    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "276f3a83-fbfa-35c3-a95b-491653fd0f48",
                    "sense_definition": "Decorated with a repeated design or motif.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a <w>patterned</w> wallpaper for the living room to make it look more interesting.",
                            "target_lang_translations": {
                                "ru": "Она выбрала <w>узорчатые</w> обои для гостиной, чтобы она выглядела интереснее."
                            }
                        },
                        {
                            "text": "The <w>patterned</w> fabric featured small blue flowers on a white background.",
                            "target_lang_translations": {
                                "ru": "На ткани <w>с рисунком</w> были изображены маленькие синие цветы на белом фоне."
                            }
                        }
                    ],
                    "synonyms": [
                        "decorated",
                        "ornamented",
                        "printed"
                    ],
                    "antonyms": [
                        "plain",
                        "solid",
                        "unpatterned"
                    ],
                    "common_phrases": [
                        "patterned fabric",
                        "patterned wallpaper",
                        "patterned shirt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшенный повторяющимся рисунком или мотивом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узорчатый",
                                "target_lang_sense_clarification": "с узорами"
                            },
                            {
                                "target_lang_word": "с рисунком",
                                "target_lang_sense_clarification": "имеющий какой-либо принт"
                            },
                            {
                                "target_lang_word": "пестрый",
                                "target_lang_sense_clarification": "разноцветный и узорчатый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e948814-4750-3dc0-9f08-aa0550fe4a6b",
                    "sense_definition": "Conformed to a specific model or standard to be followed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new curriculum is <w>patterned</w> after the successful educational systems used in Scandinavia.",
                            "target_lang_translations": {
                                "ru": "Новая учебная программа <w>построена по образцу</w> успешных образовательных систем, используемых в Скандинавии."
                            }
                        },
                        {
                            "text": "The organization maintained <w>patterned</w> procedures to ensure that every department followed the same rules.",
                            "target_lang_translations": {
                                "ru": "Организация придерживалась <w>упорядоченных</w> процедур, чтобы каждый отдел следовал одним и тем же правилам."
                            }
                        }
                    ],
                    "synonyms": [
                        "modeled",
                        "standardized",
                        "structured"
                    ],
                    "antonyms": [
                        "random",
                        "irregular"
                    ],
                    "common_phrases": [
                        "patterned after",
                        "patterned behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий определенной модели или стандарту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смоделированный",
                                "target_lang_sense_clarification": "созданный по образцу"
                            },
                            {
                                "target_lang_word": "структурированный",
                                "target_lang_sense_clarification": "организованный по схеме"
                            },
                            {
                                "target_lang_word": "шаблонный",
                                "target_lang_sense_clarification": "следующий стандарту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8415af5d-73fb-35e5-a469-87e4b4878a73",
