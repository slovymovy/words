                                "target_senses": [
                                    {
                                        "sense_id": "cc2f8a3a-e5e8-3695-a55e-b94796a741bd",
                                        "entry_id": "b02f5f50-0b8c-3e69-888d-4854242566c1",
                                        "glosses": [
                                            "The second letter of the Greek alphabet (Β, β), preceded by alpha (Α, α) and followed by gamma, (Γ, γ). In modern Greek it represents the voiced labiodental fricative sound of v found in the English words have and vase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6814fdb9-f306-3464-b5c5-c68a2a596ad2",
                                        "entry_id": "b02f5f50-0b8c-3e69-888d-4854242566c1",
                                        "glosses": [
                                            "An academic grade better than a gamma and worse than an alpha."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209a0769-df95-42cd-8ba4-260ddabc23b2",
                                                "sense_id": "6814fdb9-f306-3464-b5c5-c68a2a596ad2",
                                                "text": "But let me tell you happy extroverts that only Vera Telfer and H. A. C. Evans got even an alpha minus; only T. E. Hendrie got a beta plus […]"
                                            },
                                            {
                                                "example_id": "2281d39f-a8ee-4f4f-95d7-7d5eaab2d131",
                                                "sense_id": "6814fdb9-f306-3464-b5c5-c68a2a596ad2",
                                                "text": "Mr Taylor would hardly give a beta minus to one of his history students […]"
                                            },
                                            {
                                                "example_id": "96ac5d2d-456e-45f0-a416-a9586dd411cc",
                                                "sense_id": "6814fdb9-f306-3464-b5c5-c68a2a596ad2",
                                                "text": "The English class was for me delightful. My essays, still written under the influence of Kubla Khan, nearly always got a beta plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9f0a192-41d4-3fad-9261-fcd7208512c7",
                                        "entry_id": "b02f5f50-0b8c-3e69-888d-4854242566c1",
                                        "glosses": [
                                            "Average sensitivity of a security's price to overall securities market prices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8d6a40-e7b4-4a5d-87ab-0033d52297f5",
                                                "sense_id": "b9f0a192-41d4-3fad-9261-fcd7208512c7",
                                                "text": "An inspection of the results indicate that Property Trusts is the lowest risk industry with a long-run beta of 0.4520 while Gold is the highest risk industry with a long-run beta of 1.5229."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25658c17-1701-3975-8948-031b203eacda",
                                        "entry_id": "b02f5f50-0b8c-3e69-888d-4854242566c1",
                                        "glosses": [
                                            "The phase of development after alpha testing and before launch, in which software, while not complete, has been released to potential users for testing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66eff4d5-3642-4bca-b33e-3db2389b8b03",
                                                "sense_id": "25658c17-1701-3975-8948-031b203eacda",
                                                "text": "The company is offering a public beta program to test the software."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c90de95-9fa0-3349-82ca-e1e5d765d96d",
                                        "entry_id": "b02f5f50-0b8c-3e69-888d-4854242566c1",
                                        "glosses": [
                                            "Software in such a phase; a preliminary version."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081bfc38-6e0b-4ec1-bba0-4f5627aad4d6",
                                                "sense_id": "8c90de95-9fa0-3349-82ca-e1e5d765d96d",
                                                "text": "He quickly deduced our goal—ship a quality beta—but he also quickly discerned that we had no idea about the quality of the product because of our pile of untriaged bugs."
                                            },
                                            {
                                                "example_id": "e3737250-a3fb-48f6-9bc3-341912a62974",
                                                "sense_id": "8c90de95-9fa0-3349-82ca-e1e5d765d96d",
                                                "text": "We will assume you got the .tgz version—later 2.x series versions such as 2.5.2 or 2.6.0 should be okay, provided they are production releases (not alphas, betas, or release candidates)."
                                            },
                                            {
                                                "example_id": "c36ddbe6-7cba-46b2-a537-265837a13b34",
                                                "sense_id": "8c90de95-9fa0-3349-82ca-e1e5d765d96d",
                                                "text": "Before Evolve had even seen its first beta, the game's publisher dipped its toe into presenting it as an eSport."
                                            },
                                            {
                                                "example_id": "f362188a-c77a-45a2-82ed-681d3a205990",
                                                "sense_id": "8c90de95-9fa0-3349-82ca-e1e5d765d96d",
                                                "text": "Apple is rolling out the public beta of iOS 14 and iPadOS 14 on Thursday. We have a full (and lengthy) preview guide on both operating systems here, and now we’re breaking down how to get the public beta on your iPhone or iPad.\nThese versions of iOS 14 and iPadOS 14 are betas and don’t represent final software."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59176a14-0923-3bd1-8f10-4fbd92009778",
                                        "entry_id": "b02f5f50-0b8c-3e69-888d-4854242566c1",
                                        "glosses": [
                                            "Any kind of content from early development that was not used in the final product."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dccd6aec-cac9-426f-8b32-ee7512660284",
                                                "sense_id": "59176a14-0923-3bd1-8f10-4fbd92009778",
                                                "text": "beta levels; beta characters; beta items in a video game"
                                            }
                                        ]
                                    },
                                    {
