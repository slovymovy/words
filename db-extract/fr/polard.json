                        "entry_id": "b9efb671-4dbd-3f5f-9080-da67288bd79e",
                        "glosses": [
                            "Qui ne pense qu’au travail (se dit surtout d’un élève ou d’un étudiant)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "176dc244-a701-437e-bedd-b4421f7c2978",
                                "sense_id": "856b4ee9-093e-3574-8182-3c0992e3a217",
                                "text": "Son souci reste ses lunettes de myope qui lui rapetissent les yeux et lui donnent l’air « polard ». Quand elle les enlève, elle ne reconnaît personne dans la rue."
                            }
                        ]
                    }
