                {
                    "sense_id": "f96d1848-5cd2-37ce-b0d5-ecf8fd84c61b",
                    "sense_definition": "Mający małą długość w przestrzeni; taki, którego odległość między końcami jest niewielka",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "length",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kabel od anteny jest <w>krótki</w> i nie sięga do gniazdka.",
                            "target_lang_translations": {
                                "ru": "Антенный кабель <w>короткий</w> и не дотягивается до розетки.",
                                "de": "Das Antennenkabel ist <w>kurz</w> und reicht nicht bis zur Steckdose."
                            }
                        },
                        {
                            "text": "Latem chętnie noszę <w>krótkie</w> spodenki, gdy jest gorąco.",
                            "target_lang_translations": {
                                "ru": "Летом я охотно ношу <w>короткие</w> шорты, когда жарко.",
                                "de": "Im Sommer trage ich gerne <w>kurze</w> Hosen, wenn es heiß ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "niedługi"
                    ],
                    "antonyms": [
                        "długi"
                    ],
                    "common_phrases": [
                        "krótki rękaw",
                        "krótki dystans",
                        "krótka droga"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий небольшую длину в пространстве; такой, у которого расстояние между концами невелико",
                        "de": "Von geringer Ausdehnung im Raum; mit kleinem Abstand zwischen den Enden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короткий",
                                "target_lang_sense_clarification": "о размере или расстоянии"
                            },
                            {
                                "target_lang_word": "небольшой",
                                "target_lang_sense_clarification": "малый по размеру"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kurz",
                                "target_lang_sense_clarification": "in Bezug auf räumliche Länge oder Ausdehnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "682ddf21-6670-30d0-835e-697f77f8507f",
                    "sense_definition": "Trwający mało czasu; zajmujący niewiele czasu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mieliśmy tylko <w>krótką</w> przerwę na kawę w pracy.",
                            "target_lang_translations": {
                                "ru": "У нас был только <w>короткий</w> перерыв на кофе на работе.",
                                "de": "Wir hatten bei der Arbeit nur eine <w>kurze</w> Kaffeepause."
                            }
                        },
                        {
                            "text": "To była bardzo <w>krótka</w> wizyta, bo musieliśmy wracać do domu.",
                            "target_lang_translations": {
                                "ru": "Это был очень <w>короткий</w> визит, так как нам нужно было возвращаться домой.",
                                "de": "Es war ein sehr <w>kurzer</w> Besuch, da wir nach Hause zurückkehren mussten."
                            }
                        }
