                                                "sense_id": "9b9770a5-6e68-373a-b242-0910545c385e",
                                                "text": "Door de aanleg van de nieuwe brug is die plaats een stuk bereikbaarder geworden."
                                            },
                                            {
                                                "example_id": "5b95a3de-d648-4636-bb7b-bee254b3d3e5",
                                                "sense_id": "9b9770a5-6e68-373a-b242-0910545c385e",
