                        "dilater les vaisseaux"
                    ]
                },
                {
                    "sense_id": "6f25e1ce-0567-3386-92d1-e92e6f965059",
                    "sense_definition": "Augmenter le volume d'un corps matériel sans en altérer la masse, sous l'effet de la chaleur ou d'un changement de pression.",
