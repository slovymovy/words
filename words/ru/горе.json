                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Туристы отправились на экскурсию на остров <Горе>.",
                            "target_lang_translations": {
                                "en": "The tourists went on an excursion to <Gorée> Island.",
                                "tr": "Turistler <w>Gorée</w> Adası'na geziye gittiler."
                            }
                        },
                        {
                            "text": "История острова <Горе> связана с печальными событиями прошлого.",
                            "target_lang_translations": {
