                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "logístico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9e6c58cd-cce6-3c37-be66-ddaec817f28a",
                                        "entry_id": "d8db3335-4e13-3aae-8750-a47e9f9b0fe4",
