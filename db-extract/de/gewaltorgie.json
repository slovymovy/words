                        "glosses": [
                            "extrem starker Ausbruch von Gewalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2271cccc-30a2-4d74-9d6f-773f6558c698",
                                "sense_id": "d310a701-a61b-3c1d-91d6-f37ee3fad576",
                                "text": "„Der Leichnam weist sechs tiefe Stichwunden in der Brust und im Unterleib auf, was auf eine Gewaltorgie schließen lässt, »Overkill«, wie die Detectives sagen.“"
                            },
                            {
                                "example_id": "e0862b1b-e831-451a-bba3-45145397cc38",
                                "sense_id": "d310a701-a61b-3c1d-91d6-f37ee3fad576",
                                "text": "„Mehrere Palästinenser, die mithelfen mussten, die Massengräber zu schaufeln, schilderten den entsetzlichen Moment, als ihnen klar wurde, dass man sie ebenfalls töten würde. Sie wurden nur gerettet, weil Yaacov Epstein kam, der schon bei der Gewaltorgie im Dorf eingegriffen hatte und nun auch dem Töten am Strand Einhalt gebot.“"
                            },
                            {
                                "example_id": "4a332306-a086-459b-8d70-3589546d42b9",
                                "sense_id": "d310a701-a61b-3c1d-91d6-f37ee3fad576",
                                "text": "„Resultat war die Ruchlosigkeit und Kaltschnäuzigkeit, mit der er seine Politik umsetzte, mit bestem Gewissen und bürgerlicher Biederkeit politische Gegner ins Gefängnis sperren ließ, Gewaltorgien der Polizei zuließ und in politisch Andersdenkenden gefährliche Feinde witterte, sobald sie sich nicht mehr in einem rassistischen Grundkonsens einfangen ließen.“"
                            },
                            {
                                "example_id": "d59327a7-3727-4c0e-a54c-ff259cfd324d",
                                "sense_id": "d310a701-a61b-3c1d-91d6-f37ee3fad576",
                                "text": "„Wir malen uns Gewaltorgien aus, wie sie in dem Film Apocalypto zu sehen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
