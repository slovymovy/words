                "senses": [
                    {
                        "sense_id": "98556773-3af0-30fb-9f47-623d56bb912d",
                        "entry_id": "be7ed671-43fc-3a48-a612-3957be8a9019",
                        "glosses": [
                            "Gerät, mit dem man Guthaben auf Bezahlkarten laden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f4d1c4-01c6-408d-bdd8-f29eb805ff1e",
                                "sense_id": "98556773-3af0-30fb-9f47-623d56bb912d",
                                "text": "„Er hatte gestanden, am frühen Morgen des 28. März 2023 als Sicherheitsmitarbeiter im Gebäude einer Würzburger Firma den Geldaufwerter in der Kantine geöffnet zu haben.“"
                            },
                            {
                                "example_id": "a19766bd-b91d-4681-aa34-d7facfd8e79f",
                                "sense_id": "98556773-3af0-30fb-9f47-623d56bb912d",
                                "text": "„Aufladen der LMUcard geht an jedem Geldaufwerter des Studierendenwerks.“"
                            },
                            {
                                "example_id": "921be0a0-1ec8-417b-a57d-54f3ac67e6a9",
                                "sense_id": "98556773-3af0-30fb-9f47-623d56bb912d",
                                "text": "„Sie können die Student Card an jedem Geldaufwerter des Studierendenwerks mit Bargeld aufladen. Geldaufwerter stehen in allen Mensen und Mensarien des Studierendenwerks im Bereich der TUM.“"
                            },
                            {
                                "example_id": "57d46dec-84b9-402f-8ff6-4cd1189d2041",
                                "sense_id": "98556773-3af0-30fb-9f47-623d56bb912d",
                                "text": "„Einige Kassen zeigen Ihnen als Kontrollfunktion das Guthaben an. Selbstverständlich können Sie hierfür auch die Geldaufwerter verwenden.“"
                            },
                            {
                                "example_id": "c32a6a5b-c527-4185-aec6-984e29ced690",
                                "sense_id": "98556773-3af0-30fb-9f47-623d56bb912d",
                                "text": "„Einen Geldaufwerter für Ihre HSCard finden Sie im Foyer Gebäude L.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
