                                        "sense_id": "d9ae6bfe-4c80-396e-aa2b-372afb66ba17",
                                        "entry_id": "cd4af350-e878-3d06-bfa5-50f24a73175c",
                                        "glosses": [
                                            "einige Vogelarten aus der Familie Phasianidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb06e41-b7ec-4ad7-8e96-50f7445bec50",
                                                "sense_id": "d9ae6bfe-4c80-396e-aa2b-372afb66ba17",
                                                "text": "Die Männchen vieler Fasane sind sehr farbenprächtig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c2a60fd-91f2-3e3a-9588-f8f1d04b519b",
                                        "entry_id": "cd4af350-e878-3d06-bfa5-50f24a73175c",
                                        "glosses": [
                                            "speziell die Vogelart Phasianus colchicus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5863f4c-d260-413e-809c-207febd067e4",
                                                "sense_id": "6c2a60fd-91f2-3e3a-9588-f8f1d04b519b",
                                                "text": "Der Fasan ist ein Vogel, der aus Mittelasien stammt."
                                            },
                                            {
                                                "example_id": "0533f639-9aa5-4343-bfe2-74e9f6c99ba7",
                                                "sense_id": "6c2a60fd-91f2-3e3a-9588-f8f1d04b519b",
                                                "text": "„Kiebitze hatten sich längst aus der Sperrzone verzogen, ebenso waren die Fasane ausgewandert und die wilden, auf Stille angewiesenen Kaninchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "90fb4f36-1ddc-37d7-9183-47414e5b7ed8",
                                        "entry_id": "cd4af350-e878-3d06-bfa5-50f24a73175c",
                                        "glosses": [
                                            "Speisekartoffel: Sortenname: Fasan NN"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f62159-114a-4ea5-8c83-f4b8f42e43e3",
                                                "sense_id": "90fb4f36-1ddc-37d7-9183-47414e5b7ed8",
                                                "text": "Fasan NN, ist eine Kartoffelsorte, der 1997 offiziell von dem Bundessortenamt zugelassen wurde. Die Schalenfarbe ist gelb, die Fleischfarbe ist gelblich. Verwendet wird der Fasan NN als Speisekartoffel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
