{
    "word_family": [
        "sequence",
        "sequentially",
        "sequel"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bf5156f5-317d-3233-a512-876d2e4bbb32",
                    "sense_definition": "Following in a regular or chronological order; forming a sequence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chapters of the textbook should be read in <w>sequential</w> order.",
                            "target_lang_translations": {
                                "zh": "教科书的章节应当按<w>顺序</w>阅读。"
                            }
                        },
                        {
                            "text": "Each document is marked with a <w>sequential</w> number for easy tracking.",
                            "target_lang_translations": {
                                "zh": "每份文件都标有<w>连续的</w>编号以便于追踪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "successive",
                        "consecutive"
                    ],
                    "antonyms": [
                        "non-sequential"
                    ],
                    "common_phrases": [
                        "sequential order"
                    ],
                    "target_lang_definitions": {
                        "zh": "按顺序的，连续的；成序列的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "按顺序的",
                                "target_lang_sense_clarification": "指按照特定或自然次序进行的"
                            },
                            {
                                "target_lang_word": "连续的",
                                "target_lang_sense_clarification": "指相继发生、不中断的"
                            },
                            {
                                "target_lang_word": "相继的",
                                "target_lang_sense_clarification": "指前后承接的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c088573-7c98-3fb0-ab6c-4f2c966cdd00",
                    "sense_definition": "Executed one instruction at a time in order, without concurrency or parallelism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer uses a <w>sequential</w> processing method to handle tasks one by one.",
                            "target_lang_translations": {
                                "zh": "这台计算机采用<w>顺序</w>处理方式来逐个处理任务。"
                            }
                        },
                        {
                            "text": "This older algorithm relies on purely <w>sequential</w> execution rather than multi-threading.",
                            "target_lang_translations": {
                                "zh": "这种旧算法依赖于完全<w>串行</w>执行，而不是多线程。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-sequential"
                    ],
                    "common_phrases": [
                        "sequential processing"
                    ],
                    "target_lang_definitions": {
                        "zh": "（计算机）顺序的，逐项执行的；非并发或并行的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "顺序的",
                                "target_lang_sense_clarification": "计算机科学中指指令或数据依次处理的"
                            },
                            {
                                "target_lang_word": "串行的",
                                "target_lang_sense_clarification": "计算机术语，指逐一处理、与并行相对的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}