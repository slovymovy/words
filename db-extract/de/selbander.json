        "de-extract.jsonl": [
            {
                "entry_id": "38b74c99-657f-30a5-88ba-899daa400602",
                "word": "selbander",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7729acc6-8ebf-30d7-854d-cd6bef53e5ef",
                        "entry_id": "38b74c99-657f-30a5-88ba-899daa400602",
                        "glosses": [
                            "zu zweit"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "59a27620-e548-410d-b179-c93c3114cfbb",
                                "sense_id": "7729acc6-8ebf-30d7-854d-cd6bef53e5ef",
                                "text": "„… Der dir nun Krieg verwehrte, nun du ihn so keck wünschest, Kampf selbander!“"
                            },
                            {
                                "example_id": "ac54cae4-a696-465d-882e-3a3994fc1bc3",
                                "sense_id": "7729acc6-8ebf-30d7-854d-cd6bef53e5ef",
                                "text": "„Und sie begaben sich selbander zur Druckerei, um nach dem Preis beschlossener Plakate zu fragen.“"
                            },
                            {
                                "example_id": "5ad8f68f-00a5-449d-8722-f36a1f6b3047",
                                "sense_id": "7729acc6-8ebf-30d7-854d-cd6bef53e5ef",
                                "text": "\"Fern hast du mich geleitet. Eine volle Nacht im Walde selbander wanderten wir.\""
                            },
                            {
                                "example_id": "8c8a8535-4cda-44be-84e4-272fdc7c1659",
                                "sense_id": "7729acc6-8ebf-30d7-854d-cd6bef53e5ef",
                                "text": "„Als man zu tanzen begann, stiegen der Baron und Mintzlaff selbander in die große, geräumige Bar hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
