                "senses": [
                    {
                        "sense_id": "a6e9d9da-abcb-3fb9-9a3b-16d9ee5a3214",
                        "entry_id": "3df35f26-9113-3526-b0c0-ee0dc888b97a",
                        "glosses": [
                            "Positionierung/Anordnung/Ausrichtung von Elementen, Komponenten, Körperteilen und dergleichen in einem bestimmten Winkel zueinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da954542-8bf5-4f3d-813e-934da41c01c1",
                                "sense_id": "a6e9d9da-abcb-3fb9-9a3b-16d9ee5a3214",
                                "text": "„Die Posen unterscheiden sich nicht von gewöhnlichen Yogaübungen – Standards wie Cobra, Planke und seitliche Winkelstellungen werden in einem Fluss nachgemacht.“"
                            },
                            {
                                "example_id": "fbdc8941-aac0-4842-a056-e42731d354e8",
                                "sense_id": "a6e9d9da-abcb-3fb9-9a3b-16d9ee5a3214",
                                "text": "„Dies liegt daran, dass die Bänder von Frauen im Vergleich zu denen von Männern tendenziell lockerer sind und dass Winkelstellungen sowie Kräfte anders auf Knie- und Fußgelenke wirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
