                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1a6e2a-65ab-4be8-9e6e-0cf3edfb506e",
                                "sense_id": "4c724c51-182d-3b98-8d00-d75b51b481c6",
                                "text": "CÉRÉIFORME, adj., cereiformis (cereus, cierge, forma, forme) ; qui a la forme d’un cierge, comme l’Euphorbia cereiformis, ainsi appelé à cause de ses tiges minces, charnues et cylindriques."
                            },
                            {
                                "example_id": "22dd8f1f-e8c8-480f-8f96-65facfe88e0e",
                                "sense_id": "4c724c51-182d-3b98-8d00-d75b51b481c6",
                                "text": "Le régime xérique de la côte se prolonge sur le versant occidental des Andes moyennes, où s’étend une végétation plus ou moins steppique, qui peut être parsemée d’arbustes ou de petits arbres, ou de Cactacées céréiformes."
                            }
                        ]
                    }
