                        "glosses": [
                            "Qui n’aime pas les huiles ni les graisses."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee54a975-03a6-3764-ae54-b891fa6328fa",
                        "entry_id": "5be1dbb5-cbf8-3109-a448-4c83ad70701f",
                        "glosses": [
                            "Qui repousse les huiles et graisses, qui ne permet pas aux graisses de s’attacher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f450ff7-ee50-4a9e-bc7a-6f63d2b5b97f",
                                "sense_id": "ee54a975-03a6-3764-ae54-b891fa6328fa",
                                "text": "Il rend la peinture super hydrophobe et oléophobe, laissant glisser le moindre liquide, la boue mais aussi les traces d’huile, de gras...."
                            },
                            {
                                "example_id": "b6c34ab1-d1f9-4416-b357-05d8088601bc",
                                "sense_id": "ee54a975-03a6-3764-ae54-b891fa6328fa",
                                "text": "Cette surface est non seulement hydrophobe, mais aussi « oléophobe », c’est-à-dire qu’elle repousse les liquides organiques tels que les alcools ou les hydrocarbures, qui restent sous forme de gouttes."
                            },
                            {
                                "example_id": "bed015fd-9b2b-43b2-9383-f7f51ba10605",
                                "sense_id": "ee54a975-03a6-3764-ae54-b891fa6328fa",
                                "text": "En raison de leurs propriétés hydro- et oléophobes, ces composés sont utilisés dans une grande variété d’articles du quotidien, depuis les poêles antiadhésives jusqu’aux emballages de fast-food."
                            }
                        ]
                    }
