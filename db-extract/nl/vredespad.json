                        "glosses": [
                            "de weg naar de vrede; staken van een strijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b17e4d5-1ecf-424c-86a7-e299ea766b86",
                                "sense_id": "cc835f01-29d0-34cb-ace8-e69069d51412",
                                "text": "Het vredesproces in het Spaanse Baskenland moet deze week handen en voeten krijgen. Premier José Luis Rodríguez Zapatero wil haast maken met het uitzetten van een ‘vredespad’. Hij is erop gebrand de tegenstanders geen tijd te geven om het prille proces om zeep te helpen."
                            },
                            {
                                "example_id": "f731db6f-71ac-4e9c-86d5-3c1dc8c5cd88",
                                "sense_id": "cc835f01-29d0-34cb-ace8-e69069d51412",
                                "text": "Aan het einde van zijn toespraak riep hij op het vredespad van Gandhi (geboren in Gujarat) te volgen, en niet de weg in te slaan van religieuze onverdraagzaamheid."
                            },
                            {
                                "example_id": "448c78d0-f6d7-4a70-b34e-459ffbd22648",
                                "sense_id": "cc835f01-29d0-34cb-ace8-e69069d51412",
                                "text": "Maar naarmate de Israëlische repressie de laatste jaren toenam, groeide de aanhang van sjeik Yassin die immers nooit wat in het \"zogenaamde vredespad\" had gezien en af en toe hoogstens in een hudna, een tijdelijke wapenstilstand, wilde toestemmen."
                            }
                        ]
                    }
