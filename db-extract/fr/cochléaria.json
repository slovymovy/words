                ],
                "senses": [
                    {
                        "sense_id": "3d8e32c3-68fb-3c5f-846d-f47b9cd2a780",
                        "entry_id": "c78cdff9-6720-3c80-9db7-761a5ff16a87",
                        "glosses": [
                            "Plante de la famille des Brassicacées (ou Crucifères)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1930e12b-792d-4293-96b0-62cd4d0085ff",
                                "sense_id": "3d8e32c3-68fb-3c5f-846d-f47b9cd2a780",
                                "text": "Le cochléaria est un puissant antiscorbutique."
                            },
                            {
                                "example_id": "ecdb5862-92f0-4f71-afad-87f5ad866ae9",
                                "sense_id": "3d8e32c3-68fb-3c5f-846d-f47b9cd2a780",
                                "text": "Cette fois le printemps était revenu.\nL’herbe des prés était d’un vert lourd, luisant, tout neuf. Des touffes de primevères le nuançaient par places de jaune pâle et, dans les creux humides, des pieds de cochléaria avaient poussé, étalaient sur les eaux leurs grappes couleur de lilas."
                            },
                            {
                                "example_id": "2b1c1c77-19e6-4f6e-a785-9f285dcd95d1",
                                "sense_id": "3d8e32c3-68fb-3c5f-846d-f47b9cd2a780",
                                "text": "Le cochléaria vient à l’état sauvage dans les endroits humides et pierreux, sur les bords de la mer."
                            },
                            {
                                "example_id": "535d9363-a41f-4a2c-8120-bbb15b775a98",
                                "sense_id": "3d8e32c3-68fb-3c5f-846d-f47b9cd2a780",
                                "text": "Ses murailles avaient la couleur sombre et la rudesse des rochers, avec des mousses et du cochléaria formant de petites touffes vertes."
                            }
                        ]
                    }
                ],
