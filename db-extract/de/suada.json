                "senses": [
                    {
                        "sense_id": "06bc39e3-797b-31d8-aef5-41e88116f5b1",
                        "entry_id": "78b6516a-7014-371b-99aa-624b08d832d9",
                        "glosses": [
                            "diatribe (prolonged discourse)"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "formal",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "94df21ec-8262-4d65-84e9-4a215dc469d2",
                                "sense_id": "06bc39e3-797b-31d8-aef5-41e88116f5b1",
                                "text": "Ein Plot nur in Fetzen, eine Suada, der aber leider nicht gelang, was Suaden gelingen muss: eine*n zu packen, mitzuzerren, und sei's am Genick und sei's durch den Dreck."
                            }
                        ]
                    },
                    {
                        "sense_id": "edde188a-c505-30b4-917b-58712fc39a39",
                        "entry_id": "78b6516a-7014-371b-99aa-624b08d832d9",
                        "glosses": [
                            "persuasiveness, power of persuasion"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "0055d2fa-3d1c-4a89-80ae-b6bd8dc6601e",
                                "sense_id": "edde188a-c505-30b4-917b-58712fc39a39",
                                "text": "Giulbeaux, ein schmächtiges, blondes Männchen mit scharfen, unruhigen grauen Augen und einer lebhaften Suada, war an sich nicht begabt.",
                                "translation": "The World of Yesterday",
                                "english": "The World of Yesterday"
                            }
                        ]
                    }
