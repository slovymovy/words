                                    },
                                    {
                                        "sense_id": "27f3474c-5318-366c-a24e-018dcbd84434",
                                        "entry_id": "60b0965f-8c25-394c-bc10-fe3bbcc502de",
                                        "glosses": [
                                            "Something that can be compared to a jigsaw puzzle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2090fcd-8d78-418f-ab7e-c9f5f4d0d384",
                                                "sense_id": "27f3474c-5318-366c-a24e-018dcbd84434",
                                                "text": "A rolling programme of platform closures will enable Network Rail to replace 54-year-old signalling and (when complete in 2022) complete a jigsaw of upgrades that started in 2005."
                                            },
                                            {
                                                "example_id": "c48acb98-c91b-4ca0-89b2-2063644c8c1d",
                                                "sense_id": "27f3474c-5318-366c-a24e-018dcbd84434",
                                                "text": "The last piece of the jigsaw dropped into place in July with the stretch of line from Coleford Junction to Meldon Quarry being purchased by Network Rail from Aggregate Industries for a nominal sum."
                                            }
                                        ]
                                    }
                                ]
                            },
