                        "tags": [],
                        "examples": [
                            {
                                "example_id": "782168a2-c4de-4e3a-aa2f-d037de3f1fd4",
                                "sense_id": "dfe5a022-7447-3cb4-be7c-a2f0021a9f90",
                                "text": "“The old marplot has discovered the baby,” Monica whispered. “I suppose it cried and woke him up, and now he thinks he's witness to a miracle.”"
                            },
                            {
                                "example_id": "3fffd342-4967-4c54-b9c3-2f7b6bbe917c",
                                "sense_id": "dfe5a022-7447-3cb4-be7c-a2f0021a9f90",
                                "text": "Unthinking Anglo-Saxons regard him as a Gallic marplot, rather than the great twentieth-century statesman he was – certainly the greatest Frenchman since Napoleon."
                            }
                        ]
                    }
