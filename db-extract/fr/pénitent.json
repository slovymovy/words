                        "entry_id": "281cbf8e-3b75-383d-a576-5b1f5734c1cf",
                        "glosses": [
                            "Qui a regret d’avoir offensé Dieu, qui est dans la pratique des exercices de la pénitence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fad23290-8f88-4588-bdff-c6b83e81eece",
                                "sense_id": "42b61c4c-de58-3a57-a6ee-2f245c7fa624",
                                "text": "Pécheur pénitent. — Femme pénitente."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cf20a3b-aec8-3127-87f4-fe6eafd89501",
                        "entry_id": "281cbf8e-3b75-383d-a576-5b1f5734c1cf",
                        "glosses": [
                            "Qui fait pénitence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058ca7e7-3b38-4e2c-b90b-552cb4090f61",
                                "sense_id": "5cf20a3b-aec8-3127-87f4-fe6eafd89501",
                                "text": "Dieu consent enfin à interrompre la tâche pénitente de ses maux ; Il lui accorde de souffler et le Démon profite de cette accalmie pour entrer en scène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a183b3d-9ef0-434a-9fd4-639f719db0b8",
