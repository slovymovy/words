                "senses": [
                    {
                        "sense_id": "70d9648a-0cde-3fea-8a4e-29a1c0530839",
                        "entry_id": "97349861-674c-3351-9743-288b40eb3f2b",
                        "glosses": [
                            "иметь желание, охоту, потребность в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ad3ffc-7603-4aee-9c0e-86cb37db0003",
                                "sense_id": "70d9648a-0cde-3fea-8a4e-29a1c0530839",
                                "text": "Правда, через несколько часов ему начинало очень сильно хотеться пить, затем он ложился в постель, и через день прекрасная неаполитанка, накормившая своего мужа супом, была свободна, как весенний ветер."
                            }
                        ]
                    },
                    {
                        "sense_id": "75ec1663-7008-35c8-9605-299c55d74e74",
                        "entry_id": "97349861-674c-3351-9743-288b40eb3f2b",
                        "glosses": [
                            "надеяться найти что-нибудь в ком-чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2bc94f8-5403-4210-8d46-dbf10f5b6978",
                                "sense_id": "75ec1663-7008-35c8-9605-299c55d74e74",
                                "text": "Хотелось от него невыполнимого."
                            },
                            {
                                "example_id": "c072cd82-7891-4216-87b3-7167bcc80116",
                                "sense_id": "75ec1663-7008-35c8-9605-299c55d74e74",
                                "text": "Хотелось от него правды."
                            }
                        ]
                    }
