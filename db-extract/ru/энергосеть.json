                                "target_senses": [
                                    {
                                        "sense_id": "1d36095c-ed2e-3e0e-ab9d-304666e38578",
                                        "entry_id": "aa371835-fd16-32cd-8c14-69f147642498",
                                        "glosses": [
                                            "The infrastructure for distributing electrical power throughout a region."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f968d450-66cd-4bd2-8583-c68ea08f0e29",
                                                "sense_id": "1d36095c-ed2e-3e0e-ab9d-304666e38578",
                                                "text": "Russian missiles have damaged or destroyed much of Ukraine’s power grid since the start of October, a concerted effort to make the winter as painful as possible for the civilian population."
                                            },
                                            {
                                                "example_id": "be355fd1-2090-4f5a-aec9-da3ae52b1809",
                                                "sense_id": "1d36095c-ed2e-3e0e-ab9d-304666e38578",
                                                "text": "There have been several examples of space weather affecting power grids in the last few decades, notably blackouts caused by GICs [geomagnetically induced currents] in Canada in 1989 and Sweden in 2003."
                                            }
                                        ]
                                    }
                                ]
