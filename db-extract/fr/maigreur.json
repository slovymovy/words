        "fr-extract.jsonl": [
            {
                "entry_id": "8b574416-cbca-3201-9b02-9281af17a2af",
                "word": "maigreur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43fd0003-39eb-43f8-8654-352cbd584820",
                        "entry_id": "8b574416-cbca-3201-9b02-9281af17a2af",
                        "tags": [
                            "plural"
                        ],
                        "form": "maigreurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                        "entry_id": "8b574416-cbca-3201-9b02-9281af17a2af",
                        "glosses": [
                            "État du corps des hommes et des animaux maigres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88db7003-b19b-4349-99fb-4134e43bb182",
                                "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                                "text": "Je ne croyais pas qu’il pût arriver à un tel point de maigreur."
                            },
                            {
                                "example_id": "d7a40f0e-3807-49cc-9a39-f06ce39dda5c",
                                "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                                "text": "Si l’anorexie, comme chacun le sait, s’accompagne d’une maigreur souvent extrême, elle peut tout de même donner lieu à des crises alimentaires parfaitement similaires à celles présentes dans les autres troubles."
                            },
                            {
                                "example_id": "c8f8c8a4-96ba-4ce8-bdc9-2f81f9841ca8",
                                "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                                "text": "Sa maigreur ne l’a jamais empêché de se bien porter."
                            },
                            {
                                "example_id": "2aecb10d-c249-49a8-933e-88a1c0a92448",
                                "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                                "text": "La maigreur d’une colonne."
                            },
                            {
                                "example_id": "80440a3e-3014-484b-a3c8-fd2cff0d9ca6",
                                "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                                "text": "Maigreur de touche."
                            },
                            {
                                "example_id": "f752db98-ad01-42fb-bde2-a25a5748450b",
                                "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                                "text": "La maigreur de son sujet l’a forcé à recourir à des épisodes, à des morceaux de remplissage."
                            },
                            {
                                "example_id": "2baa9efc-3ad5-4614-801c-bc91caa6f913",
                                "sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
                                "text": "La maigreur du style."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4943e59-f805-411d-a673-43d358a617b7",
                        "source_entry_id": "8b574416-cbca-3201-9b02-9281af17a2af",
                        "source_sense_id": "26921d3f-2568-3a03-b870-22bad28caa40",
