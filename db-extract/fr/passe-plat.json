                "senses": [
                    {
                        "sense_id": "b383a297-a07a-38a1-8d1a-efb2be2d77fb",
                        "entry_id": "597f3c0b-228c-34bf-8214-e4b8f5005ad7",
                        "glosses": [
                            "Ouverture dans un mur ou une porte pour passer un ou plusieurs plats d’une pièce à l’autre, généralement de la cuisine à la salle à manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e695440-d1b0-490a-b1b0-6e29193d9a47",
                                "sense_id": "b383a297-a07a-38a1-8d1a-efb2be2d77fb",
                                "text": "Le plan du rez-de-chaussée est divisé en deux zones, dont une pour le service, qui communiquent entre elles par une seule porte de dégagement et un passe-plat dans le séjour."
                            },
                            {
                                "example_id": "16294b35-9442-4490-9bd7-94f066119daa",
                                "sense_id": "b383a297-a07a-38a1-8d1a-efb2be2d77fb",
                                "text": "On nous portait la nourriture dans les cellules, en nous la glissant par un passe-plat."
                            },
                            {
                                "example_id": "6dd9cf51-5324-4a66-8915-dc8e5c14fb03",
                                "sense_id": "b383a297-a07a-38a1-8d1a-efb2be2d77fb",
                                "text": "Je me confie à vous, monsieur, parce que dès que je vous ai vu à travers le passe-plat, je compris que vous seriez mon allié, que vous sauriez me comprendre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a70b3f1f-3b21-4fbf-8c91-17329de75bbf",
                        "source_entry_id": "597f3c0b-228c-34bf-8214-e4b8f5005ad7",
                        "source_sense_id": "b383a297-a07a-38a1-8d1a-efb2be2d77fb",
