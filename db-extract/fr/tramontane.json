            {
                "entry_id": "f3a71e71-992e-3991-a012-312c470c5b2c",
                "word": "tramontane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65f1c8de-d84c-3604-b63b-75643a4ac0fc",
                        "entry_id": "f3a71e71-992e-3991-a012-312c470c5b2c",
                        "glosses": [
                            "Vent d'origine nord-nord-ouest qui souffle dans le sud-ouest de la France, entre les Pyrénées et le Massif central, en direction du golfe du Lion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89dffdf5-12f1-4e1a-9c96-29aea896edd7",
                                "sense_id": "65f1c8de-d84c-3604-b63b-75643a4ac0fc",
                                "text": "La tramontane se leva pour de bon."
                            },
                            {
                                "example_id": "7ba566a3-0777-4855-8738-f23d2d50bd7f",
                                "sense_id": "65f1c8de-d84c-3604-b63b-75643a4ac0fc",
                                "text": "Assis sur le parapet du vieux pont, je passais une heure ou deux à regarder cette route sauvage qui conduisait vers les forêts, les combes et les plateaux que tourmente la tramontane."
                            },
                            {
                                "example_id": "11ffb793-5a7c-427f-ad7d-991e3abc78c4",
                                "sense_id": "65f1c8de-d84c-3604-b63b-75643a4ac0fc",
                                "text": "– Tramontane, sirocco, libeccio, ponant et mistral. Ce n’est tout de même pas difficile ! s’emporta Viola. Il n’y a que cinq vents qui soufflent ici."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcbc0f4d-e6df-3ecf-8701-2a191ada8196",
                        "entry_id": "f3a71e71-992e-3991-a012-312c470c5b2c",
                        "glosses": [
                            "Côté du nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31df7886-0f32-4f1d-8386-da7fe740262a",
                                "sense_id": "bcbc0f4d-e6df-3ecf-8701-2a191ada8196",
                                "text": "Une maison exposée à la tramontane."
                            },
                            {
                                "example_id": "64c67669-998a-4f7a-879a-82b7344faa3b",
                                "sense_id": "bcbc0f4d-e6df-3ecf-8701-2a191ada8196",
                                "text": "Aller vers la tramontane."
                            },
                            {
                                "example_id": "7fcd34bf-45a3-4ffc-90d5-f6f908af3657",
                                "sense_id": "bcbc0f4d-e6df-3ecf-8701-2a191ada8196",
                                "text": "Perdre la tramontane, perdre le nord, perdre la tête."
                            }
                        ]
                    }
                ],
