                        "sense_id": "9a64fc8d-e3f1-3f46-989c-af45302fd476",
                        "entry_id": "3c79a2d6-72f3-3944-b92f-73ee0ac986a3",
                        "glosses": [
                            "Féministe radical ou extrémiste."
                        ],
                        "tags": [
                            "pejorative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b60c38e3-78b6-427c-a0a2-edd257e9f0c1",
                                "sense_id": "9a64fc8d-e3f1-3f46-989c-af45302fd476",
                                "text": "Depuis près de trente ans, cette avocate est le bras armé des avancées féministes aux États-Unis, suscitant autant d’adoration chez ses admiratrices que de colère chez ses adversaires, qui la traitent de « féminazie »."
                            },
                            {
                                "example_id": "0eec4efc-38c9-480a-a30c-b4f54d214f42",
                                "sense_id": "9a64fc8d-e3f1-3f46-989c-af45302fd476",
                                "text": "[…] dans une perspective populiste, nulle discussion n’est possible avec un adversaire, dès lors qu’il est rangé parmi les « islamo-gauchistes » ou les « féminazis »."
                            }
                        ]
                    }
