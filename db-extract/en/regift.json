                        "form": "regifting"
                    },
                    {
                        "form_id": "6fa208d2-685f-454a-b72b-77a444889517",
                        "entry_id": "900757fa-81f8-3be4-af63-f765d5b45b52",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "regifted"
                    },
                    {
                        "form_id": "cc1343a5-8ba5-4dd9-a1e3-22e132ed9fa4",
                        "entry_id": "900757fa-81f8-3be4-af63-f765d5b45b52",
                        "tags": [
                            "past"
                        ],
                        "form": "regifted"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7be89cad-8c96-367e-916e-0706f22ff668",
                        "entry_id": "900757fa-81f8-3be4-af63-f765d5b45b52",
                        "glosses": [
                            "To give something as a gift which the giver previously received as a gift; to give to a person something previously received as a gift."
                        ],
                        "tags": [
                            "ditransitive",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "82d0dc7c-4a52-4e27-8f63-1a498f8be10b",
                                "sense_id": "7be89cad-8c96-367e-916e-0706f22ff668",
                                "text": "Be upfront when giving the re-gifted item."
                            },
                            {
                                "example_id": "7cb7f6e8-763e-4389-86ab-22aaf715d4cd",
                                "sense_id": "7be89cad-8c96-367e-916e-0706f22ff668",
                                "text": "Don't tell the person who is receiving the gift that he/she is being regifted."
                            },
                            {
                                "example_id": "2571e4b3-aed7-4f3d-b62f-ae98ea4c997a",
                                "sense_id": "7be89cad-8c96-367e-916e-0706f22ff668",
                                "text": "It's not usually acceptable to regift an item that's used rather than new. On the other hand, regifting something that's important to you and thus sharing its value with the recipient is actually quite generous and thoughtful."
                            },
                            {
                                "example_id": "bcba568f-79a0-4c81-89b9-f13d62d29c11",
                                "sense_id": "7be89cad-8c96-367e-916e-0706f22ff668",
                                "text": "But before you do any real regifting, you need to learn the rules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
