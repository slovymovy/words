                    },
                    {
                        "translation_id": "4c0c7fd4-1a50-4248-9cba-d2df8371ece6",
                        "source_entry_id": "dfa1c9df-ed1e-3f25-b18d-a6697108be99",
                        "source_sense_id": "5727e5bb-dc83-3d07-a84a-5333a6d645ae",
                        "source_sense_description": "the quality of being prurient",
                        "target_lang_word": "Geilheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geilheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                        "entry_id": "4d8c98f0-c6c0-3b59-a2e8-30c186f8d3a5",
                                        "glosses": [
                                            "Verfassung/Zustand, sexuell erregt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811680fd-7066-4df6-9915-893dd461dbf6",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "„Almuth hatte es auf die Schnelle haben wollen, sie war mit einer kühlen Geilheit dabei gewesen.“"
                                            },
                                            {
                                                "example_id": "beb4e094-6b4a-4d67-8042-764a9c596ee6",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "„Lust auf ein Bad hatte er nicht, aber er konnte seine Geilheit nicht mehr zügeln, und daher besorgte er es sich eben selbst.“"
                                            },
                                            {
                                                "example_id": "6fcbf0c0-948d-4061-9b02-7227d8eadbf9",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "Ohne diese derbe, rohe Redeweise, ohne den Soldatenjargon und diese schmucklos ausgebreitete Geilheit hätte die Erzählung nicht echt, sondern künstlich gewirkt, mit falschen Wörtern hätte er die dargestellten Menschen verraten."
                                            },
                                            {
                                                "example_id": "0c44a90f-016f-4db3-80a0-6facbffba356",
                                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                                "text": "„Folglich war meine Geilheit wichtiger als die so lang verabreichte Moralkotze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "443dada6-de6c-3007-b010-c275a1d2d9b9",
                                        "entry_id": "4d8c98f0-c6c0-3b59-a2e8-30c186f8d3a5",
                                        "glosses": [
                                            "übermäßiges Wachstum von Pflanzen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee64825d-e014-4eb3-8d01-5d72df017e33",
                                                "sense_id": "443dada6-de6c-3007-b010-c275a1d2d9b9",
                                                "text": "Praktische Versuche haben übrigens dargethan, daß das Vermögen der Cerealien, aus der Atmosphäre Stickstoffverbindungen zu absorbiren, höchst gering, daher bedeutungslos ist, und daß, alle übrigen zur Ausbildung unentbehrlichen mineralischen Nährstoffe im geeigneten Zustande vorausgesetzt, ihre Entwickelung dem Stickstoffzusatze proportional erfolgte und erst ein Überschuß an löslichen Stickstoffverbindungen ein übereiltes Wachsthum, Geilheit, endliche Lagerung und mangelhafte Ausbildung der Körner hervorrief."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e817bc7d-3737-46a3-b726-0ec429752079",
                        "source_entry_id": "dfa1c9df-ed1e-3f25-b18d-a6697108be99",
                        "source_sense_id": "5727e5bb-dc83-3d07-a84a-5333a6d645ae",
                        "source_sense_description": "the quality of being prurient",
                        "target_lang_word": "Lüsternheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lüsternheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                        "entry_id": "1063f4d5-ddaa-391b-8d63-de9f80095086",
                                        "glosses": [
                                            "Zustand, lüstern/sexuell begehrlich zu sein"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e20cce53-2476-4ffd-88b1-fa3f439834bb",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„Der Faun freilich in seinem abgeschwächten Zustand und bei wieder kühlem Kopfe registrierte die satte Lüsternheit seiner beiden Freundinnen mit dem Blick des Theaterbesuchers zur Bühne: Mir wird ein Spiel geboten.“"
                                            },
                                            {
                                                "example_id": "e5bbb7d0-ffca-40e2-bc08-0aa87c97a2e3",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„Sie bemächtigte sich des Mannes, der ihre Lüsternheit erregte, und er mußte ihr zu Willen sein.“"
                                            },
                                            {
                                                "example_id": "bace0aa9-1f40-41e7-928c-53a6e0660b3d",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„Ich selbst bin überaus empfindlich gegen Obszönität, besonders den Sexualwitz, wo er aus einem vitalen Mangel und Ersatzbedürfnis, aus Angeberei oder zerebraler Lüsternheit resultiert.“"
                                            },
                                            {
                                                "example_id": "ca9cb19b-4178-4668-94d1-ad0e6fa7ee90",
                                                "sense_id": "a04a7dac-20ab-3230-b6be-ea3ab882beb4",
                                                "text": "„In Deutschland schrieb man um diese Zeit oder bald nachher dergleichen auf sentimentale Manier und streute eine Fingerspitze Lüsternheiten darüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
