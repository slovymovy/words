                    }
                ],
                "senses": [
                    {
                        "sense_id": "93c25a2a-6572-3b8c-8c0b-5ab0be638b81",
                        "entry_id": "cd24256b-de81-3903-a1d1-4a45960099f4",
                        "glosses": [
                            "Any mollusc of the class Cephalopoda, which includes squid, cuttlefish, octopus, nautiloids etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5115c794-2dfa-40f5-8ce4-0e87babcecf8",
                                "sense_id": "93c25a2a-6572-3b8c-8c0b-5ab0be638b81",
                                "text": "In terms of diversity, cephalopods include the egg case making argonauts, shelled nautiluses, venomous blue-ringed octopuses and enigmatic giants like the giant and colossal squid. […] Generally, cephalopod ink includes melanin, enzymes related to melanin production, catecholamines, peptidoglycans, free amino acids and metals (Derby 2014) ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fb67091-2871-483c-85ec-8dd7164b1818",
                        "source_entry_id": "cd24256b-de81-3903-a1d1-4a45960099f4",
                        "source_sense_id": "93c25a2a-6572-3b8c-8c0b-5ab0be638b81",
                        "source_sense_description": "mollusc",
                        "target_lang_word": "hlavonožec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hlavonožec",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "076d0b70-458f-3f6a-8a64-eeef07a03edc",
                                        "entry_id": "1bdf1639-017d-3ecc-a9e1-87090e74c002",
                                        "glosses": [
                                            "měkkýš s chapadly žijící v moři"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "933234e1-2f53-42bc-8710-9765742411d8",
                                                "sense_id": "076d0b70-458f-3f6a-8a64-eeef07a03edc",
                                                "text": "Kapitán se přece neodvážil toho, aby život svého mužstva tím dal v šanc, že by za netvorem lodici vyslal, kterou hlavonožec mohl strašnými rameny snadno obemknouti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "203c59d6-d116-411d-862b-fcc258c530c4",
                        "source_entry_id": "cd24256b-de81-3903-a1d1-4a45960099f4",
                        "source_sense_id": "93c25a2a-6572-3b8c-8c0b-5ab0be638b81",
                        "source_sense_description": "mollusc",
                        "target_lang_word": "koppotige",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koppotige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7920e8-5f80-3df0-9cca-43470ffceccb",
                                        "entry_id": "5937ad00-0942-3ec8-83c5-4f7b6356486f",
                                        "glosses": [
                                            "benaming voor dieren uit de klasse Cephalopoda, waartoe de inktvissen behoren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56bcda2f-4623-413a-b621-c9374f6c4ef0",
                                                "sense_id": "cd7920e8-5f80-3df0-9cca-43470ffceccb",
                                                "text": "De reuzenpijlinktvis is een koppotige."
                                            },
                                            {
                                                "example_id": "3f9c896b-f7f3-4316-8aa5-6c110d45f626",
                                                "sense_id": "cd7920e8-5f80-3df0-9cca-43470ffceccb",
                                                "text": "Het is een dwarsdoorsnede van de externe schelp – formaat onderarm – van de inktvisachtige Orthoceras. De schelp waarin deze koppotige (naar zijn tien tentakels op de kop) zich kon terugtrekken vormt een kaarsrechte pijlpunt, aan weerskanten afgezet met biezen van kamertjes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "koppotige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4f4bcc6a-4218-3bbd-9a88-04f9aae43e1b",
                                        "entry_id": "d0b4eb7a-72b9-30b0-9491-5cbf25b6069b",
                                        "glosses": [
                                            "verbogen vorm van de stellende trap van koppotig"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a07b29db-652a-42cb-87a2-8f8c003faa24",
                                                "sense_id": "4f4bcc6a-4218-3bbd-9a88-04f9aae43e1b",
                                                "text": "Ze herinnert zich dat ze er een poosje naar stond te kijken, gefascineerd door de soepele bewegingen van de koppotige weekdieren en door de verontrustend starende blik in hun ooglidloze ogen waarmee ze haar opnamen, voordat ze met hun kop vooruit door het water schoten, met hun vier paar armen erachteraan bungelend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17528e8a-da60-4442-98fe-e8749fd00fdd",
                        "source_entry_id": "cd24256b-de81-3903-a1d1-4a45960099f4",
                        "source_sense_id": "93c25a2a-6572-3b8c-8c0b-5ab0be638b81",
                        "source_sense_description": "mollusc",
                        "target_lang_word": "inktvis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inktvis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "af8447b8-2cd6-3582-8120-2b2bd41c8527",
                                        "entry_id": "f7c131e6-96d1-3d57-a663-1d997c529a87",
                                        "glosses": [
                                            "een koppotig weekdier met vangarmen dat een inktachtig vocht afscheidt ter verdediging"
                                        ],
                                        "tags": [
                                            "koppotigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e287358-1e7e-4337-ad61-b6d344dec2e4",
                                                "sense_id": "af8447b8-2cd6-3582-8120-2b2bd41c8527",
                                                "text": "Mijn kennis is bang voor inktvissen."
                                            }
                                        ]
