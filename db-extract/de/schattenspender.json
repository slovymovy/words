                "senses": [
                    {
                        "sense_id": "cde227dd-657b-3c7d-91b3-d3938d02dc48",
                        "entry_id": "576a2e10-900c-38b6-a031-a71aa9c8924f",
                        "glosses": [
                            "ein Gegenstand der einen Schatten wirft, um Schutz vor der direkten Wärmeeinstrahlung der Sonne zu bieten"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1777750d-6218-4216-82ce-b6f340533488",
                                "sense_id": "cde227dd-657b-3c7d-91b3-d3938d02dc48",
                                "text": "Der Sonnenschirm ist ein guter Schattenspender."
                            },
                            {
                                "example_id": "be175952-768b-436f-bb54-ca15c3cd5225",
                                "sense_id": "cde227dd-657b-3c7d-91b3-d3938d02dc48",
                                "text": "Während Bäume und Büsche natürliche Schattenspender sind, werden auch oft Pavillons und Mauern verwandt, um vor starker Sonne Schutz zu bieten."
                            },
                            {
                                "example_id": "cf9611f1-5421-4a14-b32c-bc23a3df3aaa",
                                "sense_id": "cde227dd-657b-3c7d-91b3-d3938d02dc48",
                                "text": "Einige Arten werden wegen ihrer dekorativen Blätter oder als Schattenspender in Parks und Gärten, also in Gebieten, die nie Frost haben, angepflanzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
