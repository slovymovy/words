                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                        "glosses": [
                            "Péage pour circuler sur les routes."
                        ],
                        "tags": [
                            "Droit d’Ancien Régime"
                        ],
                        "examples": []
                    }
                ],
