                "translations": [
                    {
                        "translation_id": "6f730e98-16a6-4345-b974-cbcb3a78bf96",
                        "source_entry_id": "3e831f91-90fd-388c-bd3e-b5e46a83d6b2",
                        "source_sense_id": "1eb6c40b-908c-328c-844c-64f9926bd394",
                        "target_lang_word": "schlampig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlampig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa2907d-cbcc-3716-9873-9a85c61ab50e",
                                        "entry_id": "dcbadbf3-6579-3600-908e-0b87d8a5a1b9",
                                        "glosses": [
                                            "ungepflegt, unordentlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e1f7fa-e549-4612-9ff7-5d486b3cd799",
                                                "sense_id": "4fa2907d-cbcc-3716-9873-9a85c61ab50e",
                                                "text": "Sein schlampiges Äußeres lässt nichts Gutes erwarten."
                                            },
                                            {
                                                "example_id": "1cf7bc2b-b370-4f7d-817b-1c46417b1c07",
                                                "sense_id": "4fa2907d-cbcc-3716-9873-9a85c61ab50e",
                                                "text": "„Sie war so unglaublich schillernd und elegant, daß Isabel sich daneben schlampig und langweilig vorkam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                        "entry_id": "dcbadbf3-6579-3600-908e-0b87d8a5a1b9",
                                        "glosses": [
                                            "nachlässig, ohne Sorgfalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b27be1f-1f4f-46d2-9464-f5cb52dd0aaf",
                                                "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                                "text": "Die Arbeit wurde so schlampig ausgeführt, dass sie gleich nochmals getätigt werden musste."
                                            },
                                            {
                                                "example_id": "2af55a17-eb81-498f-9753-b60333b9376b",
                                                "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                                "text": "„Isabel dachte an ihren schlampig geführten Ordner »Auf bessere Zeiten«, der mit keinem Aktensystem in der Kripo verbunden war.“"
                                            },
                                            {
                                                "example_id": "011c03bf-1cb7-4635-8baf-af1aaee87641",
                                                "sense_id": "0a0a3eac-e9f3-376d-9a13-8a80e61e0727",
                                                "text": "„[…] bearbeitete Justus pünktlich und zuverlässig, ganz zur Freude seiner Eltern und zum Nutzen von Jasmin, die in diesem Punkt eher schlampig war und unzuverlässig und so häufig auf Justus zurückgriff und hastig Anfang und Ende der Texte in ihr Aufgabenheft kritzelte, den Mittelteil ließ sie aus Zeitnot meist weg, den Lehrern fiel dies sowieso nur in den seltensten Fällen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e39013b2-b35b-48da-8887-b7b31d8ffb79",
                        "source_entry_id": "3e831f91-90fd-388c-bd3e-b5e46a83d6b2",
                        "source_sense_id": "1eb6c40b-908c-328c-844c-64f9926bd394",
                        "target_lang_word": "unordentlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unordentlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0ec6ecb-af15-36fd-adb0-9104d0a9e9cc",
                                        "entry_id": "e9993870-e9d7-3c13-a80c-a5b0f669485a",
                                        "glosses": [
                                            "nicht ordentlich; ohne Ordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dda35935-6599-4f2c-8327-dcf1c5c76a3a",
                                                "sense_id": "d0ec6ecb-af15-36fd-adb0-9104d0a9e9cc",
                                                "text": "Dein Zimmer ist sehr unordentlich. Bitte räum es auf."
                                            },
                                            {
                                                "example_id": "2445fd9d-962c-4f99-b1cf-fcd79537b27f",
                                                "sense_id": "d0ec6ecb-af15-36fd-adb0-9104d0a9e9cc",
                                                "text": "Er ist ein eher unordentlicher Mitarbeiter. Er lässt immer alles liegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8023421f-ba92-4588-8e27-34135c573511",
                        "source_entry_id": "3e831f91-90fd-388c-bd3e-b5e46a83d6b2",
                        "source_sense_id": "1eb6c40b-908c-328c-844c-64f9926bd394",
                        "target_lang_word": "безалаберный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "безалаберный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3bdd8c19-33af-38c5-b8b9-fd0be902d48f",
                                        "entry_id": "a370c1fe-5627-344f-a593-c9ef46f99f97",
                                        "glosses": [
                                            "разг. беспорядочный в своём образе жизни, поступках; отличающийся неорганизованностью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a45c83-094e-432d-b39e-8a74f289c8aa",
                                                "sense_id": "3bdd8c19-33af-38c5-b8b9-fd0be902d48f",
                                                "text": "Нет, против этого нечего спорить; Беневольский, конечно, шут, ни на что не похож, безалаберная голова〈…〉"
                                            },
                                            {
                                                "example_id": "5a894cd9-cc1b-4768-bbf5-2f00f23ce6ae",
                                                "sense_id": "3bdd8c19-33af-38c5-b8b9-fd0be902d48f",
                                                "text": "Но постоянные и непроизводительные траты, безалаберные долги, обеспечиваемые ещё более безалаберными векселями, ловкий исподвольный грабеж Хлебонасущенского с братией и иные подобные причины расстроили вконец это состояние, которое по сей день продолжало ещё кое-как держаться одним лишь миражным отблеском прежнего величия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
