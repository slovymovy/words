                    },
                    {
                        "translation_id": "ad96550d-6ebd-43fd-9d32-8dce08a3335b",
                        "source_entry_id": "ac71dcb6-16d7-335e-9919-a113c980d415",
                        "source_sense_id": "fa38068d-ac28-36e7-ab0b-bc9e007f2a63",
                        "source_sense_description": "Married woman's gallant or lover",
                        "target_lang_word": "Hausfreund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausfreund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8046b62-8a4e-352c-88aa-fdae4cd6c2d8",
                                        "entry_id": "f9f1acee-8466-3f04-af06-c02d7accd6f2",
                                        "glosses": [
                                            "vertrauter Freund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee03591e-2ec6-434d-8d0c-bf40335d55e6",
                                                "sense_id": "d8046b62-8a4e-352c-88aa-fdae4cd6c2d8",
                                                "text": "Wir haben einen alten Hausfreund zum Essen eingeladen."
                                            },
                                            {
                                                "example_id": "53ff1765-5f73-419a-b395-7b8fe6d13086",
                                                "sense_id": "d8046b62-8a4e-352c-88aa-fdae4cd6c2d8",
                                                "text": "„Zu den vielen jungen Leuten, die nach Hélènes Rückkehr aus Erfurt Tag für Tag in ihrem Hause zu finden waren, gehörte auch Boris Drubezkoi, der in seiner Karriere viel Glück gehabt hatte und jetzt bei Besuchows die Rolle eines vertrauten Hausfreundes spielte.“"
                                            },
                                            {
                                                "example_id": "80567ceb-0900-4de8-a855-2eadb43ebb0c",
                                                "sense_id": "d8046b62-8a4e-352c-88aa-fdae4cd6c2d8",
                                                "text": "„Drüben aber leerte sich die Loge, darin nur Cécile mit ihrem Hausfreund zurückblieb.“"
                                            },
                                            {
                                                "example_id": "a71830a6-20d9-49a6-919a-20e51b1ef351",
                                                "sense_id": "d8046b62-8a4e-352c-88aa-fdae4cd6c2d8",
                                                "text": "„Als ich abends zum Orgelunterricht komme, sitzen dort zwei Hausfreunde vom Organisten, beide von der Polizei, der eine scheu, der andere dreist, beide lernen bei ihm Orgel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35485862-04c4-3d68-bf22-eb7bd4d6f9e7",
                                        "entry_id": "f9f1acee-8466-3f04-af06-c02d7accd6f2",
                                        "glosses": [
                                            "Geliebter einer verheirateten Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e25d3f1-af44-4a9b-948f-6b2c61958ded",
                                                "sense_id": "35485862-04c4-3d68-bf22-eb7bd4d6f9e7",
                                                "text": "\"Übrigens bin ich davon überzeugt, daß Ihnen die Rolle des eleganten Hausfreundes und Verführers keinerlei Schwierigkeiten bereiten wird.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
