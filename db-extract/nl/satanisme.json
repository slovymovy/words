                        "examples": [
                            {
                                "example_id": "c2f373a0-34a5-4eae-81e4-5d26c26ee0b8",
                                "sense_id": "c6e7b5b2-7907-35aa-8837-09be0e7d4a73",
                                "text": "De kern der tegenwoordige revolutionaire partij verkondigt het Atheïsme, ja komt gedeeltelijk rond voor het Satanisme uit.",
                                "translation": "The inner circle of the contemporary revolutionary party preaches Atheism, and frankly partly supports Satanism.",
                                "english": "The inner circle of the contemporary revolutionary party preaches Atheism, and frankly partly supports Satanism."
                            },
                            {
                                "example_id": "ddb705e0-a970-4eb1-bb56-8cbe832d58e2",
                                "sense_id": "c6e7b5b2-7907-35aa-8837-09be0e7d4a73",
                                "text": "De kleine Hansel, die in de val loopt is het Duitse volk, de gevangene der Kerk, en nu gebonden met de ketens der dogma's, voorschriften, en geboden van Jehova, en overgeleverd aan de vraatzucht en het Satanisme van Rome en Juda.",
                                "translation": "The little Hansel, who walks into a trap is the German people, the prisoner of the Church, and now bound with chains and dogmas, and commandments of Jehovah, and handed over to the greediness and the Satanism of Rome and Judas.",
                                "english": "The little Hansel, who walks into a trap is the German people, the prisoner of the Church, and now bound with chains and dogmas, and commandments of Jehovah, and handed over to the greediness and the Satanism of Rome and Judas."
                            },
                            {
                                "example_id": "4cc6756f-dd50-4fd8-8aa5-c5a13ced511f",
                                "sense_id": "c6e7b5b2-7907-35aa-8837-09be0e7d4a73",
                                "text": "In de muziek zou satanisme worden beleden en god worden vervloekt.",
                                "translation": "In the music satanism would be professed and God would be cursed.",
                                "english": "In the music satanism would be professed and God would be cursed."
                            }
                        ]
                    }
