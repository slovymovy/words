                "senses": [
                    {
                        "sense_id": "e31b8296-77ee-3ae1-818b-8cbee9e7f43f",
                        "entry_id": "a9187031-90f6-39f4-8d42-aac59bd6e0a1",
                        "glosses": [
                            "Wissenschaftler, der Anhänger des Nationalsozialismus ist/während der Zeit des Nationalsozialismus tätig war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f075061-7cfa-40ce-afa8-4d0b957db991",
                                "sense_id": "e31b8296-77ee-3ae1-818b-8cbee9e7f43f",
                                "text": "„Meine Mom sagte, wenn es eine Hölle gäbe, käme man da hin, weil man Pelzmäntel getragen oder eine Haarspülung benutzt habe, die von geflohenen Naziwissenschaftlern in Frankreich an kleinen Häschen getestet worden seien.“"
                            },
                            {
                                "example_id": "1abaad21-d422-42a1-a409-5f25b3fc052c",
                                "sense_id": "e31b8296-77ee-3ae1-818b-8cbee9e7f43f",
                                "text": "„Wussten Sie, dass viele von Mengeles Entdeckungen in die Vereinigten Staaten gelangten, und zwar im Rahmen des so genannten ›Project Paperclip‹, das Naziwissenschaftlern Straferlass gewährte und zu neuen Identitäten verhalf, wenn sie über Mengeles Forschungsergebnisse Auskunft erteilten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
