        "nl-extract.jsonl": [
            {
                "entry_id": "0fa64925-ee4e-3d4a-b890-ec9363e7cf6b",
                "word": "smeergeld",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f5fabdf5-702e-420d-8a7b-1d80aa5676d1",
                        "entry_id": "0fa64925-ee4e-3d4a-b890-ec9363e7cf6b",
                        "tags": [
                            "plural"
                        ],
                        "form": "smeergelden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                        "entry_id": "0fa64925-ee4e-3d4a-b890-ec9363e7cf6b",
                        "glosses": [
                            "geld waarmee een corrupte functionaris wordt omgekocht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a363cbd7-02a4-4eb7-8850-73684735d214",
                                "sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                                "text": "\"Secretaris-generaal FIFA maakte 10 miljoen dollar aan smeergeld over\""
                            },
                            {
                                "example_id": "92daa3c9-2476-4073-8df1-7431c78c91ec",
                                "sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                                "text": "Corruptie, smeergeld, ontbossing: Nederland krijgt er met vleesgigant JBS een omstreden multinational bij."
                            },
                            {
                                "example_id": "74143d71-51dc-4cf9-99d2-ecb462b7a8ae",
                                "sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                                "text": "Daar betoogde hij vol vuur dat het Brits-Nederlandse Shell in 2011 samen met het Italiaanse Eni een miljard dollar aan smeergeld had betaald om een groot olieveld voor de kust van Nigeria in handen te krijgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4407eb7e-a578-423d-ae1e-556f72a00c84",
                        "source_entry_id": "0fa64925-ee4e-3d4a-b890-ec9363e7cf6b",
                        "source_sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                        "target_lang_word": "Schmiergeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmiergeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                        "entry_id": "74c02463-cafb-30c3-bc24-55247fc151aa",
                                        "glosses": [
                                            "Geld, mit dem jemand bestochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3908c622-f7d4-4ab0-83c8-26b2caaf3907",
                                                "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                                "text": "Er musste wegen der Annahme von Schmiergeld von seinem Posten zurücktreten."
                                            },
                                            {
                                                "example_id": "49e5ab24-872f-4651-b7cb-04566d19214c",
                                                "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                                "text": "„Insgesamt mindestens 150 Millionen Dollar zahlt der CIA über verschwiegene Kanäle als Schmiergeld an Mobutu und seine Entourage.“"
                                            },
                                            {
                                                "example_id": "04fb9c7d-1110-4d68-8538-d24c6443def6",
                                                "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                                "text": "„Beim Kauf der Eurofighter durch Österreich sollen Schmiergelder geflossen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "446a4db5-84bd-4546-9002-b797598602df",
                        "source_entry_id": "0fa64925-ee4e-3d4a-b890-ec9363e7cf6b",
                        "source_sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                        "target_lang_word": "Bestechungsgeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestechungsgeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                        "entry_id": "779a7656-7cdc-396d-bca7-97d5bd1cadbc",
                                        "glosses": [
                                            "finanzielle Zuwendung mit der Absicht, deren Empfänger zu rechtswidrigem Handeln zu bewegen, um daraus einen unlauteren Vorteil zu erlangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50d605c-f933-4077-b381-b05b3817c9e5",
                                                "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                                "text": "„Brasiliens Präsident Temer wird vorgeworfen, rund 130.000 Euro Bestechungsgeld angenommen haben.“"
                                            },
                                            {
                                                "example_id": "23b0950e-1443-48ce-989a-2f3ce979eff0",
                                                "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                                "text": "„Die Wahl hatte den neunzehnjährigen Karl Bestechungsgelder in der sagenhaften Höhe von 852000 Goldgulden gekostet.“"
                                            },
                                            {
                                                "example_id": "144e22b8-92f1-4e57-8611-f6d584633127",
                                                "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                                "text": "„Gerüchte kursieren über Bestechungsgelder an SS-Angehörige, die angeblich eine »Arisierung« erreichen oder illegale Grenzübertritte organisieren können, hilfsbereite Freunde melden sich mit »glänzenden Verbindungen«, die sich immer wieder als Schimäre erweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfc0c771-155a-4ffa-a067-f92227fba462",
                        "source_entry_id": "0fa64925-ee4e-3d4a-b890-ec9363e7cf6b",
                        "source_sense_id": "834619ee-b127-3002-b4cf-8008b6ed7e16",
                        "target_lang_word": "bribe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42af7552-308f-35c6-a5d1-1c4cd1e4c6cb",
                                        "entry_id": "64816b9b-8379-3242-8e49-7b74120396ed",
                                        "glosses": [
                                            "Something (usually money) given in exchange for influence or as an inducement to breaking the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02251403-2eae-40c9-824a-ba0cf73da04d",
                                                "sense_id": "42af7552-308f-35c6-a5d1-1c4cd1e4c6cb",
                                                "text": "c. 1613-1625, Henry Hobart, Yardly v. Ellill\nUndue reward for anything against justice is a bribe."
                                            },
                                            {
                                                "example_id": "1ed4c9e0-f4fe-4808-aedb-9e78a34a213f",
                                                "sense_id": "42af7552-308f-35c6-a5d1-1c4cd1e4c6cb",
                                                "text": "The bribes I took did not influence me to become evil. I was evil from the beginning and the bribes were merely a bonus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a492d11-6887-3a1b-b140-7f567d6b9673",
                                        "entry_id": "64816b9b-8379-3242-8e49-7b74120396ed",
                                        "glosses": [
                                            "The act of offering or paying such a payment: an act of bribery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a80b36db-c047-3b6f-90c7-b82587204e81",
                                        "entry_id": "64816b9b-8379-3242-8e49-7b74120396ed",
                                        "glosses": [
                                            "That which seduces; seduction; allurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d2cb683-98cf-4030-abfb-9a9b9694d858",
                                                "sense_id": "a80b36db-c047-3b6f-90c7-b82587204e81",
                                                "text": "Not the bribes of sordid wealth can seduce to leave these everblooming sweets."
                                            },
                                            {
                                                "example_id": "06c09dfd-73e1-4db3-8c91-2b9e13cbbbb9",
                                                "sense_id": "a80b36db-c047-3b6f-90c7-b82587204e81",
                                                "text": "Remy, this was a bribe! Our whole marriage has been nothing but a series of bribes!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4439b9c0-4d4f-3333-a79e-044edcc98a24",
                                        "entry_id": "d20e98d6-68f4-31e8-9478-060f3dc73b5b",
                                        "glosses": [
                                            "To give a bribe to; specifically, to ask a person to do something against their original will, in exchange for some type of reward or relief from potential trouble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cf6b863-1035-478c-a832-c0a015ed47ee",
                                                "sense_id": "4439b9c0-4d4f-3333-a79e-044edcc98a24",
                                                "text": "She was accused of trying to bribe the jury into making false statements."
                                            },
                                            {
                                                "example_id": "17606924-b82a-4a3a-87cb-a7379bc2d17c",
                                                "sense_id": "4439b9c0-4d4f-3333-a79e-044edcc98a24",
                                                "text": "October 23, 1848, Frederick William Robertson, an address delivered at the Opening of The Working Men's Institute\nNeither is he worthy who bribes a man to vote against his conscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d09284-a10e-344a-a522-5214e7b4b8e0",
                                        "entry_id": "d20e98d6-68f4-31e8-9478-060f3dc73b5b",
                                        "glosses": [
                                            "To gain by a bribe; to induce as by a bribe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd8dae8c-0f9f-4b0e-a841-3e6c8104bb8d",
                                                "sense_id": "11d09284-a10e-344a-a522-5214e7b4b8e0",
                                                "text": "to bribe somebody's compliance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
