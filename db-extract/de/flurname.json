                "senses": [
                    {
                        "sense_id": "b1b8ce01-2bc5-3687-94af-2fc2423dc99c",
                        "entry_id": "01779c2d-404b-3db4-8a35-df4183657840",
                        "glosses": [
                            "die Benennung von landwirtschaftlich genutzten Gebieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb510ba-ff28-4f7b-b676-2da9fc9a3922",
                                "sense_id": "b1b8ce01-2bc5-3687-94af-2fc2423dc99c",
                                "text": "Flurnamen gestatten oft einen tiefen Einblick in Siedlungs- und Sprachgeschichte eines bestimmten Gebietes."
                            },
                            {
                                "example_id": "a7e8b7ab-1e7b-4712-9349-36bdacac56a8",
                                "sense_id": "b1b8ce01-2bc5-3687-94af-2fc2423dc99c",
                                "text": "„Schließlich einigte er sich mit den Oberen, das Objekt nach dem Flurnamen zu benennen.“"
                            },
                            {
                                "example_id": "48cf840b-c058-4622-990b-bc258efc755f",
                                "sense_id": "b1b8ce01-2bc5-3687-94af-2fc2423dc99c",
                                "text": "„Die erklärt auch das Interesse verschiedener wissenschaftlicher Disziplinen an den Flurnamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
