    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4da65c75-c995-374a-8267-91b50dadead9",
                    "sense_definition": "Simple past and past participle of <w>morph</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The digital image <w>morphed</w> into a completely different shape before our eyes.",
                            "target_lang_translations": {
                                "zh": "那张数字图像在我们眼前<w>变形</w>成了完全不同的形状。"
                            }
                        },
                        {
                            "text": "The small startup has <w>morphed</w> into a global technology company over the last decade.",
                            "target_lang_translations": {
                                "zh": "在过去十年里，这家小型初创公司已经<w>演变</w>成了一家全球性科技公司。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical inflection"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物或图像经历形态上的逐渐改变或演变。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变形",
                                "target_lang_sense_clarification": "指形状或形态发生改变。"
                            },
                            {
                                "target_lang_word": "演变",
                                "target_lang_sense_clarification": "指事物逐渐发展变化。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "671c011c-a924-3b5b-905b-65ad58545b32",
                    "sense_definition": "Having undergone a transformation or change in form.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transformed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>morphed</w> character looked nothing like the original design.",
                            "target_lang_translations": {
                                "zh": "这个<w>变形</w>后的角色看起来和最初的设计完全不同。"
                            }
                        },
                        {
                            "text": "We analyzed the <w>morphed</w> data to see how the pattern had shifted.",
                            "target_lang_translations": {
                                "zh": "我们分析了<w>变形</w>后的数据，以观察模式是如何转变的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transformed",
                        "altered",
                        "changed"
                    ],
                    "antonyms": [
                        "original",
                        "unchanged"
                    ],
                    "common_phrases": [
                        "morphed image",
                        "morphed state"
                    ],
                    "target_lang_definitions": {
                        "zh": "指已经过形态转换或改变的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变形的",
                                "target_lang_sense_clarification": "形容已经发生形态改变的状态。"
                            },
                            {
                                "target_lang_word": "改变后的",
                                "target_lang_sense_clarification": "指经过处理或转换后的状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
