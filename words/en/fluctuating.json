{
    "word_family": [
        "fluctuate",
        "fluctuation",
        "fluctuant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4f2f26f-ff83-3924-9d24-0983709d32d7",
                    "sense_definition": "Subject to irregular changes in quantity or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fluctuating</w> prices of oil make it difficult for businesses to plan their budgets.",
                            "target_lang_translations": {
                                "zh": "石油价格的<w>波动</w>使得企业难以规划预算。"
                            }
                        },
                        {
                            "text": "She watched the <w>fluctuating</w> light of the candle as it danced against the dark walls.",
                            "target_lang_translations": {
                                "zh": "她看着蜡烛那<w>起伏</w>不定的光影在黑暗的墙壁上跳动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unstable",
                        "variable",
                        "inconsistent"
                    ],
                    "antonyms": [
                        "stable",
                        "constant"
                    ],
                    "common_phrases": [
                        "fluctuating prices",
                        "fluctuating light"
                    ],
                    "target_lang_definitions": {
                        "zh": "指数量或质量上不规则地变化。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "波动",
                                "target_lang_sense_clarification": "指事物起伏不定，常用于价格、数据或物理现象。"
                            },
                            {
                                "target_lang_word": "起伏",
                                "target_lang_sense_clarification": "指高低不平或时高时低，常用于光线、情绪或地形。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21361fff-a807-3046-9ddb-0c57e3d062f0",
                    "sense_definition": "Present participle and gerund of <w>fluctuate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market has been <w>fluctuating</w> wildly throughout the entire week.",
                            "target_lang_translations": {
                                "zh": "整个星期股市一直在剧烈<w>波动</w>。"
                            }
                        },
                        {
                            "text": "By <w>fluctuating</w> the temperature, the scientist was able to observe the reaction more clearly.",
                            "target_lang_translations": {
                                "zh": "通过<w>变动</w>温度，科学家能够更清楚地观察到反应。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物在一定范围内不断地变动或调整。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "波动",
                                "target_lang_sense_clarification": "指事物在一定范围内上下变动。"
                            },
                            {
                                "target_lang_word": "变动",
                                "target_lang_sense_clarification": "指事物发生变化或调整。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee7b2f21-5a00-361b-b4d1-30bbd7183d27",
                    "sense_definition": "An instance of irregular change or variation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fluctuatings</w> in the water level were caused by the heavy rainfall upstream.",
                            "target_lang_translations": {
                                "zh": "水位<w>波动</w>是由上游的强降雨引起的。"
                            }
                        },
                        {
                            "text": "We observed several <w>fluctuatings</w> in the signal strength during the test.",
                            "target_lang_translations": {
                                "zh": "我们在测试过程中观察到了几次信号强度的<w>波动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fluctuation",
                        "variation"
                    ],
                    "target_lang_definitions": {
                        "zh": "指不规则的变化或变动的情况。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "波动",
                                "target_lang_sense_clarification": "指事物发生的不规则起伏现象。"
                            },
                            {
                                "target_lang_word": "变动",
                                "target_lang_sense_clarification": "指事物发生的变化过程。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}