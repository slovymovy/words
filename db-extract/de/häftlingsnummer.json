                "senses": [
                    {
                        "sense_id": "96cd26c2-36b3-3dce-9070-1ef92b430788",
                        "entry_id": "6afaab30-7b75-355d-87cb-6e1efcc4660f",
                        "glosses": [
                            "Registriernummer für einen Häftling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d8a254-2530-4af5-84f4-f6193ef33584",
                                "sense_id": "96cd26c2-36b3-3dce-9070-1ef92b430788",
                                "text": "So ein Zufall: Seine Häftlingsnummer war dieselbe wie die Schulnummer im Gymnasium!"
                            },
                            {
                                "example_id": "8c981ffb-c24f-4abe-a433-3ee381224030",
                                "sense_id": "96cd26c2-36b3-3dce-9070-1ef92b430788",
                                "text": "Wir werden in eine Liste eingetragen und erhalten eine Häftlingsnummer."
                            },
                            {
                                "example_id": "1ab01740-9200-4b19-be05-c09147dd179e",
                                "sense_id": "96cd26c2-36b3-3dce-9070-1ef92b430788",
                                "text": "„Aber es wunderte sie, dass sie plötzlich ihre Häftlingsnummern nicht mehr tragen mussten, mehr zu essen bekamen und die Gitter von den Fenstern entfernt wurden.“"
                            },
                            {
                                "example_id": "fe1a9a44-84ac-42a4-a331-56ceb08c67a1",
                                "sense_id": "96cd26c2-36b3-3dce-9070-1ef92b430788",
                                "text": "„Jeder Häftling erhielt bei der Aufnahme in ein KZ-Stammlager eine Registrierungsnummer (Häftlingsnummer).“"
                            },
                            {
                                "example_id": "97552d62-69d7-4d5a-a716-7bc493bb6bd0",
                                "sense_id": "96cd26c2-36b3-3dce-9070-1ef92b430788",
                                "text": "„Am Ende des Romans stirbt 509, aber aus der Häftlingsnummer ist wieder ein Mensch geworden; erstmals nach Jahren verwendet er gegenüber seinen Mitgefangenen wieder seinen bürgerlichen Namen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
