{
    "word_family": [
        "disastrous",
        "disastrously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c5c7462-614d-3c44-abe8-a726818a241f",
                    "sense_definition": "An unexpected natural or man-made event that causes great damage, destruction, or loss of life.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bad_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The earthquake was a major <w>disaster</w> that destroyed many homes.",
                            "target_lang_translations": {
                                "ru": "Землетрясение стало крупной <w>катастрофой</w>, разрушившей множество домов.",
                                "zh": "那场地震是一场重大<w>灾难</w>，摧毁了许多房屋。"
                            }
                        },
                        {
                            "text": "The government sent immediate aid to the victims of the natural <w>disaster</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство направило немедленную помощь жертвам стихийного <w>бедствия</w>.",
                                "zh": "政府向自然<w>灾害</w>的受害者提供了紧急援助。"
                            }
                        }
                    ],
                    "synonyms": [
                        "catastrophe",
                        "calamity",
                        "tragedy"
                    ],
                    "common_phrases": [
                        "natural disaster",
                        "disaster area",
                        "disaster relief",
                        "environmental disaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданное событие природного или техногенного характера, вызывающее огромные разрушения или гибель людей.",
                        "zh": "指造成巨大破坏、毁灭或生命损失的突发性自然或人为事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катастрофа",
                                "target_lang_sense_clarification": "событие с трагическими последствиями"
                            },
                            {
                                "target_lang_word": "бедствие",
                                "target_lang_sense_clarification": "крупное несчастье, часто в сочетании «стихийное бедствие»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灾难",
                                "target_lang_sense_clarification": "指造成严重后果的重大不幸事件"
                            },
                            {
                                "target_lang_word": "灾害",
                                "target_lang_sense_clarification": "常用于自然灾害，指造成损失的事件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0e2b15e-9c6f-3cdf-ae7b-94a190250e5a",
                    "sense_definition": "A complete failure or a very bad and upsetting situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "bad_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My first attempt at cooking dinner for the guests was a total <w>disaster</w>.",
                            "target_lang_translations": {
                                "ru": "Моя первая попытка приготовить ужин для гостей обернулась полной <w>катастрофой</w>.",
                                "zh": "我第一次为客人做晚饭，结果简直是一场<w>惨败</w>。"
                            }
                        },
                        {
                            "text": "Ignoring the safety warnings is a recipe for <w>disaster</w>.",
                            "target_lang_translations": {
                                "ru": "Игнорирование предупреждений о безопасности — это верный путь к <w>беде</w>.",
                                "zh": "无视安全警告是通往<w>灾难</w>的捷径。"
                            }
                        }
                    ],
                    "synonyms": [
                        "catastrophe",
                        "calamity"
                    ],
                    "common_phrases": [
                        "total disaster",
                        "recipe for disaster",
                        "spell disaster",
                        "end in disaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный провал или очень плохая, неприятная ситуация.",
                        "zh": "指彻底的失败或非常糟糕、令人沮丧的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катастрофа",
                                "target_lang_sense_clarification": "перен. крупная неудача, фиаско"
                            },
                            {
                                "target_lang_word": "провал",
                                "target_lang_sense_clarification": "полная неудача в каком-либо деле"
                            },
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "несчастье, неприятность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "指彻底的失败"
                            },
                            {
                                "target_lang_word": "一团糟",
                                "target_lang_sense_clarification": "形容情况非常混乱或糟糕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e7fd0e-ceb1-3494-ab41-77e5b281d77f",
                    "sense_definition": "A skateboard trick involving a 180-degree turn and landing with the board on the edge of the ramp.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He practiced the <w>disaster</w> on the half-pipe until he could land it perfectly.",
                            "target_lang_translations": {
                                "ru": "Он отрабатывал <w>дизастер</w> на хафпайпе, пока не смог выполнять его идеально.",
                                "zh": "他在U型池上练习<w>灾难动作</w>，直到能完美落地。"
                            }
                        },
                        {
                            "text": "The skater impressed the judges by performing a difficult <w>disaster</w>.",
                            "target_lang_translations": {
                                "ru": "Скейтер впечатлил судей, выполнив сложный <w>дизастер</w>.",
                                "zh": "这位滑手通过完成一个高难度的<w>灾难动作</w>给评委留下了深刻印象。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трюк на скейтборде, включающий разворот на 180 градусов и приземление доской на край рампы.",
                        "zh": "一种滑板特技，涉及180度转体并将滑板降落在坡道边缘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дизастер",
                                "target_lang_sense_clarification": "название трюка (транслитерация)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灾难动作",
                                "target_lang_sense_clarification": "滑板特技名称的意译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}