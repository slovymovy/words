                "senses": [
                    {
                        "sense_id": "278fb104-50f7-3c22-9dbb-ed142ceeb475",
                        "entry_id": "7e27b136-6bb7-3dc1-aad4-90f62dd572ea",
                        "glosses": [
                            "Stoß mit einem Bein einer Kuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19edc27-9eb8-4afa-9d7a-b02f41d33c6a",
                                "sense_id": "278fb104-50f7-3c22-9dbb-ed142ceeb475",
                                "text": "\"Kuhtritt in 1. Nierengegend. Teigige Infiltration der 1. Lumbalgegend. Blut und Nierenepithelien im Urin. Anämie. Probelaparotomie. Geheilt in 14 Tagen.\""
                            },
                            {
                                "example_id": "aceab0e0-affd-43ae-8e99-751a332d9e17",
                                "sense_id": "278fb104-50f7-3c22-9dbb-ed142ceeb475",
                                "text": "\"Kuhtritt löste tiefe Stichwunde durch Messer aus\""
                            },
                            {
                                "example_id": "da3f26c6-ea79-4ff3-9119-5d388980ed2e",
                                "sense_id": "278fb104-50f7-3c22-9dbb-ed142ceeb475",
                                "text": "\"Zwar gab Richter Johannes Munding den beiden Streitparteien als Überlegung mit auf den Weg, dass man »vor Gericht und auf hoher See in Gottes Hand sei«, sprich, dass man nie sicher sein könne, wie ein Verfahren über die Instanzen hinweg ausgeht, doch hält er einerseits den Kuhtritt als eine Art Berufsrisiko für einen Tierarzt und außerdem die Forderungen als zu hoch angesetzt. \""
                            },
                            {
                                "example_id": "949c8aca-dc11-4fc6-a14b-21801cc61380",
                                "sense_id": "278fb104-50f7-3c22-9dbb-ed142ceeb475",
                                "text": "\"Kein Schmerzensgeld nach Kuhtritt: Ein Tierarzt ist mit seiner Klage gegen den Besitzer einer wild gewordenen Kuh vor Gericht gescheitert.\""
                            },
                            {
                                "example_id": "ecff0794-7c29-4302-aec0-0bdb86b8ecec",
                                "sense_id": "278fb104-50f7-3c22-9dbb-ed142ceeb475",
                                "text": "\"Der Geyers Koarl aus Nemmersdorf – er berichtete unter anderem von der „Margaret, deren Hintern grün und blau von einem Kuhtritt war“ und von Tischverwechslungen im Hertie-Restaurant – aber auch der Wirths Karl aus Helmbrechts, der mit Gedichten die Hochfranken und den Steinwald huldigte, waren dem Ruf gefolgt und unterhielten die Anwesenden mit Anekdoten.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f7bf631-6649-365c-9460-7231be0dd801",
                        "entry_id": "7e27b136-6bb7-3dc1-aad4-90f62dd572ea",
                        "glosses": [
                            "versteinerter Megalodont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76feaaeb-cfcc-4fe5-83bf-135a5f3b7084",
                                "sense_id": "6f7bf631-6649-365c-9460-7231be0dd801",
                                "text": "Nach fünf Stunden Wanderung fanden wir endlich einen Kuhtritt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f85dfe6d-05ee-39b4-bb69-a8f3904b4e59",
                        "entry_id": "7e27b136-6bb7-3dc1-aad4-90f62dd572ea",
                        "glosses": [
                            "Blütenpflanze der Karnischen Alpen aus der Familie der Rachenblütler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c95182-4070-4f93-b9c7-202d06741671",
                                "sense_id": "f85dfe6d-05ee-39b4-bb69-a8f3904b4e59",
                                "text": "Der Kuhtritt blühte besonders früh."
                            }
                        ],
                        "sense_index_json": "\"3\""
