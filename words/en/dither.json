{
    "word_family": [
        "ditherer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0215e428-96d9-3eaf-b288-76e093a8252a",
                    "sense_definition": "To hesitate, vacillate, or be unable to make a clear decision.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "indecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>dithering</w> and choose which restaurant you want to visit tonight.",
                            "target_lang_translations": {
                                "de": "Hör auf zu <w>zögern</w> und entscheide, in welches Restaurant du heute Abend gehen möchtest."
                            }
                        },
                        {
                            "text": "The committee wasted weeks <w>dithering</w> over minor budget allocations.",
                            "target_lang_translations": {
                                "de": "Der Ausschuss vergeudete Wochen damit, wegen kleinerer Budgetposten <w>herumzudrucksen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitate",
                        "vacillate",
                        "waver"
                    ],
                    "antonyms": [
                        "decide"
                    ],
                    "common_phrases": [
                        "dither over",
                        "stop dithering"
                    ],
                    "target_lang_definitions": {
                        "de": "Zögern, unschlüssig sein oder keine klare Entscheidung treffen können."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zögern",
                                "target_lang_sense_clarification": "unentschlossen abwarten"
                            },
                            {
                                "target_lang_word": "herumdrucksen",
                                "target_lang_sense_clarification": "umgangssprachlich für unschlüssig zögern"
                            },
                            {
                                "target_lang_word": "wanken",
                                "target_lang_sense_clarification": "unentschlossen hin und her schwanken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dcff13d-4603-31aa-a504-267248071be6",
                    "sense_definition": "To tremble, shake, or shiver, typically from cold or fear.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poor dog was left outside in the rain, <w>dithering</w> with cold.",
                            "target_lang_translations": {
                                "de": "Der arme Hund wurde draußen im Regen gelassen und <w>zitterte</w> vor Kälte."
                            }
                        },
                        {
                            "text": "He stood by the icy lake, his limbs <w>dithering</w> before he could jump in.",
                            "target_lang_translations": {
                                "de": "Er stand am eisigen See und seine Glieder <w>bebten</w>, bevor er hineinspringen konnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiver",
                        "shiver",
                        "tremble"
                    ],
                    "common_phrases": [
                        "dither with cold"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily regional or dialectal use"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Zittern oder beben, typischerweise vor Kälte oder Angst."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zittern",
                                "target_lang_sense_clarification": "vor Kälte oder Angst"
                            },
                            {
                                "target_lang_word": "beben",
                                "target_lang_sense_clarification": "unkontrolliert schaudern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c46a807-45f4-3fac-bf8c-0c9a09b2af66",
                    "sense_definition": "To act in a nervous, agitated, or flustered manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nervousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the morning <w>dithering</w> around the house before her interview.",
                            "target_lang_translations": {
                                "de": "Sie verbrachte den Vormittag vor ihrem Vorstellungsgespräch damit, nervös im Haus <w>herumzuflattern</w>."
                            }
                        },
                        {
                            "text": "He tended to <w>dither</w> nervously whenever guests arrived unexpectedly.",
                            "target_lang_translations": {
                                "de": "Er neigte dazu, nervös <w>herumzuhantieren</w>, wann immer unerwartet Gäste eintrafen."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuss"
                    ],
                    "common_phrases": [
                        "dither around",
                        "dither about"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich nervös, aufgeregt oder fahrig verhalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "herumflattern",
                                "target_lang_sense_clarification": "nervös und fahrig umherlaufen"
                            },
                            {
                                "target_lang_word": "nervös herumhantieren",
                                "target_lang_sense_clarification": "unruhig und fahrig handeln"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d53379ce-870a-3950-a9d5-6833c1625dd1",
                    "sense_definition": "To approximate colors or smooth gradients in digital graphics by using dot patterns.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software can <w>dither</w> the image to reduce the overall file size.",
                            "target_lang_translations": {
                                "de": "Die Software kann das Bild <w>rastern</w>, um die Gesamtdateigröße zu reduzieren."
                            }
                        },
                        {
                            "text": "Older video games often had to <w>dither</w> backgrounds to create shading effects.",
                            "target_lang_translations": {
                                "de": "Ältere Videospiele mussten Hintergründe oft <w>dithern</w>, um Schattierungseffekte zu erzeugen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Farben oder Farbverläufe in Computergrafiken mithilfe von Punktmustern annähern (Rastern)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rastern",
                                "target_lang_sense_clarification": "Farbverläufe durch Punktmuster erzeugen"
                            },
                            {
                                "target_lang_word": "dithern",
                                "target_lang_sense_clarification": "Fachbegriff in der Computergrafik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aef86de8-7a90-3ba2-9863-330d38c0cb28",
                    "sense_definition": "To intentionally add a small amount of random noise to digital audio or data to reduce quantization distortion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Audio engineers typically <w>dither</w> the final mix when exporting to sixteen bits.",
                            "target_lang_translations": {
                                "de": "Toningenieure wenden beim Exportieren auf sechzehn Bit typischerweise <w>Dithering</w> auf den finalen Mix an."
                            }
                        },
                        {
                            "text": "Failing to <w>dither</w> the recording properly introduced audible distortion in quiet passages.",
                            "target_lang_translations": {
                                "de": "Die Aufnahme nicht ordnungsgemäß zu <w>dithern</w> führte zu hörbaren Verzerrungen in leisen Passagen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einem digitalen Audio- oder Datensignal gezielt ein schwaches Rauschen hinzufügen, um Quantisierungsfehler zu mindern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dithern",
                                "target_lang_sense_clarification": "Dither-Rauschen beimischen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49e41b64-ac26-3d86-ab62-84e96734e893",
                    "sense_definition": "A state of nervous excitement, anxiety, or confusion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "nervousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was in such a <w>dither</w> that she forgot her passport at home.",
                            "target_lang_translations": {
                                "de": "Sie war in solcher <w>Aufregung</w>, dass sie ihren Reisepass zu Hause vergaß."
                            }
                        },
                        {
                            "text": "The entire office got into a <w>dither</w> when the auditor arrived unannounced.",
                            "target_lang_translations": {
                                "de": "Das gesamte Büro geriet in <w>Aufruhr</w>, als der Wirtschaftsprüfer unangekündigt eintraf."
                            }
                        }
                    ],
                    "synonyms": [
                        "fluster",
                        "fret",
                        "tizzy"
                    ],
                    "antonyms": [
                        "calm"
                    ],
                    "common_phrases": [
                        "in a dither"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in colloquial speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand nervöser Unruhe, Aufregung oder Verwirrung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Aufregung",
                                "target_lang_sense_clarification": "Zustand nervöser Hektik"
                            },
                            {
                                "target_lang_word": "Nervosität",
                                "target_lang_sense_clarification": "innere Unruhe oder Fahrigkeit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc711ec0-6906-3783-8b7b-9824be7bb599",
                    "sense_definition": "A state of indecision or hesitation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "indecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His prolonged <w>dither</w> over whether to sell the company cost him millions.",
                            "target_lang_translations": {
                                "de": "Sein langes <w>Zögern</w> bei der Frage, ob er das Unternehmen verkaufen solle, kostete ihn Millionen."
                            }
                        },
                        {
                            "text": "The party leaders are in a <w>dither</w> over their economic policy.",
                            "target_lang_translations": {
                                "de": "Die Parteiführung befindet sich in einer Phase der <w>Unentschlossenheit</w> bezüglich ihrer Wirtschaftspolitik."
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitation",
                        "indecision",
                        "vacillation"
                    ],
                    "antonyms": [
                        "decisiveness"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand der Unschlüssigkeit oder des Zögerns."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Unentschlossenheit",
                                "target_lang_sense_clarification": "Fehlen einer klaren Entscheidung"
                            },
                            {
                                "target_lang_word": "Zögern",
                                "target_lang_sense_clarification": "langes Abwarten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97b38f0b-b2f0-3b59-b962-b5b2cd7e2ccf",
                    "sense_definition": "A trembling or shivering movement, usually caused by cold or fear.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>dither</w> overtook his body as the freezing wind hit him.",
                            "target_lang_translations": {
                                "de": "Ein plötzliches <w>Zittern</w> erfasste seinen Körper, als der eiskalte Wind ihn traf."
                            }
                        },
                        {
                            "text": "The chill gave her an uncontrollable <w>dither</w> that lasted several minutes.",
                            "target_lang_translations": {
                                "de": "Die Kälte versetzte sie in ein unkontrollierbares <w>Schaudern</w>, das mehrere Minuten anhielt."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiver",
                        "shiver",
                        "tremble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zittern oder Schaudern, meist ausgelöst durch Kälte oder Furcht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Zittern",
                                "target_lang_sense_clarification": "durch Kälte oder Angst"
                            },
                            {
                                "target_lang_word": "Schaudern",
                                "target_lang_sense_clarification": "kurzes körperliches Zusammenzucken vor Kälte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa679073-88ef-3c36-8aae-c0c21678fa4a",
                    "sense_definition": "The use of dot patterns in a digital graphic to approximate colors not supported by the display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Applying <w>dither</w> helped make the low-resolution graphic appear much smoother.",
                            "target_lang_translations": {
                                "de": "Das Anwenden von <w>Dithering</w> trug dazu bei, dass die niedrig aufgelöste Grafik deutlich weicher wirkte."
                            }
                        },
                        {
                            "text": "The retro video game relied heavily on <w>dither</w> to create gradients.",
                            "target_lang_translations": {
                                "de": "Das Retro-Videospiel setzte stark auf <w>Rasterung</w>, um Verläufe darzustellen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Verwendung von Punktmustern in Grafiken, um nicht direkt darstellbare Farben anzunähern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dithering",
                                "target_lang_sense_clarification": "Rasterverfahren in der Bildverarbeitung"
                            },
                            {
                                "target_lang_word": "Rastern",
                                "target_lang_sense_clarification": "Erzeugung von Halbtönen durch Punkte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "645209ea-537f-34d1-9121-5b8b106fb2b0",
                    "sense_definition": "Low-level noise intentionally added to digital signals to minimize distortion and artifacts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding <w>dither</w> prevents unwanted distortion when converting high-resolution audio files.",
                            "target_lang_translations": {
                                "de": "Das Hinzufügen von <w>Dither-Rauschen</w> verhindert unerwünschte Verzerrungen bei der Konvertierung hochauflösender Audiodateien."
                            }
                        },
                        {
                            "text": "Proper use of <w>dither</w> is essential in professional audio mastering.",
                            "target_lang_translations": {
                                "de": "Der richtige Einsatz von <w>Dither</w> ist beim professionellen Audio-Mastering unverzichtbar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein absichtlich beigemischtes schwaches Rauschsignal zur Minimierung digitaler Verzerrungen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dither",
                                "target_lang_sense_clarification": "beigemischtes Rauschsignal in der Tontechnik"
                            },
                            {
                                "target_lang_word": "Dither-Rauschen",
                                "target_lang_sense_clarification": "Signalrauschen zur Quantisierungsfehlerreduktion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}