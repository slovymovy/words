                "senses": [
                    {
                        "sense_id": "3b60a613-55f3-34eb-86f6-5ae0f4a6a133",
                        "entry_id": "9c50e820-f7c0-35d2-ad94-951f7973e160",
                        "glosses": [
                            "Relatif à la dynastie d’origine turcomane ayant régné sur l’Iran de 1786 à 1925."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a8cda14-bf3d-4bc5-95d0-23d63e6972b9",
                                "sense_id": "3b60a613-55f3-34eb-86f6-5ae0f4a6a133",
                                "text": "Ces militants de la première heure ont en effet investi, à la faveur de l'insurrection de février, un admirable palais qadjar qui, dit-on, avait appartenu à la chabanou en personne."
                            },
                            {
                                "example_id": "8939d636-7055-4e12-969e-76b508adde65",
                                "sense_id": "3b60a613-55f3-34eb-86f6-5ae0f4a6a133",
                                "text": "[…] La majorité des zoroastriens n’a eu d’autre choix que d’adopter l’islam. Et les réfractaires ont continué a être discriminés, notamment sous l’empire qadjar (1779-1925)."
                            }
                        ]
                    }
                ],
