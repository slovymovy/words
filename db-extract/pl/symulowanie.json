                        "translation_id": "208f139e-6af0-46ee-a1d0-d56ef375ccad",
                        "source_entry_id": "09077a0b-cc3c-3963-b7fc-08f886d8b1c5",
                        "source_sense_id": "eaa37504-5385-3019-919c-a6d6d24add38",
                        "target_lang_word": "симулирование",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "симулирование",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "595bef44-525d-33f6-8bb5-21304a2498d8",
                                        "entry_id": "663e21de-3645-33f2-9ea0-ad71ffb2efd6",
                                        "glosses": [
                                            "умышленное фальшивое, притворное проигрывание реального естественного действия с целью ввести в заблуждение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0077def5-d6a2-4de2-ba22-1642dede7b2f",
                                                "sense_id": "595bef44-525d-33f6-8bb5-21304a2498d8",
                                                "text": "Очень часто симулирование бывает так грубо и так непохоже на то, что желательно изобразить, что оно очевидно для окружающих; это сразу понимает и сам симулянт, быстро бросающий притворство как средство, оказавшееся совершенно непригодным."
                                            },
                                            {
                                                "example_id": "df8602c2-5c7e-41cf-9422-4b9a38323d9a",
                                                "sense_id": "595bef44-525d-33f6-8bb5-21304a2498d8",
                                                "text": "Арестованы и преданы суду по обвинению в симулировании мнимого ограбления кассир и писец конторы и бывший служащий имения."
                                            },
                                            {
                                                "example_id": "911c39c2-ae8f-4717-8cb1-598090887343",
                                                "sense_id": "595bef44-525d-33f6-8bb5-21304a2498d8",
                                                "text": "Это симулирование независимости и равнодушия также приводит его к непрестанным повторениям, оговоркам, растянутости, но здесь они повернуты не вовне, не к другому, а к себе самому: он себя убеждает, себя ободряет и успокаивает и разыгрывает по отношению к себе самому другого человека."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48041fd1-7477-3cf4-b38d-37e277a28092",
                                        "entry_id": "663e21de-3645-33f2-9ea0-ad71ffb2efd6",
                                        "glosses": [
                                            "проигрывание некоего действа с целью освоения роли и подготовки к действию в реальной обстановке"
                                        ],
