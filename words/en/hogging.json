                },
                {
                    "sense_id": "39f0017e-99b5-365e-89e5-0182217a6b83",
                    "sense_definition": "The act of targeting overweight or obese women for sexual encounters for amusement or to exploit low self-esteem.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary exposed the cruel practice of <w>hogging</w> within certain social circles.",
                            "target_lang_translations": {
                                "cs": "Dokument odhalil krutou praxi <w>vyhledávání obézních žen pro zábavu</w> v určitých sociálních kruzích."
                            }
                        },
                        {
                            "text": "Many people find the concept of <w>hogging</w> to be deeply offensive and predatory.",
                            "target_lang_translations": {
                                "cs": "Mnoho lidí považuje koncept <w>tohoto predátorského chování</w> za hluboce urážlivý."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in a derogatory social context."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hanlivé označení pro vyhledávání sexuálních kontaktů s obézními ženami za účelem výsměchu nebo zneužití."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        },
        {
