                                        "glosses": [
                                            "Bebida alcohólica destilada de Brasil que se obtiene como producto de la destilación del jugo de la caña de azúcar fermentado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4f27c4-0432-4702-b277-52a4c26bf175",
                                                "sense_id": "ecebfc1f-a480-3c06-be45-526559f2d6ea",
                                                "text": "Podría quedarme en casa tomando cachaza\nPodría ser un técnico de la NASA\nPodría mostrar lo que hay detrás de esta carcasa\nPero hoy tengo que ser uno más en la masa"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
