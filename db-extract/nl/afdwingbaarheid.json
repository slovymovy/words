                "senses": [
                    {
                        "sense_id": "4dc60a66-3e28-37e8-895f-7387fd6ef2ca",
                        "entry_id": "8593d8b5-46e6-34bf-997a-71a893d8b4ab",
                        "glosses": [
                            "de mogelijkheid om iets door middel van dwang te kunnen bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda52dc2-cd72-4139-af6b-ad1ac8c0ab78",
                                "sense_id": "4dc60a66-3e28-37e8-895f-7387fd6ef2ca",
                                "text": "„Online wapens verkopen is in België al strafbaar”, zegt Duquet. „Dat wordt het in heel Europa, en ook het verkopen van onderdelen mag dan niet meer. Maar de afdwingbaarheid hiervan blijft ingewikkeld. Het blijft moeilijk activiteiten op het deep web te traceren, of verkoopadvertenties op fora die binnen twee uur weer verdwenen kunnen zijn.”"
                            },
                            {
                                "example_id": "30a69f28-dd44-4288-837d-08b7c5985561",
                                "sense_id": "4dc60a66-3e28-37e8-895f-7387fd6ef2ca",
                                "text": "Advocaat Nienke Slump, gespecialiseerd in arbeids- en ondernemingsrecht, is positief over het feit dat er een nieuwe code komt, maar sceptisch over de afdwingbaarheid ervan: “Zolang er niets bij wet is vastgelegd, heeft zo’n code in de rechtszaal weinig houvast. In het verleden is meermaals gebleken dat zelfs franchisegevers en -nemers die de oude Europese code hadden ondertekend, daar voor de rechter uiteindelijk niet al te veel waarde aan hechtten.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79a20d72-20e3-4f66-a012-13b8986c25a6",
                        "source_entry_id": "8593d8b5-46e6-34bf-997a-71a893d8b4ab",
                        "source_sense_id": "4dc60a66-3e28-37e8-895f-7387fd6ef2ca",
                        "target_lang_word": "enforceability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enforceability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                        "entry_id": "40872662-f4a0-3984-85f5-ca1dc6d0c4db",
                                        "glosses": [
                                            "The quality of being enforceable."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63319f5-9fea-49d3-bbcd-4f7cfa4a38af",
                                                "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                                "text": "The position of the individual as a subject of international law has often been obscured by the failure to observe the distinction between the recognition, in an international instrument of rights enuring to the benefit of the individual and the enforceability of these rights at his instance."
                                            },
                                            {
                                                "example_id": "b92b2806-f13b-4cd7-9cc9-0bad51ab3644",
                                                "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                                "text": "Safety advocates counter that the same arguments about enforceability pervaded the discussion surrounding seat belt laws but that those laws, even when they were not vigorously enforced, led to widespread behavioral changes."
                                            },
                                            {
                                                "example_id": "12d6d5d9-0bb8-46ab-93b5-a7b0a124c1a0",
                                                "sense_id": "e43c4601-06ef-3033-915d-4ae7067125e0",
                                                "text": "The use of AI-generated content introduces complex questions regarding copyright and ownership. Under Australian law, copyright generally applies to original works authored by humans. Text generated by AI would probably be outside this framework, creating uncertainty regarding its protectability and enforceability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
