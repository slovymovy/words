                    {
                        "sense_id": "a0172fc4-fddf-3927-a546-1112499ef2f6",
                        "entry_id": "0d6a9bc0-1207-36a0-89ea-fd5991b8e783",
                        "glosses": [
                            "evenement waar publiek kan kijken naar bijzondere vliegtuigen en naar vluchten waarmee piloten hun vaardigheden laten zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99287a63-d7b3-4cc4-bdb7-ca10ead2eea1",
                                "sense_id": "a0172fc4-fddf-3927-a546-1112499ef2f6",
                                "text": "Het toestel dat in Engeland is geland, is een testmodel; het vliegtuig moet de attractie worden van de luchtvaartshow die komende week in Farnborough wordt gehouden."
                            },
                            {
                                "example_id": "12636b72-e17c-4f4e-af33-0243b08a56f1",
                                "sense_id": "a0172fc4-fddf-3927-a546-1112499ef2f6",
                                "text": "Frank Jansen van de Nederlands Aerospace Group (NAG), noemt dit een voorbeeld van de \"doorbraak-technologie\", waarmee Nederland zich in de vliegtuigindustrie op de kaart zet. Hij is op de luchtvaartshow in het Britse Farnborough, waar de overeenkomst tussen Fokker en Goodrich is ondertekend."
                            },
                            {
                                "example_id": "5a47ff7f-5012-4458-92d6-1610de7a8428",
                                "sense_id": "a0172fc4-fddf-3927-a546-1112499ef2f6",
                                "text": "Op de Farnborough-luchtvaartshow in Groot-Brittannië laten de luchtvaartmaatschappijen hun zorgen over de crisis alweer achter zich. Ze hebben daar tot nu toe 233 orders geplaatst voor nieuwe vliegtuigen. En als ook de opties op nieuwe toestellen worden meegeteld zijn er zelfs zo'n 500 besteld."
                            }
                        ]
                    }
