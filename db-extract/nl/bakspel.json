                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74013de-2416-4f12-8cb8-9b333c4be3d3",
                                "sense_id": "6591ed6f-7cda-30f6-88df-81d9623103d1",
                                "text": "Hier weten ze dat caféspelen behendigheid en zelfs denkwerk vragen, ook na een pint. Wie daar aan twijfelt, moet maar eens de toptafel, het hamertjesspel of een van de bakspelen proberen."
