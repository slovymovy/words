                        "entry_id": "b4d89493-56ca-315f-8fa4-49cbba9f736a",
                        "glosses": [
                            "Kleid, das eine Person und Gruppe von Personen am meisten mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd6409c1-11f8-4aa0-a48f-e98ae65cab85",
                                "sense_id": "6b54d6ae-bfee-34d0-8352-2ebb00c08e4a",
                                "text": "„Das war damals mein Lieblingskleid.“"
                            },
                            {
                                "example_id": "4dd85bfa-70d7-41c7-a9fd-d6a5755b1496",
                                "sense_id": "6b54d6ae-bfee-34d0-8352-2ebb00c08e4a",
                                "text": "„‚Und das war mein Lieblingskleid, damals, als ich noch die Ballkönigin war.‘“"
                            },
                            {
                                "example_id": "14c64947-2354-4761-86c6-292acf7e7103",
                                "sense_id": "6b54d6ae-bfee-34d0-8352-2ebb00c08e4a",
                                "text": "„Und da, ausgestreckt, unter einer dunklen Plane, liegt meine Tochter, ihr Haar ist ganz verfilzt und hängt müde herunter, ihr Lieblingskleid ist in einem besseren Zustand als ihr kleiner Körper.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
