                    {
                        "sense_id": "c00de243-9939-3f9e-9a45-5bfbbe0c913e",
                        "entry_id": "8181bb4a-cff4-302e-a2ec-b67ec6432312",
                        "glosses": [
                            "Fahrzeug nicht ganz optimaler Art"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c126dd90-deeb-44e8-8229-9171231f902c",
                                "sense_id": "c00de243-9939-3f9e-9a45-5bfbbe0c913e",
                                "text": "Diese verdammte Chaise, nie springt sie an, wenn man sie braucht!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97eb65b0-c5dc-4ab9-ab81-e69f8d8942cb",
                        "source_entry_id": "8181bb4a-cff4-302e-a2ec-b67ec6432312",
                        "source_sense_id": "1db217ba-e010-3cf6-97a3-b2abf8270449",
