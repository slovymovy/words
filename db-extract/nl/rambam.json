                        ],
                        "examples": [
                            {
                                "example_id": "40206b70-0eb9-46d4-8143-92252d2af585",
                                "sense_id": "1ce1c800-18f1-339c-acc3-99a3b19a3ac9",
                                "text": "Maar Sjemonow staat zelf te roer en hij blijkt een meester; de manoeuvre verloopt zonder schade, nu gaat het rambam de rivier af, het hoogwater is gehaald en de reus in zijn schik."
                            },
                            {
                                "example_id": "438460f5-1a73-40c0-b458-247cbbe24496",
                                "sense_id": "1ce1c800-18f1-339c-acc3-99a3b19a3ac9",
                                "text": "Gewoon een beest dat er rambam op los beukt en dat, als hij (zoals altijd) gewonnen heeft, op z'n borstkas nog eens overdoet."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2b8bc2d2-1021-3773-81a1-81d5fe790d35",
