                "senses": [
                    {
                        "sense_id": "667cb8b6-7485-3e93-8baf-121317880efb",
                        "entry_id": "e2cd7c8d-108b-3cf9-a1d2-3579a7bfd633",
                        "glosses": [
                            "to weaken"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "f21f1870-de62-4fcc-863a-3b572e900929",
                                "sense_id": "667cb8b6-7485-3e93-8baf-121317880efb",
                                "text": "In verleden, aardmagnetisch veld zwakte niet altijd af.",
                                "translation": "In the past, Earth's magnetic field didn't always weaken.",
                                "english": "In the past, Earth's magnetic field didn't always weaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d66456a-e5c5-3545-bff3-fb5c99edf884",
                        "entry_id": "e2cd7c8d-108b-3cf9-a1d2-3579a7bfd633",
                        "glosses": [
                            "to subside, to quiet down, to slow down"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "5d15830f-f783-41f1-b17f-d22606e9e17a",
                                "sense_id": "7d66456a-e5c5-3545-bff3-fb5c99edf884",
                                "text": "Deskundigen melden groei digitale muziekverkoop afzwakken.",
                                "translation": "Growth of digital music sales is slowing down - experts report.",
                                "english": "Growth of digital music sales is slowing down - experts report."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aa19210-95d5-37cc-9769-38c86ce60444",
                        "entry_id": "e2cd7c8d-108b-3cf9-a1d2-3579a7bfd633",
                        "glosses": [
                            "to relax (requirement or rule)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "84ae999e-c3da-4d8b-8d97-87cfad1b796f",
                                "sense_id": "7aa19210-95d5-37cc-9769-38c86ce60444",
                                "text": "De toezichthouder moet daarom de eisen afzwakken.",
                                "translation": "That is why regulatory authority should relax the requirements.",
                                "english": "That is why regulatory authority should relax the requirements."
                            }
                        ]
                    }
                ],
