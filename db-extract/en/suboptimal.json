                                "target_senses": [
                                    {
                                        "sense_id": "578773da-972f-376b-b868-d6f05ead9ce7",
                                        "entry_id": "3b4f435c-79c9-33b5-86b1-d53b437a26cd",
                                        "glosses": [
                                            "Qui laisse à désirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd96a86d-7b78-4e38-a3b0-88a7f9e3d9a9",
                                                "sense_id": "578773da-972f-376b-b868-d6f05ead9ce7",
                                                "text": "Pour que la contribution des parents arrête d'être supposée applicable, le ministère veut que l'étudiant ait déjà travaillé comme salarié pendant 24 mois pendant qu'il n'était pas considéré aux études, ce qui discrimine contre les travailleurs autonomes, mais aussi, empêche ces jeunes de faire leurs études avant de travailler, donc les force à prendre des boulots suboptimaux pour payer leur « juste part »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dff532cd-0772-4aaf-897d-5d7f4b2032d7",
                        "source_entry_id": "ac81a70e-21e4-3b70-a019-43e119920ebb",
                        "source_sense_id": "25dac24b-11b8-38e1-bbba-eddd7fcde6ef",
                        "source_sense_description": "less than optimal",
                        "target_lang_word": "suboptimal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suboptimal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fdf1984-5e0a-3303-a782-9fa6d3b94b84",
                                        "entry_id": "000c895b-739f-3423-9246-6ce0d0447307",
                                        "glosses": [
                                            "nicht ganz perfekt, nicht optimal"
                                        ],
                                        "tags": [
                                            "meist in fachsprachlicher Verwendung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8d4686b-49a2-4cc5-bcac-e7d58d37502c",
                                                "sense_id": "3fdf1984-5e0a-3303-a782-9fa6d3b94b84",
                                                "text": "Die Umsetzung des Projektes war suboptimal."
                                            },
                                            {
                                                "example_id": "9fdc2854-51d4-4bc7-b999-f3cd0d0d8947",
                                                "sense_id": "3fdf1984-5e0a-3303-a782-9fa6d3b94b84",
                                                "text": "„Heuristische Verfahren suchen mit Hilfe geeigneter Regeln nur eine Teilmenge des zulässigen Bereiches ab und können deshalb nicht garantieren, daß die beste gefundene Lösung optimal ist; sie liefern also im allgemeinen suboptimale Lösungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff643985-1eda-3fa6-a3c6-c1fe0875b75f",
                                        "entry_id": "000c895b-739f-3423-9246-6ce0d0447307",
                                        "glosses": [
                                            "überhaupt nicht gut, sehr ungünstig, beschissen"
                                        ],
                                        "tags": [
                                            "euphemistisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e7aa74c-4be2-4302-bc0e-d90ab1468d35",
                                                "sense_id": "ff643985-1eda-3fa6-a3c6-c1fe0875b75f",
                                                "text": "„Ein suboptimaler Auftritt, gelinde ausgedrückt. Genau, sagt er amüsiert, das ist das Wort: »Suboptimal«. So lassen die kleinen nagenden Gewissensbisse sich leichter ertragen. »War nicht gut, ich weiß.«“ (Auftritt des Bundeskanzlers, 2005)"
                                            },
                                            {
                                                "example_id": "c345c9c6-ca06-413c-863d-5c15e62c931f",
                                                "sense_id": "ff643985-1eda-3fa6-a3c6-c1fe0875b75f",
                                                "text": "„Wir lassen unsere Kinder los auf ein suboptimales System, das sich nur in Zeitlupe verbessert.“"
                                            },
                                            {
                                                "example_id": "6a4c6c95-2cba-4b31-bf5a-80ce171ec3e0",
                                                "sense_id": "ff643985-1eda-3fa6-a3c6-c1fe0875b75f",
                                                "text": "[Coronaerkrankungen:] „[…] Alles, was der Lunge schadet, ist eher suboptimal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
