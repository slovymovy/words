                    "sense_definition": "De vierde maand van het jaar, tussen maart en mei.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In <w>april</w> is het weer vaak erg wisselvallig.",
                            "target_lang_translations": {
                                "ru": "В <w>апреле</w> погода часто очень переменчива.",
                                "en": "In <w>April</w> the weather is often very changeable.",
                                "pl": "W <w>kwietniu</w> pogoda jest często bardzo zmienna.",
                                "de": "Im <w>April</w> ist das Wetter oft sehr wechselhaft.",
                                "fr": "En <w>avril</w>, le temps est souvent très changeant.",
                                "it": "Ad <w>aprile</w> il tempo è spesso molto instabile.",
                                "cs": "V <w>dubnu</w> bývá počasí často velmi proměnlivé.",
                                "tr": "<w>Nisan</w> ayında hava genellikle çok değişkendir.",
                                "es": "En <w>abril</w> el tiempo suele ser muy variable."
                            }
                        },
                        {
                            "text": "Mijn verjaardag is op 1 <w>april</w>.",
                            "target_lang_translations": {
                                "ru": "Мой день рождения 1 <w>апреля</w>.",
                                "en": "My birthday is on <w>April</w> 1st.",
                                "pl": "Moje urodziny są pierwszego <w>kwietnia</w>.",
                                "de": "Mein Geburtstag ist am 1. <w>April</w>.",
                                "fr": "Mon anniversaire est le 1er <w>avril</w>.",
                                "it": "Il mio compleanno è il 1° <w>aprile</w>.",
                                "cs": "Moje narozeniny jsou 1. <w>dubna</w>.",
                                "tr": "Doğum günüm 1 <w>Nisan</w>'da.",
                                "es": "Mi cumpleaños es el 1 de <w>abril</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasmaand",
                        "lentemaand"
                    ],
                    "common_phrases": [
