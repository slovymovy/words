                ],
                "senses": [
                    {
                        "sense_id": "632169f3-ad69-31db-b53b-685598ee5465",
                        "entry_id": "652e12b3-bf6b-33dd-af8b-aa6213f89836",
                        "glosses": [
                            "Reconstituer (quelque chose qui avait été démantelé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f505d915-0b42-408a-ae25-88fa37ad6111",
                                "sense_id": "632169f3-ad69-31db-b53b-685598ee5465",
                                "text": "Le long effort de ce curieux esprit s'épuise à élever des murailles autour de l'homme, à remanteler la citadelle et à étouffer sans merci l'irrépressible cri de l'espoir humain."
                            },
                            {
                                "example_id": "13950031-4a4b-4a89-8c11-156bb04660c1",
                                "sense_id": "632169f3-ad69-31db-b53b-685598ee5465",
                                "text": "Quant aux services publics si l’Etat Sarkosiste ne les démantelait pas il n’y aurait pas a les remanteler."
                            },
                            {
                                "example_id": "4bc96819-bfb8-4e4b-9d33-b906e27920d5",
                                "sense_id": "632169f3-ad69-31db-b53b-685598ee5465",
                                "text": "Pendant les temps relationnels, il fait l’expérience de se remanteler, c’est-à-dire qu’il peut profiter de tous ses sens à la fois et il peut mieux évaluer une situation dans son ensemble pour s’ajuster au contexte."
                            }
                        ]
                    }
