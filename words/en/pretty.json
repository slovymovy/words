{
    "word_family": [
        "prettify",
        "prettily",
        "prettiness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4c7474ed-d588-3d46-9916-66a204bbc9e8",
                    "sense_definition": "To a moderate degree; fairly or quite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exam was <w>pretty</w> difficult, but I think I passed it.",
                            "target_lang_translations": {
                                "ru": "Экзамен был <w>довольно</w> сложным, но, думаю, я его сдал."
                            }
                        },
                        {
                            "text": "It is <w>pretty</w> clear that we need to change our strategy.",
                            "target_lang_translations": {
                                "ru": "<w>Вполне</w> ясно, что нам нужно изменить стратегию."
                            }
                        }
                    ],
                    "synonyms": [
                        "fairly",
                        "quite",
                        "rather",
                        "somewhat"
                    ],
                    "common_phrases": [
                        "pretty clear",
                        "pretty good",
                        "pretty soon",
                        "pretty much"
                    ],
                    "target_lang_definitions": {
                        "ru": "В умеренной степени; довольно или вполне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довольно",
                                "target_lang_sense_clarification": "в значительной степени"
                            },
                            {
                                "target_lang_word": "достаточно",
                                "target_lang_sense_clarification": "в достаточной мере"
                            },
                            {
                                "target_lang_word": "вполне",
                                "target_lang_sense_clarification": "совершенно, в полной мере"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6411cbe8-d128-3a91-bbfa-5426f1835695",
                    "sense_definition": "Pleasant to look at; attractive, especially in a delicate way.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>pretty</w> dress to the party last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером она надела на вечеринку <w>красивое</w> платье."
                            }
                        },
                        {
                            "text": "The garden looks very <w>pretty</w> with all the flowers in bloom.",
                            "target_lang_translations": {
                                "ru": "Сад выглядит очень <w>мило</w> со всеми этими распустившимися цветами."
                            }
                        }
                    ],
                    "synonyms": [
                        "attractive",
                        "lovely",
                        "beautiful"
                    ],
                    "antonyms": [
                        "ugly"
                    ],
                    "common_phrases": [
                        "pretty face",
                        "pretty dress",
                        "pretty flower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный на вид; привлекательный, особенно в изящном смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хорошенький",
                                "target_lang_sense_clarification": "о женщинах и детях"
                            },
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "приятный, привлекательный"
                            },
                            {
                                "target_lang_word": "симпатичный",
                                "target_lang_sense_clarification": "вызывающий симпатию"
                            },
                            {
                                "target_lang_word": "красивый",
                                "target_lang_sense_clarification": "о вещах или виде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e7dd78-fe85-3414-941f-80843b84da6f",
                    "sense_definition": "Moderately large or considerable in amount.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new car must have cost him a <w>pretty</w> penny.",
                            "target_lang_translations": {
                                "ru": "Должно быть, та новая машина влетела ему в <w>кругленькую</w> сумму."
                            }
                        },
                        {
                            "text": "They made a <w>pretty</w> profit from the sale of the house.",
                            "target_lang_translations": {
                                "ru": "Они получили <w>изрядную</w> прибыль от продажи дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "considerable",
                        "sizeable"
                    ],
                    "common_phrases": [
                        "pretty penny",
                        "pretty sum"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'pretty penny'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умеренно большой или значительный по количеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кругленький",
                                "target_lang_sense_clarification": "о сумме денег"
                            },
                            {
                                "target_lang_word": "изрядный",
                                "target_lang_sense_clarification": "значительный"
                            },
                            {
                                "target_lang_word": "немалый",
                                "target_lang_sense_clarification": "ощутимый по размеру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21173b50-b90d-3c2e-b154-daf1095c6b21",
                    "sense_definition": "Used ironically to describe an unpleasant or awkward situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ironic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have gotten us into a <w>pretty</w> mess this time.",
                            "target_lang_translations": {
                                "ru": "В этот раз ты втянул нас в <w>хорошенькую</w> переделку."
                            }
                        },
                        {
                            "text": "It is a <w>pretty</w> state of affairs when nobody can agree.",
                            "target_lang_translations": {
                                "ru": "Это <w>славное</w> положение дел, когда никто не может договориться."
                            }
                        }
                    ],
                    "synonyms": [
                        "fine",
                        "nice"
                    ],
                    "common_phrases": [
                        "pretty mess",
                        "pretty state of affairs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used ironically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется иронично для описания неприятной или неловкой ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хорошенький",
                                "target_lang_sense_clarification": "иронично о ситуации"
                            },
                            {
                                "target_lang_word": "славный",
                                "target_lang_sense_clarification": "иронично о беспорядке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "127c6cd9-5d26-3a9d-b4fc-576d3433a785",
                    "sense_definition": "To make something look more attractive or beautiful.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beautify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the afternoon <w>prettying</w> up the guest room.",
                            "target_lang_translations": {
                                "ru": "Она провела вторую половину дня, <w>прихорашивая</w> гостевую комнату."
                            }
                        },
                        {
                            "text": "They decided to <w>pretty</w> the garden before the guests arrived.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>украсить</w> сад до прихода гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "beautify",
                        "decorate",
                        "embellish"
                    ],
                    "common_phrases": [
                        "pretty up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более привлекательным или красивым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прихорашивать",
                                "target_lang_sense_clarification": "украшать, наводить марафет"
                            },
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "делать красивее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45f4bd06-7bc1-3658-99a0-505fc0d326ce",
                    "sense_definition": "A term of address for a person who is attractive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry, my <w>pretty</w>, everything will be fine.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся, моя <w>красотка</w>, всё будет хорошо."
                            }
                        },
                        {
                            "text": "The villain looked at her and said, \"I'll get you, my <w>pretty</w>.\"",
                            "target_lang_translations": {
                                "ru": "Злодей посмотрел на неё и сказал: «Я до тебя доберусь, моя <w>милочка</w>»."
                            }
                        }
                    ],
                    "common_phrases": [
                        "my pretty"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in literature or old films"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращение к привлекательному человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "обращение к девушке"
                            },
                            {
                                "target_lang_word": "милочка",
                                "target_lang_sense_clarification": "фамильярное обращение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b367bb1a-d87f-38e9-bf57-05480323de7b",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pretty</w> was the owner of the local grocery store.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Претти</w> был владельцем местного продуктового магазина."
                            }
                        },
                        {
                            "text": "The <w>Pretty</w> family has lived in this village for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Претти</w> жила в этой деревне на протяжении многих поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Претти",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}