                "senses": [
                    {
                        "sense_id": "d69820d7-ac13-3e40-b818-58edb31c746b",
                        "entry_id": "707c2948-7bb1-3ea6-ba86-99058362011a",
                        "glosses": [
                            "anhaltende Zersetzung eines Holzes durch einen dieses befallenden Pilz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd9367f3-e891-4a8f-91ce-4ccab4fdef0f",
                                "sense_id": "d69820d7-ac13-3e40-b818-58edb31c746b",
                                "text": "„Abhängig von der abgebauten Holzsubstanz werden verschiedene Formen der Holzfäule – mit jeweils mehreren spezifischen Pilzarten als Fäuleerreger – unterschieden.“"
                            },
                            {
                                "example_id": "ecccb93b-22e6-41d6-9d65-b0a414fcc48c",
                                "sense_id": "d69820d7-ac13-3e40-b818-58edb31c746b",
                                "text": "„Es iſt allgemein bekannt, welcher bedeutende Schade, wie viele Störungen und Unannehmlichkeiten häufig verurſacht werden, wenn gewiſſe aus ‚Holz‘ gefertigte Baugegenſtände und dergl. dem Verderben durch die ſogenannte ‚Holzfäule‘ (uneigentlich auch ‚Holz⸗‘ oder ‚Hausſchwamm‘ genannt) unterliegen […]“ [1859]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
