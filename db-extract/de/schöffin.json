                                        "glosses": [
                                            "One who is impaneled on a jury, or who serves as a juror."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b53a1f-20ca-4435-b480-a392ff947bff",
                                                "sense_id": "0c5a1c52-33c6-363d-96b9-3d27e2a0eea7",
                                                "text": "When we speak of our eyes deceiving us, or of the testimony of our noses being suspect, we are talking as if we and our eyes are two parties in dispute, or as if our noses are in the witness-box while we ourselves are sitting down in the midst of our fellow jurymen."
                                            }
