                        ],
                        "form": "die Albedos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                        "entry_id": "6dea59a1-1848-3ee3-95cd-23664be17e90",
                        "glosses": [
                            "Rückstrahlungsvermögen eines nicht strahlenden Körpers (auch Himmelskörpers), einer Fläche"
                        ],
                        "tags": [
                            "Astrophysik",
                            "Geophysik"
                        ],
                        "examples": [
                            {
                                "example_id": "ad84f8e4-178c-4e82-8b9d-da5c5447bee7",
                                "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                                "text": "„Die Albedo ist vor allem in der Meteorologie von Bedeutung, wo sie Aussagen darüber ermöglicht, wie stark sich Luft über verschiedenen Oberflächen erwärmt.“"
                            },
                            {
                                "example_id": "193b32f2-802d-47d5-a335-24152426a006",
                                "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                                "text": "„Enceladus geometrischer Albedo liegt bei fast 1,4 – während die meisten anderen Eismonde des äußeren Sonnensystems auf nicht mehr als 0,2 bis 0,4 kommen.“"
                            },
                            {
                                "example_id": "f2d99d93-74d3-4d0f-b099-3b56a8a9b664",
                                "sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                                "text": "„Russpartikel und Feinstaub färben das Eis dunkler und lassen es schneller schmelzen. Denn das Rückstrahlvermögen, Albedo genannt, ist ausschlaggebend für die Gletscherschmelze. Je dunkler die Oberfläche der Gletscher, desto weniger können Sonnenstrahlen zurückgeworfen werden. Das Eis erwärmt sich stärker, es schmilzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78337a1a-5259-40e8-96c3-22aa90ebf3bc",
                        "source_entry_id": "6dea59a1-1848-3ee3-95cd-23664be17e90",
                        "source_sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
