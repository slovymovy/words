                        ]
                    },
                    {
                        "translation_id": "3a26219a-d54a-4e4e-b75a-34d0d3ec1140",
                        "source_entry_id": "29bf1102-a547-3ffe-bd61-3bdaa2908492",
                        "source_sense_id": "8a97a1ab-2b13-3ed0-8258-0a73370c1ca1",
                        "target_lang_word": "хреновый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хреновый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fb78bcf2-d9db-3747-a178-49efa82bf056",
                                        "entry_id": "550e2dad-d024-36d4-8dc0-244f16cb8867",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным хрен; свойственный, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97b8c3c-fbee-490b-803c-ca62bcc9145d",
                                                "sense_id": "fb78bcf2-d9db-3747-a178-49efa82bf056",
                                                "text": "Богоявленский дьякон был чёрный и мягкий, весь как на вате стеган, а никитский рыжий, сухой, что есть хреновый корень, и бородка маленькая, смычком; а как пошли кричать, выбрать невозможно, который лучше."
                                            },
                                            {
                                                "example_id": "61bea7b5-2fdc-46e1-9506-55472e9ae5ed",
                                                "sense_id": "fb78bcf2-d9db-3747-a178-49efa82bf056",
                                                "text": "Если рыжики нужно солить без специй, без всяких там смородиновых, вишневых и хреновых листьев, без укропа и чеснока, то, очевидно, в сыроежки всё это нужно класть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4a3feb3-92bf-3b07-96bd-ae776c6e90d8",
                                        "entry_id": "550e2dad-d024-36d4-8dc0-244f16cb8867",
                                        "glosses": [
                                            "разг., сниж. плохой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc6bffc0-e406-4799-b539-900999d10834",
                                                "sense_id": "a4a3feb3-92bf-3b07-96bd-ae776c6e90d8",
                                                "text": "Хреновое настроение. Не знаю, что делать."
                                            },
                                            {
                                                "example_id": "bb08477c-ec62-49c8-bfca-51fe0385b36d",
                                                "sense_id": "a4a3feb3-92bf-3b07-96bd-ae776c6e90d8",
                                                "text": "Тут, как видно, дела наши ― хреновые!"
                                            },
                                            {
                                                "example_id": "6348943b-736f-4cbf-851b-971da61baeca",
                                                "sense_id": "a4a3feb3-92bf-3b07-96bd-ae776c6e90d8",
                                                "text": "Царёк-то у нас хреновый ― нечего греха таить."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
