                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f369b67d-8710-4ab1-8939-af03d1967db3",
                                "sense_id": "a5e71b7f-0866-3831-bfa5-a2c0b0bb3ff5",
                                "text": "Русская баня без ароматного зелёного веника теряет свою колоритность."
