                        "examples": [
                            {
                                "example_id": "17af1bbc-92c7-4c25-8cf5-d9d78500de96",
                                "sense_id": "2b858d8a-1742-3ed9-a442-4aac51ea9931",
                                "text": "Das grundlegende philosophische Problem wird nicht mehr die Beziehung zwischen dem Leib und der Seele sein, sondern die Dreier-Beziehung: Gott-Welt-Mensch."
                            },
                            {
                                "example_id": "71cc437a-6118-462e-89b2-49687a9b34ef",
                                "sense_id": "2b858d8a-1742-3ed9-a442-4aac51ea9931",
                                "text": "Es gehe um die Verwendung der Dreier-Beziehung, also der ödipalen Triangulierung, als Ergänzung der präodipalen (frühen) Triangulierung (Mutter, Kind, Vater) mit dem Ziel, die normale Separation von der Mutter zu erreichen."
                            },
                            {
                                "example_id": "4904fbf0-979e-45f1-a999-ccef72895565",
                                "sense_id": "2b858d8a-1742-3ed9-a442-4aac51ea9931",
                                "text": "In einer Dreier-Beziehung ist in Analogie zu den Unterschiedene aus angelsächsischem und holländischem Modell weiter zu differenzieren:\nDas angelsächsische Modell folgt obiger Logik der Zweierkonstellation, da der Interim Provider nicht in die Vertragsausführung eingebunden ist.²⁸¹"
                            }
                        ]
                    }
