                        "glosses": [
                            "Qui est à la fois optimiste et pessimiste, vigilant, réaliste, qui a conscience des aspects positifs ainsi que négatifs et a une vision plus nuancée d’une question ou d’une situation précise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767c87d1-1281-413c-9e70-effcb7c7274a",
                                "sense_id": "685d4475-5e80-3f50-a70f-7d2e8de822f1",
                                "text": "Il se dit lui-même « non pas optimiste mais opti-pessimiste, sachant que le probable nous menace mais que l’improbable peut nous sauver ». — (Board Search/100 ème anniversaire d’Edgar Morin et Conférence à l’UNESCO/2021)"
                            },
                            {
                                "example_id": "d43a0129-8ef7-4dc9-97c9-7aafa6cf55f1",
                                "sense_id": "685d4475-5e80-3f50-a70f-7d2e8de822f1",
                                "text": "Caractère opti-pessimiste."
                            },
                            {
                                "example_id": "6a1dfc99-0698-47b9-903b-67453297ec42",
                                "sense_id": "685d4475-5e80-3f50-a70f-7d2e8de822f1",
                                "text": "Point de vue/ Opinion/ Avis opti-pessimiste."
                            },
                            {
                                "example_id": "6fe17d2a-7c6b-4ba2-a3ae-8c526a82fea4",
                                "sense_id": "685d4475-5e80-3f50-a70f-7d2e8de822f1",
                                "text": "Ce serait mieux de croire les bilans opti-pessimistes quant aux conséquences de la crise sanitaire sur la réussite éducative des jeunes."
                            }
                        ]
                    }
