                    {
                        "sense_id": "c2260251-dc94-3e65-aea1-56575f731a0c",
                        "entry_id": "1720aed0-983b-33ec-8037-cd9ad9a61f67",
                        "glosses": [
                            "Pertaining to plesiobiosis."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4cf5ddfc-8a9a-4697-9ed5-51f8aadd19df",
                                "sense_id": "c2260251-dc94-3e65-aea1-56575f731a0c",
                                "text": "As restricted in the present paper, plesiobiotic, or double nests comprise only those cases in which two, or rarely more, colonies of ants of different species excavate their galleries in close contact with one another."
                            },
                            {
                                "example_id": "dd601f3a-9335-404c-9001-3be8a02db859",
                                "sense_id": "c2260251-dc94-3e65-aea1-56575f731a0c",
                                "text": "Schooling fish probably mix in this fashion on occasion, an association analogous to the plesiobiotic nesting of social insects."
                            },
                            {
                                "example_id": "9823ad54-d590-4257-ac94-bd9d14f3d81e",
                                "sense_id": "c2260251-dc94-3e65-aea1-56575f731a0c",
                                "text": "Plesiobionts differ from each other both in morphology and in behaviour (e.g., in their foraging strategies), and at least one of the plesiobiotic pair is a submissive species."
                            }
                        ]
                    }
