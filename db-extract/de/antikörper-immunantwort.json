                "senses": [
                    {
                        "sense_id": "7be34be3-d7ba-3525-8ab3-72ef0ee594e1",
                        "entry_id": "747d4555-d48b-3c7e-89c7-737f59d08196",
                        "glosses": [
                            "messbare Reaktion (Antwort) des Körpers (des Immunsystems), Antikörper gegen einen bestimmten Krankheitserreger zu bilden, nachdem er in Kontakt damit gekommen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8056bf-6939-4725-83e9-3f588f5a118d",
                                "sense_id": "7be34be3-d7ba-3525-8ab3-72ef0ee594e1",
                                "text": "„Dabei erfolgt eine stufenweise Erhöhung der Dosis zur Ermittlung der generellen Sicherheit und Verträglichkeit sowie einer geeigneten Dosis für die Erzeugung einer spezifisch gegen SARS-CoV-2 gerichteten Antikörper-Immunantwort beim Menschen.“"
                            },
                            {
                                "example_id": "7c33142a-9330-423a-a589-c1f952f2046c",
                                "sense_id": "7be34be3-d7ba-3525-8ab3-72ef0ee594e1",
                                "text": "„Die Gensequenzierung wird heute breit eingesetzt, doch für die Bestimmung einer Antikörper-Immunantwort war diese Methode bisher zu wenig genau. Ein neues, auf genetischen Barcodes beruhendes Kontrollsystem macht die Technik nun sehr viel zuverlässiger – und bereit für den Einsatz zur Entwicklung von Impfstoffen und Antikörper-Medikamenten.“"
                            },
                            {
                                "example_id": "d5fb644e-aedb-4336-9c5d-27a0aa879a84",
                                "sense_id": "7be34be3-d7ba-3525-8ab3-72ef0ee594e1",
                                "text": "„Die spezifischen Antikörper der Klasse IgA, IgG und IgM, das erste Auftreten der spezifischen Antikörper im Serum sowie die Dauer der Antikörper-Immunantwort sind in der Tabelle 1 zusammengefaßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
