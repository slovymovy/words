                "senses": [
                    {
                        "sense_id": "bc4669f5-bd4b-300c-b4aa-ee851b1ff8e5",
                        "entry_id": "ce248fbd-47da-39d3-a3f2-d267940b0939",
                        "glosses": [
                            "blauer Farbton, bläuliche Färbung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf543fa-8f52-49bd-93bb-07c901c5f783",
                                "sense_id": "bc4669f5-bd4b-300c-b4aa-ee851b1ff8e5",
                                "text": "Dieser Blauton, Randolf, steht dir aber gut!"
                            },
                            {
                                "example_id": "15ca9296-8dcb-4623-8983-7b3941d05ee1",
                                "sense_id": "bc4669f5-bd4b-300c-b4aa-ee851b1ff8e5",
                                "text": "„Am 18. September 1810 bekam Goethe ein Meer und einen Himmel zu sehen, die ihm trotz ihrer Blautöne nicht behagt zu haben scheinen.“"
                            },
                            {
                                "example_id": "4ab444f9-e6dc-4e0a-81a8-ef19e1c811d1",
                                "sense_id": "bc4669f5-bd4b-300c-b4aa-ee851b1ff8e5",
                                "text": "„Die Blautöne passen nicht zueinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
