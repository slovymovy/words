                            {
                                "target_word": "ERP",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                        "entry_id": "7879e425-a560-386d-8967-42c4d86b2fd7",
                                        "glosses": [
                                            "Initialism of Electronic Road Pricing."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a03e09be-7301-4afb-a4f3-d975274dc414",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "Electronic road pricing (ERP)is one of the main tools which is keeping Singapore’s traffic problems within manageable levels."
                                            },
                                            {
                                                "example_id": "ab8b041e-d601-4e9d-a023-d09ee20cdc5e",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "Many car parks are now run using the same in-vehicle unit and cashcard and ERP gantries instead of the coupon system."
                                            },
                                            {
                                                "example_id": "b562b1ce-4d1f-497f-8533-591e8165a313",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "However, the term ERP is unique to Singapore, and it serves to differentiate the fact that charges are not collected at physical toll stations but are done automatically on the roadways."
                                            },
                                            {
                                                "example_id": "24c80c4e-70ff-4893-a531-bde50c6f3717",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "The Land Transport Authority (LTA) has called a tender to develop Singapore's next generation electronic road pricing system. The new system will be based on Global Navigation Satellite System technology."
                                            },
                                            {
                                                "example_id": "381da927-961f-4a97-b35f-32f47d2820ba",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "Singapore has cleared the way for its next-generation Electronic Road Pricing (ERP) system, which will have islandwide coverage and the ability to charge according to distance travelled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
