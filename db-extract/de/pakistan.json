                    {
                        "translation_id": "49ceae8f-2b53-41e0-9f91-ff5ab2b1b449",
                        "source_entry_id": "78e75ca0-4620-3765-9a10-2e26a82ba9ff",
                        "source_sense_id": "0194071a-4671-36c4-b7de-6c4e5082f828",
