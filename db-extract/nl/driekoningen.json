        "nl-extract.jsonl": [
            {
                "entry_id": "4d147835-5be6-3624-bc21-00283001794b",
                "word": "Driekoningen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1442daec-302a-38fc-b3e3-ac50069ae8fe",
                        "entry_id": "4d147835-5be6-3624-bc21-00283001794b",
                        "glosses": [
                            "christelijke feestdag op 6 januari waarbij de komst van de Wijzen uit het Oosten bij het Christuskind wordt herdacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55d2e99-db34-40bd-8ac1-41cd771dd095",
                                "sense_id": "1442daec-302a-38fc-b3e3-ac50069ae8fe",
                                "text": "Het middeleeuwse Driekoningen lijkt zoveel op de oud-Romeinse Saturnalia, dat sommige auteurs een doorlopende traditie vermoeden."
                            },
                            {
                                "example_id": "2217f382-12b6-4149-acc6-1a8cb7c8e0e6",
                                "sense_id": "1442daec-302a-38fc-b3e3-ac50069ae8fe",
                                "text": "Sinds zondag kan er weer op de midwinterhoorn worden geblazen. Het was de eerste van de adventstijd. En elke rechtgeaarde blazer weet dat pas dan de eerste toon geblazen mag worden. En na Driekoningen (6 januari) moet het afgelopen zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b0de155-9dff-4a5a-a7a3-6f778be0f94c",
                        "source_entry_id": "4d147835-5be6-3624-bc21-00283001794b",
