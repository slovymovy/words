                "senses": [
                    {
                        "sense_id": "83129a40-42c6-31c2-9212-c7c3753342bf",
                        "entry_id": "11b834fe-6edb-31d9-a6f1-a5f2b124e4f2",
                        "glosses": [
                            "kleiner runder Fleck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "895222c6-8b65-4ef2-bd67-7f1f10050ab5",
                                "sense_id": "83129a40-42c6-31c2-9212-c7c3753342bf",
                                "text": "Das Pünktchen verschönert das ganze Bild."
                            },
                            {
                                "example_id": "26f1359d-1e97-47f6-a32a-0be4bd7bb4ca",
                                "sense_id": "83129a40-42c6-31c2-9212-c7c3753342bf",
                                "text": "„Das sexuelle Tabu kann sich in sogenannten Anstandsstrichen, in vielsagenden Pünktchen oder in Sternchen zeigen.“"
                            },
                            {
                                "example_id": "bff03c9d-122d-4d92-a0e4-295c75d424d6",
                                "sense_id": "83129a40-42c6-31c2-9212-c7c3753342bf",
                                "text": "„Ich blickte auf die schwarzen Pünktchen, die die Zigarettenglut in den Teppich gebrannt hatte, aber ich war zu müde, draufzutreten und sie ganz zum Verlöschen zu bringen.“"
                            },
                            {
                                "example_id": "ff5de0e5-a871-4a95-92a1-f5a44f9f0936",
                                "sense_id": "83129a40-42c6-31c2-9212-c7c3753342bf",
                                "text": "„Als er das Pümktchen, das er suchte, gefunden hatte, zog er den Blick vom Himmel ab und sah auf die Ebene hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
