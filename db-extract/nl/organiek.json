                            {
                                "example_id": "766631b8-8131-4194-af8a-444ef99aab58",
                                "sense_id": "ab9aa29a-c7b2-3108-9da1-7927fb5a1d77",
                                "text": "De kerkfusie tot één organiek lichaam is vandaag een prestigekwestie en niet langer een geloofszaak. Ds. B. H. Weegink, 7 juni 2001"
                            }
                        ]
                    },
                    {
                        "sense_id": "b5fe2994-85b4-3ffd-a9d5-1f141a8bd839",
                        "entry_id": "0b7d9c5b-ad8f-3f0d-891b-96f5ee482471",
                        "glosses": [
                            "wet die een door de grondwet aangeduide instelling nader uitwerkt en regelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7beb1ea-f834-4468-a40a-8cd8afe796bf",
                                "sense_id": "b5fe2994-85b4-3ffd-a9d5-1f141a8bd839",
                                "text": "Dat de NBB zelf maar een beperkte invloed heeft op de samenstelling van het directiecomité, komt door het merkwaardige statuut van de organisatie. De Nationale Bank is een bedrijf sui generis, dat aangestuurd wordt via een organieke wet."
                            }
                        ]
                    }
