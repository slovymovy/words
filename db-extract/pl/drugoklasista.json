                                            {
                                                "example_id": "01234e03-e30b-4956-af95-aa4aa889e159",
                                                "sense_id": "3bf634af-b515-31b2-aa51-c36c1ad1ccd3",
                                                "text": "Die jetzigen Zweitklässler begrüßen die neuen Schulanfänger."
                                            },
                                            {
                                                "example_id": "f4ba8b8e-8366-4df9-86d4-0ffc44c36f9e",
                                                "sense_id": "3bf634af-b515-31b2-aa51-c36c1ad1ccd3",
                                                "text": "„Er solle die Schule in Sachen Völkerverständigung nach vorn bringen, hieß es dort. Sicherlich wegen dieser Geschichte damals, als ein paar Sechstklässler den Zweitklässler aus Gambia drangsaliert hatten.“"
                                            }
                                        ],
