                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb71a66-3ccb-473f-9ab6-fac25c1c59d8",
                                                "sense_id": "9f610a64-9953-348e-93dd-0a99353a4058",
                                                "text": "Nauczyciel zrobił wczoraj istny pogrom – na sprawdzianie połowa klasy dostała jedynki za ściąganie."
                                            }
