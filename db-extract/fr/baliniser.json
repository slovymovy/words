                "senses": [
                    {
                        "sense_id": "ec6c1d9d-c798-38c5-ad96-0f2b5f3dcd21",
                        "entry_id": "3dc243b6-2b39-3f65-beb2-67a540fb6f01",
                        "glosses": [
                            "Donner un caractère rappelant Bali à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f491eb15-9b37-4d75-b3b4-d93503dafb84",
                                "sense_id": "ec6c1d9d-c798-38c5-ad96-0f2b5f3dcd21",
                                "text": "Sur ce thème et à Bali, Michel Picard (2001) fait ainsi le constat que la promotion d’un tourisme culturel a convaincu les Balinais qu’ils étaient en possession d’un patrimoine à faire fructifier et que ce sont bien les Balinais qui s’affairent à « baliniser » Bali."
                            },
                            {
                                "example_id": "52bd84db-8566-4a49-928e-c59bb1946d7b",
                                "sense_id": "ec6c1d9d-c798-38c5-ad96-0f2b5f3dcd21",
                                "text": "Si vous voulez “baliniser” votre prénom et faire sourire vos interlocuteurs balinais, rien de plus simple maintenant!"
                            },
                            {
                                "example_id": "c3f64d6c-aa6f-4b78-8f02-72dd5f09d972",
                                "sense_id": "ec6c1d9d-c798-38c5-ad96-0f2b5f3dcd21",
                                "text": "le sentiment du devoir touristique accompli je peux, en sarong et en tongs, me baliniser et m`adonner à mes élucubrations en suivant le rythme local."
                            }
                        ]
                    }
                ],
