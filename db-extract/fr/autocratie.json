        "fr-extract.jsonl": [
            {
                "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                "word": "autocratie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02d7e8d1-dd6f-4f99-bde6-3d7e33bf5461",
                        "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                        "tags": [
                            "plural"
                        ],
                        "form": "autocraties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c04ff02b-4316-308e-8d0d-f69e4bb19fee",
                        "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                        "glosses": [
                            "Gouvernement d’un autocrate, dictature, monarchie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf70bc9a-5657-4e25-b957-4a91a2a57a1a",
                                "sense_id": "c04ff02b-4316-308e-8d0d-f69e4bb19fee",
                                "text": "On a pendu les régicides et proclamé sous Alexandre III, l’autocratie « inébranlable »."
                            }
                        ]
                    },
                    {
                        "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                        "entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                        "glosses": [
                            "Régime politique d’un autoritarisme absolu."
                        ],
                        "tags": [
                            "analogy",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "544ed99d-01fd-442a-ad8b-8640717d51e3",
                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                "text": "Peut-être parce que, depuis le XIᵉ siècle, la seule théorie politique de l’islam a été celle de l’obéissance passive à toute autorité de facto, le gouvernement par consentement reste un concept inconnu : l’autocratie a été la véritable et, pour l’essentiel, l’unique expérience."
                            },
                            {
                                "example_id": "3a001333-267f-4a06-9206-2f379748222a",
                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                "text": "Un peuple se lavait de l’opprobre d'une autocratie réductrice. Un pays ravalait sa façade dans l'espoir têtu que sa rage de vivre debout allait éclater sur son nouveau visage."
                            },
                            {
                                "example_id": "3e737877-3852-4222-a7bb-8c0769a1fd71",
                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                "text": "Les Américains feront le choix entre l’autocratie et la démocratie."
                            },
                            {
                                "example_id": "c47ea998-4901-4fe8-90e2-9f0c451d14ab",
                                "sense_id": "8694326b-d672-3cc0-901e-5aa5d311d0a1",
                                "text": "À l’évidence, dès la fin du XXᵉ siècle, le rêve – réel ou soudoyé – de ceux qui faisaient miroiter une fin de l’Histoire, dans une victoire définitive et totale d’une démocratie à la Suisse, devenait indéfendable, à mesure que la mondialisation économique, la dualité des deux – l’oligarchie à l’ouest et l’autocratie à l’est, jusqu’au Pacifique – s’affirmait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe56c6f5-f4df-44df-bc14-140a3109a7be",
                        "source_entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                        "target_lang_word": "Autokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                        "entry_id": "5d00164e-21ae-3e77-8369-f58f8285346c",
                                        "glosses": [
                                            "Staatsform, in der die absolute Herrschaft von einer Person oder Gruppe ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43de086-b923-480e-acee-a2fe783cd124",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "Nach jahrzehntelangem Leben in einer Autokratie müssen sich die Menschen erst an den Gedanken einer neugewonnenen Freiheit und Selbstbestimmung gewöhnen."
                                            },
                                            {
                                                "example_id": "155ceeee-0f97-417d-851c-83d9c2a54725",
                                                "sense_id": "f6093876-9629-3b9b-8cb7-37809cd53b42",
                                                "text": "„Parlamentarische Demokratien im heutigen Sinne gab es noch nicht. Wohl aber existierten parlamentarisch verfaßte Oligarchien (Großbritannien) neben relativ offenen parlamentarischen Systemen (Frankreich=, stark eingeschränkt parlamentarischen, halb-autoritären Strukturen (Deutsches Reich und Österreich-Ungarn) und beinahe unbegrenzte Autokratien (Rußland).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "547c5df9-a6b6-4f63-a44e-9e25128a7a11",
                        "source_entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                        "target_lang_word": "Selbstherrschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6937fba8-06cb-447e-96ce-cc1f92016dea",
                        "source_entry_id": "f1ff6d90-55be-31da-b4d4-9737ed0f4bfd",
                        "target_lang_word": "Selbstherrlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstherrlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07aaf37b-174b-3272-88d5-9b0fb7162e6a",
                                        "entry_id": "938fcb6f-b659-36f5-94ac-f2419d9a54f5",
                                        "glosses": [
                                            "Einstellung, sich selbst für unübertrefflich zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa6ea010-b170-4740-99ec-c3213363e0f8",
                                                "sense_id": "07aaf37b-174b-3272-88d5-9b0fb7162e6a",
                                                "text": "„Dieser Gedanke dämpfte meine Selbstherrlichkeit.“"
                                            },
                                            {
                                                "example_id": "39192bc8-387f-4229-a29e-fb3b0cc9c7e5",
                                                "sense_id": "07aaf37b-174b-3272-88d5-9b0fb7162e6a",
                                                "text": "„Er wirft ihm Amtsmissbrauch und Selbstherrlichkeit vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d510a328-e7d5-33e0-94b2-db408e0b2103",
                                        "entry_id": "938fcb6f-b659-36f5-94ac-f2419d9a54f5",
