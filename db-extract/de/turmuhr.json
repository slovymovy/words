                        "source_sense_id": "8a5b370d-d9c0-3b85-adf9-d72a91781859",
                        "source_sense_description": "aus größerer Entfernung sichtbare Uhr, die in oder an einem Turm montiert ist",
                        "target_lang_word": "horloge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horloge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d22bbbb9-767c-34bb-8679-410b95027a52",
                                        "entry_id": "14437876-ba2e-3595-b82b-a45c12960274",
                                        "glosses": [
                                            "Instrument destiné à mesurer le temps et à indiquer l'heure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea3811b-c6f1-4e39-bca0-d764f8b31edf",
                                                "sense_id": "d22bbbb9-767c-34bb-8679-410b95027a52",
                                                "text": "Une horloge à eau."
                                            },
                                            {
                                                "example_id": "e92f0061-7cba-4251-b9f8-6d0868cec932",
                                                "sense_id": "d22bbbb9-767c-34bb-8679-410b95027a52",
                                                "text": "Une horloge à ombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                        "entry_id": "14437876-ba2e-3595-b82b-a45c12960274",
                                        "glosses": [
                                            "Appareil muni d'un grand cadran à aiguilles placé dans un endroit apparent et destiné à marquer et à sonner les heures."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60ef9708-4fe4-43bd-a4ce-c98a82704212",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "L’horloge avance."
                                            },
                                            {
                                                "example_id": "d5e09e8d-425c-41a5-abdc-dfc28e030314",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "Il y a là une grande diable de place qui voudrait, avec ses boutiques allumées, ressembler au Palais-Royal et qui ne réussit qu’à ressembler à la place du Châtelet, plus grande et plus laide ; un hôtel de ville classique et ignoble coiffé d’un gros horloge que les naturels du pays vous montrent avec orgueil, parce que, disent-ils, il a été fait par un berger (qu’est-ce que cela me fait que Tircis ait fabriqué cette horloge ?)."
                                            },
                                            {
                                                "example_id": "ab0b7868-38df-4488-994b-8b27a75fc971",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "Une grosse horloge."
                                            },
                                            {
                                                "example_id": "b2941d5e-2ebf-4597-8ed5-c3d8273dd3a6",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "L’horloge d’une église, d’un palais, d’un collège."
                                            },
                                            {
                                                "example_id": "b868f86c-c488-4013-9e44-9e67fca957e6",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "L’horloge va bien."
                                            },
                                            {
                                                "example_id": "f493f872-736c-45b6-9620-51cb64c94718",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "L’horloge a sonné."
                                            },
                                            {
                                                "example_id": "be76dcef-f2b1-4d33-909d-8c97726c1fbb",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "L’horloge sonne midi."
                                            },
                                            {
                                                "example_id": "312ad4d7-79cc-4f7c-8f74-84a92401c3fe",
                                                "sense_id": "f302c233-6a75-3da8-a24f-941933f08049",
                                                "text": "Quelle heure est-il à l’horloge ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11150b06-c61a-3e6d-be59-68a576d42f8a",
                                        "entry_id": "14437876-ba2e-3595-b82b-a45c12960274",
                                        "glosses": [
                                            "Appareil horaire placé dans une gaine ou dans une boîte."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab006a1-fd18-4657-930b-54de7506e890",
                                                "sense_id": "11150b06-c61a-3e6d-be59-68a576d42f8a",
                                                "text": "On n’entendait que […] le battement régulier de la vieille horloge comtoise dont l’énorme lentille de cuivre s’avivait avec le flot de soleil qui déferlait en chatoyant."
                                            },
                                            {
                                                "example_id": "c3b76871-ecae-4841-bec2-b1285404e5db",
                                                "sense_id": "11150b06-c61a-3e6d-be59-68a576d42f8a",
                                                "text": "Elle disposa les fleurs au chevet, fit arrêter le balancier de l’horloge, voiler les glaces et les miroirs, fermer les fenêtres et cacher les portraits."
                                            },
                                            {
                                                "example_id": "07fbbfd3-095c-456a-9cb9-e11ba26dbfa8",
                                                "sense_id": "11150b06-c61a-3e6d-be59-68a576d42f8a",
                                                "text": "Monter, remonter une horloge, En bander les ressorts ou en hausser les poids."
                                            },
                                            {
                                                "example_id": "cf933e30-cbce-46ba-9701-6b5e3b4f6d55",
                                                "sense_id": "11150b06-c61a-3e6d-be59-68a576d42f8a",
                                                "text": "Démonter une horloge, En désassembler les pièces."
                                            },
                                            {
                                                "example_id": "afd42957-23ef-4d12-b7c7-9a95328790d4",
                                                "sense_id": "11150b06-c61a-3e6d-be59-68a576d42f8a",
                                                "text": "Régler une horloge, La mettre à l’heure d’après le soleil."
                                            }
                                        ]
                                    }
                                ]
                            },
