                ],
                "senses": [
                    {
                        "sense_id": "3485579f-fa85-30d2-bd5f-1220bd5f836a",
                        "entry_id": "252c85bb-5f80-343b-889c-0826afc3ad11",
                        "glosses": [
                            "ausziehbare Lade in einem Schreibtisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5756c2-cd80-4125-a8b6-4c0a18a913fa",
                                "sense_id": "3485579f-fa85-30d2-bd5f-1220bd5f836a",
                                "text": "„Sie hatte die Briefe erst nach seinem Tod in einer seiner Schreibtischschubladen gefunden.“"
                            },
                            {
                                "example_id": "dcc04c87-5372-4b1f-80cb-09ea894e54ca",
                                "sense_id": "3485579f-fa85-30d2-bd5f-1220bd5f836a",
                                "text": "„In der hintersten Schreibtischschublade grub er einen Bordeaux aus, den er zur Feier eines würdigen Anlasses aufgehoben hatte.“"
                            },
                            {
                                "example_id": "53c5e271-0254-41b2-8d4b-a3c839b2860d",
                                "sense_id": "3485579f-fa85-30d2-bd5f-1220bd5f836a",
                                "text": "„Tom kramte einen Notizblock aus seiner Schreibtischschublade, aber Noby winkte ab, nahm das Kreidestück wieder in die Hand und schrieb den Titel auf die Tafel.“"
                            },
                            {
                                "example_id": "c5d8843d-6ffd-4b75-98d8-afaafacd9fb7",
                                "sense_id": "3485579f-fa85-30d2-bd5f-1220bd5f836a",
                                "text": "„Danach verbarg ich den Apfel tagsüber in der Schreibtischschublade.“"
                            },
                            {
                                "example_id": "eaef9bcb-d2ce-4ea1-afae-99646148fde2",
                                "sense_id": "3485579f-fa85-30d2-bd5f-1220bd5f836a",
                                "text": "„Als er vom Stuhl aufstand, hakte er den Schlüsselbund von seinem Gürtel und schoss die Schreibtischschublade auf, um die Schlüssel zum Zellenblock herauszunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
