    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc8fbaa4-5e57-32b5-b507-0c2a057ed218",
                    "sense_definition": "Ein Seil, Kabel oder eine Verbindung gewaltsam oder gezielt durchtrennen bzw. unterbrechen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Einbrecher versuchten heimlich, die Leitung zu <w>kappen</w>, damit kein Alarm ausgelöst wurde."
                        },
                        {
                            "text": "Nach dem schweren Streit beschloss sie, die Verbindung zu ihren alten Bekannten endgültig zu <w>kappen</w>."
                        }
                    ],
                    "synonyms": [
                        "durchtrennen"
                    ],
                    "common_phrases": [
                        "die Leitung kappen",
                        "die Verbindung kappen"
                    ]
                },
                {
                    "sense_id": "b895997b-56b0-37da-98fe-29f6c2749637",
                    "sense_definition": "Die oberen Teile oder Spitzen von Pflanzen, Bäumen oder Hecken stutzen bzw. abschneiden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Frühling musste der Gärtner im Park die Hecken <w>kappen</w>, um das Wachstum zu fördern."
                        },
                        {
                            "text": "Weil der Baum zu hoch wurde, <w>kappte</w> mein Nachbar die obersten Spitzen der Äste."
                        }
                    ],
                    "synonyms": [
                        "beschneiden"
                    ],
                    "common_phrases": [
                        "die Hecken kappen",
                        "die Spitzen kappen"
                    ]
                },
                {
                    "sense_id": "c6a7d997-fce3-3fe4-8a5b-659c949c2eca",
                    "sense_definition": "Eine fliehende oder straffällige Person ergreifen und festnehmen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einer langen Verfolgungsjagd durch die engen Gassen konnte die Polizei den Dieb schließlich <w>kappen</w>."
                        },
                        {
                            "text": "Dem aufmerksamen Wachmann gelang es rechtzeitig, den flüchtigen Täter direkt am Ausgang zu <w>kappen</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich für festnehmen oder schnappen"
                        }
                    ]
                },
                {
                    "sense_id": "17276954-31ed-3a25-b7d0-13cca446719d",
                    "sense_definition": "Einen männlichen Vogel, insbesondere einen Haushahn, kastrieren.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gefluegel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf dem traditionellen Bauernhof wurden junge Hähne früher regelmäßig vor der Mast <w>gekappt</w>."
                        },
                        {
                            "text": "Der Züchter <w>kappte</w> den Hahn nach bewährter Methode, um besonders zartes Fleisch zu gewinnen."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vor allem in der traditionellen Landwirtschaft gebräuchlich"
                        }
                    ]
                },
                {
                    "sense_id": "5070e979-51a5-3b39-8485-6f924d3d4cdb",
                    "sense_definition": "Geflügel begatten (hauptsächlich in Bezug auf den Hahn).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gefluegel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der stolze Hahn lief über den Hof und <w>kappte</w> mehrmals am Tag die Hennen."
                        },
                        {
                            "text": "Sobald der Frühling begann, <w>kappte</w> der Hahn unermüdlich das gesamte Geflügel im Gehege."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "fachsprachlich oder mundartlich in der Geflügelhaltung"
                        }
                    ]
                }
            ]
        },
        {
