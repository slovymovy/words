        "fr-extract.jsonl": [
            {
                "entry_id": "a7ba8a2e-ffad-3562-9fe9-7a83756e7eba",
                "word": "vergleichsweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f2d8852-12bd-361e-af26-8de5e6b27cf0",
                        "entry_id": "a7ba8a2e-ffad-3562-9fe9-7a83756e7eba",
                        "glosses": [
                            "Relativement, comparativement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e087f43a-80cd-4bec-9617-90298c5a772e",
                                "sense_id": "5f2d8852-12bd-361e-af26-8de5e6b27cf0",
                                "text": "(Während der Amtszeit von Hu Jintao) der durfte auf Universitäten noch vergleichsweise frei debattiert werden und auch die Wirtschaft wuchs im zweistelligen Prozentbereich. Gleichzeitig wucherte aber auch die Korruption.",
                                "translation": "(Pendant le mandat de Hu Jintao), il était encore permis de discuter relativement librement dans les universités et l'économie connaissait une croissance à deux chiffres. Mais dans le même temps, la corruption proliférait."
                            },
                            {
                                "example_id": "e76e78bc-1277-4f03-bf63-5b3587704c8a",
                                "sense_id": "5f2d8852-12bd-361e-af26-8de5e6b27cf0",
                                "text": "Seit Wochen steigen die Spritpreise. Was steckt dahinter? Warum bleibt der Diesel vergleichsweise günstig? Und wann sollte man am besten tanken?",
                                "translation": "Depuis des semaines, les prix de l’essence augmentent. Quelle est la cause ? Pourquoi le diesel reste-t-il comparativement bon marché ? Et quel est le meilleur moment pour faire le plein ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                "word": "vergleichsweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                        "entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                        "glosses": [
                            "im Verhältnis, im Vergleich (zu etwas oder jemand anderem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49fcf6d6-3189-4efc-b416-d9fb5cd2673b",
                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                "text": "„Eine Kompaktkamera ist ein kleiner und unter Betrachtung seiner Bauform vergleichsweise leichter Fotoapparat.“"
                            },
                            {
                                "example_id": "a3138683-d2a1-48d2-962b-2d150e5456d7",
                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                "text": "„In einem Land, in dem beispielsweise Arbeitskräfte knapp sind, werden die Löhne vergleichsweise höher sein als in einem Land, in dem ein Überangebot an Arbeitskräften besteht.“"
                            },
                            {
                                "example_id": "4d6aab51-6f76-40ef-b758-c92355331e33",
                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                "text": "„Beitragsstabilität klingt zwar vergleichsweise harmlos. Es bedeutet aber, dass die Finanzkraft der Sender durch die Inflation von Jahr zu Jahr immer weiter sänke.“"
                            },
                            {
                                "example_id": "336c876f-6e6f-45ca-afdb-d6899706f7a4",
                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                "text": "„Diese Untersuchung greift auf eine vergleichsweise breite Literaturauswahl sowie auf bislang unveröffentlichtes Archivmaterial zurück.“"
                            },
                            {
                                "example_id": "efde95f7-06fd-481c-a8c2-f71059812a15",
                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                "text": "„Ein vergleichsweise milder Winter sorgt dafür, dass die Vögel nicht in die Gärten kommen, so lange sie in Wäldern, auf Wiesen und Feldern noch Nahrung finden […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57d1580d-bccb-4bf9-9c5e-bb0ae4c4cdc6",
                        "source_entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                        "source_sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                        "source_sense_description": "im Verhältnis, im Vergleich (zu etwas oder jemand anderem)",
                        "target_lang_word": "comparatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comparatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de1a7736-a96b-3299-bea5-9bc0a90c8135",
                                        "entry_id": "adee291e-9ec6-3f93-ac63-632829d11d51",
                                        "glosses": [
                                            "In a comparative manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481cfe9c-e71b-408d-b2f1-145d4419b2f0",
                                                "sense_id": "de1a7736-a96b-3299-bea5-9bc0a90c8135",
                                                "text": "And yet I suppose that my life has been, comparatively speaking, a happy one."
                                            },
                                            {
                                                "example_id": "5c9860ee-f0d1-45fe-9780-cf6b023d3b17",
                                                "sense_id": "de1a7736-a96b-3299-bea5-9bc0a90c8135",
                                                "text": "Railway grouping had caused some peculiarly Scottish phraseology to disappear, though the note \"Stops on timous notice to the guard\" survived until comparatively recently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "754161c4-9591-3284-9676-284437b559ef",
                                        "entry_id": "adee291e-9ec6-3f93-ac63-632829d11d51",
                                        "glosses": [
                                            "When compared to other entities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8fe28c-f2a2-48ba-9c10-8317f94395cc",
                                                "sense_id": "754161c4-9591-3284-9676-284437b559ef",
                                                "text": "Never did I see a more dreary and depressing scene. Miles on miles of quagmire, varied only by bright green strips of comparatively solid ground[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a4b4416-64de-483b-a953-e1fb2db31219",
                        "source_entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                        "source_sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                        "source_sense_description": "im Verhältnis, im Vergleich (zu etwas oder jemand anderem)",
                        "target_lang_word": "relatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1d19b86-7eb4-3cfd-87cb-ea343afb2b7b",
                                        "entry_id": "72f2f570-3d3e-32ae-9f8b-793a021041d7",
                                        "glosses": [
                                            "In a relative manner; with reference to environment or competition; contextually or comparatively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7f662b6-e661-4470-a5c4-2f90d9760e03",
                                                "sense_id": "b1d19b86-7eb4-3cfd-87cb-ea343afb2b7b",
                                                "text": "In the present position of Europe, it is obvious, that France domineers. She has gained positively, by adding territory to her dominions [...]; she has gained relatively, by removing Austria to a distance, and by weakening that ancient rival to such a degree, as to secure her inaction for an age."
                                            },
                                            {
                                                "example_id": "ba856003-069b-4acc-b873-656e477fb67d",
                                                "sense_id": "b1d19b86-7eb4-3cfd-87cb-ea343afb2b7b",
                                                "text": "[T]he Sundanese [...] have better preserved their primitive usages than the other inhabitants of the island. They are as a rule taller, more robust, and healthier; but they are regarded as relatively barbarous, and in the company of Malays or Javanese, they are themselves ashamed of their dialect, which is looked on as a sort of rude patois."
                                            },
                                            {
                                                "example_id": "20053c3a-4cf3-49c3-8416-1645fb3f81d4",
                                                "sense_id": "b1d19b86-7eb4-3cfd-87cb-ea343afb2b7b",
                                                "text": "Some organs may grow faster than the rest of the body so that their size increases not only in absolute terms, but also relatively to the rest of the body, which is positive allometry; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67858075-b7d5-3d57-8186-f95fb2179d16",
                                        "entry_id": "72f2f570-3d3e-32ae-9f8b-793a021041d7",
                                        "glosses": [
                                            "Somewhat; fairly."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94df847e-9eed-4e89-92a5-5611cde33190",
                                                "sense_id": "67858075-b7d5-3d57-8186-f95fb2179d16",
                                                "text": "Additionally, the F never lets you forget it's one big and very heavy motorcycle. The wide bars give you the leverage to bend it into a corner relatively quickly, but you feel its mass resisting. […] On the freeway, the seat–relatively thin to keep ride height down–offers a pleasant site for your rear through a tank of gas."
                                            },
                                            {
                                                "example_id": "69863631-f43d-4f2c-b1aa-a70c07055597",
                                                "sense_id": "67858075-b7d5-3d57-8186-f95fb2179d16",
                                                "text": "There are at least 1,000 DOE staff working in relatively new offices in the department created after Biden’s infrastructure and climate laws passed a few years ago, including the Grid Deployment Office – which works on modernizing and securing the nation’s electrical grid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4b10812-2acf-46d1-a8a6-df28027ef86e",
                        "source_entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                        "source_sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                        "source_sense_description": "im Verhältnis, im Vergleich (zu etwas oder jemand anderem)",
                        "target_lang_word": "relativement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relativement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c9e2d69-26a8-31fb-b12a-6ab19756dd5a",
                                        "entry_id": "3dc1c5a4-9d6a-340f-a2c4-babb829aaef5",
                                        "glosses": [
                                            "Par comparaison avec les autres du même type."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c500bdd-dff3-4e33-8932-a8fb3613bed4",
                                                "sense_id": "0c9e2d69-26a8-31fb-b12a-6ab19756dd5a",
                                                "text": "Parmi les départs, relativement fréquents étaient donc ceux qui se faisaient, non pas en direction du domicile des intéressés, mais vers ce bâtiment pudiquement baptisé « réserve » qui, caché par un rideau d’arbres au fond du parc, faisait office de dépositoire mortuaire avant l’enlèvement des corps par les familles."
                                            },
                                            {
                                                "example_id": "01876439-d990-48cb-9889-99761a218ede",
                                                "sense_id": "0c9e2d69-26a8-31fb-b12a-6ab19756dd5a",
                                                "text": "La Grande-Bretagne, qui s’est isolée tout récemment, et a des conditions écologiques relativement uniformes, a un endémisme presque nul."
                                            },
                                            {
                                                "example_id": "704a6cff-2a6c-45f4-af90-07be8308396c",
                                                "sense_id": "0c9e2d69-26a8-31fb-b12a-6ab19756dd5a",
                                                "text": "Pour le faumage façon « ricotta », mixez les ingrédients jusqu'à obtenir une consistance relativement lisse. Goûtez afin d'ajuster l'assaisonnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b50ccf8-03d2-3c3b-b990-7bcea1a1c8c3",
                                        "entry_id": "3dc1c5a4-9d6a-340f-a2c4-babb829aaef5",
                                        "glosses": [
                                            "(Relativement à) En ce qui concerne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf9e8b7-0c15-4139-be30-b69daee6eb02",
                                                "sense_id": "4b50ccf8-03d2-3c3b-b990-7bcea1a1c8c3",
                                                "text": "Ces photographies étaient cependant fort intéressantes : elles vérifiaient ce que la méthode graphique m’avait fait saisir relativement au mécanisme du vol, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1492d89e-de09-4c9f-a21d-b0b2f9689b2f",
                        "source_entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                        "source_sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                        "source_sense_description": "im Verhältnis, im Vergleich (zu etwas oder jemand anderem)",
                        "target_lang_word": "comparativement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comparativement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a21212c-ce32-3053-8895-730d731f45a6",
                                        "entry_id": "aaab5491-4f93-3ec5-ac32-65e894cb10fe",
                                        "glosses": [
                                            "D’une manière comparative ; par comparaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a68c86c8-f118-42a4-b793-29ba6cb2be9c",
                                                "sense_id": "9a21212c-ce32-3053-8895-730d731f45a6",
                                                "text": "Les hommes qui dépensent le revenu & qui achètent si chèrement, doivent donc être aussi à proportion beaucoup moins nombreux comparativement à la somme de leurs achats."
                                            },
                                            {
                                                "example_id": "82b34d66-35c5-43e1-aaaa-795aa47c9a78",
                                                "sense_id": "9a21212c-ce32-3053-8895-730d731f45a6",
                                                "text": "Or ceci est, comparativement à l’orthographe du temps, comparativement, du reste, à la nôtre même, une orthographe très simplifiée. C’était celle de La Fontaine."
                                            },
                                            {
                                                "example_id": "b980b33e-8359-46fb-891a-280b9b0612d9",
                                                "sense_id": "9a21212c-ce32-3053-8895-730d731f45a6",
                                                "text": "Dutton et Kerry (1999) mentionnent que les uxoricides présentent plus souvent un trouble de la personnalité schizoïde, évitante, dépendante, passive-agressive et moins souvent un trouble de la personnalité antisociale comparativement aux hommes qui ont fait de la violence conjugale."
                                            },
                                            {
                                                "example_id": "abf954c0-3963-4531-8011-a3648753adc0",
                                                "sense_id": "9a21212c-ce32-3053-8895-730d731f45a6",
                                                "text": "Les paramètres numériques de dérawtisation (luminosité, facteur de contraste, saturation des teintes, netteté, accentuation, filtres, etc.) ont été testés comparativement, avant leur sélection définitive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a4e8e6a-5e58-454c-9c60-a406d923d523",
