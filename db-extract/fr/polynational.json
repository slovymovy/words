                        "examples": [
                            {
                                "example_id": "35a7709d-7050-4b56-a6e7-1008542df6b4",
                                "sense_id": "4a8c7594-620e-3650-a6db-d7e513b767e4",
                                "text": "La Tchécoslovaquie a été un de ces États polynationaux qui virent le jour après la Première Guerre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fbc1140-ae24-3835-a95e-bd8e2a7ba0c6",
                        "entry_id": "a9312060-87cd-3812-97e0-52e133134404",
                        "glosses": [
                            "Qui a plusieurs nationalités."
