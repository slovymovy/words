                            },
                            {
                                "example_id": "d396fd13-4306-4dc6-9492-ac7c2242a93c",
                                "sense_id": "8e69bec4-4b31-3a24-b884-b029854e7101",
                                "text": "Figure 20 represents a chorded packed scrubber."
                            },
                            {
                                "example_id": "12387c38-c8af-4d44-8dd9-27b00834403a",
                                "sense_id": "8e69bec4-4b31-3a24-b884-b029854e7101",
                                "text": "The advantages of a chorded, split-loop winding are better mechanical balance, more uniform coil resistance, and better coil distribution, resulting in more end room on the armature."
                            }
                        ]
                    },
                    {
                        "sense_id": "05204b2d-67fa-3194-bcca-c20779062be0",
                        "entry_id": "659ee580-843a-3030-b350-38609ba65245",
                        "glosses": [
                            "Composed of or containing chords."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "858d45a3-dd63-47f7-87e1-7055f5be6825",
                                "sense_id": "05204b2d-67fa-3194-bcca-c20779062be0",
                                "text": "Afterwards, I would play jazz tunes in a chorded-melody style; the first time through one of us would play the melody and the other the chords, and then we'd switch."
                            },
                            {
                                "example_id": "1b151f55-c305-4148-97af-27ae48c6b6ed",
                                "sense_id": "05204b2d-67fa-3194-bcca-c20779062be0",
                                "text": "This chording technique works well for learning any tune, but this is the only tune of the set that I will write out completely as a chorded version for you."
                            }
                        ]
                    },
                    {
                        "sense_id": "a82d57fa-eb52-3d30-b32b-df7780ff46b8",
                        "entry_id": "659ee580-843a-3030-b350-38609ba65245",
                        "glosses": [
                            "Having cord-like supporting structures."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8e1f9628-16f4-49f6-8d6e-d27632665ce0",
                                "sense_id": "a82d57fa-eb52-3d30-b32b-df7780ff46b8",
                                "text": "An Immersed Boundary fluid-structure interaction model is developed to investigate the dynamic behaviour of a prosthetic chorded mitral valve (MV) inside the left ventricle (LV)."
                            }
                        ]
                    }
