                            },
                            {
                                "target_lang_word": "provide",
                                "target_lang_sense_clarification": "to supply or make available"
                            },
                            {
                                "target_lang_word": "yield",
                                "target_lang_sense_clarification": "to produce as a result"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "приносить как результат"
                            },
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "быть причиной чувства"
