                },
                {
                    "sense_id": "c8e33047-4ffe-3409-adbb-0f75b007d5fc",
                    "sense_definition": "Berbère ; relatif aux populations de la côte barbaresque.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ethnique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les anciens récits mentionnaient ces corsaires <w>barbares</w> qui sillonnaient la mer Méditerranée."
                        },
                        {
                            "text": "Ce voyageur décrivait les mœurs des nations <w>barbares</w> vivant sur les rivages nord-africains."
