                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d08ab9-68c6-40dc-8886-120f35bd7486",
                                "sense_id": "b3e6a9ef-555f-368f-9f5d-2596cb9848ce",
                                "text": "„Saprophytisch lebende Großpilze sind, zusammen mit bestimmten Bakterien, die größten Entsorger und Abfallbeseitiger in der Natur, hauptsächlich in den Wäldern.“"
                            },
                            {
                                "example_id": "ffeb05c3-f008-46da-8892-339552823eaf",
                                "sense_id": "b3e6a9ef-555f-368f-9f5d-2596cb9848ce",
                                "text": "„Sturmvögel sind sehr vielseitig im Hinblick auf ihre Ernährungsweise: Walvögel (Gattung Pachyptila) können ihre Nahrung ausseihen, Eissturmvögel (Fulmarus glacialis) sind typische Abfallbeseitiger, Schneesturmvögel (Pagodroma nivea) dagegen suchen sich ihre Nahrung ausschließlich im Packeis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
