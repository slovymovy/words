                        "glosses": [
                            "Action de rendre annuel ; résultat de cette action."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fbf908d4-02be-3649-802a-a27d0ca0c8f7",
                        "entry_id": "5bb7be6b-e6be-3729-b256-5d5ddfda3c91",
                        "glosses": [
                            "Répartition du temps de travail sur l'ensemble de l'année, avec des durées hebdomadaires variables de ce temps."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "399cfb04-d70d-4a90-bdc4-1ffc97c1568a",
                                "sense_id": "fbf908d4-02be-3649-802a-a27d0ca0c8f7",
                                "text": "— En France on préfère les positions idéologiques, voire théologiques, comme sur les 35 heures qui seraient la source de tous nos maux. Alors que pendant la crise, là où les accords 35 heures avaient mis en place l'annualisation, il y a eu sauvegarde de l'emploi."
                            }
                        ]
                    }
