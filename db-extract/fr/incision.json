        "fr-extract.jsonl": [
            {
                "entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                "word": "incision",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2fa1f28f-23c5-4869-aa50-d822e1bcbe35",
                        "entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                        "tags": [
                            "plural"
                        ],
                        "form": "incisions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                        "entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                        "glosses": [
                            "Action d’inciser ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa4c24b-62da-4757-a150-d847a893b8e6",
                                "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                                "text": "Faire une incision à l’écorce d’un arbre pour le greffer."
                            },
                            {
                                "example_id": "5721eafe-087b-4fc8-8590-32f0a5583d1c",
                                "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                                "text": "Faire une incision dans les chairs, au bras, à la cuisse."
                            },
                            {
                                "example_id": "a3a745cb-f972-4c56-8238-e8acc91e2838",
                                "sense_id": "d3cc5760-3b73-3506-b52e-66a3db8634c0",
                                "text": "Chacun d’eux s’approcha d’une vache et chacun, de la pointe effilée de sa lance, fit une incision très mince au cou de l’animal."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfaa1b8e-8c2a-39b5-a06e-810c1313b116",
                        "entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                        "glosses": [
                            "Coupure dans une couche de terrain."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "aab9d523-5e48-4fa9-a9e8-7e4a2980368c",
                                "sense_id": "dfaa1b8e-8c2a-39b5-a06e-810c1313b116",
                                "text": "Plus au Nord, après l’incision de la Sallanches, on retrouve plusieurs cordons morainiques entre les hameaux de Ste Anne (840 m) et le Crêt (725 m)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23c83313-7c1b-4a4f-8bf7-20610b7e6780",
                        "source_entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                        "target_lang_word": "Einschnitt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschnitt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7d1692-6ebc-3c0b-aa69-38061a9b3255",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "das Schneiden in etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e09f7eaf-b58d-44e8-aec2-f117bdcf1b36",
                                                "sense_id": "4b7d1692-6ebc-3c0b-aa69-38061a9b3255",
                                                "text": "„Damit Sie den Rock später leichter an- und ausziehen können, machen Sie einen Einschnitt vom Innenkreis zirka 17 cm Richtung Saum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1615057-f0ca-3e17-96eb-efbe5f8f4ec4",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "(scheinbar) durch Schneiden in etwas getriebene Kerbe, auch durch Abtragung entstandene Vertiefung im Gelände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5492d647-54c1-4e39-9e79-aca93a7c9ed5",
                                                "sense_id": "e1615057-f0ca-3e17-96eb-efbe5f8f4ec4",
                                                "text": "„Befindet sich der Einschnitt an der Blattspitze und der Stiel an der anderen Seite, ist das Blatt verkehrt herzförmig.“"
                                            },
                                            {
                                                "example_id": "43b17a98-0c1b-431d-b5a8-e5b57fb5159c",
                                                "sense_id": "e1615057-f0ca-3e17-96eb-efbe5f8f4ec4",
                                                "text": "„Noch kritischer als beim Damm ist die Hangneigung bei Einschnitten zu beurteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5731450f-094d-3293-ac25-ee341849a864",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "Ereignis, das einen Ablauf entscheidend verändert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca472568-0987-4383-ae2d-37443c249f14",
                                                "sense_id": "5731450f-094d-3293-ac25-ee341849a864",
                                                "text": "„Dies liegt laut Ministerium vor allem an dem durch die Strafe verursachten drastischen Einschnitt in die Lebenswelt des Verurteilten.“"
                                            },
                                            {
                                                "example_id": "fa54ce64-9bb3-4f81-bb9c-67daf9c09cda",
                                                "sense_id": "5731450f-094d-3293-ac25-ee341849a864",
                                                "text": "„Für die taiwanesische Geschichte markiert der Friedensvertrag einen tiefen Einschnitt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "89da9a64-4ceb-34f0-b774-1ddc24aa2982",
                                        "entry_id": "ab81679a-96b5-373e-93f4-f5c093ad3ab0",
                                        "glosses": [
                                            "Maßnahme, die zu wirtschaftlicher Verschlechterung für jemanden führt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a6b4dd-0387-4475-a647-e7b984251cf7",
                                                "sense_id": "89da9a64-4ceb-34f0-b774-1ddc24aa2982",
                                                "text": "„Er befürchte zweistellige Einschnitte bei den Agrar-Umweltmaßnahmen, sagte Bonde am Freitag in Stuttgart.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76afb021-6995-4773-af29-0a7980799070",
                        "source_entry_id": "ece77355-393c-36f1-850a-5191cfaec701",
                        "target_lang_word": "incision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
