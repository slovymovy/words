                                            {
                                                "example_id": "92b27a2d-d00a-4511-867f-233fca07e174",
                                                "sense_id": "b74da044-4acd-3f14-a106-3e00580f157e",
                                                "text": "Gunnar ging beim Fasching als Esel und nervte seine Freunde den ganzen Tag, indem er ständig „iah“ rief."
                                            },
                                            {
                                                "example_id": "fd7d4a81-4df3-4085-9a03-869b4d4aca4d",
                                                "sense_id": "b74da044-4acd-3f14-a106-3e00580f157e",
                                                "text": "„Iah!“, machte der Esel, als Helmut und Hannelore an den Zaun kamen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
