                    }
                },
                {
                    "sense_id": "854971c1-cb5a-3020-8bbd-405143a47058",
                    "sense_definition": "Abbreviation of National Accountability Bureau",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>NAB</w> is responsible for investigating corruption cases involving high-ranking officials.",
                            "target_lang_translations": {
                                "cs": "Úřad <w>NAB</w> je zodpovědný za vyšetřování korupčních kauz zahrnujících vysoce postavené úředníky."
                            }
                        },
                        {
                            "text": "Recent reports suggest that the <w>NAB</w> has launched a new inquiry into the financial scandal.",
                            "target_lang_translations": {
                                "cs": "Nedávné zprávy naznačují, že <w>NAB</w> zahájil nové vyšetřování finančního skandálu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zkratka pro National Accountability Bureau"
                    },
                    "translations": {
