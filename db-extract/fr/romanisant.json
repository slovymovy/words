                ],
                "senses": [
                    {
                        "sense_id": "ef8ee916-6cc6-3621-9456-5cd530b48aa7",
                        "entry_id": "4d574670-99b3-38ff-81e3-36d823f41d83",
                        "glosses": [
                            "Qui tend à imiter les Romains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9d817e-2302-47f5-a845-c5182c7cb0bf",
                                "sense_id": "ef8ee916-6cc6-3621-9456-5cd530b48aa7",
                                "text": "Les juristes étaient maintenant partout, dans et autour de l’administration, des plus savants aux modestes notaires. Ces hommes accueillaient et soutenaient le modèle romanisant du pouvoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "822c39b9-d5b9-3bff-a895-bd36d1754c05",
                        "entry_id": "4d574670-99b3-38ff-81e3-36d823f41d83",
                        "glosses": [
                            "Qui transforme en caractères latins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6858ad15-e78a-4f18-b020-e9e6a5bc1bf5",
                                "sense_id": "822c39b9-d5b9-3bff-a895-bd36d1754c05",
                                "text": "Les publications hindoustanies en caractères latins ont été généralement faites par les missionnaires pour leurs écoles et les agrégations indo-chrétiennes. […] Des ouvrages élémentaires rédigés d’après le système romanisant ont également vu le jour. Je dois signaler d’abord en ce genre, l’Easy introduction to the study of the hindustani, par MM. Williams et Mather, qui comprend, outre la grammaire, un choix de morceaux avec un vocabulaire et des dialogues."
                            }
                        ]
                    },
                    {
                        "sense_id": "5266640e-805e-3183-99eb-cbe364b6f88e",
                        "entry_id": "4d574670-99b3-38ff-81e3-36d823f41d83",
                        "glosses": [
                            "Qui se rapproche du rite romain, en parlant des cultes chrétiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0a8f83-877f-4ca9-a1c0-a6b04f91a47e",
                                "sense_id": "5266640e-805e-3183-99eb-cbe364b6f88e",
                                "text": "Église grecque romanisante."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "45e136ea-8277-3d48-860b-f208eba096a6",
                "word": "romanisant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "92b03c6b-30da-4527-a1be-4a7d45b535e0",
                        "entry_id": "45e136ea-8277-3d48-860b-f208eba096a6",
