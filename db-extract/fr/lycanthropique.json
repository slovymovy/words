                                "target_senses": [
                                    {
                                        "sense_id": "7c489e8b-13be-3ebd-8b3f-04f874afe9ea",
                                        "entry_id": "90e405ae-41bb-3f7c-b14d-5fac87cb420c",
                                        "glosses": [
                                            "Of or pertaining to lycanthropy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584f5e41-376b-4511-842d-8042b32deadc",
                                                "sense_id": "7c489e8b-13be-3ebd-8b3f-04f874afe9ea",
                                                "text": "Lycanthropic survival instincts\n Embrace the beast and shun the weak\n Awake the primal one that sleeps inside\n Or feel the shiver running through your spine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "870d6713-cf7e-37c1-a96d-b11f7fb8e881",
                                        "entry_id": "90e405ae-41bb-3f7c-b14d-5fac87cb420c",
                                        "glosses": [
                                            "Of or pertaining to lycanthropes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a375b34-8f3e-41d8-be43-2f46b2a01038",
                                                "sense_id": "870d6713-cf7e-37c1-a96d-b11f7fb8e881",
                                                "text": "He had kept the silver wolf’s head cane ornament that Claude Rains used to kill his lycanthropic son, Lon Chaney Jr., in “The Wolf Man” in 1941."
                                            }
                                        ]
                                    }
                                ]
