                                        "entry_id": "dde022ae-cc8a-34be-a9ba-dbc1e4855372",
                                        "glosses": [
                                            "Of or pertaining to homeostasis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fcafb8a-172f-45e1-b9c3-b84ed72d1741",
                                                "sense_id": "615f4208-7e78-3908-849c-b3a5f23fa591",
                                                "text": "Multicellular organisms require a homeostatic internal environment in order to live."
                                            },
                                            {
                                                "example_id": "9a134633-30ee-44ef-8e18-8b8ec6ca7281",
                                                "sense_id": "615f4208-7e78-3908-849c-b3a5f23fa591",
                                                "text": "Sleep, rest, food and sex provide restorative homeostatic experiences that return consciousness to order after the needs of the body intrude and cause psychic entropy to occur."
                                            }
                                        ]
                                    }
                                ]
                            }
