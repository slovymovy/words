                        "source_sense_id": "439fe2fe-884c-3caf-9d7a-1f91cec493a4",
                        "source_sense_description": "großer Eingangsbereich von Häusern",
                        "target_lang_word": "холл",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "холл",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8f457ec7-4bd3-319b-b93c-a2ab0d555d84",
                                        "entry_id": "39dba65b-d281-3458-a356-7b9c8749d4cc",
                                        "glosses": [
                                            "помещение в общественных зданиях, предназначенное для ожидания, отдыха, встреч"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70638a6f-57b5-483d-bd58-6d41d32062ab",
                                                "sense_id": "8f457ec7-4bd3-319b-b93c-a2ab0d555d84",
                                                "text": "В великолепном холле гостиницы, устланном драгоценными коврами, близ стеклянных крутящихся дверей, важно прохаживался высокий человек, с седой головой и энергичным бритым лицом, напоминающим героическое прошлое Франции."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ebf4592-d8bc-309c-a423-22ced5feb716",
                                        "entry_id": "39dba65b-d281-3458-a356-7b9c8749d4cc",
                                        "glosses": [
                                            "большая передняя в квартире, доме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f98d0c-e851-4581-89ea-2044dbed84af",
                                                "sense_id": "3ebf4592-d8bc-309c-a423-22ced5feb716",
                                                "text": "Между гостиной и передней, в проходном холле, где было светло и пустовато, где среди плетеной мебели тепличной тишиной дышали цветущие растения, где за решеткой искусственного камина пылал мандариновый жар, Драйер, в ожидании гостей, читал английскую книжку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
