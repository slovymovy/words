                                        "examples": [
                                            {
                                                "example_id": "f4763b1d-c65f-42d2-872d-4e704c2e27c5",
                                                "sense_id": "096c0d66-4451-3ddb-9e09-4aee7426ddbb",
                                                "text": "Ce village est un amas confus de masures en bois ou en pisé, sales et délabrées, habitées par un peuple de prostituées négresses, bédouines, mauresques, juives et maltaises, […]."
                                            }
