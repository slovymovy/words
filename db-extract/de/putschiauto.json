                "senses": [
                    {
                        "sense_id": "9467ed90-263b-3924-ae60-ee8fa48af7ae",
                        "entry_id": "5217950c-8cc1-3506-a84e-2304bc976f4f",
                        "glosses": [
                            "auf Chilbis (Jahrmärkte), Volksfesten oder in Vergnügungsparks anzutreffendes, elektrisch angetriebenes, autoähnliches, kleines zweisitziges, lenkbares Fahrzeug mit breitem, wulstartigem Gummirand (zum Schutz vor Zusammenstößen), das in einem Fahrgeschäft auf einer begrenzten Fahrfläche gesteuert wird"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "9dcd8dbd-3d9a-4125-ab43-55e20a1961e5",
                                "sense_id": "9467ed90-263b-3924-ae60-ee8fa48af7ae",
                                "text": "„An der Luzerner Määs stehen vom Bahnhofplatz bis zum Inseli über ein Dutzend Attraktionen wie Bahnen, Karusselle und Putschiauto zur Auswahl.“"
                            },
                            {
                                "example_id": "91914987-fa19-4068-938a-180b953cc96d",
                                "sense_id": "9467ed90-263b-3924-ae60-ee8fa48af7ae",
                                "text": "„Ein anderes Mal habe ihn eine ehemalige Miss Schweiz – deren Namen er partout nicht nennen will – gefragt, wo denn beim Putschiauto die Bremse sei.“"
                            },
                            {
                                "example_id": "8e38b8a9-5624-424e-b36a-50399c66035b",
                                "sense_id": "9467ed90-263b-3924-ae60-ee8fa48af7ae",
                                "text": "„Orgeln gehören an die Lozärner Määs wie Magenbrot und Putschiauto.“"
                            },
                            {
                                "example_id": "aab88989-01b2-4ff4-bbf3-da2e4126070c",
                                "sense_id": "9467ed90-263b-3924-ae60-ee8fa48af7ae",
                                "text": "„So muss in diesem Jahr aufs Putschiauto verzichtet werden.“"
                            },
                            {
                                "example_id": "39e6603e-c735-4c38-9219-53d698b526be",
                                "sense_id": "9467ed90-263b-3924-ae60-ee8fa48af7ae",
                                "text": "„Der Sarco sieht aus wie ein aufgemotztes «Putschiauto» einer Chilbibahn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
