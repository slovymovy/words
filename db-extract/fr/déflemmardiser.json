                "senses": [
                    {
                        "sense_id": "a96a2193-253d-31c6-85b7-ff9682f6e1fa",
                        "entry_id": "03b12f4e-dd0d-32fb-a4b6-bbe6c2588aa4",
                        "glosses": [
                            "Faire perdre son caractère flemmard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f561b62-2e13-44e7-b4f4-6ca89a199fd8",
                                "sense_id": "a96a2193-253d-31c6-85b7-ff9682f6e1fa",
                                "text": "Le point principal, pour moi, c’est la flemme. Pour moi ce n’est pas une excuse la flemme. Vous êtes flemmards ? Ben je vais vous [ses élèves] déflemmardiser."
                            },
                            {
                                "example_id": "7bb19236-8622-4192-911f-40d5283690c2",
                                "sense_id": "a96a2193-253d-31c6-85b7-ff9682f6e1fa",
                                "text": "Je cuisine énormément avec, et j’ai toujours eu la flemme de les faire… Tu viens de me déflemmardiser…"
                            },
                            {
                                "example_id": "b8970e9b-92e7-45cb-aa3e-05af99aa6646",
                                "sense_id": "a96a2193-253d-31c6-85b7-ff9682f6e1fa",
                                "text": "Dès que je suis déflemmardisé, je m’inscris."
                            }
                        ]
                    }
                ],
