                "senses": [
                    {
                        "sense_id": "91b53d71-23ae-39ca-9ff0-37c4e884128f",
                        "entry_id": "1951e4cb-1c58-3dbf-8cb7-76c88b4956f7",
                        "glosses": [
                            "швейн. полоска материи, собранная с одной стороны складками или сборками и пришитая к платью, белью и т. п. для отделки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "804d661d-81b5-49be-b7ea-a0ca9846b2a8",
                                "sense_id": "91b53d71-23ae-39ca-9ff0-37c4e884128f",
                                "text": "Да, поздравляю вас: оборок более не носят."
                            }
                        ]
                    },
                    {
                        "sense_id": "031a9e00-93a3-3fb2-84c2-c0e083f9b7cc",
                        "entry_id": "1951e4cb-1c58-3dbf-8cb7-76c88b4956f7",
                        "glosses": [
                            "полигр. типографский набор укороченными строками вокруг какого-либо рисунка, таблицы и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69e18806-36f3-3c7d-9a27-af607a08df69",
                        "entry_id": "1951e4cb-1c58-3dbf-8cb7-76c88b4956f7",
                        "glosses": [
                            "удавка, петля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0befa103-def0-4962-9dbf-87875f85f708",
                                "sense_id": "69e18806-36f3-3c7d-9a27-af607a08df69",
                                "text": "Пшёл Иван, знычит, в яр, надел собаке оборку на шею и бух в озер."
                            },
                            {
                                "example_id": "70d167ac-6d83-4446-8305-f2a278757503",
                                "sense_id": "69e18806-36f3-3c7d-9a27-af607a08df69",
                                "text": "Митрий ваш накинул старухе оборку на шею и волокёт её по земле, чисто как собаку, прости Господи!"
                            }
                        ]
                    }
                ],
