                                                "sense_id": "7687b42f-fbf4-3740-a864-72c4a54defcb",
                                                "text": "Durch seine ständige Angeberei ist er ein richtiger Möchtegern."
                                            },
                                            {
                                                "example_id": "a7d43f26-5f3c-49a1-9692-ff1541d4a8f4",
                                                "sense_id": "7687b42f-fbf4-3740-a864-72c4a54defcb",
