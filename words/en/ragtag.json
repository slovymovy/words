{
    "word_family": [
        "rag",
        "ragged",
        "tag"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7fb470ef-72c9-3636-b293-6859a1b2088d",
                    "sense_definition": "Composed of diverse, irregular, and often ill-matched elements; disorganized or motley.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebellion was led by a <w>ragtag</w> army with little formal training or modern equipment.",
                            "target_lang_translations": {
                                "ru": "Восстание возглавила <w>разношёрстная</w> армия, почти не имевшая специальной подготовки и современного оружия."
                            }
                        },
                        {
                            "text": "They assembled a <w>ragtag</w> crew of volunteers to clean up the neighborhood after the flood.",
                            "target_lang_translations": {
                                "ru": "Они собрали <w>разношёрстную</w> группу добровольцев, чтобы расчистить район после наводнения."
                            }
                        }
                    ],
                    "synonyms": [
                        "motley",
                        "patchwork"
                    ],
                    "common_phrases": [
                        "ragtag army",
                        "ragtag group",
                        "ragtag crew",
                        "ragtag collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из разнообразных, случайных и зачастую неподходящих друг другу элементов; пёстрый, разношёрстный или неорганизованный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разношёрстный",
                                "target_lang_sense_clarification": "о людях, группе или сборище"
                            },
                            {
                                "target_lang_word": "пёстрый",
                                "target_lang_sense_clarification": "неоднородный по составу"
                            },
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "набранный без отбора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3fa8a54-661f-3ffe-a354-91739d47e79e",
                    "sense_definition": "Unkempt, shabby, or in a state of disrepair; worn or tattered.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He liked to wear an old <w>ragtag</w> coat that was threadbare and missing several buttons.",
                            "target_lang_translations": {
                                "ru": "Ему нравилось носить старое <w>потрёпанное</w> пальто, совсем протёртое и без нескольких пуговиц."
                            }
                        },
                        {
                            "text": "The abandoned shed was filled with <w>ragtag</w> furniture that had completely fallen apart.",
                            "target_lang_translations": {
                                "ru": "Заброшенный сарай был завален <w>ветхой</w> мебелью, которая совершенно развалилась."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedraggled",
                        "decrepit",
                        "tattered"
                    ],
                    "common_phrases": [
                        "ragtag clothes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопрятный, потрёпанный или находящийся в полуразрушенном состоянии; ветхий или ободранный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветхий",
                                "target_lang_sense_clarification": "старый, обветшалый"
                            },
                            {
                                "target_lang_word": "потрёпанный",
                                "target_lang_sense_clarification": "изношенный, обтрёпанный"
                            },
                            {
                                "target_lang_word": "ободранный",
                                "target_lang_sense_clarification": "в лохмотьях, облезлый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f71a670-32a5-3e77-85e1-8fd1d5a86c72",
                    "sense_definition": "A shabby, unkempt, or disreputable person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small group of <w>ragtags</w> stood shivering outside the shelter door waiting for food.",
                            "target_lang_translations": {
                                "ru": "Небольшая группа <w>оборванцев</w> стояла и дрожала от холода у дверей приюта в ожидании еды."
                            }
                        },
                        {
                            "text": "The wealthy landowner looked with disdain upon the local <w>ragtags</w> wandering through his estate.",
                            "target_lang_translations": {
                                "ru": "Богатый землевладелец с презрением смотрел на местных <w>оборванцев</w>, бродивших по его поместью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оборванец, неряшливый или пользующийся дурной славой человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборванец",
                                "target_lang_sense_clarification": "человек в рваной, грязной одежде"
                            },
                            {
                                "target_lang_word": "бродяга",
                                "target_lang_sense_clarification": "опустившийся человек"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}