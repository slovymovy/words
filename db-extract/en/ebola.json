                                                "example_id": "48cb4d0f-ad58-4759-9309-340bc5fdf42c",
                                                "sense_id": "269a27ab-367e-3414-a9b4-98c94270bde6",
                                                "text": "Vědci extrahovali virus ebola z těla opice."
                                            }
                                        ]
