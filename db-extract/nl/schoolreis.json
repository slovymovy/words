                        "glosses": [
                            "een (vaak maar één dag durende) reis die door school wordt georganiseerd en waaraan de leerlingen van één of meer klassen tegelijk deelnemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607d0107-bf8a-4f5d-aa71-beda7338bde4",
                                "sense_id": "d5598837-4950-3e2c-a85c-0f041ddb21f3",
                                "text": "Het is belangrijk dat kinderen die dreigen op te groeien in armoede deel kunnen nemen aan schoolreisjes, lid kunnen worden van een sportclub en de mogelijkheid krijgen op muziekles te gaan."
                            }
                        ]
                    }
