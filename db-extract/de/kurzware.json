                "senses": [
                    {
                        "sense_id": "db8824da-7ba8-3e93-a2ec-8fac56c8e4aa",
                        "entry_id": "c6d23cce-19ad-3c47-9486-eec42dbb82c8",
                        "glosses": [
                            "Material, das beim/zum Nähen verwendet/verbraucht wird"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "72bdd304-2311-4610-b01c-3806f63d7a84",
                                "sense_id": "db8824da-7ba8-3e93-a2ec-8fac56c8e4aa",
                                "text": "Die Kurzwaren sind uns ausgegangen."
                            },
                            {
                                "example_id": "d52bbd2f-38e6-41bb-9560-486526a6e0d2",
                                "sense_id": "db8824da-7ba8-3e93-a2ec-8fac56c8e4aa",
                                "text": "„Zwischen Stoffballen und Kurzwaren stand, aufgebahrt auf einem geschmückten Podest, ein Automobil: der neue Ford \"Taunus 17 M\".“"
                            },
                            {
                                "example_id": "4e0b2296-c15e-4b56-8a66-7263496905d6",
                                "sense_id": "db8824da-7ba8-3e93-a2ec-8fac56c8e4aa",
                                "text": "„Als Vertreter für bedeutende Hersteller in allerlei Kurzwaren führte ihn seine Route weit östlich, bis an Warthe und Weichsel, ja ins Ukrainische hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1428ac75-802b-4453-a2c5-f9e4824ae312",
                        "source_entry_id": "c6d23cce-19ad-3c47-9486-eec42dbb82c8",
                        "source_sense_id": "db8824da-7ba8-3e93-a2ec-8fac56c8e4aa",
                        "source_sense_description": "meist Plural: Material, das beim/zum Nähen verwendet/verbraucht wird",
                        "target_lang_word": "notion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a024f30e-0f7a-3e41-8bae-f3f190c00067",
                                        "entry_id": "5b445f09-3934-3f04-a5e8-225f818fb8d9",
                                        "glosses": [
                                            "Mental apprehension of whatever may be known, thought, or imagined; idea, concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b759be4d-2ede-4681-8625-1fefa4c805af",
                                                "sense_id": "a024f30e-0f7a-3e41-8bae-f3f190c00067",
                                                "text": "What hath been generally agreed on, I content myself to assume under the notion of principles."
                                            },
                                            {
                                                "example_id": "e47123f6-d91e-403f-8928-8d9ad5b5e537",
                                                "sense_id": "a024f30e-0f7a-3e41-8bae-f3f190c00067",
                                                "text": "1705-1715, George Cheyne, The Philosophical Principles of Religion Natural and Revealed\nthere are few that agree in their Notions about them:."
                                            },
                                            {
                                                "example_id": "10699f2d-fa08-4561-a2a5-9655a709c4a1",
                                                "sense_id": "a024f30e-0f7a-3e41-8bae-f3f190c00067",
                                                "text": "That notion of hunger, cold, sound, color, thought, wish, or fear which is in the mind, is called the \"idea\" of hunger, cold, etc."
                                            },
                                            {
                                                "example_id": "52783e2f-4088-4c21-bd09-fdecce7e70fc",
                                                "sense_id": "a024f30e-0f7a-3e41-8bae-f3f190c00067",
                                                "text": "Notion, again, signifies either the act of apprehending, signalizing, that is, the remarking or taking note of, the various notes, marks, or characters of an object which its qualities afford, or the result of that act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a670512c-3cef-33ba-9ce2-838bf9a69b44",
                                        "entry_id": "5b445f09-3934-3f04-a5e8-225f818fb8d9",
                                        "glosses": [
                                            "A sentiment; an opinion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97b4608f-1017-4f9b-a614-21860debf139",
                                                "sense_id": "a670512c-3cef-33ba-9ce2-838bf9a69b44",
                                                "text": "“Anthea hasn't a notion in her head but to vamp a lot of silly mugwumps. She's set her heart on that tennis bloke[…]whom the papers are making such a fuss about.”"
                                            },
                                            {
                                                "example_id": "f160a7a6-f80b-45ee-bce9-9bba7b661e54",
                                                "sense_id": "a670512c-3cef-33ba-9ce2-838bf9a69b44",
                                                "text": "The extravagant notion they entertain of themselves."
                                            },
                                            {
                                                "example_id": "abb898f6-985a-4538-bd76-8d740b841064",
                                                "sense_id": "a670512c-3cef-33ba-9ce2-838bf9a69b44",
                                                "text": "December 2, 1832, John Henry Newman, Wilfulness, the Sin of Saul\nA perverse will easily collects together a system of notions to justify itself in its obliquity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fe8d8bc-80df-3022-904f-a2100e7d7955",
                                        "entry_id": "5b445f09-3934-3f04-a5e8-225f818fb8d9",
                                        "glosses": [
                                            "Sense; mind."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dbaa1ba-a66d-4b41-a27e-461ca4deb2e8",
                                                "sense_id": "6fe8d8bc-80df-3022-904f-a2100e7d7955",
                                                "text": "Who wrought with them, and all things else that might / To half a soul and to a notion crazed / Say, 'Thus did Banquo.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f1a45b-5ced-3e36-b09b-b7fbbe485ece",
                                        "entry_id": "5b445f09-3934-3f04-a5e8-225f818fb8d9",
                                        "glosses": [
                                            "An invention; an ingenious device; a knickknack."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec23311-5927-448a-b98d-e98aaa4ac9bb",
                                                "sense_id": "09f1a45b-5ced-3e36-b09b-b7fbbe485ece",
                                                "text": "Yankee notions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d57bd841-2045-3ff3-b8b1-6080beeb37cb",
                                        "entry_id": "5b445f09-3934-3f04-a5e8-225f818fb8d9",
                                        "glosses": [
                                            "Any small article used in sewing and haberdashery, either for attachment to garments or as a tool, such as a button, zipper, or thimble."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73abc020-8690-3567-867c-0cb81bf1ec0b",
                                        "entry_id": "5b445f09-3934-3f04-a5e8-225f818fb8d9",
                                        "glosses": [
                                            "Inclination; intention; predisposition; disposition."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f4d3e5-d28e-41e7-8d27-8e9f645474d5",
                                                "sense_id": "73abc020-8690-3567-867c-0cb81bf1ec0b",
                                                "text": "I have a notion to do it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cdcb8e9-ad06-3d0c-9ea6-958b0ab196e6",
                                        "entry_id": "5b445f09-3934-3f04-a5e8-225f818fb8d9",
                                        "glosses": [
                                            "Pretentiousness or overambition."
                                        ],
