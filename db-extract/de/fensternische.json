                "senses": [
                    {
                        "sense_id": "bf840b80-0d91-34b0-8b81-2882baa278af",
                        "entry_id": "b3b0c29c-1595-3535-8308-87f5d103bee8",
                        "glosses": [
                            "Wandnische, in die ein Fenster eingelassen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "746b0ef8-eaaa-4d8d-9993-9e917b48b07c",
                                "sense_id": "bf840b80-0d91-34b0-8b81-2882baa278af",
                                "text": "„Robert indessen, der zunächst versucht hatte, sich in die Tagebuchblätter des kaufmännischen Angestellten zu vertiefen, fühlte sich durch die Erregung abgelenkt, die in zunehmendem Maße von draußen auf ihn eindrang, so daß er vom Schreibtisch an die Fensternische trat.“"
                            },
                            {
                                "example_id": "77dd9214-c7a7-44f0-95bc-4df1faec362f",
                                "sense_id": "bf840b80-0d91-34b0-8b81-2882baa278af",
                                "text": "„Das Glanzstück jedoch stand in der Fensternische: eine Statue des heiligen Petrus!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
