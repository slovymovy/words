    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b460b3b-8887-3fbb-9d41-ec73c601c46a",
                    "sense_definition": "The act of surrendering to an opponent or yielding to an unwelcome demand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "surrender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military commander signed an unconditional <w>capitulation</w> after months under siege."
                        },
                        {
                            "text": "Critics viewed the mayor's sudden change in policy as a total <w>capitulation</w> to corporate lobbyists."
                        }
                    ],
                    "synonyms": [
                        "surrender",
                        "submission",
                        "yielding",
                        "concession"
                    ],
                    "antonyms": [
                        "resistance",
                        "defiance"
                    ],
                    "common_phrases": [
                        "unconditional capitulation",
                        "total capitulation",
                        "demand capitulation"
                    ]
                },
                {
                    "sense_id": "1f73f040-e85c-34c3-9ea0-514dca9b64a0",
                    "sense_definition": "A formal document or treaty specifying the terms of an agreement or surrender.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surrender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Both generals signed the formal <w>capitulation</w> inside the tent before dawn."
                        },
                        {
                            "text": "Historians examined the original <w>capitulation</w> to understand the guarantees made to the besieged city."
                        }
                    ],
                    "synonyms": [
                        "treaty",
                        "agreement"
                    ],
                    "common_phrases": [
                        "terms of capitulation"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used historically to describe treaties and formal articles of surrender."
                        }
                    ]
                },
                {
                    "sense_id": "87792351-a012-3ffa-8eaa-640bc30eccf7",
                    "sense_definition": "The reduction of a text, agreement, or topic into distinct headings or formal articles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal treatise underwent a methodical <w>capitulation</w> into twenty separate sections."
                        },
                        {
                            "text": "Scholars debated whether the manuscript represented a full argument or merely a brief <w>capitulation</w> of rules."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English except in historical contexts."
                        }
                    ]
                },
                {
                    "sense_id": "ed99b34a-18ab-3593-a180-f365462c074e",
                    "sense_definition": "An enumeration or concise statement summarizing the main parts of a subject.",
