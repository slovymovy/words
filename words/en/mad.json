        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61699499-a0f3-3e36-91d4-86afd11ec507",
                    "sense_definition": "The military doctrine of Mutually Assured Destruction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Cold War was dominated by the concept of <w>MAD</w>.",
                            "target_lang_translations": {
                                "ru": "В Холодной войне доминировала концепция <w>ГВУ</w>.",
                                "zh": "冷战时期受到<w>MAD</w>这一概念的深刻影响。"
                            }
                        },
                        {
                            "text": "Many people feared that <w>MAD</w> would lead to the end of the world.",
                            "target_lang_translations": {
                                "ru": "Многие боялись, что <w>ГВУ</w> приведет к концу света.",
                                "zh": "很多人担心<w>MAD</w>会导致世界末日。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "policy of MAD"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Военная доктрина гарантированного взаимного уничтожения.",
                        "zh": "“相互确保摧毁”的军事战略 doctrine，即双方都拥有足以毁灭对方的核打击能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ГВУ",
                                "target_lang_sense_clarification": "аббревиатура: Гарантированное Взаимное Уничтожение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相互确保摧毁",
                                "target_lang_sense_clarification": "冷战时期的核战略 doctrine"
                            },
                            {
                                "target_lang_word": "MAD",
                                "target_lang_sense_clarification": "通常直接用英文缩写表示"
                            }
                        ]
                    }
                }
            ]
        },
