                        "source_sense_id": "750d1d73-e0c3-3a88-9995-b219dea6343f",
                        "source_sense_description": "Chromosom, das bei diploiden Zellen beider Geschlechter paarweise auftritt",
                        "target_lang_word": "autosome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autosome",
