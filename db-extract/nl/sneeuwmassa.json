                        "examples": [
                            {
                                "example_id": "9052dd54-432e-4c7a-bd0e-1ed109b0dce1",
                                "sense_id": "f765d577-1b8d-39e6-8c86-10fcdd95bcc2",
                                "text": "De Nederlander wilde bij Sankt Anton am Arlberg in Tirol buiten de officiële piste een helling afdalen. Toen hij merkte dat de laag sneeuw los zat, probeerde hij weg te komen. Daardoor begon een sneeuwmassa van 80 meter breed en een meter dik te schuiven."
                            },
                            {
                                "example_id": "af7c4ec4-1969-457d-bfeb-2ceee71835c6",
                                "sense_id": "f765d577-1b8d-39e6-8c86-10fcdd95bcc2",
                                "text": "Onder de doden zijn een moeder en haar drie kinderen. Zij stikten toen de auto waarin zij zaten door een sneeuwmassa werd bedolven. Vier andere Japanners vroren dood."
                            }
                        ]
