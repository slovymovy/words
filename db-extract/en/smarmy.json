                        "entry_id": "dcaf1d44-8c91-3a52-a010-bcdf468f85f2",
                        "glosses": [
                            "Falsely earnest, smug, ingratiating, or pious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "009fd245-fe65-4b58-a94e-5235609f5d32",
                                "sense_id": "797cdbf4-1100-3e98-b2a9-e657365ece7b",
                                "text": "a smarmy salesman with a big smile"
                            },
                            {
                                "example_id": "71bd832c-5891-4d37-81a1-7e6d9d8b5c77",
                                "sense_id": "797cdbf4-1100-3e98-b2a9-e657365ece7b",
                                "text": "Starring a smarmy dog and scores of hapless flying wildfowl, Duck Hunt was the game that introduced many to the joys of the NES Zapper lightgun."
                            }
                        ]
                    },
                    {
                        "sense_id": "93616cb8-a1b1-3e18-853e-f725528f8f40",
                        "entry_id": "dcaf1d44-8c91-3a52-a010-bcdf468f85f2",
                        "glosses": [
                            "Unctuous, greasy, as hair from pomade."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "444bda19-abd3-48a1-ab50-e99fc7fdb215",
                                "sense_id": "93616cb8-a1b1-3e18-853e-f725528f8f40",
                                "text": "He looked faintly loutish, with smarmy hair and a hint of a moustache."
                            },
                            {
                                "example_id": "535fbefc-b406-47f2-9e6c-81a3fa74a258",
                                "sense_id": "93616cb8-a1b1-3e18-853e-f725528f8f40",
                                "text": "I pulled on my smarmy t-shirt and my ragged jeans and dragged myself to report to my supervisor."
                            }
                        ]
                    }
