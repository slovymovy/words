    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd690b9e-c112-3856-8f57-62a8f34d4406",
                    "sense_definition": "Opération commerciale ou financière portant sur l'achat, la vente ou le transfert de fonds ou de biens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>transaction</w> par carte bancaire est immédiatement vérifiée par le système de sécurité."
                        },
                        {
                            "text": "Cette banque enregistre des millions de <w>transactions</w> financières chaque jour à travers le monde."
                        }
                    ],
                    "synonyms": [
                        "opération",
                        "échange"
                    ],
                    "common_phrases": [
                        "transaction financière",
                        "transaction bancaire",
                        "transaction commerciale",
                        "transaction immobilière"
                    ]
                },
                {
                    "sense_id": "66496794-53ba-3d97-8115-0b5058817df2",
                    "sense_definition": "Accord par lequel des parties mettent fin à un litige ou évitent un procès au moyen de concessions réciproques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux entreprises ont finalement conclu une <w>transaction</w> pour éviter un procès long et coûteux."
                        },
                        {
                            "text": "L'avocat a proposé une <w>transaction</w> afin de trouver un compromis acceptable pour les deux familles."
                        }
                    ],
                    "synonyms": [
                        "compromis",
                        "arrangement",
                        "conciliation",
                        "accommodement"
                    ],
                    "antonyms": [
                        "procès",
                        "litige"
                    ],
                    "common_phrases": [
                        "transaction amiable",
                        "projet de transaction"
                    ]
                },
                {
                    "sense_id": "64f00738-23be-3e40-b97b-497d811ac9b4",
                    "sense_definition": "Suite d'opérations exécutées comme une unité indivisible modifiant l'état d'une base de données.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si une erreur survient au cours de l'exécution, toute la <w>transaction</w> est immédiatement annulée."
                        },
                        {
                            "text": "Le serveur assure la cohérence des données en traitant chaque <w>transaction</w> de façon sécurisée."
                        }
                    ],
                    "common_phrases": [
                        "transaction atomique"
                    ]
                }
            ]
        }
    ]
