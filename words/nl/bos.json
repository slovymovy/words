                {
                    "sense_id": "f92097f6-2324-356f-a700-4139a73dca72",
                    "sense_definition": "Het oerwoud of tropisch regenwoud.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn oom werkt diep in het <w>bos</w> van Suriname.",
                            "target_lang_translations": {
                                "en": "My uncle works deep in the <w>jungle</w> of Suriname.",
                                "ru": "Мой дядя работает глубоко в <w>джунглях</w> Суринама.",
                                "pl": "Mój wujek pracuje w głębi <w>dżungli</w> w Surinamie.",
                                "de": "Mein Onkel arbeitet tief im <w>Dschungel</w> von Suriname.",
                                "fr": "Mon oncle travaille profondément dans la <w>jungle</w> du Suriname.",
                                "it": "Mio zio lavora nel profondo della <w>giungla</w> del Suriname.",
                                "cs": "Můj strýc pracuje hluboko v surinamské <w>džungli</w>.",
                                "tr": "Amcam Surinam'ın <w>ormanlarının</w> derinliklerinde çalışıyor.",
                                "es": "Mi tío trabaja en lo profundo de la <w>selva</w> de Surinam."
                            }
                        },
                        {
                            "text": "Veel dieren in het <w>bos</w> worden bedreigd door houtkap.",
                            "target_lang_translations": {
                                "en": "Many animals in the <w>forest</w> are threatened by logging.",
                                "ru": "Многим животным в <w>лесу</w> угрожает вырубка.",
                                "pl": "Wiele zwierząt w <w>lesie</w> jest zagrożonych wycinką drzew.",
                                "de": "Viele Tiere im <w>Wald</w> sind durch Abholzung bedroht.",
                                "fr": "De nombreux animaux de la <w>forêt</w> sont menacés par l'abattage des arbres.",
                                "it": "Molti animali nella <w>foresta</w> sono minacciati dal disboscamento.",
                                "cs": "Mnoho zvířat v <w>pralese</w> je ohroženo kácením stromů.",
                                "tr": "Ağaç kesimi nedeniyle <w>ormandaki</w> birçok hayvanın nesli tehdit altında.",
                                "es": "Muchos animales del <w>bosque</w> están amenazados por la tala de árboles."
                            }
