                                                "example_id": "d22b2dcf-321e-44cb-b262-fd335a160d29",
                                                "sense_id": "fd2cdb24-0983-3f10-8a3a-26f4812c13cd",
                                                "text": "„Und es waren aufregende Zeiten: Glasnost und Perestrojka prägten die Weltpolitik.“"
