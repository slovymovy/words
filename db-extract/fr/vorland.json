                "senses": [
                    {
                        "sense_id": "127f5281-a8b9-385b-8acb-4fb383d8cda6",
                        "entry_id": "466c2051-d2f5-38a8-937b-f0107381f3c3",
                        "glosses": [
                            "Contreforts d’une montagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ce4e82-b6d0-4197-9d47-d13fc549db80",
                                "sense_id": "127f5281-a8b9-385b-8acb-4fb383d8cda6",
                                "text": "La région dont nous nous occuperons ici est la partie du vorland de l’Atlas comprise entre le 9ᵐᵉ et le 11ᵐᵉ degré de longitude ouest de Paris et entre les parallèles de Rabat et de Marrakech, c’est-à-dire un territoire d’environ 40.000 kilomètres carrés, représentant à peu près la 12ᵐᵉ partie du Maroc."
                            },
                            {
                                "example_id": "de5d6716-6bca-4627-bf55-2e76318f354e",
                                "sense_id": "127f5281-a8b9-385b-8acb-4fb383d8cda6",
                                "text": "Les points de partage des eaux, et notamment les vorlands, subissaient peu l’influence de ces tremblements de terre […]"
                            },
                            {
                                "example_id": "3fcaca51-0211-4b63-82d2-c70be7455a9f",
                                "sense_id": "127f5281-a8b9-385b-8acb-4fb383d8cda6",
                                "text": "Le lendemain du tremblement de terre le prospecteur Hill vit non loin de la Mission de Yakutat, par conséquent sur le vorland de graviers incohérents, une surface de 10 acres (plus de 4 hectares) traversée à des intervalles d’environ 1 m."
                            },
                            {
                                "example_id": "032fe655-564b-4c1d-bd60-d98214123b8a",
                                "sense_id": "127f5281-a8b9-385b-8acb-4fb383d8cda6",
                                "text": "La méganappe Coumane est située aujourd’hui par rapport aux Carpates au vorland et les autres deux méganappes au hinterland."
                            }
                        ]
                    }
