                ],
                "senses": [
                    {
                        "sense_id": "2bd9fd90-55ac-31bd-8af0-dd28d9970b94",
                        "entry_id": "8d06d675-a772-36c4-b131-41ab129e5f3b",
                        "glosses": [
                            "Piquer, faire une piqure à."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6e7158e5-4cde-4e72-952c-0e20d2caf00e",
                                "sense_id": "2bd9fd90-55ac-31bd-8af0-dd28d9970b94",
                                "text": "Votre mission sera de picouzer les personnes."
                            },
                            {
                                "example_id": "c41dbc47-4f0b-4ea1-9ca5-f01519b32bc0",
                                "sense_id": "2bd9fd90-55ac-31bd-8af0-dd28d9970b94",
                                "text": "Mais le pire reste le visage d'Elijah Wood, le grouin collé sur la vitre de la caméra, qui se laisse picouzer par le vilain appendice de la mère Shelob."
                            },
                            {
                                "example_id": "4a4e46ce-8031-4e98-978f-b882efa474e4",
                                "sense_id": "2bd9fd90-55ac-31bd-8af0-dd28d9970b94",
                                "text": "Quitte à me faire picouzer, je préfère que ce soit pour donner mon sang !"
                            }
                        ]
                    }
