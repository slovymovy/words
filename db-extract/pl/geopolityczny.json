                ],
                "senses": [
                    {
                        "sense_id": "998771b3-594e-3825-a6c9-c7ec4dcc8d99",
                        "entry_id": "d428c824-7f1a-3daa-bb82-b3302dcd3b29",
                        "glosses": [
                            "dotyczący położenia geograficznego danego obszaru, które wpływa na jego sytuację polityczną"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0dba6033-8c7b-38e0-8312-5347f02c70f7",
                        "entry_id": "d428c824-7f1a-3daa-bb82-b3302dcd3b29",
                        "glosses": [
                            "związany z geopolityką, zgodny z doktryną geopolityki"
                        ],
                        "tags": [],
