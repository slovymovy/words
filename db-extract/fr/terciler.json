                        "glosses": [
                            "Diviser une série statistique en terciles."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "acc018bc-f35d-4e18-b9dc-fae95f759ca5",
                                "sense_id": "2c81a51e-8e56-3544-a4d8-0384c912d47f",
                                "text": "Les résultats concernant l'appréciation des distances pouvant, dans chaque cas, être tercilés, 15 coefficients ennéachoriques furent calculés pour chaque plan, soit 60 coefficients au total."
                            },
                            {
                                "example_id": "fa83741b-247b-461d-bbfc-11fe39767f32",
                                "sense_id": "2c81a51e-8e56-3544-a4d8-0384c912d47f",
                                "text": "Chaque série est « tercilée », le contenu des cases extrêmes se rapprochant le plus possible du tiers de la série entière. Les valeurs sont alors cotées sur une échelle à 3 degrés, […]."
                            }
                        ]
                    }
