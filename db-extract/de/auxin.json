                "senses": [
                    {
                        "sense_id": "2e34cdc7-9077-3b45-971a-af96827825bd",
                        "entry_id": "8d330c79-aa72-3322-b69f-5b51c2af446b",
                        "glosses": [
                            "organische Verbindung, die in der Natur von der Pflanze selbst gebildet wird und deren Wachstum fördert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f2391e-3433-4146-8a82-2458e455e738",
                                "sense_id": "2e34cdc7-9077-3b45-971a-af96827825bd",
                                "text": "„Die entsprechenden Pflanzenteile, die weniger Licht bekommen, bilden sogenannte Auxine, Stoffe also, die für das Pflanzenwachstum verantwortlich sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77c5866a-47c7-4750-bda1-4f0583469aeb",
                        "source_entry_id": "8d330c79-aa72-3322-b69f-5b51c2af446b",
                        "source_sense_id": "2e34cdc7-9077-3b45-971a-af96827825bd",
                        "source_sense_description": "organische Verbindung, die von der Pflanze selbst gebildet wird und deren Wachstum fördert",
                        "target_lang_word": "auxin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auxin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                        "entry_id": "9c964444-ce90-38de-b2b6-50ec5b4e3f1b",
                                        "glosses": [
                                            "A class of plant growth substance (often called phytohormones or plant hormones) which play an essential role in coordination of many growth and behavioral processes in the plant life cycle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec73c23c-0afa-465b-8e39-4079a9da7608",
                                                "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                                "text": "In Arabidopsis roots, cold stress may reduce shootward auxin transport and alter the intracellular auxin gradient."
                                            },
                                            {
                                                "example_id": "cdb1b9d9-cedd-4307-b49a-348613cfdb00",
                                                "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                                "text": "SE onset depends on a complex network of interactions among plant growth regulators, mainly auxins and cytokinins, during the proembryogenic early stages, and ethylene and gibberellic and abscisic acids later in the development of somatic embryos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d950dde0-2c76-4b76-b4b4-e906545822af",
                        "source_entry_id": "8d330c79-aa72-3322-b69f-5b51c2af446b",
                        "source_sense_id": "2e34cdc7-9077-3b45-971a-af96827825bd",
                        "source_sense_description": "organische Verbindung, die von der Pflanze selbst gebildet wird und deren Wachstum fördert",
                        "target_lang_word": "auxine",
                        "target_lang_code": "fr",
