                        "examples": [
                            {
                                "example_id": "71f94d6b-11fd-4645-8118-7b9ff2f40a95",
                                "sense_id": "f571c900-bae7-3503-aec4-cf2185f2d019",
                                "text": "Hulpdiensten zoeken nog naar vermisten. Aan boord van de Mi-8 transporthelikopter waren volgens verschillende bronnen 9 tot 19 mensen... Zij maakten naar verluidt een visreisje."
                            },
                            {
                                "example_id": "70346670-a7e0-4405-b656-2eb935fe7b17",
                                "sense_id": "f571c900-bae7-3503-aec4-cf2185f2d019",
                                "text": "Een Siberische visser heeft 12 jaar cel gekregen voor kannibalisme. De man, Aleksej Goroelenko, was in 2012 samen met drie metgezellen tijdens een visreis verdwaald geraakt in de Siberische naaldwouden."
                            }
