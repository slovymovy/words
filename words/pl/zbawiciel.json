                                "target_lang_word": "Saviour",
                                "target_lang_sense_clarification": "Jesus Christ (UK)"
                            },
                            {
                                "target_lang_word": "Redeemer",
                                "target_lang_sense_clarification": "Jesus Christ as the redeemer"
                            }
                        ]
