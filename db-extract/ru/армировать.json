                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armaturer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abcff72c-fc5b-33ff-8957-511a772349b4",
                                        "entry_id": "0d9c5096-4fa0-3b57-9bcc-23a1d7b61973",
                                        "glosses": [
                                            "Munir d’une armature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f022c699-d32a-4668-9c3c-4e877ea284f9",
                                                "sense_id": "abcff72c-fc5b-33ff-8957-511a772349b4",
                                                "text": "Les barrots ne servent pas seulement à armaturer les ponts pour leur permettre de supporter de lourdes charges;"
                                            },
                                            {
                                                "example_id": "0ed12405-426a-4da9-93f7-6ea7c6f0af91",
                                                "sense_id": "abcff72c-fc5b-33ff-8957-511a772349b4",
                                                "text": "Quoique trop chargé, trop armaturé, l’ensemble se défendait par ce dont nous parlions tout à l’heure, la richesse, l’exagération ambiante."
                                            },
                                            {
                                                "example_id": "875607b8-9d28-4d3c-84db-f70b58097f3b",
                                                "sense_id": "abcff72c-fc5b-33ff-8957-511a772349b4",
                                                "text": "La méthode des Propos va dorénavant armaturer toute la méthode."
                                            },
                                            {
                                                "example_id": "25ef4200-4595-4d8d-975a-af48f1680268",
                                                "sense_id": "abcff72c-fc5b-33ff-8957-511a772349b4",
                                                "text": "L’horizon se déshorizonne\nEt s’armature de clochers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05d4c232-592d-4c5d-8c43-06067e1936ee",
                        "source_entry_id": "d8be4c46-fc18-3954-be4a-df03d7f71916",
                        "source_sense_id": "346930bd-30ca-3a44-aa68-37c512b34170",
                        "target_lang_word": "armer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1f4f37-3f7a-3245-a836-01e86d85fb00",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Pourvoir d’armes ; équiper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9992a6-8d55-44da-a474-b5ece6cf5aca",
                                                "sense_id": "1b1f4f37-3f7a-3245-a836-01e86d85fb00",
                                                "text": "Cependant, par précaution, Jasper Hobson, le sergent et Mrs. Paulina Barnett elle-même s'armèrent de fusils."
                                            },
                                            {
                                                "example_id": "ee002f4e-45ce-4eca-9a89-b230f9bb1555",
                                                "sense_id": "1b1f4f37-3f7a-3245-a836-01e86d85fb00",
                                                "text": "Nos grandes places de guerre, Strasbourg et Metz, les véritables boulevards de notre défense, n’avaient été ni armées, ni approvisionnées."
                                            },
                                            {
                                                "example_id": "1dbbef4d-e6be-4587-ba6d-8bfa63c34229",
                                                "sense_id": "1b1f4f37-3f7a-3245-a836-01e86d85fb00",
                                                "text": "C’était précisément pour s’armer contre moi qu’elle était restée si longtemps sans paraître."
                                            },
                                            {
                                                "example_id": "5199289f-9f9a-4925-bf6a-436c372766e5",
                                                "sense_id": "1b1f4f37-3f7a-3245-a836-01e86d85fb00",
                                                "text": "Hébert leur avait déclaré toutefois que Clouet s’était armé d'un couteau pour frapper Latour et « qu'il n'était qu'un assassineur, un Barrabas et un empoisonneur»."
                                            },
                                            {
                                                "example_id": "58f8f36e-2b8f-4f6a-b7f9-448f8918a320",
                                                "sense_id": "1b1f4f37-3f7a-3245-a836-01e86d85fb00",
                                                "text": "Juste au moment du 18 brumaire, Burnel se faisait renvoyer de Guyane par les colons, sous l’accusation de négrophilie : en réalité, à un moment où la colonie étant menacée par les Anglais, il envisageait d’armer les Noirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "982f57e9-718e-35f1-8502-51d3aec68f79",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Lever des soldats, lever des troupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fe80836-03bc-4f2c-ac63-d951fc806e58",
                                                "sense_id": "982f57e9-718e-35f1-8502-51d3aec68f79",
                                                "text": "Il attaquait dans le moment unique et irretrouvable d'une guerre civile qui armait les uns contre les autres les princes de la branche allemande."
                                            },
                                            {
                                                "example_id": "95b5af63-a976-4e56-872f-cb68b268b296",
                                                "sense_id": "982f57e9-718e-35f1-8502-51d3aec68f79",
                                                "text": "Après avoir harcelé la révolution dans l'Assemblée, elles l'attaquèrent plus tard à force ouverte, le clergé par des soulèvements intérieurs, la noblesse en armant l'Europe contre elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10894e70-492c-3be9-b325-6cde95e7726d",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Équiper un bâtiment, le pourvoir de tous les objets nécessaires pour le mettre en état de prendre la mer, qu’il s’agisse d’un bâtiment de guerre, de commerce ou de loisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e97fe2c-694b-4a1f-8cf0-8c40367a22e8",
                                                "sense_id": "10894e70-492c-3be9-b325-6cde95e7726d",
                                                "text": "La délivrance des lettres de marque et le droit de course avec commission, c'est-à-dire après avoir reçu du roi l'autorisation d’armer des navires et de courir sus aux étrangers dont on avait à se plaindre, devinrent bientôt très profitables aux armateurs malouins et à leurs confrères des autres ports."
                                            },
                                            {
                                                "example_id": "0f14bfef-8d65-4f69-b75c-77796c8a6d66",
                                                "sense_id": "10894e70-492c-3be9-b325-6cde95e7726d",
                                                "text": "L’année même de la prise de la Bastille, 1789, Paimpol n’armait plus que six terre-neuviers, quatre en 1790."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfdaf9c4-7a33-35c1-88ca-58c7658cfce9",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Enrôler un marin sur un navire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1622c891-dfe7-38f2-a7ca-0ad85dd568fb",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Exciter à prendre les armes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b164a6e7-880b-48d5-a193-0fe938a123c4",
                                                "sense_id": "1622c891-dfe7-38f2-a7ca-0ad85dd568fb",
                                                "text": "Ses vices ont armé tous les honnêtes gens contre lui."
                                            },
                                            {
                                                "example_id": "acedb7d6-a2fb-4410-a067-bf9e898a4295",
                                                "sense_id": "1622c891-dfe7-38f2-a7ca-0ad85dd568fb",
                                                "text": "Armer le fils contre le père, l’ami contre l’ami."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf665c1-c3b1-3720-915a-db096d184195",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Garnir une Place de guerre, ses remparts, de pièces de canon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e22e7a59-35ee-30f6-9eca-3b19f7a4f8c1",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Mettre une arme en situation de fonctionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40fe6af8-9e94-44ed-a337-4d9a2f0d17c4",
                                                "sense_id": "e22e7a59-35ee-30f6-9eca-3b19f7a4f8c1",
                                                "text": "Tout à coup le marquis aperçut ses pistolets, en saisit un, l’arma lestement et le dirigea sur l’étranger."
                                            },
                                            {
                                                "example_id": "bcd59d84-77c0-4e24-b37e-1a31f975b308",
                                                "sense_id": "e22e7a59-35ee-30f6-9eca-3b19f7a4f8c1",
                                                "text": "À ce cri « un homme ! » le général et les lanceros s’étaient à tout hasard préparés contre une attaque soudaine, en armant leurs fusils."
                                            },
                                            {
                                                "example_id": "2500a9bb-3b99-490c-9984-674cf9e61fae",
                                                "sense_id": "e22e7a59-35ee-30f6-9eca-3b19f7a4f8c1",
                                                "text": "Hervé arma son revolver pour se préparer à les recevoir. Il le leur aurait mis sous le nez, s’ils s’étaient approchés et, en les menaçant de leur brûler la cervelle, il les aurait poussés jusqu’à la sortie."
                                            },
                                            {
                                                "example_id": "bfd72bf2-c56a-40d4-a808-622418e6f0d0",
                                                "sense_id": "e22e7a59-35ee-30f6-9eca-3b19f7a4f8c1",
                                                "text": "J’armai la carabine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b2fe6c1-61bf-31ad-9c0a-219e0c893891",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Renforcer un objet ou un matériau par un autre objet ou matériau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbcf0208-074c-4c6c-bf45-92df87a059f0",
                                                "sense_id": "8b2fe6c1-61bf-31ad-9c0a-219e0c893891",
                                                "text": "Armer un aimant."
                                            },
                                            {
                                                "example_id": "9f6a8522-2554-4646-ad5d-6300f5345275",
                                                "sense_id": "8b2fe6c1-61bf-31ad-9c0a-219e0c893891",
                                                "text": "Armer une poutre de bandes de fer."
                                            },
                                            {
                                                "example_id": "4e2c797d-c909-48c3-8bfd-716a98d3ee4c",
                                                "sense_id": "8b2fe6c1-61bf-31ad-9c0a-219e0c893891",
                                                "text": "Armer une meule de moulin avec des liens de fer."
                                            },
                                            {
                                                "example_id": "98cf5b8f-4c41-4f24-a5b3-f372d968a3d4",
                                                "sense_id": "8b2fe6c1-61bf-31ad-9c0a-219e0c893891",
                                                "text": "Actuellement, l’architecture tient bien peu compte de la sculpture : où trouverait-elle sa place dans les cubes de béton armé qui constituent les maisons modernes ?"
                                            },
                                            {
                                                "example_id": "a987e834-a246-4b1a-9358-c4e0deccbe9c",
                                                "sense_id": "8b2fe6c1-61bf-31ad-9c0a-219e0c893891",
                                                "text": "L'usine […] était également outillée pour transformer le papier d’emballage en papier goudronné, entoilé, armé, huilé et paraffiné, à usage industriel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b33264-c32c-3515-a5a0-d6d4ace86f0b",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Munir de certains pouvoirs, de certains moyens intellectuels ou autres de défense ou d’attaque."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0039f5e1-87a9-47ff-bba3-c0961d00eba6",
                                                "sense_id": "f4b33264-c32c-3515-a5a0-d6d4ace86f0b",
                                                "text": "Bien que les ruminants soient les mieux armés stomacalement pour digérer la cellulose, il n'arrivent pas à la transformer complétement."
                                            },
                                            {
                                                "example_id": "1ceb857e-dcdf-4958-8557-75f557f51825",
                                                "sense_id": "f4b33264-c32c-3515-a5a0-d6d4ace86f0b",
                                                "text": "Le gouvernement doit être armé contre les désordres."
                                            },
                                            {
                                                "example_id": "fb5165ca-dc1d-4aa5-b9d6-e55197477b16",
                                                "sense_id": "f4b33264-c32c-3515-a5a0-d6d4ace86f0b",
                                                "text": "La justice est armée contre les délits de ce genre."
                                            },
                                            {
                                                "example_id": "2e8ad5ad-80ed-4d86-bb3d-c6cbc598f101",
                                                "sense_id": "f4b33264-c32c-3515-a5a0-d6d4ace86f0b",
                                                "text": "J’étais bien armé pour répondre à cette objection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c88473e-2606-3217-9baf-667efa94663c",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Attacher des sonnettes au faucon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd986e6-51b6-4fde-b8fc-04c66d62f8fc",
                                                "sense_id": "8c88473e-2606-3217-9baf-667efa94663c",
                                                "text": "Armer l’oiseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2613865b-d1a9-3e87-9ddf-9f90269e8bc0",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Mettre à la clef le nombre de dièses ou de bémols convenables pour indiquer le ton dans lequel est écrit l’air ou le morceau instrumental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d52601f-ec4f-487b-8ba4-9a007906229e",
                                                "sense_id": "2613865b-d1a9-3e87-9ddf-9f90269e8bc0",
                                                "text": "Armer la clef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b7572aa-d3ea-3450-b8a4-402c9ec02c49",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Résister."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "598c8466-a1ed-3bec-b62b-243d6f2780cd",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Garnir d’une protection une manœuvre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f328727-a339-3b9f-bd2d-dda21c977a4b",
                                        "entry_id": "9740dd6b-239f-3fca-a61c-5df574cee04d",
                                        "glosses": [
                                            "Enclencher un appareil photo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d283fdb9-83da-460f-9d7e-b666eddd84ec",
                                                "sense_id": "8f328727-a339-3b9f-bd2d-dda21c977a4b",
                                                "text": "Armer, zoomer, suspendre son souffle, appuyer et recommencer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
