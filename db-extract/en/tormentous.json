                        "sense_id": "c855b8e2-1f49-37a4-9ae8-4e0ef326e4a1",
                        "entry_id": "9e5cb4e2-9976-3d82-823c-9266d86b0c77",
                        "glosses": [
                            "Involving or causing torment; having the nature of torture."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d35cbc4d-ff6a-488a-a899-e6b732d8eae3",
                                "sense_id": "c855b8e2-1f49-37a4-9ae8-4e0ef326e4a1",
                                "text": "Before thee stalks inexorable Fate,\nAnd grasps impailing nails and wedges dread,\nThe hook tormentous and the melted lead."
                            },
                            {
                                "example_id": "2af435b8-1a2a-41d9-8a9e-bd3795bf2bd3",
                                "sense_id": "c855b8e2-1f49-37a4-9ae8-4e0ef326e4a1",
                                "text": "[I]ts greed gave us years tormentous and horrible, like those of Ferdinand VII."
                            },
                            {
                                "example_id": "a845b9fc-0fb6-40ce-8157-0772dc5c6d22",
                                "sense_id": "c855b8e2-1f49-37a4-9ae8-4e0ef326e4a1",
                                "text": "Few adults could have survived the tormentous, agonizing heartbreak Jimmy endured."
                            },
                            {
                                "example_id": "7aa6af0c-e324-454e-85f6-8f2fb3cd71d7",
                                "sense_id": "c855b8e2-1f49-37a4-9ae8-4e0ef326e4a1",
                                "text": "In Nigeria in particular and Africa generally, there is no winter, no heat-wave, no iceberg, no volcanoes, no hail storms, no devastating wild fires, no tormentous tornadoes or thunderstorms, no deadly floods."
                            }
                        ]
                    }
