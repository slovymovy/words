                        "sense_id": "09a0d12b-efe1-372f-b973-7025c46e0e6a",
                        "entry_id": "8b53fe2f-762a-33b1-ad9c-8c4a2f80d656",
                        "glosses": [
                            "Relatif au franricain, que l’on peut qualifier comme utilisant, à l’écrit ou à l’oral, une variété de langue qui consiste à mélanger le français et des termes ou expressions issus de la variété d’anglais commune aux États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52199ba2-d0bc-491b-ad33-699a87253c94",
                                "sense_id": "09a0d12b-efe1-372f-b973-7025c46e0e6a",
                                "text": "Elle a donné une présentation dans un style très franricain, mélangeant des phrases françaises avec des termes typiquement américains."
                            },
                            {
                                "example_id": "594afd8a-3a2d-4d7b-bc6f-6885d1d4fda3",
                                "sense_id": "09a0d12b-efe1-372f-b973-7025c46e0e6a",
                                "text": "Le marketing franricain de cette marque francophone cible clairement les jeunes influencés par la pop culture américaine."
                            }
                        ]
                    }
                ],
