                    "frequency": "High",
                    "semantic_group_id": "saveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier va <w>goûter</w> la sauce pour vérifier s'il manque du sel."
                        },
                        {
                            "text": "Tu devrais <w>goûter</w> ce gâteau au chocolat car il est vraiment délicieux."
                        }
                    ],
                    "synonyms": [
