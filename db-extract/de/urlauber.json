                                        "glosses": [
                                            "Se dit des soldats qui ont une permission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ebdfdc-cb53-4664-b813-8a50927e04de",
                                                "sense_id": "150c5745-c35b-3d94-bc48-90fef49b0f7d",
                                                "text": "Vers onze heures, un spahi permissionnaire passa. Il s'étonna de la voir encore là, …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "permissionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3655aaaf-3c67-3a3c-8275-944dd457b408",
                                        "entry_id": "4833d3ba-070e-3b8f-bb09-7fe95b000f10",
                                        "glosses": [
                                            "Soldat qui a une permission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cc31af4-29df-4f9a-88bd-51aff3fc95c0",
                                                "sense_id": "3655aaaf-3c67-3a3c-8275-944dd457b408",
                                                "text": "Les permissionnaires de dix heures."
                                            },
                                            {
                                                "example_id": "541d57a0-f3ad-4efb-8478-45e3ea02f16c",
                                                "sense_id": "3655aaaf-3c67-3a3c-8275-944dd457b408",
                                                "text": "Le permissionnaire commandait deux bières."
                                            },
                                            {
                                                "example_id": "49b36fcd-5a5b-438e-9232-762913ac36d0",
                                                "sense_id": "3655aaaf-3c67-3a3c-8275-944dd457b408",
                                                "text": "Grâce au labeur acharné des femmes, des enfants, des vieillards, des malingres et aussi des permissionnaires et des blessés convalescents, les forces secrètes de la terre avaient pu donner leur plein rendement."
                                            },
                                            {
                                                "example_id": "22767942-5be3-4ea5-9bef-454110c88848",
                                                "sense_id": "3655aaaf-3c67-3a3c-8275-944dd457b408",
                                                "text": "Tout au fond, à la terrasse du grand buffet, un groupe de permissionnaires chantaient en interrompant chaque refrain par des beuglements ou des éclats de rire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
