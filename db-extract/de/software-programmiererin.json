                "senses": [
                    {
                        "sense_id": "b1254891-d1ee-34e8-ab18-1792ee1780d8",
                        "entry_id": "5157955f-defd-3af1-ba05-df003fe8dac4",
                        "glosses": [
                            "weibliche Person, die (vorwiegend) Programmcode für Software schreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4266d49f-a53c-4d30-a698-9a43f1cfda2e",
                                "sense_id": "b1254891-d1ee-34e8-ab18-1792ee1780d8",
                                "text": "„Mit Ende 20 hatte die Software-Programmiererin einen gut bezahlten Job in Berlin.“"
                            },
                            {
                                "example_id": "38c62024-23af-4a15-b7de-f237b0797c20",
                                "sense_id": "b1254891-d1ee-34e8-ab18-1792ee1780d8",
                                "text": "„Für eine Software-Programmiererin zum Beispiel, die Spanisch spricht und Steueroptimierungsprogramme für südamerikanische Unternehmen entwirft, dürfte es auf dem hiesigen Arbeitsmarkt nur wenige weitere Optionen geben.“"
                            },
                            {
                                "example_id": "ea1146ce-6323-4e67-a6eb-07f5fa31000d",
                                "sense_id": "b1254891-d1ee-34e8-ab18-1792ee1780d8",
                                "text": "„Als Midori Kocak – eine türkische Software-Programmiererin und Netzaktivistin, die im Exil lebt – davon erfuhr, machte sie sich, wie sie sagt, ‚zunächst nur aus Spaß‘ daran, eine App zu programmieren, mit der man das erzwungene Beweisfoto der Jastimme fälschen kann.“"
                            },
                            {
                                "example_id": "5ad6deb6-ecc7-4d1c-bbad-61b8bbe9ff04",
                                "sense_id": "b1254891-d1ee-34e8-ab18-1792ee1780d8",
                                "text": "„Die Kanzlerin ermuntert sie, ihren Beruf unabhängig vom Geschlecht zu wählen. Das gelte auch für Jungen. ‚Der Erzieher sollte genauso selbstverständlich und anerkannt sein wie die Software-Programmiererin oder die Ingenieurin‘, betont Merkel.“"
                            },
                            {
                                "example_id": "32c65f08-3f1a-4e4d-b2d6-e547c8555bc9",
                                "sense_id": "b1254891-d1ee-34e8-ab18-1792ee1780d8",
                                "text": "„Die Software-Programmiererin ging zum Wachschutz, bat darum, die Videobänder der Überwachungskamera anschauen zu dürfen, identifizierte eindeutig Wieland W. als Unfallverursacher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
