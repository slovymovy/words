{
    "word_family": [
        "mucky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26c93a7d-65ea-32db-916d-732c5d8a34c0",
                    "sense_definition": "Slimy mud or sludge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dirt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was covered in <w>muck</w> from the rally race.",
                            "target_lang_translations": {
                                "zh": "车上沾满了拉力赛留下的<w>淤泥</w>。",
                                "fr": "La voiture était couverte de <w>boue</w> provenant de la course de rallye."
                            }
                        },
                        {
                            "text": "I need to clean the <w>muck</w> off my shirt after walking through the field.",
                            "target_lang_translations": {
                                "zh": "穿过田野后，我得把衬衫上的<w>淤泥</w>洗掉。",
                                "fr": "Je dois nettoyer la <w>boue</w> sur ma chemise après avoir marché dans le champ."
                            }
                        }
                    ],
                    "synonyms": [
                        "mud",
                        "sludge"
                    ],
                    "common_phrases": [
                        "thick muck"
                    ],
                    "target_lang_definitions": {
                        "zh": "黏糊糊的泥浆或淤泥。",
                        "fr": "Boue visqueuse ou mélange de terre et d'eau."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "淤泥",
                                "target_lang_sense_clarification": "指沉积在水底或地面的黏软泥土。"
                            },
                            {
                                "target_lang_word": "泥浆",
                                "target_lang_sense_clarification": "指混合了水的泥土，通常呈黏稠状。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "boue",
                                "target_lang_sense_clarification": "Mélange de terre et d'eau, souvent collant."
                            },
                            {
                                "target_lang_word": "gadoue",
                                "target_lang_sense_clarification": "Terme familier pour désigner de la boue ou de la neige fondue sale."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d02e91c-61f1-3d65-9524-f21d911e053d",
                    "sense_definition": "Anything filthy, vile, or dirty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dirt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What is that green <w>muck</w> on the floor?",
                            "target_lang_translations": {
                                "zh": "地板上那团绿色的<w>脏东西</w>是什么？",
                                "fr": "Qu'est-ce que c'est que cette <w>saleté</w> verte sur le sol ?"
                            }
                        },
                        {
                            "text": "Please wipe away that <w>muck</w> before someone slips.",
                            "target_lang_translations": {
                                "zh": "请把那块<w>污垢</w>擦掉，免得有人滑倒。",
                                "fr": "S'il te plaît, essuie cette <w>crasse</w> avant que quelqu'un ne glisse."
                            }
                        }
                    ],
                    "synonyms": [
                        "dirt",
                        "filth"
                    ],
                    "target_lang_definitions": {
                        "zh": "任何肮脏、污秽或令人厌恶的东西。",
                        "fr": "Toute substance sale, répugnante ou indésirable."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "污垢",
                                "target_lang_sense_clarification": "指物体表面积聚的脏东西。"
                            },
                            {
                                "target_lang_word": "脏东西",
                                "target_lang_sense_clarification": "泛指一切不洁净的物质。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "saleté",
                                "target_lang_sense_clarification": "Chose sale ou impure."
                            },
                            {
                                "target_lang_word": "crasse",
                                "target_lang_sense_clarification": "Saleté épaisse et tenace."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e183013f-0428-30d0-ab85-8f5abb8adc45",
                    "sense_definition": "To remove manure or dirt from a place, typically a stable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>muck</w> the stable before it gets too thick.",
                            "target_lang_translations": {
                                "zh": "在粪便堆积太厚之前，我们需要<w>清理</w>马厩。",
                                "fr": "Nous devons <w>curer</w> l'écurie avant que cela ne devienne trop épais."
                            }
                        },
                        {
                            "text": "It takes all morning to <w>muck</w> out the horse stalls.",
                            "target_lang_translations": {
                                "zh": "<w>清理</w>马厩里的粪便花了一整个上午。",
                                "fr": "Il faut toute la matinée pour <w>curer</w> les stalles des chevaux."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muck out"
                    ],
                    "target_lang_definitions": {
                        "zh": "清理马厩等地方的粪便或污物。",
                        "fr": "Nettoyer un lieu, comme une écurie, en enlevant le fumier ou les excréments."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清理",
                                "target_lang_sense_clarification": "指清除杂物或污垢。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "curer",
                                "target_lang_sense_clarification": "Nettoyer en enlevant la boue ou le fumier d'un lieu."
                            },
                            {
                                "target_lang_word": "nettoyer",
                                "target_lang_sense_clarification": "Action générale de rendre propre."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6c0fe1d5-06c1-3cc4-8b4f-555b163dc472",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the report is Mr. <w>Muck</w>.",
                            "target_lang_translations": {
                                "zh": "这份报告的作者是<w>马克</w>先生。",
                                "fr": "L'auteur du rapport est M. <w>Muck</w>."
                            }
                        },
                        {
                            "text": "I met a family named <w>Muck</w> at the conference.",
                            "target_lang_translations": {
                                "zh": "我在会议上遇到了一户姓<w>马克</w>的人家。",
                                "fr": "J'ai rencontré une famille nommée <w>Muck</w> lors de la conférence."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。",
                        "fr": "Un nom de famille."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "马克",
                                "target_lang_sense_clarification": "用于音译外国姓氏。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "Muck",
                                "target_lang_sense_clarification": "Nom propre, reste inchangé en français."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b2feeab-b11e-376e-add0-f6fb41fb5ace",
                    "sense_definition": "A small island in the Small Isles, Scotland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a ferry to the island of <w>Muck</w>.",
                            "target_lang_translations": {
                                "zh": "我们乘渡轮去了<w>马克岛</w>。",
                                "fr": "Nous avons pris un ferry pour l'<w>île de Muck</w>."
                            }
                        },
                        {
                            "text": "The wildlife on <w>Muck</w> is protected by local laws.",
                            "target_lang_translations": {
                                "zh": "<w>马克岛</w>上的野生动物受当地法律保护。",
                                "fr": "La faune sur l'<w>île de Muck</w> est protégée par les lois locales."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to a specific location in Scotland."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "苏格兰小群岛中的一个小岛。",
                        "fr": "Une petite île des Hébrides intérieures en Écosse."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "马克岛",
                                "target_lang_sense_clarification": "苏格兰地名。"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "île de Muck",
                                "target_lang_sense_clarification": "Nom géographique, souvent traduit en ajoutant le mot île."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}