                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f62f439-67d2-4dc8-94b1-3be0a1c2caeb",
                                                "sense_id": "998cef76-a806-3194-ada9-3e266c4ab836",
                                                "text": "In Wilhelmshaven wird viel Öl durch Tanker angelandet."
                                            },
                                            {
                                                "example_id": "4994f8f0-0be2-4d34-ae2b-de274697b83a",
                                                "sense_id": "998cef76-a806-3194-ada9-3e266c4ab836",
                                                "text": "„Mit seinen Tankern gehörte er lange zu den Weltmarktführern und seine Familie in die Liga der Reichsten.“"
                                            },
                                            {
                                                "example_id": "62e25bb3-be3b-4588-8813-672da4b4ba45",
                                                "sense_id": "998cef76-a806-3194-ada9-3e266c4ab836",
                                                "text": "„Bereits beim ersten Treffer flog der Tanker in die Luft.“"
                                            },
                                            {
                                                "example_id": "cf58c472-175b-402f-ae2a-a8c722cd74bc",
                                                "sense_id": "998cef76-a806-3194-ada9-3e266c4ab836",
                                                "text": "„Mehrzweckschiffe und ein Seenotrettungskreuzer kühlten den Tanker mit großen Mengen Wasser und bekämpften den Brand von außen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7486a11-4d4f-4b88-88a7-238cc72d3ee5",
                        "source_entry_id": "85fc78c3-14ed-3a7d-9f4e-792fb795b639",
                        "source_sense_id": "ad39acb5-b7b4-3402-8857-fed9ed3aba7f",
                        "target_lang_word": "Tankschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tankschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9aec6c42-8213-3c43-b3e1-136e8137d370",
                                        "entry_id": "0f4c63d8-a5b8-33e3-94f3-746c89f9e5ab",
                                        "glosses": [
                                            "Schiff, das für den Transport flüssiger oder gasförmiger Güter bestimmt ist"
                                        ],
                                        "tags": [
                                            "Logistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735153f1-3bc6-4d80-bbf2-7d3e99489cf3",
                                                "sense_id": "9aec6c42-8213-3c43-b3e1-136e8137d370",
                                                "text": "In Wilhelmshaven wird viel Öl durch Tankschiffe angelandet."
                                            },
                                            {
                                                "example_id": "08080ce1-a2bd-43d9-8c25-4b39859c07f5",
                                                "sense_id": "9aec6c42-8213-3c43-b3e1-136e8137d370",
                                                "text": "„Bei diesem Unfall starben fünf Menschen, vier Mitarbeiter der BASF und ein Matrose, der sich auf einem Tankschiff in unmittelbarer Nähe aufhielt.“"
                                            },
                                            {
                                                "example_id": "7d615973-a75d-44fa-8149-0209bee33011",
                                                "sense_id": "9aec6c42-8213-3c43-b3e1-136e8137d370",
                                                "text": "„Am Tag nach dem Feuer auf einem mit Öl beladenen Tankschiff auf der Ostsee beginnt die Suche nach der Ursache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36548c6b-6153-45f1-ad1a-f52bbecd77b7",
                        "source_entry_id": "85fc78c3-14ed-3a7d-9f4e-792fb795b639",
                        "source_sense_id": "ad39acb5-b7b4-3402-8857-fed9ed3aba7f",
                        "target_lang_word": "танкер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "танкер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "51a4797c-557f-3981-92d3-55f5b228acdb",
                                        "entry_id": "79f034fe-f4a3-31e4-a952-c670e6f86eec",
                                        "glosses": [
                                            "морск. судно, предназначенное для перевозки жидких грузов в танках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3bb6a3-da3f-4c79-9815-e0caa9653b3d",
                                                "sense_id": "51a4797c-557f-3981-92d3-55f5b228acdb",
                                                "text": "Я назначен на «Дербент» — один из танкеров новой постройки. Это, знаете ли, плавучие цистерны гигантских размеров."
                                            },
                                            {
                                                "example_id": "d48026e0-0078-457a-9f18-bc7205339521",
                                                "sense_id": "51a4797c-557f-3981-92d3-55f5b228acdb",
                                                "text": "Вскоре вся команда знала, что принят сигнал бедствия: в открытом океане горит американский танкер десяти тысяч тонн водоизмещением, идущий из Сан-Франциско с грузом нефти."
                                            },
                                            {
                                                "example_id": "5be3558b-94a2-49df-9d7a-28a5fd653cff",
                                                "sense_id": "51a4797c-557f-3981-92d3-55f5b228acdb",
                                                "text": ".. один советский танкер, шедший на Кубу с нефтью, был остановлен и проверен, но, поскольку нефть не относится к категории стратегических грузов наступательного характера, танкеру было разрешено следовать дальше."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b0214f3-6666-3515-bd81-c83aa662fd62",
                                        "entry_id": "79f034fe-f4a3-31e4-a952-c670e6f86eec",
                                        "glosses": [
                                            "авиац. самолёт, предназначенный для дозаправки в воздухе летательных аппаратов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c0334de-378b-4451-89c3-bf7538780a23",
                                                "sense_id": "2b0214f3-6666-3515-bd81-c83aa662fd62",
                                                "text": "Хорошо, если предстоит посадка и баки снова будут наполнены. Если же нет, придётся надеяться на взятое с собою или на помощь в воздухе. Под крыльями подвешивают дополнительные баки, хоть это и невыгодно, ибо крадёт скорость. Вот почему сейчас стали применять самолёты-заправщики — летающие танкеры, чтобы пополнять запас топлива в полёте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1f19edd-7214-3825-ba4f-496350ba5049",
                                        "entry_id": "79f034fe-f4a3-31e4-a952-c670e6f86eec",
                                        "glosses": [
                                            "разг. длинная куртка с глубоким и высоко застёгивающимся капюшоном"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
