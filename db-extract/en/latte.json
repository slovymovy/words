                                    },
                                    {
                                        "sense_id": "2c9eb12e-a7b4-3b62-a262-7957cd06c4cc",
                                        "entry_id": "335be8e7-1264-38e0-a45d-4f594c7fcc7a",
                                        "glosses": [
                                            "Ancienne dénomination de couleur de robe de base du cheval caractérisée par un pelage et des crins d’une couleur proche du jaune."
                                        ],
