                                "target_senses": [
                                    {
                                        "sense_id": "74bf2d1b-e7aa-3843-a9ae-1fca3c219fde",
                                        "entry_id": "52ebff14-5926-327e-af84-b09585a0380b",
                                        "glosses": [
                                            "A wand, usually made of wood, that is used to perform magic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d376471f-a2b3-307f-aba7-ac3837d1c867",
                                        "entry_id": "52ebff14-5926-327e-af84-b09585a0380b",
                                        "glosses": [
                                            "A means which will effect an instant solution."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "437cd236-00bc-4fb3-8a2d-b070355f113d",
                                                "sense_id": "d376471f-a2b3-307f-aba7-ac3837d1c867",
                                                "text": "We have to work hard together to find a solution. There is no magic wand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a4430bc-b3fc-37ef-9efc-13cfd260edc9",
                                        "entry_id": "52ebff14-5926-327e-af84-b09585a0380b",
                                        "glosses": [
                                            "A long vibrator with a vibrating rubber head; the Hitachi Magic Wand or any similar sex toy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684f3771-8adf-4946-abd1-091612b81b46",
                                                "sense_id": "0a4430bc-b3fc-37ef-9efc-13cfd260edc9",
                                                "text": "Stealthily, she slid her nightstand drawer open, located the knee-high sock and pulled out her magic wand vibrator, ready to go with new batteries."
                                            },
                                            {
                                                "example_id": "6a227382-b81a-45f0-bd48-528b52cbd298",
                                                "sense_id": "0a4430bc-b3fc-37ef-9efc-13cfd260edc9",
                                                "text": "The vibration wasn't as strong as that of her magic wand, but she slid the tip up and down the valley of her sex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53ee1685-c157-46e0-af67-4e7e37434387",
                        "source_entry_id": "4ebbb395-fe4e-3851-baab-a237f8dd9bdf",
                        "source_sense_id": "b1e176e3-98d1-31f1-9e7b-84924f34adda",
                        "source_sense_description": "staf om mee te toveren",
                        "target_lang_word": "baguette magique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baguette magique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f4c6b5-14fe-3758-a6a0-3479caff97c7",
                                        "entry_id": "8062dc41-1ef5-3969-a321-ed66ffe8e4df",
                                        "glosses": [
                                            "Baguette avec laquelle les magiciens et les fées sont censés faire leurs enchantements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba6791c-d7d5-449e-8584-60b622807e05",
                                                "sense_id": "b4f4c6b5-14fe-3758-a6a0-3479caff97c7",
                                                "text": "Alors, hop, un coup de baguette magique et la mer est transformée en montagne. Alors la Petite Fée reprend un coquillage, le reporte à son oreille. Et là, raté, elle entend encore la mer..."
                                            },
                                            {
                                                "example_id": "bc6031f4-a77c-426e-835c-3ae38c835a34",
                                                "sense_id": "b4f4c6b5-14fe-3758-a6a0-3479caff97c7",
                                                "text": "La question de savoir se pose si la baguette magique n'a pas perdu un peu de son pouvoir du fait qu'elle a été obtenue non par un meurtre mais par un vol habile."
                                            },
                                            {
                                                "example_id": "13918b2a-bee2-4c35-bd09-f5592697b560",
                                                "sense_id": "b4f4c6b5-14fe-3758-a6a0-3479caff97c7",
                                                "text": "— Qu'est-ce que tu croyais ? Que la chance allait enfin te sourire […] ? Mais la scoumoune qui s'est penchée sur ton berceau, avec une schlague en guise de baguette magique, elle ne te lâche plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "368b6380-6ae1-3e66-b10e-13b09d78df51",
                                        "entry_id": "8062dc41-1ef5-3969-a321-ed66ffe8e4df",
                                        "glosses": [
                                            "Tout outil dont les mérites sont vantés exagérément par ses promoteurs ou outil miraculeux."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996d0609-b5d4-42ca-bb63-812f0fb4dbeb",
                                                "sense_id": "368b6380-6ae1-3e66-b10e-13b09d78df51",
                                                "text": "La baguette magique agitée opportunément pour chercher à se faire élire ne suffit plus, ne convainc plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f545c5b5-7ea3-3fc8-b408-fe84fb93ad4d",
                                        "entry_id": "8062dc41-1ef5-3969-a321-ed66ffe8e4df",
                                        "glosses": [
                                            "Outil de sélection disponible dans plusieurs logiciels de retouche d’image permettant notamment de sélectionner des zones de pixels en fonctions de critères contextuels tels que la proximité chromatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44eb8697-9514-4d35-a191-4de0de9e24db",
                                                "sense_id": "f545c5b5-7ea3-3fc8-b408-fe84fb93ad4d",
                                                "text": "En activant le masque rapide ([…]), vous commutez vers un mode où vous pouvez peindre votre sélection ! Cela permet notamment de retoucher une sélection faite à la baguette magique ou par couleurs."
                                            },
                                            {
                                                "example_id": "61281739-536b-45ed-ad00-a88bdb7a5bdc",
                                                "sense_id": "f545c5b5-7ea3-3fc8-b408-fe84fb93ad4d",
                                                "text": "L'outil Baguette magique permet de sélectionner des portions d'images en fonction de la couleur des pixels sans tracer de contour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
