                "senses": [
                    {
                        "sense_id": "98573b16-491d-33b5-9ad6-0c4f28a96fe4",
                        "entry_id": "9b471c6c-f4ed-36a5-a2c7-ac5678b04e5e",
                        "glosses": [
                            "Feststellung darüber, welche Laute in historisch verwandten Sprachen in Wörtern oder Morphemen, die aus ein und derselben Wortform oder ein und demselben Morphem hervorgegangen sind, einander entsprechen"
                        ],
                        "tags": [
                            "speziell Historiolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "b01a5dc0-e2c5-4f47-8262-a5fb0f28ee02",
                                "sense_id": "98573b16-491d-33b5-9ad6-0c4f28a96fe4",
                                "text": "„Rasks Verdienst geschieht damit kein Abbruch, denn es ist etwas anderes, eine Reihe von Lautentsprechungen festzustellen, als den Zusammenhang zwischen einigen dieser Entsrpechungen zu behaupten.“"
                            },
                            {
                                "example_id": "4abc389b-6dc0-496f-8175-a23303aaf976",
                                "sense_id": "98573b16-491d-33b5-9ad6-0c4f28a96fe4",
                                "text": "„Und selbst unter den 20 Lautentsprechungen, auf die wir Sie im Folgenden aufmerksam machen, betreffen eine ganze Reihe nur kleine Schreibunterschiede und Abänderungen, die schon auf den ersten Blick \"durchsichtig\" sind.“"
                            },
                            {
                                "example_id": "3f9939cf-4acd-45ac-91a3-1d040aaa39b6",
                                "sense_id": "98573b16-491d-33b5-9ad6-0c4f28a96fe4",
                                "text": "„Weiterhin demonstriert Dalby, dass sich unter den Mel-Sprachen äußerst regelmäßige Lautentsprechungen aufstellen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
