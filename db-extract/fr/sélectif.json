                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8c90c9c-357c-474f-aa75-f115c4fbace5",
                                                "sense_id": "ffa03107-9b2c-3a48-a571-e0520a54266f",
                                                "text": "In the USA, military conscription is controlled by the Selective Service."
                                            }
