                "senses": [
                    {
                        "sense_id": "d1c3affe-6afe-3866-9ecd-d33921f0bbae",
                        "entry_id": "2fbae82d-497e-30fc-98e8-896bd91d3ba0",
                        "glosses": [
                            "Any ungulate mammal with an even number of toes and belonging to the Artiodactyla, including pigs, sheep, deer, cattle, and most grazing animals. In contrast, horses have an odd number of toes and as such are not Artiodactyla, but Perissodactyla."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242487f3-f755-4f7b-a869-d3b5a65eb8b2",
                                "sense_id": "d1c3affe-6afe-3866-9ecd-d33921f0bbae",
                                "text": "I have been unable to find out if these are linked in some way to the 1945 Budapest hippos, with the possibility this would create of a parallel history of Central Europe seen through the endurance of one brave African artiodactyl family."
                            }
                        ]
                    }
                ],
                "translations": [
