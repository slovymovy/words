{
    "word_family": [
        "nailer",
        "nailing",
        "nailbrush",
        "nailfile",
        "nailhead",
        "nailless",
        "nailset"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c4f2084-c0cf-386d-bb66-080f38bc50d0",
                    "sense_definition": "The thin, horny plate at the ends of fingers and toes on humans and some other animals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When I'm nervous I bite my <w>nails</w>.",
                            "target_lang_translations": {
                                "ru": "Когда я нервничаю, я грызу <w>ногти</w>."
                            }
                        },
                        {
                            "text": "She painted her finger <w>nails</w> with a bright red polish for the party.",
                            "target_lang_translations": {
                                "ru": "Она накрасила <w>ногти</w> на руках ярко-красным лаком для вечеринки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "finger nails",
                        "toe nails",
                        "bite your nails",
                        "paint your nails"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая роговая пластинка на концах пальцев рук и ног у людей и некоторых животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноготь",
                                "target_lang_sense_clarification": "на пальцах человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0b76c86-b4dd-3f63-a121-5b3bded71c71",
                    "sense_definition": "A spike-shaped metal fastener used for joining wood or similar materials, usually driven in by a hammer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tools_and_fasteners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a hammer to drive a long <w>nail</w> into the wooden board.",
                            "target_lang_translations": {
                                "ru": "Он использовал молоток, чтобы вбить длинный <w>гвоздь</w> в деревянную доску."
                            }
                        },
                        {
                            "text": "The carpenter needed a hammer and <w>nail</w> to fix the broken fence.",
                            "target_lang_translations": {
                                "ru": "Плотнику понадобились молоток и <w>гвоздь</w>, чтобы починить сломанный забор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hammer and nail",
                        "rusty nail",
                        "drive a nail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический крепеж в форме стержня, используемый для соединения древесины или подобных материалов, обычно забиваемый молотком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гвоздь",
                                "target_lang_sense_clarification": "крепежное изделие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d249d36-ccde-3f54-9d72-597f5efa8285",
                    "sense_definition": "The claw of a bird or other animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle gripped the branch tightly with every <w>nail</w> on its powerful feet.",
                            "target_lang_translations": {
                                "ru": "Орел крепко вцепился в ветку каждым <w>когтем</w> своих мощных лап."
                            }
                        },
                        {
                            "text": "You should be careful because the cat might scratch you with a sharp <w>nail</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит быть осторожным, потому что кошка может поцарапать тебя острым <w>когтем</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "claw",
                        "talon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коготь птицы или другого животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коготь",
                                "target_lang_sense_clarification": "у животных или птиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e36113e1-b693-3ca4-8001-b2bea675abf3",
                    "sense_definition": "An archaic English unit of length equivalent to 2.25 inches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old tailor measured the cloth using an ancient unit called a <w>nail</w>.",
                            "target_lang_translations": {
                                "ru": "Старый портной измерял ткань, используя древнюю единицу измерения под названием <w>нейл</w>."
                            }
                        },
                        {
                            "text": "In historical texts, you might find a <w>nail</w> used to describe the length of fabric.",
                            "target_lang_translations": {
                                "ru": "В исторических текстах можно встретить <w>нейл</w>, используемый для описания длины ткани."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical unit of measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая английская единица измерения длины, равная 2,25 дюйма (около 5,7 см)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нейл",
                                "target_lang_sense_clarification": "английская мера длины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32954b15-e288-3073-95a1-c60ced8e29e8",
                    "sense_definition": "To fix an object to another object using a metal fastener.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>nailed</w> the placard to the post so everyone could see it.",
                            "target_lang_translations": {
                                "ru": "Он <w>прибил</w> плакат к столбу, чтобы все могли его видеть."
                            }
                        },
                        {
                            "text": "Please <w>nail</w> the boards together to create a sturdy frame for the box.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>сбейте</w> доски вместе, чтобы создать прочный каркас для ящика."
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "fasten",
                        "attach"
                    ],
                    "antonyms": [
                        "screw"
                    ],
                    "common_phrases": [
                        "nail together",
                        "nail down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикрепить один предмет к другому с помощью металлического крепежа (гвоздя)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибивать",
                                "target_lang_sense_clarification": "гвоздями"
                            },
                            {
                                "target_lang_word": "приколачивать",
                                "target_lang_sense_clarification": "гвоздями"
                            },
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "гвоздь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dac7ad2a-cac0-3a6a-b662-0a899fd68f33",
                    "sense_definition": "To accomplish a task completely and successfully.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really <w>nailed</w> that test after studying all weekend.",
                            "target_lang_translations": {
                                "ru": "Я реально <w>затащил</w> этот тест после того, как учился все выходные."
                            }
                        },
                        {
                            "text": "She managed to <w>nail</w> the interview and was offered the job immediately.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>блестяще пройти</w> собеседование, и ей сразу же предложили работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "ace",
                        "master",
                        "succeed at"
                    ],
                    "common_phrases": [
                        "nail the interview",
                        "nail the performance"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить задачу полностью и успешно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справиться на отлично",
                                "target_lang_sense_clarification": "с задачей"
                            },
                            {
                                "target_lang_word": "блестяще выполнить",
                                "target_lang_sense_clarification": "что-либо"
                            },
                            {
                                "target_lang_word": "затащить",
                                "target_lang_sense_clarification": "сленг, успешно сделать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "971c5f9b-eb79-3f19-8633-040b22a295ba",
                    "sense_definition": "To catch or arrest someone, especially a criminal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police finally managed to <w>nail</w> the thief after a long investigation.",
                            "target_lang_translations": {
                                "ru": "Полиции наконец удалось <w>сцапать</w> вора после долгого расследования."
                            }
                        },
                        {
                            "text": "They are keeping low until they <w>nail</w> their man.",
                            "target_lang_translations": {
                                "ru": "Они затаились, пока не <w>поймают</w> своего человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrest",
                        "collar",
                        "nick",
                        "apprehend",
                        "capture",
                        "seize"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in crime contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поймать или арестовать кого-либо, особенно преступника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застукать",
                                "target_lang_sense_clarification": "поймать на месте"
                            },
                            {
                                "target_lang_word": "сцапать",
                                "target_lang_sense_clarification": "арестовать, поймать"
                            },
                            {
                                "target_lang_word": "прижать",
                                "target_lang_sense_clarification": "к ответственности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e314b79-57d8-33f8-af72-b80e7a560113",
                    "sense_definition": "To make certain, confirm, or finalize an agreement or detail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>nail</w> down the details of the contract before Friday.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>закрепить</w> детали контракта до пятницы."
                            }
                        },
                        {
                            "text": "The manager wants to <w>nail</w> the schedule for the next month today.",
                            "target_lang_translations": {
                                "ru": "Менеджер хочет <w>утвердить</w> расписание на следующий месяц сегодня."
                            }
                        }
                    ],
                    "synonyms": [
                        "clinch",
                        "fix",
                        "lock down",
                        "pin down"
                    ],
                    "common_phrases": [
                        "nail down the details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удостовериться, подтвердить или окончательно согласовать детали или соглашение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрепить",
                                "target_lang_sense_clarification": "договоренность"
                            },
                            {
                                "target_lang_word": "окончательно утвердить",
                                "target_lang_sense_clarification": "детали"
                            },
                            {
                                "target_lang_word": "согласовать",
                                "target_lang_sense_clarification": "подробности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a649bc9f-6605-3f16-b444-f185b26b6430",
                    "sense_definition": "To engage in sexual intercourse with someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sexual_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He boasted to his friends that he was going to <w>nail</w> her.",
                            "target_lang_translations": {
                                "ru": "Он хвастался друзьям, что собирается её <w>трахнуть</w>."
                            }
                        },
                        {
                            "text": "The movie character made a crude joke about wanting to <w>nail</w> his date.",
                            "target_lang_translations": {
                                "ru": "Киногерой грубо пошутил о том, что хочет <w>вдуть</w> своей спутнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "bang",
                        "screw",
                        "shag",
                        "hump"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar or highly informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступить в половую связь с кем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трахнуть",
                                "target_lang_sense_clarification": "грубо, сленг"
                            },
                            {
                                "target_lang_word": "вдуть",
                                "target_lang_sense_clarification": "вульгарно"
                            },
                            {
                                "target_lang_word": "чпокнуть",
                                "target_lang_sense_clarification": "разговорно-сниженное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "05a5d9dc-02bd-313f-9dc2-075cd6c971a1",
                    "sense_definition": "A surname transferred from a nickname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named John <w>Nail</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Джон <w>Нейл</w>."
                            }
                        },
                        {
                            "text": "We are visiting the <w>Nails</w> at their family home this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные мы навещаем <w>Нейлов</w> в их семейном доме."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, произошедшая от прозвища."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нейл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}