{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8aa1cd67-d1bd-3a4f-910c-093732f96b9e",
                    "sense_definition": "A standard, criterion, or benchmark by which something is judged, evaluated, or compared.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classic novel serves as a cultural <w>touchstone</w> for an entire generation of readers.",
                            "target_lang_translations": {
                                "ru": "Этот классический роман служит культурным <w>ориентиром</w> для целого поколения читателей."
                            }
                        },
                        {
                            "text": "Customer satisfaction remained the primary <w>touchstone</w> for measuring the team's overall success.",
                            "target_lang_translations": {
                                "ru": "Удовлетворённость клиентов оставалась главным <w>критерием</w> оценки общего успеха команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "benchmark",
                        "criterion",
                        "standard",
                        "yardstick"
                    ],
                    "common_phrases": [
                        "cultural touchstone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандарт, критерий или эталон, по которому что-либо оценивается, судится или сравнивается."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробный камень",
                                "target_lang_sense_clarification": "в переносном значении: критерий или испытание"
                            },
                            {
                                "target_lang_word": "критерий",
                                "target_lang_sense_clarification": "мерило для оценки"
                            },
                            {
                                "target_lang_word": "эталон",
                                "target_lang_sense_clarification": "образец для сравнения"
                            },
                            {
                                "target_lang_word": "мерило",
                                "target_lang_sense_clarification": "стандарт или ориентир"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be5f5094-2b64-31b1-8995-cce04c3d98d4",
                    "sense_definition": "A hard, dark stone used to test the purity of gold or silver by observing the mark left when rubbed against it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler rubbed the antique coin against a <w>touchstone</w> to verify its purity.",
                            "target_lang_translations": {
                                "ru": "Ювелир потёр старинную монету о <w>пробирный камень</w>, чтобы проверить её пробу."
                            }
                        },
                        {
                            "text": "Before modern chemical assays, miners relied on a <w>touchstone</w> to evaluate their finds.",
                            "target_lang_translations": {
                                "ru": "До появления современных химических анализов старатели полагались на <w>пробирный камень</w> для оценки своих находок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдый тёмный камень, используемый для проверки чистоты золота или серебра по цвету черты, остающейся при трении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробирный камень",
                                "target_lang_sense_clarification": "минерал для определения пробы драгоценных металлов"
                            },
                            {
                                "target_lang_word": "лидит",
                                "target_lang_sense_clarification": "минералогический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a4c60eb7-89c8-3b6d-b848-88d9a768b5fa",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We scheduled an appointment with Dr. <w>Touchstone</w> at the clinic yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мы записались на приём к доктору <w>Тачстоуну</w> в клинике."
                            }
                        },
                        {
                            "text": "The local library was named in honor of the <w>Touchstone</w> family.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Тачстоун</w>."
                            }
                        }
                    ],
                    "traits": [
