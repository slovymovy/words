                        "glosses": [
                            "The state or condition of being smokeless."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0792122b-a507-4342-8c2f-275e8001a03c",
                                "sense_id": "1d06de9f-659a-3be3-8720-1bf6f093a969",
                                "text": "By the engine stood a dark, motionless being, a sooty and grimy embodiment of tallness, in a sort of trance, with a heap of coals by his side: it was the engine-man. The isolation of his manner and colour lent him the appearance of a creature from Tophet, who had strayed into the pellucid smokelessness of this region of yellow grain and pale soil, with which he had nothing in common, to amaze and to discompose its aborigines."
                            },
                            {
                                "example_id": "68851e39-2902-4827-a504-651cbdf952b9",
                                "sense_id": "1d06de9f-659a-3be3-8720-1bf6f093a969",
                                "text": "The sharp “crack” of the weapon, its smokelessness, and the peculiar screech of the nickel bullets filled them with awe […]"
                            },
                            {
                                "example_id": "b62d39b0-44da-430e-851e-df8ac2c10f96",
                                "sense_id": "1d06de9f-659a-3be3-8720-1bf6f093a969",
                                "text": "My beer glass is empty. My cigarette has burned down to near smokelessness, hardly any company to deflect being in this bar alone."
                            }
                        ]
                    }
