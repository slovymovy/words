                        "glosses": [
                            "Suitable for scribbling upon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4d9a59-64d9-45ea-89c3-978445e6f24d",
                                "sense_id": "786e8fc4-f043-3c2b-acb7-0f09ca76b7bd",
                                "text": "But I believe most travellers have much nobler sensations in Virgil's tomb, and there is a great deal of testimony borne to their lofty sentiments on every scribbleable inch of its walls."
                            },
                            {
                                "example_id": "9bca13a3-7275-4b98-b2b6-a572ebe8f5e2",
                                "sense_id": "786e8fc4-f043-3c2b-acb7-0f09ca76b7bd",
                                "text": "He […] commenced to scribble on any scribbleable surface that could be found, no mean task aboard a whaler, which is not fitted out in any wise for penmen or for scholars."
                            },
                            {
                                "example_id": "b0d73e97-ab06-4d26-ad77-aa2fee97bbdd",
                                "sense_id": "786e8fc4-f043-3c2b-acb7-0f09ca76b7bd",
                                "text": "Scrawled over every scribbleable surface, they are tattoos in time; the result of fresh-risen panic as the console operator failed to find paper quick enough to scribble the numberplate of a car […]"
                            }
                        ]
                    }
