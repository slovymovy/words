                "senses": [
                    {
                        "sense_id": "0f24c07b-83d9-3dca-a96c-c6c628f1694e",
                        "entry_id": "c42c7a12-0e1a-3c4c-a5c2-a99ff85b3ab1",
                        "glosses": [
                            "erster Tag im Jahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a107c1a-fc54-4507-a1e6-6c730045b707",
                                "sense_id": "0f24c07b-83d9-3dca-a96c-c6c628f1694e",
                                "text": "„Zwar geschah es an diesem Neujahrstag sozusagen vor der falschen Verwandtschaft, der Verwandtschaft mütterlicherseits, doch ich holte das missglückte Ständchen zum Geburtstag des falschen Großvaters in Rüpprich nun in Dondorf nach.“"
                            },
                            {
                                "example_id": "d641cec6-cb10-47e8-bc00-ab0e708e8799",
                                "sense_id": "0f24c07b-83d9-3dca-a96c-c6c628f1694e",
                                "text": "„Am Neujahrstag 1945 herrschte in Europa tiefster Winter.“"
                            },
                            {
                                "example_id": "f6389927-47b3-4ee0-94d3-21f51eafdeb1",
                                "sense_id": "0f24c07b-83d9-3dca-a96c-c6c628f1694e",
                                "text": "„Am Neujahrstag 1934 stirbt Jakob Wassermann, sechzig Jahre alt, in seiner Villa in Altaussee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
