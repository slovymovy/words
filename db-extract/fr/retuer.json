                "senses": [
                    {
                        "sense_id": "b5d20f2a-9386-3cb8-ace1-de57237ffd29",
                        "entry_id": "0011ee38-af27-3e13-a969-0a276cf83065",
                        "glosses": [
                            "Sens médiéval: Tuer en retour"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1320504-caad-4c9a-bcfb-c238dbf19903",
                                "sense_id": "b5d20f2a-9386-3cb8-ace1-de57237ffd29",
                                "text": "Et cele ou cil qui autrui tue,\nPar jugement on le retue."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f83df1f-02cd-3191-948d-e042bc451e4b",
                        "entry_id": "0011ee38-af27-3e13-a969-0a276cf83065",
                        "glosses": [
                            "Tuer une seconde fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4765d57d-8dbc-495e-abb5-6c77df044238",
                                "sense_id": "2f83df1f-02cd-3191-948d-e042bc451e4b",
                                "text": "Je te retuerais si j’en croyais ma colère !"
                            },
                            {
                                "example_id": "fb2a0a64-fe1e-4a4d-8b34-ffb97afd85e3",
                                "sense_id": "2f83df1f-02cd-3191-948d-e042bc451e4b",
                                "text": "Je vais retuer Mme Lejanvier avec votre propre soufflant, tirer une balle qui suivra la même trajectoire que la première — sein gauche, poumon droit, omoplate droit, à vue de nez — mais forera un trou plus large…"
                            },
                            {
                                "example_id": "251ede15-0141-4476-9f2a-e288136c0937",
                                "sense_id": "2f83df1f-02cd-3191-948d-e042bc451e4b",
                                "text": "Le cochon ! s’il était pas mort, je le retuerais !"
                            }
                        ]
                    }
