                "senses": [
                    {
                        "sense_id": "c3c76a73-c4ce-323a-b1e8-fbf1e929fcc6",
                        "entry_id": "9850d93e-a76d-3045-b62d-6c0b06ceb09c",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "632eddbb-7f10-47ff-819d-8a30c46b177c",
                                "sense_id": "c3c76a73-c4ce-323a-b1e8-fbf1e929fcc6",
                                "text": "Noémie est très jolie\n Moins que Zoé, mais plus que Nathalie\n Anatole il est frivole\n Monsieur Gaston s’occupe du téléfon."
                            },
                            {
                                "example_id": "29af3499-31fb-4351-a4d5-d8270ad4aeca",
                                "sense_id": "c3c76a73-c4ce-323a-b1e8-fbf1e929fcc6",
                                "text": "Julia revient à ce qui l’a fait connaître, confie Noémie Lefort, réalisatrice et fan de l’actrice américaine."
                            },
                            {
                                "example_id": "f0698ad1-57b7-4882-ac28-1867753e7804",
                                "sense_id": "c3c76a73-c4ce-323a-b1e8-fbf1e929fcc6",
                                "text": "Dans la saison 2, lancée jeudi sur OCS Max, on retrouve Stéphanie (Noémie Schmidt), Toni (Paul Scarfoglio) et Simon (Arthur Mazet), désormais à l’étroit dans les sous-sols du quotidien Libération, pour y développer 3615 Turlu."
                            }
                        ]
                    }
                ],
