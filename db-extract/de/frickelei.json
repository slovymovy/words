                "senses": [
                    {
                        "sense_id": "f863687d-6ff0-3195-8f73-6b1a0ab62757",
                        "entry_id": "15c1a3a7-748d-382e-abff-2b6cc38cb253",
                        "glosses": [
                            "mühselige Kleinarbeit, Bastelei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2787465a-d9e2-43c5-b0dc-e770462872e7",
                                "sense_id": "f863687d-6ff0-3195-8f73-6b1a0ab62757",
                                "text": "„Meist ist einer solchen Frickelei jedoch keine große Zukunft beschieden.“"
                            },
                            {
                                "example_id": "fba29dbe-e212-4f67-b45d-8042280b35c4",
                                "sense_id": "f863687d-6ff0-3195-8f73-6b1a0ab62757",
                                "text": "„Diese Frickelei auf der MPC war eine richtige Schweinearbeit. Im Gegensatz zu einem Computer musste man noch alles manuell einstellen, selbst an den Rädchen drehen und so.“"
                            },
                            {
                                "example_id": "884ad537-f465-4ad3-b35c-2109ad7d812b",
                                "sense_id": "f863687d-6ff0-3195-8f73-6b1a0ab62757",
                                "text": "„Links ist die Zange damit beschäftigt, immer wieder Fettfetzen beiseite zu schieben. „Eine schöne Frickelei!“, sagt Falk, während er sein Handgelenk elegant kreisen lässt.“"
                            },
                            {
                                "example_id": "5fe90f62-7c95-486c-a88c-231655ed9093",
                                "sense_id": "f863687d-6ff0-3195-8f73-6b1a0ab62757",
                                "text": "„Am ehesten erinnert ihre erfrischend respektlose und auch nicht immer ganz ernst gemeinte Frickelei mit Tonquellen aller Art an Fatboy Slim aus Großbritannien.“"
                            },
                            {
                                "example_id": "101281c2-cf51-4d22-8134-f7c2536b6d65",
                                "sense_id": "f863687d-6ff0-3195-8f73-6b1a0ab62757",
                                "text": "„Das Bild wirkte stets ein wenig kühl und blass, auch allerlei Frickelei im übersichtlichen, aber seltsam übersetzten Einstellungsmenü verbesserte die Farben nur wenig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
