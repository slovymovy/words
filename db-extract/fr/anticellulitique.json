                    {
                        "sense_id": "316868eb-46eb-320a-9269-3d53253019ef",
                        "entry_id": "fca50c42-dd44-31b0-90e7-973df3f3b4e9",
                        "glosses": [
                            "Qui lutte contre la cellulite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982e82ae-9882-4ecd-ae22-c34cce37a3ce",
                                "sense_id": "316868eb-46eb-320a-9269-3d53253019ef",
                                "text": "Chacun a le choix : un bain peut être envisagé comme un soin respiratoire et oxygénant, ou circulatoire et anticellulitique, ou encore relaxant et sensuel."
                            },
                            {
                                "example_id": "6ea1880e-8ea2-4f9c-8b65-2939471d64f7",
                                "sense_id": "316868eb-46eb-320a-9269-3d53253019ef",
                                "text": "Riche en propriétés, elle est anti-inflammatoire, anticellulitique, vasodilatatrice, digestive, sédative, antifongique, antilevure…"
                            },
                            {
                                "example_id": "a8cba6bc-eb7d-469c-8196-08b2588b5b31",
                                "sense_id": "316868eb-46eb-320a-9269-3d53253019ef",
                                "text": "Il présente (comme les extraits de soja) des effets légèrement amaigrissants, antiœdémateux et anticellulitiques, peut-être dus à une action sur le rein (diurétique) et cardioprotectrice."
                            }
                        ]
                    }
