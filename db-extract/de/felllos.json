                        "glosses": [
                            "ohne durchgehende Behaarung (Fell), mit abgezogenem Pelz/Fell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "872fa216-1919-43e1-b219-24b6b258adba",
                                "sense_id": "69e84463-72bc-31b7-972d-c1e8d01046c5",
                                "text": "„Er schaltete einen 3D-Screen ein und gab uns den Blick frei in Gehege und Höhlen auf – nackte Tiere. Felllos und merkwürdig splitterfasernackt.“"
                            },
                            {
                                "example_id": "c0946563-96af-467c-b5dc-ed06e4dca3ba",
                                "sense_id": "69e84463-72bc-31b7-972d-c1e8d01046c5",
                                "text": "„[…]; sogar Gerüche nach wildem rohen Fleisch – das waren fette Kaninchen, die blutig und felllos an Holzstecken hingen, […]“"
                            }
                        ],
