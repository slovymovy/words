            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edb3eb35-1247-3da3-8b55-cb87ab410eac",
                    "sense_definition": "Répartir des objets, des parts ou des éléments entre plusieurs personnes ou en différents lieux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repartition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>distribue</w> les feuilles d'examen à tous les élèves de la classe."
                        },
                        {
                            "text": "Avant de commencer la partie, il faut <w>distribuer</w> les cartes à chaque joueur."
                        }
                    ],
                    "synonyms": [
                        "répartir",
                        "partager",
                        "donner"
                    ],
                    "antonyms": [
                        "réunir"
                    ],
                    "common_phrases": [
                        "distribuer des tracts",
                        "distribuer les cartes",
                        "distribuer le courrier"
                    ]
                },
                {
                    "sense_id": "dbe28cc4-bcb0-3f93-8986-ea46bdc7d3ae",
                    "sense_definition": "Assurer la commercialisation et la diffusion d'un produit auprès des détaillants ou des clients.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande marque <w>distribue</w> ses produits cosmétiques dans des magasins spécialisés."
                        },
                        {
                            "text": "Notre entreprise cherche un nouveau partenaire pour <w>distribuer</w> cette application en Europe."
                        }
                    ],
                    "common_phrases": [
                        "distribuer une marque",
                        "distribuer un film",
                        "distribuer un produit"
                    ]
                },
                {
                    "sense_id": "7ad9f864-572c-3700-91ba-4d9907347a3f",
                    "sense_definition": "Disposer, agencer ou ordonner les différentes parties d'un tout selon un plan déterminé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte a su bien <w>distribuer</w> les pièces pour tirer profit de la lumière naturelle."
                        },
                        {
                            "text": "L'auteur a habilement <w>distribué</w> son essai en trois grandes parties équilibrées."
                        }
                    ],
                    "synonyms": [
                        "ordonner",
                        "classer"
                    ],
                    "common_phrases": [
                        "distribuer les rôles",
                        "distribuer les pièces"
                    ]
                },
                {
                    "sense_id": "ff6ee2ff-ca24-334b-bb12-2497f69dd66d",
                    "sense_definition": "Donner ou infliger généreusement, profusément ou sans discernement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "repartition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre n'a pas hésité à <w>distribuer</w> des cartons jaunes pour calmer les deux équipes."
                        },
                        {
                            "text": "En colère, le manifestant s'est mis à <w>distribuer</w> des coups autour de lui."
