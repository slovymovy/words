                        "glosses": [
                            "Mauvaise grâce, mauvaise humeur, rancune, animosité, mauvaise volonté contre quelqu'un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d401e1d-08a2-4408-b8c0-eb9ce3e0e554",
                                "sense_id": "986f15aa-a097-392c-930c-b8e3be404fd8",
                                "text": "J'ai quelque maltalent contre M. de Malesherbes, qui protége les feuilles de Fréron."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c70bf65-2ede-3f6b-b9aa-156b87b2e55b",
                        "entry_id": "289bc577-e656-3d4a-90eb-c9e1ad979013",
                        "glosses": [
                            "Absence de talent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffeb4e2e-4118-4f4e-b5e1-d0365f8e57a8",
                                "sense_id": "3c70bf65-2ede-3f6b-b9aa-156b87b2e55b",
                                "text": "Gouvernement de maltalent,\nMégathérium ou bacille,\nSoldat brut, robin insolent,\n…\nTout cela son courroux chrétien\nL’écrase d’un mépris agile."
                            },
                            {
                                "example_id": "f974f29b-ac9c-4cd6-909c-20004d768d00",
                                "sense_id": "3c70bf65-2ede-3f6b-b9aa-156b87b2e55b",
                                "text": "Car, ici aussi, quelque relâchement, que complémente et corolle, on serait tenté de le croire, quelque maltalent pour la bonne administration et l’équanimité surtout qu’il faudrait pour faire mieux, règne trop et ne gouverne pas assez."
                            }
                        ]
                    }
