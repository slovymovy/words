                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98598f94-5978-4d0f-a497-20fe7d680376",
                                "sense_id": "980c553c-f963-3163-bbf5-134bd27c7611",
                                "text": "Na stopień podporucznika – jako pierwszy stopień oficerski – mianuje Prezydent RP."
                            }
