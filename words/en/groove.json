{
    "word_family": [
        "groovy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c33ce8b8-cbd3-3a70-b153-ce42811eacac",
                    "sense_definition": "A long, narrow cut, channel, or depression in a hard material or surface.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_channel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter cut a deep <w>groove</w> in the wood to fit the panel.",
                            "target_lang_translations": {
                                "ru": "Плотник прорезал в дереве глубокий <w>паз</w>, чтобы вставить панель.",
                                "it": "Il falegname ha tagliato un <w>solco</w> profondo nel legno per inserire il pannello."
                            }
                        },
                        {
                            "text": "Water had worn a <w>groove</w> into the rock over many years.",
                            "target_lang_translations": {
                                "ru": "За много лет вода проточила в скале <w>канавку</w>.",
                                "it": "L'acqua aveva scavato un <w>solco</w> nella roccia nel corso di molti anni."
                            }
                        }
                    ],
                    "synonyms": [
                        "channel",
                        "furrow",
                        "slot",
                        "trench"
                    ],
                    "antonyms": [
                        "ridge"
                    ],
                    "common_phrases": [
                        "cut a groove",
                        "deep groove",
                        "shallow groove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный узкий разрез, канал или углубление в твердом материале или поверхности.",
                        "it": "Un taglio, canale o depressione lungo e stretto in un materiale o superficie dura."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паз",
                                "target_lang_sense_clarification": "техническое углубление, выемка"
                            },
                            {
                                "target_lang_word": "желобок",
                                "target_lang_sense_clarification": "небольшое углубление"
                            },
                            {
                                "target_lang_word": "канавка",
                                "target_lang_sense_clarification": "длинное углубление"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "solco",
                                "target_lang_sense_clarification": "fenditura lunga e stretta in una superficie"
                            },
                            {
                                "target_lang_word": "scanalatura",
                                "target_lang_sense_clarification": "concavità longitudinale, spesso tecnica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a058949c-0175-39bc-9dfd-98c31faaeb8f",
                    "sense_definition": "A pronounced, enjoyable rhythm in music that makes people want to move.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "musical_rhythm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bass player and drummer locked into a tight <w>groove</w>.",
                            "target_lang_translations": {
                                "ru": "Басист и барабанщик поймали четкий <w>грув</w>.",
                                "it": "Il bassista e il batterista hanno trovato un <w>groove</w> perfetto."
                            }
                        },
                        {
                            "text": "Everyone at the party started dancing to the funky <w>groove</w>.",
                            "target_lang_translations": {
                                "ru": "Все на вечеринке начали танцевать под фанковый <w>ритм</w>.",
                                "it": "Tutti alla festa hanno iniziato a ballare seguendo quel <w>ritmo</w> funky."
                            }
                        }
                    ],
                    "synonyms": [
                        "rhythm",
                        "beat"
                    ],
                    "common_phrases": [
                        "funky groove",
                        "feel the groove",
                        "catchy groove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчетливо выраженный, приятный ритм в музыке, побуждающий к движению.",
                        "it": "Un ritmo musicale pronunciato e piacevole che invita al movimento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грув",
                                "target_lang_sense_clarification": "музыкальный термин"
                            },
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "музыкальный такт"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "groove",
                                "target_lang_sense_clarification": "ritmo ciclico tipico della musica moderna"
                            },
                            {
                                "target_lang_word": "ritmo",
                                "target_lang_sense_clarification": "cadenza musicale coinvolgente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef07b490-e2e8-38a7-988f-00213cd50ccd",
                    "sense_definition": "A fixed routine, habit, or a state of operating smoothly and efficiently.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "routine_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a few weeks at the new job, she finally settled into a comfortable <w>groove</w>.",
                            "target_lang_translations": {
                                "ru": "Проработав несколько недель на новом месте, она наконец вошла в комфортную <w>колею</w>.",
                                "it": "Dopo alcune settimane nel nuovo lavoro, ha finalmente trovato la sua <w>routine</w> ideale."
                            }
                        },
                        {
                            "text": "The team struggled to get into a <w>groove</w> during the first half of the game.",
                            "target_lang_translations": {
                                "ru": "Команда с трудом пыталась войти в <w>ритм</w> в первой половине игры.",
                                "it": "La squadra ha faticato a trovare il <w>ritmo</w> giusto durante il primo tempo della partita."
                            }
                        }
                    ],
                    "synonyms": [
                        "routine",
                        "rut",
                        "flow"
                    ],
                    "common_phrases": [
                        "get into a groove",
                        "stuck in a groove",
                        "settle into a groove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устоявшийся порядок, привычка или состояние слаженной и эффективной работы.",
                        "it": "Una routine fissa, un'abitudine o uno stato di funzionamento fluido ed efficiente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колея",
                                "target_lang_sense_clarification": "привычный ход жизни"
                            },
                            {
                                "target_lang_word": "ритм",
                                "target_lang_sense_clarification": "рабочий режим"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "routine",
                                "target_lang_sense_clarification": "sistema quotidiano abituale"
                            },
                            {
                                "target_lang_word": "tran tran",
                                "target_lang_sense_clarification": "azione ripetitiva e monotona"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61cf35fa-abbb-351a-8258-112d9b2bb4a3",
                    "sense_definition": "To perform, dance to, or enjoy rhythmic music.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "musical_rhythm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>groove</w> as soon as the band started playing.",
                            "target_lang_translations": {
                                "ru": "Толпа начала <w>танцевать</w>, как только группа заиграла.",
                                "it": "La folla ha iniziato a <w>ballare</w> non appena la band ha iniziato a suonare."
                            }
                        },
                        {
                            "text": "He likes to <w>groove</w> to jazz music while he cooks dinner.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>пританцовывать</w> под джаз, пока он готовит ужин.",
                                "it": "Gli piace <w>muoversi a ritmo</w> di jazz mentre prepara la cena."
                            }
                        }
                    ],
                    "synonyms": [
                        "dance",
                        "jam"
                    ],
                    "common_phrases": [
                        "groove to the music",
                        "groove along"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal contexts regarding music and dancing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять, танцевать или наслаждаться ритмичной музыкой.",
                        "it": "Eseguire, ballare o godersi musica ritmata."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танцевать",
                                "target_lang_sense_clarification": "двигаться под музыку"
                            },
                            {
                                "target_lang_word": "кайфовать",
                                "target_lang_sense_clarification": "наслаждаться музыкой (разг.)"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ballare",
                                "target_lang_sense_clarification": "muoversi a ritmo di musica"
                            },
                            {
                                "target_lang_word": "muoversi a ritmo",
                                "target_lang_sense_clarification": "lasciarsi trasportare dalla musica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af081611-326d-3bf0-84e0-59e72f4989eb",
                    "sense_definition": "To make a groove or channel in something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_channel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>grooved</w> the concrete surface to prevent slipping.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>нарезали канавки</w> на бетонной поверхности, чтобы предотвратить скольжение.",
                                "it": "Gli operai hanno <w>scanalato</w> la superficie di cemento per evitare scivolamenti."
                            }
                        },
                        {
                            "text": "Years of flowing water had <w>grooved</w> the canyon floor.",
                            "target_lang_translations": {
                                "ru": "Годы текущей воды <w>избороздили</w> дно каньона.",
                                "it": "Anni di acqua corrente avevano <w>solcato</w> il fondo del canyon."
                            }
                        }
                    ],
                    "synonyms": [
                        "furrow",
                        "channel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать паз, желоб или канавку в чем-либо.",
                        "it": "Creare un solco, un canale o una scanalatura in qualcosa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорезать пазы",
                                "target_lang_sense_clarification": "делать углубления"
                            },
                            {
                                "target_lang_word": "избороздить",
                                "target_lang_sense_clarification": "покрыть бороздами"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "solcare",
                                "target_lang_sense_clarification": "tracciare solchi o segni su una superficie"
                            },
                            {
                                "target_lang_word": "scanalare",
                                "target_lang_sense_clarification": "praticare scanalature in un materiale"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}