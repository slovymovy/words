                        "entry_id": "e4be4fe7-f1b8-341c-853f-be9009b055db",
                        "glosses": [
                            "Dialecte hongrois parlé en Roumanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16cbec1a-904e-45bf-8fd2-710e806174db",
                                "sense_id": "7987e023-cfe8-3efe-9b72-ffec2c119602",
                                "text": "La plupart des catholiques vivaient donc dans la partie orientale de la Transylvanie, dans le pays où se parle le dialecte hongrois dit « sicule »."
                            }
                        ]
                    }
                ],
