                    "sense_definition": "De algemene mening die mensen over iemand of iets hebben; faam of reputatie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het schandaal verloor het bedrijf zijn goede <w>roep</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за скандала компания потеряла свою хорошую <w>репутацию</w>.",
                                "en": "Due to the scandal, the company lost its good <w>reputation</w>.",
                                "fr": "À cause du scandale, l'entreprise a perdu sa bonne <w>réputation</w>."
