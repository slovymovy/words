                "translations": [
                    {
                        "translation_id": "c3bc817c-bd91-4eb7-a7f5-2986d5c1bf4d",
                        "source_entry_id": "3a1a7774-ce35-3a91-8536-21a79c883f3d",
                        "source_sense_id": "c4c379e3-a8e8-30f0-8f72-a5eb0ebe1afb",
                        "target_lang_word": "maquette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Modèle réduit d’un ouvrage d’art, esquisse d’ensemble (d’un panneau décoratif, par exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca8cb99-042e-4f5d-a0f3-b70a1c623af7",
                                                "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                                "text": "Les lourdes bâtisses de Trondjem, à l'allure guindée, semblent placées provisoirement comme des maquettes de monuments à venir. Elles font penser à ces villes artificielles que les favoris de Catherine de Russie semaient sur ses pas."
                                            },
                                            {
                                                "example_id": "822e451a-b464-4fed-8402-cf65936801b6",
                                                "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                                "text": "Je vais fabriquer une maquette de couplets pour y adapter ma mélodie."
                                            },
                                            {
                                                "example_id": "b25f22d0-95d1-4ffb-ba95-56288800c07e",
                                                "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                                "text": "Cette reconstitution de ce que j’ai dû éprouver est pareille à une maquette en carton reproduisant en un modèle réduit ce qu’avaient pu être les bâtiments, les maisons, les temples, les rue, les places et les jardins d’une ville engloutie…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1dc3b4c-d351-3f45-bd32-0d3b01ce0b9a",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Projet permettant de donner l’aperçu le plus juste de ce que sera la réalisation, destiné à permettre le montage des pages (ou des écrans et dialogues, dans le cas d’un logiciel)."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a969dfb-db95-3d18-8eeb-0d8de4dad10c",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Réalisation sous forme de montage expérimental d’un circuit électronique destiné à l’intégration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4358e5e3-d297-3da6-8425-b144b6685a82",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Projet présentant l’agencement des images qui permettront de réaliser une scène d’animation."
                                        ],
                                        "tags": [
                                            "Infographie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d72ef2cb-62a1-30ea-b934-53aaa58d7668",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Morceau de métal en cours d'élaboration dans une forge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f68f70d-a677-44f1-bf23-9f5332299ee1",
                                                "sense_id": "d72ef2cb-62a1-30ea-b934-53aaa58d7668",
                                                "text": "Lorsque le marteleur a aussi aplati l’ extrémité de l’encrénée qu’il ne tient pas, celle-ci devient maquette. Celle-ci est alors parée pour faire disparaître les marques du marteau. La seconde extrémité est alors réchauffée et étirée à son tour pour obtenir une bande ou un bandeau de la taille demandée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c55e6324-5023-3cda-886b-7b91e0760a14",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Mise en page des différents éléments — textes, images — constituant un document écrit — affiche, journal, magazine, livre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "129b9bf4-f611-398c-b955-e15c53b45ec9",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Prototype d’une carte ou d’une série de cartes, présenté graphiquement sous son aspect définitif."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d312ef44-5c8e-3ee7-aed5-d72b0e014d2b",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Représentation en trois dimensions, à très grande échelle, d’un site géographique ou d’un ensemble architectural."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8bdddc3-8194-3dd3-9da1-468333ae3600",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Modèle réduit d'un objet reproduit à l'échelle."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fccecfca-aba8-472f-b2be-3737a27b2f54",
                                                "sense_id": "b8bdddc3-8194-3dd3-9da1-468333ae3600",
                                                "text": "Il nourrit six enfants ; pour ses noces d’étain, sa petite famille lui a offert un cadeau dont il n'est pas peu fier : la maquette, cuivrée, d’une gondole d’or. Initiales sculptées… éclairage indirect… Elle est électronique… et elle joue Santa Lucia !!!"
                                            }
                                        ]
                                    }
                                ]
                            },
