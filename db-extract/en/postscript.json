                    {
                        "translation_id": "223a0802-c8c6-44b6-bebd-c0f5c0f979f6",
                        "source_entry_id": "afb199ed-036e-3aae-9407-e83c41854715",
                        "source_sense_description": "addendum to a letter",
                        "target_lang_word": "post-scriptum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "post-scriptum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                        "entry_id": "f215d183-eb51-3ed3-b2fe-72f734aa8f11",
                                        "glosses": [
                                            "Ce qu’on ajoute à une lettre après la signature et qu’on marque ordinairement par ces deux lettres : P.-S. ou P.S."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d61ef5c-82db-4f82-b243-85b5a95dcf0e",
                                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                                "text": "Guillaume reconnut enfin Claudie, et se rappela qu’on lui avait annoncé son admission au château dans un de ces post-scriptum de lettres intimes où l’on entasse en masse les détails de la vie domestique."
                                            },
                                            {
                                                "example_id": "7e7c1933-879c-48d1-9d2e-0ebe38efd290",
                                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                                "text": "« Dame ! fit-il, jugez-en vous-même, le post-scriptum est précis. [»]"
                                            },
                                            {
                                                "example_id": "c552d316-bdbb-4663-8076-c6586104b1b2",
                                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                                "text": "Je lui ai tendu ensuite un assez long post-scriptum détaché, qui est une liste des errata relevés par lui dans mon livre."
                                            },
                                            {
                                                "example_id": "d458a49e-3510-45a0-9eb1-89301e1f4d04",
                                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                                "text": "J’ajoutai vivement un post-scriptum : « Peut-être vas-tu me trouver ridicule mais je me mépriserais de n’oser l’être jamais. »"
                                            },
                                            {
                                                "example_id": "22a0697d-9608-42bc-965d-ce50849528d0",
                                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                                "text": "Il met des post-scriptum à toutes ses lettres."
                                            },
                                            {
                                                "example_id": "7e8bd45b-dc0e-4da5-9c4f-9b0d3ef9a539",
                                                "sense_id": "fbdff63c-65d8-3d5f-becf-76a696139167",
                                                "text": "les post-scriptum de vos dépêches antérieures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db03200f-d50c-4f4b-921f-6283ea898be2",
                        "source_entry_id": "afb199ed-036e-3aae-9407-e83c41854715",
