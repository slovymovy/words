                                    {
                                        "sense_id": "c2bc56f2-ad22-3e35-aa6c-301a9a6dfea7",
                                        "entry_id": "242bd192-9e75-303b-af46-6c6c530a7ff9",
                                        "glosses": [
                                            "goed maar niet briljant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75773aff-73af-450d-83b1-487f0832113a",
                                                "sense_id": "c2bc56f2-ad22-3e35-aa6c-301a9a6dfea7",
                                                "text": "Hij is een verdienstelijk vioolspeler maar is niet goed genoeg om als solist op te treden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c502729d-4624-4c35-ad88-d2c741d36241",
                        "source_entry_id": "164cc816-37e9-398e-9ae4-d50e2f9b3d93",
                        "source_sense_id": "7f7addc6-555d-3dd0-8abf-db6374f8a0ec",
                        "source_sense_description": "deserving of merit or commendation; deserving reward",
                        "target_lang_word": "méritoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méritoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                        "entry_id": "05b27037-2661-30f9-bef9-5582eb5fc62f",
                                        "glosses": [
                                            "Qui mérite l’approbation, l’estime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad80cc60-73ff-4de8-a437-485d2a25b7d9",
                                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                                "text": "Il se mit ensuite en apprentissage, en renouvelant les mêmes efforts, entêtement d’autant plus méritoire qu’il lui fallait un jour pour apprendre ce que d’autres savaient en une heure."
                                            },
                                            {
                                                "example_id": "0dbdcde8-8019-4320-a045-e4d30729fa16",
                                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                                "text": "Il allait se marier sans arrière-pensée d'aucune sorte et il menait déjà une conduite exemplaire, ce qui était assez méritoire de la part d'un ancien viveur."
                                            },
                                            {
                                                "example_id": "4c0d2572-1049-44dd-a3b7-5b3fb31666e2",
                                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                                "text": "Au total, et grâce à des efforts déjà méritoires, on a crée à Rouen un peu moins de 500 logements."
                                            },
                                            {
                                                "example_id": "64bf4a8e-e53b-4b5e-bccc-06ae315e5c7d",
                                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                                "text": "Mais ce catéchisme est donné comme le résultat des méditations pénibles et consciencieuses et méritoires des hommes de bien qui fabriquent la Philosophie."
                                            },
                                            {
                                                "example_id": "74707b9a-bf69-4d13-be12-e3b3f9d97384",
                                                "sense_id": "d9fc5522-9963-34be-9508-3e10ed067757",
                                                "text": "On ne s'improvise pas usurier, il faut parvenir d'abord à une méritoire insertion dans la mafia des gens bien placés pour exploiter leur prochain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbb79b7-e5c9-32ee-9e0d-cf666f99b13c",
                                        "entry_id": "05b27037-2661-30f9-bef9-5582eb5fc62f",
                                        "glosses": [
                                            "Qui rend Dieu miséricordieux pour le croyant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9c8b07-cd09-4bfa-ba0e-0b764475a126",
                                                "sense_id": "dfbb79b7-e5c9-32ee-9e0d-cf666f99b13c",
                                                "text": "Dans ses discours, il défendit avec force cette thèse que la stricte observance des lois religieuses doit s'accompagner, pour devenir méritoire, de la pratique de la justice et de l'amour du prochain, envers les juifs comme envers les non-juifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f0262aa-05cf-4205-a67f-f30805479803",
                        "source_entry_id": "164cc816-37e9-398e-9ae4-d50e2f9b3d93",
                        "source_sense_id": "7f7addc6-555d-3dd0-8abf-db6374f8a0ec",
                        "source_sense_description": "deserving of merit or commendation; deserving reward",
                        "target_lang_word": "louable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "louable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                        "entry_id": "1894c6aa-2bd8-3c8e-8ab0-35bbd0aaf042",
                                        "glosses": [
                                            "Qui est digne de louange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e96a4f-5abc-4703-9950-d999a93cea44",
                                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                                "text": "Le Danemark, avec le souci le plus louable de la santé physique et morale de ses sujets, interdit absolument l'importation de l'alcool au Groenland."
                                            },
                                            {
                                                "example_id": "e7469c55-3521-4f68-a0c8-10a948b8de71",
                                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                                "text": "Le département fait de louables efforts pour créer un dispensaire antituberculeux. Il organise l'inspection des écoles."
                                            },
                                            {
                                                "example_id": "395400e4-6881-474b-b1e4-cfaeb4285e6d",
                                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                                "text": "Il est évident que ces réformes sont fort louables, mais elles sont loin d’être acceptées avec enthousiasme: […] ; et les lettrés les considèrent comme un attentat sacrilège contre les traditions koraniques."
                                            },
                                            {
                                                "example_id": "d4e9fb39-ca34-4257-9d0c-92e9c5bb4a5d",
                                                "sense_id": "5fecb579-b9ed-30c0-9747-db36c177afd5",
                                                "text": "\"Les contraintes sont décuplées par les mesures strictes prises par les provinces de l’Atlantique qui ont été imposées avec une intention de protéger leur population, ce qui est certainement louable, mais qui n’avaient pas à aller aussi loin pour obtenir les mêmes résultats\", estime Joël Arseneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d6184b1-5b7c-3cc2-b1c5-a23da12a6ea5",
                                        "entry_id": "1894c6aa-2bd8-3c8e-8ab0-35bbd0aaf042",
                                        "glosses": [
                                            "Qui peut être loué, moyennant loyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644ef0a8-7876-457c-ab46-047bdafcb84b",
                                                "sense_id": "6d6184b1-5b7c-3cc2-b1c5-a23da12a6ea5",
                                                "text": "[…], mais si tu voulais louer ou revendre ton bien après rapetassage, alors j'avais tout au contraire à multiplier ses espaces en les cloisonnant dans tous les sens je réformais un bon gros et bien vieil appartement pour obtenir les deux ou trois petits immédiatement louables ou vendables, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0785f59c-3515-4c43-b5dc-46c101c96631",
                        "source_entry_id": "164cc816-37e9-398e-9ae4-d50e2f9b3d93",
                        "source_sense_id": "7f7addc6-555d-3dd0-8abf-db6374f8a0ec",
                        "source_sense_description": "deserving of merit or commendation; deserving reward",
                        "target_lang_word": "verdienstvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdienstvoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                        "entry_id": "7078b325-59ce-3f14-b60d-e87478e1caa9",
                                        "glosses": [
                                            "so, dass jemand/etwas besondere Anerkennung verdient (beispielsweise wegen eines herausragenden Werkes, bemerkenswerter Leistungen, langjähriger Treue)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad15f5b1-aef8-431a-bd0c-9864b2e0fcc6",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„[…] der langgediente und verdienstvolle [indische] Premier Manmohan Singh hatte keine neuen Ideen mehr.“"
                                            },
                                            {
                                                "example_id": "1a67f174-54d9-4467-bed4-58432e2336c3",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„Der Sprecher des Lesben- und Schwulenverbandes (LSVD) erklärte zur Kündigung: »Wir sind entsetzt über die unbarmherzige Haltung der Leitung des Kolpingwerkes, die einen verdienstvollen Mitarbeiter kündigt, nur weil dieser schwul ist.«“"
                                            },
                                            {
                                                "example_id": "0501b6c7-4453-4d7c-bb24-fd9d35a97e07",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„Das Paläontologische Museum Nierstein ist das Lebenswerk des verdienstvollen Hobbypaläontologen Arnulf Stapf aus Nierstein am Rhein […]“"
                                            },
                                            {
                                                "example_id": "3405dcaa-0bde-4838-b25a-410f08291a56",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„[Peter] Altmaier dankt [dem Präsidenten des BND Gerhard] Schindler für seine »langjährige, verdienstvolle Arbeit« […]“"
                                            },
                                            {
                                                "example_id": "42fbeb7e-c7dc-4abf-98bb-588d5749a004",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„[Der Professor für Sexualforschung Arne Dekker] beurteilt [die Studie] als »kleine, verdienstvolle Ergänzung, die erstmals repräsentative Angaben zum Sexualleben der Gesamtbevölkerung macht«.“"
                                            },
                                            {
                                                "example_id": "5cb23382-1a8b-436b-bafe-0ea1ae82744f",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "Reinhards Arbeit bei Wikipedia ist sehr verdienstvoll!"
                                            },
                                            {
                                                "example_id": "a076c98b-f0fc-4c28-9431-20b9d5861401",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„[…] viele Hindus [glauben], ein vegetarisches und abstinentes Leben sei verdienstvoll […]“"
                                            },
                                            {
                                                "example_id": "f2761878-489d-47de-9788-51828b5082e3",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„Eine Pilgerfahrt zu Baha'u'llahs Grab, das auch die Gebetsrichtung, \"Oiblih\" anzeigt, gilt als sehr verdienstvoll, ist aber nicht vorgeschrieben.“"
                                            },
                                            {
                                                "example_id": "249f3a3f-c03c-41f4-94bd-7e9da530c14b",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„Felix Bohrs enorm materialreiche Studie ist verdienstvoll – ein Antidot zu gängigen, mitunter allzu selbstgewissen Geschichtserzählungen.“"
                                            },
                                            {
                                                "example_id": "136bd449-7ce3-44fa-8b9d-45c14cb26b53",
                                                "sense_id": "a1505742-188f-3b94-b9af-473f3ad7fc11",
                                                "text": "„Die Erkenntnisse der Deutschen Gesellschaft für Mann und Gesundheit sind umso verdienstvoller, als die bisherigen Forschungen über den Zusammenhang von Hormonspiegel und sportlicher Leistung vergleichsweise dünn ausfallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
