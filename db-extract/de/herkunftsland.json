                ],
                "senses": [
                    {
                        "sense_id": "80d5dada-fc1b-32fd-9177-ced3be54e558",
                        "entry_id": "6c80f38d-564b-3075-9fbe-b332b98de3fa",
                        "glosses": [
                            "Land, aus dem jemand oder etwas stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23deb5ea-641c-441d-adfe-f1338e0c2308",
                                "sense_id": "80d5dada-fc1b-32fd-9177-ced3be54e558",
                                "text": "„Äthiopien ist das Herkunftsland des Kaffees — jede einzelne Kaffeepflanze kann heute noch auf ihren Ursprung in den Bergen Südwestäthiopiens zurückgeführt werden.“"
                            },
                            {
                                "example_id": "cc4d8a1e-b61d-4bfb-98b6-c337db3f95d2",
                                "sense_id": "80d5dada-fc1b-32fd-9177-ced3be54e558",
                                "text": "In der Asyldebatte warnen die Grünen vor Plänen der Union und Teilen der SPD, auch die Balkanländer Albanien, Montenegro und Kosovo zu «sicheren Herkunftsländern» zu erklären."
                            },
                            {
                                "example_id": "b33f49bc-a8a2-4310-a87a-271b62f991b2",
                                "sense_id": "80d5dada-fc1b-32fd-9177-ced3be54e558",
                                "text": "„Die meisten Forscher nehmen an, dass sich die jüdischen Einwanderer in ihren Herkunftsländern wohl in einer ähnlichen Situation der inneren und äußeren Mehrsprachigkeit befunden und die Sprachen dieser Länder in einer jüdischen Varietät gesprochen hatten.“"
                            },
                            {
                                "example_id": "55288f39-0538-4a99-a93b-f609acb5a0be",
                                "sense_id": "80d5dada-fc1b-32fd-9177-ced3be54e558",
                                "text": "„Das Thema des Doppelgängers betrifft nicht nur den Privatmann, sondern erstreckt sich auch auf die soziale Ebene: denn fast alle Gestalten Hoffmanns verfügen über einen Personenstand, einen Beruf, ein Herkunftsland, mögen sie auch Funktionen als Salamander, Vampir, Zauberer undsoweiter gleichzeitig üben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e2dd023-a2a0-460a-96f2-eaf151384a53",
                        "source_entry_id": "6c80f38d-564b-3075-9fbe-b332b98de3fa",
                        "source_sense_id": "80d5dada-fc1b-32fd-9177-ced3be54e558",
                        "source_sense_description": "Land, aus dem jemand oder etwas stammt",
                        "target_lang_word": "country of origin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "country of origin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8be4bd-0d6e-35a4-b036-dc490d18a8d0",
                                        "entry_id": "09ab63ba-ae7a-3eef-9323-c8c282dfe245",
                                        "glosses": [
                                            "The country in which a person or thing is deemed to have originated for the purposes of laws and regulations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be3fc9f7-0ea1-3bd6-8ad6-14af9b4e9533",
                                        "entry_id": "09ab63ba-ae7a-3eef-9323-c8c282dfe245",
                                        "glosses": [
                                            "The country where shipped goods are produced."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96bbb1db-726c-3207-90af-48c83b3ad19b",
                                        "entry_id": "09ab63ba-ae7a-3eef-9323-c8c282dfe245",
                                        "glosses": [
                                            "The country in which the last stage of substantial transformation of goods occurred."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f3687e3-0cbf-3450-bb19-2000716d05a3",
                                        "entry_id": "09ab63ba-ae7a-3eef-9323-c8c282dfe245",
                                        "glosses": [
                                            "The country in which the most important processing took place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "842436f8-d474-3987-976d-5ca9a42f77ea",
                                        "entry_id": "09ab63ba-ae7a-3eef-9323-c8c282dfe245",
                                        "glosses": [
                                            "The country in which a substantial amount of processing took place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131371cd-0348-45ae-b252-c286ac681650",
                                                "sense_id": "842436f8-d474-3987-976d-5ca9a42f77ea",
                                                "text": "The country of origin of a manufactured article is held to be the country in which the article has been finished by a substantial amount of labor amounting to not less than one-fourth the cost of production of such article in condition as imported into Canada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b7ff71-3515-3501-84de-5314c0944f36",
                                        "entry_id": "09ab63ba-ae7a-3eef-9323-c8c282dfe245",
                                        "glosses": [
                                            "The country indicated on a label as being the country in which the goods were made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f385bd-4162-44ad-baa6-4d9c8c5a505a",
                                                "sense_id": "a2b7ff71-3515-3501-84de-5314c0944f36",
                                                "text": "It says \"Made in Mexico\". I wonder if that is the real country of origin."
                                            },
                                            {
                                                "example_id": "fec86449-1d6d-4e91-8f71-28c8a2791429",
                                                "sense_id": "a2b7ff71-3515-3501-84de-5314c0944f36",
                                                "text": "Reviewing your Hispanic business plan and marketing strategy through the lens of country of origin can help you uncover unique benefits or barriers."
                                            },
                                            {
                                                "example_id": "555d8f54-a58b-4fc4-a05f-55bd186eefdb",
                                                "sense_id": "a2b7ff71-3515-3501-84de-5314c0944f36",
                                                "text": "Country-specific brand images and country of origin effects are key topics in this area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf95f95-4beb-3ab2-aff6-2eeb042ce6eb",
                                        "entry_id": "09ab63ba-ae7a-3eef-9323-c8c282dfe245",
                                        "glosses": [
                                            "Country of first publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8516ce7f-4844-485b-b0ac-4afd14284d2a",
                                                "sense_id": "ebf95f95-4beb-3ab2-aff6-2eeb042ce6eb",
                                                "text": "The country of origin of the work is that in which the work is first published."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
