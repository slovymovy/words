                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détacheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3092be5-d73c-3bb4-a74a-8c26939aa943",
                                        "entry_id": "f4b46693-6801-3354-93c7-ead680112481",
                                        "glosses": [
                                            "Celui qui ôte les taches des habits ; dégraisseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc74bac-07d8-4604-b6a9-0b1fff1f424a",
                                                "sense_id": "f3092be5-d73c-3bb4-a74a-8c26939aa943",
                                                "text": "Il faut que le détacheur démêle la nature du corps qui a fait la tâche ^([sic : tache]), celle de l’étoffe qui l’a reçue, le changement qui a du en résulter dans son principe colorant."
                                            },
                                            {
                                                "example_id": "dffcd77c-01c1-44ec-9bb6-dcf7c2afab01",
                                                "sense_id": "f3092be5-d73c-3bb4-a74a-8c26939aa943",
                                                "text": "Elle est détacheuse en même temps qu’apprêteuse, et l’art de bien enlever les taches est un art compliqué ; toutes les taches ne sont pas de même nature ni ne s’enlèvent avec les mêmes substances…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c976f1-3e7b-3518-8e2a-f7c9026f6332",
                                        "entry_id": "f4b46693-6801-3354-93c7-ead680112481",
                                        "glosses": [
                                            "Machine à détacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb048879-4292-4b0f-a928-663f1337609d",
                                                "sense_id": "c4c976f1-3e7b-3518-8e2a-f7c9026f6332",
                                                "text": "détacheur d’antivol de vêtement"
                                            },
                                            {
                                                "example_id": "d34ac12a-6593-4a1e-87f5-57b8ca39436c",
                                                "sense_id": "c4c976f1-3e7b-3518-8e2a-f7c9026f6332",
                                                "text": "On distingue trois familles de détacheurs, ceux à friction, ceux à fouettement et ceux à turbine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae40c807-4ed3-3796-917c-8ab5eff5e756",
                                        "entry_id": "f4b46693-6801-3354-93c7-ead680112481",
                                        "glosses": [
                                            "Produit servant à enlever les tâches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c2830e-c50d-4dcd-9f1c-8715f6afae78",
                                                "sense_id": "ae40c807-4ed3-3796-917c-8ab5eff5e756",
                                                "text": "Un camelot faisait de la propagande pour un détacheur universel. , 2014"
                                            },
                                            {
                                                "example_id": "0a5975a1-8910-4abc-9e37-ace8dbc39809",
                                                "sense_id": "ae40c807-4ed3-3796-917c-8ab5eff5e756",
                                                "text": "On peut tout de même les nettoyer avec un détacheur spécial pour cuirs et peaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
