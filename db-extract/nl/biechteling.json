                        "sense_id": "b3dc6c6b-9c1a-362e-a2b6-becd40040f55",
                        "entry_id": "61569311-5123-349e-bd3f-dbbc0bb20f35",
                        "glosses": [
                            "iemand die zijn zonden belijdt bij een priester in de rooms-katholieke kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363f5720-0d0b-4564-80e4-60a4d7ec399f",
                                "sense_id": "b3dc6c6b-9c1a-362e-a2b6-becd40040f55",
                                "text": "Voor Kerstmis en Pasen is het een stuk drukker, maar op een gemiddelde dag druppelen er vijf à zes biechtelingen binnen. Schril contrast met de lange wachtrijen van weleer is dat wel."
                            },
                            {
                                "example_id": "ccf749fd-0d34-4e0a-b54b-167dcde17dab",
                                "sense_id": "b3dc6c6b-9c1a-362e-a2b6-becd40040f55",
                                "text": "Rooms-katholieken kunnen niet met een iPhone biechten. De priester en de biechteling moeten elkaar zien. Dat heeft de woordvoerder van het Vaticaan woensdag gezegd in reactie op de goedkeuring van een applicatie van de iPhone door de Amerikaanse bisschoppen. Je kunt op geen enkele manier spreken van biechten via een iPhone, zei hij."
                            }
                        ]
                    }
