                "senses": [
                    {
                        "sense_id": "ebd2c7fe-50a4-3529-a832-527c812d4bc7",
                        "entry_id": "2b288f07-848e-31cc-b98a-1ceccd1156e9",
                        "glosses": [
                            "gevangene die gedwongen wordt arbeid te verrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e7dfd84-1533-4e36-a130-2c2bfb3df5ad",
                                "sense_id": "ebd2c7fe-50a4-3529-a832-527c812d4bc7",
                                "text": "Onder leiding van de Slowaakse rooms-katholieke priester en politicus Tiso werden in 1942 58.000 Slowaakse joodse mannen weggevoerd naar Duitse dwangarbeiderskampen, de nazi’s betaalden Slowakije 500 Reichsmark per afgevoerde Joodse dwangarbeider en lieten de achtergebleven familieleden in jodenwijken wonen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1878e17c-5e91-4a7f-98a9-af2e14d9fe49",
                        "source_entry_id": "2b288f07-848e-31cc-b98a-1ceccd1156e9",
                        "source_sense_id": "ebd2c7fe-50a4-3529-a832-527c812d4bc7",
                        "target_lang_word": "Zwangsarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwangsarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fba564b7-aa6b-3ccd-b2c1-9be22638db2a",
                                        "entry_id": "5a21e69c-7da3-330e-8e1b-74f9ed51dab7",
                                        "glosses": [
                                            "Person, die zur Zwangsarbeit gezwungen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0fd9b89-eaad-4f80-a66f-fcd36348bb09",
                                                "sense_id": "fba564b7-aa6b-3ccd-b2c1-9be22638db2a",
                                                "text": "„Ich hatte einen polnischen Großvater, der auf den Namen Tarkowski hörte und während des Zweiten Weltkrieges Zwangsarbeiter in Deutschland war; ich habe einen deutschen Großvater, der Botta hieß und zur selben Zeit für die Wehrmacht an der Ostfront kämpfte.“"
                                            },
                                            {
                                                "example_id": "a7f3b638-ff29-4510-bb8b-24d41438c9e9",
                                                "sense_id": "fba564b7-aa6b-3ccd-b2c1-9be22638db2a",
                                                "text": "„Gleichzeitig, oft genug vor den Ostpolen und den Zwangsarbeitern, kamen in Schlesien und anderswo die Polen aus den zentralen Landesteilen an.“"
                                            },
                                            {
                                                "example_id": "6cd7eb9c-a8cc-4f06-96fa-7f6dd905c320",
                                                "sense_id": "fba564b7-aa6b-3ccd-b2c1-9be22638db2a",
                                                "text": "„Ganze Dorfgemeinschaften fliehen zu ihr in den Osten des Landes – sehr zum Ärger der Portugiesen, die von ihr verlangen, die Zwangsarbeiter nach Luanda zurückzuschicken.“"
                                            },
                                            {
                                                "example_id": "f4f06af9-315b-4754-8a56-0d18df2d77dd",
                                                "sense_id": "fba564b7-aa6b-3ccd-b2c1-9be22638db2a",
                                                "text": "„Um die Stadt Barth herum gab es außerdem zahlreiche kriegswichtige Betriebe, in denen Tausende von Zwangsarbeitern Sklavenarbeit verrichten mussten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
