                "senses": [
                    {
                        "sense_id": "8a735c9d-bf92-31cf-8fe0-2d0a5b1c1d4e",
                        "entry_id": "ca3f1182-2e4c-38f1-9545-9eefe58147af",
                        "glosses": [
                            "Limer quelque chose."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "70b9ff76-9acf-3ce7-800e-33a7f9db7a8c",
                        "entry_id": "ca3f1182-2e4c-38f1-9545-9eefe58147af",
                        "glosses": [
                            "Embêter quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88bb00bc-3f6f-4d5f-a95f-a7b4bfc72ef6",
                                "sense_id": "70b9ff76-9acf-3ce7-800e-33a7f9db7a8c",
                                "text": "Camille n'arrête de pas de me chafouiner ! il faut que cela s'arrête !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b31b6795-e5f6-390e-b2cd-24985f0bf2c3",
                        "entry_id": "ca3f1182-2e4c-38f1-9545-9eefe58147af",
                        "glosses": [
                            "Fouiller, farfouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be90a7f0-77ac-4c0d-a913-f4cf53b6000f",
                                "sense_id": "b31b6795-e5f6-390e-b2cd-24985f0bf2c3",
                                "text": "La maladie grise chercha quelque chose à se mettre sous l’incisive pour demeurer dans l’enveloppe de la mano. Elle chafouina dans tous les recoins du corps de siffleuse de la mano, alla jusqu’aux doigts pour y trouver — faute de mieux - quelque chose à infecter-gangréner."
                            }
                        ]
                    },
                    {
                        "sense_id": "43dc9a92-d8d0-3f5f-a7fc-1dd7386cef0b",
                        "entry_id": "ca3f1182-2e4c-38f1-9545-9eefe58147af",
                        "glosses": [
                            "Faire la cour à une personne dans le but d’obtenir ses faveurs amoureuses."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bca78e1c-d30e-38b7-80f3-5909a0d32bde",
                        "entry_id": "ca3f1182-2e4c-38f1-9545-9eefe58147af",
                        "glosses": [
                            "Avoir une relation sexuelle consentie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "29c4dabb-7088-391f-b3b3-da82598b9aae",
                        "entry_id": "ca3f1182-2e4c-38f1-9545-9eefe58147af",
                        "glosses": [
                            "Se friper, se plisser."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "d06b7b2e-4bfc-49f3-819d-f7bc0d47ac3b",
                                "sense_id": "29c4dabb-7088-391f-b3b3-da82598b9aae",
                                "text": "L’heure n’était pas encore venue où elle allait irrémédiablement se défraîchir, se chafouiner sous ses mantilles."
                            }
                        ]
                    }
                ],
