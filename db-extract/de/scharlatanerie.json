                "senses": [
                    {
                        "sense_id": "9445c820-8df3-33c8-9e57-db46a7c0b1a3",
                        "entry_id": "980ad583-96fa-3f22-a233-42fe5226c0ae",
                        "glosses": [
                            "Charlatanerie."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "02f52e6d-a233-4d33-a95c-ebe11ccd512d",
                                "sense_id": "9445c820-8df3-33c8-9e57-db46a7c0b1a3",
                                "text": "Viele betrachten ihn als einen Wunderheiler, aber ich sehe in seinen “Kuren” nur Scharlatanerie.",
                                "translation": "Beaucoup le considèrent comme un guérisseur miracle, mais je ne vois dans ses « cures » que de la charlatanerie."
                            },
                            {
                                "example_id": "cde53959-6b56-4ada-8665-2939bb0011f5",
                                "sense_id": "9445c820-8df3-33c8-9e57-db46a7c0b1a3",
                                "text": "Demnach widme sich Esowatch dem Kampf gegen Aberglauben, Scharlatanerie und Pseudowissenschaft, und die Einträge im Lexikon seien umfangreich mit Quellen versehen und stellten eine „Fundgrube für naturwissenschaftlich haltbare Argumente“ dar.",
                                "translation": "Selon ce compte rendu, Esowatch se consacre à la lutte contre la superstition, la charlatanerie et la pseudoscience, et les entrées dans son lexique sont largement sourcées et constituent un « trésor d’arguments scientifiques solides »."
                            }
                        ]
                    }
                ],
