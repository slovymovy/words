                        "entry_id": "3fc0f421-c9f1-394f-af55-6f11067fc57f",
                        "glosses": [
                            "ein Gewölbe, das auch an den beiden Schmalseiten gewölbt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47bf78c8-51c2-4abb-89ce-844e4b3d6f2f",
                                "sense_id": "37be7bd4-1b5c-3701-ba5d-d68e23a94c4b",
                                "text": "„Das Gewölbe, dessen Inhalt in eben diesem Aufsatze berechnet wird, ist kein Kreuzgewölbe, sondern ein Kloster- oder Walmgewölbe.“"
                            },
                            {
                                "example_id": "586ddcd2-4d07-4a1c-9547-ebf92ee8cbd7",
                                "sense_id": "37be7bd4-1b5c-3701-ba5d-d68e23a94c4b",
                                "text": "„Die Klostergewölbe, auch Haubengewölbe, Walmgewölbe, sind im Grundrisse 4, 6 oder 8 eckig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
