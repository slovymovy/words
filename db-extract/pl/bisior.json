                        "glosses": [
                            "cienka tkanina wyrabiania z bisioru (1.1)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e5e65f3c-ba38-3d9e-9584-051a2a1bd8f2",
                        "entry_id": "502f90e5-4379-332b-9672-3258e98e5eb5",
                        "glosses": [
                            "delikatna i kosztowna tkanina (bawełniana, lniana lub wełniana)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8ce813f1-6711-4e17-b560-e75d17112b81",
                                "sense_id": "e5e65f3c-ba38-3d9e-9584-051a2a1bd8f2",
                                "text": "Niektóre zaś komnaty całe od złota; krzesła i ławy bisiorem albo lamą kryte, stoły z marmuru i alabastru […]"
                            },
                            {
                                "example_id": "ad567589-f0a2-4a8d-8369-428383763020",
                                "sense_id": "e5e65f3c-ba38-3d9e-9584-051a2a1bd8f2",
                                "text": "Sam pan Sobieski stanął w kapiącym od złota i bisiorów namiocie Husseina-baszy i z niego wieści o szczęśliwym zwycięstwie na wszystkie strony przez lotnych gońców rozsyłał"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
