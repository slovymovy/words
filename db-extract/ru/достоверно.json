        "ru-extract.jsonl": [
            {
                "entry_id": "45bf5ed5-ec1b-3d8e-81bf-ff670e62d2c9",
                "word": "достоверно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "decc7df2-1f26-3082-928b-f47ec95876bd",
                        "entry_id": "45bf5ed5-ec1b-3d8e-81bf-ff670e62d2c9",
                        "glosses": [
                            "наречие к достоверный; не вызывая сомнения, вполне верно, точно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "76e5efa1-9595-40c0-adc3-cd2a0034f616",
                                "sense_id": "decc7df2-1f26-3082-928b-f47ec95876bd",
                                "text": "― Мы именно для этого и выписали вас, ― перебила Марианна, ― чтоб узнать достоверно, в каком положении находятся дела."
                            },
                            {
                                "example_id": "a7f5e355-59a7-4e41-bf63-931a7f7e9812",
                                "sense_id": "decc7df2-1f26-3082-928b-f47ec95876bd",
                                "text": "Иван Фёдорович клялся, что всё это одна только «выходка» и произошла от Аглаиной «стыдливости»; что если б князь Щ. не заговорил о свадьбе, то не было бы и выходки, потому что Аглая и сама знает, знает достоверно, что всё это одна клевета недобрых людей, и что Настасья Филипповна выходит за Рогожина; что князь тут не состоит ни при чём, не только в связях; и даже никогда и не состоял, если уж говорить всю правду-истину."
                            }
                        ]
                    },
                    {
                        "sense_id": "17a084f8-0e8d-31b9-87da-b7ab2e77c3c5",
                        "entry_id": "45bf5ed5-ec1b-3d8e-81bf-ff670e62d2c9",
                        "glosses": [
                            "предик. оценочная характеристика чего-либо (высказывания, рассуждения и т. п.) как подлинного, соответствующего действительности, не вызывающего сомнения"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae2737b-f4d6-4d8b-8bb9-980eef8646c6",
                        "source_entry_id": "45bf5ed5-ec1b-3d8e-81bf-ff670e62d2c9",
                        "source_sense_description": "наречие",
                        "target_lang_word": "authentically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authentically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2a0db8-643f-3037-93c4-abffc6889419",
