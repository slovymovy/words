                                        "sense_id": "f1ed8856-5764-382a-b96d-f6afbe4e471d",
                                        "entry_id": "58334498-86cf-32b9-9e1e-6b8d610de513",
                                        "glosses": [
                                            "Proceso de formación de fibrilas."
