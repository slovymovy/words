                        "examples": [
                            {
                                "example_id": "c3ebd336-c5cc-44bc-9a9a-ebcd990ac4fe",
                                "sense_id": "fa84d2a4-c3f6-3905-969b-be2b39bc4384",
                                "text": "Stronge suggests a daily routine for post-work citizens that would include a provocative degree of state involvement: “You get your UBI payment from the government. Then you get a form from your local council telling you about things going on in your area: a five-a-side football tournament, say, or community activism – Big Society stuff, almost.”"
                            },
                            {
                                "example_id": "2d66a975-4af9-4c37-9368-1b83375c31c1",
                                "sense_id": "fa84d2a4-c3f6-3905-969b-be2b39bc4384",
                                "text": "Right-wing supporters of UBI, such as the Adam Smith Institute, will try to use it as a justification for further dismantling of the welfare state and for individualising society’s problems."
                            }
                        ]
                    }
