                "senses": [
                    {
                        "sense_id": "f418b7c9-8bd3-362a-9bdc-b525d3014218",
                        "entry_id": "746742d6-8f74-3be3-85ef-342366c92333",
                        "glosses": [
                            "A place where ships are repaired or outfitted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8026bb-6abb-4ad2-a38b-bacd4defd979",
                                "sense_id": "f418b7c9-8bd3-362a-9bdc-b525d3014218",
                                "text": "Until recently activities in the Haven [Milford Haven] were confined virtually to the naval dockyard, now closed, and to coastal shipping and shipments to and from Ireland, both on a small scale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97ec92bb-6427-4990-aef1-6df8a0c8429d",
                        "source_entry_id": "746742d6-8f74-3be3-85ef-342366c92333",
                        "source_sense_id": "f418b7c9-8bd3-362a-9bdc-b525d3014218",
                        "source_sense_description": "ship repair place",
                        "target_lang_word": "chantier naval",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chantier naval",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ebe5d8-616e-36dc-955f-b177c8090372",
                                        "entry_id": "c55cf176-3e8c-363d-a549-41af5288cf0e",
                                        "glosses": [
                                            "Lieu de construction des bateaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7054f699-4289-4b18-b69b-2fe2fcafe764",
                                                "sense_id": "a3ebe5d8-616e-36dc-955f-b177c8090372",
                                                "text": "Eh bien, d'après Drake, dit-il, Nelson avait commencé par entrer aux chantiers navals comme traceur, travaillant sur des épures et des projets de construction, et apprenant comme un fou tout ce qu'il pouvait des techniciens russes qui étaient arrivés en foule depuis la victoire de Mao."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d174dfa-cf65-491c-b2a1-6cf03ad462c8",
                        "source_entry_id": "746742d6-8f74-3be3-85ef-342366c92333",
                        "source_sense_id": "f418b7c9-8bd3-362a-9bdc-b525d3014218",
                        "source_sense_description": "ship repair place",
                        "target_lang_word": "Werft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                        "entry_id": "f6940768-c6c1-320d-b390-0342317dd31c",
                                        "glosses": [
                                            "Industrieanlage zum Bauen und Reparieren von Schiffen oder Flugzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517ac32e-7952-47af-a9dd-34e7612e4d6a",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„In aller Frühe ließ er uns heraustrommeln, lief mit uns im Laufschritt zum Dampfer, und wir fuhren zur Werft, um dort die einzelnen Gegenstände für unsere Ausrüstung zu requirieren.“"
                                            },
                                            {
                                                "example_id": "ebe9ac3a-5bcd-4dd8-ab08-07ffde27d1d7",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„Am Ende der städtischen Werften begannen die Becken, wo die Schiffe ausgestattet oder gebaut wurden.“"
                                            },
                                            {
                                                "example_id": "9aac5e0a-1615-4041-9109-a1fdc9c4db48",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„In den Küstenstädten Wismar, Rostock und Stralsund sind moderne und leistungsfähige Werften entstanden.“"
                                            },
                                            {
                                                "example_id": "9a10482d-cae7-4d10-9af1-13a03da8ff9a",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„Die Werft in Turku ist eine der größten Europas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
