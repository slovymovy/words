                "entry_id": "24c97b01-27d1-37f9-bdd2-4deb202bf5ee",
                "word": "hoarder",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "670d20c8-be2a-4ea3-8a45-6f7ef5830e8c",
                        "entry_id": "24c97b01-27d1-37f9-bdd2-4deb202bf5ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "hoarders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                        "entry_id": "24c97b01-27d1-37f9-bdd2-4deb202bf5ee",
                        "glosses": [
                            "One who hoards; one who accumulates, collects, and stores, especially one who does so to excess."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c6867a1-444c-4500-9e85-0bc5dbccba53",
                                "sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                                "text": "A bill to demonetize existing French gold coinage has been introduced in the Chamber of Deputies by Deputies Lenoir, Bouffandeau, and Eymond. The purpose is to force hoarders to bring out gold estimated at 4,000,000,000 francs which is still kept in hiding in spite of patriotic appeals to the owners to exchange it for notes."
                            },
                            {
                                "example_id": "fb9c59fa-869c-45b6-a487-3cf94b0cebfa",
                                "sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                                "text": "Like many lonely people, he was an inveterate hoarder, making and surrounding himself with objects, barriers against the demands of human intimacy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc8693fc-d151-4214-aeac-8d0b88e60396",
                        "source_entry_id": "24c97b01-27d1-37f9-bdd2-4deb202bf5ee",
                        "source_sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                        "source_sense_description": "one who hoards",
                        "target_lang_word": "verzamelaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzamelaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c879ae2b-114b-3474-b675-d275048494b7",
                                        "entry_id": "14472f5e-8f6c-3402-812f-b569fbd48863",
                                        "glosses": [
                                            "is een persoon die, bij wijze van hobby of tijdverdrijf, een collectie van een bepaald type voorwerpen aanlegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb4de8a-8f4a-4662-ba6b-9b04f55cd9e1",
                                                "sense_id": "c879ae2b-114b-3474-b675-d275048494b7",
                                                "text": "In spaarstation Dingenliefde werden bijzondere verzamelingen van bijzondere verzamelaars gepresenteerd."
                                            },
                                            {
                                                "example_id": "a2cc1b0e-1638-4633-b2da-fae8092d5f28",
                                                "sense_id": "c879ae2b-114b-3474-b675-d275048494b7",
                                                "text": "Vorige week was er op Catawiki een online-veiling met handschriften en eerste drukken van de verzamelaar, reiziger, schrijver en programmamaker Büch. Onder de parafernalia ook twee ingelijste fineliner-tekeningetjes van Drost: inderdaad fijn en vrolijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc18856e-7bf2-4fb7-bac2-cf4ba25d15fd",
                        "source_entry_id": "24c97b01-27d1-37f9-bdd2-4deb202bf5ee",
                        "source_sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                        "source_sense_description": "one who hoards",
                        "target_lang_word": "collectionneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collectionneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89f0ff8c-01c3-3f8e-86c9-c2ec6d8c04af",
                                        "entry_id": "17672a0f-4f7b-3a41-a9ed-5ce137b164c5",
                                        "glosses": [
                                            "Qui aime collectionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcd966d-37c0-4975-9525-7be92e5ff66f",
                                                "sense_id": "89f0ff8c-01c3-3f8e-86c9-c2ec6d8c04af",
                                                "text": "Fatigué des femmes — non de la sienne — Renaud a quitté cette fièvre collectionneuse, cette anxiété de philatéliste qui le jetait au-devant d’une femme nouvelle : « Ah ! un exemplaire qui me manquait !… »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "collectionneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                        "entry_id": "c8217f0b-f0f6-36d2-80e4-b7272fa88ff4",
                                        "glosses": [
                                            "Personne qui collectionne quelque chose ; celui qui fait des collections."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729adadf-5791-43bd-ac00-8cd9a67e5db1",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "Les journaux et les magazines qui alimentaient les cerveaux américains (car les livres, sur ce continent impatient, n’intéressaient plus que les collectionneurs) devinrent instantanément un feu d’artifice."
                                            },
                                            {
                                                "example_id": "5bfad12e-fbc3-450c-90df-c894bd84363e",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "J’aime la nature telle que les dieux l’on faite, et j’aime tant à la voir que je ne trouve pas le temps de la regarder par les yeux des autres, comme font les collectionneurs de tableaux."
                                            },
                                            {
                                                "example_id": "562140df-c2e0-490a-8d28-a0c22a7c52f1",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "— Il publia, en 1706, un recueil, Cent Vues de Venise, aux planches incisées avec une maestria qui lui fait le plus grand honneur et lui assure, aujourd'hui encore, l'admiration des iconophiles collectionneurs."
                                            },
                                            {
                                                "example_id": "80df6bb0-8fba-4a74-8518-61b8aa6354e3",
                                                "sense_id": "c0bfc8ad-89f3-371a-aa82-c61a6da24f51",
                                                "text": "Un cartophile est un collectionneur de cartes postales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c865de83-58dd-47de-973b-8ef0a46a7915",
                        "source_entry_id": "24c97b01-27d1-37f9-bdd2-4deb202bf5ee",
                        "source_sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
