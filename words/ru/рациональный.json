                    "sense_id": "03f58aa2-2d1b-37a0-8d78-86fd8f29090d",
                    "sense_definition": "Организованный наиболее разумным способом, практичный и целесообразный.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "целесообразность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы стараемся найти наиболее <w>рациональное</w> использование времени на каждом уроке."
                        },
                        {
                            "text": "Грамотное и <w>рациональное</w> распределение бюджета помогло компании избежать лишних трат."
                        }
                    ],
                    "synonyms": [
                        "целесообразный",
                        "разумный"
                    ],
                    "common_phrases": [
                        "рациональное использование",
                        "рациональное распределение"
                    ]
                },
                {
                    "sense_id": "fd527528-02a7-355c-90ad-5dc681192aa2",
                    "sense_definition": "Основанный на логике, разуме и рассуждениях, а не на эмоциях или вере.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "разум",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В его словах было трудно найти хотя бы одно <w>рациональное</w> зерно."
                        },
                        {
                            "text": "В споре важно сохранять <w>рациональный</w> подход и опираться только на факты."
                        }
                    ],
                    "synonyms": [
                        "логичный",
                        "логический",
                        "разумный"
                    ],
                    "common_phrases": [
                        "рациональный подход",
                        "рациональное зерно",
                        "рациональное объяснение"
                    ]
                },
                {
                    "sense_id": "c2830c1e-052a-3e61-8920-7243a3d5d001",
                    "sense_definition": "Склонный руководствоваться рассудком, а не чувствами; рассудочный.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "разум",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она всегда была крайне <w>рациональным</w> человеком и никогда не поддавалась панике."
                        },
                        {
                            "text": "Этот <w>рациональный</w> исследователь привык всё тщательно проверять на практике."
                        }
                    ],
                    "synonyms": [
                        "рассудочный",
                        "расчётливый"
                    ],
                    "common_phrases": [
                        "рациональный человек"
                    ]
                },
                {
                    "sense_id": "21c44cf1-d73d-30fa-9ed1-106093ba77a7",
                    "sense_definition": "Представимый в виде отношения целого числа к натуральному числу, то есть в виде обыкновенной дроби.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель напомнил школьникам, чем отличаются <w>рациональные</w> числа от действительных."
                        },
                        {
                            "text": "На уроке мы учились упрощать сложное <w>рациональное</w> выражение по формуле."
                        }
                    ],
                    "common_phrases": [
                        "рациональное число",
                        "рациональная дробь",
                        "рациональное выражение"
                    ]
                },
                {
                    "sense_id": "8f58397b-7ac2-3f32-8c9e-4f93abe443fd",
                    "sense_definition": "Относящийся к рационализму как философскому направлению, свойственный ему.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "разум",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Философы Нового времени активно развивали принципы <w>рационального</w> познания мира."
                        },
                        {
                            "text": "Эта концепция отражает основы <w>рационального</w> мышления эпохи Просвещения."
