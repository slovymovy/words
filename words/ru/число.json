                },
                {
                    "sense_id": "26e786e4-0e4b-32af-b612-76fd00c4ecf6",
                    "sense_definition": "День календарного месяца, обозначаемый порядковым номером.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "calendar_date",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Какое сегодня <w>число</w>?",
                            "target_lang_translations": {
