                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73721d18-23e7-3c33-8c13-41b5f82bf354",
                                        "entry_id": "dc5e832f-19e7-3329-8216-d956259468dd",
                                        "glosses": [
                                            "A mistake or error."
                                        ],
