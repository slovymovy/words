                "senses": [
                    {
                        "sense_id": "4fb6e39f-c950-3e62-ba80-dc4cde4f2e11",
                        "entry_id": "0cc0a720-78d5-3a0e-85ab-b83636c896d2",
                        "glosses": [
                            "männliche Person, die für eine bestimmte Gruppe eine Leitfigur ist, nach der sich viele ausrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b224758-0966-4b80-a910-432137710d5e",
                                "sense_id": "4fb6e39f-c950-3e62-ba80-dc4cde4f2e11",
                                "text": "„Die Liberalen stritten über Bürgerrechte oder Koalitionsfragen, es gab erbitterte Flügelkämpfe, die aus dem Hintergrund befeuert wurden von politischen Übervätern wie Otto Graf Lambsdorff oder Hans-Dietrich Genscher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f478b9e-ab97-4b90-8cc1-e1e123aecf4a",
                        "source_entry_id": "0cc0a720-78d5-3a0e-85ab-b83636c896d2",
                        "source_sense_id": "4fb6e39f-c950-3e62-ba80-dc4cde4f2e11",
                        "source_sense_description": "männliche Person, die für eine bestimmte Gruppe eine Leitfigur ist, nach der sich viele ausrichten",
                        "target_lang_word": "meneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2ce93ea-48be-32da-811c-00fae50479bf",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Celui qui mène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b128aa-b68e-4e3e-8eb9-737508b8bc77",
                                                "sense_id": "e2ce93ea-48be-32da-811c-00fae50479bf",
                                                "text": "Mais le « petit » Antoine, lui, il était insubmersible. Une vraie force de la nature, grand comme un chêne et dur comme un roc. Volubile et débordant de vie, il avait tout d’un meneur d’hommes. Ce que la vie ne lui avait pas donné, il allait le chercher avec les dents. Rien ni personne ne lui résistait, et bien sûr, il faisait se morfondre d’amour toutes les filles du pays, à des kilomètres à la ronde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a18dbf-6628-3bb7-81eb-6052f1c536f0",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Celui qui mène des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5faf26d-39c5-4b1a-95fd-5323b3f00548",
                                                "sense_id": "60a18dbf-6628-3bb7-81eb-6052f1c536f0",
                                                "text": "Ni l’un ni l’autre des béliers qui pénétraient dans l’arène par le portillon étroit ne cherchait à dominer, bousculer, imposer son excellence en passant d’abord. Ils se suivirent sagement. Le premier à entrer fut celui que son meneur tira par une corne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc92e15-4b1d-34ee-b981-7ada02e6c6a7",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Celui qui amène les nourrices aux bureaux qui se chargent de leur procurer des nourrissons."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c129a52-8442-39f7-a4d6-5f25ef1da7ed",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Celui qui, dans une société, une réunion, une entreprise, prend de l’ascendant sur les autres et les guide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a567225a-22fd-47ae-83b2-5b7f3a2c8ee1",
                                                "sense_id": "0c129a52-8442-39f7-a4d6-5f25ef1da7ed",
                                                "text": "Il est le meneur infatigable de toutes les fêtes, de toutes les réjouissances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aeb6a34-95b1-3ecc-9844-50a5fd3e3b86",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Inspirateur d’une intrigue, d’une faction."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd19b25-dde0-45b2-bf6a-ff6090dfb99f",
                                                "sense_id": "5aeb6a34-95b1-3ecc-9844-50a5fd3e3b86",
                                                "text": "Le vrai fait nouveau, aujourd’hui, n’est peut-être pas que les peuples éprouvent les passions politiques, mais qu’ils prétendent les éprouver. Cette prétention suffit, d’ailleurs, à les rendre agissants et à fournir un merveilleux terrain d’exploitation à leurs meneurs."
                                            },
                                            {
                                                "example_id": "8e57555b-21c1-44d3-9f48-38898e1d535c",
                                                "sense_id": "5aeb6a34-95b1-3ecc-9844-50a5fd3e3b86",
                                                "text": "Les interrogatoires vont bon train. […]. Les arguments frappants sont de rigueur. Ils veulent les noms des meneurs, le reste ne les intéresse pas. J'apprends par ceux qui ont été interrogés que ce n'est pas de la tarte."
                                            },
                                            {
                                                "example_id": "0978f38c-cd27-4b2f-a20c-5666de285f85",
                                                "sense_id": "5aeb6a34-95b1-3ecc-9844-50a5fd3e3b86",
                                                "text": "27 octobre 1851 : le juge de paix de La Chapelle d’Angillon signale que la commune d’Ivoy-le-Pré est agitée par des « meneurs » d’Henrichemont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b71d8326-38e5-3936-b3e3-3a2c4cb665e3",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Joueur qui dirige son équipe."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63bcb0aa-4539-4b58-9310-e235c442ba31",
                                                "sense_id": "b71d8326-38e5-3936-b3e3-3a2c4cb665e3",
                                                "text": "En revanche, le meneur des Mavericks de Dallas Frank Ntilikina et l’intérieur Victor Wembanyama ne reviendront pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ba633c-d4c1-314b-9657-ca3bcbf5473c",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Personne qui dirige et mène un attelage équestre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd16d8a1-9552-4063-85ba-37de4663230d",
                                                "sense_id": "f3ba633c-d4c1-314b-9657-ca3bcbf5473c",
                                                "text": "Lundi 1ᵉʳ août, une centaine de cavaliers et meneurs avec leurs chevaux, vététistes et attelages, ont emprunté les chemins vététistes, équibreizh ou communaux."
                                            },
                                            {
                                                "example_id": "fbc8a258-2fa0-4f38-9a48-73f6d92163cc",
                                                "sense_id": "f3ba633c-d4c1-314b-9657-ca3bcbf5473c",
                                                "text": "À peine, dans une halte où se terminait la mission des meneurs de chevaux, je pus remarquer que les gradés qui faisaient le tri des hommes et des chevaux avaient grand’peur des lieux où ils nous envoyaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ca8b9a-e63a-35a4-82f8-a41f4d6b5a8a",
                                        "entry_id": "a9d9d079-0c23-3e42-8bc6-c507769ef581",
                                        "glosses": [
                                            "Meneur de chiens."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "meneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d48ce624-ff65-3d8f-b1ef-244e3bb776ed",
                                        "entry_id": "55cc76db-3f52-347f-ad7c-098d5eba0e54",
                                        "glosses": [
                                            "Ouvrier qui traîne les wagonnets dans les galeries secondaires de roulage, dont les dimensions restreintes s’opposent à la circulation des chevaux."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0197ba69-0001-4218-9c5c-1384a3afb4c4",
                        "source_entry_id": "0cc0a720-78d5-3a0e-85ab-b83636c896d2",
                        "source_sense_id": "4fb6e39f-c950-3e62-ba80-dc4cde4f2e11",
                        "source_sense_description": "männliche Person, die für eine bestimmte Gruppe eine Leitfigur ist, nach der sich viele ausrichten",
                        "target_lang_word": "leader",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leader",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2843335-19d3-3180-84d9-a8884f322c82",
                                        "entry_id": "a6dc064e-7ad0-3b1b-a77f-dff43f6815f0",
                                        "glosses": [
                                            "Personne qui se trouve à la tête d’un parti politique ou d’un groupe quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46de78f-7cfa-4a6d-9617-64bccbfaf1d1",
                                                "sense_id": "a2843335-19d3-3180-84d9-a8884f322c82",
                                                "text": "Pour moi, ayant traversé ces milieux anarchistes et approché certains de ses « leaders » et deviné leurs âmes épouvantables, rien ne m'ôtera de l'idée que c'est Sébastien Faure demeurant dans l'ombre qui a tramé toute la machination contre Philippe Daudet et son Père."
                                            },
                                            {
                                                "example_id": "e749be45-da85-43c1-96d2-e3da083a4031",
                                                "sense_id": "a2843335-19d3-3180-84d9-a8884f322c82",
                                                "text": "Les chanceux sont du groupe A, car ils sont considérés comme ordonnés, perfectionnistes, ou du groupe O (donneur universel), dotés de qualités de leaders."
                                            },
                                            {
                                                "example_id": "659b06fa-a33b-49b4-9354-be251515a439",
                                                "sense_id": "a2843335-19d3-3180-84d9-a8884f322c82",
                                                "text": "« C’est normal qu’Ursula von der Leyen [travaille] avec Giorgia Meloni, elle est membre du Conseil européen, c’est une leader en Europe », explique Zeljana Zovko."
                                            },
                                            {
                                                "example_id": "37f88264-e7ab-40c8-91df-780596852eff",
                                                "sense_id": "a2843335-19d3-3180-84d9-a8884f322c82",
                                                "text": "Rompant avec des années d’efforts de dédiabolisation du RN, la leader d’extrême droite a lancé une guérilla médiatique qui a aussi pour effet de détourner les regards du fond du dossier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfdaf1cf-b4b4-3871-93a3-159b24d99e1c",
                                        "entry_id": "a6dc064e-7ad0-3b1b-a77f-dff43f6815f0",
                                        "glosses": [
                                            "Numéro un d’un secteur économique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de5d305-617b-4cc6-9f82-028105321cfa",
                                                "sense_id": "dfdaf1cf-b4b4-3871-93a3-159b24d99e1c",
                                                "text": "Danone, le géant agroalimentaire français annonce l’acquisition de l’américain YoCrunch, leader des «toppings», ces yaourts agrémentés de garnitures croustillantes comme des pépites de M&Ms, des biscuits Oréo ou encore Granola."
                                            },
                                            {
                                                "example_id": "a72f1065-17ed-46b9-a79d-d814167e8e2b",
                                                "sense_id": "dfdaf1cf-b4b4-3871-93a3-159b24d99e1c",
                                                "text": "Au début des années 90, Bell disposait à l'interne d'un service linguistique redoutable. Il nous fallait aiguiser nos crayons. Dans une campagne de mobilisation interne, nous avions proposé le thème « Leader mondial ». Bell voulait savoir pourquoi nous ne voulions pas employer l'expression « chef de file ». Selon nous, « leader » semblait plus dynamique, mieux rythmé, plus solide. Bref, l'argumentaire s'étalait sur une page et demie. Nous n'avons pas gagné cette bataille. Et « chef de file » me semble toujours moins percutant que « leader »."
                                            },
                                            {
                                                "example_id": "f4684aed-3a45-4fdc-895a-cced25290349",
                                                "sense_id": "dfdaf1cf-b4b4-3871-93a3-159b24d99e1c",
                                                "text": "La Nouvelle Cuisine, c'était un espoir, un dépoussiérage pour une gastronomie qui était rétrograde et cependant leader dans le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312a7044-7594-334d-b26a-af8b45d7e9c3",
                                        "entry_id": "a6dc064e-7ad0-3b1b-a77f-dff43f6815f0",
