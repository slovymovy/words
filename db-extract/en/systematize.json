                "senses": [
                    {
                        "sense_id": "412d9c79-5c53-3841-bb72-9a35e0e80386",
                        "entry_id": "768ad1dd-13c2-38f8-99ab-13147ee2df02",
                        "glosses": [
                            "To arrange into a systematic order; to make systematic; to organise as a system"
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "55e040ae-cacf-46c2-9e8c-9a23390c8643",
                                "sense_id": "412d9c79-5c53-3841-bb72-9a35e0e80386",
                                "text": "And it will be observed, that the intermediate kinds now, for the first time, systematized, are the most refined, and more closely resemble those which constitute the beauty of pictorial colouring."
                            },
                            {
                                "example_id": "fa33fcc3-b2cc-4a59-b0de-1b7b9a937ef4",
                                "sense_id": "412d9c79-5c53-3841-bb72-9a35e0e80386",
                                "text": "In this book Nietzsche elaborated and systematized his criticism of morals, and undertook to show why he considered modern civilization degrading."
                            },
                            {
                                "example_id": "304eb062-8b5a-44de-a194-17e6edac4189",
                                "sense_id": "412d9c79-5c53-3841-bb72-9a35e0e80386",
                                "text": "The European eighteenth century saw the establishment and expansion of two important and interlinked entities: the British Empire and the systematizing of nature."
                            },
                            {
                                "example_id": "611cb113-6f7c-4830-9a28-b2de80cdd1e0",
                                "sense_id": "412d9c79-5c53-3841-bb72-9a35e0e80386",
                                "text": "To get to your sweet spot, you also have to take into account your ability to systematize every aspect of your business. You may think (like Eric) that your industry is too unique or nuanced to systematize, but that's not the case."
                            }
                        ]
                    }
                ],
