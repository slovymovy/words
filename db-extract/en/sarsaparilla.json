                                "target_senses": [
                                    {
                                        "sense_id": "fa1ce7a4-0b30-380c-99f0-80439436a92f",
                                        "entry_id": "4ac3d9d1-f2ce-3e40-9bae-e2bb4fa667b7",
                                        "glosses": [
                                            "Plante du genre Smilax, de l’ordre des liliales et de la famille des Smilaceae (Smilacacées), dont la racine est souvent employée en médecine comme dépurative et sudorifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "645f3d4e-4728-4fb5-ba35-eb6f1e78047f",
                                                "sense_id": "fa1ce7a4-0b30-380c-99f0-80439436a92f",
                                                "text": "La racine de salsepareille a de nombreuses vertus médicinales."
                                            },
                                            {
                                                "example_id": "99cd27fa-fb16-4d17-98ae-0efe343e7088",
                                                "sense_id": "fa1ce7a4-0b30-380c-99f0-80439436a92f",
                                                "text": "Comme cependant l’état de ce malade tendait un peu lentement à la guérison, on associa, le 18 janvier, à l’usage de la liqueur de Van-Swiéten, celui d’un gramme d’iodure de potassium dissous dans la tisane de salsepareille."
                                            },
                                            {
                                                "example_id": "4f27957a-ff71-4138-8d60-b1318ab876d8",
                                                "sense_id": "fa1ce7a4-0b30-380c-99f0-80439436a92f",
                                                "text": "La salsepareille est un arbuste à rhizome tubéreux, fauve, muni de très nombreuses radicelles longues et dures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
