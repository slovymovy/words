        "fr-extract.jsonl": [
            {
                "entry_id": "e326789a-a4dd-3d81-a809-5a47475a2176",
                "word": "gamberge",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "48794a78-6ee7-4fb7-a6ef-2cc1dcea5af5",
                        "entry_id": "e326789a-a4dd-3d81-a809-5a47475a2176",
                        "tags": [
                            "plural"
                        ],
                        "form": "gamberges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7dca9a34-e861-3846-882a-037aa64162fa",
                        "entry_id": "e326789a-a4dd-3d81-a809-5a47475a2176",
                        "glosses": [
                            "Réflexion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ab5632-811b-4f35-8cc0-77e0d6adf675",
                                "sense_id": "7dca9a34-e861-3846-882a-037aa64162fa",
                                "text": "Il se chope le menton entre deux doigts et s’abîme dans une gamberge prononcée."
                            },
                            {
                                "example_id": "f0d17290-9947-465b-93fc-fa0fc19da88b",
                                "sense_id": "7dca9a34-e861-3846-882a-037aa64162fa",
                                "text": "Ça lui a chancetiqué le caviar à gamberge."
                            },
                            {
                                "example_id": "6cea3df0-caa3-4826-8562-4d9103c29553",
                                "sense_id": "7dca9a34-e861-3846-882a-037aa64162fa",
                                "text": "Quand tu touches une pièce d’or de Philippe le Bel, que tu imagines qu’elle est passée entre les mains des templiers, c’est tout de même un beau tremplin à gamberge !"
                            },
                            {
                                "example_id": "ce5c0275-a7b7-44ce-bfed-6c3aabfdbd9f",
                                "sense_id": "7dca9a34-e861-3846-882a-037aa64162fa",
                                "text": "Mon vice à moi, c’est la gamberge, une gamberge intempestive qui se permet, de temps en temps, d’empiéter sur la réalité."
                            },
                            {
                                "example_id": "81181531-9a15-4379-bfe1-bb2b742d037e",
                                "sense_id": "7dca9a34-e861-3846-882a-037aa64162fa",
                                "text": "Pour dégager 20 milliards d’euros d’économies, la gamberge a été poussée très loin par les services de plusieurs ministres."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
