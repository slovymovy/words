    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e27b7ad0-b3d4-33d4-a9c4-0afb1ccb27ef",
                "word": "thereafter",
                "pos": "adv",
                "lang_code": "en",
