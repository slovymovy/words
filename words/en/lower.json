                                "target_lang_word": "нижний",
                                "target_lang_sense_clarification": "находящийся внизу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "alt",
                                "target_lang_sense_clarification": "aşağıda bulunan kısım"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06012b8e-f158-3ee2-85f7-ff551d76f72d",
                    "sense_definition": "Situated on lower ground or further south, often used in place names.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adj_geo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in <w>Lower</w> Manhattan near the financial district.",
                            "target_lang_translations": {
                                "ru": "Они живут в <w>Нижнем</w> Манхэттене, недалеко от финансового квартала.",
                                "tr": "Finans bölgesine yakın olan <w>Aşağı</w> Manhattan'da yaşıyorlar."
                            }
                        },
                        {
                            "text": "The climate in <w>Lower</w> California is quite dry.",
                            "target_lang_translations": {
                                "ru": "Климат в <w>Нижней</w> Калифорнии довольно сухой.",
                                "tr": "<w>Aşağı</w> Kaliforniya'daki iklim oldukça kuraktır."
                            }
                        }
                    ],
                    "antonyms": [
                        "upper"
                    ],
                    "common_phrases": [
                        "Lower Egypt",
                        "Lower Manhattan"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often used in geographical names"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный в низине или южнее (часто в географических названиях).",
                        "tr": "Daha alçak bir arazide veya daha güneyde yer alan (genellikle coğrafi isimlerde kullanılır)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нижний",
                                "target_lang_sense_clarification": "часть топонима"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Aşağı",
                                "target_lang_sense_clarification": "coğrafi isimlerde alt/güney bölgeyi belirtir"
                            }
                        ]
                    }
                }
            ]
        },
        {
