                "senses": [
                    {
                        "sense_id": "f9d84d43-3864-3181-9202-e8418b5e8448",
                        "entry_id": "556b4cab-cc6c-39a5-b7a1-1c2b40db22d8",
                        "glosses": [
                            "Compter plus qu’il n’y a réellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d99191-40fe-421a-8497-5198d271a07f",
                                "sense_id": "f9d84d43-3864-3181-9202-e8418b5e8448",
                                "text": "Un compteur qui peut surcompter, en France, ne peut être admis, comme appareil de mesure poinçonné."
                            }
                        ]
                    },
                    {
                        "sense_id": "028998ce-b2cb-3c3f-8791-472928a6b68c",
                        "entry_id": "556b4cab-cc6c-39a5-b7a1-1c2b40db22d8",
                        "glosses": [
                            "Compter en partant d’un nombre donné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eba0dfed-5dd3-46b8-8b80-5459843e73b4",
                                "sense_id": "028998ce-b2cb-3c3f-8791-472928a6b68c",
                                "text": "On ferme la boîte, un élève indique le nombre de jetons (sans les montrer) qu’il y glisse en une seule fois (on ne peut plus s’aider des objets pour surcompter)."
                            },
                            {
                                "example_id": "729b9044-f870-47aa-9fba-421d95c14fdc",
                                "sense_id": "028998ce-b2cb-3c3f-8791-472928a6b68c",
                                "text": "Je pense que l'enfant doit d'abord surcompter en utilisant ses doigts de façon efficace."
                            }
                        ]
                    }
                ],
