            "senses": [
                {
                    "sense_id": "e7c965e2-9ec8-3fa7-9130-c6a7d91232b6",
                    "sense_definition": "Gefrituurde aardappelstaafjes, vooral in Noord-Nederland zo genoemd.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gefrituurde_aardappel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we vanavond een grote <w>patat</w> met mayonaise bestellen?",
                            "target_lang_translations": {
                                "en": "Shall we order a large portion of <w>fries</w> with mayonnaise tonight?",
                                "ru": "Может, закажем сегодня вечером большую порцию <w>картошки фри</w> с майонезом?"
                            }
                        },
                        {
                            "text": "Ik eet het liefst een <w>patat</w> met satésaus bij de snackbar.",
                            "target_lang_translations": {
                                "en": "I prefer to eat <w>fries</w> with peanut sauce at the snack bar.",
                                "ru": "В закусочной я больше всего люблю есть <w>картофель фри</w> с арахисовым соусом сате."
                            }
                        }
                    ],
                    "synonyms": [
                        "friet",
                        "frieten",
                        "frit",
                        "fritten"
                    ],
                    "common_phrases": [
                        "patat met mayonaise",
                        "zak patat"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in Noord- en Midden-Nederland."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Deep-fried potato strips, especially referred to as such in the northern part of the Netherlands.",
                        "ru": "Обжаренные во фритюре кусочки картофеля, особенно популярные под этим названием на севере Нидерландов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "French fries",
                                "target_lang_sense_clarification": "deep-fried potato strips, US English"
                            },
                            {
                                "target_lang_word": "chips",
                                "target_lang_sense_clarification": "deep-fried potato strips, UK English"
                            },
                            {
                                "target_lang_word": "fries",
                                "target_lang_sense_clarification": "shortened form for deep-fried potato strips"
                            }
                        ],
                        "ru": [
