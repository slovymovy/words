                        "entry_id": "8cfffd5c-2db7-3a1b-aec9-fd4eee66879b",
                        "glosses": [
                            "Chercheur étudiant les effets des substances polluantes sur les espèces, les populations et les environnements naturels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df0495f-8bf8-48e9-a4e8-e4e73975cbd3",
                                "sense_id": "8927b57e-cba5-34f3-9e08-4c773771247e",
                                "text": "Mais qui sont ces écotoxicologues, desservants d’une discipline nouvelle, fille de la Toxicologie et de l’Écologie : l’Écotoxicologie ?"
                            },
                            {
                                "example_id": "33e0fabc-f369-4650-8e06-8460dfd6c06f",
                                "sense_id": "8927b57e-cba5-34f3-9e08-4c773771247e",
                                "text": "Appuyés par l’écotoxicologue Jean-François Narbonne, les parents remettent le couvert et dénoncent « des résultats incomplets, non significatifs et trop précipités »."
                            }
                        ]
                    }
