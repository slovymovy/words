                        "entry_id": "5afc167b-8543-3464-b622-bb34dcceaab8",
                        "glosses": [
                            "The bodies that have political or administrative power and control in a particular sphere."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bb946c92-5fa8-33bc-a971-ec8910a0cae6",
                        "entry_id": "5afc167b-8543-3464-b622-bb34dcceaab8",
                        "glosses": [
                            "The bodies that enforce law and order or provide a public service."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2f5fdfb8-8f7c-43a3-91b2-676455924d2e",
                                "sense_id": "bb946c92-5fa8-33bc-a971-ec8910a0cae6",
                                "text": "ICE arrested Old Orchard Beach Police Department reserve Officer Jon Luke Evans, of Jamaica, on July 25, as part of the agency’s effort to step up immigration enforcement. Officials with the town and police department have said federal authorities previously told them Evans was legally authorized to work in the U.S."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a5a4a2f-1f37-4d8e-b4e7-0a8e9018da6a",
                        "source_entry_id": "5afc167b-8543-3464-b622-bb34dcceaab8",
