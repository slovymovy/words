        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3774c962-5436-3e88-a259-e921a9937a12",
                    "sense_definition": "Qui manque cruellement de raffinement, d'élégance ou de distinction ; ringard ou balourd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Porter des chaussettes blanches dans des sandales, ça fait vraiment <w>plouc</w>."
                        },
                        {
                            "text": "Elle a refusé de porter cette robe démodée qu'elle trouvait beaucoup trop <w>plouc</w>."
                        }
                    ],
                    "common_phrases": [
                        "faire plouc"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "péjoratif"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4f82c405-a690-3216-99db-eac63a14b02c",
                    "sense_definition": "Onomatopée évoquant le bruit d'une goutte ou d'un objet tombant dans un liquide.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On n'entendait dans la grotte que le <w>plouc</w> régulier de l'eau sur la pierre."
                        },
                        {
                            "text": "La pierre a heurté la surface du lac en faisant un petit bruit de <w>plouc</w> étouffé."
                        }
                    ]
                },
                {
                    "sense_id": "1ca2634c-8499-3ae4-8ef2-e5850dc36df7",
                    "sense_definition": "Onomatopée imitant le bruit sourd et étouffé d'un tir d'arme à feu munie d'un silencieux.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pistolet avec son silencieux a fait un bref <w>plouc</w> dans le silence de la nuit."
                        },
                        {
                            "text": "Un léger <w>plouc</w> retentit lorsque le tireur fit sauter discrètement la serrure de la porte."
                        }
                    ]
                }
            ]
        }
