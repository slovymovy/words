                        "examples": [
                            {
                                "example_id": "6623b1d8-acbb-4389-a351-52e66447f893",
                                "sense_id": "34f3cfa0-cbdb-3fce-b342-1547fb98d142",
                                "text": "„Von der Schiffsanlegestelle auf der linken Rheinseite waren es nur noch fünf Minuten bis zum Juridicum, der Rechtswissenschaftlichen Fakultät der Bonner Universität.“"
                            },
                            {
                                "example_id": "bc39ff0d-c864-4e97-8587-6b75842020be",
                                "sense_id": "34f3cfa0-cbdb-3fce-b342-1547fb98d142",
                                "text": "„Für die linke Rheinseite war Hauptmann Buschbeck zuständig.“"
                            },
                            {
                                "example_id": "63273b89-f6f9-40a0-af09-0b96fbd03630",
                                "sense_id": "34f3cfa0-cbdb-3fce-b342-1547fb98d142",
                                "text": "„Nach 1870 fuhren nur noch wenige französische Künstler und Intellektuelle auf die andere Rheinseite, außer Wagner und Nietzsche wurde kaum noch Deutsches rezipiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
