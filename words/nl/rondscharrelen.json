    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eda99956-4e8a-333e-b9e5-475434adc785",
                    "sense_definition": "Zonder vast doel of rustig ergens rondlopen en bezigheden verrichten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kippen <w>scharrelen</w> de hele middag rustig in de tuin <w>rond</w>.",
                            "target_lang_translations": {
                                "fr": "Les poules <w>picorent paisiblement</w> dans le jardin tout l'après-midi."
                            }
                        },
                        {
                            "text": "Ik hoorde de kat buiten op het terras <w>rondscharrelen</w>.",
                            "target_lang_translations": {
                                "fr": "J'ai entendu le chat <w>rôder</w> dehors sur la terrasse."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondlopen",
                        "rondzwerven",
                        "struinen"
                    ],
                    "common_phrases": [
                        "in de tuin rondscharrelen",
                        "wat rondscharrelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Déambuler tranquillement sans but précis, s'affairer ou fureter paisiblement quelque part."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vagabonder",
                                "target_lang_sense_clarification": "se promener tranquillement sans but"
                            },
                            {
                                "target_lang_word": "traînailler",
                                "target_lang_sense_clarification": "errer ou flâner sans but précis"
                            },
                            {
                                "target_lang_word": "picorer de-ci de-là",
                                "target_lang_sense_clarification": "en parlant d'oiseaux ou de volailles"
                            },
                            {
                                "target_lang_word": "musarder",
                                "target_lang_sense_clarification": "flâner en vaquant à de petites occupations"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d21be3c-80a7-3d38-b34b-346bd6d76a58",
                    "sense_definition": "Nieuwsgierig of heimelijk ergens rondkijken of rondzoeken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd betrapt toen hij stiekem in het archief liep te <w>rondscharrelen</w>.",
                            "target_lang_translations": {
                                "fr": "Il a été surpris alors qu'il était en train de <w>fureter</w> en cachette dans les archives."
                            }
                        },
                        {
                            "text": "Waarom <w>scharrel</w> je toch altijd stiekem tussen mijn oude spullen <w>rond</w>?",
                            "target_lang_translations": {
                                "fr": "Pourquoi viens-tu toujours <w>fouiner</w> en cachette dans mes vieilles affaires ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "rondsnuffelen",
                        "rondsluipen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fouiner, fureter ou chercher discrètement ou curieusement quelque part."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fureter",
                                "target_lang_sense_clarification": "chercher curieusement ou indiscrètement partout"
                            },
                            {
                                "target_lang_word": "fouiner",
                                "target_lang_sense_clarification": "chercher indiscrètement, mettre son nez partout"
                            },
                            {
                                "target_lang_word": "farfouiller",
                                "target_lang_sense_clarification": "chercher en désordre, fouiller"
                            }
                        ]
                    }
                }
            ]
        }
    ]
