                                "target_senses": [
                                    {
                                        "sense_id": "e1e0bd8e-e390-3ea3-8043-512902f8e75e",
                                        "entry_id": "688f2a85-38fe-3e61-a5ce-c3c480e2f79d",
                                        "glosses": [
                                            "Variante orthographique de K-way."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0aa1e8f-1bb0-4789-b645-1b3d7a9f3d21",
                                                "sense_id": "e1e0bd8e-e390-3ea3-8043-512902f8e75e",
                                                "text": "Un k-way jaune lui servant de tenue de combat et armée d’un pulvérisateur orange, Manon, 4 ans (photo), était de toutes les bagarres et n’hésitait pas à s’en prendre à plus grand qu’elle."
                                            },
                                            {
                                                "example_id": "047657b2-e7c2-48f1-9e71-4d73b774d90e",
                                                "sense_id": "e1e0bd8e-e390-3ea3-8043-512902f8e75e",
                                                "text": "Il fouilla dans son sac, se souvenant qu'il avait emporté un k-way."
                                            },
                                            {
                                                "example_id": "454fc8aa-46d2-49da-9470-aebad127243a",
                                                "sense_id": "e1e0bd8e-e390-3ea3-8043-512902f8e75e",
                                                "text": "Là haut, le vent était si violent que les k-ways claquaient comme les voiles d'un bateau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96803db2-7d87-40f1-a2c8-df29ce6f62b6",
                        "source_entry_id": "3365bdf0-5f56-3f54-b4d4-b7b86892b667",
                        "source_sense_id": "77f684c0-6cf1-3fb9-835d-d763e2093b4a",
