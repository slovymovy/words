                    {
                        "translation_id": "835c7466-e322-4817-ab27-efdc897714e3",
                        "source_entry_id": "c8764254-5d5b-32d7-9453-fa603ee29851",
                        "source_sense_description": "organic compounds such as sugar, starch or cellulose",
                        "target_lang_word": "koolhydraat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koolhydraat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3771c12-60e1-3492-8b61-6398fe2e607c",
                                        "entry_id": "c992ce58-b7f7-31d7-93b8-fdb4eb4280fa",
                                        "glosses": [
                                            "een bepaald type verbinding van koolstof-, waterstof- en zuurstofatomen met de brutoformule Cₙ(H₂O)ₙ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9937b7de-2dab-49d1-bf29-fce0331b1699",
                                                "sense_id": "b3771c12-60e1-3492-8b61-6398fe2e607c",
                                                "text": "Zetmeel en suiker zijn bekende koolhydraten."
                                            },
                                            {
                                                "example_id": "28bddbe5-5312-4756-a6cd-3a515ed48465",
                                                "sense_id": "b3771c12-60e1-3492-8b61-6398fe2e607c",
                                                "text": "Suiker bestaat uit koolstof, waterstof en zuurstof, en is een dusgenaamd koolhydraat; bij verhitting smelt dezelve en gaat in amorphen toestand over,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0847f1c8-b688-4cb5-935f-18e86f728c3d",
                        "source_entry_id": "c8764254-5d5b-32d7-9453-fa603ee29851",
                        "source_sense_description": "organic compounds such as sugar, starch or cellulose",
                        "target_lang_word": "glucide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glucide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65497cb9-3f8e-38d0-8582-51656a61cd2d",
                                        "entry_id": "3753f81f-35f7-3d44-9a3d-9e5ad87291c4",
                                        "glosses": [
                                            "Type de molécule composée de carbone, d’hydrogène et d’oxygène, un des constituants essentiels des êtres vivants, qui correspond aux molécules des sucres."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd347072-cf2f-432a-a21f-aabc28a0e121",
                                                "sense_id": "65497cb9-3f8e-38d0-8582-51656a61cd2d",
                                                "text": "Le jaune d’œuf contient des lipides, des protéines, des glucides, des minéraux, des vitamines et de l'eau. L'eau constitue 48 % de la masse totale du jaune. — (Reproduction des animaux d’élevage, Educagri, 2005, page 348)"
                                            },
                                            {
                                                "example_id": "ba7cc6bf-2fe7-465a-8631-5bbf87d9412c",
                                                "sense_id": "65497cb9-3f8e-38d0-8582-51656a61cd2d",
                                                "text": "Les deux vagues de vieillissement observées ne portent pas sur les mêmes éléments. Celle constatée à 44 ans concerne des molécules liées aux maladies cardiovasculaires et à la capacité de métaboliser la caféine, l'alcool et les lipides. Quant à celle des 60 ans, elle est davantage liée à des molécules impliquées dans la régulation immunitaire, le métabolisme des glucides et la fonction rénale. Il faut ajouter à cela des molécules touchées lors des deux vagues: celles liées au vieillissement cutané et musculaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "637cfc9d-5c15-46d9-bbcb-217159557727",
                        "source_entry_id": "c8764254-5d5b-32d7-9453-fa603ee29851",
                        "source_sense_description": "organic compounds such as sugar, starch or cellulose",
                        "target_lang_word": "Kohlenhydrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohlenhydrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                        "entry_id": "90dcb685-ec08-307f-b950-d1728a2777f0",
                                        "glosses": [
                                            "chemische Verbindung aus Kohlenstoffdioxid und Wasserstoff, allgemeine Summenformel: CₙH₂ₘOₘ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cd3204-2c1a-4b7b-94be-3e4c7437fafb",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "Kohlenhydrate sind ein wichtiger Bestandteil unserer Ernährung."
                                            },
                                            {
                                                "example_id": "d94a3b9d-78fc-4785-b0a5-113bff74570f",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "Kohlenhydrate sind in Kartoffeln, Zucker und anderen Nahrungsmitteln enthalten."
                                            },
                                            {
                                                "example_id": "585fcf26-ba1d-4fbc-bbe8-cee2d0fd9da5",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Unter den Nährstoffen sind Kohlenhydrate wie Zucker und Stärke die wichtigsten Energieträger.“"
                                            },
                                            {
                                                "example_id": "332cdc10-87a7-421b-98f1-dbfa6277f41c",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Auch Cellulose, der Baustoff pflanzlicher Zellwände, gehört zur Stoffgruppe der Kohlenhydrate.“"
                                            },
                                            {
                                                "example_id": "528140ac-d550-47d7-9c7c-87348c2da5ae",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Die Bezeichnung Kohlenhydrate geht auf die allgemeine Molekülformel Cₙ(H₂O)ₘ zurück, die viele Vertreter dieser Stoffgruppe kennzeichnet.“"
                                            },
                                            {
                                                "example_id": "60bc3697-b898-4f9d-8032-fafc79fbae7f",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Kohlenhydrate, die wie Stärke oder Cellulose aus vielen Monosaccharid-Bausteinen bestehen, nennt man Polysaccharide (Abb. 1).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
