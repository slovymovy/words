                "senses": [
                    {
                        "sense_id": "f7170322-ba83-3fae-81c9-c13345c4f90b",
                        "entry_id": "d4a31416-57a4-3a4e-8b39-bda8e7d23aeb",
                        "glosses": [
                            "zoogdier met een dikke huid zoals een olifant, nijlpaard en neushoorn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b1417e1-9ecf-4c6f-943b-f9e89d3c248a",
                                "sense_id": "f7170322-ba83-3fae-81c9-c13345c4f90b",
                                "text": "In Diergaarde Blijdorp is een neushoorntje geboren. De kleine dikhuid kwam vroeg in de avond ter wereld. Moeder Naima en haar telg maken het goed, zegt woordvoerster Constance Alderlieste van Diergaarde Blijdorp."
                            },
                            {
                                "example_id": "1d317077-3d07-4766-adba-43d0ee3391f5",
                                "sense_id": "f7170322-ba83-3fae-81c9-c13345c4f90b",
                                "text": "Het verbod is belangrijk voor het behoud en de bescherming van de Afrikaanse olifant, wiens slagtanden worden gebruikt voor het maken van objecten maar ook poeders waarvan Chinezen denken dat het een medicijn is. Elk jaar worden, volgens natuurbeschermers, dertigduizend Afrikaanse olifanten afgeslacht door stropers. De dikhuid staat op de lijst van bedreigde diersoorten."
                            },
                            {
                                "example_id": "e7a1e1a1-51d0-4d68-ac7c-64d90f3f1c99",
                                "sense_id": "f7170322-ba83-3fae-81c9-c13345c4f90b",
                                "text": "Die dikhuiden waren geruime tijd achter de schermen te zien, maar ze zwemmen nu weer dagelijks in de Nijlpaardenpoel."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b5b8fbd-46a4-3995-97ba-ee9045780ff6",
                        "entry_id": "d4a31416-57a4-3a4e-8b39-bda8e7d23aeb",
                        "glosses": [
                            "iemand die zich weinig aantrekt van de kritiek van anderen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6547a786-a95a-4032-bb3f-d7d604745456",
                        "source_entry_id": "d4a31416-57a4-3a4e-8b39-bda8e7d23aeb",
                        "source_sense_id": "f7170322-ba83-3fae-81c9-c13345c4f90b",
                        "source_sense_description": "(dierkunde) zoogdier met een dikke huid",
                        "target_lang_word": "Dickhäuter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dickhäuter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37f9b66b-fc7b-3fa0-87c5-539f2c4b2570",
                                        "entry_id": "a444d07f-92b7-39f0-8249-a0d0edf57d10",
                                        "glosses": [
                                            "großes Huftier mit ledriger Haut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51d416af-9b63-44f5-b759-86b7f13e3e45",
                                                "sense_id": "37f9b66b-fc7b-3fa0-87c5-539f2c4b2570",
                                                "text": "„Dazu berichtete Harscher von der Geschichte, die die Einheimischen über die riesigen Dickhäuter erzählen.“"
                                            },
                                            {
                                                "example_id": "c6682492-8891-4434-8676-5967b09788ea",
                                                "sense_id": "37f9b66b-fc7b-3fa0-87c5-539f2c4b2570",
                                                "text": "„Die gelehrigen Dickhäuter bildeten in dem unwegsamen Dschungel eine unschätzbare Hilfe, zumal sie im ausgewachsenen Zustand außer dem Menschen keine natürlichen Feinde haben.“"
                                            },
                                            {
                                                "example_id": "539d3fb7-c04a-40f2-b8e1-5519d6b05d50",
                                                "sense_id": "37f9b66b-fc7b-3fa0-87c5-539f2c4b2570",
                                                "text": "„Als würden die Dickhäuter von ihrem Tempo aus der Kurve getragen, preschten sie auf den Betrachter zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0150ad8-2185-3c72-a41a-d2b1076e2ab7",
                                        "entry_id": "a444d07f-92b7-39f0-8249-a0d0edf57d10",
                                        "glosses": [
                                            "gleichgültiger Mensch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4147644a-b894-404f-aa02-fe6efaf02f51",
                                                "sense_id": "c0150ad8-2185-3c72-a41a-d2b1076e2ab7",
                                                "text": "„Männerkosmetik: Pflege für Dickhäuter und Bartträger“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
