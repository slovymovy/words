                    {
                        "sense_id": "c38ad71a-2889-3de7-ba60-cec09614a757",
                        "entry_id": "4cbf415c-470a-35bd-b2a8-e9bd66b43b95",
                        "glosses": [
                            "in meer dan een vorm binnen dezelfde groep voorkomend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e872b3-966f-4f11-a2a6-8e69c121d910",
                                "sense_id": "c38ad71a-2889-3de7-ba60-cec09614a757",
                                "text": "Die jongen heeft last van polymorfe lichteruptie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e41223a6-5cb2-48f1-99ca-5ffe7dbcd418",
                        "source_entry_id": "4cbf415c-470a-35bd-b2a8-e9bd66b43b95",
                        "source_sense_id": "c38ad71a-2889-3de7-ba60-cec09614a757",
                        "source_sense_description": "in meer dan een vorm binnen dezelfde groep voorkomend",
                        "target_lang_word": "polymorph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymorph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d10d8cfe-d2c0-3a63-9016-525522ddddd1",
                                        "entry_id": "5ed18b3d-ff8b-3f8d-b99f-96e907d48680",
                                        "glosses": [
                                            "mehrere Ausprägungen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4327fd-50ca-4526-a8b0-9497dc2efed8",
                                                "sense_id": "d10d8cfe-d2c0-3a63-9016-525522ddddd1",
                                                "text": "Bei polymorphen Ameisenarten können mehrere Formen innerhalb einer Arbeiter-Kaste vorkommen."
                                            },
                                            {
                                                "example_id": "69ad8d7e-6b58-409d-9f8d-3b356aa93812",
                                                "sense_id": "d10d8cfe-d2c0-3a63-9016-525522ddddd1",
                                                "text": "Bei häufig einfallenden oder auch bei polymorphen Extrasystolen oder bei ventrikulären Salven sollte therapiert werden."
                                            },
                                            {
                                                "example_id": "5cc9657b-3ae2-4741-bbca-e24442ebd81e",
                                                "sense_id": "d10d8cfe-d2c0-3a63-9016-525522ddddd1",
                                                "text": "„Als 1900 die Mendel’schen Regeln wiederentdeckt wurden, wäre hieraus ein gravierendes Argument gegen die Degenerationstheorie abzuleiten gewesen, denn deren Annahme einer polymorphen Vererbung war nun hinfällig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08894783-0f6c-4f64-b832-ca813cf2e4a8",
                        "source_entry_id": "4cbf415c-470a-35bd-b2a8-e9bd66b43b95",
                        "source_sense_id": "c38ad71a-2889-3de7-ba60-cec09614a757",
                        "source_sense_description": "in meer dan een vorm binnen dezelfde groep voorkomend",
                        "target_lang_word": "polymorphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymorphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6af85670-dc96-3c54-8958-dcb77ea78418",
                                        "entry_id": "3efd13ad-8c34-3cec-b5d4-930aae7e13cb",
                                        "glosses": [
                                            "Relating to polymorphism (any sense), able to have several shapes or forms."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b731374c-91be-4e6e-ac67-2e845af49725",
                                                "sense_id": "6af85670-dc96-3c54-8958-dcb77ea78418",
                                                "text": "I refer to those genera which have sometimes been called \"protean\" or \"polymorphic,\" in which the species present an inordinate amount of variation; and hardly two naturalists can agree which forms to rank as species and which as varieties."
                                            },
                                            {
                                                "example_id": "be3a868f-5346-49e8-8787-d4dbe3bb46af",
                                                "sense_id": "6af85670-dc96-3c54-8958-dcb77ea78418",
                                                "text": "1897, Grant Allen, An African Millionaire\nDr. Beddersley came -- a dapper little man, with pent-house eyebrows, and keen, small eyes, whom I suspected at sight of being Colonel Clay himself in another of his clever polymorphic embodiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391e234f-0d74-3a78-83af-800f9a52cdfc",
                                        "entry_id": "3efd13ad-8c34-3cec-b5d4-930aae7e13cb",
                                        "glosses": [
                                            "Having or relating to the ability to take multiple data types for a single parameter."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c1c14d1-737c-46e8-8db2-755d1a9204c4",
                                                "sense_id": "391e234f-0d74-3a78-83af-800f9a52cdfc",
                                                "text": "Polymorphic redefinition in C++ is achieved by the use of virtual functions."
                                            },
                                            {
                                                "example_id": "828740a3-04cb-4d4f-bcfb-220eb6c1ca56",
                                                "sense_id": "391e234f-0d74-3a78-83af-800f9a52cdfc",
                                                "text": "A polymorphic call looks like a procedural call, but where a procedural call has only one possible target subroutine, a polymorphic call can result in the execution of one of several different subroutines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e337f07-7560-3f18-9035-fbb9096f99b1",
                                        "entry_id": "3efd13ad-8c34-3cec-b5d4-930aae7e13cb",
                                        "glosses": [
                                            "Relating to a compound that can crystallizes into two or more distinct forms (e.g. carbon, which can crystalize into coal, graphite, diamond, etc.)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042fc606-5a2f-4815-9a80-beb5e5b1d937",
                                                "sense_id": "4e337f07-7560-3f18-9035-fbb9096f99b1",
                                                "text": "The fact that polymorphic equilibrium is not a dynamic equilibrium is significant with respect to the random distribution of velocity of temperature agitation among the molecules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6682712d-2431-46f3-a3d3-657579619e7c",
                        "source_entry_id": "4cbf415c-470a-35bd-b2a8-e9bd66b43b95",
                        "source_sense_id": "c38ad71a-2889-3de7-ba60-cec09614a757",
