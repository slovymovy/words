{
    "word_family": [
        "bowling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f34b3cf4-67e3-3cdd-94f0-87f8ddbd7a81",
                    "sense_definition": "A bottle-shaped target used in the game of tenpin bowling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bowling_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player aimed carefully to knock down every <w>tenpin</w> on the lane.",
                            "target_lang_translations": {
                                "zh": "选手仔细瞄准，试图击倒球道上的每一个<w>球瓶</w>。"
                            }
                        },
                        {
                            "text": "A single <w>tenpin</w> remained standing after the first throw.",
                            "target_lang_translations": {
                                "zh": "第一球投出后，还剩下一个<w>球瓶</w>没倒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pin"
                    ],
                    "common_phrases": [
                        "knock down tenpin"
                    ],
                    "target_lang_definitions": {
                        "zh": "保龄球运动中使用的瓶状目标物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "球瓶",
                                "target_lang_sense_clarification": "保龄球运动中被击打的瓶状物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a92036e7-3fb2-3143-b27b-71e9b5a72185",
                    "sense_definition": "A form of bowling where players roll a ball to knock down ten pins arranged in a triangle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bowling_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to the local alley to play a game of <w>tenpin</w>.",
                            "target_lang_translations": {
                                "zh": "我们决定去当地的球馆打一场<w>保龄球</w>。"
                            }
                        },
                        {
                            "text": "Professional <w>tenpin</w> requires great precision and focus.",
                            "target_lang_translations": {
                                "zh": "职业<w>保龄球</w>运动需要极高的精准度和专注力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bowling"
                    ],
                    "common_phrases": [
                        "play tenpin"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过滚动球来击倒三角形排列的十个球瓶的保龄球运动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "保龄球",
                                "target_lang_sense_clarification": "指代保龄球这项运动本身"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}