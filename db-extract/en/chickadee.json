                                        "examples": [
                                            {
                                                "example_id": "99f3d34a-7efb-4c06-a25e-803eb8e44c65",
                                                "sense_id": "33a268ad-93ea-3959-9a06-372901aed932",
                                                "text": "Die Familie der Meisen umfasst viele Arten von Singvögeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0de1502b-a75e-3c6d-8c1e-43daaccb6cfe",
                                        "entry_id": "8b051d84-16ba-34ad-8523-1d8149ca6e5c",
                                        "glosses": [
                                            "ein Vertreter der Meisen; ein kleiner, im Sommer insektenfressender, im Winter körnerfressender Singvogel"
                                        ],
                                        "tags": [
                                            "im Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec6ec761-ba77-49c3-9711-3456e4420d54",
                                                "sense_id": "0de1502b-a75e-3c6d-8c1e-43daaccb6cfe",
                                                "text": "Meisen nisten sogar in Laternenpfählen."
                                            },
                                            {
                                                "example_id": "3a611c04-580d-472b-a3d0-739de9e52977",
                                                "sense_id": "0de1502b-a75e-3c6d-8c1e-43daaccb6cfe",
                                                "text": "„Als ich am Morgen in den großen Raum kam, saß die Meise auf einer Stuhllehne und hatte den Stoff angekackt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96630987-9d55-39d4-96c1-21ea377c7672",
                                        "entry_id": "8b051d84-16ba-34ad-8523-1d8149ca6e5c",
                                        "glosses": [
                                            "Ausdruck in Redewendungen in Verbindung mit haben für „spinnen“, leichte Verrücktheit"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3154ca14-ead9-4acf-87b1-ac7a099d9759",
                                                "sense_id": "96630987-9d55-39d4-96c1-21ea377c7672",
                                                "text": "Ich glaube, der Typ hat eine Meise. Vorsicht!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
