{
    "word_family": [
        "dullness",
        "dullard",
        "duly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d56ff2a3-9f02-31c5-aaa0-3bdb417cf577",
                    "sense_definition": "Lacking the ability to cut easily; not sharp.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All these knives are <w>dull</w>.",
                            "target_lang_translations": {
                                "zh": "这些刀全都不<w>钝</w>了。",
                                "ru": "Все эти ножи <w>тупые</w>."
                            }
                        },
                        {
                            "text": "The <w>dull</w> blade made it difficult to slice the bread.",
                            "target_lang_translations": {
                                "zh": "刀刃太<w>钝</w>，很难切开面包。",
                                "ru": "<w>Тупое</w> лезвие затрудняло нарезку хлеба."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunt"
                    ],
                    "antonyms": [
                        "sharp"
                    ],
                    "common_phrases": [
                        "dull knife"
                    ],
                    "target_lang_definitions": {
                        "zh": "指刀具等不锋利，难以切割。",
                        "ru": "О предметах: не острый, не способный легко резать."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钝",
                                "target_lang_sense_clarification": "形容刀刃不锋利。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тупо́й",
                                "target_lang_sense_clarification": "о лезвии или инструменте, который потерял остроту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be9b9ccf-3b80-39f5-b10a-c8d748ff2e06",
                    "sense_definition": "Not shiny; having a matte finish or no particular luster or brightness.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Choose a <w>dull</w> finish to hide fingerprints.",
                            "target_lang_translations": {
                                "zh": "选择<w>哑光</w>饰面可以遮盖指纹。",
                                "ru": "Выберите <w>матовую</w> отделку, чтобы скрыть отпечатки пальцев."
                            }
                        },
                        {
                            "text": "The old car had a <w>dull</w> paint job after years in the sun.",
                            "target_lang_translations": {
                                "zh": "这辆旧车在太阳下暴晒多年，车漆已经变得<w>暗淡</w>了。",
                                "ru": "После многих лет на солнце краска старой машины стала <w>тусклой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "matte"
                    ],
                    "antonyms": [
                        "bright"
                    ],
                    "common_phrases": [
                        "dull finish"
                    ],
                    "target_lang_definitions": {
                        "zh": "指表面不光亮，呈哑光状态。",
                        "ru": "Не блестящий, имеющий матовую поверхность или лишенный яркости."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暗淡",
                                "target_lang_sense_clarification": "形容光泽度低。"
                            },
                            {
                                "target_lang_word": "哑光",
                                "target_lang_sense_clarification": "指没有光泽的表面处理。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ту́склый",
                                "target_lang_sense_clarification": "лишенный блеска, яркости"
                            },
                            {
                                "target_lang_word": "ма́товый",
                                "target_lang_sense_clarification": "неблестящий, шероховатый на вид"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e16beda-617c-34cb-a52d-d5d18f881f61",
                    "sense_definition": "Cloudy; overcast.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>dull</w> day.",
                            "target_lang_translations": {
                                "zh": "今天天气很<w>阴沉</w>。",
                                "ru": "Сегодня <w>пасмурный</w> день."
                            }
                        },
                        {
                            "text": "We stayed inside because of the <w>dull</w> weather.",
                            "target_lang_translations": {
                                "zh": "因为天气<w>阴沉</w>，我们待在室内。",
                                "ru": "Мы остались дома из-за <w>хмурой</w> погоды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dull day"
                    ],
                    "target_lang_definitions": {
                        "zh": "指天气阴沉，光线不足。",
                        "ru": "Облачный, пасмурный, с недостатком солнечного света."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阴沉",
                                "target_lang_sense_clarification": "形容天气阴暗。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пасмурный",
                                "target_lang_sense_clarification": "о погоде, когда небо затянуто тучами"
                            },
                            {
                                "target_lang_word": "хмурый",
                                "target_lang_sense_clarification": "о мрачном, неприветливом дне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15cf3ebe-292f-37e5-b96a-456b3000b910",
                    "sense_definition": "Boring; not exciting or interesting.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat through the <w>dull</w> lecture and barely stayed awake.",
                            "target_lang_translations": {
                                "zh": "他坐在那听着<w>枯燥</w>的讲座，几乎无法保持清醒。",
                                "ru": "Он просидел на <w>скучной</w> лекции и едва не уснул."
                            }
                        },
                        {
                            "text": "The movie was quite <w>dull</w> and we left early.",
                            "target_lang_translations": {
                                "zh": "这部电影相当<w>无聊</w>，我们提前离场了。",
                                "ru": "Фильм был довольно <w>нудным</w>, и мы ушли пораньше."
                            }
                        }
                    ],
                    "synonyms": [
                        "boring",
                        "tedious"
                    ],
                    "common_phrases": [
                        "dull lecture"
                    ],
                    "target_lang_definitions": {
                        "zh": "指枯燥乏味，缺乏趣味。",
                        "ru": "Скучный, неинтересный, вызывающий уныние."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "枯燥",
                                "target_lang_sense_clarification": "形容内容单调乏味。"
                            },
                            {
                                "target_lang_word": "无聊",
                                "target_lang_sense_clarification": "形容令人感到没意思。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ску́чный",
                                "target_lang_sense_clarification": "неинтересный, вызывающий скуку"
                            },
                            {
                                "target_lang_word": "ну́дный",
                                "target_lang_sense_clarification": "однообразный и утомительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96505395-9ab3-339a-bf33-8cf9dba7235e",
                    "sense_definition": "Not bright or intelligent; stupid; having slow understanding.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is not <w>dull</w> enough to believe that lie.",
                            "target_lang_translations": {
                                "zh": "她没那么<w>迟钝</w>，不会相信那个谎言。",
                                "ru": "Она не настолько <w>глупа</w>, чтобы поверить в эту ложь."
                            }
                        },
                        {
                            "text": "The student was not <w>dull</w> but simply lacked motivation.",
                            "target_lang_translations": {
                                "zh": "这个学生并不<w>迟钝</w>，只是缺乏动力。",
                                "ru": "Студент не был <w>тупым</w>, ему просто не хватало мотивации."
                            }
                        }
                    ],
                    "synonyms": [
                        "stupid",
                        "dense"
                    ],
                    "antonyms": [
                        "bright"
                    ],
                    "target_lang_definitions": {
                        "zh": "指反应迟钝，不够聪明。",
                        "ru": "Не сообразительный, медленно понимающий, глуповатый."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "迟钝",
                                "target_lang_sense_clarification": "形容思维或反应慢。"
                            },
                            {
                                "target_lang_word": "笨拙",
                                "target_lang_sense_clarification": "形容不够灵敏。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тупо́й",
                                "target_lang_sense_clarification": "о человеке с медленной реакцией или низким интеллектом"
                            },
                            {
                                "target_lang_word": "глу́пый",
                                "target_lang_sense_clarification": "недалекий, неумный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "207ece44-a2b8-3672-b9b0-19dfd0f7edc2",
                    "sense_definition": "To render dull; to remove or blunt an edge or something that was sharp.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of misuse have <w>dulled</w> the tools.",
                            "target_lang_translations": {
                                "zh": "多年的不当使用把这些工具都<w>弄钝</w>了。",
                                "ru": "Годы неправильного использования <w>затупили</w> инструменты."
                            }
                        },
                        {
                            "text": "Cutting metal will quickly <w>dull</w> the blade.",
                            "target_lang_translations": {
                                "zh": "切割金属会很快把刀刃<w>弄钝</w>。",
                                "ru": "Резка металла быстро <w>затупит</w> лезвие."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunt"
                    ],
                    "common_phrases": [
                        "dull the blade"
                    ],
                    "target_lang_definitions": {
                        "zh": "使变钝，削弱锋利度。",
                        "ru": "Делать что-либо менее острым, лишать остроты."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄钝",
                                "target_lang_sense_clarification": "使工具失去锋利。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "затупи́ть",
                                "target_lang_sense_clarification": "сделать предмет не острым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef1ccc76-688c-3d88-9cfb-1c743f2de966",
                    "sense_definition": "To soften, moderate or blunt; to make dull, stupid, or sluggish; to stupefy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drinks to <w>dull</w> the pain.",
                            "target_lang_translations": {
                                "zh": "他喝酒是为了<w>减轻</w>痛苦。",
                                "ru": "Он пьет, чтобы <w>притупить</w> боль."
                            }
                        },
                        {
                            "text": "The medicine helped to <w>dull</w> the sharp ache in his leg.",
                            "target_lang_translations": {
                                "zh": "药物有助于<w>减轻</w>他腿部的剧痛。",
                                "ru": "Лекарство помогло <w>притупить</w> острую боль в ноге."
                            }
                        }
                    ],
                    "synonyms": [
                        "soften",
                        "moderate"
                    ],
                    "common_phrases": [
                        "dull the pain"
                    ],
                    "target_lang_definitions": {
                        "zh": "使减弱、缓和或变得麻木。",
                        "ru": "Смягчать, ослаблять интенсивность (боли, чувств) или делать менее восприимчивым."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "减轻",
                                "target_lang_sense_clarification": "使疼痛或感觉减弱。"
                            },
                            {
                                "target_lang_word": "麻痹",
                                "target_lang_sense_clarification": "使感觉变得迟钝。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "притупи́ть",
                                "target_lang_sense_clarification": "ослабить остроту ощущений или чувств"
                            },
                            {
                                "target_lang_word": "приглуши́ть",
                                "target_lang_sense_clarification": "сделать менее выраженным, ослабить"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a3d50488-37bf-34cc-80d9-9138b9d9e90e",
                    "sense_definition": "A village in Perth and Kinross council area, Scotland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Dull</w> while traveling through Scotland.",
                            "target_lang_translations": {
                                "zh": "他们在苏格兰旅行时参观了<w>达尔</w>这个小村庄。",
                                "ru": "Путешествуя по Шотландии, они посетили маленькую деревню <w>Дал</w>."
                            }
                        },
                        {
                            "text": "The road to <w>Dull</w> is very scenic.",
                            "target_lang_translations": {
                                "zh": "通往<w>达尔</w>的路风景非常优美。",
                                "ru": "Дорога в <w>Дал</w> очень живописна."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "苏格兰的一个村庄名。",
                        "ru": "Деревня в области Перт-энд-Кинросс, Шотландия."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "达尔",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Дал",
                                "target_lang_sense_clarification": "название деревни в Шотландии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}