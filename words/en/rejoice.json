{
    "word_family": [
        "rejoicing",
        "rejoicement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6dc71d42-3ab3-30bd-94de-2419c5c64c7e",
                    "sense_definition": "To feel or show great joy or delight; to be exceptionally happy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feel_joy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire nation began to <w>rejoice</w> when the peace treaty was finally signed."
                        },
                        {
                            "text": "We have every reason to <w>rejoice</w> in our team's historic victory today."
                        }
                    ],
                    "synonyms": [
                        "delight",
                        "exult"
                    ],
                    "antonyms": [
                        "mourn",
                        "grieve",
                        "lament"
                    ],
                    "common_phrases": [
                        "rejoice in",
                        "reason to rejoice"
                    ]
                },
                {
                    "sense_id": "d9fdae37-f314-3dcd-bdd1-cae31f0a3c4c",
                    "sense_definition": "To make someone happy; to gladden or exhilarate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "make_happy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would <w>rejoice</w> my heart to see you succeed after all your hard work."
                        },
                        {
                            "text": "The good news of her recovery <w>rejoiced</w> the entire family."
                        }
                    ],
                    "synonyms": [
                        "gladden",
                        "cheer",
                        "exhilarate",
                        "gratify",
                        "please"
                    ],
                    "antonyms": [
                        "sadden",
                        "depress"
                    ],
                    "common_phrases": [
                        "rejoice the heart",
                        "rejoice the soul"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This transitive use meaning 'to make happy' is now literary or dated."
                        }
                    ]
                },
                {
                    "sense_id": "5f420f35-7ab3-3edc-8c17-b3164e837db4",
                    "sense_definition": "To have the use or benefit of; to enjoy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In those days, the local lords <w>rejoiced</w> the sole right to fish in these waters."
                        },
                        {
                            "text": "He <w>rejoiced</w> the privilege of a private library during his long stay."
                        }
                    ],
                    "synonyms": [
                        "enjoy",
                        "possess"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of possessing or enjoying a right or property."
                        }
                    ]
                },
                {
                    "sense_id": "1ff6a669-22b6-3786-ac64-2c6b1bebe290",
                    "sense_definition": "To have someone as a lover or spouse; to enjoy sexually.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexual_enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tale spoke of a knight who would never <w>rejoice</w> any lady other than his queen."
                        },
                        {
                            "text": "He lamented that he might never <w>rejoice</w> his beloved again."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used in Middle English and early modern texts."
                        }
                    ]
                }
            ]
        }
    ]
