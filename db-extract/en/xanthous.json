                                        "entry_id": "261a609f-529f-3d29-8305-e1d43c8587c6",
                                        "glosses": [
                                            "Qui est d’un jaune pâle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa72a81a-da91-4298-a626-5b51e0922cca",
                                                "sense_id": "955f9cd7-1a8b-3d40-84e6-cccbd00b5bf6",
                                                "text": "Dessous des inférieures d'un jaune-ochracé plus ou moins pâle , avec la bordure d'un brun pâle, précédée de deux raies maculaires plus ou moins obsolètes, de la même couleur."
                                            },
                                            {
                                                "example_id": "6262edad-332c-402e-8085-bec8e3c689bb",
                                                "sense_id": "955f9cd7-1a8b-3d40-84e6-cccbd00b5bf6",
                                                "text": "À l'horizon ouest, le couchant est ochracé par le smog émanant des gisements de Hassi R'Mel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
