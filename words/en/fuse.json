                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the bath overflowed, the downstairs lights <w>fused</w>, so we need a torch."
                        },
                        {
                            "text": "The television <w>fused</w> during the storm last night."
