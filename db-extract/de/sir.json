                "senses": [
                    {
                        "sense_id": "2310d1f0-ed54-3dec-ac38-877b1926bc47",
                        "entry_id": "37c28f88-cb43-3fc9-91f2-900098d0d58d",
                        "glosses": [
                            "männlicher Titel des britischen Adels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f1feb3-13d0-48cc-8c7e-4e86003d1d77",
                                "sense_id": "2310d1f0-ed54-3dec-ac38-877b1926bc47",
                                "text": "Sir Elton John ist nicht der einzige Musiker, der sich mit dem Titel Sir schmücken darf."
                            },
                            {
                                "example_id": "ac98e8f8-513e-4cb7-9d1e-a612f9124247",
                                "sense_id": "2310d1f0-ed54-3dec-ac38-877b1926bc47",
                                "text": "„Der englische Jurist, der mit der Entscheidung über den Grenzverlauf beauftragt wurde, Sir Cyril Radcliffe, war nie zuvor in Indien gewesen, hatte für seine unmögliche Aufgabe fünf Wochen Zeit und bekam keine Gelegenheit, die betroffenen Landstriche selbst zu besichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dcf8ddc4-e2f1-30b8-855b-3e950173f2be",
                        "entry_id": "37c28f88-cb43-3fc9-91f2-900098d0d58d",
                        "glosses": [
                            "englische Anrede eines Herrn ohne seinen Namen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9ca17e-fbfc-4507-bb4c-7b3566888fc0",
                                "sense_id": "dcf8ddc4-e2f1-30b8-855b-3e950173f2be",
                                "text": "Bitte entschuldigen Sie, Sir!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdaaee23-0cb0-4425-ad5f-ac8d7fa86d2a",
                        "source_entry_id": "37c28f88-cb43-3fc9-91f2-900098d0d58d",
                        "source_sense_id": "2310d1f0-ed54-3dec-ac38-877b1926bc47",
                        "source_sense_description": "männlicher Titel des britischen Adels",
                        "target_lang_word": "sir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f5d636d-83f8-3023-98c1-05be2b4b50df",
                                        "entry_id": "aace4d32-1bcb-31f5-9402-23740dd1e066",
                                        "glosses": [
                                            "A man of a higher rank or position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bebd464e-38de-3492-9b87-1924ac81a3b3",
                                        "entry_id": "aace4d32-1bcb-31f5-9402-23740dd1e066",
                                        "glosses": [
                                            "A respectful term of address to a man of higher rank or position, particularly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e538278a-4109-4fb7-8b94-7d31ee086d9e",
                                                "sense_id": "bebd464e-38de-3492-9b87-1924ac81a3b3",
                                                "text": "Jeeves: Foreign travel often liberates emotions best kept in check, sir. The air of North America is notoriously stimulating in this regard, as witness the regrettable behavior of its inhabitants in 1776.\nB. Wooster: Hm? What happened in 1776, Jeeves?\nJeeves: I prefer not to dwell on it, if it's convenient to you, sir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0816068c-721f-35b6-be1d-50e8f28a729d",
                                        "entry_id": "aace4d32-1bcb-31f5-9402-23740dd1e066",
                                        "glosses": [
                                            "A respectful term of address to a man of higher rank or position",
                                            "to a knight or other low member of the peerage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "752d8aab-6eb1-46cf-9eee-9bd9da16d639",
                                                "sense_id": "0816068c-721f-35b6-be1d-50e8f28a729d",
                                                "text": "Just be careful. He gets whingy now if you don't address him as Sir John."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c6a6e0-1b78-369e-991a-e621b305379a",
                                        "entry_id": "aace4d32-1bcb-31f5-9402-23740dd1e066",
                                        "glosses": [
                                            "A respectful term of address to a man of higher rank or position",
                                            "to a superior military officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af2e2e58-8c26-45f6-a8c1-b5a09ad1f402",
                                                "sense_id": "20c6a6e0-1b78-369e-991a-e621b305379a",
                                                "text": "Sir, yes sir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a84c196-9d4c-3c2c-bd9d-f9c5d83ccb49",
                                        "entry_id": "aace4d32-1bcb-31f5-9402-23740dd1e066",
                                        "glosses": [
                                            "A respectful term of address to a man of higher rank or position",
                                            "to a teacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b4a80f0-2b50-4802-a819-0be102224202",
                                                "sense_id": "2a84c196-9d4c-3c2c-bd9d-f9c5d83ccb49",
                                                "text": "Here's my report, sir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b935cd-1396-3ca0-a5ed-a2f466ee013b",
                                        "entry_id": "aace4d32-1bcb-31f5-9402-23740dd1e066",
                                        "glosses": [
                                            "A respectful term of address to an adult male (often older), especially if his name or proper title is unknown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89db649d-04dd-424f-8487-1a53ecd5131d",
                                                "sense_id": "39b935cd-1396-3ca0-a5ed-a2f466ee013b",
                                                "text": "Excuse me, sir, do you know the way to the art museum?"
                                            },
                                            {
                                                "example_id": "5911dd6b-c1de-49a9-b76d-75b27ff2634c",
                                                "sense_id": "39b935cd-1396-3ca0-a5ed-a2f466ee013b",
                                                "text": "Knowledge, sir, should be free to all!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77628ac1-1f54-3d5a-b58f-4a18dab31fd9",
                                        "entry_id": "c8554750-f81e-3124-8ab6-fdabc21f43e1",
                                        "glosses": [
                                            "To address another individual using \\\"sir\\\"."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d146b0-518a-4f84-b3cf-86df81d25fe4",
                                                "sense_id": "77628ac1-1f54-3d5a-b58f-4a18dab31fd9",
                                                "text": "Sir, yes, sir! —Don't you sir me, private! I work for a living!"
                                            },
                                            {
                                                "example_id": "418f7b95-05b1-40ba-a1c0-5ba0f2d3dfd9",
                                                "sense_id": "77628ac1-1f54-3d5a-b58f-4a18dab31fd9",
                                                "text": "Don't \"Sir\" me, young man, you have no idea who you're dealing with!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
