                    },
                    {
                        "sense_id": "7f188540-b80f-3653-ad69-4eac0265e848",
                        "entry_id": "d3943add-f8cb-3c82-81fa-6796fff3c600",
                        "glosses": [
                            "перен. откровенное признание в чем-либо; откровенное, чистосердечное изложение чего-либо"
                        ],
                        "tags": [],
