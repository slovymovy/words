                "senses": [
                    {
                        "sense_id": "5d20f08a-94ca-3836-a36f-0e87165a2bba",
                        "entry_id": "56a46721-55ce-3f19-937f-8e43ffdf4924",
                        "glosses": [
                            "Einkaufswagerl und Kinderwagerl"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "77a609ae-c151-4a19-b94e-c535079caba8",
                                "sense_id": "5d20f08a-94ca-3836-a36f-0e87165a2bba",
                                "text": "„Ich schnappte mir ein großes Wagerl und nahm den schnellsten Weg durch die Kassen.“"
                            },
                            {
                                "example_id": "5435aef1-23f9-4d45-b79d-3608f22ac01c",
                                "sense_id": "5d20f08a-94ca-3836-a36f-0e87165a2bba",
                                "text": "„Vor dem Kühlregal, der Othmar will gerade eine Packung Knackwürste ins Wagerl schmeissen, läutet wieder sein Handy.“"
                            },
                            {
                                "example_id": "e83c9de0-8c1d-4c7a-9423-44e2f604a90c",
                                "sense_id": "5d20f08a-94ca-3836-a36f-0e87165a2bba",
                                "text": "„Tatsächlich sieht es beim Wandern mit Kindern oft so aus: Ein Kind sitzt im Wagerl, die ältere Schwester oder der ältere Bruder geht daneben.“"
                            }
                        ],
