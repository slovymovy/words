                "senses": [
                    {
                        "sense_id": "0413c984-01ba-3860-a124-ce788ccf3b4d",
                        "entry_id": "8c7f045f-9f17-3e7d-a6da-8b79f28fff89",
                        "glosses": [
                            "englische Geheimsprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8132470-e3ef-4453-ae8d-f4f2390e834e",
                                "sense_id": "0413c984-01ba-3860-a124-ce788ccf3b4d",
                                "text": "„Auch das Englische hat seine Geheimsprachen; eine von ihnen ist das sogenannte Schweine-Latein."
                            },
                            {
                                "example_id": "d17ae10d-2a8e-4314-a04e-b09044a7042f",
                                "sense_id": "0413c984-01ba-3860-a124-ce788ccf3b4d",
                                "text": "„Schweine-Latein (engl. Pig Latin), bei dem hinten an jedes Wort sein Onset plus der Reim /-en/ gehangen wird, z.B. »Mias Buch« … -/isamen u:chen/.“"
                            },
                            {
                                "example_id": "56ab2ae7-e9ef-402b-b633-08d3174e535a",
                                "sense_id": "0413c984-01ba-3860-a124-ce788ccf3b4d",
                                "text": "„Als ich VisiCalc entdeckte, schrieb ich ein Spreadsheet, um Englisch von VisiCalc in Pig Latin (wörtl. Schweine-Latein, Spielsprache im englischen Sprachraum) zu übersetzen.“"
                            },
                            {
                                "example_id": "1a9575bd-b914-48f0-aa4b-d675c643df02",
                                "sense_id": "0413c984-01ba-3860-a124-ce788ccf3b4d",
                                "text": "„Wer sich für Kuckucksei-Aufgaben, Schüttelreime und Schweine-Latein interessiert, sollte dieses Buch lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
