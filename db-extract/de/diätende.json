                ],
                "senses": [
                    {
                        "sense_id": "89f3dbd6-bfb4-3f29-a877-d174f469ca82",
                        "entry_id": "1cf167e1-9368-33d7-8ec0-af34fe43c6f9",
                        "glosses": [
                            "Ende der Diätphase; Zeitpunkt, an dem eine Diät zu Ende ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72a887d-592b-4237-9b94-1c4f56cafcd9",
                                "sense_id": "89f3dbd6-bfb4-3f29-a877-d174f469ca82",
                                "text": "„Innerhalb kürzester Zeit nach Diätende kehren die verlorenen Pfunde wieder zurück.“"
                            },
                            {
                                "example_id": "c6c0d005-8028-411c-a760-f7920d6bab7f",
                                "sense_id": "89f3dbd6-bfb4-3f29-a877-d174f469ca82",
                                "text": "„Trotz vorübergehendem Gewichtsverlust kommt es hier nach Diätende wieder zu einer Gewichtszunahme.“"
                            },
                            {
                                "example_id": "797bb232-cc0a-43a3-b272-c7b509469af8",
                                "sense_id": "89f3dbd6-bfb4-3f29-a877-d174f469ca82",
                                "text": "„Hier findest du Tipps, wie [sic!] 10 Kilo abnehmen kannst ohne den Jojo-Effekt nach Diätende.“"
                            },
                            {
                                "example_id": "6c0c8b80-875d-4889-8609-3902192fbc53",
                                "sense_id": "89f3dbd6-bfb4-3f29-a877-d174f469ca82",
                                "text": "„Natürlich ist es gefährlich, nach dem Diätende direkt wieder unkontrolliert zu essen.“"
                            },
                            {
                                "example_id": "f1abd78f-cfd5-4735-8fdd-31ecc495c794",
                                "sense_id": "89f3dbd6-bfb4-3f29-a877-d174f469ca82",
                                "text": "„Aber einige Zeit nach Diätende bist Du sonderbarerweise nicht nur so schwer wie zuvor, sondern darüber hinaus fühlst [sic!] Dich noch schlechter und antriebsloser als zu Beginn dieses für Dich erfolglosen Unterfangens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
