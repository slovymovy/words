                                "target_senses": [
                                    {
                                        "sense_id": "8c290ebe-a8bb-368c-aac9-315c6ad52657",
                                        "entry_id": "4ae21ceb-57f9-3119-be46-aaf15e9d35cb",
                                        "glosses": [
                                            "heftige afkeer van mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d811b709-4dfb-4e3c-91a8-136e9f476687",
                                                "sense_id": "8c290ebe-a8bb-368c-aac9-315c6ad52657",
                                                "text": "In de donkere ogen die strak vooruitstaren, liggen afgronden van mensenhaat, het gebaar waarmee de kleine, bijna vrouwelijke handen zich automatisch ballen en weer openen is een gebaar van vernietiging."
                                            },
                                            {
                                                "example_id": "545c5865-d0ef-4c12-8786-a62dbe7076de",
                                                "sense_id": "8c290ebe-a8bb-368c-aac9-315c6ad52657",
                                                "text": "In zijn jeugd had hij zich op een middag een paar uur in een naburig dorp gewaagd en gemerkt dat zijn mensenhaat extreme proporties aannam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f439e4f-bd27-46f0-8b5e-379f9281101d",
                        "source_entry_id": "e06bd508-eb3e-3faa-95f5-2735485b724c",
                        "source_sense_id": "8ec7af9f-c48c-3f41-b7b8-a268bb02445b",
                        "source_sense_description": "negative view of people or mankind",
                        "target_lang_word": "misanthropie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misanthropie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c8ff165-60b0-3c38-bee4-1b03c85209a4",
                                        "entry_id": "045735c9-3fce-3995-b8af-c1727782f7fd",
                                        "glosses": [
                                            "Sentiment, caractère de celui qui éprouve de l’hostilité, voire de la haine envers le genre humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368f74a6-067f-4cae-b5a9-295210f1c530",
                                                "sense_id": "9c8ff165-60b0-3c38-bee4-1b03c85209a4",
                                                "text": "Tantôt, elle composait les baumes, elle inventait les recherches, les musiques, les mille moyens par lesquels elle aurait calmé la féroce misanthropie de Jean-Jacques."
                                            },
                                            {
                                                "example_id": "c24f1534-f057-42a7-a28f-7f8527e8b734",
                                                "sense_id": "9c8ff165-60b0-3c38-bee4-1b03c85209a4",
                                                "text": "M. Earnshaw ne répondit pas. Il marchait de long en large avec ses mains dans ses poches, paraissant avoir complètement oublié ma présence ; il semblait si profondément absorbé, et son aspect général dénotait tant de misanthropie que je ne pus me décider à le déranger de nouveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1ee7c93-12c3-4bd2-9cfc-068f9670d9ff",
                        "source_entry_id": "e06bd508-eb3e-3faa-95f5-2735485b724c",
                        "source_sense_id": "8ec7af9f-c48c-3f41-b7b8-a268bb02445b",
                        "source_sense_description": "negative view of people or mankind",
                        "target_lang_word": "Menschenhass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf2461e6-c31c-436a-8ac9-549956215059",
                        "source_entry_id": "e06bd508-eb3e-3faa-95f5-2735485b724c",
                        "source_sense_id": "8ec7af9f-c48c-3f41-b7b8-a268bb02445b",
                        "source_sense_description": "negative view of people or mankind",
                        "target_lang_word": "Menschenfeindlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenfeindlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                        "entry_id": "8813cc5a-df71-39b3-a820-d18523117cdd",
                                        "glosses": [
                                            "Abneigung, Hass, Gegnerschaft gegenüber Personen oder Gruppen, die meist einer sozialen, religiösen oder ethnischen Minderheit angehören"
                                        ],
                                        "tags": [
                                            "Soziologie",
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35ca3d68-f475-49e9-ad0d-64d60bb4ddc1",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "„In Deutschland gibt es viele Demonstrationen gegen Rechtsextremismus und Menschenfeindlichkeit - nicht nur in Großstädten wie Berlin.“"
                                            },
                                            {
                                                "example_id": "7b305ad1-3596-4021-8903-10070ca5bcf8",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "[Tag des Gedenkens an die Opfer des Nationalsozialismus - 27. Januar:] „Zudem dient der Gedenktag, um auf aktuelle Tendenzen von Antisemitismus, Fremdenfeindlichkeit und Menschenfeindlichkeit aufmerksam zu machen.“"
                                            },
                                            {
                                                "example_id": "f99bcd37-8ed1-42c0-8cf4-98adae4aed48",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "„Die gruppenbezogene Menschenfeindlichkeit verschwindet nicht von allein wieder.“"
                                            },
                                            {
                                                "example_id": "8aebee79-923b-4e70-b37f-5a9a562e2171",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "„Eine Vielzahl empirischer Studien zeigt, dass Personen, die sich herabgesetzt fühlen, vermehrt zu gruppenbezogener Menschenfeindlichkeit neigen. 72 Prozent der Menschen, die ihre eigene Gruppe als kollektiv benachteiligt ansehen, neigen zu fremdenfeindlichen Aussagen.“"
                                            },
                                            {
                                                "example_id": "d777a46f-c7dc-4325-a5f1-89af2c7713a9",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "„»Wir haben in unseren Untersuchungen zwischen 2002 und 2012 immer wieder festgestellt: Die gruppenbezogene Menschenfeindlichkeit ist in Kleinstädten immer höher als in größeren Städten.«“"
                                            },
                                            {
                                                "example_id": "b400493a-548f-46e8-8eca-ec6a8d307fbb",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "„IKG-Präsidentin Charlotte Knobloch wurde mit dem Bayerischen Verfassungsorden ausgezeichnet“ – […] „Sie wurde damit für ihr Lebenswerk und insbesondere für ihren Einsatz für Versöhnung und gegen Menschenfeindlichkeit gewürdigt.“"
                                            },
                                            {
                                                "example_id": "f4175d79-7845-4d83-a111-a171a1d2e7aa",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "[Omas gegen rechts:] „Für die 70-Jährige ist das Engagement gegen Nazis, Menschenfeindlichkeit und Antisemitismus derzeit ein Fulltime-Job.“"
                                            },
                                            {
                                                "example_id": "d05422f1-ecde-424e-aa95-2d2744528038",
                                                "sense_id": "472acc83-f00e-357c-bf56-845494c14c76",
                                                "text": "„Dennoch hatte der alte Sonderling, bei all' seiner Menschenfeindlichkeit, nicht vergessen, daß er einen einzigen Bruder, und dieser Bruder ein einziges Kind hatte,“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75c89fe6-8f81-326d-8791-7ee1be895249",
                                        "entry_id": "8813cc5a-df71-39b3-a820-d18523117cdd",
                                        "glosses": [
                                            "Haltung/Einstellung einer einzelnen Person, die von Verbitterung und/oder Enttäuschung gekennzeichnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880fdb07-2bdd-4fd5-9e64-abcd2c81cfda",
                                                "sense_id": "75c89fe6-8f81-326d-8791-7ee1be895249",
                                                "text": "„Ob er immer ein Menschenfeind gewesen sei? Was ihn dazu brachte, ein Menschenfeind zu werden? Ob es keine Mittel gäbe, ihn von seiner Menschenfeindlichkeit abzubringen?“"
                                            },
                                            {
                                                "example_id": "0588245d-3d58-42cd-a1b1-9af59ab5d66b",
                                                "sense_id": "75c89fe6-8f81-326d-8791-7ee1be895249",
                                                "text": "„Sie geriet in jenes Stadium von Menschenfeindlichkeit, das sich aller kleinen Geister bemächtigt, sobald sie Ursache zu haben glauben, sich über andre zu beklagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b6807e0-e5ed-4fd9-ab66-0df91a86b912",
                        "source_entry_id": "e06bd508-eb3e-3faa-95f5-2735485b724c",
                        "source_sense_id": "8ec7af9f-c48c-3f41-b7b8-a268bb02445b",
                        "source_sense_description": "negative view of people or mankind",
                        "target_lang_word": "Misanthropie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Misanthropie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5c0b02-8e38-30d2-91ff-9bebf805ba2b",
                                        "entry_id": "6a8cf6e1-cbdb-37ae-adbf-d7e5a8a19e3c",
                                        "glosses": [
                                            "bestimmendes Merkmal von Misanthropen und Misanthropinnen; unspezifischer Hass auf Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba02d44-5cf2-40a7-8316-6eea65f54818",
                                                "sense_id": "fc5c0b02-8e38-30d2-91ff-9bebf805ba2b",
                                                "text": "„Das Nichtvorhandensein von Misanthropie bedeutet keineswegs Philanthropie.“"
                                            },
                                            {
                                                "example_id": "fc5c6e43-22f7-4f4b-92a2-fd1a22e26186",
                                                "sense_id": "fc5c0b02-8e38-30d2-91ff-9bebf805ba2b",
                                                "text": "„Seine Misanthropie war zunächst Versuch, der über ihm zusammenschlagenden Welle von Verachtung die Handlungsmacht zu entreissen.“"
                                            },
                                            {
                                                "example_id": "8030f318-7eb4-439c-b6e8-e3c0eb44720b",
                                                "sense_id": "fc5c0b02-8e38-30d2-91ff-9bebf805ba2b",
                                                "text": "„Die positive Würdigung der ersten Lebenshälfte, ihrer Poesie, ihrer Illusionen und Leidenschaften, gehört konstitutiv mit hinein in diesen Pessimismus und diese Misanthropie.“"
                                            },
                                            {
                                                "example_id": "737d7204-4c20-4aa2-b34e-5a647ae1d275",
                                                "sense_id": "fc5c0b02-8e38-30d2-91ff-9bebf805ba2b",
                                                "text": "„Das Wort Misanthrop scheine, so schrieb er, buchstäblich genommen einen Hass auf die gesamte Menschheit zu implizieren. Eine solche Misanthropie à la lettre sei tatsächlich verächtlich, komme aber in der Realität kaum vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
