                                "target_senses": [
                                    {
                                        "sense_id": "8a616411-1166-38e9-9632-43fcd1b1f0bf",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "A state of balance, equilibrium or stability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c05f9a-7c76-422a-bdc8-398d70f3d5b4",
                                                "sense_id": "8a616411-1166-38e9-9632-43fcd1b1f0bf",
                                                "text": "plants and animals, which are all made up of and nourished by water, and perhaps never return to water again, do not keep things at a poise"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "054110f3-2afe-35cf-8c4d-59029ffe0dad",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "Composure; freedom from embarrassment or affectation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b71ff29-d4c8-383c-80b9-84c500f72d93",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "Mien; bearing or deportment of the head or body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47d19479-80d8-338d-a094-1a5f2d78f15d",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "A condition of hovering, or being suspended."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "874d3840-03e2-396d-aaad-1e363b0aead5",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "A CGS unit of dynamic viscosity equal to one dyne-second per square centimetre."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6baee246-c024-4f78-b9b3-9ea0fcb2471b",
                                                "sense_id": "874d3840-03e2-396d-aaad-1e363b0aead5",
                                                "text": "Letterpress and offset gloss varnishes normally have viscosities varying from 50 to 250 poises; they must stain the paper as little as possible, have insufficient tack to cause plucking, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1eb6661-0a4e-3343-8999-52ea8ae7aae4",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "Weight; an amount of weight, the amount something weighs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c6f7e1c-aa31-4794-b9d3-f2d2d9e08d47",
                                                "sense_id": "e1eb6661-0a4e-3343-8999-52ea8ae7aae4",
                                                "text": "as an huge rockie clift, / Whose false foundation waues haue washt away, / With dreadfull poyse is from the mayneland rift, / […] So downe he fell […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45741ad2-708f-3057-b441-bc2acb8381dd",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "The weight, or mass of metal, used in weighing, to balance the substance weighed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2913307e-d11c-3eaf-a81d-67596b0df63b",
                                        "entry_id": "65c70a63-ccf0-3fee-b2d4-ab8f260891eb",
                                        "glosses": [
                                            "That which causes a balance; a counterweight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026a9b71-baed-40f9-9836-24ecd772d1dd",
                                                "sense_id": "2913307e-d11c-3eaf-a81d-67596b0df63b",
                                                "text": "As for Hyperboles, I will neither quote Lucan, nor Statius, Men of an unbounded imagination, but who often wanted the Poyze of Judgement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6490d3-dd25-38fe-ae1e-75dbd4484866",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To hang in equilibrium; to be balanced or suspended; hence, to be in suspense or doubt."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11a26fe-aef0-4f5e-b37e-e2ba30ae5180",
                                                "sense_id": "6f6490d3-dd25-38fe-ae1e-75dbd4484866",
                                                "text": "The slender, graceful spars / Poise aloft in the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d942903c-0ed0-3d2f-8536-4b73d58d78eb",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To counterpoise; to counterbalance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0c7480-2436-4100-9b16-c8c07ebe2875",
                                                "sense_id": "d942903c-0ed0-3d2f-8536-4b73d58d78eb",
                                                "text": "one scale of reason to poise another of sensuality"
                                            },
                                            {
                                                "example_id": "977290d6-2e37-49ee-9c44-310f2b5ff60f",
                                                "sense_id": "d942903c-0ed0-3d2f-8536-4b73d58d78eb",
                                                "text": "1699, John Dryden, Epistle to John Dryden\nto poise with solid sense a sprightly wit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79958d15-9cf1-3a2d-98c9-905cc7d88ddf",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To be of a given weight; to weigh."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "296d5aa3-b555-3be3-93a2-00aa0041b0ed",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To add weight to, to weigh down."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e7726c7-9422-404d-a353-be1e000b075b",
                                                "sense_id": "296d5aa3-b555-3be3-93a2-00aa0041b0ed",
                                                "text": "Every man poiseth [translating poise] upon his fellowes sinne, and elevates his owne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cac8aa33-3c33-3aec-af32-b9397784c2a5",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To hold (something) with or against something else in equilibrium; to balance, counterpose."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da1d2c23-baf3-4224-9231-0b3059933038",
                                                "sense_id": "cac8aa33-3c33-3aec-af32-b9397784c2a5",
                                                "text": "you saw her faire none els being by, / Her selfe poysd with her selfe in either eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e398d72e-f750-33f5-8f50-b576343c89ea",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To hold (something) in equilibrium, to hold balanced and ready; to carry (something) ready to be used."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c414db-3ebf-4eb6-8ccc-1049eca06bba",
                                                "sense_id": "e398d72e-f750-33f5-8f50-b576343c89ea",
                                                "text": "I poised the crowbar in my hand, and waited."
                                            },
                                            {
                                                "example_id": "324a7955-a391-443b-9313-05f1337fffdb",
                                                "sense_id": "e398d72e-f750-33f5-8f50-b576343c89ea",
                                                "text": "to poise the scales of a balance"
                                            },
                                            {
                                                "example_id": "0f616985-4455-46f0-88f6-442fd682e7c4",
                                                "sense_id": "e398d72e-f750-33f5-8f50-b576343c89ea",
                                                "text": "Nor yet was earth suspended in the sky; / Nor poised, did on her own foundation lie."
                                            },
                                            {
                                                "example_id": "99cd9c81-904f-401c-95bd-2c386c921ac7",
                                                "sense_id": "e398d72e-f750-33f5-8f50-b576343c89ea",
                                                "text": "The intention to close [Yeovil] Pen Mill was therefore abandoned and instead the economy axe was re-poised over Yeovil Junction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f75c15-4b99-3b4f-950b-d4f1a5923a86",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To keep (something) in equilibrium; to hold suspended or balanced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d578e4ba-5d89-4e5c-87f7-efd86c3a6698",
                                                "sense_id": "e5f75c15-4b99-3b4f-950b-d4f1a5923a86",
                                                "text": "The rock was poised precariously on the edge of the cliff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1318a1f9-b70d-3af5-9f26-59e32c83d334",
                                        "entry_id": "f43b92d8-a89a-3ddd-ac16-372fdb2b2939",
                                        "glosses": [
                                            "To ascertain, as if by balancing; to weigh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99447c69-4547-4a27-babf-8b501aba6131",
                                                "sense_id": "1318a1f9-b70d-3af5-9f26-59e32c83d334",
                                                "text": "He cannot sincerely consider the strength, poise the weight, and discern the evidence."
                                            }
                                        ]
                                    }
                                ]
                            },
