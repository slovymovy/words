                    {
                        "sense_id": "9139b463-dad5-3401-a573-b21a399e8fa3",
                        "entry_id": "0161f969-6a7a-3ab1-beb0-c05e8610b959",
                        "glosses": [
                            "Homme ou garçon qui ne pense qu’au travail (se dit surtout d’un élève ou d’un étudiant)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ee87313d-7003-4cb3-b254-19fe6e842f33",
                                "sense_id": "9139b463-dad5-3401-a573-b21a399e8fa3",
                                "text": "C’est un polard, pas un marrant."
                            },
                            {
                                "example_id": "faae8a07-a572-43cb-8493-604f13f74a6b",
                                "sense_id": "9139b463-dad5-3401-a573-b21a399e8fa3",
                                "text": "Je bullais pour la classe, à me faire engueuler par ce polard-dandy de Kader."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8085cf0b-e766-494a-95b0-729a29997b6a",
                        "source_entry_id": "0161f969-6a7a-3ab1-beb0-c05e8610b959",
                        "source_sense_id": "9139b463-dad5-3401-a573-b21a399e8fa3",
                        "target_lang_word": "Arbeitstier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitstier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d83316ca-97d0-3a25-bc5a-148cb57f1804",
                                        "entry_id": "9d82d2d7-02b7-3971-a5d3-f40972955938",
                                        "glosses": [
                                            "Nutztier, das für bestimmte Arbeiten eingesetzt wird, besonders zum Ziehen oder Transport von Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4777394-0f4c-45f2-81aa-59afe51a9e3b",
                                                "sense_id": "d83316ca-97d0-3a25-bc5a-148cb57f1804",
                                                "text": "„In Thailand leben rund 2000 als Arbeitstiere ausgebildete Elefanten. Früher wurden viele in der Forstwirtschaft eingesetzt, um schwere Lasten zu ziehen. Seit das Abholzen verboten ist, sind viele Elefanten ‚arbeitslos‘.“"
                                            },
                                            {
                                                "example_id": "6012603a-b877-401c-ac7a-1fdac6492f9a",
                                                "sense_id": "d83316ca-97d0-3a25-bc5a-148cb57f1804",
                                                "text": "„Für die Spanier waren wir nichts als eine Kriegsbeute, die man wie Arbeitstiere behandelte und schuften ließ, bis sie zusammenbrachen.“"
                                            },
                                            {
                                                "example_id": "9cd600a4-d946-424b-873c-84170f88793c",
                                                "sense_id": "d83316ca-97d0-3a25-bc5a-148cb57f1804",
                                                "text": "„Elefanten waren in Asien vermutlich schon lange als Arbeitstiere in Gebrauch.“"
                                            },
                                            {
                                                "example_id": "eeab86b9-7ed7-48e4-a509-0ab4c0680589",
                                                "sense_id": "d83316ca-97d0-3a25-bc5a-148cb57f1804",
                                                "text": "„Pferde waren in Ostpreußen immer mehr gewesen als reine Arbeitstiere oder Fortbewegungsmittel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d535480d-be18-3cb8-ad4c-86c8c257825e",
                                        "entry_id": "9d82d2d7-02b7-3971-a5d3-f40972955938",
                                        "glosses": [
                                            "jemand, der unermüdlich und schwer arbeitet, bei dem Arbeiten eine vorrangige Stelle im Leben einnimmt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "684dc9b9-7671-4acd-9dcb-d55b705cf976",
                                                "sense_id": "d535480d-be18-3cb8-ad4c-86c8c257825e",
                                                "text": "„Der beste Manager ist weder der Löwe, der am lautesten brüllt, noch das Arbeitstier, das am längsten schuftet – es ist der, der auf lange Sicht die besten Ergebnisse erzielt.“"
                                            },
                                            {
                                                "example_id": "b2692b5f-8c37-4c02-bb31-9aa4a495ee20",
                                                "sense_id": "d535480d-be18-3cb8-ad4c-86c8c257825e",
                                                "text": "„Er erklärte ihm, dass sich ein neuer und hungriger Stand von Arbeitstieren in den gebratenen europäischen Speck verbissen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
