                                "example_id": "4aed7b24-37f0-4de0-b2ee-1682cbebc053",
                                "sense_id": "bad86c33-2120-3242-aacb-5885b06f313c",
                                "text": "Prävention der Mutter-Kind-Übertragung (PMTCT) ist ein wichtiger Teil der Bemühungen um HIV zu kontrollieren."
                            },
                            {
                                "example_id": "eb07f7ae-e8e2-44a9-ab8d-ac03f1010fdd",
                                "sense_id": "bad86c33-2120-3242-aacb-5885b06f313c",
                                "text": "PMTCT Dienstleistungen werden meist im öffentlichen Sektor staatlicher Krankenhäuser in Indien zur Verfügung gestellt."
                            },
                            {
                                "example_id": "09eb2aa1-80ee-4857-9cfc-7fcc81ff4481",
                                "sense_id": "bad86c33-2120-3242-aacb-5885b06f313c",
                                "text": "Fast 30% der schwangeren Frauen in Südafrika sind schätzungsweise HIV seropositiv, doch die Einhaltung von Leitlinien für die Prävention der Mutter-zu-Kind-Übertragung von HIV (PMTCT) ist oft gering."
                            }
                        ],
