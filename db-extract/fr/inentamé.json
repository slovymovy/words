                "senses": [
                    {
                        "sense_id": "33508509-7fd7-331a-880c-def1e3b7ebb5",
                        "entry_id": "e738b5d6-4be3-399a-bf1e-04607a248806",
                        "glosses": [
                            "Qui n’est pas entamé ; qui est entier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e94ca5ac-8c18-456c-982d-58661a2f173d",
                                "sense_id": "33508509-7fd7-331a-880c-def1e3b7ebb5",
                                "text": "Une pellicule de neige inentamée recouvrait la plaine horizontale ; le soleil brillait vaillamment, gaiement presque, sur la Beauce endormie."
                            },
                            {
                                "example_id": "98babd09-a0a7-4530-adac-e2ebb40e2756",
                                "sense_id": "33508509-7fd7-331a-880c-def1e3b7ebb5",
                                "text": "Il s’avance de nouveau au tout premier plan et se rasseoit^([sic]) devant l’assiette qui contient son repas inentamé."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc1ecea3-fd6f-35eb-99c0-371244786be1",
                        "entry_id": "e738b5d6-4be3-399a-bf1e-04607a248806",
                        "glosses": [
                            "Qui est intact ; qui n’a pas évolué."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0961ac38-9b4d-48dc-8587-4a0054ddf8ff",
                                "sense_id": "bc1ecea3-fd6f-35eb-99c0-371244786be1",
                                "text": "Qu’est-ce qui fait exploser la marmite ? Il y a le fait, d’abord, que ce développement ne laisse pas inentamée la béatitude du colon. Le colon qui connaît les indigènes s’aperçoit à plusieurs indices que quelque chose est en train de changer."
                            },
                            {
                                "example_id": "c970b032-8717-4c65-b977-d6d355353bae",
                                "sense_id": "bc1ecea3-fd6f-35eb-99c0-371244786be1",
                                "text": "Chacun se contentait de savoir que l’autre savait, et cette muette complicité gardait à leurs échanges une émotion inentamée."
                            },
                            {
                                "example_id": "0e2fdeb1-6e0e-4cdc-8c68-82460b74a9b6",
                                "sense_id": "bc1ecea3-fd6f-35eb-99c0-371244786be1",
                                "text": "Toni Morrison est morte dans la nuit du lundi 5 au mardi 6 août, à l’âge de 88 ans, avec un sentiment de révolte inentamé."
                            }
                        ]
                    }
