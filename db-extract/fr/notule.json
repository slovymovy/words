                        "examples": [
                            {
                                "example_id": "a2672485-d1b0-4e0d-b8e8-e05ad895a869",
                                "sense_id": "9498f789-0df4-3272-92a4-bf4dcb570cf9",
                                "text": "Cette notule m’a donné envie d’en savoir plus."
                            },
                            {
                                "example_id": "3f5d38bd-5f8c-4004-aa9c-723e4fe5b3d1",
                                "sense_id": "9498f789-0df4-3272-92a4-bf4dcb570cf9",
                                "text": "\"Il y avait une petite notule, à la fin, qui présentait brièvement sa carrière, le type même du sculpteur académique dont les réalisations rassurent ceux que la proximité avec un artiste pourrait inquiéter.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "f95162bb-7cc7-3006-b76e-18fe32cf5a8e",
                        "entry_id": "f3924e25-5f73-3548-8994-8d3b262b7a63",
                        "glosses": [
                            "Synonyme de minute d'acte."
