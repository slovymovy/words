                        "sense_id": "ec87f22c-4b6c-3540-a43f-58e877c9fd24",
                        "entry_id": "211244f3-be12-3312-a452-b98fe98bc23c",
                        "glosses": [
                            "Covered with verdure; green and lush; verdant."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c2896bb7-1049-4de1-aa63-ffe8b1e09afb",
                                "sense_id": "ec87f22c-4b6c-3540-a43f-58e877c9fd24",
                                "text": "About midway in the short vista which my dreamy vision took in, one small circular island, profusely verdured, reposed upon the bosom of the stream."
                            },
                            {
                                "example_id": "c8ee017c-c40f-4234-9cee-7607e5842c69",
                                "sense_id": "ec87f22c-4b6c-3540-a43f-58e877c9fd24",
                                "text": "After a time, fully two miles away, he saw sheep grazing on a thinly verdured slide."
                            }
                        ]
                    }
                ],
