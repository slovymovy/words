                    "sense_definition": "Caractère distinctif, charme ou élégance qui donne du style ou de la valeur à quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces magnifiques poutres en bois donnent beaucoup de <w>cachet</w> à ce salon ancien."
                        },
                        {
                            "text": "Cette maison rénovée a su conserver tout le <w>cachet</w> de son époque d'origine."
                        }
                    ],
                    "common_phrases": [
                        "avoir du cachet",
                        "donner du cachet"
                    ]
                },
                {
                    "sense_id": "115683df-7e34-3f60-b7b7-6984a03d9c0c",
                    "sense_definition": "Rémunération forfaitaire versée à un artiste pour une prestation ou un spectacle déterminé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remuneration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune comédien touche un <w>cachet</w> pour chaque représentation théâtrale à Paris."
                        },
                        {
                            "text": "Les musiciens ont négocié leur <w>cachet</w> avant de signer le contrat du festival."
                        }
                    ],
                    "common_phrases": [
