                ],
                "senses": [
                    {
                        "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                        "entry_id": "04b5b548-6dce-30cd-8bfd-d1e69f4a2c22",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f6d598-410d-4183-ac65-de6a01fd3d17",
                                "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                                "text": "Frau Freiling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cfd58047-b7c9-416b-9c9e-0269e8265c1e",
                                "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                                "text": "Herr Freiling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c48deb5d-af60-416f-ba96-7e457a27ef22",
                                "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                                "text": "Die Freilings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c3cdd507-437f-46cc-af09-e32dbff6c4d9",
                                "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                                "text": "Der Freiling trägt nie die Schals, die die Freiling ihm strickt."
                            },
                            {
                                "example_id": "9699e553-00de-47d9-a638-a47e17e32e98",
                                "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Freiling kommt, geht der Herr Freiling.“"
                            },
                            {
                                "example_id": "1de02899-d35f-494f-9210-1c6d86117029",
                                "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                                "text": "Freiling kommt und geht."
                            },
                            {
                                "example_id": "6fb4d027-b7ca-4623-aa7e-013d123564f8",
                                "sense_id": "da1d2c1c-3c72-3d9e-9583-70dc8b66f8a8",
                                "text": "Freilings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
