                        "examples": [
                            {
                                "example_id": "a232dcbc-cddb-4534-a2e0-ff475f9415db",
                                "sense_id": "05a08a21-20b4-30e7-af96-eb3bd325a8dd",
                                "text": "О Государь! Мы здесь приносим жертвы Богу, а за алтарём льётся невинная кровь Христианская. Отколе солнце сияет на небе, не видано, не слыхано, чтобы Цари благочестивые возмущали собственную Державу столь ужасно!"
                            }
                        ]
                    },
                    {
                        "sense_id": "92e10cff-b86a-38bc-bb45-7dfe1cff7bb3",
                        "entry_id": "f263c553-a282-36b7-9f59-0c443af00e1f",
                        "glosses": [
                            "устар. откуда"
                        ],
