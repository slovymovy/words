                        "glosses": [
                            "A ring surrounding a bugle or hunting horn."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14d5a94-d37f-400c-876a-d4f3da45cd3c",
                                "sense_id": "9bb10dd1-4f8c-3e4b-b33c-d1ef69a0c448",
                                "text": "[…] except when he has a hood, bells, virols, or rings, and leashes, in which case he is said to be hooded, belled, jessed, and leashed; […]"
                            },
                            {
                                "example_id": "13eb745b-4950-406f-ab03-2fbf9cc1301a",
                                "sense_id": "9bb10dd1-4f8c-3e4b-b33c-d1ef69a0c448",
                                "text": "The Florentine GUICCIARDINI bore : Azure, three hunting-horns argent, the mouth-pieces and viroles or, banded gules. Gules, three trumpets fessways in pale argent, is the canting coat of CALL (Baronets)."
                            },
                            {
                                "example_id": "9daf0e16-bb5e-4ca2-87c7-1a3d672dcf01",
                                "sense_id": "9bb10dd1-4f8c-3e4b-b33c-d1ef69a0c448",
                                "text": "Viroled- (vi-rold') Furnished with a virole or viroles. Said of a bugle or horn when borne with rings of a different tincture from the bugle itself."
                            }
                        ]
                    }
