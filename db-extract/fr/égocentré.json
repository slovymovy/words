                        "entry_id": "576f1e95-ccf3-37e1-a05a-604f09d3c805",
                        "glosses": [
                            "Qui fait preuve d'égocentrisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbcf5e16-4e7b-41d1-a2a9-4f67e209d20e",
                                "sense_id": "7539cbeb-efdf-3a6a-8c72-60f840ab5c3f",
                                "text": "La dynamique zen permet de quitter le soi égocentré pour entrer dans la dimension de l'éveil bouddhique."
                            },
                            {
                                "example_id": "26c2a23b-9007-4fce-ab14-6f27da1f0160",
                                "sense_id": "7539cbeb-efdf-3a6a-8c72-60f840ab5c3f",
                                "text": "Le théâtre a été un miracle. Je souffrais de cette anxiété très grande qui faisait que je prenais beaucoup trop de place, que j’étais égocentré et incroyablement narcissique."
                            }
                        ]
                    }
