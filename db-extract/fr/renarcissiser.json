                ],
                "senses": [
                    {
                        "sense_id": "e535cdbc-732a-3753-95f5-05e463ecf26f",
                        "entry_id": "ba902027-d380-3538-8c68-7881e191f727",
                        "glosses": [
                            "Rendre narcissique à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa3771f-32f5-4222-b64e-01de203af5c2",
                                "sense_id": "e535cdbc-732a-3753-95f5-05e463ecf26f",
                                "text": "C’est finalement la satisfaction de travailler, en quelque sorte « dans l’ombre », ce qui permet aux parents de se renarcissiser avec des problèmes réglés, comme si les solutions étaient venues d’eux."
                            },
                            {
                                "example_id": "f803500e-d9ab-4cd3-8d20-8371e681b30e",
                                "sense_id": "e535cdbc-732a-3753-95f5-05e463ecf26f",
                                "text": "Dans son lieu thérapeutique, Elisa peut écouter et entendre cet appel intérieur, identifier la blessure, reconnaître cette part d’elle et la « renarcissiser »."
                            },
                            {
                                "example_id": "a7512676-f1fc-4be4-aed9-9d3cb05d0f08",
                                "sense_id": "e535cdbc-732a-3753-95f5-05e463ecf26f",
                                "text": "Cette sorte de parc d’attractions pour adultes est idéal pour rencontrer quantité de garçons (et de filles, manifestement), passer des bons moments, se renarcissiser, et baiser aussi, parce qu'on n'est pas là pour enfiler des perles."
                            }
                        ]
                    }
                ],
