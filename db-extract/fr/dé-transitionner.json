                "senses": [
                    {
                        "sense_id": "364d3c98-7545-3265-b6f3-23d085446dc3",
                        "entry_id": "f1ac59db-78e1-3716-82f2-c19e209b233a",
                        "glosses": [
                            "Variante orthographique de détransitionner."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "b5cbe949-9458-4f17-997b-b7119aeb5e96",
                                "sense_id": "364d3c98-7545-3265-b6f3-23d085446dc3",
                                "text": "Les parents d’enfants qui veulent transitionner ou dé-transitionner s’organisent."
                            },
                            {
                                "example_id": "3ffc795c-83a9-4c35-822b-7c8b27b4b32c",
                                "sense_id": "364d3c98-7545-3265-b6f3-23d085446dc3",
                                "text": "En France, très rares seraient celles et ceux qui veulent dé-transitionner, c’est-à-dire revenir en arrière."
                            },
                            {
                                "example_id": "b868730d-ec42-42ac-b023-f1286dfbe0a5",
                                "sense_id": "364d3c98-7545-3265-b6f3-23d085446dc3",
                                "text": "Ainsi, en février 2021, elle a décidé de «dé-transitionner» et d’arrêter complètement la thérapie à la testostérone."
                            }
                        ]
                    }
