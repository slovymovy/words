                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d8bb135b-c633-3ac0-92f3-3b4aaa37f853",
                        "entry_id": "9b25c871-a912-334a-a14b-7de588656f1d",
                        "glosses": [
                            "Déranger ; faire perdre l'habitude ; faire sortir de la routine."
                        ],
                        "tags": [
                            "Picardie"
                        ],
                        "examples": [
                            {
                                "example_id": "5295d384-e32f-4c96-8b29-136d8e522e10",
                                "sense_id": "d8bb135b-c633-3ac0-92f3-3b4aaa37f853",
                                "text": "Rien n'y a fait; rien n'a pu déroutiner nos régiments."
                            },
                            {
                                "example_id": "eba7c0c3-4b2e-4681-ae38-58149a3f1f89",
                                "sense_id": "d8bb135b-c633-3ac0-92f3-3b4aaa37f853",
                                "text": "Il exprime à son ancien maïtre, Monsieur Gabriel Monod, […], ses remerciements pour le libéralisme avec lequel il a accueilli dans la revue qu'il dirige un article dont la forme est moins destinée à dérouter qu'à déroutiner les lecteurs."
                            }
                        ]
                    }
