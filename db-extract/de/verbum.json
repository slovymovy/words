                ],
                "senses": [
                    {
                        "sense_id": "191cb385-4bb8-34a8-8787-97ea3cbbf1cd",
                        "entry_id": "be808d81-ed95-3738-b8b3-11a58d291a09",
                        "glosses": [
                            "Wortart, mit der eine Handlung (z.B. spielen, lachen, werfen), ein Zustand (glänzen, sich auflösen) oder ein Geschehen (regnen, schneien) ausgedrückt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4719bd-bd54-485a-82eb-6681340c89dc",
                                "sense_id": "191cb385-4bb8-34a8-8787-97ea3cbbf1cd",
                                "text": "„Es ist ein Unglück, daß wir im Deutschen Verbum mit Zeitwort übersetzt haben. Tatwort müßte es heißen, denn es gibt die Tat, die Handlung, das Ereignis wieder.“"
                            },
                            {
                                "example_id": "2a2c17c7-dbaf-4a36-8c66-0ea168b3e5ca",
                                "sense_id": "191cb385-4bb8-34a8-8787-97ea3cbbf1cd",
                                "text": "„Die Merkmale, nach denen Hauptwort (Substantiv), Eigenschaftswort (Adjektiv), Fürwort (Pronomen), Zahlwort (Numerale), Tätigkeits- oder Zeitwort (Verbum), Umstandswort (Adverbium), Verhältniswort (Präposition) und Bindewort (Konjunktion) unterschieden werden, sind teils solche der Form, teils solche der Leistung.“"
                            },
                            {
                                "example_id": "fabbe39e-4019-4d4e-b6de-da5d2b402637",
                                "sense_id": "191cb385-4bb8-34a8-8787-97ea3cbbf1cd",
                                "text": "„Das Subjekt stimmt stets mit dem Verbum überein, bis auf diejenigen Fälle, in denen es nicht mit ihm übereinstimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
