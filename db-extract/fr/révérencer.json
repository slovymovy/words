                "senses": [
                    {
                        "sense_id": "17df158d-5aa4-32b9-8751-14513ab83315",
                        "entry_id": "5d2deceb-5d58-3420-8947-3706457627c3",
                        "glosses": [
                            "Faire la révérence à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b6758e7-c073-49f8-aac9-1ab8bdba60fd",
                                "sense_id": "17df158d-5aa4-32b9-8751-14513ab83315",
                                "text": "Oh ! que j’en avais, mon Dieu, de ces oncles et de ces cousines à révérencer ; cela dura plus d’une heure et demie."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ce41291-da7c-3c7a-a860-ea71cb3cf744",
                        "entry_id": "5d2deceb-5d58-3420-8947-3706457627c3",
                        "glosses": [
                            "Révérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "078c6058-efd0-47dc-9893-9f3ec178c54e",
                                "sense_id": "0ce41291-da7c-3c7a-a860-ea71cb3cf744",
                                "text": "Je promets de révérencer la Grande Déesse car elle Est la Grande Mère qui créa tout dans l’univers. Je promets de révérencer le Dieu car il Est le consort et le co-créateur."
                            }
                        ]
                    }
