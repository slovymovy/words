                        "examples": [
                            {
                                "example_id": "da321fab-c4cc-49b5-a900-d397a51fad25",
                                "sense_id": "68e7799b-7efe-3947-b597-65c5b41cec9a",
                                "text": "„Und chinesische Plantagenbesitzer sollen ihre Citrusbäume vor dem Kahlfraß bewahrt haben, indem sie Ameisen mit Bambusstangen den Weg von Baum zu Baum erleichterten.“"
                            },
                            {
                                "example_id": "f8af45f2-f4ad-4dc8-9cb1-8c27b4e4f31a",
                                "sense_id": "68e7799b-7efe-3947-b597-65c5b41cec9a",
                                "text": "„Er baute ein Dach aus Bambusstangen, und das bedeckten sie mit einem Laken.“"
                            }
                        ],
