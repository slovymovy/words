                "senses": [
                    {
                        "sense_id": "e3555154-257b-3dad-9b15-6b691b62b176",
                        "entry_id": "634cbd3b-be1e-3ef6-8f7f-e7862056d896",
                        "glosses": [
                            "häufig genutzter, bedeutender Seeweg/Wasserweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6121e2-ae05-456a-a569-2b845c8cf7ee",
                                "sense_id": "e3555154-257b-3dad-9b15-6b691b62b176",
                                "text": "Diese Zeichen zeigen an, daß das Gewässer, auf dem sich die Wasserfahrzeuge oder Flöße befinden, eine Nebenschifffahrtsstraße ist, die in der Folge in eine Hauptschifffahrtsstraße mündet."
                            },
                            {
                                "example_id": "654432dc-48b0-404e-aa48-47eb45e9d6f5",
                                "sense_id": "e3555154-257b-3dad-9b15-6b691b62b176",
                                "text": "„Wenn du draußen auf dem Meer allein bist, dann kannst du nachts nicht stundenlang schlafen, vor allem nicht auf den Hauptschifffahrtsstraßen. Du könntest von einem Frachter überrollt werden, ohne dass er es überhaupt merkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
