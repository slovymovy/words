                                        "sense_id": "0d1ec66b-fa80-3525-959a-a60b049bac05",
                                        "entry_id": "6d9f84f1-e3dd-3d5c-b3f9-45a6fd2d57b6",
                                        "glosses": [
                                            "starr und wenig individuell und damit oft ungerecht durch eine Bürokratie verwalten"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdfa3e90-3ae7-4fe7-9bda-c4e37af01d4f",
                                                "sense_id": "0d1ec66b-fa80-3525-959a-a60b049bac05",
                                                "text": "„Ein Verwalter oder Administrator und Bürokrat kann niemals Verantwortung übernehmen, weil administrieren, verwalten und bürokratisieren kreativfeindlich, phantasiefeindlich, emotionsfeindlich, freiraumfeindlich und unmenschlich sind.“"
                                            }
                                        ],
