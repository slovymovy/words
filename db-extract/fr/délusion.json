                ],
                "senses": [
                    {
                        "sense_id": "0f814478-d0a6-39fc-9a82-e2e1e6fdf087",
                        "entry_id": "1c50f578-3cd2-37e0-93a3-72df3db0e84d",
                        "glosses": [
                            "Illusion, croyance que la confrontation avec les faits ne peut dissoudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be46499c-c4cf-421f-9c23-f1b7ca63f37e",
                                "sense_id": "0f814478-d0a6-39fc-9a82-e2e1e6fdf087",
                                "text": "A propos de la mort simulée, R. BASTIDE souligne qu'il vaut mieux parler de délusion que de simulation.# État de celui dont la croyance ne se dissout pas à la confrontation avec les faits."
                            },
                            {
                                "example_id": "a6fe846c-1ecd-4200-b238-aeb3904d93c4",
                                "sense_id": "0f814478-d0a6-39fc-9a82-e2e1e6fdf087",
                                "text": "Ce genre de fascination, dont il est souvent fait mention dans les ballades écossaises, y est appelé glamour, mot qui signifie un pouvoir magique au moyen duquel on trompe l’œil des spectateurs en leur faisant voir l'objet différent de ce qu'il est réellement... tout, dans cet art, n’est que délusion, et rien n’y est véritable."
                            }
                        ]
                    },
                    {
                        "sense_id": "777e0074-2262-3470-ac78-b0e8b35a27cb",
                        "entry_id": "1c50f578-3cd2-37e0-93a3-72df3db0e84d",
                        "glosses": [
                            "État de celui dont la croyance ne se dissout pas à la confrontation avec les faits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e69441b-7e42-4b77-9769-2fb25b49ad9b",
                                "sense_id": "777e0074-2262-3470-ac78-b0e8b35a27cb",
                                "text": "Le monde extérieur ne le prend jamais en défaut, car il échappe à la contradiction par un processus de délusion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c90cbc11-7340-44dc-9c34-e26913f899a2",
                        "source_entry_id": "1c50f578-3cd2-37e0-93a3-72df3db0e84d",
                        "target_lang_word": "delusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b65c5f67-0aad-3119-891c-416703c18f47",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "A false belief that is resistant to confrontation with actual facts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b48afde-fd00-3bab-a31a-8ebc35a3c155",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "The state of being deluded or misled, or process of deluding somebody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb910c6-d85e-452e-a554-79315d527f0b",
                                                "sense_id": "9b48afde-fd00-3bab-a31a-8ebc35a3c155",
                                                "text": "It is far better to grasp the universe as it really is than to persist in delusion, however satisfying and reassuring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "That which is falsely or delusively believed or propagated; false belief; error in belief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc44280-25f4-4eed-9fff-eb781113fa77",
                                                "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                                "text": "Hess, always a muddled man though not so doltish as Rosenberg, flew on his own to Britain under the delusion that he could arrange a peace settlement."
                                            },
                                            {
                                                "example_id": "ba01b9b7-0d6d-43e4-9140-a86db0b3ecfd",
                                                "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                                "text": "“Project Greenlight,” however, bore down on the soft underbelly of the movie business, focusing on the delusions and colossal blunders of first-time directors, seemingly selected as much for their unlovability as their talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6f4064-0880-3ecd-b9f0-70cef3bffd97",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "A fixed, false belief, that will not change, despite evidence to the contrary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
