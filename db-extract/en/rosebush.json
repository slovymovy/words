                ],
                "translations": [
                    {
                        "translation_id": "9f7d21e8-52a4-4ec5-bce7-c31b73fea79d",
                        "source_entry_id": "ef9dd8f9-b6bf-3cb5-953f-e55a6bfc8969",
                        "source_sense_id": "77673ca9-d02a-3997-9893-02c57e83820a",
