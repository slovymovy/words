                "senses": [
                    {
                        "sense_id": "3796d11d-16b8-3473-b03f-b355bee87b18",
                        "entry_id": "7156d292-aafc-36c0-9a0d-53320d85e7d2",
                        "glosses": [
                            "Gegenstand oder Mensch, der vermutlich viele Krankheitserreger verbreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30776bd6-83b5-4722-beff-aec7e5b6976e",
                                "sense_id": "3796d11d-16b8-3473-b03f-b355bee87b18",
                                "text": "„So gut sie einerseits ist, andererseits kann sie nach einiger Zeit verkeimen und dann im ungünstigen Fall zur Keimschleuder im Auto werden.“"
                            },
                            {
                                "example_id": "ac888ee0-aa33-425b-a8a6-79b488d756a9",
                                "sense_id": "3796d11d-16b8-3473-b03f-b355bee87b18",
                                "text": "„Dass Waschmaschinen manchmal Keimschleudern sind, haben inzwischen mehrere Forschergruppen unabhängig voneinander nachgewiesen.“"
                            },
                            {
                                "example_id": "d3aa55c0-5c4b-4bbc-a7bf-99bb276170fb",
                                "sense_id": "3796d11d-16b8-3473-b03f-b355bee87b18",
                                "text": "„Müssen wir uns also vor unseren Mitmenschen als Keimschleudern fürchten?“"
                            },
                            {
                                "example_id": "a0d51339-fe34-4f14-b84e-9edbfaa2d007",
                                "sense_id": "3796d11d-16b8-3473-b03f-b355bee87b18",
                                "text": "„Ist ja total die Keimschleuder da drinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
