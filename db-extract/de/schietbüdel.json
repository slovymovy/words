                "senses": [
                    {
                        "sense_id": "872e8af7-7260-3084-a31d-7472a825d775",
                        "entry_id": "0586f998-3a31-38cf-8726-8e8638f34ac7",
                        "glosses": [
                            "kleines Kind"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e777c7-c534-4fb9-9998-ccca3cc4f489",
                                "sense_id": "872e8af7-7260-3084-a31d-7472a825d775",
                                "text": "„Weil vegane Linsenbratlinge so unsexy klingen, nennt er sie Buttjes, so wie seine Oma ihn immer genannt hat. Und das wiederum klingt für einen Wrap besser als Schietbüdel, so hat Oma nämlich seinen Bruder gerufen.“"
                            },
                            {
                                "example_id": "a6c3f242-3385-472c-b9da-8424a1e303e2",
                                "sense_id": "872e8af7-7260-3084-a31d-7472a825d775",
                                "text": "„För de Lüüd, de nich weten, watn \"Schietbüdel\" is: Dat is en lütte Kind, dat man geern mag, dat man sotoseggen int Hart sloten hett. Seggen doon wi dat Woort besünners denn, wenn dat dore Kind ine Kniep is, Kummer un villicht uk noch dicke Traans ine Ogen hett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7691a0cf-843a-3f20-8870-c5b290b1b4f5",
                        "entry_id": "0586f998-3a31-38cf-8726-8e8638f34ac7",
                        "glosses": [
                            "Hundekotbeutel"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "49eead61-444c-4dec-8b3d-51789aa7255e",
                                "sense_id": "7691a0cf-843a-3f20-8870-c5b290b1b4f5",
                                "text": "„Seit der Einführung des Schietbüdels liegen deutlich weniger Tretminen auf den Fußwegen. Allerdings sehen Spaziergänger jetzt immer mehr gefüllte Kotbeutel in den Rabatten.“"
                            },
                            {
                                "example_id": "90efce53-2347-487f-992a-6d230f567ca0",
                                "sense_id": "7691a0cf-843a-3f20-8870-c5b290b1b4f5",
                                "text": "„Selbst ein Nutzer aus San Francisco dokumentiert einen Poopsack-Vorfall. „Wir sind jetzt bei 5200 Fotos“, sagt Krämer selig lächelnd. „Schietbüdel“ – die neue Menschheitsplage?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
