                                                "sense_id": "fd9265c3-0035-3225-be27-eb1a5022da36",
                                                "text": "Both Python and Haskell have a tuple data type as well as a list data type."
                                            },
                                            {
                                                "example_id": "845e6dee-12b1-4683-b470-2868cd9288c4",
                                                "sense_id": "fd9265c3-0035-3225-be27-eb1a5022da36",
                                                "text": "Unlike lists, tuples are not formed by consing."
                                            }
                                        ]
