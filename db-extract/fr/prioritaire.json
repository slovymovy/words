                    {
                        "sense_id": "34315d0f-4228-3b0f-a9fc-56f48e3b88e2",
                        "entry_id": "1d7117c3-3bce-39bd-b367-c602a2fdbfd0",
                        "glosses": [
                            "Qui possède ou octroie la préséance."
