                                        "entry_id": "aac7cd82-09fe-3f77-a108-fe26042d575c",
                                        "glosses": [
                                            "Configuración de dos astros que se encuentran, en relación con la Tierra, en dos puntos del cielo diametralmente opuestos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be95cd7-bc55-4239-96e6-864065bbc5b2",
                                                "sense_id": "4053aaf0-e827-35b7-9cbc-dea1740ef346",
                                                "text": "El sol, la tierra y la luna están en oposición."
                                            }
                                        ],
