                    {
                        "translation_id": "9af0462e-681a-4f37-b0c3-5d591e817bfd",
                        "source_entry_id": "05117fdc-3c0d-3fe8-92ec-5391432a9dc7",
                        "source_sense_description": "penis of an animal",
                        "target_lang_word": "Ochsenziemer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ochsenziemer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ea974c-b509-388c-b73e-692822d187b2",
                                        "entry_id": "b92dd8f3-0d28-307b-a07b-9dca81b64964",
                                        "glosses": [
                                            "Stock oder Peitsche zum Prügeln, hergestellt aus dem getrockneten Penis des Stiers"
                                        ],
                                        "tags": [
                                            "früher"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "750f392b-4f07-44b9-b7e3-eae0019b2b96",
                                                "sense_id": "b3ea974c-b509-388c-b73e-692822d187b2",
                                                "text": "„Dort schrieb er seine ersten Erzählungen, die von seinen Jahren in der Unterstadt handeln, von seiner Jugend ohne fließend Wasser, ohne Strom, ohne Bücher, ohne Radio, ohne Worte – in einem langen, jahrtausendealten Schweigen, das nur ab und zu von den Peitschenhieben unterbrochen wurde, die ihm die Großmutter mit dem Ochsenziemer verpasste.“"
                                            },
                                            {
                                                "example_id": "b4016041-6a61-4d2f-9694-b5c14852c0d0",
                                                "sense_id": "b3ea974c-b509-388c-b73e-692822d187b2",
                                                "text": "„Daß man mich nicht so ehrt wie andere Wohltäter, macht mir nichts aus. Auf Dank hab' ich nie gerechnet. Daß man mich aber noch schlägt mit dem Ochsenziemer – halte ich für gemein. Muß ich auch noch zum Märtyrer werden?“"
                                            },
                                            {
                                                "example_id": "b0e6556d-415f-4add-8343-f8524899c246",
                                                "sense_id": "b3ea974c-b509-388c-b73e-692822d187b2",
                                                "text": "„Er war blutüberströmt, Gaynes stand mit einem riesigen Ochsenziemer hinter Abed.“"
                                            },
                                            {
                                                "example_id": "29231dc5-77eb-47d1-9ea6-63cf00dad02a",
                                                "sense_id": "b3ea974c-b509-388c-b73e-692822d187b2",
                                                "text": "„Nicht allein der Vater war vom Stiefvater mit dem Ochsenziemer für den Besitz eines Buches bestraft worden, sondern der ›Vertreter seiner Klasse‹, hätte Marga gesagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ac0d0d3-3af2-446f-89dd-bad15dfbd1e9",
                        "source_entry_id": "05117fdc-3c0d-3fe8-92ec-5391432a9dc7",
                        "source_sense_description": "penis of an animal",
                        "target_lang_word": "Rute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df4f2209-5a37-3af7-915f-fdab7a294e17",
                                        "entry_id": "2e78a489-27e5-399e-883b-23a1cc67a61c",
                                        "glosses": [
                                            "meist zusammengebundene lange, dünne und flexible Zweige (ohne Blätter), Gerte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a9d151f-d434-4da9-aa4b-2e94dc4f6ff6",
                                                "sense_id": "df4f2209-5a37-3af7-915f-fdab7a294e17",
                                                "text": "Der Weihnachtsmann drohte mit der Rute."
                                            },
                                            {
                                                "example_id": "dacd9b88-6658-411e-bbe0-7829a68f74bd",
                                                "sense_id": "df4f2209-5a37-3af7-915f-fdab7a294e17",
                                                "text": "„Der Freund hatte ihm auch erklärt, was man mit dieser Rute machen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bba70f6-bfb3-3a1c-ab58-137c584a20ed",
                                        "entry_id": "2e78a489-27e5-399e-883b-23a1cc67a61c",
                                        "glosses": [
                                            "altes Längenmaß, das in verschiedenen Bereichen unterschiedlich definiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e752ec24-cf7a-4d53-8410-4f2052a37b4f",
                                                "sense_id": "8bba70f6-bfb3-3a1c-ab58-137c584a20ed",
                                                "text": "„Als ich nur noch ein paar Ruten von der Landestelle entfernt war, die sich recht nahe an dem Wachhaus am Festland befand, begann Johnson zu schreien, er müsse ertrinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "886ad97f-9c88-3268-ab89-6a9f0fbd1b3c",
                                        "entry_id": "2e78a489-27e5-399e-883b-23a1cc67a61c",
                                        "glosses": [
                                            "Schwanz von Hunden oder Füchsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e00cb035-061a-4b91-a370-edeedd536e28",
                                                "sense_id": "886ad97f-9c88-3268-ab89-6a9f0fbd1b3c",
                                                "text": "„Und wenn ich mich hinsetzte, setzte sie sich neben mich und erlaubte mir, an ihrer Rute und an ihren Ohren zu zerren.“"
                                            },
                                            {
                                                "example_id": "81a2c67e-3a03-4bd1-8ed9-c4e9aa117a8f",
                                                "sense_id": "886ad97f-9c88-3268-ab89-6a9f0fbd1b3c",
                                                "text": "„Ein zweiter Windhund stürzte, kaum dass er den Herrn vom Blumengarten aus erblickt hatte, mit gekrümmtem Rücken auf die Freitreppe zu, hob die Rute und rieb sich an Nikolais Beinen.“"
                                            },
                                            {
                                                "example_id": "5370726f-7871-4b50-bd16-cda367048c80",
                                                "sense_id": "886ad97f-9c88-3268-ab89-6a9f0fbd1b3c",
                                                "text": "„Dann zog sie es vor, hinter seinem Rücken Aufstellung zu nehmen und nur leise mahnend mit der Rute gegen seine Knie zu klopfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "44cb76f1-0ead-3b13-9849-41a3e098c96e",
                                        "entry_id": "2e78a489-27e5-399e-883b-23a1cc67a61c",
                                        "glosses": [
                                            "Schlagstock fürs Schlagzeugspiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "402fa1cd-be1a-42c8-b5af-cdffb3556d3c",
                                                "sense_id": "44cb76f1-0ead-3b13-9849-41a3e098c96e",
                                                "text": "Beim Schlagzeugspiel benutzt man Ruten für die Trommeln und die Becken, aber die Füße für die große Basstrommel."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b11daa16-85d4-331d-97e3-d4aef55c292a",
                                        "entry_id": "2e78a489-27e5-399e-883b-23a1cc67a61c",
