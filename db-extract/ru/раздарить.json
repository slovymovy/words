                "translations": [
                    {
                        "translation_id": "24935d69-22b1-4b76-98df-4decd054fa05",
                        "source_entry_id": "f1dc882d-76a7-37ff-9812-35a441859843",
                        "source_sense_id": "d6c8d62e-383b-3de5-89f1-bd5da3cd32f0",
                        "target_lang_word": "verschenken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschenken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                        "entry_id": "7dd9e4e0-e5dc-38b8-870e-5e6359e23729",
                                        "glosses": [
                                            "jemandem etwas zum Geschenk machen, jemandem etwas als Geschenk geben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f5cde65-7d10-4b5a-8ac1-34f39a79b483",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "[Der Fußballer Anthony Modeste:] „Der 33-Jährige bedankte sich und verschenkte sein Trikot an einen kleinen Fan, der auf der Tribüne auf sein Idol gewartet hatte,“ […]."
                                            },
                                            {
                                                "example_id": "f59ab88e-15e7-4940-a3f7-de0dcf9b4dbd",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "Die Deutschen verschenken gern Bücher an Weihnachten."
                                            },
                                            {
                                                "example_id": "5db19566-a17e-4679-9933-4a8bdb09de80",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "Es ist schön, zur Adventszeit Stollen zu backen und an Freunde zu verschenken."
                                            },
                                            {
                                                "example_id": "fd77369d-522f-481a-9626-d715324582ea",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "Im Sommer mache ich Erdbeermarmelade und verschenke sie an Nachbarn."
                                            },
                                            {
                                                "example_id": "fe1e149e-8fa3-42b3-95c9-53b0f863fc79",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "„Seit Dezember 2012 ist der gemeinnützige Verein \"Foodsharing\" online gegangen. Seitdem wurden mehr als 2.000 Kilogramm Lebensmittel verschenkt.“"
                                            },
                                            {
                                                "example_id": "a69af82a-1499-4b8f-b3f2-12a090271134",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "„Setzen Sie jetzt Liköre selbst an und verschenken Sie sie zu Weihnachten.“"
                                            },
                                            {
                                                "example_id": "a87ad5b4-f663-4d45-a7fa-e1d1cf8ed6a1",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "[Bundeswehr in Afghanistan:] „Die Soldaten fuhren in ungepanzerten Fahrzeugen durch die Stadt, verschenkten Süßigkeiten an die Kinder.“"
                                            },
                                            {
                                                "example_id": "35a56391-f6e6-42eb-8fa9-3282673ccff6",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "[Vincent van Gogh:] „Er verschenkte Kleidungsstücke, vernachlässigte sein Äußeres und lebte in ärmlichsten Verhältnissen.“"
                                            },
                                            {
                                                "example_id": "925d25ad-6857-47d6-a834-0e9f7ea26678",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "„Die zehnjährige Lediana will ihre langen, dunkelbraunen Haare, die fast bis zum Po gehen verschenken - an ein krankes Kind, das zum Beispiel wegen einer Krebserkrankung seine Haare verloren hat.“"
                                            },
                                            {
                                                "example_id": "0e2d46e8-4fe4-4db8-bafa-2f1410c2ca74",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "[Bernsteinzimmer:] „Im Jahr 1716 wurde das Original vom preußischen König Friedrich Wilhelm I. an den russischen Zaren Peter den Großen verschenkt und verschwand 1945.“"
                                            },
                                            {
                                                "example_id": "940cefbe-7abb-4a76-bfd2-206f8f32fa92",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "[Coronapandemie:] „Edith Scharfschwerdt hatte schon am Anfang der Pandemie begonnen, Schutzmasken zu nähen und diese unter Nachbarn und Freunden zu verschenken.“"
                                            },
                                            {
                                                "example_id": "491cce53-f8e5-40bd-bc6d-31eb796e6c1a",
                                                "sense_id": "fca59a5a-b502-3d19-97e0-c22468cd5845",
                                                "text": "[Coronapandemie 2020:] „Eine Million Masken verschenkt Taiwan. Dort ist COVID-19 unter Kontrolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a90ec77e-1514-3f2c-a396-d783a1b2d442",
                                        "entry_id": "7dd9e4e0-e5dc-38b8-870e-5e6359e23729",
                                        "glosses": [
                                            "etwas nicht nutzen, etwas ungewollt verschwenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e19a6ee4-ad84-4c18-a5d6-f638a28f19b7",
                                                "sense_id": "a90ec77e-1514-3f2c-a396-d783a1b2d442",
                                                "text": "[Weitsprung:] „Wer vor dem Balken abspringt, verschenkt wertvolle Zentimeter.“"
                                            },
                                            {
                                                "example_id": "f950c207-67ba-47c5-ad83-f8243767d704",
                                                "sense_id": "a90ec77e-1514-3f2c-a396-d783a1b2d442",
                                                "text": "[SC Freiburg:] „In der gesamten Saison hatte der Sportclub in sechs Spielen einen Sieg in den Schlussminuten verschenkt und in weiteren drei 0:0-Partien einen Elfmeter verschossen.“"
                                            },
                                            {
                                                "example_id": "86a35eb4-970e-426e-8d2a-dac0213f3525",
                                                "sense_id": "a90ec77e-1514-3f2c-a396-d783a1b2d442",
                                                "text": "„Aktuell werden Windräder gedrosselt oder ganz abgeschaltet, wenn gerade mehr Strom erzeugt wird, als das Netz tragen kann. So wird de facto wertvolle Energie verschenkt.“"
                                            },
                                            {
                                                "example_id": "25e3e579-ae46-4833-a637-d0719b8dbeca",
                                                "sense_id": "a90ec77e-1514-3f2c-a396-d783a1b2d442",
                                                "text": "„Am 23. Juni verschenkte die Bundesregierung eine letzte Chance, die Menschen, die uns in Afghanistan halfen, in Sicherheit zu bringen.“"
                                            },
                                            {
                                                "example_id": "b0d18ba0-e236-41ad-aad1-f548357590ef",
                                                "sense_id": "a90ec77e-1514-3f2c-a396-d783a1b2d442",
                                                "text": "„Aber an der vorigen Europawahl beteiligten sich nur rund 48 Prozent, europaweit 43 Prozent der Bürgerinnen und Bürger. Über die Hälfte verschenkte die Möglichkeit, sich durch das Europäische Parlament, die einzige direkt demokratisch gewählte Institution der EU vertreten zu lassen.“"
                                            },
                                            {
                                                "example_id": "49872301-30e3-4bec-91ed-bc2c6f4504ed",
                                                "sense_id": "a90ec77e-1514-3f2c-a396-d783a1b2d442",
                                                "text": "Auch die kürzlich in der Orangerie des Charlottenburger Schlosses zu Ende gegangene Ausstellung \"Preußen 1701. Eine europäische Geschichte\" verschenkte die Möglichkeit, die Rolle der Juden in den Anfängen des Preußenstaates gebührend zu würdigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0ac65613-c2bf-35dd-8854-cc12446d6fee",
                                        "entry_id": "7dd9e4e0-e5dc-38b8-870e-5e6359e23729",
                                        "glosses": [
                                            "einen Mann/Jungen lieben; sich einem Mann/Jungen hingeben; mit einem Mann/Jungen Geschlechtsverkehr haben"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f139275a-bd1b-4de4-bbc6-8204fd54189f",
                                                "sense_id": "0ac65613-c2bf-35dd-8854-cc12446d6fee",
                                                "text": "„Sie verschenkte sich, um zum Ziel zu gelangen, ihre Schönheit war ihr das Werkzeug, um Männer toll zu machen, ihren Einfluß für sich zu gewinnen, ihre Ehre, ihre Geheimnisse zu erschleichen.“"
                                            },
                                            {
                                                "example_id": "e7ae67e3-b0e2-4dbf-96db-8e6b788abe69",
                                                "sense_id": "0ac65613-c2bf-35dd-8854-cc12446d6fee",
                                                "text": "„Sie »verschenkte« sich nicht. Sie lachte, wenn Malaita um den ersehnten Kuß flehte ...“"
                                            },
                                            {
                                                "example_id": "c098a40a-76ab-4d87-b01c-c53e7430166c",
                                                "sense_id": "0ac65613-c2bf-35dd-8854-cc12446d6fee",
                                                "text": "„Manchem wohlhabenden Pächter, sagte sie, würde sehr damit gedient sein, wenn er sie zur Frau bekommen könnte; aber sie wäre fest gesonnen, wenn sie einmal ihr Herz verschenkte, sich hübschen Augentrost anzuschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
