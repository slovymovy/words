                {
                    "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                    "sense_definition": "Se mettre d'accord sur une décision commune, fixer ensemble.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>convenir</w> d'une date pour signer le contrat.",
                            "target_lang_translations": {
                                "en": "We need to <w>agree</w> on a date to sign the contract.",
                                "ru": "Нам нужно <w>договориться</w> о дате подписания контракта.",
                                "nl": "We moeten een datum <w>afspreken</w> om het contract te ondertekenen.",
                                "de": "Wir müssen ein Datum für die Vertragsunterzeichnung <w>vereinbaren</w>.",
                                "pl": "Musimy <w>uzgodnić</w> datę podpisania umowy.",
                                "it": "Dobbiamo <w>concordare</w> una data per firmare il contratto.",
                                "cs": "Musíme <w>se domluvit</w> na termínu podpisu smlouvy.",
                                "tr": "Sözleşmeyi imzalamak için bir tarih <w>kararlaştırmamız</w> gerekiyor.",
                                "es": "Debemos <w>acordar</w> una fecha para firmar el contrato.",
                                "zh": "我们需要<w>商定</w>一个签约的日期。"
                            }
                        },
                        {
                            "text": "Les deux parties ont <w>convenu</w> d'un prix de vente raisonnable.",
                            "target_lang_translations": {
                                "en": "The two parties <w>agreed</w> on a reasonable sale price.",
                                "ru": "Обе стороны <w>договорились</w> о разумной цене продажи.",
                                "nl": "De beide partijen zijn een redelijke verkoopprijs <w>overeengekomen</w>.",
                                "de": "Die beiden Parteien haben einen angemessenen Verkaufspreis <w>vereinbart</w>.",
                                "pl": "Obie strony <w>uzgodniły</w> rozsądną cenę sprzedaży.",
                                "it": "Le due parti hanno <w>concordato</w> un prezzo di vendita ragionevole.",
                                "cs": "Obě strany <w>se dohodly</w> na rozumné prodejní ceně.",
                                "tr": "İki taraf makul bir satış fiyatı üzerinde <w>anlaştı</w>.",
                                "es": "Las dos partes <w>acordaron</w> un precio de venta razonable.",
                                "zh": "双方<w>商定</w>了一个合理的售价。"
                            }
                        }
                    ],
                    "synonyms": [
                        "s'accorder",
                        "décider"
