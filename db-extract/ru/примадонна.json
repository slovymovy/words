                        "cross_references": [
                            {
                                "target_word": "prima donna",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "804698f5-cf28-398e-bc44-0ce4b4d7786b",
                                        "entry_id": "ab75c1ff-4e30-3527-91c1-451375113469",
                                        "glosses": [
                                            "Première et principale cantatrice d’un opéra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6909a51c-b6ac-4508-b666-8afd79047961",
                                                "sense_id": "804698f5-cf28-398e-bc44-0ce4b4d7786b",
                                                "text": "Madame Hulot faisait remonter les premières infidélités de son Hector au grand finale de l’Empire. La baronne avait donc tenu, pendant douze ans, dans son ménage, le rôle de prima dona assoluta, sans partage."
                                            },
                                            {
                                                "example_id": "ff788f12-2abf-4206-8342-5cee52e86249",
                                                "sense_id": "804698f5-cf28-398e-bc44-0ce4b4d7786b",
                                                "text": "Constance Bartolozzi, murmura-t-il lentement, prima donna du théâtre de la Princesse."
                                            },
                                            {
                                                "example_id": "d5f03e22-19a2-4165-91da-334e3d1e9af5",
                                                "sense_id": "804698f5-cf28-398e-bc44-0ce4b4d7786b",
                                                "text": "Pour l’amour du ciel, pourquoi ces fleurs, je ne suis pas une prima donna !"
                                            },
                                            {
                                                "example_id": "7f20ecec-b970-400f-b9e7-2e5e85f2f301",
                                                "sense_id": "804698f5-cf28-398e-bc44-0ce4b4d7786b",
                                                "text": "Les plus belles femmes du monde, les grandes ballerines, les prime donne, les Rachel, les Duse et les Garbo,-voilà ce à quoi, dans son esprit, j'étais destiné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
