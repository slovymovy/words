                                        "sense_id": "593dc507-549e-3caf-9177-1ad521e6e6db",
                                        "entry_id": "22754820-e3cd-35c7-87c3-3a9e4fafad12",
                                        "glosses": [
                                            "Person, die mit Hunden besonders gut auskommt; Person, die Hunde sehr mag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d66020-b34f-4452-8471-4f2e0c37eef8",
                                                "sense_id": "593dc507-549e-3caf-9177-1ad521e6e6db",
                                                "text": "„Hundeliebhaber, die ihren gestressten Vierbeinern etwas Gutes tun möchten, laden sie zum Wellnesswochenende nach Mayerling ein – Hundeyoga inklusive.“"
                                            },
                                            {
                                                "example_id": "120d1cae-ce14-42c3-94aa-1ae48fdd90ec",
                                                "sense_id": "593dc507-549e-3caf-9177-1ad521e6e6db",
                                                "text": "„Die meisten Hundeliebhaber sind von der Intelligenz dieser Vierbeiner überzeugt.“"
                                            },
                                            {
                                                "example_id": "0971284c-a26f-4499-9128-62bfe69e60f2",
                                                "sense_id": "593dc507-549e-3caf-9177-1ad521e6e6db",
                                                "text": "„Deutsche Hundeliebhaber sind dem Ursprungsort der ersten Hunde übrigens besonders nahe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
