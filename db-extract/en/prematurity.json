                        "entry_id": "eda916c8-cd34-3e38-82fd-ad2c55c11f74",
                        "glosses": [
                            "The condition of (a baby, etc.) being premature."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e94fc081-a100-4d56-bc6e-258d33d56fc4",
                                "sense_id": "5cb6a4de-ea75-3bb3-ae7c-692999f550d8",
                                "text": "The questions of prematurity and low birth weight and the implications for later development are consistent with the theme of risk and vulnerability discussed throughout the book."
                            },
                            {
                                "example_id": "93619931-34b3-4942-9f58-465dcb89dcf7",
                                "sense_id": "5cb6a4de-ea75-3bb3-ae7c-692999f550d8",
                                "text": "Apnea of prematurity represents a striking disorder of respiratory control."
                            },
                            {
                                "example_id": "0424fec5-4e97-407b-844c-bd7f68ee388d",
                                "sense_id": "5cb6a4de-ea75-3bb3-ae7c-692999f550d8",
                                "text": "In Table 8.2, problems of prematurity are second only to congenital abnormalities as the cause of neonatal death."
                            }
                        ]
                    },
                    {
                        "sense_id": "77c6eba9-028f-31e9-90b7-372d0d2b3148",
                        "entry_id": "eda916c8-cd34-3e38-82fd-ad2c55c11f74",
                        "glosses": [
                            "Something that is premature or occurs prematurely."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ba6c37a9-713d-42f6-a85b-505bd1abe8d7",
                                "sense_id": "77c6eba9-028f-31e9-90b7-372d0d2b3148",
                                "text": "Those individuals in the third group with 5 to 10 prematurities noted averaged 7 prematurities for every 57 heart beats[…]."
                            },
                            {
                                "example_id": "6ccfa44b-ba08-4cfa-9396-1946c2ac3729",
                                "sense_id": "77c6eba9-028f-31e9-90b7-372d0d2b3148",
                                "text": "Not all patients with occlusal prematurities have trauma from occlusion."
                            },
                            {
                                "example_id": "e66847ff-c413-4dfd-882b-4a3b2602f2d5",
                                "sense_id": "77c6eba9-028f-31e9-90b7-372d0d2b3148",
                                "text": "Studies might compare the accuracy of locating Centric Relation prematurities determined by mounted diagnostic models and the T-Scan."
                            }
                        ]
                    }
