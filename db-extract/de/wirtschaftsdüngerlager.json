                "senses": [
                    {
                        "sense_id": "a6a4dc17-1b1c-32a5-90d3-4db07422ce56",
                        "entry_id": "279222e4-8554-368d-b51c-8de0f7d46543",
                        "glosses": [
                            "Lager für Wirtschaftsdünger (zum Beispiel: Gülle, Jauche, Mist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f014219-5514-4781-990f-4e4d83109b8e",
                                "sense_id": "a6a4dc17-1b1c-32a5-90d3-4db07422ce56",
                                "text": "„Die Gülle, die vom Hof nicht vollständig auszubringen ist, wird von Vertragsfirmen mit blankpolierten Tankwagen zum öffentlichen Wirtschaftsdüngerlager, oft auch in andere, teilweise weit entfernt liegende Regionen gefahren, wo die meisten Ackerbauern selbst keine Tiere mehr halten, dafür jedoch für ihren Anbau von Mais, Roggen und Weizen Phosphor, Stickstoff und Spurenelemente gut gebrauchen können.“"
                            },
                            {
                                "example_id": "3918ca0c-fa9c-4903-ba37-f93281c0380b",
                                "sense_id": "a6a4dc17-1b1c-32a5-90d3-4db07422ce56",
                                "text": "„Stehen Tiere im Winterhalbjahr auf der Weide (z.B. Mutterkühe), kann sich dieses dagegen bei der Bemessung des Wirtschaftsdüngerlagers lagerkapazitätsverringernd auswirken.“"
                            },
                            {
                                "example_id": "42931bd1-58d4-4bb4-8d8a-c735db388d77",
                                "sense_id": "a6a4dc17-1b1c-32a5-90d3-4db07422ce56",
                                "text": "„Niedersachsen will den Bau neuer Wirtschaftsdüngerlager oder Lagerplatten für Stallmist mit insgesamt 10 Mio. Euro unterstützen.“"
                            },
                            {
                                "example_id": "7925b481-e5e2-424e-8ffa-b1aa4075fe65",
                                "sense_id": "a6a4dc17-1b1c-32a5-90d3-4db07422ce56",
                                "text": "„Insgesamt 10 Mio. Euro sind für den Bau neuer Läger für Wirtschaftsdüngerlager oder Lagerplatten für Stallmist eingeplant.“"
                            },
                            {
                                "example_id": "35ba1d73-89b6-4d04-906c-11e9f1dc62d0",
                                "sense_id": "a6a4dc17-1b1c-32a5-90d3-4db07422ce56",
                                "text": "„Derartige Verluste treten im Stall, im Wirtschaftsdüngerlager und bei der Ausbringung von Wirtschaftsdünger auf und müssen so weit wie möglich reduziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
