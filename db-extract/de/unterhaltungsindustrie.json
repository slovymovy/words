                ],
                "senses": [
                    {
                        "sense_id": "f9a6994e-655d-3ed7-af42-409e05b77d0f",
                        "entry_id": "2859f8fd-c1b2-3a52-b318-cdcd21e01d59",
                        "glosses": [
                            "Wirtschaftsbereich, der sich mit öffentlichen, Publikum unterhaltenden, Darbietungen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e234565-f800-4176-af2c-55c40ef473c7",
                                "sense_id": "f9a6994e-655d-3ed7-af42-409e05b77d0f",
                                "text": "„Obwohl viele Menschen zurzeit ein Bedürfnis nach Musik, Filmen und Videospielen haben, steht auch die Unterhaltungsindustrie in der Krise still.“"
                            },
                            {
                                "example_id": "4f2fb00c-aa1e-47d5-8c1c-f5d23ea6a23e",
                                "sense_id": "f9a6994e-655d-3ed7-af42-409e05b77d0f",
                                "text": "„Man kann aber sagen, dass schon Hunderte Leute aus der Unterhaltungsindustrie in diesem Büro saßen: Musiker, Produzenten, Schauspieler, Regisseure.“"
                            },
                            {
                                "example_id": "1a57c921-bc98-4469-ac8e-2440cc74504e",
                                "sense_id": "f9a6994e-655d-3ed7-af42-409e05b77d0f",
                                "text": "„Krieg war ihre Unterhaltungsindustrie, zumindest, was den Adel betraf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
