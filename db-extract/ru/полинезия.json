                                "target_senses": [
                                    {
                                        "sense_id": "dbd3523c-756c-3ed9-b72b-3391fa02861b",
                                        "entry_id": "034e8247-cefd-3aa0-be19-1c98ac148f1b",
                                        "glosses": [
                                            "Büyük Okyanus'taki üç büyük ada grubundan biri."
                                        ],
                                        "tags": [
                                            "adalar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df34ff7a-ea77-4a80-9336-07ef7d287255",
                                                "sense_id": "dbd3523c-756c-3ed9-b72b-3391fa02861b",
                                                "text": "Büyük Okyanus'taki üç büyük ada grubu Melanezya, Mikronezya ve Polinezya'dır."
                                            }
