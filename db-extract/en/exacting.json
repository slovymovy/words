                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b69470c0-4a67-4a10-80f7-eca53d603e55",
                                                "sense_id": "37be915a-bdcd-3948-8a95-0caf01e41ee9",
                                                "text": "Elle propose (mais on pourra ensuite se les prescrire à soi-même) des exercices permettant de « se détourner de ce qui nous détourne de nous » (HS, 198). Et consistant à désabsolutiser les objets illusoirement absolutisés, entre autres à se désabsolutiser soi-même en n’exigeant pas trop de soi."
                                            }
                                        ]
                                    }
                                ]
