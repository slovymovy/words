                "senses": [
                    {
                        "sense_id": "027e278b-2708-3e53-89ac-8b925bce0183",
                        "entry_id": "1c9f5f72-0440-31f5-8df4-ba64b6e8d990",
                        "glosses": [
                            "Person, die an einer Neurose erkrankt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc68cac-6e9f-4358-af74-2095d1474484",
                                "sense_id": "027e278b-2708-3e53-89ac-8b925bce0183",
                                "text": "Weil sein Psychiater sagte, er sei Neurotiker, macht er eine Verhaltenstherapie."
                            },
                            {
                                "example_id": "249258d6-3af4-47b9-8391-9ba6116ac72d",
                                "sense_id": "027e278b-2708-3e53-89ac-8b925bce0183",
                                "text": "Während seines Psychatrieaufenthalts lernte der Neurotiker mit seiner Krankheit umzugehen."
                            },
                            {
                                "example_id": "f3de785c-5be4-4ffd-aedf-5f7589d78354",
                                "sense_id": "027e278b-2708-3e53-89ac-8b925bce0183",
                                "text": "Jeder Tag ist eine Belastung für den Neurotiker, da er unter starken Zwängen leidet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07562ce5-9f81-42c0-9051-b8df547f0b30",
                        "source_entry_id": "1c9f5f72-0440-31f5-8df4-ba64b6e8d990",
                        "source_sense_id": "027e278b-2708-3e53-89ac-8b925bce0183",
                        "source_sense_description": "Person, die an einer Neurose erkrankt ist",
                        "target_lang_word": "neurotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e14399c-ad90-32ef-a1ac-5a1b3cc85228",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Affected with a neurosis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45d3370b-5c11-40f3-8e8e-1405fa95cb7d",
                                                "sense_id": "0e14399c-ad90-32ef-a1ac-5a1b3cc85228",
                                                "text": "If there were such a thing as inspiration from a higher realm, it might well be that the neurotic temperament would furnish the chief condition of the requisite receptivity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Overly anxious."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f1edc2a-2160-4e5e-a3e2-55a840e06159",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "He is getting neurotic about time-keeping."
                                            },
                                            {
                                                "example_id": "e7ada65e-4d13-4587-b2da-cb9c64394a06",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers, the worn-out, passionless men,[…], the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosis,[…]!”"
                                            },
                                            {
                                                "example_id": "1a2a1df2-f3ff-4d01-87b3-20bd0d962dd0",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "“You did come down a wallop, didn't you? How art thou fallen from heaven, oh Lucifer, son of the morning, I said to myself. You're so terribly neurotic, Bertie. You must try to be less jumpy. What you need is a good nerve tonic.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4809abb0-05c2-3289-89b2-c6566f7a0210",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Useful in disorders of, or affecting, the nerves."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "neurotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf7508b-6506-32fa-b185-85a68db4be36",
                                        "entry_id": "85fe07bd-c171-3ba1-a4a3-5093133ab952",
                                        "glosses": [
                                            "A person who has a neurosis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17723cb8-4a60-3bde-9b84-7480b0636291",
                                        "entry_id": "85fe07bd-c171-3ba1-a4a3-5093133ab952",
                                        "glosses": [
                                            "A crazy person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9706d1a-63fc-450e-8983-8723c31c8c7c",
                                                "sense_id": "17723cb8-4a60-3bde-9b84-7480b0636291",
                                                "text": "Drag this neurotic to hysterics, leave him balked and unfulfilled;\nholding inside, outwardly patient 'til the time he'll call it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b095caf1-5fda-47ee-8323-901cf93d92d2",
                        "source_entry_id": "1c9f5f72-0440-31f5-8df4-ba64b6e8d990",
                        "source_sense_id": "027e278b-2708-3e53-89ac-8b925bce0183",
                        "source_sense_description": "Person, die an einer Neurose erkrankt ist",
                        "target_lang_word": "névrosé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "névrosé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a31337e-db36-3c5d-8231-f9fc518adc6a",
                                        "entry_id": "3af24201-d3e1-3fae-bd18-e7aa586f9b15",
                                        "glosses": [
                                            "Atteint de névrose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89507a4-f6a1-4d72-b696-cb6a97a06641",
                                                "sense_id": "8a31337e-db36-3c5d-8231-f9fc518adc6a",
                                                "text": "C’était vers cette époque que Mélasse avait commencé à parler de « petits cons névrosés » et de « nénettes mal dépucelées » à propos du groupe Bakounine."
                                            },
                                            {
                                                "example_id": "14f443e4-18c4-463e-9b39-dc767fdc3529",
                                                "sense_id": "8a31337e-db36-3c5d-8231-f9fc518adc6a",
                                                "text": "« Laisse tomber. Même à des ouvrières il arrive d’être névrosées. Le cœur pur que tu crois avoir découvert n’existera qu’en l’an 2050. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "névrosé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b716e2-8769-3204-bc59-ceb9ad956485",
                                        "entry_id": "6204eecb-486a-3a78-905a-32de7a6917eb",
                                        "glosses": [
                                            "Personne atteinte de névrose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f40daf4-6c88-4829-b4ae-4e54a38335f2",
                                                "sense_id": "f4b716e2-8769-3204-bc59-ceb9ad956485",
                                                "text": "C'est un névrosé de première."
                                            },
                                            {
                                                "example_id": "b6c70943-c269-4d0e-8801-4aed8324949e",
                                                "sense_id": "f4b716e2-8769-3204-bc59-ceb9ad956485",
                                                "text": "Cependant, le problème du névrosé réside dans une perte de la référence symbolique des signifiants qui constituent les points centraux de sa structure complexe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "névrosé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "180d53af-a7c0-3d64-86a4-0caa53c6597c",
                                        "entry_id": "c1472397-4fe7-35c5-88a4-30a4cc84fa4c",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe névroser."
                                        ],
