                        "form": "homeowners"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02dd3ec3-4d08-330d-9724-041113bdb567",
                        "entry_id": "3ba17456-7796-3287-858f-afef9b4e683a",
                        "glosses": [
                            "屋主"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5f842e2-f614-4fd7-a142-529e2fbf2215",
                                "sense_id": "02dd3ec3-4d08-330d-9724-041113bdb567",
                                "text": "As a plumber, I feel bad for the homeowner and his neighbors.",
                                "translation": "作为一名水管工，我为房主和他的邻居感到难过。"
                            },
                            {
                                "example_id": "c667f23f-e425-4b34-8234-a9a348e6acf9",
                                "sense_id": "02dd3ec3-4d08-330d-9724-041113bdb567",
                                "text": "He advised homeowners to get insurance before then so they can be grandfathered in as discretionary buyers of flood insurance in a nonflood zone. Even when the new maps take effect, these homeowners will pay lower flood premiums than they otherwise would.",
                                "translation": "他建議業主在洪泛區改劃前投保，好讓他們沿承自願購買非洪水區水險的保費優惠。"
                            },
                            {
                                "example_id": "1bada094-f007-4b01-a173-89930f38b3c9",
                                "sense_id": "02dd3ec3-4d08-330d-9724-041113bdb567",
                                "text": "The homeowner theorized that the intruders saw that the house was up for sale and targeted it for their rager.",
                                "translation": "房主推测，入侵者看到这所房子正在出售，因此将其作为袭击目标。"
                            },
                            {
                                "example_id": "6e24fd2f-8590-4f73-9ad3-db1b0823b915",
                                "sense_id": "02dd3ec3-4d08-330d-9724-041113bdb567",
                                "text": "The taxability of forgiven debt is set to become a pressing issue as more homeowners fall behind on their mortgages and face foreclosure.",
                                "translation": "随着越来越多的房主拖欠抵押贷款并面临丧失抵押品赎回权，免除债务征税将成为一个紧迫的问题。"
                            }
                        ]
                    }
                ],
