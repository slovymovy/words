    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7e4f829-912a-32e1-bba4-7fd15890a4a2",
                    "sense_definition": "Einen Gegenstand so wenden, dass die andere Seite nach oben oder vorne zeigt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>dreh</w> das Blatt <w>um</w>, damit du die nächste Aufgabe lesen kannst."
                        },
                        {
                            "text": "Er <w>drehte</w> das Fleisch in der Pfanne <w>um</w>, damit es von beiden Seiten gar wird."
                        }
                    ],
                    "synonyms": [
                        "wenden",
                        "umwenden"
                    ],
                    "common_phrases": [
                        "das Blatt umdrehen",
                        "das Fleisch umdrehen"
                    ]
                },
                {
                    "sense_id": "49e5524c-3bb7-3450-98a7-24e13f9e4525",
                    "sense_definition": "Seinen Körper oder Kopf zur Seite oder nach hinten wenden, meist um zurückzublicken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "blickrichtung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie hörte Schritte hinter sich und <w>drehte</w> sich erschrocken <w>um</w>."
                        },
                        {
                            "text": "Er <w>drehte</w> sich nach seiner Freundin <w>um</w>, die noch am Bahnsteig stand."
                        }
                    ],
                    "synonyms": [
                        "zurückblicken",
                        "umschauen"
                    ],
                    "common_phrases": [
