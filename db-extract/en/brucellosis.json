                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "69bd9a0c-daac-4f24-b004-3d591658c5da",
                        "entry_id": "8adf8298-4d43-3c42-a900-722095f3527b",
                        "tags": [
                            "plural"
                        ],
