                {
                    "sense_id": "61704ce2-4e45-35d7-bfe3-fac454ad55ca",
                    "sense_definition": "Cast or scattered widely in all directions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture_sowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>broadcast</w> method of sowing is less precise than drilling.",
                            "target_lang_translations": {
                                "ru": "<w>Разбросной</w> метод посева менее точен, чем рядовой.",
                                "zh": "<w>撒播</w>的播种方法不如条播精确。"
                            }
                        },
                        {
                            "text": "We used a <w>broadcast</w> distribution of pamphlets to reach everyone.",
                            "target_lang_translations": {
                                "ru": "Мы использовали <w>массовое</w> распространение брошюр, чтобы охватить всех.",
                                "zh": "我们采用了<w>广泛</w>分发小册子的方式以覆盖所有人。"
                            }
                        }
                    ],
                    "synonyms": [
