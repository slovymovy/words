{
    "word_family": [
        "confrontation",
        "confrontatif",
        "confrontationnel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ae45305-0484-3147-9370-4b9c0127ff91",
                    "sense_definition": "Mettre quelqu'un en présence d'une situation difficile, d'un problème ou d'une réalité incontournable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mettre_face_a",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jeunes diplômés sont souvent <w>confrontés</w> à un marché du travail difficile."
                        },
                        {
                            "text": "Cette crise économique va <w>confronter</w> le gouvernement à des choix budgétaires délicats."
                        }
                    ],
                    "synonyms": [
                        "exposer",
                        "opposer"
                    ],
                    "antonyms": [
                        "épargner",
                        "soustraire"
                    ],
                    "common_phrases": [
                        "être confronté à",
                        "confronté à la réalité"
                    ]
                },
                {
                    "sense_id": "0759ae08-f7e4-3f7c-b46d-a750a4069386",
                    "sense_definition": "Comparer deux choses, deux documents ou deux versions pour observer leurs ressemblances ou leurs différences.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comparer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les historiens doivent <w>confronter</w> plusieurs sources avant de valider un fait."
                        },
                        {
                            "text": "En réunion, nous avons pu <w>confronter</w> des points de vue très différents sur ce projet."
                        }
                    ],
                    "synonyms": [
                        "comparer",
                        "rapprocher",
                        "collationner"
                    ],
                    "common_phrases": [
                        "confronter des points de vue",
                        "confronter les sources"
                    ]
                },
                {
                    "sense_id": "b1963890-e8a1-399e-aa20-d6e37cd7cbf5",
                    "sense_definition": "Mettre deux ou plusieurs personnes face à face afin de vérifier leurs déclarations et éclaircir la vérité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "face_a_face",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge d'instruction a décidé de <w>confronter</w> les accusés pour déceler d'éventuels mensonges."
                        },
                        {
                            "text": "Les enquêteurs ont <w>confronté</w> les deux suspects pour relever les contradictions dans leurs histoires."
                        }
                    ],
                    "synonyms": [
                        "mettre en présence"
                    ],
                    "antonyms": [
                        "séparer"
                    ],
                    "common_phrases": [
                        "confronter les témoins",
                        "confronter les accusés"
                    ]
                },
                {
                    "sense_id": "221ee133-b758-3e29-b775-743d0197965d",
                    "sense_definition": "Interroger directement une personne pour lui demander des explications ou des comptes sur un comportement suspect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "face_a_face",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir découvert la vérité, elle a décidé de <w>confronter</w> son collègue directement dans son bureau."
                        },
                        {
                            "text": "Il hésitait à <w>confronter</w> son associé au sujet des anomalies comptables récemment constatées."
                        }
                    ],
                    "synonyms": [
                        "interpeller"
                    ],
                    "antonyms": [
                        "ignorer"
                    ],
                    "common_phrases": [
                        "confronter directement"
                    ]
                },
                {
                    "sense_id": "8a644958-81f3-3550-8f59-7088a1438744",
                    "sense_definition": "Être contigu, confiner à un autre terrain ou à un autre domaine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon les anciens actes notariés, cette parcelle agricole <w>confronte</w> au chemin communal."
                        },
                        {
                            "text": "La propriété du meunier <w>confrontait</w> au domaine seigneurial sur toute sa limite nord."
                        }
                    ],
                    "synonyms": [
                        "confiner",
                        "avoisiner",
                        "toucher"
                    ],
                    "common_phrases": [
                        "confronter au levant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Terme juridique ancien pour désigner les limites d'un bien-fonds"
                        }
                    ]
                }
            ]
        }
    ]
}