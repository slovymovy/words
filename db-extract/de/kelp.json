                                        "entry_id": "685dc947-b68c-3c5d-bcf5-e6440858f26a",
                                        "glosses": [
                                            "Any of several large brown algae seaweeds (order Laminariales)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
