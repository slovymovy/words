                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rave_culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived to shut down the illegal <w>rave</w> taking place in the forest.",
