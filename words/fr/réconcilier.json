                    "sense_definition": "Remettre d'accord des personnes qui étaient brouillées ou en conflit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relations_humaines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a tenté de <w>réconcilier</w> les deux collègues avant que la dispute ne s'aggrave."
                        },
                        {
                            "text": "Un vieil ami est intervenu pour <w>réconcilier</w> les deux frères fâchés depuis des mois."
                        }
                    ],
                    "synonyms": [
