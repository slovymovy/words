    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b205c236-a111-3cbb-a40c-5fe5ee357063",
                    "sense_definition": "Einen bestimmten Ort, einen Gegenstand oder ein Verkehrsmittel räumlich oder zeitlich rechtzeitig antreffen oder dorthin gelangen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ort_gelangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen uns beeilen, wenn wir den Zug noch <w>erreichen</w> wollen."
                        },
                        {
                            "text": "Nach einer langen Wanderung durch den Wald <w>erreichten</w> die Touristen das kleine Bergdorf."
                        }
                    ],
                    "synonyms": [
                        "gelangen"
                    ],
                    "antonyms": [
                        "verfehlen",
                        "verpassen"
                    ],
                    "common_phrases": [
                        "den Zug erreichen",
                        "den Bahnhof erreichen",
                        "rechtzeitig erreichen"
                    ]
                },
                {
                    "sense_id": "7b59f731-c48a-37d3-bdfd-3fb657321373",
                    "sense_definition": "Mit einer Person erfolgreich Kontakt aufnehmen, meist über Telefon, E-Mail oder Funk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kontakt_herstellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe den ganzen Vormittag versucht, meine Ärztin telefonisch zu <w>erreichen</w>."
                        },
                        {
                            "text": "Unter dieser Handynummer können Sie mich jederzeit im Notfall <w>erreichen</w>."
                        }
                    ],
                    "common_phrases": [
                        "jemanden telefonisch erreichen",
                        "per Mail erreichen"
                    ],
                    "synonyms": [
                        "kontaktieren"
                    ]
                },
                {
                    "sense_id": "4aa7cfbf-9617-3530-9b88-595d20b84c6d",
                    "sense_definition": "Ein bestimmtes Ziel, Resultat oder Vorhaben durch Anstrengung verwirklichen oder erlangen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ziel_verwirklichen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die beiden Parteien verhandelten stundenlang, um endlich eine Einigung zu <w>erreichen</w>."
