                    ],
                    "common_phrases": [
                        "fouetter le visage",
                        "fouetter les vitres"
                    ]
                },
                {
                    "sense_id": "cf084af1-cfa2-3826-bc11-4ba4273c69fe",
                    "sense_definition": "Dégager une odeur particulièrement désagréable ; puer.",
