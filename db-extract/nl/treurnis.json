                    {
                        "translation_id": "9ef2f4b6-4181-4bf3-afba-226612c61132",
                        "source_entry_id": "c02e9e95-c9dc-3391-b3ad-281fc8b6fdad",
                        "source_sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
                        "target_lang_word": "gloom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gloom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bc128c5-e1bd-37e7-b956-803bc51802c1",
                                        "entry_id": "b905ff0c-481b-3b07-81e2-13f5d64afe36",
                                        "glosses": [
                                            "Darkness, dimness, or obscurity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0410d6a-4e8d-4634-9a97-b190c102735a",
                                                "sense_id": "5bc128c5-e1bd-37e7-b956-803bc51802c1",
                                                "text": "the gloom of a forest, or of midnight"
                                            },
                                            {
                                                "example_id": "5e83aef9-41a9-4b0e-a965-17dd0a3e7d86",
                                                "sense_id": "5bc128c5-e1bd-37e7-b956-803bc51802c1",
                                                "text": "Here was a surprise, and a sad one for me, for I perceived that I had slept away a day, and that the sun was setting for another night. And yet it mattered little, for night or daytime there was no light to help me in this horrible place; and though my eyes had grown accustomed to the gloom, I could make out nothing to show me where to work."
                                            },
                                            {
                                                "example_id": "3bb105ae-4700-4d9a-a528-e4eed417dc29",
                                                "sense_id": "5bc128c5-e1bd-37e7-b956-803bc51802c1",
                                                "text": "On December 13, Maritime-liveried 66051 powers out of the early morning gloom with three repatriated Class 66s, on the 0809 Dollands Moor Sidings-Scunthorpe Redbourne Siding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8813f285-beb4-3c3c-b652-d019470c5064",
                                        "entry_id": "b905ff0c-481b-3b07-81e2-13f5d64afe36",
                                        "glosses": [
                                            "A depressing, despondent, or melancholic atmosphere."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1efd482-747a-4a3c-b312-1d0edaffb7eb",
                                                "sense_id": "8813f285-beb4-3c3c-b652-d019470c5064",
                                                "text": "A sudden little river crossed my path / As unexpected as a serpent comes. / No sluggish tide congenial to the glooms— / This, as it frothed by, might have been a bath / For the fiend's glowing hoof—to see the wrath / Of its black eddy bespate with flakes and spumes."
                                            },
                                            {
                                                "example_id": "5bde64aa-e7f9-4082-b9f4-83794c59322f",
                                                "sense_id": "8813f285-beb4-3c3c-b652-d019470c5064",
                                                "text": "Although it's always crowded\nYou still can find some room\nFor broken-hearted lovers\nTo cry there in their gloom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a62606-4596-3762-bdf8-bd062413f342",
                                        "entry_id": "b905ff0c-481b-3b07-81e2-13f5d64afe36",
                                        "glosses": [
                                            "Cloudiness or heaviness of mind; melancholy; aspect of sorrow; low spirits; dullness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5299e08a-6ab0-4242-b1e9-539be26fade7",
                                                "sense_id": "f1a62606-4596-3762-bdf8-bd062413f342",
                                                "text": "A sullen gloom and furious disorder prevailed by fits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b07f0dc7-3390-3f4f-b810-03a87567bedf",
                                        "entry_id": "b905ff0c-481b-3b07-81e2-13f5d64afe36",
                                        "glosses": [
                                            "A drying oven used in gunpowder manufacture."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gloom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a2ba67-4cca-3a5e-ae23-b5767e1d9b5a",
                                        "entry_id": "c4c7bd6a-9afe-30fa-a36b-176108f4d7f5",
                                        "glosses": [
                                            "To be dark or gloomy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e49b5d50-5ebe-405b-9c46-8feea5c69929",
                                                "sense_id": "a6a2ba67-4cca-3a5e-ae23-b5767e1d9b5a",
                                                "text": "Here, while the proud their long drawn pomps diſplay, / There the black gibbet glooms beſide the way."
                                            },
                                            {
                                                "example_id": "f5c472fe-dfd1-475e-95d1-2392d86329e3",
                                                "sense_id": "a6a2ba67-4cca-3a5e-ae23-b5767e1d9b5a",
                                                "text": "Around all the dark forest gloomed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc22b379-565f-3572-b34b-66875d5e766c",
                                        "entry_id": "c4c7bd6a-9afe-30fa-a36b-176108f4d7f5",
                                        "glosses": [
                                            "To look or feel sad, sullen or despondent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e51680eb-6348-4c25-b38c-f56bfe483c04",
                                                "sense_id": "cc22b379-565f-3572-b34b-66875d5e766c",
                                                "text": "Her face gathers, furrows, glooms; arching eyebrows wrinkle into horizontals, and a tinge of bitterness unsmooths the cheek and robs the lip of sweetened grace. She is evidently perturbed."
                                            },
                                            {
                                                "example_id": "5f156d64-4e05-40ce-8e5d-e77d588b5da5",
                                                "sense_id": "cc22b379-565f-3572-b34b-66875d5e766c",
                                                "text": "Ciss was a big, dark-complexioned, pug-faced young woman who seemed to be glooming about something."
                                            },
                                            {
                                                "example_id": "d9166613-4540-4a98-975a-b27682549a6a",
                                                "sense_id": "cc22b379-565f-3572-b34b-66875d5e766c",
                                                "text": "\"Is Maggie then astonishing too?\"—and he gloomed out of his window."
                                            },
                                            {
                                                "example_id": "70de9041-03dd-4a1b-ba9e-81cf6a60326f",
                                                "sense_id": "cc22b379-565f-3572-b34b-66875d5e766c",
                                                "text": "He gloomed for some moments above the round-topped table[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a65284-2040-39d3-8d68-bca828cee9bf",
                                        "entry_id": "c4c7bd6a-9afe-30fa-a36b-176108f4d7f5",
                                        "glosses": [
                                            "To render gloomy or dark; to obscure; to darken."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445e51e5-f299-44c7-bde9-d2d6de21f6f4",
                                                "sense_id": "b4a65284-2040-39d3-8d68-bca828cee9bf",
                                                "text": "A black yew gloom'd the stagnant air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c1442b7-8c2d-3563-9618-de299230101e",
                                        "entry_id": "c4c7bd6a-9afe-30fa-a36b-176108f4d7f5",
                                        "glosses": [
                                            "To fill with gloom; to make sad, dismal, or sullen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810ef8cf-9ba3-4b9d-bd3b-edfab1f67984",
                                                "sense_id": "1c1442b7-8c2d-3563-9618-de299230101e",
                                                "text": "For see you not, dear love, / Such a mood as that, which lately gloom'd / Your fancy when you saw me following you, / Must make me fear still more you are not mine, […]"
                                            },
                                            {
                                                "example_id": "a7f4bd7a-e4a5-4bc2-8072-e38c866294c3",
                                                "sense_id": "1c1442b7-8c2d-3563-9618-de299230101e",
                                                "text": "Good Heaven! What ſorrows gloom'd that parting day, / That called them from their native walks away; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28f8d6d-2521-35c4-bb03-0c8f7649f524",
                                        "entry_id": "c4c7bd6a-9afe-30fa-a36b-176108f4d7f5",
                                        "glosses": [
                                            "To shine or appear obscurely or imperfectly; to glimmer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f7dcae8-babe-4acb-b3a3-af4e3a822649",
                        "source_entry_id": "c02e9e95-c9dc-3391-b3ad-281fc8b6fdad",
                        "source_sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
                        "target_lang_word": "grief",
