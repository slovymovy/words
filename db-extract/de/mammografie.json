                        "entry_id": "c3925db5-5184-38e5-90b4-ec08b7e2653a",
                        "glosses": [
                            "Verfahren der Radiologie eine Röntgenuntersuchung üblicherweise der weiblichen, gegebenenfalls aber auch der männlichen Brust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a4f838-e9ee-4949-ba37-354cd81f6a03",
                                "sense_id": "c2d594a5-9ac0-3ce3-a570-2221542cb15d",
                                "text": "Die Mammografie gehört zu den Reihenuntersuchungen."
                            },
                            {
                                "example_id": "bcabd57c-a048-4d86-af0e-45cade109f81",
                                "sense_id": "c2d594a5-9ac0-3ce3-a570-2221542cb15d",
                                "text": "Bei der Mammografie erstellte Bilder werden in der Patientenakte aufbewahrt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91f98777-daf6-4453-ae5b-ee4f7f397b33",
                        "source_entry_id": "c3925db5-5184-38e5-90b4-ec08b7e2653a",
                        "source_sense_id": "c2d594a5-9ac0-3ce3-a570-2221542cb15d",
                        "target_lang_word": "mammography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mammography",
