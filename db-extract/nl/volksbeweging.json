                        "glosses": [
                            "het gaan van grote groepen mensen van de ene naar de andere plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb8e7a1-9a57-45d8-8da7-73e1125955c6",
                                "sense_id": "5d890536-30ac-39ac-980b-81f6344ae422",
                                "text": "Want als een bepaalde regeringsvorm werd ingevoerd of een bepaalde volksbeweging zich voltrok als gevolg van bepaalde geografische, etnografische of economische voorwaarden, dan kan de vrije wil van de mensen die in onze ogen die regeringsvorm of die volksverhuizingen hebben veroorzaakt, niet langer als oorzaak worden gezien."
                            }
                        ]
                    },
