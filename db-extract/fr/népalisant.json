                        "glosses": [
                            "Spécialiste de la langue ou de la culture népalaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1070616-aaac-4cc5-98ae-b61d2f1ef0e6",
                                "sense_id": "3d25af2c-1f11-33cd-91ef-9380488b285c",
                                "text": "Celui de David Gellner, Monk, Householder and Tantric Priest, Newar Buddhism and its Hierarchy of Ritual (Cambridge University Press, 1992), remarquable étude sociologique par un excellent népalisant qui est en même temps un bon sanskritiste ; et celui de Robert J. Lévy, Mesocosm, Hinduism and the Organization of a Traditional City in Nepal (Berkeley, University of California, 1990), par un anthropologue étranger au Népal, mais dont le regard neuf sur monde népalais, tout en étant parfois discutable, est souvent singulièrement éclairant. Ce sont deux études que l’on ne peut pas ignorer."
                            }
                        ]
                    }
