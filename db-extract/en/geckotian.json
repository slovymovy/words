                        "glosses": [
                            "A gecko."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cdbeffbc-0d90-49ac-b000-1ab14b134352",
                                "sense_id": "284bcc3c-19d1-3c60-95e7-d515c5434391",
                                "text": "The Geckotians, is composed of nocturnal lizards, so much resembling each other that they might be left in one genus."
                            },
                            {
                                "example_id": "b98f4593-b331-4009-b341-9d31c77fba50",
                                "sense_id": "284bcc3c-19d1-3c60-95e7-d515c5434391",
                                "text": "It proved to be nothing more that a lizard of the geckotian family, hideously ugly, but, in common with all of his kind, perfectly harmless."
                            },
                            {
                                "example_id": "7cf6edda-6e09-4d09-8211-65e75da5d457",
                                "sense_id": "284bcc3c-19d1-3c60-95e7-d515c5434391",
                                "text": "Other saurians have folds of skin along the flanks; but in no other of them is this disposition so developed as in a curious geckotian, the Ptychozoon homacephalum of Java and other Sunda Islands."
                            }
                        ]
                    }
