                ],
                "senses": [
                    {
                        "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                        "entry_id": "2e434d5c-a51d-39e0-bd39-9dcc4ca5fd4f",
                        "glosses": [
                            "Vorstellung eines bestimmten irrealen Ziels, einer angestrebte Idee der Vollkommenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d872a32-81c3-4ff2-a08f-42884cf18bc9",
                                "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                                "text": "„Daraus ergeben sich wichtige Argumente für eine jedenfalls partielle Entsprechung von Idealvorstellung und Wirklichkeit.“"
                            },
                            {
                                "example_id": "0780d16d-29c0-444e-a7a0-cfd80b65ff48",
                                "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                                "text": "„Ein beliebtes Thema mittelhochdeutscher Mären sind die Rollenverhältnisse von Mann und Frau, hierbei kommt es oft zu Verkehrungen oder Brüchen mit den Idealvorstellungen.“"
                            },
                            {
                                "example_id": "77be6bca-de1c-4f43-bf43-bd5c0f3bc47a",
                                "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                                "text": "„Eingebettet in katholische Kirchenvorstellungen hatten Lucien und ich versucht christliche Idealvorstellungen zu verwirklichen.“"
                            },
                            {
                                "example_id": "7af408f4-e0eb-4158-abd9-164c33d44626",
                                "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                                "text": "„Die Philosophen bemühen sich seit jeher, Idealvorstellungen über das richtige, gute, ethisch korrekte Leben zu entwerfen.“"
                            },
                            {
                                "example_id": "c67f6df6-e383-4c76-83a9-2cf676cf54c8",
                                "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                                "text": "„Die Idealvorstellung ist, dass das neue Voice-over sich ebenfalls nach dem Originalton richten soll und nicht nach dem bereits vorhandenen Voice-over.“"
                            },
                            {
                                "example_id": "f0e30cd3-f5bd-4725-a23d-415df22bc82e",
                                "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                                "text": "„Welche Idealvorstellung haben Sie von Ihrem Unternehmen – als Arbeitgeber und auch als Anbieter?“"
                            },
                            {
                                "example_id": "a2771165-04a4-4a26-a4c3-ee701857bf9c",
                                "sense_id": "b146b8fb-8cfc-309c-87ff-301ad65cda44",
                                "text": "„Die Rahmenkonzeption geht von der Idealvorstellung der gesamten betrieblichen Informationswirtschaft aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
