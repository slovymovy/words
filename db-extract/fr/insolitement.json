                "senses": [
                    {
                        "sense_id": "08cbccae-8cc3-34bf-9f76-e2aab039a2ab",
                        "entry_id": "a30104ab-2586-3edf-a01d-a269f31d9dee",
                        "glosses": [
                            "D’une manière insolite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f283e3b-4073-4dde-b8ac-db4dc3afc70b",
                                "sense_id": "08cbccae-8cc3-34bf-9f76-e2aab039a2ab",
                                "text": "Insolitement désemparés de leur arrogance, ils contemplaient, du seuil, ce petit vieillard au visage d’enfant, ce Deucalion ecclésiastique monstrueusement environné d’un si grand nombre de pierres qu’il n’en aurait pas fallu davantage, semblait-il, pour le renouvellement de la race humaine anéantie par les déluges ou les exterminations militaires."
                            },
                            {
                                "example_id": "ff845bca-bcbe-407b-971a-eb75d499d4e0",
                                "sense_id": "08cbccae-8cc3-34bf-9f76-e2aab039a2ab",
                                "text": "La voix du négociant — merrains, traverses de chemin de fer et bois de mine — a quelque chose d’insolitement grave."
                            },
                            {
                                "example_id": "04598825-4ccf-48d3-8c4b-a7a98bf3d381",
                                "sense_id": "08cbccae-8cc3-34bf-9f76-e2aab039a2ab",
                                "text": "… son bar où une bouteille d’after shave « Made in France » trône insolitement au milieu d’autres breuvages alcoolisés."
                            }
                        ]
                    }
                ],
