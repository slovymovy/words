                "senses": [
                    {
                        "sense_id": "dabd45b6-90df-3447-8648-d2ed66967bbf",
                        "entry_id": "a766b40f-03f4-30b5-8187-9c950c987c27",
                        "glosses": [
                            "Qui ne reçoit pas ou qui n’a pas reçu la punition méritée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf3b723-570e-4025-8c5a-51f072d3bb04",
                                "sense_id": "dabd45b6-90df-3447-8648-d2ed66967bbf",
                                "text": "« M. Gide n’incarne pas même une école littéraire, pas même la revue où il écrit. Son œuvre est le scandale intellectuel et moral le plus impuni du siècle », lis-je dans la Revue française."
                            },
                            {
                                "example_id": "39d95c1a-98ed-4b9d-927a-ddab1f97f9da",
                                "sense_id": "dabd45b6-90df-3447-8648-d2ed66967bbf",
                                "text": "Le coupable ne restera pas impuni."
                            },
                            {
                                "example_id": "32c4a13e-522f-4cd4-bf8f-05af848b02e2",
                                "sense_id": "dabd45b6-90df-3447-8648-d2ed66967bbf",
                                "text": "Cette faute ne demeurera pas impunie."
                            },
                            {
                                "example_id": "db3966cf-1966-45c8-b6ea-af1112044270",
                                "sense_id": "dabd45b6-90df-3447-8648-d2ed66967bbf",
                                "text": "Dieu ne laisse point les crimes impunis."
                            },
                            {
                                "example_id": "548cc093-5356-4f21-a955-0067f69a7e5b",
                                "sense_id": "dabd45b6-90df-3447-8648-d2ed66967bbf",
                                "text": "L’injure a été trop publique pour demeurer impunie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57f5e0a2-7263-4d93-9704-db9e04352d44",
                        "source_entry_id": "a766b40f-03f4-30b5-8187-9c950c987c27",
                        "source_sense_id": "dabd45b6-90df-3447-8648-d2ed66967bbf",
