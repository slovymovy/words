                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e16c6b-dd6d-4339-9e4b-9fb151fd9cd7",
                        "source_entry_id": "b17313da-83e5-395e-a1df-1304e3da02aa",
                        "target_lang_word": "intertextuality",
