                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61170b1-8d35-4d29-863c-39419fd44542",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "Mam na imię Katarzyna i jestem krawcową z Łodzi."
                                            },
                                            {
                                                "example_id": "0cc38bb0-6120-49b6-ac38-9a96cedad9a7",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "Katarzyna Figura jest polską aktorką, która z humorem i pasją kreuje postacie kobiet ekscentrycznych i nieobliczalnych żon."
                                            },
                                            {
                                                "example_id": "8d1baf34-a6aa-44e3-9a04-6e0824f1e5c0",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "W Kościele katolickim na 25 listopada przypada wspomnienie św. Katarzyny Aleksandryjskiej, patronki katarzynek, krawcowych, bieliźniarek, prządek, modystek, fryzjerów, dziewcząt, mężatek, kołodziejów, młynarzy, garncarzy, polskich kolejarzy, studentów i uczonych oraz chroniącej od bólu głowy."
                                            },
                                            {
                                                "example_id": "b650297e-84f5-4828-9f2d-257255638eba",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "Katarzyny dzień swej patronki, czyli imieniny, obchodzą 25 listopada, a także 2 i 13 lutego, 22 i 24 marca, 29 i 30 kwietnia, 15 września oraz 31 grudnia."
                                            },
                                            {
                                                "example_id": "e5d53c40-63fb-48f6-aa7e-fbf6a270ab0c",
                                                "sense_id": "acf2c753-8b63-3665-9b46-047883b4df89",
                                                "text": "Mieszkam w Katarzynie od urodzenia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b561d958-4971-313b-9786-ed4f8b89e73d",
