                "senses": [
                    {
                        "sense_id": "3bd06020-36fa-3f1f-ad9a-97399cf1e122",
                        "entry_id": "ec9322e1-b348-31e8-aa17-b4749dc785fe",
                        "glosses": [
                            "für eine Nucleinbase"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "4f54d2e7-a5b1-42d3-9779-24c4b212c4b4",
                                "sense_id": "3bd06020-36fa-3f1f-ad9a-97399cf1e122",
                                "text": "Die Xanthinbasen sind basische Bausteine der Nucleinsäuren."
                            },
                            {
                                "example_id": "ee740195-ae5b-481f-94ca-47ec5d224770",
                                "sense_id": "3bd06020-36fa-3f1f-ad9a-97399cf1e122",
                                "text": "Die modernere Bezeichnung für Xanthinbasen lautet Nucleinbasen."
                            },
                            {
                                "example_id": "7324c2b2-7913-45ef-bf55-8f89ff199915",
                                "sense_id": "3bd06020-36fa-3f1f-ad9a-97399cf1e122",
                                "text": "Zu der veralteten Bezeichnung Xanthinbasen zählte man die Purin- und Pyrimidinbasen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "595a1469-89d9-3e09-abb4-574d26d98f69",
                        "entry_id": "ec9322e1-b348-31e8-aa17-b4749dc785fe",
                        "glosses": [
                            "Stoff, Substanz aus der Kohlenstoffchemie, N-methylierte Derivate des Xanthins"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "d16afc4f-b179-43b6-9339-fbf41ec40005",
                                "sense_id": "595a1469-89d9-3e09-abb4-574d26d98f69",
                                "text": "Die wichtigsten Xanthinbasen (eigentlich Purinbasen) sind Theophyllin, Theobromin und Coffein."
                            },
                            {
                                "example_id": "e8b6c42c-59f1-4bbe-854c-93199ba9692b",
                                "sense_id": "595a1469-89d9-3e09-abb4-574d26d98f69",
                                "text": "Die Xanthinbasen treten im Kaffee, im Tee, im Kakao, in der Cola-Nuss und im Mate auf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
