                        "examples": [
                            {
                                "example_id": "47e0a76e-2a0e-4b6d-bf08-3dd14d3e78d1",
                                "sense_id": "26f13820-f9f2-3530-ac2d-c660f3df2cf1",
                                "text": "Her driver was new to the country; he mightn't be prepared for the leaping of the yellow water down dry arroyos, swift as the pouncings of a cat, or the snake-like slidings of tons of loosened rock and clay from the steep potreros […]"
                            },
                            {
                                "example_id": "3a30b583-fd18-48bb-a0db-02dd0299ef50",
                                "sense_id": "26f13820-f9f2-3530-ac2d-c660f3df2cf1",
                                "text": "“But, mightn’t there have been something unusual about the Stimatis contract itself?” [Perry Mason cross-examining Roger Correll.]"
                            },
                            {
                                "example_id": "100d3241-a2b0-45e4-b769-309ff9e4074c",
                                "sense_id": "26f13820-f9f2-3530-ac2d-c660f3df2cf1",
                                "text": "\"But at night she would still think the same thing: mightn't it be that he wouldn't come to see her anymore?\""
                            }
                        ]
                    }
