                "word_linkages": []
            },
            {
                "entry_id": "d19d6a52-c6f1-3225-b6b1-7333de6e9706",
                "word": "berthon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "12863e1c-7249-413c-9af9-74b057f5d4b3",
                        "entry_id": "d19d6a52-c6f1-3225-b6b1-7333de6e9706",
                        "tags": [
                            "plural"
                        ],
                        "form": "berthons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10bb2a20-71ac-3728-9a82-31f8f2892c87",
                        "entry_id": "d19d6a52-c6f1-3225-b6b1-7333de6e9706",
                        "glosses": [
                            "Petit canot pliable en bois et en toile peinte, créé pour la marine française."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4fd49ee8-8c83-4795-af34-2fd18338ce92",
                                "sense_id": "10bb2a20-71ac-3728-9a82-31f8f2892c87",
                                "text": "Mon travail terminé, après un repas sommaire, je mis à l'eau mon berthon et ramai vers la terre."
                            },
                            {
                                "example_id": "11792f33-5443-449f-b7e4-abda66414845",
                                "sense_id": "10bb2a20-71ac-3728-9a82-31f8f2892c87",
                                "text": "le 18, natation, plongeon, course de plates, course avec obstacles des berthons de sous-marins, match de football entre l'équipe de l'escadre et l'équipe du Havre."
                            },
                            {
                                "example_id": "e784117d-7fbb-43ce-b114-ea5672382f49",
                                "sense_id": "10bb2a20-71ac-3728-9a82-31f8f2892c87",
                                "text": "Le canot bascule sur le berthon, se met à glisser vers l'avant écrasant une trentaine de personnes et blessant grièvement à la jambe Isaac Lehmann."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58da9f70-8700-4a48-87bd-a1b60e7e0c72",
                        "source_entry_id": "d19d6a52-c6f1-3225-b6b1-7333de6e9706",
                        "source_sense_id": "10bb2a20-71ac-3728-9a82-31f8f2892c87",
                        "target_lang_word": "Faltboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faltboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                        "entry_id": "e14688ce-06a4-3294-be82-983ed31def3e",
                                        "glosses": [
                                            "ein zerlegbares Boot, welches im wesentlichen aus einer flexiblen Bootshaut und einem zerlegbarem Innengerüst besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837f400e-6960-4996-8e8a-4d6900e0334e",
                                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                                "text": "Für unseren Paddelausflug, nutzen wir ein Faltboot."
                                            },
                                            {
                                                "example_id": "47847afb-cd8f-4612-9a90-b7c106f84402",
                                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                                "text": "Die Urlauber sind mit dem Faltboot auf dem Bodensee unterwegs."
                                            },
                                            {
                                                "example_id": "0dd79016-30d3-4ea1-93ba-9164894b1ff0",
                                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                                "text": "„Flußromantik und Flußzauber, des Frühlings Einzug, des Sommers Erwachen kann man im Faltboot stimmungsvoll erleben.“"
                                            },
                                            {
                                                "example_id": "5c9dbd03-d6d3-41ad-83b9-ac0d781e680b",
                                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                                "text": "„Denn kaum war der Arbeitsdienst vorüber, stürzte der 20-jährige sich in ein besonders veritables Abenteuer: eine Fahrt mit seinem Faltboot Marke Klepper auf der Donau von Passau bis zum Schwarzen Meer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
