                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbac5f37-b239-482f-9f8c-ec49928d7693",
                                "sense_id": "ed3b0f59-14d5-3df2-8317-7291c3b35cb2",
                                "text": "„Der iPhone-Hersteller forsche in einem neuen Geheimlabor im Silicon Valley an dem Projekt.“"
                            },
                            {
                                "example_id": "babfe0b1-1007-4c21-b734-60ee338fc736",
                                "sense_id": "ed3b0f59-14d5-3df2-8317-7291c3b35cb2",
                                "text": "„Von hier oben öffnet sich der Blick auf die gegenüberliegenden Hügel, in denen das Geheimlabor versteckt ist.“"
                            },
                            {
                                "example_id": "04476efe-48a4-4439-b970-6410d39fc382",
                                "sense_id": "ed3b0f59-14d5-3df2-8317-7291c3b35cb2",
                                "text": "„Mehrere Hundert Apple-Mitarbeiter sollen in einem Geheimlabor am in den Medien \"iCar\" genannten Fahrzeug arbeiten.“"
                            }
                        ],
