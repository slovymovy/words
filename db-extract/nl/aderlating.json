                    {
                        "sense_id": "fbedfd78-3ae2-35e3-a2fc-6d1691ac8e65",
                        "entry_id": "ecdb2fee-061a-37d7-8ce0-285a19d09dca",
                        "glosses": [
                            "de handeling van het aderlaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a537d75-9f77-4ed5-b37c-37c96befe322",
                                "sense_id": "fbedfd78-3ae2-35e3-a2fc-6d1691ac8e65",
                                "text": "Door middel van een aderlating werd geprobeerd de bloedstroom af te leiden."
                            }
                        ]
                    },
                    {
                        "sense_id": "91460429-5a26-3ded-ac2f-02dcb51c52d6",
                        "entry_id": "ecdb2fee-061a-37d7-8ce0-285a19d09dca",
