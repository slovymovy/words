    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "14a9fe8c-0b59-3eea-893d-3c266afaeb8c",
                "word": "wight",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed365d1e-bbd5-3203-8eaa-75d73bbde3b9",
                        "entry_id": "14a9fe8c-0b59-3eea-893d-3c266afaeb8c",
                        "glosses": [
                            "Brave, valorous, strong."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "aaa019ec-17e4-4dc1-9d0f-12d5e13f2a9d",
                                "sense_id": "ed365d1e-bbd5-3203-8eaa-75d73bbde3b9",
                                "text": "I haue two sones that were but late made knyghtes / and the eldest hyghte sir Tirre /[…]/ and my yongest sone hyght Lauayne / and yf hit please yow / he shalle ryde with yow vnto that Iustes / and he is of his age x stronge and wyght"
                            }
                        ]
                    },
                    {
                        "sense_id": "3b3847ff-cf8b-3d38-8b74-c56f04c4f2df",
                        "entry_id": "14a9fe8c-0b59-3eea-893d-3c266afaeb8c",
                        "glosses": [
                            "Strong; stout; active."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "74f527d0-179e-4418-945a-9f270376b725",
                                "sense_id": "3b3847ff-cf8b-3d38-8b74-c56f04c4f2df",
                                "text": "Then spake Much the milner son, / Ever more well him betide! / ‘Take twelve of thy wight yeomen, / Well weapon’d by thy side. / Such one would thyselfë slon, / That twelve dare not abide.’"
                            },
                            {
                                "example_id": "8f079b0f-82c6-4ccd-96d7-af7be0410bb5",
                                "sense_id": "3b3847ff-cf8b-3d38-8b74-c56f04c4f2df",
                                "text": "Ye do you to my father's stable, / Where steeds do stand baith wight and able; / Strike ane o' them upo' the back, / The swiftest will gie his head a wap."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
