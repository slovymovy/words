                        "sense_id": "890cd743-90d4-3f30-96b8-a7050a885f0a",
                        "entry_id": "0ba44e78-c8f7-3d42-b4ff-7f7cb474df17",
                        "glosses": [
                            "Jeu d'orgue de la famille des gambes dont le son est analogue à celui d'un cor."
                        ],
                        "tags": [
                            "Orgues"
                        ],
                        "examples": [
                            {
                                "example_id": "23d422ff-de59-4598-9e32-666c0f03ffb9",
                                "sense_id": "890cd743-90d4-3f30-96b8-a7050a885f0a",
                                "text": "Quant au kéraulophone , jeu tout à fait nouveau, je n'en dirais rien pour cette fois, si ce n'est que ce nom signifie, je pense, dans la pensée de l'inventeur, corne à son de flute."
                            },
                            {
                                "example_id": "ab5de421-9866-41b4-8122-9f7394b1eca1",
                                "sense_id": "890cd743-90d4-3f30-96b8-a7050a885f0a",
                                "text": "Le kéraulophone occupe la première chape. C'est un jeu ouvert de 8' en métal, de menue taille. Ce jeu, inventé par Gray et Davison en Angleterre, a sans doute été ramené par Ducrocquet de retour de l'exposition universelle de Londres en 1851."
                            }
                        ]
                    }
