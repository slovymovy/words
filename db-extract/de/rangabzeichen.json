                    },
                    {
                        "translation_id": "cb11feac-cab1-4423-955a-36212ef4ab80",
                        "source_entry_id": "43eb3c92-ad5d-3713-9f45-b7d775de18e0",
                        "source_sense_id": "dbce69e4-5468-36af-85d2-e6d0e6a91142",
                        "source_sense_description": "Zeichen an der Kleidung, die die Position (Rang) des Trägers in einer Organisation anzeigen",
                        "target_lang_word": "insignia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insignia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d147150-35ae-3e3d-9aff-c35bd0091183",
                                        "entry_id": "fc532ce5-4bd8-3864-a89b-8f7059a256e9",
                                        "glosses": [
                                            "A patch or other object that indicates a person's official or military rank, or membership in a group or organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db044cb1-412f-43b8-b869-5a405ac70d99",
                                                "sense_id": "1d147150-35ae-3e3d-9aff-c35bd0091183",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a29f70e-0c44-3ede-b63e-df0b3fe0488b",
                                        "entry_id": "fc532ce5-4bd8-3864-a89b-8f7059a256e9",
                                        "glosses": [
                                            "A symbol or token of personal power, status, or office, or of an official body of government or jurisdiction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bc47dc-3933-45c0-91cd-e1c3edfbc676",
                                                "sense_id": "3a29f70e-0c44-3ede-b63e-df0b3fe0488b",
                                                "text": "The former Protector tendered him the oaths, and presented him with the insignia of office, performing the ceremonies of installation."
                                            },
                                            {
                                                "example_id": "ab33c994-6c7e-46d9-aef2-eda6b58d99c2",
                                                "sense_id": "3a29f70e-0c44-3ede-b63e-df0b3fe0488b",
                                                "text": "The most sacred part of the ceremony followed when the new king was anointed with holy oil to confirm his semi-divine status. He was then invested with the royal insignia: the ring, sword, crown, sceptre and rod. Finally, the newly crowned monarch received the homage of his leading subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e661931-2346-3637-ba2b-e88052d2f22f",
                                        "entry_id": "fc532ce5-4bd8-3864-a89b-8f7059a256e9",
                                        "glosses": [
                                            "A mark or token by which anything is known."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d67c2d-2114-4e7d-8541-ef66d78464c2",
                                                "sense_id": "3e661931-2346-3637-ba2b-e88052d2f22f",
                                                "text": "But if autumn wear the insignia of nature's royalty, its purple and gold, in only the shaded lane or the green field with its one or two old trees, what is its more than eastern pomp in a wooded empire like the New Forest!"
                                            },
                                            {
                                                "example_id": "f284dcec-63ca-42ee-948d-be8ed531f875",
                                                "sense_id": "3e661931-2346-3637-ba2b-e88052d2f22f",
                                                "text": "Rule 23: “The stress of love makes it hard to eat and sleep.” To these empirical laws we can add the various other insignia of love."
                                            }
                                        ]
                                    }
                                ]
                            },
