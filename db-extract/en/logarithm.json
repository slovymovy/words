                                                "sense_id": "d1c36d3a-806d-3d61-a288-6e98bd482403",
                                                "text": "Der Logarithmus zur Basis 10 wird auch als Zehnerlogarithmus oder dekadischer Logarithmus bezeichnet."
                                            },
                                            {
                                                "example_id": "d91dec7a-f234-413a-91f1-730eece6620d",
                                                "sense_id": "d1c36d3a-806d-3d61-a288-6e98bd482403",
                                                "text": "Ist 2 der Logarithmus zur Basis 10 einer Zahl, dann ist die Zahl gerade 100."
                                            },
                                            {
                                                "example_id": "53e37df8-f982-4225-a06d-dc3daa97f7fb",
                                                "sense_id": "d1c36d3a-806d-3d61-a288-6e98bd482403",
                                                "text": "Der dyadische Logarithmus von 8 ist 3."
                                            },
                                            {
                                                "example_id": "8ed68d57-a642-4c6e-9424-73e28ff6a959",
                                                "sense_id": "d1c36d3a-806d-3d61-a288-6e98bd482403",
                                                "text": "Der Logarithmus zur Basis b und der Exponent zur Basis b sind zueinander das Ergebnis einer Umkehrfunktion."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
