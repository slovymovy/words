{
    "word_family": [
        "knavery",
        "knavish",
        "knavishly",
        "knavishness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61fb4a1d-bb48-36f1-b348-7e93be0433c6",
                    "sense_definition": "A dishonest, deceitful, or untrustworthy person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scoundrel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishonest merchant was known throughout the town as an untrustworthy <w>knave</w>.",
                            "target_lang_translations": {
                                "ru": "Нечестный торговец был известен по всему городу как ненадёжный <w>плут</w>."
                            }
                        },
                        {
                            "text": "He refused to do business with such a deceitful <w>knave</w> after the scam was uncovered.",
                            "target_lang_translations": {
                                "ru": "Он отказался вести дела с таким лживым <w>мошенником</w> после того, как афера была раскрыта."
                            }
                        }
                    ],
                    "synonyms": [
                        "rogue",
                        "scoundrel",
                        "rascal",
                        "blackguard"
                    ],
                    "common_phrases": [
                        "deceitful knave",
                        "cunning knave"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный, коварный или не заслуживающий доверия человек; мошенник или негодяй."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлец",
                                "target_lang_sense_clarification": "низкий, бесчестный человек"
                            },
                            {
                                "target_lang_word": "плут",
                                "target_lang_sense_clarification": "хитрый обманщик, мошенник"
                            },
                            {
                                "target_lang_word": "мошенник",
                                "target_lang_sense_clarification": "жулик, обманщик"
                            },
                            {
                                "target_lang_word": "негодяй",
                                "target_lang_sense_clarification": "подлый и дурной человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b235e7d7-c615-3d8b-90ad-687d237f46c3",
                    "sense_definition": "A playing card depicting a soldier or servant, commonly called a jack.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "card",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older English card games, the player led with the <w>knave</w> of hearts.",
                            "target_lang_translations": {
                                "ru": "В старинных английских карточных играх игрок ходил с червового <w>валета</w>."
                            }
                        },
                        {
                            "text": "She drew the <w>knave</w> of spades from the pack to complete her hand.",
                            "target_lang_translations": {
                                "ru": "Она вытянула из колоды пикового <w>валета</w>, чтобы добрать нужную комбинацию карт."
                            }
                        }
                    ],
                    "synonyms": [
                        "jack"
                    ],
                    "common_phrases": [
                        "knave of hearts",
                        "knave of spades",
                        "knave of clubs",
                        "knave of diamonds"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игральная карта с изображением оруженосца или слуги; валет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валет",
                                "target_lang_sense_clarification": "игральная карта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d6a4ebd-e658-3852-bf60-9f4163015d0f",
                    "sense_definition": "A male servant or menial worker.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobleman commanded the young <w>knave</w> to fetch fresh water from the well.",
                            "target_lang_translations": {
                                "ru": "Дворянин приказал молодому <w>слуге</w> принести свежей воды из колодца."
                            }
                        },
                        {
                            "text": "Every kitchen <w>knave</w> was busy preparing the feast for the royal guests.",
                            "target_lang_translations": {
                                "ru": "Каждый поварёнок и <w>прислужник</w> на кухне был занят приготовлением пира для королевских гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "varlet"
                    ],
                    "common_phrases": [
                        "kitchen knave"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слуга мужского пола или чернорабочий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слуга",
                                "target_lang_sense_clarification": "человек для услуг, прислуга"
                            },
                            {
                                "target_lang_word": "прислужник",
                                "target_lang_sense_clarification": "слуга, подручный"
                            },
                            {
                                "target_lang_word": "лакей",
                                "target_lang_sense_clarification": "слуга при господине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ae09574-631f-3ec6-a2a0-52eb37994fbe",
                    "sense_definition": "A male child or boy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval texts, the term often referred simply to a young <w>knave</w> growing into manhood.",
                            "target_lang_translations": {
                                "ru": "В средневековых текстах это слово часто означало просто юного <w>мальчика</w>, взрослеющего и становящегося мужчиной."
                            }
                        },
                        {
                            "text": "The midwife announced that the newborn child was a healthy <w>knave</w>.",
                            "target_lang_translations": {
                                "ru": "Повитуха объявила, что новорождённый — здоровый <w>мальчик</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ребёнок мужского пола, мальчик или юноша."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мальчик",
                                "target_lang_sense_clarification": "ребёнок мужского пола"
                            },
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "юноша, молодой человек"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}