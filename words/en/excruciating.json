                            {
                                "target_lang_word": "ondraaglijk",
                                "target_lang_sense_clarification": "niet te verdragen of uit te houden"
                            },
                            {
                                "target_lang_word": "martelend",
                                "target_lang_sense_clarification": "zeer pijnlijk of kwelend"
                            }
                        ],
                        "es": [
