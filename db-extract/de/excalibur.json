                "senses": [
                    {
                        "sense_id": "527f99fe-64eb-3b33-b081-ae8323ebf298",
                        "entry_id": "250dba42-9403-395f-b639-02c467a4015a",
                        "glosses": [
                            "Schwert des mythischen Königs Artus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f113bb-3d24-457c-ac1d-1fae1b147f5d",
                                "sense_id": "527f99fe-64eb-3b33-b081-ae8323ebf298",
                                "text": "„In alter Zeit wurde mein Land von einem großen König beherrscht, der ein Zauberschwert besaß. Das hieß Excalibur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67cd2640-5b77-41ce-8c50-8640dc463bd8",
                        "source_entry_id": "250dba42-9403-395f-b639-02c467a4015a",
                        "source_sense_id": "527f99fe-64eb-3b33-b081-ae8323ebf298",
                        "source_sense_description": "mythisches Schwert",
                        "target_lang_word": "Excalibur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Excalibur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5de2215-2d05-3b2f-982d-84899fb18d19",
                                        "entry_id": "82f0ed48-cb96-3f56-af6c-36c56f7b0f01",
                                        "glosses": [
                                            "The legendary sword of King Arthur, having magical properties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de42b9e-b3bc-4d8e-8f84-0dcda56d9dbb",
                                                "sense_id": "d5de2215-2d05-3b2f-982d-84899fb18d19",
                                                "text": "Until recently, suppression of ethnicity has perhaps been the leading characteristic of the trend of thought of these Jewish intellectuals. Some, like Noam Chomsky and I. F. Stone, have been considered by some Jews to be so suppressed—or at least so overcompensating for their being Jewish—as to be regarded as anti-Semitic on some issues. Such men flaunt their universalism like Excaliburs of truth and objectivity."
                                            },
                                            {
                                                "example_id": "6d0a2eff-3344-4ddb-9a0b-c02a0ad951c5",
                                                "sense_id": "d5de2215-2d05-3b2f-982d-84899fb18d19",
                                                "text": "And we would see fish swimming among the tall bulrushes that rose like Excaliburs out of the lake."
                                            },
                                            {
                                                "example_id": "d3bec2e3-23cf-4ad2-a520-0353e8311ab7",
                                                "sense_id": "d5de2215-2d05-3b2f-982d-84899fb18d19",
                                                "text": "You and I, we are not alone, and our screwdrivers are our flashing Excaliburs as we sally forth to make small parts of the fragmented world whole again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
