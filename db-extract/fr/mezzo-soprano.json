                "senses": [
                    {
                        "sense_id": "61aa76c0-e178-385d-8c47-17bd908e6c0c",
                        "entry_id": "43d11b1f-7e37-304f-9481-a08421c79a0f",
                        "glosses": [
                            "Voix qui tient le milieu entre l’alto et le soprano."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b57d0f-72d1-44b4-b79f-edaac56cdd5b",
                                "sense_id": "61aa76c0-e178-385d-8c47-17bd908e6c0c",
                                "text": "Avec cela, musicien, doué d'une voix de mezzo-soprano d'un charme irrésistible."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bbe31f9-ad7a-3bcb-bf77-287551a90c4e",
                        "entry_id": "43d11b1f-7e37-304f-9481-a08421c79a0f",
                        "glosses": [
                            "Chanteuse qui possède cette voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f419c446-41cc-47d3-b049-38015ec5b8da",
                                "sense_id": "6bbe31f9-ad7a-3bcb-bf77-287551a90c4e",
                                "text": "La BBC a, de son côté, invité la mezzo-soprano écossaise Katherine Jenkins à enregistrer l’hymne avec les bonnes paroles, mais cette version n’est pas commercialisée."
                            },
                            {
                                "example_id": "1b0a5dcd-a4fa-4cfe-934e-1d4b1404b636",
                                "sense_id": "6bbe31f9-ad7a-3bcb-bf77-287551a90c4e",
                                "text": "Ce vendredi, la mezzo-soprano Léa Desandre et le luthiste Thomas Dunford joueront et chanteront un mélange hétéroclite, allant d’Erik Satie à Barbara, en passant par le morceau baroque d’Honoré d’Ambruis, Le Doux Silence de nos bois, Françoise Hardy ou encore Debussy."
                            },
                            {
                                "example_id": "b29b2d65-d473-425f-b1a6-782a5be93e80",
                                "sense_id": "6bbe31f9-ad7a-3bcb-bf77-287551a90c4e",
                                "text": "Avec Sophie Belloir, mezzo-soprano ; Maël Fauvy, guitariste et compositeur, et Chani Stroobant, violoniste."
                            }
                        ]
                    }
