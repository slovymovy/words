                "senses": [
                    {
                        "sense_id": "881903e0-6f95-31f4-8c79-38f4fed30e96",
                        "entry_id": "23c00984-3a29-3e55-9f37-78d250c4536f",
                        "glosses": [
                            "славянская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba4297b5-75c7-4903-a8ed-0f8ff26a1265",
                                "sense_id": "881903e0-6f95-31f4-8c79-38f4fed30e96",
                                "text": "Справа от него стоял венгр Ковач, слева ― австралиец Лоуренс."
                            },
                            {
                                "example_id": "942634f8-4f78-4c95-b665-d828b8ae364b",
                                "sense_id": "881903e0-6f95-31f4-8c79-38f4fed30e96",
                                "text": "Самая распространённая в мире фамилия ― Шмидт, Смит… У западных славян ― Ковач. У наших самых близких родственников с юга…"
                            }
                        ]
                    }
                ],
