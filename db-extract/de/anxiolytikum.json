                    },
                    {
                        "translation_id": "0f4e90f7-2de0-4b0d-bc09-38bc49e585c9",
                        "source_entry_id": "abc26701-fa8e-3c75-b4e1-6681b66e3f66",
                        "source_sense_id": "1c768db8-3c9e-387b-82ed-e74c5a021903",
                        "source_sense_description": "Medikament, das zur Verminderung übermäßiger oder krankhafter Ängste verwendet wird",
                        "target_lang_word": "anxiolytique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anxiolytique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "688535b9-c94c-3745-9551-158b30def89c",
                                        "entry_id": "ae304aa7-0908-307e-b722-20ab4ae56fe7",
                                        "glosses": [
                                            "Propre à combattre l’anxiété ou l’angoisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0220cf93-4a1b-4fcd-8ee1-bbde3eb73c9b",
                                                "sense_id": "688535b9-c94c-3745-9551-158b30def89c",
                                                "text": "Si les fabricants vantent ses propriétés anxiolytiques, anti-inflammatoires, neuroprotectrices et antalgiques, l’association invite à en nuancer la fiabilité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anxiolytique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63fe3eff-a9e9-3c18-affe-5633be75a85f",
                                        "entry_id": "d72b741c-a7b2-3b8c-a352-a0fad421861b",
                                        "glosses": [
                                            "Médicament contre l’anxiété ou l’angoisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2802cd48-ff72-4abc-a9c4-8d58b81b2cd0",
                                                "sense_id": "63fe3eff-a9e9-3c18-affe-5633be75a85f",
                                                "text": "Autrefois les poulets mettaient trois mois à être adultes ; aujourd’hui entre l’œuf et le poulet vendu en hypermarché s’écoulent seulement 42 jours dans des conditions atroces (25 bêtes par mètre carré, nourries aux antibiotiques et anxiolytiques)."
                                            },
                                            {
                                                "example_id": "5efdd9b4-7286-4d7f-bf7f-4bb237fc3eb8",
                                                "sense_id": "63fe3eff-a9e9-3c18-affe-5633be75a85f",
                                                "text": "Le médecin m’examina et s’alarma de ma faiblesse, il me prescrivit des médicaments pour une forme sérieuse d’arthrose, des antidépresseurs, des anxiolytiques, des vitamines."
                                            },
                                            {
                                                "example_id": "17edefcd-61c0-4893-8e4d-8c4ccc297398",
                                                "sense_id": "63fe3eff-a9e9-3c18-affe-5633be75a85f",
                                                "text": "En arrivant aux urgences, il avait encore la trace d’un puissant anxiolytique et de plusieurs grammes d’alcool dans le sang."
                                            },
                                            {
                                                "example_id": "f8868385-b845-4cf4-b703-de6ca25d7583",
                                                "sense_id": "63fe3eff-a9e9-3c18-affe-5633be75a85f",
                                                "text": "Le contact avec la douce fourrure angora de Pupuce, lapine géante, agit comme un anxiolytique et apaise cet enfant atteint de polyhandicaps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
