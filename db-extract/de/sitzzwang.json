                ],
                "senses": [
                    {
                        "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                        "entry_id": "0f4ab41c-3e2e-3424-a561-f4b9581f9a03",
                        "glosses": [
                            "strikte Vorgabe zur Einnahme der sitzenden Körperhaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a8a8aa2-dac5-4bb0-9c5f-5b881831f045",
                                "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                                "text": "„Die Fixierung auf einen bestimmten Platz in Schule, elterlichem Fahrzeug, Bus oder Bahn wird als unangenehmer Sitzzwang empfunden.“"
                            },
                            {
                                "example_id": "b8ed744b-0198-406c-853d-19bc454cd31c",
                                "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                                "text": "„Seit darüber öffentlich diskutiert werden kann und das traditionelle Pinkelverhalten des Mannes als atavistisch gebrandmarkt wurde, trösten sich im Internet seitenweise Männerseelen, die sich durch den von weiblicher Übermacht erzwungenen Sitzzwang im eigenen Haus geknickt fühlen.“"
                            },
                            {
                                "example_id": "ec67fd2f-6d73-41c9-9700-3dcdbfc4bd50",
                                "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                                "text": "„Die neuen Hausherren führten Tischdecken und Sitzzwang ein.“"
                            },
                            {
                                "example_id": "729bf003-355d-44a6-8bb0-b420f2321b1f",
                                "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                                "text": "„Dieser aber kann nun einmal mit lebendigen und vom Sitzzwang gepeinigten Kindern nicht in Friedhofsruhe durchgeführt werden.“"
                            },
                            {
                                "example_id": "aa577bc6-7d32-4a85-92c4-82c4a4359b8f",
                                "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                                "text": "„Kein Sitzzwang und keinen Ärger darüber, 13 Mark für den falschen Film ausgegeben zu haben.“"
                            },
                            {
                                "example_id": "06914f8e-185d-4935-8469-60d298ccf5ac",
                                "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                                "text": "„Der Sitzzwang ist dramaturgisch bedingt.“"
                            },
                            {
                                "example_id": "990cd57c-34d5-4947-9594-f6188ec053c7",
                                "sense_id": "7eb3ad2c-5c81-3885-8313-c2096b82f3c9",
                                "text": "„Auch der Sitzzwang kann störend sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
