                                        "entry_id": "b4bbd9a7-bc2e-362c-ae4d-60670bf07742",
                                        "glosses": [
                                            "One who utters something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00be822c-8040-414c-bc26-ee227132d888",
                                                "sense_id": "7006829c-b4a6-3cb7-b9ea-b351528c74f8",
                                                "text": "The strange and beautiful being gazed on the spot with a look of horror; she wrung her hands as if in the helplessness of despair—a low cry came upon the wind, and its mysterious utterer had disappeared."
                                            },
                                            {
                                                "example_id": "e3a73cda-54a9-4a34-bebf-39d634c04177",
                                                "sense_id": "7006829c-b4a6-3cb7-b9ea-b351528c74f8",
                                                "text": "Some maintain that arbitration avoids prejudiced juries and sympathy verdicts, but such remarks may merely reflect their utterers' antijury bias."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
