                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496e0d1f-cf9f-44be-9b82-eaf47ddcdc56",
                                "sense_id": "d950e976-0361-3365-9c18-87a301b73e78",
                                "text": "“Een voordeel is dat er straks zeven verkeerslichten op elkaar afgestemd kunnen worden. Op die manier ontstaat een groene golf”, aldus wethouder Martin Velten. De verkeerslichten zijn bovendien ‘zelfdenkend’: ze meten het verkeersaanbod en passen zich aan, om filevorming te voorkomen."
                            },
                            {
                                "example_id": "64d86a39-ae42-4e2f-851c-ca8c8be25fce",
                                "sense_id": "d950e976-0361-3365-9c18-87a301b73e78",
                                "text": "Facebook heeft de bouw van slimme zelfdenkende robots vroegtijdig moeten afbreken. De robots in kunstmatige intelligentie bleken illegaal hun eigen taaltje te hebben ontwikkeld."
                            }
                        ]
