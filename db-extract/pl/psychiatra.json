                        "cross_references": [
                            {
                                "target_word": "psychiater",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1ff5e2-1af2-395f-bcdb-f335cb3cc099",
                                        "entry_id": "b7adce79-c94b-34ef-b136-575fba037be6",
                                        "glosses": [
                                            "een arts die zich gespecialiseerd heeft in de psychiatrie"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3cfa9fc-8994-487c-800b-a36aa16d9744",
                        "source_entry_id": "fdd5f6d7-6e5c-38d3-b160-f8fef40e20cf",
                        "source_sense_id": "72d23350-98a3-3720-a7b4-d550f3a46068",
                        "target_lang_word": "Psychiater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychiater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                        "entry_id": "3fc3e076-3a91-3ccb-99eb-d4b075f337ef",
                                        "glosses": [
                                            "Facharzt für Geistes- und Gemütskrankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f908a9-3fac-4d71-81a5-108bd693bd12",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "Der Psychiater hat den Kranken in das Krankenhaus für Neurologie und Psychiatrie eingewiesen."
                                            },
                                            {
                                                "example_id": "48642a70-efc8-49c2-b017-893d761cc26e",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Die Mutter einer Schizophrenen benachrichtigte den behandelnden Psychiater telefonisch, dass der Zustand ihrer Tochter sich wieder verschlechterte.“"
                                            },
                                            {
                                                "example_id": "29c0a2ef-cfec-478a-bc6a-d75d67e87920",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Ein Psychiater von heute hätte vielleicht die verschiedenartigsten narzißstischen Persönlichkeitsstörungen diagnostiziert.“"
                                            },
                                            {
                                                "example_id": "a8a3d7bc-51c1-4b5b-ac2d-4475fa64e102",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Ich wäre dann auf jeden Fall irrsinnig, aber es ist mir trotzdem nie eingefallen, zum Psychiater zu gehen.“"
                                            },
                                            {
                                                "example_id": "5cb63d82-949c-4e79-a015-b9f12d4a0fe7",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Man saß im Wartezimmer eines Psychiaters in Gesellschaft von lauter Bekloppten und fragte sich, ob man selber einer war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7427d01-2cfd-4179-af01-e51f71481d2d",
                        "source_entry_id": "fdd5f6d7-6e5c-38d3-b160-f8fef40e20cf",
                        "source_sense_id": "72d23350-98a3-3720-a7b4-d550f3a46068",
                        "target_lang_word": "психиатр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "психиатр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "425a4125-94f0-360d-9ec2-373c3acc547c",
                                        "entry_id": "92dbf109-61b3-3bb3-bede-1167aa6d4272",
                                        "glosses": [
                                            "мед. специалист в области психиатрии; врач, занимающийся психиатрией"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2abd5b3d-ec9b-4282-81e8-6d03ae6cd67a",
                                                "sense_id": "425a4125-94f0-360d-9ec2-373c3acc547c",
                                                "text": "Психиатры рассказывают, что один солдат, раненный при Ватерлоо, сошёл с ума и впоследствии уверял всех и сам в то верил, что он убит при Ватерлоо, а что то, что теперь считают за него, есть только его тень, отражение прошлого."
                                            },
                                            {
                                                "example_id": "e3596dd0-e876-4d22-9af6-62046bd44222",
                                                "sense_id": "425a4125-94f0-360d-9ec2-373c3acc547c",
                                                "text": "Прежде всего необходимо отрешиться от того взгляда, что проявления психических болезней, как мы их наблюдаем в клинике, служат выражением анатомических изменений мозга, и, следовательно, нет основания доискиваться и анатомической основы в разделении психозов, несмотря на сделанные в этом отношении попытки со стороны известных психиатров."
                                            },
                                            {
                                                "example_id": "aed8a902-82d7-4cec-ac1f-8dab41baa8c8",
                                                "sense_id": "425a4125-94f0-360d-9ec2-373c3acc547c",
                                                "text": "Когда со зловещим упорством стали повторяться приступы равнодушия к работе и жизни — одного из самых тяжёлых заболеваний человека, — Эвда Наль, знаменитый психиатр, исследовала его."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
