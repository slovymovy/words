                        ],
                        "examples": [
                            {
                                "example_id": "4320435b-87ad-4d48-9ec8-19c1d58f0bfb",
                                "sense_id": "4f2ad17e-c4e0-333b-9525-8a7f8a907147",
                                "text": "Obwohl ihre Tochter schon seit einer Woche verschwunden war, gaben die Eltern keine Abgängigkeitsanzeige bei der Polizei auf."
                            },
                            {
                                "example_id": "42ac5c8e-e1fa-41c1-b83c-64cac3015734",
                                "sense_id": "4f2ad17e-c4e0-333b-9525-8a7f8a907147",
                                "text": "„Nach der Veröffentlichung der Abgängigkeitsanzeige am Donnerstag teilte ein Radiohörer der Polizei den Aufenthaltsort der Jugendlichen mit.“"
                            }
