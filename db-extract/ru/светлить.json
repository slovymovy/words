                "senses": [
                    {
                        "sense_id": "83123cf1-f557-3a48-9f69-e61f5bff374c",
                        "entry_id": "710ab69d-cc8d-3243-a0e9-20e30b141c23",
                        "glosses": [
                            "разг. делать светлым или более светлым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b3f393-1056-459e-8a86-a0ee23746db7",
                                "sense_id": "83123cf1-f557-3a48-9f69-e61f5bff374c",
                                "text": "Стояла пасмурная, тихая, не очень холодная и не тёмная ночь, ― должно быть, месяц стоял за плёнкой зимнего тумана, да и снег светлил."
                            },
                            {
                                "example_id": "0e16aebf-0419-43d3-8b8a-fb229a24b361",
                                "sense_id": "83123cf1-f557-3a48-9f69-e61f5bff374c",
                                "text": "Огни приближавшегося полустанка все более светлили мглистый мрак снаружи; видны стали лапти и поношенные сермяжки векшинских спутников."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f30e96d7-ecbe-4b47-a3aa-dd77b6deba08",
                        "source_entry_id": "710ab69d-cc8d-3243-a0e9-20e30b141c23",
                        "source_sense_id": "83123cf1-f557-3a48-9f69-e61f5bff374c",
                        "target_lang_word": "lighten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lighten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b4f779-8075-3554-9190-f9f885b27811",
                                        "entry_id": "0761af3b-9202-3b5a-a3af-37d9649141e3",
                                        "glosses": [
                                            "To make brighter or clearer; to illuminate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d071c3f-7b93-41e5-b9d2-ecc5b03d4662",
                                                "sense_id": "b1b4f779-8075-3554-9190-f9f885b27811",
                                                "text": "to lighten an apartment with lamps or gas; to lighten the streets"
                                            },
                                            {
                                                "example_id": "e9dc632d-da3a-493d-8349-c333891fe7e8",
                                                "sense_id": "b1b4f779-8075-3554-9190-f9f885b27811",
                                                "text": "A Key of fire ran all along the shore,\nAnd lighten’d all the river with the blaze:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4514a7ed-d873-3122-99b7-12b29165f820",
                                        "entry_id": "0761af3b-9202-3b5a-a3af-37d9649141e3",
                                        "glosses": [
                                            "To become brighter or clearer; to brighten."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18de9f53-0f8a-3046-a29f-9456cfd81fe5",
                                        "entry_id": "0761af3b-9202-3b5a-a3af-37d9649141e3",
                                        "glosses": [
                                            "To flash lightning, to give off lightning."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1603cd68-f161-48ad-9b05-038a7b31f28a",
                                                "sense_id": "18de9f53-0f8a-3046-a29f-9456cfd81fe5",
                                                "text": "Enter the Conjurer; it lightens and thunders […]"
                                            },
                                            {
                                                "example_id": "7e9be60f-4618-44bd-9bea-529471f9e453",
                                                "sense_id": "18de9f53-0f8a-3046-a29f-9456cfd81fe5",
                                                "text": "[…] this dreadful night,\nThat thunders, lightens, opens graves, and roars\nAs doth the lion."
                                            },
                                            {
                                                "example_id": "914bbec9-85fd-494e-9616-5fcd929243b8",
                                                "sense_id": "18de9f53-0f8a-3046-a29f-9456cfd81fe5",
                                                "text": "While we were in the Twins it began to thunder and lighten and pour with rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1d1240-adbc-3951-9198-a69593a64821",
                                        "entry_id": "0761af3b-9202-3b5a-a3af-37d9649141e3",
                                        "glosses": [
                                            "To emit or disclose in, or as if in, lightning; to flash out, like lightning."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09abc542-30ad-4a45-a6b6-72876775f897",
                                                "sense_id": "2a1d1240-adbc-3951-9198-a69593a64821",
                                                "text": "[…] behold his eye,\nAs bright as is the eagle’s, lightens forth\nControlling majesty:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecdb4ce6-ba11-30e6-bbe1-8b110ed0a482",
                                        "entry_id": "0761af3b-9202-3b5a-a3af-37d9649141e3",
                                        "glosses": [
                                            "To illuminate with knowledge."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed3b961c-b275-4ed3-8429-0c5ae3c27478",
                                                "sense_id": "ecdb4ce6-ba11-30e6-bbe1-8b110ed0a482",
                                                "text": "O Light which mak’st the Light, which makes the Day,\nWhich setst the Eye without and Mind within,\nLighten my spirit with one cleare heavenly ray,\nWhich now to view it selfe doth first begin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lighten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4841c186-23e3-34b8-9682-f07f84b20030",
                                        "entry_id": "c4027078-1bae-33a2-b9ed-1f9bf5623af9",
                                        "glosses": [
                                            "To alleviate; to reduce the burden of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8a5027-5334-47ae-993e-4eabea9fe07f",
                                                "sense_id": "4841c186-23e3-34b8-9682-f07f84b20030",
                                                "text": "Sorrow can be lightened by being openly brought out."
                                            },
                                            {
                                                "example_id": "1c76630f-21f2-4a25-9e9a-1ee96d69c1bc",
                                                "sense_id": "4841c186-23e3-34b8-9682-f07f84b20030",
                                                "text": "She cites a 2015 British poll conducted by the Family Holiday Association that found vacations can serve as “happiness anchors” that provide memories of familial joy to lighten the burdens of adulthood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd963429-5288-33b4-8e05-660e08796e02",
                                        "entry_id": "c4027078-1bae-33a2-b9ed-1f9bf5623af9",
                                        "glosses": [
                                            "To make light or lighter in weight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad4e413c-09ac-3c48-8ec4-b87eb1314128",
                                        "entry_id": "c4027078-1bae-33a2-b9ed-1f9bf5623af9",
                                        "glosses": [
                                            "To make less serious or more cheerful."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8d342a6-7244-487d-9912-542346bbb6f8",
                                                "sense_id": "ad4e413c-09ac-3c48-8ec4-b87eb1314128",
                                                "text": "They looked unto him, were lightened: and their faces were not ashamed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d9e43be-15cd-3d26-8183-686fe993fa76",
                                        "entry_id": "c4027078-1bae-33a2-b9ed-1f9bf5623af9",
                                        "glosses": [
                                            "To become light or lighter in weight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b31adcc4-75d5-31b4-98ed-fcafd89a5e9f",
                                        "entry_id": "c4027078-1bae-33a2-b9ed-1f9bf5623af9",
                                        "glosses": [
                                            "To become less serious or more cheerful."
                                        ],
