                        "empiéter sur la propriété"
                    ]
                },
                {
                    "sense_id": "698d04aa-34ea-3a2e-abaa-eeadf1b95644",
                    "sense_definition": "Déborder et s'étendre progressivement au-delà de ses limites naturelles, en parlant des eaux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec l'érosion constante, les vagues de la mer <w>empiètent</w> chaque hiver sur la falaise."
                        },
                        {
                            "text": "Après ces pluies torrentielles, le fleuve commence à <w>empiéter</w> sur les berges voisines."
                        }
                    ],
                    "synonyms": [
