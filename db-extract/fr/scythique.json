                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d07864-7ad6-48f5-9289-dca519325e6b",
                                "sense_id": "f42ff0df-fbd6-38d0-904d-b1955126a3c6",
                                "text": "Les nations scythiques."
                            },
                            {
                                "example_id": "71e63f5e-75c7-41a0-a005-98f17c985663",
                                "sense_id": "f42ff0df-fbd6-38d0-904d-b1955126a3c6",
                                "text": "Nous ne sommes pas des Russiens accoutumés aux frimas scythiques pour hiverner ici jusqu’à demain matin, le derrière dans la neige."
                            }
                        ]
                    }
                ],
                "translations": [
