                        "glosses": [
                            "Mouvement artistique fictif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3064a1dc-ab7e-41fe-ac1c-32ec31aa4a7b",
                                "sense_id": "b3f07220-5fc9-3970-9f59-f93717718907",
                                "text": "Mon pauvre vieux, nous avions inventé, autrefois, le conisme, pour rire. Ils ont fait pire. Je connais sculpteurs qui ne touchent pas à la glaise ; […]."
                            },
                            {
                                "example_id": "fa2b545e-3530-4211-b3e8-53ec2c0d91b4",
                                "sense_id": "b3f07220-5fc9-3970-9f59-f93717718907",
                                "text": "Si le Conisme est un mouvement fictif, ses peintures sont elles bien réelles. Et par cette forme parodique et iconoclaste, nous partageons notre questionnement et tentons d’amener le spectateur à s’interroger sur son propre rapport à la peinture."
                            }
                        ]
                    }
