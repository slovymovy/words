                                "target_senses": [
                                    {
                                        "sense_id": "c88b471a-9bb2-3848-b6ca-bf0e7d11af1a",
                                        "entry_id": "5579fe39-ac23-36eb-b90c-95759fb6c4f5",
                                        "glosses": [
                                            "Offering nothing that is stimulating or challenging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bec09e4-d18e-4e9e-ad18-994f8179ef0f",
                                                "sense_id": "c88b471a-9bb2-3848-b6ca-bf0e7d11af1a",
                                                "text": "In Koons' best-known works—a life-sized poly-chromed wood replica of Michael Jackson and his pet chimp Bubbles; vapid fin de siècle readymades such as a trio of basketballs floating in a fishtank […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e7e7aa-74e0-39ce-af50-b3b1b8a64187",
                                        "entry_id": "5579fe39-ac23-36eb-b90c-95759fb6c4f5",
                                        "glosses": [
                                            "Lifeless, dull, or banal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff7415f-4f4d-4a31-a1ac-031e60fc1e46",
                                                "sense_id": "e3e7e7aa-74e0-39ce-af50-b3b1b8a64187",
                                                "text": "Then there was a little more trite conversation between Mr. Arabin and Mr. Harding; trite, and hard, and vapid, and senseless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f585ae87-0764-302f-b18e-305dc2fd8cc6",
                                        "entry_id": "5579fe39-ac23-36eb-b90c-95759fb6c4f5",
                                        "glosses": [
                                            "Tasteless, bland, or insipid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a465629c-6a42-4a69-95d2-1eb590663d39",
                        "source_entry_id": "85c9dad3-15c6-38f4-89af-917357c0c76b",
                        "target_lang_word": "soppy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soppy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47b3d43d-fe1a-3d9b-80d8-e02d18723e3b",
                                        "entry_id": "0b015b8e-b55a-3d7a-9d18-2a8cc8781f68",
                                        "glosses": [
                                            "Very wet; sodden, soaked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "738b998f-66e3-4f23-96d0-50afb30b87dd",
                                                "sense_id": "47b3d43d-fe1a-3d9b-80d8-e02d18723e3b",
                                                "text": "Yarmouth […] looked rather spongy and soppy, I thought, as I carried my eye over the great dull waste that lay across the river; and I could not help wondering, if the world were really as round as my geography book said, how any part of it came to be so flat."
                                            },
                                            {
                                                "example_id": "d0f94a43-cd13-4e74-9972-896b72fde04e",
                                                "sense_id": "47b3d43d-fe1a-3d9b-80d8-e02d18723e3b",
                                                "text": "'Goodness me!' said I to myself, 'whatever will become of sister's white satin shoes, if she has to walk about on soppy grass after such rain as this?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5105de11-e297-3fef-9340-69fd28411319",
                                        "entry_id": "0b015b8e-b55a-3d7a-9d18-2a8cc8781f68",
                                        "glosses": [
                                            "Overly sentimental, maudlin, schmaltzy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0ccf39-dde3-4cd1-9309-335e754bdb97",
                                                "sense_id": "5105de11-e297-3fef-9340-69fd28411319",
                                                "text": "\"[…] It's unfortunate, if I happen to look like what pleased some soppy old Greek sculptor, but I assure you that if it weren't for my face I'd be a quiet nun in the convent without\"—then she broke into a run and her raised voice floated back to him as he followed—\"my precious babies, which I must go back and see.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9074fad0-df3c-4404-8f7e-ac81f2c1363e",
                        "source_entry_id": "85c9dad3-15c6-38f4-89af-917357c0c76b",
                        "target_lang_word": "mawkish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mawkish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2cf71ed-303d-339a-849d-23413619c8c7",
                                        "entry_id": "794d83a2-f9dd-35bc-b3c7-0b9efd7dd10f",
                                        "glosses": [
                                            "Excessively or falsely sentimental; showing a sickly excess of sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57451f60-f2d6-470e-a68e-42959c2028fb",
                                                "sense_id": "e2cf71ed-303d-339a-849d-23413619c8c7",
                                                "text": "After all, a vague, archaic, mostly harmless tradition fraught with pomp and ceremony and mawkish self-aggrandising with a bit of royalty thrown in is about the most British thing imaginable and would never happen in a boring sensible country like Germany."
                                            },
                                            {
                                                "example_id": "5e062c4b-7b13-4b98-8b61-18f04068fc82",
                                                "sense_id": "e2cf71ed-303d-339a-849d-23413619c8c7",
                                                "text": "Some of Mr. Williams’s performances were criticized for a mawkish sentimentality, like “Patch Adams,” a 1998 film that once again cast him as a good-hearted doctor, and “Bicentennial Man,” a 1999 science-fiction feature in which he played an android."
                                            },
                                            {
                                                "example_id": "6ecd0df8-ef57-40a3-9eeb-408c23dca603",
                                                "sense_id": "e2cf71ed-303d-339a-849d-23413619c8c7",
                                                "text": "I found [Christoph] Buchel’s appropriation of the boat in which so many migrants lost their lives a vile and mawkish spectacle in the context of the biennale."
                                            },
                                            {
                                                "example_id": "ccfbd075-d0d7-427f-9f67-d0519aa0f5aa",
                                                "sense_id": "e2cf71ed-303d-339a-849d-23413619c8c7",
                                                "text": "The tabloids branded him James Hewitt forevermore as the “love rat,” and Pasternak was excoriated for peddling mawkish fantasy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0b05b57-a243-3455-b176-71f0e5241bde",
                                        "entry_id": "794d83a2-f9dd-35bc-b3c7-0b9efd7dd10f",
                                        "glosses": [
                                            "Feeling sick, queasy."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cce9c69e-ed7c-3f92-b942-93d81391fc91",
                                        "entry_id": "794d83a2-f9dd-35bc-b3c7-0b9efd7dd10f",
                                        "glosses": [
                                            "Sickening or insipid in taste or smell."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4225676-7fbd-4f55-a51e-f07b0f3bb135",
                        "source_entry_id": "85c9dad3-15c6-38f4-89af-917357c0c76b",
                        "target_lang_word": "namby-pamby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "namby-pamby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "676c5ee7-ea60-395f-8c39-896f18ec1abc",
                                        "entry_id": "bb0b3ea8-b683-3f05-b292-a78e909933b8",
                                        "glosses": [
                                            "Insipid and sentimental."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6f30c5d-1070-3a4d-9f36-a969325672fa",
                                        "entry_id": "bb0b3ea8-b683-3f05-b292-a78e909933b8",
                                        "glosses": [
                                            "Lacking vigor or decisiveness; spineless; wishy-washy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d027d8c-ad4d-4d63-b0a2-e19082653971",
                                                "sense_id": "f6f30c5d-1070-3a4d-9f36-a969325672fa",
                                                "text": "[…] she was still, as heretofore, a namby-pamby milk-and-water affected creature […]"
                                            },
                                            {
                                                "example_id": "d76c30c0-fc7e-48e4-aa7d-d99b5906cdce",
                                                "sense_id": "f6f30c5d-1070-3a4d-9f36-a969325672fa",
                                                "text": "We can honestly commend the Atlantic Monthly as the most able and spirited of American periodicals, at the present time, and we like it, moreover, because it dares have opinions and to express them in unmistakable terms, on subjects which when referred to at all, by most of the current magazines, are mentioned in the gingerliest namby-pamby style of common place neutrality."
                                            },
                                            {
                                                "example_id": "dccc739f-55d2-43b6-b56e-b4f9a7f68ab1",
                                                "sense_id": "f6f30c5d-1070-3a4d-9f36-a969325672fa",
                                                "text": "She boasts to Bentley that the Prince of Wales admires her books for the “fearless courage” of her opinions. “He said, ‘There is no namby-pamby nonsense about you – you write with a man’s pen, and I should think you would fight your enemies like a man!’ These words delighted me, for to be ‘namby-pamby’ would be a horror to me,” she writes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "namby-pamby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4f2a28-b589-32bf-a328-0c8f97379a68",
                                        "entry_id": "537d4c57-7ee4-3fd7-8c2f-63645dfc1b75",
                                        "glosses": [
                                            "One who is insipid, sentimental, or weak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f4f343-59fc-44e6-ae4f-5409edc42b23",
                                                "sense_id": "0d4f2a28-b589-32bf-a328-0c8f97379a68",
                                                "text": "Namby Pamby’s doubly Mild,\n Once a Man, and twice a Child;\n To his Hanging-Sleeves restor’d\n Now he foots it like a Lord;\n Now he Pumps his little Wits;\n Sh—ing Writes and Writing Sh—s,^([sic])"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17724420-0dd8-38b8-b0d4-6c07d046fd04",
                                        "entry_id": "537d4c57-7ee4-3fd7-8c2f-63645dfc1b75",
                                        "glosses": [
                                            "Talk or writing which is weakly sentimental or affectedly pretty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332eda39-55ef-4646-bf39-5d2a0365a7da",
                                                "sense_id": "17724420-0dd8-38b8-b0d4-6c07d046fd04",
                                                "text": "Another of Addison’s favourite companions was Ambrose Phillipps, a good Whig and a middling poet, who had the honour of bringing into fashion a species of composition which has been called, after his name, Namby-Pamby."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "namby-pamby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfed5e7e-e4ab-3f50-80ba-4fe271a018ee",
                                        "entry_id": "c324b582-faa8-3de3-b3c0-7a360285f50b",
                                        "glosses": [
                                            "To coddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e0d8e6-1b37-461b-bae0-5349bad513f9",
                                                "sense_id": "bfed5e7e-e4ab-3f50-80ba-4fe271a018ee",
                                                "text": "While we business men of Britain have little time for this sort of namby-pambying towards the next generation, who are often feckless, tearful, small, dirty or all of the above, there is no doubt that youths have their place in commerce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
