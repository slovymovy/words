                ],
                "senses": [
                    {
                        "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                        "entry_id": "691fd0e5-1e68-3094-9ee0-513952677834",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46a42378-d4cc-426a-8866-9853b593d7c1",
                                "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                                "text": "Frau Gebhart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6d1b314b-c8b0-46f6-84c2-222cfbc832be",
                                "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                                "text": "Herr Gebhart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e8d2801-b099-4894-8e5f-2c3aacaeb569",
                                "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                                "text": "Die Gebharts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "814b1acb-4198-48b0-b92d-60eee28ea517",
                                "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                                "text": "Der Gebhart trägt nie die Schals, die die Gebhart ihm strickt."
                            },
                            {
                                "example_id": "4fa68953-d0bd-48f1-a344-9e2e94aded1e",
                                "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebhart kommt, geht der Herr Gebhart.“"
                            },
                            {
                                "example_id": "46e27c13-3f85-4baf-a54a-d024d9a7df2b",
                                "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                                "text": "Gebhart kommt und geht."
                            },
                            {
                                "example_id": "3cafb1ff-3c36-48f1-a467-ad0eb4159b7a",
                                "sense_id": "d29bbcde-7bbb-3e55-8d7e-9c9ec7567868",
                                "text": "Gebharts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
