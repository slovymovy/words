                ],
                "senses": [
                    {
                        "sense_id": "2653a5cc-eed8-3113-bc39-cd97a3b73965",
                        "entry_id": "1f5b5cc0-a214-3c61-bede-6d993afd82ee",
                        "glosses": [
                            "in der Art eines Gönners, in herablassender Weise"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "2d354378-c9d9-4558-a4ce-77072e6871e5",
                                "sense_id": "2653a5cc-eed8-3113-bc39-cd97a3b73965",
                                "text": "„Leroy nickte so gönnerisch, als nähme er eine Parade ab, und ließ den Wagen betont langsam auf das Anwesen rollen.“"
                            },
                            {
                                "example_id": "17a535e0-4c91-4fe3-b529-59c3fac6d140",
                                "sense_id": "2653a5cc-eed8-3113-bc39-cd97a3b73965",
                                "text": "„Dieser eitle Mensch packt doch tatsächlich mit den Händen seinen Hintern und lacht gönnerisch, wohl im Glauben, dass er das Geschenk an die Frauenwelt ist.“"
                            },
                            {
                                "example_id": "67aecd17-8095-4986-bcd4-41e7fd69b1a9",
                                "sense_id": "2653a5cc-eed8-3113-bc39-cd97a3b73965",
                                "text": "„Er ließ sich wieder in seinen Sessel plumpsen und verschränkte gönnerisch die Arme vor der Brust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
