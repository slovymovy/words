                    "frequency": "Middle",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau <w>coordinateur</w> de projet anime la réunion chaque lundi matin."
                        },
                        {
                            "text": "Elle a contacté le <w>coordinateur</w> pour obtenir le calendrier définitif des ateliers."
                        }
                    ],
