                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e365c1-7c37-4162-8401-81d054175252",
                                                "sense_id": "4e375975-abb1-3230-a080-4822c38bb95d",
                                                "text": "This supermarket chain adopts several families every Yuletide, providing them with money and groceries for the holidays."
                                            },
                                            {
                                                "example_id": "4db33820-9949-4625-a972-baf2d63c12ed",
                                                "sense_id": "4e375975-abb1-3230-a080-4822c38bb95d",
                                                "text": "Sixteen years ago, the station entered into a new chapter when it was adopted by the Friends of Chirk Station (FoCS) volunteer group, under the Arriva Trains Wales Station Adopters programme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5974329c-46c3-37c3-bb15-74230e51b4bc",
                                        "entry_id": "04251ff8-8dfc-3384-bb3c-ac31a369495d",
                                        "glosses": [
                                            "To take or receive as one's own what is not so naturally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2906af-3bf4-48b3-8fc9-0612ce1787e0",
                                                "sense_id": "5974329c-46c3-37c3-bb15-74230e51b4bc",
                                                "text": "He adopted a new look in order to fit in with his new workmates."
                                            },
                                            {
                                                "example_id": "89a707ce-8c00-4653-a4f3-2b9bf48c6465",
                                                "sense_id": "5974329c-46c3-37c3-bb15-74230e51b4bc",
                                                "text": "[S]he [Edwina, mother of Tennessee Williams] was indeed Amanda [Wingfield, character in Williams' play The Glass Menagerie] in the flesh: a doughty chatterbox from Ohio who adopted the manner of a Southern belle and eschewed both drink and sex to the greatest extent possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b0a6d0b-9851-3972-887b-9ef3f038c95d",
                                        "entry_id": "04251ff8-8dfc-3384-bb3c-ac31a369495d",
                                        "glosses": [
                                            "To select and take or approve."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b31f9e11-4502-45be-9c06-12272f596cf5",
                                                "sense_id": "7b0a6d0b-9851-3972-887b-9ef3f038c95d",
                                                "text": "to adopt the view or policy of another"
                                            },
                                            {
                                                "example_id": "8a9e34ff-74ad-4bc4-8f98-6b9126e2051a",
                                                "sense_id": "7b0a6d0b-9851-3972-887b-9ef3f038c95d",
                                                "text": "These are resolutions that were adopted."
                                            },
                                            {
                                                "example_id": "4b6c64c6-397d-4226-983e-8596ae1cb85e",
                                                "sense_id": "7b0a6d0b-9851-3972-887b-9ef3f038c95d",
                                                "text": "Every society should adopt an order of business adapted to its special wants."
                                            },
                                            {
                                                "example_id": "078bcfd2-128c-4b78-a765-f2482c999ca9",
                                                "sense_id": "7b0a6d0b-9851-3972-887b-9ef3f038c95d",
                                                "text": "Having found a property that 'feels' right you then have to adopt a hard-headed attitude and consider the realities of life in a new environment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc1501b-8ae6-3384-9449-fc7f435e484c",
                                        "entry_id": "04251ff8-8dfc-3384-bb3c-ac31a369495d",
                                        "glosses": [
                                            "To beat an opponent ten times in a row."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e708d698-a53d-4b52-a7d9-045ba9a4fb71",
                                                "sense_id": "dbc1501b-8ae6-3384-9449-fc7f435e484c",
                                                "text": "The match was not even close; the IM made amateurish blunders and ended up getting adopted."
                                            },
                                            {
                                                "example_id": "3eecdd15-c050-4497-8116-5970397404e5",
                                                "sense_id": "dbc1501b-8ae6-3384-9449-fc7f435e484c",
                                                "text": "Nakamura 'Adopts' Komodo On Fathers Day: 20.5-2.5"
                                            },
                                            {
                                                "example_id": "62e1caa5-0b85-4e5f-aacb-d9c288d10ad7",
                                                "sense_id": "dbc1501b-8ae6-3384-9449-fc7f435e484c",
                                                "text": "Wednesday's event will offer the Russian grandmaster three opportunities to adopt Rensch, though just like in the Speed Chess Championship, Nepomniachtchi will have to race against the clock."
                                            },
                                            {
                                                "example_id": "30bb822c-723b-4560-87fd-1d86eb3535f0",
                                                "sense_id": "dbc1501b-8ae6-3384-9449-fc7f435e484c",
                                                "text": "\"That's it, that's it!\" the Grandmaster Eric Hansen bellowed after following nine straight losses with a win. \"You are not adopting me! Not today, not today!\""
                                            },
                                            {
                                                "example_id": "ad437460-70e6-4627-861f-cb34a6bac948",
                                                "sense_id": "dbc1501b-8ae6-3384-9449-fc7f435e484c",
                                                "text": "There was wasn't much for Gukesh fans to cheer, but at least he avoided the fate of Maghsoodloo, who was \"adopted\", i.e. beaten 10 games in a row. Gukesh struck in the 2nd 3+1 game, when he was dangerously close to that mark."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adopt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14199fa0-a49d-3703-abc5-8fb2f4a76755",
                                        "entry_id": "1583a7b1-9f74-3a80-a6eb-292f340fb842",
                                        "glosses": [
                                            "Clipping of adoptable."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
