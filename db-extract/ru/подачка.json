                "senses": [
                    {
                        "sense_id": "e64d7853-5264-3dc3-94e5-fa29e2f4b3c2",
                        "entry_id": "9995509c-4eaf-3eb2-85c9-1ad4164daf57",
                        "glosses": [
                            "то, что даётся из жалости, из милости; подаяние, пожертвование"
                        ],
                        "tags": [],
