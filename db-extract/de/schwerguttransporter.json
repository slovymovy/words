                "senses": [
                    {
                        "sense_id": "6e0f01f2-42c4-3d73-8579-49abc62a181f",
                        "entry_id": "7e771e07-e133-31d2-9234-8a03dc48a62b",
                        "glosses": [
                            "großes, zur Beförderung von Gütern von sehr hohem Gewicht und Ausmaß genutztes Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea16cafd-8d3a-4464-91ff-72d5f419e676",
                                "sense_id": "6e0f01f2-42c4-3d73-8579-49abc62a181f",
                                "text": "„Auf einem Schwerguttransporter waren Propeller für Schiffsschrauben mit einem Gesamtgewicht von 23 Tonnen völlig ungesichert und so auf die Ladefläche gestellt worden, dass die vorderen Achsen überladen waren.“"
                            },
                            {
                                "example_id": "0e595a79-61d2-49ca-b90b-4825531db5e1",
                                "sense_id": "6e0f01f2-42c4-3d73-8579-49abc62a181f",
                                "text": "„So können zum Beispiel die Schwerguttransporter der Reederei von Hans und Klaus Heinrich in Steinkirchen mit den beiden Bordkränen zusammen bis zu 750 Tonnen heben und an Deck nehmen.“"
                            },
                            {
                                "example_id": "16c49a6c-6920-49ee-b819-0d55468965af",
                                "sense_id": "6e0f01f2-42c4-3d73-8579-49abc62a181f",
                                "text": "„Gefährdet sind vor allem kleinere Schiffe sowie Tanker und Schwerguttransporter mit niedriger Bordwand und geringer Höchstgeschwindigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
