                        ]
                    },
                    {
                        "translation_id": "4cd4257f-4318-4d11-ae1d-02aa1094d469",
                        "source_entry_id": "d90737c4-62fa-3660-9961-3474abe14615",
                        "source_sense_id": "ed8302ff-fb00-341a-8f0d-063d9b6498b2",
