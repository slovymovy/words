                "senses": [
                    {
                        "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                        "entry_id": "a9f4574f-cb8f-3e3d-a6d0-ad7cd3377108",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a04403e-ab10-4af5-a41f-9eb3ff7d0bbf",
                                "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                                "text": "Frau Hallermeier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "79209793-c436-4767-8ce3-77acc2b731c6",
                                "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                                "text": "Herr Hallermeier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d72001b3-252c-42df-ba02-1bc2c8d72860",
                                "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                                "text": "Die Hallermeiers kommen heute aus Irland."
                            },
                            {
                                "example_id": "7954a534-ce62-473f-81ac-0bbf753b137d",
                                "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                                "text": "Der Hallermeier trägt nie die Schals, die die Hallermeier ihm strickt."
                            },
                            {
                                "example_id": "88593e64-9093-4f0f-8d06-dade99777dc1",
                                "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hallermeier kommt, geht der Herr Hallermeier.“"
                            },
                            {
                                "example_id": "e314c79c-e3b1-467c-8b78-e3d087815add",
                                "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                                "text": "Hallermeier kommt und geht."
                            },
                            {
                                "example_id": "4d9a45e5-d4c0-43b2-8ebd-027c1b495e88",
                                "sense_id": "d3e5edb4-16c7-30b0-b7c8-5bbb45336650",
                                "text": "Hallermeiers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
