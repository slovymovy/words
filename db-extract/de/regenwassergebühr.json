                "senses": [
                    {
                        "sense_id": "c9bec2e8-66e7-3d27-ac03-66bd98f56ec6",
                        "entry_id": "b17ebca5-918d-3116-8389-61de00fac353",
                        "glosses": [
                            "Abgabe für die Inanspruchnahme der öffentlichen Abwasseranlage durch eingelassenes Regenwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d8b609-f80e-46c8-a5a1-94637ab316c1",
                                "sense_id": "c9bec2e8-66e7-3d27-ac03-66bd98f56ec6",
                                "text": "„Die Höhe der Regenwassergebühr richtet sich nach der angeschlossenen Fläche.“"
                            },
                            {
                                "example_id": "54ff6066-49fa-49a8-96f7-e6cc03eef5b8",
                                "sense_id": "c9bec2e8-66e7-3d27-ac03-66bd98f56ec6",
                                "text": "„Damit werden aus der einen Gebühr zukünftig zwei Gebühren, die Schmutzwassergebühr und die Regenwassergebühr.“"
                            },
                            {
                                "example_id": "bd230224-49d5-4d44-9604-fecfe51c6b2a",
                                "sense_id": "c9bec2e8-66e7-3d27-ac03-66bd98f56ec6",
                                "text": "„Denn die Regenwassergebühr betrifft beide Gebührenmaßstäbe, da einerseits weniger Regenwasser dem Kanal zufließt, andererseits Trinkwasser ersetzt werden kann, dabei aber weiterhin Schmutzwasser aus WC und Waschküche anfällt.“"
                            },
                            {
                                "example_id": "d2851f50-f930-4279-a520-7de5f16faf00",
                                "sense_id": "c9bec2e8-66e7-3d27-ac03-66bd98f56ec6",
                                "text": "„Begründet wird das damit, dass die Regenwassergebühr nicht nach einem Wirklichkeitsmaßstab, sondern nach einem Wahrscheinlichkeitsmaßstab erhoben wird, der eine Pauschalierung bei der Art der Befestigung zulässt und keine weitere Differenzierung nach dem Grad der Verdichtung verlangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
