        "fr-extract.jsonl": [
            {
                "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                "word": "commodité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43dc0a4f-c575-4727-9da3-a12ef64c3b8d",
                        "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "tags": [
                            "plural"
                        ],
                        "form": "commodités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                        "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "glosses": [
                            "Tout ce qui facilite l’usage d’une chose et la rend utile et agréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7053d668-39bd-4492-aae8-db90cbe4ca03",
                                "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                                "text": "Les dégagements font toute la commodité d’une maison."
                            },
                            {
                                "example_id": "d2774fff-f23c-4f1a-b693-ef9b88061671",
                                "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                                "text": "Pour plus de commodité."
                            },
                            {
                                "example_id": "5594b883-1964-4dc1-b7eb-46670d70c398",
                                "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                                "text": "Le voisinage du parc nous procure la commodité de la promenade."
                            },
                            {
                                "example_id": "d9c8677e-c489-445b-9b28-df945d903629",
                                "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                                "text": "Faites cela à votre commodité."
                            },
                            {
                                "example_id": "b89acfdd-0d83-4e29-bbc9-6ea419923ed1",
                                "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                                "text": "Ribadier. — Ah ! mais, je vous en prie, à votre commodité !"
                            },
                            {
                                "example_id": "8e854964-795d-4e5b-a740-b54fb1eb9d5a",
                                "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                                "text": "Je pensai un instant à dire comment j’avais rencontré Patricia. Mais un réflexe obscur m’inspira de préférer les commodités du mensonge que Sybil m’offrait elle-même."
                            },
                            {
                                "example_id": "89bd8d1f-9376-4e7f-8146-33f847f1c02e",
                                "sense_id": "d379300e-612f-3d78-b534-66541f22b788",
                                "text": "La commodité compte toujours beaucoup pour le consommateur, me dit-il."
                            }
                        ]
                    },
                    {
                        "sense_id": "ced85358-9bda-387f-9c25-659f372d02c1",
                        "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "glosses": [
                            "Tout ce qui facilite l’usage d’une chose et la rend utile et agréable.",
                            "Aménagement destiné au confort d'une maison d'habitation."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "914e46da-f20c-427e-a413-9ceeca3ec9b3",
                                "sense_id": "ced85358-9bda-387f-9c25-659f372d02c1",
                                "text": "Il y a bien des commodités dans cette maison-là."
                            },
                            {
                                "example_id": "9fe1ec86-6319-48fd-b99c-10a0b68ee510",
                                "sense_id": "ced85358-9bda-387f-9c25-659f372d02c1",
                                "text": "C’est un petit appartement où l’on a toutes les commodités."
                            },
                            {
                                "example_id": "761b0063-f9ac-4670-828e-799d61b70e14",
                                "sense_id": "ced85358-9bda-387f-9c25-659f372d02c1",
                                "text": "Il préférait descendre chez un sien ami, dans la demeure de qui il trouverait des commodités particulières pour certains apprêts techniques de la dernière minute."
                            },
                            {
                                "example_id": "b41f4b1c-93e7-4dad-af9b-544857a5f4b4",
                                "sense_id": "ced85358-9bda-387f-9c25-659f372d02c1",
                                "text": "Mᵐᵉ Maigret acceptait la situation comme elle acceptait tout, sans étonnement, sans fièvre. Elle était depuis une heure dans la chambre, que cette chambre devenait sa chambre, qu’elle y apportait ses petites commodités, sa note personnelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "abc6def2-c501-3044-b97e-8cdf79fae423",
                        "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "glosses": [
                            "Tout ce qui facilite l’usage d’une chose et la rend utile et agréable.",
                            "Facilités d'accès à des lieux comme les commerces, les transports, les distractions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3823fad-96ce-4495-b833-5c709faeb20c",
                                "sense_id": "abc6def2-c501-3044-b97e-8cdf79fae423",
                                "text": "La commodité de la rapidité d'accès à l’hôtel."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc55b84f-ae11-3494-94e5-f9a1cf712ce5",
                        "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "glosses": [
                            "Toilettes."
                        ],
                        "tags": [
                            "obsolete",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a435b9c1-1dba-4e5a-a296-be7a79211d60",
                                "sense_id": "fc55b84f-ae11-3494-94e5-f9a1cf712ce5",
                                "text": "Je me suis levé en direction des chiottards. Je me suis faufilé entre les convives. Les commodités étaient à l’autre bout de l’endroit."
                            },
                            {
                                "example_id": "6e20668c-6753-46d3-ab8f-00d852a55cc2",
                                "sense_id": "fc55b84f-ae11-3494-94e5-f9a1cf712ce5",
                                "text": "– Où sont les commodités, je vous prie ? est la seule réponse que je trouve à lui faire.\nC’est, je vous le concède, légèrement abrupt.\n– Oh, je suis désolé, je ne vous les ai pas indiquées, dit M. Ozu avec un parfait naturel. La porte derrière vous, puis deuxième à droite dans le couloir."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d299a4d-2d9b-3ded-ab7c-d8dfe9d48d50",
                        "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "glosses": [
                            "Il s’emploie dans le sens du mot anglais commodity, « denrée », emphatiquement, en jouant sur les significations en français et en anglais."
                        ],
                        "tags": [
                            "Anglicism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "982d77a5-6751-4283-b6fd-dcfea33b9953",
                                "sense_id": "8d299a4d-2d9b-3ded-ab7c-d8dfe9d48d50",
                                "text": "L'eau est un droit, pas une commodité."
                            }
                        ]
                    },
                    {
                        "sense_id": "deae2d25-6bd4-3290-8838-3d063d40f409",
                        "entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "glosses": [
                            "Se dit des chaises, des fauteuils « les commodités de la conversation »"
                        ],
                        "tags": [
                            "formal",
                            "obsolete",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "16a7dc4f-7114-4e50-85f5-e41957f879fc",
                                "sense_id": "deae2d25-6bd4-3290-8838-3d063d40f409",
                                "text": "Vite, voiturez-nous ici les commodités de la conversation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bfd5c60-0947-4fc2-a58b-0b14ede0b42b",
                        "source_entry_id": "ed6b4c38-8ade-3f06-86ac-ebe503870dd8",
                        "source_sense_description": "Facilité d'usage",
                        "target_lang_word": "facility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b255f92-1137-3ceb-af83-1264d8aa3f66",
                                        "entry_id": "942ec565-f84e-337c-9d3b-bf801b5876c5",
                                        "glosses": [
                                            "The physical means or contrivances to make something (especially a public service) possible; the required equipment, infrastructure, location etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02382e2c-77b1-4fc8-93ea-cb1ed7e475a2",
                                                "sense_id": "7b255f92-1137-3ceb-af83-1264d8aa3f66",
                                                "text": "Transport facilities in Bangkok are not sufficient to prevent frequent traffic collapses during rush hour."
                                            },
                                            {
                                                "example_id": "872ac87c-00e0-461c-b4b3-7c5340738f6c",
                                                "sense_id": "7b255f92-1137-3ceb-af83-1264d8aa3f66",
                                                "text": "As though on an incendiary rampage, the fires systematically devoured the contents of Edison's headquarters and facilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d15f8db7-251f-329d-9637-bc863da28090",
                                        "entry_id": "942ec565-f84e-337c-9d3b-bf801b5876c5",
                                        "glosses": [
                                            "A building or campus specially designed for a specific purpose, such as incarceration, military use, or scientific experimentation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81931e04-b7b3-3e80-a41b-c2dda3675b17",
                                        "entry_id": "942ec565-f84e-337c-9d3b-bf801b5876c5",
                                        "glosses": [
                                            "The fact of being easy, or easily done; absence of difficulty; simplicity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "921fc2e8-2241-4685-8414-df37b3cdd139",
                                                "sense_id": "81931e04-b7b3-3e80-a41b-c2dda3675b17",
                                                "text": "Clytomachus affirmed, that he could never understand by the writings of Carneades, what opinion he was of. Why hath Epicurus interdicted facility unto his Sectaries?"
                                            },
                                            {
                                                "example_id": "09270e71-0fed-41eb-8acd-e5f98eac1164",
                                                "sense_id": "81931e04-b7b3-3e80-a41b-c2dda3675b17",
                                                "text": "Since I had started to break down all my writing and get rid of all facility and try to make instead of describe, writing had been wonderful to do. But it was very difficult, and I did not know how I would ever write anything as long as a novel. It often took me a full morning of work to write a paragraph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b5ae36-f18c-37f0-8e86-09bfca9bcd02",
                                        "entry_id": "942ec565-f84e-337c-9d3b-bf801b5876c5",
                                        "glosses": [
                                            "Dexterity of speech or action; skill, talent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24823bf6-bf62-4bc7-be89-50cc91ac9fe4",
                                                "sense_id": "23b5ae36-f18c-37f0-8e86-09bfca9bcd02",
                                                "text": "The facility she shows in playing the violin is unrivalled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0c372f-9a61-3031-89d4-5de585bdda4c",
                                        "entry_id": "942ec565-f84e-337c-9d3b-bf801b5876c5",
                                        "glosses": [
                                            "Clipping of credit facility."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
