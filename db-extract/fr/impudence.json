        "fr-extract.jsonl": [
            {
                "entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                "word": "impudence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6d6b051-a7c7-461a-a60c-c1698df4f1a3",
                        "entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                        "tags": [
                            "plural"
                        ],
                        "form": "impudences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                        "entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                        "glosses": [
                            "Manque de pudeur, effronterie extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c527bcec-da9f-4ed1-8bac-cdd4b0869d3f",
                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                "text": "Ces rustres n’eussent pas osé agir avec une impudence aussi inconcevable s’ils ne se sentaient appuyés par quelque forte bande."
                            },
                            {
                                "example_id": "61c4aaf9-3b13-4125-b583-37caba2a21ac",
                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                "text": "Le Truculentus représente la vie et les gestes d'une gueuse, qui, par sa rapacité, ses éhontements et l’impudence de sa mauvaise foi, révolterait même les blasés de nos petits théâtres."
                            },
                            {
                                "example_id": "5829aa3a-ba5f-4d33-b6ff-95630ea2eccd",
                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                "text": "Ce mouvement était inimitable; il avait la canaillerie, l’impudence, la persuasion d’un dresseur, d’un tombeur de femmes."
                            },
                            {
                                "example_id": "08df7dfe-809a-4acf-8017-cde05dc42b4a",
                                "sense_id": "4aab296d-9c52-3a08-8cee-a98da240cf0d",
                                "text": "En effet, je n'en ai pas, et cela m'est égal, mais je ne désire pas supporter une nouvelle impudence de votre part !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b759090-72b8-3865-a62f-fb3bee915733",
                        "entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                        "glosses": [
                            "Action et parole impudentes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5c1842c6-5508-4fe4-bf06-2fdc85f1db2c",
                                "sense_id": "9b759090-72b8-3865-a62f-fb3bee915733",
                                "text": "Il mérite d’être châtié pour ses impudences."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04494fbd-62aa-4b5f-b680-d25a47c3be6c",
                        "source_entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                        "target_lang_word": "Dreistheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreistheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0cb883f-5d4a-309d-a1de-3b777ecc509c",
                                        "entry_id": "ad068dea-ecdf-3fbf-b304-86a7e8bf28b4",
                                        "glosses": [
                                            "Tat oder eine Äußerung, die nicht von ausreichendem Respekt gegenüber dem anderen geprägt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67ae878-0485-451a-8f30-22d66857b83d",
                                                "sense_id": "f0cb883f-5d4a-309d-a1de-3b777ecc509c",
                                                "text": "So eine Dreistheit habe ich noch nie erlebt!"
                                            },
                                            {
                                                "example_id": "154053e7-07d2-40f0-8b0f-d45a7ff07320",
                                                "sense_id": "f0cb883f-5d4a-309d-a1de-3b777ecc509c",
                                                "text": "„So eine Dreistheit, die schämen sich nicht einmal, das musst du dir mal überlegen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06518bf7-efb7-3f9d-83fa-225aadbd849a",
                                        "entry_id": "ad068dea-ecdf-3fbf-b304-86a7e8bf28b4",
                                        "glosses": [
                                            "Eigenschaft, respektlos/dreist zu sein beziehungsweise die Neigung zu solchem Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad77ee82-2949-442a-a6fd-07fe5bc9afb5",
                                                "sense_id": "06518bf7-efb7-3f9d-83fa-225aadbd849a",
                                                "text": "So etwas von Dreistheit habe ich noch nie erlebt!"
                                            },
                                            {
                                                "example_id": "afe344af-53b0-4fdc-81b5-c4019e662797",
                                                "sense_id": "06518bf7-efb7-3f9d-83fa-225aadbd849a",
                                                "text": "„Was die Dame auszeichnete, war eine gehörige Portion Dummheit, gespielte Naivität und das gepaart mit Dreistheit und Bauernschläue bei besten Verbindungen in Politik und Wirtschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dcd67d5-ecd6-4baa-973c-e8c51291d305",
                        "source_entry_id": "c91be646-1c05-3d71-bd2c-8e63b6a63f6f",
                        "target_lang_word": "Unverschämtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unverschämtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                        "entry_id": "c0f6172c-7979-3e33-af15-40de47641b86",
                                        "glosses": [
                                            "ohne Plural: unverschämte Haltung, unverschämtes Wesen einer Person; das Unverschämtsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84444a48-ce50-4051-801b-e511135af95d",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "Das ist wohl eine Unverschämtheit! Jetzt setzt der Typ schon wieder einen fehlerhaften Artikel ein und hofft auf Verbesserung seiner Fehler."
                                            },
                                            {
                                                "example_id": "ce00e653-6a47-4ae2-9077-37fc0a5d1519",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "Es ist keine Unverschämtheit! Denn ich setzte den Artikel mit gutem Gewissen ein und bin dankbar, dass meine Fehler verbessert werden, die ich aus Unwissenheit machte oder übersah!"
                                            },
                                            {
                                                "example_id": "e5766c9b-b980-4609-91b7-38231632e27a",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "„Er durchbrach in aufreizender Unverschämtheit die über meinem Haus befindliche Schallmauer und verursachte dabei einen Knall, der als überwältigend bezeichnet werden muss.“"
                                            },
                                            {
                                                "example_id": "6e53e29f-f8ee-4609-a33a-6d524e28ecc1",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "„Das halb konfiszierte Schelmengesicht, in dem ein Zug von Gutmütigkeit mit einer derben Portion irischer Unverschämtheit und unbezwingbarer Laune sich spiegelte, hatte die ganze Eskorte allmählich in eine Stimmung versetzt, die, so ernst sie anfangs war, das Lachen kaum mehr unterdrücken konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                        "entry_id": "c0f6172c-7979-3e33-af15-40de47641b86",
                                        "glosses": [
                                            "unverschämte Aussage oder Haltung; etwas Unverschämtes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ca8db3-f1ad-420d-ab9b-a61001f0c857",
                                                "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                                "text": "Das ist wohl eine Unverschämtheit! Jetzt setzt der Typ schon wieder einen fehlerhaften Artikel ein und hofft auf Verbesserung seiner Fehler."
                                            },
                                            {
                                                "example_id": "e7500d9c-42b9-4e7a-9ddb-eb998979628a",
                                                "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                                "text": "Es ist keine Unverschämtheit! Denn ich setzte den Artikel mit gutem Gewissen ein und bin dankbar, dass meine Fehler verbessert werden, die ich aus Unwissenheit machte oder übersah!"
                                            },
                                            {
                                                "example_id": "e6ec8c37-519b-4190-a899-0cdef72f9afe",
                                                "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                                "text": "„Die Schwester ging hinaus, um zu sehen, wer sich diese Unverschämtheit erlaubt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
