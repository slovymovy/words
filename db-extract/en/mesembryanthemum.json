                        "glosses": [
                            "Any of the genus Mesembryanthemum of herbaceous or suffruticose plants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1125ee36-f93c-4986-a63a-3215d663b820",
                                "sense_id": "8c7ccdff-62a8-3ac0-a5a0-05a803c2c112",
                                "text": "The celebrated garden in which suicidal gamblers used to put an end to their troubles was overgrown with mesembryanthemum."
                            },
                            {
                                "example_id": "01f429d5-87f7-4dc2-9566-d8afaa6d8a1a",
                                "sense_id": "8c7ccdff-62a8-3ac0-a5a0-05a803c2c112",
                                "text": "They had come out on to the coast road now, and Cornwall was out-postering itself, as usual, with rocky headlands and sandy coves and fishing villages that spilled themselves down the cliff face like cascades of mesembryanthemum."
                            }
                        ]
                    }
