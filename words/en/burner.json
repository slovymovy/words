                        {
                            "text": "It took the artist all night to finish that <w>burner</w> on the side of the warehouse.",
                            "target_lang_translations": {
                                "ru": "Художнику потребовалась вся ночь, чтобы закончить то <w>граффити</w> на стене склада."
                            }
