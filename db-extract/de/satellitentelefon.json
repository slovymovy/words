                "senses": [
                    {
                        "sense_id": "c35ab4a6-5acb-3fa9-b8da-bdae7887aa12",
                        "entry_id": "c45341c3-f0d8-38c9-95e4-1e04d53de203",
                        "glosses": [
                            "Telefon, das die Verbindung über einen Satelliten herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d047c4c6-5b01-4bbd-9667-cd86c3deb6a1",
                                "sense_id": "c35ab4a6-5acb-3fa9-b8da-bdae7887aa12",
                                "text": "„Wenn der Korrespondent aus einer entlegenen Ecke des Berichtsgebietes einen Beitrag überspielen will, kommt das Satellitentelefon zum Einsatz.“"
                            },
                            {
                                "example_id": "14063379-7f57-4772-8cee-ff91b77dfd8a",
                                "sense_id": "c35ab4a6-5acb-3fa9-b8da-bdae7887aa12",
                                "text": "„Noch von dem verfallenen Haus am Tigris aus rief Ferris Ed Hoffman über sein Satellitentelefon an.“"
                            },
                            {
                                "example_id": "3b975e5a-92f7-4832-84ee-ec0a54bb3fd7",
                                "sense_id": "c35ab4a6-5acb-3fa9-b8da-bdae7887aa12",
                                "text": "„Raynor spürte, wie sein Satellitentelefon vibrierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
