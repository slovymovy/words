                {
                    "sense_id": "c1a8afbd-7a36-318b-ae8f-53d29e195919",
                    "sense_definition": "Se déplacer pour se rendre au lieu où se trouve la personne qui parle ou dont on parle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>venir</w> chez moi ce soir pour regarder un film."
                        },
                        {
                            "text": "Mon ami <w>vient</w> nous voir tous les week-ends à la campagne."
                        }
                    ],
                    "synonyms": [
                        "arriver"
                    ],
                    "antonyms": [
                        "partir"
                    ],
                    "common_phrases": [
                        "venir ici",
                        "venir voir quelqu'un"
                    ]
                },
                {
                    "sense_id": "36909303-5958-3465-9ac0-bad60ddfbd45",
                    "sense_definition": "Être employé comme semi-auxiliaire suivi de « de » et d'un infinitif pour exprimer une action achevée dans un passé très proche.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>viens</w> de finir mon travail et je vais rentrer."
                        },
                        {
                            "text": "Le train <w>vient</w> de partir de la gare il y a deux minutes."
                        }
                    ],
                    "common_phrases": [
