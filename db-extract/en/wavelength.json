                                "sense_id": "f840e8fd-9e65-3197-921f-a09a751489e4",
                                "text": "I'd take requests on the telephone / I'm on a wavelength far from home"
                            }
                        ]
                    },
                    {
                        "sense_id": "ae6272ba-e4f2-387e-9174-967359ce8f05",
                        "entry_id": "5e6772fb-15bb-31d2-a18b-4efa10e89d7c",
                        "glosses": [
                            "A person's attitude and way of thinking as compared to another person's."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
