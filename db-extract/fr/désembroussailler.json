                "senses": [
                    {
                        "sense_id": "ef78d204-1846-3a90-863f-b0af73054caa",
                        "entry_id": "a6c9dce7-622a-34e3-99a0-f507264d04d2",
                        "glosses": [
                            "Débarrasser des broussailles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "30a9a16c-dce4-35f6-bd1b-8c4baa875984",
                        "entry_id": "a6c9dce7-622a-34e3-99a0-f507264d04d2",
                        "glosses": [
                            "Débarrasser de ce qui encombre comparé à de la broussaille."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a7b65555-d1c8-4f46-854b-03c7062ba068",
                                "sense_id": "30a9a16c-dce4-35f6-bd1b-8c4baa875984",
                                "text": "J'ai affirmé notre intention de désembroussailler, encore, les bureaux de Chantilly."
                            },
                            {
                                "example_id": "c237b7d4-4804-4e2b-8d6a-cb8ea7b811b1",
                                "sense_id": "30a9a16c-dce4-35f6-bd1b-8c4baa875984",
                                "text": "La surprise doit être recherchée pour elle-même, inconditionnellement » martèle Breton car elle seule est capable de « désembroussailler les chemins du désir»."
                            },
                            {
                                "example_id": "89b5b4c5-d821-4a70-b5e4-2ebd30fb795f",
                                "sense_id": "30a9a16c-dce4-35f6-bd1b-8c4baa875984",
                                "text": "Il prétendit même désembroussailler la théologie, la délivrer des abstractions et des subtilités scolastiques, la traiter et la commenter en termes communs, littérairement."
                            }
                        ]
                    }
                ],
