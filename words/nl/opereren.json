                    "sense_id": "032f683f-ec64-30e1-9789-de6050755138",
                    "sense_definition": "een medische ingreep uitvoeren bij een mens of dier",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De chirurg zal morgenochtend de patiënt <w>opereren</w>.",
                            "target_lang_translations": {
                                "en": "The surgeon will <w>operate</w> on the patient tomorrow morning.",
                                "ru": "Хирург будет <w>оперировать</w> пациента завтра утром."
                            }
                        },
                        {
                            "text": "De dierenarts moest de kat <w>opereren</w> om de gebroken poot te herstellen.",
                            "target_lang_translations": {
                                "en": "The vet had to <w>operate</w> on the cat to repair the broken leg.",
                                "ru": "Ветеринару пришлось <w>прооперировать</w> кошку, чтобы восстановить сломанную лапу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand opereren",
                        "aan een knie opereren"
                    ],
                    "target_lang_definitions": {
