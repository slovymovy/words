{
    "word_family": [
        "evacuate",
        "evacuee",
        "evacuator",
        "evacuative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2f50bcc-5d7d-34d7-8f08-aa100f4db587",
                    "sense_definition": "The act of moving people away from a place of danger to a safer location.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "safety_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire alarm triggered an immediate <w>evacuation</w> of the office building.",
                            "target_lang_translations": {
                                "ru": "Пожарная сигнализация спровоцировала немедленную <w>эвакуацию</w> офисного здания.",
                                "zh": "火警触发了办公大楼的紧急<w>疏散</w>。",
                                "tr": "Yangın alarmı ofis binasının derhal <w>tahliye edilmesini</w> tetikledi."
                            }
                        },
                        {
                            "text": "Local officials ordered a mass <w>evacuation</w> before the hurricane reached the coast.",
                            "target_lang_translations": {
                                "ru": "Местные власти распорядились о массовой <w>эвакуации</w> до того, как ураган достиг побережья.",
                                "zh": "在飓风到达海岸之前，当地官员下令进行大规模<w>撤离</w>。",
                                "tr": "Yerel yetkililer kasırga kıyıya ulaşmadan önce kitlesel bir <w>tahliye</w> emri verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "withdrawal",
                        "removal",
                        "clearance"
                    ],
                    "common_phrases": [
                        "emergency evacuation",
                        "mass evacuation",
                        "evacuation plan",
                        "order an evacuation",
                        "evacuation route"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованный вывоз людей из зоны опасности в безопасное место.",
                        "zh": "将人员从危险区域转移到安全地点的行为。",
                        "tr": "İnsanların tehlikeli bir bölgeden daha güvenli bir yere planlı şekilde nakledilmesi eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эвакуация",
                                "target_lang_sense_clarification": "вывоз людей из опасной зоны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疏散",
                                "target_lang_sense_clarification": "指人员从危险地带撤离"
                            },
                            {
                                "target_lang_word": "撤离",
                                "target_lang_sense_clarification": "指离开危险区域"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tahliye",
                                "target_lang_sense_clarification": "tehlike anında insanların güvenli yere nakli"
                            },
                            {
                                "target_lang_word": "boşaltma",
                                "target_lang_sense_clarification": "bina veya bölgenin güvenli hale getirilmek üzere boşaltılması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be108e8b-cfb6-371c-86fd-d160802a87ed",
                    "sense_definition": "The process of removing the contents from a container or space, often to create a vacuum.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_emptying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pump allows for the rapid <w>evacuation</w> of air from the sealed chamber.",
                            "target_lang_translations": {
                                "ru": "Насос позволяет производить быструю <w>откачку</w> воздуха из герметичной камеры.",
                                "zh": "泵可以快速将密封舱内的空气<w>抽空</w>。",
                                "tr": "Pompa, kapalı bölmedeki havanın hızlı bir şekilde <w>tahliyesini</w> sağlar."
                            }
                        },
                        {
                            "text": "Complete <w>evacuation</w> of the tank is necessary before any repairs can begin.",
                            "target_lang_translations": {
                                "ru": "Полное <w>опорожнение</w> резервуара необходимо перед началом любых ремонтных работ.",
                                "zh": "在开始任何维修工作之前，必须将储罐彻底<w>排空</w>。",
                                "tr": "Herhangi bir tamirat başlamadan önce tankın tamamen <w>boşaltılması</w> gerekmektedir."
                            }
                        }
                    ],
                    "synonyms": [
                        "emptying",
                        "draining",
                        "voiding"
                    ],
                    "antonyms": [
                        "filling"
                    ],
                    "common_phrases": [
                        "evacuation of air",
                        "smoke evacuation"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс удаления содержимого из емкости или пространства, часто для создания вакуума.",
                        "zh": "从容器或空间中清除内容物的过程，通常用于制造真空。",
                        "tr": "Genellikle vakum oluşturmak amacıyla bir kap veya alandaki içeriğin dışarı çıkarılması işlemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удаление",
                                "target_lang_sense_clarification": "извлечение содержимого"
                            },
                            {
                                "target_lang_word": "откачка",
                                "target_lang_sense_clarification": "воздуха или газа"
                            },
                            {
                                "target_lang_word": "опорожнение",
                                "target_lang_sense_clarification": "освобождение емкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽空",
                                "target_lang_sense_clarification": "指抽出气体或液体"
                            },
                            {
                                "target_lang_word": "排空",
                                "target_lang_sense_clarification": "指清空容器内的物质"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boşaltma",
                                "target_lang_sense_clarification": "bir kabın veya haznenin içini boşaltma"
                            },
                            {
                                "target_lang_word": "tahliye",
                                "target_lang_sense_clarification": "gaz veya sıvının dışarı atılması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5830346f-a26a-3bc0-80ca-c4382d199477",
                    "sense_definition": "The act of discharging waste matter from the body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_discharge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient about the frequency of their bowel <w>evacuation</w>.",
                            "target_lang_translations": {
                                "ru": "Врач спросил пациента о частоте <w>опорожнения</w> кишечника.",
                                "zh": "医生询问了病人的<w>排便</w>频率。",
                                "tr": "Doktor hastaya bağırsak <w>boşaltım</w> sıklığını sordu."
                            }
                        },
                        {
                            "text": "Certain medications are designed to stimulate the <w>evacuation</w> of the digestive tract.",
                            "target_lang_translations": {
                                "ru": "Определенные лекарства предназначены для стимуляции <w>очищения</w> пищеварительного тракта.",
                                "zh": "某些药物旨在刺激消化道的<w>排泄</w>。",
                                "tr": "Bazı ilaçlar sindirim sisteminin <w>boşalmasını</w> uyarmak için tasarlanmıştır."
                            }
                        }
                    ],
                    "synonyms": [
                        "defecation",
                        "discharge",
                        "excretion"
                    ],
                    "antonyms": [
                        "retention"
                    ],
                    "common_phrases": [
                        "bowel evacuation",
                        "gastric evacuation"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medical"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выведение продуктов жизнедеятельности из организма.",
                        "zh": "从体内排出废弃物的行为。",
                        "tr": "Atık maddelerin vücuttan dışarı atılması eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опорожнение",
                                "target_lang_sense_clarification": "кишечника"
                            },
                            {
                                "target_lang_word": "испражнение",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排便",
                                "target_lang_sense_clarification": "指肠道排泄"
                            },
                            {
                                "target_lang_word": "排泄",
                                "target_lang_sense_clarification": "指排出体内废物"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boşaltım",
                                "target_lang_sense_clarification": "vücuttan atıkların uzaklaştırılması süreci"
                            },
                            {
                                "target_lang_word": "defekasyon",
                                "target_lang_sense_clarification": "bağırsakların boşaltılması, dışkılama"
                            },
                            {
                                "target_lang_word": "tahliye",
                                "target_lang_sense_clarification": "tıbbi olarak bağırsak veya mide içeriğinin boşaltılması"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}