                "senses": [
                    {
                        "sense_id": "99ff27ba-80e8-32a5-999e-25ea960a66af",
                        "entry_id": "ef3590ab-8fdb-3a1a-ad62-021f5efc016e",
                        "glosses": [
                            "Modell/Darstellung eines nicht weiter verbesserbaren (= idealen) Zustandes bei etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fde0e1a-2954-4f2c-83bb-416c536e9157",
                                "sense_id": "99ff27ba-80e8-32a5-999e-25ea960a66af",
                                "text": "„Günstigstenfalls wird man sich zu Negativurteilen durchringen können, daß gewisse Subventionsschemata aus bestimmten Gründen nicht mit einem Idealschema der skizzierten Art übereinstimmen.“"
                            },
                            {
                                "example_id": "2fe1721f-25d5-427f-8931-211b95b0e47d",
                                "sense_id": "99ff27ba-80e8-32a5-999e-25ea960a66af",
                                "text": "„Ständiger Fokus auf das Äußere und die omnipräsente Kritik gegen all diejenigen, die dem Idealschema nicht entsprechen, ist die Wurzel dessen, was Gesellschaft und allem die nachwachsenden Generationen verändert bzw.“"
                            },
                            {
                                "example_id": "a9b37ffd-e65c-46d5-9599-2946ae490785",
                                "sense_id": "99ff27ba-80e8-32a5-999e-25ea960a66af",
                                "text": "„Die Physiognomik hatte diesen Blick für Abweichungen von einem Idealschema sensibilisiert und damit eine Wertung des Gesehenen vorangetrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
