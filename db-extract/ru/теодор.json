                                        "entry_id": "c00e14c9-b9ae-3c53-8a52-c80b4778339a",
                                        "glosses": [
                                            "A diminutive of the male given names Edward or Theodore, or of their diminutives Ted and Tedd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72c57533-354a-4343-9c9f-1935ca0f3f0a",
                                                "sense_id": "e727164a-33ad-3eb0-b3ff-32d4af6f8b95",
                                                "text": "She said, “You indicated little Teddy's become quite a handful.” “Theodore,” said Christopher. “God, whatever you do, don't call him Teddy.”"
                                            }
                                        ]
