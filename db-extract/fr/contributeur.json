                                                "sense_id": "48773ffc-08f5-3746-b36b-01be88d10873",
                                                "text": "I am a longstanding financial contributor to Amnesty International."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b620ecd9-9ed6-3322-80c8-aa408a0acfe0",
