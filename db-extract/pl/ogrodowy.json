                    }
                ],
                "senses": [
                    {
                        "sense_id": "92954887-eb9f-3a63-b26c-09dc5b489ed2",
                        "entry_id": "df94a717-3cb3-33d0-aadd-cca6308e85de",
                        "glosses": [
                            "dotyczący ogrodu, należący do ogrodu, znajdujący się, spotykany w ogrodzie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e174b775-3a3c-4445-92f3-00c2635033f4",
                                "sense_id": "92954887-eb9f-3a63-b26c-09dc5b489ed2",
                                "text": "Ważnym akcentem wnętrza ogrodowego jest soliter o czerwonej barwie liści."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f94f7958-d376-3ae6-83cb-9fff809cfacb",
                        "entry_id": "df94a717-3cb3-33d0-aadd-cca6308e85de",
                        "glosses": [
                            "uprawiany, hodowany w ogrodzie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eac3fc6c-0002-47ce-b927-a64462d48dc7",
                        "source_entry_id": "df94a717-3cb3-33d0-aadd-cca6308e85de",
                        "source_sense_id": "f94f7958-d376-3ae6-83cb-9fff809cfacb",
                        "target_lang_word": "садовый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "садовый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b22e21fb-da8d-3e8b-bd5d-c497351cd371",
                                        "entry_id": "479b0858-96c9-3477-aac4-1391d32857a5",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным сад"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c714cfd0-e0ca-438b-a614-5a081a37d96a",
                                                "sense_id": "b22e21fb-da8d-3e8b-bd5d-c497351cd371",
                                                "text": "Выбор основных элементов оформления — мощёная площадка, садовая мебель, растения — не может быть случайным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f07541-daa5-39c8-9fcb-8877eee9d2b5",
                                        "entry_id": "479b0858-96c9-3477-aac4-1391d32857a5",
                                        "glosses": [
                                            "предназначенный для использования, работы в саду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c22988-d506-4a1c-9978-ae8f30b00ac2",
                                                "sense_id": "89f07541-daa5-39c8-9fcb-8877eee9d2b5",
                                                "text": "Садовым насосом мы можем всасывать воду и выпрыскивать её на значительную высоту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25ff11b1-65e4-38e0-be2f-39679070af7e",
                                        "entry_id": "479b0858-96c9-3477-aac4-1391d32857a5",
                                        "glosses": [
                                            "свойственный саду, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e35adea-7c19-4519-b865-facb1c138386",
                                                "sense_id": "25ff11b1-65e4-38e0-be2f-39679070af7e",
                                                "text": "В честь Штёрка один из распространённых в садовой культуре видов аконита был назван его именем"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea66c7a9-6d2b-3a1e-87df-49fe168f249e",
                                        "entry_id": "479b0858-96c9-3477-aac4-1391d32857a5",
                                        "glosses": [
                                            "принадлежащий саду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6bc19ae-e8d5-490d-8dd9-0285b66283e2",
                                                "sense_id": "ea66c7a9-6d2b-3a1e-87df-49fe168f249e",
                                                "text": "Существует мнение, что при выращивании аконитов на плодородной садовой почве они через несколько поколений теряют свои ядовитые свойства."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd995c9-791f-33ac-9cc3-a28ce4742ebc",
                                        "entry_id": "479b0858-96c9-3477-aac4-1391d32857a5",
                                        "glosses": [
                                            "расположенный в саду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cd9ba18-cdf8-4db4-b282-4be6ec2cbc49",
                                                "sense_id": "2cd995c9-791f-33ac-9cc3-a28ce4742ebc",
                                                "text": "Несколько ступенек стали продолжением садовой дорожки. Чтобы вода не застаивалась, поверхность каждой ступени должна иметь небольшой уклон вперёд (два-три процента от её ширины)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e71948e9-7fb0-3f26-be7e-9e5bc7cfb948",
                                        "entry_id": "479b0858-96c9-3477-aac4-1391d32857a5",
                                        "glosses": [
                                            "выращиваемый в саду; культурный; окультуренный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc50381-ef10-4c34-8f2c-e3a4dbc7b595",
                                                "sense_id": "e71948e9-7fb0-3f26-be7e-9e5bc7cfb948",
                                                "text": "Пёстрый, романтичный, он совмещает в себе и садовые цветы, и их дикорастущих «родственников», овощи и пряные травы, кусты чубушника и заросли шиповника — в нём есть место всему, что напоминает нам сельский палисадник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2019b3a2-a8c0-3633-af1d-cfc5c47f4a7b",
                                        "entry_id": "479b0858-96c9-3477-aac4-1391d32857a5",
                                        "glosses": [
                                            "то же, что садоводческий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8fafaa8-3047-4bdc-b6c4-62ef227b8f81",
                                                "sense_id": "2019b3a2-a8c0-3633-af1d-cfc5c47f4a7b",
                                                "text": "Аналогично выглядели и подобного рода хозяйства семей горожан, использующих садовые, огородные, дачные участки, в коллективных и индивидуальных хозяйствах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
