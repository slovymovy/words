{
    "word_family": [
        "hangarage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dba30db2-70b9-3593-8901-c15b4008ac5c",
                    "sense_definition": "A large garage-like structure where aircraft are kept.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aviation_buildings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plane taxied on over to the <w>hangar</w> for repairs.",
                            "target_lang_translations": {
                                "ru": "Самолет вырулил к <w>ангару</w> для проведения ремонта."
                            }
                        },
                        {
                            "text": "The mechanics worked late inside the aircraft <w>hangar</w> to prepare the jet for its morning flight.",
                            "target_lang_translations": {
                                "ru": "Механики допоздна работали в авиационном <w>ангаре</w>, чтобы подготовить реактивный самолет к утреннему вылету."
                            }
                        }
                    ],
                    "synonyms": [
                        "shed",
                        "garage"
                    ],
                    "common_phrases": [
                        "aircraft hangar",
                        "hangar deck",
                        "airport hangar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое сооружение типа гаража, в котором хранятся и обслуживаются самолеты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ангар",
                                "target_lang_sense_clarification": "для авиационной техники"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1617ccd-b0c0-3c84-899a-fd013ed42bae",
                    "sense_definition": "A covered shed for carriages.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old estate still featured a wooden <w>hangar</w> where the family once kept their horse-drawn carriages.",
                            "target_lang_translations": {
                                "ru": "В старом поместье все еще сохранился деревянный <w>навес</w>, где семья когда-то держала свои конные экипажи."
                            }
                        },
                        {
                            "text": "By the side of the manor ran an open <w>hangar</w> upheld by a score of rough tarred posts.",
                            "target_lang_translations": {
                                "ru": "Сбоку от усадьбы тянулся открытый <w>сарай</w>, поддерживаемый десятком грубых просмоленных столбов."
                            }
                        }
                    ],
                    "synonyms": [
                        "carriage house",
                        "shed"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical carriage storage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крытый навес или сарай для хранения экипажей и карет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навес",
                                "target_lang_sense_clarification": "для карет"
                            },
                            {
                                "target_lang_word": "сарай",
                                "target_lang_sense_clarification": "хозяйственная постройка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "942cd70b-ad22-38b1-b7c6-6c35bced0d2b",
                    "sense_definition": "To store (an aircraft) in a hangar.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aviation_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot decided to <w>hangar</w> the plane overnight to protect it from the approaching storm.",
                            "target_lang_translations": {
                                "ru": "Пилот решил <w>поставить</w> самолет <w>в ангар</w> на ночь, чтобы защитить его от приближающегося шторма."
                            }
                        },
                        {
                            "text": "It is much safer to <w>hangar</w> the aircraft during the winter months than to leave it on the runway.",
                            "target_lang_translations": {
                                "ru": "В зимние месяцы гораздо безопаснее <w>держать</w> самолет <w>в ангаре</w>, чем оставлять его на взлетно-посадочной полосе."
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать (самолет) в ангар для хранения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить в ангар",
                                "target_lang_sense_clarification": "о самолете"
                            },
                            {
                                "target_lang_word": "размещать в ангаре",
                                "target_lang_sense_clarification": "для хранения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}