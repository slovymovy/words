                            {
                                "example_id": "f2ab462b-9f82-45f1-a4c6-da63521a3a9a",
                                "sense_id": "b4a0887a-677a-3738-934c-f8a69b4a6e1a",
                                "text": "Встряхнуть щенка."
                            },
                            {
                                "example_id": "986a4167-211c-4f00-9850-b65f7e4a9cf1",
