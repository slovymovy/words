                "senses": [
                    {
                        "sense_id": "dc3a9a38-556c-3309-9c5c-14f07264445b",
                        "entry_id": "6006a253-4cd9-39f8-95e5-170443c00afb",
                        "glosses": [
                            "Monitor, der für die Verwendung mit einem Computer vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27dadeda-b7fd-4630-acc9-bfdb501b2bb8",
                                "sense_id": "dc3a9a38-556c-3309-9c5c-14f07264445b",
                                "text": "„Und so steht am nächsten Tag plötzlich ein herrenloses Sofa auf dem Gehsteig, ein alter Computermonitor wartet auf bessere Zeiten, eine ausrangierte Küchenzeile, deren Dienste nicht mehr benötigt werden, harrt der Dinge, schwimmender Müll in Form von Plastiksackerln oder Aludosen in den Flüssen oder gar ein Klavier, das nach vielen Jahren der treuen Dienste wohl niemanden mehr mit lieblichen Klängen entzücken wird.“"
                            },
                            {
                                "example_id": "b95eddf2-d4c7-4e7f-8346-fa5c1a17eec4",
                                "sense_id": "dc3a9a38-556c-3309-9c5c-14f07264445b",
                                "text": "„Es ist vermutlich nicht so, dass die Leute darum auf Ausdrucke verzichten, weil sie die Bilder lieber am Computermonitor oder am Fernseher sich anschauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
