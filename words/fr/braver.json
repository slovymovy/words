{
    "word_family": [
        "brave",
        "bravement",
        "bravoure",
        "bravade"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc506d9a-090d-39d1-851e-a4b36f4f9af3",
                    "sense_definition": "Affronter un danger, des intempéries ou une situation périlleuse sans céder à la peur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins ont dû <w>braver</w> la tempête pour secourir les passagers du bateau en détresse."
                        },
                        {
                            "text": "Malgré la pluie glaciale, les randonneurs continuent d'avancer en <w>bravant</w> le froid des montagnes."
                        }
                    ],
                    "synonyms": [
                        "affronter"
                    ],
                    "common_phrases": [
                        "braver la tempête",
                        "braver le froid",
                        "braver le danger"
                    ]
                },
                {
                    "sense_id": "9d4e305a-2414-3d5a-8aaa-0170eb18e686",
                    "sense_definition": "Défier une autorité, une loi ou un adversaire avec courage ou insolence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune employé n'a pas hésité à <w>braver</w> l'autorité du directeur en exprimant son désaccord."
                        },
                        {
                            "text": "Les manifestants se sont réunis sur la place centrale, <w>bravant</w> ainsi les interdictions officielles."
                        }
                    ],
                    "common_phrases": [
                        "braver l'autorité",
                        "braver les interdits"
                    ]
                },
                {
                    "sense_id": "a320da06-5471-3163-8d27-95621b4e1592",
                    "sense_definition": "Passer outre des règles sociales, des préjugés ou des menaces en refusant de s'y soumettre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour épouser l'homme qu'elle aimait, cette artiste a choisi de <w>braver</w> les convenances de son époque."
                        },
                        {
                            "text": "Ce journaliste indépendant a poursuivi ses enquêtes en <w>bravant</w> les intimidations répétées de ses détracteurs."
                        }
                    ],
                    "common_phrases": [
                        "braver les convenances",
                        "braver l'opinion publique"
                    ]
                }
            ]
        }
    ]
}