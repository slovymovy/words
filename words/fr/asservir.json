{
    "word_family": [
        "asservissement",
        "asservisseur",
        "serf",
        "servitude"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91ef64fa-d471-34bc-b3ec-b315867e4d9b",
                    "sense_definition": "Réduire un être humain, un peuple ou une nation à la servitude ou à l'esclavage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'empire colonial cherchait à <w>asservir</w> les populations locales pour exploiter leurs ressources."
                        },
                        {
                            "text": "Le tyran a réussi à <w>asservir</w> tout le pays en supprimant les libertés fondamentales."
                        }
                    ],
                    "synonyms": [
                        "assujettir",
                        "soumettre",
                        "opprimer"
                    ],
                    "antonyms": [
                        "affranchir",
                        "libérer",
                        "émanciper"
                    ],
                    "common_phrases": [
                        "asservir un peuple",
                        "asservir une nation"
                    ]
                },
                {
                    "sense_id": "2e027141-92ea-3a14-959b-4598067f1921",
                    "sense_definition": "Placer sous une dépendance absolue, morale ou intellectuelle, en ôtant toute autonomie de pensée ou d'action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette idéologie destructrice cherche à <w>asservir</w> les esprits dès le plus jeune âge."
                        },
                        {
                            "text": "Il refuse de laisser ses désirs matériels <w>asservir</w> sa conscience et ses choix moraux."
                        }
                    ],
                    "synonyms": [
                        "aliéner",
                        "subjuguer",
                        "dominer"
                    ],
                    "antonyms": [
                        "émanciper"
                    ],
                    "common_phrases": [
                        "asservir les esprits"
                    ]
                },
                {
                    "sense_id": "3dee8eec-4014-3e8a-9c90-5275e9793bd8",
                    "sense_definition": "Se placer soi-même sous la dépendance étroite ou la contrainte de quelqu'un ou de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut jamais s'<w>asservir</w> aux volontés d'un supérieur malveillant sans protester."
                        },
                        {
                            "text": "L'écrivain refuse de s'<w>asservir</w> aux modes passagères du marché littéraire."
                        }
                    ],
                    "synonyms": [
                        "se plier",
                        "se soumettre"
                    ],
                    "antonyms": [
                        "se rebeller",
                        "s'affranchir"
                    ],
                    "common_phrases": [
                        "s'asservir à la mode",
                        "s'asservir aux désirs"
                    ]
                },
                {
                    "sense_id": "a4f61651-e539-3b78-b61f-6662ecab97fc",
                    "sense_definition": "Régir ou commander un mécanisme ou un dispositif de manière subordonnée à une consigne ou à une autre grandeur physique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capteur de température <w>asservit</w> automatiquement la vitesse de rotation des ventilateurs."
                        },
                        {
                            "text": "L'ingénieur a conçu un système électronique qui <w>asservit</w> la trajectoire du robot à un signal laser."
                        }
                    ],
                    "synonyms": [
                        "réguler",
                        "piloter"
                    ],
                    "common_phrases": [
                        "asservir la commande"
                    ]
                }
            ]
        }
    ]
}