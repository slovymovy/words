                                            {
                                                "example_id": "7ddf5b8c-ba33-4c6a-b504-80e4101183f5",
                                                "sense_id": "e038117c-2868-3c09-81df-9616a31c5da7",
                                                "text": "Anpassung ist ein regulatorischer Prozess."
                                            },
                                            {
                                                "example_id": "1af13bbb-ae17-4a12-8ea1-5c6dc2a3c0ef",
                                                "sense_id": "e038117c-2868-3c09-81df-9616a31c5da7",
                                                "text": "Regulatorische T-Zellen verhindern im gesunden Organismus die Entstehung von Autoimmunkrankheiten."
                                            },
                                            {
                                                "example_id": "2a7ed923-e84a-4570-b6ab-f123749e7b23",
                                                "sense_id": "e038117c-2868-3c09-81df-9616a31c5da7",
                                                "text": "Wenn nach einem biologischen Herstellungsprozess dass Endprodukt in genügend hoher Konzentration vorliegt, führt dies zu einer Rückkopplung an das regulatorische Enzym, das zunächst die Herstellung in Gang setzte und nun eine weitere Produktion verhindert."
                                            },
                                            {
                                                "example_id": "38f8e597-0eed-401f-a459-f8eb6025ebc3",
                                                "sense_id": "e038117c-2868-3c09-81df-9616a31c5da7",
                                                "text": "Wohl keine andere Branche unterliegt so hohen regulatorischen Anforderungen wie die der Finanzdienstleister."
                                            }
