                                                "sense_id": "8da5b7e5-40e6-328e-bf44-1f1428136ade",
                                                "text": "„Aber das Geläut der Kuhglocken wurde überdröhnt vom Lärm der Musikboxen und der Motorräder ohne Auspufftöpfe, deren Geknatter wie Maschinengewehrgarben von den Felswänden widerhallte.“"
                                            },
                                            {
                                                "example_id": "de18d33d-5f49-4ae3-b6a4-9b38fe079d41",
                                                "sense_id": "8da5b7e5-40e6-328e-bf44-1f1428136ade",
                                                "text": "„Aus der Ferne war das Bimmeln der Kuhglocken zu hören.“"
                                            },
                                            {
                                                "example_id": "7ebcc724-b0fa-4d90-9f31-409ed01b7c8c",
                                                "sense_id": "8da5b7e5-40e6-328e-bf44-1f1428136ade",
                                                "text": "„Kuhglocken sind das doch!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
