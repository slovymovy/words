                    },
                    {
                        "translation_id": "2a4db05d-c0c1-49b4-a38d-37245b55b6e4",
                        "source_entry_id": "7f0f4e31-1a6c-311f-bf99-f9bbe1639e6f",
                        "source_sense_description": "action de banaliser",
                        "target_lang_word": "banality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
