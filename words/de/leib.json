                        "den nackten Leib bedecken"
                    ]
                },
                {
                    "sense_id": "4bb55a7a-b9a2-3d05-9c42-fe0927575cfb",
                    "sense_definition": "Der mittlere Teil des Körpers ohne Kopf und Gliedmaßen; der Rumpf.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "koerper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei der Abfahrt zog der Skifahrer die Arme ganz dicht an den <w>Leib</w>."
                        },
                        {
                            "text": "Das eng geschnittene Kleidungsstück lag fast wie eine zweite Haut am <w>Leib</w> an."
