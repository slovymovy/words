                                        "entry_id": "39f43133-6bd8-3dbb-8fb5-5264cc348fcc",
                                        "glosses": [
                                            "die Ebene polarisierten Lichts nach links drehend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5eb4998-a2a4-4d42-95a2-f402ab4a987f",
                                                "sense_id": "b3f02f1d-f588-3a6e-a086-25e0ac8f3f1c",
                                                "text": "Auch der Harn von Hunden und Kaninchen dreht schwach nach links [Roos], Porcher und Nicolas fanden Hundeharn nach Fleischnahrung stärker lävogyr als nach Ernährung mit Brot."
                                            },
                                            {
                                                "example_id": "728f0aae-0a44-4d85-b6be-473dbac4006b",
                                                "sense_id": "b3f02f1d-f588-3a6e-a086-25e0ac8f3f1c",
                                                "text": "Bei Zucker von 1838 war die optische Ablenkung lävogyr geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
