                "senses": [
                    {
                        "sense_id": "0b2c70aa-4cc1-36a2-85ff-f92c7f1b324d",
                        "entry_id": "cb102a39-1c5c-3ce6-954b-bd03eaacedfc",
                        "glosses": [
                            "desperate, being in dire need of something, and willing to take risks to get it"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "55d3032d-b7c2-383d-9642-d2c6f439c6e7",
                        "entry_id": "cb102a39-1c5c-3ce6-954b-bd03eaacedfc",
                        "glosses": [
                            "at a loss, being uncertain about something, or lacking something (ideas, direction, ability)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "085a41e7-5c54-41ab-b0c3-441b45284a21",
                                "sense_id": "55d3032d-b7c2-383d-9642-d2c6f439c6e7",
                                "text": "Lacking ideas, being out of ideas: ideeëloos"
                            },
                            {
                                "example_id": "a55dc14f-186b-4628-ac1d-de72202d966c",
                                "sense_id": "55d3032d-b7c2-383d-9642-d2c6f439c6e7",
                                "text": "Lacking direction, being directionless: richtingloos"
                            },
                            {
                                "example_id": "36f0e6f7-a129-4bbb-ab46-f01abab8cf14",
                                "sense_id": "55d3032d-b7c2-383d-9642-d2c6f439c6e7",
                                "text": "Not knowing what to say, being at a loss for words or speechless: sprakeloos"
                            }
                        ]
                    }
                ],
