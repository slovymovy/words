                        "sense_id": "9ae5ade1-a719-39ee-9ea8-ca2c073a4127",
                        "entry_id": "e91eb601-03a1-3411-a456-59e69c058dfa",
                        "glosses": [
                            "In a sacerdotal manner, in the manner of a priest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f4dab14-d788-4254-a298-f4e6b71db5d0",
                                "sense_id": "9ae5ade1-a719-39ee-9ea8-ca2c073a4127",
                                "text": "1720, Samuel Parker, Biblioteca Biblica, Oxford: William and John Innys, Volume I, Part 2, Occasional Annotation 30, “The Pillar of Jacob,” p. 608,\n[…] first he Blessed the Place Sacerdotally, setting it apart by Solemn Rites for a Place of Divine Worship […]"
                            },
                            {
                                "example_id": "652e5445-b577-4b6b-a87f-f18d8211a865",
                                "sense_id": "9ae5ade1-a719-39ee-9ea8-ca2c073a4127",
                                "text": "Some ladies went a dozen times in the day to hear mass, but paid little attention to what was going on sacerdotally."
                            },
                            {
                                "example_id": "67dcfb92-522d-4683-b8bd-8e0acd8736ce",
                                "sense_id": "9ae5ade1-a719-39ee-9ea8-ca2c073a4127",
                                "text": "Pickerbaugh assigned to them the chief booth, on the platform once sacerdotally occupied by the Reverend Mr. Sunday."
                            },
                            {
                                "example_id": "c558c8ee-ccae-4f8b-bf94-3306ce953915",
                                "sense_id": "9ae5ade1-a719-39ee-9ea8-ca2c073a4127",
                                "text": "Here I saw for the first time, in any number to speak of, the Mission-boys, the converted Natives, half sacerdotally attired, whatever office they might be filling […]"
                            }
                        ]
                    }
