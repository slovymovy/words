                "senses": [
                    {
                        "sense_id": "0dd54aba-ff1f-3b85-8d87-ddf6fc1e27d9",
                        "entry_id": "27f87d03-6125-3ab2-9bba-3d934dff8185",
                        "glosses": [
                            "weibliche Person mit entsprechender Ausbildung, die berufsmäßig die Oberfläche eines Gegenstandes glättet, gegebenenfalls formt"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "f445f2a3-3a54-42c4-893d-1d0c1826664a",
                                "sense_id": "0dd54aba-ff1f-3b85-8d87-ddf6fc1e27d9",
                                "text": "„Wer eine duale Ausbildung zum Schleifer/zur Schleiferin absolviert, lernt überwiegend im Ausbildungsbetrieb und in der Berufsschule.“"
                            },
                            {
                                "example_id": "8a842546-be03-4f6f-97fc-136e41fb8a8a",
                                "sense_id": "0dd54aba-ff1f-3b85-8d87-ddf6fc1e27d9",
                                "text": "„Pawlitschenko […] absolvierte eine Ausbildung zur Scharfschützin, während sie parallel als Schleiferin im Arsenalwerk arbeitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
