                                    {
                                        "sense_id": "314bce1c-10c5-3bff-a7fd-b699a4d791dc",
                                        "entry_id": "f0259447-f63a-3f91-bec2-2e199fbeac5d",
                                        "glosses": [
                                            "zu den Symptomen einer Psychose gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4adcf2e-95d5-4fea-813f-3e2b493792bd",
                                                "sense_id": "314bce1c-10c5-3bff-a7fd-b699a4d791dc",
                                                "text": "Wahnvorstellungen kann man als psychotisch einstufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f42bf671-215f-36e2-ac07-085cea1947ae",
                                        "entry_id": "f0259447-f63a-3f91-bec2-2e199fbeac5d",
                                        "glosses": [
                                            "an einer Psychose erkrankt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8035cdca-a78b-4e13-84f9-1fc59cc419a9",
                                                "sense_id": "f42bf671-215f-36e2-ac07-085cea1947ae",
                                                "text": "Der Patient wurde während des Klinikaufenthalts psychotisch."
                                            },
                                            {
                                                "example_id": "9ee23d24-955e-4224-bb81-b0f117002a85",
                                                "sense_id": "f42bf671-215f-36e2-ac07-085cea1947ae",
                                                "text": "„Musik- und Kunsttherapie sind Beispiele für die vielgestaltigen pädagogischen Initiativen, die auch in Verhaltenstherapien psychotisch Kranker zu erkennen sind.“"
                                            }
                                        ],
