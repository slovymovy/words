                                            },
                                            {
                                                "example_id": "c9181e84-70b0-4768-b05f-bcc2bdf76ea3",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Die Zeit verwandelt sie in Arschlöcher, die nur darauf warten, die Waffe zu ziehen.“"
                                            },
                                            {
                                                "example_id": "20e644a6-647a-4243-9b96-71bf8c6b52f3",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Alles in allem, diese Sendung versammelte wieder einmal nichts als Arschlöcher.“"
                                            },
                                            {
                                                "example_id": "805d9dc2-4fef-471f-8285-2691fee44463",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Aber gewinnen damit nicht letztlich eben doch die Arschlöcher, und die Anständigen können schauen, wo sie bleiben? ‹Das stimmt nicht!›, ruft Sutton fröhlich. Ein Arschloch zu sein, lohne sich nur kurzfristig – längerfristig zahle es sich nicht aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f419fbe0-57dc-4843-b952-fa77006c9c18",
                        "source_entry_id": "81b8bcd5-ca29-37aa-a2b3-366430e14556",
                        "source_sense_description": "анус",
                        "target_lang_word": "Rosette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a187c2f2-a4d7-3829-9a64-bd9dc16a828a",
                                        "entry_id": "179cd493-7403-3baf-8a42-64a6bf278b93",
                                        "glosses": [
                                            "verziertes Schallloch im Resonanzboden eines Musikinstruments"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1a981b6-4e52-463e-a6a3-6125b8c43251",
                                                "sense_id": "a187c2f2-a4d7-3829-9a64-bd9dc16a828a",
                                                "text": "„In der Decke ist das Schalloch oder die Rosette eingeschnitten; aufgeleimt ist der Steg (Saitenhalter oder Saitenfest); innen ist die Decke durch Balken oder Stege aus Klangholz versteift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "477a3de3-1d67-392a-b92d-c3a569df534d",
                                        "entry_id": "179cd493-7403-3baf-8a42-64a6bf278b93",
                                        "glosses": [
                                            "dekoratives rosenartiges Ornament"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "5a0d3597-e8ec-31d2-a452-4e1e40d03a52",
                                        "entry_id": "179cd493-7403-3baf-8a42-64a6bf278b93",
                                        "glosses": [
                                            "dekorativ eingeschlossenes Rundfenster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8820e32f-15c3-4f18-9dda-f477946a8aff",
                                                "sense_id": "5a0d3597-e8ec-31d2-a452-4e1e40d03a52",
                                                "text": "„Die Fassade zeigt in ihrer Gesamtanlage romanische Elemente ebenso wie die Rosette, die die Mittelpartie beherrscht und sie ist gotisch im schönen französischen Doppelportal.“"
                                            },
                                            {
                                                "example_id": "a87495f7-a8cc-4b84-8ff0-6782b947b6a4",
                                                "sense_id": "5a0d3597-e8ec-31d2-a452-4e1e40d03a52",
                                                "text": "„Eine Rosette darüber war unmittelbar hinter dem Gitterwerk vermauert.“"
                                            },
                                            {
                                                "example_id": "252896f0-6c66-4c55-8e60-bf0802196445",
                                                "sense_id": "5a0d3597-e8ec-31d2-a452-4e1e40d03a52",
                                                "text": "„Die Nähe der Toten war ihnen unangenehm; die Uhr der Kirche gab ein ständiges Röcheln von sich, und die Rosette in ihrem Giebelfeld sah aus wie ein Auge, das die Tempelschänder beobachtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "1df51a6a-464a-3b57-81a8-52cbd69ddde7",
                                        "entry_id": "179cd493-7403-3baf-8a42-64a6bf278b93",
                                        "glosses": [
                                            "runde Stoffschleife, die an Kleidung und Ordensbändern angebracht wird"
                                        ],
                                        "tags": [
                                            "Mode"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb1b913c-dc09-4e61-8e17-32cd15700e0e",
                                                "sense_id": "1df51a6a-464a-3b57-81a8-52cbd69ddde7",
                                                "text": "Im Knopfloch trug er eine kunstvoll arrangierte farbenreiche Rosette, welche die Ritterschaft vieler christlicher Orden dokumentierte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6c26332d-4abd-345e-8a78-6f5e6a2343fa",
                                        "entry_id": "179cd493-7403-3baf-8a42-64a6bf278b93",
                                        "glosses": [
                                            "sternförmig angeordnete Blätter bei einer Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54fe5cf5-2590-4b0c-80d7-7973ad7bd215",
                                                "sense_id": "6c26332d-4abd-345e-8a78-6f5e6a2343fa",
                                                "text": "„Die Echte Aloe hat circa zwanzig Blätter, die in dichter Rosette bis zu fünfzig Zentimeter hoch wachsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2521d889-b095-31a9-bcdf-01f20d825a14",
                                        "entry_id": "179cd493-7403-3baf-8a42-64a6bf278b93",
                                        "glosses": [
                                            "der After"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28cfc458-b061-4507-b155-8d4ea775046c",
                                                "sense_id": "2521d889-b095-31a9-bcdf-01f20d825a14",
                                                "text": "„Sein Mittelfinger fand ihre Rosette und rutschte hinein, während Sophie ihr Becken anhob.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7819d974-998b-3536-b8be-512d1dad7e2d",
                                        "entry_id": "179cd493-7403-3baf-8a42-64a6bf278b93",
                                        "glosses": [
                                            "rosenartige Schliffform bei Edelsteinen"
                                        ],
                                        "tags": [
                                            "Schmuckherstellung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ebf5e1f-83bd-4c92-8308-5f7f05d60789",
                                                "sense_id": "7819d974-998b-3536-b8be-512d1dad7e2d",
                                                "text": "„Eine zentrale Rosette in Diamanten und Rubinen umgibt die emaillierte Partie des Gehäuses in Blaßrosa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
