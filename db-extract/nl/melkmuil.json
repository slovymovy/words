                                "target_senses": [
                                    {
                                        "sense_id": "6321688d-cf94-3147-acaf-afea00bb41a7",
                                        "entry_id": "6949d714-5822-31d8-8979-435eb747e434",
                                        "glosses": [
                                            "Milchablagerung auf der Oberlippe nach Milchgenuss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4291ca9a-30e8-441c-9db9-acafdb1acfdf",
                                                "sense_id": "6321688d-cf94-3147-acaf-afea00bb41a7",
                                                "text": "Wisch dir mal den Milchbart ab!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a5b4bba-d697-3071-b76b-f86259ae7f42",
                                        "entry_id": "6949d714-5822-31d8-8979-435eb747e434",
                                        "glosses": [
                                            "unreifer junger Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d80e06e1-86c8-4ab4-b98b-a60ab4c757a2",
                                                "sense_id": "1a5b4bba-d697-3071-b76b-f86259ae7f42",
                                                "text": "„Der Leutnant ist blutjung, ein Milchbart, ein halbes Kind.“ (1909)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bdb63644-5946-338d-9b15-a7c4122d512d",
                                        "entry_id": "6949d714-5822-31d8-8979-435eb747e434",
                                        "glosses": [
                                            "erster Bart eines jungen Mannes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142c590c-5397-4c9a-8f1a-0391958a47d6",
                                                "sense_id": "bdb63644-5946-338d-9b15-a7c4122d512d",
                                                "text": "„Aus Eitelkeit ließ ich immer noch meinen ersten Milchbart stehen; dieser Flaum war mir teuer, weil er jeden Zweifel an meiner Jugend unmöglich machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0310a767-b797-406a-95cf-d7672d3955e2",
                        "source_entry_id": "32d72305-e6da-3727-b8b5-d5f10895929a",
                        "target_lang_word": "milksop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milksop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "150c5797-4b35-3996-93a7-fc0996da2bd3",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "A piece of bread sopped in milk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae5aadcf-2ea7-37f7-be30-b124c2d3077e",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "A dish consisting of bread pieces in a bowl, sprinkled with sugar and covered in hot milk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                        "entry_id": "dd0dea91-00a8-3b75-aaf8-32994a78bf01",
                                        "glosses": [
                                            "An easily frightened, ineffectual, or weak person."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e002abb7-0ac5-443c-a13b-c7039f3380eb",
                                                "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                                "text": "And vvho doth lead them but a paltrey fellovv,? / Long kept in Brittaine at our mothers coſt, / A milkeſopt, one that neuer in his life / Felt ſo much colde as ouer ſhooes in ſnovv: […]"
                                            },
                                            {
                                                "example_id": "804068f6-ebf0-4553-89f6-3d1d90a84154",
                                                "sense_id": "e7003fbb-b11b-3168-8be5-5900c7fadcd7",
                                                "text": "“That milksop of a creature pretend to be worthy of such a woman as Mrs. Pendennis,” broke out the Doctor: “where will impudence stop next!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e30d316d-661f-4365-88b2-9ae4b2e55a21",
                        "source_entry_id": "32d72305-e6da-3727-b8b5-d5f10895929a",
                        "target_lang_word": "blanc-bec",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blanc-bec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25ae0c20-c248-340b-bf06-b6fbc08b71bd",
                                        "entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                                        "glosses": [
                                            "Jeune homme qui n’a pas encore de barbe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                        "entry_id": "d38f251a-56b8-3629-a311-c6afb968054b",
                                        "glosses": [
                                            "Jeune homme sans expérience et trop sûr de lui."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6413c4ad-6f00-484e-9d48-08bad6382da2",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "Il trouvait que ce muscadin avait du bon et se mit à lui expliquer la façon de se comporter au régiment, pour ne pas avoir l’air d’un blanc-bec."
                                            },
                                            {
                                                "example_id": "446d8688-32e4-47e7-8d68-c6fda55c937f",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "— Tu ne sais donc pas ce que disait ma mère, blanc-bec ? reprenait gravement le plus vieux en baissant les yeux d’un air farouche et solennel pour se faire écouter."
                                            },
                                            {
                                                "example_id": "5decb270-aa7a-4471-baa7-77112ef66977",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "Un blanc-bec tel que vous provoquer en duel un personnage comme le baron !"
                                            },
                                            {
                                                "example_id": "56fcbc31-0801-43c9-8ace-1f8c106537e4",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "L’autre, en rajustant son habit, prenait cet air las et dégoûté des jeunes blancs-becs qui s’en viennent de livrer un galant assaut."
                                            },
                                            {
                                                "example_id": "c12033b4-09e1-4655-9bde-e17c385a61ce",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "— Sacrés jean-foutres de blancs-becs ! grogne le facteur en promenant autour de lui un œil courroucé. Le lait leur coule encore des narines, et ça voudrait chambarder tout !"
                                            },
                                            {
                                                "example_id": "01fef8bc-f0e9-4703-8348-84a70ce68470",
                                                "sense_id": "ead230d8-7471-3738-a2ae-ba8d24e01d24",
                                                "text": "Alors blanc bec t’aimes le basket\nBen on va ouèj à ma façon ;\nJ’vais juste un peu changer les règles :\nOn est les joueurs, toi t’es l’ballon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
