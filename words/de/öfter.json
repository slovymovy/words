                    "semantic_group_id": "haeufigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir haben diesen Film schon <w>öfter</w> zusammen im Fernsehen gesehen.",
                            "target_lang_translations": {
                                "en": "We have already seen this movie together on TV <w>several times</w>."
                            }
