                "senses": [
                    {
                        "sense_id": "68174842-d18a-367a-b8a9-6f05112e1c33",
                        "entry_id": "1a419ca4-2f16-3693-98ac-6733456484fc",
                        "glosses": [
                            "Körper einer jungen Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31501d42-4c9f-46e9-aa9b-fb192504a863",
                                "sense_id": "68174842-d18a-367a-b8a9-6f05112e1c33",
                                "text": "„Ich bekam Lust, den herrlichen Mädchenleib im Bilde zu besitzen, und ein deutscher Künstler malte sie mir göttlich schön für sechs Louis.“"
                            },
                            {
                                "example_id": "cbba1745-40d8-4cb8-ab24-a46157780b92",
                                "sense_id": "68174842-d18a-367a-b8a9-6f05112e1c33",
                                "text": "„Dieser junge Mädchenleib mit seiner verwirrenden Blutwärme nahm mir alle Besinnung.“"
                            },
                            {
                                "example_id": "3745085d-c690-4335-8a62-5e3ea26d4c87",
                                "sense_id": "68174842-d18a-367a-b8a9-6f05112e1c33",
                                "text": "„Mit beiden Armen umklammerte er den schmiegsamen Mädchenleib.“"
                            },
                            {
                                "example_id": "a75b445b-ab72-4418-8d34-398039285439",
                                "sense_id": "68174842-d18a-367a-b8a9-6f05112e1c33",
                                "text": "„Er fühlte die schlanke Gestalt des lieblichen Mädchens an seiner Brust, fühlte an seinem Körper ganz dicht einen warmen, weichen Mädchenleib und vernahm den rasenden Pulsschlag des anderen Herzens. “"
                            },
                            {
                                "example_id": "c6a10d1a-8003-4fa8-a76d-1e72d5fdd469",
                                "sense_id": "68174842-d18a-367a-b8a9-6f05112e1c33",
                                "text": "„Grausame Krämpfe schüttelten ihren schmalen Mädchenleib.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
