                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "44b8fe64-2400-422f-8c70-6e479459c1f9",
                        "entry_id": "eb13c70a-55b2-3ae2-834c-57d43d8945a7",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "géocentriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19147805-b920-32cb-abf0-92fc8cf146c5",
                        "entry_id": "eb13c70a-55b2-3ae2-834c-57d43d8945a7",
                        "glosses": [
                            "Qui a pour centre la planète Terre (et plus précisément le centre de celle-ci), ou qui est mesuré dans un référentiel centré sur elle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa534091-5cbc-4a7f-9785-b31524ad6238",
                                "sense_id": "19147805-b920-32cb-abf0-92fc8cf146c5",
                                "text": "La position d’un objet dans un référentiel géocentrique. Les coordonnées géocentriques ; la latitude, la longitude et la distance géocentriques d’un objet."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb1136eb-9ccb-35c9-b84f-3f7dbb79045f",
                        "entry_id": "eb13c70a-55b2-3ae2-834c-57d43d8945a7",
                        "glosses": [
                            "À propos d’une orbite, qui a pour foyer la planète Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3bdc597-b90d-48c4-8cba-b48b53d9014f",
                                "sense_id": "bb1136eb-9ccb-35c9-b84f-3f7dbb79045f",
                                "text": "Une orbite géocentrique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e076072b-0767-4d9a-bfa7-34d904187fa9",
                        "source_entry_id": "eb13c70a-55b2-3ae2-834c-57d43d8945a7",
                        "target_lang_word": "geozentrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geozentrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d33b15ce-bdf5-38a0-aaf2-c31a76df546b",
                                        "entry_id": "f8334dd6-45a4-3f36-8b0d-fb972927f270",
                                        "glosses": [
                                            "mit der Erde als Mittelpunkt, zum Beispiel des Universums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f2ea6d-7a9a-41d2-ae26-57558c83bcb5",
                                                "sense_id": "d33b15ce-bdf5-38a0-aaf2-c31a76df546b",
                                                "text": "Im Mittelalter galt das geozentrische Weltbild, also bevor Kopernikus das heliozentrische Weltbild mit der Sonne als Mittelpunkt entwickelte."
                                            },
                                            {
                                                "example_id": "10b277ef-4b7a-4e07-8fd0-890492940730",
                                                "sense_id": "d33b15ce-bdf5-38a0-aaf2-c31a76df546b",
                                                "text": "„Das Mittelalter war geozentrisch und anthropozentrisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84dbf5df-8e41-3c92-826a-812c475413c2",
                                        "entry_id": "f8334dd6-45a4-3f36-8b0d-fb972927f270",
                                        "glosses": [
                                            "vom Erdmittelpunkt aus berechnet; auf den Erdmittelpunkt bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cc53413-f2ef-44a9-8509-477c30481e5c",
                                                "sense_id": "84dbf5df-8e41-3c92-826a-812c475413c2",
                                                "text": "„Die Unterscheidung des Standortes des Beobachters (heliozentrisch, geozentrisch oder für einen bestimmten geographischen Standort topozentrisch) ist insbesondere für nahe Objekte wie die des Sonnensystems von Bedeutung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d866979e-24e1-4210-beca-d4ebf2da3c20",
                        "source_entry_id": "eb13c70a-55b2-3ae2-834c-57d43d8945a7",
                        "target_lang_word": "geocentric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geocentric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe0e373-acba-3aec-863b-17ba99754c9b",
                                        "entry_id": "65278694-d6a5-322f-94c2-6a57bc111c1d",
                                        "glosses": [
                                            "Having the Earth at the center."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2b56850-74dc-4fc8-88bd-9b62182b1c5d",
                                                "sense_id": "bfe0e373-acba-3aec-863b-17ba99754c9b",
                                                "text": "a geocentric coordinate system"
                                            },
                                            {
                                                "example_id": "69074f5f-5ea8-4c53-b5b2-5a82e150691b",
                                                "sense_id": "bfe0e373-acba-3aec-863b-17ba99754c9b",
                                                "text": "a geocentric orbit"
                                            },
                                            {
                                                "example_id": "40a085d9-9a63-43cf-aa5b-c2bab6062d28",
                                                "sense_id": "bfe0e373-acba-3aec-863b-17ba99754c9b",
                                                "text": "To make the Catalogue of Eclipses, as also the Table of the Parallaxes of [Jupiter], it was necessary first to make a Table of [Jupiter]' Heliocentrick places, to which the Parallaxes being applied, give the Geocentrick."
                                            },
                                            {
                                                "example_id": "e3437171-0eba-4501-9497-0a798d75e436",
                                                "sense_id": "bfe0e373-acba-3aec-863b-17ba99754c9b",
                                                "text": "Near-Earth objects (NEOs) that follow horseshoe paths, and approach our planet at close range and low relative velocity, may undergo mini-moon events in which their geocentric energy becomes negative for hours, days or months, but without completing one revolution around Earth while bound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "678dd7b0-9634-32e9-8444-6f69fd88ef98",
                                        "entry_id": "65278694-d6a5-322f-94c2-6a57bc111c1d",
                                        "glosses": [
                                            "Of or relating to geocentrism, an obsolete cosmology which placed the Earth at the center of the universe."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
