                ],
                "senses": [
                    {
                        "sense_id": "9561db36-6b33-34d8-bb1c-700ca1462ad4",
                        "entry_id": "0cf15d19-9305-3699-a617-2a8a714c5637",
                        "glosses": [
                            "умышленно не упоминать о ком-либо или о чём-либо, скрывать что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "233ebac4-b384-4e28-9bfc-62c030eb41aa",
                                "sense_id": "9561db36-6b33-34d8-bb1c-700ca1462ad4",
                                "text": "Дальше этого позорного стремления замалчивать открытия советской науки, затирать советских авторов ― некуда идти."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86597587-b382-45f8-a3cc-b7b8e8ea4497",
                        "source_entry_id": "0cf15d19-9305-3699-a617-2a8a714c5637",
                        "source_sense_id": "9561db36-6b33-34d8-bb1c-700ca1462ad4",
                        "target_lang_word": "taire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29558453-1a7b-32d2-b735-9dced9d8e075",
                                        "entry_id": "84d79319-da80-3533-8611-34659a97bb4b",
                                        "glosses": [
                                            "Ne pas dire ; passer sous silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "429e3342-791f-4f4b-91f7-efca90c9756c",
                                                "sense_id": "29558453-1a7b-32d2-b735-9dced9d8e075",
                                                "text": "Il vous a bien dit telle chose, mais il vous en a tu beaucoup d’autres."
                                            },
                                            {
                                                "example_id": "3b98e976-9b1b-4a05-94a8-1282973b027f",
                                                "sense_id": "29558453-1a7b-32d2-b735-9dced9d8e075",
                                                "text": "C’est un homme sûr et qui ne dit jamais rien de ce qu’il faut taire."
                                            },
                                            {
                                                "example_id": "9dbacb36-816d-4bf5-952e-08dc7584cf22",
                                                "sense_id": "29558453-1a7b-32d2-b735-9dced9d8e075",
                                                "text": "Comme chaque année désormais, la Marche des Fiertés avait été interdite par le gouverneur de la ville, mais les manifestants brandissant des drapeaux arc-en-ciel se sont rassemblés plusieurs heures avant le début annoncé de la manifestation, en des lieux soigneusement tus jusqu’au dernier moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a243618-6bab-32f6-bb82-98462f6f2ccd",
                                        "entry_id": "84d79319-da80-3533-8611-34659a97bb4b",
                                        "glosses": [
                                            "Maitriser un sentiment ; le contraindre au silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564537e7-6c86-4459-9a21-0e98d68f0b4a",
                                                "sense_id": "3a243618-6bab-32f6-bb82-98462f6f2ccd",
                                                "text": "Il a fait taire son ressentiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f77cc7-9f33-3c8f-ab85-d53be00505bb",
                                        "entry_id": "84d79319-da80-3533-8611-34659a97bb4b",
                                        "glosses": [
                                            "Ne pas faire de bruit ; en ce sens, il se dit des animaux, et généralement de tout ce qui est capable de faire du bruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4607144e-5235-43f0-bdd9-04431b01ff20",
                                                "sense_id": "32f77cc7-9f33-3c8f-ab85-d53be00505bb",
                                                "text": "Faites taire cet enfant."
                                            },
                                            {
                                                "example_id": "6a5e7f8d-171e-44d7-8b74-dae3826a6640",
                                                "sense_id": "32f77cc7-9f33-3c8f-ab85-d53be00505bb",
                                                "text": "Faites taire ces chiens."
                                            },
                                            {
                                                "example_id": "98785f79-9979-4a79-a5d4-8e7391dad5d5",
                                                "sense_id": "32f77cc7-9f33-3c8f-ab85-d53be00505bb",
                                                "text": "Notre canon a fait taire celui de l’ennemi, il a mis celui de l’ennemi hors d’état de continuer à tirer."
                                            },
                                            {
                                                "example_id": "2b49fc0c-9734-4a8d-9e20-f9b49e833ecc",
                                                "sense_id": "32f77cc7-9f33-3c8f-ab85-d53be00505bb",
                                                "text": "depuis que la coalition d’extrême droite dirigée par Giorgia Meloni a pris le pouvoir en octobre 2022, la liberté de la presse a été soumise à une pression croissante, avec des attaques et des violations sans précédent, souvent initiées par des hommes politiques dans le but de marginaliser et de faire taire les opinions divergentes»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                        "entry_id": "84d79319-da80-3533-8611-34659a97bb4b",
                                        "glosses": [
                                            "Garder le silence, s’abstenir de parler."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4fbb7d8-853a-4022-9747-736fd272aabc",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "– Je suis citoyen britannique ! – continua Bert, obstiné. – Vous n’êtes pas obligés d’écouter, mais rien ne me force à me taire."
                                            },
                                            {
                                                "example_id": "b4314fdf-d9e1-414c-a5ff-478dfcc0ce4d",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "Dans dix ans, parmi les vestiges de Beaumat, les souffles du vent, les croassements des corbeaux et la chute des pierres retentiront seuls ; nulle oreille humaine ne les entendra et la cloche du village elle-même se taira, fatiguée de tinter seulement pour les morts."
                                            },
                                            {
                                                "example_id": "1293e3b6-8712-408e-8166-4fe4f0788552",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "Il a manqué une belle occasion de se taire, il a parlé mal à propos, il s’est fait du tort en parlant."
                                            },
                                            {
                                                "example_id": "7e10d29d-969e-44bb-945f-80fb712fb420",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "Se taire sur quelque chose ou simplement se taire, ne pas divulguer un secret."
                                            },
                                            {
                                                "example_id": "ef2535de-063b-4edb-9a26-54a754898544",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "Il se tut sur ce que le hasard lui avait fait découvrir."
                                            },
                                            {
                                                "example_id": "029bb76c-2313-40a2-8a73-25b1cba82953",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "Il promit de se taire."
                                            },
                                            {
                                                "example_id": "639dea06-0af9-437a-a83b-aae75246fc59",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "Ne pouvoir se taire d’une chose, la publier partout, en parler sans cesse."
                                            },
                                            {
                                                "example_id": "1d87dc3e-c348-4e6e-ae35-07b5b32ef653",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "Il ne peut se taire sur le service, du service que vous lui avez rendu."
                                            },
                                            {
                                                "example_id": "d900012f-28b6-4983-92aa-282df96d3c56",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "En de telles circonstances, tous les ressentiments doivent se taire."
                                            },
                                            {
                                                "example_id": "5cc0d1c9-f2ad-4ef8-8752-570bf46c72dd",
                                                "sense_id": "3d5fdb21-875e-3bce-854f-05c470fe89eb",
                                                "text": "La mer et les vents se turent à la voix de Jésus-Christ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bb8940b-02f5-44dc-a13a-5f671467f4dd",
                        "source_entry_id": "0cf15d19-9305-3699-a617-2a8a714c5637",
                        "source_sense_id": "9561db36-6b33-34d8-bb1c-700ca1462ad4",
                        "target_lang_word": "passer sous silence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passer sous silence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0ec8b78-dc86-38d5-9f57-8068f4fb9a2b",
                                        "entry_id": "608f5be6-177b-32e0-8e97-df11159e80e7",
                                        "glosses": [
                                            "Taire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93396deb-0a41-4096-a9e8-2c77ebcb5f26",
                                                "sense_id": "d0ec8b78-dc86-38d5-9f57-8068f4fb9a2b",
                                                "text": "Je passe sous silence quelques variétés qui me paraissent nouvelles, mais sur lesquelles j’ai encore quelques doutes, ou bien qui n’offrent que très-peu d’intérêt, […]."
                                            },
                                            {
                                                "example_id": "2015971c-f3c8-4cff-b6b7-66df289b27b2",
                                                "sense_id": "d0ec8b78-dc86-38d5-9f57-8068f4fb9a2b",
                                                "text": "Pourtant, parmi les travaux qui se rapportent à cette période, parfois plus encore par leur nature que par leur date, il en est de trop importans pour que nous les passions sous silence."
                                            },
                                            {
                                                "example_id": "eff15859-7b99-4a98-bdfb-07d287ad0634",
                                                "sense_id": "d0ec8b78-dc86-38d5-9f57-8068f4fb9a2b",
                                                "text": "Cette aptitude à passer sous silence des événements que pourtant je ressentais assez vivement pour ne jamais les oublier, est un des traits qui me frappent le plus quand je me remémore mes premières années."
                                            },
                                            {
                                                "example_id": "056530ab-a3d8-48ef-9a2a-fe1ed5475d6b",
                                                "sense_id": "d0ec8b78-dc86-38d5-9f57-8068f4fb9a2b",
                                                "text": "En parlant des cafés, on ne saurait passer sous silence le bar-tabac. Car en France, le tabac, les cigarettes, les allumettes, les timbres-poste, les timbres fiscaux et les vignettes-auto se vendent dans les bars-tabac."
                                            },
                                            {
                                                "example_id": "759cb308-16b3-4121-92e8-dd3148ade412",
                                                "sense_id": "d0ec8b78-dc86-38d5-9f57-8068f4fb9a2b",
                                                "text": "Il ne faudrait pas passer sous silence le fait que les chercheurs et chercheures francophones se rencontrent aussi dans le cadre de colloques annuels et autres activités organisées par les centres de recherches dans les provinces."
                                            },
                                            {
                                                "example_id": "3b716528-da5e-49f5-a73f-23171c1b80c7",
                                                "sense_id": "d0ec8b78-dc86-38d5-9f57-8068f4fb9a2b",
                                                "text": "Impossible, pourtant, de passer sous silence le débat que soulevait cette affaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c5fc75b-a6b8-4b2e-99cf-b89774ec7fcb",
                        "source_entry_id": "0cf15d19-9305-3699-a617-2a8a714c5637",
                        "source_sense_id": "9561db36-6b33-34d8-bb1c-700ca1462ad4",
                        "target_lang_word": "cacher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34338403-ed3b-3917-b0e8-670d7e0a9e6c",
                                        "entry_id": "565aaacf-0d5c-32e5-968f-68f65675fe83",
                                        "glosses": [
                                            "Mettre (une personne ou une chose) en un lieu où on ne peut pas la voir, la recouvrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a58847a3-e7de-4a72-92e2-b92fab927228",
                                                "sense_id": "34338403-ed3b-3917-b0e8-670d7e0a9e6c",
                                                "text": "Cacher un trésor."
                                            },
                                            {
                                                "example_id": "91543bc4-28a1-4623-b644-a78815617ff0",
                                                "sense_id": "34338403-ed3b-3917-b0e8-670d7e0a9e6c",
                                                "text": "Il se cache pour ne pas être arrêté."
                                            },
                                            {
                                                "example_id": "626c5dc2-6592-4bd3-8f82-a28bdb518cdd",
                                                "sense_id": "34338403-ed3b-3917-b0e8-670d7e0a9e6c",
                                                "text": "Cacher des papiers, des pierreries, de l’argent, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c4eef1-fb88-3759-b7a9-ee0db1236892",
                                        "entry_id": "565aaacf-0d5c-32e5-968f-68f65675fe83",
                                        "glosses": [
                                            "Couvrir une chose, empêcher qu’on ne la voie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7f5affb-2c45-49a1-acc4-26f8498966a9",
                                                "sense_id": "17c4eef1-fb88-3759-b7a9-ee0db1236892",
                                                "text": "Rien de gracieux comme ses mouvements d’épaules, lorsqu’elle attire le menton pour se cacher entièrement la figure, qui, par instants, se montre à la dérobée."
                                            },
                                            {
                                                "example_id": "485f095f-1eda-4c61-859a-ecefa3a789f9",
                                                "sense_id": "17c4eef1-fb88-3759-b7a9-ee0db1236892",
                                                "text": "Elle a remis une robe ; elle me cache tous les beaux secrets qu’elle cache à tous ; elle est rentrée dans le deuil de sa pudeur."
                                            },
                                            {
                                                "example_id": "c4977127-3948-4e42-af20-eb6d4128904d",
                                                "sense_id": "17c4eef1-fb88-3759-b7a9-ee0db1236892",
                                                "text": "Elle disposa les fleurs au chevet, fit arrêter le balancier de l'horloge, voiler les glaces et les miroirs, fermer les fenêtres et cacher les portraits."
                                            },
                                            {
                                                "example_id": "4dbc9a4e-c39b-476a-b98b-2b3674d30d62",
                                                "sense_id": "17c4eef1-fb88-3759-b7a9-ee0db1236892",
                                                "text": "Quand il mettait un ortolan entier dans sa bouche, il cachait dans ses deux mains sa face rouge et bleue comme le cou des dindons quand on les siffle, et il fallait que les enfants fissent silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e21477e-61e5-3328-8f1b-772dc824dd5f",
                                        "entry_id": "565aaacf-0d5c-32e5-968f-68f65675fe83",
                                        "glosses": [
                                            "Mettre à l'abri."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99a4d59-9130-402f-89ce-e56fa6938fa9",
                                                "sense_id": "1e21477e-61e5-3328-8f1b-772dc824dd5f",
                                                "text": "Pendant les alertes c'est là qu'on venait aux abris et quand il faisait trop froid. L'hiver c'est là qu'on vient se cacher avec les filles et toutes les nuits y’a des clodos qui viennent y roupiller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                        "entry_id": "565aaacf-0d5c-32e5-968f-68f65675fe83",
                                        "glosses": [
                                            "Taire ; celer ; dissimuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e66691-bd43-4c71-9eea-47dec8d6901c",
                                                "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                                "text": "Quand Eugène fut parti, Félicité essaya de pénétrer le secret qu’on lui cachait."
                                            },
                                            {
                                                "example_id": "df237460-09b0-4e96-8ff4-67d95a9664ab",
                                                "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                                "text": "Mettez-vous en garde contre ces belles promesses, elles cachent souvent la plus infame des tromperies."
                                            },
                                            {
                                                "example_id": "d2a73eb4-3b3a-475d-8709-aa0be850abba",
                                                "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                                "text": "Notre homme était un officier supérieur à la retraite qui cachait, j’allais l'apprendre assez vite, une fine culture littéraire derrière son côté scrogneugneu."
                                            },
                                            {
                                                "example_id": "74abcff9-4559-491b-93bc-0aba1d3ecf56",
                                                "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                                "text": "N’avoir rien de caché pour quelqu’un, Ne rien lui cacher de ce qu’on pense ou de ce qu’on projette"
                                            },
                                            {
                                                "example_id": "4f133c43-c81f-4d9e-b5c2-d3e0b266f2f1",
                                                "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                                "text": "Je ne vous cache pas que cela m’inquiète beaucoup."
                                            },
                                            {
                                                "example_id": "66784302-38d6-413a-b9d2-6a16a722cac7",
                                                "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                                "text": "Sous cet air d’indifférence il cachait une ambition démesurée."
                                            },
                                            {
                                                "example_id": "1b6db21c-1f69-4478-bf54-6d30d0651a7a",
                                                "sense_id": "08055210-32b8-3bed-b234-2b1385055910",
                                                "text": "Y a-t-il quelque chose que vous cachez à votre famille? Vous devez partager ceci maintenant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cb3e7e-3d29-3bd7-9364-9f1181c2109c",
                                        "entry_id": "565aaacf-0d5c-32e5-968f-68f65675fe83",
                                        "glosses": [
                                            "Placer en mémoire cache."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b95c284b-c6d8-4546-b8d0-955372d8466a",
                                                "sense_id": "f2cb3e7e-3d29-3bd7-9364-9f1181c2109c",
                                                "text": "À titre d'exemple, Windows exploite une partie de la mémoire centrale pour \"cacher\" les données accessibles sur les lecteurs de disques durs, de disquettes et de CD-ROM."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cacher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0254b01-18ad-3cce-8f7a-a395ba89e729",
