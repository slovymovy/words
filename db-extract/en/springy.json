                                                "sense_id": "b99d3454-72f7-33e7-9bc9-120c586130b9",
                                                "text": "Un tissu élastique."
                                            },
                                            {
                                                "example_id": "068f57ef-2c82-4be0-94f0-0aa8fa8a05e6",
                                                "sense_id": "b99d3454-72f7-33e7-9bc9-120c586130b9",
                                                "text": "Une peau douce et fine, tendue sur une chair ferme et élastique, apanage exclusif de la fraîcheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c8eebe-c6d1-35d1-af55-3d9bdcde1347",
                                        "entry_id": "1ccd4e31-5549-31d9-80fa-d16b3e2dc581",
                                        "glosses": [
                                            "Qui a une apparence de souplesse, qui s'effectue avec beaucoup d'aisance."
                                        ],
                                        "tags": [],
                                        "examples": [
