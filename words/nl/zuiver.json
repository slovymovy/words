                    "sense_definition": "gebiedende wijs van <w>zuiveren</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zuiver</w> de lucht in deze kamer door het raam open te zetten!",
                            "target_lang_translations": {
                                "en": "<w>Purify</w> the air in this room by opening the window!"
                            }
                        },
                        {
                            "text": "<w>Zuiver</w> eerst je eigen gedachten voordat je anderen bekritiseert.",
                            "target_lang_translations": {
                                "en": "<w>Purify</w> your own thoughts first before criticizing others."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative mood of 'to purify'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purify",
                                "target_lang_sense_clarification": "command to make clean"
                            },
                            {
                                "target_lang_word": "cleanse",
                                "target_lang_sense_clarification": "command to clean or rid of impurities"
                            }
                        ]
                    }
                }
            ]
        }
