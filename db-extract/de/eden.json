                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4edfc321-32aa-38b2-b111-16f5a286e038",
                                        "entry_id": "edb8b2b9-5b50-3ac2-9683-b3bea2f9c57d",
                                        "glosses": [
                                            "A garden built by God as the home for Adam and Eve; sometimes identified as part of Mesopotamia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585385c7-3bb5-4a5f-9091-db836b4f6ede",
                                                "sense_id": "4edfc321-32aa-38b2-b111-16f5a286e038",
                                                "text": "And the LORD God planted a garden Eastward in Eden; and there he put the man whom he had formed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d456924a-95a5-3947-a428-2b39b96473f1",
                                        "entry_id": "edb8b2b9-5b50-3ac2-9683-b3bea2f9c57d",
                                        "glosses": [
                                            "An English surname, probably derived from a place name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67022874-8cd5-431f-bd79-f4a8c3c57619",
                                                "sense_id": "d456924a-95a5-3947-a428-2b39b96473f1",
                                                "text": "It was no good. I felt beyond all question that I was indeed Eden, not Elvesham. But Eden in Elvesham's body!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd8b06a4-c7e2-3346-8533-94d9fe2af932",
                                        "entry_id": "edb8b2b9-5b50-3ac2-9683-b3bea2f9c57d",
                                        "glosses": [
                                            "A female given name from Hebrew from the biblical place name; also a medieval diminutive of Old English compound names beginning with the element ēad (“riches”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dffad2d-3024-4125-9829-3ecd9a9ad6f8",
                                                "sense_id": "bd8b06a4-c7e2-3346-8533-94d9fe2af932",
                                                "text": "We call Edith Eden now because that is what she called herself before she could pronounce 'th'. It is rather a lovely name, I think. Edith sounds like someone's old aunt. I can't think why Mother and Father chose it."
                                            }
                                        ]
                                    },
