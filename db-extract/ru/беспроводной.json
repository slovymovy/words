                                        "glosses": [
                                            "Qui permet de transmettre des signaux sans avoir recours à des câbles, en utilisant des ondes radioélectriques ou infrarouges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4870f813-de98-4263-850a-e9006a298bf2",
                                                "sense_id": "362988ee-2bf7-35e7-9bf2-cb838b454562",
                                                "text": "Un réseau local sans fil."
                                            },
                                            {
                                                "example_id": "8296b692-d823-44ec-96ae-6f48e23d16a7",
                                                "sense_id": "362988ee-2bf7-35e7-9bf2-cb838b454562",
                                                "text": "– Excusez-moi, j’aurais aimé avoir des infos sur les haut-parleurs qu’on peut connecter en Wi-Fi.\n…\nBon, regardez, il y a des brochures là-bas qui donnent un paquet d’informations sur les enceintes sans fil."
                                            }
                                        ]
                                    },
