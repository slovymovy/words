                        "entry_id": "84d7301b-12eb-318c-8d12-642bd8024b5b",
                        "glosses": [
                            "Consisting of multiple cells; multicellular"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b7d95fb-e0e9-475d-babe-2f3517755a39",
                                "sense_id": "cf39e866-d8cf-3d74-8a1f-47d246e47b08",
                                "text": "Fusion events in vivo, particularly in embryonic development, often involve the purse-string contraction of a pluricellular actomyosin cable at the free edge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fc20dba-b4a7-4c37-b04b-735c0c71c885",
                        "source_entry_id": "84d7301b-12eb-318c-8d12-642bd8024b5b",
