                "senses": [
                    {
                        "sense_id": "4b2ab721-e680-391c-8db4-9ce31a75200d",
                        "entry_id": "0821ed1c-06af-3470-b9a4-8851d9db151c",
                        "glosses": [
                            "Trouble de la prononciation."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e5ad1a8d-9dd0-4a8c-b9af-16465bd1e79c",
                                "sense_id": "4b2ab721-e680-391c-8db4-9ce31a75200d",
                                "text": "A l’opposé de ces dysphasies existent des troubles portant uniquement sur la prononciation, troubles curables, et probablement inorganiques. C’est pour ces derniers que M. Meige a proposé le nom de « dystomies »."
                            },
                            {
                                "example_id": "eed60ba5-ce83-4bc6-b1a7-d9d4a4003a0e",
                                "sense_id": "4b2ab721-e680-391c-8db4-9ce31a75200d",
                                "text": "Sa légère dystomie est la manifestation apparente de sa très grande émotivité dans des attitudes qu’elle perçoit comme une agression de ses références."
                            },
                            {
                                "example_id": "2a3dd529-e557-42f3-9e8f-e49d3aec376e",
                                "sense_id": "4b2ab721-e680-391c-8db4-9ce31a75200d",
                                "text": "L’enfant en grandissant montrait des signes évidents de dystomie : il bégayait."
                            }
                        ]
                    }
                ],
