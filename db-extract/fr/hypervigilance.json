                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c2df5da7-a907-461d-b8df-a9ecc3bce53c",
                        "entry_id": "e0522a8b-5a8b-3a44-9be9-e4cb3ad9a73d",
                        "tags": [
                            "plural"
                        ],
                        "form": "hypervigilances"
