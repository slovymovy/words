                        ],
                        "form": "das Pfühl"
                    },
                    {
                        "form_id": "2d849ff7-3c3e-435b-ba27-a2c47747e553",
                        "entry_id": "6aa4e6bd-e4ea-3e0d-9ff6-bbfd9fb9d61a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Pfühle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84fdae8a-1a1c-36f2-98e0-2c04015d096e",
                        "entry_id": "6aa4e6bd-e4ea-3e0d-9ff6-bbfd9fb9d61a",
                        "glosses": [
                            "großes, weiches Kissen"
                        ],
                        "tags": [
                            "archaic",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "d4329bdc-6024-4bb9-86b3-4ffc9b2ba638",
                                "sense_id": "84fdae8a-1a1c-36f2-98e0-2c04015d096e",
                                "text": "„[…] in die Kissen und die Pfühle, denn man liegt nicht gerne kühle.“"
                            },
                            {
                                "example_id": "ec9a4161-a10d-4a7a-9594-c271d6248b8e",
                                "sense_id": "84fdae8a-1a1c-36f2-98e0-2c04015d096e",
                                "text": "„O gib, vom weichen Pfühle, träumend ein halb Gehör[…]“"
                            },
                            {
                                "example_id": "87a38db0-ad1f-473f-ac92-73847c6bc918",
                                "sense_id": "84fdae8a-1a1c-36f2-98e0-2c04015d096e",
                                "text": "„Ich mache zum Pfühl die Gräser und Blüten.“"
                            },
                            {
                                "example_id": "fe01b195-b344-4084-abd1-380f15c1f5f5",
                                "sense_id": "84fdae8a-1a1c-36f2-98e0-2c04015d096e",
                                "text": "„Natascha kauerte sich auf dem blaugestreiften Pfühl zusammen, umarmte die Freundin und schluchzte haltlos.“"
                            },
                            {
                                "example_id": "33bb321e-87a4-46cf-b5fa-deaf874d4539",
                                "sense_id": "84fdae8a-1a1c-36f2-98e0-2c04015d096e",
                                "text": "„Nachts war Mondschein, und er war längst hinunter in seine Stube gegangen, aber sie vermochte keinen Schlummer zu finden, wandte sich nur ruhelos in den Pfühlen hin und her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
