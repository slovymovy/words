                                "target_senses": [
                                    {
                                        "sense_id": "8267d9eb-1ad1-336d-bf9c-fa70d1de79b9",
                                        "entry_id": "30d2b49b-2cd4-36de-9e2d-e210fc9dad41",
                                        "glosses": [
                                            "To break, or cause something to break."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f31c7025-a425-3065-a6ae-4858996bc81f",
                                        "entry_id": "30d2b49b-2cd4-36de-9e2d-e210fc9dad41",
                                        "glosses": [
                                            "To amuse (a person) greatly; to split someone's sides."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7730e3fa-00e7-4bcc-8ee2-2f0f7956b60f",
                                                "sense_id": "f31c7025-a425-3065-a6ae-4858996bc81f",
                                                "text": "“You fracture me, Frankie,” Patsy said. “You should take that act on the road. Howsabout now?” This is the way it would go whenever I showed up at Patsy's, a dual of digs and wisecracks with the disapproving groans of those within earshot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbcf65ba-5c37-4bcd-9aad-eb316fb999d5",
                        "source_entry_id": "69ed5ffc-a2d2-380f-96e8-bfce2083fa8a",
                        "source_sense_id": "04ae59ab-a3c7-30ff-82b8-45abaf2aea7b",
                        "source_sense_description": "een botbreuk",
                        "target_lang_word": "fracture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fracture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0de55d54-6723-380c-b7e1-3e095c472d6c",
                                        "entry_id": "9bae93ce-42c5-3408-8c5d-76c4776122f5",
                                        "glosses": [
                                            "Rupture avec effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fc02ce-53dd-4d67-bcc1-69c85d158a81",
                                                "sense_id": "0de55d54-6723-380c-b7e1-3e095c472d6c",
                                                "text": "Éclisse : petit morceau de bois plat & mince dont on se sert dans le jardinage comme en chirurgie, pour soutenir & garantir des fractures, en assujettissant les branches fêlées, & facilitant leur reprise."
                                            },
                                            {
                                                "example_id": "622f700d-79d3-4404-b00b-2b4f2c493463",
                                                "sense_id": "0de55d54-6723-380c-b7e1-3e095c472d6c",
                                                "text": "Une fracture du sol pouvait engloutir ses compagnons et lui."
                                            },
                                            {
                                                "example_id": "2b9a5de2-dc5a-44a6-aa4e-135c5b2084c2",
                                                "sense_id": "0de55d54-6723-380c-b7e1-3e095c472d6c",
                                                "text": "C'est à la « fracture du pain » que les deux hommes d'Emmaüs reconnaissent Jésus, à la « fracture du pain » que les apôtres se retrouvent dans les Actes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aafd930-bf12-33f1-934d-9c440b10fb00",
                                        "entry_id": "9bae93ce-42c5-3408-8c5d-76c4776122f5",
                                        "glosses": [
                                            "Lésion osseuse consistant en une rupture accompagnée ou non de déplacement des téguments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a84016-3344-4a74-af17-95bacd86cb98",
                                                "sense_id": "0aafd930-bf12-33f1-934d-9c440b10fb00",
                                                "text": "Un des accidens le plus ordinaires aux cornes, est la fracture."
                                            },
                                            {
                                                "example_id": "bf4e5496-8fe4-4839-b33b-a890fc6175a4",
                                                "sense_id": "0aafd930-bf12-33f1-934d-9c440b10fb00",
                                                "text": "— Il s'agissait des blessés de la catastrophe de chemin de fer de Lothiers. On m'a amené le 6 décembre, dans la matinée, environ cent soixante fractures, presque toutes de jambes et de cuisses."
                                            },
                                            {
                                                "example_id": "782b23ef-45c5-42fc-aa8f-7e1c18d48804",
                                                "sense_id": "0aafd930-bf12-33f1-934d-9c440b10fb00",
                                                "text": "Après ma fracture du bassin, et au terme d'une rééducation peu satisfaisante chez le kiné, je suis allée chez une fasciathérapeute : […]."
                                            },
                                            {
                                                "example_id": "74ad8e78-f248-45cd-94f3-860aca45d27d",
                                                "sense_id": "0aafd930-bf12-33f1-934d-9c440b10fb00",
                                                "text": "Le LBD provoque des fractures, des hématomes et des contusions (pulmonaires, osseuses, cérébrales). Il arrache des joues et éborgne. Il a occasionné des comas de quelques jours à un mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a922095e-d59a-34f6-863a-b485b8469dd0",
                                        "entry_id": "9bae93ce-42c5-3408-8c5d-76c4776122f5",
                                        "glosses": [
                                            "Division au sein du corps social jugée anormale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e968c505-77fe-4bf5-be88-c8961314c03e",
                                                "sense_id": "a922095e-d59a-34f6-863a-b485b8469dd0",
                                                "text": "Depuis quelques mois, certains responsables politiques s’entichent d’un nouvel intellectuel, qui ausculte, lui aussi, les fractures des sociétés occidentales : David Goodhart, auteur de The road to somewhere (Penguin Books Ltd, 2017, non traduit)."
                                            },
                                            {
                                                "example_id": "664c398c-d313-46bc-b109-d046108c491b",
                                                "sense_id": "a922095e-d59a-34f6-863a-b485b8469dd0",
                                                "text": "Et ce qui m’inquiète le plus, c’est que toutes les polémiques actuelles ne polarisent la société au point de créer une fracture qui, au bout du compte, nuirait grandement aux minorités."
                                            }
                                        ]
                                    }
                                ]
                            },
