                        "source_sense_id": "b286732c-0749-3457-8dbc-29471ff3a5d6",
                        "target_lang_word": "belly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a06d6015-9d28-3add-9045-8586b29d4ee0",
                                        "entry_id": "d429669d-7910-3ff2-bdf8-28b1f3a258d2",
                                        "glosses": [
                                            "The abdomen (especially a fat one)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02c25212-be3e-4b2c-a06d-0de81c48e502",
                                                "sense_id": "a06d6015-9d28-3add-9045-8586b29d4ee0",
                                                "text": "You've grown a belly over Christmas! Time to join the gym again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65501443-ed52-3536-b79f-b946913ac807",
                                        "entry_id": "d429669d-7910-3ff2-bdf8-28b1f3a258d2",
                                        "glosses": [
                                            "stomach (an organ in animals that stores food in the process of digestion)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9021f365-d2b0-44ed-a366-bac2fb7eea59",
                                                "sense_id": "65501443-ed52-3536-b79f-b946913ac807",
                                                "text": "My belly was full of wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9145fbe-cf5b-3eec-9a2a-451631bb5f98",
                                        "entry_id": "d429669d-7910-3ff2-bdf8-28b1f3a258d2",
                                        "glosses": [
                                            "uterus (a reproductive organ of therian mammals in which the young are conceived and develop until birth)"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27d3d52c-813a-4a23-b751-c11fe72bd903",
                                                "sense_id": "d9145fbe-cf5b-3eec-9a2a-451631bb5f98",
                                                "text": "Before I formed thee in the bellie, I knew thee; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f1e8a68-8b1d-3886-963c-0e7bc820fd76",
                                        "entry_id": "d429669d-7910-3ff2-bdf8-28b1f3a258d2",
                                        "glosses": [
                                            "The lower fuselage of an airplane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd65cb5-2765-4d49-9d41-e4641c0839c6",
                                                "sense_id": "4f1e8a68-8b1d-3886-963c-0e7bc820fd76",
                                                "text": "There was no heat, and we shivered in the belly of the plane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1b3e79-6df2-3d21-8f0a-e997d016521f",
                                        "entry_id": "d429669d-7910-3ff2-bdf8-28b1f3a258d2",
                                        "glosses": [
                                            "The part of anything which resembles (either closely or abstractly) the human belly in protuberance or in concavity; often, the fundus (innermost part)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1864b6-dcca-4d72-9b2e-1855f54320f4",
                                                "sense_id": "0f1b3e79-6df2-3d21-8f0a-e997d016521f",
                                                "text": "the belly of a flask, muscle, violin, sail, or ship"
                                            },
                                            {
                                                "example_id": "cfca5dd5-0aad-4ebc-94f1-7a5a40258c40",
                                                "sense_id": "0f1b3e79-6df2-3d21-8f0a-e997d016521f",
                                                "text": "[…] I cried by reason of mine affliction vnto the Lord, and hee heard mee; out of the belly of hell cried I, and thou heardest my voyce."
                                            },
                                            {
                                                "example_id": "a34e13e8-9118-44de-bfcb-243f2f46a721",
                                                "sense_id": "0f1b3e79-6df2-3d21-8f0a-e997d016521f",
                                                "text": "At last I got my knife and cut the halyards. The peak dropped instantly, a great belly of loose canvas floated broad upon the water […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f1a6b8-995c-3d9c-9309-f7e69b5e50d5",
                                        "entry_id": "d429669d-7910-3ff2-bdf8-28b1f3a258d2",
                                        "glosses": [
                                            "The part of anything which resembles (either closely or abstractly) the human belly in protuberance or in concavity; often, the fundus (innermost part).",
                                            "The main curved portion of a knife blade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75b30049-474e-3579-a28e-f7140eba36df",
                                        "entry_id": "d429669d-7910-3ff2-bdf8-28b1f3a258d2",
                                        "glosses": [
                                            "The part of anything which resembles (either closely or abstractly) the human belly in protuberance or in concavity; often, the fundus (innermost part).",
                                            "The hollow part of a curved or bent timber, the convex part of which is the back."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "belly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6208e4e-d7c2-309f-a277-8e9874ecf6ee",
                                        "entry_id": "b8753d73-da36-36a6-85c0-3f4b1a5a21d4",
                                        "glosses": [
                                            "To position one’s belly; to move on one’s belly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5372fcac-ead8-4589-9e8e-0dda88873efa",
                                                "sense_id": "c6208e4e-d7c2-309f-a277-8e9874ecf6ee",
                                                "text": "Bellying forward to the edge of the clearing, he found Hans, lying on his face, feathered with arrows like a porcupine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e441564-1bc0-36f7-974b-d3d6c1bda061",
                                        "entry_id": "b8753d73-da36-36a6-85c0-3f4b1a5a21d4",
                                        "glosses": [
                                            "To swell and become protuberant; to bulge or billow."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7d80c2-5763-4894-bb95-c25c3f420684",
                                                "sense_id": "4e441564-1bc0-36f7-974b-d3d6c1bda061",
                                                "text": "The Pow'r appeaſ'd, with Winds ſuffic'd the Sail, / The bellying Canvaſs ſtrutted with the Gale; […]"
                                            },
                                            {
                                                "example_id": "0ea41451-e3bb-492d-bc10-eb3d257fbdb9",
                                                "sense_id": "4e441564-1bc0-36f7-974b-d3d6c1bda061",
                                                "text": "The halliards twanged against the tops, the bunting bellied broad,"
                                            },
                                            {
                                                "example_id": "ff2a202a-0ca1-4fd0-8ff5-45040f86d4d3",
                                                "sense_id": "4e441564-1bc0-36f7-974b-d3d6c1bda061",
                                                "text": "There were trees whose trunks bellied into huge swellings."
                                            },
                                            {
                                                "example_id": "42aa64f8-36e1-4fc5-85bf-30910c691997",
                                                "sense_id": "4e441564-1bc0-36f7-974b-d3d6c1bda061",
                                                "text": "1917 rev. 1925 Ezra Pound, \"Canto I\"\nwinds from sternward\nBore us onward with bellying canvas ..."
                                            },
                                            {
                                                "example_id": "3758d6c4-1f9e-464a-8b3e-6fa592634c22",
                                                "sense_id": "4e441564-1bc0-36f7-974b-d3d6c1bda061",
                                                "text": "1930, Otis Adelbert Kline, The Prince of Peril, serialized in Argosy, Chapter 1,\nThe building stood on a circular foundation, and its walls, instead of mounting skyward in a straight line, bellied outward and then curved in again at the top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0df794bc-a619-3775-a5a2-aca7994bbd4e",
                                        "entry_id": "b8753d73-da36-36a6-85c0-3f4b1a5a21d4",
                                        "glosses": [
                                            "To cause to swell out; to fill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29008d62-ed56-411f-936d-cae82b86f6df",
                                                "sense_id": "0df794bc-a619-3775-a5a2-aca7994bbd4e",
                                                "text": "A breeze which had crossed a thousand miles of wheat-lands bellied her taffeta skirt in a line so graceful, so full of animation and moving beauty, that the heart of a chance watcher on the lower road tightened to wistfulness over her quality of suspended freedom."
                                            },
                                            {
                                                "example_id": "a1592823-5e58-47a5-95d3-ee8bd1e45ba8",
                                                "sense_id": "0df794bc-a619-3775-a5a2-aca7994bbd4e",
                                                "text": "Your breath of full consent bellied his sails; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
