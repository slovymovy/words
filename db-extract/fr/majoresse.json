                "senses": [
                    {
                        "sense_id": "1815efeb-0bc1-397a-a55a-fdc52604d266",
                        "entry_id": "8ed3521b-a14f-37fe-91ac-95e5f32a9446",
                        "glosses": [
                            "Épouse d’un major."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "791216a0-5271-4b28-89ee-078ecf28b903",
                                "sense_id": "1815efeb-0bc1-397a-a55a-fdc52604d266",
                                "text": "Pour cette majoresse de qui l’on raconte au régiment qu’elle a sacrifié à la carrière de son mari de réels dons musicaux, c’est bien le « grand amour », pourtant, qu’il éprouve soudain."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c8e1c78-8123-3592-8124-2c369e097332",
                        "entry_id": "8ed3521b-a14f-37fe-91ac-95e5f32a9446",
                        "glosses": [
                            "Première d’une promotion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01505ac3-6e30-4715-a8f8-977d6e5caf9e",
                                "sense_id": "3c8e1c78-8123-3592-8124-2c369e097332",
                                "text": "On ne put compter sur moi pour ouvrir le premier bal de l’Ecole Normale avec la « majoresse » de la promotion de normaliennes jumelle de la nôtre, comme c’était la coutume, m’avait-on dit…"
                            }
                        ]
                    },
                    {
                        "sense_id": "0a5eef25-b694-38c6-b6cd-4e12206354da",
                        "entry_id": "8ed3521b-a14f-37fe-91ac-95e5f32a9446",
                        "glosses": [
                            "Variante orthographique de mayoresse."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "82f566b9-4c69-400f-92c5-a30c9d3766a2",
                                "sense_id": "0a5eef25-b694-38c6-b6cd-4e12206354da",
                                "text": "Isabelle, comtesse de Biandrate, majoresse de Viège, vidomnesse de Conches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e30dcd29-87c3-498e-84c7-1a78b4fd8d18",
                        "source_entry_id": "8ed3521b-a14f-37fe-91ac-95e5f32a9446",
                        "source_sense_id": "1815efeb-0bc1-397a-a55a-fdc52604d266",
                        "source_sense_description": "Épouse d’un major",
                        "target_lang_word": "majoress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majoress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "124073f6-b158-3456-b871-d03ae294c899",
                                        "entry_id": "93ff3237-048a-35c8-b8c7-92b3290580ca",
                                        "glosses": [
                                            "A female major."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a402c08-efc6-4e0f-9e0b-66b80fbd0ea4",
                                                "sense_id": "124073f6-b158-3456-b871-d03ae294c899",
                                                "text": "Suppose a Coloneless, or a Majoress, or a Captainess received orders to lead her men up to a dangerous post, under a heavy fire, how would she do it?"
                                            },
                                            {
                                                "example_id": "fdb13826-1e72-46ce-bfc3-3d9481ffc919",
                                                "sense_id": "124073f6-b158-3456-b871-d03ae294c899",
                                                "text": "Imagine my feelings when I found that it was composed of the nicest young ladies, in such very becoming uniforms, with a stout old drum-majoress."
                                            },
                                            {
                                                "example_id": "7fc80885-f8f1-40bd-af3a-4a8af0f3f267",
                                                "sense_id": "124073f6-b158-3456-b871-d03ae294c899",
                                                "text": "But instead, the soldiery will fatten and grow sleek and strong and Commissary Sergeantess Morgan will be promoted and become a Lieutenantess, and then a Captainess, and afterwards a Majoress, and from that to Coloneless, and who knows but some time when she inspects the camp the voice of the sentry at post No. 1 will be heard calling as she approaches: “The Generaless of the Colorado Militia! Turn out the guard!”"
                                            },
                                            {
                                                "example_id": "081618da-2574-4c2d-a505-b8bff5c73da2",
                                                "sense_id": "124073f6-b158-3456-b871-d03ae294c899",
                                                "text": "If the governor of Kentucky is now making colonels by the wholesale, he is doing it “for a reason.” It is a mere unfortunate incident, for him, that he can not make colonelesses and majoresses. The grip of the appointive power on the women is even stronger than on the men."
                                            },
                                            {
                                                "example_id": "4a71cd1f-151a-416f-8606-478404300645",
                                                "sense_id": "124073f6-b158-3456-b871-d03ae294c899",
                                                "text": "SERGEANT-MAJORESS? A British army male sergeant major, who hopes to start the new year as a woman, has been confined to barracks pending an investigation into his revelations to the news media."
                                            },
                                            {
                                                "example_id": "d45a4db4-49b0-4a6d-a89d-bda53501261f",
                                                "sense_id": "124073f6-b158-3456-b871-d03ae294c899",
                                                "text": "No one else can define these points for a young man, not his Major – present or not present – or his Majoress, not his friends nor his job nor his education or lack thereof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8556b584-fb50-3ee5-8d78-a4246d014a69",
                                        "entry_id": "93ff3237-048a-35c8-b8c7-92b3290580ca",
                                        "glosses": [
                                            "The wife of a major."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75b8ba7f-7bab-4878-b998-ba13092df193",
                                                "sense_id": "8556b584-fb50-3ee5-8d78-a4246d014a69",
                                                "text": "God be praiſed! my worthy lady majoreſs! my dear, fortune major!"
                                            },
                                            {
                                                "example_id": "0c13f94a-4521-4179-88fc-dfa2c5e01711",
                                                "sense_id": "8556b584-fb50-3ee5-8d78-a4246d014a69",
                                                "text": "Landlords Arthur and Angie Cascoe and clown Alic Gostonski steady the ribbon for Major and Majoress John and Shirley to officially open the event"
                                            },
                                            {
                                                "example_id": "7ac8b75c-d2f7-41da-bc20-b0cddfe8fa05",
                                                "sense_id": "8556b584-fb50-3ee5-8d78-a4246d014a69",
                                                "text": "other guests include: MISS WINSFORD 1997, WINSFORD TOWN MAJOR & MAJORESS"
                                            },
                                            {
                                                "example_id": "7b1642c1-2c18-481a-a0fd-5f819ea4f61c",
                                                "sense_id": "8556b584-fb50-3ee5-8d78-a4246d014a69",
                                                "text": "Special guests for the evening will be Deputy Major and Majoress, Mr and Mrs Tom Dawn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
