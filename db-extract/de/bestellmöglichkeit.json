                        "examples": [
                            {
                                "example_id": "c8c3edba-ec8d-427d-b4ec-7a7aeb4b5d1d",
                                "sense_id": "41e55fe9-6614-307e-a1ed-97e2c6ec1f74",
                                "text": "Bei der letzten Bestellmöglichkeit für das limitierte Produkt ist der Server zusammengebrochen."
                            },
                            {
                                "example_id": "ce3a6d27-4cc2-45b6-9b81-52af7fe1ba06",
                                "sense_id": "41e55fe9-6614-307e-a1ed-97e2c6ec1f74",
                                "text": "„Nahezu jede stationäre Sortimentsbuchhandlung bietet heute die Bestellmöglichkeit über das Internet und wird so auch zur Versandbuchhandlung.“"
                            },
                            {
                                "example_id": "40c1ce0e-17cd-4d7d-a6c5-580f2d777ed9",
                                "sense_id": "41e55fe9-6614-307e-a1ed-97e2c6ec1f74",
                                "text": "„Banner, die Werbeflächen auf dem oberen Teil einer Website, sind das bekannteste Online-Werbeformat. […] Auch in ihrer Gestaltung sind sie vielfältiger - und damit auffälliger - geworden: animierte Bilder, direkte Bestellmöglichkeit oder sogar kleine Spiele werden nicht selten auf einer Bannerfläche untergebracht.“"
                            }
                        ],
