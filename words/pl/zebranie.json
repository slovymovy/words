                                "target_lang_sense_clarification": "assembly of people"
                            },
                            {
                                "target_lang_word": "assembly",
                                "target_lang_sense_clarification": "formal meeting of people"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c30fcd0-0081-3fa0-987b-01484e947690",
                    "sense_definition": "rzeczownik odczasownikowy od <w>zebrać</w>; czynność gromadzenia lub łączenia czegoś w jedno miejsce",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę o dokładne <w>zebranie</w> materiałów na temat przestępczości w naszej dzielnicy.",
                            "target_lang_translations": {
                                "en": "Please ensure a thorough <w>gathering</w> of materials on crime in our district."
                            }
                        },
                        {
                            "text": "Szybkie <w>zebranie</w> wszystkich dokumentów zajęło mu zaledwie kilkanaście minut.",
                            "target_lang_translations": {
                                "en": "The quick <w>collection</w> of all the documents took him just over ten minutes."
                            }
