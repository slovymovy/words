{
    "word_family": [
        "swiveling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "034a53ce-7bb6-339c-87c3-229f42b73245",
                    "sense_definition": "A mechanical device that allows an attached object to rotate freely around a central axis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chair is attached to a <w>swivel</w> so you can turn around easily.",
                            "target_lang_translations": {
                                "cs": "Židle je připevněna na <w>otočném mechanismu</w>, takže se můžete snadno otočit."
                            }
                        },
                        {
                            "text": "He attached the leash to the <w>swivel</w> to keep the rope from tangling.",
                            "target_lang_translations": {
                                "cs": "Připnul vodítko k <w>otočnému čepu</w>, aby se lano nezamotávalo."
                            }
                        }
                    ],
                    "synonyms": [
                        "pivot"
                    ],
                    "common_phrases": [
                        "swivel chair"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mechanické zařízení umožňující připojenému předmětu volně se otáčet kolem středové osy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otočný čep",
                                "target_lang_sense_clarification": "obecné mechanické zařízení pro otáčení"
                            },
                            {
                                "target_lang_word": "otočný mechanismus",
                                "target_lang_sense_clarification": "obecné označení pro součást umožňující rotaci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf80f015-69c6-35c0-8695-9ac756353fa1",
                    "sense_definition": "A small device used in fishing to connect two pieces of line and prevent them from twisting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman attached a <w>swivel</w> to his line to stop it from twisting.",
                            "target_lang_translations": {
                                "cs": "Rybář připevnil na vlasec <w>obratlík</w>, aby zabránil jeho kroucení."
                            }
                        },
                        {
                            "text": "Make sure the <w>swivel</w> is strong enough to hold the weight of the fish.",
                            "target_lang_translations": {
                                "cs": "Ujistěte se, že <w>obratlík</w> je dostatečně pevný, aby udržel váhu ryby."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá rybářská pomůcka používaná ke spojení dvou kusů vlasce, která zabraňuje jejich kroucení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obratlík",
                                "target_lang_sense_clarification": "rybářská součástka zabraňující kroucení vlasce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22a8d6b2-83a7-3383-9058-8e6f35b82317",
                    "sense_definition": "A small cannon mounted on a pivot that allows it to be turned in different directions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship was armed with several small <w>swivels</w> along the deck.",
                            "target_lang_translations": {
                                "cs": "Loď byla podél paluby vyzbrojena několika malými <w>otočnými děly</w>."
                            }
                        },
                        {
                            "text": "The soldiers aimed the <w>swivel</w> gun at the approaching enemy boat.",
                            "target_lang_translations": {
                                "cs": "Vojáci zamířili <w>otočné dělo</w> na blížící se nepřátelský člun."
                            }
                        }
                    ],
                    "synonyms": [
                        "swivel gun"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical military equipment."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malé dělo upevněné na čepu, které umožňuje otáčení do různých směrů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otočné dělo",
                                "target_lang_sense_clarification": "historická zbraň na otočném podstavci"
                            },
                            {
                                "target_lang_word": "otočnice",
                                "target_lang_sense_clarification": "historické označení pro otočné lehké dělo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbc64299-d335-3f9f-b155-ac650d012762",
                    "sense_definition": "To turn or rotate around a fixed point or axis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>swiveled</w> her chair to face the computer screen.",
                            "target_lang_translations": {
                                "cs": "Otočila svou židli tak, aby čelila obrazovce počítače, a <w>pootočila se</w>."
                            }
                        },
                        {
                            "text": "The player <w>swiveled</w> quickly to shoot the ball into the goal.",
                            "target_lang_translations": {
                                "cs": "Hráč se rychle <w>otočil</w>, aby vystřelil míč do brány."
                            }
                        }
                    ],
                    "synonyms": [
                        "pivot",
                        "rotate",
                        "spin"
                    ],
                    "target_lang_definitions": {
                        "cs": "Otáčet se nebo rotovat kolem pevného bodu či osy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "otočit se",
                                "target_lang_sense_clarification": "pohyb kolem osy"
                            },
                            {
                                "target_lang_word": "pootočit",
                                "target_lang_sense_clarification": "částečné otočení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}