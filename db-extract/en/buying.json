                "senses": [
                    {
                        "sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                        "entry_id": "712f5de6-37b0-3185-b49e-64ae438f0986",
                        "glosses": [
                            "The act of making a purchase."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "99ac63c7-13f2-4f56-9b17-cf921cd16b19",
                                "sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                                "text": "[…] Reckonings of all and every his Dealings, Doings, Buyings and Sellings and Employments, touching and concerning the Premises […]"
                            },
                            {
                                "example_id": "3b428324-8ff2-4d33-9d29-e5dae47b9a13",
                                "sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                                "text": "\"He's hanging back to make an excuse of going to town for the spring buying, and it won't do.\""
                            },
                            {
                                "example_id": "bb255f79-781b-4bfa-bcd1-3544e33c9c34",
                                "sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                                "text": "Paying for these buyings, and arranging for their cartage to the shop, she got away, feeling physically tired but mentally elated, and very anxious to hear what Peter would say about the quality of her period pieces, and what prospects they offered for restoration."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18a6734a-ca83-44cd-b675-bc08d973a1f2",
                        "source_entry_id": "712f5de6-37b0-3185-b49e-64ae438f0986",
                        "source_sense_id": "a7cd63ac-7c51-3331-a5aa-c6559b58227b",
                        "source_sense_description": "act of making a purchase",
                        "target_lang_word": "kaufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kaufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "939e1366-bb5d-3a6c-87d3-c1d3191f3910",
                                        "entry_id": "70ce295d-0e24-373c-81b3-31e9234e2bc2",
                                        "glosses": [
                                            "Ware gegen Entgelt erwerben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f450dff4-c2e0-4db4-bc26-460815961253",
                                                "sense_id": "939e1366-bb5d-3a6c-87d3-c1d3191f3910",
                                                "text": "Wenn ich einmal groß bin, kaufe ich mir ein Auto."
                                            },
                                            {
                                                "example_id": "000c080e-f949-448f-8680-3798050ed6d2",
                                                "sense_id": "939e1366-bb5d-3a6c-87d3-c1d3191f3910",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80b6dfeb-459f-397e-9c91-f515f5749c81",
                                        "entry_id": "70ce295d-0e24-373c-81b3-31e9234e2bc2",
                                        "glosses": [
                                            "ein Verpflichtungsgeschäft zum Erwerb eines Gegenstands eingehen, das von dem Erfüllungsgeschäft (Übertragung des Eigentums) zu unterscheiden ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9add77-b022-49e4-bd41-5e1c5e603538",
                                                "sense_id": "80b6dfeb-459f-397e-9c91-f515f5749c81",
                                                "text": "Pjotr Ekhahn kaufte einen grünen Ford vom Gebrauchtwagenhändler Hompka mit der Maßgabe, dass die Übereignung desselben nach Zahlung des vollständigen Kaufpreises am darauffolgenden Montag erfolgen sollte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b905763f-12d5-30cb-ace7-88201c397392",
                                        "entry_id": "70ce295d-0e24-373c-81b3-31e9234e2bc2",
                                        "glosses": [
                                            "eine Person unter Druck setzen, ernsthaft mit ihr diskutieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b84c17b-dd1b-4ced-988e-4f934e29c1d1",
                                                "sense_id": "b905763f-12d5-30cb-ace7-88201c397392",
                                                "text": "Pjotr gab an, sich den Hompka bei nächster Gelegenheit wegen des fehlgeschlagenen Autogeschäfts einmal kaufen zu wollen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "383c1b91-91aa-3f58-ae7a-d3e938d0be5f",
                                        "entry_id": "70ce295d-0e24-373c-81b3-31e9234e2bc2",
                                        "glosses": [
                                            "eine Person bestechen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7504ee1c-6059-4f7f-a72f-0cf798424146",
                                                "sense_id": "383c1b91-91aa-3f58-ae7a-d3e938d0be5f",
                                                "text": "Nach Presseangaben war der Schiedsrichter in dem Spiel am Gründonnerstag von der Wettmafia gekauft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
