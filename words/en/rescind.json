{
    "word_family": [
        "rescission",
        "rescissory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad33946b-a940-34a5-81c1-460b4973151d",
                    "sense_definition": "To officially repeal, annul, or cancel a law, contract, decision, or offer.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency decided to <w>rescind</w> the policy because of public outcry.",
                            "target_lang_translations": {
                                "zh": "因公众强烈抗议，该机构决定<w>废除</w>该政策。"
                            }
                        },
                        {
                            "text": "The company faced severe backlash after it <w>rescinded</w> dozens of job offers.",
                            "target_lang_translations": {
                                "zh": "该公司在<w>撤销</w>了数十份录用通知后遭到了强烈抨击。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revoke",
                        "repeal",
                        "annul",
                        "cancel",
                        "countermand",
                        "recall"
                    ],
                    "antonyms": [
                        "enact",
                        "enforce",
                        "validate"
                    ],
                    "common_phrases": [
                        "rescind an offer",
                        "rescind a decision",
                        "rescind a policy",
                        "rescind an order"
                    ],
                    "target_lang_definitions": {
                        "zh": "正式废除、撤销或取消（法律、合同、决定、提议等）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "取消决定、录用、判决等"
                            },
                            {
                                "target_lang_word": "废除",
                                "target_lang_sense_clarification": "使法律、制度、法令等失效"
                            },
                            {
                                "target_lang_word": "取消",
                                "target_lang_sense_clarification": "使某事不再生效或发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "736dae4e-181b-3299-b414-e87d9606895f",
                    "sense_definition": "To physically cut off or sever.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Surgeons had to carefully <w>rescind</w> the damaged tissue during the procedure.",
                            "target_lang_translations": {
                                "zh": "手术过程中，外科医生不得不小心地<w>切除</w>受损组织。"
                            }
                        },
                        {
                            "text": "The botanist demonstrated how to <w>rescind</w> dead branches without harming the tree.",
                            "target_lang_translations": {
                                "zh": "植物学家演示了如何在不伤及树木的情况下<w>剪除</w>枯枝。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English for physical cutting"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧）切断，割除，切除"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "切除",
