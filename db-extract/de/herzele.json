                "senses": [
                    {
                        "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                        "entry_id": "19b235de-722b-3ba1-b6e4-8f22e8c540fa",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a630fc57-4a89-4c42-a77f-b86c117dd43e",
                                "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                                "text": "Frau Herzele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c6c6699d-7712-4c1b-93e5-b52fbb9c3cbc",
                                "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                                "text": "Herr Herzele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "30e1249b-960b-46f0-a5b7-20b532e60d66",
                                "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                                "text": "Die Herzeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "de7269e9-25f0-4898-b9cd-97051c593fb5",
                                "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                                "text": "Der Herzele trägt nie die Pullover, die die Herzele ihm strickt."
                            },
                            {
                                "example_id": "5f558c64-1359-4c23-9553-de1baff6db11",
                                "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Herzele kommt, geht der Herr Herzele.“"
                            },
                            {
                                "example_id": "124dd109-7413-4aae-bbbf-24855706a9ef",
                                "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                                "text": "Herzele kommt und geht."
                            },
                            {
                                "example_id": "eca93fb9-630e-41e6-9471-25d6d9f26359",
                                "sense_id": "3003c11d-5963-34c2-b4d3-3480f7406729",
                                "text": "Herzeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
