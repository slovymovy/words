                                                "sense_id": "87d33d79-aa6a-3881-aeeb-2bf2fe593ed0",
                                                "text": "Ik rentenier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0c2b938-0230-3861-928e-e09224605227",
                                        "entry_id": "1d28998a-b35b-3996-8c22-af97bf3eff5b",
