                    },
                    {
                        "sense_id": "48924dc7-6279-371d-8789-43a695f9f646",
                        "entry_id": "4aa43e4a-826b-38ba-a1c4-f1632ef073a8",
                        "glosses": [
                            "To renew (wine etc.) by mixing must with it and raising a new fermentation."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fc448d65-9fcc-44b2-9d2b-60b828238338",
                                "sense_id": "48924dc7-6279-371d-8789-43a695f9f646",
                                "text": "We stum our crude wines […]to renew their spirits."
                            }
                        ]
                    },
                    {
                        "sense_id": "3266043c-3cf6-33fe-a36d-1e801794d694",
                        "entry_id": "4aa43e4a-826b-38ba-a1c4-f1632ef073a8",
                        "glosses": [
                            "To fume, as a cask of liquor, with burning sulphur."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c5084f32-d097-4478-9d09-0c7dc7c659e3",
                                "sense_id": "3266043c-3cf6-33fe-a36d-1e801794d694",
                                "text": "Since I have taken this method with cyder, it has proved more like wine than common drink, but then I racked it off a second and a third time, as soon as it appeared fine, and then stummed the cask that received it the lasttime […]"
                            }
                        ]
                    }
