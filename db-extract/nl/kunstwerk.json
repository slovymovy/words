                ],
                "senses": [
                    {
                        "sense_id": "96de1571-96bd-3b7e-b902-51454fb66166",
                        "entry_id": "70a760d1-4b6c-3fae-aca3-437439d4fa12",
                        "glosses": [
                            "resultaat van een inspanning om iets te maken dat bijzonder mooi of indringend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e0ad03-bbb7-489b-8a76-e3b9402c532a",
                                "sense_id": "96de1571-96bd-3b7e-b902-51454fb66166",
                                "text": "De \"Mona Lisa\" wordt als een kunstwerk beschouwd."
                            },
                            {
                                "example_id": "55bdb186-cfdc-4a0f-91a2-ebf9de263965",
                                "sense_id": "96de1571-96bd-3b7e-b902-51454fb66166",
                                "text": "De onthulling van het straatbord werd wegens de pandemie twee jaar uitgesteld. Naast het naambord werd ook het kunstwerk, met daarop de tekst 'Ik heb je lief', voor het eerst getoond. Dat is een zin uit de tekst van het beroemde nummer Pastorale, dat List samen met Ramses Shaffy zong."
                            }
                        ]
                    },
                    {
                        "sense_id": "9580557c-73b8-311b-bb9f-2de2a6f9ee18",
                        "entry_id": "70a760d1-4b6c-3fae-aca3-437439d4fa12",
                        "glosses": [
                            "bijzondere constructie zoals een viaduct of tunnel bij de wegenbouw"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "5045c755-76db-4cfb-82e2-d4adf2a171c0",
                                "sense_id": "9580557c-73b8-311b-bb9f-2de2a6f9ee18",
                                "text": "Het zijn de vele kunstwerken die dit traject zo peperduur maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecdc8d49-b32b-3327-84cf-218f3eae5d5d",
                        "entry_id": "70a760d1-4b6c-3fae-aca3-437439d4fa12",
                        "glosses": [
                            "toestel om tijdens een voorstelling bepaalde natuurverschijnselen of andere veranderingen te suggereren"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33022251-cac2-4484-b3b2-c751ca972b8e",
                        "source_entry_id": "70a760d1-4b6c-3fae-aca3-437439d4fa12",
                        "source_sense_id": "96de1571-96bd-3b7e-b902-51454fb66166",
                        "source_sense_description": "resultaat van een inspanning om iets te maken dat bijzonder mooi of indringend is",
                        "target_lang_word": "Kunstwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kunstwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "742708a3-24a4-3934-b7e4-ca71a3da9fc2",
                                        "entry_id": "9d4ba2ec-7b64-36a3-b969-e7547157780e",
                                        "glosses": [
                                            "schöpferisches Werk eines Künstlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4fb9d17-fcc4-4d8d-ad3c-a09fe0ec943b",
                                                "sense_id": "742708a3-24a4-3934-b7e4-ca71a3da9fc2",
                                                "text": "Ein Kunstwerk ist das Ergebnis einer künstlerischen Arbeit."
                                            },
                                            {
                                                "example_id": "b63f0eaf-c220-423a-bb55-101fc71bac36",
                                                "sense_id": "742708a3-24a4-3934-b7e4-ca71a3da9fc2",
                                                "text": "„Wenn man erst einmal ein Kunstwerk als geordnete Elementenmenge begriffen hat, ist es naheliegend, den Ordnungsgrad der Menge der Elemente formal genauso zu berechnen, wie man in der Physik Entropien berechnet.“"
                                            },
                                            {
                                                "example_id": "f794a199-c9e2-45df-beda-e12cfd049b55",
                                                "sense_id": "742708a3-24a4-3934-b7e4-ca71a3da9fc2",
                                                "text": "„Briefmarken sind mehr als kleine, sammelwürdige Kunstwerke und auch mehr als einfache Zahlungsbelege für den Transport eines Briefes oder Paketes.“"
                                            },
                                            {
                                                "example_id": "57a77b40-6a78-4059-9786-376885bbfd2b",
                                                "sense_id": "742708a3-24a4-3934-b7e4-ca71a3da9fc2",
                                                "text": "„Im Herbst 1954 vernichtete Jasper Jones alle seine bis dahin von ihm geschaffenen Kunstwerke, die noch in seinem Besitz waren.“"
                                            },
                                            {
                                                "example_id": "e14a8dca-53b3-42f8-b174-4fae6b901575",
                                                "sense_id": "742708a3-24a4-3934-b7e4-ca71a3da9fc2",
                                                "text": "„Beim Anblick eines auch nur entfernt modernen Kunstwerks ist sie nicht nur verwirrt, sondern auch enttäuscht von sich selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed6a6e6b-dec8-38ae-9439-f3f34f6dd5f1",
                                        "entry_id": "9d4ba2ec-7b64-36a3-b969-e7547157780e",
                                        "glosses": [
                                            "besonders kunstvolles Ergebnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8286d352-4e27-449f-b460-a9c5d33007da",
                                                "sense_id": "ed6a6e6b-dec8-38ae-9439-f3f34f6dd5f1",
                                                "text": "Diese Hochsteckfrisur ist ja ein wahres Kunstwerk geworden."
                                            },
                                            {
                                                "example_id": "689477f0-957a-4bbc-a500-2d1ba110fe40",
                                                "sense_id": "ed6a6e6b-dec8-38ae-9439-f3f34f6dd5f1",
                                                "text": "Eine Birnenwähe zu backen ist kein Kunstwerk."
                                            },
                                            {
                                                "example_id": "a39cbe7d-2989-49bc-a295-f5671bc4d8bf",
                                                "sense_id": "ed6a6e6b-dec8-38ae-9439-f3f34f6dd5f1",
                                                "text": "Jetzt, wo dein Geld alle ist, nach Papa zu rufen, ist auch kein Kunstwerk."
                                            },
                                            {
                                                "example_id": "7132eaf6-8268-41bc-aa16-dfe891e8378d",
                                                "sense_id": "ed6a6e6b-dec8-38ae-9439-f3f34f6dd5f1",
                                                "text": "„Für Planetenforscher sind die Saturnringe mehr als nur ein fantastisches Kunstwerk der Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f66c6d8c-a338-4ff6-bf20-ab3e8014415e",
                        "source_entry_id": "70a760d1-4b6c-3fae-aca3-437439d4fa12",
                        "source_sense_id": "96de1571-96bd-3b7e-b902-51454fb66166",
                        "source_sense_description": "resultaat van een inspanning om iets te maken dat bijzonder mooi of indringend is",
                        "target_lang_word": "work of art",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "work of art",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecafe296-d7ef-3c44-99b8-cd1ce7428c2c",
                                        "entry_id": "14fdc723-5a20-3325-8468-677b59a01e78",
                                        "glosses": [
                                            "A product of the fine arts; a painting, sculpture, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00696c6d-0ca7-407f-8176-ef3f22384b12",
                                                "sense_id": "ecafe296-d7ef-3c44-99b8-cd1ce7428c2c",
                                                "text": "2012, Ivan Berg, Nik Berg, Top Gear: Motor Mania\nThe Beetle's cheap, frugal and functional nature attracted legions of flower-power fans and the little Vee Dubs became symbols, moving protests and even works of art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c37ecc-0d3c-35d1-9b85-eb4c0fcf44f6",
                                        "entry_id": "14fdc723-5a20-3325-8468-677b59a01e78",
                                        "glosses": [
                                            "Anything beautiful, exquisite, or finely crafted."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36597224-81e2-49a9-9c44-ebf249651799",
                                                "sense_id": "20c37ecc-0d3c-35d1-9b85-eb4c0fcf44f6",
                                                "text": "She was bedazzling, in short she was a work of art. She looked as natural as it's possible to be in an age of cosmetics; her hair was flowing and beautiful and she was a picture of summery goodness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b51ab4fc-2c60-4a80-9d04-5381c06aff7e",
                        "source_entry_id": "70a760d1-4b6c-3fae-aca3-437439d4fa12",
                        "source_sense_id": "96de1571-96bd-3b7e-b902-51454fb66166",
                        "source_sense_description": "resultaat van een inspanning om iets te maken dat bijzonder mooi of indringend is",
                        "target_lang_word": "artwork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artwork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "526b2ba9-e85f-3be6-be0e-1e3047745de4",
                                        "entry_id": "9d8d7fe8-aa14-3299-81f2-91c4b049a796",
                                        "glosses": [
                                            "A painting, drawing, sculpture or other piece of creative, visual art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3e85f9-791d-4a00-a181-b4cc1ad9d41d",
                                                "sense_id": "526b2ba9-e85f-3be6-be0e-1e3047745de4",
                                                "text": "A myriad of Hellenic artworks reflects the perceptions of the citizens of Ancient Greece."
                                            },
                                            {
                                                "example_id": "62c849be-ebab-4204-9454-af73bbc0c8bb",
                                                "sense_id": "526b2ba9-e85f-3be6-be0e-1e3047745de4",
                                                "text": "The most distinctive physical attribute of the space is the bright red metal sculpture that resembles one of Claes Oldenburg's oversized clothespins, only slightly deconstructed. The artwork may be enjoyed on its own terms, but ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a98558-bd60-332d-af51-8b6792e1108f",
                                        "entry_id": "9d8d7fe8-aa14-3299-81f2-91c4b049a796",
                                        "glosses": [
                                            "Artistic work."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81863f5b-a00b-3420-b40a-d0a1611a9819",
                                        "entry_id": "9d8d7fe8-aa14-3299-81f2-91c4b049a796",
                                        "glosses": [
                                            "The graphical elements to be included in a reproduced work."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba679669-e714-4f0e-9cdd-ddbdc2f32a20",
                                                "sense_id": "81863f5b-a00b-3420-b40a-d0a1611a9819",
                                                "text": "The text has been reviewed, but the photographer hasn't delivered some of the artwork."
                                            }
