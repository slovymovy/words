{
    "word_family": [
        "eternity",
        "eternalize",
        "eternally",
        "eternalness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7937a72d-2a98-30bf-9da7-d365b9f43036",
                    "sense_definition": "Lasting forever; having no beginning or end.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "everlasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many religions believe in the existence of an <w>eternal</w> soul that lives on after death.",
                            "target_lang_translations": {
                                "ru": "Многие религии верят в существование <w>вечной</w> души, которая продолжает жить после смерти.",
                                "zh": "许多宗教相信存在一个死后依然存活的<w>永恒</w>灵魂。",
                                "es": "Muchas religiones creen en la existencia de un alma <w>eterna</w> que sigue viviendo después de la muerte."
                            }
                        },
                        {
                            "text": "The artist sought to capture the <w>eternal</w> beauty of the mountains in his paintings.",
                            "target_lang_translations": {
                                "ru": "Художник стремился запечатлеть на своих полотнах <w>вечную</w> красоту гор.",
                                "zh": "这位艺术家试图在他的画作中捕捉山峦的<w>永恒</w>之美。",
                                "es": "El artista buscaba capturar la belleza <w>eterna</w> de las montañas en sus pinturas."
                            }
                        }
                    ],
                    "synonyms": [
                        "everlasting",
                        "unending",
                        "endless",
                        "perpetual"
                    ],
                    "antonyms": [
                        "temporary",
                        "fleeting",
                        "momentary",
                        "ephemeral"
                    ],
                    "common_phrases": [
                        "eternal life",
                        "eternal flame",
                        "eternal youth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий вечно; не имеющий ни начала, ни конца.",
                        "zh": "永远持续；没有开始也没有终结。",
                        "es": "Que dura para siempre; que no tiene principio ni fin."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечный",
                                "target_lang_sense_clarification": "не имеющий конца"
                            },
                            {
                                "target_lang_word": "бесконечный",
                                "target_lang_sense_clarification": "непрекращающийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "永恒",
                                "target_lang_sense_clarification": "指时间上无始无终"
                            },
                            {
                                "target_lang_word": "永久",
                                "target_lang_sense_clarification": "指长久持续"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "eterno",
                                "target_lang_sense_clarification": "que no tiene principio ni fin"
                            },
                            {
                                "target_lang_word": "sempiterno",
                                "target_lang_sense_clarification": "de duración infinita (literario)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f99850a3-3ccc-373e-9164-ec60cf5ac767",
                    "sense_definition": "Existing outside of time altogether rather than just lasting forever within it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "everlasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In philosophical terms, an <w>eternal</w> truth is one that is valid regardless of time.",
                            "target_lang_translations": {
                                "ru": "В философском понимании <w>вечная</w> истина — это та, что остается верной независимо от времени.",
                                "zh": "在哲学上，<w>永恒</w>的真理是指无论时间如何流逝都成立的道理。",
                                "es": "En términos filosóficos, una verdad <w>eterna</w> es aquella que es válida independientemente del tiempo."
                            }
                        },
                        {
                            "text": "The concept of an <w>eternal</w> state of being is central to many metaphysical theories.",
                            "target_lang_translations": {
                                "ru": "Концепция <w>вневременного</w> состояния бытия занимает центральное место во многих метафизических теориях.",
                                "zh": "<w>永恒</w>存在状态的概念是许多形而上学理论的核心。",
                                "es": "El concepto de un estado de ser <w>eterno</w> es central en muchas teorías metafísicas."
                            }
                        }
                    ],
                    "synonyms": [
                        "timeless",
                        "atemporal"
                    ],
                    "antonyms": [
                        "transient"
                    ],
                    "common_phrases": [
                        "eternal truths"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "philosophical or theological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий вне времени, а не просто длящийся вечно внутри него.",
                        "zh": "超越时间范畴，而非仅仅在时间中持续。",
                        "es": "Que existe fuera del tiempo, en lugar de simplemente durar para siempre dentro de él."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вневременной",
                                "target_lang_sense_clarification": "не зависящий от времени"
                            },
                            {
                                "target_lang_word": "вечный",
                                "target_lang_sense_clarification": "в философском смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超时间",
                                "target_lang_sense_clarification": "哲学或形而上学语境"
                            },
                            {
                                "target_lang_word": "永恒",
                                "target_lang_sense_clarification": "指不受时间限制的真理"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atemporal",
                                "target_lang_sense_clarification": "que no depende del tiempo"
                            },
                            {
                                "target_lang_word": "eterno",
                                "target_lang_sense_clarification": "en sentido filosófico o metafísico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f568bedc-f903-3667-8e37-e136e20a562f",
                    "sense_definition": "Seemingly ceaseless; occurring so often as to be annoying or ever-present.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "constant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am tired of your <w>eternal</w> complaints about the weather every single morning.",
                            "target_lang_translations": {
                                "ru": "Мне надоели твои <w>вечные</w> жалобы на погоду каждое божье утро.",
                                "zh": "我厌倦了你每天早上对天气的<w>没完没了</w>的抱怨。",
                                "es": "Estoy cansado de tus <w>eternas</w> quejas sobre el clima cada mañana."
                            }
                        },
                        {
                            "text": "The professor was rarely seen without his <w>eternal</w> pipe clenched between his teeth.",
                            "target_lang_translations": {
                                "ru": "Профессора редко видели без его <w>неизменной</w> трубки, зажатой в зубах.",
                                "zh": "人们很少见到这位教授嘴里不叼着他那根<w>总是</w>不离口的烟斗。",
                                "es": "Al profesor rara vez se le veía sin su <w>eterna</w> pipa apretada entre los dientes."
                            }
                        }
                    ],
                    "synonyms": [
                        "constant",
                        "ceaseless",
                        "perpetual",
                        "interminable"
                    ],
                    "antonyms": [
                        "momentary"
                    ],
                    "common_phrases": [
                        "eternal optimist",
                        "eternal triangle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for emphasis or exaggeration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущийся непрекращающимся; происходящий настолько часто, что это раздражает.",
                        "zh": "看似没完没了；频繁发生以至于令人厌烦。",
                        "es": "Que parece incesante; que ocurre tan a menudo que resulta molesto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечный",
                                "target_lang_sense_clarification": "постоянно повторяющийся"
                            },
                            {
                                "target_lang_word": "бесконечный",
                                "target_lang_sense_clarification": "о жалобах или спорах"
                            },
                            {
                                "target_lang_word": "неизменный",
                                "target_lang_sense_clarification": "всегда присутствующий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没完没了",
                                "target_lang_sense_clarification": "形容令人厌烦的重复"
                            },
                            {
                                "target_lang_word": "总是",
                                "target_lang_sense_clarification": "强调行为频繁"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "eterno",
                                "target_lang_sense_clarification": "usado para enfatizar algo molesto o repetitivo"
                            },
                            {
                                "target_lang_word": "sempiterno",
                                "target_lang_sense_clarification": "que aparece reiterada e invariablemente (coloquial)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc241f89-feaf-32c3-99b2-0f44186e9865",
                    "sense_definition": "Used as an intensifier to describe something exceedingly great or bad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was described by his victims as an <w>eternal</w> villain with no sense of remorse.",
                            "target_lang_translations": {
                                "ru": "Жертвы описывали его как <w>неисправимого</w> злодея, лишенного чувства раскаяния.",
                                "zh": "受害者形容他是一个<w>无可救药</w>且毫无悔意的恶棍。",
                                "es": "Sus víctimas lo describieron como un villano <w>eterno</w> sin sentido de remordimiento."
                            }
                        },
                        {
                            "text": "The betrayal caused him <w>eternal</w> shame that he could never fully escape.",
                            "target_lang_translations": {
                                "ru": "Предательство навлекло на него <w>вечный</w> позор, от которого он так и не смог полностью избавиться.",
                                "zh": "这次背叛给他带来了<w>永远的</w>耻辱，使他终生无法摆脱。",
                                "es": "La traición le causó una vergüenza <w>eterna</w> de la que nunca pudo escapar por completo."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "utter"
                    ],
                    "common_phrases": [
                        "eternal villain"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилитель для описания чего-то чрезвычайно великого или плохого.",
                        "zh": "用作强调词，形容极其严重或糟糕的事物。",
                        "es": "Utilizado como intensificador para describir algo extremadamente grande o malo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неисправимый",
                                "target_lang_sense_clarification": "о качествах человека"
                            },
                            {
                                "target_lang_word": "вечный",
                                "target_lang_sense_clarification": "в значении абсолютный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无可救药",
                                "target_lang_sense_clarification": "形容人品性极坏"
                            },
                            {
                                "target_lang_word": "永远的",
                                "target_lang_sense_clarification": "强调程度深"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "eterno",
                                "target_lang_sense_clarification": "en sentido absoluto"
                            },
                            {
                                "target_lang_word": "incorregible",
                                "target_lang_sense_clarification": "cuando se refiere a cualidades negativas de una persona"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4549d7f9-bc92-3125-9ad7-75029bbac047",
                    "sense_definition": "A being who lives forever; an immortal entity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "immortal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old legends, the <w>eternals</w> watched over the world from their mountain home.",
                            "target_lang_translations": {
                                "ru": "В древних легендах <w>бессмертные</w> взирали на мир из своей обители в горах.",
                                "zh": "在古老的传说中，<w>永生者</w>们在山中的居所守护着这个世界。",
                                "es": "En las viejas leyendas, los <w>eternos</w> vigilaban el mundo desde su hogar en la montaña."
                            }
                        },
                        {
                            "text": "He sought the secret of the <w>eternals</w> in hopes of living forever himself.",
                            "target_lang_translations": {
                                "ru": "Он искал секрет <w>вечных</w>, надеясь и сам обрести бессмертие.",
                                "zh": "他寻找<w>永生者</w>的秘密，希望能让自己长生不老。",
                                "es": "Él buscaba el secreto de los <w>eternos</w> con la esperanza de vivir para siempre él mismo."
                            }
                        }
                    ],
                    "synonyms": [
                        "immortal"
                    ],
                    "antonyms": [
                        "mortal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in mythology or fantasy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Существо, которое живет вечно; бессмертное создание.",
                        "zh": "长生不老的存在；不朽的实体。",
                        "es": "Un ser que vive para siempre; una entidad inmortal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессмертный",
                                "target_lang_sense_clarification": "о существе"
                            },
                            {
                                "target_lang_word": "вечный",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "永生者",
                                "target_lang_sense_clarification": "神话或奇幻语境"
                            },
                            {
                                "target_lang_word": "不朽者",
                                "target_lang_sense_clarification": "指长生不老的人或物"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "inmortal",
                                "target_lang_sense_clarification": "ser que no muere"
                            },
                            {
                                "target_lang_word": "eterno",
                                "target_lang_sense_clarification": "usado como sustantivo en contextos mitológicos"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}