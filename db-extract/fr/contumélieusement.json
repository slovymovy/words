                        "glosses": [
                            "D’une façon méprisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e9d34d-f08d-4b32-b546-3abfe205a931",
                                "sense_id": "2257f07c-898f-3024-a8b0-7a0106e15fcc",
                                "text": "Il sera prouvé que l’accusée [la duchesse de Berry] a été six heures à la géhenne du feu dans un espace trop étroit où quatre personnes pouvaient à peine respirer ; ce qui a fait dire contumélieusement à la torturée qu’on lui faisait la guerre à la saint Laurent."
                            }
                        ]
                    }
