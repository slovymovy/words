        "fr-extract.jsonl": [
            {
                "entry_id": "1d82d86e-703b-3d27-9d31-78cadc669a0c",
                "word": "parkway",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a05bef16-6e9c-4a33-8aeb-7c20b8bc3bcd",
                        "entry_id": "1d82d86e-703b-3d27-9d31-78cadc669a0c",
                        "tags": [
                            "plural"
                        ],
                        "form": "parkways"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be47afc1-0900-30a0-8c27-44608d626ff7",
                        "entry_id": "1d82d86e-703b-3d27-9d31-78cadc669a0c",
                        "glosses": [
                            "Promenade, route panoramique principale traversant un parc, ou en reliant plusieurs, sur laquelle les véhicules commerciaux comme les poids lourds sont interdits."
                        ],
                        "tags": [
                            "États-Unis",
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "8287d5c1-c39c-45dc-9cfa-c720df3613fa",
                                "sense_id": "be47afc1-0900-30a0-8c27-44608d626ff7",
                                "text": "From what I understand, 'way' means 'road'. So a driveway is a road that you drive on, typically either to the street or your garage. A parkway is a road through or to a park. Usually parkways are landscaped, or beautified, with medians or trees along the edges.",
                                "translation": "De ce que je comprend, 'way' signifie 'route'. Un driveway est donc une route sur laquelle on conduit, typiquement vers la route ou votre garage. Un parkway est une route à travers ou en direction d’un parc. Les parkways sont généralement aménagés ou embellis avec des ilots centraux ou des arbres sur les côtés."
                            },
                            {
                                "example_id": "11adad5b-237f-4775-868e-1607c58550e2",
                                "sense_id": "be47afc1-0900-30a0-8c27-44608d626ff7",
                                "text": "This project involves the restoration of the Long Sault Parkway, including a new layer of asphalt and geotechnical studies.",
                                "translation": "Ce projet comprend la réfection de la promenade Long Sault, y compris une nouvelle couche d’asphalte et des études géotechniques."
                            }
                        ]
                    },
                    {
                        "sense_id": "13479a80-b98c-3c6f-af53-0bc9cdbdb1ec",
                        "entry_id": "1d82d86e-703b-3d27-9d31-78cadc669a0c",
                        "glosses": [
                            "Autoroute ou voie rapide présentant de beaux paysages."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "edf88ed6-8bb8-4400-a84c-e6f9a0e72b65",
                                "sense_id": "13479a80-b98c-3c6f-af53-0bc9cdbdb1ec",
                                "text": "In the fall, brilliantly colored foliage blankets Virginia, especially the Skyline Drive, which runs through the Shenandoah National Park, and the Blue Ridge Parkway, which offers more than 200 miles of driving pleasure.",
                                "translation": "En automne, un feuillage de couleurs vives recouvre la Virginie, surtout le Skyline Drive, qui parcourt le parc national Shenandoah, et la Blue Ridge Parkway qui offre plus de 200 miles de plaisir au volant."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5e8d65c-3bca-3e99-805d-dd4e1fd71339",
                        "entry_id": "1d82d86e-703b-3d27-9d31-78cadc669a0c",
                        "glosses": [
                            "Rue avec une bande aménagée entre les deux sens de circulation."
                        ],
                        "tags": [
