                                        "glosses": [
                                            "Celle qui débute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1e1e18-3dd6-4652-8ac2-eb78534fe90e",
                                                "sense_id": "ebb89166-99f9-3ec4-a22a-93ac04ae9066",
                                                "text": "S’il s'avère qu’elle m’a menti, alors je me suis fait avoir comme une débutante."
                                            },
                                            {
                                                "example_id": "a75e867e-cb9e-4db4-9f88-676284631df3",
                                                "sense_id": "ebb89166-99f9-3ec4-a22a-93ac04ae9066",
                                                "text": "Née en 1889, ma mère ne tarda pas à envoûter les reporters par sa beauté qui d’emblée faisait d’elle la reine des bals des débutantes."
                                            }
                                        ]
