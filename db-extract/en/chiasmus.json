                        ],
                        "examples": [
                            {
                                "example_id": "2e977bdd-3f50-48fb-821b-95d1e8049bd1",
                                "sense_id": "ea57c62f-b95e-35e3-a85e-b173e41960f0",
                                "text": "The book of Habakkuk has been discovered to consist of a closely knit chaistic structure throughout. This is the first poem of such length to stand revealed as a literary unit of this kind, though chiasmus has already been discovered throughout many psalms […]"
                            },
                            {
                                "example_id": "4266a0e6-b5ea-442b-b10b-60684f1b5c64",
                                "sense_id": "ea57c62f-b95e-35e3-a85e-b173e41960f0",
                                "text": "John F. Kennedy is more famous for his chiasmus than for many of his policies:\n\"Ask not what your country can do for you—ask what you can do for your country.\""
                            },
                            {
                                "example_id": "1a418d30-6231-45c5-b572-a5020d5e8a1a",
                                "sense_id": "ea57c62f-b95e-35e3-a85e-b173e41960f0",
                                "text": "Leeman therefore holds that chiasmus is the basic order in Greek and Latin: antithesis is, he claims, normal for the modern, rational mind, but for the Greeks and Romans chiasmus was more natural."
                            },
                            {
                                "example_id": "8899f5b1-b3a4-4f48-8f00-004fb08cc219",
                                "sense_id": "ea57c62f-b95e-35e3-a85e-b173e41960f0",
                                "text": "The realization that Mawlānā was using parallelism and chiasmus to organize the higher levels of his work has been a major surprise."
                            }
                        ]
