                "senses": [
                    {
                        "sense_id": "d351d63d-45b9-319d-9e54-9cbeadef5d75",
                        "entry_id": "9d1010f0-3484-38a5-a23f-f1d3d400941e",
                        "glosses": [
                            "przepis, zarządzenie czyniące surowszymi dotychczasowe prawa, zakazy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4806ba0-7504-4ef9-84e6-4888b481c9cf",
                                "sense_id": "d351d63d-45b9-319d-9e54-9cbeadef5d75",
                                "text": "W październiku roku ubiegłego Rada Bezpieczeństwa postanowiła sankcje zaostrzyć. Obostrzenia weszły w życie w listopadzie"
                            },
                            {
                                "example_id": "ca56f481-5172-4b1d-8813-bb97d4ed2070",
                                "sense_id": "d351d63d-45b9-319d-9e54-9cbeadef5d75",
                                "text": "Należąca do Unii Europejskiej Dania wprowadziła ostatnio obostrzenia dotyczące obrotu terenami rekreacyjnymi, bojąc się zwiększonego ich wykupu ze strony Niemców"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1639a6f-4565-4cc6-8e28-21ec1a6dea5e",
                        "source_entry_id": "9d1010f0-3484-38a5-a23f-f1d3d400941e",
                        "source_sense_id": "d351d63d-45b9-319d-9e54-9cbeadef5d75",
