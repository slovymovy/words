                        "cross_references": [
                            {
                                "target_word": "Ienisseï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d0c7cbc-ff3a-392a-8975-01fce05cbe1f",
                                        "entry_id": "ebea5579-80b8-36c7-855f-3f0ed9fcb43a",
                                        "glosses": [
                                            "Fleuve de Sibérie se jetant dans l’océan Arctique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b87a057-0a5b-403c-861e-410a764becac",
                                                "sense_id": "3d0c7cbc-ff3a-392a-8975-01fce05cbe1f",
                                                "text": "Il avait trouvé sur une carte un ancien tracé de chemins qui reliait les bassins miniers de l’Oural aux basses terres de Sibérie occidentale et au fleuve Ienisseï, à travers les steppes du Kirghizistan."
                                            },
                                            {
                                                "example_id": "d242f86e-3cd8-4371-a1dd-127281ab0e7b",
                                                "sense_id": "3d0c7cbc-ff3a-392a-8975-01fce05cbe1f",
                                                "text": "Mène-moi dans la nuit où coule l’Ienisséi,\nOú le sapin porte jusqu’aux étoiles,\nCar je ne suis pas un loup par ma sang\nEt seule me tuera la main de mon égal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6492f285-55a1-4565-a67b-7cf2e11bbf0f",
                        "source_entry_id": "29782a20-4d47-3504-99d4-785811b1f8d6",
                        "source_sense_id": "a9fac9d8-6212-3192-818b-7302fcc90bc1",
                        "source_sense_description": "langer Fluss in Sibirien (Russland)",
                        "target_lang_word": "Енисей",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Енисей",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8c7273-6d9b-3c12-b853-2096adbbdeca",
                                        "entry_id": "45ad2cde-2690-35e3-af4c-60489d487332",
                                        "glosses": [
                                            "геогр. река в России, в Сибири, впадающая в Карское море Северного Ледовитого океана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cbc45b-fff7-4da2-a1ac-6d5f7da12dc4",
                                                "sense_id": "ff8c7273-6d9b-3c12-b853-2096adbbdeca",
                                                "text": "Он изучил берега Енисея и нашёл такое место — там, где в Енисей впадает речка Кача."
                                            },
                                            {
                                                "example_id": "42f8710c-3d1f-4941-ad0f-676424df818a",
                                                "sense_id": "ff8c7273-6d9b-3c12-b853-2096adbbdeca",
                                                "text": "Ученые Красноярской археологической экспедиции обнаружили в раскопках на берегах Енисея много железных вещей: серьги, браслеты, оружие."
                                            },
                                            {
                                                "example_id": "ecf0df6f-f223-4ea6-b9a5-e8c99d154858",
                                                "sense_id": "ff8c7273-6d9b-3c12-b853-2096adbbdeca",
                                                "text": "Енисей течёт между гор, оставляя в лощинах, к нему прилежащих, места изобильные."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42495879-6a06-3550-83d4-dede461573a3",
                                        "entry_id": "45ad2cde-2690-35e3-af4c-60489d487332",
                                        "glosses": [
                                            "посёлок в Новосёловском районе Красноярского края"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
