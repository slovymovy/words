{
    "word_family": [
        "side",
        "line"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "282a3963-0e8e-3579-92cf-bb2ae4aba36f",
                    "sense_definition": "A line defining the side boundary of a playing field.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player stepped on the <w>sideline</w> and the referee blew the whistle.",
                            "target_lang_translations": {
                                "zh": "球员踩到了<w>边线</w>，裁判吹响了哨子。"
                            }
                        },
                        {
                            "text": "The ball rolled across the <w>sideline</w> during the intense match.",
                            "target_lang_translations": {
                                "zh": "激烈的比赛中，球滚过了<w>边线</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "touchline"
                    ],
                    "common_phrases": [
                        "cross the sideline"
                    ],
                    "target_lang_definitions": {
                        "zh": "运动场两侧的界线。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "边线",
                                "target_lang_sense_clarification": "体育比赛场地两侧的界线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b82416d6-9364-35e5-bbfe-67e0b268d481",
                    "sense_definition": "The area outside the playing field beyond the boundary lines.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach stood on the <w>sidelines</w> and shouted instructions to the team.",
                            "target_lang_translations": {
                                "zh": "教练站在<w>场边</w>向队员大声喊着指令。"
                            }
                        },
                        {
                            "text": "Injured players often watch the game from the <w>sidelines</w>.",
                            "target_lang_translations": {
                                "zh": "受伤的球员经常在<w>场边</w>观看比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the sidelines"
                    ],
                    "target_lang_definitions": {
                        "zh": "比赛场地界线以外的区域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "场边",
                                "target_lang_sense_clarification": "比赛场地之外的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03131bbc-7ea0-35d5-9ce6-dcd656ffe3d5",
                    "sense_definition": "An activity or job done in addition to one's main work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secondary_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started a small business as a <w>sideline</w> to her regular job.",
                            "target_lang_translations": {
                                "zh": "她在正职之外做了一份小生意作为<w>副业</w>。"
                            }
                        },
                        {
                            "text": "Selling handmade crafts became a profitable <w>sideline</w> for him.",
                            "target_lang_translations": {
                                "zh": "卖手工工艺品成了他的一项盈利<w>副业</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "主业之外的副业或兼职。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "副业",
                                "target_lang_sense_clarification": "主业之外从事的额外工作"
                            },
                            {
                                "target_lang_word": "兼职",
                                "target_lang_sense_clarification": "在主业之外从事的额外工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f281609-60e1-39a1-bb3e-7aa118abe012",
                    "sense_definition": "The outside or perimeter of any activity or social group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "secondary_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like he was being kept on the <w>sidelines</w> of the important decision-making process.",
                            "target_lang_translations": {
                                "zh": "他感觉自己被排除在重要的决策过程之外，处于<w>边缘</w>地带。"
                            }
                        },
                        {
                            "text": "Many people are relegated to the <w>sidelines</w> when they lack the necessary connections.",
                            "target_lang_translations": {
                                "zh": "许多人因为缺乏必要的人脉而被<w>边缘化</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "relegated to the sidelines"
                    ],
                    "target_lang_definitions": {
                        "zh": "处于活动或社交圈的边缘，无法参与核心事务。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "指处于核心圈子之外的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3aae7405-f3b0-37c9-92ac-a2b85a3a9e2d",
                    "sense_definition": "To prevent someone from participating in an activity or game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach <w>sidelined</w> the star player because of a minor injury.",
                            "target_lang_translations": {
                                "zh": "教练因为明星球员受了点轻伤而<w>让他无法上场</w>。"
                            }
                        },
                        {
                            "text": "A sudden injury <w>sidelined</w> him for the rest of the season.",
                            "target_lang_translations": {
                                "zh": "突如其来的伤病使他<w>无法参加</w>本赛季余下的比赛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人无法参加比赛或活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……无法上场",
                                "target_lang_sense_clarification": "因伤病等原因导致运动员无法参赛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51abc037-9466-3455-8a4f-627dfe6e5c4d",
                    "sense_definition": "To remove someone or something from a position of influence or importance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new management <w>sidelined</w> the older employees to make room for fresh ideas.",
                            "target_lang_translations": {
                                "zh": "新管理层将老员工<w>边缘化</w>，以便为新想法腾出空间。"
                            }
                        },
                        {
                            "text": "Political rivals were <w>sidelined</w> during the recent party reorganization.",
                            "target_lang_translations": {
                                "zh": "在最近的党内改组中，政治对手被<w>边缘化</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marginalize"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某人或某物从有影响力的位置上撤下或边缘化。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "边缘化",
                                "target_lang_sense_clarification": "使某人失去影响力或被排挤出核心"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}