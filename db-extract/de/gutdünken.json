                                        "examples": [
                                            {
                                                "example_id": "dfb40faf-14d9-44d7-8958-bd34d490666f",
                                                "sense_id": "6aa819ee-b91d-3243-afbb-d12daa81675d",
                                                "text": "Bob showed great discretion despite his knowledge of the affair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b6fd07c-c573-3dda-b863-ae28b3ad0dac",
                                        "entry_id": "1724ec98-1507-32fb-9bae-802fe1d878f2",
                                        "glosses": [
                                            "The ability to make wise choices or decisions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17f6d91-19cc-42be-ba39-4e4e6f45ead7",
                                                "sense_id": "3b6fd07c-c573-3dda-b863-ae28b3ad0dac",
                                                "text": "With regard to a woman, at nine years of age, she was, if married, considered entitled to her dower; at twelve, she may consent to marriage; at fourteen, she is at years of discretion, and may choose a guardian; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "730bb17c-85dc-376e-804e-359d1055fe11",
                                        "entry_id": "1724ec98-1507-32fb-9bae-802fe1d878f2",
                                        "glosses": [
                                            "The freedom to make one's own judgements."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35dc695a-2992-45de-a208-f157dba7600d",
                                                "sense_id": "730bb17c-85dc-376e-804e-359d1055fe11",
                                                "text": "I leave that to your discretion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "006071cf-ad5a-3a08-9ee4-5ce825a7748c",
                                        "entry_id": "1724ec98-1507-32fb-9bae-802fe1d878f2",
                                        "glosses": [
                                            "The freedom to make one's own judgements.",
                                            "The authority to exercise one's own judgement in making decisions that have effect."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
