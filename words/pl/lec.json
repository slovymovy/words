                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Woźnica mocno chwycił skórzany <w>lec</w>, próbując uspokoić spłoszonego konia.",
                            "target_lang_translations": {
                                "ru": "Кучер крепко ухватился за кожаную <w>вожжу</w>, пытаясь успокоить испуганную лошадь."
                            }
                        },
                        {
                            "text": "Gdy pękł lewy <w>lec</w>, wóz niebezpiecznie zjechał z piaszczystej drogi.",
                            "target_lang_translations": {
                                "ru": "Когда лопнула левая <w>вожжа</w>, телега опасно съехала с песчаной дороги."
                            }
                        }
