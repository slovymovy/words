                        ]
                    },
                    {
                        "translation_id": "7c9a2945-55db-4e51-b15f-e54fbf4c6089",
                        "source_entry_id": "da6cadcc-de9f-392b-b48f-3d60924bbbfb",
                        "source_sense_id": "36c6d34f-a2df-3a6a-8e0a-939e378fa490",
                        "source_sense_description": "Zoologie: Marder, der in Mittel- und Südamerika heimisch ist und einem Dachs ähnelt",
                        "target_lang_word": "grison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ada3095e-03d5-315a-a2e1-e939b09091ea",
                                        "entry_id": "dc8229c2-95d4-3e2b-9a04-988f774165e6",
                                        "glosses": [
                                            "Personne qui grisonne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e3f1a2-e477-4207-be3b-9b85ff2c106f",
                                                "sense_id": "ada3095e-03d5-315a-a2e1-e939b09091ea",
                                                "text": "C’est un vieux grison."
                                            },
                                            {
                                                "example_id": "19e4e09d-7b47-4148-b361-4328b261530e",
                                                "sense_id": "ada3095e-03d5-315a-a2e1-e939b09091ea",
                                                "text": "Un homme entre deux âges, moitié grison, moitié garçon de bureau, mais plus huileux et plus huilé, la chevelure grasse, l’abdomen grassouillet, le teint blafard et humide comme celui d’une supérieure de couvent, chaussé de chaussons de lisière, vêtu de drap bleu et d’un pantalon grisâtre, se montra soudain."
                                            },
                                            {
                                                "example_id": "8b777df7-5801-49f8-9c6b-e4e9fd0380bf",
                                                "sense_id": "ada3095e-03d5-315a-a2e1-e939b09091ea",
                                                "text": "Tous éprouvaient une légère envie de s’amuser aux dépens de ce grison amoureux d’une ombre et l’espèce d’état second où semblait le plonger la vue d’Hildegarde flattait la jeune femme et ses parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c28f548-7efb-3a05-be50-f62c30940159",
                                        "entry_id": "dc8229c2-95d4-3e2b-9a04-988f774165e6",
                                        "glosses": [
                                            "Synonyme de poudingue du fait de l'aspect parfois gris de cet amalgame minéral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cba35dc-d8a0-47a7-842d-c220060165a1",
                                                "sense_id": "2c28f548-7efb-3a05-be50-f62c30940159",
                                                "text": "Le sol est ordinairement peu profond, le grison (poudingue un peu ferrugineux) affleure en certains endroits."
                                            },
                                            {
                                                "example_id": "78858721-2e03-4a29-83bc-8023c5a2f412",
                                                "sense_id": "2c28f548-7efb-3a05-be50-f62c30940159",
                                                "text": "De petits blocs taillées d'une espèce de poudingue siliceux, formé d'un gravier agglutiné, ont été généralement employés dans les constructions. Quoique d'une couleur brune, on a donné à cette pierre le nom de grison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47826c4a-541c-3bed-a9be-e60f5df8faa4",
                                        "entry_id": "c38b46fa-fbb1-3d62-bddf-7048de56db84",
                                        "glosses": [
                                            "Âne."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "257bca03-d40e-4da1-b515-0f20d4235edd",
                                                "sense_id": "47826c4a-541c-3bed-a9be-e60f5df8faa4",
                                                "text": "Être monté sur un grison."
                                            },
                                            {
                                                "example_id": "e9dca3c8-5b21-48c7-b3b8-a5e597631b92",
                                                "sense_id": "47826c4a-541c-3bed-a9be-e60f5df8faa4",
                                                "text": "L’âne castillan a la mine plus philosophique et plus délibérée ; il comprend qu’on ne peut se passer de lui ; il est de la maison, il a lu Don Quichotte, et se flatte de descendre en droite ligne du célèbre grison de Sancho Pança."
                                            },
                                            {
                                                "example_id": "1974d38f-6d64-4d92-a997-93c1979fe466",
                                                "sense_id": "47826c4a-541c-3bed-a9be-e60f5df8faa4",
                                                "text": "À la queue du pauvre grison on a attaché un crucifix et la Bible ; ainsi à la pleine lumière du jour, pour l’ébaudissement d’une populace hurlante, l’évangile se balance à la queue d’un âne et traîne dans la boue du ruisseau."
                                            },
                                            {
                                                "example_id": "a3e04670-be7a-48ba-8dbb-69df20874f62",
                                                "sense_id": "47826c4a-541c-3bed-a9be-e60f5df8faa4",
                                                "text": "Mais, en fait d’âne, j’avais déjà eu, plus petite encore, un amour à la Titania pour un grison qui promenait les enfants dans une île du bois de la Cambre à Bruxelles, où l’on m’avait emmenée pour quelques jours chez ma tante infirme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61aff5d3-7a26-3d53-a7eb-a21f8df2f1fc",
                                        "entry_id": "4abcfee0-db91-314a-8323-bb081d4ba372",
                                        "glosses": [
                                            "Relatif à Grisy-sur-Seine, commune française située dans le département de la Seine-et-Marne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab67e671-2f59-399d-bd39-2014c9cab14c",
                                        "entry_id": "4abcfee0-db91-314a-8323-bb081d4ba372",
                                        "glosses": [
                                            "Relatif aux Grisons, canton suisse situé à l'est du pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "185e90bc-52c2-4fc9-b34e-2b7b51c531a7",
                                                "sense_id": "ab67e671-2f59-399d-bd39-2014c9cab14c",
                                                "text": "samedi 25 janvier: il parait que les CFF, sur ordre de la police grisonne, n'ont pas assez de wagons pour faire des trains spéciaux pour monter a Davos."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe79277f-665a-3322-94d3-1123666308de",
                                        "entry_id": "ca96c5ad-1bf2-32db-ab0c-1ab1c93788bb",
                                        "glosses": [
                                            "Qui est assez gris, en parlant de la barbe et des cheveux, ou de la robe d'un animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d56f3e-13ae-49d5-9cf4-92a29c56db20",
                                                "sense_id": "fe79277f-665a-3322-94d3-1123666308de",
                                                "text": "Le voilà devenu grison."
                                            },
                                            {
                                                "example_id": "5ca4dffe-3c7d-4510-8a69-ce1942f9570b",
                                                "sense_id": "fe79277f-665a-3322-94d3-1123666308de",
                                                "text": "En premier lieu, je m’ai, — c’est le meilleur de l’affaire, — j’ai moi, Colas Breugnon, bon garçon, Bourguignon, rond de façons et du bedon, plus de la première jeunesse, cinquante ans bien sonnés, mais râblé, les dents saines, l’œil frais comme un gardon, et le poil qui tient dru au cuir, quoique grison."
                                            },
                                            {
                                                "example_id": "aab2a5ab-d592-4de3-985a-b5d1b63b79b8",
                                                "sense_id": "fe79277f-665a-3322-94d3-1123666308de",
                                                "text": "Le père et Anne-Marie partirent un matin sur le cheval grison"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae3e7c9-1d4b-3a50-a880-4ae86fd60085",
                                        "entry_id": "ab7d5c75-914e-39de-9efd-8bbf70e42c04",
                                        "glosses": [
                                            "Mammifère de la famille des Mustelidés vivant en Amérique centrale et au nord de l’Amérique du Sud, de nom scientifique Galictis vittata."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
