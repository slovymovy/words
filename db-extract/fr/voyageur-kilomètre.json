                "senses": [
                    {
                        "sense_id": "0d9edb0b-d86d-3c2e-9cea-96de9a0b84cd",
                        "entry_id": "0601f94a-3e31-3793-b56b-cb515b54e625",
                        "glosses": [
                            "Unité de mesure de trafic, utilisé dans le domaine du transport de passager, équivalent au transport d’un voyageur sur une distance d’un kilomètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eca71b4-0d7b-4333-b1eb-1f9c9bac16c5",
                                "sense_id": "0d9edb0b-d86d-3c2e-9cea-96de9a0b84cd",
                                "text": "Il faut donc nécessairement introduire une unité complexe, qui permette de tenir compte tout à la fois du nombre des voyageurs et de la distance parcourue par chacun d’eux : cette unité, qu’on appelle le voyageur-kilomètre, est le voyageur transporté à un kilomètre de distance."
                            },
                            {
                                "example_id": "8668e2d0-073e-49dc-a84b-17f01cc0914f",
                                "sense_id": "0d9edb0b-d86d-3c2e-9cea-96de9a0b84cd",
                                "text": "Les unités de mesure les plus couramment utilisées pour quantifier le trafic sont le voyageur-kilomètre pour le trafic de personnes et la tonne-kilomètre pour le trafic de marchandises."
                            }
                        ]
                    }
