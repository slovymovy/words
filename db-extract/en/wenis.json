                        "sense_id": "7598e6d7-0077-352c-9581-e6d94a218bf6",
                        "entry_id": "b71a7930-f7a5-3d74-8fe9-c4a3e93d2698",
                        "glosses": [
                            "An Egyptian pharaoh of the fifth dynasty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09fe9488-436b-4de1-8d6f-26ee4d9cc4bd",
                                "sense_id": "7598e6d7-0077-352c-9581-e6d94a218bf6",
                                "text": "The passages were eventually separated and categorized, as well as illustrated and eventually evolved into the Book of the Dead, or more properly, 'The Book of the Coming forth by Day'. The oldest of these text come from that Pyramid of Wenis, or more popularly these days, Unas at Saqqara."
                            },
                            {
                                "example_id": "160e9314-14e3-4e5a-8f02-a5e64a92544c",
                                "sense_id": "7598e6d7-0077-352c-9581-e6d94a218bf6",
                                "text": "Unas (Wenis) reigned at the end of Dynasty V, for a period of up to 30 years."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e0fac65c-23e8-3d05-93fa-a320baedeece",
                "word": "wenis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6f2ef23e-d088-458a-a8cb-b9c21cac519c",
                        "entry_id": "e0fac65c-23e8-3d05-93fa-a320baedeece",
                        "tags": [
                            "plural"
