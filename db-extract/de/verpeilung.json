                ],
                "senses": [
                    {
                        "sense_id": "b8962877-8ffc-395c-a9d0-f34a459548bc",
                        "entry_id": "53a6d894-412e-3f68-9485-36310483eeb5",
                        "glosses": [
                            "Erkundung, zum Beispiel des Bodenprofils eines Gewässers, mit Geräten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1dbb805-6023-48e2-a538-29e41e9594b0",
                                "sense_id": "b8962877-8ffc-395c-a9d0-f34a459548bc",
                                "text": "„Die Verpeilung geschah etwas oberhalb der Insel, die nicht weit von der Falkenau'schen Wassermühle liegt, an der breitesten Stelle zwischen grossen Steinen.“"
                            },
                            {
                                "example_id": "a56c2151-1b97-4478-b1e3-dcf3fae4ae17",
                                "sense_id": "b8962877-8ffc-395c-a9d0-f34a459548bc",
                                "text": "„Man hat die Unsicherheit dieses Verfahrens bei der Verpeilung der Felsen am Rheine schon vor langer Zeit erkannt, und es sind daher vollkommenere und für den vorliegenden Zweck geeignetere Peilgeräthe, nämlich das Peilgerüst und der Peilrahmen erfunden worden.“"
                            },
                            {
                                "example_id": "358261e7-c5d6-4d25-84f1-2144c3015a20",
                                "sense_id": "b8962877-8ffc-395c-a9d0-f34a459548bc",
                                "text": "„Die ausgeführten Verpeilungen waren noch nicht sämmtlich aufgetragen, auch fehlten noch einige Verpeilungen.“"
                            },
                            {
                                "example_id": "4fc2425f-44f7-486a-8dcb-36d7261472aa",
                                "sense_id": "b8962877-8ffc-395c-a9d0-f34a459548bc",
                                "text": "„Im Wasser sind, nach vorhergegangner sorgfältiger Verpeilung, die die wechselnden Tiefen ausgleichenden Sinkstücke in zwei Lagen über einander genau so versenkt, daß die Fugen der untern Lage durch die obern Stücke gedeckt werden.“"
                            },
                            {
                                "example_id": "4633cf93-bc04-4b53-a488-b201450bf2df",
                                "sense_id": "b8962877-8ffc-395c-a9d0-f34a459548bc",
                                "text": "„Paucker giebt bei seiner Verpeilung des Embach nur an zwei Stellen steinigen Boden an: nämlich zwischen Dorpat und Bischofahofund bei Ihhaste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85446f12-d24c-3646-8440-b15a8aa0a200",
                        "entry_id": "53a6d894-412e-3f68-9485-36310483eeb5",
                        "glosses": [
                            "Zustand der Verwirrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc5432cd-1a48-4c5b-9b1d-43418d081310",
                                "sense_id": "85446f12-d24c-3646-8440-b15a8aa0a200",
                                "text": "„Den coolsten Poetry-Slam aller Zeiten als »Musikdarbietung« zu betiteln, das grenzt allerdings an Verpeilung.“"
                            },
                            {
                                "example_id": "c02f4599-a074-49c1-a086-86b9d540e7d6",
                                "sense_id": "85446f12-d24c-3646-8440-b15a8aa0a200",
                                "text": "„Droscha schien meine Verpeilung zu ignorieren.“"
                            },
                            {
                                "example_id": "6f471fc8-2ad3-4e46-a3df-5d84d5e0bd50",
                                "sense_id": "85446f12-d24c-3646-8440-b15a8aa0a200",
                                "text": "„Wir nannten es: das Glück der Verpeilung.“"
                            },
                            {
                                "example_id": "dcd2c807-050b-40ea-b354-be3afc88d6df",
                                "sense_id": "85446f12-d24c-3646-8440-b15a8aa0a200",
                                "text": "„Den restlichen Tag verbringe ich in einem Zustand totaler Verpeilung, ich weiß nichts mit mir anzufangen und sitze oder stehe einfach nur sinnlos irgendwo rum.“"
                            },
                            {
                                "example_id": "7f5161ab-42f2-40c1-9d23-fd28f14ab2c9",
                                "sense_id": "85446f12-d24c-3646-8440-b15a8aa0a200",
                                "text": "„Die Verpeilung meines Lebensweges fing in der Polytechnischen Oberschule an, […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
