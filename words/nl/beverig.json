    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d0cb508-e5ef-3730-ada7-6fa0f30067cc",
                    "sense_definition": "onvast trillend of schuddend, vaak door ouderdom, kou of angst",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man zette met een <w>beverige</w> hand zijn handtekening onder het contract.",
                            "target_lang_translations": {
                                "pl": "Starszy mężczyzna podpisał umowę <w>drżącą</w> ręką."
                            }
                        },
                        {
                            "text": "Zij sprak de menigte toe met een opvallend <w>beverige</w> stem.",
                            "target_lang_translations": {
                                "pl": "Przemawiała do tłumu uderzająco <w>drżącym</w> głosem."
                            }
                        }
                    ],
                    "synonyms": [
                        "trillend",
                        "bevend",
                        "onvast"
                    ],
                    "antonyms": [
                        "vast",
                        "stabiel"
                    ],
                    "common_phrases": [
                        "een beverige stem",
                        "een beverig handschrift"
                    ],
                    "target_lang_definitions": {
                        "pl": "drżący, niestabilny, często ze starości, zimna lub strachu"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drżący",
                                "target_lang_sense_clarification": "o rękach, głosie lub ciele"
                            },
                            {
                                "target_lang_word": "trzęsący się",
                                "target_lang_sense_clarification": "poruszający się niespokojnie, drżący"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "923ce561-9d55-378d-9da8-49605f612b08",
                    "sense_definition": "rillerig en zwak voelend als gevolg van ziekte of koorts",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ziekte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Omdat ik me erg <w>beverig</w> voelde, besloot ik de hele middag in bed te blijven.",
                            "target_lang_translations": {
                                "pl": "Ponieważ czułem się bardzo <w>słabo i rozbity</w>, postanowiłem zostać w łóżku przez całe popołudnie."
                            }
                        },
                        {
                            "text": "Na de griepprik werd ze plotseling <w>beverig</w> en kreeg ze last van koude rillingen.",
                            "target_lang_translations": {
                                "pl": "Po szczepieniu przeciw grypie nagle zrobiła się <w>roztrzęsiona</w> i zaczęła mieć dreszcze."
                            }
                        }
                    ],
                    "synonyms": [
                        "rillerig",
                        "koortsig"
                    ],
                    "common_phrases": [
                        "zich beverig voelen"
                    ],
                    "target_lang_definitions": {
                        "pl": "osłabiony i roztrzęsiony w wyniku choroby lub gorączki"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozbity",
                                "target_lang_sense_clarification": "osłabiony przez chorobę"
                            },
                            {
                                "target_lang_word": "dreszczowy",
                                "target_lang_sense_clarification": "mający dreszcze, roztrzęsiony"
                            },
                            {
                                "target_lang_word": "słaby",
                                "target_lang_sense_clarification": "pozbawiony sił, drżący"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9a498e3d-54b3-38ff-95ac-82f40a3ddb39",
                    "sense_definition": "op een onvaste, trillende of aarzelende manier",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zanger zong het emotionele refrein nogal <w>beverig</w>.",
                            "target_lang_translations": {
                                "pl": "Piosenkarz zaśpiewał emocjonalny refren dość <w>drżąco</w>."
                            }
                        },
                        {
                            "text": "Hij antwoordde <w>beverig</w> toen de politieagent hem vroeg naar zijn alibi.",
                            "target_lang_translations": {
                                "pl": "Odpowiedział <w>niepewnie</w>, kiedy policjant zapytał go o alibi."
                            }
                        }
                    ],
                    "synonyms": [
                        "onvast",
                        "trillend"
                    ],
                    "antonyms": [
                        "zelfverzekerd",
                        "vastberaden"
                    ],
                    "target_lang_definitions": {
                        "pl": "w sposób niepewny, drżący lub wahający się"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drżąco",
                                "target_lang_sense_clarification": "drżącym głosem lub sposobem"
                            },
                            {
                                "target_lang_word": "niepewnie",
                                "target_lang_sense_clarification": "wahając się, z wahaniem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}