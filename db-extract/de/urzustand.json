                    {
                        "form_id": "85595132-2e29-41b9-849c-d711452fffe0",
                        "entry_id": "d09561e4-bcfe-3090-87e2-243225fb2dff",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Urzustände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fff0e10-8f5d-3c3b-b345-067f955577ab",
                        "entry_id": "d09561e4-bcfe-3090-87e2-243225fb2dff",
                        "glosses": [
                            "ursprünglicher Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e70c3c5-3abb-4ae0-9b6d-a00ab72d5505",
                                "sense_id": "1fff0e10-8f5d-3c3b-b345-067f955577ab",
                                "text": "„Die Unmittelbarkeit der Gottesbeziehung, die im Urzustand existierte, wird wiederhergestellt, der Graben zwischen Gott und den Menschen ist wieder geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0cc15414-9874-3278-bf64-90a493019940",
                        "entry_id": "d09561e4-bcfe-3090-87e2-243225fb2dff",
                        "glosses": [
                            "ursprünglicher Zustand",
                            "gedachter oder angenommener Zustand vor dem Abschluss des Gesellschaftsvertrages"
                        ],
                        "tags": [
                            "Kontraktualismus"
                        ],
                        "examples": [
                            {
                                "example_id": "a08fe94a-e5da-4d9f-9088-ba0817b367a2",
                                "sense_id": "0cc15414-9874-3278-bf64-90a493019940",
                                "text": "„Da der Urzustand viel weniger die Ausgangsposition einer Vertragsverhandlung als eine Perspektive ist, die jeder Einzelne zur Überprüfung der Gerechtigkeit institutioneller Strukturen einnehmen soll, bildet Rawls’ postmetaphysisches Theoriedesign Kants Zwei-Welten-Dualismus nach. Die Spannung zwischen der am Urzustand geschulten moralischen und selbstinteressiert-alltäglichen Subjektivität nimmt das Individuum in die Zucht […].“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
                ],
