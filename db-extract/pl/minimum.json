                                                "example_id": "be75d04e-6ee7-4f40-a13a-c94e94e0ed8b",
                                                "sense_id": "9a7f54b7-a8d6-3b15-885a-e71ac4d9f085",
                                                "text": "Please keep noise to a minimum after 11 o'clock"
                                            },
                                            {
                                                "example_id": "f750f19a-cf8c-4c5c-9d2a-cc9e38c9b2bb",
                                                "sense_id": "9a7f54b7-a8d6-3b15-885a-e71ac4d9f085",
                                                "text": "Realism might be the hardest aesthetic to do well. The performances have to be genuinely moving and the setting vividly evoked; bonkers twists must be kept to a minimum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf74f5a-5ade-34f5-8f5d-ede1ce4d070e",
                                        "entry_id": "0522449a-079d-3623-b9e5-0db34b89a232",
                                        "glosses": [
                                            "A period of minimum brightness or energy intensity (of a star)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861c61ec-b859-4a08-8121-6b56e72d1e8b",
                                                "sense_id": "eaf74f5a-5ade-34f5-8f5d-ede1ce4d070e",
                                                "text": "The Maunder minimum of the Sun reportedly corresponded to a period of great cold on Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad33922-b487-3915-bc1b-d5d44fac1066",
                                        "entry_id": "0522449a-079d-3623-b9e5-0db34b89a232",
                                        "glosses": [
                                            "A lower bound of a set which is also an element of that set."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0e42cfb-49ac-354c-ba0c-6aed3fa98089",
                                        "entry_id": "0522449a-079d-3623-b9e5-0db34b89a232",
                                        "glosses": [
                                            "The smallest member of a batch or sample or the lower bound of a probability distribution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "minimum",
                                "target_lang_code": "en",
                                "target_senses": [
