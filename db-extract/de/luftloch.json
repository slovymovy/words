                                    {
                                        "sense_id": "3cc9c967-5261-36c8-92c3-d5015c4f9f7a",
                                        "entry_id": "35ae6e30-6e2c-3f6c-bcf3-13d2a4020b33",
                                        "glosses": [
                                            "Exposition au vent, à l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a20ffd-dee5-4d2f-839f-f5fe608d45ff",
                                                "sense_id": "3cc9c967-5261-36c8-92c3-d5015c4f9f7a",
                                                "text": "Mettre des marchandises, des hardes à l’évent."
                                            },
                                            {
                                                "example_id": "c26f93aa-3287-48a6-a0a4-0f5175f34e15",
                                                "sense_id": "3cc9c967-5261-36c8-92c3-d5015c4f9f7a",
                                                "text": "Il semblait que cette petite pendule était fée et qu’elle avait pris à tâche d’ensorceler toute la Bavière. Partout où elle passait, partout où elle sonnait son joli timbre à l’évent, il affolait, détraquait les cervelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68b24e36-b69f-3541-818e-d0673e786487",
                                        "entry_id": "35ae6e30-6e2c-3f6c-bcf3-13d2a4020b33",
                                        "glosses": [
                                            "Odeur et saveur particulières que donne parfois aux aliments et aux liqueurs le contact prolongé de l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26a98e52-e87b-43a8-873b-940d8706dc99",
                                                "sense_id": "68b24e36-b69f-3541-818e-d0673e786487",
                                                "text": "Du vin qui sent l’évent, qui a de l’évent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6a72140-a919-32f6-bba3-2960ce9d8d6e",
                                        "entry_id": "35ae6e30-6e2c-3f6c-bcf3-13d2a4020b33",
                                        "glosses": [
                                            "Ouverture par laquelle certains cétacés aspirent l’air puis le rejettent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67802347-abce-3a5e-b595-d3ab486c45d0",
                                        "entry_id": "35ae6e30-6e2c-3f6c-bcf3-13d2a4020b33",
                                        "glosses": [
                                            "Conduit que l’on ménage dans la fondation des fourneaux des fonderies pour que l’air y circule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a78b55a7-894f-376a-8eff-ef4e4de1bc81",
