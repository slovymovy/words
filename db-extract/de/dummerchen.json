                "senses": [
                    {
                        "sense_id": "c2591e90-1e07-309b-b3a8-c79b9b2e937a",
                        "entry_id": "51780427-9700-3637-9ed8-b42948d66e8f",
                        "glosses": [
                            "naive, unerfahrene, sich dümmlich und ungeschickt anstellende Person"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "familiär;",
                            "meist als Anrede gegenüber kleinen Kindern benutzt"
                        ],
                        "examples": [
                            {
                                "example_id": "58478343-44b5-48d1-8b7b-5235755c7eac",
                                "sense_id": "c2591e90-1e07-309b-b3a8-c79b9b2e937a",
                                "text": "Du kleines Dummerchen! Du musst erst die Radschrauben entfernen, bevor du das Rad wechseln kannst."
                            },
                            {
                                "example_id": "3f7059d8-9e10-4e1b-84c3-d49f67248ce5",
                                "sense_id": "c2591e90-1e07-309b-b3a8-c79b9b2e937a",
                                "text": "„Anscheinend war ich echt das Dummerchen der Nation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec67bf11-64e9-48b6-b770-9a72c01c88c0",
                        "source_entry_id": "51780427-9700-3637-9ed8-b42948d66e8f",
                        "source_sense_id": "c2591e90-1e07-309b-b3a8-c79b9b2e937a",
                        "source_sense_description": "naive, unerfahrene, sich dümmlich und ungeschickt anstellende Person",
                        "target_lang_word": "bêta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bêta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e037c3cb-5017-39ea-81fa-077f3d8a8641",
                                        "entry_id": "b0bee291-6584-3ff9-bf82-f349c3847689",
                                        "glosses": [
                                            "Un peu bête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c5c3f16-30b6-4114-a1d2-6372947846e1",
                                                "sense_id": "e037c3cb-5017-39ea-81fa-077f3d8a8641",
                                                "text": "Je le trouve un peu bêta."
                                            },
                                            {
                                                "example_id": "72de58ed-14f9-483b-80df-dc214506ab28",
                                                "sense_id": "e037c3cb-5017-39ea-81fa-077f3d8a8641",
                                                "text": "— Pauvre enfant ! je me souviens de vos nuits de travail à la rue du Doyenné. Vous avez été un peu bêta."
                                            },
                                            {
                                                "example_id": "b8a64536-cd20-43ab-bb82-f109513bf3a8",
                                                "sense_id": "e037c3cb-5017-39ea-81fa-077f3d8a8641",
                                                "text": "Il causait peu, paraissait bêta."
                                            },
                                            {
                                                "example_id": "5a8743fa-7d70-4dea-b118-a9054040594f",
                                                "sense_id": "e037c3cb-5017-39ea-81fa-077f3d8a8641",
                                                "text": "Gros bêta ! s’écria ma tante quand je rentrai, est-il permis de se gâter ainsi la vie ! Il n’y a pas un mot de raisonnable dans tout ce que tu m’a conté ce matin…"
                                            },
                                            {
                                                "example_id": "4f03adb3-152e-42f7-b56e-f4ee768a78eb",
                                                "sense_id": "e037c3cb-5017-39ea-81fa-077f3d8a8641",
                                                "text": "Le bêta de général a d'abord cru que c'était la nôtre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bêta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35c44a90-5304-3482-9ca3-dec822353c27",
                                        "entry_id": "420036a5-4729-3de8-88cd-6b3043846408",
                                        "glosses": [
                                            "Qualifie la version d’un logiciel destinée à détecter les derniers problèmes restants avant de la diffuser normalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f310b7-8cf8-44a1-b172-a79ca698a68d",
                                                "sense_id": "35c44a90-5304-3482-9ca3-dec822353c27",
                                                "text": "GitHub Actions est actuellement en bêta fermée et vous pouvez vous inscrire à cette adresse pour essayer d’y participer."
                                            },
                                            {
                                                "example_id": "90f16071-5a26-4b6f-993c-16a1c8e80b45",
                                                "sense_id": "35c44a90-5304-3482-9ca3-dec822353c27",
                                                "text": "La version bêta munie de cette fonctionnalité devrait sortir au printemps, selon ce qu’a indiqué Apple, sans plus de précision."
                                            },
                                            {
                                                "example_id": "8a481499-8964-4f8c-becd-2877328efce7",
                                                "sense_id": "35c44a90-5304-3482-9ca3-dec822353c27",
                                                "text": "Ceux qui connaissent bien la firme d’Elon Musk ont bien en tête que de nombreuses fonctionnalités sortent en version bêta, et restent malheureusement éternellement en bêta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9008ae7-dc9f-39e1-8bb8-30ac051f871f",
                                        "entry_id": "420036a5-4729-3de8-88cd-6b3043846408",
                                        "glosses": [
                                            "Relatif aux rayons bêta. Relatif à la désintégration radioactive dans laquelle un électron ou un positron est émis."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5901463-ea40-4c80-b1a8-763168dee63f",
                                                "sense_id": "f9008ae7-dc9f-39e1-8bb8-30ac051f871f",
                                                "text": "Comme l'électron bêta émis se déplace dans le cristal en provoquant des ionisations sur son parcours, les orbitales des autres atomes du cristal sont réarrangées le long de son parcours. L'électron bêta peut être finalement capté par le cristal lui-même sans pouvoir s'en échapper, cédant alors toute son énergie cinétique au cristal, sous forme de chaleur."
                                            },
                                            {
                                                "example_id": "484469e9-6de0-48de-8c51-cad86506683d",
                                                "sense_id": "f9008ae7-dc9f-39e1-8bb8-30ac051f871f",
                                                "text": "Au contraire de la désintégration bêta, la désintégration alpha est soumise à la force nucléaire forte et est caractéristique des noyaux lourds de masse atomique supérieure à 200)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bêta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6960c69d-914e-3554-857a-acc462a432a1",
                                        "entry_id": "fdfe5c3b-12ce-3a00-8ff1-b89754e6d4b1",
                                        "glosses": [
                                            "Celui qui est d’une bêtise niaise et lourde."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687990d2-dee4-4fc3-9485-f1dc4dd68192",
                                                "sense_id": "6960c69d-914e-3554-857a-acc462a432a1",
                                                "text": "Le fils était un garçon quelconque, majeur depuis six mois, physionomie insignifiante, long col, ce qui, joint au reste, est souvent un indice de stupidité native […] en un mot, un de ces bêtas, nuls et inutiles, qui, pour employer une locution de la langue algébrique, sont affectés du signe « moins »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bêta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb692b5d-980d-3e04-99c1-e8353f8d9664",
                                        "entry_id": "e7e8a99e-9c48-3cce-8936-a148bea31486",
                                        "glosses": [
                                            "Nom de β, ϐ, Β, deuxième lettre et première consonne de l’alphabet grec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aabd161b-273d-4cdf-96c0-960fef468bef",
                                                "sense_id": "cb692b5d-980d-3e04-99c1-e8353f8d9664",
                                                "text": "Bêta vient de la seconde lettre de l’alphabet phénicien, bet signifiant « maison »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379bbeb9-13fd-390c-ae38-5ecbd80e9ca7",
                                        "entry_id": "e7e8a99e-9c48-3cce-8936-a148bea31486",
                                        "glosses": [
                                            "Partie de la performance correspondant à un indice financier donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feba31e5-f9cc-4e97-845d-cd6121b62514",
                                                "sense_id": "379bbeb9-13fd-390c-ae38-5ecbd80e9ca7",
                                                "text": "Le bêta d’un fonds se définit mathématiquement comme le rapport de la covariance de la rentabilité implicite du portefeuille avec celle du marché et de la variance de la rentabilité implicite du marché."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bêta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a31717a-5bfc-383b-aa4c-0369b120c64a",
                                        "entry_id": "07f59a70-67e6-31a3-81e0-9a43987737cc",
                                        "glosses": [
                                            "Nom donné à une version d’un logiciel destinée à détecter les derniers problèmes restants avant de la diffuser normalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82142f9-a433-46dc-8dba-c427d72a6a33",
                                                "sense_id": "9a31717a-5bfc-383b-aa4c-0369b120c64a",
                                                "text": "La bêta ouverte, ou bêta publique, est la version dans laquelle n’importe qui peut participer, avec parfois une restriction technique (nombre d’utilisateurs connectés simultanément, etc.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4daca972-422f-43da-848c-483c74456eaf",
                        "source_entry_id": "51780427-9700-3637-9ed8-b42948d66e8f",
                        "source_sense_id": "c2591e90-1e07-309b-b3a8-c79b9b2e937a",
