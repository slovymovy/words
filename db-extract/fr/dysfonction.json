                ],
                "senses": [
                    {
                        "sense_id": "3b3fa007-3220-3ade-be25-112da79b2690",
                        "entry_id": "c916ac72-15b0-3c70-a688-b047c0630178",
                        "glosses": [
                            "Dysfonctionnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe2a4b87-1c6f-4d88-931b-0a2f7c343a7d",
                                "sense_id": "3b3fa007-3220-3ade-be25-112da79b2690",
                                "text": "Dans le premier cas, on parlera de pathologie de l'administration, de bureaupathologie ou, pour emprunter la terminologie de K. MERTON, de dysfonctions administratives."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e2adf65-f5b2-380a-9c60-e1bbf4d06cb3",
                        "entry_id": "c916ac72-15b0-3c70-a688-b047c0630178",
                        "glosses": [
                            "Mauvais fonctionnement, défaut, trouble, en particulier concernant la sexualité masculine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e250481f-2367-4d4d-be54-300cf2617d8c",
                                "sense_id": "9e2adf65-f5b2-380a-9c60-e1bbf4d06cb3",
                                "text": "La dysfonction érectile se définit par l’incapacité à obtenir ou à maintenir une érection suffisante pour un rapport sexuel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e750253-32bf-4ed5-b820-2232f2abeb99",
                        "source_entry_id": "c916ac72-15b0-3c70-a688-b047c0630178",
                        "target_lang_word": "dysfunction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysfunction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f69cce7b-5857-392d-8f7f-c80c08b5c309",
                                        "entry_id": "cb3a7bf9-4ed5-328e-89eb-ee860882cb14",
                                        "glosses": [
                                            "A failure to function in an expected or complete manner. Usually refers to a disorder in a bodily organ (e.g. erectile dysfunction), a mental disorder, or the improper behavior of a social group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec2ddac-7fd9-4cdc-886a-4f522594cc37",
                                                "sense_id": "f69cce7b-5857-392d-8f7f-c80c08b5c309",
                                                "text": "Cerebellar dysfunction is characterized by truncal ataxia, a broad-based stance, dysmetria in which the limbs either overstep (hypermetria) or understep (hypometria), and tremor that is most pronounced when the animal attempts a goal-orientated movement (intention tremor)."
                                            },
                                            {
                                                "example_id": "bb0a8435-0260-4c8f-bf15-4a9d3dcce133",
                                                "sense_id": "f69cce7b-5857-392d-8f7f-c80c08b5c309",
                                                "text": "We next consider the cognification of interpersonal dysfunctions in treating clinical depression."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dysfunction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b00e564a-1374-30ab-a59a-872425dcb1ae",
                                        "entry_id": "fe72644b-eace-3cc4-ae8f-06d0640522af",
                                        "glosses": [
                                            "To fail to function correctly; to malfunction."
