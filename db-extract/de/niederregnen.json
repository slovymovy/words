                ],
                "senses": [
                    {
                        "sense_id": "97ab4e12-ce5e-3541-9902-1af78d873b5c",
                        "entry_id": "b3308a6a-ed3e-39c8-809b-e44e074df8f0",
                        "glosses": [
                            "(wie Regen[tropfen]) von oben, einem höher gelegenen Ort, nach unten, einen tiefer gelegenen Ort, fallen/herabkommen"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2e80216b-2e2c-499c-bd4e-9a468f28c857",
                                "sense_id": "97ab4e12-ce5e-3541-9902-1af78d873b5c",
                                "text": "„Streumunition sind Bomben oder Granaten, die sich über dem Gefechtsfeld öffnen und zahlreiche kleinere Sprengsätze niederregnen lassen.“"
                            },
                            {
                                "example_id": "57111040-4816-41a7-b33d-e0c8108134e0",
                                "sense_id": "97ab4e12-ce5e-3541-9902-1af78d873b5c",
                                "text": "„Die Menge von Meteoritengeröll, die auf die Sonne niederregnen müsste, um deren gemessene Wärmeleistung zu erbringen, würde auf der Sonnenoberfläche eine jährlich um zehn Meter in die Höhe wachsende Schicht bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
