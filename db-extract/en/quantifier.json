                "senses": [
                    {
                        "sense_id": "ec20ddeb-8f49-3975-ae2e-a556cc100d73",
                        "entry_id": "dde5fe0e-64af-3642-ad26-4890ed8767b5",
                        "glosses": [
                            "A word, such as all or many, that expresses the quantity of a related noun."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "965c74b3-94f8-30e8-9adf-d10b00a9107e",
                        "entry_id": "dde5fe0e-64af-3642-ad26-4890ed8767b5",
                        "glosses": [
                            "An operator, such as the universal quantifier (written as ∀) or the existential quantifier (∃), used in predicate calculus to indicate the degree that predicate is true for a specified set."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "14268798-81a7-3551-b044-1412044fca0e",
                        "entry_id": "dde5fe0e-64af-3642-ad26-4890ed8767b5",
                        "glosses": [
                            "A symbol or symbols in a regular expression indicating the number of characters to be matched."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2511dcdf-89e0-4dc7-a98e-d318288a7b6b",
                        "source_entry_id": "dde5fe0e-64af-3642-ad26-4890ed8767b5",
                        "source_sense_description": "a word, such as all or many, that expresses a quantity",
                        "target_lang_word": "quantificateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quantificateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54b948e9-1a5a-3118-9c3d-36725894bbde",
                                        "entry_id": "327a67c4-3860-3584-92d9-7d238629918b",
                                        "glosses": [
                                            "Symbole représentant une quantification."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b697fd7-156f-3d0e-806b-e4a7f42e5aed",
                                        "entry_id": "327a67c4-3860-3584-92d9-7d238629918b",
                                        "glosses": [
                                            "Une quantification en elle-même."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27d4baa0-363a-4096-baf7-b3268140f146",
                                                "sense_id": "6b697fd7-156f-3d0e-806b-e4a7f42e5aed",
                                                "text": "Rétrospectivement, on peut dire que la logique aristotélicienne prend en considération quatre quantificateurs : « tous », « quelques », « aucun » et « pas tous »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb557615-2b4b-3732-9915-248fcbdc8d6a",
                                        "entry_id": "327a67c4-3860-3584-92d9-7d238629918b",
                                        "glosses": [
                                            "Déterminant indiquant la quantité par laquelle le substantif est défini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0c9e725-9591-4ce5-be3d-996e66131dec",
                                                "sense_id": "cb557615-2b4b-3732-9915-248fcbdc8d6a",
                                                "text": "Ici le quantificateur travaille sur le prédicat complexe « manger - biscuit », et construit une fermeture (manger un biscuit)."
                                            },
                                            {
                                                "example_id": "67d1372b-d6db-470b-839d-6439aaaa8fad",
                                                "sense_id": "cb557615-2b4b-3732-9915-248fcbdc8d6a",
                                                "text": "Dans 76 % des langues, les quantificateurs universels (ex. tout) et existentiels (ex. quelqu’un) sont dérivés d’interrogatifs."
                                            },
                                            {
                                                "example_id": "146c2324-3a45-468b-8f35-6889e262bed6",
                                                "sense_id": "cb557615-2b4b-3732-9915-248fcbdc8d6a",
                                                "text": "NOTE IMPORTANTE: Il est possible de “proclitiser” les dizaines qui s’accordent avec leurs quantificateurs, et lier celles qui ne s’accordent pas d’un train d’union avec les leurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c449cbf-6d62-3e23-988d-088c1c541935",
                                        "entry_id": "327a67c4-3860-3584-92d9-7d238629918b",
                                        "glosses": [
                                            "Élément regex indiquant le nombre d’occurrences."
                                        ],
                                        "tags": [
                                            "Expressions rationnelles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5690069d-000f-4fb8-b8c5-9109d8d1bae4",
                                                "sense_id": "5c449cbf-6d62-3e23-988d-088c1c541935",
                                                "text": "L’efficacité des regex provient de leur capacité à combiner plusieurs quantificateurs pour former une expression plus complexe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
