                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8180b844-16f2-3f73-9882-38fe23d85458",
                        "entry_id": "3fb88760-9552-3389-9670-a51033864e0b",
                        "glosses": [
