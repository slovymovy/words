                "senses": [
                    {
                        "sense_id": "63b4b14b-70d6-3a99-8d08-4c71b8f703b9",
                        "entry_id": "07c4f200-a692-3696-ad27-36bad2ba0e1e",
                        "glosses": [
                            "Attentive, listening."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb05f3d-8c41-43c6-b18e-1257814d5217",
                                "sense_id": "63b4b14b-70d6-3a99-8d08-4c71b8f703b9",
                                "text": "The boundless, — infinite, — Almighty Power, Is ceaseless rolling on our listful ears — Through all th' immensity which every where appears."
                            },
                            {
                                "example_id": "c0615792-9121-479a-9e81-824b1f7dae08",
                                "sense_id": "63b4b14b-70d6-3a99-8d08-4c71b8f703b9",
                                "text": "Like the former, this meeting was equally listful and attentive, breaking up in the best of order and apparent satisfaction."
                            },
                            {
                                "example_id": "ed9596bf-8fda-4a34-9711-a0499dd798df",
                                "sense_id": "63b4b14b-70d6-3a99-8d08-4c71b8f703b9",
                                "text": "These are historical facts that cannot be controverted, and therefore proclaim in tones more eloquently than thunder, the listful attention of every oppressed man, woman, and child under the government of the people of the United States of America."
                            }
                        ]
                    },
                    {
                        "sense_id": "a67e74c0-54d8-3933-b48c-6e3b29b9530f",
                        "entry_id": "07c4f200-a692-3696-ad27-36bad2ba0e1e",
                        "glosses": [
                            "Using or based on lists."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67e73d74-d325-433e-94d0-e1971ecce0f5",
                                "sense_id": "a67e74c0-54d8-3933-b48c-6e3b29b9530f",
                                "text": "Unfortunately, listful style can be very inefficient. This is due to the space required to store the intermediate lists, and the time required to traverse them."
                            },
                            {
                                "example_id": "13061848-59d5-429c-ae18-7bafe71998cb",
                                "sense_id": "a67e74c0-54d8-3933-b48c-6e3b29b9530f",
                                "text": "True joy permeates from the commander of common grace, his matrix of pleasure flows throughout with a listful liberation of joy."
                            },
                            {
                                "example_id": "d6964631-4c08-423d-9409-1fb3c365a82d",
                                "sense_id": "a67e74c0-54d8-3933-b48c-6e3b29b9530f",
                                "text": "If you embrace the philosophy of listful thinking, you can get your life back— because thinking in terms of bitesized goals is much easier than biting off a Guy Fierisized chunk."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8bac54a-94f6-3288-9fff-6c9c839bb792",
                        "entry_id": "07c4f200-a692-3696-ad27-36bad2ba0e1e",
                        "glosses": [
                            "Tending to list or lean."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "69bf0390-12a8-44af-8126-48c96b3f1884",
                                "sense_id": "d8bac54a-94f6-3288-9fff-6c9c839bb792",
                                "text": "Leaving the coach sitting there horseless of shaft and decidedly listful at the front end."
                            }
                        ]
                    }
                ],
