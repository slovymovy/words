                                        "glosses": [
                                            "ein südamerikanisches Nagetier, das auch beliebtes Haustier bei Kindern ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da2c769-2187-45c1-9a47-e2596e6a0f26",
                                                "sense_id": "97e4364e-b237-3873-b8af-ceebaa18076f",
                                                "text": "Möchtest du lieber ein Meerschweinchen oder ein Chinchilla?"
                                            },
                                            {
                                                "example_id": "9bf0158a-0910-412f-92b8-5558db391a75",
                                                "sense_id": "97e4364e-b237-3873-b8af-ceebaa18076f",
                                                "text": "Chinchillas sind normalerweise recht neugierig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "546adea8-4572-3f5b-bd72-595e3efc95cd",
                                        "entry_id": "146f0736-8839-3421-9a65-f99c0d730b7e",
                                        "glosses": [
                                            "der Pelz von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50aa1e4f-6be6-491f-b496-8c271ca6d8c3",
                                                "sense_id": "546adea8-4572-3f5b-bd72-595e3efc95cd",
                                                "text": "Ein dunkler Wollmantel mit einem Kragen aus Chinchilla rundete ihr Outfit ab."
                                            },
                                            {
                                                "example_id": "921cfd18-8e64-4038-acd1-2df373641a77",
                                                "sense_id": "546adea8-4572-3f5b-bd72-595e3efc95cd",
                                                "text": "Er lud sie in die Bar des Grandhotels ein, wohin er sie und sie ihre neueste Kreation aus Chinchilla ausführte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
