                        "glosses": [
                            "ursprüngliche Einspielung eines Musikstücks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99f6b71-2b71-4b52-aaa4-cae239c0aef1",
                                "sense_id": "0a47e6c6-812b-38d0-af63-390c2f5786f2",
                                "text": "„Die Erstaufnahme der Lili Marleen mit einem Orchester unter Leitung von Bruno Seidler-Winkler dauerte die ganze Nacht vom 31. Juli auf den 1. August 1939.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09f01ec3-68e1-3be9-89a1-387d8ef6a960",
                        "entry_id": "87d7f639-34b3-31f0-a5ec-1d8707b3b0bb",
                        "glosses": [
                            "vorläufige Unterbringung von Flüchtlingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b9359f4-4ea0-46e0-a34f-51f9e429be3c",
                                "sense_id": "09f01ec3-68e1-3be9-89a1-387d8ef6a960",
                                "text": "„Ab Montag erfolgt die Erstaufnahme für alle Asylwerber, die über Kärnten nach Österreich kommen, in Krumpendorf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
