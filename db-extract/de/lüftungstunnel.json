                "senses": [
                    {
                        "sense_id": "cd4fa7d8-e5e7-36f2-93b2-64f9b3c3d92a",
                        "entry_id": "6cac1734-1d18-3823-9779-249a6c52f887",
                        "glosses": [
                            "längliche Röhre durch die Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43891a5a-8a32-4045-89c8-e3b0c5faf714",
                                "sense_id": "cd4fa7d8-e5e7-36f2-93b2-64f9b3c3d92a",
                                "text": "„Mithilfe eines besonders regensicheren Lüftungstunnels erfolgt die Lüftung durch eine große Anzahl von freien Lüftungsöffnungen.“"
                            },
                            {
                                "example_id": "ebf8b00c-527e-4ef3-ac7e-ddca182697d6",
                                "sense_id": "cd4fa7d8-e5e7-36f2-93b2-64f9b3c3d92a",
                                "text": "„Zum Beispiel fehlt der Lüftungstunnel in der Mitte der Tiertransporter.“"
                            },
                            {
                                "example_id": "857a5d61-4215-44d4-83b5-0b51179d276e",
                                "sense_id": "cd4fa7d8-e5e7-36f2-93b2-64f9b3c3d92a",
                                "text": "„Diese Segmente bestehen aus den 3 Röhren nebeneinander und den Lüftungstunneln unter und über der Fahrbahn.“"
                            },
                            {
                                "example_id": "b128e85c-977e-46e3-829d-35aab425da8f",
                                "sense_id": "cd4fa7d8-e5e7-36f2-93b2-64f9b3c3d92a",
                                "text": "„Insekten, wie etwa Termiten, legen lange Lüftungstunnel an, um die Temperatur zu regulieren.“"
                            },
                            {
                                "example_id": "8a6cb3ea-117a-4eae-b381-a71afb5a71e2",
                                "sense_id": "cd4fa7d8-e5e7-36f2-93b2-64f9b3c3d92a",
                                "text": "„Hier mussten ebenfalls zusätzliche Leistungen erbracht werden und eine 2m starke Auffüllung aus Beton in der Sohle des Lüftungstunnels aufgebrochen und das aufgeweitete Gerinne hergestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
