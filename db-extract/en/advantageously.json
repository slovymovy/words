                        "entry_id": "0d375c5b-a672-36dd-bc24-752e947fd1e5",
                        "glosses": [
                            "In a manner which provides an advantage; in an advantageous manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfc373f-1fca-4fec-a506-829df642191c",
                                "sense_id": "81813159-f686-3a39-8f2b-bca6323f1748",
                                "text": "[…] ſtill he thought no more than that being ſo young, the largeneſs of his machine (for few men could diſpute ſize with him) made all the difficulty, and that poſſibly I had not been enjoy’d by any ſo advantageouſly made in that part as himſelf; […]",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e754fbc-27f0-4941-afde-fab19240fdb4",
                        "source_entry_id": "0d375c5b-a672-36dd-bc24-752e947fd1e5",
                        "source_sense_id": "81813159-f686-3a39-8f2b-bca6323f1748",
                        "source_sense_description": "in an advantageous manner",
                        "target_lang_word": "avantageusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avantageusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                        "entry_id": "7d2338ff-3414-3efc-a8c3-7b9645f27b6b",
                                        "glosses": [
                                            "Qui apporte un avantage en étant utile, profitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85744b02-47eb-4acf-b795-8218f2c1006f",
                                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                                "text": "Cette maison est située très avantageusement pour les opérations secrètes du ministère."
                                            },
                                            {
                                                "example_id": "642992c5-1b71-4cf2-8ce0-1e7bbf55922f",
                                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                                "text": "À Tripoli comme à Alger l’embonpoint est considéré comme un type de beauté, aussi engraisse-t-on les jeunes filles pour les marier avantageusement."
                                            },
                                            {
                                                "example_id": "b4eea72c-96b7-41f4-aa4d-8e426dfa7531",
                                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                                "text": "Le diamant remplace avantageusement aujourd’hui le fer chaud"
                                            },
                                            {
                                                "example_id": "4ae3feab-e73a-447c-98da-fd7d7027b456",
                                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                                "text": "Quant à la ruine, elle sera pour moi moins considérable que je ne l’avais cru, parce que j’ai vendu très avantageusement ma ferme à Deauville."
                                            },
                                            {
                                                "example_id": "27de3fda-23b7-47e7-a22d-ea7aef601ac1",
                                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                                "text": "Est-ce que des professeurs particuliers ne remplaceraient pas avantageusement la routine universitaire ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                        "entry_id": "7d2338ff-3414-3efc-a8c3-7b9645f27b6b",
                                        "glosses": [
                                            "De manière à honorer, à flatter, à mettre en valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e19cce3-aa35-496e-ba5b-fa01f384a72b",
                                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                                "text": "Par exemple, les auteurs du cinquiéme siécle ne parlent point avantageusement du courage et des mœurs des vandales."
                                            },
                                            {
                                                "example_id": "362442a1-899f-4908-a6bf-1933449a7a63",
                                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                                "text": "Le goût des habillements qui dessinent avantageusement les formes, a repris faveur."
                                            },
                                            {
                                                "example_id": "95643357-6672-4656-bad3-e001efcd7194",
                                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                                "text": "Toutefois, il était si avantageusement connu dans les provinces du Magne que, devant ce nom, tous s’inclinèrent."
                                            },
                                            {
                                                "example_id": "cadb10c8-e2b5-47b9-a954-da8a5e83ce09",
                                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                                "text": "Alors je lui dis que je serais heureux de prendre sa photographie, ce qui le fit sourire avantageusement."
                                            },
                                            {
                                                "example_id": "3c02b221-aacc-4219-9e59-ef08cd05a1f7",
                                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                                "text": "La taille élancée, l’œil profond et la moustache retroussée sur de belles dents blanches, il portait avantageusement encore son renom d’homme à femmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11c71b2f-0b02-4edc-a653-b30129071248",
                        "source_entry_id": "0d375c5b-a672-36dd-bc24-752e947fd1e5",
                        "source_sense_id": "81813159-f686-3a39-8f2b-bca6323f1748",
                        "source_sense_description": "in an advantageous manner",
                        "target_lang_word": "zweckmäßigerweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweckmäßigerweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                        "entry_id": "758e1f5c-c8ec-30a9-842d-9c31b99d48ef",
                                        "glosses": [
                                            "zur Zweckmäßigkeit; in Anbetracht der Nützlichkeit von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f66a57-f0f0-479d-95d0-09d1841d9f52",
                                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                                "text": "„Die Meldepflicht bei Durchfallerkrankungen ist zweckmäßigerweise auf Fälle beschränkt, die seuchenhygienisch von wesentlicher Bedeutung sind.“"
                                            },
                                            {
                                                "example_id": "d85de339-7fb7-49c7-9475-e23a8c36e9cf",
                                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                                "text": "„Es kann zweckmäßigerweise vorkommen, dass bei einem späteren Kapitel auf bestimmte Teile zurückgegriffen wird.“"
                                            },
                                            {
                                                "example_id": "f31a0478-6c4a-433f-91cb-a5056cbf8d22",
                                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                                "text": "„Man geht deshalb zweckmäßigerweise an Hand eines Schemas oder einer Check-Liste vor.“"
                                            },
                                            {
                                                "example_id": "5d1b1180-b435-4436-89b6-0596f459478e",
                                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                                "text": "„In diesen Schulküchen wird zweckmäßigerweise eine Mittagsmahlzeit, etwa dem Drittel des täglichen Nahrungsbedarfes im Nährwerte entsprechend, den Kindern verabreicht (etwa 10 hn pro Kind und Tag).“"
                                            },
                                            {
                                                "example_id": "dfaf483f-e737-4ed3-9054-bb5e9a2496ec",
                                                "sense_id": "ab34fd6d-9e74-302a-a2af-8651ae85d0ca",
                                                "text": "„Bei vielen fremdbezogenen Produkten muß sich der Einkauf mit der Frage befassen, ob man zweckmäßigerweise den Betriebsbedarf direkt beim Erzeuger decken oder ein Handelsunternehmen einschalten soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
