                            "target_lang_translations": {
                                "en": "The dog came up to me and started to <w>sniff</w> my shoes."
                            }
                        },
                        {
                            "text": "In de tuin ging de puppy rustig een vrolijk <w>besnuffelen</w> van alle bloemen aan.",
                            "target_lang_translations": {
