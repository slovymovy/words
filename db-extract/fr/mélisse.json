                ],
                "senses": [
                    {
                        "sense_id": "2c8c6660-face-3fbc-b6e7-7bc8e312d406",
                        "entry_id": "16f7dcdf-400b-3439-b989-5eba13986f4b",
                        "glosses": [
                            "Plante aromatique de la famille des lamiacées, dont on fait une eau distillée, appelée eau de mélisse ou eau des Carmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdbd2cc-1572-43a8-a98c-c75cc1110033",
                                "sense_id": "2c8c6660-face-3fbc-b6e7-7bc8e312d406",
                                "text": "J’ai senti mes forces m’abandonner et c’est à partir de ce moment que je me suis mise à boire, d’abord de l’eau de mélisse, plus tard du rhum."
                            },
                            {
                                "example_id": "4c41a4bd-15aa-4eb0-8c40-e7c8ec8b57e4",
                                "sense_id": "2c8c6660-face-3fbc-b6e7-7bc8e312d406",
                                "text": "À tout moment, sous une bouffée d’infection, son cœur se levait : elle était obligée de prendre dans sa poche un flacon d’eau de mélisse qu’elle avait toujours sur elle, et d’en boire une gorgée pour ne pas se trouver mal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "676e4e25-5b30-4227-8f0a-4334751d91a3",
                        "source_entry_id": "16f7dcdf-400b-3439-b989-5eba13986f4b",
