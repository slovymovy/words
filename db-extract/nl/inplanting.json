                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa82c8c-4cd4-4880-a286-ab63d95f0ab9",
                                "sense_id": "f646181c-e475-328c-b482-3a7379384870",
                                "text": "‘Voor mij is het cruciaal dat ik zal waken over de leefkwaliteit, de leefomgeving, het leefmilieu, het fijn stof, de CO2, de geluidshinder, de ruimtelijke inplanting en alles wat erbij komt kijken’, zei Schauvliege."
                            },
                            {
                                "example_id": "a3e3dd8e-c4f4-4772-a45b-b31ced6660b5",
                                "sense_id": "f646181c-e475-328c-b482-3a7379384870",
                                "text": "Daarnaast konden verschillende uitbaters niet aantonen dat er regelmatig onderhoud van de toestellen gebeurt. Ook een slechte inplanting van de speeltoestellen of beknellingsgevaar aan de toestellen waren redenen voor een waarschuwing."
                            },
                            {
                                "example_id": "268e70e8-b0b1-401e-a491-4ebb4f146bc0",
                                "sense_id": "f646181c-e475-328c-b482-3a7379384870",
                                "text": "In mei 2013 koos de Brusselse regering reeds voor de inplanting van een nieuw stadion op de huidige parking C van de Heizel, die op het grondgebied van de Vlaamse gemeente Grimbergen ligt."
                            }
                        ]
                    }
                ],
