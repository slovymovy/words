                "senses": [
                    {
                        "sense_id": "563414b9-809f-3c9e-bb96-f4a14a059321",
                        "entry_id": "8a5122af-6b84-30c4-8de6-31961608a8f4",
                        "glosses": [
                            "Software, mit der verschiedene Medieninhalte (Audio- und Videodateien) abgespielt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98fffaef-4278-4b9a-bc00-331b9466cc1c",
                                "sense_id": "563414b9-809f-3c9e-bb96-f4a14a059321",
                                "text": "„Erstellen wir nun einen Mediaplayer als Beispiel, der die wichtigsten besprochenen Features zeigen soll […]“"
                            },
                            {
                                "example_id": "2149ea2c-c1ae-4879-b31a-58f3fc4b7cac",
                                "sense_id": "563414b9-809f-3c9e-bb96-f4a14a059321",
                                "text": "„Anstatt einen Ordner zu öffnen, surrte das Laufwerk weiter und fragte mit welchem Mediaplayer das Video geöffnet werden soll.“"
                            },
                            {
                                "example_id": "684272ae-31af-494b-bc78-5ec8ebfe9678",
                                "sense_id": "563414b9-809f-3c9e-bb96-f4a14a059321",
                                "text": "„Mediaplayer sind Computerprogramme, die Daten von verschiedenen Quellen einlesen, dekodieren und dann als unkomprimierte digitale Daten an eine Ausgabeeinheit weiterleiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
