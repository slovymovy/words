                        "examples": [
                            {
                                "example_id": "c7265c68-55e5-4c4c-a4e8-48f343502a7a",
                                "sense_id": "4bee19d7-258c-33e1-8608-4821aeb17d94",
                                "text": "’Une opération \" les stéthos du coeur \" a été montée pour que chaque concitoyen puisse librement consulter un praticien libéral proche de son domicile."
                            },
                            {
                                "example_id": "7e2280c6-1bd5-47ca-84c4-0ac4c18b3683",
                                "sense_id": "4bee19d7-258c-33e1-8608-4821aeb17d94",
                                "text": "’Tain, Léo, t’es pas encore au pieu ? demande une blouse blanche, un stétho dépassant de la poche, le nez chaussé de lunettes rondes cerclées de métal."
                            },
                            {
                                "example_id": "7c4b8686-2179-43b5-9b93-c5de487b835e",
                                "sense_id": "4bee19d7-258c-33e1-8608-4821aeb17d94",
                                "text": "’Le pavillon est la partie du stétho qui se pose sur le malade et responsable de la qualité d’écoutes des sons, une membrane y est présente et va permettre de capter les sons."
                            }
                        ]
                    }
