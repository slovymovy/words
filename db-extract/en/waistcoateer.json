                        "glosses": [
                            "Someone wearing a waistcoat; especially, a woman wearing one uncovered, or thought fit for such a habit; hence, a whore."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ca5211bf-430f-4632-9fb6-f0803c2e2014",
                                "sense_id": "6bf75d1d-1a5a-30f7-9984-14eddce00cdc",
                                "text": "Do you think you are here, sir, / Amongst your waistcoateers, your base wenches?"
                            },
                            {
                                "example_id": "a63fe41a-8c2e-4f41-b273-4b3dde21eb36",
                                "sense_id": "6bf75d1d-1a5a-30f7-9984-14eddce00cdc",
                                "text": "Thou knowest well that, from Mrs. Deputy's self down to the waistcoateers in the alley, all of them are twiring and peeping betwixt their fingers when you pass; and yet you call yourself a miserable dog!"
                            }
                        ]
                    }
