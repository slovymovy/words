                                        "glosses": [
                                            "Implante compuesto de tejido vivo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "942345b8-b6a3-43a0-b87e-b3860c86971c",
                                                "sense_id": "c44dedc9-a742-343d-b4ad-e4752a1f0c3c",
                                                "text": "Al elegir el lugar de donde se obtendrá el injerto se considerará en primer lugar la región glútea, la cara interior o posterior del muslo y la pantorrilla."
