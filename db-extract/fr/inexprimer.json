                "senses": [
                    {
                        "sense_id": "36227a35-0307-3118-86ee-8ce150e762c5",
                        "entry_id": "2e6e10da-c11b-395d-bd28-1134a4f3e799",
                        "glosses": [
                            "Ne plus exprimer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c391ae7-b09c-4534-b99b-a791c690e3de",
                                "sense_id": "36227a35-0307-3118-86ee-8ce150e762c5",
                                "text": "Toute la tâche de l’art est d’« inexprimer l’exprimable », selon les termes de Barthes."
                            },
                            {
                                "example_id": "df46856e-c2e0-466e-afab-34d17bb9f959",
                                "sense_id": "36227a35-0307-3118-86ee-8ce150e762c5",
                                "text": "Mais ils « inexpriment » - dans le sens qu’ils manipulent savamment - leur ensemble de signes polysémiques qui restent flous."
                            },
                            {
                                "example_id": "3a686f6e-5990-4ca6-ac0b-4848c6cf567d",
                                "sense_id": "36227a35-0307-3118-86ee-8ce150e762c5",
                                "text": "Volupté que le chant ne peut inexprimer !"
                            }
                        ]
                    }
