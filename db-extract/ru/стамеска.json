                                                "sense_id": "a27361eb-683c-3bc1-8866-2d738c6fccef",
                                                "text": "Laws that protect the environment are being chiseled away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "501bd97b-9e8c-3c11-8ab6-d26644b3172c",
                                        "entry_id": "adcb45ba-b608-3ac0-9a7a-cfd805c5d382",
                                        "glosses": [
                                            "To beg or pressure somebody into giving up (something); to haggle excessively; to cheat; to obtain something from (someone) by cheating."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5157138-225e-445f-935c-afb68759c0b8",
                                                "sense_id": "501bd97b-9e8c-3c11-8ab6-d26644b3172c",
                                                "text": "He's managed to chisel a couple dollars from somewhere."
                                            },
                                            {
                                                "example_id": "26dce35b-c04d-4388-af2a-ca1b80a597ca",
                                                "sense_id": "501bd97b-9e8c-3c11-8ab6-d26644b3172c",
                                                "text": "She can always chisel whatever she needs from her father."
                                            },
