                ],
                "senses": [
                    {
                        "sense_id": "352cb951-6a02-3d6e-afa8-dabfc352b60c",
                        "entry_id": "330d98c7-03cf-3ce0-86c3-d694415cb6a3",
                        "glosses": [
                            "Donner un caractère bouddhique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e1d0deb-6c13-41c7-92d0-4b6fd89bae11",
                                "sense_id": "352cb951-6a02-3d6e-afa8-dabfc352b60c",
                                "text": "Voilà pourquoi, dans une démocratie, l’école ne doit pas bouddhiser, judaïser, christianiser ou islamiser, mais humaniser seulement."
                            },
                            {
                                "example_id": "b39d6a2b-71ff-4737-8530-dd1f8bcd6d89",
                                "sense_id": "352cb951-6a02-3d6e-afa8-dabfc352b60c",
                                "text": "Dans la pratique, d’anciens généraux et d’anciens prisonniers sont chargés de « bouddhiser » l’Arakan."
                            },
                            {
                                "example_id": "9ba3b8ee-4bc9-4755-9413-032b238892a3",
                                "sense_id": "352cb951-6a02-3d6e-afa8-dabfc352b60c",
                                "text": "La pauvreté de cette population peut l’avoir poussé à se bouddhiser lentement, pour être reconnue par les Khmers dominants."
                            },
                            {
                                "example_id": "1a334cd5-7c26-40d1-9b7d-ec7bbcedb518",
                                "sense_id": "352cb951-6a02-3d6e-afa8-dabfc352b60c",
                                "text": "Ce processus serait né de la non-intégration des Tamouls des hauts plateaux, récemment importés (XIXᵉ-XXᵉ EC) par les Britanniques dans la région de Kandy (Centre-Sud) pour travailler dans les plantations de thé, alors que les castes tamoules karâva et salâgama qui les y avaient précédés s’étaient intégrées, singhalisées et bouddhisées."
                            }
                        ]
                    }
                ],
