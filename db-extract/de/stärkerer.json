                ],
                "senses": [
                    {
                        "sense_id": "18779635-7a8a-35d4-b8e6-c5e348d701ab",
                        "entry_id": "4d07bcff-5b72-34a7-a7f5-d17bf1c76579",
                        "glosses": [
                            "(männliche^☆) Person, die mehr Kraft hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7851159-3af9-4dbf-8117-5e6db3559b79",
                                "sense_id": "18779635-7a8a-35d4-b8e6-c5e348d701ab",
                                "text": "„Ihr seid die Stärkeren. Ihr müßt ihnen vormachen, daß man ohne Lüge leben kann und ohne Feigheit.“"
                            },
                            {
                                "example_id": "25a303ca-e67f-44d5-80b8-3b5e6dc5c0af",
                                "sense_id": "18779635-7a8a-35d4-b8e6-c5e348d701ab",
                                "text": "„Niemand fühlt sich wohl in einem Klima, wo der Stärkere den Schwächeren unterdrückt, […].“"
                            },
                            {
                                "example_id": "695eec1f-1247-432d-af20-fb6577c9d49d",
                                "sense_id": "18779635-7a8a-35d4-b8e6-c5e348d701ab",
                                "text": "„Wir sind die Stärkeren. Wir haben dem Haß, in meinem Land wie in ganz Europa, einen mächtigen Bundesgenossen entgegenzusetzen, ein Licht, das sich nicht allein aus Vernunft speist, die auch ein großer Gegner von Haß sein kann.“"
                            },
                            {
                                "example_id": "f57e878d-8da1-47f9-8a61-d989438612d5",
                                "sense_id": "18779635-7a8a-35d4-b8e6-c5e348d701ab",
                                "text": "[Völkerrecht:] „Gegen das Recht des Stärkeren hilft nur die Stärke des Rechts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
