                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "49a2551e-4b74-3d07-b4a9-89bf5b5c18b1",
                        "entry_id": "62c969ce-831e-38a4-bceb-baf27d0c300f",
                        "glosses": [
                            "eine Maschine, die Verdichtungsarbeit, durch ihr Eigengewicht, unter sich selbst ausführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd3048b-5f3b-4116-a646-a0e20c7e92fb",
                                "sense_id": "49a2551e-4b74-3d07-b4a9-89bf5b5c18b1",
                                "text": "Die Verdichter rollen den ganzen Tag, damit endlich der Bitumen aufgebracht werden kann und die Straße fertig wird."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
