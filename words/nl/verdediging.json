{
    "word_family": [
        "verdedigen",
        "verdediger",
        "verdedigbaar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9875c066-42b9-35ae-a10b-5348531ba3d0",
                    "sense_definition": "De handeling van het beschermen van iemand of iets tegen een aanval, kritiek of gevaar.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aanval is soms de beste <w>verdediging</w>.",
                            "target_lang_translations": {
                                "ru": "Нападение иногда — лучшая <w>защита</w>.",
                                "en": "Attack is sometimes the best <w>defense</w>.",
                                "de": "Angriff ist manchmal die beste <w>Verteidigung</w>."
                            }
                        },
                        {
                            "text": "Hij schoot direct in de <w>verdediging</w> toen hij kritiek kreeg.",
                            "target_lang_translations": {
                                "ru": "Он сразу ушел в <w>оборону</w>, когда его раскритиковали.",
                                "en": "He immediately went on the <w>defensive</w> when he received criticism.",
                                "de": "Er ging sofort in die <w>Verteidigung</w>, als er Kritik erhielt."
                            }
                        }
                    ],
                    "synonyms": [
                        "defensie",
                        "bescherming"
                    ],
                    "common_phrases": [
                        "in de verdediging",
                        "de beste verdediging",
                        "uit zelfverdediging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по защите кого-либо или чего-либо от нападения, критики или опасности.",
                        "en": "The action of protecting someone or something against an attack, criticism, or danger.",
                        "de": "Die Handlung, jemanden oder etwas vor einem Angriff, vor Kritik oder Gefahr zu schützen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "активное сопротивление"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "defense",
                                "target_lang_sense_clarification": "protection against attack"
                            },
                            {
                                "target_lang_word": "defence",
                                "target_lang_sense_clarification": "UK spelling"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verteidigung",
                                "target_lang_sense_clarification": "allgemeine Abwehr von Angriffen oder Kritik"
                            },
                            {
                                "target_lang_word": "Schutz",
                                "target_lang_sense_clarification": "Sicherung vor Gefahr"
                            },
                            {
                                "target_lang_word": "Abwehr",
                                "target_lang_sense_clarification": "aktives Zurückweisen eines Angriffs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1fc4a5f-3cae-38b9-927f-a05086d4e26e",
                    "sense_definition": "De groep spelers of soldaten die de taak heeft om de tegenstander tegen te houden en het eigen doel of gebied te beschermen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_defenders",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verdediging</w> van deze ploeg is niet sterk genoeg voor de finale.",
                            "target_lang_translations": {
                                "ru": "<w>Защита</w> этой команды недостаточно сильна для финала.",
                                "en": "The <w>defense</w> of this team is not strong enough for the final.",
                                "de": "Die <w>Abwehr</w> dieser Mannschaft ist nicht stark genug für das Finale."
                            }
                        },
                        {
                            "text": "Onze <w>verdediging</w> hield stand tegen de vijandelijke troepen.",
                            "target_lang_translations": {
                                "ru": "Наша <w>оборона</w> выстояла против вражеских войск.",
                                "en": "Our <w>defense</w> held out against the enemy troops.",
                                "de": "Unsere <w>Verteidigung</w> hielt den feindlichen Truppen stand."
                            }
                        }
                    ],
                    "synonyms": [
                        "defensie"
                    ],
                    "antonyms": [
                        "agressie"
                    ],
                    "common_phrases": [
                        "een sterke verdediging",
                        "de verdediging organiseren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа игроков или солдат, чья задача — сдерживать противника и защищать свои ворота или территорию.",
                        "en": "The group of players or soldiers tasked with stopping the opponent and protecting their own goal or territory.",
                        "de": "Die Gruppe von Spielern oder Soldaten, die die Aufgabe hat, den Gegner aufzuhalten und das eigene Tor oder Territorium zu schützen."
                    },
                    "translations": {
                        "ru": [
