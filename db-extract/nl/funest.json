                "senses": [
                    {
                        "sense_id": "c19f0706-d5b9-3f64-9e8e-91d643865ee3",
                        "entry_id": "a9e0c8bd-fec3-32bf-9c17-3b508d00699e",
                        "glosses": [
                            "fataal, noodlottig, verderfelijk, rampzalig, desastreus, heilloos"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6977c91-df79-47fb-9a14-02c81ee4b749",
                        "source_entry_id": "a9e0c8bd-fec3-32bf-9c17-3b508d00699e",
                        "source_sense_id": "c19f0706-d5b9-3f64-9e8e-91d643865ee3",
                        "target_lang_word": "fatal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3b7968-e8cf-36bb-867a-827f5c28b27c",
                                        "entry_id": "487b20b4-c049-37df-a000-d96279a4ca18",
                                        "glosses": [
                                            "Proceeding from, or appointed by, fate or destiny."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fc16bef-5837-4631-a7dc-36ac7fd15443",
                                                "sense_id": "4a3b7968-e8cf-36bb-867a-827f5c28b27c",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16145ff-e6ce-3177-babe-4c4e3bd0f24d",
                                        "entry_id": "487b20b4-c049-37df-a000-d96279a4ca18",
                                        "glosses": [
                                            "Foreboding death or great disaster."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d6f7e1-8356-430d-ace3-132d891a21ef",
                                                "sense_id": "d16145ff-e6ce-3177-babe-4c4e3bd0f24d",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability: […] it is a black spot which all the soaps ever advertised could never wash off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9735129a-7efe-3f1b-8deb-1ece13a85c7a",
                                        "entry_id": "487b20b4-c049-37df-a000-d96279a4ca18",
                                        "glosses": [
                                            "Causing death or destruction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06c4c968-7a81-4473-8634-3e74ca754b11",
                                                "sense_id": "9735129a-7efe-3f1b-8deb-1ece13a85c7a",
                                                "text": "a fatal wound; a fatal disease; that fatal day; a fatal mistake"
                                            },
                                            {
                                                "example_id": "fe3fd9a5-3ef8-41c2-b425-ea5dc0226381",
                                                "sense_id": "9735129a-7efe-3f1b-8deb-1ece13a85c7a",
                                                "text": "Author Rita Mae Brown consistently strings together short comical movie clips which may be fine for screenplays but fatal in novels. Unfortunately, Toder chooses to imitate this model and her story suffers."
                                            },
                                            {
                                                "example_id": "3b757b55-6a4d-4119-a572-5ced1645f0d8",
                                                "sense_id": "9735129a-7efe-3f1b-8deb-1ece13a85c7a",
                                                "text": "I shoot Mrs. Marlow expertly through the neck. This is not a fatal wound. The bullet misses every artery. She is paralyzed before it leaves her body. Which doesn’t mean she can’t feel pain. It just means she can’t do anything about it. This is my design."
                                            },
                                            {
                                                "example_id": "49de0eb2-3ddc-42e4-8b8e-b7654b153a7c",
                                                "sense_id": "9735129a-7efe-3f1b-8deb-1ece13a85c7a",
                                                "text": "Surprisingly, this analysis revealed that acute exposure to solvent vapors at concentrations below those associated with long-term effects appears to increase the risk of a fatal automobile accident. Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, another solvent, which has the well-known property of causing this type of cancer."
                                            },
                                            {
                                                "example_id": "baf0830c-dce1-46bd-80f2-78ee4122923f",
                                                "sense_id": "9735129a-7efe-3f1b-8deb-1ece13a85c7a",
                                                "text": "For this reason, the US Centers for Disease Control and Prevention recommends that spinach be cooked at 160º for 15 seconds, which kills potentially fatal bacteria."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2296dc3f-bdf3-37c2-bdc4-527be9a79b8b",
                                        "entry_id": "487b20b4-c049-37df-a000-d96279a4ca18",
                                        "glosses": [
                                            "Causing a sudden end to the running of a program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb1df82-a156-4df3-b08c-fbe3b34320ed",
                                                "sense_id": "2296dc3f-bdf3-37c2-bdc4-527be9a79b8b",
                                                "text": "a fatal error; a fatal exception"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fatal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7515c0f2-683b-3cc7-ad98-0afc280b3757",
                                        "entry_id": "d3a6c101-5159-333e-8581-085bdccc5f9d",
                                        "glosses": [
                                            "A fatality; an event that leads to death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e7df58b-de56-4972-8848-91b7689ac204",
                                                "sense_id": "7515c0f2-683b-3cc7-ad98-0afc280b3757",
                                                "text": "For this same period there have been four fatals and 44 nonfatals in gassy mines."
                                            },
                                            {
                                                "example_id": "91e776ea-94c9-407f-bdbe-01badd84a8e7",
                                                "sense_id": "7515c0f2-683b-3cc7-ad98-0afc280b3757",
                                                "text": "The best accident rate in general aviation is in corporate/executive flying at 0.17 per 100000 hours for fatals and .50 for total accidents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06a07911-36c1-36b5-8be4-09eba2c65908",
                                        "entry_id": "d3a6c101-5159-333e-8581-085bdccc5f9d",
                                        "glosses": [
                                            "A fatal error; a failure that causes a program to terminate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25fc7581-81de-45be-a83e-95348f3c290a",
                        "source_entry_id": "a9e0c8bd-fec3-32bf-9c17-3b508d00699e",
                        "source_sense_id": "c19f0706-d5b9-3f64-9e8e-91d643865ee3",
                        "target_lang_word": "ill-fated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ill-fated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                        "entry_id": "4159365e-effe-358b-be93-7a83c60a7c72",
                                        "glosses": [
                                            "unlucky; doomed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d7cb49-d1e6-4489-8434-e979ad5ccacb",
                                                "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                                "text": "My grandfather was originally scheduled to travel on the ill-fated last voyage of the RMS Lusitania, but thankfully had to change his plans at the last minute."
                                            },
                                            {
                                                "example_id": "b76a3878-27f9-4c3d-bc2b-bb2a86080e12",
                                                "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                                "text": "The engine of the ill-fated mail was Stephenson, one of Whale's 4-6-0 \"Experiment\" class, which fact led to sensational outcryings in the daily papers about the scandal of \"experimental machines\" being used on fast trains!"
                                            },
                                            {
                                                "example_id": "2fbebe8e-9b83-462c-a970-0fb550ba5737",
                                                "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                                "text": "In February 1927, eight short months before minstrel Al Jolson sang “My Mammy” to enthralled moviegoers who had never before heard pictures talk, the ill-fated silent movie industry had itself one last fling: Paramount Pictures' romantic comedy It, […]"
                                            },
                                            {
                                                "example_id": "6f39ecff-2134-4961-b22d-d466801d486f",
                                                "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                                "text": "Despite his ill-fated spell at Anfield, he received a warm reception from the same Liverpool fans he struggled to win over before being sacked midway through last season."
                                            },
                                            {
                                                "example_id": "adb09e41-808b-4ce7-9ced-4cc0c298ffb4",
                                                "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                                "text": "With Christie's words about \"all-talk-no-action\" in mind, notice that Obama and his two secretaries of state, Hillary Clinton and John Kerry, as well as his vice president, Joe Biden, were all senators, the last two serving for two or three decades, respectively. Not forgetting the ill-fated secretary of defense, Senator Chuck Hagel."
                                            },
                                            {
                                                "example_id": "838c5fc7-7e6b-4140-a1fa-29bd4fbe160f",
                                                "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                                "text": "Yingluck is facing a possible 10-year prison term on charges of negligence linked to an ill-fated rice subsidy programme that cost the state billions of dollars."
                                            },
                                            {
                                                "example_id": "d3f7203c-7aa5-4cf2-a434-5df984fc3bc1",
                                                "sense_id": "f5f1e9fa-c25b-3cb8-9cbc-d1808e89e354",
                                                "text": "There is a broad-gauge transfer shed, lengths of running track with reconstructed stations, and a bit of Brunel's ill-fated atmospheric railway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48f5bbf9-87fc-4c6a-91ad-50d2444b3151",
                        "source_entry_id": "a9e0c8bd-fec3-32bf-9c17-3b508d00699e",
                        "source_sense_id": "c19f0706-d5b9-3f64-9e8e-91d643865ee3",
                        "target_lang_word": "funeste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funeste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d20ad4-1804-3519-9979-9d85fae2e5d6",
                                        "entry_id": "6298cc45-35b0-3c65-bbfc-76aea2773fd7",
                                        "glosses": [
                                            "Qui cause le malheur, la perte ou la destruction, la désolation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ab3669-09e5-47dd-9c0d-7bbf54b02581",
                                                "sense_id": "e5d20ad4-1804-3519-9979-9d85fae2e5d6",
                                                "text": "Votre amour à ce prix n’est qu’un présent funeste\nQui porte à votre amant sa perte manifeste."
                                            },
                                            {
                                                "example_id": "64b6bb83-2a5e-460d-a525-65ef9af6cfae",
                                                "sense_id": "e5d20ad4-1804-3519-9979-9d85fae2e5d6",
                                                "text": "Entre un mauvais et un bon Économiste, voici toute la différence : l’un s’en tient à l’effet visible ; l’autre tient compte et de l’effet qu’on voit et de ceux qu’il faut prévoir.\nMais cette différence est énorme, car il arrive presque toujours que, lorsque la conséquence immédiate est favorable, les conséquences ultérieures sont funestes, et vice versa."
                                            },
                                            {
                                                "example_id": "b8af4fdc-a096-4771-84bd-1c3c36737df8",
                                                "sense_id": "e5d20ad4-1804-3519-9979-9d85fae2e5d6",
                                                "text": "Tout ce qui a été dit, […], sur les conséquences funestes des lois successorales imposées par le code Napoléon s'applique exactement à cette autre portion du pays gascon …."
                                            },
                                            {
                                                "example_id": "34296b1b-030e-4d56-a318-d9d35c939941",
                                                "sense_id": "e5d20ad4-1804-3519-9979-9d85fae2e5d6",
                                                "text": "Le travail lui-même est nuisible et funeste non seulement dans les conditions présentes, mais en général, dans la mesure où son but est le simple accroissement de la richesse."
                                            },
                                            {
                                                "example_id": "ce7cb982-3059-4775-8fb3-120d3d4effad",
                                                "sense_id": "e5d20ad4-1804-3519-9979-9d85fae2e5d6",
                                                "text": "Avec lui aussi disparaît l’inventeur de cette politique desséchante et funeste de l’opportunisme, qu'il appelait la politique de la sagesse et de la raison, qu'il considérait comme la politique des résultats et qui allait devenir, avec les Jules Ferry, les Rouvier, les Constans, les Méline, une politique de stagnation, d'impuissance, d'opposition à tout progrès démocratique et à toute réforme sociale […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5d0c9e-4519-3286-b423-36f7ec559b18",
                                        "entry_id": "6298cc45-35b0-3c65-bbfc-76aea2773fd7",
                                        "glosses": [
                                            "Qui cause la mort."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2531a2ab-f167-413a-b366-28bd3e6613c2",
                                                "sense_id": "8c5d0c9e-4519-3286-b423-36f7ec559b18",
                                                "text": "Il a encore cette acception dans la locution porter, recevoir le coup funeste."
                                            }
                                        ]
                                    }
                                ]
                            },
