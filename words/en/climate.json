    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94ff21f0-942f-377c-82ca-b9e423fa641a",
                    "sense_definition": "The regular pattern of weather conditions in a particular area over a long period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_environment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>climate</w> in this part of the country is generally warm and sunny.",
                            "target_lang_translations": {
                                "ru": "<w>Климат</w> в этой части страны, как правило, тёплый и солнечный.",
                                "zh": "该国这一地区的<w>气候</w>通常温暖且阳光充足。"
                            }
                        },
                        {
                            "text": "Scientists are working hard to understand the long-term effects of <w>climate</w> change.",
                            "target_lang_translations": {
                                "ru": "Учёные усердно работают, чтобы понять долгосрочные последствия изменения <w>климата</w>.",
                                "zh": "科学家们正在努力研究<w>气候</w>变化的长期影响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weather conditions"
                    ],
                    "common_phrases": [
                        "climate change",
                        "tropical climate",
                        "mild climate",
                        "dry climate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для данной местности режим погоды, устанавливающийся за длительный период времени.",
                        "zh": "指某一地区在长时期内所呈现的规律性天气状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "климат",
                                "target_lang_sense_clarification": "погодные условия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气候",
                                "target_lang_sense_clarification": "指长期的天气状况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00382762-af24-36f1-a13f-032044867e0f",
                    "sense_definition": "The general situation, mood, or attitude regarding a particular subject or at a particular time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to start a new business in the current economic <w>climate</w>.",
                            "target_lang_translations": {
                                "ru": "Трудно начинать новый бизнес в нынешнем экономическом <w>климате</w>.",
                                "zh": "在当前的经济<w>环境</w>下，创业十分困难。"
                            }
                        },
                        {
                            "text": "The political <w>climate</w> has become very tense in recent weeks.",
                            "target_lang_translations": {
                                "ru": "Политический <w>климат</w> стал очень напряжённым в последние недели.",
                                "zh": "近几周的政治<w>氛围</w>变得非常紧张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "atmosphere",
                        "mood",
                        "environment",
                        "situation"
                    ],
                    "common_phrases": [
