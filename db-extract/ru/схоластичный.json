                                            {
                                                "example_id": "bc73bb3a-f8d0-4a34-94bd-303b1742aafe",
                                                "sense_id": "73001914-7fb1-39ab-a1d1-ffeeabb41f74",
                                                "text": "„Was die Art und Weise angeht, so sollte in humanistischer Weise “zur Erbauung des Volkes (para la edificación del pueblo)” gepredigt werden und nicht in scholastischer Weise, d.h. nicht spekulativ und allzu argumentativ […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
