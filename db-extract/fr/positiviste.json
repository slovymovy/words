        "fr-extract.jsonl": [
            {
                "entry_id": "7b761d5d-ba6b-38a7-a5e8-f952a8c3d9ad",
                "word": "positiviste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63f8123c-e6df-4b8f-8b51-1ad6540ffb54",
                        "entry_id": "7b761d5d-ba6b-38a7-a5e8-f952a8c3d9ad",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "positivistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57325e4e-4d5b-3d54-8df8-ab1e51255235",
                        "entry_id": "7b761d5d-ba6b-38a7-a5e8-f952a8c3d9ad",
                        "glosses": [
                            "Relatif à la doctrine d’Auguste Comte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9b2e45-4263-4949-a5fa-5bb21a0444ab",
                                "sense_id": "57325e4e-4d5b-3d54-8df8-ab1e51255235",
                                "text": "Le dogme, la morale, la politique positiviste."
                            },
                            {
                                "example_id": "8d52de38-9f0f-46f6-b2e3-62ee319d969c",
                                "sense_id": "57325e4e-4d5b-3d54-8df8-ab1e51255235",
                                "text": "Plus tard, venu à Paris comme petit professeur, passionné par l’étude, il s’était donné, de toute son intelligence, à Auguste Comte ; et c’était ainsi qu’on aurait retrouvé chez lui, sous le positiviste fervent, l’ancien proudhonien, sa révolte personnelle de pauvre, en haine de la misère."
                            },
                            {
                                "example_id": "6dfe6d94-bd65-425a-a183-55b837de5f3b",
                                "sense_id": "57325e4e-4d5b-3d54-8df8-ab1e51255235",
                                "text": "Ensuite, il faut se débarrasser de cette culture positiviste qui considère la technique comme « neutre » et moralement soumise au seul usage qui en sera fait par l’utilisateur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6251a1b2-c753-3f9b-88b8-201dc65164a2",
                "word": "positiviste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "34f250ea-0e40-45c7-9157-b68b8aaf824e",
                        "entry_id": "6251a1b2-c753-3f9b-88b8-201dc65164a2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "positivistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a3e3c0a-a97a-3dbc-9673-3f2809d0dc2c",
                        "entry_id": "6251a1b2-c753-3f9b-88b8-201dc65164a2",
                        "glosses": [
                            "Adepte du positivisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba056166-e545-45b8-97bd-a115b3bc690b",
                                "sense_id": "8a3e3c0a-a97a-3dbc-9673-3f2809d0dc2c",
                                "text": "En sciences humaines, un positiviste sera donc celui qui valorise ou adopte le modèle de la science positive."
                            },
                            {
                                "example_id": "d87db2c9-f063-4ed6-86e4-dac0dbdd8e27",
                                "sense_id": "8a3e3c0a-a97a-3dbc-9673-3f2809d0dc2c",
                                "text": "Les positivistes, qui représentent, à un degré éminent, la médiocrité, l’orgueil et le pédantisme, avaient décrété que la philosophie devait disparaître devant leur science ; mais la philosophie n’est point morte et elle s’est réveillée avec éclat."
                            },
                            {
                                "example_id": "e8a07772-a0f5-41cd-833d-3e3388e3a980",
                                "sense_id": "8a3e3c0a-a97a-3dbc-9673-3f2809d0dc2c",
                                "text": "Tchekhov est un homme de science, médecin de profession, mais cela n'en fait pas pour autant un positiviste convaincu que le bonheur de l'humanité réside dans la seule science."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
