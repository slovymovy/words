                "senses": [
                    {
                        "sense_id": "4e913a81-39db-361e-a1d5-fb33e6d815df",
                        "entry_id": "8e92fad5-1c3c-3f32-a58b-972783f5736d",
                        "glosses": [
                            "Sombrer."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "7f931570-0536-4d2b-ac2f-1effa040ed77",
                                "sense_id": "4e913a81-39db-361e-a1d5-fb33e6d815df",
                                "text": "Que pour un capitaine de vaisseau qui doit « fluctuer sans mergiturer », surmonter la crise et faire oublier « l’éradiqueur de racaille », prendre en exemple un type qui ne parvient pas à ses fins, ce n’est pas très malin !"
                            },
                            {
                                "example_id": "e62c49a7-64bb-4ce1-8cc0-f21b64131cc5",
                                "sense_id": "4e913a81-39db-361e-a1d5-fb33e6d815df",
                                "text": "Oscillations correspondantes des courbes qui fluctuent sans mergiturer, de bien agréable manière."
                            },
                            {
                                "example_id": "60cd9af1-19db-4b62-829d-de64e5c25d60",
                                "sense_id": "4e913a81-39db-361e-a1d5-fb33e6d815df",
                                "text": "Les huiles (du classement) fluctuatent sans mergiturer sur un océan plat de chez raplaplat."
                            }
                        ]
                    }
