                        "glosses": [
                            "Plante dont la fleur s’épanouit en fin de matinée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c42852c-a4c1-4ada-a398-a39a52a3a6c4",
                                "sense_id": "ae9de7e0-fa26-3e9c-8b4d-36de7bb3f0e6",
                                "text": "On ne retrouvait la bête qu’en fin de matinée, ponctuelle comme une dame-d’onze-heures."
                            },
                            {
                                "example_id": "5b1eaf89-8fad-48ef-ab05-6bf1de0384c6",
                                "sense_id": "ae9de7e0-fa26-3e9c-8b4d-36de7bb3f0e6",
                                "text": "« Le monde commence d’exister quand on le nomme. Et la dame-d’onze-heures, fleur lève-tard et discrète… »"
                            }
                        ]
                    }
