                        "entry_id": "f0524df7-c4af-3e92-905b-8ed06c4d3f8b",
                        "glosses": [
                            "Unwohlsein oder ernsthafte Erkrankung, hervorgerufen durch verdorbene Lebensmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79b851e9-b7f9-4a6a-bbdf-115ab3a1d6e1",
                                "sense_id": "e1940afa-695b-38f3-b109-70030c7517b9",
                                "text": "Ich glaube, meine Übelkeit gestern kam von einer Lebensmittelvergiftung."
                            },
                            {
                                "example_id": "a25a1f87-df03-4394-b894-520d7165a8f3",
                                "sense_id": "e1940afa-695b-38f3-b109-70030c7517b9",
                                "text": "„Louis Armstrong, das Idol ihrer Kindheit, steht mit ihr auf dem Programm der Show, aber eine Lebensmittelvergiftung zwingt Billie, den Job aufzugeben.“"
                            },
                            {
                                "example_id": "92b89536-aa8b-44ca-942e-e14efa5f8f93",
                                "sense_id": "e1940afa-695b-38f3-b109-70030c7517b9",
                                "text": "„Gräuliches Fleisch ist oft verdorben und führt zu einer Lebensmittelvergiftung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
