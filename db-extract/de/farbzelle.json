                "senses": [
                    {
                        "sense_id": "a019b622-ce52-3e19-86e6-084c383c6963",
                        "entry_id": "2f9b3da2-4733-3e70-b770-8b83a6b9b4c1",
                        "glosses": [
                            "pigmentierte Zelle von Gewebetieren, die meistens oberflächennah im Körper liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d75522-e421-4557-8895-f412813c8523",
                                "sense_id": "a019b622-ce52-3e19-86e6-084c383c6963",
                                "text": "„Das bedeutet, dass eine Farbzelle dann reagiert, wenn der entsprechende Reiz eintrifft.“"
                            },
                            {
                                "example_id": "1d209882-65c8-4ab4-b966-35ea79209b95",
                                "sense_id": "a019b622-ce52-3e19-86e6-084c383c6963",
                                "text": "„In ihrer Haut befinden sich dazu tausende kugelförmige Chromatophoren, melaningefüllte Farbzellen, die je nach Spezies Gelb, Orange, Rosa, Rot, Braun, Violett oder Schwarz sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
