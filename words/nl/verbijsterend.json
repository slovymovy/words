    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a4156734-46b9-39f9-b0ce-ebeaec951e93",
                    "sense_definition": "zo verrassend of onbegrijpelijk dat men er sprakeloos van wordt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verrassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vond het <w>verbijsterend</w> om te horen hoeveel indruk de trail destijds op deze man had gemaakt.",
                            "target_lang_translations": {
                                "en": "I found it <w>staggering</w> to hear how much of an impression the trail had made on this man at the time."
                            }
                        },
                        {
                            "text": "Het was een <w>verbijsterend</w> resultaat waar niemand van de aanwezigen op had gerekend.",
                            "target_lang_translations": {
                                "en": "It was a <w>bewildering</w> result that none of those present had counted on."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbazingwekkend",
                        "onthutsend",
                        "verbluffend",
                        "ontstellend"
                    ],
                    "antonyms": [
                        "voorspelbaar",
                        "begrijpelijk"
                    ],
                    "common_phrases": [
                        "verbijsterend resultaat",
                        "verbijsterend nieuws"
                    ],
                    "target_lang_definitions": {
                        "en": "so surprising or incomprehensible that it leaves one speechless"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "staggering",
                                "target_lang_sense_clarification": "overwhelmingly shocking or surprising"
                            },
                            {
                                "target_lang_word": "bewildering",
                                "target_lang_sense_clarification": "confusing or very difficult to understand"
                            },
                            {
                                "target_lang_word": "astounding",
                                "target_lang_sense_clarification": "surprisingly impressive or notable"
                            },
                            {
                                "target_lang_word": "mind-boggling",
                                "target_lang_sense_clarification": "overwhelming the mind; intellectually staggering"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ea2baaa-7992-338f-b277-06fb2a1eed74",
                    "sense_definition": "onvoltooid deelwoord van <w>verbijsteren</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De goochelaar verliet het podium, het publiek volledig <w>verbijsterend</w> met zijn laatste truc.",
                            "target_lang_translations": {
                                "en": "The magician left the stage, completely <w>bewildering</w> the audience with his final trick."
                            }
                        },
                        {
                            "text": "Door iedereen <w>verbijsterend</w> achter te laten, bewees hij zijn punt op een krachtige manier.",
                            "target_lang_translations": {
                                "en": "By leaving everyone <w>stunned</w>, he proved his point in a powerful way."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordig deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of 'verbijsteren' (to bewilder/stun)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bewildering",
                                "target_lang_sense_clarification": "causing someone to become perplexed"
                            },
                            {
                                "target_lang_word": "stunning",
                                "target_lang_sense_clarification": "shocking or amazing someone into silence"
                            },
                            {
                                "target_lang_word": "baffling",
                                "target_lang_sense_clarification": "totally confusing or perplexing someone"
                            }
                        ]
                    }
                }
            ]
        }
