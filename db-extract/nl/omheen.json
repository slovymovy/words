                                    },
                                    {
                                        "sense_id": "0d0c5307-f1b3-3982-aeaf-7033bc374ba2",
                                        "entry_id": "6cc3f8a9-1d7e-3237-bece-5af0ea4401b2",
                                        "glosses": [
                                            "umgangssprachlich, Circa-Angabe: ungefähr zu einem Zeitpunkt oder zu einer Größenangabe"
