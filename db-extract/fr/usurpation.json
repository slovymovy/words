                        ]
                    },
                    {
                        "translation_id": "71c4b9db-9ddd-4bc8-ab1d-b8cb410df22c",
                        "source_entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                        "target_lang_word": "usurpation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usurpation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eed4ccf6-4b70-3ec6-9c51-52a95a58e879",
                                        "entry_id": "f93ecd4e-dffb-3692-8cb3-003b179406ee",
                                        "glosses": [
                                            "The wrongful seizure of something by force, especially of sovereignty or other authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e061c455-152a-4b81-8a37-7982cf01cc5e",
                                                "sense_id": "eed4ccf6-4b70-3ec6-9c51-52a95a58e879",
                                                "text": "The third part of practice hath divers branches, but one principal root in these our times, which is the vast and overspreading ambition and usurpation of the see of Rome; […]"
                                            },
