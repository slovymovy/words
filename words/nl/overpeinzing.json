    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f1586a7-edc1-3478-986c-6e115009e22f",
                    "sense_definition": "Het diep, ernstig en langdurig nadenken over een bepaald onderwerp.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "nadenken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na uren van stille <w>overpeinzing</w> kwam hij eindelijk tot een belangrijk besluit.",
                            "target_lang_translations": {
                                "en": "After hours of silent <w>contemplation</w>, he finally reached an important decision."
                            }
                        },
                        {
                            "text": "Zijn diepe <w>overpeinzing</w> werd plotseling verstoord door het harde geluid van een dichtslaande deur.",
                            "target_lang_translations": {
                                "en": "His deep <w>pondering</w> was suddenly disturbed by the loud sound of a slamming door."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezinning",
                        "contemplatie",
                        "gepeins",
                        "meditatie",
                        "overdenking",
                        "reflectie"
                    ],
                    "common_phrases": [
                        "diepe overpeinzing",
                        "uren van overpeinzing"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of deep, serious, and prolonged thinking about a particular subject."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contemplation",
                                "target_lang_sense_clarification": "the state of thinking deeply about something"
                            },
                            {
                                "target_lang_word": "reflection",
                                "target_lang_sense_clarification": "serious thought or consideration"
                            },
                            {
                                "target_lang_word": "pondering",
                                "target_lang_sense_clarification": "the act of thinking carefully about something"
                            },
                            {
                                "target_lang_word": "meditation",
                                "target_lang_sense_clarification": "deep focus or spiritual contemplation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a453b5f-57fa-35fe-9992-0e10cefca6ea",
                    "sense_definition": "De gedachte of beschouwing die het resultaat is van het nadenken.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedachte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij schreef haar persoonlijke <w>overpeinzingen</w> dagelijks op in een klein leren dagboek.",
                            "target_lang_translations": {
                                "en": "She wrote down her personal <w>musings</w> daily in a small leather diary."
                            }
                        },
                        {
                            "text": "Het boek staat vol met filosofische <w>overpeinzingen</w> over de zin van het menselijk bestaan.",
                            "target_lang_translations": {
                                "en": "The book is full of philosophical <w>reflections</w> on the meaning of human existence."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedenking",
                        "beschouwing",
                        "bespiegeling",
                        "gedachte",
                        "mijmerij",
                        "overweging"
                    ],
                    "common_phrases": [
                        "persoonlijke overpeinzingen",
                        "filosofische overpeinzingen"
                    ],
                    "target_lang_definitions": {
                        "en": "The thought, reflection, or consideration that results from thinking deeply."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "musings",
                                "target_lang_sense_clarification": "thoughts or reflections, often expressed in writing"
                            },
                            {
                                "target_lang_word": "reflections",
                                "target_lang_sense_clarification": "thoughts or opinions that come from reflection"
                            },
                            {
                                "target_lang_word": "thoughts",
                                "target_lang_sense_clarification": "ideas or opinions produced by thinking"
                            },
                            {
                                "target_lang_word": "ponderings",
                                "target_lang_sense_clarification": "careful thoughts or considerations"
                            }
                        ]
                    }
                }
            ]
