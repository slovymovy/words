                    },
                    {
                        "translation_id": "46bb14f6-243f-48ce-8dd1-1addb3b0c0e7",
                        "source_entry_id": "30d4e0bd-0f01-3ef5-8602-c8abb853bf6e",
                        "source_sense_id": "20d3c32d-66e7-3516-9a49-b9bae60dcc78",
                        "target_lang_word": "désertion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désertion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                        "entry_id": "8c1aceb2-530d-3d19-b3d8-3ae616d73092",
                                        "glosses": [
                                            "Action de déserter ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "039988a4-bf49-44f6-9206-eae3be1e3526",
                                                "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                                "text": "Son trésor est vide. Son armée, mal recrutée, mal équipée, mal disciplinée, absolument démoralisée par ses défaites récentes, est réduite à fort peu de chose par les licenciements forcés et les désertions."
                                            },
                                            {
                                                "example_id": "0f3a0ff8-a54f-4b37-b7ec-e8d2e0681916",
                                                "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                                "text": "Il faut donc trouver un argument-massue, un argument capable de semer le doute dans l’âme des ouvriers, d’ébranler leur confiance, d’amener des défections de plus en plus nombreuses, puis des désertions massives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcf13c5c-6250-466d-a3a2-dd2137dd52e0",
                        "source_entry_id": "30d4e0bd-0f01-3ef5-8602-c8abb853bf6e",
