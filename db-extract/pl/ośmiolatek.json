                        "translation_id": "d1512cb9-c93d-425f-bd1c-479e4aafffa5",
                        "source_entry_id": "95077901-6a63-3122-bc2d-e6788040b859",
                        "source_sense_id": "9f3283a5-2be6-3d31-baa7-f61e15c8bc7a",
                        "target_lang_word": "Achtjähriger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achtjähriger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2581e3d-d723-37d8-9b12-62012d3d6185",
                                        "entry_id": "9517f267-edcb-33e1-adf8-18b621c8cbdf",
                                        "glosses": [
                                            "ein Junge von acht Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50d372ee-570c-415b-ba39-182046009914",
                                                "sense_id": "d2581e3d-d723-37d8-9b12-62012d3d6185",
                                                "text": "„Er erinnere sich gut, sagt Peter Schneirla, wie er mit seiner Mutter das erste Mal Tiffany besuchte, an ihrer Hand durch die Tür kam, aus der Perspektive des Achtjährigen diese Halle sah.“"
                                            },
                                            {
                                                "example_id": "dd30a89a-c4ea-4b87-8010-bda9b6abe8a5",
                                                "sense_id": "d2581e3d-d723-37d8-9b12-62012d3d6185",
                                                "text": "„In nur wenigen Monaten des Sommeraufenthalts in Lausanne trichtert die Mutter nun in täglichen Unterrichtsstunden dem Achtjährigen eine weitere Fremdsprache ein.“"
                                            },
                                            {
                                                "example_id": "9372cc6d-cdbc-4b7e-8246-5501b52e8336",
                                                "sense_id": "d2581e3d-d723-37d8-9b12-62012d3d6185",
                                                "text": "„War ich beim ersten Gang durch die Stadt in meinen Englischkenntnissen etwa fünf bis sechs Jahre alt gewesen, so war ich eine Woche später bereits auf der Stude eines Achtjährigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
