                "forms": [],
                "senses": [
                    {
                        "sense_id": "77d00aff-63a9-3bde-8c80-2b4f2c7b06d3",
                        "entry_id": "bdb3c08f-8cbc-33ec-a3cc-0c1da038e71f",
                        "glosses": [
                            "Microscope électronique à balayage."
                        ],
                        "tags": [
                            "Acronyme"
                        ],
                        "examples": [
                            {
                                "example_id": "3c0919d4-3aa9-46f2-a99a-7bbb68cb3583",
                                "sense_id": "77d00aff-63a9-3bde-8c80-2b4f2c7b06d3",
                                "text": "Par la suite, c’est le scientifique allemand Manfred von Ardenne qui, en 1938, a construit le premier microscope électronique à balayage. Mais cet appareil ne ressemblait pas encore aux MEB modernes car il avait été créé pour étudier des échantillons très fins en transmission."
                            }
                        ]
                    }
                ],
