                "senses": [
                    {
                        "sense_id": "f71dca0b-8b04-325e-9591-e083f2158571",
                        "entry_id": "e8f40209-f67a-3070-9e76-8522571c46c3",
                        "glosses": [
                            "To make unreal; to idealize."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "095b4c1b-e60e-4d36-b3cb-3d022050eb4c",
                                "sense_id": "f71dca0b-8b04-325e-9591-e083f2158571",
                                "text": "His fancy, habitually moving about in worlds not realized, unrealizes everything at a touch."
                            },
                            {
                                "example_id": "15f8de9b-eea1-42b2-aa2f-89590a3203be",
                                "sense_id": "f71dca0b-8b04-325e-9591-e083f2158571",
                                "text": "But De Quincey generally sees a much deeper technical significance, an idealizing or unrealizing effect in the language."
                            },
                            {
                                "example_id": "d3ae6129-007f-4f7a-a329-8edc60046b2b",
                                "sense_id": "f71dca0b-8b04-325e-9591-e083f2158571",
                                "text": "Every action that realizes a dream or desire unrealizes it in reality."
                            }
                        ]
                    },
                    {
                        "sense_id": "f73fc97f-481a-32c2-9be4-4333e32326f4",
                        "entry_id": "e8f40209-f67a-3070-9e76-8522571c46c3",
                        "glosses": [
                            "To alter one's own viewpoint after a previous realization; to change one's mind."
                        ],
                        "tags": [
                            "nonce-word"
                        ],
                        "examples": [
                            {
                                "example_id": "4e5d6f0f-46b9-4f78-8f77-20d98ff7ba72",
                                "sense_id": "f73fc97f-481a-32c2-9be4-4333e32326f4",
                                "text": "I easily realized that all of his statements were wrong. How do you unrealize that?"
                            }
                        ]
                    }
