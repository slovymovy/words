                                    {
                                        "sense_id": "9fab7192-2bc2-3cca-9d4d-e28903896c78",
                                        "entry_id": "5e702a8b-79b3-322b-9868-aad7683a5295",
                                        "glosses": [
                                            "A collection of related websites which are interlinked in a circular structure, each site having links to the previous and next site in the ring."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb490e6-effe-49c3-b591-c816196c6537",
                                                "sense_id": "9fab7192-2bc2-3cca-9d4d-e28903896c78",
                                                "text": "The site had the look of an old Geocities^([sic]) page. Black background, ASCII art, novelty GIFs, visitor counters. There’s a link to the “badday webring” and an audio-only file of the video."
                                            },
                                            {
                                                "example_id": "1a40545e-59d3-4d78-a7c4-2e2b773a219d",
                                                "sense_id": "9fab7192-2bc2-3cca-9d4d-e28903896c78",
                                                "text": "Each of the member websites in a webring had a navigation area at the bottom of the page that had “next” and “previous” buttons directing surfers to other sites in the ring."
                                            }
                                        ]
                                    }
                                ]
                            }
