                "senses": [
                    {
                        "sense_id": "1f1879fa-495b-3f2b-ae03-ecbfa887dea0",
                        "entry_id": "2c432187-faf5-3b46-a09c-9a90b64fbd57",
                        "glosses": [
                            "parting (of hair)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fef14ea-1481-447f-a235-43f91f684654",
                                "sense_id": "1f1879fa-495b-3f2b-ae03-ecbfa887dea0",
                                "text": "прямо́й пробо́р",
                                "translation": "parting in the middle",
                                "english": "parting in the middle"
                            },
                            {
                                "example_id": "7d8d4b68-96d5-4135-9d3d-91d733a7bbdf",
                                "sense_id": "1f1879fa-495b-3f2b-ae03-ecbfa887dea0",
                                "text": "Он но́сит во́лосы на прямо́й (косо́й) пробо́р.",
                                "translation": "His hair is parted in the middle (at one side).",
                                "english": "His hair is parted in the middle (at one side)."
                            },
                            {
                                "example_id": "6a44e929-f30c-4c8c-a7f7-6c31c284543e",
                                "sense_id": "1f1879fa-495b-3f2b-ae03-ecbfa887dea0",
                                "text": "сде́лать (себе́) пробо́р",
                                "translation": "to part one's hair",
                                "english": "to part one's hair"
                            },
                            {
                                "example_id": "8e869338-f70a-4912-bf79-00cebb588a57",
                                "sense_id": "1f1879fa-495b-3f2b-ae03-ecbfa887dea0",
                                "text": "Она́ вспо́мнила безукори́зненные пробо́ры, с иго́лочки фре́нчи, сладкова́тый за́пах англи́йского тру́бочного табаку́.",
                                "translation": "Konstantin Vaginov",
                                "english": "Konstantin Vaginov"
                            }
                        ]
                    }
                ],
