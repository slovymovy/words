                                "target_senses": [
                                    {
                                        "sense_id": "b9151818-b98b-384a-89a8-ed85d0718c4e",
                                        "entry_id": "43d189bc-8fc1-3906-be68-83aba476df69",
                                        "glosses": [
                                            "Celui qui avait droit de justice en quelque lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56322ebf-7373-4dae-b76f-12103ed6d775",
                                                "sense_id": "b9151818-b98b-384a-89a8-ed85d0718c4e",
                                                "text": "Il en était seigneur justicier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "justicier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4798cd14-6371-31ae-a115-93b437ec6772",
                                        "entry_id": "2a945fc0-dcaa-39f0-9674-86aaf2bebe4f",
                                        "glosses": [
                                            "Celui qui aime à rendre, à faire justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7cb5a5f-659a-432b-9952-ee82049edb66",
                                                "sense_id": "4798cd14-6371-31ae-a115-93b437ec6772",
                                                "text": "Saint Louis était grand justicier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "584ee915-bdd1-398a-a13a-e244920c7bd7",
                                        "entry_id": "2a945fc0-dcaa-39f0-9674-86aaf2bebe4f",
                                        "glosses": [
                                            "Personne qui avait droit de justice en quelque lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b615b89f-528e-460c-9e4a-2b8cef74e901",
                                                "sense_id": "584ee915-bdd1-398a-a13a-e244920c7bd7",
                                                "text": "Haut justicier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40cf2960-c9a9-313b-83c7-4d767fb11b84",
                                        "entry_id": "2a945fc0-dcaa-39f0-9674-86aaf2bebe4f",
                                        "glosses": [
                                            "Celui qui s’octroie le droit de rendre la justice."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "881298af-0e42-4da4-bebe-60e174fedbef",
                                                "sense_id": "40cf2960-c9a9-313b-83c7-4d767fb11b84",
                                                "text": "Il agissait en justicier des siens."
                                            },
                                            {
                                                "example_id": "4f2ba88b-0d1e-4884-a0ea-ba98a040d75f",
                                                "sense_id": "40cf2960-c9a9-313b-83c7-4d767fb11b84",
                                                "text": "Il n’admet pas d’être jugé par les autres, il est son propre justicier."
                                            },
                                            {
                                                "example_id": "59dcc9ad-68e3-41b0-a508-364e793d0819",
                                                "sense_id": "40cf2960-c9a9-313b-83c7-4d767fb11b84",
                                                "text": "il se fit justicier, il rêva de se dresser, des Halles mêmes, pour écraser ce règne de mangeailles et de soûleries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "justicier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a77253fc-7ec5-3a4b-b542-bd07d3b2d2ba",
                                        "entry_id": "551d53cb-935c-3671-bb6d-553ef8bb1470",
                                        "glosses": [
                                            "Punir quelqu’un d’une peine en exécution d’une sentence ou d’un arrêt."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16031412-7008-490c-bbb7-3a8c046ad5e5",
                                                "sense_id": "a77253fc-7ec5-3a4b-b542-bd07d3b2d2ba",
                                                "text": "Je l’ai rencontré, après qu’il venait de faire justicier Veysset et de regarder le macchabée exécuter, du haut du Pont-Neuf, un plongeon dans la Seine."
                                            },
                                            {
                                                "example_id": "d51c1e21-c8ce-4e2a-9c92-654d317b794e",
                                                "sense_id": "a77253fc-7ec5-3a4b-b542-bd07d3b2d2ba",
                                                "text": "Lorsqu’un homme était justicié, lit-on dans le Grand Coutumier, le bourreau avait le droit à tout ce qui était au-dessus de la ceinture."
                                            },
                                            {
                                                "example_id": "0245775e-7453-43ba-a261-7eff45047a5b",
                                                "sense_id": "a77253fc-7ec5-3a4b-b542-bd07d3b2d2ba",
                                                "text": "Par ailleurs, les deux bourreaux, chargés de justicier le protagoniste sont seulement de vieux acteurs subalternes, donc artistes eux aussi, mais uniquement interprètes, pâles, gras et répugnants, incapables de répondre à aucune question."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
