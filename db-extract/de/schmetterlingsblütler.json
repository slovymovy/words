                        "glosses": [
                            "Unterfamilie der Hülsenfrüchtler mit dem wissenschaftlichen Namen Faboideae (veraltet: Papilionoideae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ccc7f0b-4ff4-4200-bcfa-8063649292a1",
                                "sense_id": "7be84560-c97a-3d47-878f-22a0d8c229fc",
                                "text": "Der Wiesenklee gehört zur Familie der Schmetterlingsblütler."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b8d0557d-ce54-30f8-a806-9b111e1e4226",
                        "entry_id": "fbc41d66-8922-33c3-b492-663861e9cb1b",
                        "glosses": [
                            "ein Vertreter von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f49611f-83f4-4e37-9f2d-5d414a29af6f",
                                "sense_id": "b8d0557d-ce54-30f8-a806-9b111e1e4226",
                                "text": "Die Blüten eines Schmetterlingsblütlers haben die Form eines Schmetterlings, daher der Name."
                            },
                            {
                                "example_id": "0c518ca6-4583-49b0-b9e5-03bb47d28346",
                                "sense_id": "b8d0557d-ce54-30f8-a806-9b111e1e4226",
                                "text": "Die von dem Chemiekonzern Monsanto manipulierten Schmetterlingsblütler enthalten das Gen eines Bodenbakteriums, das sie gegen den hauseigenen Unkrautvernichter Marke Roundup unempfindlich macht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
