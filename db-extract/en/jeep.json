                                        "sense_id": "e8357950-f880-3908-a8fa-e3ac8585798e",
                                        "entry_id": "bd573852-6895-39c2-938c-1ed9d99d00b7",
                                        "glosses": [
                                            "Véhicule tout-terrain à quatre roues motrices apparu durant la Seconde Guerre mondiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a728f51-02f1-4c64-968b-0ae3556b483e",
                                                "sense_id": "e8357950-f880-3908-a8fa-e3ac8585798e",
                                                "text": "Je traversai une cour encombrée de jeeps et de camions militaires et j'arrivai devant l'entrée du bâtiment inachevé."
                                            },
                                            {
                                                "example_id": "a2d91384-0664-4ed6-8b97-0e06e5197d13",
                                                "sense_id": "e8357950-f880-3908-a8fa-e3ac8585798e",
                                                "text": "Midi et demi... Le convoi roule, précédé de quelques jeeps..."
                                            },
                                            {
                                                "example_id": "16d754a6-307d-4ae3-b764-57b246aab1f1",
                                                "sense_id": "e8357950-f880-3908-a8fa-e3ac8585798e",
                                                "text": "C'est un beau petit jeep rouge qui grafigne sur les quatre roues et la caisse de transmission est défoncée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "429c35fd-1c47-44bf-87f4-b4a38b795168",
                        "source_entry_id": "b025f647-150e-395c-8e2a-35d4d064e129",
