                "senses": [
                    {
                        "sense_id": "3355fa13-ad80-3167-841f-fbf439b5b01a",
                        "entry_id": "d5c3e27b-88ee-3292-9471-44b831bc92c4",
                        "glosses": [
                            "Phase in einem komplexen Wettspiel, etwa einem Turnier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a405a7a4-06b0-481e-8be4-075a69b9d188",
                                "sense_id": "3355fa13-ad80-3167-841f-fbf439b5b01a",
                                "text": "„Nach einem Spieldurchgang tauschen Belagerer und Eingekesselte ihre Rollen.“"
                            },
                            {
                                "example_id": "069c2508-d471-45ff-99f2-54936e2f3167",
                                "sense_id": "3355fa13-ad80-3167-841f-fbf439b5b01a",
                                "text": "„Die Antwort darauf erhielten die Berliner bereits im ersten Spieldurchgang.“"
                            },
                            {
                                "example_id": "5acb9c2d-5bcb-44b7-a85e-502bff1c0337",
                                "sense_id": "3355fa13-ad80-3167-841f-fbf439b5b01a",
                                "text": "„Vor jedem Spieldurchgang muß das Schachtelunterteil kräftig geschüttelt werden, damit niemand mehr weiß, in welcher Mulde sich das Piepsding befindet.“"
                            },
                            {
                                "example_id": "ede060e3-f662-469e-a0b2-7152179c8f99",
                                "sense_id": "3355fa13-ad80-3167-841f-fbf439b5b01a",
                                "text": "„Allerdings wird eine Mehrzahl der Spieler sich darüber im Klaren sein, dass diese Vorstellungen sich gravierend von Spieler zu Spieler und von Spieldurchgang zu Spieldurchgang unterscheiden, […]."
                            },
                            {
                                "example_id": "a9ce1d33-d99f-49d8-a8b8-62d76bd20d9c",
                                "sense_id": "3355fa13-ad80-3167-841f-fbf439b5b01a",
                                "text": "„Praktisch bedeutet dies, dass ein Spieldurchgang mit diesen Karten im Schnitt etwa halb so lange dauert wie mit den Karten von 32xBerlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
