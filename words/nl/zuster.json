{
    "word_family": [
        "zusterlijk",
        "zusterschap"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f23d111a-ce53-3e6b-8997-b6e8c175c682",
                    "sense_definition": "Een vrouwelijk kind van dezelfde ouders.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>zuster</w> is twee jaar ouder dan ik.",
                            "target_lang_translations": {
                                "en": "My <w>sister</w> is two years older than me.",
                                "ru": "Моя <w>сестра</w> на два года старше меня.",
                                "fr": "Ma <w>sœur</w> a deux ans de plus que moi."
                            }
                        },
                        {
                            "text": "Ik ga morgen met mijn <w>zuster</w> winkelen in de stad.",
                            "target_lang_translations": {
                                "en": "I am going shopping in the city with my <w>sister</w> tomorrow.",
                                "ru": "Завтра я иду по магазинам в городе со своей <w>сестрой</w>.",
                                "fr": "Demain, je vais faire du shopping en ville avec ma <w>sœur</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zus"
                    ],
                    "antonyms": [
                        "broer"
                    ],
                    "common_phrases": [
                        "mijn oudste zuster",
                        "grote zuster"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "slightly formal compared to 'zus'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A female child of the same parents.",
                        "ru": "Дочь тех же родителей.",
                        "fr": "Enfant féminin des mêmes parents."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sister",
                                "target_lang_sense_clarification": "female sibling"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сестра",
                                "target_lang_sense_clarification": "родственница"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sœur",
                                "target_lang_sense_clarification": "membre de la famille"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bffcdac-61c9-3550-9987-4794825be8f6",
                    "sense_definition": "Een vrouw die als beroep zieken verzorgt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>zuster</w> bracht de patiënt zijn medicijnen.",
                            "target_lang_translations": {
                                "en": "The <w>nurse</w> brought the patient his medicine.",
                                "ru": "<w>Медсестра</w> принесла пациенту его лекарства.",
                                "fr": "L'<w>infirmière</w> a apporté ses médicaments au patient."
                            }
                        },
                        {
                            "text": "Als je pijn hebt, moet je de <w>zuster</w> roepen.",
                            "target_lang_translations": {
                                "en": "If you are in pain, you should call the <w>nurse</w>.",
                                "ru": "Если вам больно, нужно позвать <w>медсестру</w>.",
                                "fr": "Si tu as mal, tu dois appeler l'<w>infirmière</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verpleegster",
                        "ziekenzuster",
                        "ziekenverpleegster",
                        "verpleegkundige"
                    ],
                    "common_phrases": [
                        "de zuster roepen",
                        "dienstdoende zuster"
                    ],
                    "target_lang_definitions": {
                        "en": "A woman whose profession is caring for the sick.",
                        "ru": "Женщина, чья профессия — уход за больными.",
                        "fr": "Femme dont la profession est de soigner les malades."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nurse",
                                "target_lang_sense_clarification": "medical professional"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "медсестра",
                                "target_lang_sense_clarification": "медицинский работник"
                            },
                            {
                                "target_lang_word": "сестра",
                                "target_lang_sense_clarification": "медицинская сестра"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "infirmière",
                                "target_lang_sense_clarification": "professionnelle de santé"
                            },
                            {
                                "target_lang_word": "sœur",
                                "target_lang_sense_clarification": "infirmière en milieu religieux ou traditionnel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f004f13-5dab-30f6-b544-53185946de88",
                    "sense_definition": "Een vrouw die in een klooster leeft en haar leven aan de godsdienst wijdt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>zuster</w> liep rustig door de kloostertuin.",
                            "target_lang_translations": {
                                "en": "The <w>nun</w> walked quietly through the monastery garden.",
                                "ru": "<w>Монахиня</w> спокойно шла по монастырскому саду.",
                                "fr": "La <w>sœur</w> se promenait calmement dans le jardin du couvent."
                            }
                        },
                        {
                            "text": "Zij heeft besloten om <w>zuster</w> te worden en in armoede te leven.",
                            "target_lang_translations": {
                                "en": "She has decided to become a <w>nun</w> and live in poverty.",
                                "ru": "Она решила стать <w>монахиней</w> и жить в бедности.",
                                "fr": "Elle a décidé de devenir <w>religieuse</w> et de vivre dans la pauvreté."
                            }
                        }
                    ],
                    "synonyms": [
                        "non",
                        "kloosterlinge"
                    ],
                    "antonyms": [
                        "monnik",
                        "broeder"
                    ],
                    "common_phrases": [
                        "geestelijke zuster",
                        "zusters van liefde"
                    ],
                    "target_lang_definitions": {
                        "en": "A woman who lives in a convent and dedicates her life to religion.",
                        "ru": "Женщина, живущая в монастыре и посвятившая себя религии.",
                        "fr": "Femme qui vit dans un couvent et voue sa vie à la religion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nun",
                                "target_lang_sense_clarification": "member of a religious order"
                            },
                            {
                                "target_lang_word": "sister",
                                "target_lang_sense_clarification": "religious title"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "монахиня",
                                "target_lang_sense_clarification": "член религиозного ордена"
                            },
                            {
                                "target_lang_word": "сестра",
                                "target_lang_sense_clarification": "религиозное обращение"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sœur",
                                "target_lang_sense_clarification": "religieuse"
                            },
                            {
                                "target_lang_word": "bonne sœur",
                                "target_lang_sense_clarification": "religieuse (familier)"
                            },
                            {
                                "target_lang_word": "nonne",
                                "target_lang_sense_clarification": "religieuse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "080888df-f4d0-3fb4-a180-887af1679612",
                    "sense_definition": "Een vrouw die tot dezelfde geloofsgemeenschap behoort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dominee heette alle broeders en <w>zusters</w> welkom in de kerk.",
                            "target_lang_translations": {
                                "en": "The pastor welcomed all brothers and <w>sisters</w> to the church.",
                                "ru": "Пастор приветствовал всех братьев и <w>сестёр</w> в церкви.",
                                "fr": "Le pasteur a souhaité la bienvenue à tous les frères et <w>sœurs</w> dans l'église."
                            }
                        },
                        {
                            "text": "Wij bidden voor onze zieke <w>zuster</w> in de gemeente.",
                            "target_lang_translations": {
                                "en": "We pray for our sick <w>sister</w> in the congregation.",
                                "ru": "Мы молимся за нашу больную <w>сестру</w> в общине.",
                                "fr": "Nous prions pour notre <w>sœur</w> malade dans la communauté."
                            }
                        }
                    ],
                    "antonyms": [
                        "broeder"
                    ],
                    "common_phrases": [
                        "broeders en zusters"
                    ],
                    "target_lang_definitions": {
                        "en": "A woman who belongs to the same religious community.",
                        "ru": "Женщина, принадлежащая к той же религиозной общине.",
                        "fr": "Femme qui appartient à la même communauté religieuse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sister",
                                "target_lang_sense_clarification": "fellow believer"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сестра",
                                "target_lang_sense_clarification": "единоверка"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sœur",
                                "target_lang_sense_clarification": "coreligionnaire"
                            }
                        ]
                    }
                }
            ]
        }
