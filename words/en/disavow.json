{
    "word_family": [
        "disavowal"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7170c429-5abb-3f1f-9898-dd37279176d4",
                    "sense_definition": "To strongly and solemnly refuse to acknowledge or accept responsibility for something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "denial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician had to <w>disavow</w> the controversial statements made by his campaign manager.",
                            "target_lang_translations": {
                                "pl": "Polityk musiał <w>odciąć się od</w> kontrowersyjnych wypowiedzi swojego szefa kampanii."
                            }
                        },
                        {
                            "text": "The agency will <w>disavow</w> any agent who is captured on foreign soil.",
                            "target_lang_translations": {
                                "pl": "Agencja <w>wyprze się</w> każdego agenta schwytanego na obcej ziemi."
                            }
                        }
                    ],
                    "synonyms": [
                        "disclaim",
                        "disown",
                        "reject"
                    ],
                    "antonyms": [
                        "accept"
                    ],
                    "common_phrases": [
                        "disavow responsibility",
                        "disavow knowledge"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stanowczo i oficjalnie wyprzeć się czegoś lub odmówić przyjęcia odpowiedzialności za kogoś lub za coś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyprzeć się",
                                "target_lang_sense_clarification": "stanowczo zaprzeczyć powiązaniom lub odpowiedzialności"
                            },
                            {
                                "target_lang_word": "odciąć się",
                                "target_lang_sense_clarification": "np. od wypowiedzi, zachowania, kogoś"
                            },
                            {
                                "target_lang_word": "wyrzec się",
                                "target_lang_sense_clarification": "odmówić uznania kogoś za swojego (np. agenta, członka rodziny)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c58481-25a4-3b6d-9bab-6b62e1b0e8d5",
                    "sense_definition": "To deny the legitimacy, truth, or value of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "denial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar decided to <w>disavow</w> her earlier research after finding significant errors in the data.",
                            "target_lang_translations": {
                                "pl": "Badaczka postanowiła <w>odrzucić</w> swoje wcześniejsze badania po odkryciu istotnych błędów w danych."
                            }
                        },
                        {
                            "text": "It is difficult to <w>disavow</w> the merits of a theory that has been proven correct.",
                            "target_lang_translations": {
                                "pl": "Trudno jest <w>podważyć</w> zalety teorii, której poprawność została udowodniona."
                            }
                        }
                    ],
                    "synonyms": [
                        "deny",
                        "repudiate"
                    ],
                    "antonyms": [
                        "prove"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odrzucić lub zanegować prawdziwość, słuszność bądź wartość czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odrzucić",
                                "target_lang_sense_clarification": "uznać za nieważne lub błędne (np. teorię, badania)"
                            },
                            {
                                "target_lang_word": "zanegować",
                                "target_lang_sense_clarification": "zaprzeczyć wartości, istnieniu lub słuszności czegoś"
                            },
                            {
                                "target_lang_word": "podważyć",
                                "target_lang_sense_clarification": "zakwestionować zasadność lub zalety czegoś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}