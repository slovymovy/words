                {
                    "sense_id": "b6aa8464-a0d6-3bdd-8085-c6fa2ab66afc",
                    "sense_definition": "Een nauwsluitend kledingstuk dat de voet en een deel van het been bedekt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een groot gat in mijn linker <w>kous</w>.",
                            "target_lang_translations": {
                                "en": "There is a big hole in my left <w>stocking</w>."
                            }
                        },
                        {
                            "text": "Zij draagt vandaag wollen <w>kousen</w> tegen de kou.",
                            "target_lang_translations": {
                                "en": "She is wearing wool <w>stockings</w> today against the cold."
                            }
                        }
                    ],
                    "synonyms": [
                        "sok"
                    ],
                    "common_phrases": [
                        "wollen kousen",
                        "een paar kousen"
                    ],
                    "target_lang_definitions": {
                        "en": "A close-fitting garment that covers the foot and part of the leg."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stocking",
                                "target_lang_sense_clarification": "a long, close-fitting garment for the leg"
                            },
                            {
                                "target_lang_word": "sock",
                                "target_lang_sense_clarification": "a shorter garment covering the foot and ankle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ad64f08-11fd-392b-8778-cefdda7d549f",
                    "sense_definition": "Een onderdeel van een lamp dat brandstof omzet in licht.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verlichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kous</w> van de olielamp moet worden vervangen.",
                            "target_lang_translations": {
                                "en": "The <w>wick</w> of the oil lamp needs to be replaced."
                            }
                        },
                        {
                            "text": "Zonder een goede <w>kous</w> geeft de lamp weinig licht.",
                            "target_lang_translations": {
                                "en": "Without a good <w>wick</w>, the lamp gives off little light."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiek",
                        "pit",
                        "kousje"
                    ],
                    "common_phrases": [
