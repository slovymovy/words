                "senses": [
                    {
                        "sense_id": "70156a76-2f15-376a-a3f7-6c5311456935",
                        "entry_id": "a53ae50f-c386-3b70-b636-b78740cc563e",
                        "glosses": [
                            "Surnom donné par les poilus pendant la guerre de tranchée au lance-bombes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f69258f-3cd8-411d-b6f6-3a21a6dd47b6",
                                "sense_id": "70156a76-2f15-376a-a3f7-6c5311456935",
                                "text": "Le crapouillot est un mortier de tranchée, petit, trapu, la gueule en l’air, attaché à une plaque de fer qui lui sert d’affût …."
                            },
                            {
                                "example_id": "8f654444-eae0-4048-9cb7-5d4f5bb061dd",
                                "sense_id": "70156a76-2f15-376a-a3f7-6c5311456935",
                                "text": "En 1918, cette artillerie de tranchée, le crapouillot, a joué un rôle essentiel dans la destruction des premières lignes allemandes."
                            },
                            {
                                "example_id": "cf6e3397-a7b0-45b2-b300-0cde32104339",
                                "sense_id": "70156a76-2f15-376a-a3f7-6c5311456935",
                                "text": "Prendre le tour de garde d'un camarade fatigué, à l'heure où le froufroutement du crapouillot monte dans le jour qui sombre, ce n'est pas rien !"
                            },
                            {
                                "example_id": "e55ee23c-a921-4042-8625-284ce75c5222",
                                "sense_id": "70156a76-2f15-376a-a3f7-6c5311456935",
                                "text": "Nous avons des armes plus redoutables : les « crapouillots », ainsi appelés parce que, par leur aspect, ils rappelaient le crapaud, lourd et trapu, portant de grosses glandes autour du cou. Les premiers furent des mortiers de 15 cm, datant de Louis-Philippe, dénichés dans les forts et arsenaux."
                            }
                        ]
                    }
                ],
