                        "examples": [
                            {
                                "example_id": "cdc00bb0-8c56-44bc-8577-9d469bc80735",
                                "sense_id": "947cb5a8-71a7-3c17-9914-b488ccf7bf08",
                                "text": "And now, though there is none of that sweetness of stolen fruits, none of that creeping insecurity of former readings, there is an undisturbing, quiet secureness that makes our books more living to us."
                            },
                            {
                                "example_id": "72d5db75-0d5f-4bcd-a88c-de7c461419f3",
                                "sense_id": "947cb5a8-71a7-3c17-9914-b488ccf7bf08",
                                "text": "A square seat, about as wide and unyielding as a table-top, was strapped securely to each donkey, and to this seat we clung, with no secureness at all."
                            },
                            {
                                "example_id": "825d3bda-c5ff-4a8f-a64c-83cc18be91b1",
                                "sense_id": "947cb5a8-71a7-3c17-9914-b488ccf7bf08",
                                "text": "That's partly because of the high level of professionalism and efficiency of M. Seth Reines's staging of the show at Apple Tree Theatre; the very secureness of the production mitigates any feelings of insecurity the characters might want to communicate."
                            }
                        ]
                    }
