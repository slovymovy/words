        "nl-extract.jsonl": [],
        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "44b2340c-a39b-3fd4-9425-9d5dfe88a7e4",
                "word": "plumeau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "55bea89b-a42a-4e2d-a9ce-975ec9d81df5",
                        "entry_id": "44b2340c-a39b-3fd4-9425-9d5dfe88a7e4",
                        "tags": [
                            "plural"
                        ],
                        "form": "plumeaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1b1331f-ffd7-3b97-b021-a1f7a2fdd69c",
                        "entry_id": "44b2340c-a39b-3fd4-9425-9d5dfe88a7e4",
                        "glosses": [
                            "Ustensile de ménage, fait avec de grosses plumes de dindon, de coq, etc., qui sert à enlever la poussière de dessus les meubles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b25f0b1a-91c0-4ab0-a660-61c7c19d64ea",
                                "sense_id": "c1b1331f-ffd7-3b97-b021-a1f7a2fdd69c",
                                "text": "Jamais il ne fallait battre les habits ni les meubles de peur de les user, mais les housser légèrement avec un plumeau."
                            },
                            {
                                "example_id": "f85181e6-ad61-40c7-91d0-d27aa50e2b6f",
                                "sense_id": "c1b1331f-ffd7-3b97-b021-a1f7a2fdd69c",
                                "text": "J’ai, comme elle, frotté les meubles à l’eau japonaise, collectionné toutes sortes de cires, rangé de façon presque maniaque les différentes brosses ou plumeaux par tailles ou selon l'usage auquel ils étaient réservés."
                            },
                            {
                                "example_id": "1070c325-4068-4f84-b407-e1ff32b69af3",
                                "sense_id": "c1b1331f-ffd7-3b97-b021-a1f7a2fdd69c",
                                "text": "Et puis le sable, c'est surtout de la poussière : le désert est très poussiéreux, car il n'y tombe jamais d'eau.\n— Vous n'époussetez pas ? dit M. Loubet.\n— Chameaux, plumeaux ! fredonna Karagheuz."
                            }
                        ]
                    },
                    {
                        "sense_id": "c579f707-88ce-310e-8f21-805b48e147ff",
                        "entry_id": "44b2340c-a39b-3fd4-9425-9d5dfe88a7e4",
                        "glosses": [
                            "Inflorescence en forme de panache."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "b819b3b8-7b01-4324-9351-21aa40df0371",
                                "sense_id": "c579f707-88ce-310e-8f21-805b48e147ff",
                                "text": "Le tout resplendit, enlaçant des rocs datant de la préhistoire et en jaillissent des herbes de la pampa qui se terminent par de majestueux plumeaux blancs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6a52d2a-fbdc-46d3-8ba3-40adc3349da4",
                        "source_entry_id": "44b2340c-a39b-3fd4-9425-9d5dfe88a7e4",
                        "source_sense_description": "Ustensile de ménage.",
                        "target_lang_word": "Staubwedel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staubwedel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                        "entry_id": "11ee6cb9-47ca-317f-bdcb-0c66ad72f7f1",
                                        "glosses": [
                                            "handliches Haushaltsgerät mit weichen, dünnen Borsten, Federn oder dergleichen zum Entfernen von Staub oder Schmutz, häufig an schwer erreichbaren Stellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0550794-de25-46a9-a8ff-dd3ca4f4dc94",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Sie war vor einer Abstellkammer stehengeblieben und reichte mir einen Staubwedel.“"
                                            },
                                            {
                                                "example_id": "c48fc2a4-d76a-4b2f-a4ab-5db862683b0e",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "Mit dem Staubwedel wischte sie den Schrank ab."
                                            },
                                            {
                                                "example_id": "f1931cc7-3922-413d-88bb-fd00f23c53a8",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Den Staubwedel brauche ich für meine Gemälde; sie dürfen nur mit diesem Staubwedel gereinigt werden.“"
                                            },
                                            {
                                                "example_id": "329ecf37-ce2a-4fb2-be4b-695cafdaa765",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Sobald sie ihre Arbeit begutachtet hatte, griff sie nach einem Staubwedel und führte ihn an der Tapete entlang.“"
                                            },
                                            {
                                                "example_id": "4cb52022-05cb-4fdf-a3d5-2b6322d98502",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Unsere Mönche benutzen nur vier Dinge: Besen, Scheuerlappen, Staubwedel und Eimer, mehr nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
