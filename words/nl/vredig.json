    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a4fd3f9-aa99-372d-bf56-27395a0d4c8a",
                    "sense_definition": "vrij van ruzie, strijd of onrust; gekenmerkt door rust en harmonie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rust en vrede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>vredige</w> ochtend in het kleine dorpje aan de kust.",
                            "target_lang_translations": {
                                "en": "It was a <w>peaceful</w> morning in the small village on the coast."
                            }
                        },
                        {
                            "text": "Zij hopen op een <w>vredige</w> oplossing voor dit grote conflict.",
                            "target_lang_translations": {
                                "en": "They hope for a <w>peaceful</w> solution to this major conflict."
                            }
                        }
                    ],
                    "synonyms": [
                        "vreedzaam",
                        "rustig",
                        "kalm"
                    ],
                    "antonyms": [
                        "onrustig",
                        "gewelddadig",
                        "roerig"
                    ],
                    "common_phrases": [
                        "vredige oplossing",
                        "vredige sfeer"
                    ],
                    "target_lang_definitions": {
                        "en": "free from conflict, struggle, or unrest; characterized by peace and harmony"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peaceful",
                                "target_lang_sense_clarification": "not at war or disturbed by strife"
                            },
                            {
                                "target_lang_word": "peaceable",
                                "target_lang_sense_clarification": "inclined to avoid conflict"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d191b5b6-b695-3218-9307-bf4719bc7009",
                    "sense_definition": "niet gestoord door lawaai of opschudding; sereen en kalm",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rust en vrede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>vredige</w> stemming werd ruw verstoord door het lawaai van een aanrijding.",
                            "target_lang_translations": {
                                "en": "The <w>peaceful</w> atmosphere was rudely disturbed by the noise of a collision."
                            }
                        },
                        {
                            "text": "In de <w>vredige</w> stilte van het bos kon hij eindelijk goed nadenken.",
                            "target_lang_translations": {
                                "en": "In the <w>peaceful</w> silence of the forest, he could finally think clearly."
                            }
                        }
                    ],
                    "synonyms": [
                        "kalm",
                        "rustig",
                        "stil"
                    ],
                    "antonyms": [
                        "lawaaiig",
                        "druk"
                    ],
                    "common_phrases": [
                        "vredige stilte",
                        "vredige stemming"
                    ],
                    "target_lang_definitions": {
                        "en": "undisturbed by noise or commotion; serene and calm"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peaceful",
                                "target_lang_sense_clarification": "quiet and calm"
                            },
                            {
                                "target_lang_word": "serene",
                                "target_lang_sense_clarification": "tranquil and untroubled"
                            },
                            {
                                "target_lang_word": "tranquil",
                                "target_lang_sense_clarification": "free from disturbance"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2be07d6a-2f0b-3459-b1ca-8c361ce19e27",
                    "sense_definition": "op een manier die rust en kalmte uitstraalt; zonder verstoring",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rust en vrede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby lag heel <w>vredig</w> te slapen in zijn wiegje.",
                            "target_lang_translations": {
                                "en": "The baby was sleeping very <w>peacefully</w> in his crib."
                            }
                        },
                        {
                            "text": "De twee eenden glijden <w>vredig</w> langs het raam van de woonboot.",
                            "target_lang_translations": {
                                "en": "The two ducks glide <w>peacefully</w> past the window of the houseboat."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustig",
                        "kalm",
                        "stil"
                    ],
                    "antonyms": [
                        "onrustig"
                    ],
                    "common_phrases": [
                        "vredig slapen",
                        "vredig naast elkaar"
                    ],
                    "target_lang_definitions": {
