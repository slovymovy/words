                    {
                        "translation_id": "6da596e1-0e36-4fae-870c-7924a3b0c5b3",
                        "source_entry_id": "8834cf89-e540-3dcc-b0de-9e840b273800",
                        "source_sense_id": "b7fb706c-6392-3ecc-9aaa-d0201da78738",
                        "target_lang_word": "szelest",
