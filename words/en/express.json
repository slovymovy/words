{
    "word_family": [
        "expression",
        "expressive",
        "expressly",
        "expressiveness",
        "expressionism",
        "expressionist"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c695a32c-9e61-3c5c-a51c-96f0151bf39f",
                    "sense_definition": "To convey a thought, feeling, or opinion using words, actions, or art.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to <w>express</w> her gratitude for their help.",
                            "target_lang_translations": {
                                "ru": "Ей было трудно <w>выразить</w> свою благодарность за их помощь.",
                                "cs": "Měla potíže <w>vyjádřit</w> svou vděčnost za jejich pomoc.",
                                "it": "Faceva fatica a <w>esprimere</w> la sua gratitudine per il loro aiuto."
                            }
                        },
                        {
                            "text": "The artist used dark colors to <w>express</w> a sense of sadness.",
                            "target_lang_translations": {
                                "ru": "Художник использовал темные цвета, чтобы <w>выразить</w> чувство грусти.",
                                "cs": "Umělec použil tmavé barvy, aby <w>vyjádřil</w> pocit smutku.",
                                "it": "L'artista ha usato colori scuri per <w>esprimere</w> un senso di tristezza."
                            }
                        }
                    ],
                    "synonyms": [
                        "utter"
                    ],
                    "common_phrases": [
                        "express oneself",
                        "express an opinion",
                        "express concern",
                        "express interest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать мысли, чувства или мнения словами, действиями или искусством.",
                        "cs": "Vyjádřit myšlenku, pocit nebo názor pomocí slov, činů nebo umění.",
                        "it": "Comunicare un pensiero, un sentimento o un'opinione usando parole, azioni o l'arte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "передавать чувства или мысли (несов. вид)"
                            },
                            {
                                "target_lang_word": "выразить",
                                "target_lang_sense_clarification": "передать чувства или мысли (сов. вид)"
                            },
                            {
                                "target_lang_word": "высказывать",
                                "target_lang_sense_clarification": "озвучивать мнение словами"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyjádřit",
                                "target_lang_sense_clarification": "sdělit pocity nebo myšlenky (dokonavé)"
                            },
                            {
                                "target_lang_word": "vyjadřovat",
                                "target_lang_sense_clarification": "sdělovat pocity nebo myšlenky (nedokonavé)"
                            },
                            {
                                "target_lang_word": "vyslovit",
                                "target_lang_sense_clarification": "formulovat slovy"
                            },
                            {
                                "target_lang_word": "projevit",
                                "target_lang_sense_clarification": "dát najevo"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "esprimere",
                                "target_lang_sense_clarification": "comunicare sentimenti o idee"
                            },
                            {
                                "target_lang_word": "manifestare",
                                "target_lang_sense_clarification": "rendere evidente un sentimento"
                            },
                            {
                                "target_lang_word": "dichiarare",
                                "target_lang_sense_clarification": "affermare esplicitamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b261b150-0c3b-3bbf-bd36-33f9d5f44d67",
                    "sense_definition": "To force out liquid or air from something by pressing or squeezing it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor had to <w>express</w> the fluid from the wound to prevent infection.",
                            "target_lang_translations": {
                                "ru": "Врачу пришлось <w>выдавить</w> жидкость из раны, чтобы предотвратить инфекцию.",
                                "cs": "Lékař musel z rány <w>vytlačit</w> tekutinu, aby zabránil infekci.",
                                "it": "Il medico ha dovuto <w>spremere</w> il liquido dalla ferita per prevenire l'infezione."
                            }
                        },
                        {
                            "text": "Mothers often learn how to <w>express</w> milk for their babies.",
                            "target_lang_translations": {
                                "ru": "Матери часто учатся <w>сцеживать</w> молоко для своих детей.",
                                "cs": "Matky se často učí, jak <w>odsávat</w> mléko pro své děti.",
                                "it": "Le madri spesso imparano come <w>tirarsi</w> il latte per i loro bambini."
                            }
                        }
                    ],
                    "common_phrases": [
                        "express milk",
                        "express fluid"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in medical or biological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдавливать жидкость или воздух из чего-либо путем нажатия или сжатия.",
                        "cs": "Vytlačit tekutinu nebo vzduch z něčeho tlakem nebo stisknutím.",
                        "it": "Far uscire liquidi o aria da qualcosa premendo o schiacciando."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавливать",
                                "target_lang_sense_clarification": "извлекать жидкость давлением"
                            },
                            {
                                "target_lang_word": "сцеживать",
                                "target_lang_sense_clarification": "о молоке"
                            },
                            {
                                "target_lang_word": "выжимать",
                                "target_lang_sense_clarification": "удалять влагу сжатием"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vymáčknout",
                                "target_lang_sense_clarification": "tlakem dostat ven"
                            },
                            {
                                "target_lang_word": "odsát",
                                "target_lang_sense_clarification": "o mateřském mléce"
                            },
                            {
                                "target_lang_word": "vytlačit",
                                "target_lang_sense_clarification": "působením síly dostat ven"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "spremere",
                                "target_lang_sense_clarification": "estrarre premendo"
                            },
                            {
                                "target_lang_word": "tirare",
                                "target_lang_sense_clarification": "riferito al latte materno"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3565e8ab-a97f-395e-a3ca-9ddaeb3d7b8e",
                    "sense_definition": "To cause a gene to function and produce a specific protein or observable trait.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying how certain cells <w>express</w> this specific gene.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают, как определенные клетки <w>экспрессируют</w> этот конкретный ген.",
                                "cs": "Vědci studují, jak určité buňky <w>exprimují</w> tento konkrétní gen.",
                                "it": "Gli scienziati stanno studiando come certe cellule <w>esprimono</w> questo gene specifico."
                            }
                        },
                        {
                            "text": "The trait is only <w>expressed</w> if the organism inherits the gene from both parents.",
                            "target_lang_translations": {
                                "ru": "Этот признак <w>проявляется</w>, только если организм наследует ген от обоих родителей.",
                                "cs": "Tento znak se <w>projeví</w> pouze tehdy, pokud organismus zdědí gen od obou rodičů.",
                                "it": "Il tratto si <w>manifesta</w> solo se l'organismo eredita il gene da entrambi i genitori."
                            }
                        }
                    ],
                    "common_phrases": [
                        "express a gene",
                        "express a protein"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять ген функционировать и производить определенный белок или наблюдаемый признак.",
                        "cs": "Způsobit, aby gen fungoval a produkoval specifický protein nebo pozorovatelný znak.",
                        "it": "Far sì che un gene funzioni e produca una specifica proteina o un tratto osservabile."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспрессировать",
                                "target_lang_sense_clarification": "биол. о генах"
                            },
                            {
                                "target_lang_word": "проявлять",
                                "target_lang_sense_clarification": "о признаках"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "exprimovat",
                                "target_lang_sense_clarification": "odborně o genech"
                            },
                            {
                                "target_lang_word": "projevit se",
                                "target_lang_sense_clarification": "o genetickém znaku"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "esprimere",
                                "target_lang_sense_clarification": "in ambito genetico"
                            },
                            {
                                "target_lang_word": "manifestarsi",
                                "target_lang_sense_clarification": "di un tratto ereditario"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "237aa128-9796-3c23-9999-2056eb1a4e8e",
                    "sense_definition": "Traveling at high speed or designed for rapid transportation, often with few stops.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speed_transport_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took the <w>express</w> train to get to the city center faster.",
                            "target_lang_translations": {
                                "ru": "Мы сели на <w>скорый</w> поезд, чтобы быстрее добраться до центра города.",
                                "cs": "Jeli jsme <w>expresním</w> vlakem, abychom se do centra města dostali rychleji.",
                                "it": "Abbiamo preso il treno <w>espresso</w> per arrivare più velocemente in centro."
                            }
                        },
                        {
                            "text": "The company offers an <w>express</w> delivery service for urgent packages.",
                            "target_lang_translations": {
                                "ru": "Компания предлагает услугу <w>экспресс</w>-доставки для срочных посылок.",
                                "cs": "Společnost nabízí <w>expresní</w> doručovací službu pro naléhavé zásilky.",
                                "it": "L'azienda offre un servizio di consegna <w>espresso</w> per pacchi urgenti."
                            }
                        }
                    ],
                    "synonyms": [
                        "fast",
                        "direct",
                        "quick",
                        "rapid"
                    ],
                    "antonyms": [
                        "local"
                    ],
                    "common_phrases": [
                        "express train",
                        "express service",
                        "express delivery",
                        "express lane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся с высокой скоростью или предназначенный для быстрой перевозки, часто с небольшим количеством остановок.",
                        "cs": "Cestující vysokou rychlostí nebo určený pro rychlou přepravu, často s minimem zastávek.",
                        "it": "Che viaggia ad alta velocità o progettato per il trasporto rapido, spesso con poche fermate."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорый",
                                "target_lang_sense_clarification": "быстрый (о поезде)"
                            },
                            {
                                "target_lang_word": "скоростной",
                                "target_lang_sense_clarification": "обладающий высокой скоростью"
                            },
                            {
                                "target_lang_word": "экспресс",
                                "target_lang_sense_clarification": "в составе сложных слов (экспресс-доставка)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "expresní",
                                "target_lang_sense_clarification": "rychlý, přímý"
                            },
                            {
                                "target_lang_word": "rychlíkový",
                                "target_lang_sense_clarification": "týkající se rychlíku"
                            },
                            {
                                "target_lang_word": "rychlý",
                                "target_lang_sense_clarification": "vysokorychlostní"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "espresso",
                                "target_lang_sense_clarification": "veloce, riferito a treni o spedizioni"
                            },
                            {
                                "target_lang_word": "diretto",
                                "target_lang_sense_clarification": "senza fermate intermedie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf2565e0-3cde-3a1f-8c7f-fd711e8d51e6",
                    "sense_definition": "Clearly and openly stated; not hidden, ambiguous, or merely implied.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You cannot copy this book without the <w>express</w> permission of the publisher.",
                            "target_lang_translations": {
                                "ru": "Вы не можете копировать эту книгу без <w>прямого</w> разрешения издателя.",
                                "cs": "Tuto knihu nemůžete kopírovat bez <w>výslovného</w> svolení vydavatele.",
                                "it": "Non puoi copiare questo libro senza l'<w>espresso</w> consenso dell'editore."
                            }
                        },
                        {
                            "text": "He came here with the <w>express</w> purpose of apologizing to you.",
                            "target_lang_translations": {
                                "ru": "Он пришел сюда со <w>специальной</w> целью извиниться перед вами.",
                                "cs": "Přišel sem s <w>výslovným</w> úmyslem se vám omluvit.",
                                "it": "È venuto qui con lo scopo <w>espresso</w> di chiederti scusa."
                            }
                        }
                    ],
                    "synonyms": [
                        "explicit",
                        "specific",
                        "clear",
                        "unambiguous",
                        "unequivocal"
                    ],
                    "antonyms": [
                        "implied"
                    ],
                    "common_phrases": [
                        "express permission",
                        "express purpose",
                        "express wish",
                        "express agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Четко и открыто заявленный; не скрытый и не подразумеваемый.",
                        "cs": "Jasně a otevřeně vyjádřený; neskrytý, nejednoznačný nebo pouze naznačený.",
                        "it": "Dichiarato in modo chiaro e aperto; non nascosto, ambiguo o semplicemente implicito."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямой",
                                "target_lang_sense_clarification": "непосредственный, явный"
                            },
                            {
                                "target_lang_word": "специальный",
                                "target_lang_sense_clarification": "особый, намеренный"
                            },
                            {
                                "target_lang_word": "явный",
                                "target_lang_sense_clarification": "очевидный"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "výslovný",
                                "target_lang_sense_clarification": "přímo stanovený"
                            },
                            {
                                "target_lang_word": "jasný",
                                "target_lang_sense_clarification": "zřetelný"
                            },
                            {
                                "target_lang_word": "přímý",
                                "target_lang_sense_clarification": "otevřený"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "espresso",
                                "target_lang_sense_clarification": "chiaro ed esplicito"
                            },
                            {
                                "target_lang_word": "esplicito",
                                "target_lang_sense_clarification": "dichiarato apertamente"
                            },
                            {
                                "target_lang_word": "formale",
                                "target_lang_sense_clarification": "ufficiale e preciso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82e89b10-c5bc-3134-b534-a6711f63f22d",
                    "sense_definition": "A train or bus that travels quickly to a destination, making few or no stops.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speed_transport_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you miss the <w>express</w>, you will have to take the slower local train.",
                            "target_lang_translations": {
                                "ru": "Если вы опоздаете на <w>экспресс</w>, вам придется ехать на более медленной электричке.",
                                "cs": "Pokud zmeškáte <w>expres</w>, budete muset jet pomalejším osobním vlakem.",
                                "it": "Se perdi l'<w>espresso</w>, dovrai prendere il treno locale più lento."
                            }
                        },
                        {
                            "text": "The morning <w>express</w> is usually very crowded with commuters.",
                            "target_lang_translations": {
                                "ru": "Утренний <w>экспресс</w> обычно переполнен пассажирами.",
                                "cs": "Ranní <w>rychlík</w> bývá obvykle velmi přeplněný dojíždějícími.",
                                "it": "L'<w>espresso</w> del mattino è solitamente molto affollato di pendolari."
                            }
                        }
                    ],
                    "antonyms": [
                        "local"
                    ],
                    "common_phrases": [
                        "take the express",
                        "catch the express",
                        "airport express"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поезд или автобус, который быстро едет до пункта назначения, делая мало остановок или не делая их вовсе.",
                        "cs": "Vlak nebo autobus, který jede rychle do cíle a zastavuje jen málo nebo vůbec.",
                        "it": "Un treno o un autobus che viaggia velocemente verso una destinazione, facendo poche o nessuna fermata."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспресс",
                                "target_lang_sense_clarification": "вид транспорта"
                            },
                            {
                                "target_lang_word": "скорый поезд",
                                "target_lang_sense_clarification": "железнодорожный термин"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "expres",
                                "target_lang_sense_clarification": "rychlý dopravní spoj"
                            },
                            {
                                "target_lang_word": "rychlík",
                                "target_lang_sense_clarification": "rychlý vlak"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "espresso",
                                "target_lang_sense_clarification": "treno veloce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61760945-398b-3717-8126-11e39ead63a4",
                    "sense_definition": "A service for sending mail or packages very quickly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speed_transport_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I sent the documents via <w>express</w> to ensure they arrived the next day.",
                            "target_lang_translations": {
                                "ru": "Я отправил документы <w>экспресс-почтой</w>, чтобы они прибыли на следующий день.",
                                "cs": "Dokumenty jsem poslal <w>expresně</w>, aby dorazily hned druhý den.",
                                "it": "Ho inviato i documenti per <w>espresso</w> per assicurarmi che arrivassero il giorno dopo."
                            }
                        },
                        {
                            "text": "The package was delivered by <w>express</w> early this morning.",
                            "target_lang_translations": {
                                "ru": "Посылка была доставлена <w>экспресс-почтой</w> рано утром.",
                                "cs": "Balíček byl doručen <w>expresní poštou</w> dnes brzy ráno.",
                                "it": "Il pacco è stato consegnato tramite <w>espresso</w> questa mattina presto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "send by express",
                        "overnight express"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служба очень быстрой отправки почты или посылок.",
                        "cs": "Služba pro velmi rychlé zasílání pošty nebo balíků.",
                        "it": "Un servizio per l'invio molto rapido di posta o pacchi."
                    },
                    "translations": {
