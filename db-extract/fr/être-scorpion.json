                        "glosses": [
                            "Être dont l’apparence évoque un scorpion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ce9955-aa3a-480f-90b6-59cf229b1cc8",
                                "sense_id": "7e5a0da5-2cbb-31b6-bdef-851a70abab4b",
                                "text": "Voyageant entassés par myriades dans d’énormes vaisseaux dépourvus du moindre confort, les Strules étaient des êtres-scorpions directement adaptés à toutes les planètes."
                            },
                            {
                                "example_id": "912c7550-5158-442d-9642-90ab8967378a",
                                "sense_id": "7e5a0da5-2cbb-31b6-bdef-851a70abab4b",
                                "text": "Dans les anciens textes sumériens, il est en effet signalé que le héros Gilgamesh brisa les deux stèles shut abnê lorsqu'il rencontra deux êtres-scorpions au pied du mont Masha."
                            },
                            {
                                "example_id": "23e027ed-9e39-4a4c-bb01-254762222dce",
                                "sense_id": "7e5a0da5-2cbb-31b6-bdef-851a70abab4b",
                                "text": "La femme capée qu’il avait prise pour T’ra Saa empala les arachnoïdes désarmées en plein torse – laissant les six segments des êtres-scorpions s’effondrer et se contorsionner puis s’immobiliser."
                            }
                        ]
                    }
