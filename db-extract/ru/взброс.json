                    {
                        "translation_id": "a38e5f2a-adc5-4d73-9c41-b563936c0695",
                        "source_entry_id": "67f5138f-9fe3-32e0-961a-00efb02498e3",
                        "source_sense_description": "разрывное тектоническое смещение, поднятие участка горных пород",
                        "target_lang_word": "uplift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uplift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To raise something or someone to a higher physical, social, moral, intellectual, spiritual or emotional level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58202ff9-0d7f-4957-b4ae-c1f1eb154798",
                                                "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                                "text": "Whether you find it by your power as a man, or because, being near the gods, a god has whispered you. Uplift our State; think upon your fame; your coming brought us luck, be lucky to us still, remember that it is better to rule over men than over a waste place, since neither walled town nor ship is anything if it be empty and no man within it."
                                            },
                                            {
                                                "example_id": "8406ffb9-4f55-4096-b076-e34528bbb9fa",
                                                "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                                "text": "They recognised that their free-lay properties were just right for premises where there had to be easy access to underfloor cables or where office layouts needed to be readily changed without having to uplift the carpet every time."
                                            },
                                            {
                                                "example_id": "ee0a4093-6bca-40fc-badf-412501345664",
                                                "sense_id": "338e55cf-87fa-37ef-a001-e9708e2da39f",
                                                "text": "At the behest of the London Midland Region, the infrastructure was built with a capability for running at up to 110mph with conventional rolling stock, as well as the raising of speed limits - such as the 60mph over Shap summit uplifted to 80mph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b647f2-a80c-3d6d-994b-49d2dad1e99f",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To raise something or someone to a higher physical, social, moral, intellectual, spiritual or emotional level.",
                                            "To raise (a nonsentient species) into sentience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c1deb2d-9292-4d45-a299-18bb5965198b",
                                                "sense_id": "d3b647f2-a80c-3d6d-994b-49d2dad1e99f",
                                                "text": "—genetically uplifted the ancestors of the saurs, and culturally—at least—uplifted the kraken. We are used to thinking of these species as wise and ancient, which indeed they are, but the octopods are their 'Elder Race.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "589d266c-419a-3d3a-a4ed-e3b10f8a1a60",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To aggravate; to increase."
                                        ],
                                        "tags": [
                                            "of a penalty"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9def407b-947c-4cc8-9c87-10a942d3471c",
                                                "sense_id": "589d266c-419a-3d3a-a4ed-e3b10f8a1a60",
                                                "text": "A man who abused a Police Community Support Officer for being transgender has received an uplifted sentence at Mold Magistrates' Court... At Court the prosecutor applied for the sentence for the public order offence to be uplifted to reflect the hate crime aspect. This resulted in the Court imposing a greater penalty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a48ffb6-8147-39fa-b09a-5b077b20008c",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To be accepted for carriage on a flight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a37b4f16-dfb8-3068-a1d6-f765ff6fdc6a",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
                                        "glosses": [
                                            "To remove (a child) from a damaging home environment by a social welfare organization."
                                        ],
                                        "tags": [
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccea5b7e-fb46-4e81-9f58-4cbd8ec16454",
                                                "sense_id": "a37b4f16-dfb8-3068-a1d6-f765ff6fdc6a",
                                                "text": "In an affidavit supporting an application for a court order to uplift the child, a social worker said there were ongoing family violence issues between the baby's mother and father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae9dcdf-6733-3e23-91cc-6276986d124c",
                                        "entry_id": "8dea4fea-c360-3a11-92e4-31d9293c21e0",
