                                "target_senses": [
                                    {
                                        "sense_id": "c0102d1d-3b61-35c1-83af-9d911aac928d",
                                        "entry_id": "86e81b0f-c257-32c1-b18f-337c1bd5f1ab",
                                        "glosses": [
                                            "Designed in such a way as to allow players to exchange real-world currency for in-game benefits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c0605a-1e92-471d-b4f7-27eff8580526",
                                                "sense_id": "c0102d1d-3b61-35c1-83af-9d911aac928d",
                                                "text": "Concerns about pay-to-win dynamics are laced through core games, as the default norm is that superior players should win battles contested on a level playing field."
                                            },
                                            {
                                                "example_id": "9d4fa4cb-6b20-45e2-ba5f-1f03c1b8b297",
                                                "sense_id": "c0102d1d-3b61-35c1-83af-9d911aac928d",
                                                "text": "Admittedly, the loot boxes first of all monetize video games, by reinforcing the pay-to-win logic, but they also contribute to their gamblification (Johnson 2018), […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pay to win",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
