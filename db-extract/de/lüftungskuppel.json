                "senses": [
                    {
                        "sense_id": "d6bb8602-5af5-36d1-af12-6d2d8afbb579",
                        "entry_id": "2ece3a89-002c-33bd-8518-b179d603ace7",
                        "glosses": [
                            "halbkugelförmig gewölbte Überdachung die der Lüftung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6dc560-91ce-4cd3-88cf-e7aeec43e7af",
                                "sense_id": "d6bb8602-5af5-36d1-af12-6d2d8afbb579",
                                "text": "„Zusammen mit der Funktion von Lüftungskuppeln sind sie die beste Komplettlösung für ein gesundes Raumklima.“"
                            },
                            {
                                "example_id": "86b8ab79-35e9-4901-bcf6-8bd243dd5046",
                                "sense_id": "d6bb8602-5af5-36d1-af12-6d2d8afbb579",
                                "text": "„Lichtkuppeln als Lüftungskuppeln ausgeführt, sorgen für gesundes Raumklima und ersparen oftmals eine aufwendige Klimatisierung mit teurer Regeltechnik und hohem Wartungsaufwand.“"
                            },
                            {
                                "example_id": "8bf85723-e0c8-4705-ae81-296305477ce9",
                                "sense_id": "d6bb8602-5af5-36d1-af12-6d2d8afbb579",
                                "text": "„Bei regnerischem Wetter ist die Lüftungskuppel unverzüglich zu schließen. Aus Lärmschutzgründen sind die Lüftungskuppel und die Außentüren nach 22.00 Uhr geschlossen zu halten.“"
                            },
                            {
                                "example_id": "3dbe2497-9c34-458d-bc1c-9fac560f9d94",
                                "sense_id": "d6bb8602-5af5-36d1-af12-6d2d8afbb579",
                                "text": "„Enthält seine Leistungsbeschreibung keine Angaben zur Dimensionierung von RWA- und Lüftungskuppeln, muss der Planer trotzdem prüfen, ob die Angebote eine mangelfreie Ausführung gewährleisten.“"
                            },
                            {
                                "example_id": "e6fe7882-d83a-4b39-8979-4cd24b804bcb",
                                "sense_id": "d6bb8602-5af5-36d1-af12-6d2d8afbb579",
                                "text": "„Eine Lüftungskuppel im Dach über der Treppe lässt an heißen Tagen die warme Luft nach oben entweichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
