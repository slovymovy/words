                        ],
                        "form": "die Photographie"
                    },
                    {
                        "form_id": "36e75513-6e38-4efa-8c3f-f43926d14fdc",
                        "entry_id": "a080dbc2-1c95-3894-bd69-c5da1127d9d3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Photographien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d31bc0e-c42b-30ed-9439-b48c81243b50",
                        "entry_id": "a080dbc2-1c95-3894-bd69-c5da1127d9d3",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "ff7b5f2f-5684-4938-8359-aea9a254c61a",
                                "sense_id": "8d31bc0e-c42b-30ed-9439-b48c81243b50",
                                "text": "„Eine ovale Photographie erklärte, daß es einmal einen jungen Kanonier Jepsen gegeben hatte, der neben einer leichten Haubitze kniete wie vor einem Altar, derselbe Kanonier trug in Galizien einen Mantel und sang mit anderen Kanonieren einen Weihnachtsbaum an.“"
                            },
                            {
                                "example_id": "3e31bdab-e669-4449-97c0-67e4e36622f7",
                                "sense_id": "8d31bc0e-c42b-30ed-9439-b48c81243b50",
                                "text": "„Wir bedienen uns für Meldungen einiger Resultate aus den Versuchen von Heinrich Hertz, der in Karlsruhe lebte, früh starb und, wenigstens auf der Photographie der Graphischen Sammlung München, einen Vollbart trug.“"
                            },
                            {
                                "example_id": "96ba6dbf-a7a1-4209-9247-96cc99fb96b0",
                                "sense_id": "8d31bc0e-c42b-30ed-9439-b48c81243b50",
                                "text": "„Unter den ersten Sachen war auch eine Schreibmappe, deren Deckel eine Photographie zeigte, das Bild seiner Schwester.“"
                            },
                            {
                                "example_id": "27be1bf1-b2a8-4f7c-bc72-ac67a8d7eeae",
                                "sense_id": "8d31bc0e-c42b-30ed-9439-b48c81243b50",
                                "text": "„Das Wohnzimer Jessies war nicht groß, aber es war ganz in ihrem Stil eingerichtet. Kissen überall, viele Stühle, eine Chaiselongue und an den Wänden viele Photographien, fast alle mit überschwenglichen Widmungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
