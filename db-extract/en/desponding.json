                        "glosses": [
                            "That causes or communicates despondency; disheartening or despondent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e4a5e8-c68b-4e2e-8aed-0258e1b015a0",
                                "sense_id": "cbc81984-f4fd-3f11-bdc3-1f0318d81b2d",
                                "text": "[T]he doubts, apprehensions, and desponding suspense which had accompanied her setting out, were now all removed, and certainty, ease, the expectation of happiness, and the cessation of all perplexity, had taken their place."
                            },
                            {
                                "example_id": "8f3a5e98-0bca-487a-b74b-6ac6ede37601",
                                "sense_id": "cbc81984-f4fd-3f11-bdc3-1f0318d81b2d",
                                "text": "\"Somebody has hooked off with your pie,\" he blurted in a desponding tone."
                            }
                        ]
                    }
