                                "example_id": "4c653162-251a-4e01-a701-6d6babf607f9",
                                "sense_id": "06c8ea71-9611-3a09-87da-e7d0588c5ba9",
                                "text": "Met behulp van de Segway PT is elke politiebeambte of beveiligingsmedewerker in staat om in een kortere tijd een groter gebied te bestrijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66d28594-af34-45b9-bf20-7bad8783833f",
                        "source_entry_id": "74334191-8f96-3f29-a194-1864ce513c9b",
                        "source_sense_id": "06c8ea71-9611-3a09-87da-e7d0588c5ba9",
                        "source_sense_description": "iemand die in dienst is van de politie",
                        "target_lang_word": "Polizeibeamter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizeibeamter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                        "entry_id": "86f77a86-9cf5-3466-b2b9-afb496e201df",
                                        "glosses": [
                                            "Beamter bei der Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e8db3f-49fa-4788-9dc5-e07ee440b0da",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "Der Polizeibeamte konnte den Täter auf frischer Tat erwischen."
                                            },
                                            {
                                                "example_id": "beefcb45-18ee-44b7-bcaa-efbba8d2199e",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Im Frühjahr 2014 wurde eine Reportage über Gewalt und Respektlosigkeit gegenüber Polizeibeamten im Fernsehen gezeigt.“"
                                            },
                                            {
                                                "example_id": "0a8d45f0-89b6-43e3-bef5-b78f5263754e",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Bei Vernehmungen haben die Angeklagten inzwischen ausgesagt, dass Patrick, die Nummer zwei in der Hierarchie, immer wieder mal von Polizeibeamten über geplante Einsätze informiert worden sei.“"
                                            },
                                            {
                                                "example_id": "aeb4257b-3478-4828-b97b-5f4b96764409",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Eigil erhob sich, als er sah, wie die beiden Polizeibeamten auf das Grab zukamen.“"
                                            },
                                            {
                                                "example_id": "4f161c9a-ce92-46fc-81ac-0494fe075d95",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Ich fing wirklich an, mir die Möglichkeit zu denken, daß ich einen Polizeibeamten vor mir hätte, darum antwortete ich auch der Wahrheit gemäß, daß ich aus Finnland käme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8c24ba3-b928-4267-9804-e7e9d06e760d",
                        "source_entry_id": "74334191-8f96-3f29-a194-1864ce513c9b",
                        "source_sense_id": "06c8ea71-9611-3a09-87da-e7d0588c5ba9",
                        "source_sense_description": "iemand die in dienst is van de politie",
                        "target_lang_word": "Polizist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                        "entry_id": "4e0b0e4d-ce09-3c07-b95e-829afca8bbb7",
                                        "glosses": [
                                            "Angehöriger der Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573a6e95-efd0-4288-8b32-5518642bd897",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "Die Polizisten verhafteten 21 gewalttätige Demonstranten."
                                            },
                                            {
                                                "example_id": "2ed6e61a-9a8a-47e2-8796-4ba0dab04ea3",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "cb549a3e-613b-4b88-9410-e6886a0b8b23",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Im März 1954 treiben Aufständische 30 Polizisten zusammen, sperren sie in ein Haus und zünden es an.“"
                                            },
                                            {
                                                "example_id": "4c43b5b6-68ea-468d-a341-038de7ac6bd7",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Einer der Polizisten schob sie heftig zur Seite, und sie bekam vor Angst weiche Knie.“"
                                            },
                                            {
                                                "example_id": "eeb75324-6e61-48b5-9a2c-546cd4b03963",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Ein junger Polizist eilte den Gang herunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
