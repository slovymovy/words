                "senses": [
                    {
                        "sense_id": "8d4cfde9-cc17-3702-bf35-1a0e4793b81f",
                        "entry_id": "8b58e186-091c-3f8d-a243-8fe4212500a2",
                        "glosses": [
                            "Huile pyrogénée, mêlée de goudron, qu’on obtient en brûlant dans des vaisseaux clos l’épiderme du bouleau, et qui donne au cuir de Russie son odeur particulière."
                        ],
                        "tags": [
                            "Travail du cuir"
                        ],
                        "examples": [
                            {
                                "example_id": "cd950883-9189-4e73-99df-cafc7f73078f",
                                "sense_id": "8d4cfde9-cc17-3702-bf35-1a0e4793b81f",
                                "text": "Jʼai appris quʼen brûlant lʼécorce du bouleau on obtient une huile, le diogot, qui donne son odeur particulière au cuir de Russie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b67dbbc-76a2-4890-9ae2-0bab1ee798f1",
                        "source_entry_id": "8b58e186-091c-3f8d-a243-8fe4212500a2",
                        "source_sense_id": "8d4cfde9-cc17-3702-bf35-1a0e4793b81f",
                        "target_lang_word": "дёготь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дёготь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "40858b17-7ae6-3c5a-b8a5-a4b7f69f79f1",
                                        "entry_id": "074a0159-305a-388e-ac20-ae0baa342e00",
                                        "glosses": [
                                            "густая тёмная смолистая жидкость с запахом, получаемая путём сухой перегонки (пиролиза) каменного или бурого угля, сланца, древесины или торфа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d0875f-db55-43bd-9f4f-4410b71fe315",
                                                "sense_id": "40858b17-7ae6-3c5a-b8a5-a4b7f69f79f1",
                                                "text": "— Хозяин! Дёготь у вас хороший есть? — Такого дёгтю, любезный, у твоего деда на свадьбе не было!"
                                            },
                                            {
                                                "example_id": "98d76cda-bac2-4073-80d9-3ca430d1bd05",
                                                "sense_id": "40858b17-7ae6-3c5a-b8a5-a4b7f69f79f1",
                                                "text": "Перегонкой берёзы и осины получают обычно дёготь, из которого научились, кроме его прямого использования для консервирования, получать уксусную кислоту, спирт, ацетон, гваякол и пр."
                                            },
                                            {
                                                "example_id": "f5b0f3c8-5e2e-4681-928e-4e2406048e7a",
                                                "sense_id": "40858b17-7ae6-3c5a-b8a5-a4b7f69f79f1",
                                                "text": "Дёготь добывается из бересты́. ❬…❭ Когда корчага нагреется до соответствующей температуры, береста́ тлеет без горения пламени и из неё по трубопроводу стекает дёготь — тёмно-коричневая маслянистая жидкость приятного, неповторимого ничем запаха."
                                            },
                                            {
                                                "example_id": "9ae37602-d1eb-417f-8c43-a73bf9fd6ecb",
                                                "sense_id": "40858b17-7ae6-3c5a-b8a5-a4b7f69f79f1",
                                                "text": "Значительное место занимала сухая перегонка дерева: выделывали дёготь, вар, смолу, скипидар, канифоль. ❬…❭ Дёготь был просто необходим в каждом хозяйстве как смазочный материал для колёс, механизмов, кожаных сапог."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
