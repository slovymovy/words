                                            {
                                                "example_id": "c34b262d-3e7b-426c-af50-64637a9cdf26",
                                                "sense_id": "fa327e48-1009-3cc0-b798-18139d886e07",
                                                "text": "I’ve been visiting Saudi Arabia for close to two decades and in that time I’ve experienced some incredible things."
