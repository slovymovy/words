                "senses": [
                    {
                        "sense_id": "86f23d99-b8bd-3d61-a004-87b80b2ec0b5",
                        "entry_id": "f9202d69-16d2-3636-934b-fdcda9ae5adf",
                        "glosses": [
                            "informelles Treffen am Abend, wo Leute zusammenkommen, um eine angenehme Zeit miteinander zu verbringen; oft beinhaltet es Aktivitäten wie gemeinsames Essen, Musizieren oder Kartenspielen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "139e7526-6f0a-475b-876e-ce84a1ed4615",
                                "sense_id": "86f23d99-b8bd-3d61-a004-87b80b2ec0b5",
                                "text": "„Während der ersten drei Monate meines Aufenthalts in Rom war der Verein die Hauptstätte der Abendgeselligkeit des Freundeskreises, dem ich angehörte.“"
                            },
                            {
                                "example_id": "4060e77a-ed27-49b4-8978-6452e033a25d",
                                "sense_id": "86f23d99-b8bd-3d61-a004-87b80b2ec0b5",
                                "text": "„Eines Tages nun aber, wie das wohl ohne besonderen Anlaß einmal geschehen mochte, hatte die Abendgeselligkeit in Halle und Zimmern sich reger als alltäglich gestaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
