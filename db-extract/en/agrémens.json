                            {
                                "example_id": "780fc00e-dbec-4f8f-ba21-53ce8366c339",
                                "sense_id": "69873f52-9188-3122-b349-d09cd89be84d",
                                "text": "When to this was added the state dinners, to which she was always regularly invited, and held as a distinguished guest, and it was remembered how seldom this occurred in other houses since her widowhood, the vacillating mind took a new direction, and it was voted an impracticable thing to part with the baroness and her atmosphere of agrémens."
                            },
                            {
                                "example_id": "7442cadf-0c64-4411-bd9f-c920ae98e868",
                                "sense_id": "69873f52-9188-3122-b349-d09cd89be84d",
                                "text": "Arthur Young, that shrewd plucky traveller, smiled as we do at the tedious repetition of the agrémens of beautiful Paris."
                            },
                            {
                                "example_id": "9fb422ae-b54e-4ac6-8430-e72ab84e4c9d",
                                "sense_id": "69873f52-9188-3122-b349-d09cd89be84d",
                                "text": "The impressions which I had previously conceived were confirmed that there was no place in the world in which the agrémens of life are so accessible at so little cost by an individual who lives only for himself..."
                            },
                            {
                                "example_id": "b0de54e2-58e0-4fbb-b704-743dd394a4f4",
                                "sense_id": "69873f52-9188-3122-b349-d09cd89be84d",
                                "text": "\"I was the principal witness for the prosecution in this cause célèbre, with all the agrémens that attend that enviable position.\""
                            }
                        ]
                    }
