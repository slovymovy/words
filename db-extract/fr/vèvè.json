                    {
                        "sense_id": "885c708f-b3d4-3ac0-a760-944029b10728",
                        "entry_id": "80ef2011-7ba1-3333-97bf-cc081255ba14",
                        "glosses": [
                            "Symbole dessiné d’un esprit."
                        ],
                        "tags": [
                            "Vaudou"
                        ],
                        "examples": [
                            {
                                "example_id": "1a3a15ae-6119-4421-8b17-8912a616de00",
                                "sense_id": "885c708f-b3d4-3ac0-a760-944029b10728",
                                "text": "Cette forme « cannibale », comme le formule Baudrillard, de la culture haïtienne continue aujourd’hui de saper et miner l’institution catholique : même le père Aristide, avant son élection à la présidence, affichait durant ses prêches, sur le dos de sa soutane, des vèvès, ces dessins mystiques du vaudou."
                            },
                            {
                                "example_id": "30fc589a-f422-40ab-b855-181d7315ad95",
                                "sense_id": "885c708f-b3d4-3ac0-a760-944029b10728",
                                "text": "Le tracé des vèvè n’est pas donc extérieur au vaudou."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b290ea5d-7db4-4dff-8160-aaa1a3482e80",
                        "source_entry_id": "80ef2011-7ba1-3333-97bf-cc081255ba14",
