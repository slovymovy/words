                                "target_senses": [
                                    {
                                        "sense_id": "d3f8a683-06c1-3ee0-be77-fe1d32b8962e",
                                        "entry_id": "3dcb1900-71ce-3daf-b63b-ce9243913fe0",
                                        "glosses": [
                                            "A person who is addicted, especially to a harmful drug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dce4141-f7b4-4cf0-b3b2-238b8b507932",
                                                "sense_id": "d3f8a683-06c1-3ee0-be77-fe1d32b8962e",
                                                "text": "a heroin addict"
                                            },
                                            {
                                                "example_id": "278b3bb2-e5bb-402f-9694-bf92d42b36a4",
                                                "sense_id": "d3f8a683-06c1-3ee0-be77-fe1d32b8962e",
                                                "text": "He is an addict when it comes to chocolate cookies."
                                            },
                                            {
                                                "example_id": "cf76fece-088d-413d-b360-72fd26202cd8",
                                                "sense_id": "d3f8a683-06c1-3ee0-be77-fe1d32b8962e",
                                                "text": "Those nonaddicts who picked a winning card had increased blood flow to the striatum, but the gambling addicts who picked the right card had much less of it (their reward system was less active)."
                                            },
                                            {
                                                "example_id": "21206f82-edd9-425b-a499-e61898f47545",
                                                "sense_id": "d3f8a683-06c1-3ee0-be77-fe1d32b8962e",
                                                "text": "A stressful environment in which there is ready access to drugs can trump a low genetic risk of addiction in these animals. The same may be true for humans, too. And that’s a notion many find hard to believe: Just about anyone, regardless of baseline genetic risk, can become an addict under the right circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510fa9f7-877a-31de-9fd0-13d5b578cefa",
                                        "entry_id": "3dcb1900-71ce-3daf-b63b-ce9243913fe0",
                                        "glosses": [
                                            "An adherent or fan (of something)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
