                "senses": [
                    {
                        "sense_id": "68c82779-20e3-35f7-a53b-6a060cfb200b",
                        "entry_id": "d4458239-2ac5-30bd-abd0-107fb9457f61",
                        "glosses": [
                            "thawed patch, glade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "893b8608-dd72-427a-b3bb-d596b15c2de6",
                                "sense_id": "68c82779-20e3-35f7-a53b-6a060cfb200b",
                                "text": "В прота́лины о́кон был ви́ден ослепи́тельно сверка́ющий снег на кры́шах, искри́лись сере́бряные че́пчики на столба́х забо́ра и скворе́шне.",
                                "translation": "Through the thawed patches on the window I could see the dazzling white snow on the roofs, forming sparkling silver caps on the fences and starling-box.",
                                "english": "Through the thawed patches on the window I could see the dazzling white snow on the roofs, forming sparkling silver caps on the fences and starling-box."
                            }
                        ]
                    }
                ],
