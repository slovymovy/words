                        "glosses": [
                            "Relatif à une réaction d’oxydoréduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee5b6e8-169c-474d-9b60-97c2a2080617",
                                "sense_id": "c92bac6a-a961-3fa3-ae1e-b3c6f8c3581e",
                                "text": "L’oxydation (ou la réduction) d’une substance est toujours couplée à la réduction (ou à l’oxydation) d’une autre substance. On parle de réactions d’oxydoréduction ou de réactions redox."
                            },
                            {
                                "example_id": "20e1107b-a44f-42ba-90e9-c2e08e8f3a1a",
                                "sense_id": "c92bac6a-a961-3fa3-ae1e-b3c6f8c3581e",
                                "text": "Un couple redox donné constitue une demi-pile, il faut donc utiliser un autre système redox pour constituer une pile dont on mesurera la f.e.m."
                            }
                        ]
                    }
                ],
