                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e59b728e-1f94-378d-b01b-c8ae60d87414",
                                        "entry_id": "9c1889c6-3bbd-3caf-ac15-e2e25d18b445",
                                        "glosses": [
                                            "A judgment, sentence, or final decision. Specifically: The decision of arbitrators in a case submitted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da17f5e0-a23c-42cc-b6bc-74b7bf981aa4",
                                                "sense_id": "e59b728e-1f94-378d-b01b-c8ae60d87414",
                                                "text": "Citing the damages that Ms. Lewis and Mr. Heslin had requested, Mr. Jones called the award a “major victory” in a video posted on Infowars on Thursday night, even as he urged viewers to buy products from his website to stave off what he portrayed as financial ruin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f3d0dcc-2614-3f6e-a765-8daaf15bc252",
                                        "entry_id": "9c1889c6-3bbd-3caf-ac15-e2e25d18b445",
                                        "glosses": [
                                            "The paper containing the decision of arbitrators; that which is warded."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de026d99-8bca-31eb-8e39-7442be1bfdb5",
                                        "entry_id": "9c1889c6-3bbd-3caf-ac15-e2e25d18b445",
                                        "glosses": [
                                            "Funding that has been granted for the conduct of a research project."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "559a60b9-854d-3469-a1a5-35a3a1eff1d8",
                                        "entry_id": "9c1889c6-3bbd-3caf-ac15-e2e25d18b445",
                                        "glosses": [
                                            "A trophy or medal; something that denotes an accomplishment, especially in a competition. A prize or honor based on merit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71b2856c-a811-30d3-874d-826e3630e73a",
                                        "entry_id": "9c1889c6-3bbd-3caf-ac15-e2e25d18b445",
                                        "glosses": [
                                            "A negotiated set of employment conditions and minimum wages for a particular trade or industry; an industrial award."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6936d3f-fbab-43a1-b260-a6cf858b0189",
                                                "sense_id": "71b2856c-a811-30d3-874d-826e3630e73a",
                                                "text": "The AMIEU^([Australasian Meat Industry Employees Union]) first developed into a powerful organisation in the early years of the twentieth century, and after the first industry-wide collective agreement was made in 1911, collective bargaining prevailed in the industry until 1917, when the employers sought an award from the Queensland Industrial Court. The first award was issued on March 12, 1918."
                                            },
                                            {
                                                "example_id": "b9dffe58-34a8-40aa-8ca0-4ef2b05b142d",
                                                "sense_id": "71b2856c-a811-30d3-874d-826e3630e73a",
                                                "text": "A further 17 per cent responded that the agreement replaced ‘most’ aspects of the award, leaving the large majority (67 per cent) claiming that the agreement replaced only ‘some’ aspects of the award."
                                            },
                                            {
                                                "example_id": "223b2dac-c6c3-4b53-8db7-6c6a457e8af6",
                                                "sense_id": "71b2856c-a811-30d3-874d-826e3630e73a",
                                                "text": "Employees whose pay is set by ‘award only’ are those who have their pay set by an award, and who are not paid more than the award rate of pay."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "award",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0481d3f6-4ab4-3477-9b98-2ecda741175f",
                                        "entry_id": "7ecabb5f-0720-3b88-9076-df1f814306de",
                                        "glosses": [
                                            "To determine; to make or grant an award."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3085fb88-5790-41ef-b50a-2debe676c816",
                                                "sense_id": "0481d3f6-4ab4-3477-9b98-2ecda741175f",
                                                "text": "To assert its control, Vietnam has since established Spratly Island as a township in Truòng Sa district, organized local elections and tours in the Spratlys, and has continued to award oil exploration contracts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69dbf866-f76c-3076-b8e0-61e00fafd99b",
                                        "entry_id": "7ecabb5f-0720-3b88-9076-df1f814306de",
                                        "glosses": [
                                            "To give (an award)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05ff869a-898b-4fcf-9787-307a325de1c0",
                                                "sense_id": "69dbf866-f76c-3076-b8e0-61e00fafd99b",
                                                "text": "Four or five of these medals are awarded every year."
                                            },
                                            {
                                                "example_id": "81dee25e-8b9d-4813-ae75-1ff8916f929b",
                                                "sense_id": "69dbf866-f76c-3076-b8e0-61e00fafd99b",
                                                "text": "He was awarded the Nobel Prize for Literature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a042701-f7d3-3330-8055-611ea0e613be",
                                        "entry_id": "7ecabb5f-0720-3b88-9076-df1f814306de",
                                        "glosses": [
                                            "To give (a person) an award."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bd9ce0c-bba5-405d-8a99-967f2e4cee22",
                                                "sense_id": "7a042701-f7d3-3330-8055-611ea0e613be",
                                                "text": "He was awarded with the Nobel Prize for Literature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce08842e-cf28-36c7-9e33-10b6dc8f233c",
                                        "entry_id": "7ecabb5f-0720-3b88-9076-df1f814306de",
                                        "glosses": [
                                            "To give by sentence or judicial determination; to assign or apportion, after careful regard to the nature of the case."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdcea767-d3aa-47d7-86a0-5746815674bb",
                                                "sense_id": "ce08842e-cf28-36c7-9e33-10b6dc8f233c",
                                                "text": "The arbitrators awarded damages to the complainant."
                                            },
                                            {
                                                "example_id": "c179c455-7818-4b30-8beb-a83945389988",
                                                "sense_id": "ce08842e-cf28-36c7-9e33-10b6dc8f233c",
                                                "text": "To review / The wrongful sentence, and award a new."
                                            },
                                            {
                                                "example_id": "36e711b5-d00d-4233-ba5d-163411568852",
                                                "sense_id": "ce08842e-cf28-36c7-9e33-10b6dc8f233c",
                                                "text": "Power to award compensation"
                                            },
                                            {
                                                "example_id": "12ef1407-6183-4aba-934f-61ae9d17a777",
                                                "sense_id": "ce08842e-cf28-36c7-9e33-10b6dc8f233c",
                                                "text": "A Texas jury on Thursday awarded the parents of a child killed in the 2012 mass shooting at Sandy Hook Elementary School more than $4 million in compensatory damages from the conspiracy theorist Alex Jones, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd659847-42d3-344c-96cc-82036f4c7992",
                                        "entry_id": "7ecabb5f-0720-3b88-9076-df1f814306de",
                                        "glosses": [
                                            "(in an examination) To give marks for a correct answer."
                                        ],
                                        "tags": [
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d20ad0f-1b48-4b76-b12f-028edc77612a",
                                                "sense_id": "cd659847-42d3-344c-96cc-82036f4c7992",
                                                "text": "Do not award marks for data from previous questions."
                                            }
