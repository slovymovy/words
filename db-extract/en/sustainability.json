                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3169bab3-cb84-4225-a1bc-ce46f9abf445",
                                                "sense_id": "fd52ae78-4ad5-322b-95b8-fe5ef17b7b2a",
                                                "text": "De duurzaamheid van dit materiaal is spreekwoordelijk."
                                            },
                                            {
                                                "example_id": "7c7ddac1-05a6-446e-910f-0e99e19f4d29",
                                                "sense_id": "fd52ae78-4ad5-322b-95b8-fe5ef17b7b2a",
                                                "text": "Maandenlang had ik alle specificaties van tenten bestudeerd: gewicht, ruimte, kosten, duurzaamheid, dubbelwandig, enkelwandig, vrijstaand, camouflagemotief, cuben fiber en nylon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9cc953b-1235-37cf-aa23-3e1e2a52bd24",
                                        "entry_id": "b8212192-2145-3f55-bcba-cea4ec32bb74",
                                        "glosses": [
                                            "het vermogen niet tot uitputting of vervuiling te voeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a3d622-c65c-413b-9661-fe56a36a20c0",
                                                "sense_id": "c9cc953b-1235-37cf-aa23-3e1e2a52bd24",
                                                "text": "De duurzaamheid van zonne-energie is een aantrekkelijke zaak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d912de8-cc40-4d8d-b334-977541b311bb",
                        "source_entry_id": "60d7e7d0-56db-3734-b87a-6a22f606910f",
