                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c0ca3de-5b7a-4452-a76b-b368a75520b4",
                                                "sense_id": "074a1570-4110-3322-8202-79585e133e33",
                                                "text": "As the other persons in the Castle, on whom such tasks were delegated, readily imitated the prudential conduct of the major-domo, there was little controul used towards Roland Græme, who, of course, learned no more than what a very active mind, and a total impatience of absolute idleness, led him to acquire upon his own account, and by dint of his own exertions."
                                            }
