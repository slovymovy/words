                "senses": [
                    {
                        "sense_id": "2fd41a1c-5a9c-3f59-bc29-f8d6e06c8d1d",
                        "entry_id": "bbfafa91-d33f-39b9-8699-7155fd455f92",
                        "glosses": [
                            "de volksvertegenwoordiging van een gemeente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e41ddd22-4ce5-4fe7-9d6a-1ce7670852e8",
                                "sense_id": "2fd41a1c-5a9c-3f59-bc29-f8d6e06c8d1d",
                                "text": "De gemeenteraad werd door de bevolking gekozen."
                            },
                            {
                                "example_id": "7581b8ae-08c5-4b43-84a7-ee7d7f176182",
                                "sense_id": "2fd41a1c-5a9c-3f59-bc29-f8d6e06c8d1d",
                                "text": "De PVV vindt het groene waarschuwingsbord bij Kinderboerderij Het Weusthag dat deels in het Turks is geschreven ‘een doorn in het oog’. Fractievoorzitter Jeanet Nijhof van de PVV in de gemeenteraad heeft er vragen over gesteld aan het college van b en w."
                            },
                            {
                                "example_id": "557992ef-f6b4-4ca6-8e8e-7511ae0a6537",
                                "sense_id": "2fd41a1c-5a9c-3f59-bc29-f8d6e06c8d1d",
                                "text": "Het voorgestelde restauratieplan van de nieuwe eigenaar is in te zien op de website van Paleis Soestdijk. Of het ook wordt uitgevoerd, is nog niet helemaal zeker. De gemeenteraad moet het eerst nog goedkeuren, iets waar al langer over wordt gesteggeld."
                            },
                            {
                                "example_id": "d835b5a4-86d6-40be-a6a7-decb577a9003",
                                "sense_id": "2fd41a1c-5a9c-3f59-bc29-f8d6e06c8d1d",
                                "text": "Het aantal meldingen van rattenoverlast in Amsterdam is vorig jaar weer toegenomen. In 2024 ontving de gemeente 6800 meldingen, 600 meer dan het jaar daarvoor, meldt wethouder publieke gezondheid en preventie Alexander Scholtes in een brief aan de gemeenteraad."
                            }
                        ]
                    },
                    {
                        "sense_id": "25fd6a19-2866-35a1-8210-93c9d5754fac",
                        "entry_id": "bbfafa91-d33f-39b9-8699-7155fd455f92",
                        "glosses": [
