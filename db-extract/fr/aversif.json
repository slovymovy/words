                ],
                "senses": [
                    {
                        "sense_id": "6efafccd-ddc9-35e2-bff8-c640f36583e0",
                        "entry_id": "62f637b9-47c5-3071-9af1-7e2636ab508e",
                        "glosses": [
                            "Relatif à l’aversion ; qui provoque cette dernière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb9b7962-4f8e-455b-8d0a-397da4953f75",
                                "sense_id": "6efafccd-ddc9-35e2-bff8-c640f36583e0",
                                "text": "Il évite un événement de l'environnement lorsqu'il produit un comportement ou une séquence de comportements pour ne pas être confronté ou être moins exposé à un événement aversif."
                            },
                            {
                                "example_id": "d361041f-0b11-4e4e-89bf-397d191841f0",
                                "sense_id": "6efafccd-ddc9-35e2-bff8-c640f36583e0",
                                "text": "L'ensemble des résultats montre le déclenchement d'un comportement de combat lié à la réception de stimulations « aversives », plus ou moins sévères (Ulrich et al., 1962 ; Azrin, Hutchinson & Hake, 1963 cités par Pahlavan)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bca335e-37ac-3348-a2f1-778a5503d028",
                        "entry_id": "62f637b9-47c5-3071-9af1-7e2636ab508e",
                        "glosses": [
                            "Cas grammatical de certaines langues aborigènes indiquant l'aversion de la personne qui s'exprime pour l'élément ainsi décliné."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13986c12-06c5-4b65-96e9-100e8dd37cdb",
