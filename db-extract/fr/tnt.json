                                        "entry_id": "8628d184-8e05-3875-81bf-dd4dc8ae40b3",
                                        "glosses": [
                                            "An illegal immigrant."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
