                "senses": [
                    {
                        "sense_id": "3207ab21-f0c5-30ba-96e6-7c78393bed74",
                        "entry_id": "517ba4a4-7659-36ea-a73e-aab4c48f01e3",
                        "glosses": [
                            "Action par laquelle un être retrouve son intégrité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e592157-109c-438e-9abe-3da33dc0ed0e",
                                "sense_id": "3207ab21-f0c5-30ba-96e6-7c78393bed74",
                                "text": "Synthèse organique, génération, régénération, rédintégration et même cicatrisation sont des aspects du même phénomène, des manifestations variées d’un même agent, le germe."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f9d2b74-30a7-36dd-826d-eed798d9a113",
                        "entry_id": "517ba4a4-7659-36ea-a73e-aab4c48f01e3",
                        "glosses": [
                            "Réparation des forces ou d’une partie du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b41e32-039d-47e5-bce6-7b577b784b5d",
                                "sense_id": "9f9d2b74-30a7-36dd-826d-eed798d9a113",
                                "text": "Coupés en deux, les lombrics continuent à vivre séparément, c'est ce que l'on appelle la rédintégration."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54528a1c-4796-42af-9560-a928e4969ae4",
                        "source_entry_id": "517ba4a4-7659-36ea-a73e-aab4c48f01e3",
