                                        "examples": [
                                            {
                                                "example_id": "1b77da4a-4c7b-424b-8978-035f16df636a",
                                                "sense_id": "edfee0af-d86a-31ef-85ae-37c68cec6c04",
                                                "text": "In nibbing the pen, place the inside of the point flat upon the nail of your left-hand thumb (holding the quill between the first and second finger of that hand), and let the whole length of the split be extended thereon, to steady the pen as much as possible […]"
                                            }
