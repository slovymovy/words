                        "entry_id": "b461cd15-8f81-3c7c-a191-2ac4f1fedf2f",
                        "glosses": [
                            "Donner un caractère de prototype à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac9424c-35f5-4278-8e16-6db6df5873f7",
                                "sense_id": "4f90125c-4475-3913-931b-3da49ffb6b88",
                                "text": "Le coréen peut prototypiser l’usage d’un nom générique du type estomac affamé ou gorge desséchée."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7114ed1-9055-3f28-9f6c-e8c26476dc33",
                        "entry_id": "b461cd15-8f81-3c7c-a191-2ac4f1fedf2f",
                        "glosses": [
                            "Être un prototype pour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0562dba-e209-4fb8-896f-e41fa22323dd",
                                "sense_id": "e7114ed1-9055-3f28-9f6c-e8c26476dc33",
                                "text": "En ce temps de matérialisme jouisseur, de platitude morale — du moins Balzac le dit, — où trouver des saints, des héros, qui prototypisent le catholicisme ?"
                            }
                        ]
                    }
