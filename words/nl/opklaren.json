{
    "word_family": [
        "klaren",
        "verklaren",
        "opklaring",
        "klaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd08b1f5-2bba-30f0-8e5a-50d34a99f2dd",
                    "sense_definition": "het minder bewolkt worden van de lucht zodat de zon of sterren zichtbaar worden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plotseling <w>klaarde</w> het <w>op</w> en brak de zon door.",
                            "target_lang_translations": {
                                "en": "Suddenly it <w>cleared up</w> and the sun broke through."
                            }
                        },
                        {
                            "text": "De weerman zegt dat het vanmiddag eindelijk zal <w>opklaren</w> na de regen.",
                            "target_lang_translations": {
                                "en": "The weatherman says it will finally <w>clear up</w> this afternoon after the rain."
                            }
                        }
                    ],
                    "synonyms": [
                        "optrekken",
                        "uitklaren"
                    ],
                    "antonyms": [
                        "betrekken",
                        "bewolken"
                    ],
                    "common_phrases": [
                        "het weer klaart op",
                        "langzaam opklaren"
                    ],
                    "target_lang_definitions": {
                        "en": "the sky becoming less cloudy so that the sun or stars become visible"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear up",
                                "target_lang_sense_clarification": "of the weather or sky"
                            },
                            {
                                "target_lang_word": "brighten up",
                                "target_lang_sense_clarification": "when the sun starts to shine"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39087c54-bb47-30b4-8d59-d39e58e39053",
                    "sense_definition": "een vrolijker of optimistischer gezichtsuitdrukking of stemming krijgen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het leek of de gezichten in de zaal een beetje <w>opklaarden</w> bij het goede nieuws.",
                            "target_lang_translations": {
                                "en": "It seemed as if the faces in the room <w>brightened up</w> a bit at the good news."
                            }
                        },
                        {
                            "text": "Zijn sombere gezicht <w>klaarde</w> meteen <w>op</w> toen hij zijn vrienden zag.",
                            "target_lang_translations": {
                                "en": "His gloomy face <w>lit up</w> immediately when he saw his friends."
                            }
                        }
                    ],
                    "synonyms": [
                        "opvrolijken",
                        "stralen"
                    ],
                    "antonyms": [
                        "betrekken",
                        "verstrakken"
                    ],
                    "common_phrases": [
                        "gezicht klaart op"
                    ],
                    "target_lang_definitions": {
                        "en": "to get a more cheerful or optimistic facial expression or mood"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brighten up",
                                "target_lang_sense_clarification": "of a person's face or mood"
                            },
                            {
                                "target_lang_word": "light up",
                                "target_lang_sense_clarification": "of a face showing sudden joy"
                            },
                            {
                                "target_lang_word": "cheer up",
                                "target_lang_sense_clarification": "to become happier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bab1195d-20fa-37e3-b97e-947122dab0f8",
                    "sense_definition": "een onduidelijke situatie of een raadsel begrijpelijk maken of oplossen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "begrip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie hoopt dat dit nieuwe bewijs de zaak snel zal <w>opklaren</w>.",
                            "target_lang_translations": {
                                "en": "The police hope that this new evidence will <w>clear up</w> the case quickly."
                            }
                        },
                        {
                            "text": "Na een goed gesprek konden we het misverstand volledig <w>opklaren</w>.",
                            "target_lang_translations": {
                                "en": "After a good conversation, we were able to completely <w>resolve</w> the misunderstanding."
                            }
                        }
                    ],
                    "synonyms": [
                        "ophelderen",
                        "verduidelijken",
                        "oplossen"
                    ],
                    "antonyms": [
                        "compliceren",
                        "verwarren"
                    ],
                    "common_phrases": [
                        "een misverstand opklaren",
                        "een zaak opklaren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make an unclear situation or a mystery understandable or to solve it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear up",
                                "target_lang_sense_clarification": "to resolve a misunderstanding or mystery"
                            },
                            {
                                "target_lang_word": "clarify",
                                "target_lang_sense_clarification": "to make something clear or easier to understand"
                            },
                            {
                                "target_lang_word": "resolve",
                                "target_lang_sense_clarification": "to find a solution to a problem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}