                        "form": "grandiloquente"
                    },
                    {
                        "form_id": "dd44673b-e42a-493c-b10b-bbebad255a86",
                        "entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "grandiloquentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5dbe418e-6a2d-3fa8-a7b4-02c92995851f",
                        "entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "glosses": [
                            "Qui s’exprime avec grandiloquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "675c396f-354f-4ad9-a6c3-7163755f8b35",
                                "sense_id": "5dbe418e-6a2d-3fa8-a7b4-02c92995851f",
                                "text": "Ginginet, tu es grandiloquent comme feu Cicéron lui-même, mais tu m’embêtes !"
                            },
                            {
                                "example_id": "fe7a4e35-97e9-4bc8-9d0a-e8322245778e",
                                "sense_id": "5dbe418e-6a2d-3fa8-a7b4-02c92995851f",
                                "text": "Hans avait une furieuse envie de rire au nez de ce polichinelle grandiloquent, à qui il ne manquait que la redingote, le col à manger de la tarte et l’écharpe mayorale pour personnifier le stupide-fonctionnaire-conscient-de-son-importance."
                            },
                            {
                                "example_id": "040d8ba8-d546-4fe0-816e-2cf94989e2d9",
                                "sense_id": "5dbe418e-6a2d-3fa8-a7b4-02c92995851f",
                                "text": "Jeudi, le nouveau chef des conservateurs ne s'était montré pas moins grandiloquent devant les députés en affirmant que les termes de l'accord de retrait sont « inacceptables pour ce gouvernement et ce pays »."
                            }
                        ]
                    },
                    {
                        "sense_id": "3db51c32-e3cd-3d77-9c03-b8ee9cc3a9f7",
                        "entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "glosses": [
                            "Où il y a de la grandiloquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a364c4ed-86bd-413a-a81a-2434bc65a281",
                                "sense_id": "3db51c32-e3cd-3d77-9c03-b8ee9cc3a9f7",
                                "text": "Le décalage s’introduit même dans la narration, entre le style grandiloquent d’un récit et l'extrême platitude des dialogues, dans le Mystère de la crypte ensorcelée."
                            },
                            {
                                "example_id": "0beb105c-9055-4740-aeb9-c8aeff3f7a9d",
                                "sense_id": "3db51c32-e3cd-3d77-9c03-b8ee9cc3a9f7",
                                "text": "Lorsque Jean Sarkozy est tenté de se faire parachuter par son président de père à la tête de l’Épad (Établissement public d’aménagement de La Défense), en 2009, Griveaux se fend d’une tribune grandiloquente qu’il envoie à « Libération »."
                            },
                            {
                                "example_id": "3cdd5e54-4935-40b5-983e-b9cc267e7938",
                                "sense_id": "3db51c32-e3cd-3d77-9c03-b8ee9cc3a9f7",
                                "text": "En revanche, quel dommage que ces déclarations grandiloquentes et mélodramatiques soient en totale contradiction avec la triste réalité qui nous entoure !"
                            },
                            {
                                "example_id": "479e9749-cc49-4d0b-83f7-0bdd0ae5780c",
                                "sense_id": "3db51c32-e3cd-3d77-9c03-b8ee9cc3a9f7",
                                "text": "Je débitais un à un le chapelet de pseudonymes sonores et grandiloquents, chargés d'exprimer tout ce que je ressentais, tout ce que je voulais lui offrir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efd59e0b-7c6c-4ce1-a38d-2e5270d7f4e6",
                        "source_entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "target_lang_word": "hochtrabend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hochtrabend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                        "entry_id": "970f00c1-0c39-336f-a20e-d5cdb92b6145",
                                        "glosses": [
                                            "übertrieben vornehm und dabei ohne Inhalt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd1f4ff-e848-489e-ba7d-be6b34c77868",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "Dieses hochtrabende Gerede hätte er sich sparen können."
                                            },
                                            {
                                                "example_id": "3b48daf7-c3f2-4eb2-b624-ac14321b0003",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "„Unter solchen Umständen können auch die hochtrabendsten Redensarten von Höhe und Tiefe der Kunst, von den großen Aufgaben der Gegenwart und den strengsten Anforderungen an ihre Leistungen kein sonderliches Vertrauen erwecken.“"
                                            },
                                            {
                                                "example_id": "edfdfec4-a862-4529-8d1a-493a3c41d7cf",
                                                "sense_id": "64da9fd4-9e4b-335f-a729-1406a6b7ba61",
                                                "text": "„Die Affichen sind mit hochtrabenden Namen unterfertigt, »Hochschule für geheime Wissenschaften«, »Gelehrte Gesellschaft für okkultes Wissen« und so weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13f08a66-64eb-45dd-9669-553ff314447e",
                        "source_entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "target_lang_word": "grandiloquent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandiloquent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "400423a9-c04e-34c2-8adb-2ff429751280",
                                        "entry_id": "d4e1299b-e682-3d7c-a639-7a0ae5c33a6c",
                                        "glosses": [
                                            "Given to using language in a showy way by using an excessive number of difficult words to impress others; bombastic; turgid."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a764eb62-4b34-4845-9d09-b221ddfa41a0",
                                                "sense_id": "400423a9-c04e-34c2-8adb-2ff429751280",
                                                "text": "The American people believe that they have a free country, and we are treated to grandiloquent speeches about our flag and our reputation for freedom and enlightenment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13a0ae46-52de-4ba3-92bf-3a96bbdb1fae",
                        "source_entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "target_lang_word": "grandilocuente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandilocuente",
