                        "form": "die Straßenseiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f29ad854-0eeb-3391-9a9f-b1358e47d268",
                        "entry_id": "76248fbc-0fdf-35ef-aee9-26ac7fdb93e4",
                        "glosses": [
                            "Teil einer Straße rechts oder links der Mitte, sowie der Bereich der rechts oder Links einer Straße liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37fc4cf-8126-4871-a2eb-8faedf3ca76b",
                                "sense_id": "f29ad854-0eeb-3391-9a9f-b1358e47d268",
                                "text": "In Kontinentaleuropa fährt man auf der rechten Straßenseite, in Großbritannien auf der linken."
                            },
                            {
                                "example_id": "7d739eb5-1415-4284-a120-5795b5817172",
                                "sense_id": "f29ad854-0eeb-3391-9a9f-b1358e47d268",
                                "text": "Sie setzten sich in das Café auf der anderen Straßenseite."
                            },
                            {
                                "example_id": "c2425c65-ea0b-4e3f-801f-baf66c116779",
                                "sense_id": "f29ad854-0eeb-3391-9a9f-b1358e47d268",
                                "text": "„In diesem Moment kam der Schwarze, der für mich arbeitete, um die Ecke, sah die Frau und ging sofort auf die andere Straßenseite, um sie so weit wie möglich zu umgehen.“"
                            },
                            {
                                "example_id": "efb07d83-f9f9-4ebc-8907-dc4f16d0f613",
                                "sense_id": "f29ad854-0eeb-3391-9a9f-b1358e47d268",
                                "text": "„Nach der Kurve konnte ich das Fahrrad wieder auf die rechte Straßenseite lenken und bremsen und anhalten.“"
                            },
                            {
                                "example_id": "74104d35-5b1d-4906-bdd8-a9f6e9fdb564",
                                "sense_id": "f29ad854-0eeb-3391-9a9f-b1358e47d268",
                                "text": "„Die Freitaler Polizisten wissen nun, wer sich auf der anderen Straßenseite trifft.“"
                            },
                            {
                                "example_id": "1e12dbb3-f939-4795-b2ec-9a006f674648",
                                "sense_id": "f29ad854-0eeb-3391-9a9f-b1358e47d268",
                                "text": "„Sie überquerten die Winston Street und gelangten zu einer hohen weißen Mauer, die sich entlang der gegenüberliegenden Straßenseite des Hotels erstreckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "baa18325-47b6-302d-abb2-984b9afe81b6",
                        "entry_id": "76248fbc-0fdf-35ef-aee9-26ac7fdb93e4",
                        "glosses": [
                            "die Seite eines Gebäudes, die an einer Straße liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5023dc2c-a7a7-4791-bf5f-958cf904b3d7",
                                "sense_id": "baa18325-47b6-302d-abb2-984b9afe81b6",
                                "text": "Mein Schlafzimmer liegt an der Straßenseite des Hauses."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
