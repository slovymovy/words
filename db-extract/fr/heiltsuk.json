                        "glosses": [
                            "peuple amérindien de Colombie-Britannique au Canada"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5cddd9-ed9a-40d4-b052-5c59e2ba3f95",
                                "sense_id": "58268c65-0860-3e73-a8d0-07854f73ba01",
                                "text": "La chef Marilyn Slett affirme que les négociations entre les Heiltsuk et Pêche et Océans Canada la semaine dernière n’ont mené à rien."
                            },
                            {
                                "example_id": "06888070-0636-4c05-86c6-df2e81c1bc55",
                                "sense_id": "58268c65-0860-3e73-a8d0-07854f73ba01",
                                "text": "Il existait au moins cinq tribus de Heiltsuks, chacune possédant son dialecte, son grand chef, son territoire, son village d’hiver et ses rites cérémoniels."
                            }
                        ]
                    }
