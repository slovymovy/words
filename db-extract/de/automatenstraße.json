                                "example_id": "539df8c5-18fe-4059-8905-1883c71fc2b0",
                                "sense_id": "e04d0416-edb0-31f1-933b-f3edec788353",
                                "text": "„In Wien wurde Europas längste Automatenstraße in Betrieb genommen. Die Anlage ist 30 m lang, umschließt 150 Automaten mit 1050 Fächern.“ (1961)"
                            }
                        ],
                        "sense_index_json": "\"1\""
