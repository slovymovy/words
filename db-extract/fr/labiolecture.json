                "senses": [
                    {
                        "sense_id": "2ca84874-79f1-3352-bae1-9e660413549a",
                        "entry_id": "c4e4e0b1-df7e-3211-9df7-997709eb633f",
                        "glosses": [
                            "Procédé permettant de comprendre ce que dit une autre personne en tenant compte d’indications visuelles telles que les mouvements des lèvres, des muscles faciaux, des mains, du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2a995d8-93a0-4828-a114-d8ae610d2d1a",
                                "sense_id": "2ca84874-79f1-3352-bae1-9e660413549a",
                                "text": "Lecture labiale, labiolecture, lecture sur les lèvres, lecture de la parole ou encore lecture des indices oro-faciaux : autant de termes et de définitions utilisés pour décrire le concept de lecture labiale (LL)."
                            },
                            {
                                "example_id": "cbd77231-f31c-4080-bf6f-5aea4c760d2c",
                                "sense_id": "2ca84874-79f1-3352-bae1-9e660413549a",
                                "text": "Quand elle est venue voir Janson, au CHU, ils se sont accrochés verbalement... dans le champ d’une caméra de vidéosurveillance... Janson était de trois quarts face... on a pu faire analyser certaines paroles par un expert en labiolecture..."
                            },
                            {
                                "example_id": "54c4c021-e84a-438e-b274-90a37c863c31",
                                "sense_id": "2ca84874-79f1-3352-bae1-9e660413549a",
                                "text": "En effet, si l’enfant sourd, rien qu’en milieu familial, est la variante d’un entendant, de quelle utilité peuvent alors être les cours d’articulation et de labiolecture ?"
                            }
                        ]
                    }
