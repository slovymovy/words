                        "target_lang_word": "Vormund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vormund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd61a027-3968-34e9-8533-409e10de8849",
                                        "entry_id": "d496cb2e-fb80-389c-acdc-e20ce2e6f1ce",
                                        "glosses": [
                                            "natürliche oder juristische Person, subsidiär Behörde, der die Vormundschaft über eine minderjährige Person, den Mündel, übertragen worden ist und die damit als gesetzlicher Vertreter des Mündels fungiert"
                                        ],
                                        "tags": [
                                            "deutsches Familienrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "439e4f2d-5c55-4379-a308-ee681225292f",
                                                "sense_id": "bd61a027-3968-34e9-8533-409e10de8849",
                                                "text": "Das Gericht bestellte den Lebensgefährten der Mutter zum Vormund der 3-Jährigen."
                                            },
                                            {
                                                "example_id": "3cfabd9e-5f3b-40b1-91b2-94290a3f16a1",
                                                "sense_id": "bd61a027-3968-34e9-8533-409e10de8849",
                                                "text": "„Mehrere Vormünder führen die Vormundschaft gemeinschaftlich.“"
                                            },
                                            {
                                                "example_id": "5924f1fb-20bd-430b-9f7c-8f6479043b7a",
                                                "sense_id": "bd61a027-3968-34e9-8533-409e10de8849",
                                                "text": "„Vormunde und andere sogenannte Berufsbetreuer dürfen nach einem Beschluss des Bundesverfassungsgerichts weiterhin pauschal bezahlt werden, unabhängig von der Zahl der tatsächlichen Arbeitsstunden.“"
                                            },
                                            {
                                                "example_id": "09459607-9212-4f02-b40e-11ea7db9c3be",
                                                "sense_id": "bd61a027-3968-34e9-8533-409e10de8849",
                                                "text": "„Vor allem mußte Madame d'Urfé ein rechtskräftiges Testament machen, in dem das Kind, dessen Vormund ich bis zu seinem dreizehnten Lebensjahr sein sollte, zum Universalerbe eingesetzt wurde.“"
                                            },
                                            {
                                                "example_id": "e15d95f3-22b2-4b1e-9ee5-a294e51432c2",
                                                "sense_id": "bd61a027-3968-34e9-8533-409e10de8849",
                                                "text": "„Will Vesper kümmert sich um den Nachlass, berät die Witwe Rose Rimpau in Geschäftsdingen, wird Vormund ihrer zwei Kinder, und ehe allzu viel Zeit vergeht, ist Rose Rimpau von ihm schwanger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
