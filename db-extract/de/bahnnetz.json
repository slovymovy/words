                "senses": [
                    {
                        "sense_id": "7823c1ae-cbfe-3077-b9ee-482e46b2a5a7",
                        "entry_id": "9e4e6f68-f722-3eac-b062-fae25cb5ca77",
                        "glosses": [
                            "Gesamtheit der Verkehrslinien für Eisenbahnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3412eb57-da9b-4757-bc18-c0656b9edca8",
                                "sense_id": "7823c1ae-cbfe-3077-b9ee-482e46b2a5a7",
                                "text": "„Vater nimmt sich 1940 eine Dachgechosswohnung am Ortsrand von Feldafing am Starnberger See, von den Ortsansässigen nur »Wöllhaus« genannt – dort ist es günstig, und der Ort ist bestens an das Bahnnetz angeschlossen.“"
                            },
                            {
                                "example_id": "5eb75ce9-ded3-4a0e-b941-1903e4c45359",
                                "sense_id": "7823c1ae-cbfe-3077-b9ee-482e46b2a5a7",
                                "text": "„Er war es, der hierzulande die Anfänge eines Bahnnetzes maßgeblich etablierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
