                    {
                        "form_id": "8eaf98e4-5dd6-4570-81a1-84121c7ce798",
                        "entry_id": "fb5a18a3-f4e4-3484-914d-23e6ff13a67e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "électricienne"
