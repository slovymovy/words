    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7db69d33-12da-39dc-8914-b50646246f6b",
                    "sense_definition": "To sleep for a short period of time, especially during the day.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "short sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby usually <w>naps</w> for two hours after lunch.",
                            "target_lang_translations": {
                                "ru": "Ребёнок обычно <w>спит</w> два часа после обеда."
                            }
                        },
                        {
                            "text": "I like to <w>nap</w> on the sofa during the weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>вздремнуть</w> на диване в выходные."
                            }
                        }
                    ],
                    "synonyms": [
                        "snooze",
                        "doze",
                        "kip"
                    ],
                    "common_phrases": [
                        "nap on the sofa",
                        "nap during the day"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спать в течение короткого периода времени, особенно днем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздремнуть",
                                "target_lang_sense_clarification": "немного поспать"
                            },
                            {
                                "target_lang_word": "дремать",
                                "target_lang_sense_clarification": "находиться в полусонном состоянии"
                            },
                            {
                                "target_lang_word": "кемарить",
                                "target_lang_sense_clarification": "дремать (разговорное)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "500c5e36-4849-38d9-aa79-774363c38243",
                    "sense_definition": "To be off one's guard or unprepared for a situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regulators were caught <w>napping</w> by the sudden financial collapse.",
                            "target_lang_translations": {
                                "ru": "Регуляторы были <w>застигнуты врасплох</w> внезапным финансовым крахом."
                            }
                        },
                        {
                            "text": "Don't let the competition catch you <w>napping</w> during the negotiations.",
                            "target_lang_translations": {
                                "ru": "Не позволяйте конкурентам <w>застать вас врасплох</w> во время переговоров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "caught napping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть застигнутым врасплох или оказаться неподготовленным к ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зевать",
                                "target_lang_sense_clarification": "проявлять невнимательность"
                            },
                            {
                                "target_lang_word": "прозевать",
                                "target_lang_sense_clarification": "упустить момент из-за небрежности"
                            },
                            {
                                "target_lang_word": "быть застигнутым врасплох",
                                "target_lang_sense_clarification": "оказаться неготовым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a537549f-a677-386b-a0a1-9d5f29b7da31",
                    "sense_definition": "To cover a food item lightly with a sauce.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>nap</w> the poached pear with a rich chocolate sauce.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>полить</w> грушу-пашот густым шоколадным соусом."
                            }
                        },
                        {
                            "text": "The fish was lightly <w>napped</w> with a lemon butter glaze before serving.",
                            "target_lang_translations": {
                                "ru": "Перед подачей рыбу слегка <w>покрыли</w> лимонно-масляной глазурью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "napped with sauce"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical culinary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка покрыть блюдо соусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наппировать",
                                "target_lang_sense_clarification": "кулинарный термин: покрывать соусом"
                            },
                            {
                                "target_lang_word": "поливать",
                                "target_lang_sense_clarification": "слегка покрывать соусом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f9dc92a-cb67-3e7a-9ac9-a0c38c8c984f",
                    "sense_definition": "To form or raise a soft or fuzzy surface on fabric or leather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fabric texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is designed to <w>nap</w> the wool to make it softer.",
                            "target_lang_translations": {
                                "ru": "Машина предназначена для того, чтобы <w>ворсовать</w> шерсть, делая её мягче."
                            }
                        },
                        {
                            "text": "They <w>nap</w> the leather to give it a suede-like finish.",
                            "target_lang_translations": {
                                "ru": "Они <w>начёсывают</w> кожу, чтобы придать ей вид замши."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать мягкую или пушистую поверхность на ткани или коже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворсовать",
                                "target_lang_sense_clarification": "наводить ворс на ткани"
                            },
                            {
                                "target_lang_word": "начёсывать",
                                "target_lang_sense_clarification": "создавать пушистую поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1748247e-8216-399d-8e8d-9953f22194cf",
                    "sense_definition": "To grab or seize something suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to <w>nap</w> the purse from the table.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>стащить</w> сумочку со стола."
                            }
                        },
                        {
                            "text": "He managed to <w>nap</w> the last cookie before anyone else saw it.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>схватить</w> последнее печенье прежде, чем кто-либо другой его заметил."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно схватить или стащить что-либо."
