{
    "word_family": [
        "lusciously",
        "lusciousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "16d81042-3ed0-370e-ab9d-b6dc817cfd3b",
                    "sense_definition": "Having a delicious, rich, and sweet taste or smell.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasing_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local market was filled with baskets of <w>luscious</w> ripe strawberries.",
                            "target_lang_translations": {
                                "nl": "De lokale markt stond vol met manden <w>sappige</w>, rijpe aardbeien."
                            }
                        },
                        {
                            "text": "We enjoyed a <w>luscious</w> chocolate dessert after dinner.",
                            "target_lang_translations": {
                                "nl": "Na het diner genoten we van een <w>verrukkelijk</w> chocoladetoetje."
                            }
                        }
                    ],
                    "synonyms": [
                        "delectable",
                        "delicious",
                        "mouthwatering",
                        "scrumptious",
                        "tasty"
                    ],
                    "common_phrases": [
                        "luscious fruit",
                        "luscious dessert"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een heerlijke, rijke en zoete smaak of geur; sappig en verrukkelijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verrukkelijk",
                                "target_lang_sense_clarification": "uitstekend van smaak of geur"
                            },
                            {
                                "target_lang_word": "sappig",
                                "target_lang_sense_clarification": "vol vocht en rijk van smaak, vooral bij fruit"
                            },
                            {
                                "target_lang_word": "delicieus",
                                "target_lang_sense_clarification": "zeer smakelijk en verfijnd"
                            },
                            {
                                "target_lang_word": "weelderig",
                                "target_lang_sense_clarification": "rijk en overvloedig (qua smaak of geur)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa69b4f8-3433-3a76-aebe-3c98ddcd014b",
                    "sense_definition": "Visually appealing, seductive, or richly attractive in a sensual way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pleasing_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actress was admired for her <w>luscious</w> hair and elegant appearance.",
                            "target_lang_translations": {
                                "nl": "De actrice werd bewonderd om haar <w>weelderige</w> haar en elegante verschijning."
                            }
                        },
                        {
                            "text": "The fashion magazine highlighted models with <w>luscious</w> lips.",
                            "target_lang_translations": {
                                "nl": "Het modetijdschrift zette modellen met <w>volle, verleidelijke</w> lippen in de schijnwerpers."
                            }
                        }
                    ],
                    "synonyms": [
                        "alluring",
                        "seductive",
                        "sensual"
                    ],
                    "common_phrases": [
                        "luscious lips",
                        "luscious curls"
                    ],
                    "target_lang_definitions": {
                        "nl": "Visueel zeer aantrekkelijk, verleidelijk of sensueel weelderig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "weelderig",
                                "target_lang_sense_clarification": "vol, rijk en aantrekkelijk (bijv. van haar of vormen)"
                            },
                            {
                                "target_lang_word": "wulps",
                                "target_lang_sense_clarification": "sensueel, volrond en verleidelijk"
                            },
                            {
                                "target_lang_word": "verleidelijk",
                                "target_lang_sense_clarification": "aantrekkelijk en bekoorlijk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a08fe009-5e32-36d6-9b13-afd1453eda01",
                    "sense_definition": "Lacking decency; obscene or excessively suggestive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indecent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He disapproved of their <w>luscious</w> talk and left the room immediately.",
                            "target_lang_translations": {
                                "nl": "Hij keurde hun <w>obscene</w> praat af en verliet onmiddellijk de kamer."
                            }
                        },
                        {
                            "text": "The elder critics condemned the novel for its <w>luscious</w> descriptions.",
                            "target_lang_translations": {
                                "nl": "De oudere critici veroordeelden de roman vanwege de <w>wellustige</w> beschrijvingen."
                            }
                        }
                    ],
                    "synonyms": [
                        "salacious"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean obscene"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onzedelijk, te suggestief of obsceen (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "obsceen",
                                "target_lang_sense_clarification": "onzedelijk, schunnig"
                            },
                            {
                                "target_lang_word": "wellustig",
                                "target_lang_sense_clarification": "onbehoorlijk seksueel geladen"
                            },
                            {
                                "target_lang_word": "wulps",
                                "target_lang_sense_clarification": "al te dartel of onzedig"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}