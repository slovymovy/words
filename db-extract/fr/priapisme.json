        "fr-extract.jsonl": [
            {
                "entry_id": "e6f9fcc9-97e9-318a-a61c-5018bdf3eecc",
                "word": "priapisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bde7188d-e462-4c53-98ee-c6cc0b83532c",
                        "entry_id": "e6f9fcc9-97e9-318a-a61c-5018bdf3eecc",
                        "tags": [
