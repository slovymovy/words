                ],
                "senses": [
                    {
                        "sense_id": "917e7d20-dfc7-3f44-a2f2-e0deaa0ca7f5",
                        "entry_id": "24cff5f6-13b5-3128-a230-c3d46c8fb43d",
                        "glosses": [
                            "Gegenstand, mit dem ein Mord begangen wurde oder begangen werden kann"
                        ],
                        "tags": [
                            "oft",
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "05353d47-1b4f-46f1-950b-f9877444a91d",
                                "sense_id": "917e7d20-dfc7-3f44-a2f2-e0deaa0ca7f5",
                                "text": "„In der Abteilung »Neuzeit« ist von der Ansbacher Polizei ein Zimmer dem Andenken des armen Findlings Kaspar Hauser geweiht; man sieht seine Uhr, seine Kleider und Wäsche mit den Stichmarken des Mordinstrumentes und die ganze Literatur über diesen geheimnisvollen Unbekannten.“"
                            },
                            {
                                "example_id": "39d56bf6-ce50-4fb0-89a5-fa66ef05f9cb",
                                "sense_id": "917e7d20-dfc7-3f44-a2f2-e0deaa0ca7f5",
                                "text": "„Zahlreiche Exponate von Folter und Strafvollzug, die originale Folterkammer sowie Mordinstrumente, Bilder von Ermordeten sowie berühmte Kriminalfälle ließen manchmal den kalten Schauer über die Schulter laufen.“"
                            },
                            {
                                "example_id": "c984920c-efb3-4aee-94f3-0e24de41d192",
                                "sense_id": "917e7d20-dfc7-3f44-a2f2-e0deaa0ca7f5",
                                "text": "„Das G3 und sein Ableger HK33 seien in vielen Konflikten die häufigsten Mordinstrumente nach dem AK 47; statistisch werde alle 14 Minuten ein Mensch von einer Kugel aus einer HK-Waffe getötet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "475b2c33-9b59-3f53-b9dc-8f115c54a4e9",
                        "entry_id": "24cff5f6-13b5-3128-a230-c3d46c8fb43d",
                        "glosses": [
                            "Gegenstand, der so aussieht, als könne damit ein Mord begangen werden"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "0a20e50b-c691-4a4e-bf04-a4588250b19f",
                                "sense_id": "475b2c33-9b59-3f53-b9dc-8f115c54a4e9",
                                "text": "„‚In China sollen diese Barthaare als Mordinstrumente benutzt worden sein‘, erzählt sie.“"
                            },
                            {
                                "example_id": "cb89979b-3421-4e41-a69d-0be79f1aae2b",
                                "sense_id": "475b2c33-9b59-3f53-b9dc-8f115c54a4e9",
                                "text": "„Sie verwandeln Leiter und Brett in eine Wippe, machen einen Zollstock erst zum Greifwerkzeug und dann zum potenziellen Mordinstrument.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
