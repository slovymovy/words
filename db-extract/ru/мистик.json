                        ]
                    },
                    {
                        "translation_id": "0a683e98-116e-48dd-892c-30d8115031d0",
                        "source_entry_id": "a41599c5-7d64-37a9-82c8-4ce3eaea3dba",
                        "target_lang_word": "gizemci",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gizemci",
