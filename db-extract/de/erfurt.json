                            }
                        ]
                    },
                    {
                        "translation_id": "18804e9d-aaf1-4c28-b288-c07153423423",
                        "source_entry_id": "fd18813a-db3e-3e4b-9de4-d27cfe181b78",
                        "source_sense_id": "c3d4b973-923c-3a80-aebc-0cc2c49c0dab",
                        "source_sense_description": "Stadt in Deutschland, Landeshauptstadt von Thüringen",
                        "target_lang_word": "Erfurt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erfurt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98cef4ff-6280-31d4-8249-18db3f6d53ce",
                                        "entry_id": "ec4fd6e7-febc-32b5-8a76-5c1427240b2f",
                                        "glosses": [
                                            "Ville, commune et arrondissement d’Allemagne, capitale de la Thuringe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e282fe0-aea5-4c6c-8121-31b9406959bb",
                                                "sense_id": "98cef4ff-6280-31d4-8249-18db3f6d53ce",
                                                "text": "Et dans sa fosse à moines d’Erfurt sûrement que la faim et la soif de la justice le dévoraient."
                                            },
                                            {
                                                "example_id": "181d023a-6f83-4ce8-85d2-d987fdb1c18e",
                                                "sense_id": "98cef4ff-6280-31d4-8249-18db3f6d53ce",
                                                "text": "A moins d’une lieue de Vendœuvres, en allant sur le marais de Bellebouche, au lieu dit « le button aux fades », une famille d’hommes libres, venant de la région d’Erfurt, a été pourvue par notre souverain d’un domaine, en remplacement d’Aquitains qui avaient péri pendant la guerre, il y a cela plus de vingt ans."
                                            },
                                            {
                                                "example_id": "3e6dbb02-30fe-4c97-b74a-3ca414bbe205",
                                                "sense_id": "98cef4ff-6280-31d4-8249-18db3f6d53ce",
                                                "text": "Oui certes, un fils de Johann-Christoph, le glorieux oncle de Jean-Sébastien, ira fabriquer des orgues en Suède ; un autre, d’Erfurt, émigrera à Hambourg, puis à Rotterdam et finalement en Angleterre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
