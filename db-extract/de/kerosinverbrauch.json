                "senses": [
                    {
                        "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                        "entry_id": "8aee0e96-9178-3330-8428-00a35a53b8ab",
                        "glosses": [
                            "Verbrauch von Flugbenzin (= Kerosin)"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "5abf737a-63d7-49f9-9324-900635d2e590",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Der Kerosinverbrauch aller VW-Jets zusammen ist von 2021 auf 2022 um etwa eine Million Liter gestiegen, auf mehr als acht Millionen.“"
                            },
                            {
                                "example_id": "af4cc9cd-df15-4175-aaa5-09e13a15b315",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Weniger Geschäftsreisen per Flugzeug - das wurde ja während der Lockdowns schon geübt - würden weitere Einsparungen im Kerosinverbrauch bringen.“"
                            },
                            {
                                "example_id": "693f7ce1-57c5-41a8-ab82-87c531e69e67",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Fliegen gilt nach wie vor als Klimakiller. Die Lösung könnten Flugzeuge mit deutlich sparsamerem Kerosinverbrauch sein.“"
                            },
                            {
                                "example_id": "918764c3-ba92-49aa-ad5c-ac19fee05c57",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Je nach Kombination von Flugzeugtyp und Triebwerk gibt es Unterschiede im Kerosinverbrauch einer Maschine.“"
                            },
                            {
                                "example_id": "e5ed718a-19de-4894-b38a-5864acaf148e",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Vor allem ein höherer Kerosinverbrauch würde den Kostenvorteil für Fluglinien aber schnell wieder aufzehren.“"
                            },
                            {
                                "example_id": "32abc3e6-a3ab-4912-8179-7403a82f3d7d",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Die verbesserte Aerodynamik soll den A380 vier Prozent sparsamer beim Kerosinverbrauch machen.“"
                            },
                            {
                                "example_id": "13786de7-050c-4e10-86d5-ca25fc15b816",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Die Flugzeugbauer mussten reagieren: Um rund 40 Prozent sank der Kerosinverbrauch ihrer neuen Modelle.“"
                            },
                            {
                                "example_id": "388d7a59-5e48-4c1e-a2c2-b36de5295988",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "[…] „Mit der Boeing 777 können mehr Passagiere bei geringerem Kerosinverbrauch befördert werden.“"
                            },
                            {
                                "example_id": "8f5670a5-1a09-4185-aa45-0ece8bf75b5a",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Rein wirtschaftlich war die Concorde ein Irrweg der Luftfahrtgeschichte: zu teuer, zu laut, immens hoher Kerosinverbrauch.“"
                            },
                            {
                                "example_id": "70e85930-7195-41a0-8fe9-84a0e0e4757a",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "[Iljuschin Il-76MD-90A:] „Die Nutzlast stieg auf 60 Tonnen, der Kerosinverbrauch ist etwa 10 % geringer.“"
                            },
                            {
                                "example_id": "7c134abb-9224-4a99-b87d-362f7644afc6",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Weil man in der Schweiz Steuern und Abgaben auf Kerosin bezahlen müsse und in Schottland nicht, könne die Luftwaffe über 900'000 Franken sparen bei einem Kerosinverbrauch von 1,5 Millionen Litern für die «Kampagne» in Schottland.“"
                            },
                            {
                                "example_id": "9d998c0a-f2d2-4885-97de-01dda45bfc6f",
                                "sense_id": "6370acb5-77e5-3660-bd85-4d9d2344a07c",
                                "text": "„Derzeit ist der kommerzielle Kerosinverbrauch nach der Gesetzgebung aller Mitgliedstaaten der Europäischen Union steuerfrei (Stand: 2018).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
