                        "glosses": [
                            "собир. дубины, колья, палки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35cc6e09-2fcc-44f7-8293-70bf56e52d67",
                                "sense_id": "fabb4392-dc2d-330d-bdd5-fc937e973cf3",
                                "text": "Спины заживут, а как новое сено поспеет, миршенцы опять за дубьё, опять пойдут у них с якимовцами бои не на живот, а на смерть."
                            }
                        ]
                    },
                    {
                        "sense_id": "449cb354-29ec-3b61-9583-6dafcf255af5",
                        "entry_id": "62c93654-187d-3335-98d9-7dae1bad3646",
                        "glosses": [
                            "собир., лес. дубовый лес"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b6b694-3f85-4967-bc3c-a435ff85311c",
                                "sense_id": "449cb354-29ec-3b61-9583-6dafcf255af5",
                                "text": "От мороза крякало в лесу столетнее дубьё .."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b9fc196-411a-3d8c-a86d-57c392df267c",
                        "entry_id": "62c93654-187d-3335-98d9-7dae1bad3646",
                        "glosses": [
                            "устар., собир., строит., лес. строительный материал из дуба; дубовые брёвна"
                        ],
