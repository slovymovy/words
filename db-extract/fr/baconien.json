                        "sense_id": "4b74ad21-f9c8-3e96-9a9c-209c6b1b27cb",
                        "entry_id": "b719f653-2e3c-35a9-8823-69c0d3bc8acc",
                        "glosses": [
                            "Relatif à la vie et l’œuvre du scientifique et philosophe anglais Francis Bacon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57baadc-2c38-4c07-9eca-f8c514434954",
                                "sense_id": "4b74ad21-f9c8-3e96-9a9c-209c6b1b27cb",
                                "text": "La Royal Society de Londres, l’une des premières académies des arts et des sciences, est inspirée par l’évangile baconien de la science."
                            },
                            {
                                "example_id": "59f12957-e2b8-4b71-8b3f-ee4a635f16f0",
                                "sense_id": "4b74ad21-f9c8-3e96-9a9c-209c6b1b27cb",
                                "text": "Alors peut-être faut-il changer de système de références métaphorique, trouver dans le système baconien une autre distribution imaginaire qui, elle, légitime la rédaction d'une fable."
                            }
                        ]
                    }
                ],
