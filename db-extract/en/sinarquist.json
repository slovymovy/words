                ],
                "senses": [
                    {
                        "sense_id": "44a17858-993f-3e4d-ac60-db48ab3ee87a",
                        "entry_id": "8427ead2-5a3e-3713-805c-c58ce16a5509",
                        "glosses": [
                            "A supporter of Sinarquism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f61cf97-adb0-4a2b-b687-abcaae1fa689",
                                "sense_id": "44a17858-993f-3e4d-ac60-db48ab3ee87a",
                                "text": "The Sinarquists numbered 300,000 and were heavily represented in the interior of the country, particularly in the Central Zone of Mexico."
                            },
                            {
                                "example_id": "d19e2aee-769d-44a1-af3b-b9b55aa8ce83",
                                "sense_id": "44a17858-993f-3e4d-ac60-db48ab3ee87a",
                                "text": "Secondly, La Opinion, the Los Angeles Spanish-language paper, published an article which defended the young Sinarquists in Los Angeles against charges that they organized and promoted juvenile gangs."
                            },
                            {
                                "example_id": "6ac79dcf-474d-43c9-8478-a24ec2ba49c5",
                                "sense_id": "44a17858-993f-3e4d-ac60-db48ab3ee87a",
                                "text": "One broadcast that aired on Wednesday, 5 May 1943, blamed pro-fascist Mexican Sinarquists for stirring support for the police crackdown on working-class youths in the Mexican American community because the Mexican Sinarquists viewed Pachucos as being \"corrupted by American thought and habits.\""
                            }
                        ]
                    }
