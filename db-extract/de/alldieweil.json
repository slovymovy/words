        "de-extract.jsonl": [
            {
                "entry_id": "9618268d-ef68-3cbe-ac19-27a1a8179935",
                "word": "alldieweil",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5aaa74f7-ca3e-3dc0-8a1c-2fc776f27c9a",
                        "entry_id": "9618268d-ef68-3cbe-ac19-27a1a8179935",
                        "glosses": [
                            "in der Zwischenzeit, währenddessen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1fcfbcdd-cfa3-4d94-baab-dc021f5856d6",
                                "sense_id": "5aaa74f7-ca3e-3dc0-8a1c-2fc776f27c9a",
                                "text": "Als das Gelage geendet hatte, trat man in den Park hinaus, wo alldieweil eine Kapelle ihre Instrumente ausgepackt hatte und nun zu spielen anhub."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3666795-27f1-49b4-aa9b-0f0005054b7e",
                        "source_entry_id": "9618268d-ef68-3cbe-ac19-27a1a8179935",
                        "source_sense_id": "5aaa74f7-ca3e-3dc0-8a1c-2fc776f27c9a",
                        "source_sense_description": "veraltet, heute noch scherzhaft gebraucht: in der Zwischenzeit, währenddessen",
                        "target_lang_word": "all the while",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all the while",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a13b927c-6e2e-3ce8-889a-56fbd96f2847",
                                        "entry_id": "5f920c9a-9eaa-30b1-a176-06b93c4a339c",
                                        "glosses": [
                                            "At the same time as, usually over an extended period."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a6f8f2-690b-45db-8044-6385016f9f71",
                                                "sense_id": "a13b927c-6e2e-3ce8-889a-56fbd96f2847",
                                                "text": "The good fortune which attended him throughout life may have been partly owing to this cause as well as to his undoubted valour, for though he never lost a battle, nothing is more astounding than his imprudence and the easy confidence with which he trusted Somerset, Warwick, Montague, and others, all the while they were betraying him."
                                            },
                                            {
                                                "example_id": "e7964748-b427-4075-9dfe-8a8581cd8316",
                                                "sense_id": "a13b927c-6e2e-3ce8-889a-56fbd96f2847",
                                                "text": "Sulla, encamped near Scipio, and amusing him with caresses under pretence of an approaching peace, was all the while corrupting his troops."
                                            },
                                            {
                                                "example_id": "38d1580c-296b-4332-a0f6-4d173c23e0f4",
                                                "sense_id": "a13b927c-6e2e-3ce8-889a-56fbd96f2847",
                                                "text": "And all with that vital piece of evidence burning a hole in his pocket the while!"
                                            },
                                            {
                                                "example_id": "b7d9b8ec-21be-4ecb-ac8f-6af69125f0be",
                                                "sense_id": "a13b927c-6e2e-3ce8-889a-56fbd96f2847",
                                                "text": "All the while, my intention was to amuse her, and divert her out of her hellish thoughts, and show to her the wide world of which she could now be a part."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "f8645ce9-40be-4542-aace-7bd4c2bd6095",
                        "source_entry_id": "9618268d-ef68-3cbe-ac19-27a1a8179935",
