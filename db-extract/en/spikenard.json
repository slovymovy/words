    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                "word": "spikenard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "99206230-560f-45f9-a59f-30bf813febc5",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "tags": [
                            "plural"
                        ],
                        "form": "spikenards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0cc64cc-4572-31bf-a081-eef2b48fa52a",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "glosses": [
                            "A perfumed ointment, extracted from the plant Nardostachys jatamansi that belongs to the Valerian family and grows in the Himalayas."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0863f8d2-515b-4fc3-8da7-0380a43da035",
                                "sense_id": "e0cc64cc-4572-31bf-a081-eef2b48fa52a",
                                "text": "All subtle thought, all curious fears,\n⁠Borne down by gladness so complete,\n⁠She bows, she bathes the Saviour’s feet\nWith costly spikenard and with tears."
                            },
                            {
                                "example_id": "ebad331d-6846-441b-b04a-d154dcbf1d69",
                                "sense_id": "e0cc64cc-4572-31bf-a081-eef2b48fa52a",
                                "text": "While the king sitteth at his table, my spikenard sendeth forth the smell thereof."
                            },
                            {
                                "example_id": "49cae816-f8b1-451d-8fd1-5a08248e4ed5",
                                "sense_id": "e0cc64cc-4572-31bf-a081-eef2b48fa52a",
                                "text": "The glories of Mary held his soul captive : spikenard and myrrh and frankincense, symbolising the preciousness of God's gifts to her soul, rich garments, symbolising her royal lineage, her emblems, the lateflowering plant and lateblossoming tree, symbolising the agelong gradual growth of her cultus among men."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bfaf143-12bc-3706-93f9-cffa964c7360",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "glosses": [
                            "The plant Nardostachys jatamansi (syn. Nardostachys grandiflora)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "89b3f46d-3678-4225-a5b7-c534788968f1",
                                "sense_id": "5bfaf143-12bc-3706-93f9-cffa964c7360",
                                "text": "A garden inclosed is my sister, my spouse; a spring shut up, a fountain sealed. Thy plants are an orchard of pomegranates, with pleasant fruits; camphire, with spikenard, Spikenard and saffron; calamus and cinnamon, with all trees of frankincense; myrrh and aloes, with all the chief spices"
                            }
                        ]
                    },
                    {
                        "sense_id": "14136ad4-2af2-397b-b06b-40b2334899f8",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "glosses": [
                            "Lavandula stoechas, another species used in antiquity to produce an aromatic oil."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c50c3635-706b-39a8-9852-946cac1c58f1",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "glosses": [
                            "Any plant of the genus Aralia of the Araliaceae family."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6782ce71-9be9-3d1d-b96c-4ae5fc402a79",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "glosses": [
                            "False spikenard (Maianthemum racemosum, syn. Smilacina racemosa)"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0e21f874-d035-3cc7-975b-fdfb2c47264f",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "glosses": [
                            "Ploughman's spikenard (Inula conyza, now Pentanema conyzae)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6103c6c1-64aa-3ff7-aa51-68f043bec1d6",
                        "entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "glosses": [
                            "Wild spikenard (Asarum europaeum)."
                        ],
                        "tags": [
