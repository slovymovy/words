                                        "glosses": [
                                            "A kind of strong drink."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf2b4bb-404f-4fab-b90a-85b13ea3da59",
                                                "sense_id": "288d7610-b305-36ca-9491-e4fb9bef7abf",
                                                "text": "you do provide me hum enough , And lour to bouse with"
