                    "sense_definition": "wyznaczać kogoś na określone stanowisko lub powoływać na urząd",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nominacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach monarcha osobiście <w>postanawiał</w> nowych urzędników na kluczowe pozycje.",
                            "target_lang_translations": {
                                "ru": "В былые времена монарх лично <w>назначал</w> новых чиновников на ключевые посты."
                            }
