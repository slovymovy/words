    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a2b257fb-c11d-3d6a-8b72-f38c2e08956e",
                    "sense_definition": "To a small or moderate extent or degree; a little bit.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "degree_modifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions for the new software were <w>somewhat</w> confusing at first.",
                            "target_lang_translations": {
                                "ru": "Инструкции к новому программному обеспечению поначалу были <w>несколько</w> запутанными.",
                                "zh": "新软件的说明书起初<w>有点</w>让人困惑。"
                            }
                        },
                        {
                            "text": "I felt <w>somewhat</w> better after drinking a glass of water and resting.",
                            "target_lang_translations": {
                                "ru": "Я почувствовал себя <w>немного</w> лучше, выпив стакан воды и отдохнув.",
                                "zh": "喝了杯水并休息后，我感觉<w>稍微</w>好了一些。"
                            }
                        },
                        {
                            "text": "The final results were <w>somewhat</w> different from what we had anticipated.",
                            "target_lang_translations": {
                                "ru": "Окончательные результаты <w>несколько</w> отличались от того, что мы ожидали.",
                                "zh": "最终结果与我们预期的<w>有些</w>不同。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slightly",
                        "moderately",
                        "rather",
                        "partially",
                        "a little"
                    ],
                    "antonyms": [
                        "completely",
                        "totally",
                        "entirely",
                        "wholly"
                    ],
                    "common_phrases": [
                        "somewhat different",
                        "somewhat difficult",
                        "somewhat better",
                        "somewhat surprised",
                        "somewhat confusing"
                    ],
                    "target_lang_definitions": {
                        "ru": "В незначительной или умеренной степени; немного.",
                        "zh": "在一定程度上或中等程度上；稍微。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несколько",
                                "target_lang_sense_clarification": "в определенной мере, слегка (формально)"
                            },
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "чуть-чуть, в малой степени (разговорное)"
                            },
                            {
                                "target_lang_word": "отчасти",
                                "target_lang_sense_clarification": "частично, не полностью"
                            },
                            {
                                "target_lang_word": "в некоторой степени",
                                "target_lang_sense_clarification": "до определенного уровня"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有点",
                                "target_lang_sense_clarification": "表示程度，口语常用"
                            },
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "表示程度轻微"
                            },
                            {
                                "target_lang_word": "有些",
                                "target_lang_sense_clarification": "表示程度，常用于形容词前"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "a7a09f93-a0b3-3bc8-a530-bae532205b29",
                    "sense_definition": "Something; an unspecified thing or amount.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indefinite_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He whispered <w>somewhat</w> in her ear that made her smile instantly.",
                            "target_lang_translations": {
                                "ru": "Он прошептал ей на ухо <w>что-то</w>, что заставило её мгновенно улыбнуться.",
                                "zh": "他在她耳边低语了<w>什么</w>，让她瞬间露出了笑容。"
                            }
                        },
                        {
                            "text": "There is <w>somewhat</w> in his manner that suggests he is hiding the truth.",
                            "target_lang_translations": {
                                "ru": "В его манерах есть <w>нечто</w>, что наводит на мысль, что он скрывает правду.",
                                "zh": "他的举止中透着<w>某种</w>暗示，说明他在隐瞒真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "something"
                    ],
                    "antonyms": [
                        "nothing"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern English uses 'something' instead."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то; неопределенный предмет или количество (устаревшее значение).",
                        "zh": "某事；不确定的事物或数量（古旧用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что-то",
                                "target_lang_sense_clarification": "неопределенный предмет или вещь"
                            },
                            {
                                "target_lang_word": "нечто",
                                "target_lang_sense_clarification": "что-то неопределенное (книжное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "什么",
                                "target_lang_sense_clarification": "指代不确定的事物"
                            },
                            {
                                "target_lang_word": "某事",
                                "target_lang_sense_clarification": "指代不确定的事情"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
