                                        "entry_id": "c284f4e8-da2b-36d1-a15c-ef6d583961bd",
                                        "glosses": [
                                            "Réunir des lois éparses en un corps de législation, rédiger un code."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9479ec2-1ff9-4c61-96f6-3a3e1df7a9e1",
                                                "sense_id": "3b74a0e5-762e-3f9f-9b0d-0e1afca2cdf7",
                                                "text": "La distinction des animaux purs et impurs est antérieure à la loi mosaïque, qui ne fit que la codifier."
                                            },
                                            {
                                                "example_id": "758af6f8-82c5-4885-bbb3-b5119d144d1c",
                                                "sense_id": "3b74a0e5-762e-3f9f-9b0d-0e1afca2cdf7",
                                                "text": "Napoléon ! Ça lui allait bien, à celui-là, de codifier la protection de la vie humaine et de la propriété !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e94ba6-f828-377c-a2e5-c6f59fd80619",
                                        "entry_id": "c284f4e8-da2b-36d1-a15c-ef6d583961bd",
                                        "glosses": [
                                            "Rassembler des connaissances, des informations en un système organisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98e1141-1a18-4fd4-ba05-e6291176d722",
                                                "sense_id": "99e94ba6-f828-377c-a2e5-c6f59fd80619",
                                                "text": "Plus que toute autre institution, l’Académie française est sensible aux évolutions et aux innovations de la langue, puisqu’elle a pour mission de les codifier."
                                            }
                                        ]
                                    }
                                ]
                            }
