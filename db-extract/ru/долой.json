                    {
                        "sense_id": "e42c6463-e0f3-30c1-98ca-8f74014d26f2",
                        "entry_id": "3d675ce4-7303-3ff4-9d9c-11a4202ee4cc",
                        "glosses": [
                            "away, down"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3698ebd-3daa-4777-9d15-e0fe08b3bd15",
                                "sense_id": "e42c6463-e0f3-30c1-98ca-8f74014d26f2",
                                "text": "Уйди́ с глаз доло́й!",
                                "translation": "Get out of my sight!",
                                "english": "Get out of my sight!"
                            },
                            {
                                "example_id": "ac9a2306-df6d-4352-8839-7c5c0c0c89be",
                                "sense_id": "e42c6463-e0f3-30c1-98ca-8f74014d26f2",
                                "text": "Доло́й фаши́зм!",
                                "translation": "Down with fascism!",
                                "english": "Down with fascism!"
                            },
                            {
                                "example_id": "ec957f7b-af0e-4c3e-9cd4-20a5a82167e4",
                                "sense_id": "e42c6463-e0f3-30c1-98ca-8f74014d26f2",
                                "text": "Доло́й царя́!",
                                "translation": "Down with the tsar!",
                                "english": "Down with the tsar!"
                            },
                            {
                                "example_id": "586456e8-9dbf-44ec-84a4-e2b5d2c07d89",
                                "sense_id": "e42c6463-e0f3-30c1-98ca-8f74014d26f2",
                                "text": "Подпи́сано, так с плеч доло́й.",
                                "translation": "Expresses indifference towards the result of a job and a desire to be done with it / not have to deal with it further. From the 1824 Alexander Griboyedov play Woe from Wit.",
                                "english": "Expresses indifference towards the result of a job and a desire to be done with it / not have to deal with it further. From the 1824 Alexander Griboyedov play Woe from Wit."
                            },
                            {
                                "example_id": "cb547d1b-a061-4cb1-8610-a79d875960a4",
                                "sense_id": "e42c6463-e0f3-30c1-98ca-8f74014d26f2",
                                "text": "Из армии прогнали шкурников. Все мы скажем теперь:\n«Долой шкурников, долой тех, кто думает о своей выгоде, спекуляции, об отлынивании от работы, кто боится необходимых для победы жертв!»",
                                "translation": "We drove the scroungers out of the army. And now we say, \"Down with the scroungers, down with those who think of their own advantage, of speculation and of shirking work, those who are afraid of the sacrifices necessary for victory!\"",
                                "english": "We drove the scroungers out of the army. And now we say, \"Down with the scroungers, down with those who think of their own advantage, of speculation and of shirking work, those who are afraid of the sacrifices necessary for victory!\""
                            }
                        ]
                    }
                ],
