{
    "word_family": [
        "striver",
        "striving"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f873482-b717-370d-8188-82625028008e",
                    "sense_definition": "To make a great and persistent effort to achieve a result or improve something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company will always <w>strive</w> to improve customer satisfaction.",
                            "target_lang_translations": {
                                "ru": "Компания всегда будет <w>стремиться</w> повысить уровень удовлетворенности клиентов.",
                                "it": "L'azienda si <w>impegnerà</w> sempre per migliorare la soddisfazione del cliente."
                            }
                        },
                        {
                            "text": "She <w>strove</w> for excellence in every project she undertook at the university.",
                            "target_lang_translations": {
                                "ru": "Она <w>стремилась</w> к совершенству в каждом проекте, за который бралась в университете.",
                                "it": "Lei ha <w>cercato</w> l'eccellenza in ogni progetto che ha intrapreso all'università."
                            }
                        }
                    ],
                    "synonyms": [
                        "work hard",
                        "apply oneself",
                        "seek"
                    ],
                    "antonyms": [
                        "give up",
                        "surrender"
                    ],
                    "common_phrases": [
                        "strive for excellence",
                        "strive to improve",
                        "strive for perfection",
                        "strive to achieve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилагать большие и настойчивые усилия для достижения результата или улучшения чего-либо.",
                        "it": "Compiere un grande e costante sforzo per raggiungere un risultato o migliorare qualcosa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "настойчиво добиваться, сильно желать чего-либо"
                            },
                            {
                                "target_lang_word": "прилагать усилия",
                                "target_lang_sense_clarification": "активно действовать ради достижения цели"
                            },
                            {
                                "target_lang_word": "стараться",
                                "target_lang_sense_clarification": "делать попытки, усердствовать"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "impegnarsi",
                                "target_lang_sense_clarification": "concentrarsi e sforzarsi per raggiungere un obiettivo"
                            },
                            {
                                "target_lang_word": "sforzarsi",
                                "target_lang_sense_clarification": "fare uno sforzo attivo per ottenere un risultato"
                            },
                            {
                                "target_lang_word": "adoperarsi",
                                "target_lang_sense_clarification": "darsi da fare attivamente per uno scopo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d3a752e-29e6-32fa-ac93-f5a2b5de4e58",
                    "sense_definition": "To struggle vigorously against an opposing force, condition, or difficulty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swimmer had to <w>strive</w> against the strong current to reach the shore.",
                            "target_lang_translations": {
                                "ru": "Пловцу пришлось <w>бороться</w> с сильным течением, чтобы добраться до берега.",
                                "it": "Il nuotatore ha dovuto <w>lottare</w> contro la forte corrente per raggiungere la riva."
                            }
                        },
                        {
                            "text": "They continued to <w>strive</w> against adversity despite the overwhelming odds.",
                            "target_lang_translations": {
                                "ru": "Они продолжали <w>бороться</w> с невзгодами, несмотря на подавляющее превосходство обстоятельств.",
                                "it": "Hanno continuato a <w>battersi</w> contro le avversità nonostante le probabilità schiaccianti."
                            }
                        }
                    ],
                    "synonyms": [
                        "break one's back",
                        "put one's shoulder to the wheel",
                        "give 110%"
                    ],
                    "antonyms": [
                        "yield",
                        "submit"
                    ],
                    "common_phrases": [
                        "strive against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергично бороться против противодействующей силы, условий или трудностей.",
                        "it": "Lottare energicamente contro una forza, una condizione o una difficoltà avversa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "противостоять кому-то или чему-то, преодолевать трудности"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "lottare",
                                "target_lang_sense_clarification": "resistere o opporsi con forza a una difficoltà"
                            },
                            {
                                "target_lang_word": "battersi",
                                "target_lang_sense_clarification": "combattere contro un ostacolo o una forza contraria"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19884d18-1e23-3ca0-881c-b1c5732fc814",
                    "sense_definition": "To compete with someone as a rival.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two factions <w>strove</w> with each other for control of the territory.",
                            "target_lang_translations": {
                                "ru": "Две фракции <w>боролись</w> друг с другом за контроль над территорией.",
                                "it": "Le due fazioni hanno <w>competuto</w> l'una contro l'altra per il controllo del territorio."
                            }
                        },
                        {
                            "text": "Poets often <w>strive</w> to outdo one another in the beauty of their verse.",
                            "target_lang_translations": {
                                "ru": "Поэты часто <w>состязаются</w> в желании превзойти друг друга красотой своих стихов.",
                                "it": "I poeti spesso <w>rivaleggiano</w> nel superarsi a vicenda nella bellezza dei loro versi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strive with"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соперничать или состязаться с кем-либо.",
                        "it": "Competere o gareggiare con qualcuno come rivale."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состязаться",
                                "target_lang_sense_clarification": "участвовать в соревновании или споре"
                            },
                            {
                                "target_lang_word": "соперничать",
                                "target_lang_sense_clarification": "выступать в качестве конкурента"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "competere",
                                "target_lang_sense_clarification": "gareggiare con altri per la supremazia"
                            },
                            {
                                "target_lang_word": "rivaleggiare",
                                "target_lang_sense_clarification": "essere in competizione diretta con qualcuno"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5736d838-f7f4-31be-8628-a920fa8d4421",
                    "sense_definition": "An archaic or dialectal form of <w>strife</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kingdom was torn apart by internal <w>strive</w> and war.",
                            "target_lang_translations": {
                                "ru": "Королевство раздирали внутренние <w>распри</w> и война.",
                                "it": "Il regno era dilaniato da <w>discordie</w> interne e dalla guerra."
                            }
                        },
                        {
                            "text": "He sought to end the <w>strive</w> between the two feuding families.",
                            "target_lang_translations": {
                                "ru": "Он пытался положить конец <w>вражде</w> между двумя враждующими семьями.",
                                "it": "Cercò di porre fine alla <w>contesa</w> tra le due famiglie in faida."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "archaic variant of strife"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова «strife» (раздор, борьба).",
                        "it": "Forma arcaica o dialettale per indicare discordia o conflitto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распря",
                                "target_lang_sense_clarification": "вражда, ссора"
                            },
                            {
                                "target_lang_word": "раздор",
                                "target_lang_sense_clarification": "несогласие, внутренний конфликт"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "discordia",
                                "target_lang_sense_clarification": "mancanza di accordo, conflitto"
                            },
                            {
                                "target_lang_word": "contesa",
                                "target_lang_sense_clarification": "lotta o disputa accesa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}