                    {
                        "sense_id": "cb5e6e82-8b11-3e9d-906d-777de3d11812",
                        "entry_id": "6c1aa4c2-ad30-33d4-89a4-5ef16d9266ec",
                        "glosses": [
                            "Couvée qui est encore dans le nid."
                        ],
                        "tags": [
                            "collective"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd9d4ee-eb23-4ea7-8bc7-b5e24014fcb8",
                                "sense_id": "cb5e6e82-8b11-3e9d-906d-777de3d11812",
                                "text": "La nichée était de quatre ou cinq petits rossignols."
                            },
                            {
                                "example_id": "da2857f1-259e-4618-ae11-19eb10e914f2",
                                "sense_id": "cb5e6e82-8b11-3e9d-906d-777de3d11812",
                                "text": "Je suis comme un vieux chêne noueux et moussu qui réveille des nichées d’oiseaux chanteurs en agitant ses branches."
                            },
                            {
                                "example_id": "d06ea834-2034-4a4e-b826-7c059cf2e562",
                                "sense_id": "cb5e6e82-8b11-3e9d-906d-777de3d11812",
                                "text": "Cette fois, la déco est monacale. Les murs sont badigeonnés d'un enduit coquille d'œuf à faire chialer une nichée de poussins."
                            }
                        ]
                    }
                ],
