{
    "word_family": [
        "rampantly",
        "rampancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74d09c08-f46b-3e5e-80e6-abe99af5c7d4",
                    "sense_definition": "Rife, widespread, or occurring widely and menacingly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unchecked_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens demanded immediate action because there was <w>rampant</w> corruption in the city government.",
                            "target_lang_translations": {
                                "ru": "Граждане потребовали немедленных действий, поскольку в городском правительстве процветала <w>повальная</w> коррупция.",
                                "pl": "Mieszkańcy domagali się natychmiastowych działań, ponieważ we władzach miasta <w>panoszyła się</w> korupcja."
                            }
                        },
                        {
                            "text": "Without proper security measures, <w>rampant</w> rumors can easily destroy a company's reputation.",
                            "target_lang_translations": {
                                "ru": "Без надлежащих мер безопасности <w>безудержные</w> слухи могут легко разрушить репутацию компании.",
                                "pl": "Bez odpowiednich środków ostrożności <w>szalejące</w> plotki mogą łatwo zniszczyć reputację firmy."
                            }
                        }
                    ],
                    "synonyms": [
                        "rife",
                        "widespread",
                        "prevalent"
                    ],
                    "antonyms": [
                        "scarce",
                        "rare"
                    ],
                    "common_phrases": [
                        "rampant corruption",
                        "rampant inflation",
                        "rampant rumors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко распространенный, свирепствующий или угрожающе разрастающийся.",
                        "pl": "Szerzący się na wielką skalę, powszechny i trudny do opanowania (zwykle o negatywnych zjawiskach)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повальный",
                                "target_lang_sense_clarification": "о болезнях, слухах, коррупции"
                            },
                            {
                                "target_lang_word": "широко распространенный",
                                "target_lang_sense_clarification": "о явлениях"
                            },
                            {
                                "target_lang_word": "угрожающий",
                                "target_lang_sense_clarification": "о масштабах проблем"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szerzący się",
                                "target_lang_sense_clarification": "o zjawiskach, np. korupcji, chorobach"
                            },
                            {
                                "target_lang_word": "szalejący",
                                "target_lang_sense_clarification": "o inflacji, chorobie, plotkach"
                            },
                            {
                                "target_lang_word": "panoszący się",
                                "target_lang_sense_clarification": "o korupcji, przestępczości"
                            },
                            {
                                "target_lang_word": "powszechny",
                                "target_lang_sense_clarification": "o negatywnych zjawiskach występujących masowo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a3b6a01-0416-3b62-b4cf-20385756edd3",
                    "sense_definition": "Unrestrained, unchecked, or growing out of control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unchecked_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weeds grew <w>rampant</w> in the neglected garden, choking out all the beautiful flowers.",
                            "target_lang_translations": {
                                "ru": "Сорняки <w>буйно</w> разрослись в запущенном саду, заглушая все красивые цветы.",
                                "pl": "W zaniedbanym ogrodzie <w>bujnie</w> rozrastały się chwasty, zagłuszając wszystkie piękne kwiaty."
                            }
                        },
                        {
                            "text": "During the winter months, flu and other seasonal illnesses ran <w>rampant</w> through the crowded school.",
                            "target_lang_translations": {
                                "ru": "В зимние месяцы грипп и другие сезонные заболевания <w>свирепствовали</w> в переполненной школе.",
                                "pl": "W miesiącach zimowych grypa i inne choroby sezonowe <w>szalały</w> w przepełnionej szkole."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncontrolled",
                        "unchecked",
                        "unrestrained",
                        "wild"
                    ],
                    "antonyms": [
                        "controlled",
                        "restrained",
                        "checked"
                    ],
                    "common_phrases": [
                        "run rampant",
                        "rampant growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудержимый, безудержный или вышедший из-под контроля.",
                        "pl": "Bujny, niekontrolowany lub rozrastający się bez żadnych ograniczeń."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безудержный",
                                "target_lang_sense_clarification": "о росте, эмоциях"
                            },
                            {
                                "target_lang_word": "буйный",
                                "target_lang_sense_clarification": "о растительности"
                            },
                            {
                                "target_lang_word": "неконтролируемый",
                                "target_lang_sense_clarification": "о росте, распространении"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepohamowany",
                                "target_lang_sense_clarification": "o wzroście, sile"
                            },
                            {
                                "target_lang_word": "bujny",
                                "target_lang_sense_clarification": "o roślinności"
                            },
                            {
                                "target_lang_word": "niekontrolowany",
                                "target_lang_sense_clarification": "o rozroście, rozwoju"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6854de88-8699-35e3-b664-d6aa3998ec61",
                    "sense_definition": "Rearing up on the hind legs, especially with one foreleg raised, as depicted in heraldry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "heraldry_posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal family's coat of arms features a golden lion <w>rampant</w> against a blue background.",
                            "target_lang_translations": {
                                "ru": "На гербе королевской семьи изображен золотой <w>восстающий</w> лев на синем фоне.",
                                "pl": "Herb rodziny królewskiej przedstawia złotego lwa <w>wspiętego</w> na błękitnym tle."
                            }
                        },
                        {
                            "text": "He wore a signet ring engraved with a dragon <w>rampant</w> holding a sword.",
                            "target_lang_translations": {
                                "ru": "Он носил перстень с печаткой, на которой был выгравирован <w>вздыбленный</w> дракон, держащий меч.",
                                "pl": "Nosił sygnet z wygrawerowanym <w>wspiętym</w> smokiem trzymającym miecz."
                            }
                        }
                    ],
                    "synonyms": [
                        "rearing"
                    ],
                    "common_phrases": [
                        "lion rampant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стоящий на задних лапах (в геральдике).",
                        "pl": "Wspięty, stojący na tylnych łapach (w heraldyce)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздыбленный",
                                "target_lang_sense_clarification": "о геральдическом животном"
                            },
                            {
                                "target_lang_word": "восстающий",
                                "target_lang_sense_clarification": "геральдический термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wspięty",
                                "target_lang_sense_clarification": "termin heraldyczny o zwierzęciu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d293e75-1343-3a23-91fb-2af0be3257c0",
                    "sense_definition": "Rearing on both hind legs with the forelegs extended.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry_posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The majestic stallion stood <w>rampant</w> in the field, startled by the sudden thunder.",
                            "target_lang_translations": {
                                "ru": "Величественный жеребец встал <w>на дыбы</w> в поле, испугавшись внезапного грома.",
                                "pl": "Majestatyczny ogier stanął <w>dęba</w> na polu, spłoszony nagłym grzmotem."
                            }
                        },
                        {
                            "text": "The statue depicts a horse <w>rampant</w>, capturing a sense of wild energy.",
                            "target_lang_translations": {
                                "ru": "Статуя изображает коня, вставшего <w>на дыбы</w>, передавая ощущение дикой энергии.",
                                "pl": "Rzeźba przedstawia konia <w>wspiętego na tylnych nogach</w>, oddając poczucie dzikiej energii."
                            }
                        }
                    ],
                    "synonyms": [
                        "rearing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставший на дыбы, стоящий на задних ногах с вытянутыми передними.",
                        "pl": "Stojący dęba, wspięty na tylnych nogach."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставший на дыбы",
                                "target_lang_sense_clarification": "о животном"
                            },
                            {
                                "target_lang_word": "стоящий на задних лапах",
                                "target_lang_sense_clarification": "о животном"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dęba",
                                "target_lang_sense_clarification": "stojący dęba, o koniu lub innym zwierzęciu"
                            },
                            {
                                "target_lang_word": "wspięty",
                                "target_lang_sense_clarification": "o zwierzęciu stojącym na tylnych kończynach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25ef2145-11d2-3891-94c7-c8371093e593",
                    "sense_definition": "Tilted, describing an arch with one side higher than the other, or an inclined vault.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval cathedral features a <w>rampant</w> arch supporting the asymmetrical roofline.",
                            "target_lang_translations": {
                                "ru": "Средневековый собор украшает <w>ползучая</w> арка, поддерживающая асимметричную линию крыши.",
                                "pl": "Średniowieczna katedra posiada łuk <w>pełzający</w>, który wspiera asymetryczną linię dachu."
                            }
                        },
                        {
                            "text": "Architects used a <w>rampant</w> vault to accommodate the steep slope of the hillside.",
                            "target_lang_translations": {
                                "ru": "Архитекторы использовали <w>косой</w> свод, чтобы приспособить здание к крутому склону холма.",
                                "pl": "Architekci zastosowali sklepienie <w>pełzające</w>, aby dostosować budowlę do stromego zbocza wzgórza."
                            }
                        }
                    ],
                    "synonyms": [
                        "inclined",
                        "sloping"
                    ],
                    "common_phrases": [
                        "rampant arch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in architecture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Косой, наклонный (об арке или своде, у которых одна пята выше другой).",
                        "pl": "Połogi, asymetryczny (o łuku lub sklepieniu, którego podpory znajdują się na różnych wysokościach)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косой",
                                "target_lang_sense_clarification": "об арке"
                            },
                            {
                                "target_lang_word": "ползучий",
                                "target_lang_sense_clarification": "архитектурный термин для арок"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "połogi",
                                "target_lang_sense_clarification": "termin architektoniczny o łuku"
                            },
                            {
                                "target_lang_word": "pełzający",
                                "target_lang_sense_clarification": "termin architektoniczny o łuku lub sklepieniu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0694552e-cf62-307b-b2e4-b34005bfaba5",
                    "sense_definition": "In an unchecked, wild, or <w>rampant</w> manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wildflowers were growing <w>rampant</w> along the sides of the highway.",
                            "target_lang_translations": {
                                "ru": "Дикие цветы <w>буйно</w> росли по обочинам шоссе.",
                                "pl": "Polne kwiaty rosły <w>bujnie</w> wzdłuż pobocza autostrady."
                            }
                        },
                        {
                            "text": "Rumors are running <w>rampant</w> throughout the office regarding the upcoming layoffs.",
                            "target_lang_translations": {
                                "ru": "По всему офису <w>безудержно</w> ползут слухи о предстоящих увольнениях.",
                                "pl": "W biurze <w>szaleją</w> plotki na temat nadchodzących zwolnień."
                            }
                        }
                    ],
                    "synonyms": [
                        "rampantly",
                        "wildly"
                    ],
                    "common_phrases": [
                        "running rampant",
                        "growing rampant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безудержно, буйно или бесконтрольно.",
                        "pl": "W sposób niepohamowany, bujny lub trudny do opanowania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безудержно",
                                "target_lang_sense_clarification": "о росте, распространении"
                            },
                            {
                                "target_lang_word": "буйно",
                                "target_lang_sense_clarification": "о росте растений"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bujnie",
                                "target_lang_sense_clarification": "o wzroście roślin"
                            },
                            {
                                "target_lang_word": "niepohamowanie",
                                "target_lang_sense_clarification": "o rozprzestrzenianiu się"
                            },
                            {
                                "target_lang_word": "bezkarnie",
                                "target_lang_sense_clarification": "o szerzeniu się zjawisk bez kontroli"
                            }
                        ]
                    }
                }
            ]
        }
    ]
