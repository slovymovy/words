                "senses": [
                    {
                        "sense_id": "69e4c95a-3c30-3aa6-906c-6d481d2ff071",
                        "entry_id": "a78e3a45-86d3-3683-aa5c-43c4ccf4313b",
                        "glosses": [
                            "aromatische Kohlenstoffverbindung, die in drei isomeren Formen vorliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6360bb0d-aa37-41ee-839a-3d3495ff4ed8",
                                "sense_id": "69e4c95a-3c30-3aa6-906c-6d481d2ff071",
                                "text": "Xylol ist ein aromatischer Kohlenwasserstoff."
                            },
                            {
                                "example_id": "6cf70099-fef5-42c7-861c-b260976fa2f3",
                                "sense_id": "69e4c95a-3c30-3aa6-906c-6d481d2ff071",
                                "text": "Die Summenformel von Xylol ist C₆H₄(CH₃)₂."
                            },
                            {
                                "example_id": "117feec4-6c7f-494f-9a3f-df00fa0f7587",
                                "sense_id": "69e4c95a-3c30-3aa6-906c-6d481d2ff071",
                                "text": "Der Ausgangsstoff für viele Farb-, Duft- und Kunststoffe ist Xylol."
                            },
                            {
                                "example_id": "da969abb-5ea6-4f1d-abb9-30f897c9b836",
                                "sense_id": "69e4c95a-3c30-3aa6-906c-6d481d2ff071",
                                "text": "Xylol ist ein „Gemisch der drei Isomere des Dimethylbenzols, die aus Steinkohlenteer oder Erdöl gewonnen werden. […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18da9168-db5c-431a-a2bc-3ae83eced38a",
