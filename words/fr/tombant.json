            "senses": [
                {
                    "sense_id": "e7d14fa0-5b31-35bd-b64e-408e6a9c288b",
                    "sense_definition": "Qui décline, en parlant du jour ou de la clarté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les promeneurs ont regagné le village à la nuit <w>tombante</w>.",
                            "target_lang_translations": {
                                "en": "The walkers returned to the village as night was <w>falling</w>.",
                                "ru": "Гуляющие вернулись в деревню в <w>сгущавшихся</w> сумерках.",
                                "de": "Die Spaziergänger kehrten bei <w>einbrechender</w> Nacht ins Dorf zurück.",
                                "es": "Los paseantes regresaron al pueblo al <w>caer</w> la noche.",
                                "zh": "散步的人们在<w>渐暗</w>的夜色中回到了村子。"
                            }
                        },
                        {
                            "text": "Au jour <w>tombant</w>, les oiseaux se réfugient dans les branches.",
                            "target_lang_translations": {
                                "en": "As daylight <w>fades</w>, the birds take shelter in the branches.",
                                "ru": "При <w>угасающем</w> свете дня птицы укрываются в ветвях.",
                                "de": "Bei <w>schwindendem</w> Tageslicht suchen die Vögel Schutz in den Zweigen.",
                                "es": "Al <w>declinar</w> el día, los pájaros se refugian en las ramas.",
                                "zh": "在<w>将暗</w>的天光里，鸟儿都躲进了树枝间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "déclinant"
                    ],
                    "antonyms": [
                        "naissant"
                    ],
                    "common_phrases": [
                        "la nuit tombante",
                        "au jour tombant",
                        "au soir tombant"
