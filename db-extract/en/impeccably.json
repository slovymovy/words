                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c7c576-5f24-4fb9-919d-eeefb8a89f11",
                                                "sense_id": "da8f442b-d84f-3824-a940-fd2aad850ab1",
                                                "text": "Das Buch ist zwar gebraucht, befindet sich aber in einem tadellosen Zustand."
                                            },
                                            {
                                                "example_id": "c6628630-ac67-4b69-bc1c-e09907a50ec0",
                                                "sense_id": "da8f442b-d84f-3824-a940-fd2aad850ab1",
                                                "text": "„Zudem teilt mir ein dieser Tage aus der Mandschurei zurückgekehrter Ingenieur mit, daß sich die mandschurische Bahn nicht nur in einem tadellosen Zustande befinde, sondern auch sehr gut gebaut sei und starkbewacht (sic) werde.“"
                                            },
                                            {
                                                "example_id": "d5cccd76-eec8-41d4-a38f-7ec43b6ce1e7",
                                                "sense_id": "da8f442b-d84f-3824-a940-fd2aad850ab1",
                                                "text": "„Die tadellos gebildete, markige Stimme mit dem metallischen Schimmer, mehr noch ihre souveräne Beherrschung, nötigen Bewunderung ab.“"
                                            },
                                            {
                                                "example_id": "fe497005-8482-4a2b-ac60-5b2d66f392bd",
                                                "sense_id": "da8f442b-d84f-3824-a940-fd2aad850ab1",
                                                "text": "„Die Blockstation Berg am Lain sei allerdings erst seit 15. Mai in Betrieb gewesen, habe aber stets tadellos funktioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
