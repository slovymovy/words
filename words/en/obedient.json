{
    "word_family": [
        "obey",
        "obedience"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e63bbe4c-c5da-3c8c-aa26-a410a46f502a",
                    "sense_definition": "Willing to comply with the commands, orders, or instructions of those in authority.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "compliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>obedient</w> dog sat down immediately when its owner gave the command.",
                            "target_lang_translations": {
                                "zh": "那只<w>顺从的</w>狗在主人下达命令后立刻坐了下来。"
                            }
                        },
                        {
                            "text": "Students are expected to be <w>obedient</w> to the school rules at all times.",
                            "target_lang_translations": {
                                "zh": "学生们被要求时刻<w>服从</w>学校的规章制度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dutiful",
                        "compliant"
                    ],
                    "antonyms": [
                        "disobedient",
                        "defiant",
                        "rebellious",
                        "insubordinate"
                    ],
                    "common_phrases": [
                        "obedient child",
                        "obedient servant"
                    ],
                    "target_lang_definitions": {
                        "zh": "愿意服从权威人士的命令、指示或要求。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "顺从的",
                                "target_lang_sense_clarification": "形容人或动物听话、服从命令。"
                            },
                            {
                                "target_lang_word": "听话的",
                                "target_lang_sense_clarification": "口语中常用的表达，指孩子或下属服从管教。"
                            },
                            {
                                "target_lang_word": "服从的",
                                "target_lang_sense_clarification": "强调行为上遵守规则或命令。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1092f8ab-a332-331f-90fa-9b18d20e8e2d",
                    "sense_definition": "A person who follows orders or complies with authority.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "compliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system relies on mindless <w>obedients</w> to maintain the status quo.",
                            "target_lang_translations": {
                                "zh": "这个系统依赖于盲目的<w>顺从者</w>来维持现状。"
                            }
                        },
                        {
                            "text": "He was never one of the <w>obedients</w> who followed every rule without question.",
                            "target_lang_translations": {
                                "zh": "他从来都不是那种会毫无疑问地遵守每一条规则的<w>顺从者</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指代那些盲目服从命令或权威的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "顺从者",
                                "target_lang_sense_clarification": "指代服从权威的人。"
                            },
                            {
                                "target_lang_word": "听话的人",
                                "target_lang_sense_clarification": "指代习惯于听从他人指令的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}