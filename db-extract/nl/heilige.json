                    {
                        "sense_id": "91df3c26-424e-3b6d-9f11-8518ca454b61",
                        "entry_id": "1ff0bfd9-6d2c-3ae5-8818-ddf724ad129a",
                        "glosses": [
                            "persoon die zonder zonden is; heel braaf persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed769e2-cc56-4de9-99bf-adadb13b3368",
                                "sense_id": "91df3c26-424e-3b6d-9f11-8518ca454b61",
                                "text": "Met een vader als de onze en een zigeunerin als moeder - je hoeft tegenover mij echt niet te doen alsof je een heilige bent."
                            }
                        ]
                    },
                    {
                        "sense_id": "af2b88da-b9c3-325f-bae7-89fd52c7df93",
                        "entry_id": "1ff0bfd9-6d2c-3ae5-8818-ddf724ad129a",
                        "glosses": [
                            "persoon die heilig verklaard is door de paus"
                        ],
                        "tags": [
                            "in de Rooms-Katholieke Kerk"
                        ],
                        "examples": [
                            {
                                "example_id": "69089e0c-34f3-4445-ade3-12b9109ff98e",
                                "sense_id": "af2b88da-b9c3-325f-bae7-89fd52c7df93",
                                "text": "Heiligen zijn vooral in de Rooms-Katholieke Kerk van zeer groot belang, in de Protestantse Kerk zijn ze minder belangrijk."
                            },
                            {
                                "example_id": "3ded5270-e731-43f1-8704-2dc8827c4b7e",
                                "sense_id": "af2b88da-b9c3-325f-bae7-89fd52c7df93",
                                "text": "Heb je ooit van de heilige Rufina gehoord?' 'Nee."
                            },
                            {
                                "example_id": "b86156dd-9603-4b16-b2e1-9a25ef393270",
                                "sense_id": "af2b88da-b9c3-325f-bae7-89fd52c7df93",
                                "text": "De deugden en eigenschappen van deze tweede Nicolaas heeft men echter overgedragen op de eerste en die werd toen de heilige Nicolaas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abf74074-c4d2-4293-a066-dc8953a40c00",
                        "source_entry_id": "1ff0bfd9-6d2c-3ae5-8818-ddf724ad129a",
                        "target_lang_word": "saint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "577b98d2-fd73-306e-a529-89dfde95d749",
                                        "entry_id": "cb06abe5-a340-3a9a-8563-b569effeb2a1",
                                        "glosses": [
                                            "A deceased person whom a church or another religious group has officially recognised as especially holy or godly; one eminent for piety and virtue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671a5504-3650-4872-841a-f80c743b3e05",
                                                "sense_id": "577b98d2-fd73-306e-a529-89dfde95d749",
                                                "text": "The Roman Catholic Church proclaimed Kateri Tekakwitha a saint in 2012."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf1a8a4-42b6-3d15-932a-e1dc7c57bc1e",
                                        "entry_id": "cb06abe5-a340-3a9a-8563-b569effeb2a1",
                                        "glosses": [
                                            "One of the blessed in heaven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de85d39e-14ba-4879-b69f-0ef69d76949d",
                                                "sense_id": "fbf1a8a4-42b6-3d15-932a-e1dc7c57bc1e",
                                                "text": "Then ſhall thy Saints unmixt, and from th' impure / Farr ſeparate, circling thy holy Mount / Unfained Halleluiahs to thee ſing,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d207c35-e9dc-35b2-89ca-c89444c0d339",
                                        "entry_id": "cb06abe5-a340-3a9a-8563-b569effeb2a1",
                                        "glosses": [
                                            "A Christian; a faithful believer in the present world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f38f405-f19a-456c-bbf6-0a38a9e14142",
                                                "sense_id": "8d207c35-e9dc-35b2-89ca-c89444c0d339",
                                                "text": "Unto the Church of God which is at Corinth, to them that are sanctified in Christ Iesus, called to be Saints, with all that in euery place call vpon the Name of Iesus Christ our Lord, both theirs and ours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df4a138-55dc-3ffb-8d71-8b67b824f516",
                                        "entry_id": "cb06abe5-a340-3a9a-8563-b569effeb2a1",
                                        "glosses": [
                                            "Alternative letter-case form of Saint (“a Mormon, a Latter-day Saint”)."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "alt-of",
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5dad9a1-45e0-309c-9de9-40207f27d05d",
                                        "entry_id": "cb06abe5-a340-3a9a-8563-b569effeb2a1",
                                        "glosses": [
                                            "A person with similarly overwhelming positive qualities; one who does good."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61622d6a-fb4b-40cf-ad99-6c3a10365616",
                                                "sense_id": "b5dad9a1-45e0-309c-9de9-40207f27d05d",
                                                "text": "Dorothy Day was a living saint."
                                            },
                                            {
                                                "example_id": "6a657595-eec2-48b6-8c60-804193d564bc",
                                                "sense_id": "b5dad9a1-45e0-309c-9de9-40207f27d05d",
                                                "text": "Thanks for looking after the house while I'm away. You're a saint!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eece8c19-5bca-358d-9649-436afb0b2ce6",
                                        "entry_id": "cb06abe5-a340-3a9a-8563-b569effeb2a1",
                                        "glosses": [
                                            "A holy object."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe23749-4ac1-4376-bffb-cea90d76535b",
                                                "sense_id": "eece8c19-5bca-358d-9649-436afb0b2ce6",
                                                "text": "It is ruine to a man to deuoure ſaintes, and afterward to retracte the vowes."
                                            }
                                        ]
                                    }
                                ]
                            },
