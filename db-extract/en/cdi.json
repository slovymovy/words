                            "countable",
                            "ellipsis",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a815b58d-e267-49a9-91d7-4f72a04de3fd",
                                "sense_id": "200e6cf0-4a57-356f-8a86-b83f820000fc",
                                "text": "Lauren turned to him and said, “I grew up on Army bases, so I know what CDI means. Chicks Dig It. The average male thinks things that go boom have a higher CDI than the hard work of diplomacy.”"
                            }
                        ]
