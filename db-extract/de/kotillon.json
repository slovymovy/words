                "senses": [
                    {
                        "sense_id": "5bbf365d-6399-3c1a-8cdc-e25b0fa60104",
                        "entry_id": "6ed1339a-5b43-3075-835b-3c50dad72ebd",
                        "glosses": [
                            "ein aus Frankreich stammender Gesellschaftstanz bzw. ein Tanzspiel mit Verlosung scherzhafter Geschenkartikel"
                        ],
                        "tags": [
                            "Tanz"
                        ],
                        "examples": [
                            {
                                "example_id": "1d6465fe-a807-475f-aec9-8ca739388ab2",
                                "sense_id": "5bbf365d-6399-3c1a-8cdc-e25b0fa60104",
                                "text": "„Mitten im Kotillon kam Natascha, noch schwer atmend, nach Beendigung einer Tour auf ihren Platz zurück und wurde gleich darauf von einem neuen Kavalier aufgefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "59142748-e74c-320b-9009-22054307d458",
                        "entry_id": "6ed1339a-5b43-3075-835b-3c50dad72ebd",
                        "glosses": [
                            "kurzer Unterrock einer bäuerlichen Tracht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3640d225-b952-42b9-9032-787120d48d0f",
                        "source_entry_id": "6ed1339a-5b43-3075-835b-3c50dad72ebd",
                        "source_sense_id": "5bbf365d-6399-3c1a-8cdc-e25b0fa60104",
                        "target_lang_word": "cotillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cotillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c0711b1-0894-3aa0-9e18-123df118544f",
                                        "entry_id": "314327af-7ed3-30da-9903-7d2a04acb162",
                                        "glosses": [
                                            "Cotte ou jupe de dessous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b88f35d-01cf-4cc2-85d1-c3e2104c34a0",
                                                "sense_id": "8c0711b1-0894-3aa0-9e18-123df118544f",
                                                "text": "Ma femme a trente-six cotillons et j’ai même pas une culotte !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1142e25-58c5-381c-930d-2ef7c72f159e",
                                        "entry_id": "314327af-7ed3-30da-9903-7d2a04acb162",
                                        "glosses": [
                                            "Jupon des femmes du peuple et des paysannes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6ff91ac-cd1c-4b24-8c5e-2b70843c1c6d",
                                                "sense_id": "a1142e25-58c5-381c-930d-2ef7c72f159e",
                                                "text": "Une fille passa, conduisant un troupeau de dindons ; elle était vêtue d’un cotillon ignoble, et elle était sans beauté."
                                            },
                                            {
                                                "example_id": "83c18423-1ba5-4268-97a5-020385e26092",
                                                "sense_id": "a1142e25-58c5-381c-930d-2ef7c72f159e",
                                                "text": "Puis pivotant dans son ample cotillon, qui fit une gracieuse corolle autour de ses chevilles, elle voleta d'un pas léger vers la cuisine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05745270-dcbc-3b0e-9954-7841c660efd5",
                                        "entry_id": "314327af-7ed3-30da-9903-7d2a04acb162",
                                        "glosses": [
                                            "Femme, dans un jeu de séduction."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73434b72-61d2-431f-9f49-456db0595b82",
                                                "sense_id": "05745270-dcbc-3b0e-9954-7841c660efd5",
                                                "text": "FRANÇOISE : […]. Et ça vous enrage de voir de braves garçons se troubler la cervelle pour le premier cotillon venu !\nPIERRE : Le premier cotillon venu ! Dites une femme comme il n'y en a pas deux, une femme...\nFRANÇOISE, vivement : Ah ! t'es amoureux ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82b0f0ae-4369-3e17-8082-ecff368d07d1",
                                        "entry_id": "314327af-7ed3-30da-9903-7d2a04acb162",
                                        "glosses": [
                                            "Danse avec figures variées qui terminait certains bals."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04671f4-3cac-40f0-b40d-c93398a14dab",
                                                "sense_id": "82b0f0ae-4369-3e17-8082-ecff368d07d1",
                                                "text": "Ces danseurs et ces danseuses, presque étrangers à la maison, et qui finissent par s’emparer du terrain à toutes les noces, se livraient à ces interminables dernières contredanses nommées des cotillons, les joueurs de bouillotte étaient acharnés à leurs tables, le père Crevel gagnait six mille francs."
                                            },
                                            {
                                                "example_id": "fd9379f5-4c47-4828-badb-b42523eedef9",
                                                "sense_id": "82b0f0ae-4369-3e17-8082-ecff368d07d1",
                                                "text": "Vers une heure du matin, entrait avec bruit le petit groupe de la jeunesse dorée bruxelloise, décidé à ne s’amuser et à ne danser le cotillon qu’entre soi."
                                            },
                                            {
                                                "example_id": "d8f08de8-b2c2-427b-bba4-86077f435699",
                                                "sense_id": "82b0f0ae-4369-3e17-8082-ecff368d07d1",
                                                "text": "Lensky a tout vu, il s’indigne, il ne peut plus se contenir, et, après la mazourka, il invite sa fiancée pour le cotillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ec1c36e-ed66-31fa-8824-003f00149c7a",
                                        "entry_id": "314327af-7ed3-30da-9903-7d2a04acb162",
                                        "glosses": [
                                            "Accessoire de fête en papier ou carton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e45a6d10-530b-44b6-a255-d4267f279820",
                                                "sense_id": "2ec1c36e-ed66-31fa-8824-003f00149c7a",
                                                "text": "Elle sortit du sac un sans-gêne — ce cotillon qui se déroule comme une langue en produisant un drôle de bruit. Elle souffla dedans."
                                            },
                                            {
                                                "example_id": "e4e68132-67ac-4630-9501-116ff6d59308",
                                                "sense_id": "2ec1c36e-ed66-31fa-8824-003f00149c7a",
                                                "text": "J'étais bien seul, pour la première fois, sans enfants de mon âge autour de moi avec langues de belle-mère et cotillons comme ce fut le cas l'année précédente sur la terrasse de l'appartement du 22 Boulevard de Marseille."
                                            },
                                            {
                                                "example_id": "80b1058a-1394-4b16-a98b-79af26e391ae",
                                                "sense_id": "2ec1c36e-ed66-31fa-8824-003f00149c7a",
                                                "text": "Elle est fiancée à un des plus riches héritiers du Marais. Le fils d’un fabricant de farces-attrapes et d’accessoires de cotillon…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
