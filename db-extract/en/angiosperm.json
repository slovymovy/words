                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0666b2a6-dd2c-3bca-83bc-35ed1dd8a0ce",
                                        "entry_id": "203463e0-c5fe-3328-877a-a0bd277df3e9",
                                        "glosses": [
                                            "Klasse in der Abteilung Gefäßpflanzen"
                                        ],
                                        "tags": [
                                            "collective",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c051ef-039b-4c8e-aa99-34c9306c2983",
                                                "sense_id": "0666b2a6-dd2c-3bca-83bc-35ed1dd8a0ce",
                                                "text": "Die Magnolien mit ihrer spiraligen Anordnung der Fruchtblätter sind eine ursprüngliche Gruppe der Bedecktsamer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "72a13cd0-4cee-3e52-9133-7331e4485581",
                                        "entry_id": "203463e0-c5fe-3328-877a-a0bd277df3e9",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755c30fc-f7a1-417a-b75e-c159658b7bab",
                                                "sense_id": "72a13cd0-4cee-3e52-9133-7331e4485581",
                                                "text": "Die meisten höheren Pflanzen gehören zu den Bedecktsamern."
                                            }
