{
    "word_family": [
        "каков",
        "какой-то",
        "какой-либо",
        "какой-нибудь",
        "кое-какой",
        "никакой"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "ee4f0ba7-f2d6-3394-8942-92998be9542f",
                    "sense_definition": "Вопросительное слово, используемое для выяснения качества, свойств, признаков или типа предмета.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogative_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите, пожалуйста, <w>какой</w> сегодня день недели?",
                            "target_lang_translations": {
                                "en": "Tell me, please, <w>what</w> day of the week it is today?",
                                "zh": "请问今天<w>是</w>星期几？"
                            }
                        },
                        {
                            "text": "Я не знаю, <w>какая</w> погода будет завтра утром.",
                            "target_lang_translations": {
                                "en": "I don't know <w>what</w> the weather will be like tomorrow morning.",
                                "zh": "我不知道明天早上天气会<w>是什么样</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "како́го ро́да",
                        "что за"
                    ],
                    "common_phrases": [
                        "какой цвет",
                        "какая погода",
                        "какой адрес",
                        "какой смысл"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to ask about the nature, quality, or type of something.",
                        "zh": "用于询问事物的性质、特征、类型或种类。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "general interrogative"
                            },
                            {
                                "target_lang_word": "what kind of",
                                "target_lang_sense_clarification": "asking about type or quality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "什么",
                                "target_lang_sense_clarification": "询问性质或类型"
                            },
                            {
                                "target_lang_word": "什么样的",
                                "target_lang_sense_clarification": "询问具体特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbf328ed-0186-363b-b269-1923dd6ca6f6",
                    "sense_definition": "Вопросительное слово, используемое для выбора одного предмета или лица из ряда однородных (в значении «который»).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogative_selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Какой</w> из этих двух костюмов тебе нравится больше?",
                            "target_lang_translations": {
                                "en": "<w>Which</w> of these two suits do you like more?",
                                "zh": "这两套西装里你更喜欢<w>哪</w>一套？"
                            }
                        },
                        {
                            "text": "Мы ещё не решили, в <w>каком</w> ресторане будем ужинать.",
                            "target_lang_translations": {
                                "en": "We haven't decided yet <w>which</w> restaurant we will have dinner in.",
                                "zh": "我们还没决定要去<w>哪</w>家餐厅吃晚饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кото́рый",
                        "кото́рый из",
                        "како́й из"
                    ],
                    "common_phrases": [
                        "в каком году",
                        "на какой улице",
                        "какой из них"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to specify one or more things from a definite set.",
                        "zh": "用于从一组确定的事物中进行选择。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "selection from a group"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哪",
                                "target_lang_sense_clarification": "用于选择"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecf8e8b0-071f-3dee-a626-2f02cb2654db",
                    "sense_definition": "Слово, используемое в восклицательных предложениях для выражения сильных эмоций (удивления, восхищения, возмущения) по поводу качества предмета.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "exclamatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Какой</w> прекрасный вид открывается из вашего окна!",
                            "target_lang_translations": {
                                "en": "<w>What a</w> beautiful view opens up from your window!",
                                "zh": "从你的窗户看出去的景色<w>多么</w>美啊！"
                            }
                        },
                        {
                            "text": "Господи, <w>какой</w> ужас творится на дорогах в час пик!",
                            "target_lang_translations": {
                                "en": "God, <w>what</w> horror is happening on the roads during rush hour!",
                                "zh": "天哪，高峰期的路上<w>真</w>是太可怕了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "как",
                        "что"
                    ],
                    "common_phrases": [
                        "какой ужас",
                        "какой кошмар",
                        "какая красота",
                        "какой молодец"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in exclamations to emphasize a remarkable quality or degree.",
                        "zh": "用于感叹句，强调事物的程度或品质。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "exclamatory"
                            },
                            {
                                "target_lang_word": "what a",
                                "target_lang_sense_clarification": "exclamatory with countable nouns"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多么",
                                "target_lang_sense_clarification": "感叹程度"
                            },
                            {
                                "target_lang_word": "真",
                                "target_lang_sense_clarification": "感叹品质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8092cfa3-817b-3d69-b6a7-438bfcdeb968",
                    "sense_definition": "Союзное слово, которое связывает придаточное предложение с главным (часто соотносится с указательными местоимениями «тот», «такой»).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Выбирай любую книгу, <w>какую</w> только захочешь прочитать.",
                            "target_lang_translations": {
                                "en": "Choose any book <w>that</w> you want to read.",
                                "zh": "选一本你<w>所</w>想读的任何书吧。"
                            }
                        },
                        {
                            "text": "Здесь мы найдём именно те материалы, <w>какие</w> нам нужны для работы.",
                            "target_lang_translations": {
                                "en": "Here we will find exactly those materials <w>which</w> we need for work.",
                                "zh": "我们可以在这里找到工作<w>所</w>需要的那些材料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кото́рый"
                    ],
                    "common_phrases": [
                        "такой какой",
                        "тот какой",
                        "все какие есть"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to introduce a relative clause, referring to a noun mentioned previously.",
                        "zh": "用于引导定语从句，指代前文提到的名词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "relative pronoun"
                            },
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "relative pronoun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "所",
                                "target_lang_sense_clarification": "用于定语从句"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08b24d77-1c26-3397-85e4-111dbab3211e",
                    "sense_definition": "Обозначает тождество или сходство, обычно в конструкциях сравнения (такой... какой).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она любит меня таким, <w>какой</w> я есть на самом деле.",
                            "target_lang_translations": {
                                "en": "She loves me <w>as</w> I really am.",
                                "zh": "她爱我本来的<w>样子</w>。"
                            }
                        },
                        {
                            "text": "Лучше видеть вещи такими, <w>какие</w> они существуют в реальности.",
                            "target_lang_translations": {
                                "en": "It is better to see things <w>as</w> they exist in reality.",
                                "zh": "最好能看清事物原本的<w>样子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "как"
                    ],
                    "common_phrases": [
                        "такой какой есть",
                        "не такой какой"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in comparison structures to indicate similarity or identity.",
                        "zh": "用于比较结构，表示相似或等同。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "in 'such... as' constructions"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像……一样",
                                "target_lang_sense_clarification": "比较结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc5c1893-8306-3f4a-856d-38611b85c6f1",
                    "sense_definition": "Употребляется в значении неопределённого местоимения: некий, какой-то, какой-нибудь.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если возникнет <w>какой</w> вопрос, сразу звони мне на мобильный.",
                            "target_lang_translations": {
                                "en": "If <w>any</w> question arises, call me on my mobile immediately.",
                                "zh": "如果出现<w>任何</w>问题，立刻打我手机。"
                            }
                        },
                        {
                            "text": "Может быть, у вас найдётся <w>какой</w> инструмент для ремонта?",
                            "target_lang_translations": {
                                "en": "Maybe you can find <w>some</w> tool for repair?",
                                "zh": "或许你那里有<w>某种</w>维修工具吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "како́й-то",
                        "како́й-нибудь"
                    ],
                    "common_phrases": [
                        "какой-никакой",
                        "мало ли какой"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in spoken language instead of 'какой-то' or 'какой-нибудь'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to refer to an unspecified or unknown person or thing.",
                        "zh": "用于指代不确定的事物或人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "any",
                                "target_lang_sense_clarification": "indefinite determiner"
                            },
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "indefinite determiner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "某个",
                                "target_lang_sense_clarification": "不确定指代"
                            },
                            {
                                "target_lang_word": "任何",
                                "target_lang_sense_clarification": "泛指"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}