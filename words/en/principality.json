{
    "word_family": [
        "prince",
        "princess",
        "princely",
        "principal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6402b41a-7e94-3744-bc24-df3912883863",
                    "sense_definition": "A territory, region, or sovereign nation ruled by a prince or princess.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "territory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Monaco is a small European <w>principality</w> located along the Mediterranean coast."
                        },
                        {
                            "text": "In medieval times, the land was divided into several independent <w>principalities</w>."
                        }
                    ],
                    "common_phrases": [
                        "independent principality",
                        "sovereign principality"
                    ]
                },
                {
                    "sense_id": "a0c35bd5-eb47-3143-adf6-385bedc36a31",
                    "sense_definition": "In Christian angelology, a high order of angels ranking above archangels and below powers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval scholar wrote a detailed treatise describing each <w>principality</w> within the celestial hierarchy."
                        },
                        {
                            "text": "The scriptural passage refers to powers and <w>principalities</w> governing unseen realms."
                        }
                    ],
                    "common_phrases": [
                        "powers and principalities"
                    ]
                },
                {
                    "sense_id": "17786324-60ca-37de-baa7-6fa7d4ce6dfc",
                    "sense_definition": "The status, supreme authority, or rule of a prince.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warlord claimed absolute <w>principality</w> over all the surrounding provinces."
                        },
                        {
                            "text": "His right to <w>principality</w> was challenged by rival claimants to the throne."
                        }
                    ],
                    "synonyms": [
                        "sovereignty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean sovereign power"
                        }
                    ]
                },
                {
                    "sense_id": "406d31d0-1487-320c-bdda-1136ae5163cb",
                    "sense_definition": "The quality or state of being principal; supreme importance or prominence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "prominence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued for the <w>principality</w> of reason over emotional impulse."
                        },
                        {
                            "text": "No one doubted the <w>principality</w> of his contribution to modern physics."
                        }
                    ],
                    "synonyms": [
                        "pre-eminence",
                        "primacy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean pre-eminence"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7606e312-3b72-3b96-afcc-c5a2a2f90582",
                    "sense_definition": "Wales, traditionally referred to as the Principality of Wales.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wales",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many tourists visit the scenic valleys of the <w>Principality</w> every summer."
                        },
                        {
                            "text": "Rugby remains an enduring national passion throughout the <w>Principality</w>."
                        }
                    ],
                    "synonyms": [
                        "Wales"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in the United Kingdom"
                        }
                    ]
                },
                {
                    "sense_id": "bfc437e2-a8ee-329a-a5ca-7f48616a77b4",
                    "sense_definition": "Any specific sovereign state ruled by a prince, such as Monaco, Liechtenstein, or Andorra, when used as a proper title.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "territory",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The ambassador delivered official greetings to the reigning prince of the <w>Principality</w>."
                        },
                        {
                            "text": "Cross-border tax agreements between France and the <w>Principality</w> were renegotiated."
                        }
                    ]
                }
            ]
        }
    ]
