                                                "example_id": "0abf6570-9338-4112-8804-07771e833730",
                                                "sense_id": "efa52ebc-03e4-3e51-a036-11af81d3dcd6",
                                                "text": "„Parteiübergreifend empören sich Abgeordnete über die Arroganz des Regierungschefs und seiner Minister.“"
                                            },
                                            {
                                                "example_id": "9e2bc591-d27c-4d50-9d37-cb8f9f70189f",
                                                "sense_id": "efa52ebc-03e4-3e51-a036-11af81d3dcd6",
                                                "text": "„In Deutschland fordern Politiker parteiübergreifend eine Impfpflicht.“"
                                            }
