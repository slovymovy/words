                "senses": [
                    {
                        "sense_id": "19bbcab3-c921-3377-a5dd-9c775a6e28d5",
                        "entry_id": "aef6842b-71d7-370a-89fa-44fb800e5c31",
                        "glosses": [
                            "Planter ou peupler de résineux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45c9626-c4d6-451b-aad3-7083a3b49d9b",
                                "sense_id": "19bbcab3-c921-3377-a5dd-9c775a6e28d5",
                                "text": "[…] les landes à Bruyères déjà troublées dans leur évolution naturelle par des plantations de Bouleaux, le seront plus encore lorsque dans un avenir prochain l’administration forestière aura enrésiné par des plantations d’Épicéa le plateau tourbeux d’Ecromagny […]"
                            },
                            {
                                "example_id": "087e48be-16a3-4f01-b23d-5bccbc57a6a7",
                                "sense_id": "19bbcab3-c921-3377-a5dd-9c775a6e28d5",
                                "text": "Leur remplacement demandant un temps trop long, M. Doré résolut d’enrésiner toutes les bonnes parties du massif, soit une centaine d’hectares."
                            },
                            {
                                "example_id": "e6033c0d-bd08-4879-a3d5-c90cadb28119",
                                "sense_id": "19bbcab3-c921-3377-a5dd-9c775a6e28d5",
                                "text": "Faut-il continuer à enrésiner ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c82520da-64c6-361f-b5b3-bb91fb2386db",
                        "entry_id": "aef6842b-71d7-370a-89fa-44fb800e5c31",
                        "glosses": [
                            "Enduire de résine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81bcd2f3-eb87-423b-90a6-8fe1f29c7a89",
                                "sense_id": "c82520da-64c6-361f-b5b3-bb91fb2386db",
                                "text": "Le résultat à retenir est la possibilité pour nous d’enrésiner des wafers ayant subi des gravures profondes."
                            }
                        ]
                    }
