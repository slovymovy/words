                "senses": [
                    {
                        "sense_id": "ba97745c-3f31-35cd-a711-72c549ee4e8c",
                        "entry_id": "004d0886-dc71-3a51-97d3-feb0f7aa6fcf",
                        "glosses": [
                            "Tisch, der an/vor einer Couch oder einem Sofa platziert wird und entsprechend eine relativ niedrige Tischplatte hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e7055b-6065-4d03-825a-28ef54fd22b0",
                                "sense_id": "ba97745c-3f31-35cd-a711-72c549ee4e8c",
                                "text": "„Er schob, während er so sprach, den Sofatisch beiseite und begann auszupacken.“"
                            },
                            {
                                "example_id": "cc8210bc-6967-47d4-937a-af04fb7d1c40",
                                "sense_id": "ba97745c-3f31-35cd-a711-72c549ee4e8c",
                                "text": "„Als Páll am Abend gegen Einbruch der Dunkelheit nach Hause kam, lag Skúli noch immer gemütlich auf dem Sofa, das Buch aufgeschlagen auf seiner Brust, der Kaffee in seinem Becher auf dem Sofatisch aber so kalt, dass er sicher schon seit Stunden tot war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
