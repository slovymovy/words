{
    "word_family": [
        "deal",
        "dealing",
        "dealership"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a35861f5-832e-34d4-b95e-96d5e034b185",
                    "sense_definition": "A person or business that buys and sells goods, especially cars.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to buy our new vehicle from a reputable car <w>dealer</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили купить наш новый автомобиль у авторитетного <w>дилера</w>.",
                                "zh": "我们决定从一家信誉良好的汽车<w>经销商</w>那里购买新车。"
                            }
                        },
                        {
                            "text": "She works as an antique <w>dealer</w> and travels the country looking for rare items.",
                            "target_lang_translations": {
                                "ru": "Она работает <w>торговцем</w> антиквариатом и ездит по стране в поисках редких предметов.",
                                "zh": "她是一名古董<w>商人</w>，经常在全国各地奔波寻找稀有物品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trader",
                        "vendor"
                    ],
                    "common_phrases": [
                        "car dealer",
                        "antique dealer",
                        "art dealer",
                        "authorized dealer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или компания, покупающие и продающие товары, особенно автомобили.",
                        "zh": "从事商品买卖的个人或企业，尤指汽车销售商。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилер",
                                "target_lang_sense_clarification": "официальный представитель, автодилер"
                            },
                            {
                                "target_lang_word": "торговец",
                                "target_lang_sense_clarification": "антиквариатом, предметами искусства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经销商",
                                "target_lang_sense_clarification": "指代汽车或大型商品的销售商"
                            },
                            {
                                "target_lang_word": "商人",
                                "target_lang_sense_clarification": "指代古董或艺术品交易者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1311846-e5f2-3b9c-8947-9e23a180e668",
                    "sense_definition": "A person who sells illegal drugs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "trader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested a suspected drug <w>dealer</w> near the park last night.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью полиция арестовала подозреваемого <w>наркоторговца</w> возле парка.",
                                "zh": "昨晚警方在公园附近逮捕了一名涉嫌<w>毒贩</w>。"
                            }
                        },
                        {
                            "text": "He ruined his life by getting involved with a local <w>dealer</w>.",
                            "target_lang_translations": {
                                "ru": "Он разрушил свою жизнь, связавшись с местным <w>дилером</w>.",
                                "zh": "他因为与当地的<w>毒贩</w>混在一起而毁了自己的一生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peddler"
                    ],
                    "common_phrases": [
                        "drug dealer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который продает запрещенные наркотические средства.",
                        "zh": "贩卖非法毒品的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наркоторговец",
                                "target_lang_sense_clarification": "стандартный термин"
                            },
                            {
                                "target_lang_word": "дилер",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒贩",
                                "target_lang_sense_clarification": "贩卖毒品的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a38fdf8-da07-39a3-9813-b785a4923117",
                    "sense_definition": "The person who distributes the cards to players in a card game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distributor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dealer</w> shuffled the deck thoroughly before starting the next hand.",
                            "target_lang_translations": {
                                "ru": "<w>Сдающий</w> тщательно перетасовал колоду перед началом следующей раздачи.",
                                "zh": "<w>发牌员</w>在开始下一局之前彻底洗了牌。"
                            }
                        },
                        {
                            "text": "In this game, the <w>dealer</w> must stand on seventeen.",
                            "target_lang_translations": {
                                "ru": "В этой игре <w>дилер</w> должен остановиться на семнадцати.",
                                "zh": "在这场游戏中，<w>荷官</w>必须在十七点时停牌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "card dealer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который раздает карты игрокам в карточной игре.",
                        "zh": "在纸牌游戏中负责给玩家发牌的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдающий",
                                "target_lang_sense_clarification": "в карточной игре"
                            },
                            {
                                "target_lang_word": "дилер",
                                "target_lang_sense_clarification": "в казино"
                            },
                            {
                                "target_lang_word": "крупье",
                                "target_lang_sense_clarification": "профессиональный работник казино"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发牌员",
                                "target_lang_sense_clarification": "一般纸牌游戏中的发牌者"
                            },
                            {
                                "target_lang_word": "荷官",
                                "target_lang_sense_clarification": "赌场中专业的发牌人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81b4e5e1-40d7-3453-b518-3e03122f1c13",
                    "sense_definition": "A person or firm in the business of buying and selling securities for their own account.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bond <w>dealer</w> quoted a price for the new government issue.",
                            "target_lang_translations": {
                                "ru": "<w>Дилер</w> по облигациям назначил цену за новый государственный выпуск.",
                                "zh": "债券<w>交易商</w>为新发行的政府债券报了价。"
                            }
                        },
                        {
                            "text": "He works as a securities <w>dealer</w> for a major investment bank.",
                            "target_lang_translations": {
                                "ru": "Он работает <w>дилером</w> по ценным бумагам в крупном инвестиционном банке.",
                                "zh": "他在一家大型投资银行担任证券<w>交易商</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "broker-dealer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или фирма, занимающиеся куплей-продажей ценных бумаг за свой счет.",
                        "zh": "以自有资金从事证券买卖的个人或公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилер",
                                "target_lang_sense_clarification": "на рынке ценных бумаг"
                            },
                            {
                                "target_lang_word": "маклер",
                                "target_lang_sense_clarification": "биржевой посредник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交易商",
                                "target_lang_sense_clarification": "金融市场中进行证券买卖的机构或个人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41379b71-bb68-3b84-9b27-f1c2734952cb",
                    "sense_definition": "One who distributes or inflicts something, often of a serious or abstract nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distributor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fate is often a cruel <w>dealer</w> of unexpected misfortunes.",
                            "target_lang_translations": {
                                "ru": "Судьба часто бывает жестоким <w>раздатчиком</w> неожиданных бед.",
                                "zh": "命运往往是残酷的意外不幸的<w>散布者</w>。"
                            }
                        },
                        {
                            "text": "The general was known as a fierce <w>dealer</w> of justice on the battlefield.",
                            "target_lang_translations": {
                                "ru": "Генерал был известен как суровый <w>вершитель</w> правосудия на поле битвы.",
                                "zh": "这位将军在战场上以严厉的公正<w>施加者</w>而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто распределяет или причиняет что-либо, часто серьезного или абстрактного характера.",
                        "zh": "分发或施加某物的人，通常指抽象或严重的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вершитель",
                                "target_lang_sense_clarification": "правосудия, судеб"
                            },
                            {
                                "target_lang_word": "раздатчик",
                                "target_lang_sense_clarification": "распределитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "施加者",
                                "target_lang_sense_clarification": "指施加惩罚或正义的人"
                            },
                            {
                                "target_lang_word": "散布者",
                                "target_lang_sense_clarification": "指分发不幸或灾难的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}