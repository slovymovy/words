                        "cross_references": [
                            {
                                "target_word": "genoma",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "e8818ee0-09a3-364b-a1bf-e26f833746dd",
                                        "entry_id": "523c2b8b-e07f-308a-b519-55d1e4d76d26",
                                        "glosses": [
                                            "complesso di DNA contenuto in una cellula, formato dall'insieme di geni di un essere vivente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3bb161-1e58-4b66-81b0-4f1aa58596ba",
                                                "sense_id": "e8818ee0-09a3-364b-a1bf-e26f833746dd",
                                                "text": "alcuni virus inserendosi nel genoma della cellula ospite possono casualmente produrre un tumore"
                                            },
                                            {
                                                "example_id": "9f853d0f-ffbd-47f9-a35c-bc62feb6d9b6",
                                                "sense_id": "e8818ee0-09a3-364b-a1bf-e26f833746dd",
                                                "text": "nel genoma umano ci sono circa ventimila geni"
                                            },
                                            {
                                                "example_id": "66eba813-c1de-4d69-bc05-055ab095b4cf",
                                                "sense_id": "e8818ee0-09a3-364b-a1bf-e26f833746dd",
                                                "text": "il genoma di un mammut è lungo 3,2 miliardi di basi"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
