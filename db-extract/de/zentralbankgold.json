                ],
                "senses": [
                    {
                        "sense_id": "fae46151-d73d-3059-95be-7f8aa1ec8aee",
                        "entry_id": "95316648-b379-3172-b13f-d75f12ea9722",
                        "glosses": [
                            "Gold, das sich im Besitz einer Zentralbank befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637aba0c-b497-4fd8-b140-341438f5a1c7",
                                "sense_id": "fae46151-d73d-3059-95be-7f8aa1ec8aee",
                                "text": "„Für die Zentralbanken dieser - und anderer Länder - wäre eine neue Drehscheibe für Zentralbankgold \"ein Gewinn, denn sie würden unabhängig von der Überwachung und Kontrolle durch westliche Zentralbanken sein\".“"
                            },
                            {
                                "example_id": "9d7f9cb5-c9d1-42da-8adb-d2ee1b4ff74a",
                                "sense_id": "fae46151-d73d-3059-95be-7f8aa1ec8aee",
                                "text": "„„Von diesen Ländern ist durchaus zu erwarten, dass sie zunächst ihre Vermögenswerte, also auch das Zentralbankgold einsetzen, um durch Schuldenabbau ein tragfähiges Niveau zu erreichen“, sagte Willsch.“"
                            },
                            {
                                "example_id": "ab7b0b38-f46d-4097-9e74-892144eb99cd",
                                "sense_id": "fae46151-d73d-3059-95be-7f8aa1ec8aee",
                                "text": "„Gerechtfertigt wurde der Verkauf von Zentralbankgold immer damit, dass Gold den Notenbanken und damit den Staaten keine laufenden Erträge und keine Wertsteigerungen bringe.“"
                            },
                            {
                                "example_id": "67ded6c1-be9a-4722-94e9-478b310ee7ad",
                                "sense_id": "fae46151-d73d-3059-95be-7f8aa1ec8aee",
                                "text": "„Seither gibt es sogenanntes Zentralbankgold, das zum offiziellen Preis des US-Schatzamtes zum Ausgleich der Zahlungsbilanzen verrechnet wird, und Warengold, dessen Preis sich nach Angebot und Nachfrage reguliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
