{
    "word_family": [
        "set",
        "beset",
        "upset",
        "reset",
        "preset",
        "offset",
        "outset",
        "sunset"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "613c087c-dada-30ad-9b70-556ffad058bb",
                    "sense_definition": "The beginning or start of something, especially something unpleasant or difficult.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>onset</w> of winter brought heavy snow and freezing temperatures to the valley.",
                            "target_lang_translations": {
                                "ru": "<w>Наступление</w> зимы принесло в долину сильные снегопады и морозы.",
                                "tr": "Kışın <w>başlaması</w> vadiye yoğun kar ve dondurucu soğuklar getirdi."
                            }
                        },
                        {
                            "text": "Farmers rushed to harvest their crops before the <w>onset</w> of the monsoon rains.",
                            "target_lang_translations": {
                                "ru": "Фермеры спешили собрать урожай до <w>наступления</w> муссонных дождей.",
                                "tr": "Çiftçiler, muson yağmurlarının <w>baş göstermesinden</w> önce ürünlerini toplamak için acele ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "start",
                        "beginning",
                        "commencement"
                    ],
                    "antonyms": [
                        "end",
                        "conclusion",
                        "finish",
                        "termination"
                    ],
                    "common_phrases": [
                        "sudden onset",
                        "onset of winter",
                        "at the onset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начало или наступление чего-либо, особенно неприятного или трудного.",
                        "tr": "Özellikle olumsuz veya zor bir şeyin başlaması veya baş göstermesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наступление",
                                "target_lang_sense_clarification": "приход времени года, события"
                            },
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başlangıç",
                                "target_lang_sense_clarification": "genel anlamda bir olayın veya sürecin ilki"
                            },
                            {
                                "target_lang_word": "baş gösterme",
                                "target_lang_sense_clarification": "olumsuz durumların ortaya çıkması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "531c752a-6ce7-30a7-953a-baf5ea023ccd",
                    "sense_definition": "The initial phase of a disease or condition, in which symptoms first become apparent.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors prescribed medication to delay the <w>onset</w> of the disease.",
                            "target_lang_translations": {
                                "ru": "Врачи прописали лекарство, чтобы отсрочить <w>начало</w> болезни.",
                                "tr": "Doktorlar hastalığın <w>başlangıcını</w> geciktirmek için ilaç yazdılar."
                            }
                        },
                        {
                            "text": "The patient reported that the <w>onset</w> of pain occurred early in the morning.",
                            "target_lang_translations": {
                                "ru": "Пациент сообщил, что <w>приступ</w> боли произошел рано утром.",
                                "tr": "Hasta, ağrının <w>ortaya çıkışının</w> sabahın erken saatlerinde gerçekleştiğini bildirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "start",
                        "beginning",
                        "commencement"
                    ],
                    "antonyms": [
                        "end"
                    ],
                    "common_phrases": [
                        "onset of symptoms",
                        "early onset",
                        "delayed onset",
                        "age of onset"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical or formal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начальная фаза болезни или состояния, когда симптомы впервые становятся заметными.",
                        "tr": "Bir hastalığın veya tıbbi durumun belirtilerinin ilk kez ortaya çıktığı evre."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "болезни, процесса"
                            },
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "боли, острого состояния"
                            },
                            {
                                "target_lang_word": "возникновение",
                                "target_lang_sense_clarification": "появление симптомов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başlangıç",
                                "target_lang_sense_clarification": "hastalık veya durum başlangıcı"
                            },
                            {
                                "target_lang_word": "ortaya çıkış",
                                "target_lang_sense_clarification": "semptomların belirginleşmesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee6f97ae-a0ae-3bf8-9246-d57db26282a2",
                    "sense_definition": "An attack or assault, especially by an army.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers stood firm against the furious <w>onset</w> of the enemy troops.",
                            "target_lang_translations": {
                                "ru": "Солдаты стойко держались против яростного <w>натиска</w> вражеских войск.",
                                "tr": "Askerler, düşman birliklerinin öfkeli <w>saldırısına</w> karşı dik durdular."
                            }
                        },
                        {
                            "text": "The castle walls were built to withstand a sudden <w>onset</w> from invaders.",
                            "target_lang_translations": {
                                "ru": "Стены замка были построены так, чтобы выдержать внезапное <w>нападение</w> захватчиков.",
                                "tr": "Kale surları, işgalcilerin ani bir <w>hücumuna</w> dayanacak şekilde inşa edilmişti."
                            }
                        }
                    ],
                    "synonyms": [
                        "storming"
                    ],
                    "antonyms": [
                        "retreat",
                        "defense"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атака или нападение, особенно со стороны армии.",
                        "tr": "Özellikle bir ordu tarafından yapılan saldırı veya hücum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натиск",
                                "target_lang_sense_clarification": "сильное давление, напор"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "военное нападение"
                            },
                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "штурм"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "saldırı",
                                "target_lang_sense_clarification": "askeri veya fiziksel hücum"
                            },
                            {
                                "target_lang_word": "hiddetli hücum",
                                "target_lang_sense_clarification": "şiddetli baskın veya saldırı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "630f8e9c-a7f8-393d-9dc9-5d0fdc7813c0",
                    "sense_definition": "The initial portion of a syllable, preceding the syllable nucleus (usually the vowel).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the word \"cat\", the sound /k/ forms the <w>onset</w> of the syllable.",
                            "target_lang_translations": {
                                "ru": "В слове «cat» звук /k/ образует <w>приступ</w> слога.",
                                "tr": "\"Cat\" kelimesinde /k/ sesi hecenin <w>başını</w> oluşturur."
                            }
                        },
                        {
                            "text": "Some languages allow complex clusters of consonants in the syllable <w>onset</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые языки допускают сложные сочетания согласных в <w>приступе</w> слога.",
                                "tr": "Bazı diller, hece <w>başında</w> karmaşık ünsüz kümelerine izin verir."
                            }
                        }
                    ],
                    "antonyms": [
                        "coda"
                    ],
                    "common_phrases": [
                        "syllable onset",
                        "complex onset"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начальная часть слога, предшествующая ядру (обычно гласному).",
                        "tr": "Fonolojide bir hecenin çekirdeğinden (genellikle ünlü harf) önce gelen başlangıç kısmı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "лингвистика"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hece başı",
                                "target_lang_sense_clarification": "dilbilim, hecenin ilk kısmı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26af1468-cb66-39dc-a17f-bb780ac06c73",
                    "sense_definition": "The beginning of a musical note or other sound, in which the amplitude rises from zero to an initial peak.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>onset</w> of the drum beat was sharp and distinct in the recording.",
                            "target_lang_translations": {
                                "ru": "<w>Атака</w> барабанного удара на записи была резкой и отчетливой.",
                                "tr": "Kayıtta davul vuruşunun <w>ataktı</w> keskin ve belirgindi."
                            }
                        },
                        {
                            "text": "Software can detect the <w>onset</w> of each note to transcribe the melody automatically.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение может определять <w>атаку</w> каждой ноты для автоматической транскрипции мелодии.",
                                "tr": "Yazılım, melodiyi otomatik olarak notaya dökmek için her notanın <w>başlangıcını</w> tespit edebilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "start",
                        "beginning"
                    ],
                    "antonyms": [
                        "decay",
                        "release"
                    ],
                    "common_phrases": [
                        "onset detection"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "music and acoustics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начало музыкальной ноты или другого звука, характеризующееся нарастанием амплитуды.",
                        "tr": "Bir müzik notasının veya sesin, genliğin sıfırdan zirveye ulaştığı başlangıç anı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "акустика, музыка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "atak",
                                "target_lang_sense_clarification": "müzik ve ses fiziği"
                            },
                            {
                                "target_lang_word": "başlangıç",
                                "target_lang_sense_clarification": "sesin veya notanın ilk anı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}