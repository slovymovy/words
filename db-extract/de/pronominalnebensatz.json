                ],
                "senses": [
                    {
                        "sense_id": "47703600-21bc-3b68-8d19-a313696f0e98",
                        "entry_id": "b01738b9-e38c-337d-8ff9-1a30fe065a2b",
                        "glosses": [
                            "Teilsatz, der durch ein Pronomen oder Pronominaladverb eingeleitet wird"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "7427fbfd-0194-400c-8eba-e203b9c1ae7c",
                                "sense_id": "47703600-21bc-3b68-8d19-a313696f0e98",
                                "text": "Der Satz: \"Peter, den ich erst gestern sah, liegt im Krankenhaus\" enthält den Pronominalnebensatz \"den ich erst gestern sah\". Dieser Pronominalnebensatz dient wie viele andere auch als Attribut."
                            },
                            {
                                "example_id": "0d9daea6-26e6-4025-8c8c-09a1137ddcda",
                                "sense_id": "47703600-21bc-3b68-8d19-a313696f0e98",
                                "text": "Der Satz: \"Das Loch, worin man die Funde entdeckte, erwies sich zunächst als zu tief\" enthält einen Pronominalnebensatz, der mit einem Pronominaladverb (\"worin\") eingeleitet wird."
                            },
                            {
                                "example_id": "226a1cdc-18d7-485d-a721-80e91c52cbe7",
                                "sense_id": "47703600-21bc-3b68-8d19-a313696f0e98",
                                "text": "Die Begriffe Relativsatz und Pronominalnebensatz unterscheiden sich dadurch, dass der erstere die grammatische Relation zu einer Bezugseinheit betont, während der andere die Art des Einleitewortes herausstellt."
                            },
                            {
                                "example_id": "d84b6d7a-8bdf-4bcf-8d15-3b417f78afc6",
                                "sense_id": "47703600-21bc-3b68-8d19-a313696f0e98",
                                "text": "„Bei der einen Unterart enthält das Satzglied im Vorfeld ein besonderes Pronomen, Artikelwort oder Pro-Adverb. Man spricht daher auch von Pronominalnebensätzen.“"
                            },
                            {
                                "example_id": "36d78cb8-659d-4e1b-be5d-a50fcd63f646",
                                "sense_id": "47703600-21bc-3b68-8d19-a313696f0e98",
                                "text": "„Bei der einen Unterart enthält das Satzglied im Vorfeld ein Satzglied mit einem besonderen Pronomen; man spricht dann auch von einem Pronominalnebensatz. Nach der Semantik kann man zusätzlich unterscheiden zwischen Pronominalnebensätzen mit einem Relativpronomen (= Relativsatz) oder Pronominalnebensätzen mit einem Interrogativpronomen (= Fragenebensatz); → Block L.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
