                                        "entry_id": "26f80647-718f-3432-8ba0-77e969482faf",
                                        "glosses": [
                                            "hoher immergrüner Baum, der in verschiedenen Arten in den amerikanischen Tropen wächst und dessen Rinde Chinin und andere Alkaloide enthält (Cinchona)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a98d8a-0e63-4e7c-9ea5-afb853cbc785",
                                                "sense_id": "e96ad24e-0c1e-340e-a17d-b3653d4f8377",
                                                "text": "Der Chinarindenbaum liefert Chinarinde."
                                            },
                                            {
                                                "example_id": "3cc620a6-4bb9-49b9-ac52-ef66ac76a330",
                                                "sense_id": "e96ad24e-0c1e-340e-a17d-b3653d4f8377",
                                                "text": "„Pharmakina ist Weltmarktführer in der Produktion des Malariamittels Chinin, das aus der Borke des in dieser Weltgegend gut gedeihenden Chinarindenbaumes gewonnen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
