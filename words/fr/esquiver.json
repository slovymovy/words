    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aac1f654-5cf8-3ce6-bb94-286f1ce29c9a",
                    "sense_definition": "Éviter avec agilité un coup, un obstacle ou un projectile en déplaçant son corps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evitement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boxeur a réussi à <w>esquiver</w> un coup violent en se baissant rapidement."
                        },
                        {
                            "text": "Le cycliste a fait un brusque écart sur le côté pour <w>esquiver</w> un obstacle."
                        }
                    ],
                    "synonyms": [
                        "éviter"
                    ],
                    "antonyms": [
                        "encaisser",
                        "subir"
                    ],
                    "common_phrases": [
                        "esquiver un coup",
                        "esquiver un projectile"
                    ]
                },
                {
                    "sense_id": "196c5957-ec88-3cc9-8ebf-cfc2d3427260",
                    "sense_definition": "Éviter avec adresse une obligation, une difficulté ou une question embarrassante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evitement_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a tenté d'<w>esquiver</w> la question des journalistes lors de la conférence."
                        },
                        {
                            "text": "Elle essaie toujours d'<w>esquiver</w> ses responsabilités lorsqu'un imprévu survient au bureau."
                        }
                    ],
                    "synonyms": [
                        "éluder",
                        "contourner",
                        "fuir"
                    ],
                    "antonyms": [
                        "affronter",
                        "assumer"
                    ],
                    "common_phrases": [
                        "esquiver la question",
                        "esquiver le regard"
                    ]
                },
                {
                    "sense_id": "329f8aab-3ef1-34c9-8bf0-8a7833f34939",
                    "sense_definition": "Quitter discrètement un lieu ou une compagnie sans être remarqué.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "depart_furtif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par cette longue fête, Julien a préféré s'<w>esquiver</w> discrètement avant minuit."
                        },
                        {
                            "text": "Elle a profité de l'agitation générale pour s'<w>esquiver</w> par la porte de derrière."
                        }
                    ],
                    "synonyms": [
                        "s'éclipser",
                        "filer",
                        "se défiler"
                    ],
                    "antonyms": [
                        "demeurer",
                        "rester"
                    ],
                    "common_phrases": [
                        "s'esquiver discrètement",
                        "s'esquiver en douce"
                    ]
                }
            ]
        }
    ]
