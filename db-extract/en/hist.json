                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d137d04-1d60-35b2-a8ac-24f56f7fa8f2",
                        "entry_id": "fc9f979a-b56d-3d05-9190-ccbba647c673",
                        "glosses": [
                            "An utterance used to discreetly attract someone's attention."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "55b0fe44-eb7f-3ee0-a9e1-918b4c08b6d1",
                        "entry_id": "fc9f979a-b56d-3d05-9190-ccbba647c673",
                        "glosses": [
                            "An injunction to be silent and/or to pay attention to what is being said or can be heard."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "be138f65-4dcf-447e-bba2-dbd613812414",
                                "sense_id": "55b0fe44-eb7f-3ee0-a9e1-918b4c08b6d1",
                                "text": "\"My worthy Nelly! I am greatly rejoiced to find it is no other than thee. Hist! child, hist! Should Ishmael gain a knowledge of our plans, he would not hesitate to cast us both from this rock, upon the plain beneath. Hist! Nelly, hist!\""
                            },
                            {
                                "example_id": "e704205e-1665-4cb4-a56b-4f9c7e5e09f2",
                                "sense_id": "55b0fe44-eb7f-3ee0-a9e1-918b4c08b6d1",
                                "text": "1850, Edgar Allan Poe, Scenes from \"Politian\", 2009 [1902], Charles F. Richardson (editor), The Complete Works of Edgar Allan Poe, Volume 1: Poems, page 87,\nHist! hist! thou canst not say / Thou hearest not now Baldazzar?,"
                            },
                            {
                                "example_id": "4f770e65-ceb5-46b7-9785-fbba912d3926",
                                "sense_id": "55b0fe44-eb7f-3ee0-a9e1-918b4c08b6d1",
                                "text": "There’s a clue somewhere; wait a bit; hist—hark! By Jove, I have it!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d70b0ad8-34ee-4b7b-b40e-3c3700c274af",
                        "source_entry_id": "fc9f979a-b56d-3d05-9190-ccbba647c673",
                        "source_sense_description": "injunction to be silent",
                        "target_lang_word": "pst",
