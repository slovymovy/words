                "senses": [
                    {
                        "sense_id": "cf3752d4-01d3-33cc-bc13-94261bca5a5c",
                        "entry_id": "16af44db-89f5-3354-a624-2e06304fc016",
                        "glosses": [
                            "Person, die im Dritten Reich auf der Grundlage nationalsozialistischer Gesetze Juden ihre Besitztümer gewaltsam und ohne Entschädigung weggenommen und diese dann zu „arischen“ Besitztümern gemacht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "703ee299-e189-491c-9ad7-f5822065d00f",
                                "sense_id": "cf3752d4-01d3-33cc-bc13-94261bca5a5c",
                                "text": "„Die übrigen Immobilien, einen Landsitz in Altdöbern von insgesamt 779 Hektar, ein Grundstück von 600 Quadratmetern Unter den Linden 46 sowie weitere Liegenschaften in Mitte und Pankow, eigneten sich andere Ariseure an.“"
                            }
                        ],
