                "senses": [
                    {
                        "sense_id": "ec218c24-c114-316e-bac7-75bd138f1ba9",
                        "entry_id": "02c4fb49-8b4a-3fa1-a791-c252db0a4eee",
                        "glosses": [
                            "alles wetend, alles kennend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0fc1b3-7036-4016-ba4f-5a88dd296869",
                                "sense_id": "ec218c24-c114-316e-bac7-75bd138f1ba9",
                                "text": "Juist die dubbelheid betrekt ons bij het wonder van de persoon van Jezus. Als Gods Zoon is Hij één met de Vader, en is met de Vader almachtig, alwijs, eeuwig. Maar Hij is ook werkelijk mens geworden. Daarom is Hij als kind gegroeid in wijsheid en kennis. Wat Hij als God volkomen had, moest Hij als mensenkind verwerven."
                            },
                            {
                                "example_id": "5f89c3f7-fea6-46c6-9b75-67419d52b568",
                                "sense_id": "ec218c24-c114-316e-bac7-75bd138f1ba9",
                                "text": "Omdat de Schepper alwijs is, heb ik gegronde hoop dat door in deze lijn te boeren een stuk van de last die veel boeren ervaren, wordt weggenomen."
                            }
                        ]
                    }
