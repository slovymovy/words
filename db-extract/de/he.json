                "translations": [
                    {
                        "translation_id": "b420460a-a43f-4af4-860d-04b31e585c1a",
                        "source_entry_id": "ad0986f1-2539-3d82-a371-932250998433",
                        "source_sense_id": "d188190c-cfaa-3dc4-9eb4-e0b7a7a4e57b",
                        "source_sense_description": "Ausruf, um die Aufmerksamkeit einer Person zu erregen",
                        "target_lang_word": "hé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e23bb1d4-43fe-3a77-96b9-c02ec1b31692",
                                        "entry_id": "2a518098-66a4-3fe3-8050-408836a10269",
                                        "glosses": [
                                            "Sert principalement à appeler quelqu’un. Ces sortes de phrases ne s’emploient qu’en parlant à des inférieurs ou à des personnes avec lesquelles on vit très familièrement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcafa234-4a76-4f62-8bab-5bcc1fabf657",
                                                "sense_id": "e23bb1d4-43fe-3a77-96b9-c02ec1b31692",
                                                "text": "Hé ! L’ami !"
                                            },
                                            {
                                                "example_id": "51ef187d-393e-4445-adc7-03c3696c0df3",
                                                "sense_id": "e23bb1d4-43fe-3a77-96b9-c02ec1b31692",
                                                "text": "Hé ! Viens ici."
                                            },
                                            {
                                                "example_id": "a402604a-41c2-4b0e-8bea-ee065038b3c3",
                                                "sense_id": "e23bb1d4-43fe-3a77-96b9-c02ec1b31692",
                                                "text": "Hé, Gabriel !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb7316cb-7fff-3fc8-9df6-7af392d1d18b",
                                        "entry_id": "2a518098-66a4-3fe3-8050-408836a10269",
                                        "glosses": [
                                            "Se dit également, soit pour avertir de prendre garde à quelque chose :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f9ce73-507f-45c4-95f9-793b971a5780",
                                                "sense_id": "cb7316cb-7fff-3fc8-9df6-7af392d1d18b",
                                                "text": "Hé ! Qu’allez- vous faire ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04f0e3b1-39ec-3fae-b408-774c502568e4",
                                        "entry_id": "2a518098-66a4-3fe3-8050-408836a10269",
                                        "glosses": [
                                            "Soit pour témoigner de la commisération :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa09da2-e982-48a6-bd65-1f76ede46b7f",
                                                "sense_id": "04f0e3b1-39ec-3fae-b408-774c502568e4",
                                                "text": "Hé, mon Dieu !"
                                            },
                                            {
                                                "example_id": "75187f8e-d41d-46f6-a0b6-efdfb7940f10",
                                                "sense_id": "04f0e3b1-39ec-3fae-b408-774c502568e4",
                                                "text": "Hé, pauvre homme, que je vous plains !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f5c811-fd3a-3377-8b12-777caacb99e9",
                                        "entry_id": "2a518098-66a4-3fe3-8050-408836a10269",
                                        "glosses": [
                                            "Soit pour marquer du regret, de la douleur :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75900de8-9d93-435f-8cb1-1ed2f3909a7b",
                                                "sense_id": "b0f5c811-fd3a-3377-8b12-777caacb99e9",
                                                "text": "Hé, qu’ai-je fait !"
                                            },
                                            {
                                                "example_id": "4c6dbda0-1f74-43fb-a44b-74173f5477ba",
                                                "sense_id": "b0f5c811-fd3a-3377-8b12-777caacb99e9",
                                                "text": "Hé, que je suis misérable !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea950076-9ab8-3883-ae3c-f640054df5e3",
                                        "entry_id": "2a518098-66a4-3fe3-8050-408836a10269",
                                        "glosses": [
                                            "Soit pour exprimer quelque étonnement :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b40a324-d834-4440-8e1d-5c21e11a8de0",
                                                "sense_id": "ea950076-9ab8-3883-ae3c-f640054df5e3",
                                                "text": "Hé, bonjour ! Il y a longtemps qu’on ne vous a pas vu."
                                            },
                                            {
                                                "example_id": "36ea13e8-9384-42dc-8cc2-e4c46db2ba45",
                                                "sense_id": "ea950076-9ab8-3883-ae3c-f640054df5e3",
                                                "text": "Hé, vous voilà ? Je ne vous attendais pas si tôt."
                                            },
                                            {
                                                "example_id": "6adec466-a444-425c-ab59-488d0ead749f",
                                                "sense_id": "ea950076-9ab8-3883-ae3c-f640054df5e3",
                                                "text": "Hé quoi ! Vous n’êtes pas encore parti !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2744ae63-7b23-36cf-999a-b554f9cc7d29",
                                        "entry_id": "2a518098-66a4-3fe3-8050-408836a10269",
                                        "glosses": [
                                            "Il se répète quelquefois, dans la conversation familière, pour exprimer une sorte d’adhésion, d’approbation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5d38355-8b4b-4cca-aa66-d88d1193e4c0",
                                                "sense_id": "2744ae63-7b23-36cf-999a-b554f9cc7d29",
                                                "text": "Hé, hé, je ne dis pas non."
                                            },
                                            {
                                                "example_id": "3bf8dca0-364c-4dd8-b19d-49c91ffc497f",
                                                "sense_id": "2744ae63-7b23-36cf-999a-b554f9cc7d29",
                                                "text": "Hé, hé, pourquoi pas ?"
                                            }
                                        ]
                                    }
                                ]
                            },
