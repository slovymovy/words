                                        "sense_id": "5d014116-64b3-3857-b3df-6cb69f02ea0d",
                                        "entry_id": "891c467c-4eeb-34a6-80e5-4c9e574a57cb",
                                        "glosses": [
                                            "Unusually small size, as the result of a developmental abnormality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441610a1-116c-41be-939f-7d1e859a3192",
                                                "sense_id": "5d014116-64b3-3857-b3df-6cb69f02ea0d",
                                                "text": "In this gene, other mutations can cause a kind of nanism that is lethal during the first weeks of life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acc02894-8526-43dc-b978-ce59067e9bc1",
                        "source_entry_id": "349e6fbb-8372-374e-977f-8ba5bbda0ed3",
                        "source_sense_id": "14ef7458-27ba-351e-87ab-90d4346a4e56",
                        "target_lang_word": "dwarfism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
