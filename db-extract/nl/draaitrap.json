                "senses": [
                    {
                        "sense_id": "33cc6c56-26f8-3eea-a130-7c097484019a",
                        "entry_id": "af96aea1-65a8-3348-97f7-589e3311ddfa",
                        "glosses": [
                            "een spiraalvormige trap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53772f77-667f-4591-adf6-b848d68bdf7d",
                                "sense_id": "33cc6c56-26f8-3eea-a130-7c097484019a",
                                "text": "Er zijn slechtere jobs dan die van Michael Ignatieff. Als de rector van de Hongaars-Amerikaanse Central European University zijn bureau op de eerste verdieping buitenstapt, de stenen draaitrap naar beneden neemt, het zwart-witportret van George Soros passeert en Boedapest in wandelt, botst hij links tegen de imposante Sint-Stefanusbasiliek aan. Gaat hij de andere kant op, dan staat hij tien minuten later voor het even indrukwekkende parlementsgebouw."
                            }
                        ]
                    },
                    {
                        "sense_id": "87ba81cc-6bd9-38de-90ee-6d71bfbd0471",
                        "entry_id": "af96aea1-65a8-3348-97f7-589e3311ddfa",
                        "glosses": [
                            "met een draaiende beweging van het lichaam een trap geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8623dc19-6eba-4b92-b2b9-98a8f721d5f8",
                                "sense_id": "87ba81cc-6bd9-38de-90ee-6d71bfbd0471",
                                "text": "Onder andere dankzij een mooie draaitrap liep de taekwondoka in het derde kwart uit naar een 7-1 overwinning. Haar partij in de volgende ronde staat gepland rond 20.00 uur vanavond tegen de Amerikaanse Jackie Galloway."
                            }
                        ]
                    }
