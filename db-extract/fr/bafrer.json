                "senses": [
                    {
                        "sense_id": "7bc15e61-9d11-313a-a16b-d0b8a5b1e20d",
                        "entry_id": "347b83af-f30e-3102-a9dc-2eddb498613e",
                        "glosses": [
                            "Manger avidement et avec excès."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f390328f-ec52-428a-bb06-2be743c628eb",
                                "sense_id": "7bc15e61-9d11-313a-a16b-d0b8a5b1e20d",
                                "text": "Que non, mon vieux, y’a plus pressé si on veut bafrer des tartines de fifis, l’feu attend chez Rubin, ces emmerdeurs partis au chef-lieu, on en profite, oui z’ou non ?"
                            },
                            {
                                "example_id": "cfd74b25-42c4-40f0-bc04-e065d80eab21",
                                "sense_id": "7bc15e61-9d11-313a-a16b-d0b8a5b1e20d",
                                "text": "À leur table, la conversation est nulle ; le goût pour les choses de l’esprit a été remplacé par la passion de jouir au sens le plus brutal du mot, de manger et de bafrer."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc94d0dd-1046-3793-a6fd-49372f5703fe",
                        "entry_id": "347b83af-f30e-3102-a9dc-2eddb498613e",
                        "glosses": [
                            "Manger quelque chose avidement et avec excès."
                        ],
