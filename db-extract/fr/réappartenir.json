                        "glosses": [
                            "Appartenir de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9d8f5e-b830-4f4a-9793-fb12cf0efe5f",
                                "sense_id": "7086ca40-e742-3a37-a867-cf758f27cf50",
                                "text": "Il s'agit d'aider le stressé à reprendre son autonomie, à se réappartenir, à recommencer à décider par lui même de la conduite de sa vie."
                            },
                            {
                                "example_id": "d2c9b849-7c2b-4b30-8f41-c5a710813cf4",
                                "sense_id": "7086ca40-e742-3a37-a867-cf758f27cf50",
                                "text": "J'essaie de réappartenir à la nature."
                            },
                            {
                                "example_id": "bfe28dcd-db43-46b7-b70d-438327c34415",
                                "sense_id": "7086ca40-e742-3a37-a867-cf758f27cf50",
                                "text": "Elle doit se reprendre, se racheter, se réappartenir."
                            }
                        ]
                    }
