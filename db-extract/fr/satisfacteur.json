                                "example_id": "3832a3aa-5857-4f53-a238-1890e823a921",
                                "sense_id": "8ebf4a50-3702-3992-9288-4f85d2b0748d",
                                "text": "Et tel écrit vaut comme excitateur ou apéritif de la pensée, et tel autre comme satisfacteur, remplaçant, aliment de pensée."
                            },
                            {
                                "example_id": "72240bfb-4c33-4320-8930-01b60e33a7e5",
                                "sense_id": "8ebf4a50-3702-3992-9288-4f85d2b0748d",
                                "text": "Nous avons dit, à propos du Désir, qu'il oriente et « pousse » la conduite vers la recherche ou la réalisation de la situation satisfactrice."
                            }
                        ]
                    }
