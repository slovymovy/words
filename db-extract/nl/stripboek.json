                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3555592b-ac69-35c0-b998-24ff01c20f37",
                                        "entry_id": "d0a5c4ec-f734-3b05-b8ed-5a1b49347c4f",
                                        "glosses": [
                                            "fortlaufende Geschichte in Form einer Folge von Zeichnungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc92e98-44f3-4fde-ab34-4b24eaf9a6f9",
                                                "sense_id": "3555592b-ac69-35c0-b998-24ff01c20f37",
                                                "text": "„Seine Inspiration für traurige, zynische Comicstrips findet er an jeder Ecke in Island.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
