                        "glosses": [
                            "Tag, an dem Banken geschlossen haben, obwohl kein gesetzlicher Feiertag ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be2f8c63-c9bd-45e4-b446-ebcaecd182fb",
                                "sense_id": "56cfde14-ea44-3266-aa54-404c0b02c7ea",
                                "text": "Der 31. Dezember (Silvester) ist ein Bankfeiertag."
                            },
                            {
                                "example_id": "b961c9e3-b9dc-48e6-a8a3-f7bc832c4340",
                                "sense_id": "56cfde14-ea44-3266-aa54-404c0b02c7ea",
                                "text": "„Um das zu vermeiden, könnte die griechische Regierung einen Bankfeiertag ausrufen, die Finanzinstitute blieben also geschlossen.“"
                            },
                            {
                                "example_id": "23eb503b-ce4b-4a2f-9cd9-2b78d00f0c5b",
                                "sense_id": "56cfde14-ea44-3266-aa54-404c0b02c7ea",
                                "text": "„Einen außerplanmäßigen Bankfeiertag wie am Dienstag hat es in Uruguay seit siebzig Jahren nicht mehr gegeben.“"
                            }
                        ],
