                "senses": [
                    {
                        "sense_id": "887fc58f-707e-3081-8aa3-05f61173b225",
                        "entry_id": "016807e9-caa5-3fa6-a918-e0b96adf8311",
                        "glosses": [
                            "Amérindien habitant le Sud-Ouest des États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c9bccb-cbeb-42a4-b0e5-37a526ee5e0b",
                                "sense_id": "887fc58f-707e-3081-8aa3-05f61173b225",
                                "text": "Les Hopi les aspergent de farine de maïs, leur offrent de multiples présents."
                            },
                            {
                                "example_id": "ce9a0191-8f4e-47d0-854b-1c0a2aefdf4d",
                                "sense_id": "887fc58f-707e-3081-8aa3-05f61173b225",
                                "text": "Aujourd’hui encore, sur les terres arides des Hopi et des Zuñi, dont le territoire s’étend entre l’Arizona et le Nouveau-Mexique, l’eau céleste est assurée de tomber grâce à l’intervention des colibris ; c’est pourquoi ceux-ci, en retour, sont peints sur ces grosses jarres domestiques gonflées comme ventre de femme, associées au ventre de la déesse-mère, et qui constituent de ce fait le réceptacle tangible de l’essence divine."
                            }
                        ]
                    }
