                "senses": [
                    {
                        "sense_id": "dd192891-684b-3cae-baac-edae6988c177",
                        "entry_id": "260ffa27-d92c-3835-9666-6911e01a6867",
                        "glosses": [
                            "Permis de conduire."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "545c5cc9-6c74-4e4e-9344-d64891091f01",
                                "sense_id": "dd192891-684b-3cae-baac-edae6988c177",
                                "text": "Nach diesem Unfall hat man ihm den Führerausweis abgenommen.",
                                "translation": "Après cet accident, on lui a retiré le permis de conduire."
                            },
                            {
                                "example_id": "3842d843-9b9a-4479-9a9c-0e37c4082247",
                                "sense_id": "dd192891-684b-3cae-baac-edae6988c177",
                                "text": "Was es genau kostet, den Führerausweis zu machen, hängt davon ab, in welchem Kanton Sie wohnen, wieviel Unterricht und wie viele Prüfungsanläufe Sie brauchen. Sie müssen etwa mit folgenden Kosten rechnen […].",
                                "translation": "Le coût du permis de conduire dépend du canton dans lequel vous habitez et du nombre d'heures de conduite et de tentatives dont vous avez besoin pour passer les examens. Vous devez prendre en compte les coûts suivants […]."
                            }
                        ]
                    }
