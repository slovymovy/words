                    },
                    {
                        "translation_id": "38579555-a2fa-4449-a0f1-522057f88acb",
                        "source_entry_id": "4a092ff0-47a1-348a-bac0-ba896f89c17a",
                        "source_sense_id": "2f690090-928a-308b-9435-e708da6c2cc7",
                        "source_sense_description": "of or relating to nihilism",
                        "target_lang_word": "nihilistisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nihilistisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "041e48de-8e69-3332-844a-b0dc9bf87b02",
                                        "entry_id": "38e082e1-1845-35bb-99a4-e33f24b92935",
                                        "glosses": [
                                            "van, betreffende het nihilisme, getuigend van nihilisme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64cd22d0-7b0a-4bc1-95f2-d300a801585e",
                                                "sense_id": "041e48de-8e69-3332-844a-b0dc9bf87b02",
                                                "text": "„Maatschappelijke ontwrichting is hier noch het hoofddoel, noch de kern van de ideologie”, schrijven de onderzoekers. Het draait leden om een „nihilistisch genoegen in sadisme”. Oftewel: geweld is niet het middel, maar het doel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e1b6756-c78d-4bc8-a871-b993f528af7b",
                        "source_entry_id": "4a092ff0-47a1-348a-bac0-ba896f89c17a",
                        "source_sense_id": "2f690090-928a-308b-9435-e708da6c2cc7",
                        "source_sense_description": "of or relating to nihilism",
                        "target_lang_word": "nihiliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nihiliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73b1ac64-bef3-34d0-ba7c-0823dbd9ca5e",
                                        "entry_id": "f155e17e-7487-32c7-9c22-51bf8c0337ec",
                                        "glosses": [
                                            "Celui qui professe le nihilisme philosophique qui proclame l’impossibilité de hiérarchiser les valeurs et implique l’amoralisme et le scepticisme moral"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42248b7f-6224-4d17-8a3d-125e773da499",
                                                "sense_id": "73b1ac64-bef3-34d0-ba7c-0823dbd9ca5e",
                                                "text": "Autre idée, plus piteuse : le nihilisme serait une réaction de désenchantement face à «l'imperfection du monde et de l'Homme », qui engendre chez le nihiliste une volonté de nier toute valeur aux hommes réels, au profit d'un homme rêvé (et de même pour le monde)... Les nihilistes sont donc des dépressifs."
                                            },
                                            {
                                                "example_id": "2637c82c-9bbd-491d-9971-e745f357d14f",
                                                "sense_id": "73b1ac64-bef3-34d0-ba7c-0823dbd9ca5e",
                                                "text": "Il avait fini par devenir nihiliste : il professait les opinions les plus extrêmes, se moquait de sa propre secte, faisait gras en carême, jouait aux cartes et buvait du champagne comme de l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b74bee4-254b-33ca-b973-891299b03a31",
                                        "entry_id": "f155e17e-7487-32c7-9c22-51bf8c0337ec",
                                        "glosses": [
                                            "Partisan du nihilisme russe, socialisme proche de l’anarchisme qui proclame le rejet de l’autorité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008a15a0-4d11-4e2d-9405-5c4b61c82665",
                                                "sense_id": "0b74bee4-254b-33ca-b973-891299b03a31",
                                                "text": "Le nihiliste russe Bakounine lui inspire le personnage de Dimitri Roubine, personnage composite fort en éloquence et faible dans l'action."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nihiliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a164bb99-18bf-3839-b709-1718ef210a7d",
                                        "entry_id": "edee07a8-e22d-3115-b062-f18ea0b46836",
                                        "glosses": [
                                            "Relatif au nihilisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f781156a-d585-4bce-8179-388b85ae96a9",
                                                "sense_id": "a164bb99-18bf-3839-b709-1718ef210a7d",
                                                "text": "Au contraire, elle pêche volontairement dans un conspirationnisme nihiliste qui la rend incapacitante dans le domaine des idées et de l'action métapolitique."
                                            },
                                            {
                                                "example_id": "7fb3399c-f16d-49e3-afc6-4032478067ac",
                                                "sense_id": "a164bb99-18bf-3839-b709-1718ef210a7d",
                                                "text": "… nous communiquer, par des synopsis des fictions de Henry Miller, son goût pour la dépravation sexuelle (ça te fait des grosses déclarations nihilistes puis cinq minutes après ça croit en Éros, notre Cul Tout-Puissant qui êtes aux Dacieux)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1f1e17d-3929-407d-96b1-dcfeff57cec9",
                        "source_entry_id": "4a092ff0-47a1-348a-bac0-ba896f89c17a",
                        "source_sense_id": "2f690090-928a-308b-9435-e708da6c2cc7",
                        "source_sense_description": "of or relating to nihilism",
                        "target_lang_word": "nihilistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nihilistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "323f2221-d046-3385-999e-710f7d701c3e",
                                        "entry_id": "d09531d6-2b98-39e4-a97c-696a3f66b34e",
                                        "glosses": [
                                            "die philosophische Richtung des Nihilismus (verkürzt: die Ablehnung von Überzeugungen, Normen, Werten, insbesondere von religiösen, ethischen oder politischen) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c880b5fb-baa4-44d2-8497-da99f8ca9664",
                                                "sense_id": "323f2221-d046-3385-999e-710f7d701c3e",
                                                "text": "„Er hatte diesen praktischen, aber auch nihilistischen und skeptischen Blick auf das Leben.“"
                                            },
                                            {
                                                "example_id": "eea274c5-b3de-4277-bc40-e2be3248727f",
                                                "sense_id": "323f2221-d046-3385-999e-710f7d701c3e",
                                                "text": "„Der IS ist für sehr viele Menschen eine attraktive Organisation. Sie verfügt über viel Geld und logistische Unterstützung - viel mehr, als Al-Kaida je hatte. Zudem ist ihre Ideologie deutlich nihilistischer.“"
                                            },
                                            {
                                                "example_id": "3f29441d-1f51-415b-9d13-3fe391cb0e56",
                                                "sense_id": "323f2221-d046-3385-999e-710f7d701c3e",
                                                "text": "„Jacques Derridas Philosophie bezeichnet er [der kanadische Psychologe Jordan Peterson] als ‚nihilistisch und destruktiv‘.“"
                                            },
                                            {
                                                "example_id": "dbc38f72-8447-4589-a082-49f9449843d8",
                                                "sense_id": "323f2221-d046-3385-999e-710f7d701c3e",
                                                "text": "„Menschen fragen, was ist der Sinn des Lebens? Ich sage: Es gibt keinen Sinn, warum sollte es ihn geben? Und die Leute denken: ganz schön nihilistisch.“"
                                            },
                                            {
                                                "example_id": "d58e194b-c2e7-4fd5-a6ae-bdc8d30504af",
                                                "sense_id": "323f2221-d046-3385-999e-710f7d701c3e",
                                                "text": "„[…] die titelgegebenden ‚Wir Negativen‘, in denen sich Tucholsky einst halb ironisch selbst beschrieben hatte, waren ja alles andere als nihilistische Nein-Sager, sondern sie verfügten über einen ethischen Kompass – im Unterschied zu Millionen anderer damaliger Deutscher.“"
                                            },
                                            {
                                                "example_id": "599c7be2-cb78-4fe0-ac48-b4fc36bb22c7",
                                                "sense_id": "323f2221-d046-3385-999e-710f7d701c3e",
                                                "text": "[1926:] „Vom Albtraum des Ersten Weltkrieges desillusioniert, begehrte [die britische Jugend] gegen altmodische soziale Normen auf. Eine neue, nihilistisch geprägte Generation suchte das Vergnügen, die Dekadenz und die Experimentierfreude.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "035c0d49-74c3-350f-b7cb-c8ac455a45ef",
                                        "entry_id": "d09531d6-2b98-39e4-a97c-696a3f66b34e",
                                        "glosses": [
                                            "in einem Gemütszustand, der alles Lebensbejahende ablehnt"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
