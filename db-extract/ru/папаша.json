                "senses": [
                    {
                        "sense_id": "6d4f9ef6-7215-33d5-9abf-b8053168eafa",
                        "entry_id": "fca60fff-53a4-3705-84ee-9163b5a1ca73",
                        "glosses": [
                            "same as (папа) dad"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "af4e1f41-1531-4292-8941-8468b099d56a",
                                "sense_id": "6d4f9ef6-7215-33d5-9abf-b8053168eafa",
                                "text": "— Поми́луй, папа́ша, — подхвати́л Арка́дий, — ты как бу́дто извиня́ешься; как тебе́ не со́вестно.",
                                "translation": "\"For goodness' sake, Daddy,\" interposed Arkady. \"You needn't apologize. Are you ashamed?\"",
                                "english": "\"For goodness' sake, Daddy,\" interposed Arkady. \"You needn't apologize. Are you ashamed?\""
                            }
                        ]
