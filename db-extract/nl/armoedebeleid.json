                        "examples": [
                            {
                                "example_id": "ac52b885-eb0d-4fe7-b159-85d651b5741e",
                                "sense_id": "7c6c9da2-bd1f-38db-9690-91bedbec0524",
                                "text": "Toch gaat het geld niet altijd als extra budget naar jongeren in armoede. Zo wordt het soms gebruikt om tekorten op algemeen armoedebeleid te dichten, of bezuinigingen af te wenden."
                            },
