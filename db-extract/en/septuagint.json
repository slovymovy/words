                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Septuaginta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc797627-7bf6-3938-a797-59dca99ad60c",
                                        "entry_id": "f0f1d56c-15f8-379c-90a8-bf0f39f9515a",
                                        "glosses": [
                                            "älteste und wichtigste Übersetzung der Bibel ins damals alltägliche Altgriechisch (Koine) aus der hebräischen Vorlage; entstand etwa von 250 vor Christus bis 100 nach Christus zunächst im hellenistischen Judentum, dann auch im frühen Christentum"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa327e26-988c-4e18-bad7-1f5e997c0a87",
                                                "sense_id": "dc797627-7bf6-3938-a797-59dca99ad60c",
                                                "text": "„Bei den deuterokanonischen Schriften handelt es sich um Bücher oder Zusätze zu Büchern, die in der Septuaginta überliefert wurden, nicht aber in der masoretischen Texttradition.“"
                                            },
                                            {
                                                "example_id": "75d5f8bc-7bea-48e4-9b81-b8c01c80f47c",
                                                "sense_id": "dc797627-7bf6-3938-a797-59dca99ad60c",
                                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
