                                        "glosses": [
                                            "Fortschritt zeigend; sich positiv weiterentwickelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1554dae-a019-447d-8211-52d6fb4f624a",
                                                "sense_id": "ce82bc93-9a0b-38cb-a1f7-d084cae9865b",
                                                "text": "Er ist ein fortschrittlicher Mensch, der bereit ist, an sich zu arbeiten."
                                            },
                                            {
                                                "example_id": "787c0e3c-03f5-4428-a7b5-2c7a024c1610",
                                                "sense_id": "ce82bc93-9a0b-38cb-a1f7-d084cae9865b",
                                                "text": "„Die Triebwerke von Flüssigtreibstoff-Raketen, wie sie Nordkorea und Iran besitzen, brennen rund vier Minuten lang, die von fortschrittlicheren Feststoffraketen nur rund 170 Sekunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
