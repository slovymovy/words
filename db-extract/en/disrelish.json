                    {
                        "sense_id": "7e9c6c96-e64d-30e6-a6df-abd13aa55e37",
                        "entry_id": "2c85ed11-8044-3a3e-ab34-9b64d35b310d",
                        "glosses": [
                            "To have no taste for; to reject as distasteful."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "83e539d7-5dbe-4b36-a855-1f22d14e9172",
                                "sense_id": "7e9c6c96-e64d-30e6-a6df-abd13aa55e37",
                                "text": "September 1, 1733, Alexander Pope, letter to Jonathan Swift\nEverybody is so concerned for the public, that all private enjoyments are lost or disrelished"
                            }
                        ]
                    },
                    {
                        "sense_id": "afe00012-823f-30d6-9f66-896a95ee60ca",
                        "entry_id": "2c85ed11-8044-3a3e-ab34-9b64d35b310d",
                        "glosses": [
                            "To deprive of relish; to make nauseous or disgusting in a slight degree."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6e9d91d0-ae3a-469b-992c-76f0e66f8200",
                                "sense_id": "afe00012-823f-30d6-9f66-896a95ee60ca",
                                "text": "And Eve within, due at her hour prepar'd / For dinner favourie fruits, of taſte to pleaſe / True appetite, and not diſreliſh thirſt"
                            }
                        ]
                    }
