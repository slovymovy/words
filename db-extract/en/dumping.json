                                "example_id": "b9eda301-fb04-4b5f-9d49-52e2f0c744de",
                                "sense_id": "ec6f1db6-c1b2-3b85-9b00-4d8931cf446d",
                                "text": "NO DUMPING [sign posted to discourage lawless dumping of trash]"
                            }
                        ]
                    },
                    {
                        "sense_id": "58bccea3-4fd7-38e4-ac50-89d9f072fb07",
                        "entry_id": "b5c26a4f-ae59-3f2d-9460-c00d84c6f30e",
                        "glosses": [
                            "Selling goods at less than their normal price, or even at a loss, especially in the export market as a means of securing a monopoly."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbbe582b-88ff-4b32-b053-b9d64bf48d9d",
                        "source_entry_id": "b5c26a4f-ae59-3f2d-9460-c00d84c6f30e",
                        "source_sense_description": "the disposal of something no longer needed, or of no value",
                        "target_lang_word": "сброс",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
