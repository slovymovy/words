                        ],
                        "examples": [
                            {
                                "example_id": "533ebb92-84bc-4292-8e7b-e4b5a5a52edc",
                                "sense_id": "968bed51-3c76-3273-893a-d95fba90a01f",
                                "text": "We stomen af op een grote catastrofe.",
