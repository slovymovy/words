                "senses": [
                    {
                        "sense_id": "5e18e0f5-393f-32ec-8d9e-674f8245977b",
                        "entry_id": "83de0f75-ab68-3aed-ab0e-52fb0b1e8fee",
                        "glosses": [
                            "Enlever au bulldozer."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "6cb8adaa-cd66-41db-93f0-a95b982fa3a8",
                                "sense_id": "5e18e0f5-393f-32ec-8d9e-674f8245977b",
                                "text": "Permettez-moi d'ajouter qu'il n'a détruit aucune orangeraie, aucune oliveraie, n'a comblé aucun puits, n'a bulldozéré aucune maison."
                            },
                            {
                                "example_id": "a5587bf7-9e01-45ad-a67c-634b8b629868",
                                "sense_id": "5e18e0f5-393f-32ec-8d9e-674f8245977b",
                                "text": "J'espère quand même qu'on n'aura pas besoin de systématiquement tout bulldozérer le calcaire de craie à la chaux blanche qui traîne par terre."
                            },
                            {
                                "example_id": "86c2fa12-e840-43e4-859d-34bd84cf35a9",
                                "sense_id": "5e18e0f5-393f-32ec-8d9e-674f8245977b",
                                "text": "puisque tu sembles avoir compris, on te donne 3 jours pour intégrabiliser, sinon on bulldozère tout."
                            }
                        ]
                    }
                ],
