                    {
                        "sense_id": "9cb70fe8-56a8-3183-9834-3d4363e57000",
                        "entry_id": "ca696a4b-0802-3ec8-a873-0f6e1d2b85f6",
                        "glosses": [
                            "A worthless or superficially meaningless post on a message board, newsgroup, or other online discussion platform, often intended to derail or distract from relevant conversation."
                        ],
                        "tags": [
                            "Internet",
                            "derogatory",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "d02552c2-fac4-4057-9928-fc26fde26487",
                                "sense_id": "9cb70fe8-56a8-3183-9834-3d4363e57000",
                                "text": "BTW, that was an extremely annoying SHITpost. If you want to send people ecrypted messages why don't you try direct e-mail?"
                            },
                            {
                                "example_id": "dfc3f89d-83fe-455b-a389-e3e1188a11ef",
                                "sense_id": "9cb70fe8-56a8-3183-9834-3d4363e57000",
                                "text": "How is it, all you *would be* flame *specialists*, have to bring a sexual dimension into your shitpost."
                            },
                            {
                                "example_id": "f42baf0b-c9c6-4db9-92c8-7892c41d46ec",
                                "sense_id": "9cb70fe8-56a8-3183-9834-3d4363e57000",
                                "text": "Every time you see a \"here's how to get rich\" shitpost, put some cash in the bank. After 6 months, marvel at how much you've suddenly managed to save....."
                            },
                            {
                                "example_id": "8014c22d-3a57-4f50-8994-3de97140ab41",
                                "sense_id": "9cb70fe8-56a8-3183-9834-3d4363e57000",
                                "text": "It'll make the newsgroups much easier to navigate when you don't see shitposts all over the place."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed5d9b8a-d0ff-3b2d-976f-1318d02ac189",
                        "entry_id": "ca696a4b-0802-3ec8-a873-0f6e1d2b85f6",
                        "glosses": [
                            "A seemingly worthless or superficially meaningless image, video or piece of text posted to a social media platform that is intended to be humorously or ironically enjoyed."
