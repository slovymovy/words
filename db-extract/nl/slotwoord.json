                        "examples": [
                            {
                                "example_id": "5625351c-99a0-4e14-8734-5ddefb8728e3",
                                "sense_id": "6366e25f-2035-3bf9-9e76-f332f62a47cb",
                                "text": "Zelf denkt PVV-leider Geert Wilders dat het gaat om „uw chauffeur, uw tuinier, uw huisarts of uw huishoudelijke hulp, de vriendin van de griffier, uw fysiotherapeut, de verpleegster in het verpleeghuis van uw ouders of de bakker bij u in de buurt”. Dat vertelde hij althans de rechters tijdens het slotwoord van het proces tegen hem. Wilders wil maar zeggen: gewone Nederlanders, die stemmen PVV."
                            }
                        ]
