                ],
                "senses": [
                    {
                        "sense_id": "f6df3aac-15d4-3201-9afa-b041fb4cf521",
                        "entry_id": "10d25ddd-6134-38c3-9ca7-0bbad50a2d91",
                        "glosses": [
                            "Brett, hergestellt aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b44e63d-0710-464f-81af-e6c0cfefa389",
                                "sense_id": "f6df3aac-15d4-3201-9afa-b041fb4cf521",
                                "text": "Vor dem Haus lag ein Stapel von Holzbrettern."
                            },
                            {
                                "example_id": "68c3dfff-c37f-4e6e-b610-a4a012c685f3",
                                "sense_id": "f6df3aac-15d4-3201-9afa-b041fb4cf521",
                                "text": "„Er hatte sogar ein Holzbrett mit ähnlichen Sprüchen an Amas Zimmertür genagelt.“"
                            },
                            {
                                "example_id": "cc5ab0fa-ff8b-44fa-b59e-dc348c291808",
                                "sense_id": "f6df3aac-15d4-3201-9afa-b041fb4cf521",
                                "text": "„Die harten Holzbretter im Bett und die entsetzlichen Wanzen hielten uns in ununterbrochener Unruhe.“"
                            },
                            {
                                "example_id": "ae4370f2-fd1c-4873-8ae3-befb1f0b317d",
                                "sense_id": "f6df3aac-15d4-3201-9afa-b041fb4cf521",
                                "text": "„Doch am besten gefallen uns die Holzbretter mit Tiermotiven.“"
                            },
                            {
                                "example_id": "394952e1-f727-40a6-8f66-3e9f132f334e",
                                "sense_id": "f6df3aac-15d4-3201-9afa-b041fb4cf521",
                                "text": "„Die Holzbretter hatten sie von der Scheune abgerissen, nicht zerkleinert, sondern in langen Stücken in den Ofen geschoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
