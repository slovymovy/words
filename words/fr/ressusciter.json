{
    "word_family": [
        "résurrection",
        "susciter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "beeaa033-965c-3d12-8ef7-1a7c47e650c8",
                    "sense_definition": "Revenir de la mort à la vie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vie_mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la tradition chrétienne, Jésus est <w>ressuscité</w> trois jours après sa mort."
                        },
                        {
                            "text": "Dans ce roman fantastique, les défunts <w>ressuscitent</w> pour hanter les vivants chaque nuit."
                        }
                    ],
                    "synonyms": [
                        "revivre"
                    ],
                    "common_phrases": [
                        "ressusciter le troisième jour"
                    ]
                },
                {
                    "sense_id": "4a72f18a-e510-3782-a33f-590fc50c89f0",
                    "sense_definition": "Rappeler ou ramener quelqu'un de la mort à la vie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vie_mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les récits bibliques, le prophète parvient à <w>ressusciter</w> l'enfant de la veuve."
                        },
                        {
                            "text": "Aucun médecin moderne ne possède le pouvoir magique de <w>ressusciter</w> un mort."
                        }
                    ],
                    "common_phrases": [
                        "ressusciter les morts",
                        "ressusciter un mort"
                    ]
                },
                {
                    "sense_id": "644c8ea0-7e90-3020-93e5-44e52437d069",
                    "sense_definition": "Redonner de l'énergie, de la force ou de la vigueur à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vigueur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une bonne tasse de café chaud m'a complètement <w>ressuscité</w> après cette nuit blanche."
                        },
                        {
                            "text": "L'annonce de cette excellente nouvelle a semblé <w>ressusciter</w> le vieux professeur affaibli."
                        }
                    ]
                },
                {
                    "sense_id": "f8fc84ed-32b7-3716-b24f-88c681f5483b",
                    "sense_definition": "Faire revivre, remettre en usage ou au goût du jour ce qui avait disparu ou cessé d'exister.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renouveau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le metteur en scène a voulu <w>ressusciter</w> une pièce de théâtre oubliée depuis des décennies."
                        },
                        {
                            "text": "Ce festival estival cherche à <w>ressusciter</w> une tradition médiévale au cœur du village."
                        }
                    ],
                    "common_phrases": [
                        "ressusciter une tradition",
                        "ressusciter le passé"
                    ]
                },
                {
                    "sense_id": "a445a3fb-e4df-3f43-8586-bdc96e3e3110",
                    "sense_definition": "Retrouver l'ardeur, le bien-être ou la joie de vivre après une épreuve.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vigueur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que le printemps est revenu, j'ai eu l'impression de <w>ressusciter</w> après cet hiver sombre."
                        },
                        {
                            "text": "En respirant l'air pur de la montagne, le randonneur sentait qu'il commençait enfin à <w>ressusciter</w>."
                        }
                    ],
                    "synonyms": [
                        "revivre"
                    ]
                }
            ]
        }
    ]
}