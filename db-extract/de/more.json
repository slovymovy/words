                "senses": [
                    {
                        "sense_id": "75bc4154-c69a-3619-8463-21bf393cf890",
                        "entry_id": "0d2da4d9-5ab3-3e55-9233-0906785c575b",
                        "glosses": [
                            "kleinste zeitliche Einheit des Verstaktes; sie hat die Dauer einer kurzen Silbe, die aus einem kurzen Vokal besteht und zusätzlich höchstens einen Konsonanten enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06951b87-bdd0-4bba-bf20-cb763d630dce",
                                "sense_id": "75bc4154-c69a-3619-8463-21bf393cf890",
                                "text": "Bei Moren muss man darauf achten, ob sie genau in dem oben angegebenen Sinn gemeint sind oder in einem etwas anderen."
                            },
                            {
                                "example_id": "ac4ec4f0-134d-49c6-9021-2088aa17cb03",
                                "sense_id": "75bc4154-c69a-3619-8463-21bf393cf890",
                                "text": "„Jedem Kana-Zeichen entspricht also eine More, das heißt eine silbische Einheit, die die Struktur (K)V aufweist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "237b5628-255b-30d3-abc2-292e01af5ab2",
                        "entry_id": "0d2da4d9-5ab3-3e55-9233-0906785c575b",
                        "glosses": [
                            "eine Sprache in Burkina Faso, Elfenbeinküste und Ghana"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "06b9a6b3-ed68-4115-adbb-a9d2d1a4ae8b",
                                "sense_id": "237b5628-255b-30d3-abc2-292e01af5ab2",
                                "text": "More wird in Afrika gesprochen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
