                                "example_id": "2c514cf4-994c-4e2f-8cc2-d57e6e1fe6b9",
                                "sense_id": "c40314b1-a216-3a71-b6dc-f8de5c4eae26",
                                "text": "„Seine rechte Hand steckte in seiner Sommerhose und zuckte; er kratzte sich.“"
                            },
