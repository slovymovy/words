                    },
                    {
                        "sense_id": "4d736d9a-2737-35bb-89d2-1a9ff998706c",
                        "entry_id": "d0973149-17b4-37e1-82a0-0bc61bc5ad82",
                        "glosses": [
                            "to fall (into), to lapse (into), to sink (into)"
                        ],
                        "tags": [
                            "perfective"
                        ],
                        "examples": [
                            {
                                "example_id": "88c240f1-dc6e-4287-9f43-d48e8d1d5221",
                                "sense_id": "4d736d9a-2737-35bb-89d2-1a9ff998706c",
                                "text": "впасть в заду́мчивость",
                                "translation": "to fall into a reverie",
                                "english": "to fall into a reverie"
                            },
                            {
                                "example_id": "35f60a6c-c55a-4a8f-9da3-9715d8af0fbb",
                                "sense_id": "4d736d9a-2737-35bb-89d2-1a9ff998706c",
                                "text": "впасть в отча́яние",
                                "translation": "to give way to despair; be driven into despair",
                                "english": "to give way to despair; be driven into despair"
                            },
                            {
                                "example_id": "94290e7f-3786-4a39-890e-9f9d78c92357",
                                "sense_id": "4d736d9a-2737-35bb-89d2-1a9ff998706c",
                                "text": "впасть в сомне́ние",
                                "translation": "to begin to have doubts",
                                "english": "to begin to have doubts"
                            },
                            {
                                "example_id": "0fc34e32-9c44-4fdd-ae7c-ca2a7e3cc21e",
                                "sense_id": "4d736d9a-2737-35bb-89d2-1a9ff998706c",
                                "text": "впасть в неми́лость",
                                "translation": "to fall into disfavour/disfavor/disgrace",
                                "english": "to fall into disfavour/disfavor/disgrace"
                            },
                            {
                                "example_id": "58a0ea6c-bd8f-41c6-9ba6-c385ec128516",
                                "sense_id": "4d736d9a-2737-35bb-89d2-1a9ff998706c",
                                "text": "впасть в де́тство",
                                "translation": "to enter one's second childhood; be in one's dotage",
                                "english": "to enter one's second childhood; be in one's dotage"
                            },
                            {
                                "example_id": "71b91d19-72af-473b-b200-fd9f9fac3894",
                                "sense_id": "4d736d9a-2737-35bb-89d2-1a9ff998706c",
                                "text": "впасть в противоре́чие",
                                "translation": "contradict oneself",
                                "english": "contradict oneself"
                            }
                        ]
