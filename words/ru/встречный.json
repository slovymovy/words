{
    "word_family": [
        "встреча",
        "встречать",
        "встречаться",
        "встретить",
        "встретиться",
        "навстречу"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3cb498fa-0649-3ec0-9c85-ba7bac263b3e",
                    "sense_definition": "Движущийся или дующий навстречу, приближающийся с противоположной стороны.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сильный <w>встречный</w> ветер мешал велосипедистам ехать вперед по открытой трассе.",
                            "target_lang_translations": {
                                "pl": "Silny <w>przeciwny</w> wiatr utrudniał rowerzystom jazdę do przodu po otwartej trasie."
                            }
                        },
                        {
                            "text": "На узкой лесной дороге показалась <w>встречная</w> машина с включенными фарами.",
                            "target_lang_translations": {
                                "pl": "Na wąskiej leśnej drodze pojawił się samochód <w>z naprzeciwka</w> z włączonymi światłami."
                            }
                        }
                    ],
                    "antonyms": [
                        "попутный"
                    ],
                    "common_phrases": [
                        "встречный ветер",
                        "встречная полоса",
                        "встречный поезд"
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszający się lub wiejący z naprzeciwka, zbliżający się z przeciwnej strony."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeciwny",
                                "target_lang_sense_clarification": "np. wiatr wiejący z przodu"
                            },
                            {
                                "target_lang_word": "nadjeżdżający z naprzeciwka",
                                "target_lang_sense_clarification": "o pojeździe"
                            },
                            {
                                "target_lang_word": "z naprzeciwka",
                                "target_lang_sense_clarification": "kierunek ruchu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc91a218-2e21-3185-b56a-c783bd44eaf7",
                    "sense_definition": "Попавшийся навстречу, случайно оказавшийся на пути.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "encounter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он улыбался каждому <w>встречному</w> прохожему в этот солнечный весенний день.",
                            "target_lang_translations": {
                                "pl": "Uśmiechał się do każdego <w>napotkanego</w> przechodnia w ten słoneczny wiosenny dzień."
                            }
                        },
                        {
                            "text": "Мы расспрашивали всех <w>встречных</w> жителей деревни о правильной дороге к озеру.",
                            "target_lang_translations": {
                                "pl": "Wypytywaliśmy wszystkich <w>napotkanych</w> mieszkańców wsi o właściwą drogę nad jezioro."
                            }
                        }
                    ],
                    "common_phrases": [
                        "первый встречный"
                    ],
                    "target_lang_definitions": {
                        "pl": "Napotkany po drodze, przypadkowo idący lub znajdujący się naprzeciw."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "napotkany",
                                "target_lang_sense_clarification": "przypadkowo spotkany"
                            },
                            {
                                "target_lang_word": "idący z naprzeciwka",
                                "target_lang_sense_clarification": "o osobie mijanej w drodze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a20dd95-2298-3d8c-b4b3-db6c121119ac",
                    "sense_definition": "Являющийся ответом на что-либо, предпринимаемый в ответ на сходное действие.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компания подготовила <w>встречное</w> предложение для своих деловых партнеров.",
                            "target_lang_translations": {
                                "pl": "Firma przygotowała <w>kontrofertę</w> dla swoich partnerów biznesowych."
                            }
                        },
                        {
                            "text": "Адвокат ответчика решил подать <w>встречный</w> иск в районный суд.",
                            "target_lang_translations": {
                                "pl": "Adwokat pozwanego postanowił złożyć pozew <w>wzajemny</w> do sądu rejonowego."
                            }
                        }
                    ],
                    "synonyms": [
                        "ответный"
                    ],
                    "common_phrases": [
                        "встречный иск",
                        "встречное предложение",
                        "встречный план"
                    ],
                    "target_lang_definitions": {
                        "pl": "Będący odpowiedzią na czyjeś działanie, podejmowany w reakcji na podobny krok."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wzajemny",
                                "target_lang_sense_clarification": "np. pozew, oferta"
                            },
                            {
                                "target_lang_word": "odwetowy",
                                "target_lang_sense_clarification": "będący reakcją"
                            },
                            {
                                "target_lang_word": "kontr-",
                                "target_lang_sense_clarification": "jako przedrostek, np. kontroferta, kontrpropozycja"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04c2ccc3-cd36-31a2-a06a-4ad5cc4cd26f",
                    "sense_definition": "Тот, кто идет навстречу или случайно попадается на пути.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит доверять свои личные секреты первому <w>встречному</w>.",
                            "target_lang_translations": {
                                "pl": "Nie warto powierzać swoich osobistych sekretów pierwszemu <w>lepszemu</w>."
                            }
                        },
                        {
                            "text": "Каждый <w>встречный</w> оборачивался и с удивлением смотрел на необычный наряд музыканта.",
                            "target_lang_translations": {
                                "pl": "Każdy <w>przechodzień</w> odwracał się i ze zdziwieniem patrzył na niezwykły strój muzyka."
                            }
                        }
                    ],
                    "synonyms": [
                        "прохожий"
                    ],
                    "common_phrases": [
                        "первый встречный"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba idąca z naprzeciwka lub przypadkowo napotkana na drodze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przechodzień",
                                "target_lang_sense_clarification": "osoba mijana na ulicy"
                            },
                            {
                                "target_lang_word": "napotkany",
                                "target_lang_sense_clarification": "przypadkowa osoba"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}