                    {
                        "sense_id": "028b1235-38a2-34d8-8f3d-ca9acf644575",
                        "entry_id": "84740cd4-72c0-3050-b177-96e9a8bebc94",
                        "glosses": [
                            "Établi par la constitution ou les lois du pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39603054-b52a-4e6f-88dd-aaf012f1ea00",
                                "sense_id": "028b1235-38a2-34d8-8f3d-ca9acf644575",
                                "text": "Les autorités constituées, les corps constitués."
                            },
                            {
                                "example_id": "96bf49ed-2bfd-4ac5-a6a1-3d600a80474b",
                                "sense_id": "028b1235-38a2-34d8-8f3d-ca9acf644575",
                                "text": "Une situation est qualifiée de « constituée » lorsqu’elle est juridiquement parfaite, c’est-à-dire définitivement fixée avant l’intervention de la règle nouvelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d5ab7e-d3e9-32f9-88d0-bbdde1076a71",
                        "entry_id": "84740cd4-72c0-3050-b177-96e9a8bebc94",
                        "glosses": [
                            "Qui est de bonne ou de mauvaise complexion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19cd85fe-f71f-410d-a7eb-06288d41e222",
                                "sense_id": "c3d5ab7e-d3e9-32f9-88d0-bbdde1076a71",
                                "text": "Être bien ou mal constitué, avoir le corps bien ou mal constitué."
                            }
                        ]
                    }
                ],
