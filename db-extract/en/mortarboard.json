                        "source_sense_description": "rectangular board with a handle",
                        "target_lang_word": "Traufel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Traufel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e75d28c2-f463-3cc4-bbd7-bdccc590b5cd",
                                        "entry_id": "69fb9c08-c89b-321d-8060-85ebaa56d957",
                                        "glosses": [
                                            "Handwerksgerät für Maurer (regional z.B. im Rheinland): die Kelle, die Maurerkelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78da12b-b41e-4b0d-b0ad-8ac35aae81fd",
                                                "sense_id": "e75d28c2-f463-3cc4-bbd7-bdccc590b5cd",
                                                "text": "Bring mir doch mal die Traufel her!"
                                            },
                                            {
                                                "example_id": "13055e27-bfa5-41f8-97d1-455fcd99e037",
                                                "sense_id": "e75d28c2-f463-3cc4-bbd7-bdccc590b5cd",
                                                "text": "„Die Traufel wird zum Auftragen und Abziehen von Außenputz und Innenputz und von Spachtel benutzt - beispielsweise, um Fugen in einer Gipsfaserwand zu füllen und die Übergänge zu glätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c859a948-ee95-4dd6-b429-223ffdb24c0b",
                        "source_entry_id": "3b538a2b-0f14-3dee-a9b9-4ad878b8ca6b",
                        "source_sense_description": "rectangular board with a handle",
                        "target_lang_word": "Glättkelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
