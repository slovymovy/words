                ],
                "senses": [
                    {
                        "sense_id": "14195367-a6a5-312b-b391-e6dfe67369bf",
                        "entry_id": "36138cab-7825-359b-8193-a211606972f5",
                        "glosses": [
                            "приводить кому-то соображения, заставляющие поверить во что-то или сделать что-то"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf3f2a39-d1c2-44b9-a779-b32e613dbc80",
                                "sense_id": "14195367-a6a5-312b-b391-e6dfe67369bf",
                                "text": "— Да ничего не сделаешь: это уж такая натура. Весь в тетку: та такая же плакса. Я уж немало убеждал его. — Только убеждал? — И убедил; он согласился со мной."
                            },
                            {
                                "example_id": "a0958004-54ba-4660-9046-f8c5378054a0",
                                "sense_id": "14195367-a6a5-312b-b391-e6dfe67369bf",
                                "text": "В конце марта Машу, по ее желанию, назначили попечительницей куриловской школы, а в начале апреля мы три раза собирали сход и убеждали крестьян, что их школа тесна и стара и что необходимо строить новую."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b21ce836-b401-4aa5-8add-68503ec3628d",
                        "source_entry_id": "36138cab-7825-359b-8193-a211606972f5",
                        "source_sense_id": "14195367-a6a5-312b-b391-e6dfe67369bf",
                        "target_lang_word": "convince",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convince",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48785e7b-91b9-3cdb-a0d9-83312ae343f6",
                                        "entry_id": "bca84664-cc41-3a63-b990-f93f66d6476c",
                                        "glosses": [
                                            "To make someone believe, or feel sure about something, especially by using logic, argument or evidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4142704f-b6af-4b5b-88aa-a78861bf6349",
                                                "sense_id": "48785e7b-91b9-3cdb-a0d9-83312ae343f6",
                                                "text": "I wouldn't have or do something, unless I'm convinced that it's good."
                                            },
                                            {
                                                "example_id": "88ffa9ea-6444-442f-a60d-2a89f3f422be",
                                                "sense_id": "48785e7b-91b9-3cdb-a0d9-83312ae343f6",
                                                "text": "Such convincing proofs and assurances of it as might enable them to convince others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf518c8-0c1b-3c81-941e-84c54c2aa00b",
                                        "entry_id": "bca84664-cc41-3a63-b990-f93f66d6476c",
                                        "glosses": [
                                            "To persuade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a53b16d6-5c50-3104-a1b2-c1a719aec9e2",
                                        "entry_id": "bca84664-cc41-3a63-b990-f93f66d6476c",
                                        "glosses": [
                                            "To overcome, conquer, vanquish."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d618efa7-70ba-4986-be8f-91197f6ae45f",
                                                "sense_id": "a53b16d6-5c50-3104-a1b2-c1a719aec9e2",
                                                "text": "[…]his two Chamberlaines / Will I with Wine, and Waſſell, ſo conuince, / That Memorie, the Warder of the Braine, / Shall be a Fume,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5acb9c9b-e2f0-340f-9fdc-1a7d78b9f801",
                                        "entry_id": "bca84664-cc41-3a63-b990-f93f66d6476c",
                                        "glosses": [
                                            "To behave believably in a role; to make someone perceive oneself as the character being portrayed."
                                        ],
