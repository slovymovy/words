{
    "word_family": [
        "geocache",
        "geocaching",
        "cacher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09939fdc-d4d5-3e57-a425-33b46911b499",
                    "sense_definition": "A fast temporary storage where recently or frequently used information is stored to avoid having to reload it from a slower storage medium.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should clear your browser <w>cache</w> if the website is not loading the latest version.",
                            "target_lang_translations": {
                                "ru": "Вам следует очистить <w>кэш</w> браузера, если сайт не загружает последнюю версию."
                            }
                        },
                        {
                            "text": "The processor uses a high-speed <w>cache</w> to improve overall system performance.",
                            "target_lang_translations": {
                                "ru": "Процессор использует высокоскоростной <w>кэш</w> для повышения общей производительности системы."
                            }
                        }
                    ],
                    "synonyms": [
                        "buffer",
                        "temporary storage"
                    ],
                    "common_phrases": [
                        "browser cache",
                        "clear the cache",
                        "cache memory"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое временное хранилище, где хранится недавно или часто используемая информация, чтобы избежать ее повторной загрузки из более медленного источника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кэш",
                                "target_lang_sense_clarification": "компьютерная память для временного хранения данных"
                            },
                            {
                                "target_lang_word": "буфер",
                                "target_lang_sense_clarification": "промежуточное хранилище данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fc71bcf-18e2-367a-bf2c-3ac84f333618",
                    "sense_definition": "A store, protected or hidden in some way, of things that may be required in the future, such that they can be retrieved rapidly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police discovered a large <w>cache</w> of weapons hidden in the basement of the abandoned house.",
                            "target_lang_translations": {
                                "ru": "Полиция обнаружила в подвале заброшенного дома большой <w>тайник</w> с оружием."
                            }
                        },
                        {
                            "text": "The hikers left a food <w>cache</w> at the base of the mountain for their return journey.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы оставили <w>запас</w> еды у подножия горы на обратный путь."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoard",
                        "store",
                        "stockpile",
                        "stash"
                    ],
                    "common_phrases": [
                        "hidden cache",
                        "food cache",
                        "weapons cache"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищенное или скрытое хранилище вещей, которые могут понадобиться в будущем, организованное так, чтобы их можно было быстро извлечь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тайник",
                                "target_lang_sense_clarification": "скрытое место для хранения"
                            },
                            {
                                "target_lang_word": "схрон",
                                "target_lang_sense_clarification": "потайное хранилище, часто оружия или припасов"
                            },
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "накопленные для будущего использования вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb91441b-4242-3623-a5b6-a244f865be3a",
                    "sense_definition": "A container containing treasure in a global treasure-hunt game.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geocaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon looking for a tiny <w>cache</w> hidden under a park bench.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день в поисках крошечного <w>тайника</w>, спрятанного под парковой скамейкой."
                            }
                        },
                        {
                            "text": "The GPS coordinates led us directly to the geocaching <w>cache</w> near the old bridge.",
                            "target_lang_translations": {
                                "ru": "Координаты GPS привели нас прямо к <w>кэшу</w> для геокэшинга возле старого моста."
                            }
                        }
                    ],
                    "synonyms": [
                        "geocache"
                    ],
                    "common_phrases": [
                        "geocaching cache",
                        "find a cache"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер с «сокровищами» в глобальной игре по поиску кладов (геокэшинге)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кэш",
                                "target_lang_sense_clarification": "контейнер в геокэшинге"
                            },
                            {
                                "target_lang_word": "тайник",
                                "target_lang_sense_clarification": "спрятанный объект в игре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c9a6840-2a28-3d74-bc73-2b30bfc31f30",
                    "sense_definition": "To store data in a cache.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application will <w>cache</w> data locally to ensure it works even when the user is offline.",
                            "target_lang_translations": {
                                "ru": "Приложение будет <w>кэшировать</w> данные локально, чтобы обеспечить работу даже в автономном режиме."
                            }
                        },
                        {
                            "text": "Modern web browsers <w>cache</w> images to make pages load faster on subsequent visits.",
                            "target_lang_translations": {
                                "ru": "Современные веб-браузеры <w>кэшируют</w> изображения, чтобы страницы загружались быстрее при последующих посещениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "buffer"
                    ],
                    "common_phrases": [
                        "cache data",
                        "cache images"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранять данные в кэш-памяти для ускорения доступа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кэшировать",
                                "target_lang_sense_clarification": "сохранять в компьютерный кэш"
                            },
                            {
                                "target_lang_word": "буферизовать",
                                "target_lang_sense_clarification": "временно сохранять данные"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8ff5762-373c-3afa-8531-bfa41743fa6d",
                    "sense_definition": "To place in a cache; to hide or store away for future use.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Squirrels often <w>cache</w> supplies of nuts in various locations to survive the winter.",
                            "target_lang_translations": {
                                "ru": "Белки часто <w>прячут</w> запасы орехов в разных местах, чтобы пережить зиму."
                            }
                        },
                        {
                            "text": "The explorers decided to <w>cache</w> their heavy equipment before attempting the final climb.",
                            "target_lang_translations": {
                                "ru": "Исследователи решили <w>спрятать</w> свое тяжелое снаряжение перед последним восхождением."
                            }
                        }
                    ],
                    "synonyms": [
                        "stash",
                        "hoard",
                        "stockpile"
                    ],
                    "common_phrases": [
                        "cache supplies",
                        "cache food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать в тайник; прятать или сохранять для использования в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прятать",
                                "target_lang_sense_clarification": "скрывать в надежном месте"
                            },
                            {
                                "target_lang_word": "делать запасы",
                                "target_lang_sense_clarification": "откладывать вещи на будущее"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}