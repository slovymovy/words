                "senses": [
                    {
                        "sense_id": "b235aa85-ded3-3ea4-994f-b332ba5c9105",
                        "entry_id": "7dbf19ac-2078-365a-8793-ac8c07f3c003",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fcd8b7c-62bf-46a7-ab83-a8dd23c3da98",
                                "sense_id": "b235aa85-ded3-3ea4-994f-b332ba5c9105",
                                "text": "„Szkoła średnia to był koszmar” – wyznał Sebastian."
                            },
                            {
                                "example_id": "84c37463-e066-4214-8629-642314f207e8",
                                "sense_id": "b235aa85-ded3-3ea4-994f-b332ba5c9105",
                                "text": "Kuzynka Sebastiana jest Greczynką."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b519c7f-9438-4c66-8d76-0a3d16a82e82",
                        "source_entry_id": "7dbf19ac-2078-365a-8793-ac8c07f3c003",
                        "source_sense_id": "b235aa85-ded3-3ea4-994f-b332ba5c9105",
                        "target_lang_word": "Sebastian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sebastian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3cc7d1-b167-309c-94eb-b29d396698ac",
                                        "entry_id": "44a1ea31-8543-3378-939f-3071ce00d5d7",
                                        "glosses": [
                                            "A male given name from Latin or Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e190c48-cef0-4c31-a0a1-871eab27a0f0",
                                                "sense_id": "dc3cc7d1-b167-309c-94eb-b29d396698ac",
                                                "text": "Of Messaline: Sebastian was my father; / Such a Sebastian was my brother too, / So went he suited to his watery tomb."
                                            },
                                            {
                                                "example_id": "b1301ff8-d5cb-4f0b-833f-8e1ef7baa486",
                                                "sense_id": "dc3cc7d1-b167-309c-94eb-b29d396698ac",
                                                "text": "I was hoping the man would have some romantic name like Sebastian or Julian. However, as a surname Fletcher's all right."
                                            },
                                            {
                                                "example_id": "56308bb1-119d-47ee-8f19-ede5420eb3cd",
                                                "sense_id": "dc3cc7d1-b167-309c-94eb-b29d396698ac",
                                                "text": "“She was a new student. I was a counterculture hero. Back then I went by a different name. Sebastian. Sexy, right? And so much better than Guy. You can't be a counterculture hero and a Guy. That name is way too average. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6563ec6b-ceb6-4d93-a817-858eb51a21e8",
                        "source_entry_id": "7dbf19ac-2078-365a-8793-ac8c07f3c003",
                        "source_sense_id": "b235aa85-ded3-3ea4-994f-b332ba5c9105",
                        "target_lang_word": "Sébastien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sébastien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e31516a5-660f-3bf2-b4e2-5a313cf90446",
                                        "entry_id": "c4f29938-d13d-3e56-9c01-7220bccfc76b",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Sébastien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1d66f66-2d4c-3642-8605-a1934f9ff023",
                                        "entry_id": "03ca45a6-7074-3cc3-8804-898b14ff09ce",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7538bf-6dd8-4b1a-8b86-3bad3c1972a7",
                                                "sense_id": "b1d66f66-2d4c-3642-8605-a1934f9ff023",
                                                "text": "À peine des Lupeaulx savait-il qu’il existât un Sébastien de La Roche."
                                            },
                                            {
                                                "example_id": "0d6d6845-3043-424c-96a4-56c39caa759f",
                                                "sense_id": "b1d66f66-2d4c-3642-8605-a1934f9ff023",
                                                "text": "Je me suis inspiré de ma mère, qui a retrouvé son père biologique, explique Sébastien Marnier."
                                            },
                                            {
                                                "example_id": "07693334-9c60-4ea8-92da-c3bcad3b6505",
                                                "sense_id": "b1d66f66-2d4c-3642-8605-a1934f9ff023",
                                                "text": "Confirmant une information de nos confrères d’Actu Rennes, le procureur de la République adjoint Sébastien Farges nous indique que la décision ne leur « apparaît pas conforme à la matérialité des faits »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7c036ab-3619-46e8-97e1-3606d9de8b19",
                        "source_entry_id": "7dbf19ac-2078-365a-8793-ac8c07f3c003",
