    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7ecc08a3-644c-3614-97a3-ac61049bab5e",
                "word": "catatonic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ba0ee1c0-00a4-4b17-88dd-d871156a13d5",
                        "entry_id": "7ecc08a3-644c-3614-97a3-ac61049bab5e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more catatonic"
                    },
                    {
                        "form_id": "4b378117-1ae7-4452-9091-ef31c4003f0d",
                        "entry_id": "7ecc08a3-644c-3614-97a3-ac61049bab5e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most catatonic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3424b10-fe63-3f02-adf2-97d67e897cf1",
                        "entry_id": "7ecc08a3-644c-3614-97a3-ac61049bab5e",
                        "glosses": [
                            "Of, relating to, or suffering from catatonia; having a tendency to remain in a rigid state of stupor for long periods which give way to short periods of extreme agitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e84c87bf-d63a-40e9-80bb-123c7d5a0001",
                                "sense_id": "d3424b10-fe63-3f02-adf2-97d67e897cf1",
                                "text": "However, he was looking a lot more catatonic and depressed before and sometimes we find that on the anti-depressants you remove the depression and uncover the paranoid stuff and we may have to give him larger quantities of tranquilizers just to tone this down."
                            },
                            {
                                "example_id": "f617a218-9c90-4707-9f55-19f9132fcbc9",
                                "sense_id": "d3424b10-fe63-3f02-adf2-97d67e897cf1",
                                "text": "It was plausible that Cara became more catatonic in order to avoid a painful and overwhelming confrontation with terrifying but repressed memories of child abuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8901113b-2859-32d0-b428-b947c56c7b63",
                        "entry_id": "7ecc08a3-644c-3614-97a3-ac61049bab5e",
                        "glosses": [
                            "Motionless and unresponsive, as from shock; withdrawn."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "15038ef3-30ae-47fc-9cfe-2e986108f7df",
                                "sense_id": "8901113b-2859-32d0-b428-b947c56c7b63",
                                "text": "He made Yossarian think of cripples and of cold and hungry men and women, and of all the dumb, passive, devout mothers with catatonic eyes nursing infants outdoors that same night with chilled animal udders bared insensibly to that same raw rain."
                            },
                            {
                                "example_id": "f0eae251-a2da-468d-85b2-0928d9cd4762",
                                "sense_id": "8901113b-2859-32d0-b428-b947c56c7b63",
                                "text": "Further and further he would withdraw from the world, becoming more and more catatonic — withdrawing completely from his hateful world to the only real and secure comfort he had ever known, the womb."
                            },
                            {
                                "example_id": "27059fd6-19c7-4a58-9c5a-51df9e950372",
                                "sense_id": "8901113b-2859-32d0-b428-b947c56c7b63",
                                "text": "The fact that he was not twirling his kiss curl underscored his catatonic state of mind. I didn't know who was more catatonic—Brentwood, the minister, or myself."
                            },
                            {
                                "example_id": "5f66e19a-6c44-4b67-885d-3e195c7542cd",
                                "sense_id": "8901113b-2859-32d0-b428-b947c56c7b63",
                                "text": "A very young Ensign, in his first real contact with combat conditions, was in charge but was almost of no use as he began to hyper-ventilate and became more and more catatonic the closer they got to shore."
                            }
                        ]
                    }
                ],
