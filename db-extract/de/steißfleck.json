                "senses": [
                    {
                        "sense_id": "c9ef36a4-e542-3147-b602-2df22847788d",
                        "entry_id": "534bd89f-a650-36ae-bded-715274579a29",
                        "glosses": [
                            "unregelmäßige bläuliche Muttermale meist am Rücken, Gesäß oder Kreuzbein eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ea9556-32cc-4002-8e33-c1ca08ec679a",
                                "sense_id": "c9ef36a4-e542-3147-b602-2df22847788d",
                                "text": "„Darauf weist die Erscheinung hin, daß der entsprechend gelagerte Steißfleck (Mongolenfleck), obwohl aus braunem Pigment bestehend, makroskopisch bläulich aussieht.“"
                            },
                            {
                                "example_id": "d9679b90-f6c7-4e51-b8c4-58041294297c",
                                "sense_id": "c9ef36a4-e542-3147-b602-2df22847788d",
                                "text": "„Die überholt klingenden Mongolenflecken (oder auch Steißfleck) sind bei dunkelhäutigen Babys verbreitet und sehen ähnlich wie ein flacher Bluterguss in grau-bläulicher Farbe aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
