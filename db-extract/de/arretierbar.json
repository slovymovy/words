                        "examples": [
                            {
                                "example_id": "5d2e8285-3956-4b08-bf35-9ac712a5f73b",
                                "sense_id": "16dcd234-0289-3279-96b3-c1441554f84a",
                                "text": "In diesem Fall brauchen wir eine hochklappbare und arretierbare Armlehne."
                            },
                            {
                                "example_id": "9b389c3d-e806-4b61-ad5d-f453cc67fc1b",
                                "sense_id": "16dcd234-0289-3279-96b3-c1441554f84a",
                                "text": "Diese Greifzange hat ein arretierbares Gleitgelenk und ist ideal geeignet zum Lösen oder Festziehen von Verschraubungen mit großem Gewinde."
                            }
