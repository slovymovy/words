                "senses": [
                    {
                        "sense_id": "d42b69d3-649d-3169-bc9f-d7a46a69ce53",
                        "entry_id": "52ab38a9-a894-3218-bd51-c6bc375429e4",
                        "glosses": [
                            "смотреть, бросать взгляды вокруг себя; осматриваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3638b63-5555-4766-9634-8d68aa882ba3",
                                "sense_id": "d42b69d3-649d-3169-bc9f-d7a46a69ce53",
                                "text": "Буфетчица занималась с кем-то в конце стойки, а ребята пока оглядывались, сидя у стойки."
                            }
                        ]
                    },
                    {
                        "sense_id": "68bf1cad-2679-3772-a423-01b5b2d9a6ae",
                        "entry_id": "52ab38a9-a894-3218-bd51-c6bc375429e4",
                        "glosses": [
                            "перен. привыкать к новой обстановке, к новым условиям; осваиваться"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f1459f3f-365d-30ca-b77b-ae27dbb59618",
                        "entry_id": "52ab38a9-a894-3218-bd51-c6bc375429e4",
                        "glosses": [
                            "перен. окидывать мысленным взором, воспроизводить в памяти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d7fa90d-b643-4727-b59d-6daf5fe7441f",
                                "sense_id": "f1459f3f-365d-30ca-b77b-ae27dbb59618",
                                "text": "Оглядываясь назад, в историческое прошлое, мы замечаем, что так было и раньше, насколько наш взор проникает в глубь веков."
                            }
                        ]
                    },
