                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e20bdb8d-59a7-45f3-99cc-409aac177530",
                                "sense_id": "0d3cb530-1914-3c82-ae18-c285bdafcc98",
                                "text": "„Er trägt ein Unterhemd, das seine Armmuskeln freilegt.“"
                            },
                            {
                                "example_id": "79804bc0-63cd-47b9-af90-0cc2bddadba7",
                                "sense_id": "0d3cb530-1914-3c82-ae18-c285bdafcc98",
                                "text": "„So angespannt, wie er jetzt dasaß, seine Schultern stocksteif, seine Armmuskeln unter dem engen Pulli hervortretend, vermutete ich, dass er genauso ungeduldig war wie ich.“"
                            }
                        ],
