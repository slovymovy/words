                                                "example_id": "263bde2a-74db-4c66-bc90-43fa2e98f438",
                                                "sense_id": "6698dd22-50d7-3d53-8f32-5970b59828ba",
                                                "text": "Брюнетка — чёрный ворон."
                                            }
                                        ]
