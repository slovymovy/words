                        ],
                        "form": "die Anamorphose"
                    },
                    {
                        "form_id": "1dca8fba-90db-4f95-98c4-5e62f54341aa",
                        "entry_id": "36fbcd76-6353-3a69-92ae-508bd8ee1f2e",
