                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cruaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ceux qui s'attaquent lâchement à des personnes sans défense se comportent en véritables <w>barbares</w>."
                        },
                        {
                            "text": "La justice doit punir ce <w>barbare</w> pour les crimes abominables qu'il a commis."
                        }
