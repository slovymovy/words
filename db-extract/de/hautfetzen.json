                ],
                "senses": [
                    {
                        "sense_id": "4beea5ce-7fdb-30e2-9b70-abe0e41e429a",
                        "entry_id": "56eef195-c413-35ab-9975-9038f1f3f792",
                        "glosses": [
                            "Fetzen von Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b792f2fa-80ac-470e-ae10-f6762b5adde2",
                                "sense_id": "4beea5ce-7fdb-30e2-9b70-abe0e41e429a",
                                "text": "„Am Nachmittag untersuchten die Feuerwehrleute, die sich mit ihrem Kommen viel Zeit gelassen hatten, die Überreste des klinischen Labors und fanden zwei Skelette, an denen noch verkohlte Hautfetzen hingen.“"
                            },
                            {
                                "example_id": "702c3f70-b141-4f75-9054-9f12ea9604ef",
                                "sense_id": "4beea5ce-7fdb-30e2-9b70-abe0e41e429a",
                                "text": "„Und ein Augenlid hängt schlaff herunter. Als ich den Kopf schüttle, rutscht es wie ein Blatt über mein Auge. Es ist nur noch durch einen dünnen Hautfetzen mit meinem Gesicht verbunden.“"
                            },
                            {
                                "example_id": "ebf06b10-8b05-4985-ab39-55bf36e10aac",
                                "sense_id": "4beea5ce-7fdb-30e2-9b70-abe0e41e429a",
                                "text": "„Ihr Nachthemd war bis zum Hals hochgeschoben, die vom Körper abgezogenen Hautfetzen lagen auf dem Boden.“"
                            },
                            {
                                "example_id": "7b99ee01-03f9-4c21-98a1-41f660acfa24",
                                "sense_id": "4beea5ce-7fdb-30e2-9b70-abe0e41e429a",
                                "text": "„Saddiqi verarztete den losen Hautfetzen und drückte die Risswunde zu, bis sie aufhörte zu bluten.“"
                            },
                            {
                                "example_id": "a93e473a-b8f3-4c2b-b21a-acc478b50a88",
                                "sense_id": "4beea5ce-7fdb-30e2-9b70-abe0e41e429a",
                                "text": "„Die Brüste waren bedeckt mit Brandmalen von Zigaretten, die rechte hing lose herab, nur noch von Hautfetzen am Torso gehalten; die linke war um die Brustwarze herum aufgeschlitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
