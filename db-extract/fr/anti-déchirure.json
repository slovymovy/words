                        "glosses": [
                            "Destiné à éviter les déchirures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d637f83-4016-4965-aa37-4c4873aa5275",
                                "sense_id": "1d903b71-5e72-35e6-8b50-233ec1ad4984",
                                "text": "Un soufflet anti-déchirure est posé au départ des fentes des côtés."
                            },
                            {
                                "example_id": "a20588a2-689b-4ddd-bc0b-87aa7fb82e6d",
                                "sense_id": "1d903b71-5e72-35e6-8b50-233ec1ad4984",
                                "text": "Au niveau de la poitrine, les poches manchons à double passepoils sont renforcées par des flèches surpiquées ou appliquées anti-déchirure."
                            },
                            {
                                "example_id": "85010cc0-e121-4ee4-a42f-ff66df9e803a",
                                "sense_id": "1d903b71-5e72-35e6-8b50-233ec1ad4984",
                                "text": "À l’heure actuelle, on a de moins en moins recours à la toile, à laquelle les Inuit préfèrent le nylon anti-déchirure, l’arctic armour, ou un mélange coton-polyester solidement tissé pour l’enveloppe extérieure du vêtement."
                            }
