{
    "word_family": [
        "булка",
        "булочка",
        "булочник",
        "булочный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0170a006-f1b5-34f3-987d-fb3b6720053f",
                    "sense_definition": "Магазин, торгующий хлебом и другими хлебобулочными изделиями.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "магазин",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По дороге домой он зашёл в <w>булочную</w>, чтобы купить свежий батон к ужину.",
                            "target_lang_translations": {
                                "nl": "Onderweg naar huis ging hij naar de <w>bakkerij</w> om een vers brood voor het avondeten te kopen."
                            }
                        },
                        {
                            "text": "Маленькая <w>булочная</w> на углу нашей улицы открывается в семь часов утра.",
                            "target_lang_translations": {
                                "nl": "De kleine <w>bakkerij</w> op de hoek van onze straat gaat om zeven uur 's ochtends open."
                            }
                        }
                    ],
                    "common_phrases": [
                        "зайти в булочную",
                        "свежий хлеб в булочной"
                    ],
                    "target_lang_definitions": {
                        "nl": "Winkel waar brood en andere bakkerijproducten worden verkocht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bakkerij",
                                "target_lang_sense_clarification": "winkel die brood verkoopt"
                            },
                            {
                                "target_lang_word": "broodjeszaak",
                                "target_lang_sense_clarification": "winkel waar brood of broodjes worden verkocht"
                            },
                            {
                                "target_lang_word": "bakker",
                                "target_lang_sense_clarification": "de bakkerswinkel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b774a34f-f0ce-3b86-81f8-2e164d9104e2",
                    "sense_definition": "Предприятие или заведение, где выпекают и продают хлебобулочные изделия.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "пекарня",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро в этой небольшой <w>булочной</w> выпекают ароматные круассаны.",
                            "target_lang_translations": {
                                "nl": "Elke ochtend bakken ze in deze kleine <w>bakkerij</w> geurige croissants."
                            }
                        },
                        {
                            "text": "Старая семейная <w>булочная</w> радовала жителей района вкусной и горячей выпечкой.",
                            "target_lang_translations": {
                                "nl": "De oude familie-<w>bakkerij</w> verblijdde de buurtbewoners met lekker en warm gebak."
                            }
                        }
                    ],
                    "synonyms": [
                        "булочная-пекарня",
                        "хлебопекарня"
                    ],
                    "common_phrases": [
                        "семейная булочная"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bedrijf of werkplaats waar brood en banket worden gebakken en verkocht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bakkerij",
                                "target_lang_sense_clarification": "werkplaats en winkel waar men bakt"
                            },
                            {
                                "target_lang_word": "broodbakkerij",
                                "target_lang_sense_clarification": "bedrijf waar brood gebakken wordt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eddbbbf8-b21a-3e85-a5f9-39036155ce66",
                    "sense_definition": "Форма именительного падежа женского рода единственного числа прилагательного <w>булочный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В супермаркете была открыта новая <w>булочная</w> витрина со свежей продукцией.",
                            "target_lang_translations": {
                                "nl": "In de supermarkt werd een nieuwe <w>broodvitrine</w> met verse producten geopend."
                            }
                        },
                        {
                            "text": "Вся эта <w>булочная</w> торговля приносила владельцам стабильный доход.",
                            "target_lang_translations": {
                                "nl": "Al deze <w>bakkerijhandel</w> leverde de eigenaren een stabiel inkomen op."
                            }
                        }
                    ],
                    "common_phrases": [
                        "булочная лавка"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Vrouwelijke vorm van het bijvoeglijk naamwoord dat betrekking heeft op brood, broodjes of de bakkerij."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bakkerij-",
                                "target_lang_sense_clarification": "als voorvoegsel/bepaling bij zelfstandige naamwoorden"
                            },
                            {
                                "target_lang_word": "brood-",
                                "target_lang_sense_clarification": "betrekking hebbend op brood"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}