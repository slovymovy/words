                        "glosses": [
                            "To remove a roof from, e.g. a building."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50243c67-ac82-4aee-9d47-30352db4dcd3",
                                "sense_id": "ac6208ba-2a30-3d29-b2cf-73581d78c993",
                                "text": "The rabble should have first unroof'd the city, / Ere so prevail'd with me:"
                            },
                            {
                                "example_id": "0788b560-6a3a-4e05-aa47-9bedc0482161",
                                "sense_id": "ac6208ba-2a30-3d29-b2cf-73581d78c993",
                                "text": "Here Stuarts once in glory reigned, / And laws for Scotland's weal ordained; / But now unroof'd their palace stands, / Their sceptre's sway'd by other hands;"
                            },
                            {
                                "example_id": "ca0bd4e2-e3f3-4365-9ebc-10a2e9264a3a",
                                "sense_id": "ac6208ba-2a30-3d29-b2cf-73581d78c993",
                                "text": "[…] Rain-logged, wind-unroofed, / The manor farm hulked its last use / As landmark. […]"
                            },
                            {
                                "example_id": "d327de45-98c4-4c5a-b423-36bf18d344b3",
                                "sense_id": "ac6208ba-2a30-3d29-b2cf-73581d78c993",
                                "text": "When the workers rejected these terms, some planters threatened to evict them, and others unroofed cottages and turned estate cattle through the workers’ provision grounds."
                            }
                        ]
                    }
                ],
