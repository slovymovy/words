                "senses": [
                    {
                        "sense_id": "090d7fd7-d6dc-37d6-aa15-6398f301c7b7",
                        "entry_id": "da6e8e48-569d-37fb-9da9-165c1931a65e",
                        "glosses": [
                            "высок. навсегда, на всю жизнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe5b743-6939-40aa-9997-04e67b1e2868",
                                "sense_id": "090d7fd7-d6dc-37d6-aa15-6398f301c7b7",
                                "text": "― Полно, мой дружок, ― сказал папа, ― ведь не навек расстаемся."
                            },
                            {
                                "example_id": "2ec16954-1800-4ecb-b09e-ec40c78a0287",
                                "sense_id": "090d7fd7-d6dc-37d6-aa15-6398f301c7b7",
                                "text": "Придумал я свой край родной // Навек оставить, но с тобой!.."
                            },
                            {
                                "example_id": "f4a959f0-490e-40ba-bab6-7b385a95acdf",
                                "sense_id": "090d7fd7-d6dc-37d6-aa15-6398f301c7b7",
                                "text": "Когда меня навек обымет смертный сон, // Над урною моей промолви с умиленьем: // Он мною был любим, он мне был одолжён // И песен и любви последним вдохновеньем."
                            }
                        ]
                    }
                ],
