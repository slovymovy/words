{
    "word_family": [
        "grade",
        "gradient",
        "gradual",
        "upgrade",
        "degrade",
        "gradation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79e32f1a-8047-31fd-a336-17b20a9c8b4e",
                    "sense_definition": "To lower the status, rank, or level of importance of something or someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The financial analyst decided to <w>downgrade</w> the company's stock from a buy to a sell rating.",
                            "target_lang_translations": {
                                "ru": "Финансовый аналитик решил <w>понизить</w> рейтинг акций компании с «покупать» до «продавать»."
                            }
                        },
                        {
                            "text": "After the restructuring, the management had to <w>downgrade</w> several positions to save on operational costs.",
                            "target_lang_translations": {
                                "ru": "После реструктуризации руководству пришлось <w>понизить</w> несколько должностей, чтобы сэкономить на операционных расходах."
                            }
                        }
                    ],
                    "synonyms": [
                        "demote",
                        "reduce"
                    ],
                    "antonyms": [
                        "upgrade",
                        "promote"
                    ],
                    "common_phrases": [
                        "downgrade a rating",
                        "downgrade a position"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понизить статус, ранг или уровень значимости чего-либо или кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понижать",
                                "target_lang_sense_clarification": "в должности или рейтинге"
                            },
                            {
                                "target_lang_word": "понизить",
                                "target_lang_sense_clarification": "в должности или рейтинге"
                            },
                            {
                                "target_lang_word": "разжаловать",
                                "target_lang_sense_clarification": "в звании или должности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4db94083-33a6-3676-906c-6484da6da2e4",
                    "sense_definition": "To replace a current version of software or hardware with an older or less advanced one.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new update was so buggy that I had to <w>downgrade</w> to the previous version.",
                            "target_lang_translations": {
                                "ru": "Новое обновление было настолько забагованным, что мне пришлось <w>откатиться</w> до предыдущей версии."
                            }
                        },
                        {
                            "text": "If you <w>downgrade</w> software, you might lose some of the newer features you were using.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>понизите версию</w> программного обеспечения, вы можете потерять некоторые из новых функций, которыми пользовались."
                            }
                        }
                    ],
                    "synonyms": [
                        "revert"
                    ],
                    "antonyms": [
                        "upgrade"
                    ],
                    "common_phrases": [
                        "downgrade software",
                        "downgrade to a version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменить текущую версию программного или аппаратного обеспечения на более старую или менее продвинутую."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откатывать",
                                "target_lang_sense_clarification": "версию ПО"
                            },
                            {
                                "target_lang_word": "откатить",
                                "target_lang_sense_clarification": "версию ПО"
                            },
                            {
                                "target_lang_word": "понизить версию",
                                "target_lang_sense_clarification": "программного обеспечения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bad4a4c-f384-32ab-8e09-f9e3cb579986",
                    "sense_definition": "To officially reduce the estimated intensity or category of a storm or weather event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meteorologists expect the hurricane to <w>downgrade</w> to a tropical storm before it reaches the coast.",
                            "target_lang_translations": {
                                "ru": "Метеорологи ожидают, что ураган <w>ослабнет</w> до тропического шторма, прежде чем достигнет побережья."
                            }
                        },
                        {
                            "text": "The authorities decided to <w>downgrade</w> the storm warning as the winds began to die down.",
                            "target_lang_translations": {
                                "ru": "Власти решили <w>понизить</w> уровень штормового предупреждения, когда ветер начал стихать."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduce"
                    ],
                    "antonyms": [
                        "upgrade"
                    ],
                    "common_phrases": [
                        "downgrade a storm",
                        "downgrade a warning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально снизить расчетную интенсивность или категорию шторма или погодного явления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понижать",
                                "target_lang_sense_clarification": "категорию опасности"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "о шторме или урагане"
                            },
                            {
                                "target_lang_word": "снижать",
                                "target_lang_sense_clarification": "уровень угрозы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bae3e65-6a35-333f-ab5f-a4ec3510cdea",
                    "sense_definition": "To speak of someone or something in a way that reduces their value or importance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disparagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unfair to <w>downgrade</w> his achievements just because you do not like his personality.",
                            "target_lang_translations": {
                                "ru": "Несправедливо <w>преуменьшать</w> его достижения только потому, что вам не нравится его характер."
                            }
                        },
                        {
                            "text": "She felt that her colleagues were trying to <w>downgrade</w> her contributions to the project.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что коллеги пытаются <w>умалить</w> её вклад в проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "defame",
                        "degrade"
                    ],
                    "antonyms": [
                        "praise",
                        "extol"
                    ],
                    "common_phrases": [
                        "downgrade achievements",
                        "downgrade contributions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить о ком-то или о чем-то таким образом, чтобы уменьшить их ценность или важность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преуменьшать",
                                "target_lang_sense_clarification": "значимость или заслуги"
                            },
                            {
                                "target_lang_word": "недооценивать",
                                "target_lang_sense_clarification": "важность"
                            },
                            {
                                "target_lang_word": "умалять",
                                "target_lang_sense_clarification": "достоинства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daffcd9d-a0da-3cb8-a78c-61a1833ea911",
                    "sense_definition": "To simplify something to the point of removing complexity or nuance; to dumb down.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "simplification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director had to <w>downgrade</w> the plot to make the movie more accessible to a general audience.",
                            "target_lang_translations": {
                                "ru": "Режиссеру пришлось <w>упростить</w> сюжет, чтобы сделать фильм более доступным для широкой аудитории."
                            }
                        },
                        {
                            "text": "Critics argued that the new curriculum would <w>downgrade</w> the educational standards of the school.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что новая учебная программа <w>снизит</w> образовательные стандарты школы."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduce"
                    ],
                    "common_phrases": [
                        "downgrade the complexity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упростить что-либо до такой степени, что исчезает сложность или нюансы; упрощать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрощать",
                                "target_lang_sense_clarification": "делать примитивным"
                            },
                            {
                                "target_lang_word": "снижать",
                                "target_lang_sense_clarification": "стандарты или уровень сложности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "457c98f3-fff3-3a9f-9968-46a34815d0ee",
                    "sense_definition": "An official reduction in the rating or status of something, especially in finance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country's credit <w>downgrade</w> led to a significant increase in borrowing costs.",
                            "target_lang_translations": {
                                "ru": "Кредитное <w>понижение</w> страны привело к значительному росту стоимости заимствований."
                            }
                        },
                        {
                            "text": "Investors were worried after the sudden <w>downgrade</w> of the tech giant's stock.",
                            "target_lang_translations": {
                                "ru": "Инвесторы были обеспокоены после внезапного <w>понижения</w> рейтинга акций технологического гиганта."
                            }
                        }
                    ],
                    "antonyms": [
                        "upgrade"
                    ],
                    "common_phrases": [
                        "credit downgrade",
                        "rating downgrade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное снижение рейтинга или статуса чего-либо, особенно в финансах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понижение",
                                "target_lang_sense_clarification": "рейтинга или статуса"
                            },
                            {
                                "target_lang_word": "снижение",
                                "target_lang_sense_clarification": "кредитного рейтинга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34d14613-b457-3d27-9e98-03aa9f79823b",
                    "sense_definition": "A loss of quality or a movement toward a worse or inferior state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moving from a house to a small apartment felt like a major <w>downgrade</w> for the family.",
                            "target_lang_translations": {
                                "ru": "Переезд из дома в маленькую квартиру показался семье серьезным <w>ухудшением</w> условий."
                            }
                        },
                        {
                            "text": "The change in ingredients resulted in a noticeable <w>downgrade</w> in the quality of the food.",
                            "target_lang_translations": {
                                "ru": "Изменение ингредиентов привело к заметному <w>снижению</w> качества еды."
                            }
                        }
                    ],
                    "antonyms": [
                        "upgrade"
                    ],
                    "common_phrases": [
                        "quality downgrade",
                        "major downgrade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потеря качества или переход в худшее или низшее состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "качества или условий"
                            },
                            {
                                "target_lang_word": "понижение",
                                "target_lang_sense_clarification": "уровня или класса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c393387a-b9d9-3364-aaf7-61048d8538b6",
                    "sense_definition": "A section of a road or railway track that slopes downward.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Truck drivers must use low gears when navigating a steep <w>downgrade</w> to maintain control.",
                            "target_lang_translations": {
                                "ru": "Водители грузовиков должны использовать низкие передачи при движении на крутом <w>спуске</w>, чтобы сохранять контроль."
                            }
                        },
                        {
                            "text": "The train picked up speed as it moved along the long, continuous <w>downgrade</w> toward the coast.",
                            "target_lang_translations": {
                                "ru": "Поезд набирал скорость, двигаясь по длинному непрерывному <w>уклону</w> к побережью."
                            }
                        }
                    ],
                    "antonyms": [
                        "upgrade"
                    ],
                    "common_phrases": [
                        "steep downgrade",
                        "continuous downgrade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок дороги или железнодорожного пути, имеющий уклон вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "наклонный участок дороги"
                            },
                            {
                                "target_lang_word": "уклон",
                                "target_lang_sense_clarification": "вниз"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}