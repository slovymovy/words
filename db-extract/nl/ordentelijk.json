                ],
                "senses": [
                    {
                        "sense_id": "d7437d18-d833-3cff-8e3b-e5deae0d3cd5",
                        "entry_id": "4ade21f6-0c4b-352f-8b93-4f2e352c37e3",
                        "glosses": [
                            "volgens de regels en zonder problemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06929ce2-f161-464a-90e2-2bd37f2c4387",
                                "sense_id": "d7437d18-d833-3cff-8e3b-e5deae0d3cd5",
                                "text": "Schiphol heeft bijvoorbeeld 20 procent meer personeel aan het werk en speciale teams zorgen ervoor dat de passagiersstromen ordentelijk verlopen in deze tijd van topdrukte."
                            },
                            {
                                "example_id": "5cfafa99-2fb2-43f9-b3fe-115a202bbd57",
                                "sense_id": "d7437d18-d833-3cff-8e3b-e5deae0d3cd5",
                                "text": "In juni 2016 koos een kleine meerderheid, 51,9 procent van de Britten, voor een vertrek uit de Europese Unie. Een deal waarmee ordentelijk afscheid genomen kan worden van het Verenigd Koninkrijk als EU-land is er nog altijd niet."
                            },
                            {
                                "example_id": "078d4f44-f5de-4c4b-98ee-a1892f0512f7",
                                "sense_id": "d7437d18-d833-3cff-8e3b-e5deae0d3cd5",
                                "text": "Hoekstra tempert echter de verwachtingen. ,,Ik wil dit graag snel gaan regelen, maar ik ben ook voor een ordentelijk proces”, schrijft hij. Een en ander zal afgestemd moeten worden met de uitgeefsector en de minister van Onderwijs, die over media gaat. Als de wetgeving klaar is, heeft de Belastingdienst minstens drie maanden nodig om de aanpassingen door te voeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c3b23d3-9b48-47d1-a523-fdab62f071ee",
                        "source_entry_id": "4ade21f6-0c4b-352f-8b93-4f2e352c37e3",
                        "source_sense_id": "d7437d18-d833-3cff-8e3b-e5deae0d3cd5",
                        "target_lang_word": "decently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6ee242-224d-3f5e-bf49-38f258137eb5",
                                        "entry_id": "c5e90c55-7215-35e5-a95f-3f11b7fe4388",
                                        "glosses": [
                                            "In a decent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5dcfd3-59ff-45e0-83ba-69f34576e72d",
                                                "sense_id": "6f6ee242-224d-3f5e-bf49-38f258137eb5",
                                                "text": "You need to be decently attired to enter the restaurant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193e4bc4-34d9-31a4-8a55-f7a079fc0ebf",
                                        "entry_id": "c5e90c55-7215-35e5-a95f-3f11b7fe4388",
                                        "glosses": [
                                            "To a reasonable or acceptable degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ddac229-9933-45a0-96a0-67b9a7c7ff3d",
                                                "sense_id": "193e4bc4-34d9-31a4-8a55-f7a079fc0ebf",
                                                "text": "a decently high salary"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89447849-56d3-4815-8646-bc9c06c85ae9",
                        "source_entry_id": "4ade21f6-0c4b-352f-8b93-4f2e352c37e3",
                        "source_sense_id": "d7437d18-d833-3cff-8e3b-e5deae0d3cd5",
                        "target_lang_word": "decent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97b8b1e8-5c3f-3de0-ad32-766195579887",
                                        "entry_id": "b7d2c124-40ff-30dd-9889-8d76fef770e4",
                                        "glosses": [
                                            "Appropriate; suitable for the circumstances."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2816b314-9a08-35de-bb98-05c1576f1596",
                                        "entry_id": "b7d2c124-40ff-30dd-9889-8d76fef770e4",
                                        "glosses": [
                                            "Having a suitable conformity to basic moral standards; showing integrity, fairness, or other characteristics associated with moral uprightness."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2fef27f-89c2-3c11-bda5-f9e4d0f5efc7",
                                        "entry_id": "b7d2c124-40ff-30dd-9889-8d76fef770e4",
                                        "glosses": [
                                            "Sufficiently clothed or dressed to be seen."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "652b6138-4c32-49a2-85d4-fa06ee696739",
                                                "sense_id": "a2fef27f-89c2-3c11-bda5-f9e4d0f5efc7",
                                                "text": "Are you decent? May I come in?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "516d0d62-5e7d-3594-9064-d1d15920bfef",
                                        "entry_id": "b7d2c124-40ff-30dd-9889-8d76fef770e4",
                                        "glosses": [
                                            "Fair; acceptable; okay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61a203e-f659-4c30-a53d-90c16f82f30b",
                                                "sense_id": "516d0d62-5e7d-3594-9064-d1d15920bfef",
                                                "text": "He's a decent saxophonist, but probably not good enough to make a career of it."
                                            },
                                            {
                                                "example_id": "60be87d8-780f-46bf-ac89-0cb8c10f8137",
                                                "sense_id": "516d0d62-5e7d-3594-9064-d1d15920bfef",
                                                "text": "A canister of flour from the kitchen had been thrown at the looking-glass and lay like trampled snow over the remains of a decent blue suit with the lining ripped out which lay on top of the ruin of a plastic wardrobe."
                                            },
                                            {
                                                "example_id": "188953de-a860-473f-862f-921ce78c200a",
                                                "sense_id": "516d0d62-5e7d-3594-9064-d1d15920bfef",
                                                "text": "And ‘blubbing’ . . . Blubbing went out with ‘decent’ and ‘ripping’. Mind you, not a bad new language to start up. 1920s schoolboy slang could be due for a revival."
                                            },
                                            {
                                                "example_id": "103d9d62-9194-4642-874a-190be3a129f5",
                                                "sense_id": "516d0d62-5e7d-3594-9064-d1d15920bfef",
                                                "text": "I'm all for opening new stations (Transport Scotland is planning another at East Linton, about halfway between Drem and Dunbar), but they are useless without a decent service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88a85cc-4168-3f9e-bc20-7c8f43f905c0",
                                        "entry_id": "b7d2c124-40ff-30dd-9889-8d76fef770e4",
                                        "glosses": [
                                            "Significant; substantial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19db1a36-9022-4fbb-b429-900da29f9f77",
                                                "sense_id": "a88a85cc-4168-3f9e-bc20-7c8f43f905c0",
                                                "text": "There are a decent number of references out there, if you can find them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7079fd2e-5df7-35e1-9860-0b0db7bfd0fc",
                                        "entry_id": "b7d2c124-40ff-30dd-9889-8d76fef770e4",
                                        "glosses": [
                                            "Conforming to perceived standards of good taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d7b40a-0030-4a66-a7e7-4ca2001e05d2",
                                                "sense_id": "7079fd2e-5df7-35e1-9860-0b0db7bfd0fc",
                                                "text": "I had a cup of tea - the last decent cup of tea for many days; and in a room that most soothingly looked just as you would expect a lady’s drawing-room to look, we had a long quiet chat by the fireside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb79135-e886-30b6-a800-7be3b4f2832f",
                                        "entry_id": "b7d2c124-40ff-30dd-9889-8d76fef770e4",
                                        "glosses": [
                                            "Comely; shapely; well-formed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e8b27da-0663-43e4-8dc6-ea17e0c728f8",
                                                "sense_id": "deb79135-e886-30b6-a800-7be3b4f2832f",
                                                "text": "And ſable ſtole of Cipres Lawn,\nOver thy decent ſhoulders drawn."
                                            }
                                        ]
                                    }
                                ]
                            },
