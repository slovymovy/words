                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viskose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70103e90-354e-3dd6-9c84-20410f4df232",
                                        "entry_id": "26cb7f09-26f7-3256-9ca3-099fee736e81",
                                        "glosses": [
                                            "matt glänzende, seidenartige Kunstfaser aus Zellstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32cfbf8-2a3f-457a-a19a-4df6da580399",
                                                "sense_id": "70103e90-354e-3dd6-9c84-20410f4df232",
                                                "text": "Das Spannbetttuch besteht aus 50% Baumwolle und 50% Viskose."
                                            },
                                            {
                                                "example_id": "282ff300-2115-4fde-be59-0f15211c905f",
                                                "sense_id": "70103e90-354e-3dd6-9c84-20410f4df232",
                                                "text": "„Mamas Ankleidekammer war voll von solchen Ausgehkleidungsstücken, dünnen Kleidern und Seidenblusen, Wickelkleidern aus Viskose, selbst für ein Essen im Søilen, Mos Nobelrestaurant, kamen sie mir zu fein vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f13e95c4-39ce-4ab0-b05a-4358c92fd4af",
                        "source_entry_id": "262b21bf-e9b4-39f3-91d4-5e319c5c8f58",
