                ],
                "senses": [
                    {
                        "sense_id": "8e8ceb35-face-3013-8d25-d3255600961a",
                        "entry_id": "6687418f-26c0-3477-9fe0-219e830aa87e",
                        "glosses": [
                            "Gespräch, an dem nur zwei Personen beteiligt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d761ef0-1eee-4cc0-9b08-b5dc35ca8667",
                                "sense_id": "8e8ceb35-face-3013-8d25-d3255600961a",
                                "text": "„EU-Außenkommissarin Federica Mogherini, die mit Kurz sehr gut ist, wollte die neue Kollegin dort partout nicht zum Vieraugengespräch treffen.“"
                            },
                            {
                                "example_id": "99578e3b-a1d4-4ba3-aef2-00a3a26b753d",
                                "sense_id": "8e8ceb35-face-3013-8d25-d3255600961a",
                                "text": "Sie konnten ihre Differenzen in einem Vieraugengespräch überwinden."
                            },
                            {
                                "example_id": "2cde484f-7210-4c08-b9ed-5ded464763a6",
                                "sense_id": "8e8ceb35-face-3013-8d25-d3255600961a",
                                "text": "„Äusserungen Trumps bei einem Vieraugengespräch im Februar hatte der frühere FBI-Chef als Anweisung interpretiert, die Untersuchung gegen den früheren Sicherheitsberater Flynn einzustellen.“"
                            },
                            {
                                "example_id": "db4b8a97-5c3c-431b-a63f-41d4c62f2244",
                                "sense_id": "8e8ceb35-face-3013-8d25-d3255600961a",
                                "text": "„Zwischen einem Vieraugengespräch und einer Daumen-zu-Daumen-Unterhaltung wird es immer einen Unterschied geben, der uns stört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
