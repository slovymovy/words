{
    "word_family": [
        "magic",
        "magical",
        "magician",
        "magus"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "917b8804-f331-3d56-91ba-6997c1491c6c",
                    "sense_definition": "A magician, wizard, sorcerer, or practitioner of supernatural magic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "magic_practitioner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The powerful <w>mage</w> cast a protective spell over the entire village.",
                            "target_lang_translations": {
                                "tr": "Güçlü <w>büyücü</w> tüm köyün üzerine koruyucu bir büyü yaptı."
                            }
                        },
                        {
                            "text": "In many fantasy novels, a young <w>mage</w> must learn to control their magical abilities.",
                            "target_lang_translations": {
                                "tr": "Pek çok fantastik romanda, genç bir <w>büyücü</w> sihirli yeteneklerini kontrol etmeyi öğrenmelidir."
                            }
                        }
                    ],
                    "synonyms": [
                        "magus",
                        "magic user",
                        "spellcaster",
                        "enchanter",
                        "conjurer",
                        "thaumaturge",
                        "theurgist"
                    ],
                    "common_phrases": [
                        "powerful mage",
                        "young mage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in fantasy literature and gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Doğaüstü büyü yapan kimse; büyücü, sihirbaz veya efsuncu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "büyücü",
                                "target_lang_sense_clarification": "büyü yapan kimse"
                            },
                            {
                                "target_lang_word": "sihirbaz",
                                "target_lang_sense_clarification": "büyücü, illüzyonist"
                            },
                            {
                                "target_lang_word": "efsuncu",
                                "target_lang_sense_clarification": "büyü ve efsun yapan kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e2d7926-29bb-3e10-8c4f-e7dad8306a98",
                    "sense_definition": "A Zoroastrian priest; a synonym of <w>magus</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient Persian <w>mage</w> performed sacred rituals in honor of the deity.",
                            "target_lang_translations": {
                                "tr": "Antik Pers <w>rahibi</w> tanrının onuruna kutsal ritüeller gerçekleştirdi."
                            }
                        },
                        {
                            "text": "Historical texts describe a Persian <w>mage</w> who traveled far to share his wisdom.",
                            "target_lang_translations": {
                                "tr": "Tarihi metinler, bilgeliğini paylaşmak için uzaklara seyahat eden bir Pers <w>rahibini</w> tasvir eder."
                            }
                        }
                    ],
                    "synonyms": [
                        "magus"
                    ],
                    "common_phrases": [
                        "Persian mage"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or classical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Zerdüştlük dinine mensup rahip; mecusi rahibi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "mecusi rahibi",
                                "target_lang_sense_clarification": "Zerdüşt rahibi"
                            },
                            {
                                "target_lang_word": "rahip",
                                "target_lang_sense_clarification": "Zerdüştlük dinindeki din adamı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}