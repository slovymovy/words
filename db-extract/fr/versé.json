                    }
                ],
                "senses": [
                    {
                        "sense_id": "39316fa6-ff1b-35b6-813a-db382a749cc8",
                        "entry_id": "7ca41942-2c7b-31d1-b88d-9a1d626062ae",
                        "glosses": [
                            "Qui est expérimenté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4603ad4f-c9de-490d-96c2-0035dd8ee5e5",
                                "sense_id": "39316fa6-ff1b-35b6-813a-db382a749cc8",
                                "text": "– Ces trucs-là, moi, tu sais, je ne suis pas très versée…"
                            },
                            {
                                "example_id": "0b47e5bb-c1cf-4576-a07c-db8663d4a117",
                                "sense_id": "39316fa6-ff1b-35b6-813a-db382a749cc8",
                                "text": "Les politiciens allemands, qu’ils soient de droite ou de gauche, ne sont pas versés dans l’art de perdre."
                            },
                            {
                                "example_id": "add6420b-1405-4366-aa83-cb71bf9e0dfb",
                                "sense_id": "39316fa6-ff1b-35b6-813a-db382a749cc8",
                                "text": "C’est un homme versé dans les affaires de finance, dans les négociations."
                            },
                            {
                                "example_id": "e3380645-63d9-4c26-9822-0e458f42464f",
                                "sense_id": "39316fa6-ff1b-35b6-813a-db382a749cc8",
                                "text": "Être versé dans la philosophie, dans les mathématiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "25021a3d-e315-36c7-aa04-3fef382d1763",
                        "entry_id": "7ca41942-2c7b-31d1-b88d-9a1d626062ae",
                        "glosses": [
                            "Se dit d’une pièce, d’un meuble représenté à l’envers (tête en bas). Synonyme de renversé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23071fde-d9a4-4b36-a4f4-d145c275dacf",
                                "sense_id": "25021a3d-e315-36c7-aa04-3fef382d1763",
                                "text": "De sinople au chevron versé abaissé d’or accompagné d’un croissant du même en chef, qui est de Vétrigne → voir illustration « chevron versé »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f738f95-ef0d-4d5c-8e72-d5bf539923e8",
                        "source_entry_id": "7ca41942-2c7b-31d1-b88d-9a1d626062ae",
                        "target_lang_word": "versed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33a2d071-de82-306a-a1ce-4315bac658a8",
                                        "entry_id": "eece3077-16a7-33f3-a24d-55b4aafb31ea",
                                        "glosses": [
                                            "Knowledgeable or skilled, either through study or experience; familiar; practiced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2e532c-e5cc-4582-9125-d0f02b378991",
                                                "sense_id": "33a2d071-de82-306a-a1ce-4315bac658a8",
                                                "text": "deep versed in books and shallow in himself"
                                            },
                                            {
                                                "example_id": "20aca7e5-e77b-40f1-93e7-7dc8081a96ed",
                                                "sense_id": "33a2d071-de82-306a-a1ce-4315bac658a8",
                                                "text": "opinions […] derived from studying the Scriptures, wherein he was versed beyond any person of his age"
                                            },
                                            {
                                                "example_id": "27ae56a6-a0c5-43b4-96b9-13675a176ebe",
                                                "sense_id": "33a2d071-de82-306a-a1ce-4315bac658a8",
                                                "text": "These men were versed in the details of business."
                                            },
                                            {
                                                "example_id": "8167aa3b-f4ad-4f6a-b950-11e8f9cc962f",
                                                "sense_id": "33a2d071-de82-306a-a1ce-4315bac658a8",
                                                "text": "I mean no disrespect for such knowledge, if anyone really is versed in it – I do not want any more lawsuits brought against me by Meletus – but the fact is, gentlemen, that I take no interest in it."
                                            }
                                        ]
                                    }
                                ]
                            },
