{
    "word_family": [
        "dodge",
        "dodger",
        "dodginess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3785acd8-252e-36a9-8e6f-2ec635095c56",
                    "sense_definition": "Dishonest, illegal, or suspicious in nature.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are investigating a <w>dodgy</w> politician who was seen taking money from a local businessman.",
                            "target_lang_translations": {
                                "ru": "Полиция ведет расследование в отношении <w>коррумпированного</w> политика, которого видели берущим деньги у местного бизнесмена.",
                                "zh": "警方正在调查一名<w>可疑的</w>政客，有人看到他收受当地商人的钱财。"
                            }
                        },
                        {
                            "text": "I am sure you would not want to be seen buying <w>dodgy</w> gear from a street vendor.",
                            "target_lang_translations": {
                                "ru": "Я уверен, ты бы не хотел, чтобы тебя видели покупающим <w>сомнительные</w> вещи у уличного торговца.",
                                "zh": "我肯定你不想被人看到从街头小贩那里买<w>不正当的</w>商品。"
                            }
                        }
                    ],
                    "antonyms": [
                        "honest",
                        "legal",
                        "trustworthy"
                    ],
                    "common_phrases": [
                        "dodgy deal",
                        "dodgy character"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British and Australian English to describe suspicious activity."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный, незаконный или подозрительный по своему характеру.",
                        "zh": "指性质上不诚实、非法或可疑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий недоверие"
                            },
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "внушающий сомнения в честности"
                            },
                            {
                                "target_lang_word": "нечестный",
                                "target_lang_sense_clarification": "связанный с обманом"
                            },
                            {
                                "target_lang_word": "левый",
                                "target_lang_sense_clarification": "сленг: незаконный или неофициальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可疑的",
                                "target_lang_sense_clarification": "引起怀疑的"
                            },
                            {
                                "target_lang_word": "不正当的",
                                "target_lang_sense_clarification": "不合法的或不诚实的"
                            },
                            {
                                "target_lang_word": "不诚实的",
                                "target_lang_sense_clarification": "欺诈性的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c99b127-e7ea-39cc-ad0f-c7f4a0e508bf",
                    "sense_definition": "Unreliable, unstable, or likely to break or fail.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unreliability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dodgy</w> old machine kept breaking down every time we tried to start it.",
                            "target_lang_translations": {
                                "ru": "Эта <w>барахлящая</w> старая машина ломалась каждый раз, когда мы пытались её завести.",
                                "zh": "那台<w>不可靠的</w>旧机器每次我们试图启动时都会坏掉。"
                            }
                        },
                        {
                            "text": "You should never listen to <w>dodgy</w> advice from people who do not have any experience.",
                            "target_lang_translations": {
                                "ru": "Никогда не стоит слушать <w>сомнительные</w> советы от людей, у которых нет никакого опыта.",
                                "zh": "你永远不该听取那些毫无经验之人给出的<w>不靠谱的</w>建议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shaky",
                        "flaky",
                        "unreliable",
                        "untrustworthy"
                    ],
                    "antonyms": [
                        "reliable",
                        "stable",
                        "solid"
                    ],
                    "common_phrases": [
                        "dodgy connection",
                        "dodgy engine"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal way to describe physical objects or information that cannot be trusted."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ненадежный, нестабильный или имеющий высокую вероятность поломки или сбоя.",
                        "zh": "指不可靠、不稳定，或容易损坏、出故障的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненадежный",
                                "target_lang_sense_clarification": "может подвести или сломаться"
                            },
                            {
                                "target_lang_word": "барахлящий",
                                "target_lang_sense_clarification": "о технике, работающей со сбоями"
                            },
                            {
                                "target_lang_word": "шаткий",
                                "target_lang_sense_clarification": "неустойчивый или неосновательный"
                            },
                            {
                                "target_lang_word": "непрочный",
                                "target_lang_sense_clarification": "легко ломающийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可靠的",
                                "target_lang_sense_clarification": "无法信任的"
                            },
                            {
                                "target_lang_word": "不稳定的",
                                "target_lang_sense_clarification": "容易出问题的"
                            },
                            {
                                "target_lang_word": "质量差的",
                                "target_lang_sense_clarification": "容易损坏的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a87c5b51-9e48-3778-8cb5-847a597ef725",
                    "sense_definition": "Involving a high level of risk or danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is a slightly <w>dodgy</w> plan because there is a lot that could go wrong during the execution.",
                            "target_lang_translations": {
                                "ru": "Это слегка <w>рискованный</w> план, потому что в процессе реализации многое может пойти не так.",
                                "zh": "这个计划有点<w>冒险</w>，因为在执行过程中有很多可能会出错的地方。"
                            }
                        },
                        {
                            "text": "Walking through that part of the city alone at night can be a bit <w>dodgy</w> for tourists.",
                            "target_lang_translations": {
                                "ru": "Прогулки в одиночку по этой части города ночью могут быть немного <w>опасными</w> для туристов.",
                                "zh": "晚上独自走在城市的那片区域对游客来说可能有点<w>危险</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chancy",
                        "risky"
                    ],
                    "antonyms": [
                        "safe",
                        "secure"
                    ],
                    "common_phrases": [
                        "dodgy area",
                        "dodgy situation"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe situations that feel unsafe or uncertain."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с высоким уровнем риска или опасности.",
                        "zh": "指涉及高风险或危险的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рискованный",
                                "target_lang_sense_clarification": "содержащий риск"
                            },
                            {
                                "target_lang_word": "опасный",
                                "target_lang_sense_clarification": "представляющий угрозу"
                            },
                            {
                                "target_lang_word": "стремный",
                                "target_lang_sense_clarification": "сленг: вызывающий опасение или страх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有风险的",
                                "target_lang_sense_clarification": "存在潜在危险的"
                            },
                            {
                                "target_lang_word": "危险的",
                                "target_lang_sense_clarification": "可能造成伤害的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aff3ee10-9808-3590-8123-b56a1b6160a4",
                    "sense_definition": "Evasive and shifty, often avoiding a direct answer or responsibility.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked about the missing funds, the spokesman gave a <w>dodgy</w> answer about legal ramifications.",
                            "target_lang_translations": {
                                "ru": "Когда его спросили о пропавших средствах, представитель дал <w>уклончивый</w> ответ о юридических последствиях.",
                                "zh": "当被问及失踪的资金时，发言人就法律后果给出了一个<w>闪烁其词的</w>回答。"
                            }
                        },
                        {
                            "text": "He has a <w>dodgy</w> way of looking at you that makes you feel he is hiding something.",
                            "target_lang_translations": {
                                "ru": "У него какой-то <w>подозрительный</w> взгляд, из-за которого кажется, что он что-то скрывает.",
                                "zh": "他看你的眼神很<w>古怪</w>，让你觉得他隐瞒了什么。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dodge"
                    ],
                    "antonyms": [
                        "direct",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "dodgy answer",
                        "dodgy look"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Describes a person's behavior or mannerisms."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уклончивый и неискренний, часто избегающий прямого ответа или ответственности.",
                        "zh": "指闪烁其词、不诚实，常试图回避直接回答或责任的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклончивый",
                                "target_lang_sense_clarification": "избегающий прямоты"
                            },
                            {
                                "target_lang_word": "изворотливый",
                                "target_lang_sense_clarification": "хитрый, умеющий выкручиваться"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "сленг: неясный, подозрительный в поведении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪烁其词的",
                                "target_lang_sense_clarification": "回避直接回答的"
                            },
                            {
                                "target_lang_word": "狡猾的",
                                "target_lang_sense_clarification": "不诚实且难以捉摸的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af092296-eacb-35bf-a830-d886bc4f8056",
                    "sense_definition": "Feeling unwell, uncomfortable, or slightly ill.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am feeling <w>dodgy</w> today, so I think I might be coming down with the flu.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя <w>неважно</w> сегодня, кажется, я заболеваю гриппом.",
                                "zh": "我今天感觉<w>不舒服</w>，我想我可能是要感冒了。"
                            }
                        },
                        {
                            "text": "Eating that old seafood made my stomach feel a bit <w>dodgy</w> for the rest of the evening.",
                            "target_lang_translations": {
                                "ru": "Из-за тех несвежих морепродуктов мой желудок чувствовал себя <w>не лучшим образом</w> весь оставшийся вечер.",
                                "zh": "吃了那些不新鲜的海鲜后，我整个晚上胃都感觉<w>不适</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "healthy",
                        "well"
                    ],
                    "common_phrases": [
                        "feel dodgy",
                        "dodgy stomach"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English to describe feeling sick."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий недомогание, дискомфорт или легкую тошноту.",
                        "zh": "指感到身体不适、不舒服或轻微生病的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неважный",
                                "target_lang_sense_clarification": "о плохом самочувствии"
                            },
                            {
                                "target_lang_word": "несвежий",
                                "target_lang_sense_clarification": "о состоянии желудка или самочувствии"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "о еде или состоянии, внушающем опасение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不舒服的",
                                "target_lang_sense_clarification": "身体感觉欠佳的"
                            },
                            {
                                "target_lang_word": "不适的",
                                "target_lang_sense_clarification": "感到轻微生病的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20288f0d-7b14-3db3-9e30-8337674ad2fb",
                    "sense_definition": "Socially unacceptable, deviant, or weird in a creepy way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors complained about the <w>dodgy</w> man who was always hanging around the playground.",
                            "target_lang_translations": {
                                "ru": "Соседи жаловались на <w>подозрительного</w> типа, который постоянно ошивался возле детской площадки.",
                                "zh": "邻居们抱怨那个总是徘徊在操场附近的<w>可疑</w>男子。"
                            }
                        },
                        {
                            "text": "He has some <w>dodgy</w> habits that make his colleagues feel very uncomfortable in the office.",
                            "target_lang_translations": {
                                "ru": "У него есть кое-какие <w>странные</w> привычки, из-за которых коллеги чувствуют себя в офисе очень неуютно.",
                                "zh": "他有一些<w>怪异的</w>习惯，让同事们在办公室里感到非常不自在。"
                            }
                        }
                    ],
                    "antonyms": [
                        "normal",
                        "conventional"
                    ],
                    "common_phrases": [
                        "dodgy habit",
                        "dodgy guy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe creepy or socially deviant behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Социально неприемлемый, странный или пугающий в неприятном смысле.",
                        "zh": "指社会上不可接受的、反常的，或令人感到毛骨悚然的怪异。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "странный",
                                "target_lang_sense_clarification": "необычный в плохом смысле"
                            },
                            {
                                "target_lang_word": "стремный",
                                "target_lang_sense_clarification": "сленг: пугающий или неприятный"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий опасения своим поведением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怪异的",
                                "target_lang_sense_clarification": "令人不舒服的异常行为"
                            },
                            {
                                "target_lang_word": "可疑的",
                                "target_lang_sense_clarification": "行为举止令人不安的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}