                ],
                "senses": [
                    {
                        "sense_id": "ae7363e2-df09-3bc6-8eff-5ef93df2204f",
                        "entry_id": "15c48677-ae9c-3b0f-8251-77f863a1452f",
                        "glosses": [
                            "Zug, der der medizinischen Versorgung und dem Transport vor allem von Soldaten/Soldatinnen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3327b109-b4cb-41a0-9aaa-e5e7a963dbe6",
                                "sense_id": "ae7363e2-df09-3bc6-8eff-5ef93df2204f",
                                "text": "„Die sogenannten Lazarettzüge, die im Ersten Weltkrieg dem Transport Verwundeter und Kranker aus dem Einsatz- beziehungsweise Kriegsgebiet dienten, konnten auch größere Strecken überbrücken und verfügten über Krankenbetten sowie zum Teil auch über Operationsräume und Apotheken.“"
                            },
                            {
                                "example_id": "59d2e64f-7d27-4e86-94b4-edf5acd92374",
                                "sense_id": "ae7363e2-df09-3bc6-8eff-5ef93df2204f",
                                "text": "„Auf einer Bahnstation, an der wir halten, steht im Nebengeleis ein Lazarettzug.“"
                            },
                            {
                                "example_id": "805041ec-5d30-4617-b987-510bc2215341",
                                "sense_id": "ae7363e2-df09-3bc6-8eff-5ef93df2204f",
                                "text": "„Auf dem Bahnhof stand ein leerer Lazarettzug.“"
                            },
                            {
                                "example_id": "e083e655-1fcf-4b0d-822d-10e0e3b4f9dc",
                                "sense_id": "ae7363e2-df09-3bc6-8eff-5ef93df2204f",
                                "text": "„Die Somme-Offensive war im Gang, die Lazarette in der Etappe wurden geleert, und Schlump rollte mit dem Lazarettzug in die Heimat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
