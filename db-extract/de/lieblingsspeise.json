                                "sense_id": "f328e4ac-ba9f-361d-8dd8-c7cb1aa6b5e2",
                                "text": "„Eiernockerl mit Salat soll die Lieblingsspeise von Adolf Hitler gewesen sein.“"
                            },
                            {
                                "example_id": "9dff311d-478b-44ee-9c06-21ea26b37c46",
                                "sense_id": "f328e4ac-ba9f-361d-8dd8-c7cb1aa6b5e2",
                                "text": "„Seine Lieblingsspeisen waren Kabeljau, dicke Erbsen, Teltower Rübchen, Göttinger Wurst und Kaviar, den ihm sein Verleger Hartknoch aus Riga schickte.“"
                            }
                        ],
