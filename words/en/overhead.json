{
    "word_family": [
        "head"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "07041cdc-9cb6-3b6d-a7d0-6e79baf3a24a",
                    "sense_definition": "In a position above one's head or in the sky.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A flock of birds flew <w>overhead</w> as we walked through the park.",
                            "target_lang_translations": {
                                "ru": "Стая птиц пролетела <w>над головой</w>, пока мы гуляли по парку.",
                                "zh": "当我们穿过公园时，一群鸟从我们<w>头顶</w>飞过。"
                            }
                        },
                        {
                            "text": "The sun was directly <w>overhead</w> at noon, making it very hot.",
                            "target_lang_translations": {
                                "ru": "В полдень солнце было прямо <w>над головой</w>, поэтому было очень жарко.",
                                "zh": "正午时分太阳直射<w>头顶</w>，天气非常炎热。"
                            }
                        }
                    ],
                    "synonyms": [
                        "above",
                        "up"
                    ],
                    "antonyms": [
                        "below",
                        "underfoot"
                    ],
                    "common_phrases": [
                        "fly overhead",
                        "directly overhead",
                        "circle overhead"
                    ],
                    "target_lang_definitions": {
                        "ru": "В положении над головой или в небе.",
                        "zh": "在头顶上方或天空中的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "над головой",
                                "target_lang_sense_clarification": "находящийся выше уровня глаз"
                            },
                            {
                                "target_lang_word": "наверху",
                                "target_lang_sense_clarification": "в верхней части пространства или в небе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头顶上方",
                                "target_lang_sense_clarification": "位于视线或身体上方"
                            },
                            {
                                "target_lang_word": "在空中",
                                "target_lang_sense_clarification": "指在天空或高处"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8ff95b24-f01d-3263-be80-6ca180525c5f",
                    "sense_definition": "Located or functioning above the level of the head.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please place your larger bags in the <w>overhead</w> compartment.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положите большие сумки на <w>верхнюю</w> полку.",
                                "zh": "请将大件行李放入<w>上方</w>行李架。"
                            }
                        },
                        {
                            "text": "The <w>overhead</w> lights flickered for a moment before going out completely.",
                            "target_lang_translations": {
                                "ru": "<w>Потолочное</w> освещение на мгновение замерцало, прежде чем полностью погаснуть.",
                                "zh": "<w>头顶</w>的灯闪烁了几下，然后彻底熄灭了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "upper",
                        "raised",
                        "suspended",
                        "above"
                    ],
                    "antonyms": [
                        "floor-level",
                        "ground"
                    ],
                    "common_phrases": [
                        "overhead compartment",
                        "overhead bin",
                        "overhead wires",
                        "overhead lighting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный или работающий выше уровня головы.",
                        "zh": "位于或运行在头部上方位置的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верхний",
                                "target_lang_sense_clarification": "расположенный в верхней части"
                            },
                            {
                                "target_lang_word": "потолочный",
                                "target_lang_sense_clarification": "прикрепленный к потолку"
                            },
                            {
                                "target_lang_word": "подвесной",
                                "target_lang_sense_clarification": "висящий сверху"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头顶上的",
                                "target_lang_sense_clarification": "位置在上方"
                            },
                            {
                                "target_lang_word": "顶部的",
                                "target_lang_sense_clarification": "位于高处或天花板处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8c634e6-a570-3109-8d60-fdcc7be2115e",
                    "sense_definition": "Performed with a motion above the head, particularly in sports.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker scored a goal with a spectacular <w>overhead</w> kick.",
                            "target_lang_translations": {
                                "ru": "Нападающий забил гол эффектным ударом <w>через себя</w>.",
                                "zh": "前锋用一记精彩的<w>倒钩</w>射门得分。"
                            }
                        },
                        {
                            "text": "She has a powerful <w>overhead</w> smash that is hard to return.",
                            "target_lang_translations": {
                                "ru": "У нее мощный удар <w>над головой</w>, который трудно отбить.",
                                "zh": "她有一记强力的<w>头顶扣杀</w>，很难回击。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "overhead kick",
                        "overhead smash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполняемый движением над головой, особенно в спорте.",
                        "zh": "通过头顶上方的动作完成的，尤指体育运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "над головой",
                                "target_lang_sense_clarification": "о движении руки или предмета"
                            },
                            {
                                "target_lang_word": "через себя",
                                "target_lang_sense_clarification": "в контексте удара в футболе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒钩",
                                "target_lang_sense_clarification": "足球中过顶的射门动作"
                            },
                            {
                                "target_lang_word": "头顶扣杀",
                                "target_lang_sense_clarification": "网球或羽毛球中过顶的击球"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64980351-38be-3495-b44e-015cbeb24ccb",
                    "sense_definition": "Regular costs required to run a business, such as rent and electricity, that are not directly related to producing goods or services.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_cost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is trying to reduce its <w>overhead</w> by moving to a smaller office.",
                            "target_lang_translations": {
                                "ru": "Компания пытается сократить свои <w>накладные расходы</w>, переезжая в меньший офис.",
                                "zh": "公司正试图通过搬到更小的办公室来降低<w>运营费用</w>。"
                            }
                        },
                        {
                            "text": "Small businesses often struggle with high <w>overhead</w> during economic downturns.",
                            "target_lang_translations": {
                                "ru": "Малый бизнес часто страдает от высоких <w>накладных расходов</w> во время экономических спадов.",
                                "zh": "小企业在经济低迷时期往往难以负担高昂的<w>间接成本</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "operating costs",
                        "fixed costs",
                        "expenses",
                        "running costs"
                    ],
                    "common_phrases": [
                        "reduce overhead",
                        "high overhead",
                        "low overhead",
                        "overhead costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянные расходы на ведение бизнеса, такие как аренда и электричество, не связанные напрямую с производством товаров или услуг.",
                        "zh": "经营企业所需的日常开支，如租金和电费，与生产商品或服务无直接关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладные расходы",
                                "target_lang_sense_clarification": "бухгалтерский термин"
                            },
                            {
                                "target_lang_word": "издержки",
                                "target_lang_sense_clarification": "общие затраты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间接成本",
                                "target_lang_sense_clarification": "会计术语"
                            },
                            {
                                "target_lang_word": "运营费用",
                                "target_lang_sense_clarification": "维持业务运行的开销"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70a2e456-be90-33e2-a53a-b16688172a77",
                    "sense_definition": "A storage compartment located above the seats in a passenger aircraft or train.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I struggled to lift my heavy suitcase into the <w>overhead</w>.",
                            "target_lang_translations": {
                                "ru": "Я с трудом поднял свой тяжелый чемодан на <w>верхнюю полку</w>.",
                                "zh": "我费了好大劲才把沉重的行李箱举到<w>行李架</w>上。"
                            }
                        },
                        {
                            "text": "There was no room left in the <w>overheads</w>, so I had to check my bag.",
                            "target_lang_translations": {
                                "ru": "На <w>верхних полках</w> не осталось места, поэтому мне пришлось сдать сумку в багаж.",
                                "zh": "<w>行李架</w>上已经没有空间了，所以我不得不办理托运。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bin",
                        "locker"
                    ],
                    "common_phrases": [
                        "in the overhead",
                        "stow in the overhead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсек для хранения вещей, расположенный над сиденьями в пассажирском самолете или поезде.",
                        "zh": "客机或火车上座位上方的行李存放处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верхняя полка",
                                "target_lang_sense_clarification": "место для багажа"
                            },
                            {
                                "target_lang_word": "багажная полка",
                                "target_lang_sense_clarification": "официальное название отсека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行李架",
                                "target_lang_sense_clarification": "交通工具上的储物空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad39d02c-d845-3887-9818-b493c4f7841c",
                    "sense_definition": "Extra computing resources, such as time or memory, required to manage a process rather than doing the actual work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_cost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security encryption adds significant <w>overhead</w> to the data transmission speed.",
                            "target_lang_translations": {
                                "ru": "Шифрование безопасности добавляет значительные <w>накладные расходы</w> к скорости передачи данных.",
                                "zh": "安全加密给数据传输速度增加了巨大的<w>系统开销</w>。"
                            }
                        },
                        {
                            "text": "We need to optimize the code to reduce the system <w>overhead</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно оптимизировать код, чтобы снизить системные <w>издержки</w>.",
                                "zh": "我们需要优化代码以减少<w>系统开销</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "system overhead",
                        "performance overhead"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительные вычислительные ресурсы, такие как время или память, необходимые для управления процессом, а не для выполнения самой работы.",
                        "zh": "计算机系统中用于管理进程而非执行实际工作所需的额外资源（如时间或内存）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладные расходы",
                                "target_lang_sense_clarification": "в информатике"
                            },
                            {
                                "target_lang_word": "издержки",
                                "target_lang_sense_clarification": "затраты ресурсов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系统开销",
                                "target_lang_sense_clarification": "计算机科学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dccf62a-823e-3c5d-a6b3-98c1df847bef",
                    "sense_definition": "A device that projects an image from a transparent sheet onto a wall or screen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher placed a transparency on the <w>overhead</w> to show us the diagram.",
                            "target_lang_translations": {
                                "ru": "Учитель положил прозрачную пленку на <w>кодоскоп</w>, чтобы показать нам диаграмму.",
                                "zh": "老师把透明胶片放在<w>投影仪</w>上给我们展示图表。"
                            }
                        },
                        {
                            "text": "We found an old <w>overhead</w> in the storage room covered in dust.",
                            "target_lang_translations": {
                                "ru": "Мы нашли в кладовке старый, покрытый пылью <w>кодоскоп</w>.",
                                "zh": "我们在储藏室里发现了一台落满灰尘的旧<w>投影仪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overhead projector"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly replaced by digital projectors"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, проецирующее изображение с прозрачной пленки на стену или экран.",
                        "zh": "一种将透明胶片上的图像投射到墙壁或屏幕上的设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кодоскоп",
                                "target_lang_sense_clarification": "оптический прибор"
                            },
                            {
                                "target_lang_word": "проектор",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投影仪",
                                "target_lang_sense_clarification": "通用投影设备"
                            },
                            {
                                "target_lang_word": "高射投影仪",
                                "target_lang_sense_clarification": "专门指代老式胶片投影设备"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "5214db63-fe6c-31b8-91ae-93f287627765",
                    "sense_definition": "Above someone or something.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spatial_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stars shone brightly <w>overhead</w> the quiet village.",
                            "target_lang_translations": {
                                "ru": "Звезды ярко сияли <w>над</w> тихой деревней.",
                                "zh": "星星在宁静村庄的<w>上方</w>闪烁着光芒。"
                            }
                        },
                        {
                            "text": "Dark clouds gathered <w>overhead</w> the valley before the storm.",
                            "target_lang_translations": {
                                "ru": "Темные тучи сгустились <w>над</w> долиной перед грозой.",
                                "zh": "暴风雨来临前，乌云笼罩在山谷<w>上方</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "above",
                        "over"
                    ],
                    "antonyms": [
                        "below",
                        "beneath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Над кем-то или чем-то.",
                        "zh": "在某人或某物的上方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "над",
                                "target_lang_sense_clarification": "предлог места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……上方",
                                "target_lang_sense_clarification": "表示位置的介词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}