                "senses": [
                    {
                        "sense_id": "1268d1bb-6fd9-3011-9c11-09a9d4f2ad0f",
                        "entry_id": "2b1fb3bb-031c-3eb4-806a-64993846606d",
                        "glosses": [
                            "Lampe mit besonders niedrigem Stromverbrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0201a04d-e7de-4e9b-9499-3d1dce2427bc",
                                "sense_id": "1268d1bb-6fd9-3011-9c11-09a9d4f2ad0f",
                                "text": "Durch die Verwendung von Energiesparlampen können die Stromkosten gesenkt werden."
                            },
                            {
                                "example_id": "ad367a0b-71f3-4b87-b4dd-a1cb0f9a89e7",
                                "sense_id": "1268d1bb-6fd9-3011-9c11-09a9d4f2ad0f",
                                "text": "„Nicci war schon immer sehr umweltbewusst gewesen und hatte, lange bevor es üblich wurde, unser Heim mit Energiesparlampen ausgestattet; matt und in einer unbehaglichen Gelbfärbung dämmerte das Licht zu mir nach draußen.“"
                            },
                            {
                                "example_id": "64da5ac5-2b42-46fe-acc3-2c9793222824",
                                "sense_id": "1268d1bb-6fd9-3011-9c11-09a9d4f2ad0f",
                                "text": "„Für Wasserkraftwerke werden Stauseen errichtet, die riesige Ökosysteme zerstören, und für Energiesparlampen muss in China hochgiftiges Quecksilber abgebaut werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
