                        "glosses": [
                            "Couper des céréales à la faucille."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2f6fe922-d31f-4aab-b904-3b98e0acfa7a",
                                "sense_id": "e04ef590-eb68-37d5-bfbf-1aefac18e7c8",
                                "text": "Menace ou pas, invasion ou pas, déportation ou pas, le blé est mûr, il faut le « métiver », le cueillir et le mettre à l’abri."
                            },
                            {
                                "example_id": "0ecaf5f0-1c06-4618-a11b-0067a8c34882",
                                "sense_id": "e04ef590-eb68-37d5-bfbf-1aefac18e7c8",
                                "text": "Métiver représentait un dur travail, mais un travail qui se faisait dans l’allégresse."
                            }
                        ]
