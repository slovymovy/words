                    {
                        "translation_id": "d51c039e-421d-4c9a-9ca3-80dd71204cea",
                        "source_entry_id": "43c23b8d-986d-3efa-a603-4007bdb73ea4",
                        "source_sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
