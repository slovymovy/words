                                        "examples": [
                                            {
                                                "example_id": "db675215-dc8a-4286-957c-0d58b82e502c",
                                                "sense_id": "e8bf6219-1422-3240-ad91-e4cf85d400f9",
                                                "text": "There were only about a dozen officers in the great wardroom, six of them in the khaki gabardine working uniform of the U.S. Navy."
