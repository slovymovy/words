                ],
                "senses": [
                    {
                        "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                        "entry_id": "86082c89-6042-3961-9c18-979c2c7af44a",
                        "glosses": [
                            "Staat in Afrika, der am 9. Juli 2011 die Unabhängigkeit vom Sudan erlangte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d7436c-4a66-4b3f-b545-481acd3ab393",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Er überlebte seinen Traum, die Unabhängigkeitserklärung des Südsudan, nur um eine Woche“."
                            },
                            {
                                "example_id": "27c7292f-700d-4277-9b3c-64dce6c85b37",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Bis der jüngst gegründete Südsudan ein eigenes Länderkürzel für Internet-Adressen bekommt, wird wohl noch einige Zeit vergehen.“"
                            },
                            {
                                "example_id": "297ce882-0cde-4b4b-8e4a-60cb93f6c4d3",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„An diesem Wochenende wurde Südsudan offiziell zum autonomen Staat.“"
                            },
                            {
                                "example_id": "f01157b1-a688-4d69-9901-8524702f7580",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Eigentlich sind dies Tage des Jubels in Südsudan, doch wenn der Schmerz so groß ist, fällt das Feiern schwer“"
                            },
                            {
                                "example_id": "04294d85-43ed-4480-9f7f-5b38a365c373",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Im Südsudan, der erst vor wenigen Tagen unabhängig wurde, kämpfen die Helfer von Ärzte ohne Grenzen mit medizinischen Verhältnissen, wie sie kaum vergleichbar sind.“"
                            },
                            {
                                "example_id": "c0bc4325-2071-4bda-87a8-edf56a34c264",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Der Südsudan wird mit einer eigenen Mannschaft bei den Olympischen Spielen 2012 in London starten, vermutlich aber nicht mit eigener Flagge.“"
                            },
                            {
                                "example_id": "d910d105-0193-4e77-8e4b-9d979b3c6019",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Die aussenpolitischen Kommissionen des Stände- und des Nationalrates hatten sich im Vorfeld einstimmig für die Anerkennung des Südsudans ausgesprochen.“"
                            },
                            {
                                "example_id": "7a4c2533-6812-4b40-a09a-edc37268aba5",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Wer in Juba, der Hauptstadt des Südsudans, unterwegs ist, muss nur die Augen schließen und glaubt sich in Kenia oder Uganda.“"
                            },
                            {
                                "example_id": "d8271891-f0c7-4320-b135-7a2d5d966585",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Die Unabhängigkeit des Südsudan zeige erneut, dass ein neuer Anfang nach Kriegen möglich sei.“"
                            },
                            {
                                "example_id": "cbac097d-1813-4f3f-926c-1979c8c347da",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Mit dem Südsudan entsteht ein instabiler und schwacher Staat in einer der konfliktträchtigsten Regionen weltweit.“"
                            },
                            {
                                "example_id": "4b3d982e-cf97-4401-881c-0fa5d4e072ee",
                                "sense_id": "b55ec2db-0982-35da-8cb4-8d511654e914",
                                "text": "„Es werde gemeinsame deutsch-kenianische Investitionen in Infrastruktur geben, vor allem die geplante neue Ölpipeline aus Südsudan zum kenianischen Hafen Lamu und der Ausbau dieses Hafens, sagte Präsident Mwai Kibaki nach seinem Treffen mit Merkel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
