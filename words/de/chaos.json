    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9862683e-23ba-3685-9363-d46d43aaf269",
                    "sense_definition": "völlige Unordnung, Verwirrung oder ein Zustand des Durcheinanders",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unordnung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem heftigen Unwetter herrschte auf den Straßen der Stadt ein riesiges <w>Chaos</w>."
                        },
                        {
                            "text": "Die Renovierung der Wohnung sorgte in den ersten Wochen für großes <w>Chaos</w>."
                        }
                    ],
                    "synonyms": [
                        "Durcheinander",
                        "Unordnung",
                        "Wirrwarr"
                    ],
                    "antonyms": [
                        "Ordnung"
                    ],
                    "common_phrases": [
                        "völliges Chaos",
                        "im Chaos versinken",
                        "Chaos anrichten"
                    ]
                },
                {
                    "sense_id": "43673369-cfb5-3d85-9419-145f6e2f2493",
                    "sense_definition": "der ungeordnete Urzustand der Welt vor der Entstehung des geordneten Kosmos",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In vielen antiken Mythen entstand die Welt aus einem formlosen und finsteren <w>Chaos</w>."
                        },
                        {
                            "text": "Die griechische Schöpfungsgeschichte beschreibt das <w>Chaos</w> als den ursprünglichen Zustand allen Seins."
                        }
                    ],
                    "synonyms": [
                        "Urzustand"
                    ],
                    "antonyms": [
                        "Kosmos"
                    ],
                    "common_phrases": [
                        "aus dem Chaos entstehen"
                    ]
                },
                {
                    "sense_id": "2641cbe7-54cb-3005-953f-c072e14c3882",
                    "sense_definition": "scheinbar regelloses, unvorhersehbares Verhalten innerhalb deterministischer, dynamischer Systeme",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naturwissenschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Chaostheorie zeigt, dass hinter scheinbarem <w>Chaos</w> oft mathematische Gesetzmäßigkeiten stehen."
                        },
                        {
                            "text": "Kleine Veränderungen in den Anfangswerten können in solchen Systemen rasch zu deterministischem <w>Chaos</w> führen."
                        }
                    ],
                    "antonyms": [
                        "Ordnung"
                    ],
                    "common_phrases": [
                        "deterministisches Chaos"
                    ]
                },
                {
                    "sense_id": "55dd6ea4-33d2-3985-a192-23e7fbf94979",
                    "sense_definition": "anfängliche Phase bei Großeinsätzen oder Katastrophen ohne klares Lagebild und feste Führung",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "einsatzlage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den ersten Minuten nach dem Unglück musste die Einsatzleitung das <w>Chaos</w> vor Ort bewältigen."
                        },
                        {
                            "text": "Nach der Alarmierung dauerte es eine Weile, bis die Einsatzleitung das anfängliche <w>Chaos</w> in den Griff bekam."
                        }
                    ],
                    "antonyms": [
                        "Ordnung"
                    ]
                },
                {
                    "sense_id": "91a6f157-bf77-34fc-8786-5bc2497c964b",
                    "sense_definition": "Zustand beim Übergang thermodynamischer oder physikalischer Systeme von einem Gleichgewicht in ein Ungleichgewicht",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naturwissenschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Phasenübergang geriet das physikalische System zunehmend in ein dynamisches <w>Chaos</w>."
                        },
                        {
                            "text": "Forscher untersuchten den Punkt, an dem thermisches Gleichgewicht in unkontrolliertes <w>Chaos</w> übergeht."
                        }
                    ],
                    "antonyms": [
                        "Ordnung"
                    ]
                }
            ]
        }
    ]
}