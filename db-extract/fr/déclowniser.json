                "senses": [
                    {
                        "sense_id": "d1b0a5b5-e3aa-3caa-90bb-28bde1c1f9cc",
                        "entry_id": "08639247-de13-3033-833f-cba2a118186d",
                        "glosses": [
                            "Faire perdre son caractère de clown à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae9b634-4c1b-4c49-ab7b-93e308155030",
                                "sense_id": "d1b0a5b5-e3aa-3caa-90bb-28bde1c1f9cc",
                                "text": "Façon de déclowniser son visage sans tomber dans le chantage au clown triste, écorchure sous le nez rouge, Guignol mélancolique,Tchao Pantin."
                            },
                            {
                                "example_id": "1bdbfd66-811a-418c-bead-e1300b4cf04f",
                                "sense_id": "d1b0a5b5-e3aa-3caa-90bb-28bde1c1f9cc",
                                "text": "Et, suprême étrangeté, à la fin du film, il déclownise le visage de Cabiria pour lui faire irradier cette joie qui jusque-là était réservée au spectateur, et non au pitre."
                            }
                        ]
                    }
                ],
