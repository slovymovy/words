                                    },
                                    {
                                        "sense_id": "226c22ce-f4a6-3d55-b6cf-b307859ff5f8",
                                        "entry_id": "314eef2b-718e-3b85-b601-b43e83bd5d5b",
                                        "glosses": [
                                            "rozróżnianie czasowników ze względu na strony"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb1ca58-fd67-48b6-9892-4a8c95da012e",
                                                "sense_id": "226c22ce-f4a6-3d55-b6cf-b307859ff5f8",
                                                "text": "Mówi się tu, że tzw. strona czynna ma diatezę nienacechowaną."
