                ],
                "senses": [
                    {
                        "sense_id": "fe3e6866-cfe6-3cf5-9479-b82a69f1ca3c",
                        "entry_id": "5b5465d8-06bd-30e4-b2cb-35c1adcac4fb",
                        "glosses": [
                            "Wand eines Tunnels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f60346fe-6da0-40e3-b414-1c67c5526537",
                                "sense_id": "fe3e6866-cfe6-3cf5-9479-b82a69f1ca3c",
                                "text": "„Doch die paradoxe unruhige Bewegung der massiven Tunnelwände hörte nicht auf.“"
                            },
                            {
                                "example_id": "dad418f1-957a-477e-82c3-76cb2371e905",
                                "sense_id": "fe3e6866-cfe6-3cf5-9479-b82a69f1ca3c",
                                "text": "„Während ich weiterging, hielt ich meine Laterne dicht an die Tunnelwände.“"
                            },
                            {
                                "example_id": "f4bf7888-7f75-466f-9199-f3d520184544",
                                "sense_id": "fe3e6866-cfe6-3cf5-9479-b82a69f1ca3c",
                                "text": "„Am Ende orientierte ich mich, indem ich mich mit meinem Gehstock die Tunnelwand entlangtastete, genau so, wie es ein Blinder tun würde.“"
                            },
                            {
                                "example_id": "66e2d2c0-389d-4856-a616-78f28865444f",
                                "sense_id": "fe3e6866-cfe6-3cf5-9479-b82a69f1ca3c",
                                "text": "„Stattdessen schob Gray Man den Gegner rückwärts gegen die Tunnelwand und stieß ihn heftig gegen den zweiten vermeintlichen Attentäter, den er in dem Moment erwischte, als dieser um die Biegung kam und seine Waffe zücken wollte.“"
                            },
                            {
                                "example_id": "27a6a330-4280-4ee9-aa11-b3f8880bab49",
                                "sense_id": "fe3e6866-cfe6-3cf5-9479-b82a69f1ca3c",
                                "text": "„Hamish lenkte den Lkw so dicht an den Rand des Tunnels, dass die linke Seite des Fahrzeugs an der Tunnelwand entlangschrammte und der Drache gegen den Eingang prallte und fortgerissen wurde, während der Müllwagen weiter in den Tunnel donnerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
