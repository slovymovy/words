                "senses": [
                    {
                        "sense_id": "cd53129c-2c89-3ab9-a48d-babd195257e2",
                        "entry_id": "62fcc802-81ac-3a80-9daa-51c5a5556eeb",
                        "glosses": [
                            "Eid einer Person oder Organisation gegenüber, durch den die Treue ihr gegenüber geschworen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a294d3-7d24-497e-b827-3804613a3d75",
                                "sense_id": "cd53129c-2c89-3ab9-a48d-babd195257e2",
                                "text": "„Dann nahm er die Kapitulation aller pompeianischen Legionen in Messina entgegen, ließ die Soldaten einen Treueeid auf seine eigene Person schwören und fügte die Legionen jenen hinzu, die er bereits befehligte.“"
                            },
                            {
                                "example_id": "c2f7ca4c-caf0-44e9-a1d9-06e250073be0",
                                "sense_id": "cd53129c-2c89-3ab9-a48d-babd195257e2",
                                "text": "„›Ihr werdet in aller Form ersucht, Euch in Osaka einzufinden, um Euren Treueeid zu erneuern.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
