                "senses": [
                    {
                        "sense_id": "f6d7d649-e54d-39df-88aa-eba01f96fb0b",
                        "entry_id": "eda0f04a-9b00-3c60-ab9b-1f38382d8775",
                        "glosses": [
                            "Glisser."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "ad79dfdb-bc05-49b6-9b0c-c24004ae879e",
                                "sense_id": "f6d7d649-e54d-39df-88aa-eba01f96fb0b",
                                "text": "L’hiver Thomas profite du verglas pour débrioler avec ses sabots : glisser en prenant son élan et en mettant un pied devant l’autre."
                            },
                            {
                                "example_id": "d38d2cd5-5419-47f7-af2e-6861e8b2868e",
                                "sense_id": "f6d7d649-e54d-39df-88aa-eba01f96fb0b",
                                "text": "Son émotion passée, Forain se souvient de son jeune temps, et avisant un gamin qui le regarde curieusement, il lui donne quatre sous en lui demandant de débrioler sur l’escalier qu'ont poli des milliers de fonds de culotte."
                            }
                        ]
                    }
