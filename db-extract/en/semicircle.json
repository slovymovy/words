                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1d2d94e-d7a4-3e9f-851c-a46c496bfb3f",
                        "entry_id": "bd952315-0c9e-3937-afe0-1bec13e2f491",
                        "glosses": [
                            "Halbkreis, Halbbogen"
                        ],
                        "tags": [],
