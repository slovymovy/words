                                "target_lang_sense_clarification": "ничем не примечательный"
                            },
                            {
                                "target_lang_word": "банальный",
                                "target_lang_sense_clarification": "избитый, заурядный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76058551-5556-32a8-9f7f-d23335b50eb2",
                    "sense_definition": "An event, feature, or thing that is completely ordinary or commonly encountered.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Delays on this train route have unfortunately become a <w>commonplace</w>.",
                            "target_lang_translations": {
                                "ru": "Задержки поездов на этом маршруте, к сожалению, стали <w>обычным делом</w>."
                            }
                        },
                        {
                            "text": "Using digital devices in classrooms is now an accepted <w>commonplace</w>.",
                            "target_lang_translations": {
                                "ru": "Использование цифровых устройств на уроках теперь стало общепринятой <w>нормой</w>."
                            }
