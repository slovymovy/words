                                    {
                                        "sense_id": "fdafc38e-8585-3d6e-b298-95185250412b",
                                        "entry_id": "e53be2c5-09fb-3aad-899b-3db3d776218e",
                                        "glosses": [
                                            "The state of being viscous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20c78055-4bd5-4453-9c2f-0d96d9177e75",
                                                "sense_id": "fdafc38e-8585-3d6e-b298-95185250412b",
                                                "text": "Near-synonym: thickness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1ebf5d6-7f9d-35ac-8622-b4f2dc589779",
                                        "entry_id": "e53be2c5-09fb-3aad-899b-3db3d776218e",
                                        "glosses": [
                                            "A quantity expressing the magnitude of internal friction in a fluid, as measured by the force per unit area resisting uniform flow."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e581043-7009-491c-a03e-2e118da90d83",
                                                "sense_id": "c1ebf5d6-7f9d-35ac-8622-b4f2dc589779",
                                                "text": "The microcannon was seen moving at about a micron per second, it was about 15 microns long, and the high speed photograph was done in water (density of 1 kg/L, viscosity of about 0.001 pascal seconds)."
                                            },
                                            {
                                                "example_id": "b8b993c4-f816-46c7-895c-25754535ab94",
                                                "sense_id": "c1ebf5d6-7f9d-35ac-8622-b4f2dc589779",
                                                "text": "Aquafaba was recovered from 10 commercial canned chickpea products and correlations among aquafaba composition, density, viscosity and foaming properties were investigated. Proton NMR was used to characterize aquafaba composition before and after ultrafiltration through membranes with different molecular weight cut offs (MWCOs of 3, 10, or 50 kDa)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89db3a70-7665-3dbe-bfac-3bdccb378dd3",
                                        "entry_id": "e53be2c5-09fb-3aad-899b-3db3d776218e",
                                        "glosses": [
                                            "A tendency to prolong interpersonal encounters."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "063e91b7-b227-441e-8d77-a0e43ce163ea",
                        "source_entry_id": "afd97fb4-768e-3ddc-a629-ed42eebbf42e",
                        "source_sense_id": "7f46f3ea-dbf7-3792-a4cf-52f114ab25e6",
                        "target_lang_word": "viscosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viscosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de4228e2-a525-3b01-8479-ab92d63091d1",
                                        "entry_id": "7b8783b8-94b2-325a-9d86-0e45dc411eee",
                                        "glosses": [
                                            "Caractère de ce qui est visqueux."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930c1824-f7fd-468c-8dde-f93af57b0b6f",
                                                "sense_id": "de4228e2-a525-3b01-8479-ab92d63091d1",
                                                "text": "La viscosité du sang, qui est diminuée dans la fièvre typhoïde, augmente au contraire dans la pneumonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca218dc4-90fe-30bb-a3c4-920f8d01ecfa",
                                        "entry_id": "7b8783b8-94b2-325a-9d86-0e45dc411eee",
                                        "glosses": [
                                            "Résistance à l’écoulement uniforme et sans turbulence se produisant dans la masse d’une matière."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05b50f36-5600-48b9-9674-01106be1ca57",
                                                "sense_id": "ca218dc4-90fe-30bb-a3c4-920f8d01ecfa",
                                                "text": "Les huiles « newtoniennes », c'est-à-dire les huiles minérales et synthétiques ne comportant pas d'additif améliorant l'indice de viscosité sont dites «incisaillables», ce qui signifie que leur viscosité ne varie pas lorsqu'elles sont soumises à un cisaillement dans les organes mécaniques rapides à faibles jeux de fonctionnement […]."
                                            },
                                            {
                                                "example_id": "3a64113d-fda2-4f57-8d0d-bc9fc5deefff",
                                                "sense_id": "ca218dc4-90fe-30bb-a3c4-920f8d01ecfa",
                                                "text": "Explication : plus l'eau est chaude, moins elle est visqueuse. La viscosité de l'eau n'est pas facile à visualiser, mais c'est exactement le même phénomène que quand vous chauffez du miel ou du caramel, il devient plus mou et ne coule pas de la même façon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b934dd94-1caf-41d2-b9d1-65a824cb30e8",
                        "source_entry_id": "afd97fb4-768e-3ddc-a629-ed42eebbf42e",
                        "source_sense_id": "7f46f3ea-dbf7-3792-a4cf-52f114ab25e6",
                        "target_lang_word": "viscosidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7456eec8-c616-486d-8702-449d9567337c",
                        "source_entry_id": "afd97fb4-768e-3ddc-a629-ed42eebbf42e",
                        "source_sense_id": "7f46f3ea-dbf7-3792-a4cf-52f114ab25e6",
                        "target_lang_word": "Viskosität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viskosität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3dad405-5571-3a2d-aa7e-ee574dc8358d",
                                        "entry_id": "77c1ff14-1023-3b04-85fb-060effd28248",
                                        "glosses": [
                                            "Maß für die Beweglichkeit der Teilchen von Fluiden"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e795f27-77c4-4eaf-bfb7-0cdd854e8d54",
                                                "sense_id": "f3dad405-5571-3a2d-aa7e-ee574dc8358d",
                                                "text": "Honig hat eine höhere Viskosität als Wasser."
                                            },
                                            {
                                                "example_id": "a6d4a910-6e44-4bd5-b84d-83d123cde84a",
                                                "sense_id": "f3dad405-5571-3a2d-aa7e-ee574dc8358d",
                                                "text": "Die Viskosität von Gasen steigt mit der Temperatur, während die von Flüssigkeiten mit der Temperatur exponentiell sinkt."
                                            },
                                            {
                                                "example_id": "4c84e480-fd45-4592-8403-655f6fd6ae10",
                                                "sense_id": "f3dad405-5571-3a2d-aa7e-ee574dc8358d",
                                                "text": "Obwohl Glas ein Feststoff ist, hat es als Fluid eine Viskosität."
                                            },
                                            {
                                                "example_id": "d5f11066-f89e-4a9e-a590-30dc8e63d183",
                                                "sense_id": "f3dad405-5571-3a2d-aa7e-ee574dc8358d",
                                                "text": "Je größer die Viskosität ist, desto dickflüssiger, d. h. weniger fließfähig ist das Fluid."
                                            },
                                            {
                                                "example_id": "cc761ab1-23eb-4f15-bca7-1091a595616c",
                                                "sense_id": "f3dad405-5571-3a2d-aa7e-ee574dc8358d",
                                                "text": "„Während der Topfzeit steigt die Viskosität des Harzes in einer nichtlinearen Kurve immer weiter an, bis schließlich keine Verarbeitung mehr möglich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
