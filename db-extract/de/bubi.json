                    },
                    {
                        "sense_id": "9bf24be0-e5ac-3153-acec-e2b6bd502718",
                        "entry_id": "2cbdbb3a-d96b-3fd1-8fa2-aed3620dde52",
                        "glosses": [
                            "(Péjoratif) Pour un jeune homme : personne immature, infantile, faible ; freluquet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f4a05dd-f274-4bdb-9105-ccd3c20c822c",
                                "sense_id": "9bf24be0-e5ac-3153-acec-e2b6bd502718",
                                "text": "Dieser Bubi beeindruckt mich wirklich nicht!",
                                "translation": "Ce freluquet ne m'impressionne vraiment pas !"
                            }
                        ]
                    }
