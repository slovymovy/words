    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6216d206-c2e8-3c87-9c1e-4fc9fee5a590",
                    "sense_definition": "Provided with the food or other substances necessary for growth, health, and good condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a hot, hearty meal, the children felt warm and <w>nourished</w>.",
                            "target_lang_translations": {
                                "nl": "Na een warme, stevige maaltijd voelden de kinderen zich warm en <w>goed gevoed</w>."
                            }
                        },
                        {
                            "text": "A child who is well <w>nourished</w> usually does better at school.",
                            "target_lang_translations": {
                                "nl": "Een <w>goed gevoed</w> kind presteert waarschijnlijk beter op school."
                            }
                        }
                    ],
                    "synonyms": [
                        "fed",
                        "nurtured"
                    ],
                    "antonyms": [
                        "malnourished",
                        "starved"
                    ],
                    "common_phrases": [
                        "well nourished"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van voedsel of andere stoffen die nodig zijn voor groei, gezondheid en een goede conditie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gevoed",
                                "target_lang_sense_clarification": "algemene term voor voorzien van voeding"
                            },
                            {
                                "target_lang_word": "goed gevoed",
                                "target_lang_sense_clarification": "vaak gebruikt in de context van 'well-nourished'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd395117-a015-3455-bec3-37bf945634ab",
                    "sense_definition": "Simple past and past participle of <w>nourish</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother <w>nourished</w> her baby with healthy food every single day.",
                            "target_lang_translations": {
                                "nl": "De moeder <w>voedde</w> haar baby elke dag met gezond eten."
                            }
                        },
                        {
                            "text": "The soil had <w>nourished</w> the crops throughout the entire growing season.",
                            "target_lang_translations": {
                                "nl": "De bodem had de gewassen gedurende het hele groeiseizoen <w>gevoed</w>."
                            }
