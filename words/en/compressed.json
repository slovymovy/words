{
    "word_family": [
        "compress",
        "compression",
        "compressor",
        "compressible",
        "compressibility",
        "decompression"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3236dee4-f6aa-3463-aa10-4241b21f0ff4",
                    "sense_definition": "Pressed tightly together or reduced in volume by pressure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scuba diver carried a tank of <w>compressed</w> air to breathe underwater.",
                            "target_lang_translations": {
                                "ru": "Аквалангист нес баллон со <w>сжатым</w> воздухом, чтобы дышать под водой."
                            }
                        },
                        {
                            "text": "The <w>compressed</w> spring released a lot of energy when it was finally let go.",
                            "target_lang_translations": {
                                "ru": "<w>Сжатая</w> пружина высвободила много энергии, когда ее наконец отпустили."
                            }
                        }
                    ],
                    "synonyms": [
                        "condensed",
                        "compacted",
                        "squeezed"
                    ],
                    "antonyms": [
                        "expanded",
                        "dilated"
                    ],
                    "common_phrases": [
                        "compressed air",
                        "compressed gas",
                        "highly compressed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно сжатый или уменьшенный в объеме под воздействием давления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "находящийся под давлением"
                            },
                            {
                                "target_lang_word": "уплотненный",
                                "target_lang_sense_clarification": "сделанный более плотным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7efc0eeb-5342-3179-a8a3-ea952428f898",
                    "sense_definition": "Flattened or made smaller in size, especially along its length or in a digital format.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should send a <w>compressed</w> file because the original is too large for an email attachment.",
                            "target_lang_translations": {
                                "ru": "Вам следует отправить <w>сжатый</w> файл, так как оригинал слишком велик для вложения в электронное письмо."
                            }
                        },
                        {
                            "text": "The fossil was found in a <w>compressed</w> layer of ancient rock.",
                            "target_lang_translations": {
                                "ru": "Окаменелость была найдена в <w>спрессованном</w> слое древней породы."
                            }
                        }
                    ],
                    "synonyms": [
                        "flattened",
                        "zipped"
                    ],
                    "antonyms": [
                        "uncompressed"
                    ],
                    "common_phrases": [
                        "compressed file",
                        "compressed data",
                        "compressed format"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплющенный или уменьшенный в размере, особенно в длину или в цифровом формате."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "о файлах или данных"
                            },
                            {
                                "target_lang_word": "сплющенный",
                                "target_lang_sense_clarification": "деформированный давлением"
                            },
                            {
                                "target_lang_word": "архивированный",
                                "target_lang_sense_clarification": "о компьютерных файлах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c178cc64-bf3a-3137-8574-4c4f3c3a2c57",
                    "sense_definition": "Simple past and past participle of <w>compress</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine <w>compressed</w> the old car into a small metal cube.",
                            "target_lang_translations": {
                                "ru": "Машина <w>спрессовала</w> старый автомобиль в небольшой металлический куб."
                            }
                        },
                        {
                            "text": "She <w>compressed</w> her lips together and refused to say another word.",
                            "target_lang_translations": {
                                "ru": "Она <w>сжала</w> губы и отказалась произнести больше ни слова."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «сжимать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжал",
                                "target_lang_sense_clarification": "действие в прошлом"
                            },
                            {
                                "target_lang_word": "сдавил",
                                "target_lang_sense_clarification": "сильно прижал"
                            },
                            {
                                "target_lang_word": "спрессовал",
                                "target_lang_sense_clarification": "с помощью техники"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}