                "senses": [
                    {
                        "sense_id": "e069e7ad-37bf-3825-bbab-56b70e4c5148",
                        "entry_id": "c715fec1-1bca-3a2a-8155-12378d2588b9",
                        "glosses": [
                            "Réparer le gréement d’un bâtiment, ainsi que tous les dommages qu’il a pu éprouver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bcccd6b-b978-4497-9bbb-a4bb439bb4ff",
                                "sense_id": "e069e7ad-37bf-3825-bbab-56b70e4c5148",
                                "text": "Repeints et regréés, ils ont l’air et l’odeur de gros jouets neufs."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7c712c7-bd2e-3ec0-b797-30e1a2b85542",
                        "entry_id": "c715fec1-1bca-3a2a-8155-12378d2588b9",
                        "glosses": [
                            "Variante de ragréer."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "505db3d3-0a6c-43b4-a2e6-4c2ef35f7975",
                                "sense_id": "e7c712c7-bd2e-3ec0-b797-30e1a2b85542",
                                "text": "Les maçons, eux, gâchaient le mortier, regréaient, jointoyaient. Ils déposaient ici ou là les pierres rongées par le temps et il fallait choisir celles qui les remplaceraient, les mettre au gabarit, et, avec les documents fournis par les Monuments historiques, reconstituer le prodigieux décor de tiges perlées, de palmettes, de roses, d’acanthes grotesques, de guillochures qui couraient sur les archivoltes, ou s’entremêlaient sur les chapiteaux."
                            }
                        ]
                    }
