                        ],
                        "examples": [
                            {
                                "example_id": "99dc5252-9698-4871-8594-a68d56b96615",
                                "sense_id": "ffed07ff-56b5-3884-a009-318134417908",
                                "text": "„In der Nähe stand der Schinto-Dorfschrein, ein winziges, strohgedecktes Dach über einer Plattform für den Kami, den Geist, der hier wohnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
