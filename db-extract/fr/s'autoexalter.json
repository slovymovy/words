                ],
                "senses": [
                    {
                        "sense_id": "ba1f3f7e-cada-3165-b11b-b29dac2f078e",
                        "entry_id": "2172d8c9-2085-389a-af03-68995c55eaec",
                        "glosses": [
                            "S’exalter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0cb6cbc-35b3-4d1d-a076-61e5563403b5",
                                "sense_id": "ba1f3f7e-cada-3165-b11b-b29dac2f078e",
                                "text": "Ce qu'on nomme culture ne s'autoexalte pas toujours dans une complicité folklorique du type Morgenstraich: toutes les activités collectives des Suisses sentent le folklore."
                            },
                            {
                                "example_id": "452c5a72-7f3a-4d68-8e90-9ec7ddd106bc",
                                "sense_id": "ba1f3f7e-cada-3165-b11b-b29dac2f078e",
                                "text": "Je ne suis pas en train de faire de l’incantation, pour nous, pour s’autoexalter, je suis en train de dire que l’on gagnera, on y arrivera, parce que l’histoire le montre, et donc que faire?"
                            }
                        ]
                    }
