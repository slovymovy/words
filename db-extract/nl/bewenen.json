                                        "entry_id": "cf565f34-52f8-3c3d-b066-699ccd168c6d",
                                        "glosses": [
                                            "To express sadness or sorrow for; to grieve over (especially a death)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc80154-ac2d-40e2-a527-c8c78ed429b4",
                                                "sense_id": "08bdf5fb-e168-3a9d-9ed8-a01606044955",
                                                "text": "For two months, she mourned her father's passing."
                                            },
                                            {
                                                "example_id": "b9a0e1cb-f296-4b94-ba4f-20add34c6703",
                                                "sense_id": "08bdf5fb-e168-3a9d-9ed8-a01606044955",
                                                "text": "We mourn in black; why mourn we not in blood?"
                                            },
                                            {
                                                "example_id": "273a4cea-d2fb-4bb2-a884-800d30a240fb",
                                                "sense_id": "08bdf5fb-e168-3a9d-9ed8-a01606044955",
                                                "text": "Abraham came to mourn for Sarah, and to weep for her."
                                            },
                                            {
                                                "example_id": "3f68f962-6dda-483b-8d35-8d0899af480a",
                                                "sense_id": "08bdf5fb-e168-3a9d-9ed8-a01606044955",
                                                "text": "Thane Krios: It seems there will be no one to mourn me when I die. You're the only friend I've made in ten years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99e95c1-7e3b-32bd-a729-2e896222593d",
                                        "entry_id": "cf565f34-52f8-3c3d-b066-699ccd168c6d",
                                        "glosses": [
                                            "To utter in a sorrowful manner."
