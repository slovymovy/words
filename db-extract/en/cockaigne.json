                                    {
                                        "sense_id": "29b57a19-2b04-3b83-82b8-d157d920024d",
                                        "entry_id": "bef5c757-1062-3257-8979-c3bf9b22818c",
                                        "glosses": [
                                            "denkbeeldig land waar eten en drinken in overvloed te krijgen zijn, zonder dat men ervoor hoeft te werken en waar men om er te komen zich door een rijstebrijberg heen moet eten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aefd582-9fa1-4f17-b19f-5ae5dfc465e1",
                                                "sense_id": "29b57a19-2b04-3b83-82b8-d157d920024d",
                                                "text": "in Luilekkerland vliegen de gebraden vogels vanzelf in de mond en lopen gebraden varkens in het rond met het mes al in hun rug. De huizen zijn er gemaakt van pannenkoeken, wafels en andere lekkernijen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a587b291-7468-4c42-80b2-1213a24cdc5f",
                        "source_entry_id": "b90c2989-b6db-3448-a999-2c991a2a5673",
                        "source_sense_id": "1a04ad32-e211-3e0d-9235-f1d118f14e5c",
                        "source_sense_description": "mythical land",
                        "target_lang_word": "cocagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15c4a487-b770-3b0b-9849-fb7c246472b9",
                                        "entry_id": "5b83b7a1-4711-3610-8dfa-6ad226623147",
                                        "glosses": [
                                            "Temps de réjouissance où l’on boit et mange abondamment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "943fc249-8187-45f5-80d4-c5a318c94be2",
                                                "sense_id": "15c4a487-b770-3b0b-9849-fb7c246472b9",
                                                "text": "Je vois des vaiſſeaux ſur cette mer [la mer Noire], des villes ſur les bords, des cocagnes pour un peuple immenſe, des feux d’artifice et tous les miracles de l’opéra réunis."
                                            },
                                            {
                                                "example_id": "19dcd5b4-fcc2-4b7f-84d8-2932e9bba6f1",
                                                "sense_id": "15c4a487-b770-3b0b-9849-fb7c246472b9",
                                                "text": "Ouvre à la chatte, elle sait aussi que midi approche. Tous les jours, elle a peur, après sa promenade matinale, de me retrouver guérie. Dormir sur mon lit, la nuit et le jour, quelle vie de Cocagne pour elle !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cocagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57858a8c-d6df-333c-b8af-e55d976281a8",
                                        "entry_id": "2765d422-f325-31a1-b45c-be3a8e2c74b2",
                                        "glosses": [
                                            "Signifie que ce qui vient d’être dit est jugé de peu d’importance, ou ne change rien sur le fond ; il n’y a pas de raison de s’inquiéter."
                                        ],
                                        "tags": [
                                            "Occitanie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ef31cf-f64c-482c-9ab0-0a5ad1795cfc",
                                                "sense_id": "57858a8c-d6df-333c-b8af-e55d976281a8",
                                                "text": "Tu lui as dit de te rappeler ? Cocagne ! Il se débrouillera bien seul sans toi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4168fe96-5b53-4f30-895c-e0a42a59e0d4",
                        "source_entry_id": "b90c2989-b6db-3448-a999-2c991a2a5673",
                        "source_sense_id": "1a04ad32-e211-3e0d-9235-f1d118f14e5c",
                        "source_sense_description": "mythical land",
                        "target_lang_word": "pays de cocagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pays de cocagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                        "entry_id": "881530e8-fec5-3144-90f8-966057aac8fd",
                                        "glosses": [
                                            "Pays imaginaire où l’on trouve de tout en abondance."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7e9d09-2850-4c9d-b6b2-1eb5a0c67ad6",
                                                "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                                "text": "Paris est pour un riche un pays de cocagne :\nSans sortir de la ville, il trouve la campagne ;"
                                            },
                                            {
                                                "example_id": "1b51683a-61cf-48b6-9b3f-30cc6fe1758f",
                                                "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                                "text": "Ils touchèrent les côtes d’Afrique en baie de Bône. Gabriel Morange foulait pour la première fois un sol étranger. De ces pays de cocagne qu’il imaginait au cœur de ses rêves d’enfant."
                                            },
                                            {
                                                "example_id": "6877eae4-7380-4f46-96bd-70e7a383bf3c",
                                                "sense_id": "491f1c1d-e781-3a42-a180-06b672d78ac6",
                                                "text": "Ce pays, mes amis, n’a rien à envier\nAux Flandres, au Languedoc, ou même à la Bretagne.\nC’est sans forfanterie que je puis vous confier\nQu’il est assurément un pays de cocagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00119f0d-a6c0-4534-ac7e-26a08b224742",
                        "source_entry_id": "b90c2989-b6db-3448-a999-2c991a2a5673",
                        "source_sense_id": "1a04ad32-e211-3e0d-9235-f1d118f14e5c",
                        "source_sense_description": "mythical land",
                        "target_lang_word": "Schlaraffenland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlaraffenland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                        "entry_id": "66ddb9b2-b174-3e56-b0d7-527dcb397b75",
                                        "glosses": [
                                            "märchenhaftes Land, in dem nach Art der Schlaraffen gelebt wird (Den sich dort aufhaltenden äußerst trägen Leuten flogen nach volkstümlicher Vorstellung z. B. gebratene Tauben und Spezereien im Überfluss in den Mund, es flossen Wein, Milch und Honig; Faulheit und Nichtstun galten als Tugenden, Hässliche und Alte verwandelte ein Jungbrunnen in Schöne beziehungsweise Junge und vieles mehr.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14050442-ee0a-4548-ae10-5c9856cc7e17",
                                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                                "text": "„Schlaraffenland gibt es nirgendwo, und die Faulheit ist überall verdächtig.“"
                                            },
                                            {
                                                "example_id": "f62c0813-367e-4b71-be72-65c140f48fd1",
                                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                                "text": "Im Vergleich zu meiner Heimat lebt man hier wie im Schlaraffenland."
                                            },
                                            {
                                                "example_id": "3407881d-66e6-48ee-a962-e88019c32b5d",
                                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                                "text": "„Ich trete durch die Tür und komme in ein Schlaraffenland.“"
                                            },
                                            {
                                                "example_id": "426ce71b-52d9-4ab7-a731-bf0eeca2c2f4",
                                                "sense_id": "e0e4cbda-db33-35ef-b157-9af8254f3da5",
                                                "text": "„Deren Witzfiguren flogen aus dem Schlaraffenland der ‚tüchtigen Deutschen‘ gewissermaßen wie gebratene Tauben in den Volksmund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
