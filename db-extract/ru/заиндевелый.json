                "senses": [
                    {
                        "sense_id": "97deebfe-17f5-36dd-8451-7830dc8fa995",
                        "entry_id": "0305737d-73fe-32a6-ac2f-b09cd04a6643",
                        "glosses": [
                            "покрытый инеем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d8e7ce-9825-4ed6-be0a-a62d510409dd",
                                "sense_id": "97deebfe-17f5-36dd-8451-7830dc8fa995",
                                "text": "Заиндевелые останки травы шуршали под ногами, как папиросная бумага."
                            },
                            {
                                "example_id": "3fbce622-d360-4110-a85a-b0375ede2de7",
                                "sense_id": "97deebfe-17f5-36dd-8451-7830dc8fa995",
                                "text": "Светящиеся изнутри и заиндевелые окна домов походили на драгоценные ларцы из дымчатого слоистого топаза."
                            }
                        ]
                    },
                    {
                        "sense_id": "df9dd86b-21e8-3d11-bb14-3e5331942ac4",
                        "entry_id": "0305737d-73fe-32a6-ac2f-b09cd04a6643",
                        "glosses": [
                            "перен. поседевший, седой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283fe5fb-bc09-4c3d-9647-8919dd941a01",
                                "sense_id": "df9dd86b-21e8-3d11-bb14-3e5331942ac4",
                                "text": "Его бронзовое, альпинистское лицо обрамляли заиндевелые кудри."
                            }
                        ]
                    }
                ],
