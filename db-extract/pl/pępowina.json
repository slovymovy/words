                                        "sense_id": "143d6646-f827-392d-b15e-aaf60a852574",
                                        "entry_id": "f3433227-d531-38bc-9e1e-1b19c2576877",
                                        "glosses": [
                                            "Any of the various lines connecting a rocket to its launch pad before liftoff."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de7860be-a2d6-399e-8307-b029657537ba",
