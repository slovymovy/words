                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41bb6923-70ae-3e27-80a9-f50290bef73a",
                                        "entry_id": "5ff01348-531b-30b6-a725-34716f1f518d",
                                        "glosses": [
                                            "The region between the eyes and nostrils of birds, reptiles, and amphibians."
