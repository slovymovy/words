                    {
                        "translation_id": "4f89e31a-73f5-4250-b9c0-3a0c067e89e8",
                        "source_entry_id": "16aa9419-e202-3d40-9138-f306c8db5a60",
                        "source_sense_id": "45c4a5c9-4402-3948-849e-4becf2d9a11e",
                        "source_sense_description": "kruid gebruikt in de keuken",
                        "target_lang_word": "Thymian",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thymian",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03d1a341-3618-3039-bd88-0fb06df3f3dc",
                                        "entry_id": "b31e8b94-9d65-3755-b922-574784aad1b2",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung Thymus aus der Familie der Lippenblütengewächse (Lamiaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b9d0809-6652-476e-9632-baeb358d4eff",
                                                "sense_id": "03d1a341-3618-3039-bd88-0fb06df3f3dc",
                                                "text": "Die Thymiane sind vor allem im Mittelmeerraum verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46508ab4-7095-3a2b-9afc-bb1be9c25433",
                                        "entry_id": "b31e8b94-9d65-3755-b922-574784aad1b2",
                                        "glosses": [
                                            "speziell Thymus vulgaris, welcher als Gewürz- und Heilpflanze genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1ec6986-4d75-49b7-8a50-82cf6222a93c",
                                                "sense_id": "46508ab4-7095-3a2b-9afc-bb1be9c25433",
                                                "text": "In unserem Kräutergarten haben wir unter anderem Thymian."
                                            },
                                            {
                                                "example_id": "e429006b-8f7e-4216-90ad-28768667496a",
                                                "sense_id": "46508ab4-7095-3a2b-9afc-bb1be9c25433",
                                                "text": "Tomatensoße wird gerne mit Thymian gewürzt."
                                            },
                                            {
                                                "example_id": "874e143e-5a08-475f-b84d-a0383ae1141a",
                                                "sense_id": "46508ab4-7095-3a2b-9afc-bb1be9c25433",
                                                "text": "„Eines Tages entdeckte Harbert in einer feuchten Niederung ganze Stauden von aromatischen Kräutern, Thymian, Quendel, Basilikum, Pfefferkraut und viele andere Lippenblütler.“"
                                            },
                                            {
                                                "example_id": "a976e3c9-e51d-4677-bdcb-28d18ef54731",
                                                "sense_id": "46508ab4-7095-3a2b-9afc-bb1be9c25433",
                                                "text": "„Sylvia atmete den Duft nach Thymian, Möhren und Rindfleisch ein und dachte, sie würde gleich vor lauter Glück tot umfallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "10fa7f10-ce70-3b7f-99fb-2cd9ce63f316",
                                        "entry_id": "b31e8b94-9d65-3755-b922-574784aad1b2",
                                        "glosses": [
                                            "aus den Blättern von Thymus vulgaris hergestelltes Küchengewürz"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eac9a07-aab8-4812-817e-f5c8c34a71d1",
                                                "sense_id": "10fa7f10-ce70-3b7f-99fb-2cd9ce63f316",
                                                "text": "„An diesem Tag im neuen Jahr hatte er Knoblauchzehen in das Fleisch gesteckt und den Braten mit einer Mischung aus geriebener Zitronenschale, Thymian, Rosmarin und Oregano bestrichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
