                    "frequency": "Middle",
                    "semantic_group_id": "introduire_discretement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>glissé</w> un billet au serveur pour avoir une meilleure table."
                        },
                        {
                            "text": "Sa grand-mère lui <w>glisse</w> toujours quelques euros en cachette."
