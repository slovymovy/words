                    {
                        "sense_id": "2eece4a0-c098-3864-b54f-d4fb21e9700d",
                        "entry_id": "a376ca3f-678d-3342-a7f3-7775fab544ee",
                        "glosses": [
                            "ursprünglich italische, dann römische Göttin des Handwerks, die ab dem 3. Jahrhundert v. Chr. mit der griechischen Göttin Athene gleichgesetzt und so zur Göttin der Weisheit, Dichter, Künstler, Lehrer und Ärzte wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "500ad730-46a7-48f8-aa65-b93e9ce7bddb",
                                "sense_id": "2eece4a0-c098-3864-b54f-d4fb21e9700d",
                                "text": "„Ähnliches [Zeugnisse privater Weihgaben] gilt auch für das zweite, bis in die Frühzeit der Siedlung zurückreichende Heiligtum, das Hercules und Minerva geweiht war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
