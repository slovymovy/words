                "senses": [
                    {
                        "sense_id": "b09b3d69-5e16-3070-8865-e442af31ba24",
                        "entry_id": "da201101-6b76-32e1-b1b8-cef5a902a0d8",
                        "glosses": [
                            "großes Säugetier aus der Gruppe der Robben mit einer Art Rüssel bei ausgewachsenen Bullen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29196a48-5494-48cd-ba0c-a71c4edf2574",
                                "sense_id": "b09b3d69-5e16-3070-8865-e442af31ba24",
                                "text": "„Der Mensch rottete [an Kanadas Küste] im 19. Jahrhundert die See-Elefanten aus.“"
                            },
                            {
                                "example_id": "299d8bb3-f949-4dfc-afd2-570450737d02",
                                "sense_id": "b09b3d69-5e16-3070-8865-e442af31ba24",
                                "text": "„See-Elefanten schwimmen bis zu 2000 Meter tief hinab und bleiben bis zu zwei Stunden unten.“"
                            },
                            {
                                "example_id": "24d7fccd-dc3e-4a96-b285-67395f7f9b25",
                                "sense_id": "b09b3d69-5e16-3070-8865-e442af31ba24",
                                "text": "„Im Januar machten sich plötzlich über hundert nördliche See-Elefanten (Mirounga angustirostris) auf Drakes Beach breit [].“"
                            },
                            {
                                "example_id": "afa37646-da14-4e11-917e-c5dfc04d1142",
                                "sense_id": "b09b3d69-5e16-3070-8865-e442af31ba24",
                                "text": "„Menschen werden aber erstmal nur in kleinen Gruppen zum Strand dürfen, um die See-Elefanten aus ungefähr 30 Metern Entfernung anzugucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
