                        "entry_id": "1b2ae702-ca64-301b-88ba-e05fb87b0bb8",
                        "glosses": [
                            "To separate into two parts, to classify into two classes, or to categorize into two categories."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "03ca3201-bb9c-49b1-92c0-dfbc8360756b",
                                "sense_id": "b94519d7-9b1f-30de-8cc0-657c96cb103e",
                                "text": "The apostolical benediction dichotomizes all good things into grace and peace."
                            },
                            {
                                "example_id": "da674860-a32a-4bd1-b424-f9818a74a127",
                                "sense_id": "b94519d7-9b1f-30de-8cc0-657c96cb103e",
                                "text": "Also, societies cannot be dichotomized into hunter-gatherer bands and agricultural civilizations."
                            }
                        ]
                    },
                    {
                        "sense_id": "af50c8b7-032c-3756-92f9-4bb78b8cd601",
                        "entry_id": "1b2ae702-ca64-301b-88ba-e05fb87b0bb8",
                        "glosses": [
                            "To be divided into two."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8bc66312-18b3-3d4b-8466-d6604001a061",
                        "entry_id": "1b2ae702-ca64-301b-88ba-e05fb87b0bb8",
                        "glosses": [
                            "To exhibit as a half disk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c9032a2-6ded-4442-ba9a-a7237d128375",
                                "sense_id": "8bc66312-18b3-3d4b-8466-d6604001a061",
                                "text": "If the moon was a perfectly smooth sphere […] the place when she was dichotomized, […] would depend upon the sun's distance from the earth."
                            }
                        ]
                    }
