        "fr-extract.jsonl": [
            {
                "entry_id": "2e6ebe85-ea90-3acb-93bb-cfaa4aca4168",
                "word": "lipophile",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5705cef4-8477-47d2-b5fb-746fc185900a",
                        "entry_id": "2e6ebe85-ea90-3acb-93bb-cfaa4aca4168",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "lipophiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0993ea90-fa3d-38bc-a6a1-a4bd5edc6c08",
                        "entry_id": "2e6ebe85-ea90-3acb-93bb-cfaa4aca4168",
                        "glosses": [
                            "Qualifie la portion de certaines molécules ayant une affinité avec les solvants organiques, et évitant d’être en contact avec un solvant polaire, comme l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb43e8a2-bfcc-4297-af88-5ef4e36fc9ab",
                                "sense_id": "0993ea90-fa3d-38bc-a6a1-a4bd5edc6c08",
                                "text": "La chaîne carbonée de l’éthanol est lipophile, contrairement à son groupe hydroxyle."
                            },
                            {
                                "example_id": "3743648e-b054-423b-86af-82e6e55dd266",
                                "sense_id": "0993ea90-fa3d-38bc-a6a1-a4bd5edc6c08",
                                "text": "Les savons sont des molécules dont une partie est hydrophile, l’autre lipophile, soluble dans un corps gras."
                            },
                            {
                                "example_id": "e6e1b577-41ae-4129-8116-9607ab0538df",
                                "sense_id": "0993ea90-fa3d-38bc-a6a1-a4bd5edc6c08",
                                "text": "Les molécules de tensioactifs utilisées dans les émulsions d’huile dans l'eau ayant une extrémité hydrophile (attirée par l’eau) et une extrémité lipophile (attirée par l’huile), elles se disposent à la surface des gouttelettes en présentant leur extrémité lipophile vers l’intérieur de la goutte et leur partie hydrophile vers l'extérieur, ce qui empêche les contacts directs entre les gouttes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c76c7c52-5b3d-3a07-8569-cd04dfc704d3",
                        "entry_id": "2e6ebe85-ea90-3acb-93bb-cfaa4aca4168",
                        "glosses": [
                            "Se dit d’une substance chimique très soluble dans les corps gras."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "48a87058-1afb-4d1b-9a10-b72c931707c4",
                                "sense_id": "c76c7c52-5b3d-3a07-8569-cd04dfc704d3",
                                "text": "Une pommade lipophile pénètre mieux la peau."
                            },
                            {
                                "example_id": "c81f36c3-57dd-4b6e-9ffc-3fe243f6e86d",
                                "sense_id": "c76c7c52-5b3d-3a07-8569-cd04dfc704d3",
                                "text": "Quand les émulsions sont fortement battues, à proportions d’huile et d’eau fixées, les gouttelettes d’huile sont plus nombreuses et plus petites : les arômes lipophiles ont moins de distance à parcourir pour atteindre la surface des gouttes."
                            },
                            {
                                "example_id": "ebed22bc-8b02-4e7e-a0f9-d1d8ac1284fd",
                                "sense_id": "c76c7c52-5b3d-3a07-8569-cd04dfc704d3",
                                "text": "Comme le THC, le cannabidiol est lipophile et s'accumule dans les tissus gras au premier rang desquels le cerveau."
                            },
                            {
                                "example_id": "0a37afd2-aa9b-4fab-bcc5-15a67457a19b",
                                "sense_id": "c76c7c52-5b3d-3a07-8569-cd04dfc704d3",
                                "text": "La plupart des 1500 molécules chimiques de pesticides et autres substances organiques (qui comportent de nombreux atomes de carbone) actuellement en circulation en Europe et dans le monde sont précisément lipophiles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca26f1f0-a712-4732-80b7-17a9c21714ec",
                        "source_entry_id": "2e6ebe85-ea90-3acb-93bb-cfaa4aca4168",
                        "target_lang_word": "lipophil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lipophil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eea33a7-998f-3383-b83e-ff5bcc67cdda",
                                        "entry_id": "a733304b-9689-31e2-87d3-035241dbc5fc",
                                        "glosses": [
                                            "im Fett löslich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0794f53f-2665-4cbf-b714-cd8f0fda7687",
                                                "sense_id": "8eea33a7-998f-3383-b83e-ff5bcc67cdda",
                                                "text": "Er stützt sich auf die Hypothese, dass Borrelien ein fettliebendes (lipophiles) Toxin produzieren."
                                            },
                                            {
                                                "example_id": "48470004-660b-4db8-b5a8-be42541572fb",
                                                "sense_id": "8eea33a7-998f-3383-b83e-ff5bcc67cdda",
                                                "text": "Lipophile und hydrophile Farbstoffe reichern sich nach ihrer Löslichkeit in unterschiedlichen Kompartimenten an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4926d356-97df-3b6a-a335-51e6304cce00",
                                        "entry_id": "a733304b-9689-31e2-87d3-035241dbc5fc",
                                        "glosses": [
                                            "zur extremen Anlagerung von Fett neigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e225ab8-f087-4653-9069-4e677eaa0a67",
                                                "sense_id": "4926d356-97df-3b6a-a335-51e6304cce00",
                                                "text": "In Abhängigkeit von Lipophilie und pKa-Wert werden Anästhetika im lipophilen Gewebe aufgenommen, sodass vor allem bei Injektion in das Fettgewebe mit einer starken Anreicherung unmittelbar an der Injektionsstelle gerechnet werden muss."
                                            },
                                            {
                                                "example_id": "3f79766c-3bfc-41f0-8307-6fb772f0eb5a",
                                                "sense_id": "4926d356-97df-3b6a-a335-51e6304cce00",
                                                "text": "Nach 1948 entwickelte sich bei Frauen über 40 Jahren und einer Gewichtszunahme von über 25 kg eine lipophile Dystrophie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
