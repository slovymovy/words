                        "glosses": [
                            "Donner un caractère sensuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cbc0e88-5887-4df7-88b8-64f575de39f4",
                                "sense_id": "006ca5b9-527f-33a5-a63a-66b178867729",
                                "text": "L’homme, lui, ne peut qu’intellectualiser sa relation à l’univers, alors que la femme va au contraire la sensualiser."
                            },
                            {
                                "example_id": "429d9a8d-c824-4806-a6cf-3f8d89334b86",
                                "sense_id": "006ca5b9-527f-33a5-a63a-66b178867729",
                                "text": "Voir est sentir, ouvrir la vue, sensualiser le visible."
                            }
                        ]
                    }
