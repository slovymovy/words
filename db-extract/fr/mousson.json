                    {
                        "sense_id": "d314a05f-bae1-3d31-932e-20f9a3685d57",
                        "entry_id": "a9e23149-1ea5-39ad-b644-96bc2f9bdd89",
                        "glosses": [
                            "Vent qui souffle périodiquement dans l’océan Indien, six mois du même côté, et six mois du côté opposé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32dd249e-ee27-4911-b3df-8001e16e7fad",
                                "sense_id": "d314a05f-bae1-3d31-932e-20f9a3685d57",
                                "text": "Le régime des moussons."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ad9793b-f44f-3ba3-98a8-e1d28f9355b5",
                        "entry_id": "a9e23149-1ea5-39ad-b644-96bc2f9bdd89",
                        "glosses": [
                            "Vent périodique des tropiques."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d217ad78-b200-446c-b84a-88a570366356",
                                "sense_id": "0ad9793b-f44f-3ba3-98a8-e1d28f9355b5",
                                "text": "Mais nous leur montrerons qu’on peut, sans eux, courir des bordées contre les moussons de l’océan Pacifique !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c70009a4-8b6e-3383-a1ff-f091c4fa98b3",
                        "entry_id": "a9e23149-1ea5-39ad-b644-96bc2f9bdd89",
                        "glosses": [
                            "Période où souffle ce vent."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "df448de9-db88-4751-81d1-c873f8995a8f",
                                "sense_id": "c70009a4-8b6e-3383-a1ff-f091c4fa98b3",
                                "text": "La mousson d’été, la mousson d’hiver."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba18fb78-02c9-309c-bd23-8815a9bcc687",
                        "entry_id": "a9e23149-1ea5-39ad-b644-96bc2f9bdd89",
                        "glosses": [
                            "Mousson de canard : pâté de foie de canard de consistance légère et mousseuse."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01719f40-6482-4b29-9384-719ae956218e",
                        "source_entry_id": "a9e23149-1ea5-39ad-b644-96bc2f9bdd89",
                        "target_lang_word": "Monsun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monsun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                        "entry_id": "357430a6-1448-3fd3-8810-872f6a14243d",
                                        "glosses": [
                                            "immer wiederkehrendes, feuchtes (im Sommer) bzw. trockenes (im Winter) Windsystem, das starken Einfluss auf das Klima der Subtropen (Rossbreiten) hat, weniger in den Tropen (am Äquator), weil hier der jahreszeitliche Temperaturunterschied zu gering ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871e9740-d0f3-4bdb-899e-a3444f1bece4",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Viele Monsune haben eine starke wirtschaftliche Bedeutung für einzelne Länder."
                                            },
                                            {
                                                "example_id": "5cf8b5ab-de76-4a47-8e1d-f1361026fe7f",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Monsune ändern nur alle halben Jahre ihre Richtung."
                                            },
                                            {
                                                "example_id": "89837fc7-1cfd-47ea-a4c1-d2be83a7748e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Nachdem der Monsun immer wieder Flutwellen in die Bucht getrieben hatte, musste ein Teil Victorias versetzt werden.“"
                                            },
                                            {
                                                "example_id": "bdd6f029-2db7-4d34-b83d-d7786339b18e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Er musste dabei den Stand der Ernte unter den Bedingungen des Monsuns beurteilen, die einmal besser, einmal schlechter sein konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34152d5e-4cb0-459d-9a69-1ac72537e8c6",
