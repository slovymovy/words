                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01883d8b-91d1-441c-9781-c7a6fd6d24f9",
                                "sense_id": "c0fc55df-b2fd-3ea0-b89a-e84dfe8d412a",
                                "text": "„Wir kamen in ein Zimmer und sahen einen großen, ringsum mit vornehmen Leuten besetzen Tisch, die Pharao spielten; der Fürst hielt die Karten, und die Bank schien in Sovrano-Münzen und Dukaten wohl über dreizehn- oder vierzehntausend Gulden zu verfügen.“"
                            },
                            {
                                "example_id": "0bcddc04-5207-42da-b97e-e74340938e51",
                                "sense_id": "c0fc55df-b2fd-3ea0-b89a-e84dfe8d412a",
                                "text": "„Ich besaß die Standhaftigkeit, den ganzen Karneval zu verbringen, ohne mein Geld im Pharao zu riskieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
