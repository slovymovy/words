                ],
                "senses": [
                    {
                        "sense_id": "19a11d95-d34a-3123-a27e-a8fd55f4e4c8",
                        "entry_id": "b62886dd-8d02-387c-8939-9495749ad17e",
                        "glosses": [
                            "Very liberal in giving or bestowing."
                        ],
                        "tags": [
                            "of a person or group"
                        ],
                        "examples": [
                            {
                                "example_id": "dc74e8a0-9df8-43dc-93ad-ffde0922ca30",
                                "sense_id": "19a11d95-d34a-3123-a27e-a8fd55f4e4c8",
                                "text": "Munificent as he was in his own disposition in the conferring of favours, his acceptance, under the circumstances we have described, of the fortune bestowed by Robert, he found upon reasoning with himself to be perfectly consistent with the most scrupulous principles of uprightness and probity:[…]"
                            },
                            {
                                "example_id": "68e0f8c5-ba59-4ad6-94da-5a9faee45e22",
                                "sense_id": "19a11d95-d34a-3123-a27e-a8fd55f4e4c8",
                                "text": "Tellson's Bank […] was a munificent house, and extended great liberality to old customers who had fallen from their high estate."
                            },
                            {
                                "example_id": "9875d001-49a6-40b0-95ea-99715a52afd1",
                                "sense_id": "19a11d95-d34a-3123-a27e-a8fd55f4e4c8",
                                "text": "[M]ilk producers are among the most munificent backers of political campaigns in the U.S."
                            },
                            {
                                "example_id": "f6919f2f-65b2-4c79-af86-0b98410d2c67",
                                "sense_id": "19a11d95-d34a-3123-a27e-a8fd55f4e4c8",
                                "text": "An exceptionally munificent benefactor of several institutions, he has given $100 million each to MIT and Harvard."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba323027-9758-33df-85dc-6856a7c393dd",
                        "entry_id": "b62886dd-8d02-387c-8939-9495749ad17e",
                        "glosses": [
                            "Very generous; lavish."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5116e036-443a-4bfa-b8fa-714ba24b6d1d",
                                "sense_id": "ba323027-9758-33df-85dc-6856a7c393dd",
                                "text": "On the hill, where kites used to be flown, stood the fine college which Mr Laurence's munificent legacy had built."
                            },
                            {
                                "example_id": "82128055-c414-4dd2-908d-7069ddfdbce0",
                                "sense_id": "ba323027-9758-33df-85dc-6856a7c393dd",
                                "text": "It was all very well for this casual youth to make her a present of a half million acres of land in this debonair way, but she could not persuade herself to accept so munificent a gift."
                            },
                            {
                                "example_id": "07871c7a-4ef3-4498-a6a5-a4d9d0d40926",
                                "sense_id": "ba323027-9758-33df-85dc-6856a7c393dd",
                                "text": "The machinists finally agreed to a munificent increase averaging 5.7% a year for three years."
                            }
                        ]
                    }
                ],
