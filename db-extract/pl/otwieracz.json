                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb263bd8-b8ed-4aec-ad58-94d35cb3864a",
                                                "sense_id": "a2c633c1-0157-3460-87bf-1fdcf78b5da5",
                                                "text": "Drück ja nicht den Öffner! Denn die Schwiegermutter soll noch ein wenig den Regen genießen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c46ce9c5-4c59-3ec8-b577-1159d54cdeef",
                                        "entry_id": "1a22d955-623e-39a0-a0ff-01c8e398a89a",
                                        "glosses": [
                                            "eine elektrische Vorrichtung beziehungsweise Schaltung, die den elektrischen Strom unterbricht"
