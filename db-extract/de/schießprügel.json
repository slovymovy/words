                                "example_id": "b013b48c-8be9-411b-a374-90a9f83df35b",
                                "sense_id": "57287854-063b-398a-a080-34da805dc667",
                                "text": "„Ganz schön schwer, so ein Schießprügel, wenn man den halten mußte.“"
                            },
                            {
                                "example_id": "bb731d80-95a1-40c6-a4e6-37cc5bdef7de",
                                "sense_id": "57287854-063b-398a-a080-34da805dc667",
                                "text": "„Er atmet den Feinstaub jeden Tag ein, denn mit seinem alten Schießprügel bewacht er die neuen Maschinen, die seit drei Jahren die Straße in den Fels treiben.“"
                            }
                        ],
