                                                "sense_id": "8796c66b-f5c0-3b53-b246-22f425b60a1a",
                                                "text": "Na pulpicie mam kilkanaście skrótów."
                                            },
                                            {
                                                "example_id": "6c9f0767-21d9-49ec-8658-a01122e7e47e",
                                                "sense_id": "8796c66b-f5c0-3b53-b246-22f425b60a1a",
                                                "text": "Dzięki tym skrótom można podejrzeć, otworzyć lub wstawić plik bez konieczności przechodzenia do lokalizacji, w której się znajduje"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
