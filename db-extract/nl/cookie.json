                    {
                        "sense_id": "f46ebce9-8573-3510-85b5-a5c8a9f9de07",
                        "entry_id": "9e84fae1-faad-3b93-805f-b7beeb878e79",
                        "glosses": [
                            "koekje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c487301-0134-4221-9a03-ebe26c0412ef",
                                "sense_id": "f46ebce9-8573-3510-85b5-a5c8a9f9de07",
                                "text": "Voor de thuiskok zijn er natuurlijk ook spectaculaire, zoetige desserts om te maken. Het recept van de brownie oreo chocholate chip cookie cheesecake is daar een goed voorbeeld van."
                            },
                            {
                                "example_id": "51e62960-c356-40bc-a194-6fa41e958f2e",
                                "sense_id": "f46ebce9-8573-3510-85b5-a5c8a9f9de07",
                                "text": "Het is een ware hype in Amerika waar nu ook Twentse zoetekauwen van kunnen genieten: rauw koekdeeg, oftewel cookie dough. De, naar eigen zeggen, eerste cookie dough bar van Overijssel opende eind vorige maand haar deuren aan de Heurne 47 in Enschede."
                            }
                        ]
                    },
                    {
                        "sense_id": "3915845d-8dbd-3840-ae53-8443fcfa6f39",
                        "entry_id": "9e84fae1-faad-3b93-805f-b7beeb878e79",
                        "glosses": [
                            "een stukje software op een website dat gegevens van bezoekers verzamelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4f5088-2a31-4d7a-91c3-eccd0b45f54e",
                                "sense_id": "3915845d-8dbd-3840-ae53-8443fcfa6f39",
                                "text": "Ook het Diakonessenhuis in Utrecht, een ziekenhuis, stuurt het surfgedrag van bezoekers door naar Facebook. Dat gebeurt ook als bezoekers pagina's met medische achtergrondinformatie bekijken. Als patiënten die pagina's bezoeken, kan Facebook dat zien. Door de gebruikelijke cookie-melding weg te klikken, geef je daar als gebruiker in principe toestemming voor."
                            },
                            {
                                "example_id": "722d2fbc-f211-41f0-a80f-debf93ac0333",
                                "sense_id": "3915845d-8dbd-3840-ae53-8443fcfa6f39",
                                "text": "De meeste ondervraagden zeggen dat ze privacy heel belangrijk vinden, maar minder dan de helft verwijdert cookies of controleert wat voor persoonlijke informatie ze op sociale media delen. Slechts één op de vijf surft incognito."
                            }
                        ]
                    }
