                "senses": [
                    {
                        "sense_id": "c413de91-c514-3a95-8583-9b6a3b7a64a5",
                        "entry_id": "849c0bc0-1c7b-3cb9-8509-1d721a5b02bd",
                        "glosses": [
                            "Gesamtheit der Aktivitäten zur Förderung der Gesundheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b587b512-646e-4136-ab76-17ad082b18d1",
                                "sense_id": "c413de91-c514-3a95-8583-9b6a3b7a64a5",
                                "text": "„Requiem gab vor, im Gesundheitssektor zu arbeiten, aber niemand in Stadtland wusste, was er wirklich trieb, einmal abgesehen von Entführungen und Einbrüchen im Polygon.“"
                            },
                            {
                                "example_id": "498d9b57-e28f-45d1-a962-383a747cfed1",
                                "sense_id": "c413de91-c514-3a95-8583-9b6a3b7a64a5",
                                "text": "„Dazu kommen oft starke Ungerechtigkeiten, hohe Kriminalität, Korruption, eine unfähige Regierung und Verwaltung, weit verbreitete Probleme im Gesundheitssektor, hoher Analphabetismus sowie eine unprofessionelle oder zensierte Presse, die das Land an seiner Entfaltung hindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
