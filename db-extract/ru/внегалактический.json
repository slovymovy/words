                "senses": [
                    {
                        "sense_id": "436f2bb5-ebd2-3c60-97fe-1ac6b4a4895b",
                        "entry_id": "a621d904-0a35-3c2c-b0d8-0db95e1ad0c4",
                        "glosses": [
                            "астрон. находящийся за пределами галактики"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee90c25-c281-40e1-b7c0-7cc27a0322a4",
                                "sense_id": "436f2bb5-ebd2-3c60-97fe-1ac6b4a4895b",
                                "text": "Как и в случае галактических источников, существование внегалактических ускорителей космических лучей ультравысокой энергии подтверждают данные детекторов гамма-излучения…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44068ae2-c1e2-4198-ad14-25448d2e8399",
                        "source_entry_id": "a621d904-0a35-3c2c-b0d8-0db95e1ad0c4",
                        "source_sense_id": "436f2bb5-ebd2-3c60-97fe-1ac6b4a4895b",
                        "target_lang_word": "extragalaktisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extragalaktisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "488aaf21-64f2-34f6-92dd-9a0598724a86",
                                        "entry_id": "97f14a1a-269e-3faf-affc-e851ce0769aa",
                                        "glosses": [
                                            "außerhalb der Galaxis liegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0702a8b5-4324-4dd8-bb4f-1553506ecf53",
                                                "sense_id": "488aaf21-64f2-34f6-92dd-9a0598724a86",
                                                "text": "„Und da man zudem genaue Entfernungsangaben benötigt, um Leuchtkraft, Masse und Größe astronomischer Objekte zu berechnen, hängt letztlich die gesamte extragalaktische Astronomie mehr oder weniger stark von der kosmischen Entfernungsskala ab.“"
                                            },
                                            {
                                                "example_id": "0436b5a5-4b76-4f2d-8944-8f1db3a59a32",
                                                "sense_id": "488aaf21-64f2-34f6-92dd-9a0598724a86",
                                                "text": "„So prachtvoll die Milchstraße für romantische Gemüter auch sein mag: Für Astronomen, die extragalaktische Sternsysteme erforschen, ist sie ein ständiges Ärgernis, denn sie versperrt die Sicht auf mehr als zwanzig Prozent des Kosmos und damit auf ein Fünftel aller Galaxien.“"
                                            },
                                            {
                                                "example_id": "995c9e7f-815a-4b98-b375-0aa57edb7bf5",
                                                "sense_id": "488aaf21-64f2-34f6-92dd-9a0598724a86",
                                                "text": "„Wenngleich die Entdeckung von Galaxien mit geringer Flächenhelligkeit erst vor kurzem die extragalaktische Astronomie umzukrempeln begann, kündigten sich die ersten Anzeichen dafür bereits vor zwanzig Jahren an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
