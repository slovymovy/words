                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6761b8b-5de2-31a3-81e6-c6d150392f49",
                        "entry_id": "75c896b8-82ce-38ae-83e4-93c8f6001c2b",
                        "glosses": [
                            "roofbouw plegen, van alle kracht ontdoen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "504980c3-c97b-46cd-980a-92cab9bd161e",
                                "sense_id": "f6761b8b-5de2-31a3-81e6-c6d150392f49",
                                "text": "Duizenden Grieken hebben maandagavond in Athene gedemonstreerd tegen het extreme bezuinigingsbeleid en tegen het bezoek van Angela Merkel. De Duitse bondskanselier is zowat de verpersoonlijking van het uitmergelen van de Griekse samenleving."
                            },
                            {
                                "example_id": "a39a2234-7537-40eb-a74e-f0457dc69a3b",
                                "sense_id": "f6761b8b-5de2-31a3-81e6-c6d150392f49",
                                "text": "Aan de Europese Unie zal in 2018 een einde komen. Het project zal instorten nadat de Zuid-Europese landen zich eerst omwille van de euro hebben laten uitmergelen en vervolgens nationalisme, separatisme en neofascisme de kop hebben opgestoken."
                            }
                        ]
                    }
