                    }
                ],
                "senses": [
                    {
                        "sense_id": "154bf183-1272-35c8-8441-aef18e916d62",
                        "entry_id": "76db60d1-c0a0-38d9-b4ab-8ca68619f723",
                        "glosses": [
                            "groter dan normaal potentiaalverschil, waardoor er te veel stroom gaat lopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8342c322-6228-42ff-bba3-255676568ba7",
                                "sense_id": "154bf183-1272-35c8-8441-aef18e916d62",
                                "text": "TNO constateert dat al in februari 2019 een zogenoemde nuldraad niet goed is vastgezet in de elektrische installatie van AFS. Dat bleef zonder gevolgen omdat een Uninterruptible Power Supply (UPS) de spanning doorgaf. Pas toen deze UPS op 24 juli tijdelijk werd uitgeschakeld vanwege onderhoudswerkzaamheden, ontstond overspanning. Hierdoor brandden een aantal componenten door en trad volgens protocol een Emergency Shut Down (ESD) in werking."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c77ef35-8e4d-3ad4-b8eb-64a1351da413",
                        "entry_id": "76db60d1-c0a0-38d9-b4ab-8ca68619f723",
                        "glosses": [
                            "extra potentiaalverschil dat bij elektrolyse nodig is om de elektrodereactie te laten verlopen in vergelijking met de evenwichtssituatie\\nDit kan worden opgevat als de benodigde activeringsenergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7cc2db1-83d2-400c-ae12-e00b50bfb4c4",
                                "sense_id": "8c77ef35-8e4d-3ad4-b8eb-64a1351da413",
                                "text": "Voor een maximaal rendement moet je hierbij elektroden gebruiken die werken bij een zo laag mogelijke overspanning. Theoretisch is voor het splitsen van water minimaal 1,23 V nodig, en alles wat daar boven zit is puur verlies."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd7762df-7a3b-3ab7-8111-59ce4b6f6b79",
                        "entry_id": "76db60d1-c0a0-38d9-b4ab-8ca68619f723",
                        "glosses": [
                            "verwisseling van trekdieren"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4963b001-f761-485b-9a4b-6853b55d1c90",
                                "sense_id": "cd7762df-7a3b-3ab7-8111-59ce4b6f6b79",
                                "text": "Na de overspanning reed het rijtuig heel wat sneller."
                            }
                        ]
                    }
                ],
