                        "examples": [
                            {
                                "example_id": "8ef87741-c004-4806-9340-48b8bdd580e4",
                                "sense_id": "35079009-190a-3dfa-b9d1-8414ef897658",
                                "text": "\" Sedert enige tijd hoorde men een groot gedruis aan de voorpoort der abdij."
                            },
                            {
                                "example_id": "a6fb8a8b-04e7-4471-a97a-beb6dc5f065c",
                                "sense_id": "35079009-190a-3dfa-b9d1-8414ef897658",
                                "text": "Voor twee dukaten gemiddagmaald met zuur vlees en pastinaak, daarbij het gelag inbegrepen, toen het valkenhuis naast de Voorpoort bezocht en mij wel gediverteerd met Zijne Majesteits grootvalkenier, die onder gedurig heen en weer lopen met een Noorse geervalk, geschenk van de koning van Denemarken bij 's Prinsen verheffing, uiteenzette hoe men een wilde vogel zeeg maakt door hem in uitgehongerde toestand aas aan te bieden uit de hand."
                            }
                        ]
                    }
