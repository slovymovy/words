                "senses": [
                    {
                        "sense_id": "b6701b6a-e01e-3511-91c1-99ab19f2cd46",
                        "entry_id": "20788b40-0bf8-3bc9-affe-7413c6ed6864",
                        "glosses": [
                            "Faire perdre son caractère fluide à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a24d9b-16f9-4716-b0a2-ee5292279b8c",
                                "sense_id": "b6701b6a-e01e-3511-91c1-99ab19f2cd46",
                                "text": "Cependant, il peut utiliser un fixateur universel dont la propriété est d’absorber toutes sortes d’influences maléfiques à condition de le « défluidiser » après chaque emploi sur un malade."
                            },
                            {
                                "example_id": "32a9a471-45a2-4c45-a207-79835247e5da",
                                "sense_id": "b6701b6a-e01e-3511-91c1-99ab19f2cd46",
                                "text": "Une partie de la poudre étant défluidisée, le débit qui traverse le lit est inférieur à U_f."
                            }
                        ]
                    }
