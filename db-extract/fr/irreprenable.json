                            {
                                "example_id": "c0588442-802b-41f8-8ccb-8a3de7f4827a",
                                "sense_id": "857e0a71-e952-3887-9d72-a9aefb9dae9f",
                                "text": "On va le voir lancer ses « cortadas » meurtrières, ou bondir sur une pelote que l’on croyait irreprenable."
                            },
                            {
                                "example_id": "c48af784-9f46-446d-9689-be260bae56ea",
                                "sense_id": "857e0a71-e952-3887-9d72-a9aefb9dae9f",
                                "text": "La première balle de service s’avérait « irreprenable » et l’Australien, malgré de timides aventures au filet où il réussissait à placer quelques petites balles coupées, laissait échapper le second set."
                            }
                        ]
                    },
                    {
