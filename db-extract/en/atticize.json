                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atticiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6655a304-3e1e-3d12-b254-cec05dafac90",
                                        "entry_id": "3c624e30-baf4-3752-b14c-119e1b1c3445",
                                        "glosses": [
                                            "Donner un caractère rappelant l’Attique à quelque chose, helléniser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad9acdc-1790-4e77-b28f-897e07d385c3",
                                                "sense_id": "6655a304-3e1e-3d12-b254-cec05dafac90",
                                                "text": "Cela s'appelait helléniser les Barbares, atticiser Rome, ou, peut-être, immuniser la Ville contre la mort."
                                            },
                                            {
                                                "example_id": "bab1538e-30ae-4596-8506-276436442b0a",
                                                "sense_id": "6655a304-3e1e-3d12-b254-cec05dafac90",
                                                "text": "J’entrevoyais la possibilité d’helléniser les barbares, d’atticiser Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8baff3df-bad6-30d8-a3a4-7cad9a87f763",
                                        "entry_id": "3c624e30-baf4-3752-b14c-119e1b1c3445",
                                        "glosses": [
                                            "Utiliser la langue grecque classique, en privilégiant le vocabulaire, la morphologie et la syntaxe des auteurs athéniens du cinquième et du quatrième siècle av. J.-C."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1150d91d-5bc5-4b5c-bc55-82b35d175bea",
                                                "sense_id": "8baff3df-bad6-30d8-a3a4-7cad9a87f763",
                                                "text": "Elle suit assez exactement les traditions de ceux qui, par réaction contre la négligence et la laideur de la langue commune, s'étaient remis à atticiser, de ceux du moins qui atticisaient sans pédantisme."
                                            },
                                            {
                                                "example_id": "1190bcdb-39cb-4f4d-8da7-1c9ab56d1c99",
                                                "sense_id": "8baff3df-bad6-30d8-a3a4-7cad9a87f763",
                                                "text": "Mais Psellus était un savant, nourri de la lecture des anciens, et cherche manifestement, quand il le peut et qu'il y pense, à atticiser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
