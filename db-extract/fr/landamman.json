                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2057fa-0ace-4a68-a588-662fffadc568",
                                "sense_id": "2e302d06-6c95-374e-a4e8-299390e98126",
                                "text": "Rapport présenté à Mr. le landamman et à la haute Diète des dix-neuf cantons."
                            },
                            {
                                "example_id": "5386d974-4e31-4d5e-8f60-ac30a81296aa",
                                "sense_id": "2e302d06-6c95-374e-a4e8-299390e98126",
                                "text": "Le landamman du canton d'Unterwalden a fait adresser au gouvernement fédéral un long rapport, dans lequel, etc."
                            },
