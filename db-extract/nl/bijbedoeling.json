                                        "sense_id": "c5e87b4b-718d-3c45-aa67-1312925602d6",
                                        "entry_id": "207821fe-cc54-3df8-8113-de0219bd5be0",
                                        "glosses": [
                                            "Absicht, die das Handeln einer Person beeinflusst, aber nicht offen ausgesprochen wird; verdecktes Motiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3586e0b0-caad-42c2-93a2-662e799e42be",
                                                "sense_id": "c5e87b4b-718d-3c45-aa67-1312925602d6",
                                                "text": "Obama hat die Auszeichnung an Frau Merkel wohl kaum ohne Hintergedanken vergeben."
                                            },
                                            {
                                                "example_id": "3ba89be8-3ee5-4091-80eb-71a8deca9673",
                                                "sense_id": "c5e87b4b-718d-3c45-aa67-1312925602d6",
                                                "text": "„Ein junger Kerl bot ihr sein besticktes Taschentuch an, aus reiner Höflichkeit, ohne Hintergedanken.“"
                                            },
                                            {
                                                "example_id": "9fb7cfcf-ef7d-480a-ba0c-853ab4b3f656",
                                                "sense_id": "c5e87b4b-718d-3c45-aa67-1312925602d6",
                                                "text": "„Alles Hallodrihafte war fern und die Nebengedanken und Hintergedanken machten mal Pause.“"
                                            },
                                            {
                                                "example_id": "33a93f27-a931-4327-9cc7-1372b488ca3b",
                                                "sense_id": "c5e87b4b-718d-3c45-aa67-1312925602d6",
                                                "text": "„Pierre aber liess nun die Auffassung des Fürsten Andrej ohne irgendeinen Hintergedanken gelten.“"
                                            },
                                            {
                                                "example_id": "2b209630-d5b4-4317-a630-118697538dc0",
                                                "sense_id": "c5e87b4b-718d-3c45-aa67-1312925602d6",
                                                "text": "„In gutem Französisch unterrichtete sie mich über ihre klägliche Lage, ohne Hintergedanken und ohne jene Zaghaftigkeit, die wohl der Furcht entspringt, der Zuhörer werde die Notlage, die man ihm anvertraut, nur auszunutzen suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
