                "senses": [
                    {
                        "sense_id": "7733dcdd-99dc-3009-9bff-4d643677b1e4",
                        "entry_id": "1a6a68ca-613a-3356-834c-a75f2f884797",
                        "glosses": [
                            "südlicher Stadtteil von Delhi, der der Regierungssitz der Republik Indien ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebca3dfa-ec6b-4f9d-a97b-91dbe8f39972",
                                "sense_id": "7733dcdd-99dc-3009-9bff-4d643677b1e4",
                                "text": "„In Neu-Delhi herrscht während der heißen Jahreszeit eine trockene Hitze, die Umweltbelastung ist sehr hoch.“"
                            },
                            {
                                "example_id": "fff50eac-deb3-4237-bbec-2f79627f30c1",
                                "sense_id": "7733dcdd-99dc-3009-9bff-4d643677b1e4",
                                "text": "„In Neu-Delhi befinden sich eine große Anzahl hervorragender Museen für Geschichte, Kunst und Kunsthandwerk.“"
                            },
                            {
                                "example_id": "8840defb-2417-472c-8777-740bc074ee92",
                                "sense_id": "7733dcdd-99dc-3009-9bff-4d643677b1e4",
                                "text": "„Ob der Einsatz des sozialen Netzwerks der Polizei wirklich helfen wird, den Verkehr in Neu-Delhi unter Kontrolle zu bekommen, ist fraglich.“"
                            },
                            {
                                "example_id": "6737f56a-216b-4b42-8e08-e838b95c9cde",
                                "sense_id": "7733dcdd-99dc-3009-9bff-4d643677b1e4",
                                "text": "„Bei einer Hitze von 52 Grad Celsius können Menschen im Freien nicht überleben. So heiß wurde es Ende Mai [Anm.: 2024] in Indiens Hauptstadt Neu-Delhi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26e4e1c3-8a5b-4e24-be07-19b1fa9c6064",
                        "source_entry_id": "1a6a68ca-613a-3356-834c-a75f2f884797",
                        "source_sense_id": "7733dcdd-99dc-3009-9bff-4d643677b1e4",
