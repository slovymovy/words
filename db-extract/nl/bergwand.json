                    },
                    {
                        "translation_id": "7c4a7d43-358c-4611-b264-08e561f2c4b0",
                        "source_entry_id": "a1969bd9-4f69-3745-b37c-251e1945c436",
                        "source_sense_id": "7e8154e5-ffbb-3ef1-9269-881e51e6e1fb",
