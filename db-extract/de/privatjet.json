                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dac6a55b-b6f9-4391-b187-73fb712f5199",
                                "sense_id": "ff31058e-0314-39ad-8006-ec262454513e",
                                "text": "„Während im Hause Schumacher und Vettel das letzte Hemd für den Kartmotor gegeben wurde, flog Nico Rosberg schon mal im Privatjet seines Vaters zum Kartrennen ein.“"
                            },
                            {
                                "example_id": "3c7f4a01-5eb9-4fcc-888a-81eab81fb06a",
                                "sense_id": "ff31058e-0314-39ad-8006-ec262454513e",
                                "text": "„Ihre Assistentin lässt am Flughafen Le Bourget einen Privatjet bereitstellen.“"
                            }
                        ],
