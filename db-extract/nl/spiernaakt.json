                "senses": [
                    {
                        "sense_id": "3a69f93a-eb0c-30b0-9742-f9f88e6cc92d",
                        "entry_id": "443d8952-f83f-3943-8ebe-d23d3c4cbe5a",
                        "glosses": [
                            "helemaal zonder kleren aan te hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd39789b-90a5-4ac9-a62b-43c213a4d0b6",
                                "sense_id": "3a69f93a-eb0c-30b0-9742-f9f88e6cc92d",
                                "text": "Wij moeten zijn vriend worden. Jan Decorte zegt het meermaals in Stand down, waarin hij het seksuele ontluiken uit zijn jeugd opdist. Zijn spiernaakte wederhelft Sigrid Vinks danst zijn verhalen aan elkaar. Haar bewegingen zijn halve turnoefeningen, ontwapenend en beheerst: een lichaam dat zichzelf opmeet. Naast haar speelt Black Box Revelation snedige rock."
                            },
                            {
                                "example_id": "57a16c86-f26e-4691-8380-ccb70320275d",
                                "sense_id": "3a69f93a-eb0c-30b0-9742-f9f88e6cc92d",
                                "text": "De geestigste naaktscène komt voor in Redoubtable, een biografische speelfilm over de grillige Nouvelle Vague-regisseur Jean-Luc Godard. Twee vertolkers, die filmacteurs spelen, lopen spiernaakt door het beeld om onderling te overleggen of zij wel bereid zijn om in een film van Godard helemaal bloot voor de camera te verschijnen."
                            }
                        ]
                    }
