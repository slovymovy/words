                    },
                    {
                        "translation_id": "c69ee647-7479-4bf5-b65b-ab1c2b1cbd9d",
                        "source_entry_id": "c6cbb96b-ae37-3483-a79a-9679d5b8355d",
                        "source_sense_id": "bea06ef3-843a-3248-8333-2154e2913fae",
                        "source_sense_description": "sidelocks worn by Hasidic and Orthodox male Jews",
                        "target_lang_word": "papillote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papillote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Morceau de papier dont on enveloppe les cheveux que l’on met en boucles, pour les friser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e57e4ee-6753-42b9-8fb7-1bef31408eec",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Le Marquis.– Blanche m’a donné le fer à papillotes… Le voici…"
                                            },
                                            {
                                                "example_id": "3aa55370-e3c9-4cec-9014-b9e30c146c40",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Mettre les cheveux dans des papillotes."
                                            },
                                            {
                                                "example_id": "e42a2c11-3169-444e-b52a-511636cf8352",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Mettre des papillotes."
                                            },
                                            {
                                                "example_id": "f325d15b-8aec-4049-a8f6-3254948f5d67",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Fer à papillotes."
                                            },
                                            {
                                                "example_id": "cbbc01b6-da6c-4382-ab93-a3121b6c6405",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "De chaque côté des tempes il passait des boucles échappées de leurs papillottes ^([sic]) en papier gris."
                                            },
                                            {
                                                "example_id": "b6db7551-aa8d-43ec-8fcd-5d0a51b797f0",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "D’autres, des railleurs, roulent ces lettres pour en allumer leur cigare, ou les donnent à leurs femmes qui s’en font des papillotes."
                                            },
                                            {
                                                "example_id": "d115c03b-67e2-4d97-95d1-e7872d91c373",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Ses cheveux abondants et noirs venaient de recevoir les dernières façons des mains de la coiffeuse, dont la tâche avait dû être assez compliquée, à en juger par la quantité de papillotes de papier brouillard qui jonchaient le tapis autour de la toilette."
                                            },
                                            {
                                                "example_id": "5670e599-5ee4-450a-bf65-7d06147c640d",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Sur le devant des maisons, de jeunes gars se tenaient, graves et cérémonieux, vêtus de leurs habits de dimanche, et des petites filles, aux figures joufflues, avaient leurs boucles blondes enchevêtrées de papillotes."
                                            },
                                            {
                                                "example_id": "37eb9964-e8b2-406b-9c38-342cbe452037",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Eh bien, vos contrats, vous les prenez, vous les roulez, et vous vous faites des papillotes pour friser…"
                                            },
                                            {
                                                "example_id": "f048afb0-c14c-4271-bdfe-a3ba8c2f1062",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "être en papillotes, avoir la tête en papillotes, avoir les cheveux dans des papillotes."
                                            },
                                            {
                                                "example_id": "0d524666-0b01-4a83-8a89-c7fba778366c",
                                                "sense_id": "c5cc9aa0-1042-3143-a654-f0cf83ebb0af",
                                                "text": "Cela n’est bon qu’à faire des papillotes, se dit d’un écrit sans mérite, d’un papier sans valeur, bon à mettre au rebut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3024cf11-08d5-3c08-8532-5f7fbc2cd03c",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Mèche de cheveux frisée avec ce papier ou au fer."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c78f4a72-2302-41f4-bc51-902b3e91f9f2",
                                                "sense_id": "3024cf11-08d5-3c08-8532-5f7fbc2cd03c",
                                                "text": "Elle était nu-tête, de longues papillotes à l'anglaise, d'un blond cendré, tombaient avec une grâce exquise sur ses épaules décolletées."
                                            },
                                            {
                                                "example_id": "e73777d3-1aaa-43b4-a280-816e484bb953",
                                                "sense_id": "3024cf11-08d5-3c08-8532-5f7fbc2cd03c",
                                                "text": "Ses papillotes noires — ses pauvres bien-aimées papillotes qui n'ont pas changé de forme, mais qui sont, hélas ! éclaircies et toutes blanches aujourd'hui — n'étaient alors mêlées d'aucun fil d'argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1345b0f-05bc-3e63-8bbc-2d8b042b7e41",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Mèche de cheveux allant de paire de chaque côté du visage, typiques des hommes juifs orthodoxes."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "966d4e86-3367-4817-959f-3fdf7c27e2ca",
                                                "sense_id": "d1345b0f-05bc-3e63-8bbc-2d8b042b7e41",
                                                "text": "Une vingtaine de jeunes gens, […] en chapeau rond, avec de longues papillotes tombant sur leur visage"
                                            },
                                            {
                                                "example_id": "74bf7635-dcce-43e2-9f48-5e3a3fe711ee",
                                                "sense_id": "d1345b0f-05bc-3e63-8bbc-2d8b042b7e41",
                                                "text": "Au bureau voisin se pressait en désordre dans les piaillements, les injures, les coups de coude, les pieds écrasés, la faune des émigrants : jeunes hassidim en redingotes et chapeaux de feutre noir, visages mangés par des barbes roussâtres, papillotes en bataille ; Italiens plus bruyants et rigolards que tous les autres ; réfugiés d’Europe centrale aux visages gris, aux yeux brillants d’anxiété, taciturnes, pressés de mettre un océan et l’enfer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd029797-fde2-3c90-9350-2a295737c541",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Enveloppe faite d’une feuille de papier pour éviter la dessiccation des aliments lors de la cuisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa0c523-82aa-4ec4-874e-76dbff58b5f1",
                                                "sense_id": "bd029797-fde2-3c90-9350-2a295737c541",
                                                "text": "Ajoutez un filet d'huile d'olive, puis saupoudrez d’herbes de Provence. Refermez soigneusement les papillotes. Faites-les cuire doucement au barbecue 20 à 25 minutes."
                                            },
                                            {
                                                "example_id": "ac303c3f-089d-46c9-a24b-68d5bff9df3f",
                                                "sense_id": "bd029797-fde2-3c90-9350-2a295737c541",
                                                "text": "Le saumon et l’oseille font un mariage classique, mais en papillote, c'est plus original !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8854a456-573f-32ad-b0d9-7da1c6c75f45",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Ornement de papier façonné et dentelé dont on entoure le manche d'un gigot ou d'une côtelette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9686322-9325-467f-8ccb-7325637ec677",
                                                "sense_id": "8854a456-573f-32ad-b0d9-7da1c6c75f45",
                                                "text": "Rangez les navets autour, mettez une papillote au manche du gigot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee3c8025-884d-3521-a8ab-a86aeba837d5",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Emballage individuel d'un bonbon, d'un fruit, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd08499f-e529-40cc-9d81-5e5dca034d2a",
                                                "sense_id": "ee3c8025-884d-3521-a8ab-a86aeba837d5",
                                                "text": "Lorsque les fruits importés sont enveloppés d'une papillote celle-ci doit être revêtue de l'indication d'origine en caractères d'au moins 4mm de haut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0109b3ce-7286-3c50-baf4-0bc927f4cdb0",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Dragée enveloppée dans un morceau de papier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ab281a-86f4-4480-86fc-ed5ff1aa1bf4",
                                                "sense_id": "0109b3ce-7286-3c50-baf4-0bc927f4cdb0",
                                                "text": "Quant à moi à nouveau rendue libre de toute appréhension je me jetais avec précipitation sur le cornet dans lequel je décelais, une orange, un jeanbonhomme, un pain d’épices à l’effigie du grand saint, et plaisir suprême, quelques papillotes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d582cc0e-22e4-3efe-bf7b-b7e351d131bd",
                                        "entry_id": "40022a9f-02e9-37dc-8ab4-398f6c3de2f8",
                                        "glosses": [
                                            "Cette friandise emballée avec une maxime et/ou un pétard."
                                        ],
                                        "tags": [
                                            "Lyonnais"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
