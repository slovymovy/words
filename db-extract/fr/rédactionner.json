                ],
                "senses": [
                    {
                        "sense_id": "f90f5ee2-7e38-3da9-882c-b64c997f4754",
                        "entry_id": "05e4a5c9-b3cc-3191-be24-46e0a1d10e5d",
                        "glosses": [
                            "Rédiger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e2935e-7513-4451-80a7-8e2a23ee8503",
                                "sense_id": "f90f5ee2-7e38-3da9-882c-b64c997f4754",
                                "text": "Nous avions pendant dix ans, expéditionné, collationné, rédactionné coude a coude, sans trop nous abrutir, il est vrai, à ce travail mécanique, qui laissait à nos facultés intellectuelles toute liberté de s’exercer parallèlement sur des sujets plus attrayants."
                            },
                            {
                                "example_id": "d25aceb5-98e1-4a6b-8331-bc1b5e732287",
                                "sense_id": "f90f5ee2-7e38-3da9-882c-b64c997f4754",
                                "text": "Il se mit à monnayer ses conseils stylistiques aux élèves incapables de rédactionner une belle journée d’hiver et aux amoureux transis qui préféraient déléguer à la poste le soin de témoigner de leurs chatouillis d’âme."
                            },
                            {
                                "example_id": "d72abe6b-cb66-4982-9851-b69d90f2dd66",
                                "sense_id": "f90f5ee2-7e38-3da9-882c-b64c997f4754",
                                "text": "J’ai déjà rédactionné deux pages et j’attaque ma troisième."
                            }
                        ]
                    }
                ],
