                        "examples": [
                            {
                                "example_id": "cf37c4dc-c9cf-4f94-9577-7dade480fbc1",
                                "sense_id": "ed58a124-5b9d-318a-8acc-8d0ac25096e2",
                                "text": "„Zum Hochadel konnte man wohl nur durch Geburt oder Einheirat gehören.“"
                            },
                            {
                                "example_id": "6be35ab6-0edc-4772-815f-57b881243bbf",
                                "sense_id": "ed58a124-5b9d-318a-8acc-8d0ac25096e2",
                                "text": "„An diesem Abend suchte ihn der Häuptling an seinem letztn irdischen Lager auf, sprach ihm nach ernsthafter Pfeife in gebrochenen Worten karge Bewunderung aus und eröffnete ihm schließlich den Vorschlag sühnender Einheirat in Pflichten und Rechte des erschossenen Kriegers.“"
                            }
                        ],
