                                    {
                                        "sense_id": "04e37443-b3b4-3174-bdc7-032721a3dcc1",
                                        "entry_id": "bf59ac79-c80b-321d-9cc2-8d4c323c584c",
                                        "glosses": [
                                            "D’une manière qui n’est pas probable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af3d928-3614-4fdf-80aa-69801551b59f",
                                                "sense_id": "04e37443-b3b4-3174-bdc7-032721a3dcc1",
                                                "text": "Afin que ces étincelles de vie apparaissent pour ce qu’elles sont, de véritables regains, il faut bien développer un peu, par contraste, de quels gouffres elles ont improbablement jailli."
                                            },
                                            {
                                                "example_id": "e2547a8c-8400-4ec5-b2a6-1e4a32db8f7d",
                                                "sense_id": "04e37443-b3b4-3174-bdc7-032721a3dcc1",
                                                "text": "Il y a ces noms sexistement débiles, comme femme de ménage ou garçon de café. Il y a ce nom improbablement différent selon le sexe, et jamais naturel : le saxon steward devenant hôtesse de l'air."
                                            },
                                            {
                                                "example_id": "6f369c22-0fc4-42c4-8b52-d877cdc3b0d3",
                                                "sense_id": "04e37443-b3b4-3174-bdc7-032721a3dcc1",
                                                "text": "C’est parce que son masque immobile de cuivre\n S’est improbablement et doublement fendu\n Pour deux pâles iris où le cœur éperdu\n Se noie, et sans lesquels on ne saurait plus vivre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d719ad56-bca2-40fb-b980-1dd4a566d7da",
                        "source_entry_id": "fbc51fb2-c364-3418-b467-27fc8ce3f5dc",
                        "source_sense_id": "a4befd76-6659-3bdd-86e1-af140b76fc7f",
                        "source_sense_description": "in an improbable manner",
                        "target_lang_word": "unwahrscheinlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwahrscheinlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                        "entry_id": "d612f12c-5f11-3365-a0a0-687952d2c4a3",
                                        "glosses": [
                                            "nicht wahrscheinlich; mit geringer Wahrscheinlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1c75c3-9615-41f8-8f26-4fb786678395",
                                                "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                                "text": "Im Lotto zu gewinnen ist höchst unwahrscheinlich."
                                            },
                                            {
                                                "example_id": "a57fdd52-8093-48e4-985d-a5f5829801b1",
                                                "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                                "text": "„Denn selbst wenn es für die Wohnung bereits einen Nachmieter gibt, so ist es aktuell eher unwahrscheinlich, dass er oder sie demnächst einzieht.“"
                                            },
                                            {
                                                "example_id": "760e8f8d-0509-4124-9e26-a66aa416eaed",
                                                "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                                "text": "„Die Regierungen der Welt haben sich im Paris-Abkommen verpflichtet, die Erderhitzung bei deutlich unter 2 Grad und möglichst bei 1,5 Grad zu begrenzen. Das erscheint aber zunehmend unwahrscheinlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0435beb-3207-3949-9fd9-ed0ed6eacd9b",
                                        "entry_id": "d612f12c-5f11-3365-a0a0-687952d2c4a3",
                                        "glosses": [
                                            "sehr, übermäßig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ab5b6-c3ed-4447-829d-36924a19e596",
                                                "sense_id": "d0435beb-3207-3949-9fd9-ed0ed6eacd9b",
                                                "text": "Sie hatte bei der letzten Prüfung unwahrscheinliches Glück mit dem Thema gehabt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
