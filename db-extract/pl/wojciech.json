                        "cross_references": []
                    },
                    {
                        "translation_id": "ab91adb3-9ad6-4cc8-b2fc-b529cb121718",
                        "source_entry_id": "00b0606e-74ac-3ff0-99eb-a9d6cc86b3c0",
                        "source_sense_id": "0ce9c9c7-52f4-30e0-8dd6-9bb1ab805bd8",
                        "target_lang_word": "Vojtěch",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vojtěch",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1e8b504b-72cb-3308-ad63-2c6d9a52f0dd",
                                        "entry_id": "15415e77-2d49-309e-baed-78ec08234381",
                                        "glosses": [
                                            "mužské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c50a947-8592-447e-8e69-e2a4446b143d",
                                                "sense_id": "1e8b504b-72cb-3308-ad63-2c6d9a52f0dd",
                                                "text": "Ne každý ví, že katedrála sv. Víta na Pražském hradě je zasvěcena též dalším národním patronům, knížeti svatému Václavovi a svatému Vojtěchu Slavníkovci, druhému biskupu pražskému."
                                            },
                                            {
                                                "example_id": "dee746c5-f041-4028-ab63-f85a0809e7c6",
                                                "sense_id": "1e8b504b-72cb-3308-ad63-2c6d9a52f0dd",
                                                "text": "Teprve teď se rozhlédl, postál před obrazy, uvědomil si stojící věci — „Vojtěše, chudáčku,“ ozval se výsměšně, „tak tady ty bydlíš? A sám? A máš tu dost místa pro celý život, pro celý život?)"
                                            },
                                            {
                                                "example_id": "b8729081-3952-4af1-98b6-7fce231336f1",
                                                "sense_id": "1e8b504b-72cb-3308-ad63-2c6d9a52f0dd",
                                                "text": "Vojtěch Bartošův byl v těch létech, kde se hoch už nemusí bát, že mu někdo z usedlejších vynadá holobrádků."
                                            },
                                            {
                                                "example_id": "77797bf5-6896-43be-86f5-9a2fb1e93cee",
                                                "sense_id": "1e8b504b-72cb-3308-ad63-2c6d9a52f0dd",
                                                "text": "Nu, milá babičko, nyní mi uvař dobré snídaní a potom pošli do Stožic pro Vojtěcha, že s ním musím mluvit, protože do večera umru.“"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Vojtěch",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "acddcf84-ec00-3439-abef-d1c30614c683",
                                        "entry_id": "cd74bc55-0124-38ea-a860-c129dec08eda",
                                        "glosses": [
                                            "české mužské příjmení"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23ef93ce-63f4-4088-8229-932fe8e2fc03",
                        "source_entry_id": "00b0606e-74ac-3ff0-99eb-a9d6cc86b3c0",
                        "source_sense_id": "0ce9c9c7-52f4-30e0-8dd6-9bb1ab805bd8",
                        "target_lang_word": "Adalbert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adalbert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b07d652-721c-335c-826a-fa4635dccbe7",
                                        "entry_id": "85350555-9479-3b80-a41c-289cbe139f57",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5041b8a6-ca05-43d6-a161-026124b731b9",
                                                "sense_id": "1b07d652-721c-335c-826a-fa4635dccbe7",
                                                "text": "Adalberts liebstes Steckenpferd ist das Voltigieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Adalbert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                        "entry_id": "9e5d04d4-98fc-3c5d-a402-e485abd59b56",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ba11ba-c70c-49c2-a318-d9b10726750d",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Frau Adalbert träumt seit ihrer Kindheit von einer eigenen Zementfabrik."
                                            },
                                            {
                                                "example_id": "97dc7857-b926-41b3-8c9c-2cde1ce11753",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Bei Adalberts von Gegenüber hängt stets eine Fahne von St. Pauli draußen."
                                            },
                                            {
                                                "example_id": "44973173-c4c2-4050-b6ae-e178250a6a29",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Herr Adalbert wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "1507c723-ab9f-4e7e-92af-26e8383e9001",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Die Adalberts kommen heute aus Bonn."
                                            },
                                            {
                                                "example_id": "f997d709-a556-4ec3-b7e7-5e45e0414338",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Der Adalbert trägt nie die Schals, die die Adalbert ihm strickt."
                                            },
                                            {
                                                "example_id": "71fc1368-3311-4e69-8ec2-f5ac3cb6a351",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Adalbert kommt, geht der Herr Adalbert.“"
                                            },
                                            {
                                                "example_id": "f7c92865-3d6e-44bb-8ef0-2dc7be7be25f",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Adalbert kommt und geht."
                                            },
                                            {
                                                "example_id": "366d5a6d-7550-4c7f-a2f4-253bdb20f1ef",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "Adalberts kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "fbcc617e-4cd8-4380-8db7-85d5cab98e56",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "An verregneten Herbsttagen ist Familie Adalberts liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "a022ef13-72d0-4fb5-93d2-8ec360fc92eb",
                                                "sense_id": "857985f6-c0ea-3054-ba81-a5f1bc7c8e30",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Adalbert das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23601d45-81c3-429e-b8c4-74e693b19fc1",
                        "source_entry_id": "00b0606e-74ac-3ff0-99eb-a9d6cc86b3c0",
                        "source_sense_id": "0ce9c9c7-52f4-30e0-8dd6-9bb1ab805bd8",
                        "target_lang_word": "Войцех",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Войцех",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c1ff79-29c0-3e98-b71a-984e422f0220",
                                        "entry_id": "014a25b1-2d73-3739-890a-007fb67021b2",
                                        "glosses": [
                                            "польское мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2749c531-933b-47ec-a713-f93188ce942c",
                                                "sense_id": "d9c1ff79-29c0-3e98-b71a-984e422f0220",
                                                "text": "После каждого очередного польского восстания шляхту ― офицерство ― ссылали на Кавказ, искупать грех кровью, а крестьянство ― в Красноярский край. Известное тебе село Шушенское ― сплошь из поляков… Мой прадед Войцех был отправлен на службу в Темир-Хан-Шуру, сейчас это Буйнакск, там была Ставка."
                                            },
                                            {
                                                "example_id": "9d91e0a9-3be1-432b-9ff2-32ebca0f62da",
                                                "sense_id": "d9c1ff79-29c0-3e98-b71a-984e422f0220",
                                                "text": "Войцех Ярузельский был единственным из руководителей соцстран, кто сумел договориться с антикоммунистической оппозицией (1989 год) и обеспечил выполнение договоренностей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
