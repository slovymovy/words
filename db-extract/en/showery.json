                        "glosses": [
                            "Given to showers; having frequent rainfall."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d0c83b4-df58-445f-a223-f2cad570e355",
                                "sense_id": "d42244ee-5ba0-3585-8ac5-2c73f706b7a5",
                                "text": "A gentleman goes forth on a showery and miry day. He returns immaculate in the evening with the gloss still on his hat and his boots."
                            },
                            {
                                "example_id": "139fb029-40aa-4d53-9a98-1fbd8dc92da5",
                                "sense_id": "d42244ee-5ba0-3585-8ac5-2c73f706b7a5",
                                "text": "The sun came out after what had been a showery morning, allowing the celebration to take place in the garden."
                            }
                        ]
                    },
                    {
                        "sense_id": "c01147d0-537b-372e-9ed7-94b1dcf00982",
                        "entry_id": "c6f8b9fe-e16c-3261-8f07-e051c69be42b",
                        "glosses": [
                            "Of or relating to a shower or showers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4e9d18-b399-47e8-968c-a6f3f4545532",
                                "sense_id": "c01147d0-537b-372e-9ed7-94b1dcf00982",
                                "text": "Over their heads a crystal firmament, / Whereon a sapphire throne, inlaid with pure / Amber, and colours of the showery arch."
                            },
                            {
                                "example_id": "c7be2a59-7530-43cb-a80d-735ace53597f",
                                "sense_id": "c01147d0-537b-372e-9ed7-94b1dcf00982",
                                "text": "She knew exactly how each of these trees would talk if only she could wake them, and what sort of human form it would put on. She looked at a silver birch: it would have a soft, showery voice and would look like a slender girl, with hair blown all about her face, and fond of dancing."
                            }
                        ]
