                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02ac47a7-8a24-433f-aeb4-1d319ef030ef",
                                "sense_id": "7a2315cb-1c41-30cf-a3eb-b164c3dcfd67",
                                "text": "Бисерные вышивки украшали головные уборы — бархатки, сборники, сороки, ряски, девичий венец, косник; шейные украшения — борок, нашейник, наборушник."
                            }
                        ]
