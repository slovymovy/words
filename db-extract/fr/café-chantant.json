                    {
                        "sense_id": "05a395bb-76de-3843-8762-588ca450e980",
                        "entry_id": "36dcdbc0-15db-320c-aa8b-12dd175c1748",
                        "glosses": [
                            "Établissement, à l’origine du café-concert, où le public payait en consommations le plaisir d’entendre des chanteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ec5c52-6308-477d-9667-d4ebccdf0915",
                                "sense_id": "05a395bb-76de-3843-8762-588ca450e980",
                                "text": "Or, le destin voulut qu’un soir, où il lui semblait que tout le marasme du département se fût aggloméré dans son crâne, il entrât, pour se distraire, dans un café-chantant où les camarades du mess lui avaient signalé une jolie fille."
                            },
                            {
                                "example_id": "8e16401d-becf-477d-805e-f6992928d1a8",
                                "sense_id": "05a395bb-76de-3843-8762-588ca450e980",
                                "text": "Elle avait pourtant doublé les fenêtres de rideaux à molleton, mais refusé de mettre son piano à la cave, ainsi que le commissaire de police le lui avait suggéré en prenant pour exemple les cafés-chantants de la cité."
                            }
                        ]
                    }
