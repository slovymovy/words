                        "target_lang_word": "Roch",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "022a9a95-893d-3b27-be02-fdeb97a8dc5a",
                                        "entry_id": "7bb6d69c-4232-3f09-81d1-bfae752feedf",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a44f90a-331d-4753-a7ca-6a0b467934f9",
                                                "sense_id": "022a9a95-893d-3b27-be02-fdeb97a8dc5a",
                                                "text": "Saint Roch, né à Montpellier en 1295, atteint de la peste, il se réfugia dans une forêt où il allait succomber s'il n'y avait été découvert par le chien d'un gentilhomme."
                                            },
                                            {
                                                "example_id": "6e8bf189-6cf5-46e5-8d7b-30548ea19cc4",
                                                "sense_id": "022a9a95-893d-3b27-be02-fdeb97a8dc5a",
                                                "text": "C'est saint Roch et son chien, se dit de deux personnes qui sont toujours ensemble."
                                            },
                                            {
                                                "example_id": "e99833af-c6f0-41a7-a653-512f67edd345",
                                                "sense_id": "022a9a95-893d-3b27-be02-fdeb97a8dc5a",
                                                "text": "Donner des bénédictions de saint Roch, maudire quelqu'un, ou en dire du mal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
