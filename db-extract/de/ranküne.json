                    },
                    {
                        "form_id": "731eb85b-9628-4c09-920d-0a6b58c5ec99",
                        "entry_id": "5f8d7e2a-8946-3d1d-a3df-2da1407aab36",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rankünen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0accb60b-0b7e-397a-9eac-388fd3cdb478",
                        "entry_id": "5f8d7e2a-8946-3d1d-a3df-2da1407aab36",
                        "glosses": [
                            "gehoben, veraltend: heimliche Feindschaft, Groll, Rachsucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd5902a3-2417-4483-9dba-b99f3fb43793",
                                "sense_id": "0accb60b-0b7e-397a-9eac-388fd3cdb478",
                                "text": "„Mag sein, es ist eine gewisse Ranküne bei dem, was er getan hat.“"
                            },
                            {
                                "example_id": "362040fb-e3d0-4a66-96d3-1748d78a0b2e",
                                "sense_id": "0accb60b-0b7e-397a-9eac-388fd3cdb478",
                                "text": "„Ist es ein heimlicher, hämischer, seiner selbst vielleicht uneigenständlicher Instinkt der Verkleinerung des Menschen? Oder etwa ein pessimistischer Argwohn, das Mißtrauen von enttäuschten, verdüsterten, giftig und grün gewordenen Idealisten? Oder eine kleine unterirrdische Feindschaft und Ranküne gegen das Christentum (und Plato), die vielleicht nicht einmal über die Schwelle des Bewußtseins gelangt ist?“"
                            },
                            {
                                "example_id": "6798c777-3593-412f-805a-2600fd821815",
                                "sense_id": "0accb60b-0b7e-397a-9eac-388fd3cdb478",
                                "text": "„Darum ist die Liebe,die Hoffmann auch weiterhin noch immer empfindet, nun von dumpfer Ranküne bemakelt, Ranküne, die freilich mit Aufschwüngen des Verzeihens wechselt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cda13b4d-e992-32a2-9f00-4c14bc0e3f1f",
                        "entry_id": "5f8d7e2a-8946-3d1d-a3df-2da1407aab36",
                        "glosses": [
                            "Handlung aus Ranküne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77ad35b-8921-451a-9aad-22d448711d4c",
                                "sense_id": "cda13b4d-e992-32a2-9f00-4c14bc0e3f1f",
                                "text": "„Dann kam der Teufel über sie: Du hast sie gemordet, und sie drohten. Beobachtung, Argwohn, Flüstereien überall, wohin ich kam, in London, Paris, Berlin. Um so satanischer, als ins Kalkül fielen meine Einsamkeit, Unthätigkeit, Nervosität, Provokationsgruben, der Chauvinismus, royalistische Verbindungen … Die in weiter Welt auf Revanche oder Ranküne lauernden Widersacher.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7997fb55-6674-4da7-9a41-de58e8b700d7",
                        "source_entry_id": "5f8d7e2a-8946-3d1d-a3df-2da1407aab36",
                        "source_sense_id": "0accb60b-0b7e-397a-9eac-388fd3cdb478",
                        "source_sense_description": "gehoben, veraltend: heimliche Feindschaft, Groll, Rachsucht",
                        "target_lang_word": "rancune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rancune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63aea732-bc78-3233-94a9-4eb1ec063d7a",
                                        "entry_id": "6b6cf398-d99d-3b34-b9ab-737e0fd2d772",
                                        "glosses": [
                                            "Ressentiment tenace, sentiment profond de mal-être, opinion négative envers quelqu’un suite à du mal, des offenses subies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48218bef-ba63-4ce3-a76e-454201e670b3",
                                                "sense_id": "63aea732-bc78-3233-94a9-4eb1ec063d7a",
                                                "text": "Le gros Léon, se montrant plus généreux, avait généralement de meilleurs tuyaux que son confrère, lequel, en secret, lui gardait bien un peu rancune de la chose."
                                            },
                                            {
                                                "example_id": "631e19f0-2df8-4670-8eb8-db7498d650da",
                                                "sense_id": "63aea732-bc78-3233-94a9-4eb1ec063d7a",
                                                "text": "La Pauvreté, ah! la garce! Elle va dans un cortège d'humiliations, de basses rancunes, de fangeuses abdications. Elle traîne, derrière elle, sa sœur la Misère, au rire édenté, aux orbites desséchées, aux doigts mous."
                                            },
                                            {
                                                "example_id": "4d1c1dda-c035-408b-aa92-089be0fa02c3",
                                                "sense_id": "63aea732-bc78-3233-94a9-4eb1ec063d7a",
                                                "text": "Il m’arrivait de ne pouvoir retenir une moquerie qui les blessait mortellement et dont ils me gardaient rancune."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rancune",
                                "target_lang_code": "fr",
                                "target_senses": [
