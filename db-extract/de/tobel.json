                "senses": [
                    {
                        "sense_id": "2e0f6493-2949-3680-9428-a61b14579e3f",
                        "entry_id": "c0a56c2f-ad3a-326a-b612-5fee5e8db159",
                        "glosses": [
                            "enges Tal, tiefer Einschnitt im Gelände"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "80496a3b-de76-4980-b2aa-486d969e5229",
                                "sense_id": "2e0f6493-2949-3680-9428-a61b14579e3f",
                                "text": "„Ein 46 Jahre alter Autofahrer ist am Jochpass bei Bad Hindelang im Oberallgäu mit seinem Auto in einen Abhang gestürzt und schwer verletzt worden. […] Das Auto überschlug sich mehrmals und blieb etwa 200 Meter von der Straße entfernt in dem Tobel auf dem Dach liegen.“"
                            },
                            {
                                "example_id": "75ae14ed-8969-4fec-93fc-5c81c7eb3342",
                                "sense_id": "2e0f6493-2949-3680-9428-a61b14579e3f",
                                "text": "„Der Fussweg durchs Tobel ist erst wieder durchgehend begehbar, wenn sicher ist, dass nicht weiteres Gestein in die Tiefe zu stürzen droht […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eda8a43e-1d9b-4128-9099-df2d0526ef9a",
                        "source_entry_id": "c0a56c2f-ad3a-326a-b612-5fee5e8db159",
                        "source_sense_id": "2e0f6493-2949-3680-9428-a61b14579e3f",
                        "source_sense_description": "süddeutsch, österreichisch, schweizerisch: enges Tal, tiefer Einschnitt im Gelände",
                        "target_lang_word": "glen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                                        "entry_id": "929cb458-6e1e-33c6-ba39-f179534380d7",
                                        "glosses": [
                                            "A secluded and narrow valley, especially one with a river running through it; a depression between hills; a dale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b43efb7-fe06-4f29-8f41-0bf7ab3b72c1",
                                                "sense_id": "929e25c5-3588-3a88-a6e3-0a48c8d21045",
                                                "text": "What riches too, of gold and jewels, might not be hidden among those forest-shrouded glens and peaks? And beyond, and beyond again, ever new islands, new continents perhaps, an inexhaustible wealth of yet undiscovered worlds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
