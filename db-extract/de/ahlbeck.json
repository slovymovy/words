                                "sense_id": "88648b0c-d5ce-3af2-ae89-7bcab1be4a3a",
                                "text": "Wir haben in Ahlbeck unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "e1a03e95-aa17-497b-9ebb-433ec7631496",
                                "sense_id": "88648b0c-d5ce-3af2-ae89-7bcab1be4a3a",
                                "text": "Nach Ahlbeck führen viele Wege."
                            },
                            {
                                "example_id": "a52400dc-e8a2-4e43-b6d6-f8793ef72ace",
                                "sense_id": "88648b0c-d5ce-3af2-ae89-7bcab1be4a3a",
                                "text": "Ahlbeck liegt auf der Nordhalbkugel."
