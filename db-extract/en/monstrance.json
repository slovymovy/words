                    {
                        "translation_id": "66ee8254-3433-485e-a854-3ede96cd93ec",
                        "source_entry_id": "ce95ce54-702b-3e67-8ab6-41194d9253b3",
                        "source_sense_id": "0061e8e2-8e28-325e-a410-523d6c382d6d",
                        "source_sense_description": "ornamental receptacle in which the consecrated host is placed for Eucharistic adoration",
                        "target_lang_word": "ostensoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ostensoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5ba8eb-8bb1-33cc-8c01-2cdb12c1cd32",
                                        "entry_id": "51f200b7-404f-3b76-b3e4-0e7224e12959",
                                        "glosses": [
                                            "Objet de culte, en forme de soleil comportant en son centre une custode de verre ou lunule, dans lequel est exposé le Saint-Sacrement pour le salut et les processions."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a6e352-d088-4228-bd1d-c3b3d612a347",
                                                "sense_id": "fc5ba8eb-8bb1-33cc-8c01-2cdb12c1cd32",
                                                "text": "Tu as donné à la paroisse un ostensoir de cinq mille francs."
                                            },
                                            {
                                                "example_id": "01135e0c-7070-4187-b6cd-c8e4c2a95988",
                                                "sense_id": "fc5ba8eb-8bb1-33cc-8c01-2cdb12c1cd32",
                                                "text": "Ton souvenir en moi luit comme un ostensoir !"
                                            },
                                            {
                                                "example_id": "4c0b8f5c-40a0-4aa5-af54-485281d12263",
                                                "sense_id": "fc5ba8eb-8bb1-33cc-8c01-2cdb12c1cd32",
                                                "text": "M. le Grand Doyen, vêtue d’une chasuble rutilante de rayons et de flammes d’or, porte sous un dais à pompons blancs l’ostensoir éblouissant de gemmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec8a41d8-af1d-45fd-9ad9-23f7d630a234",
                        "source_entry_id": "ce95ce54-702b-3e67-8ab6-41194d9253b3",
                        "source_sense_id": "0061e8e2-8e28-325e-a410-523d6c382d6d",
                        "source_sense_description": "ornamental receptacle in which the consecrated host is placed for Eucharistic adoration",
                        "target_lang_word": "Monstranz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monstranz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0cf3704-b942-3867-9625-de875083a7ec",
                                        "entry_id": "860d2d1a-968c-372b-b2ab-8be8168ac5ef",
                                        "glosses": [
                                            "schmuckvoll gestaltetes, reich verziertes (zumeist goldenes) liturgisches Objekt, in welchem in der Mitte hinter einem kleinen Fenster eine geweihte (konsekrierte) Hostie (das Allerheiligste) als der Leib Christi zur Verehrung sichtbar ausgestellt (gezeigt) wird"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec87520-1150-43f3-9aac-bba949deaa4d",
                                                "sense_id": "e0cf3704-b942-3867-9625-de875083a7ec",
                                                "text": "Unsere Kirche besitzt eine sehr alte und kostbare Monstranz. Sie ist mit vielen Edelsteinen verziert."
                                            },
                                            {
                                                "example_id": "8c24ecce-dc19-4acf-91df-2ef6163636f5",
                                                "sense_id": "e0cf3704-b942-3867-9625-de875083a7ec",
                                                "text": "An Fronleichnam wird das Allerheiligste in der Monstranz sichtbar durch die Straßen getragen."
                                            },
                                            {
                                                "example_id": "c5616ac3-8920-4bcf-a0ca-aa556147810a",
                                                "sense_id": "e0cf3704-b942-3867-9625-de875083a7ec",
                                                "text": "„Weihrauch quillt in die Dämmerung, die Monstranz funkelt, und nach der Andacht treiben sich die jungen Leute noch einige Zeit umher auf den Plätzen mit den Bäumen, wo die Maikäfer summen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
