                    {
                        "sense_id": "de5e2617-ea12-3ef9-bdba-637fa1dae8d8",
                        "entry_id": "edcc784a-6387-3c30-b528-87099f03f0b7",
                        "glosses": [
                            "Variante orthographique de grec."
                        ],
                        "tags": [
