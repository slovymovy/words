        "nl-extract.jsonl": [
            {
                "entry_id": "90548393-1500-3517-bcc3-3f3bfa0062ef",
                "word": "zielenrust",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e0e4ceb9-d574-34b1-931f-42904cf166cf",
                        "entry_id": "90548393-1500-3517-bcc3-3f3bfa0062ef",
                        "glosses": [
                            "de rust en het geluk dat je ervaart als je leeft als een goed mens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07a58a4-2f66-47cc-afac-af6bf0b4258e",
                                "sense_id": "e0e4ceb9-d574-34b1-931f-42904cf166cf",
                                "text": "Op de site van het gebeuren zie ik hoe pelgrims zich over elkaar heen storten om vervolgens maar het beeld van de maagd aan te kunnen raken want dat brengt geluk. Weinig zielenrust, wel heel veel plezier. Of heeft het één met het ander te maken?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4f7bc801-f88c-3f02-8a99-e63694e11c7c",
                        "entry_id": "90548393-1500-3517-bcc3-3f3bfa0062ef",
                        "glosses": [
                            "de rust van de overledene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0f1ea0f-13e0-42d3-9b6d-b3996e9c2785",
                                "sense_id": "4f7bc801-f88c-3f02-8a99-e63694e11c7c",
                                "text": "Bij de plaats waar gisteren de 22-jarige Ömer Köksal werd doodgeschoten, worden langzamerhand steeds meer bloemen neergelegd. Jongeren bidden op straat voor de zielenrust van de jongeman. Niemand wil echt wat zeggen, behalve dat heb ’een goede jongen’ was. Ondertussen verbazen bewoners zich over wat er is gebeurd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "420c30c1-8799-4f51-806d-634031f827f8",
                        "source_entry_id": "90548393-1500-3517-bcc3-3f3bfa0062ef",
                        "source_sense_id": "e0e4ceb9-d574-34b1-931f-42904cf166cf",
                        "target_lang_word": "peace of mind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peace of mind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                        "entry_id": "bcd204c1-8ff5-3fe2-8417-c1c003dab37f",
                                        "glosses": [
                                            "The absence of mental turmoil or anxiety."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b89b58-311e-4858-9eb8-6dc54b8d2be2",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "These people are under continual disquietudes, never enjoying a minute's peace of mind."
                                            },
                                            {
                                                "example_id": "630ca214-6b05-4a9e-be39-5fe40080fcb5",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "Who can describe the pleasure and delight, the peace of mind and soft tranquillity, the sickly boy felt in the balmy air, and among the green hills and rich woods, of an inland village!"
                                            },
                                            {
                                                "example_id": "5e14d2e6-a461-43c0-b45e-9841eaf7b47f",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "Genevieve was tall and blonde, a destroyer of masculine peace of mind."
                                            },
                                            {
                                                "example_id": "58a99652-6e29-40ec-a31b-b0d5704460cc",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "In between, what I find is pleasing and I'm feeling fine / Love is so confusing, there's no peace of mind"
                                            },
                                            {
                                                "example_id": "9857c14b-7ca4-418d-90a8-40215d7e66e8",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "Peace of mind is good for health, good for community, good for family, and also for physical growth."
                                            },
                                            {
                                                "example_id": "ad8e6847-7615-4908-80ca-1f072748d673",
                                                "sense_id": "c3e98210-db5d-3a7c-8c96-9b3c536df463",
                                                "text": "The basic toilet has quite a heavy door, which then bleeps to remind you to lock it - with a nice, peace of mind, manual lock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
