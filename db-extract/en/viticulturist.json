                                    {
                                        "sense_id": "932d4e0c-5d8b-3aef-b9f9-00ac7d2b0a0b",
                                        "entry_id": "fd289dea-8ea9-3537-acd3-619788be22dc",
                                        "glosses": [
                                            "weibliche Person, die Wein beruflich an- und ausbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d90d60c-d23b-4824-98c0-22f29b4ccea5",
                                                "sense_id": "932d4e0c-5d8b-3aef-b9f9-00ac7d2b0a0b",
                                                "text": "„Um die Lokalführung kümmert sich Tochter Claudia eine begeisterte Önologin und Weinbäuerin.“"
                                            },
                                            {
                                                "example_id": "e52512f8-8db6-4de0-8501-6a31c713eefd",
                                                "sense_id": "932d4e0c-5d8b-3aef-b9f9-00ac7d2b0a0b",
                                                "text": "„Die Weinbäuerin lieferte uns dazu ein paar Fachausdrücke, wie intensiv und vollmundig oder nach der zweiten Gärung entzieht der Wein den Schalen wiederholt Farbe und Aroma.“"
                                            },
                                            {
                                                "example_id": "b3c0bae6-4b51-4cfd-9229-89e3358bae71",
                                                "sense_id": "932d4e0c-5d8b-3aef-b9f9-00ac7d2b0a0b",
                                                "text": "„Zum Essen kredenzt Daniela Weißwein und Biosekt von Liana Peruzzi, einer Weinbäuerin in den Marken, die ich unbedingt noch besuchen möchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12e0bb91-6201-4ce4-8398-a14e975882e4",
                        "source_entry_id": "fcc27944-f0a4-3e4e-93a6-61c7469b5b7a",
