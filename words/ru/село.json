{
    "word_family": [
        "сельский",
        "сельцо",
        "селище",
        "селянин",
        "селянка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a0b758d-4627-3e93-b565-e10eb1d9b632",
                    "sense_definition": "Большой крестьянский или ремесленный населённый пункт, традиционно имеющий церковь.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы приехали в небольшое <w>село</w> навестить бабушку.",
                            "target_lang_translations": {
                                "en": "We arrived in a small <w>village</w> to visit our grandmother."
                            }
                        },
                        {
                            "text": "В центре <w>село</w> стоит старая церковь.",
                            "target_lang_translations": {
                                "en": "An old church stands in the center of the <w>village</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "посёлок",
                        "селение",
                        "деревня"
                    ],
                    "antonyms": [
                        "город"
                    ],
                    "common_phrases": [
                        "родное село",
                        "далекое село"
                    ],
                    "target_lang_definitions": {
                        "en": "A large rural settlement, traditionally featuring a church."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "village",
                                "target_lang_sense_clarification": "A small rural community, often with a church."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c176adbc-4144-347f-838a-864620afd441",
                    "sense_definition": "Сельская местность как среда обитания или сфера деятельности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие молодые люди уезжают из <w>села</w> в большие города.",
                            "target_lang_translations": {
                                "en": "Many young people are leaving the <w>countryside</w> for big cities."
                            }
                        },
                        {
                            "text": "Жизнь на <w>селе</w> сильно отличается от городской жизни.",
                            "target_lang_translations": {
                                "en": "Life in the <w>countryside</w> is very different from city life."
                            }
                        }
                    ],
                    "common_phrases": [
                        "жизнь на селе",
                        "работать на селе"
                    ],
                    "target_lang_definitions": {
                        "en": "Rural areas or the countryside as a place of living or work."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "countryside",
                                "target_lang_sense_clarification": "The land and scenery outside of cities and towns."
                            },
                            {
                                "target_lang_word": "rural area",
                                "target_lang_sense_clarification": "General term for non-urban regions."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9d93167-5055-3a60-9953-b352564c502b",
                    "sense_definition": "Невежественный, некультурный человек.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он ведет себя как полное <w>село</w> в приличном обществе.",
                            "target_lang_translations": {
                                "en": "He is acting like a total <w>hick</w> in polite society."
                            }
                        },
                        {
                            "text": "Не будь таким <w>село</w>, научись манерам.",
                            "target_lang_translations": {
                                "en": "Don't be such a <w>bumpkin</w>, learn some manners."
                            }
                        }
                    ],
                    "antonyms": [
                        "невежда"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "шутливое или пренебрежительное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An ignorant or uncultured person (slang/derogatory)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hick",
                                "target_lang_sense_clarification": "Informal, derogatory term for an unsophisticated person from the country."
                            },
                            {
                                "target_lang_word": "bumpkin",
                                "target_lang_sense_clarification": "A person from the countryside perceived as awkward or unsophisticated."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81aa1f4d-c4d6-32f4-9612-32c3db8673ce",
                    "sense_definition": "Форма прошедшего времени среднего рода единственного числа глагола <w>сесть</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солнце <w>село</w> за горизонт, и стало темно.",
                            "target_lang_translations": {
                                "en": "The sun <w>set</w> below the horizon, and it became dark."
                            }
                        },
                        {
                            "text": "Такси <w>село</w> на мель в глубокой луже.",
                            "target_lang_translations": {
                                "en": "The taxi <w>sat</w> stuck in a deep puddle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма глагола"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past tense, neuter singular form of the verb 'to sit' or 'to set' (e.g., sun)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "Used for the sun going down below the horizon."
                            },
                            {
                                "target_lang_word": "sat",
                                "target_lang_sense_clarification": "Past tense of sit; can also mean to be positioned or stuck."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}