                        "зелёный чай",
                        "зелёная трава",
                        "зелёные глаза"
                    ],
                    "target_lang_definitions": {
                        "en": "Having the color of grass, foliage; one of the main colors of the spectrum.",
                        "de": "Die Farbe von Gras oder Blättern habend; eine der Grundfarben des Spektrums."
                    },
