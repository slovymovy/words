                                "target_senses": [
                                    {
                                        "sense_id": "0cd55403-eede-31e7-8a33-ec797cff9077",
                                        "entry_id": "32089720-8e96-312c-a085-168bfb683187",
                                        "glosses": [
                                            "Of a bird or other animal: to brood, cover, incubate, or sit over (eggs)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f767c6b-79c1-420d-a2df-f1dc6d704682",
                                                "sense_id": "0cd55403-eede-31e7-8a33-ec797cff9077",
                                                "text": "Moreover, the provident care of the tortoiſe in the generation, nouriſhment and preſervation of [h]er yooung, is vvoonderfull: for out ſhe goeth of the ſea, and laieth her egges or caſteth her ſpavvne upon the banke ſide; but being not able to cove or ſit upon them, nor to remaine herſelfe upon the land out of the ſea any long time, ſhe beſtovveth them in the gravell, and aftervvards covereth them vvith the lighteſt and fineſt ſand ſhe can get: […]"
                                            }
