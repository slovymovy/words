                    {
                        "sense_id": "0cce7721-082f-33ae-a8ba-a21dde70aa56",
                        "entry_id": "9794dec2-3caf-32c0-a0a7-57ec86bd1cda",
                        "glosses": [
                            "kraam op de markt of op straat waar men bloemen verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78e9f836-fe52-4522-956e-18eb060b0de7",
                                "sense_id": "0cce7721-082f-33ae-a8ba-a21dde70aa56",
                                "text": "Volgens het Brabants Dagblad had de man in de supermarkt terpentine gekocht en gezegd dat hij zichzelf iets aan zou doen. Daarna ging hij naar buiten, gooide de terpentine over zich heen en stak zichzelf in brand. Omstanders zouden het vuur met water uit de bloemenstal hebben gedoofd."
                            },
                            {
                                "example_id": "cc210e93-1fee-47c0-9460-68a5e77e6856",
                                "sense_id": "0cce7721-082f-33ae-a8ba-a21dde70aa56",
                                "text": "Smith staat al twintig jaar in een bloemenstal op de markt in Northampton, een stadje in Midden-Engeland. Kort na het referendum was ik hier ook, en toen waren Zoe's inkoopprijzen al enorm gestegen. Ze koopt vooral bloemen uit Nederland en door de keldering van het pond zijn bloemen uit eurolanden veel duurder voor haar."
                            },
                            {
                                "example_id": "a2d8b012-6c33-4200-8f7d-cf719bac9e8b",
                                "sense_id": "0cce7721-082f-33ae-a8ba-a21dde70aa56",
                                "text": "Oud-correspondent Jeroen Wollaars sprak vlak voor hij terugging naar Nederland met een van de nabestaanden, de zoon van het eerste slachtoffer: een Turkse bloemenhandelaar die voor zijn bloemenstal werd doodgeschoten."
                            }
                        ]
                    }
