                        "examples": [
                            {
                                "example_id": "a784c77c-d53d-41ed-a63e-3ca5fa2e1d5f",
                                "sense_id": "e758e9de-db5c-37fa-a7a6-4aa300b85525",
                                "text": "Объектом моего коллекционирования являются только футбольные программки тульских команд."
                            }
                        ]
                    }
                ],
                "translations": [
