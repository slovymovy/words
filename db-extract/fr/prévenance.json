                                    {
                                        "sense_id": "ccdde672-8422-3e03-9afe-c2fafc2d24c8",
                                        "entry_id": "35278ceb-d15c-37f1-9fe2-6ccca82b1d03",
                                        "glosses": [
                                            "Thoughtful and considerate attention."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70d3065d-cd34-4146-becd-a32c0d777509",
                                                "sense_id": "ccdde672-8422-3e03-9afe-c2fafc2d24c8",
                                                "text": "She sat with her feet tucked under her, and leaned against her father, who held her in his arm, as she stared out the window at the passing people with a queer old-fashioned thoughtfulness in her big eyes."
                                            }
                                        ]
