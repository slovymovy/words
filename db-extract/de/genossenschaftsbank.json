                ],
                "senses": [
                    {
                        "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                        "entry_id": "1986e617-3bd3-329c-9b2f-606703efcc94",
                        "glosses": [
                            "Bank, die die Rechtsform einer Genossenschaft oder Aktiengesellschaft hat und einer genossenschaftlichen Bankengruppe angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70cb362-f9e1-4b4a-b544-5eae4024de08",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "Ich habe mein Konto bei einer Genossenschaftsbank."
                            },
                            {
                                "example_id": "2885a92f-1fc8-45a0-bb8e-bbb18c80cf73",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "Die Zinsen, die man für die Anteile an einer Genossenschaftsbank erhält, sind im Vergleich zum Sparbuch gut."
                            },
                            {
                                "example_id": "ad88a9e7-a285-4b1c-8875-62b3ef8e69f5",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„»Nie war die Mitgliedschaft bei einer Genossenschaftsbank beliebter als heute«, so Fröhlich.“"
                            },
                            {
                                "example_id": "e827a2ba-c28e-4809-9f1b-7912c0da8132",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Die Zinsen sind niedrig, die Kreditnachfrage klein – trotzdem geht es den Genossenschaftsbanken in Deutschland blendend. Sie übertrumpfen mit ihrem Gewinn sogar den Branchenprimus.“"
                            },
                            {
                                "example_id": "c49adc08-69c2-4a0b-909a-6e8e9834b4b4",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Genossenschaftsbanken [Anmerkung: mussten nach der Finanzkrise 2008] kaum von den Rettungspaketen für internationale Geldinstitute Gebrauch machen.“"
                            },
                            {
                                "example_id": "9fe67add-09cf-47b4-ac51-c96a572d6da7",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Die Genossenschaftsbanken sind in den vergangenen Jahren im Hypothekarbereich stark gewachsen.“"
                            },
                            {
                                "example_id": "01dad5fa-baf3-4fc7-83fa-80342a7d08b0",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Der Konzentrationsprozess [Anmerkung: im Bankensektor] war in Deutschland vergleichsweise weniger stark vorangeschritten, weil die zumeist regional tätigen Sparkassen und Genossenschaftsbanken dieser Tendenz entgegenwirkten.“"
                            },
                            {
                                "example_id": "0d60f030-b0e3-4d99-a56d-db60378ec434",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„[…] das Privatkundengeschäft [Anmerkung: der Deutschen Bank] soll gestärkt werden. Das wird angesichts der Konkurrenz von Sparkassen und Genossenschaftsbanken nicht einfach sein.“"
                            },
                            {
                                "example_id": "c82abf7e-cfae-4456-945c-25114dc909fc",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Grundsätzlich pessimistisch ist der Aktienstratege der Genossenschaftsbanken aber nicht: Den Euro Stoxx 50 sieht er von derzeit 3.420 Punkte bis zum Jahresende auf 3.750 steigen und den DAX dann bei 13.000.“"
                            },
                            {
                                "example_id": "ecb69733-8a9f-4dcb-988f-e31a2f0bbdbd",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Besonders die deutschen öffentlich-rechtlichen Sparkassen und die Genossenschaftsbanken hatten die europäische Einlagensicherung scharf kritisiert.“"
                            },
                            {
                                "example_id": "49526adf-bd87-4f28-ab5c-0339e4ef3f50",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Da es sich bei den meisten deutschen Ökobanken um Genossenschaftsbanken handelt, sind diese auch in das Sicherungssystem der Deutschen Volks- und Raiffeisenbanken eingebunden.“"
                            },
                            {
                                "example_id": "12138c5f-ab63-4ceb-869c-8877542e1793",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„Um den Anforderungen an eine systemrelevante Bank zu genügen, braucht die Genossenschaftsbank [Anmerkung: die schweizerische Raiffeisen] mehr Eigenkapital sowie einen Plan zur Abwicklung im Falle eines Konkurses.“"
                            },
                            {
                                "example_id": "26ce0223-c305-4169-bead-4565bd59b836",
                                "sense_id": "163dfc4c-e4eb-3d50-a7b9-39dec1ef68b7",
                                "text": "„[…] Die Kredit-Regulierungsbehörde der USA wirft der Bank JP Morgan vor, drei Genossenschaftsbanken in den Ruin getrieben zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
