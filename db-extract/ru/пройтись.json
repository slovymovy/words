                "senses": [
                    {
                        "sense_id": "3f07374a-10aa-3aa4-a616-7f6a126e6fc7",
                        "entry_id": "b6c3c145-ae58-3336-9790-341e11fc862f",
                        "glosses": [
                            "to (go for a) walk, to stroll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7825a1bc-9624-4710-b5af-1b5f978c4fa9",
                                "sense_id": "3f07374a-10aa-3aa4-a616-7f6a126e6fc7",
                                "text": "Хотя́ придётся немно́го пройти́сь вниз по у́лице.",
                                "translation": "(You) have to walk a little down the street, though.",
                                "english": "(You) have to walk a little down the street, though."
                            },
                            {
                                "example_id": "43a42754-4d84-413b-82a6-8525157d696e",
                                "sense_id": "3f07374a-10aa-3aa4-a616-7f6a126e6fc7",
                                "text": "А по-мо́ему, бы́ло бы прия́тно пройти́сь по по́лю для го́льфа.",
                                "translation": "And in my opinion, it would be nice to walk along the golf course.",
                                "english": "And in my opinion, it would be nice to walk along the golf course."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a04f2a5-a205-3e90-b42f-6b0e76f987c0",
                        "entry_id": "b6c3c145-ae58-3336-9790-341e11fc862f",
                        "glosses": [
                            "to go over; to scrutinize; to analyze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f4d229d-a730-4ba3-a447-d709602e21e8",
                                "sense_id": "6a04f2a5-a205-3e90-b42f-6b0e76f987c0",
                                "text": "Я хоте́ла бы пройти́сь по расписа́нию.",
                                "translation": "I would like to go over the schedule.",
                                "english": "I would like to go over the schedule."
                            },
                            {
                                "example_id": "df357d03-8bae-4298-b8f6-9009cd187010",
                                "sense_id": "6a04f2a5-a205-3e90-b42f-6b0e76f987c0",
                                "text": "Ми́ша, нам ну́жно опя́ть пройти́сь по твои́м показа́ниям.",
                                "translation": "Misha, we need to go over your testimony again.",
                                "english": "Misha, we need to go over your testimony again."
                            }
                        ]
                    }
                ],
