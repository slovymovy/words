                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f57cc66d-40a7-38c4-8806-907b528fbc4c",
                                        "entry_id": "8a352663-c9b2-3540-88f4-4a9d115eb9eb",
                                        "glosses": [
                                            "gemeend, niet gespeeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f973a6e9-9ae3-4835-84ef-035f7d4226ca",
                                                "sense_id": "f57cc66d-40a7-38c4-8806-907b528fbc4c",
                                                "text": "En ik was oprecht blij voor haar: dat ze een nieuwe liefde had gevonden, dat ze weer gelukkig was."
                                            },
                                            {
                                                "example_id": "2ad6d32d-6353-44fb-a7ae-ca35ae2c77eb",
                                                "sense_id": "f57cc66d-40a7-38c4-8806-907b528fbc4c",
                                                "text": "' 'Ja, ik heb je dat al eerder horen zeggen, maar ik snap oprecht niet wat er erg aan is,' verzucht Joy."
                                            },
                                            {
                                                "example_id": "200bcd9e-4c4b-4936-9a07-6b84a51c9e72",
                                                "sense_id": "f57cc66d-40a7-38c4-8806-907b528fbc4c",
                                                "text": "Ik was overweldigd door hun vrijgevigheid en oprechte vriendelijkheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e01bd7a3-ebd4-4d8c-820b-261c40da9e89",
                        "source_entry_id": "42bebf1d-356e-3730-bc3e-4a6f5241f091",
                        "source_sense_description": "In a sincere or earnest manner; honestly",
                        "target_lang_word": "sincèrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sincèrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                                        "entry_id": "f3d0ac7f-60ff-3285-bf9b-de834c069e94",
                                        "glosses": [
                                            "Avec sincérité; d'une manière sincère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624313d6-f933-4db9-b84c-47f1918fd8cd",
                                                "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                                                "text": "Des fautes si sincèrement senties et dans la suite si glorieusement réparées,"
                                            },
                                            {
                                                "example_id": "8f4f1a49-fbf5-4d78-9add-e7548a8f2b7b",
                                                "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                                                "text": "Il jugera chaque homme selon la loi qu’il aura sincèrement admise,"
                                            },
                                            {
                                                "example_id": "4952fb26-747d-48db-94a3-a5e06b740cb6",
                                                "sense_id": "cae03d02-5466-3d6c-ba48-739ea570f28c",
                                                "text": "Toutefois, si un magnanime sentiment de fraternité s'imposait sincèrement et définitivement, sans arrière pensée, à tous les esprits européens, alors nous n'aurions pas à nous inquiéter du cosmopolitisme marseillais, intéressant embryon de la civilisation future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
