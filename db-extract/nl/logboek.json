                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9805fbf5-41ad-4509-bdf0-0ff171a71d45",
                                "sense_id": "e9d15c24-6773-399a-a05c-459f27ce7e3f",
                                "text": "In het logboek schreef hij alle nautische gegevens op."
