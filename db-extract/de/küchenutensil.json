                                        "examples": [
                                            {
                                                "example_id": "77a854cb-9420-4796-a23f-c022f8e92953",
                                                "sense_id": "445c44dd-d655-317b-8e8a-652932297c31",
                                                "text": "Ils vendirent leur mobilier sur place et ne ramenèrent de Termonde que leurs vêtements et leur linge de maison, leur plus belle vaisselle, le fauteuil d'osier de bon-papa et ce qui lui restait de livres ainsi que les ustensiles de cuisine de bonne-maman."
                                            },
                                            {
                                                "example_id": "8cee0785-cf45-4217-a33f-341b681a7b16",
                                                "sense_id": "445c44dd-d655-317b-8e8a-652932297c31",
                                                "text": "Les enfants entendirent un crépitement ferrailleux sur l’asphalte, comme une pluie d’ustensiles de cuisine qui s’abattait sur la chaussée."
                                            }
