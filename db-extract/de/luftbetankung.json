                "senses": [
                    {
                        "sense_id": "118f48ba-56e3-3b39-8071-5add93565148",
                        "entry_id": "8cedb051-5e8d-3702-891a-87c78de8a51f",
                        "glosses": [
                            "Betanken eines Flugzeugs oder Hubschraubers während des Flugs mit Hilfe eines Tankflugzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7a246aa-905e-4f93-afbb-585a316f944b",
                                "sense_id": "118f48ba-56e3-3b39-8071-5add93565148",
                                "text": "„Den Forschern zufolge würde ein neues System zur Luftbetankung auch die Lärmbelastung in der Nähe von Flughäfen erheblich reduzieren, da schwerere Flugzeuge beim Start mehr Lärm verursachten.“"
                            },
                            {
                                "example_id": "ee3ab08d-48a2-472c-a86c-e45ed82e6c84",
                                "sense_id": "118f48ba-56e3-3b39-8071-5add93565148",
                                "text": "„Der US-Armee ist erstmals die Luftbetankung einer unbemannten Drohne gelungen.“"
                            },
                            {
                                "example_id": "1414ce40-ca73-4cb2-8f88-4b32f543a994",
                                "sense_id": "118f48ba-56e3-3b39-8071-5add93565148",
                                "text": "„Auch wenn dieser Einsatz insgesamt erfolgreich verlief, sind doch die Defizite im Bereich der Luftbetankung klar erkannt worden.“"
                            },
                            {
                                "example_id": "62cf601d-8d3b-4de9-87e1-9bf854789921",
                                "sense_id": "118f48ba-56e3-3b39-8071-5add93565148",
                                "text": "Im Einsatz hat die deutsche Luftwaffe sechs Tornado-Aufklärungsflugzeuge und einen Airbus 310 zur Luftbetankung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
