    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "37e45fb6-2e18-3de2-96cc-973ddf1a8066",
                    "sense_definition": "Not having or showing good manners; rude or discourteous.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>impolite</w> to talk while someone else is speaking.",
                            "target_lang_translations": {
                                "ru": "Разговаривать, пока говорит кто-то другой, — <w>невежливо</w>."
                            }
                        },
                        {
                            "text": "He was very <w>impolite</w> to the waiter when he complained about the food.",
                            "target_lang_translations": {
                                "ru": "Он был очень <w>невежлив</w> с официантом, когда жаловался на еду."
                            }
                        }
                    ],
                    "synonyms": [
                        "discourteous",
                        "uncivil",
                        "rude",
                        "unpolite",
                        "bad-mannered",
                        "ill-mannered",
                        "impolite",
                        "insolent",
                        "unmannerly"
                    ],
                    "antonyms": [
                        "polite"
                    ],
                    "common_phrases": [
                        "very impolite",
                        "considered impolite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обладающий хорошими манерами; грубый или неучтивый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невежливый",
                                "target_lang_sense_clarification": "общее обозначение отсутствия вежливости"
                            },
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "более сильное проявление неучтивости"
                            },
                            {
                                "target_lang_word": "невоспитанный",
                                "target_lang_sense_clarification": "указывает на отсутствие хорошего воспитания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}