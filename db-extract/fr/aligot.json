                                        "glosses": [
                                            "A dish traditionally made in the south of Auvergne from melted Tomme cheese blended into mashed potatoes, often with garlic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
