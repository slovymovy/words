                "senses": [
                    {
                        "sense_id": "824913f9-ccb6-3fc6-90f1-9e01fc4b5064",
                        "entry_id": "8aef9328-4eab-3ca8-af5c-57efed6fad94",
                        "glosses": [
                            "in Bergen über natürlichen Fels führender Pfad verschiedener Schwierigkeitsgrade, welcher mit Steighilfen (Leitern, Stahlseilen, Tritthilfen aus Eisenklammern) ausgerüstet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e14413c-054a-4a55-baf1-38fc93dfefde",
                                "sense_id": "824913f9-ccb6-3fc6-90f1-9e01fc4b5064",
                                "text": "Beim Begehen von Klettersteigen sollte eine spezielle Ausrüstung und ein Helm als Schutz vor Steinschlag verwendet werden."
                            },
                            {
                                "example_id": "037e99c3-4b3d-45b8-9630-b663b27614da",
                                "sense_id": "824913f9-ccb6-3fc6-90f1-9e01fc4b5064",
                                "text": "„Heute nehmen sie die Bergsportler ins Visier, bieten Klettersteige nach Katalog oder nehmen die vorhandenen Wege und klassifizieren sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b58ac453-1ed0-4c1a-8875-81ca7eb05a29",
                        "source_entry_id": "8aef9328-4eab-3ca8-af5c-57efed6fad94",
                        "source_sense_id": "824913f9-ccb6-3fc6-90f1-9e01fc4b5064",
                        "target_lang_word": "via ferrata",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "via ferrata",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                        "entry_id": "3e00ab27-d810-35d1-9152-3f4d45a68341",
                                        "glosses": [
                                            "A protected climbing route, usually with iron cables and hooks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc46f7b5-e5d2-4779-b4ca-a75b70fc5797",
                                                "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                                "text": "Like its counterparts in the Dolomites, where the first vie ferrate were built to help move troops through the mountains during World War I, this one has a steel cable bolted into the rock, paralleling the Rings."
                                            },
                                            {
                                                "example_id": "64dc83b8-08cd-43ff-a3d4-8e70702dc9ce",
                                                "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                                "text": "Hidden away among steep crags and dense forests, Chisà is the starting point for several interesting hikes, and also for possibly the most thrilling via ferrata in Corsica."
                                            },
                                            {
                                                "example_id": "ddb040f1-158a-4f15-b077-09df657c390d",
                                                "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                                "text": "In the three places in this book where the vie ferrate are of a slightly more advanced level, alternative trails have been suggested."
                                            },
                                            {
                                                "example_id": "5029cef7-e429-4bc0-a6a0-9b969bcd6bb4",
                                                "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                                "text": "Vie ferrate are frequently demanding undertakings requiring experience in many aspects of mountaineering."
                                            },
                                            {
                                                "example_id": "ea16ca96-330e-4eb1-9109-aba7915d599b",
                                                "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                                "text": "The loss of welfare for vie ferrate in Pale di S. Martino was twice as large as that in Tofane, indicating the vie ferrate are probably more appealing."
                                            },
                                            {
                                                "example_id": "e1a087c9-4edd-4494-a9fd-197add392edd",
                                                "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                                "text": "However, the dramatic beauty and tricky rock faces attracted the attention of local and foreign climbers, and during the 1930s the construction of a via ferrata to the base of difficult climbs began."
                                            },
                                            {
                                                "example_id": "40b38c10-3873-47e2-a4b0-a7c49a58e99f",
                                                "sense_id": "d53a737a-677d-3684-bf18-fc7534a29c78",
                                                "text": "Vie ferrate are growing fast in number and popularity around the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d6dd6f1-dcb9-4d55-a44c-3fdfff20792f",
                        "source_entry_id": "8aef9328-4eab-3ca8-af5c-57efed6fad94",
