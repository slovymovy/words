                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c6565a2-cb7d-3136-af22-1fa531b4736f",
                        "entry_id": "5c269bc3-a34b-314a-8aa8-ca1b671178e4",
                        "glosses": [
                            "État de qui est frileux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d926d858-253a-4530-8a1c-6da0a0fe7e5e",
                                "sense_id": "4c6565a2-cb7d-3136-af22-1fa531b4736f",
                                "text": "Signes de carence Goitre (augmentation de volume de la thyroïde), frilosité, peau sèche, chute des cheveux, fatigue, dépression, troubles de la mémoire, prise de poids."
                            },
                            {
                                "example_id": "8ffca49a-0329-44bc-970a-30496a34248f",
                                "sense_id": "4c6565a2-cb7d-3136-af22-1fa531b4736f",
                                "text": "Une frilosité maladive."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6cb61e3-4c7e-38e0-9b6c-86b32f65edd3",
                        "entry_id": "5c269bc3-a34b-314a-8aa8-ca1b671178e4",
                        "glosses": [
                            "Absence d’audace."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "97efd6de-07fe-4b13-be24-319160a816b2",
                                "sense_id": "d6cb61e3-4c7e-38e0-9b6c-86b32f65edd3",
                                "text": "L’importance donnée au fait divers, au sensationnalisme, au catastrophisme, aux événements racoleurs, nourrit le repli sur soi et la frilosité."
                            },
                            {
                                "example_id": "4bcc9ef7-29cd-499a-b1c9-57316e2b1dd0",
                                "sense_id": "d6cb61e3-4c7e-38e0-9b6c-86b32f65edd3",
                                "text": "Joe Biden, à la présidence, a perpétué la frilosité et le populisme de la politique de vaccination de Donald Trump : les Américains et rien que les Américains."
                            },
                            {
                                "example_id": "197c1097-6a7c-4adb-a923-1d1271b6467e",
                                "sense_id": "d6cb61e3-4c7e-38e0-9b6c-86b32f65edd3",
                                "text": "Qu’on s’en désole ou non, le mot « nationalisme » (autrefois si exaltant pour les gens de 20 ans) est devenu, pour la majorité des jeunes, un mot radioactif, infréquentable.\n Synonyme de fermeture, de frilosité et d’intolérance."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbc5d99f-227e-3776-9726-fa81ee5cabd2",
                        "entry_id": "5c269bc3-a34b-314a-8aa8-ca1b671178e4",
                        "glosses": [
                            "Distance, aversion, réserves."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3e719fb5-6a32-45e3-8149-eb9da5510eba",
                                "sense_id": "dbc5d99f-227e-3776-9726-fa81ee5cabd2",
                                "text": "… certains des partisans déçus de la défense du cours ECR gravitant dans le milieu de l'éducation ont déjà exprimé politiquement leur frilosité, voire leur désaccord profond, face aux nouvelles orientations gouvernementales."
                            }
                        ]
                    }
