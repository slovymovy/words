                                                "sense_id": "9e75fd9a-0d47-313b-956f-bac996120131",
                                                "text": "Die Handhabung dieses Artikels ist kinderleicht."
                                            },
                                            {
                                                "example_id": "b58d5dab-332a-4c92-8a9c-33c840f47ca9",
                                                "sense_id": "9e75fd9a-0d47-313b-956f-bac996120131",
                                                "text": "„Die Handhabung der Niederlage von 1918 war Deutschlands letzter großer Fehler im Ersten Weltkrieg, und fast der schlimmste.“"
                                            },
                                            {
                                                "example_id": "7116ec76-a8e6-48a4-8168-b899f542c170",
                                                "sense_id": "9e75fd9a-0d47-313b-956f-bac996120131",
                                                "text": "„Die in der regionalen Geographie verwendete Grenzgürtelmethode hat bei formaler Handhabung jedoch meist wenig Aussagekraft.“"
                                            }
