                    },
                    {
                        "translation_id": "95acc574-7016-4efb-8239-442b3d46a738",
                        "source_entry_id": "c480345d-a51a-381b-bf4d-477eae853ee9",
                        "source_sense_description": "ancestral form or source word",
                        "target_lang_word": "étymon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étymon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                                        "entry_id": "8a04b28b-aace-3082-b847-58836336e641",
                                        "glosses": [
                                            "Mot le plus ancien à l’origine du mot nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04c01f7-1697-4f4f-a8e6-d62b676e8bb4",
                                                "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                                                "text": "Le latin operari est l’étymon de ouvrer, devenu œuvrer, et de opérer."
                                            },
                                            {
                                                "example_id": "e0e695db-bf34-441b-ab99-8cc4652dcf26",
                                                "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                                                "text": "S’il existe un consensus pour rattacher « ironie » à l’étymon eirôneia, les avis divergent quant à la signification du mot grec."
                                            },
                                            {
                                                "example_id": "6cb01cd6-8396-4966-8681-1f15de133cf0",
                                                "sense_id": "f93d4658-7ce0-3f2f-9a5c-2132f457219d",
                                                "text": "C’est l’époque où l’on commençait à mettre en relation le nom Ingrande, dérivé de l’étymon celtique equoranda, avec le passage d’une frontière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7223b8cc-7588-4cbf-90ac-d5355f512572",
                        "source_entry_id": "c480345d-a51a-381b-bf4d-477eae853ee9",
                        "source_sense_description": "ancestral form or source word",
                        "target_lang_word": "Etymon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Etymon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3077ed81-6ad6-351f-af6b-2dc41e69d101",
                                        "entry_id": "c5453be5-303f-369d-8092-efedfc53e315",
                                        "glosses": [
                                            "jede in einer früheren Sprachstufe Vorform und frühere Bedeutung eines Wortes oder Morphems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c96f82f1-edb1-4e4f-ae0e-4b4d661135f6",
                                                "sense_id": "3077ed81-6ad6-351f-af6b-2dc41e69d101",
                                                "text": "„ Andererseits soll das heißen, daß es sich um einen Akzent handelt, der sich hauptsächlich auf das Grundwort (Etymon), den Stamm, bezieht.“"
                                            },
                                            {
                                                "example_id": "2c75a119-87ed-43c1-a879-4f1131d0b24d",
                                                "sense_id": "3077ed81-6ad6-351f-af6b-2dc41e69d101",
                                                "text": "„Das Etymon gar vieler Wörter unserer Umgangssprache ist tot…“"
                                            },
                                            {
                                                "example_id": "47a0ca51-c87d-47bb-bbee-f5d67eb4d752",
                                                "sense_id": "3077ed81-6ad6-351f-af6b-2dc41e69d101",
                                                "text": "„Während also deutlich ist, warum ‚Sauer-‘, ‚Weiß-‘ und ‚Rotkraut‘ mit dieser ersten Komponente benannt wurden, ist das Etymon von ‚Kraut‘ nur noch historisch zu erschließen....“"
                                            },
                                            {
                                                "example_id": "10fc8f8f-243d-4a8b-a94a-984e8695a365",
                                                "sense_id": "3077ed81-6ad6-351f-af6b-2dc41e69d101",
                                                "text": "„Alle diese verschiedenen Wörter haben also dasselbe »Etymon« oder, so sagt die Etymologie auch, sie sind »Reflexe« desselben (lateinischen) Worts.“"
                                            },
                                            {
                                                "example_id": "9b3eb426-607c-43fb-88ad-055ec4f414e6",
                                                "sense_id": "3077ed81-6ad6-351f-af6b-2dc41e69d101",
                                                "text": "„Als einer der ersten hat sich Yaron Matras mit diesem Phänomen befasst und für die südwestdeutsche Viehhändlersprache eine »semantische Umorientierung« bei der Integration hebräischstämmiger Etyma in die Viehhändlersprache nachweisen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
