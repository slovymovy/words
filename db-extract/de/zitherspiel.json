                        "examples": [
                            {
                                "example_id": "8d5fa198-77cb-4b3c-998f-1d5eb106feaf",
                                "sense_id": "1da0b3e2-a520-3998-8f2d-0087b659614e",
                                "text": "Sie lauschten andächtig dem Zitherspiel."
                            },
                            {
                                "example_id": "970fc3b2-6c63-4d52-ba05-443a5bfea35d",
                                "sense_id": "1da0b3e2-a520-3998-8f2d-0087b659614e",
                                "text": "„Noch immer läuft Graham Greenes ‚Der dritte Mann‘ in Österreich vor vollen Kinos. […] Hier aber strömen die Menschen, von dem hintergründigen Zitherspiel der untermalenden Musik wie betäubt aus den Kinos, um sich am nächsten oder übernächsten Tag wieder um Karten anzustellen.“"
                            }
                        ],
