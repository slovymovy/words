                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К нам подошёл какой-то незнакомый <крест>.",
                            "target_lang_translations": {
                                "en": "Some unfamiliar <guy> approached us.",
                                "de": "Irgendein unbekannter <w>Typ</w> kam auf uns zu."
                            }
                        },
                        {
                            "text": "Эй, <крест>, ты не видел здесь моих друзей?",
                            "target_lang_translations": {
