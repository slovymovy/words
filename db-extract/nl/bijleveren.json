                                "target_senses": [
                                    {
                                        "sense_id": "2809e180-cdab-3948-9738-272a6c7b56d3",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To set free from restraint or danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26b841cb-c7c7-4c77-9e7b-20bab895e76d",
                                                "sense_id": "2809e180-cdab-3948-9738-272a6c7b56d3",
                                                "text": "The hostage was delivered from her captors and thus preserved from any danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d1ba06-1ca0-36d0-9b48-2b2aecafbd51",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "Senses having to do with birth.",
                                            "To assist in the birth of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4bbf13-b94f-4e52-8006-e7e620a2ca52",
                                                "sense_id": "f7d1ba06-1ca0-36d0-9b48-2b2aecafbd51",
                                                "text": "the doctor delivered the baby"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dfa8e12-1ff1-320b-8043-632f4ae9b676",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "Senses having to do with birth.",
                                            "To assist (a female) in bearing, that is, in bringing forth (a child)."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "132f977e-2389-40de-bad3-ed8d1b242bf7",
                                                "sense_id": "5dfa8e12-1ff1-320b-8043-632f4ae9b676",
                                                "text": "the duchess was delivered of a son"
                                            },
                                            {
                                                "example_id": "763154bc-4818-46b8-a568-34d982529631",
                                                "sense_id": "5dfa8e12-1ff1-320b-8043-632f4ae9b676",
                                                "text": "the doctor is expected to deliver her of a daughter tomorrow"
                                            },
                                            {
                                                "example_id": "85d3b5dd-561b-4df1-a396-d11cd27f211f",
                                                "sense_id": "5dfa8e12-1ff1-320b-8043-632f4ae9b676",
                                                "text": "Sche was delivered sauf and sone"
                                            },
                                            {
                                                "example_id": "5cf6cb92-2fd3-43e9-bf6b-7f68b4baa85e",
                                                "sense_id": "5dfa8e12-1ff1-320b-8043-632f4ae9b676",
                                                "text": "The queen has already been delivered, and is presenting her daughter to several goddesses, who have acted the part of midwives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57780cd6-4367-3db0-8495-ee518c701b0c",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "Senses having to do with birth.",
                                            "To give birth to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4f0821a-4120-4b6d-a9fa-b78614b95adf",
                                                "sense_id": "57780cd6-4367-3db0-8495-ee518c701b0c",
                                                "text": "she delivered a baby boy yesterday"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79134c8f-f07c-3d16-b1ac-48d2c5a92be8",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To free from or disburden of anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d46b2c4b-bd8f-453b-93b8-042831369c84",
                                                "sense_id": "79134c8f-f07c-3d16-b1ac-48d2c5a92be8",
                                                "text": "Tully was long ere he could be delivered of a few verses, and those poor ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dac9e9e-63c7-32b0-bf49-644359b9a786",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To bring or transport something to its destination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d93f291-dc28-463a-95af-f43d15de186d",
                                                "sense_id": "6dac9e9e-63c7-32b0-bf49-644359b9a786",
                                                "text": "deliver a package"
                                            },
                                            {
                                                "example_id": "695b9cd3-d013-4de9-92f9-a33b1fb7dff8",
                                                "sense_id": "6dac9e9e-63c7-32b0-bf49-644359b9a786",
                                                "text": "deliver the mail"
                                            },
                                            {
                                                "example_id": "8c7b76b0-104a-49b6-af9b-14a68bb9ae97",
                                                "sense_id": "6dac9e9e-63c7-32b0-bf49-644359b9a786",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b17117-0f42-30c2-9f1e-be31cdb51a3d",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To hand over or surrender (someone or something) to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da9a3a8-5b51-45ab-9f3b-e862037b0406",
                                                "sense_id": "69b17117-0f42-30c2-9f1e-be31cdb51a3d",
                                                "text": "deliver the thief to the police"
                                            },
                                            {
                                                "example_id": "9e416d0c-9f50-4859-ba54-ee48b1b4ec9c",
                                                "sense_id": "69b17117-0f42-30c2-9f1e-be31cdb51a3d",
                                                "text": "Thou shalt deliver Pharaoh's cup into his hand."
                                            },
                                            {
                                                "example_id": "b2675f64-726e-44b0-9c2b-e90715e9d802",
                                                "sense_id": "69b17117-0f42-30c2-9f1e-be31cdb51a3d",
                                                "text": "The constables have delivered her over."
                                            },
                                            {
                                                "example_id": "c2765115-4d3d-456a-90f6-01eceff38198",
                                                "sense_id": "69b17117-0f42-30c2-9f1e-be31cdb51a3d",
                                                "text": "The exalted mind / All sense of woe delivers to the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To produce what is expected or required."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a649473-2bb2-4f11-85bb-5942f1cad932",
                                                "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                                "text": "deliver on a promise"
                                            },
                                            {
                                                "example_id": "5f4b9f4c-a13c-4ea5-b1a5-a5ddf74d9cf4",
                                                "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                                "text": "\"You know, he plays great sometimes when he doesn't score,\" Brown said. \"Tonight, with Rip (Richard Hamilton) struggling, we needed somebody to step up, and he really did. He really delivered.\""
                                            },
                                            {
                                                "example_id": "34601134-b653-4de5-b8e2-ad0f694a5916",
                                                "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                                "text": "However, ministers argue they are delivering the Brexit demanded by the electorate – and say it is time for businesses to wean themselves off cheap migrant labour."
                                            },
                                            {
                                                "example_id": "fd0e53d3-0a2c-4bdb-b0ac-3e3c26413313",
                                                "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                                "text": "This is our vital mission to ensure opportunity and prosperity for all people and future generations. I am determined to deliver. Thank you."
                                            },
                                            {
                                                "example_id": "0cfa05b9-05ee-4c33-9360-a69d56987910",
                                                "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                                "text": "But overall, I think the railway delivered very well on my travels. I'd give it 9/10 - there are just a few little rough edges that need smoothing off."
                                            },
                                            {
                                                "example_id": "1040d8c3-3fdd-44f4-81f7-4eeec0150336",
                                                "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                                "text": "But...what exactly are celebrities asking for in the first place? It’s a classic chicken-and-egg scenario. Dw, tho, I asked the pros firsthand: What are the elite set asking for this year, for those of us who want to get in on the trends a little early? And they delivered."
                                            },
                                            {
                                                "example_id": "82637fd0-c29b-4ef6-af83-b42f41a8da9a",
                                                "sense_id": "e26005a8-fc2b-30ae-b6a7-d98bb0b3c48b",
                                                "text": "England delivered the finest performance of head coach Thomas Tuchel's reign as they took a giant stride towards World Cup qualification by outclassing Serbia in Belgrade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fa5613a-04d1-3cfe-9ec0-1c9553d6741a",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To express in words or vocalizations, declare, utter, or vocalize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7c6bd69-90d6-40ed-b8a5-cf53bfa4c67e",
                                                "sense_id": "2fa5613a-04d1-3cfe-9ec0-1c9553d6741a",
                                                "text": "deliver a speech"
                                            },
                                            {
                                                "example_id": "21ca61f3-4721-49d9-a9a6-456e8828958e",
                                                "sense_id": "2fa5613a-04d1-3cfe-9ec0-1c9553d6741a",
                                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            },
                                            {
                                                "example_id": "235f7d78-dc1b-460c-a45c-fca2f366469b",
                                                "sense_id": "2fa5613a-04d1-3cfe-9ec0-1c9553d6741a",
                                                "text": "It’s a lovely sequence cut too short because the show seems afraid to give itself over to romance and whimsy and wistfulness when it has wedgie jokes to deliver."
                                            },
                                            {
                                                "example_id": "3267eff4-ed28-4912-9b46-c633e1de8162",
                                                "sense_id": "2fa5613a-04d1-3cfe-9ec0-1c9553d6741a",
                                                "text": "England went into the interval 22-6 down, a second [Owen] Farrell penalty their only response to Scotland’s burst of tries. They had not conceded more points in a Six Nations match in the Eddie Jones era and when the whistle blew for the interval, Dylan Hartley formed his players into a circle to deliver a rallying cry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f01f3486-3ce1-3e8e-aa14-8dfd085b004b",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To give forth in action or exercise; to discharge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf2e7ac7-9478-43d7-803c-8b77108a32f9",
                                                "sense_id": "f01f3486-3ce1-3e8e-aa14-8dfd085b004b",
                                                "text": "to deliver a blow"
                                            },
                                            {
                                                "example_id": "c3d1591c-b637-4c2f-b949-8ea9fa18e102",
                                                "sense_id": "f01f3486-3ce1-3e8e-aa14-8dfd085b004b",
                                                "text": "shaking his head and delivering some show of tears",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "f427c80b-7b9f-4210-8964-4be402984207",
                                                "sense_id": "f01f3486-3ce1-3e8e-aa14-8dfd085b004b",
                                                "text": "An uninstructed bowler […] thinks to attain the jack by delivering his bowl straight forward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc2681b9-e519-3b2a-a3df-40031a8f760f",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To discover; to show."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6cda37-ae8f-4c57-8109-efcf1efd3197",
                                                "sense_id": "cc2681b9-e519-3b2a-a3df-40031a8f760f",
                                                "text": "I'll deliver myself your loyal servant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6488d46f-610c-3375-8a7e-ae13d2595e58",
                                        "entry_id": "d47ca6bd-6385-39dd-96d1-fb82b94173f4",
                                        "glosses": [
                                            "To administer a drug."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deliver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43e794f2-056e-3d22-946f-4f47c46441eb",
                                        "entry_id": "5be9f497-38dc-3783-91e0-8c6121674d10",
                                        "glosses": [
                                            "Capable, agile, or active."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a5fb03-528f-4f64-a902-57f5a922175c",
                                                "sense_id": "43e794f2-056e-3d22-946f-4f47c46441eb",
                                                "text": "Therefore my policy and advice shall be this: That about the dead time of the night, when our enemies be most quiet at rest, there shall issue from us a number of the most deliverest soldiers to assault their camp; who shall give the assault right secretly, even directly against the entry of the camp, which is almost invincible."
                                            },
                                            {
                                                "example_id": "b1f7fab9-3b34-4e75-83da-3b200e2c905c",
                                                "sense_id": "43e794f2-056e-3d22-946f-4f47c46441eb",
                                                "text": "\"More skillful!\" interrupted the host. \"He is the most deliver at that exercise I have ever set eyes on.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0781576-01b0-486a-b132-ce2068e0ca03",
                        "source_entry_id": "3d323986-0707-3f18-a078-6a8fc76ceb44",
