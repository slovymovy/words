                ],
                "senses": [
                    {
                        "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                        "entry_id": "5223d504-8726-3245-b58a-9db73b9a7ac7",
                        "glosses": [
                            "Zoologie, Ichthyologie: im Meer lebender Raubfisch (Überordnung Selachii) aus der Klasse der Knorpelfische"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "955cb694-593e-4295-82d5-ebfc0c7c21d1",
                                "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                                "text": "Haifische sind gefürchtet."
                            },
                            {
                                "example_id": "9816d74e-9e34-40ca-b437-0d3ac5a27463",
                                "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                                "text": "„Es wimmelte von Haifischen, und wir mussten gut aufpassen, dass sie uns nicht am Bein schnappten, während wir uns mit den Baumstämmen abmühten.“"
                            },
                            {
                                "example_id": "ff788a5e-2826-49fb-a836-6e807bc6d177",
                                "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                                "text": "„Smoaks nahm den Haken, der seitlich im Kiefer des Haifischs steckte, und brachte ihn mehr in der Mitte an, damit der Hai sich leichter ins Schlepptau nehmen ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
