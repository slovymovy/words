                ],
                "senses": [
                    {
                        "sense_id": "11c102fa-a68c-3c59-8abd-37a41594704d",
                        "entry_id": "421015fc-f856-36ad-a693-0e42454f0cee",
                        "glosses": [
                            "Généraliser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131d2b32-a34a-46a1-a995-b16b835f0b6d",
                                "sense_id": "11c102fa-a68c-3c59-8abd-37a41594704d",
                                "text": "Les adeptes de la pensée critique évitent de surgénéraliser, c’est-à-dire d’étendre le résultat d’une réflexion ou d’une expérience à des situations qui ne ressemblent que superficiellement au fait étudié."
                            },
                            {
                                "example_id": "739afe4f-237f-4364-a0a4-c1ead5a83fb8",
                                "sense_id": "11c102fa-a68c-3c59-8abd-37a41594704d",
                                "text": "Il utilise au moins deux stratégies : l’une, de surgénéraliser des observations partielles sur le nombre ou le genre, par exemple ; l’autre, de choisir les images qui lui rappellent le plus ce qu’il a déjà vu souvent."
                            }
                        ]
                    }
                ],
