                "senses": [
                    {
                        "sense_id": "fbe75c3a-ffa9-3cb0-9095-ee7c7cd3407b",
                        "entry_id": "68823044-ef07-38f2-a0d2-90a87802b632",
                        "glosses": [
                            "Gesamtheit der Flexionsformen einer Sprache, die das Genus/das grammatische Geschlecht realisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7010d65e-5751-441c-bde9-a345520d9ee3",
                                "sense_id": "fbe75c3a-ffa9-3cb0-9095-ee7c7cd3407b",
                                "text": "„Diese nichtindogermanischen Nachbarsprachen haben nicht nur kein Genussystem, sie unterscheiden auch bei den Fürwörtern nicht zwischen er, sie und es.“"
                            },
                            {
                                "example_id": "8c4bf34f-8294-4839-86db-2915c566fc65",
                                "sense_id": "fbe75c3a-ffa9-3cb0-9095-ee7c7cd3407b",
                                "text": "„In Sprachen mit Genussystem besitzt jedes Substantiv ein bestimmtes Genus.“"
                            },
                            {
                                "example_id": "c4815438-e939-43fe-a3eb-2ea52f5ef054",
                                "sense_id": "fbe75c3a-ffa9-3cb0-9095-ee7c7cd3407b",
                                "text": "„Viele Deutschlernende verzweifeln am Genussystem, da ihnen die Wahl des Artikels zu willkürlich erscheint.“"
                            },
                            {
                                "example_id": "b0088f70-9178-481e-acbf-37f772e988a2",
                                "sense_id": "fbe75c3a-ffa9-3cb0-9095-ee7c7cd3407b",
                                "text": "„Das Limba, eine gemeinhin dem Atlantischen zugeordnete Sprache in Sierra Leone und Guinea, verfügt über ein komplexes Genussystem mit klaren Bezügen zum Niger-Kongo.“"
                            },
                            {
                                "example_id": "41540b1a-bbce-4263-94a5-f7f9ff99bf55",
                                "sense_id": "fbe75c3a-ffa9-3cb0-9095-ee7c7cd3407b",
                                "text": "„In dieser Arbeit wird das deutsche Genussystem aus der Perspektive des Genuslernens und -unterrichts untersucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
