                        "entry_id": "b580cae6-9531-3086-baa8-1520b74a30c1",
                        "glosses": [
                            "Wiederherstellung aller Dinge am Ende der Zeiten, insbesondere in ihrer ursprünglichen Vollkommenheit"
                        ],
                        "tags": [
                            "Theologie",
                            "Eschatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "18ec59c2-1a0e-4214-b871-aafde177aa97",
                                "sense_id": "943b15b4-adea-3b9a-9617-3bfbc89fb3fd",
                                "text": "Schon die Pythagoreer sollen eine Apokatastasis gelehrt haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aca7f54-059d-45f5-a741-5e8586f5f7e2",
                        "source_entry_id": "b580cae6-9531-3086-baa8-1520b74a30c1",
                        "source_sense_id": "943b15b4-adea-3b9a-9617-3bfbc89fb3fd",
                        "source_sense_description": "Wiederherstellung aller Dinge am Ende der Zeiten in ihrer ursprünglichen Vollkommenheit",
                        "target_lang_word": "apocatastasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apocatastasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "393d58d3-6243-3d7e-8f30-7d4e2421dc91",
                                        "entry_id": "f7aeef76-0203-3ff9-b02b-c95ca74a8bb0",
                                        "glosses": [
                                            "Restoration, renovation, reestablishment",
                                            "An apocalypse leading to the remaking of the world rather than a Final Judgment, (Christianity) an Origenist doctrine condemned by the 543 C.E. Synod of Constantinople."
                                        ],
                                        "tags": [
                                            "especially",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e1dc39-80c3-4d2e-b5c7-e6365603c95a",
                                                "sense_id": "393d58d3-6243-3d7e-8f30-7d4e2421dc91",
                                                "text": "The Egyptians were the first assertors of the soul's immortality, and of its transmigration, after the death and corruption of this body, into the bodies of other animals successively, viz. until it have run round through the whole circuit of terrestrial, marine, and volatile animals, after which, they say, it is to return again into a human body; they supposing this revolution or apocatastasis of souls to be made in no less space than that of three thousand years."
                                            },
                                            {
                                                "example_id": "a019659e-a0b3-4e5a-b88e-032b90f42eab",
                                                "sense_id": "393d58d3-6243-3d7e-8f30-7d4e2421dc91",
                                                "text": "If anyone shall say that all reasonable beings will one day be united in one, when the hypostases as well as the numbers and the bodies shall have disappeared,... moreover, that in this pretended apocatastasis, spirits only will continue to exist... let him be anathema.\nA Tradition...concerning the Apocatastasis of the World...partly by Inundation and partly by Conflagration."
                                            },
                                            {
                                                "example_id": "03719933-3712-4e85-a4d5-615e6282026e",
                                                "sense_id": "393d58d3-6243-3d7e-8f30-7d4e2421dc91",
                                                "text": "The Stoic idea was based upon an astronomical doctrine according to which the return (apokatastasis) of the planets to their proper \"celestial signs\" initiates the conflagration (ekpurôsis), which is the reduction of the entire cosmos to its primal element (fire), after which follows the rebirth of all existing things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70f3020-c5b0-3c2a-962f-334b8ccc14d1",
                                        "entry_id": "f7aeef76-0203-3ff9-b02b-c95ca74a8bb0",
                                        "glosses": [
                                            "Restoration, renovation, reestablishment",
                                            "The doctrine that all souls will enter heaven or paradise, (Christianity) an Origenist doctrine condemned by the 543 C.E. Synod of Constantinople."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be1157f-7512-41be-b211-cfc9771cda22",
                                                "sense_id": "a70f3020-c5b0-3c2a-962f-334b8ccc14d1",
                                                "text": "No doctrine...contradicts the Holy Scripture in a more unwarrantable manner than that of the so-called Apokatastasis."
                                            },
                                            {
                                                "example_id": "fc317180-2916-49d3-8607-fe86ae2c76f4",
                                                "sense_id": "a70f3020-c5b0-3c2a-962f-334b8ccc14d1",
                                                "text": "Apocatastasis, A name given in the history of theology to the doctrine which teaches that a time will come when all free creatures will share in the grace of salvation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169f7734-adf7-3a61-965b-d71333f68166",
                                        "entry_id": "f7aeef76-0203-3ff9-b02b-c95ca74a8bb0",
                                        "glosses": [
                                            "Restoration, renovation, reestablishment",
                                            "Return to an earlier condition."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bccae2f4-cd8a-4b24-8675-f9f85ce302fe",
                                                "sense_id": "169f7734-adf7-3a61-965b-d71333f68166",
                                                "text": "We read of Apocatastasis or urine...of tumours, and other diseases."
                                            },
                                            {
                                                "example_id": "31343ea1-69fc-4d87-b007-85914cae9c60",
                                                "sense_id": "169f7734-adf7-3a61-965b-d71333f68166",
                                                "text": "Apocatastasis, The subsidence of a tumour, or the re-establishment of an exudation or secretion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a954601-5dad-3d09-b5cc-fd4599d59044",
                                        "entry_id": "f7aeef76-0203-3ff9-b02b-c95ca74a8bb0",
                                        "glosses": [
                                            "Restoration, renovation, reestablishment",
                                            "Return to the same apparent position, as after a revolution."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d59a80e-36de-4338-9361-d3e76568965d",
                                                "sense_id": "2a954601-5dad-3d09-b5cc-fd4599d59044",
                                                "text": "The accurate apocatastasis (i.e. regression to the same sign) of the moon, and in a similar manner of the sun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
