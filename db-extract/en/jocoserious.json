                "senses": [
                    {
                        "sense_id": "8137d648-2f28-3800-a5ac-182f36a2b8a9",
                        "entry_id": "5626b1b8-742b-33bb-b915-891367649f1d",
                        "glosses": [
                            "Simultaneously jocular and serious; mixing mirth with serious matters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3826b63d-33b3-42b0-b83d-3fcbcb133370",
                                "sense_id": "8137d648-2f28-3800-a5ac-182f36a2b8a9",
                                "text": "Our proposed removal to Mr. Small's was, as you suppose, a jest, or rather a joco-serious matter. We never looked upon it as entirely feasible, yet we saw in it something so like practicability, that we did not esteem it altogether unworthy of our attention. It was one of those projects which people of lively imaginations play with, and admire for a few days, and then break in pieces."
                            },
                            {
                                "example_id": "18b18e8a-50df-465d-a663-93128f0e7d62",
                                "sense_id": "8137d648-2f28-3800-a5ac-182f36a2b8a9",
                                "text": "“His genius was jocular; but, when disposed, he could be very serious.” It is a part of his joco-serious vein of late."
                            },
                            {
                                "example_id": "229b3885-1690-4ce4-8f64-fc871467c3e8",
                                "sense_id": "8137d648-2f28-3800-a5ac-182f36a2b8a9",
                                "text": "Was the guest conscious of and did he acknowledge these marks of hospitality? His attention was directed to them by his host jocosely, and he accepted them seriously as they drank in jocoserious silence Epps's massproduct, the creature cocoa."
                            }
                        ]
                    }
