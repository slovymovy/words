                ],
                "senses": [
                    {
                        "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                        "entry_id": "405af8f8-72dd-3ea9-8dc7-e8430d85356a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46083bb6-645e-44b3-9401-62fb72067362",
                                "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                                "text": "Frau Kauffmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "42649517-8d13-49e2-a076-fc015284e166",
                                "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                                "text": "Herr Kauffmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "894a1f24-e460-4d28-bdc8-5fa720219ce5",
                                "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                                "text": "Die Kauffmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6886ded6-f248-4cbd-80cb-393218a7f365",
                                "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                                "text": "Der Kauffmann trägt nie die Schals, die die Kauffmann ihm strickt."
                            },
                            {
                                "example_id": "0c41f3d6-ec8c-4ddf-8148-0e0553f36398",
                                "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kauffmann kommt, geht der Herr Kauffmann.“"
                            },
                            {
                                "example_id": "85c8309a-66e1-4189-8b17-61a2a4a6a688",
                                "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                                "text": "Kauffmann kommt und geht."
                            },
                            {
                                "example_id": "fc85f891-d98f-4ec1-9147-efe096ca8d18",
                                "sense_id": "5f1d5846-eddc-3d3e-bca6-5b49757fdc96",
                                "text": "Kauffmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
