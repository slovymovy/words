                "senses": [
                    {
                        "sense_id": "752a0a1c-c38c-3f0c-8d28-a9ac56d07ddb",
                        "entry_id": "01746efa-7b71-3df8-b46c-c7eec2c8274a",
                        "glosses": [
                            "Akt oder Haltung, zugunsten anderer auf die Wahrung der eigenen Interessen zu verzichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "098d58b3-5afb-4a4b-a386-d76d63de4746",
                                "sense_id": "752a0a1c-c38c-3f0c-8d28-a9ac56d07ddb",
                                "text": "„Der Verzicht der mährischen Deutschen auf ihre Mehrheit sei ein Akt der Selbstverleugnung.“"
                            },
                            {
                                "example_id": "e5532b7f-79e8-4c3c-97b8-4640531305f0",
                                "sense_id": "752a0a1c-c38c-3f0c-8d28-a9ac56d07ddb",
                                "text": "„Schweigend, jedoch mit der den Indianern eigentümlichen Selbstverleugnung folgte er dem greisen Häuptlinge durch eine Landschaft, die von der, durch welche sie bisher gekommen waren, gänzlich verschieden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2addfd16-183b-417e-aeef-1318e0bc8e07",
                        "source_entry_id": "01746efa-7b71-3df8-b46c-c7eec2c8274a",
                        "source_sense_id": "752a0a1c-c38c-3f0c-8d28-a9ac56d07ddb",
