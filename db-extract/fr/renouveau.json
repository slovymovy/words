                    {
                        "sense_id": "d5bebf22-40c3-318d-8cd2-fa4daad0f6cf",
                        "entry_id": "633be7d5-5ee8-33a8-932d-44d02a3e96af",
                        "glosses": [
                            "Retour du printemps ; début du printemps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ef5762-549c-4b85-a8ac-86d6cc7dd523",
                                "sense_id": "d5bebf22-40c3-318d-8cd2-fa4daad0f6cf",
                                "text": "La nature se réveillait de son long sommeil […] L'effet de ce renouveau est peut-être plus sensible au milieu des contrées hyperboréennes qu’en tout autre point du globe."
                            },
                            {
                                "example_id": "21b4a603-f22b-49da-a2e7-3715a3f6c41a",
                                "sense_id": "d5bebf22-40c3-318d-8cd2-fa4daad0f6cf",
                                "text": "En tout cinq générations, un arbre humain qui, à cinq printemps déjà, à cinq renouveaux de l’humanité, a poussé des tiges, sous le flot de sève de l’éternelle vie !"
                            }
                        ]
                    },
                    {
                        "sense_id": "bd3b5d70-d860-3b77-af79-1c6464f9a187",
                        "entry_id": "633be7d5-5ee8-33a8-932d-44d02a3e96af",
                        "glosses": [
                            "Retour de quelque chose après son déclin."
                        ],
                        "tags": [],
                        "examples": []
                    }
