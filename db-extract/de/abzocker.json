                    {
                        "sense_id": "81884a6f-46f5-3cc2-8f06-931ccee13b0c",
                        "entry_id": "5bf9fedf-7823-3e17-9a9e-3ef6ffc10c3c",
                        "glosses": [
                            "finanzieller Betrüger"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "0c7be8c2-1679-4fb0-b304-b8cca08032b5",
                                "sense_id": "81884a6f-46f5-3cc2-8f06-931ccee13b0c",
                                "text": "Unerfahrene Verbraucher werden häufig von Abzockern hereingelegt."
                            },
                            {
                                "example_id": "61297b4b-7772-4806-913c-8d393e3469fa",
                                "sense_id": "81884a6f-46f5-3cc2-8f06-931ccee13b0c",
                                "text": "„Anders ist es kaum zu erklären, dass es Abzocker seit Jahrhunderten schaffen, mit ihrer Masche den Leuten das Geld aus der Tasche zu ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48b64d82-68db-4be8-b3ca-d6d3b0ec8031",
                        "source_entry_id": "5bf9fedf-7823-3e17-9a9e-3ef6ffc10c3c",
                        "source_sense_id": "81884a6f-46f5-3cc2-8f06-931ccee13b0c",
                        "source_sense_description": "salopp: finanzieller Betrüger",
                        "target_lang_word": "swindler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swindler",
