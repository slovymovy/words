                        "examples": [
                            {
                                "example_id": "aa646a8a-fb0d-4f38-9dd2-d40e08b7233d",
                                "sense_id": "064265ef-cfea-3deb-a0f4-6eb24372315a",
                                "text": "Rosie the Riveter is an iconic piece of American WWII propaganda."
                            },
                            {
                                "example_id": "1ddf127a-7b0a-422d-8f73-6b5d80b63e54",
                                "sense_id": "064265ef-cfea-3deb-a0f4-6eb24372315a",
                                "text": "Ev'ry one stops to admire the scene / Rosie at work on the B-19 / She's never twittery / nervous or jittery / Rosie the riveter"
                            }
                        ]
                    },
                    {
                        "sense_id": "d57f39e8-a415-3ac9-a758-f1c8861e8ee7",
                        "entry_id": "cbfc3bca-771f-3505-a445-0d534b2fcfa5",
                        "glosses": [
                            "A machine or tool used to apply rivets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e32788-135f-4e41-888c-79d58cb5c0a0",
                                "sense_id": "d57f39e8-a415-3ac9-a758-f1c8861e8ee7",
                                "text": "The beam couldn't support the weight of the riveter, so the workers were riveting by hand."
                            }
                        ]
