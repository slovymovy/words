                ],
                "senses": [
                    {
                        "sense_id": "fe85ae12-acde-300e-b2aa-4f587e051a7b",
                        "entry_id": "50206784-ffe9-3936-beb5-d575a36ff577",
                        "glosses": [
                            "Raccommoder, remettre en état."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405d777d-165b-4f52-ae84-050c79994f06",
                                "sense_id": "fe85ae12-acde-300e-b2aa-4f587e051a7b",
                                "text": "Je pourrais emprunter à Maloup, mais nous sommes en froid elle et moi, et pas question de rembiner mon coup en la faisant rentrer chez vous avec ses tétines de mère de famille."
                            },
                            {
                                "example_id": "92cc41c2-49b7-4fb5-aed0-578f890664d5",
                                "sense_id": "fe85ae12-acde-300e-b2aa-4f587e051a7b",
                                "text": "Si vous me trouvez 16 paquets de gitanes, vides, bien sûr, je ne dessine pas par intérêt, je vous en ferai un jeu neuf, dis-je pour rembiner mon monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1924211-5e21-3515-9274-da18438828ed",
                        "entry_id": "50206784-ffe9-3936-beb5-d575a36ff577",
                        "glosses": [
                            "Essayer de rentrer dans les bonnes grâces de quelqu’un, séduire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89df3217-62b0-4199-9c3e-8888e9620b27",
                                "sense_id": "a1924211-5e21-3515-9274-da18438828ed",
                                "text": "Je vais me la rembiner vite fait."
                            }
                        ]
                    }
