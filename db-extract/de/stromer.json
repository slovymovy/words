                "senses": [
                    {
                        "sense_id": "ebf6b34b-0789-39d3-b241-3d0c0ee59df6",
                        "entry_id": "9095114a-d6ba-3b52-ba99-644441951434",
                        "glosses": [
                            "öfter umherstreifender Mensch"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "7b4ea2b2-3756-4e41-9aec-eafe97c54ba1",
                                "sense_id": "ebf6b34b-0789-39d3-b241-3d0c0ee59df6",
                                "text": "Er ist ein Stromer geworden, erst keine Arbeit mehr, dann die Ehe hin und die Wohnung weg."
                            },
                            {
                                "example_id": "a0bdd00e-6e4e-4fed-a39c-d183fa748212",
                                "sense_id": "ebf6b34b-0789-39d3-b241-3d0c0ee59df6",
                                "text": "Mein Kater ist ein Stromer, der kommt nur noch zum Fressen nach Hause, oder wenn er krank ist."
                            },
                            {
                                "example_id": "31721747-d6c9-4988-bcc9-e8095bd4deab",
                                "sense_id": "ebf6b34b-0789-39d3-b241-3d0c0ee59df6",
                                "text": "„Der Stromer brauchte keine weitere Aufforderung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3839201e-3518-3ca1-ab02-738af028d0cc",
                        "entry_id": "9095114a-d6ba-3b52-ba99-644441951434",
                        "glosses": [
                            "liebes, aber im Moment vielleicht ein klein wenig freches Kind"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "244c4fd7-c7eb-46d8-a656-1d47d70a9134",
                                "sense_id": "3839201e-3518-3ca1-ab02-738af028d0cc",
                                "text": "Du kleiner Stromer!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
