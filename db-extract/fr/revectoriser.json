                "senses": [
                    {
                        "sense_id": "1b2f1012-d26e-3c46-a5b6-071ccf172ec3",
                        "entry_id": "28c0cfd9-0bd3-37b0-9d6e-7f3ebf6fea6f",
                        "glosses": [
                            "Vectoriser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda751e8-9283-42bc-8ae9-a2ed34cb19be",
                                "sense_id": "1b2f1012-d26e-3c46-a5b6-071ccf172ec3",
                                "text": "Aucune syntagmatique ne semble pouvoir s'imposer, qui parviendrait à revectoriser l'existence."
                            },
                            {
                                "example_id": "7a455a13-0dcf-48db-9c1f-4f6dc7ae8071",
                                "sense_id": "1b2f1012-d26e-3c46-a5b6-071ccf172ec3",
                                "text": "À l'opposé d'une tradition ou d'un savoir hégémonique, le document souhaite faire acte de transmission, de passager (Martineau 1987) qui amorce un mouvement, un désir, de dépassement afin de recoordonner les représentations et de les revectoriser dans la recherche de nouveaux sens."
                            }
                        ]
                    }
