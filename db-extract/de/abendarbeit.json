                "senses": [
                    {
                        "sense_id": "0aa6f12a-ca11-384c-b318-f3ede7099a00",
                        "entry_id": "e2aaa150-2ba3-3f2c-af6e-874548eb7756",
                        "glosses": [
                            "Arbeit, die in den Abendstunden verrichtet wird"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "d8f97aa8-ea88-47ed-82ac-12f18190ea5d",
                                "sense_id": "0aa6f12a-ca11-384c-b318-f3ede7099a00",
                                "text": "„Als alle Abendarbeit verrichtet war, und sie zu Bett gehen wollten, sagte die alte Lisa zu Barbro: »Ist es jetzt ganz sicher, daß du den Jungen am Leben lassen willst?«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c56aac0e-b721-3b99-9395-bd2da3e7ebf0",
                        "entry_id": "e2aaa150-2ba3-3f2c-af6e-874548eb7756",
                        "glosses": [
                            "Erwerbstätigkeit außerhalb der normalen Arbeitszeiten, die weder Früh- noch Nachtschichtarbeit ist (Schweiz: Arbeit von 20 bis 23 Uhr)"
                        ],
                        "tags": [
                            "Arbeitsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "b1974dca-8afc-46dd-abf2-8f63502eaf27",
                                "sense_id": "c56aac0e-b721-3b99-9395-bd2da3e7ebf0",
                                "text": "„Die Arbeit von 6 Uhr bis 20 Uhr gilt als Tagesarbeit, die Arbeit von 20 Uhr bis 23 Uhr ist Abendarbeit. Tages- und Abendarbeit sind bewilligungsfrei. Abendarbeit kann vom Arbeitgeber nach Anhörung der Arbeitnehmervertretung im Betrieb oder, wo eine solche nicht besteht, der betroffenen Arbeitnehmer eingeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
