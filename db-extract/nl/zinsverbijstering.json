                ],
                "senses": [
                    {
                        "sense_id": "054d9bd8-eb18-39ab-8364-de3efb5b8ac9",
                        "entry_id": "bc3dcf99-35f0-373a-9545-4025f9fa49eb",
                        "glosses": [
                            "tijdelijke periode van waanzin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ad01d9-e6f3-4e19-85fe-1427f5bc4c62",
                                "sense_id": "054d9bd8-eb18-39ab-8364-de3efb5b8ac9",
                                "text": "In een vlaag van zinsverbijstering sprong de man het veld op en wist hij de vijandelijke doelpoging te verijdelen met een prachtige sliding tackle. En hij had ondertussen ook nog zijn medische tassen vast!"
                            },
                            {
                                "example_id": "63cd0165-1005-4ef1-8325-44a9ceb3b4a9",
                                "sense_id": "054d9bd8-eb18-39ab-8364-de3efb5b8ac9",
                                "text": "De echtgenoot van de vrouw trof het drietal dinsdagavond aan. Justitie stelde dat de zelfmoorden plaatsvonden uit „collectieve zinsverbijstering.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abea3445-010f-41e1-acb2-37e0d1acd5bc",
                        "source_entry_id": "bc3dcf99-35f0-373a-9545-4025f9fa49eb",
                        "source_sense_id": "054d9bd8-eb18-39ab-8364-de3efb5b8ac9",
                        "target_lang_word": "madness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                        "entry_id": "9d5c48f5-7621-356c-a9d4-6f3670a58b97",
                                        "glosses": [
                                            "The state of being mad; insanity; mental disease."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0c2cc5-9343-4fb3-b200-6e0e1bf45db6",
                                                "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                                "text": "Though this be madneſſe, / Yet there is Method in 't: […]"
                                            },
                                            {
                                                "example_id": "cfcba4c9-1c35-42bb-a642-d897a3b8b3d3",
                                                "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                                "text": "You were lonely for a man\nI said, \"Take me as I am\"\n'Cause you might enjoy some madness for a while"
                                            },
                                            {
                                                "example_id": "cee48d41-9d77-4eb8-9667-712d733d1203",
                                                "sense_id": "ef361824-835b-36bb-a554-5392b7947ced",
                                                "text": "Shepard: What's wrong with your assistant?\nDr. Warren: Manuel has a brilliant mind, but he's always been a bit... unstable. Genius and madness are two sides of the same coin.\nDr. Manuel: Is it madness to see the future? To see the destruction rushing towards us? To understand there is no escape? No hope? No, I am not mad. I'm the only sane one left!\nDr. Warren: I gave him an extra dose of his meds after the attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a61686e-11f0-3bcc-b18b-e7d7ac834ff2",
                                        "entry_id": "9d5c48f5-7621-356c-a9d4-6f3670a58b97",
                                        "glosses": [
                                            "The state of being angry."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28bf2cbc-138a-3e85-ab7f-28c8d1bf3d38",
                                        "entry_id": "9d5c48f5-7621-356c-a9d4-6f3670a58b97",
