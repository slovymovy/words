                "senses": [
                    {
                        "sense_id": "b9039bee-2472-311c-b3c2-a86df776c277",
                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                        "glosses": [
                            "grobe, ruppige, wenig feinfühlige Art"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e0acdf27-673b-46f6-a56f-e26847bee8cf",
                                "sense_id": "b9039bee-2472-311c-b3c2-a86df776c277",
                                "text": "Seine Grobheit erregte immer wieder Abscheu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                        "glosses": [
                            "Verhalten, sich grob zu äußern oder grob zu handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6388195d-774f-4716-a9a3-8e5046cecb66",
                                "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                "text": "„Auf dem Heimweg brabbelt er allerlei sexuelle Grobheiten vor sich hin.“"
                            },
                            {
                                "example_id": "bebb6783-735c-4b1f-8b4b-ecf1b9c7c117",
                                "sense_id": "e52ce0ac-dc7f-3bca-aaac-67460c5d19af",
                                "text": "„Mochten sich die einen an Luthers Schriften begeistern, andere sich über sie empören, wieder andere sich kopfschüttelnd über seine Grobheiten amüsieren – gleichgültig ließen sie niemanden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e5ba6207-6ee8-3f54-a9d6-084ecc8c99d5",
                        "entry_id": "10a1e9dd-9f72-37c4-b2b5-04993288f9d2",
                        "glosses": [
                            "Eigenschaft eines groben, rauen Materials; Eigenschaft, sich grob/rau anzufühlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "751abf1b-028a-4f66-9a64-4e1a31faa2af",
                                "sense_id": "e5ba6207-6ee8-3f54-a9d6-084ecc8c99d5",
                                "text": "Ein Tuch von solcher Grobheit schien uns in diesem Fall nicht passend zu sein."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
