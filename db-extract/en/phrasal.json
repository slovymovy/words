                            {
                                "target_word": "φραστικός",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "27004326-fcbc-309f-8ab8-5ba8856b3518",
                                        "entry_id": "d05198b8-8653-309e-b46e-46788c89c7f1",
                                        "glosses": [
                                            "αυτός που γίνεται μέσω του λόγου· λεκτικός, προφορικός ή εκφραστικός"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1955d591-9701-4256-b819-ce2715ec8ca1",
                                                "sense_id": "27004326-fcbc-309f-8ab8-5ba8856b3518",
                                                "text": "Το λάθος στο κείμενο ήταν φραστικό, πρόκειται για παρερμηνεία (συντακτικό λάθος ή επιλογή άκομψης λέξης)"
                                            },
                                            {
                                                "example_id": "a3411416-712b-4394-9911-f77462d74acc",
                                                "sense_id": "27004326-fcbc-309f-8ab8-5ba8856b3518",
                                                "text": "Οι δύο άνδρες είχαν έναν φραστικό διαπληκτισμό (τσακώθηκαν αλλά αντάλλαξαν κουβέντες χωρίς να έρθουν στα χέρια)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc531003-c2ea-3b36-bd08-e32a464a4b5c",
                                        "entry_id": "d05198b8-8653-309e-b46e-46788c89c7f1",
                                        "glosses": [
                                            "που σχετίζεται με τη φράση"
                                        ],
                                        "tags": [
                                            "γλωσσολογία"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "614a8947-3de4-48d0-8def-d455e837aec9",
                        "source_entry_id": "66d50542-9c00-3fdc-89e8-de7e79ffa666",
                        "source_sense_description": "being a phrase",
                        "target_lang_word": "εκφραστικός",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "εκφραστικός",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "77e55ad8-7a3c-301f-8d8f-552997f6c531",
                                        "entry_id": "caae036d-c1c1-3d50-bece-07246c122ca8",
                                        "glosses": [
                                            "που εκδηλώνει συναισθήματα, που εκφράζεται"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b427532a-7db1-4e7e-9b09-889abe760e50",
                                                "sense_id": "77e55ad8-7a3c-301f-8d8f-552997f6c531",
                                                "text": "※ Σε όλες τις προσπάθειές του παραμένει εξπρεσιονιστής, που όχι μόνο σχεδιάζει με χρώμα, αλλά και κατορθώνει να μεταφέρει στη ζωγραφική επιφάνεια όλο τον εσωτερικό χαρακτήρα και το εκφραστικό περιεχόμενο του χρώματος, χωρίς να θυσιάζει την οπτική πραγματικότητα. (Δώρα Κομίνη-Διαλέτη, Λεξικό Ελλήνων καλλιτεχνών: ζωγράφοι, γλύπτες, χαράκτες, 16ος-20́ος αιώνας, Πατ-Ω. τομος 4, εκδ. Μέλισσα, 2000, σελ. 278)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5435d1cd-2a78-3d65-94b3-cb113c374aa9",
                                        "entry_id": "caae036d-c1c1-3d50-bece-07246c122ca8",
                                        "glosses": [
                                            "φωνολογικό ή γραμματικό στοιχείο (σπανιότερα συντακτικό) που προσδίδει σε «εκφραστικές λέξεις», ζωντάνια και έμφαση, μερικές φορές και με τη συμμετοχή ηχομιμητικών στοιχείων, ή κάποιας παρετυμολογίας (όπως στο «εφτάζυμος»), με διπλασιασμούς (όπως στο όπα όπα), ή με τη βιωματική χρήση λέξεων (όπως στο «έγινε χαμός»)"
                                        ],
                                        "tags": [
                                            "γλωσσολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c91ebc4-bd41-4028-bc3f-6b655fa8ccb9",
                                                "sense_id": "5435d1cd-2a78-3d65-94b3-cb113c374aa9",
                                                "text": "εκφραστικοί φθόγγοι στα ελληνικά, όπως [sf] (όπως στο σφάζω), [sx], [sç] (όπως στο σχίζω)"
                                            },
                                            {
                                                "example_id": "f8caf23f-7f34-45ac-a212-e7f2157efe3d",
                                                "sense_id": "5435d1cd-2a78-3d65-94b3-cb113c374aa9",
                                                "text": "εκφραστική επανάληψη, όπως στον εκφραστικό διπλασιασμό στη λέξη χάχανο"
                                            },
                                            {
                                                "example_id": "660e0ad4-9103-4f49-b550-e9233ee53de0",
                                                "sense_id": "5435d1cd-2a78-3d65-94b3-cb113c374aa9",
                                                "text": "Κατηγορία:Εκφραστικοί όροι στο Βικιλεξικό"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
