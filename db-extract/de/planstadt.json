                "senses": [
                    {
                        "sense_id": "a59f5865-d21d-3b0d-84e1-c1b91d46c451",
                        "entry_id": "042c0309-314d-3f1d-8868-12570e71704f",
                        "glosses": [
                            "auf einer freien Fläche aufgrund eines erkennbaren Planes erbaute Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "623c1225-9fc8-4793-b444-542eafb5f819",
                                "sense_id": "a59f5865-d21d-3b0d-84e1-c1b91d46c451",
                                "text": "„Prägnanter, so meine ich, lassen sich die Hinterlassenschaften der Utopie der sozialistischen Menschengemeinschaft, jener Zeit also, in der – wie es in einer Parole aus der Gründungszeit der sozialistischen Planstadt Halle-Neustadt heißt – ‚das Morgen schon Gegenwart‘ war, kaum historisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48c18c52-64b9-48b6-9bb8-87911e8391d0",
                        "source_entry_id": "042c0309-314d-3f1d-8868-12570e71704f",
                        "source_sense_id": "a59f5865-d21d-3b0d-84e1-c1b91d46c451",
                        "source_sense_description": "auf einer freien Fläche aufgrund eines erkennbaren Planes erbaute Stadt",
                        "target_lang_word": "ville nouvelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ville nouvelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c4b4572-3aff-39ac-aa87-b24965f3331b",
                                        "entry_id": "69f4a06e-e0ca-3349-a541-ba57cf434f26",
                                        "glosses": [
                                            "Ville créée de manière planifiée sur un emplacement peu ou pas habité."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aac252b-1de8-4faf-a281-13fd72112c63",
                                                "sense_id": "8c4b4572-3aff-39ac-aa87-b24965f3331b",
                                                "text": "Si on considère la plupart des villes nouvelles européennes, Louvain-la-Neuve est sans doute un exemple unique par l'absence de quartiers d'habitations répétitives."
                                            },
                                            {
                                                "example_id": "7d7a4c4f-1d37-411c-a51e-f0f91222de8f",
                                                "sense_id": "8c4b4572-3aff-39ac-aa87-b24965f3331b",
                                                "text": "La première étape, par exemple permet d’aller de Versailles, la ville nouvelle de Louis XIV, à Cergy, ville nouvelle voulue par De Gaulle dans les années soixante."
                                            },
                                            {
                                                "example_id": "054febed-4d51-4928-8c2a-7df6b9c7a837",
                                                "sense_id": "8c4b4572-3aff-39ac-aa87-b24965f3331b",
                                                "text": "Quant aux marécages, ils ont été asséchés pour devenir des terrains à bâtir. La commune de la ville nouvelle est ainsi devenue une ville où les lotissements sont rois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
