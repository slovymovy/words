                        ],
                        "examples": [
                            {
                                "example_id": "71878b04-6d35-46aa-b466-478d53936e26",
                                "sense_id": "35c94e35-ef6e-305f-a75c-204f23208dfc",
                                "text": "Bei einem Ausweichmanöver war der Bus auf dem Berliner Ring gegen einen Brückenpfeiler geprallt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0c759e71-e1e0-3128-9f55-5fb4835d389d",
                        "entry_id": "5b7d4580-4877-3832-913f-74694148a987",
