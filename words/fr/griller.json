                    ]
                },
                {
                    "sense_id": "7bb5bef9-2a7d-3335-b96e-51c497675696",
                    "sense_definition": "Éprouver une très vive impatience ou un désir ardent de faire quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impatience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>grillait</w> d'envie de lui raconter tout ce qu'elle venait de découvrir."
                        },
                        {
                            "text": "Toute l'équipe <w>grille</w> de savoir si le nouveau projet sera finalement accepté."
