                        "examples": [
                            {
                                "example_id": "48e9810e-742a-41ad-96c8-c9728ca643c0",
                                "sense_id": "0747406b-5155-3e04-9224-9d74a6414fa3",
                                "text": "Das Kind ist ein richtiger Plärrer."
                            },
                            {
                                "example_id": "ff55be73-d50f-4a30-84f5-50077a07b337",
                                "sense_id": "0747406b-5155-3e04-9224-9d74a6414fa3",
                                "text": "„Bißchen Armseligkeit! Los, mach schon! Verzieh dich! Du Nichts! Du Nullundnichtig! Laß mich hier hängen! Geb mich nur auf! Du Plärrer! Wie früher schon! Laß mich allein! Du Bindfaden! Du Dünnpfiff! Du letzter Heuler! Nimm keine Rücksicht!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3372bfa8-3434-3ffb-ace3-10c3bca5d741",
                        "entry_id": "28d20700-e2e5-323a-90b5-1518046660a4",
                        "glosses": [
                            "zweimal jährlich stattfindendes Volksfest in Augsburg auf dem Kleinen Exerzierplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1025fa62-1438-4df7-b54d-ad572f837fc3",
                                "sense_id": "3372bfa8-3434-3ffb-ace3-10c3bca5d741",
                                "text": "Ich versuche dieses Jahr noch auf den Plärrer zu gehen."
                            }
