                        "source_entry_id": "768e87bf-0b25-36ed-9bae-29002cb283ec",
                        "source_sense_id": "fc3aaae2-b394-3ab1-b521-450ad984c00f",
                        "target_lang_word": "catarrh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catarrh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                        "entry_id": "595d2f27-f8c0-3c9d-aeb7-0c1867b39378",
                                        "glosses": [
                                            "Inflammation of a mucous membrane.",
                                            "Especially, that of the nose and throat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da8cc78-eaae-4bad-833a-fe12fa278d5c",
                                                "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                                "text": "And then as to your ſcurvys, and gouts, rheumatiſms, conſumptions, coughs and catarrhs, tar-vvater and turpentine vvill make you as ſound as a roach."
                                            },
                                            {
                                                "example_id": "af9f2ff9-098a-4109-94db-170f9e6d33f2",
                                                "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                                "text": "Jonah mixed him a pitch-like potion of gin and molasses, which he swore was a sovereign cure for all colds and catarrhs whatsoever […]"
                                            },
                                            {
                                                "example_id": "e33883cf-ffa0-4817-858b-bb0691bbdef1",
                                                "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                                "text": "\"Where I went wrong,\" he said, still speaking in that low, husky voice as if he had been a ghost suffering from catarrh, \"was in getting engaged to Phyllis Mills.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5813ca1-e8e4-3375-8d4b-aad97675c548",
                                        "entry_id": "595d2f27-f8c0-3c9d-aeb7-0c1867b39378",
                                        "glosses": [
                                            "Inflammation of a mucous membrane.",
                                            "The discharge (fluid) associated with this condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "562368bd-d962-498a-99df-a0257b182792",
                                                "sense_id": "a5813ca1-e8e4-3375-8d4b-aad97675c548",
                                                "text": "He coughed violently and spit out the catarrh irritating his throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e31ca0-a690-3018-9c91-45fd9ff3fce4",
                                        "entry_id": "595d2f27-f8c0-3c9d-aeb7-0c1867b39378",
                                        "glosses": [
                                            "Inflammation of a mucous membrane.",
                                            "Rhinitis or rhinosinusitis; cold or coldlike illness; common cold."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
