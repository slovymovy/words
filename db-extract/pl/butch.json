                        "translation_id": "767ef3a5-82a6-415f-9ee4-ad535165aa51",
                        "source_entry_id": "67d8bbd3-342e-3e19-83cc-427f5884b82c",
                        "source_sense_id": "b7209f48-0278-3c77-893a-624a77c85024",
                        "target_lang_word": "butch",
                        "target_lang_code": "en",
