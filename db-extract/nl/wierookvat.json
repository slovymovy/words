                "senses": [
                    {
                        "sense_id": "8003f848-d895-3993-a41b-fbc4ce6e01ee",
                        "entry_id": "546c7dc4-1ac2-39fc-8dcd-1d0281004b8e",
                        "glosses": [
                            "vat waarin men wierook kan verbranden en waarmee men de welriekende rook kan verspreiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0062a8b-9b0e-4990-9857-306eb2d3389a",
                                "sense_id": "8003f848-d895-3993-a41b-fbc4ce6e01ee",
                                "text": "Paus Franciscus is tijdens een mis op de Wereldjongerendagen in Polen gevallen. Het lijkt erop dat hij een traptrede miste op het altaar. Hij kwam daardoor met een wierookvat ten val."
                            },
                            {
                                "example_id": "f3cf460f-61bc-4d20-b34d-210f7c947639",
                                "sense_id": "8003f848-d895-3993-a41b-fbc4ce6e01ee",
                                "text": "Nederland heeft een uniek wierookvat teruggegeven aan China. Het vat stond sinds het begin van de twintigste eeuw op het terrein van de Nederlandse ambassade in Peking. Minister Verhagen van Economische Zaken overhandigde het vat op de eerste dag van zijn handelsmissie naar China."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49fa1883-151f-47ba-bb67-52f758f0d5f2",
                        "source_entry_id": "546c7dc4-1ac2-39fc-8dcd-1d0281004b8e",
                        "source_sense_id": "8003f848-d895-3993-a41b-fbc4ce6e01ee",
                        "source_sense_description": "vat waarin men wierook kan verbranden en waarmee men de welriekende rook kan verspreiden",
                        "target_lang_word": "thurible",
