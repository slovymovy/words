                    "sense_id": "c3f62289-9a64-35c8-bee6-566a72c002aa",
                    "sense_definition": "Plural of <w>grain</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef carefully washed the <w>grains</w> of rice before putting them in the pot.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар тщательно промыл <w>зёрна</w> риса, прежде чем положить их в кастрюлю.",
                                "pl": "Szef kuchni starannie umył <w>ziarna</w> ryżu, zanim wrzucił je do garnka."
                            }
                        },
                        {
                            "text": "Tiny <w>grains</w> of sand got into our shoes while we were walking on the beach.",
                            "target_lang_translations": {
                                "ru": "Крошечные <w>крупицы</w> песка попали нам в обувь, пока мы гуляли по пляжу.",
                                "pl": "Malutkie <w>ziarenka</w> piasku wpadły nam do butów, kiedy spacerowaliśmy po plaży."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grains of sand",
                        "grains of rice",
                        "whole grains",
                        "cereal grains"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова grain (зерно, крупица, злак).",
                        "pl": "Liczba mnoga od słowa grain (ziarna, ziarenka, zboża)."
