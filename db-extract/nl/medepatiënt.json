                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14693326-fab7-4f9d-9f82-404bf5b8c7ae",
                                "sense_id": "cb2cb08e-6bf7-3d48-bb27-c4024e32e3f2",
                                "text": "Een zuster fluisterde Catharina ongevraagd de tragische geschiedenissen van haar medepatiënten toe. Het meisje in het bed naast haar had haar broer en beide ouders verloren. De oudere vrouw tegenover haar had haar dochter verpleegd tot deze in haar armen was gestorven."
                            },
                            {
                                "example_id": "7682e4dc-24e4-4b56-8993-e10247b8679b",
                                "sense_id": "cb2cb08e-6bf7-3d48-bb27-c4024e32e3f2",
                                "text": "In het Algemeen Dagblad stellen ex-patiënten dat ze jarenlang onder druk zijn gezet om bijvoorbeeld medepatiënten in bedwang te houden."
                            }
                        ]
