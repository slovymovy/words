        "fr-extract.jsonl": [
            {
                "entry_id": "7098041e-e6a9-327c-9bb2-657cad615da6",
                "word": "commodément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a3ba0e8-87d7-38ed-85e8-8d91bd405906",
                        "entry_id": "7098041e-e6a9-327c-9bb2-657cad615da6",
                        "glosses": [
                            "D’une manière commode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4116abd6-d52e-47dc-9048-4fe01f61cfc6",
                                "sense_id": "2a3ba0e8-87d7-38ed-85e8-8d91bd405906",
                                "text": "Mon père l'avait installé commodément dans notre fauteuil Voltaire, et ma mère avait jeté une charpagnée de souches dans le brasier, qui pétillait gaîment."
                            },
                            {
                                "example_id": "6897345b-0850-4927-a17f-f1e90ad5bb07",
                                "sense_id": "2a3ba0e8-87d7-38ed-85e8-8d91bd405906",
                                "text": "Les empereurs n'ont jamais triomphé à Rome si mollement, si commodément, ni si sûrement même, contre le vent, la pluie […] que le bourgeois sait à Paris se faire mener par toute la ville."
                            },
                            {
                                "example_id": "c895a05f-eea4-49ec-80fa-08343281e817",
                                "sense_id": "2a3ba0e8-87d7-38ed-85e8-8d91bd405906",
                                "text": "Il a trouvé le secret de monter et de descendre autrement que par l’escalier, et il cherche celui d’entrer et de sortir plus commodément que par la porte."
                            },
                            {
                                "example_id": "29fa0670-03c5-46c3-a419-01e808dab7cb",
                                "sense_id": "2a3ba0e8-87d7-38ed-85e8-8d91bd405906",
                                "text": "Vous dépriser mal à propos ma calèche, Trésor des Fèves, reprit Fleur des Pois. On y voyage très commodément quand elle est ouverte ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b7d4895-c59c-31eb-b91e-bf8391823644",
                        "entry_id": "7098041e-e6a9-327c-9bb2-657cad615da6",
                        "glosses": [
                            "Avec opportunité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "237d924d-d002-4d63-8312-e550ac757fa4",
                                "sense_id": "4b7d4895-c59c-31eb-b91e-bf8391823644",
                                "text": "On parlera plus commodément, en un autre endroit, des magnificences de Salomon."
                            },
                            {
                                "example_id": "9637bc89-2b7a-4ccb-b71e-3f8ea95b8b19",
                                "sense_id": "4b7d4895-c59c-31eb-b91e-bf8391823644",
                                "text": "À moins qu’on désirât les grandeurs pour offenser Dieu ou l’État plus commodément."
                            },
                            {
                                "example_id": "6a21050e-5815-4c97-a8d0-1de7609e92a3",
                                "sense_id": "4b7d4895-c59c-31eb-b91e-bf8391823644",
                                "text": "Des universitaires aux postures idéologiques nourrissent les approches déficientes du ministère en matière de prévention et rejettent commodément la faute sur les relations patronales-syndicales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbc865fc-4f05-42d5-a703-c605b2a89e27",
                        "source_entry_id": "7098041e-e6a9-327c-9bb2-657cad615da6",
