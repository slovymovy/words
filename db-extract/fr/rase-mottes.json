                "word_linkages": []
            },
            {
                "entry_id": "df1fd650-b71e-3f93-95df-c60195ea9cff",
                "word": "rase-mottes",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54d1b0c9-83bf-4db4-a3b4-a880909ee0b4",
