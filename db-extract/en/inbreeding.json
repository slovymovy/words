                                "target_senses": [
                                    {
                                        "sense_id": "20cec77a-149d-30ff-a720-af835a0dbdcd",
                                        "entry_id": "7928b633-8a8e-38eb-96d1-3f7d234ea8f1",
                                        "glosses": [
                                            "kojarzenie blisko spokrewnionych osobników"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75431fc-336b-45f1-ad1e-b853076abbca",
                                                "sense_id": "20cec77a-149d-30ff-a720-af835a0dbdcd",
                                                "text": "Chów wsobny w naturze nie jest zjawiskiem korzystnym – często prowadzi do ujawnienia niekorzystnych alleli recesywnych i zmniejszenia się różnorodności genetycznej populacji na skutek przyspieszonego dryftu genetycznego"
                                            },
                                            {
                                                "example_id": "dcdf864e-6b09-4ed4-bb23-bcd7a65f55d1",
                                                "sense_id": "20cec77a-149d-30ff-a720-af835a0dbdcd",
                                                "text": "Pseudohodowca (…) rozmnaża zwierzęta chore i z wadami genetycznymi. Oszczędza na kryciu, używając jako reproduktorów samce blisko spokrewnione z suką czy kotką, czyli stosując tzw. chów wsobny, prowadzący często do poważnych wad genetycznych"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
