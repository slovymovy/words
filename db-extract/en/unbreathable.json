                        "entry_id": "c0045794-c003-3e56-8393-fa6552795728",
                        "glosses": [
                            "Not suitable for breathing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1349d514-db47-42de-bfd1-20b03fb54af1",
                                "sense_id": "858aee48-76cc-34ac-9037-ca65cbcac729",
                                "text": "The atmosphere on Venus is an unbreathable mixture of carbon dioxide and sulphuric acid, amongst other things."
                            },
                            {
                                "example_id": "aefc14f6-8648-4ae4-9c28-6ab77b4040ab",
                                "sense_id": "858aee48-76cc-34ac-9037-ca65cbcac729",
                                "text": "The air was not just thick, it was unbreathable."
                            }
                        ]
                    },
                    {
                        "sense_id": "d60583e1-0b8c-3169-9601-30a5149d3459",
                        "entry_id": "c0045794-c003-3e56-8393-fa6552795728",
                        "glosses": [
                            "Not letting air seep through."
                        ],
                        "tags": [],
