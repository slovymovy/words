                                                "sense_id": "e4c81314-5748-3d62-92d9-8bc31d07ab0f",
                                                "text": "„Clementinen wachsen als kleiner, immergrüner Baum mit runder, ausgebreiteter Krone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f01e731-2549-3918-9dd3-eae5cd97370c",
