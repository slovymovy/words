                "senses": [
                    {
                        "sense_id": "611d2202-df76-3b01-8c5f-78d30ca7cb03",
                        "entry_id": "7bfe7b94-43e9-35b1-aa1a-5eceeb08c173",
                        "glosses": [
                            "Bantusprache, die vor allem in Namibia, aber auch im Süden Angolas gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d95eb17-5920-4444-a74d-98eabd91b906",
                                "sense_id": "611d2202-df76-3b01-8c5f-78d30ca7cb03",
                                "text": "„Wenn sie mir etwas in Oshivambo erzählten, fiel mir auf, dass sie die Worte anders aussprachen als ich.“"
                            },
                            {
                                "example_id": "4db6bfe9-05ca-4079-82ef-29b5d733de85",
                                "sense_id": "611d2202-df76-3b01-8c5f-78d30ca7cb03",
                                "text": "„Der staatliche Namibische Rundfunk (NBC) überträgt neben Englisch […] auch 10 Stunden pro Tag auf Oshivambo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
