                        "glosses": [
                            "veganes Lebensmittel aus Gluten, das als Fleischersatz genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f89b88-dda0-460b-8286-e7b925f815bd",
                                "sense_id": "df05d7fd-7618-3447-9ac4-245176acf7de",
                                "text": "„Wie Tofu ist Seitan pflanzlichen Ursprungs. Anders als Tofu besteht er jedoch nicht aus Soja. Der Fleischersatz kommt aus China und Japan, weshalb einige Seitan-Rezepte asiatisch angehaucht sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
