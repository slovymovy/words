                "senses": [
                    {
                        "sense_id": "f276feb1-9ac0-31e9-a4e1-645c06fd1bf6",
                        "entry_id": "dd39022e-6f2f-3dc4-9a28-5de9eb764784",
                        "glosses": [
                            "Assiette de bois sur laquelle on taille, on coupe de la viande."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "05af0614-b7a4-4130-8d6d-92a2042188a1",
                                "sense_id": "f276feb1-9ac0-31e9-a4e1-645c06fd1bf6",
                                "text": "… les tailloirs épais de quatre doigts sont de buis patiné ; …"
                            },
                            {
                                "example_id": "efaf1d3f-9021-4cc9-9c17-19dafc13f798",
                                "sense_id": "f276feb1-9ac0-31e9-a4e1-645c06fd1bf6",
                                "text": "… puis à la crédence ils embrochent sur une grosse fourchette un chapon ou un quartier de viande qu'ils posent sur un tailloir en bois et, avec un grand couteau, ils les sectionnent en coupant à travers sans aucun discernement."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd662aaa-52c1-3850-b908-3b6d66c1c70d",
                        "entry_id": "dd39022e-6f2f-3dc4-9a28-5de9eb764784",
                        "glosses": [
                            "Partie supérieure du chapiteau des colonnes, sorte de tablette carrée sur laquelle se pose l’architrave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7014b0fe-86a8-45bd-95a0-720ee47cce5d",
                                "sense_id": "dd662aaa-52c1-3850-b908-3b6d66c1c70d",
                                "text": "Quelques supports nʼont pas de tailloir: lorsque le chapiteau porte la corniche, la tablette saillante de la corniche tient lieu de tailloir; cʼest fréquent."
                            },
                            {
                                "example_id": "2a6a4c32-17dd-4480-8d7d-28f782553648",
                                "sense_id": "dd662aaa-52c1-3850-b908-3b6d66c1c70d",
                                "text": "L'auteur des étranges modillons d’Ardentes est venu à Sassierges-Saint-Germain, petite localité voisine, pour réaliser le décor de la porte occidentale de l'église. Celle-ci est un reflet parfait, quoique plus simple, du portail nord de Saint-Martin : même archivolte sculptée de demi-cercles opposés deux à deux, même alignement de rosaces sur les claveaux de la voussure médiane à l'arête torique, même mouluration complexe des tailloirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed3eac79-c492-3eab-92d6-cf1919f30822",
                        "entry_id": "dd39022e-6f2f-3dc4-9a28-5de9eb764784",
                        "glosses": [
                            "Outil coupant utilisé pour sectionner les baguettes en plomb destinées à réaliser des vitraux."
                        ],
                        "tags": [],
                        "examples": []
                    }
