                    },
                    {
                        "sense_id": "dc8efa73-dd61-3ad4-965c-f787ae0039b2",
                        "entry_id": "080ac6ed-06d8-34a1-90fe-2a339331db1c",
                        "glosses": [
                            "A shallow metallic cup or drum, with a thin elastic membrane supporting a writing lever. Two or more of these are connected by a rubber tube and used to transmit and register the movements of the pulse or of any pulsating artery."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1b091858-fac7-30ac-bd48-0ed8c3196b1b",
                        "entry_id": "080ac6ed-06d8-34a1-90fe-2a339331db1c",
                        "glosses": [
                            "In real tennis, a buttress-like obstruction in the main wall."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e4def577-be8c-4cfd-98e6-de3bfca64021",
                                "sense_id": "1b091858-fac7-30ac-bd48-0ed8c3196b1b",
                                "text": "One hazard is the tambour, a buttress which juts out and causes the ball to bounce unpredictably."
                            }
                        ]
                    },
                    {
                        "sense_id": "c89f5eda-3dda-3006-82a9-f2096d1b8948",
                        "entry_id": "080ac6ed-06d8-34a1-90fe-2a339331db1c",
                        "glosses": [
                            "A rolling top or front (as of a rolltop desk) of narrow strips of wood glued on canvas."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f76c874-ffde-4afb-b619-e0b708fa66fd",
                        "source_entry_id": "080ac6ed-06d8-34a1-90fe-2a339331db1c",
                        "source_sense_description": "circular frame for embroidery",
                        "target_lang_word": "пя́льцы",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пя́льцы",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a81216b2-8c56-3c12-b17c-b68c0a96d5fe",
                                        "entry_id": "4c636f0a-fbd6-3a1c-9657-f16241af0074",
                                        "glosses": [
                                            "приспособление для рукоделия в виде рамы, на которой закрепляется натянутая ткань"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f504829c-ba5d-409d-9fb0-88dccfa6d36c",
                                                "sense_id": "a81216b2-8c56-3c12-b17c-b68c0a96d5fe",
                                                "text": "Её изнеженные пальцы // Не знали игл; склонясь на пяльцы, // Узором шёлковым она // Не оживляла полотна."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7d01f05-194d-4b24-b480-0d1ee58d76f6",
                        "source_entry_id": "080ac6ed-06d8-34a1-90fe-2a339331db1c",
                        "source_sense_description": "real tennis court feature",
                        "target_lang_word": "tambour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tambour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0d5f7f-6979-3c92-8cf3-809c73317203",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Caisse de forme cylindrique, dont les deux fonds sont formés de peaux tendues, sur l’une desquelles on frappe avec des baguettes pour en tirer des sons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf1181b3-5759-40ed-bd92-91d157dd77a9",
                                                "sense_id": "ae0d5f7f-6979-3c92-8cf3-809c73317203",
                                                "text": "Mon imagination s’est toujours émue au bruit du tambour des camps, du clairon des batailles, et des clameurs enivrantes des soldats."
                                            },
                                            {
                                                "example_id": "fbfe199e-eda7-448c-8a00-275734300933",
                                                "sense_id": "ae0d5f7f-6979-3c92-8cf3-809c73317203",
                                                "text": "Les Mangaréviens, qui chantaient harmonieusement, se servaient fort mal de la mandoline et de l’accordéon, et jadis leurs instruments préférés pour les danses étaient les tambours en bois."
                                            },
                                            {
                                                "example_id": "a92fe7c0-6b5e-4f80-88fa-bbdc60a1adbe",
                                                "sense_id": "ae0d5f7f-6979-3c92-8cf3-809c73317203",
                                                "text": "La fête se termina par des réjouissances bruyantes : musique, sonneries de clairons, roulements de tambours, fantasias échevelées, décharges retentissantes d’artillerie et de mousqueterie, — une orgie de couleurs, de mouvement et de bruit."
                                            },
                                            {
                                                "example_id": "ef400651-4a0e-4acf-b6c0-97292c2a932a",
                                                "sense_id": "ae0d5f7f-6979-3c92-8cf3-809c73317203",
                                                "text": "Leur régal, c’était ce tambour qui réglait la marche du lycée. Ses roulements s’y propageaient comme un ouragan sonore."
                                            },
                                            {
                                                "example_id": "c90be429-9dba-489a-a387-c0d1abcacc69",
                                                "sense_id": "ae0d5f7f-6979-3c92-8cf3-809c73317203",
                                                "text": "Tous les anges, param pam pam pam\n Ont pris leurs beaux tambours, param pam pam pam\n Et ont dit à l'enfant, param pam pam pam\n \"Ton père est de retour\", param pam pam pam\n Ram pam pam pam, ram pam pam pam\n Et l'enfant s'éveille, param pam pam pam\n Sur son tambour."
                                            },
                                            {
                                                "example_id": "48696ec7-ab43-4269-a8c3-9b521a5838b0",
                                                "sense_id": "ae0d5f7f-6979-3c92-8cf3-809c73317203",
                                                "text": "Cette formation organisée selon la demande est consacrée aux polyrythmies jouées par les tambours djembé et dundun au Mali et en Guinée et à celles de l'ensemble de tambours sabar du Sénégal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "282d46af-3096-3a31-9810-7207c67a0b3a",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Celui dont la fonction est de battre du tambour."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d861ac2f-47b3-4cef-beba-ff2e55c522c2",
                                                "sense_id": "282d46af-3096-3a31-9810-7207c67a0b3a",
                                                "text": "Quant à la procession en elle-même, outre le personnel d’un nombreux clergé, prêtres, chantres, porte-châsses, porte-bannières, etc., elle s’avançait précédée de deux tambours, avec une escorte de six hallebardiers et douze porte-torches."
                                            },
                                            {
                                                "example_id": "58a1fcdb-47c8-427b-af49-c7202e9c507e",
                                                "sense_id": "282d46af-3096-3a31-9810-7207c67a0b3a",
                                                "text": "Une école de tambourinage s'établit près des remparts; les gamins apprirent à battre les marches françaises, et le tambour Legrand devint le professeur en chef, le directeur suprême de ce conservatoire en plein vent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c46fb95-1bde-3b28-afe8-9a1d00cce58c",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Sorte de mandoline dont la caisse est petite et le manche très long, en usage dans divers pays d'Afrique et du Proche-Orient. Il esn existe à deux à huit cordes."
                                        ],
                                        "tags": [],
                                        "note": "On trouve aussi l'orthographe tanbour",
                                        "examples": [
                                            {
                                                "example_id": "c06873e9-d86e-4c39-903d-c6855b6adea0",
                                                "sense_id": "2c46fb95-1bde-3b28-afe8-9a1d00cce58c",
                                                "text": "Le tambour est une espèce de mandoline dont le manche est très-long. Le corps de l'instrument est petit, la table sans ouverture."
                                            },
                                            {
                                                "example_id": "73129d0c-02dd-413d-a59d-7b991fc69bf3",
                                                "sense_id": "2c46fb95-1bde-3b28-afe8-9a1d00cce58c",
                                                "text": "La grosse mandoline, dont on joue comme de la mandoline italienne, enfin le tambour et le bouzouki . Le tambour est un instrument à cordes pincées, une sorte de guitare à manche très long. Son étendue comprend deux octaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de5b360-85e4-33e7-8e63-09d8f3a186f4",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Petite enceinte de menuiserie, à doubles portes, placée aux principales entrées des édifices ou des grandes salles, pour empêcher le vent de pénétrer dans l’intérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed14af07-d6da-4ac3-80f7-8e3137451e37",
                                                "sense_id": "0de5b360-85e4-33e7-8e63-09d8f3a186f4",
                                                "text": "Il se méfie, en effet, car je le bloque entre deux portes, dans le tambour, profond comme une alcôve, qui sépare la salle à manger du salon."
                                            },
                                            {
                                                "example_id": "8c39089f-db70-44bc-af2d-a9e183be4988",
                                                "sense_id": "0de5b360-85e4-33e7-8e63-09d8f3a186f4",
                                                "text": "En entrant dans ce magnifique hôtel Beauharnais, qui abritait à la fois les familles Buloz et Richet et les services de la Revue, on tournait à gauche, on montait un petit escalier et on arrivait dans un salon de réception, séparé du cabinet directorial par un tambour entrouvert."
                                            },
                                            {
                                                "example_id": "a951b77d-b178-458d-81e6-9dacf48b314a",
                                                "sense_id": "0de5b360-85e4-33e7-8e63-09d8f3a186f4",
                                                "text": "Les grandes œuvres naissent souvent au détour d’une rue ou dans le tambour d’un restaurant."
                                            },
                                            {
                                                "example_id": "275186aa-6a79-481a-9312-4caf40b5944b",
                                                "sense_id": "0de5b360-85e4-33e7-8e63-09d8f3a186f4",
                                                "text": "Établir des tambours aux portes d’une église."
                                            },
                                            {
                                                "example_id": "fb96b554-6c87-4094-a79f-263d4b7fa10b",
                                                "sense_id": "0de5b360-85e4-33e7-8e63-09d8f3a186f4",
                                                "text": "Tambour vitré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15b9399b-2a87-3a61-8b7c-b962cb6bc158",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Porte tournante fonctionnant sur le principe du tourniquet, subdivisée en plusieurs compartiments afin d’empêcher les courants d’air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acef8f10-9ce4-34c1-899d-99f6c1f011c6",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Chambre servant à se déchausser en entrant dans une maison."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bd3edca-f436-331c-860e-bef34695858a",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Petite enceinte amovible en bois, en toile ou en tôle placée devant les portes en hiver pour empêcher la neige ou le vent d’entrer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "782cd1d1-f97e-41d6-8981-36eac12647f8",
                                                "sense_id": "6bd3edca-f436-331c-860e-bef34695858a",
                                                "text": "Tout autour de l’île, quand arrive la saison hivernale, de petites constructions se greffent au corps principal des maisons. Ce sont des tambours, de petits édicules qui précèdent l’entrée principale de la maison."
                                            },
                                            {
                                                "example_id": "e07e380c-7fc4-4c32-acb4-24e4c378a2a1",
                                                "sense_id": "6bd3edca-f436-331c-860e-bef34695858a",
                                                "text": "J’ai posé le tambour puisque l’hiver approche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c3cb9c7-647f-340d-9e52-f4f31d23f238",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Chacune des assises de pierres cylindriques qui composent le fût d’une colonne ou le noyau d’un escalier à vis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efca9735-7e77-4a41-b1b7-8f72e8646458",
                                                "sense_id": "7c3cb9c7-647f-340d-9e52-f4f31d23f238",
                                                "text": "Les tambours des colonnes du Parthénon."
                                            },
                                            {
                                                "example_id": "08eb37cb-f33e-4f22-a72d-5049e50a23a9",
                                                "sense_id": "7c3cb9c7-647f-340d-9e52-f4f31d23f238",
                                                "text": "Non, l’erreur n’était plus possible ; ce qui se découvrait, c’était le tambour de granit jaillissant hors de son informe gaine de pisé, c’était le fût de la colonne, le haut du fût, la volute de pierre qui le bague et enfin le chapiteau de marbre rose avec ses ornements sculptés, têtes d’hommes ou de bêtes encore intactes et du plus authentique roman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d59226e-c2c7-3e07-bbf2-9b47d2315772",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Toute pièce de forme cylindrique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52d43137-f4b1-4a4d-9697-28466d51ebf3",
                                                "sense_id": "0d59226e-c2c7-3e07-bbf2-9b47d2315772",
                                                "text": "Dans ces appareils un tambour annulaire […] est mis lentement en rotation dans un récipient contenant de l’eau chaude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4947df9e-5b54-3e19-83ed-7f0f7750b9d1",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Pièce métallique de machine à laver, de forme cylindrique, dans laquelle on place le linge."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a0ae7b1-80f4-4a39-a0a8-b3f11f145878",
                                                "sense_id": "4947df9e-5b54-3e19-83ed-7f0f7750b9d1",
                                                "text": "Lire la presse, c’est comme regarder la machine à laver. Le tambour tourne, le même linge passe."
                                            },
                                            {
                                                "example_id": "4ba34f6d-9278-4bc7-9e37-3273636fe109",
                                                "sense_id": "4947df9e-5b54-3e19-83ed-7f0f7750b9d1",
                                                "text": "Elle a l’impression que tout tourne à toute vitesse à l’intérieur de son crâne, comme le tambour du lave-linge en phase essorage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6564e4d-b118-311a-adf4-67cd1cdca49f",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Gros cylindre sur lequel vient s’enrouler un câble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "096dcf9b-c858-4305-9690-7b19b1ab3665",
                                                "sense_id": "e6564e4d-b118-311a-adf4-67cd1cdca49f",
                                                "text": "Le diamètre du tambour [d'un treuil] est d'autant plus faible que la charge remontée est plus forte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd9bc6b5-8579-38da-8f11-d97620a3a187",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Conduit descendant d’une écoutille ou autre ouverture du pont pour descendre à un niveau inférieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4b11ba-50d7-4c2d-bb66-54300d4cdf72",
                                                "sense_id": "dd9bc6b5-8579-38da-8f11-d97620a3a187",
                                                "text": "C’est au moyen de ce tambour qui cerne l’ouverture de l’écoutille aux poudres qu’on descend dans la soute aux poudres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071e4759-cf3a-31f7-8b2d-61ad712a945a",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Cylindre sur lequel est roulée la corde ou la chaîne qui sert à remonter une horloge."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c95d6f5-1864-4b68-a2f3-5fa0706dfa5a",
                                                "sense_id": "071e4759-cf3a-31f7-8b2d-61ad712a945a",
                                                "text": "Le phénomène ne peut être répété aussitôt après qu'il a pris fin : il faut à nouveau enrouler la corde autour du tambour et régler l'écoulement du mercure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87e9be0f-feb6-3c2b-a4d5-b84b06653bd2",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Appareil de forme circulaire sur lequel est tendue une toile ou une étoffe pour exécuter différentes broderies."
                                        ],
                                        "tags": [
                                            "Broderie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72539a09-1acf-4597-9003-2649dbc072e0",
                                                "sense_id": "87e9be0f-feb6-3c2b-a4d5-b84b06653bd2",
                                                "text": "Il portait l’habit de cour, les cheveux en bourse, l’épée au côté, une veste brodée au tambour et son chapeau sous le bras."
                                            },
                                            {
                                                "example_id": "3959bd27-ba73-4e38-96a5-5199734b299a",
                                                "sense_id": "87e9be0f-feb6-3c2b-a4d5-b84b06653bd2",
                                                "text": "Pierre remontait vers l’auberge, par la ruelle envahie de bardanes et d’herbes de Saint-Jacques, quand il aperçut près d’une fenêtre ouverte un tambour de brodeuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b81af792-5a5d-3c37-8c66-8bad1cc70db8",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Serran hépate, poisson capable d'émettre une sorte de ronflement dû aux vibrations de sa vessie natatoire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80c7b759-a004-3563-b7c6-c1310c4e14d6",
                                        "entry_id": "26f5a24a-78b9-378b-9017-7b0af4c2ed52",
                                        "glosses": [
                                            "Variété de pigeon ayant une aigrette sur la nuque et des plumes sur les pattes et dont le roucoulement est très fort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a817c1-a783-4f2d-a1b1-e12eb8d196fa",
                                                "sense_id": "80c7b759-a004-3563-b7c6-c1310c4e14d6",
                                                "text": "On élève trois variétés principales de tambours : le tambour de Boukharie, le tambour de Dresde et le tambour d'Altenbourg."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tambour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b33c616-3f36-32b4-8fd9-80ae3c7957d3",
                                        "entry_id": "3091ed5f-1b48-32ef-840c-00c2adb41359",
                                        "glosses": [
