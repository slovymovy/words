                                        "entry_id": "84680591-8083-396b-8ded-19d36d2136a4",
                                        "glosses": [
                                            "To produce or set (something) down in writing; to record something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d75b7f3-c019-32d1-9030-1f79151a574b",
                                        "entry_id": "84680591-8083-396b-8ded-19d36d2136a4",
                                        "glosses": [
                                            "To write (something) in a simple or condescending style."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3ab3d4d-a1a9-4197-ac8b-2aaa6f5fb5f8",
                                                "sense_id": "9d75b7f3-c019-32d1-9030-1f79151a574b",
                                                "text": "Good heavens, I can't write down to the level of the vulgar public!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d07e77-db73-37a2-a71a-5d58d4d00ba4",
                                        "entry_id": "84680591-8083-396b-8ded-19d36d2136a4",
                                        "glosses": [
                                            "To make a downward adjustment in the value of an asset."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb31f8cc-e888-3d38-9152-a66f39d5c556",
                                        "entry_id": "84680591-8083-396b-8ded-19d36d2136a4",
                                        "glosses": [
                                            "To condemn in writing; to document the faults, offenses, or wrongdoing of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4755577d-2da1-4546-b564-f8e8db52c207",
                                                "sense_id": "eb31f8cc-e888-3d38-9152-a66f39d5c556",
                                                "text": "By 1859, D. Morier Evans was exhibiting [George] Hudson as the principal character in his rogues' gallery entitled \"Facts, Failures and Frauds\"; and at the hands of modern economic historians he has been written down as a common swindler."
                                            },
                                            {
                                                "example_id": "ba76e5b6-b369-46c5-b210-e1567ea7a137",
                                                "sense_id": "eb31f8cc-e888-3d38-9152-a66f39d5c556",
                                                "text": "See also: cite"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
