                ],
                "translations": [
                    {
                        "translation_id": "067e610a-f8d0-4277-b2ed-88fd74dc0c6b",
                        "source_entry_id": "9843922d-5f14-3a38-b139-7f7dd9d5f596",
                        "source_sense_id": "fe75fd07-4500-369e-84cd-9ab94908c3c6",
                        "target_lang_word": "honestly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                        "entry_id": "5841d707-cf1e-35ae-a32a-aa320f52e3e6",
                                        "glosses": [
                                            "In an honest manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f47224-adce-4cba-b951-4f1d25aae945",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "He answered the questions honestly."
                                            },
                                            {
                                                "example_id": "dfd8017f-109d-4648-b244-05c9c5d7ea7f",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "You honestly quit your tools; quit a most muddy confused coil of sore work, short rations, of sorrows, dispiritments and contradictions, having now honestly done with it all; — and await, not entirely in a distracted manner, what the Supreme Powers, and the Silences and the Eternities may have to say to you."
                                            },
                                            {
                                                "example_id": "e8f7b1a5-4848-4bf5-9be4-717a53399ac4",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "I can't honestly say that I feel any elatement at the prospect."
                                            },
                                            {
                                                "example_id": "442f14ec-7a46-41b0-93fa-063d624a9ca6",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "Nevertheless, you must know (if I am to speak honestly to you) that I do not repent me those dallyings in enchanted fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75406bb5-24d9-3028-8fe2-bf93e549265f",
                                        "entry_id": "5841d707-cf1e-35ae-a32a-aa320f52e3e6",
                                        "glosses": [
                                            "Frankly, to be honest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9a6216-1d40-4d3e-91b5-2237de473c20",
                                                "sense_id": "75406bb5-24d9-3028-8fe2-bf93e549265f",
                                                "text": "Honestly, I didn't believe a word she said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "honestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9a2e5d-bd9e-35f1-adf4-cbc214c61626",
                                        "entry_id": "b4df50d1-7d4e-3216-b748-72ab564d082d",
                                        "glosses": [
                                            "Used to express exasperation, dismay, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd40b95-57cc-478f-83b5-28372d72cbab",
                                                "sense_id": "ec9a2e5d-bd9e-35f1-adf4-cbc214c61626",
                                                "text": "Honestly! I want to finish this work and you keep interrupting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cbd92e0-f32a-4a0d-9e1d-39125f4ef095",
                        "source_entry_id": "9843922d-5f14-3a38-b139-7f7dd9d5f596",
                        "source_sense_id": "fe75fd07-4500-369e-84cd-9ab94908c3c6",
                        "target_lang_word": "fair and square",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fair and square",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66ae37d5-c727-3a85-be31-0d395337c725",
                                        "entry_id": "c71a555e-7782-3947-a101-bfd9cdf4c166",
                                        "glosses": [
                                            "Totally fairly and undoubtedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0269063-a3cc-4271-ace6-203fa7385d70",
                                                "sense_id": "66ae37d5-c727-3a85-be31-0d395337c725",
                                                "text": "We won the game fair and square."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f995c2eb-afeb-37d9-a6fb-54f990a09825",
                                        "entry_id": "c71a555e-7782-3947-a101-bfd9cdf4c166",
                                        "glosses": [
                                            "Within the applicable rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a49a5e2f-53ec-4db6-bb73-8e25a1c21318",
                                                "sense_id": "f995c2eb-afeb-37d9-a6fb-54f990a09825",
                                                "text": "He said they give licenses now to steal — steal folks'es senses away, and then they would steal every thing else, and murder, and tear round into every kind of wickedness. But he didn't ask that. He wanted things done fair and square: he jest wanted to steal horses. He was goin' West, and he thought he could do a good business, and lay up something. If he had a license, he shouldn't be afraid of bein' shot up, or shot."
                                            },
                                            {
                                                "example_id": "68ad8857-22f5-4172-87e3-fedcf71ea564",
                                                "sense_id": "f995c2eb-afeb-37d9-a6fb-54f990a09825",
                                                "text": "They had crawled in and staked the land and stood ready to shoot those of us who came in, fair and square, in the Run."
                                            },
                                            {
                                                "example_id": "59b9dc34-872f-460c-b3aa-7be47824c291",
                                                "sense_id": "f995c2eb-afeb-37d9-a6fb-54f990a09825",
                                                "text": "For the \"Most Accurate Assessment of an International Situation\" the unanimous winner is the Republican U.S. Senate hopeful from California, S.E. Hayakawa. He said, \"Of course we should keep the Panama Canal, we stole it fair and square.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "331d787e-4d47-310b-b872-c5aed685b368",
                                        "entry_id": "c71a555e-7782-3947-a101-bfd9cdf4c166",
                                        "glosses": [
                                            "In all fairness; equitably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53031121-8824-4f42-9ff7-afaf795d6737",
                                                "sense_id": "331d787e-4d47-310b-b872-c5aed685b368",
                                                "text": "\"Have it out with him to-night. Fair and square. Out he goes, Edmund, neck and crop. Out, by thunder.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fair and square",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3fe8c60-bd69-3063-aa54-2e3c9bc97160",
                                        "entry_id": "704536fd-11d0-3854-97c5-5e56a3875871",
                                        "glosses": [
                                            "Unquestionably fair."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "346c403e-9c96-46f4-805b-75ed9d8f53ed",
                                                "sense_id": "c3fe8c60-bd69-3063-aa54-2e3c9bc97160",
                                                "text": "“[…] I always liked you Joe, and stood up for you, too. Don’t you remember? You won’t tell, will you Joe?” And the poor creature dropped on his knees before the stolid murderer, and clasped his appealing hands. / “No, you’ve always been fair and square with me, Muff Potter, and I won’t go back on you.—There, now, that’s as fair as a man can say.”"
                                            },
                                            {
                                                "example_id": "7d180d0f-e0a4-451d-a9bc-17cb0f1041f6",
                                                "sense_id": "c3fe8c60-bd69-3063-aa54-2e3c9bc97160",
                                                "text": "It was a fair and square deal. We won. And we won in the Senate. And it's in the bill. And I didn't think we could beat them, but we did."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0de443d9-184d-4b25-baa3-0ab74a98ab44",
                        "source_entry_id": "9843922d-5f14-3a38-b139-7f7dd9d5f596",
                        "source_sense_id": "fe75fd07-4500-369e-84cd-9ab94908c3c6",
                        "target_lang_word": "justement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdf97df-fd4f-38c2-98a9-41021890dc90",
                                        "entry_id": "63511c68-1d15-3282-8ec9-bbc5e0f13dc3",
                                        "glosses": [
                                            "Avec justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfdf7cf-b3a7-4dda-a5ec-4bdaadd4b6e5",
                                                "sense_id": "fcdf97df-fd4f-38c2-98a9-41021890dc90",
                                                "text": "Il a jugé justement. - Il a agi justement. - Il a été puni justement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                        "entry_id": "63511c68-1d15-3282-8ec9-bbc5e0f13dc3",
                                        "glosses": [
                                            "Dans la juste proportion, ni plus ni moins qu’il ne faut, précisément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b964de-d242-45bb-b5b4-759a4978841c",
                                                "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                                "text": "Voilà justement ce qui vous manque. - Vous arrivez justement à l’heure qu’il faut. - C’est justement cette explication que je désirais."
                                            },
                                            {
                                                "example_id": "16696b34-3806-4730-a847-a630141dea51",
                                                "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                                "text": "Gisèle me demanda où elle pourrait la trouver, car elle avait justement quelque chose à lui dire. « Quoi donc ? — Des choses qui se rapportent à de petites camarades à elle. — Quelles camarades ? Je pourrai peut-être vous renseigner, ce qui ne vous empêchera pas de la voir. — Oh ! des camarades d’autrefois, je ne me rappelle pas les noms », répondit Gisèle d’un air vague, en battant en retraite. Elle me quitta, croyant avoir parlé avec une prudence telle que rien ne pouvait me paraître que très clair. Mais le mensonge est si peu exigeant, a besoin de si peu de chose pour se manifester ! S’il s’était agi de camarades d’autrefois, dont elle ne savait même pas les noms, pourquoi aurait-elle eu « justement » besoin d’en parler à Albertine ? Cet adverbe, assez parent d’une expression chère à Mme Cottard : « cela tombe à pic », ne pouvait s’appliquer qu’à une chose particulière, opportune, peut-être urgente, se rapportant à des êtres déterminés."
                                            },
                                            {
                                                "example_id": "618350c8-1318-452e-a4a8-7b0fc55ff050",
                                                "sense_id": "d5b8898a-8fad-383e-b1dc-b5b761fd3aa4",
                                                "text": "— Tu veux que je téléphone de la cabine qui est en bas ? J’ai remarqué que, de la salle, on entend tout ce qui se dit…\n— Justement !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba8554e-7011-365a-97ce-f671de966882",
                                        "entry_id": "63511c68-1d15-3282-8ec9-bbc5e0f13dc3",
                                        "glosses": [
                                            "Qualifie qu'on vient de parler de telle ou telle chose/personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36141ce3-e041-49e8-8456-1222f19c3d4c",
                                                "sense_id": "4ba8554e-7011-365a-97ce-f671de966882",
                                                "text": "Actuellement, l'équipe travaille beaucoup et de façon intense sur l'amélioration de l’Académie Français Authentique, dont Tom fait partie justement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8678a8c9-e756-40d4-8487-62c54a7506db",
                        "source_entry_id": "9843922d-5f14-3a38-b139-7f7dd9d5f596",
                        "source_sense_id": "fe75fd07-4500-369e-84cd-9ab94908c3c6",
                        "target_lang_word": "honnêtement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honnêtement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44d63341-5bc1-3ea6-9b74-243cb21e061d",
                                        "entry_id": "3b32e34b-f448-360b-a778-3f3028fc0345",
                                        "glosses": [
                                            "Avec les bienséances qu’exige la société."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ecc123e-3711-4e4f-ab93-96816a60fc27",
                                                "sense_id": "44d63341-5bc1-3ea6-9b74-243cb21e061d",
                                                "text": "Il lui a parlé fort honnêtement. Il l’a reçu le plus honnêtement du monde."
                                            },
                                            {
                                                "example_id": "7b0c2b83-fb3f-486f-8a2a-510bb118afc3",
                                                "sense_id": "44d63341-5bc1-3ea6-9b74-243cb21e061d",
                                                "text": "Je veux vivre honnêtement avec tous ces messieurs quand j'en rencontrerai, sans jamais disputer avec eux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d692f7b1-57ab-3c94-a66d-27f0d1c40352",
                                        "entry_id": "3b32e34b-f448-360b-a778-3f3028fc0345",
                                        "glosses": [
                                            "D’une manière honnête, honorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "765ba4fa-300d-438d-bd65-29b091e864d4",
                                                "sense_id": "d692f7b1-57ab-3c94-a66d-27f0d1c40352",
                                                "text": "Vivre, se conduire honnêtement."
                                            },
                                            {
                                                "example_id": "66a9da60-39e6-4f5f-8482-d3b7a0443257",
                                                "sense_id": "d692f7b1-57ab-3c94-a66d-27f0d1c40352",
                                                "text": "Si je pouvais honnêtement abandonner ce qui me revient en Angoumois."
                                            },
                                            {
                                                "example_id": "5a33e220-0d4b-4339-8d55-d55429989a4c",
                                                "sense_id": "d692f7b1-57ab-3c94-a66d-27f0d1c40352",
                                                "text": "Ils [les Perses] traitaient honnêtement les rois vaincus."
                                            },
                                            {
                                                "example_id": "7f3a1bef-a1bb-4d30-a1d5-dce17b825e15",
                                                "sense_id": "d692f7b1-57ab-3c94-a66d-27f0d1c40352",
                                                "text": "Et cette pension, madame, est-elle forte ? - Je n'en vivrais, monsieur, que trop honnêtement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af57e2d-e805-3a85-9585-ab7757a42e1e",
                                        "entry_id": "3b32e34b-f448-360b-a778-3f3028fc0345",
                                        "glosses": [
                                            "En honnête homme, au sens du XVIIᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9810d2d-fdd0-439c-b4f1-d51c32ddc206",
                                                "sense_id": "5af57e2d-e805-3a85-9585-ab7757a42e1e",
                                                "text": "C'est [la Fontaine] un homme unique dans les excellents morceaux qu’il nous a laissés : ils sont en grand nombre, ils sont dans la bouche de tous ceux qui ont été élevés honnêtement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec9474bb-ea1e-36e8-9975-6ddf9175b12d",
                                        "entry_id": "3b32e34b-f448-360b-a778-3f3028fc0345",
                                        "glosses": [
                                            "Suffisamment ; passablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea1cba9-920b-4e71-8c6d-36d8d4777a1c",
                                                "sense_id": "ec9474bb-ea1e-36e8-9975-6ddf9175b12d",
                                                "text": "Cette chambre était alors, Dieu merci, honnêtement remplie de monde."
                                            },
                                            {
                                                "example_id": "dffa8fc1-8cb7-4d0a-8d60-e93567507e8a",
                                                "sense_id": "ec9474bb-ea1e-36e8-9975-6ddf9175b12d",
                                                "text": "On a rejoué Zaïre, il y avait honnêtement du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba4993a-3846-35c5-9da8-70fec98e65d6",
                                        "entry_id": "3b32e34b-f448-360b-a778-3f3028fc0345",
                                        "glosses": [
                                            "En toute bonne foi ; pour être honnête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98bd9bd7-223c-4d22-bab3-657ecf2b4c28",
                                                "sense_id": "4ba4993a-3846-35c5-9da8-70fec98e65d6",
                                                "text": "Chacun de nous put acquérir pour une modique somme une K7 contant le reportage et vingt minutes de rush qu'il eut la gentillesse de rendre intelligentes, ce qui dut lui donner beaucoup de mal, car, honnêtement, nos déplacements rugbystiques n'ont jamais vraiment brillé ni par leur originalité, ni par la pertinence de nos pensées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e6af025-d8b1-3127-90f2-27073d99dc8d",
                                        "entry_id": "3b32e34b-f448-360b-a778-3f3028fc0345",
                                        "glosses": [
                                            "Ironiquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0b7c76-8e7a-4c90-b1ee-e440743364f8",
                                                "sense_id": "3e6af025-d8b1-3127-90f2-27073d99dc8d",
                                                "text": "Ils sont fort honnêtement crottés."
                                            },
                                            {
                                                "example_id": "7315602a-ef0e-4ac4-be01-0ec574d997f9",
                                                "sense_id": "3e6af025-d8b1-3127-90f2-27073d99dc8d",
                                                "text": "Quand on a dit à Machiavel honnêtement d’injures, on pourrait s’en tenir aux raisons."
                                            },
                                            {
                                                "example_id": "878cebe0-9cbc-4fe2-b08c-e5f8bf26e80d",
                                                "sense_id": "3e6af025-d8b1-3127-90f2-27073d99dc8d",
                                                "text": "Vous me tiendrez lieu, vous et votre aimable société, de toute une nation honnêtement ingrate."
                                            },
                                            {
                                                "example_id": "7fbbfcf4-813b-41de-9e2b-e83426c73ed2",
                                                "sense_id": "3e6af025-d8b1-3127-90f2-27073d99dc8d",
