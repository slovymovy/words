                ],
                "senses": [
                    {
                        "sense_id": "866670de-fef9-382d-822c-2a438d1ad553",
                        "entry_id": "32b39614-0281-34d3-9586-c9f8df3440d4",
                        "glosses": [
                            "verwandtschaftlich verbundene Gruppe von Menschen, die in der unmittelbaren Nähe von etwas wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77970db5-e143-4eaa-91dd-e858e81d3cae",
                                "sense_id": "866670de-fef9-382d-822c-2a438d1ad553",
                                "text": "„Dort wehrten sich vier Anrainerfamilien gegen ein Wohnbauprojekt rund um eine alte Villa, das die städtische Baubehörde dem Unternehmer Paul Schäffler in zwei Instanzen genehmigt hatte.“"
                            },
                            {
                                "example_id": "c2eaac7d-bce7-4070-8469-91ae6a1f2cba",
                                "sense_id": "866670de-fef9-382d-822c-2a438d1ad553",
                                "text": "„Am alten Weg ins Karwendeltal liegt einsam auf einer kleinen Lichtung im Wald die Birzlkapelle, die von den Anrainerfamilien zum Schutz vor Unwetter und Blitzschlag errichtet wurde.“"
                            },
                            {
                                "example_id": "f7c44927-4e3f-445a-9e62-c2c6b43d338d",
                                "sense_id": "866670de-fef9-382d-822c-2a438d1ad553",
                                "text": "„Die neue Freifläche wird vermehrt von Anrainerfamilien genutzt, ist offener Spielplatz für Kinder und Kleinkinder sowie Aufenthaltsbereich für die Frauen.“"
                            },
                            {
                                "example_id": "510b62a4-b17d-4251-90fa-323e8c61d150",
                                "sense_id": "866670de-fef9-382d-822c-2a438d1ad553",
                                "text": "„Apropos Nachbarn – ich glaube, das ist eine gute Gelegenheit, sich bei den Anrainerfamilien zu bedanken, ohne deren Toleranz und Verständnis viele unserer Aktivitäten nicht möglich wären.“"
                            },
                            {
                                "example_id": "da2e1dbc-324f-401e-96e9-c8356bfa946e",
                                "sense_id": "866670de-fef9-382d-822c-2a438d1ad553",
                                "text": "„Die Messungen selbst wurden im Garten des Wohnhauses der Anrainerfamilie P. durchgeführt, dies deshalb, da es sich dabei um den am ungünstigsten gelegenen Punkt in der Nachbarschaft handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
