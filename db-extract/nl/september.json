                                        "glosses": [
                                            "The ninth month of the Gregorian calendar, following August and preceding October, containing the southward equinox."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294d841f-f634-4ba0-9414-9d57fdfee4c2",
                                                "sense_id": "4eba3c20-99c2-3a24-afac-77422150782a",
                                                "text": "Holonyms: calendar year; year"
                                            },
                                            {
                                                "example_id": "d8d24b1c-0e5a-4aa3-8b14-b28b41298316",
                                                "sense_id": "4eba3c20-99c2-3a24-afac-77422150782a",
                                                "text": "Late September is a beautiful time of year."
                                            },
                                            {
                                                "example_id": "e5f1e256-b59a-46d8-a495-780e84c82a14",
                                                "sense_id": "4eba3c20-99c2-3a24-afac-77422150782a",
                                                "text": "This was one of the warmest Septembers on record."
                                            },
                                            {
                                                "example_id": "79f8be49-b096-4b0a-b14c-d2586cf512e2",
                                                "sense_id": "4eba3c20-99c2-3a24-afac-77422150782a",
                                                "text": "BioLab officials told the investigators they had established a permanent fire watch two or three months prior to the incident after strong odors from oxidizers in two storage buildings were detected, according to the CSB report. BioLab also told CSB two employees were on duty for fire watch on September 29."
                                            }
                                        ]
                                    },
