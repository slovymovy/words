                        "source_sense_description": "4",
                        "target_lang_word": "backstop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backstop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9811ea4-70fe-312d-a47b-7188479617fb",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "An object or a person put in the rear or in the back of something to reinforce, hold, support."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24932295-053c-3cc2-b02b-329a782708c2",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "A default arrangement that holds if all else fails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39bd5dc-4109-4ccb-b03c-e992f263a477",
                                                "sense_id": "24932295-053c-3cc2-b02b-329a782708c2",
                                                "text": "Irish prime minister Leo Varadkar, this morning, said a time-limited backstop would be unacceptable, and has previously promised to vote down the UK’s Brexit withdrawal deal unless it features a satisfactory backstop."
                                            },
                                            {
                                                "example_id": "7dc514b7-b4a3-41c1-ac48-5c5fe84cc96e",
                                                "sense_id": "24932295-053c-3cc2-b02b-329a782708c2",
                                                "text": "\"The 2½ years since have been about hammering home these points in any European capital that would listen. And in spite of capacity-sapping talks on the first point – Brexit, border and backstop – the Department of Foreign Affairs and other government departments have been working quietly to make good on the second."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab3d9d7d-0022-3794-ad33-7e69405d60d5",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "A wall or fence behind home plate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "373231a7-c377-370d-a881-a01b9c83fee7",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "A catcher; the position of catcher."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9833557-d44c-417a-b0de-77ff92a40fcf",
                                                "sense_id": "373231a7-c377-370d-a881-a01b9c83fee7",
                                                "text": "Bench may be the greatest catcher subjectively, but he's not statistically. Statwise, Yogi Berra is the all-time backstop, regardless of which measure you prefer. Berra's Total-Z is one-third of a standard deviation higher than Bench's, and his Core-Z average is a point better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ccea13f-556c-3987-a3b1-fb2f578618ad",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "The player who stands immediately behind the striking base."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76bdba5c-09a7-3875-af7f-0464c0620568",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "The longstop."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5a129fc-0a0f-3249-8bb0-cbcdd4af5995",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "The wicket-keeper."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "039f0508-b8be-37b9-a936-abd19adb7130",
                                        "entry_id": "8fd6dc93-56d0-3d36-8f06-f09cc0ec00bf",
                                        "glosses": [
                                            "Something serving to bolster or support a cover story etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22ddffe8-a1aa-46a1-ba98-c18af75d0ea4",
                                                "sense_id": "039f0508-b8be-37b9-a936-abd19adb7130",
                                                "text": "[…] to be set up in Indonesia with a phony book and school supplies company established in New York City as a backstop."
                                            },
                                            {
                                                "example_id": "36d8ae5a-d013-4738-8d06-b3ff3a9c63f0",
                                                "sense_id": "039f0508-b8be-37b9-a936-abd19adb7130",
                                                "text": "Closely representing an alibi, creating a backstop could involve such measures as having people available to verify the details of an agent's cover story."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "backstop",
                                "target_lang_code": "en",
                                "target_senses": [
