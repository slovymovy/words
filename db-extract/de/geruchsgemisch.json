                ],
                "senses": [
                    {
                        "sense_id": "ebba56fe-076e-3748-8df9-37528a15ebd5",
                        "entry_id": "661747cf-ef58-3f12-8b54-4fac85d6eff8",
                        "glosses": [
                            "Mischung aus zwei oder mehreren verschiedenen Stoffen, die Geruch abgeben und eine charakteristische Geruchswahrnehmung darstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ce02ac-f3d1-43f4-8b05-734a6af20409",
                                "sense_id": "ebba56fe-076e-3748-8df9-37528a15ebd5",
                                "text": "„Das Geruchsgemisch einer solchen Fährte ist nicht leicht zu analysieren.“"
                            },
                            {
                                "example_id": "28dfdd35-0119-48fe-99f1-009dba34bd4a",
                                "sense_id": "ebba56fe-076e-3748-8df9-37528a15ebd5",
                                "text": "„Je Geruchsgemisch erhält man ein Signalmuster „Geruchsabdruck“ oder „Fingerprint“.“"
                            },
                            {
                                "example_id": "dc2fdd2b-a334-4738-927e-ab6b9ade275e",
                                "sense_id": "ebba56fe-076e-3748-8df9-37528a15ebd5",
                                "text": "„Zudem lässt sich der Geruchseindruck, den ein Geruchsgemisch beim Menschen hervorruft, nicht auf einen Einzelstoff zurückführen, sondern wird u. a. auch durch Wechselwirkungen der Geruchsstoffe untereinander beeinflusst.“"
                            },
                            {
                                "example_id": "5ee10539-22e0-42f3-8af0-3a104d1dd83f",
                                "sense_id": "ebba56fe-076e-3748-8df9-37528a15ebd5",
                                "text": "„Ein Geruchsgemisch wird von den allermeisten Menschen nur wie ein Geruch wahrgenommen.“"
                            },
                            {
                                "example_id": "5ca89bb0-d514-4a2e-a8eb-51c6d947c992",
                                "sense_id": "ebba56fe-076e-3748-8df9-37528a15ebd5",
                                "text": "„Vom Bootshaus her nahm ich ein Geruchsgemisch von Gummi, Öl und Benzin wahr.“"
                            },
                            {
                                "example_id": "f0215c34-d868-417d-b82d-bf51a0b5aac6",
                                "sense_id": "ebba56fe-076e-3748-8df9-37528a15ebd5",
                                "text": "„Es besteht ein Bedarf an weiterer Forschung zur Optimierung des Modells für den Fall, dass die Probeluft nicht nur durch Geruchsgemische aus den Bauprodukten, sondern zusätzlich z.B. durch menschliche Ausdünstungen, Einrichtungsgegenstände oder Nahrungsmittel belastet ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
