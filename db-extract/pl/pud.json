                "senses": [
                    {
                        "sense_id": "0d5225de-8d49-3f86-8d80-879e7a3995de",
                        "entry_id": "4a0d7d56-9059-3ca1-9e21-9ca3dbe2b7cb",
                        "glosses": [
                            "dawna rosyjska jednostka masy równa 40 ówczesnym funtom (16,38 kg)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c0a5bc-97f8-4b57-8ebc-d7fce43e9cb2",
                                "sense_id": "0d5225de-8d49-3f86-8d80-879e7a3995de",
                                "text": "Wstałem z niespodzianie wielkim trudem, jakbym miał w lędźwiach pud żelaza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69afcbfd-c3ec-4580-aaf2-18545db1b23d",
                        "source_entry_id": "4a0d7d56-9059-3ca1-9e21-9ca3dbe2b7cb",
                        "source_sense_id": "0d5225de-8d49-3f86-8d80-879e7a3995de",
                        "target_lang_word": "pood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "985e9b8e-2e42-3452-9548-25dcd520f10a",
                                        "entry_id": "2967d6e3-3364-3fa8-9a51-cc05a5ea629d",
                                        "glosses": [
                                            "An obsolete Russian unit of mass, equal to 40 Russian funt, or about 16.38 kg (approximately 36.11 pounds)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de013d0c-0450-4ba9-888c-1c4adc7d8544",
                                                "sense_id": "985e9b8e-2e42-3452-9548-25dcd520f10a",
                                                "text": "About 250,000 poods of yuft are prepared annually, of which about 150,000 poods are red yuft, manufactured chiefly for foreign markets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792f65c4-b116-3a89-8f72-a765259d009a",
                                        "entry_id": "2967d6e3-3364-3fa8-9a51-cc05a5ea629d",
                                        "glosses": [
                                            "A Russian unit of mass used for kettlebells, now rounded off to 16 kg (about 35.274 pounds)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42a525d8-3288-4a0f-af47-f12fd1ff3d18",
                        "source_entry_id": "4a0d7d56-9059-3ca1-9e21-9ca3dbe2b7cb",
                        "source_sense_id": "0d5225de-8d49-3f86-8d80-879e7a3995de",
                        "target_lang_word": "pud",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c3d722c2-8bcc-47fb-b132-ba05f246d9d9",
                        "source_entry_id": "4a0d7d56-9059-3ca1-9e21-9ca3dbe2b7cb",
                        "source_sense_id": "0d5225de-8d49-3f86-8d80-879e7a3995de",
                        "target_lang_word": "пуд",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пуд",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "64781b53-3ab9-372e-be83-0c1d624faeb7",
                                        "entry_id": "3ce87fab-aae2-3744-bf71-cfd9f8c43c81",
                                        "glosses": [
                                            "старин. дометрическая единица измерения массы русской системы мер, равная 16,4 кг; в России официально отменёна в 1918 году, но ещё около 50 лет применялась в сельском хозяйстве как мера зерна. Округлённая масса до 16 кг используется в гиревом спорте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35144d95-a89d-44b2-9fe6-fd687d1d18fc",
                                                "sense_id": "64781b53-3ab9-372e-be83-0c1d624faeb7",
                                                "text": "Но понеже к кучной работе много земли надобно, для того что на некоторых местах из трёх пудов земли только один фунт селитры выварить можно, то надлежит весьма рассуждать, как бы оную обогатить."
                                            },
                                            {
                                                "example_id": "1f711772-efea-4a2e-8dd4-60927883ce77",
                                                "sense_id": "64781b53-3ab9-372e-be83-0c1d624faeb7",
                                                "text": "Через несколько секунд Ньютон предложил ускорить движение вверх, причём кажущаяся тяжесть внутри прибора должна удвоиться, т. е. каждый должен был весить от 8 до 10 пудов."
                                            },
                                            {
                                                "example_id": "6df6c8b5-2154-4314-9340-8923be399a8c",
                                                "sense_id": "64781b53-3ab9-372e-be83-0c1d624faeb7",
                                                "text": "Первые 13 миллионов гектаров целины, намеченные к освоению в 1954 году, в случае успеха уже осенью того же года могли добавить в наши закрома 800‒⁠900 миллионов пудов товарного зерна."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b76226-f4e0-332f-b2f6-ee302645cc4e",
                                        "entry_id": "3ce87fab-aae2-3744-bf71-cfd9f8c43c81",
                                        "glosses": [
                                            "разг. перен. для выражения большого количества или большой массы чего‑л."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ab0885-90f1-49b1-8058-f08602801398",
                                                "sense_id": "17b76226-f4e0-332f-b2f6-ee302645cc4e",
                                                "text": "— Месяца два тому назад мы продали в ларёк несколько пудов старых газет."
                                            },
                                            {
                                                "example_id": "d9e5e85c-b01a-422d-bfc4-2bfee0d296bc",
                                                "sense_id": "17b76226-f4e0-332f-b2f6-ee302645cc4e",
                                                "text": "«Шесть пудов истерик», — называл он её про себя."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
