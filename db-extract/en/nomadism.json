                "entry_id": "b8d23a9b-9b4e-36bc-ac1e-14e3ce7eff08",
                "word": "nomadism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75396c12-cfa2-4e02-80e8-7fcc1ac0e9a4",
                        "entry_id": "b8d23a9b-9b4e-36bc-ac1e-14e3ce7eff08",
                        "tags": [
                            "plural"
                        ],
                        "form": "nomadisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "209b9769-5cf6-3978-8738-e0be8ba0062e",
                        "entry_id": "b8d23a9b-9b4e-36bc-ac1e-14e3ce7eff08",
                        "glosses": [
                            "The way of life of a nomad or nomads."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1d47e5de-47f0-4885-9e4d-6663604ec52d",
                                "sense_id": "209b9769-5cf6-3978-8738-e0be8ba0062e",
                                "text": "Like the Mesolithic age of 10,000-8000 B.C., the period 6000-4000 B.C. seems to be one of the fall of fortresses and the rise of pastoral nomadism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8114d564-1cff-47c6-b21c-a230f777fa95",
                        "source_entry_id": "b8d23a9b-9b4e-36bc-ac1e-14e3ce7eff08",
                        "source_sense_id": "209b9769-5cf6-3978-8738-e0be8ba0062e",
                        "source_sense_description": "way of life of a nomad",
                        "target_lang_word": "nomadisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomadisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0728779a-9354-399c-ae05-245f356a4177",
                                        "entry_id": "a12152da-41c0-382c-b029-3fbb3fdad0db",
                                        "glosses": [
                                            "Mode de vie nomade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c2945b-f4d4-4ead-aa12-ea820fd8d6b5",
                                                "sense_id": "0728779a-9354-399c-ae05-245f356a4177",
                                                "text": "Le principe du nomadisme historique recommande de ne jamais penser à l’étape finale."
                                            },
                                            {
                                                "example_id": "4c31bc78-a62b-44a6-9ae1-8288b7b99451",
                                                "sense_id": "0728779a-9354-399c-ae05-245f356a4177",
                                                "text": "5) la situation de protection assurée par l’existence de mers sur trois côtés et de forêts et marais sur le quatrième, protégeant les sociétés européennes des attaques de nomades – et du nomadisme, ravalé au rang d’un signe de sauvagerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "284ad9ff-6952-3e8d-9b53-2729ab524505",
                                        "entry_id": "a12152da-41c0-382c-b029-3fbb3fdad0db",
                                        "glosses": [
                                            "Mode de production basé sur le déplacement régulier et permanent des populations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f4adb8e-4398-3400-b101-f10c36b1a73a",
                                        "entry_id": "a12152da-41c0-382c-b029-3fbb3fdad0db",
                                        "glosses": [
                                            "Par extension Déplacements répétés dus à une organisation du travail (par exemple sur les chantiers) ou de l’économie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb65322-4d3b-4b1d-ba0a-2c6dc70c3d4a",
                                                "sense_id": "1f4adb8e-4398-3400-b101-f10c36b1a73a",
                                                "text": "Ils (les capitalistes) pratiquent une sorte de nomadisme fiscal, social et environnemental, afin de trouver dans tous les cas les coûts de production les plus bas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
