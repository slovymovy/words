                                        "sense_id": "eb24b713-81f4-3c01-8efc-10b8acd08a16",
                                        "entry_id": "65ce10e2-43e6-3f10-a29d-f0976d7cd909",
                                        "glosses": [
                                            "Synonym of slider (“movable part of a zip fastener that opens or closes the row of teeth”)."
