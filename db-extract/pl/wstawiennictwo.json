                "translations": [
                    {
                        "translation_id": "54a6640c-2c27-4487-be40-c6cf78699119",
                        "source_entry_id": "a8958c16-d44d-3145-a5ea-05a8e8e61da9",
                        "source_sense_id": "2c14b57f-b2cb-3bf1-9e42-e6ec7f76a775",
                        "target_lang_word": "intercession",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intercession",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae41942-5019-306f-b723-96420e2b991b",
                                        "entry_id": "4eac190e-c2ef-3181-b6bc-bdf2bb047a60",
                                        "glosses": [
                                            "The act of intervening or mediating between two parties."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c1aa1bc-fe71-414e-98c8-9d4f78e66d79",
                                                "sense_id": "8ae41942-5019-306f-b723-96420e2b991b",
                                                "text": "Lady Marchmont found her companions in no mood for discourse. Her husband was asleep, and Ethel's languid voice was scarcely audible when she forced a reply to some trilling question; and Henrietta could perceive, from the convulsive movement, and from the short suppressed sob, that she was weeping. When they arrived at home, the light showed Ethel so pale, so worn out, that she thought all attempt at any intercession were best deferred to the morrow. It must, also, be confessed, that she felt too weary for much eloquence as a pleader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aba9412-d416-34cb-a857-fe84237462da",
                                        "entry_id": "4eac190e-c2ef-3181-b6bc-bdf2bb047a60",
                                        "glosses": [
                                            "A prayer to God on behalf of another person; especially, such a prayer offered by a heavenly saint on behalf of a mere mortal who has prayed to the saint for such help."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e811493-cdda-45b0-85c3-b5f033bfcdd2",
                        "source_entry_id": "a8958c16-d44d-3145-a5ea-05a8e8e61da9",
                        "source_sense_id": "2c14b57f-b2cb-3bf1-9e42-e6ec7f76a775",
                        "target_lang_word": "intercession",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intercession",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd58e29-cb2d-3aac-aaa4-3667a2720a9d",
                                        "entry_id": "61151fcb-86f8-3bdd-8179-ad53e1d1cad5",
                                        "glosses": [
                                            "Action d’intercéder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f481eb-f1fc-483f-98dd-9a3a37104c8d",
                                                "sense_id": "1bd58e29-cb2d-3aac-aaa4-3667a2720a9d",
                                                "text": "Demander quelque chose au patron par l’intercession du représentant syndical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468454c2-e409-34f0-9de8-979668c5c0af",
                                        "entry_id": "61151fcb-86f8-3bdd-8179-ad53e1d1cad5",
                                        "glosses": [
                                            "Action d’intercéder.",
                                            "Médiation auprès de Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b69a59-ff10-4ccc-bc66-08d85b3f6927",
                                                "sense_id": "468454c2-e409-34f0-9de8-979668c5c0af",
                                                "text": "— […] : Sire, Votre Majesté sera délivrée demain de tous ses ennemis ?\n— Et par l’intercession de quel saint ferait-on ce miracle ?\n— Sire, nous sommes aujourd’hui le 24 août, ce serait donc par l’intercession de saint Barthélemy."
                                            },
                                            {
                                                "example_id": "95383d10-8cf2-4e3f-9868-d57112bef6ac",
                                                "sense_id": "468454c2-e409-34f0-9de8-979668c5c0af",
                                                "text": "Si l’intercession n’avait rien donné, le saint était mis en quarantaine, la statue retournée face au mur comme au coin un mauvais élève."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c649ca84-0362-3f37-805e-ec4203d22c8d",
                                        "entry_id": "61151fcb-86f8-3bdd-8179-ad53e1d1cad5",
                                        "glosses": [
                                            "Capacité d'un programme informatique à modifier son propre état d'exécution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
