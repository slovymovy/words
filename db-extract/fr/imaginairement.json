                        "examples": [
                            {
                                "example_id": "bb304a71-f932-4dc4-9dc3-45ef05dbd05e",
                                "sense_id": "54bc41c2-4cb6-323a-a3ad-c04bff307e63",
                                "text": "Je me complaisais à ressentir imaginairement un amour arrivé à ce degré de certitude où les émotions pénètrent si bien deux êtres, que le bonheur a passé dans la vie, dans les regards, dans les paroles, et ne cause plus aucun choc."
                            },
                            {
                                "example_id": "c9ac8238-21dd-4ce8-9e55-263591be7699",
                                "sense_id": "54bc41c2-4cb6-323a-a3ad-c04bff307e63",
                                "text": "Imaginairement, elle avait voyagé avec Paul."
                            }
                        ]
