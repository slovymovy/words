                "senses": [
                    {
                        "sense_id": "bfe85387-acfa-37ac-8319-3bd9d0b6bc40",
                        "entry_id": "3ff7e6a0-31e8-3d4f-b8b2-0a3f46e81332",
                        "glosses": [
                            "Eigenschaft eines Gebietes, von Sprechern verschiedener Sprachen bewohnt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e44853-078c-49ef-b3f9-cedf81099f18",
                                "sense_id": "bfe85387-acfa-37ac-8319-3bd9d0b6bc40",
                                "text": "„Und Gemischtsprachigkeit war selbstverständlich.“"
                            },
                            {
                                "example_id": "197a239e-713f-4bea-bee8-807061eabdbb",
                                "sense_id": "bfe85387-acfa-37ac-8319-3bd9d0b6bc40",
                                "text": "„Ein kunterbuntes Gemisch aus verschiedensten Sprachen, dessen Sinnhaftigkeit und Verständnis aufgrund der Gemischtsprachigkeit nicht gegeben sei, kritisiert der Meraner Gemeinderat Christoph Mitterhofer (STF).“"
                            },
                            {
                                "example_id": "4fe6fd5f-df30-4850-bac2-d1c97ad18dbb",
                                "sense_id": "bfe85387-acfa-37ac-8319-3bd9d0b6bc40",
                                "text": "„Die einstige Gemischtsprachigkeit lässt sich auch an einigen alten Riedbezeichnungen wie Podgrabnam (unter dem Graben) oder Spodnje polje (Untere Felder) ablesen.“"
                            },
                            {
                                "example_id": "0ab7049e-f289-48e2-8dde-bded5281fa6e",
                                "sense_id": "bfe85387-acfa-37ac-8319-3bd9d0b6bc40",
                                "text": "„Die Deutschsprachigen interpretieren das Territorialitätsprinzip jedoch in dem Sinn, dass es gerade auch gemischtsprachige Gebiete als solche schützt, wenn die Gemischtsprachigkeit eine historisch gewachsene Tatsache darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
