                                "zh": "这两份报告在最终数字上<w>有出入</w>。",
                                "nl": "De twee rapporten <w>stemmen niet overeen</w> over de uiteindelijke cijfers.",
                                "pl": "Te dwa raporty <w>różnią się</w> w kwestii ostatecznych liczb.",
                                "de": "Die beiden Berichte <w>divergieren</w> bei den endgültigen Zahlen.",
                                "fr": "Les deux rapports <w>divergent</w> sur les chiffres finaux.",
                                "it": "I due rapporti <w>divergono</w> sui numeri finali.",
                                "cs": "Tyto dvě zprávy se v konečných číslech <w>rozcházejí</w>.",
                                "tr": "İki rapor nihai rakamlar konusunda <w>çelişiyor</w>.",
                                "es": "Los dos informes <w>discrepan</w> en las cifras finales."
                            }
