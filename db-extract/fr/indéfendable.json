                                "example_id": "5ba6b5da-6518-489f-a542-f46ac1d981d8",
                                "sense_id": "c2191da0-ecd7-307e-8bf1-8c263b0dcb5e",
                                "text": "Cette opinion est indéfendable."
                            },
                            {
                                "example_id": "8aa749f3-e934-4629-a795-f996a4ec90f6",
                                "sense_id": "c2191da0-ecd7-307e-8bf1-8c263b0dcb5e",
                                "text": "Mais Napoléon la jugera indéfendable et la vendra en 1803 aux États-Unis. (en parlant de la Louisiane)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
