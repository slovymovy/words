                "senses": [
                    {
                        "sense_id": "62870ce9-0a16-3584-bc48-afe2e05f84c6",
                        "entry_id": "b2081ec3-b750-324e-9c97-4570caa0ed21",
                        "glosses": [
                            "Leser (in der Regel ein Kind von circa 5 bis 8/9 Jahren), der seine ersten Leseversuche unternimmt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0058de47-312b-36f0-9602-e9f775e27c94",
                        "entry_id": "b2081ec3-b750-324e-9c97-4570caa0ed21",
                        "glosses": [
                            "erster Leser eines literarischen Werkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216b62c2-fe73-4afc-a4db-deda8b92d1a5",
                                "sense_id": "0058de47-312b-36f0-9602-e9f775e27c94",
                                "text": "„Und dann wären da noch mein Erstleser und meine Erstleserinnen, deren Rückmeldungen mir während der einsamen Schreibphase immer sehr helfen.“"
                            },
                            {
                                "example_id": "0cc150bb-424d-4751-9951-a61efdb53737",
                                "sense_id": "0058de47-312b-36f0-9602-e9f775e27c94",
                                "text": "„Thomas Hasler, mein Erstleser, der kritisch und unerbittlich jeden Logikfehler aufdeckt und so gut wie immer recht hat (!), selbst wenn er Akkordarbeit leisten muss, weil das Manuskript eigentlich schon abgegeben sein müsste, wenn er es in die Hände kriegt.“"
                            },
                            {
                                "example_id": "b0561e1a-02ea-44a1-9e36-a86f1a3d686e",
                                "sense_id": "0058de47-312b-36f0-9602-e9f775e27c94",
                                "text": "Ein weiterer Dank gilt meinen Erstlesern, die mich mit Ideen, Kritik und Ermutigungen beim Schreiben unterstützt haben.“"
                            },
                            {
                                "example_id": "b60a7dc8-cae1-4df9-8502-7a1480d9cbf0",
                                "sense_id": "0058de47-312b-36f0-9602-e9f775e27c94",
                                "text": "„Ich danke meinem Erstleser Ernst Kleemann für sein Engagement und sein Durchhaltevermögen.“"
                            },
                            {
                                "example_id": "e6fff17d-b7dd-4bff-8910-142e3b4d8d0a",
                                "sense_id": "0058de47-312b-36f0-9602-e9f775e27c94",
                                "text": "„Und ich danke Adam, meinem Erstleser, umsichtigen Lektor, größten Fürsprecher, besten Publikum und treuesten Freund.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
