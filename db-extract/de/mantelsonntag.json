                        "examples": [
                            {
                                "example_id": "ca20d63c-dd26-4022-aeea-bbd4b23cc84d",
                                "sense_id": "500d3cec-b7f7-3cb1-aab0-715141ff22ff",
                                "text": "„Wenn sich die Ludwigstraße mit Menschen füllt, dann ist Mantelsonntag in Bad Brückenau.“"
                            },
                            {
                                "example_id": "904efccf-c25c-4f3e-a230-69738a794405",
                                "sense_id": "500d3cec-b7f7-3cb1-aab0-715141ff22ff",
                                "text": "„In der rheinland-pfälzischen Landeshauptstadt ist die Genehmigung des sogenannten Mantelsonntags (der Name erinnert an die Gewohnheit der Winzer und Landwirte, nach der Lese oder Ernte zum Kauf eines neuen Mantels in die Stadt zu kommen) am nächsten Wochenende nur mehr eine Formsache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
