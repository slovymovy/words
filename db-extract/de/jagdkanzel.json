                "senses": [
                    {
                        "sense_id": "e16df1a0-ef13-388e-82ae-20dc3119fdd1",
                        "entry_id": "054dc4bc-7b27-3fde-a4c1-dc134ed148f6",
                        "glosses": [
                            "eine Ansitzeinrichtung, die unmittelbar dem Aufsuchen des Wildes sowie der Jagdausübung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de08677-cdb0-450a-8a08-8541f3b810f1",
                                "sense_id": "e16df1a0-ef13-388e-82ae-20dc3119fdd1",
                                "text": "„Bei Ueckermünde in Vorpommern sind am Wochenende in größerem Stil Jagdkanzeln zerstört worden. Wie ein Polizeisprecher am Montag in Neubrandenburg sagte, wurden im und am Wald zwischen Ueckermünde, der Bundesstraße 109 sowie Lübs (Kreis Vorpommern-Greifswald) sechs Ansitze mit Kanzeln umgeworfen oder kaputtgesägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
