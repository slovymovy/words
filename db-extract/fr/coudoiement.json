                "senses": [
                    {
                        "sense_id": "b89d6ad8-4a41-32d2-96d6-b222782bb10c",
                        "entry_id": "6ee60a55-9601-3eca-a8e7-bb964debac93",
                        "glosses": [
                            "Action de coudoyer les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa535e78-7249-4d4a-a2e4-f2cb1043241c",
                                "sense_id": "b89d6ad8-4a41-32d2-96d6-b222782bb10c",
                                "text": "Puis, une délicatesse dut lui venir, la pensée qu’il serait brutal d’interrompre leur rêve, d’entrer dans cette solitude à deux qu’ils gardaient même parmi les coudoiements des trottoirs."
                            },
                            {
                                "example_id": "95cd8813-c1d4-4202-996f-712c7047c838",
                                "sense_id": "b89d6ad8-4a41-32d2-96d6-b222782bb10c",
                                "text": "A petits pas, Henri fit le tour de l'établissement, étudiant les physionomies, évitant les brusques coudoiements des garçons affolés, […]."
                            },
                            {
                                "example_id": "176f1d9b-3a6e-4174-9ff1-f2b418b53a91",
                                "sense_id": "b89d6ad8-4a41-32d2-96d6-b222782bb10c",
                                "text": "Le chemin de fer soumet les jeunes personnes de Suarlée aux coudoiements des gares de grandes villes."
                            },
                            {
                                "example_id": "5923b28e-baa1-48ce-9588-7e988ad1a1db",
                                "sense_id": "b89d6ad8-4a41-32d2-96d6-b222782bb10c",
                                "text": "Paris grisant et capiteux avec son atmosphère cérébrale, ses coudoiements mondains, le bruit de ses œuvres, la facilité de ses camaraderies, le prestige de ses salons !"
                            }
                        ]
                    }
