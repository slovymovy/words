{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2060c53-16d4-363d-b066-1e027d74bec0",
                    "sense_definition": "The central part of a church building, extending from the entrance to the transepts or choir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "church_architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir walked slowly down the central aisle of the <w>nave</w> toward the altar.",
                            "target_lang_translations": {
                                "de": "Der Chor schritt langsam durch den Mittelgang des <w>Kirchenschiffs</w> auf den Altar zu."
                            }
                        },
                        {
                            "text": "Sunlight streamed through the tall stained glass windows, illuminating the vast <w>nave</w> of the cathedral.",
                            "target_lang_translations": {
                                "de": "Sonnenlicht strömte durch die hohen Buntglasfenster und erleuchtete das gewaltige <w>Hauptschiff</w> der Kathedrale."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cathedral nave",
                        "church nave"
                    ],
                    "target_lang_definitions": {
                        "de": "Der mittlere Teil eines Kirchengebäudes, der sich vom Eingang bis zum Querschiff oder Chor erstreckt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kirchenschiff",
                                "target_lang_sense_clarification": "länglicher Haupt- oder Innenraum einer Kirche"
                            },
                            {
                                "target_lang_word": "Mittelschiff",
                                "target_lang_sense_clarification": "zentrales Schiff eines mehrschiffigen Kirchenbaus"
                            },
                            {
                                "target_lang_word": "Langhaus",
                                "target_lang_sense_clarification": "architektonischer Längsbau einer Kirche bis zum Querhaus"
                            },
                            {
                                "target_lang_word": "Hauptschiff",
                                "target_lang_sense_clarification": "mittlerer Hauptraum einer Kirche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f43a2dd8-5ce5-33d5-8693-507c87cb1cd6",
                    "sense_definition": "The central hub of a wheel, through which the axle passes and from which the spokes radiate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wheel_hub",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wooden spokes projected outward from the heavy iron <w>nave</w> of the wagon wheel.",
                            "target_lang_translations": {
                                "de": "Holzspeichen ragten von der schweren eisernen <w>Nabe</w> des Wagenrads nach außen."
                            }
                        },
                        {
                            "text": "The blacksmith carefully inspected the cracked <w>nave</w> before attempting to repair the cart.",
                            "target_lang_translations": {
                                "de": "Der Schmied untersuchte die gerissene <w>Radnabe</w> sorgfältig, bevor er versuchte, den Karren zu reparieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "hub"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern contexts, replaced by hub"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Der zentrale Teil eines Rades, durch den die Achse verläuft und von dem die Speichen ausgehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Nabe",
                                "target_lang_sense_clarification": "Radnabe, Mittelteil eines Speichenrades"
                            },
                            {
                                "target_lang_word": "Radnabe",
                                "target_lang_sense_clarification": "zentrales Radbauteil zur Achsaufnahme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c8142f1-2b19-3e83-affa-a5df015e3dd7",
                    "sense_definition": "The ground-level middle space or central aisle of a barn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "barn_architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tractors and farming equipment were parked in the <w>nave</w> of the large timber barn.",
                            "target_lang_translations": {
                                "de": "Traktoren und landwirtschaftliche Geräte waren im <w>Mittelschiff</w> der großen Holzscheune abgestellt."
                            }
                        },
                        {
                            "text": "Bales of hay were stacked neatly along both sides of the barn's <w>nave</w>.",
                            "target_lang_translations": {
                                "de": "Heuballen waren ordentlich zu beiden Seiten der Scheunen-<w>Tenne</w> aufgestapelt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Der ebenerdige mittlere Bereich oder Mittelgang einer Scheune."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mittelschiff",
                                "target_lang_sense_clarification": "zentraler Bereich oder Gang einer Scheune"
                            },
                            {
                                "target_lang_word": "Tenne",
                                "target_lang_sense_clarification": "Mittelgang oder Dreschboden einer Scheune"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c43983e2-fe3f-3518-82d8-694e8a015746",
                    "sense_definition": "The navel or belly button.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_navel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient play, the warrior was unseamed from the <w>nave</w> to the chaps.",
                            "target_lang_translations": {
                                "de": "In dem antiken Theaterstück wurde der Krieger vom <w>Nabel</w> bis zum Kinn aufgeschlitzt."
                            }
                        },
                        {
                            "text": "The archaic text used the word <w>nave</w> to describe the center of the abdomen.",
                            "target_lang_translations": {
                                "de": "Der archaische Text verwendete das Wort <w>nave</w>, um die Mitte des Bauches zu beschreiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "belly button",
                        "navel",
                        "umbilicus"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or literary term for navel"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Der Nabel bzw. Bauchnabel (historisch/archaisch)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Nabel",
                                "target_lang_sense_clarification": "Bauchnabel (archaische Bedeutung)"
                            }
                        ]
                    }
                }
            ]
        },
        {
