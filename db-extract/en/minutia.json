                                        "glosses": [
                                            "Menudencia, cosa de poco valor y entidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1719ab03-6b71-4606-a4d1-4b1fe02ab75f",
