                    {
                        "form_id": "33ab9528-db8c-4dc7-810b-41a29240f116",
                        "entry_id": "e772611a-d41e-3cda-b48f-916af7bd4445",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Spontaneität"
                    },
                    {
                        "form_id": "4d35bd18-78cb-48d5-8b46-17cb1ed74c1a",
                        "entry_id": "e772611a-d41e-3cda-b48f-916af7bd4445",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Spontaneitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa6df183-7e8f-3541-b4b7-34743a88e068",
                        "entry_id": "e772611a-d41e-3cda-b48f-916af7bd4445",
                        "glosses": [
                            "positive Unkompliziertheit, Agieren ohne präzise Planung, emotionales Handeln, aber eventuell auch Unzuverlässigkeit, Unvorhersehbarkeit"
                        ],
                        "tags": [
                            "Plural selten",
                            "Charaktereigenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d77f662d-298e-43a9-8b5d-7744e12143a8",
                                "sense_id": "aa6df183-7e8f-3541-b4b7-34743a88e068",
                                "text": "„[…] so gibt die Vernunft nicht demjenigen Grunde, der empirisch gegeben ist, nach, und folgt nicht der Ordnung der Dinge, so wie sie sich in der Erscheinung darstellen, sondern macht sich mit völliger Spontaneität eine eigene Ordnung nach Ideen, in die sie die empirischen Bedingungen hinein paßt, und nach denen sie sogar Handlungen für notwendig erklärt, die doch nicht geschehen sind und vielleicht nicht geschehen werden […].“"
                            },
                            {
                                "example_id": "fc1d6da2-328f-4bb4-b9b2-dbdee85d2441",
                                "sense_id": "aa6df183-7e8f-3541-b4b7-34743a88e068",
                                "text": "„Erotische Spontaneität und Ausdauer sind mitentscheidend, wenn sich reife Frauen einen jungen Geliebten suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d097ae61-fea6-3010-a1dd-91d25b5e6df7",
                        "entry_id": "e772611a-d41e-3cda-b48f-916af7bd4445",
                        "glosses": [
                            "freiwillige, aus eigenem Willen und Antrieb, nicht von außen bestimmte Handlung"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a0c9e24e-e76b-4cb8-8d36-299d891e03b1",
                                "sense_id": "d097ae61-fea6-3010-a1dd-91d25b5e6df7",
                                "text": "„In den Fällen aber, in denen spontan Kausalketten entstehen, könnte er sich irren, weil er diese Spontaneitäten nicht einkalkulieren kann.“"
                            },
                            {
                                "example_id": "2f2b5953-d092-4358-bc96-7f1d123a0994",
                                "sense_id": "d097ae61-fea6-3010-a1dd-91d25b5e6df7",
                                "text": "„In ähnlicher Spontaneität schlossen sich der Börsenverein des deutschen Buchhandels, die Initiative gegen Gewalt und Fremdenhass, in der sich 60 deutsche Verlage zusammengefunden hatten, und die deutsche Janusz-Korczak-Gesellschaft der Aktion an.“"
                            },
                            {
                                "example_id": "5b873e40-b27a-439c-9d8e-d986fa0a19a9",
                                "sense_id": "d097ae61-fea6-3010-a1dd-91d25b5e6df7",
                                "text": "„Doch Jane Austen hat man die atemlose Zeichensetzung und Spontaneität herausredigiert, vielleicht weil ein solcher Eindruck von ihr den stereotypischen Vorstellungen einer sittsamen und zurückhaltenden Autorin widersprochen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "291912b2-a104-4e4c-99db-2e480076d8f8",
                        "source_entry_id": "e772611a-d41e-3cda-b48f-916af7bd4445",
                        "source_sense_id": "aa6df183-7e8f-3541-b4b7-34743a88e068",
                        "source_sense_description": "Neigung zu kurzentschlossenem Handeln",
                        "target_lang_word": "spontaneity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontaneity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eecb637a-7e4e-33fd-a8a3-c45b93880ca6",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "The quality of being spontaneous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ec6393-f170-430a-b1d2-b45bf394cf26",
                                                "sense_id": "eecb637a-7e4e-33fd-a8a3-c45b93880ca6",
                                                "text": "In any case, they are not very big on spontaneity. They sit on him for a few minutes before they decide what to do next."
                                            },
                                            {
                                                "example_id": "dd30dfa0-48c0-4db6-b05a-0367a230e738",
                                                "sense_id": "eecb637a-7e4e-33fd-a8a3-c45b93880ca6",
                                                "text": "The unpredictability of Gemini was then contrasted with examples of human spontaneity, like the splatter technique of Jackson Pollock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d151cfe6-1ef2-33c5-a01d-dfb0cbec8e8a",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "Spontaneous behaviour."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3391fea5-9144-477f-a1d6-6f2745c6ef47",
                                                "sense_id": "d151cfe6-1ef2-33c5-a01d-dfb0cbec8e8a",
                                                "text": "Romney Leigh, who lives by diagrams, / And crosses out the spontaneities / Of all his individual, personal life / With formal universals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9015aa2c-f923-3218-92e5-26bec780b9c9",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "The tendency to undergo change, characteristic of both animal and vegetable organisms, and not restrained or checked by the environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bb8df04-927a-34ab-8eee-73a09bd33852",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "The tendency to activity of muscular tissue, including the voluntary muscles, when in a state of healthful vigour and refreshment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a7ee915-96c1-424a-93ee-ea1cf6192193",
                        "source_entry_id": "e772611a-d41e-3cda-b48f-916af7bd4445",
                        "source_sense_id": "aa6df183-7e8f-3541-b4b7-34743a88e068",
