                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725d7541-03ca-4b09-bdd3-37bf6cb2939e",
                                "sense_id": "623c60e8-f96d-3a23-bcb7-c6d9a7c97f93",
                                "text": "Hij ondervond veel plezier daarvan."
                            },
                            {
                                "example_id": "337310cc-5a93-4383-87b0-170112d10937",
                                "sense_id": "623c60e8-f96d-3a23-bcb7-c6d9a7c97f93",
                                "text": "Ik dacht eerst dat ik tijdens dit experiment niet veel plezier zou hebben en misschien zelfs door de hikers zou worden genegeerd."
                            },
                            {
                                "example_id": "ed3636d6-4e78-40ac-bf6d-6388aac47872",
                                "sense_id": "623c60e8-f96d-3a23-bcb7-c6d9a7c97f93",
                                "text": "Zangeres Sita won meerdere TMF Awards en kijkt daar met plezier op terug: 'Ik stond er op het podium met Janet Jackson' Véras Fawaz (31) is regisseur van videoclips van artiesten als Joost Klein, Goldband en Bizzey. \"Ik ben opgegroeid in Stadskanaal, in het noorden. TMF was de plek waar we konden dromen van de wereld.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "53a99b1a-6af5-3a46-95ce-dcf9ea596d59",
                        "entry_id": "79a288c8-e49d-32ba-a49b-339a8188907d",
                        "glosses": [
                            "iets wat genoegen schept"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f863c1-32ca-4c3c-9c92-2f10bf7e5b19",
                                "sense_id": "53a99b1a-6af5-3a46-95ce-dcf9ea596d59",
                                "text": "Hij deed haar daarmee een pleziertje."
                            },
                            {
                                "example_id": "660d4cc4-40df-4679-a5ae-ff83c1847a17",
                                "sense_id": "53a99b1a-6af5-3a46-95ce-dcf9ea596d59",
                                "text": "Het was gemakkelijk om de Engelsen te haten, ten slotte zo gemakkelijk dat het een plezier was ze te doden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
