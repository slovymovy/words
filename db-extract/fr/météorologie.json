                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da69ef67-0f93-387b-b121-3fbb10d74aad",
                                        "entry_id": "e52041a9-d779-3298-93d1-dfe8c2adf584",
                                        "glosses": [
                                            "Lehre von den physikalischen Vorgängen und Gesetzmäßigkeiten in der Lufthülle der Erde (Atmosphäre)"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb72f9d1-f1ba-4e96-b401-a0c4b7dbb9bb",
                                                "sense_id": "da69ef67-0f93-387b-b121-3fbb10d74aad",
                                                "text": "Die Meteorologie befasst sich mit den Vorgängen in der Lufthülle, die für uns als Wetter in Erscheinung treten."
                                            }
                                        ],
