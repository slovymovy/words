                "senses": [
                    {
                        "sense_id": "091dfbcd-f628-3412-a359-e569ed2ac532",
                        "entry_id": "adf01440-05c3-35cd-aafe-2687a2ab6977",
                        "glosses": [
                            "не являющийся растворённым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fbbbe6c-6328-4e8d-951c-722b289d9736",
                                "sense_id": "091dfbcd-f628-3412-a359-e569ed2ac532",
                                "text": "Задача аффинёра подобрать условия процесса так, чтобы на катоде отлагалось лишь золото, а примеси, находящиеся в аноде, либо оставались нерастворёнными, либо переходили в раствор."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ea274ad-d4fe-4dbf-b853-e1963b068cf6",
                        "source_entry_id": "adf01440-05c3-35cd-aafe-2687a2ab6977",
                        "source_sense_id": "091dfbcd-f628-3412-a359-e569ed2ac532",
                        "target_lang_word": "ungelöst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungelöst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16b131b1-35f0-3441-97b5-43be1ae5096c",
                                        "entry_id": "7b416ff4-2aeb-3bcb-9822-4be114f4914d",
                                        "glosses": [
                                            "so, dass es (noch) keine Lösung, Antwort zu etwas gibt; nicht geklärt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431ef6eb-c32f-45c5-8496-ca8d851aa568",
                                                "sense_id": "16b131b1-35f0-3441-97b5-43be1ae5096c",
                                                "text": "Die Polizei versucht, die ungelösten Fragen zu beantworten."
                                            },
                                            {
                                                "example_id": "4b534b65-b428-40ca-aaf0-1c5295816637",
                                                "sense_id": "16b131b1-35f0-3441-97b5-43be1ae5096c",
                                                "text": "„Einige ungelöste soziale und politische Herausforderungen generieren Leiden und Krankheit.“"
                                            },
                                            {
                                                "example_id": "6b3d64f1-b3e9-4ec4-a274-78be51c981c9",
                                                "sense_id": "16b131b1-35f0-3441-97b5-43be1ae5096c",
                                                "text": "„Die Mystery-Größe auf YouTube mit mehr als 2 Millionen Fans lehrt uns das Gruseln: alle Geschichten sind wahr, ungelöst und hochdramatisch.“"
                                            },
                                            {
                                                "example_id": "378b4d12-f8be-4ab0-8e75-57ce4c46355b",
                                                "sense_id": "16b131b1-35f0-3441-97b5-43be1ae5096c",
                                                "text": "„Bis heute ist dies der einzige ungelöste Fall einer Flugzeugentführung in den USA.“"
                                            },
                                            {
                                                "example_id": "2cb8e88c-9fdb-405a-a758-f6d4caf33911",
                                                "sense_id": "16b131b1-35f0-3441-97b5-43be1ae5096c",
                                                "text": "„Vordergründig geht es um eine Charité-Studie und die wissenschaftlich ungelöste Frage, welchen Anteil genau Kinder und Schüler zum Infektionsgeschehen beitragen.“"
                                            },
                                            {
                                                "example_id": "fb081f92-7b06-4912-b979-d1fd2fd262cc",
                                                "sense_id": "16b131b1-35f0-3441-97b5-43be1ae5096c",
                                                "text": "„Merkel und der ukrainische Präsident Selenskyj sprechen über bekannte und doch ungelöste Probleme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
