                        "sense_id": "6ac87f40-6eb9-3aaf-82e6-693b977c7d98",
                        "entry_id": "42cea0f8-dd3c-3578-a617-6fef810c7285",
                        "glosses": [
                            "A wild and reckless person (especially a boy); a scoundrel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ad96c5-36d3-4de1-8073-2310715071f0",
                                "sense_id": "6ac87f40-6eb9-3aaf-82e6-693b977c7d98",
                                "text": "He is now laden with that superabundant energy which makes a fool of a man, and a scapegrace of a boy, and he wants to work it off."
                            },
                            {
                                "example_id": "a0f397b4-df81-4a48-a649-c42503a76d6a",
                                "sense_id": "6ac87f40-6eb9-3aaf-82e6-693b977c7d98",
                                "text": "An infantry officer in the trenches, Graves wrote of his rocky and scapegrace return to civilian life: \"I still had the Army Habit of commandeering anything of uncertain ownership that I found lying about; also a difficulty in telling the truth--it was always easier for me now, when charged with any fault, to lie my way out in Army style.\""
                            }
                        ]
                    }
