                    {
                        "sense_id": "1b75026a-7f04-3d31-9593-f9e0d3190db5",
                        "entry_id": "8361e069-7943-3741-9f6f-e4f5e7c00c76",
                        "glosses": [
                            "Entrelacement de problèmes de santé pour une personne (physiques, et/ou psychiques) qui se renforcent mutuellement les uns les autres, et portent atteinte à la santé globale de la personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d82869-77b2-46d8-8a52-1ab26f99fdd0",
                                "sense_id": "1b75026a-7f04-3d31-9593-f9e0d3190db5",
                                "text": "C’est pour décrire cet « entrelacement de maladies en interactions et s’aggravant réciproquement », contre lequel la médecine n’est pas armée, que l’anthropologue américain Merrill Singer inventa, en 1990, la notion de « syndémie »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2ecffff-22e0-4bea-9b6d-c5275971587f",
                        "source_entry_id": "8361e069-7943-3741-9f6f-e4f5e7c00c76",
