                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "06f321c7-8c56-3106-ba0e-2fce497a2832",
                                        "entry_id": "f91861c0-a326-3a10-abf7-9a82a187a358",
                                        "glosses": [
                                            "iemand die profijt trekt van de omstandigheden zonder rekening te houden met principes of moraal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6ff9be-1624-4700-a228-067ff690f1e3",
                                                "sense_id": "06f321c7-8c56-3106-ba0e-2fce497a2832",
                                                "text": "Opportunisten zijn het gevaarlijkst: ze maken het kwaad mogelijk, maar dragen geen bruin hemd; ze komen over als wijs, rationeel, neutraal; ze hebben ook heus soms buikpijn, maar ‘laten zich niet door emoties meeslepen’, ze zeggen bedachtzaam dat je ‘wel realistisch moet zijn’ – ze kunnen zelfs shapeshiften tot verzetsheld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f6cb051-4000-49b2-90bc-a229b72c037c",
                        "source_entry_id": "a13d34d8-fd0f-304c-97cc-e732f7994e82",
                        "source_sense_id": "54d0ca7f-b5d3-32e5-a6ba-6e5ff72a9490",
