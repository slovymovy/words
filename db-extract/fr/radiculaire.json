                    {
                        "sense_id": "fdacaa5a-d05f-3ec5-9e19-728600136aed",
                        "entry_id": "a7995523-3eab-3f8b-ae63-353f4590523c",
                        "glosses": [
                            "Relatif à la radicule."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0ebd356c-461a-3dcc-9a19-fcf307f41f01",
                        "entry_id": "a7995523-3eab-3f8b-ae63-353f4590523c",
                        "glosses": [
                            "Synonyme de racinaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ce7327-1442-4142-87cc-691b41975c7c",
                                "sense_id": "0ebd356c-461a-3dcc-9a19-fcf307f41f01",
                                "text": "Chaque embryon présente une extrémité radiculaire et une extrémité cotylédonaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "5315fabd-7fb8-3ddb-930d-aa91cad907c1",
                        "entry_id": "a7995523-3eab-3f8b-ae63-353f4590523c",
                        "glosses": [
                            "Qui concerne la ou les racines de la dent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b0963f-9635-442b-82b1-0eb62a660f5e",
                                "sense_id": "5315fabd-7fb8-3ddb-930d-aa91cad907c1",
                                "text": "Selon son emplacement, ce tissu conjonctif porte le nom de pulpe coronaire (pour la partie située sous la couronne) ou de pulpe radiculaire (pour celle qui se trouve dans la racine)."
                            },
                            {
                                "example_id": "6ed1aa42-9dba-4a18-b05a-5a0c93a3eb07",
                                "sense_id": "5315fabd-7fb8-3ddb-930d-aa91cad907c1",
                                "text": "L’éruption intra-osseuse du germe s’accompagne de l’initiation de l’élongation radiculaire ainsi que du développement du ligament parodontal et de la jonction gingivale."
                            },
                            {
                                "example_id": "ea59e902-b80d-475f-99a2-c4436d5eba9d",
                                "sense_id": "5315fabd-7fb8-3ddb-930d-aa91cad907c1",
                                "text": "La carie radiculaire est une lésion qui commence ou se prolonge à proximité de la jonction amélo-cémentaire jusqu'à l'apex."
                            },
                            {
                                "example_id": "09e6635a-e0c5-49e5-8eb8-abbf6a7d6e0e",
                                "sense_id": "5315fabd-7fb8-3ddb-930d-aa91cad907c1",
                                "text": "L'objectif du drainage est de soulager l’écoulement qui est enfermé dans le tissu et ne peut être drainé par le canal radiculaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "9934a819-0fe3-38c8-95b9-abbd75e794e5",
                        "entry_id": "a7995523-3eab-3f8b-ae63-353f4590523c",
                        "glosses": [
                            "Qui concerne les racines des nerfs."
                        ],
                        "tags": [],
                        "examples": []
                    }
