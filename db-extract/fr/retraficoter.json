                "senses": [
                    {
                        "sense_id": "d7c7ee52-d546-3164-8091-59602bff3819",
                        "entry_id": "d85f2d7b-039f-371d-a1eb-c5038974d735",
                        "glosses": [
                            "Traficoter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a708a2-addc-46e9-845f-784fa3dd5933",
                                "sense_id": "d7c7ee52-d546-3164-8091-59602bff3819",
                                "text": "Baisser la luminosité, prendre la photo même si l'écran est tout noir... et retraficoter la luminosité sur l'ordinateur."
                            },
                            {
                                "example_id": "6c70adf5-7ed7-44b7-9980-0c43d3bda1d1",
                                "sense_id": "d7c7ee52-d546-3164-8091-59602bff3819",
                                "text": "Je ne vais pas retraficoter mes lignes de référence pour être conforme aux modes de calcul de métré d'ArchiCAD."
                            },
                            {
                                "example_id": "639720bd-15d9-4395-89a6-26b9b5628937",
                                "sense_id": "d7c7ee52-d546-3164-8091-59602bff3819",
                                "text": "Oh, je ne me fais pas d'illusions, des intégristes vont bien nous retraficoter deux ou trois versets pour leur faire dire ce qu'ils en souhaitent."
                            }
                        ]
                    }
                ],
