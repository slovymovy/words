                ],
                "senses": [
                    {
                        "sense_id": "b9235ad2-bba2-3337-aac1-2238a4bf0673",
                        "entry_id": "41f831fb-2baa-3902-89bf-10e5753f71cd",
                        "glosses": [
                            "Empfänger einer Forderung, nachdem diese vom ursprünglichen Eigentümer abgetreten, weiterverkauft oder übergegangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5aedacb-09be-4ee2-9d97-431a9fdfe97d",
                                "sense_id": "b9235ad2-bba2-3337-aac1-2238a4bf0673",
                                "text": "„Auch nach österreichischem Recht wird der persönlich oder mit bestimmten Vermögensstücken Haftende, der eine fremde Schuld begleicht, Legalzessionar (…)“"
                            },
                            {
                                "example_id": "d99c7e89-a99a-47d2-85e8-c1262daeca24",
                                "sense_id": "b9235ad2-bba2-3337-aac1-2238a4bf0673",
                                "text": "„Leistete aber der Haftpflichtversicherer über Urgenz des klagenden Legalzessionars den auf den Haftungshöchstbetrag fehlenden Differenzbetrag, dann fehlt für die Annahme eines hiedurch zum Ausdruck gebrachten weiterreichenden Verpflichtungswillens jegliche Grundlage.“"
                            },
                            {
                                "example_id": "c235156f-aed7-494d-b7ee-d52b66ede559",
                                "sense_id": "b9235ad2-bba2-3337-aac1-2238a4bf0673",
                                "text": "„Für den Sozialversicherungsträger gilt diejenige Verjährungsvorschrift, der der zivilrechtliche Anspruch des Verletzten unterliegt, und gegenüber dem Sozialversicherungsträger als Legalzessionar beginnt keine neue Verjährungsfrist zu laufen.“"
                            },
                            {
                                "example_id": "f6d21046-309e-410f-86e5-ede0982e7b11",
                                "sense_id": "b9235ad2-bba2-3337-aac1-2238a4bf0673",
                                "text": "„…; zu diesem Einwand ist der Schädiger auch gegenüber dem Legalzessionar (Feuerversicherer) berechtigt.“"
                            },
                            {
                                "example_id": "e8b9f1b8-48d9-43ae-ad95-f1451fa9179d",
                                "sense_id": "b9235ad2-bba2-3337-aac1-2238a4bf0673",
                                "text": "„Der leistende Sachversicherer klagte als Legalzessionar den AN auf ungeminderten Ersatz des Schadens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
