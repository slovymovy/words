{
    "word_family": [
        "mouse",
        "mouser",
        "mousy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f25f2438-5912-3831-92a3-1d2d2e263512",
                    "sense_definition": "Plural of <w>mouse</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat chased three <mice> across the kitchen floor.",
                            "target_lang_translations": {
                                "ru": "Кошка погналась за тремя <мышами> по кухонному полу.",
                                "zh": "猫在厨房地板上追逐三只<w>老鼠</w>。"
                            }
                        },
                        {
                            "text": "Field <mice> often hide in the tall grass to avoid predators.",
                            "target_lang_translations": {
                                "ru": "Полевые <мыши> часто прячутся в высокой траве, спасаясь от хищников.",
                                "zh": "田<w>鼠</w>经常躲在高草丛中以躲避捕食者。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "field mice",
                        "blind mice",
                        "quiet as mice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «мышь»; мелкие грызуны.",
                        "zh": "“Mouse”的复数形式；指小型啮齿动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мыши",
                                "target_lang_sense_clarification": "животные"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老鼠",
                                "target_lang_sense_clarification": "指代小型啮齿类动物"
                            },
                            {
                                "target_lang_word": "鼠",
                                "target_lang_sense_clarification": "指代啮齿类动物的统称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36db68c9-a1c9-3558-8022-0f1935b0af5b",
                    "sense_definition": "To be distracted or inattentive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was just <micing> around instead of paying attention to his work.",
                            "target_lang_translations": {
                                "ru": "Он просто <считал ворон> вместо того, чтобы уделять внимание своей работе.",
                                "zh": "他只是在<w>走神</w>，根本没专心工作。"
                            }
                        },
                        {
                            "text": "Stop <micing> and listen to what I am saying.",
                            "target_lang_translations": {
                                "ru": "Перестань <зевать> и слушай, что я говорю.",
                                "zh": "别<w>发呆</w>了，听我说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "daydream",
                        "space out"
                    ],
                    "antonyms": [
                        "focus",
                        "concentrate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "implied by usage context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть рассеянным, невнимательным или витать в облаках.",
                        "zh": "指心不在焉、注意力不集中或发呆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "считать ворон",
                                "target_lang_sense_clarification": "идиома: быть невнимательным"
                            },
                            {
                                "target_lang_word": "зевать",
                                "target_lang_sense_clarification": "проявлять невнимательность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走神",
                                "target_lang_sense_clarification": "指注意力不集中"
                            },
                            {
                                "target_lang_word": "发呆",
                                "target_lang_sense_clarification": "指心不在焉的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}