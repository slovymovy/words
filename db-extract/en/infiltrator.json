    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8b331f7b-62b0-3265-ac27-0cc37e221321",
                "word": "infiltrator",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "995b8a4c-aea9-4c35-8e28-fa51cdb46a02",
                        "entry_id": "8b331f7b-62b0-3265-ac27-0cc37e221321",
                        "tags": [
                            "plural"
                        ],
                        "form": "infiltrators"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae2d7c95-d46e-372c-9e1c-3a242ee8b52f",
                        "entry_id": "8b331f7b-62b0-3265-ac27-0cc37e221321",
                        "glosses": [
                            "One who infiltrates an organization or territory; an undercover or covert agent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a101e286-7a73-4642-b8ed-b17c8c78f970",
                                "sense_id": "ae2d7c95-d46e-372c-9e1c-3a242ee8b52f",
                                "text": "Sometimes Israelis were attacked by Arab infiltrators, and hardly a month went by without a West Jerusalemite either being killed or wounded."
                            },
                            {
                                "example_id": "f4a79664-431b-43b4-8c2e-d8b608958a03",
                                "sense_id": "ae2d7c95-d46e-372c-9e1c-3a242ee8b52f",
                                "text": "Suddenly, one of the cadre appeared from out of the darkness. \"Hello, soldier\", he said. \"Do you have a light?” “Sure,” Jack replied, digging into his pocket for a book of matches. “Soldier! You are dead!” exclaimed the cadre. Jack had failed to challenge the infiltrator. The password was “Bronx”, the counter password was “Bombers”."
                            },
                            {
                                "example_id": "96f53f78-3e4f-405c-bbab-0fa1caeb9567",
                                "sense_id": "ae2d7c95-d46e-372c-9e1c-3a242ee8b52f",
                                "text": "Sudan’s President Omar al-Bashir blamed infiltrators for the recent deaths of anti-government protesters a speech Sunday while vowing to respect the will of the people in the 2020 elections."
                            },
                            {
                                "example_id": "1e3d9a0b-7671-4cbe-a07e-691ea5a153a5",
                                "sense_id": "ae2d7c95-d46e-372c-9e1c-3a242ee8b52f",
                                "text": "“We will remove every single infiltrator from the country, except Buddha, Hindus and Sikhs,” Bharatiya Janata Party (BJP) president Amit Shah told supporters in West Bengal on Thursday."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bde5a8d8-c0ba-458f-8578-68a4e7121848",
                        "source_entry_id": "8b331f7b-62b0-3265-ac27-0cc37e221321",
                        "source_sense_id": "ae2d7c95-d46e-372c-9e1c-3a242ee8b52f",
                        "source_sense_description": "one who infiltrates",
                        "target_lang_word": "infiltrant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infiltrant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "75e58e1e-349b-3a59-9c84-7b2d9680b29e",
                                        "entry_id": "598b902b-6fa9-3fe7-ac63-7f2c34795db1",
                                        "glosses": [
                                            "iemand die deelneemt aan een organisatie om die organisatie te bespioneren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f453a3-311b-4f6d-be65-e1773a534a9f",
                                                "sense_id": "75e58e1e-349b-3a59-9c84-7b2d9680b29e",
                                                "text": "We zullen je dan natuurlijk voorzien hebben van alle papieren die je nodig kan hebben, je was een van ons, je was een geheime infiltrant in de Hird, een held in de verzetsstrijd enzovoort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
