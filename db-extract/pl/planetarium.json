                    {
                        "translation_id": "6ce07b99-0d4c-4935-9a20-0d563df2bb73",
                        "source_entry_id": "a5d56ecd-b3d6-3dcb-8604-6479e4a13b9f",
                        "source_sense_id": "79523363-de13-341a-b1bf-27da170fe7fc",
