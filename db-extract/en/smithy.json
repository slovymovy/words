                "senses": [
                    {
                        "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                        "entry_id": "e4c784cc-1854-3a1c-9c69-6223fecb58e7",
                        "glosses": [
                            "The location where a smith (particularly a blacksmith) works, a forge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae0cedf-f279-4bdf-a844-410f8119e344",
                                "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                                "text": "Traditionally a village smithy was a busy place because the smith's work was so necessary."
                            },
                            {
                                "example_id": "40a5cc34-40fb-41b8-8fb6-08d531895d33",
                                "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                                "text": "The workshop with its smithy is still intact, also the loading stage where the narrow-gauge wagons tipped their contents into those of the G.W.R."
                            },
                            {
                                "example_id": "bfd56608-2b44-4664-99fc-f14d3d46d90c",
                                "sense_id": "8d79b8b3-ad19-31ce-8100-41b7d9af7f25",
                                "text": "Close to the hump-backed bridge on the lane leading into the Hambleden Valley is a mid-19th-century smithy, its inside walls hung with tools of the blacksmith's trade, though decorative wrought-ironwork is now the main product from its glowing forge."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
