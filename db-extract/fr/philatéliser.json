                "senses": [
                    {
                        "sense_id": "6bff3187-d1a1-31c0-b703-2ecc15da0c8a",
                        "entry_id": "5c4a6529-edc0-38e0-a48a-a9615cf890e0",
                        "glosses": [
                            "Amener à la philatélie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf474ba5-e5ad-4901-8b7d-9ef9464d6c7c",
                                "sense_id": "6bff3187-d1a1-31c0-b703-2ecc15da0c8a",
                                "text": "Un philatéliste ne cherche pas à \"philatéliser\" les élus; on ne lui demande jamais."
                            }
                        ]
                    },
                    {
                        "sense_id": "adf00f80-8a08-378b-ac2c-5ab6a8dbd8aa",
                        "entry_id": "5c4a6529-edc0-38e0-a48a-a9615cf890e0",
                        "glosses": [
                            "S’adonner à la philatélie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1330842d-0621-4721-8a94-fa9e0c882182",
                                "sense_id": "adf00f80-8a08-378b-ac2c-5ab6a8dbd8aa",
                                "text": "En pleine « messe » nougarienne, sans trop l'envie de philatéliser, je musarde sur cette toile pleine de surprise."
                            },
                            {
                                "example_id": "cbf7f844-d2d8-43da-ab79-1060489297da",
                                "sense_id": "adf00f80-8a08-378b-ac2c-5ab6a8dbd8aa",
                                "text": "Encore un jour pour « philatéliser » au Forum."
                            },
                            {
                                "example_id": "54cd9592-65e5-44a7-812b-12380506c1df",
                                "sense_id": "adf00f80-8a08-378b-ac2c-5ab6a8dbd8aa",
                                "text": "Pas du tout pratique pour philatéliser (ni pour rien d'autre d'ailleurs), alors merci de votre compréhension pour le retard probable dans les échanges."
                            }
                        ]
                    }
