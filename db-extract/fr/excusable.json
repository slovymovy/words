                                "target_senses": [
                                    {
                                        "sense_id": "808737e0-9659-3d38-99af-3cc25c607de3",
                                        "entry_id": "7ac66a6d-1741-366e-a932-668d3d309365",
                                        "glosses": [
                                            "so, dass man es verzeihen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d54fa21e-35db-43bb-bc56-0e4880ea83c6",
                                                "sense_id": "808737e0-9659-3d38-99af-3cc25c607de3",
                                                "text": "Ihre heutige Abwesenheit ist entschuldbar, schließlich hat sie Geburtstag."
                                            },
                                            {
                                                "example_id": "05df4f7b-5473-4a71-9f01-b79100d14549",
                                                "sense_id": "808737e0-9659-3d38-99af-3cc25c607de3",
                                                "text": "Das war doch ein entschuldbarer Fehler, wie ich meine, da sollten wir nicht so kleinlich sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
