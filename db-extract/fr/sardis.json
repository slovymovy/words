                        "glosses": [
                            "Drap fabriqué en Bourgogne aux XVIIᵉ et XIIIᵉ siècles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad0f05e-b4e7-41eb-a03a-8bb3e8bbb691",
                                "sense_id": "21f94819-4a16-3f94-9bca-c2f4358df886",
                                "text": "Il ne faut pas omettre la fabrication qui se fait à la Charité de Mâcon & à Cluny, de Draps mêlés de différentes couleurs, & de Draps communs nommés Sardis."
                            },
                            {
                                "example_id": "64975785-a7d7-4e58-845a-5852eee3135b",
                                "sense_id": "21f94819-4a16-3f94-9bca-c2f4358df886",
                                "text": "On fait à Cluny, à Paray, à Pont-de-Vaux, à Bourg, à Montluel, de deux sortes de droguets, dont les uns, appellés^([sic]) sardis, sont tout de laine, & les autres, talanches, sont de fil & laine ; on n’y emploie que des laines du Pays, qui ne sont pas fort bonnes."
                            }
                        ]
                    }
