                "senses": [
                    {
                        "sense_id": "d65cb947-3872-318c-a074-dc2757602346",
                        "entry_id": "4a1bc7f8-6cbc-37a4-9e01-f2fc94247e06",
                        "glosses": [
                            "слегка бранить, укорять кого-либо за что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a132ce-1ef3-49f2-8e70-4894ae72a8ae",
                                "sense_id": "d65cb947-3872-318c-a074-dc2757602346",
                                "text": "В качестве друга я журил его, зачем он много пьёт, зачем живёт не по средствам и делает долги, зачем ничего не делает и не читает, зачем он так мало культурен и мало знает."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92311121-9e19-44e5-82cc-871f4d0cc572",
                        "source_entry_id": "4a1bc7f8-6cbc-37a4-9e01-f2fc94247e06",
                        "source_sense_id": "d65cb947-3872-318c-a074-dc2757602346",
                        "target_lang_word": "reprove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reprove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a63f687f-6e6c-3b80-a7ec-eabacaffd230",
                                        "entry_id": "6bd70850-ac55-364b-877f-5efba8425e51",
                                        "glosses": [
                                            "To express disapproval."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40c196db-31e2-3eeb-9fed-5ccec5d323ff",
                                        "entry_id": "6bd70850-ac55-364b-877f-5efba8425e51",
                                        "glosses": [
                                            "To criticise, rebuke, or reprimand (someone), usually in a gentle and kind tone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2261e1aa-d30c-411f-8bc0-cdc845d5f4dc",
                                                "sense_id": "40c196db-31e2-3eeb-9fed-5ccec5d323ff",
                                                "text": "Reprove not a scorner, lest he hate thee: rebuke a wise man, and he will love thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ad5a8c-b6d9-3ade-b2ee-b8ef97f6ddfa",
                                        "entry_id": "6bd70850-ac55-364b-877f-5efba8425e51",
                                        "glosses": [
                                            "To deny or reject (as a feeling, behaviour, action, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4cb6d2d-82c5-4d12-8d93-a2013bf98cb5",
                                                "sense_id": "a6ad5a8c-b6d9-3ade-b2ee-b8ef97f6ddfa",
                                                "text": "She ached to be with Affad again – and to reprove the feeling she frowned and bit her lip."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reprove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec953b97-b34f-3fe3-bf33-09c3ef24b62a",
                                        "entry_id": "02e862df-4abd-39d3-adf8-991a840d70f0",
                                        "glosses": [
                                            "To prove again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c2e70d-e4c6-4fff-a9fb-1e897aa5fde6",
                                                "sense_id": "ec953b97-b34f-3fe3-bf33-09c3ef24b62a",
                                                "text": "As we've just learned, as long as we live in the manifest realm, a hero's journey is never over. We are constantly having to reprove ourselves."
                                            },
                                            {
                                                "example_id": "90272e3a-252d-4300-b1b9-1a4fd0f56080",
                                                "sense_id": "ec953b97-b34f-3fe3-bf33-09c3ef24b62a",
                                                "text": "Often, previously-known results will be streamlined, reworded, or reproven to make them directly relevant to the results of this paper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45a203ee-1fa1-4cab-8896-dd86589dafb7",
                        "source_entry_id": "4a1bc7f8-6cbc-37a4-9e01-f2fc94247e06",
                        "source_sense_id": "d65cb947-3872-318c-a074-dc2757602346",
                        "target_lang_word": "rebuke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebuke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                        "entry_id": "7b8548d8-ca5f-34bb-b746-3daee1e92f89",
                                        "glosses": [
                                            "A harsh criticism."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c1e58d-4ac0-4cc8-b3df-53e01971b6a7",
                                                "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                                "text": "There was the sternness of an old-fashioned Tour patron in his rebuke to the young Frenchman Pierre Rolland, the only one to ride away from the peloton and seize the opportunity for a lone attack before being absorbed back into the bunch, where he was received with coolness."
                                            },
                                            {
                                                "example_id": "1cc842e7-dd8c-48fe-bc7d-ee2ab9a774f4",
                                                "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                                "text": "U.S. Vice President JD Vance met Saturday with the Vatican's No. 2 official, following a remarkable papal rebuke of the Trump administration’s crackdown on migrants and Vance’s theological justification of it."
                                            },
                                            {
                                                "example_id": "b8e6cd1c-17dc-4750-9196-0aa247eeb4e6",
                                                "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                                                "text": "With his emphasis on accepting the science (he was a trained chemist) – and hence his stern rebuke to the climate change deniers and the politicians who courted them – he even managed to reset the relationship between science and religion, which had been rocky ever since Galileo fell foul of the Inquisition 400 years earlier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rebuke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3daaaf7d-cae5-3236-b6b0-027d2e58743e",
                                        "entry_id": "85a7cc07-1d91-36da-a09f-c49cb5120dd9",
                                        "glosses": [
                                            "To criticise harshly; to reprove."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d18bd88-1267-4e59-9a2f-1c9c46d83083",
                                                "sense_id": "3daaaf7d-cae5-3236-b6b0-027d2e58743e",
                                                "text": "O Lord, do not rebuke me in Your anger or discipline me in Your wrath."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7a88b1b-31af-4db2-8746-cbd23b063dfc",
                        "source_entry_id": "4a1bc7f8-6cbc-37a4-9e01-f2fc94247e06",
                        "source_sense_id": "d65cb947-3872-318c-a074-dc2757602346",
                        "target_lang_word": "tadeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tadeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                        "entry_id": "d5f9227a-e547-317e-a489-313bffc7fbcd",
                                        "glosses": [
                                            "das Verhalten einer Person bemängeln, kritisieren, etwas nicht gutheißen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0737e63f-105c-401c-9e05-0109b1b5311a",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "Der Lehrer tadelt seine Schüler, weil sie die Vokabeln nicht beherrschen."
                                            },
                                            {
                                                "example_id": "4a279a2f-6334-423e-960c-caefb0683a91",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "Wieso tadelst du mich mit erhobenem Finger? Ich habe überhaupt nichts Verwerfliches getan."
                                            },
                                            {
                                                "example_id": "89ec26fd-b88a-4dc8-b3eb-239500bf37ae",
                                                "sense_id": "00dd8db7-2edc-3b5b-8c97-84df7417db14",
                                                "text": "„Ihr tadeltet meinen langen Schlummer, Ihr warft mir vor, die Interessen des Vaterlandes meiner Ruhe zu opfern.“ (1828)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7b92824-0ead-40f1-b5ed-f5bc43d5003d",
                        "source_entry_id": "4a1bc7f8-6cbc-37a4-9e01-f2fc94247e06",
                        "source_sense_id": "d65cb947-3872-318c-a074-dc2757602346",
                        "target_lang_word": "vorwerfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorwerfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                        "entry_id": "1cfb17e0-2bae-3880-a7ca-ed2eb80c01a1",
                                        "glosses": [
                                            "jemandem tadelnd sagen, dass er oder sie sich unrichtig verhält oder Fehler macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a1082c7-d125-44a1-9647-760dcefb6272",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "„Was ich dir vorwerfe? Ich werfe dir vor, dass du mich betrogen hast. So einfach ist das: wir werden uns trennen!“"
                                            },
                                            {
                                                "example_id": "38964e95-0acd-484b-9e6b-e166d399ae83",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "Lee Myung Bak wird unter anderem Korruption vorgeworfen. Ihm droht eine lange Haftstrafe."
                                            },
                                            {
                                                "example_id": "b590498c-ea82-4c83-bece-c77674659cb0",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "Ihr werden Korruption, Amtsmissbrauch und Nötigung vorgeworfen. Nun droht Südkoreas früherer Präsidentin Park Geun Hye eine lange Gefängnisstrafe […]"
                                            },
                                            {
                                                "example_id": "94534135-6ba9-49f0-b770-5e12bd84ed30",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "Die Verbraucherschutzorganisation Foodwatch hat dem Getränke-Konzern Coca-Cola eine gesundheitsgefährdende Marketingstrategie vorgeworfen."
                                            },
                                            {
                                                "example_id": "69dec59e-706b-416f-816c-d445d2e1594a",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "„Die niedersächsische Wissenschaftsministerin warf der Universitätsführung und der Vorgängerregierung vor, jahrelang schöngerechnet zu haben und von üblichen Standards abgewichen zu sein, setzte selbst aber auch erst spät eine professionelle Projektsteuerung durch.“"
                                            },
                                            {
                                                "example_id": "28d3cbcb-ddc9-49c1-8cfa-f9a7f2df5c53",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "„In dem Zivilprozess war Trump, dessen Söhnen und Mitarbeitern vorgeworfen worden, den Wert der Trump Organization jahrelang manipuliert zu haben, um an günstigere Kredite und Versicherungsverträge zu kommen.“"
                                            },
                                            {
                                                "example_id": "7c710537-547f-4ba4-ad58-c62f68866975",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "In einer einstweiligen Anordnung hat das Landgericht Köln entschieden, dass die Ex-Geliebte des Wettermoderators Jörg Kachelmann diesem nicht mehr öffentlich vorwerfen darf, sie „unter Einsatz eines Messers vergewaltigt“ zu haben."
                                            },
                                            {
                                                "example_id": "abde335e-d8ed-4b47-abc1-7a3868547410",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "In dichtem Nebel haben sich zwei griechische Soldaten anscheinend verlaufen und die Grenze zur Türkei überquert. […] Ihnen wird nun versuchte Militärspionage vorgeworfen."
                                            },
                                            {
                                                "example_id": "ff7e349a-fe53-4fa6-b418-fae4a6279226",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "Mangelnden Ehrgeiz kann man der PARTEI jedenfalls nicht vorwerfen."
                                            },
                                            {
                                                "example_id": "0a1659dd-7de2-4313-88c0-9e871058a668",
                                                "sense_id": "9c1226b0-8b19-39c2-97c5-62c05cf9879b",
                                                "text": "Ich habe mir nichts vorzuwerfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "350d338f-55de-3a0a-8ec6-cdd8e6627c2d",
                                        "entry_id": "1cfb17e0-2bae-3880-a7ca-ed2eb80c01a1",
                                        "glosses": [
                                            "etwas vor Tieren auf den Boden werfen, damit sie es fressen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fadf689-2fc6-4226-80f7-97801f459ad3",
                                                "sense_id": "350d338f-55de-3a0a-8ec6-cdd8e6627c2d",
                                                "text": "Natürlich sollte […] der Hundehalter dem Hund nicht einfach einen Brocken rohes Fleisch mit Knochen vorwerfen […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2be4ed9f-8027-3101-ac0e-a53c7bfcf4f8",
                                        "entry_id": "1cfb17e0-2bae-3880-a7ca-ed2eb80c01a1",
                                        "glosses": [
                                            "etwas durch die Luft nach vorne schmeißen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f071608-41a0-49b3-bd21-aab7869066c9",
                                                "sense_id": "2be4ed9f-8027-3101-ac0e-a53c7bfcf4f8",
                                                "text": "In der Flugphase werden die Hüften gebeugt und die Beine vorgeworfen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
