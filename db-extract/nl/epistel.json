                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64eed92c-f3e3-4307-a620-eeeb96558838",
                                                "sense_id": "a47122d4-3ae2-3cfb-8a4a-55167759f7b0",
                                                "text": "Envié una carta muy insultante al periódico por el artículo que publicaron."
                                            },
                                            {
                                                "example_id": "c5060e23-d785-475a-8749-452edfe8ee50",
                                                "sense_id": "a47122d4-3ae2-3cfb-8a4a-55167759f7b0",
                                                "text": "¡Cuán gritan esos malditos!\n¡Pero mal rayo me parta\nsi, en concluyendo la carta,\nno pagan caros sus gritos!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
