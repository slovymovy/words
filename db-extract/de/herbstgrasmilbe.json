                                        "sense_id": "616f10fe-a009-35e0-a7a2-46395391382a",
                                        "entry_id": "62350a89-571b-3602-9d01-a2ce4d90906e",
                                        "glosses": [
                                            "Any of various mites of family Trombiculidae that inhabit forests and grasslands and which, in their larval stage, attach to various animals including humans and feed on skin, often causing itching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43612f44-981a-4538-baa9-995f4b443098",
                                                "sense_id": "616f10fe-a009-35e0-a7a2-46395391382a",
                                                "text": "I wonder what I look like to the intrepid harvest mite, with his six red hungry legs, nosing through the crusted dirt of the Via Solis to find a soft pouch of blood at the base of my forefinger?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
