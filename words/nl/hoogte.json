                    "sense_id": "b66d7275-4d9c-33f1-a526-5de10d4d1c70",
                    "sense_definition": "De verticale afstand van de onderkant tot de bovenkant van iets, of het niveau ten opzichte van een referentiepunt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>hoogte</w> van de berg is meer dan tweeduizend meter.",
                            "target_lang_translations": {
                                "en": "The <w>height</w> of the mountain is more than two thousand meters.",
                                "ru": "<w>Высота</w> горы составляет более двух тысяч метров.",
                                "pl": "<w>Wysokość</w> góry wynosi ponad dwa tysiące metrów.",
                                "de": "Die <w>Höhe</w> des Berges beträgt mehr als zweitausend Meter.",
                                "fr": "La <w>hauteur</w> de la montagne est de plus de deux mille mètres.",
                                "it": "L'<w>altezza</w> della montagna è di oltre duemila metri.",
                                "cs": "<w>Výška</w> hory je více než dva tisíce metrů.",
                                "tr": "Dağın <w>yüksekliği</w> iki bin metreden fazladır.",
                                "es": "La <w>altura</w> de la montaña es de más de dos mil metros."
                            }
                        },
                        {
                            "text": "Ik ben helaas niet op de <w>hoogte</w> van de laatste ontwikkelingen.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I am not up to <w>date</w> with the latest developments.",
                                "ru": "К сожалению, я не в <w>курсе</w> последних событий.",
                                "pl": "Niestety nie jestem na <w>bieżąco</w> z najnowszymi wydarzeniami.",
                                "de": "Ich bin leider nicht auf dem <w>Laufenden</w> über die neuesten Entwicklungen.",
                                "fr": "Je ne suis malheureusement pas au <w>courant</w> des derniers développements.",
                                "it": "Purtroppo non sono al <w>corrente</w> degli ultimi sviluppi.",
                                "cs": "Bohužel nejsem v <w>obraze</w> ohledně nejnovějšího vývoje.",
                                "tr": "Maalesef son gelişmelerden <w>haberdar</w> değilim.",
                                "es": "Lamentablemente no estoy al <w>tanto</w> de los últimos acontecimientos."
                            }
                        }
                    ],
                    "antonyms": [
                        "diepte",
                        "laagte"
                    ],
                    "common_phrases": [
                        "op de hoogte",
                        "de hoogte in",
                        "op grote hoogte"
                    ],
                    "target_lang_definitions": {
                        "en": "The vertical distance from the bottom to the top of something, or the level relative to a reference point.",
                        "ru": "Вертикальное расстояние от основания до вершины чего-либо или уровень относительно точки отсчета.",
                        "pl": "Pionowa odległość od dołu do góry czegoś lub poziom w stosunku do punktu odniesienia.",
                        "de": "Der vertikale Abstand von der Unterseite zur Oberseite von etwas, oder das Niveau im Verhältnis zu einem Bezugspunkt.",
                        "fr": "La distance verticale du bas vers le haut de quelque chose, ou le niveau par rapport à un point de référence.",
                        "it": "La distanza verticale dalla base alla cima di qualcosa, o il livello rispetto a un punto di riferimento.",
                        "cs": "Vertikální vzdálenost od spodní části k horní části něčeho, nebo úroveň vzhledem k referenčnímu bodu.",
                        "tr": "Bir şeyin tabanından tepesine olan dikey mesafe veya bir referans noktasına göre seviyesi.",
                        "es": "La distancia vertical desde la parte inferior hasta la parte superior de algo, o el nivel en relación con un punto de referencia."
                    },
