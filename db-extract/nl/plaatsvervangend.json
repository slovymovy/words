                        "sense_id": "67b89ffa-e3c6-3666-b58d-369d671e2d2d",
                        "entry_id": "9ab39a52-f489-3d15-b4e4-efc8c00a3cf2",
                        "glosses": [
                            "van een persoon dat deze de werkzaamheden van iemand overneemt als deze laatste afwezig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "097c5367-b9ea-4a6f-8b81-339c474783f7",
                                "sense_id": "67b89ffa-e3c6-3666-b58d-369d671e2d2d",
                                "text": "In verband met de ziekte van de directeur is de onderdirecteur als plaatsvervangend directeur benoemd."
                            },
                            {
                                "example_id": "28275fc9-d28a-4dec-9a86-ecc5746f87bc",
                                "sense_id": "67b89ffa-e3c6-3666-b58d-369d671e2d2d",
                                "text": "Die overdreven voorliefde voor het gezag had ze van haar vader, adjunct van het plaatsvervangend afdelingshoofd bij het ministerie van Posterijen, die de hiërarchie binnen zijn ministerie zag als een metafoor voor het universum."
                            }
                        ]
                    }
