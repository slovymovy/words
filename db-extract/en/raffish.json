                        "form": "more raffish"
                    },
                    {
                        "form_id": "0e118e46-ebc7-4702-806f-6f6fd80f24e7",
                        "entry_id": "f31caaf3-a44d-388c-8811-0f9c49f5d260",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most raffish"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52918648-4917-3408-839f-d82b614d0dff",
                        "entry_id": "f31caaf3-a44d-388c-8811-0f9c49f5d260",
                        "glosses": [
                            "Characterized by careless unconventionality; rakish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d1eff56-15fe-481c-90d4-80efa0c1f93b",
                                "sense_id": "52918648-4917-3408-839f-d82b614d0dff",
                                "text": "Billie Eilish wants you to know she is in charge, brash and self-assured enough to scrap the raffish image that helped garner her a world of fans in favor of something a little more … adult."
                            },
                            {
                                "example_id": "cbdd6dbe-8e18-40b3-869a-9b445e5a72c3",
                                "sense_id": "52918648-4917-3408-839f-d82b614d0dff",
                                "text": "The smokers' most raffish outsider, Comstock, appeared to do nothing but smoke; Chris had never seen him inside the building."
                            }
                        ]
                    },
                    {
                        "sense_id": "7739ba44-c8df-353c-a356-8f76315f1f99",
                        "entry_id": "f31caaf3-a44d-388c-8811-0f9c49f5d260",
                        "glosses": [
                            "Low-class; disreputable; vulgar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4e0a78-0dc3-408c-8998-d2523a9670d6",
                                "sense_id": "7739ba44-c8df-353c-a356-8f76315f1f99",
                                "text": "I had met the man before this in the village, and detested him on sight; there was something indescribably raffish in his looks and ways that raised my gorge; […]"
                            },
                            {
                                "example_id": "8e845ce6-47cf-4533-9572-979d56076863",
                                "sense_id": "7739ba44-c8df-353c-a356-8f76315f1f99",
                                "text": "He bowed cordially to the lady in charge of Miss de Barral’s education, whom he saw in the hall engaged in conversation with a very good-looking but somewhat raffish young gentleman."
                            },
                            {
                                "example_id": "b488c514-9db3-447e-bf14-6312c4ea8217",
                                "sense_id": "7739ba44-c8df-353c-a356-8f76315f1f99",
                                "text": "He wore a neat dark overcoat, brown shoes, and a bowler hat rather on one side; his appearance was, in fact, genteel, though his air was a trifle raffish."
                            },
                            {
                                "example_id": "f0c35124-35ea-45e4-8957-6df21d408922",
                                "sense_id": "7739ba44-c8df-353c-a356-8f76315f1f99",
                                "text": "Altogether the city [Las Vegas] is one of the most amiably raffish communities in the nation—an assembly of glittering chrome and flaming colors by day, a flowering jungle of glowing neon and flashing lights by night."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1448edef-185b-4cba-bc8d-c44be5dca9e6",
                        "source_entry_id": "f31caaf3-a44d-388c-8811-0f9c49f5d260",
                        "source_sense_description": "characterized by careless unconventionality — see also rakish",
                        "target_lang_word": "verwegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9bc6ab-794a-31e3-996b-e3541beae893",
                                        "entry_id": "6d632db8-8842-3dd4-91fb-86ea6d7fca81",
                                        "glosses": [
                                            "sehr mutig, Risiken eingehend, gewagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca78005-99bb-456d-a43d-621dc151575b",
                                                "sense_id": "4f9bc6ab-794a-31e3-996b-e3541beae893",
                                                "text": "Dieser Angriff war ja wohl sehr verwegen."
                                            },
                                            {
                                                "example_id": "ddcf3c04-4e0d-422d-ad75-00400953e049",
                                                "sense_id": "4f9bc6ab-794a-31e3-996b-e3541beae893",
                                                "text": "„Den zeigt er dem schwärmerischen jungen Naturfreund, für diesen ein unvergeßliches Erlebnis, wahrscheinlich nicht weniger bedeutsam als die gesamte verwegene Bildungsreise.“"
                                            },
                                            {
                                                "example_id": "a4ba9674-df55-4a93-aa75-d84f96d087b0",
                                                "sense_id": "4f9bc6ab-794a-31e3-996b-e3541beae893",
                                                "text": "„Für verwegene Kerle, die gut bezahlt wurden, ein Kinderspiel, ihn und die ganzen lästigen Aufsichtsbeamten hier irgendwo an der Küste verschwinden zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
