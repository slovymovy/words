                "senses": [
                    {
                        "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                        "entry_id": "ad929cc2-7b36-3f1e-9919-2c6b595d43cd",
                        "glosses": [
                            "Non-Oxford British English standard spelling of recognize."
                        ],
                        "tags": [
                            "UK",
                            "alt-of",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "0295a463-d27c-447c-a40f-b23734636d2b",
                                "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                                "text": "“[…] That woman is stark mad, Lord Stranleigh. Her own father recognised it when he bereft her of all power in the great business he founded. […]”"
                            },
                            {
                                "example_id": "24be033e-9095-4b1c-82ca-4ea07464ec7c",
                                "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, and so we entered stage three – what therapists call \"bargaining\". A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul."
                            },
                            {
                                "example_id": "f37cac61-e4e3-4a51-8070-98405b4bed95",
                                "sense_id": "c37ed572-5ba9-340d-a7b1-9fe5bee95755",
                                "text": "\"When you think about it, who wants to drive 300 tonnes of steel at 125mph in the pitch black at four o'clock in the morning?\" Whelan says this with a wry smile, however, recognising that these are exactly the sort of things that train drivers love about their jobs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
