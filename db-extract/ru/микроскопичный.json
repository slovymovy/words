                                    },
                                    {
                                        "sense_id": "4687a417-98f4-3c53-a14e-9ef637cc3d69",
                                        "entry_id": "97934d1b-e13a-33e8-af75-eacdc984649d",
                                        "glosses": [
                                            "mit Hilfe eines Mikroskops"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91433095-b63c-4f25-9e8b-2b11f7c1ab4b",
                                                "sense_id": "4687a417-98f4-3c53-a14e-9ef637cc3d69",
                                                "text": "Die Schüler führen eine mikroskopische Untersuchung an einer Zwiebelhaut durch."
