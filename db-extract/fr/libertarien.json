            {
                "entry_id": "3eeb91f8-b88e-3243-b276-c3b30c73f1e7",
                "word": "libertarien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "35595256-54ed-4319-a105-29f0f768ad35",
                        "entry_id": "3eeb91f8-b88e-3243-b276-c3b30c73f1e7",
                        "tags": [
