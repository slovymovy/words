                "senses": [
                    {
                        "sense_id": "5e67085d-02b8-3290-b138-fbe932355b2e",
                        "entry_id": "dc11c64c-ba35-3e5a-bc7e-96ebcb1dab53",
                        "glosses": [
                            "биол., генет. мужская гамета для оплодотворения яйцеклетки при оогамии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54b42d2-1792-48c0-bf9a-10ff7f1016f1",
                                "sense_id": "5e67085d-02b8-3290-b138-fbe932355b2e",
                                "text": "Сформированный сперматозоид имеет размер около 60 мкм и состоит из головки, шейки и хвостика."
                            },
                            {
                                "example_id": "5d4d4d64-5b3b-4e2b-b464-7b95d8b46bd1",
                                "sense_id": "5e67085d-02b8-3290-b138-fbe932355b2e",
                                "text": "Одной из главных причин бесплодия супругов является малое содержание сперматозоидов в сперме мужчины или их пониженная подвижность."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "349b0b88-fdc3-4061-b855-515b7dca4151",
                        "source_entry_id": "dc11c64c-ba35-3e5a-bc7e-96ebcb1dab53",
                        "source_sense_id": "5e67085d-02b8-3290-b138-fbe932355b2e",
                        "target_lang_word": "spermatozoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spermatozoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                        "entry_id": "403feb77-8f44-392b-9f72-8135994ce786",
                                        "glosses": [
                                            "A reproductive cell or gamete of a male, carried in semen, that fertilizes an ovum to produce a zygote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14585a1f-391f-4213-b5af-6cac7a8742d5",
                                                "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                                "text": "But let us suppose [...] that one hardy or lucky spermatozoon has reached the waiting egg."
                                            },
                                            {
                                                "example_id": "abf492ab-51a1-413e-b7a9-cddcb0bbcff7",
                                                "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                                "text": "A sperm, or spermatozoa, is the microscopic male reproductive cell. Sperms are made up of oval-shaped heads and long tails that they use for mobility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
