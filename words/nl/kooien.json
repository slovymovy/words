                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "encager",
                                "target_lang_sense_clarification": "mettre en cage"
                            },
                            {
                                "target_lang_word": "mettre en cage",
                                "target_lang_sense_clarification": "enfermer dans une cage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c5c45c-32a2-3853-bdae-6ef5ba2fa4a6",
                    "sense_definition": "gaan slapen of rusten in een scheepskooi",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een zware wacht mocht de matroos eindelijk gaan <w>kooien</w>.",
                            "target_lang_translations": {
                                "fr": "Après un quart difficile, le matelot a enfin pu <w>aller au cadre</w>."
                            }
                        },
                        {
                            "text": "De zeelieden <w>kooiden</w> om de beurt tijdens de lange tocht.",
                            "target_lang_translations": {
                                "fr": "Les marins <w>dormaient dans leur couchette</w> à tour de rôle pendant le long voyage."
                            }
                        }
                    ],
                    "synonyms": [
                        "slapen"
                    ],
                    "target_lang_definitions": {
                        "fr": "aller dormir ou se reposer dans une couchette de navire"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aller au cadre",
                                "target_lang_sense_clarification": "terme marin : aller dormir dans sa couchette"
                            },
                            {
                                "target_lang_word": "se coucher",
                                "target_lang_sense_clarification": "dans une couchette de marin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a7cfe4b-24b5-31c8-88a7-65402f544290",
                    "sense_definition": "een eendenkooi beheren of gebruiken om wilde eenden te vangen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn voorouders wisten al generaties lang succesvol te <w>kooien</w> in dit moeras.",
                            "target_lang_translations": {
                                "fr": "Ses ancêtres savaient déjà <w>exploiter une canardière</w> avec succès depuis des générations dans ce marais."
                            }
                        },
                        {
                            "text": "Het recht om te <w>kooien</w> is in sommige streken nog eeuwenoud erfgoed.",
                            "target_lang_translations": {
                                "fr": "Le droit de <w>chasser au canardeau</w> constitue encore un patrimoine séculaire dans certaines régions."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "capturer des canards sauvages à l'aide d'un canardeau ou canardière"
