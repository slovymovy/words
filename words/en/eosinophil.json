{
    "word_family": [
        "eosinophilic",
        "eosinophilia"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3de998ae-e388-37b0-bc68-4e5ade33338a",
                    "sense_definition": "A type of white blood cell that helps the immune system fight off parasitic infections.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "blood_cells",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor ordered a blood test to check the count of <w>eosinophils</w> in the patient's body.",
                            "target_lang_translations": {
                                "zh": "医生开了一份验血单，以检查病人血液中<w>嗜酸性粒细胞</w>的计数。"
                            }
                        },
                        {
                            "text": "High levels of <w>eosinophils</w> are often a sign that the body is fighting a parasitic infection.",
                            "target_lang_translations": {
                                "zh": "<w>嗜酸性粒细胞</w>水平升高通常是身体正在抵抗寄生虫感染的信号。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eosinophil granulocyte",
                        "eosinophilic granulocyte"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种白细胞，有助于免疫系统抵抗寄生虫感染。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嗜酸性粒细胞",
                                "target_lang_sense_clarification": "医学术语，指一种具有嗜酸性颗粒的白细胞。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a8a6040-7072-3bbd-9640-49f37eda92b8",
                    "sense_definition": "An alternative form of <w>eosinophilic</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adjectives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tissue sample showed an <w>eosinophil</w> reaction under the microscope.",
                            "target_lang_translations": {
                                "zh": "在显微镜下，该组织样本显示出<w>嗜酸性</w>反应。"
                            }
                        },
                        {
                            "text": "Researchers identified the <w>eosinophil</w> cells during the laboratory analysis.",
                            "target_lang_translations": {
                                "zh": "研究人员在实验室分析过程中识别出了<w>嗜酸性</w>细胞。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指与嗜酸性粒细胞相关的或由其引起的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嗜酸性的",
                                "target_lang_sense_clarification": "形容词，描述组织或细胞对嗜酸性染料的亲和性。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}