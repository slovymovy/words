                "translations": [
                    {
                        "translation_id": "d909afa9-9d55-46a2-b79a-ccfb951e562e",
                        "source_entry_id": "8f82188a-714f-30be-9f17-60b4c65b095a",
                        "source_sense_id": "5fb5df1e-85cb-3e13-89f3-7cb1487d9899",
                        "source_sense_description": "Vertreter der Lehre des Atomismus",
                        "target_lang_word": "atomist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atomist",
