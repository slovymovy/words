                    },
                    {
                        "translation_id": "d0bbf60e-6084-470a-a2a9-1d59974b6778",
                        "source_entry_id": "987fed98-d78c-34fe-9bd6-5de63c69dc97",
                        "source_sense_id": "c00fac3c-942f-370b-9240-d605d3ea250c",
                        "target_lang_word": "navelstaren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navelstaren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a094bb52-fb85-3103-87f2-1c2f325389c8",
                                        "entry_id": "3fc8c9bb-d61d-3236-a3ce-4116d45d72bf",
                                        "glosses": [
                                            "overmatig bezig zijn met zichzelf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5457b4f7-8ff6-4fa0-a5e9-6bf4e4225e05",
                                                "sense_id": "a094bb52-fb85-3103-87f2-1c2f325389c8",
                                                "text": "We moeten nu niet gaan navelstaren, maar ook kijken wat er buiten Europa gebeurt."
                                            },
                                            {
                                                "example_id": "4497f289-bdda-4591-bb71-1e592de51777",
                                                "sense_id": "a094bb52-fb85-3103-87f2-1c2f325389c8",
                                                "text": "Waar zowel de kunst als de wetenschap overeenkomen in de uitvinding in de verrassing, komt de afkeer van het onverwachte ook overeen. Veel conceptuele moderne kunst wordt bij voorbaat afgeschreven als navelstaren, omdat de kunst tegenwoordig in zowel de uiting als het proces kan zitten. Wetenschapssubsidies verminderen of houden op te bestaan. Ideeën die zich niet meten aan gevestigde theorieën worden minder aangemoedigd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
