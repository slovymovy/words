                        "source_entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "source_sense_id": "7e272ed7-79e1-3333-8c78-3765f8886729",
                        "source_sense_description": "orthodoxe Kirchen: der Raum, in dem der Priester am Altar die Mysterien feiert",
                        "target_lang_word": "sanctum sanctorum",
