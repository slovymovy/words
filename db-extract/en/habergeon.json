    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6eed6a69-e920-3bc2-84b3-4274c88593c0",
                "word": "habergeon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "81508369-620e-4afa-b9a8-b432e3bfe19e",
                        "entry_id": "6eed6a69-e920-3bc2-84b3-4274c88593c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "habergeons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0e58878-0100-32d6-a761-a9d0e1e0e518",
                        "entry_id": "6eed6a69-e920-3bc2-84b3-4274c88593c0",
                        "glosses": [
                            "A sleeveless or short-sleeved coat of mail armour (a shorter hauberk)."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "32856039-97d3-4b07-81d6-67aeed4d9395",
                                "sense_id": "a0e58878-0100-32d6-a761-a9d0e1e0e518",
                                "text": "Their mightie ſtrokes their haberieons diſmayld, / And naked made each others manly ſpalles; […]"
                            },
                            {
                                "example_id": "33f37a00-2b80-4ce5-83da-c07a5062239f",
                                "sense_id": "a0e58878-0100-32d6-a761-a9d0e1e0e518",
                                "text": "And it came to paſſe from that time forth, that the halfe of my ſeruants wrought in the worke, and the other halfe of them held both the ſpeares, the ſhields and the bowes, and the habergeons, and the rulers were behind all the houſe of Iudah."
                            },
                            {
                                "example_id": "b575bd49-ec0c-4fae-9a60-fe6fffd43915",
                                "sense_id": "a0e58878-0100-32d6-a761-a9d0e1e0e518",
                                "text": "[…] wore a quilted haketon next his shirt, and over that the habergeon, a lesser hawberk of chain mail."
                            },
                            {
                                "example_id": "323d26c0-5988-4f8c-8f54-7e0f9b758e99",
                                "sense_id": "a0e58878-0100-32d6-a761-a9d0e1e0e518",
                                "text": "The gambeson was a medieval garment of cloth or leather, stuffed and quilted. This was worn underneath the habergeon or coat of mail to prevent bruises, but later it formed the principal defensive garment."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a4a0642-52b2-3d2c-9fc2-33d4f0c28539",
                        "entry_id": "6eed6a69-e920-3bc2-84b3-4274c88593c0",
                        "glosses": [
                            "The quilted undergarment worn under a hauberk."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2ffbc273-b125-4c3d-8309-88d439874385",
                                "sense_id": "1a4a0642-52b2-3d2c-9fc2-33d4f0c28539",
                                "text": "His quilted habergeon stuffed with cotton, gave him, indeed, an exterior almost herculean. What finally became of this brave belligerent I did not learn; but as he was never shy in exposing his person, it is very probable that[…]"
                            },
                            {
                                "example_id": "5c066c62-dbee-4d97-abcd-92bf7f9e3910",
                                "sense_id": "1a4a0642-52b2-3d2c-9fc2-33d4f0c28539",
                                "text": "There would be an iron helmet, with protection for the face given by the hinged vizor; body armour of a mixture of chainmail and plate, worn over a thick padded habergeon of cloth or leather; iron gauntlets."
                            },
                            {
                                "example_id": "501f80ec-31f9-4ce0-bb5f-110706e5d7ab",
                                "sense_id": "1a4a0642-52b2-3d2c-9fc2-33d4f0c28539",
                                "text": "His squire was already at his side, and helped with the coat of plates, the mail, the thick padded habergeon, and all the while Guillaume de Beaujeu was thinking, assessing, analysing, considering."
                            }
                        ]
                    },
                    {
                        "sense_id": "8feac3f7-9114-30d6-b4a7-68e942426ab6",
                        "entry_id": "6eed6a69-e920-3bc2-84b3-4274c88593c0",
                        "glosses": [
                            "A hauberk, any coat of mail, less commonly even a coat of scale armour."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c9acd438-35b2-4053-a9dd-83366b650b03",
                                "sense_id": "8feac3f7-9114-30d6-b4a7-68e942426ab6",
                                "text": "The defensive armour, or coat of mail of a knight, or man at arms, (also called a hauberk or habergeon,) was[…]"
                            },
                            {
                                "example_id": "87390174-a3eb-458e-9b4e-dd3b29459f2e",
                                "sense_id": "8feac3f7-9114-30d6-b4a7-68e942426ab6",
                                "text": "The Egyptians wore a kind of tippet, or square piece with a hole in it for the head to pass through, covering the shoulders and breast; this is the hauberk or habergeon. It was of scale armour; and below it, to protect the rest[…]"
                            },
                            {
                                "example_id": "620877f7-b947-41a8-93ca-f0f2b787b3d5",
                                "sense_id": "8feac3f7-9114-30d6-b4a7-68e942426ab6",
                                "text": "The knee-length mail shirt was called a hauberk or habergeon. But these shirts of mail didn't protect the legs. So, during the twelfth century, many soldiers began wearing mail pieces attached by leather on the front of their legs."
                            }
                        ]
                    }
                ],
