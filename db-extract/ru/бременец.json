                "senses": [
                    {
                        "sense_id": "60da0e25-6c9f-33e6-86e0-ad29e9ce346d",
                        "entry_id": "e63b0e0f-ac51-3052-9e7e-dc68ce294f32",
                        "glosses": [
                            "житель или уроженец города Бремена либо одноимённой федеральной земли."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7caa056-7310-450d-91e1-49288b492bc5",
                                "sense_id": "60da0e25-6c9f-33e6-86e0-ad29e9ce346d",
                                "text": "Молодой бременец."
                            },
                            {
                                "example_id": "369fb6f6-4ff6-47ee-914c-13eee7a056fb",
                                "sense_id": "60da0e25-6c9f-33e6-86e0-ad29e9ce346d",
                                "text": "Талантливые бременцы."
                            },
                            {
                                "example_id": "e9cf16a6-b219-4974-931e-cbbaca7a1e71",
                                "sense_id": "60da0e25-6c9f-33e6-86e0-ad29e9ce346d",
                                "text": "Когда в марте 1919 года против революционных рабочих Бремена были брошены отряды так называемого «добровольческого корпуса», на заводах, фабриках и верфях Северной Германии вспыхнула всеобщая забастовка. В Гамбурге формировались рабочие сотни на помощь бременцам, которым приходилось вести оборону против реакционной военщины."
                            },
                            {
                                "example_id": "83b20fae-788a-4f5b-a26d-8dca0b3e199d",
                                "sense_id": "60da0e25-6c9f-33e6-86e0-ad29e9ce346d",
                                "text": "Гастроли бременцев проходили с шумным успехом .."
                            },
                            {
                                "example_id": "23eac2c9-fc9f-4cef-ad32-60436d1906e1",
                                "sense_id": "60da0e25-6c9f-33e6-86e0-ad29e9ce346d",
                                "text": "На «бис» бременцы исполнили «Венгерский танец» Брамса — один из трёх, что Брамс оркестровал сам."
                            }
                        ]
                    }
