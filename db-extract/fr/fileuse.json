                    },
                    {
                        "form_id": "340effaa-428d-460e-b595-c0331cedb60a",
                        "entry_id": "30278938-ba0b-3c61-b656-ab18354ee543",
                        "tags": [
                            "masculine"
                        ],
                        "form": "fileur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88371912-2173-3af6-be37-4ce330b7aee1",
                        "entry_id": "30278938-ba0b-3c61-b656-ab18354ee543",
                        "glosses": [
                            "Celle qui file des matières textiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2192252-ba28-4494-82a2-0894aee98806",
                                "sense_id": "88371912-2173-3af6-be37-4ce330b7aee1",
                                "text": "Chaque tour est muni de trois asples, de manière à ce que, quand le bout casse sur l’un des deux qui fonctionnent, la fileuse fournit au troisième asple, tandis que la rattacheuse noue le bout cassé ; une rattacheuse suffit pour quatre fileuses."
                            },
                            {
                                "example_id": "a3e8ad47-5589-4fe3-a82a-f7a580e8e78a",
                                "sense_id": "88371912-2173-3af6-be37-4ce330b7aee1",
                                "text": "Ceux-ci, livrés à une fileuse indigène ont donné de jolis échantillons de soie en bourre et de soie filée au fuseau malgache."
                            }
                        ]
                    },
                    {
                        "sense_id": "137b7a69-175b-3409-8ca6-450684823962",
                        "entry_id": "30278938-ba0b-3c61-b656-ab18354ee543",
                        "glosses": [
                            "Celle qui fabrique des filets de pêche, de tennis, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a5f54c5-3334-4f2b-85f1-61c35ed01c63",
                                "sense_id": "137b7a69-175b-3409-8ca6-450684823962",
                                "text": "A la fin du xixᵉ siècle, c’est toute une population qui vit du hareng à Boulogne-sur-Mer : outre les équipages de la centaine de harenguiers, il y a les saleurs, les fileuses, les tonneliers qui concourent à cet âge d’or."
                            },
                            {
                                "example_id": "7ca47086-b6ff-40aa-b017-fe3de9afcf12",
                                "sense_id": "137b7a69-175b-3409-8ca6-450684823962",
                                "text": "C’était d’abord un certain Trede, employé du fisc à Stettin, qui fut « désestomaqué » par le Dʳ Schuckhardt, puis une fileuse de Zürich, Anne Landie, à qui le Dr Schlatter avait rendu le même office."
                            }
                        ]
                    },
                    {
                        "sense_id": "c304c5ff-cc2b-31a8-819a-c4c21b5377b7",
                        "entry_id": "30278938-ba0b-3c61-b656-ab18354ee543",
                        "glosses": [
                            "Celle qui file le verre incandescent."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f341e083-cf06-4a44-b5ee-2afb8b792e26",
                        "source_entry_id": "30278938-ba0b-3c61-b656-ab18354ee543",
                        "source_sense_id": "88371912-2173-3af6-be37-4ce330b7aee1",
