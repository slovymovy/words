                                    {
                                        "sense_id": "de61089d-08ca-3b8a-aef9-f4ce4f7de64d",
                                        "entry_id": "4eee514c-5d02-300b-9412-6bc8ba2de9e9",
                                        "glosses": [
                                            "To destroy."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a98b6f0-6bdb-4a57-ba32-85792ebe768f",
                                                "sense_id": "de61089d-08ca-3b8a-aef9-f4ce4f7de64d",
                                                "text": "She completely holed the argument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a26af01-1a18-38c2-9a17-6df258c8032b",
                                        "entry_id": "4eee514c-5d02-300b-9412-6bc8ba2de9e9",
                                        "glosses": [
                                            "To go into a hole."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa45a669-e041-4e54-9141-df65b80cbc7a",
                                                "sense_id": "3a26af01-1a18-38c2-9a17-6df258c8032b",
                                                "text": "Good master Picklock, with your worming brain,\nAnd wriggling engine-head of maintenance,\nWhich I shall see you hole with very shortly!\nA fine round head, when those two lugs are off,\nTo trundle through a pillory!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d9c157b-f14d-33a6-a7cb-c7f15a585ee4",
                                        "entry_id": "4eee514c-5d02-300b-9412-6bc8ba2de9e9",
                                        "glosses": [
                                            "To drive into a hole, as an animal, or a billiard ball or golf ball."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80f12ae9-908f-46e0-a9c5-05f2f2c4a70c",
                                                "sense_id": "5d9c157b-f14d-33a6-a7cb-c7f15a585ee4",
                                                "text": "If the player holes the red ball, he scores three, and upon holing his adversary's ball, he gains two; and thus it frequently happens, that seven are got upon a single stroke, by caramboling and holing both balls."
                                            },
                                            {
                                                "example_id": "a4c051f8-8266-4c6d-8513-c05bbe9e1c61",
                                                "sense_id": "5d9c157b-f14d-33a6-a7cb-c7f15a585ee4",
                                                "text": "Woods holed a standard three foot putt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61f7239c-b341-35cd-b92f-f74a9cc56a89",
                                        "entry_id": "4eee514c-5d02-300b-9412-6bc8ba2de9e9",
                                        "glosses": [
                                            "To cut, dig, or bore a hole or holes in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc94a37-2284-4d2b-b9d5-1267dda11a8e",
                                                "sense_id": "61f7239c-b341-35cd-b92f-f74a9cc56a89",
                                                "text": "to hole a post for the insertion of rails or bars"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
