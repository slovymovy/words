        "fr-extract.jsonl": [
            {
                "entry_id": "77282c6d-ffd6-3c2e-a7d7-dfe0ac2ad037",
                "word": "schizophrène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "adfa4621-8702-40e8-b89b-dcfc51fb559c",
                        "entry_id": "77282c6d-ffd6-3c2e-a7d7-dfe0ac2ad037",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "schizophrènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "309d2871-5951-3017-9f53-5b27585c8e4d",
                        "entry_id": "77282c6d-ffd6-3c2e-a7d7-dfe0ac2ad037",
                        "glosses": [
                            "Personne atteinte de schizophrénie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d352cfb7-b82f-4a29-8ad9-9557d1dc976d",
                                "sense_id": "309d2871-5951-3017-9f53-5b27585c8e4d",
                                "text": "Classé par la médecine américaine comme schizophrène non répertorié (unclassified schizophrenia) et n’étant visiblement pas dangereux, il est remis à la charge de sa femme, qui le ramène à New York. Fin de l’épisode."
                            },
                            {
                                "example_id": "d1659ab7-3f5a-4063-abe6-3ba2291047a2",
                                "sense_id": "309d2871-5951-3017-9f53-5b27585c8e4d",
                                "text": "En Allemagne, en France, et même dans l’Angleterre victorienne, la montée de l’autoritarisme familial produit des schizophrènes, des suicidés, des alcooliques. L'éducation devient persécution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f046949-2a2d-47fc-a70f-8126855d4da9",
                        "source_entry_id": "77282c6d-ffd6-3c2e-a7d7-dfe0ac2ad037",
                        "source_sense_id": "309d2871-5951-3017-9f53-5b27585c8e4d",
                        "target_lang_word": "schizophrenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schizophrenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d72f4e79-6cc3-3c90-b04c-0b9b79037ad7",
                                        "entry_id": "9349f9e5-638d-364a-b180-48acec7f5c16",
                                        "glosses": [
                                            "Of or relating to schizophrenia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90db53af-b802-3949-beea-a563afbbc927",
                                        "entry_id": "9349f9e5-638d-364a-b180-48acec7f5c16",
                                        "glosses": [
                                            "Afflicted with schizophrenia; having difficulty with perception of reality."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "344d5b2e-b687-3028-9edf-ec30472ec3e4",
                                        "entry_id": "9349f9e5-638d-364a-b180-48acec7f5c16",
                                        "glosses": [
                                            "Exhibiting more than one personality; having a wildly changeable personality."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac20d6b2-bf2d-4ef7-be49-5ba6765f0344",
                                                "sense_id": "344d5b2e-b687-3028-9edf-ec30472ec3e4",
                                                "text": "Schizophrenia is where two or more personalities live in the same brain. The ancients of the 20th Century actually looked upon schizophrenia as a disease! Everyone felt it was very shameful to have a schizophrenic person in the family,"
                                            },
                                            {
                                                "example_id": "1751ddcb-fd53-4bb3-b01b-6ad60ea69159",
                                                "sense_id": "344d5b2e-b687-3028-9edf-ec30472ec3e4",
                                                "text": "The average person is afraid that such a common experience means that he is \"splitting off\" and becoming schizophrenic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc2de381-eafa-3615-a09e-522b8b7c9a88",
                                        "entry_id": "9349f9e5-638d-364a-b180-48acec7f5c16",
                                        "glosses": [
                                            "Having qualities that strongly conflict or are at odds."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3318302d-bc34-482a-a789-04509b30b33c",
                                                "sense_id": "cc2de381-eafa-3615-a09e-522b8b7c9a88",
                                                "text": "Höss, a man of schizophrenic sensibility, preferred gassing to shooting because he was “spared all these bloodbaths.”"
                                            },
                                            {
                                                "example_id": "ff9696e5-018b-4f13-8d01-08ed0729d167",
                                                "sense_id": "cc2de381-eafa-3615-a09e-522b8b7c9a88",
                                                "text": "That feverish response and Jackson's infamous negative attitude towards his fans contributed to a performance which was schizophrenic at best. The program was divided into three sections, distinguishable only by the fact that slide projections on the side of the stage informed us that we were now watching \"Part 1, 2, or 3.\""
                                            },
                                            {
                                                "example_id": "6ece074b-fb51-431d-9692-1a66ef5d827c",
                                                "sense_id": "cc2de381-eafa-3615-a09e-522b8b7c9a88",
                                                "text": "Society currently displays a schizophrenic attitude to drug abuse. We seem to accept alcohol intake and smoking during pregnancy even though we know that these drugs can be addictive, and that regular use can affect the baby."
                                            },
                                            {
                                                "example_id": "9a1bb89f-d04e-4d2e-9b59-fe194b9942f4",
                                                "sense_id": "cc2de381-eafa-3615-a09e-522b8b7c9a88",
                                                "text": "The neoclassical synthesis was a schizophrenic approach to economics – a way of subscribing to both Keynesian and classical analysis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "schizophrenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b8bb762-f42b-3214-9a3a-3063a9a3fa73",
                                        "entry_id": "73023110-5c89-30e1-a885-e4befb81601c",
                                        "glosses": [
                                            "A person suffering from schizophrenia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085a61de-0ff8-4667-b8f5-1e79e6d17922",
                                                "sense_id": "9b8bb762-f42b-3214-9a3a-3063a9a3fa73",
                                                "text": "Oh, what an extraordinary idea! I have served 11 governments in the past 30 years. If I'd believed in all their policies, [proceeds to describe contradictory policies by different parties], but above all, I would have been a stark-staring raving schizophrenic! (laugh track)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
