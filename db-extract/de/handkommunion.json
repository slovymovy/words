                "senses": [
                    {
                        "sense_id": "e780fb55-aeaa-3903-994d-bcc6d28a74af",
                        "entry_id": "c40cfdbe-735a-3619-870b-efca2746b715",
                        "glosses": [
                            "der Empfang der Hostie bei der Kommunion mit der Hand (und nicht mit dem Mund)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b78a951c-350a-4f16-9774-d16ce26eebc0",
                                "sense_id": "e780fb55-aeaa-3903-994d-bcc6d28a74af",
                                "text": "„Tatsache ist auch, dass die Riten der Ostkirche keine Handkommunion kennen. Tatsache ist weiterhin, dass die Mundkommunion – rein rechtlich gesehen – der Normalfall bleibt und die Praxis der Handkommunion eine Ausnahme darstellt.“"
                            },
                            {
                                "example_id": "322f5b3c-a1cb-431a-8c4f-d5fd675ff14d",
                                "sense_id": "e780fb55-aeaa-3903-994d-bcc6d28a74af",
                                "text": "„Internationale Bekanntheit erlangte [Juan Rodolfo Laise] aufgrund seines Buches gegen die Handkommunion […], das in mehrere Sprachen übersetzt wurde.“"
                            },
                            {
                                "example_id": "cdf7b498-961f-4e6c-816e-2061d9b97ef4",
                                "sense_id": "e780fb55-aeaa-3903-994d-bcc6d28a74af",
                                "text": "„Das Interview wurde am 24. Dezember veröffentlicht, dem Tag, an dem Benedikt XVI. als Bischof von Rom den Indult für die Handkommunion bei Messen mit dem Heiligen Vater außer Kraft gesetzt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
