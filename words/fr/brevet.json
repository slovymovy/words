                {
                    "sense_id": "6b38df69-16c9-35e6-adb0-a88fa2d538aa",
                    "sense_definition": "Diplôme national sanctionnant la fin des études de collège ou certaines formations scolaires.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diplome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves révisent avec sérieux pour réussir les épreuves écrites du <w>brevet</w> en juin."
                        },
                        {
                            "text": "Après avoir obtenu son <w>brevet</w>, elle s'est inscrite dans un lycée général de sa ville."
                        }
                    ],
                    "common_phrases": [
                        "brevet des collèges",
                        "passer son brevet",
                        "obtenir son brevet"
                    ]
                },
                {
                    "sense_id": "b8c64785-e4b1-3a21-a1eb-06d52ead6a27",
                    "sense_definition": "Titre légal délivré à un inventeur lui assurant l'exclusivité de l'exploitation de son invention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "titre_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise innovante a décidé de déposer un <w>brevet</w> pour protéger sa nouvelle machine."
                        },
                        {
                            "text": "La durée de protection accordée par ce <w>brevet</w> prendra fin d'ici quelques mois."
                        }
                    ],
                    "common_phrases": [
                        "déposer un brevet",
                        "brevet d'invention"
                    ]
                },
                {
                    "sense_id": "7e4c6152-6746-3f0c-812b-843139485922",
                    "sense_definition": "Certificat ou habilitation officielle attestant une compétence technique ou professionnelle particulière.",
