                ],
                "senses": [
                    {
                        "sense_id": "e2a7c9c8-f6e1-3600-a683-dd5493c47fc0",
                        "entry_id": "1ad43afa-0c81-3067-97b5-19cfd16daba1",
                        "glosses": [
                            "Person, die ein politisches Amt ausübt, ohne einer Partei anzugehören"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4392688d-72a1-312c-8a39-31d6058686a8",
                        "entry_id": "1ad43afa-0c81-3067-97b5-19cfd16daba1",
                        "glosses": [
                            "Anhänger oder Mitglied der Unabhängigen Sozialdemokratischen Partei Deutschlands (USPD)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "845442cf-5312-47b2-98dd-78f334fa8586",
                                "sense_id": "4392688d-72a1-312c-8a39-31d6058686a8",
                                "text": "„Zunächst, in Abwesenheit ihres altgedienten Vorsitzenden, hatten die Unabhängigen es halsstarrig abgelehnt, Nichtsozialisten in die Regierung aufzunehmen, und sei es auch nur als Fachleute ohne exekutive Befugnisse.“"
                            },
                            {
                                "example_id": "28d46b1f-f57f-4932-a388-8c1f0389cfed",
                                "sense_id": "4392688d-72a1-312c-8a39-31d6058686a8",
                                "text": "„Möglicherweise hegten einige Unabhängige die Hoffnung, daß Radek die Exekutive der Komintern bewegen könne, eine internationale Konferenz einzuberufen.“"
                            },
                            {
                                "example_id": "eedabfd2-fd76-4041-b52e-35e4ae2327c6",
                                "sense_id": "4392688d-72a1-312c-8a39-31d6058686a8",
                                "text": "„Während Vertreter des von der SPD beherrschten Soldatenrats Vermittler nach Bremen schickten, versuchten einige Unabhängige und Kommunisten eine bewaffnete Truppe aufzustellen, um der Bremer Räterepublik zu Hilfe zu eilen.“"
                            },
                            {
                                "example_id": "37961f87-999b-4bcf-8f3c-d829501748a8",
                                "sense_id": "4392688d-72a1-312c-8a39-31d6058686a8",
                                "text": "„Unbestreitbar war, daß einige Unabhängige bald führende Funktionen in der vereinigten Partei übernahmen.“"
                            },
                            {
                                "example_id": "b87f229d-d937-4508-932c-773d70c4f692",
                                "sense_id": "4392688d-72a1-312c-8a39-31d6058686a8",
                                "text": "„Das Bielefelder Abkommen spaltete auch den Bueraner Vollzugsrat; MSPD und der Unabhängige Balke sprachen sich für die Durchführung des Bielefelder Abkommens aus; Kommunisten und linke Unabhängige wandten sich gegen den Abbruch des Kampfes und gegen die Reduzierung der örtlichen Arbeiterwehr.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
