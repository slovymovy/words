                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193b22e1-deaa-4865-8bb9-79c7728fbeb9",
                                "sense_id": "8e868896-c396-3463-971d-7ca306874953",
                                "text": "Le fossoyeur-chef n’avait pas très bien compris, mais il s’en fichait."
                            },
                            {
                                "example_id": "f1facc76-97c7-4ddf-afae-56ff9013c377",
                                "sense_id": "8e868896-c396-3463-971d-7ca306874953",
                                "text": "La liste est interminable : il y a des inspecteurs, des sous-inspecteurs, des conservateurs, des sous-conservateurs, des commis, des géomètres, des gardiens, des fossoyeurs-chefs, des fossoyeurs-ouvriers…"
                            },
                            {
                                "example_id": "dd6984ac-2de2-44fa-bf9b-ceb338220063",
                                "sense_id": "8e868896-c396-3463-971d-7ca306874953",
                                "text": "La famille Strip-tease a l’agréable douleur de vous faire part de l’achèvement du portrait de Monsieur Van Hoecke, fossoyeur-chef, à l’issue d’un bref tournage, à Gembloux."
                            },
                            {
                                "example_id": "e93137ac-5349-4d24-9087-a5dbab706225",
                                "sense_id": "8e868896-c396-3463-971d-7ca306874953",
                                "text": "Dans les Lettres, je reste le fossoyeur-chef. Je curriculum vite, j’archive, je prosopope."
                            }
                        ]
                    }
