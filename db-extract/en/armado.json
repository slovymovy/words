                        "examples": [
                            {
                                "example_id": "cb3e1abf-7180-4e1d-ad18-952e33c8d80c",
                                "sense_id": "b2eea082-11ab-37ac-8285-38ce04bc2a55",
                                "text": "The erizo, or water hedge-hog, is very like the armado, but not quite so large."
                            },
                            {
                                "example_id": "0078cf47-54c5-4166-9515-6fd1d302e709",
                                "sense_id": "b2eea082-11ab-37ac-8285-38ce04bc2a55",
                                "text": "The armado is a thick strong fish with a short body. It is about a foot in length, and generally weighs from four to six pounds. A small part of the belly is cartilaginous, except which the fish is covered with hard thick bone."
                            }
