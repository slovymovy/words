                        "entry_id": "3a55b530-48fa-3b5f-bfaf-d405d4353029",
                        "glosses": [
                            "muziekinstrument met één of meer snaren die in trilling worden gebracht door tokkelen, aanslaan of door strijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7faa53cf-557c-444e-b4be-912352f17f68",
                                "sense_id": "8372a6ea-38cf-3c51-a6d7-8934e41becc2",
                                "text": "Een van de snaarinstrumenten waarop veel verschillende speeltechnieken mogelijk zijn is de viool."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c791c961-c5c3-4200-bd27-8370eecc58f4",
                        "source_entry_id": "3a55b530-48fa-3b5f-bfaf-d405d4353029",
                        "source_sense_id": "8372a6ea-38cf-3c51-a6d7-8934e41becc2",
                        "source_sense_description": "muziekinstrument met snaren",
                        "target_lang_word": "Saiteninstrument",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saiteninstrument",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                                        "entry_id": "8fed6143-3aae-337a-b199-9ff3b4d6ca99",
                                        "glosses": [
                                            "Musikinstrument, bei dem die Töne durch meist mehrere schwingende Saiten erzeugt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11afeed0-f2cc-4275-9511-036b1d41627c",
                                                "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                                                "text": "Er würde lieber ein Saiteninstrument erlernen."
                                            },
                                            {
                                                "example_id": "e6632bec-b5a0-4e57-85b4-016a3f883318",
                                                "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                                                "text": "„Die Pferde von der Station gehen auf der Wiese umher und knabbern hier und dort ein wenig Gras, ein Stück weiter an einer Hauswand spielt jemand auf einem Saiteninstrument und singt dazu.“"
                                            },
                                            {
                                                "example_id": "bf211619-8506-4f89-a28f-fb970225997b",
                                                "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                                                "text": "„Sie spielten auf Banjos, Bouzoukia, Baglamades und anderen Saiteninstrumenten den griechischen Blues.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
