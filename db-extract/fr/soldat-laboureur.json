                        "glosses": [
                            "Laboureur au statut de soldat, ou soldat qui est aussi laboureur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14b12ded-ee43-4f01-87ce-7d17af70aa6e",
                                "sense_id": "4f8fe1dc-435e-35d7-a6c6-f22719dead99",
                                "text": "Le troisième, nommé Gaillard, vieux soldat devenu sous-lieutenant, criblé de blessures, appartenait à la classe des soldats-laboureurs."
                            },
                            {
                                "example_id": "cda548b9-e6ef-4cbe-9e38-dccf5ac025dc",
                                "sense_id": "4f8fe1dc-435e-35d7-a6c6-f22719dead99",
                                "text": "Aux colons, il préférait évidemment des « soldats-laboureurs » travailleurs et disciplinés."
                            },
                            {
                                "example_id": "3e1e76a7-ed86-4dc6-b2c1-f96c800b0340",
                                "sense_id": "4f8fe1dc-435e-35d7-a6c6-f22719dead99",
                                "text": "Le Japon a même organisé des compagnies de soldats-laboureurs, chargés de défricher les terres, et d’exécuter, pour leur compte, des travaux agricoles."
                            }
                        ]
                    }
