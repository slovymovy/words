                        "glosses": [
                            "die in Algerien gesprochene Form (teilweise als Dialekt bezeichnet) des Arabischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478dcd05-ec05-4515-bed5-6d6f16d03710",
                                "sense_id": "80da8aa1-b529-3bb2-9b24-da49973bb8cd",
                                "text": "„Daneben wird das sogenannte Algerisch-Arabisch gesprochen, das praktische, das jedermann versteht. Es ist ein Dialekt des Hocharabischen. Daneben werden die Berbersprache Tamazight von den Berbern im Norden gesprochen und bei den Tuareg im Süden Tamahaq.“"
                            }
                        ],
