                            {
                                "target_lang_word": "досадный",
                                "target_lang_sense_clarification": "вызывающий неприятное чувство неудачи или помехи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7620b8b-8914-3e73-bf49-979178ad4d6c",
                    "sense_definition": "Difficult to deal with due to being complex, tricky, or having a prickly personality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "difficult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team struggled to solve the <w>nettlesome</w> legal issue regarding international trade.",
                            "target_lang_translations": {
                                "ru": "Команда с трудом пыталась решить <w>сложный</w> юридический вопрос, касающийся международной торговли."
                            }
                        },
                        {
                            "text": "She was known for her <w>nettlesome</w> personality which made it hard to work with her.",
                            "target_lang_translations": {
                                "ru": "Она была известна своим <w>неуживчивым</w> характером, из-за чего с ней было трудно работать."
                            }
                        }
                    ],
                    "synonyms": [
                        "thorny",
                        "tricky",
                        "problematic",
                        "challenging"
                    ],
                    "antonyms": [
