                                                "example_id": "3c8a4b86-3344-45fe-84c8-e01c93091046",
                                                "sense_id": "f95c2753-e20e-3faf-936c-ab7f91933538",
                                                "text": "Deze auto kan beter gesloopt worden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e895feea-a9a5-3576-b1d2-95a2c79441df",
                                        "entry_id": "66efde7a-5a71-3368-a82c-3008d8640e75",
                                        "glosses": [
