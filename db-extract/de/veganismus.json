                    {
                        "sense_id": "8e19dac2-2d01-3fc3-b46d-c855aabf7076",
                        "entry_id": "901214ab-421b-31f9-ba2e-185e59078bea",
                        "glosses": [
                            "Ernährungseinstellung, die die absolute Vermeidung tierischer Produkte bedingt"
                        ],
                        "tags": [],
