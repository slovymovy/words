                ],
                "senses": [
                    {
                        "sense_id": "b24df324-6e14-3239-b35a-64e859a4b2f8",
                        "entry_id": "a3513716-1167-3dde-80e2-0ba57a3c6017",
                        "glosses": [
                            "Fouiller la terre, avec son boutoir, pour y chercher des vers, des larves, des insectes, des rongeurs (communément appelés vermine), des oignons ou des racines, pour le sanglier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f81ecb-c2e3-44d3-b907-cc7639965187",
                                "sense_id": "b24df324-6e14-3239-b35a-64e859a4b2f8",
                                "text": "Partout où il vermille, il laisse dans son sillage destruction, factures salées et émissions disproportionnées de gaz à effet de serre."
                            },
                            {
                                "example_id": "210195eb-72dc-431b-be47-6a40deff6078",
                                "sense_id": "b24df324-6e14-3239-b35a-64e859a4b2f8",
                                "text": "Les cochons étaient passés sans s’arrêter, tout en fougeant. À en juger par leurs empreintes, ils devaient être une bonne vingtaine. À un certain endroit, ils avaient cessé de vermiller pour se disperser en courant. Puis la harde s’était rassemblée."
                            },
                            {
                                "example_id": "b97f515a-eea9-463a-a1f2-fd353783c956",
                                "sense_id": "b24df324-6e14-3239-b35a-64e859a4b2f8",
                                "text": "Les sangliers vont vermiller dans les pacages, dans les prés."
                            }
                        ]
                    }
                ],
