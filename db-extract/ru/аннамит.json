                        "examples": [
                            {
                                "example_id": "cd7b43a4-942c-4e3d-bdfa-33c4cdbcd6b7",
                                "sense_id": "c417fb8f-f173-36af-a46b-3ff4b2346f40",
                                "text": "По широкой бухте вокруг кораблей, оставляя на зеркальной воде колыхающийся след, скользили на своих узких челноках аннамиты. Весь их наряд состоял из куска пестрой материи, прикрывающей тело, из белой чалмы на голове."
                            }
                        ]
                    }
