                        "examples": [
                            {
                                "example_id": "7b0449ac-1f9a-4115-9c27-c1a9ee8ca3f3",
                                "sense_id": "fe6c6901-5efd-3a36-9b29-dcd393857e4e",
                                "text": "„Dieses Plateau, das verhältnismäßig frei war von der unbekömmlichen Flora und Fauna der tiefen, dampfenden Dschungel, bildete dann den Hauptstützpunkt für unsere Erkundungsflüge.“"
                            },
                            {
                                "example_id": "17abb304-3696-47b3-b1a6-93e51cf77f9e",
                                "sense_id": "fe6c6901-5efd-3a36-9b29-dcd393857e4e",
                                "text": "„Fest steht jedenfalls: Iran, dessen ›Achse des Widerstands‹ einen Hauptstützpunkt verloren hat, wird seinen schiitischen Protegé im Libanon nicht ohne Weiteres aufgeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
