                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ce652a-ee73-4432-bae9-3ba8b3445407",
                                "sense_id": "bf95bbd8-992a-301e-a35a-401cc8d22217",
                                "text": "В омы́том не́бе, сия́я все́ми подро́бностями чудо́вищно-сло́жной ле́пки, и́з-за вороно́го о́блака выпра́стывалось о́блако упои́тельной белизны́.",
                                "translation": "Up the rain-washed sky, from behind a raven cloud, a cloud of ravishing whiteness was extricating itself and shining with all the detail of a monstrously complicated molding.",
                                "english": "Up the rain-washed sky, from behind a raven cloud, a cloud of ravishing whiteness was extricating itself and shining with all the detail of a monstrously complicated molding."
                            }
                        ]
                    }
