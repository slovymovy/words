                        "sense_id": "6d1a94c2-4c00-389a-a101-480528048dae",
                        "entry_id": "f4862645-52b7-3516-999c-be6df7425594",
                        "glosses": [
                            "Not reaching orbit; having a trajectory that does not reach orbital velocity and so must return to ground eventually."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "02504bdd-7185-4ce6-a2a4-d20013d2894f",
                                "sense_id": "6d1a94c2-4c00-389a-a101-480528048dae",
                                "text": "The first rocket test was suborbital; it didn't even get off the ground but rather exploded on the launchpad."
                            }
                        ]
                    },
                    {
                        "sense_id": "14579248-31ca-3e94-b554-4880d567fbfd",
                        "entry_id": "f4862645-52b7-3516-999c-be6df7425594",
