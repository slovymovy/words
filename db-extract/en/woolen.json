                                "target_senses": [
                                    {
                                        "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                                        "entry_id": "c3199887-62b7-3219-8f13-9778d09ffa2b",
                                        "glosses": [
                                            "gemaakt van wol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910ff58a-1355-4a1e-b82a-00b2d0f73625",
                                                "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                                                "text": "Hij draagt sinds kort weer wollen sokken."
                                            },
                                            {
                                                "example_id": "ccc51731-bbb8-4992-9beb-25bcce60120f",
                                                "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                                                "text": "Verder zaten er handschoenen, een lange wollen onderbroek, een sneeuwbril en een hele lading pillen in."
                                            },
                                            {
                                                "example_id": "e69ea744-c4a7-4ca6-b66d-db3e19449be7",
                                                "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                                                "text": "Caspar Witsen, met zijn woeste haardos, die slaphangende wollen sjaal om zijn nek en die versleten schoudertas schuin over zijn lichaam, staat op de drempel van de ontvangkamer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "716c3c30-9d87-4d43-bac6-2cccd10dd482",
                        "source_entry_id": "1d7822e7-1cbc-3cc1-aedd-814a46d3b406",
