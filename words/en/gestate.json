{
    "word_family": [
        "gestation",
        "gestational"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d59bab40-60cf-3e54-b0db-6041221372bd",
                    "sense_definition": "To carry young in the womb from conception until birth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Female elephants <w>gestate</w> their calves for nearly two years before giving birth.",
                            "target_lang_translations": {
                                "ru": "Самки слонов <w>вынашивают</w> детенышей почти два года перед тем, как родить."
                            }
                        },
                        {
                            "text": "The scientist tracked how long the mice would <w>gestate</w> under different laboratory conditions.",
                            "target_lang_translations": {
                                "ru": "Ученый наблюдал, как долго мыши будут <w>вынашивать потомство</w> в различных лабораторных условиях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gestate offspring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вынашивать потомство в утробе от зачатия до рождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынашивать",
                                "target_lang_sense_clarification": "плод, потомство"
                            },
                            {
                                "target_lang_word": "находиться в утробном периоде",
                                "target_lang_sense_clarification": "о развитии эмбриона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f64ba1c-7310-310c-a9f0-eaa6ca57f801",
                    "sense_definition": "To slowly develop and take form in the mind over time, such as an idea, plan, or project.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director let the concept for the new movie <w>gestate</w> for several months before writing the script.",
                            "target_lang_translations": {
                                "ru": "Режиссер позволил концепции нового фильма <w>вызревать</w> в течение нескольких месяцев, прежде чем сесть за сценарий."
                            }
                        },
                        {
                            "text": "A brilliant breakthrough often needs time to <w>gestate</w> in the back of the mind.",
                            "target_lang_translations": {
                                "ru": "Блестящему прорыву часто требуется время, чтобы <w>созреть</w> на задворках сознания."
                            }
                        }
                    ],
                    "synonyms": [
                        "develop",
                        "incubate",
                        "mature"
                    ],
                    "common_phrases": [
                        "gestate an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно формироваться, развиваться и созревать в сознании (об идее, плане, замысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызревать",
                                "target_lang_sense_clarification": "об идее, плане"
                            },
                            {
                                "target_lang_word": "вынашивать",
                                "target_lang_sense_clarification": "замысел, проект в уме"
                            },
                            {
                                "target_lang_word": "зреть",
                                "target_lang_sense_clarification": "постепенно развиваться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}