                "senses": [
                    {
                        "sense_id": "9b1b8474-9050-30f2-a723-d3cb16e2cb93",
                        "entry_id": "38e17e93-f82d-3f84-9f6f-52d53840c4c4",
                        "glosses": [
                            "Fenster, das zum Öffnen oder Schließen gekippt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ff67c2a-5faf-4ae0-b87f-92c456c78614",
                                "sense_id": "9b1b8474-9050-30f2-a723-d3cb16e2cb93",
                                "text": "„Das Haus auf dem Mallendarer Berg kriegte ein Garagentor, und im oberen Bad setzte Papa ein Kippfenster ein.“"
                            },
                            {
                                "example_id": "a070781c-dc4d-4f8c-a7b4-579ae2d589d8",
                                "sense_id": "9b1b8474-9050-30f2-a723-d3cb16e2cb93",
                                "text": "„Die früher gehaltene Katze hatte sich kurz nach dem Umzug in das noch nicht fertiggestellte Haus in einem Kippfenster zu Tode gequetscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
