                "senses": [
                    {
                        "sense_id": "e8f52f96-2bdd-3881-ad64-05f850e4fa7e",
                        "entry_id": "d4fba194-782b-3b45-9169-040143be5981",
                        "glosses": [
                            "systematisches Üben zum Aufbau einer Verkehrskompetenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8efe6be4-811a-4775-92af-b26fdcbf09b7",
                                "sense_id": "e8f52f96-2bdd-3881-ad64-05f850e4fa7e",
                                "text": "„Es würde daher bedeuten, ein Gebäude auf Sand zu errichten, wollte der Erzieher versuchen, den Spielbereich vorschnell zu verlassen, um stattdessen ein Verkehrstraining im kindfremden Realbereich des Verkehrs zu betreiben.“"
                            },
                            {
                                "example_id": "b26b037b-5f4d-4adf-a223-8bca47d97131",
                                "sense_id": "e8f52f96-2bdd-3881-ad64-05f850e4fa7e",
                                "text": "„Ein Verkehrstraining an der Verkehrsschule im Meesenring soll die Jüngsten in die Geheimnisse und Gefahren im Straßenverkehr einweisen.“"
                            },
                            {
                                "example_id": "8268fddc-e522-49b2-8f2b-f38be6b80c9a",
                                "sense_id": "e8f52f96-2bdd-3881-ad64-05f850e4fa7e",
                                "text": "„Die Jugendverkehrsschule Mannheim bietet wieder ihr beliebtes Verkehrstraining für ältere Kraftfahrer an.“"
                            },
                            {
                                "example_id": "f5387f2e-5f52-453a-97db-6e395f67b8f2",
                                "sense_id": "e8f52f96-2bdd-3881-ad64-05f850e4fa7e",
                                "text": "„Für Mobilitätstraining gibt es eine Vielzahl von weiteren Bezeichnungen, wie zum Beispiel Verkehrstraining, Verkehrserziehung oder Mobilitätserziehung.“"
                            },
                            {
                                "example_id": "cba6e6e1-718f-409d-8c81-4ab7206b4bf2",
                                "sense_id": "e8f52f96-2bdd-3881-ad64-05f850e4fa7e",
                                "text": "„Vier Tage lang hatten sie sich jeden Tag gesehen, natürlich war Carlotta bewusst, dass weder der Zufall noch Tullios Begeisterung fürs Verkehrstraining der i-Dötzchen, gesunde Ernährung im Rentenalter oder eine Teeager-Disco die wahren Auslöser für diese Begegnungen in der Pfarrei waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
