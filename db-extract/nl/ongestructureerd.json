                "senses": [
                    {
                        "sense_id": "64304768-b85e-34d0-a89e-64e2ccf2fd17",
                        "entry_id": "8837d9e5-4c44-30f0-8089-dfbcf7eac571",
                        "glosses": [
                            "zonder organisatie of planning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b22480f8-a71e-4b5c-9fa3-31d7acbd559c",
                                "sense_id": "64304768-b85e-34d0-a89e-64e2ccf2fd17",
                                "text": "De tekst zou in het begin voor het publiek willekeurig, ongestructureerd lijken, maar stukje bij beetje zouden de toeschouwers (hopelijk) begrijpen met hoeveel precisie Gorza de replieken had geschreven en hoe ingenieus die op elkaar inwerkten."
                            },
                            {
                                "example_id": "c0aeca5d-eea1-4529-99c4-a98a376560ee",
                                "sense_id": "64304768-b85e-34d0-a89e-64e2ccf2fd17",
                                "text": "De inspecties onderzochten het treinongeluk in Amsterdam. Daarbij vielen in april ruim honderd gewonden en een dode. De registratie van slachtoffers en de verdeling over de ziekenhuizen was geïmproviseerd en ongestructureerd, concluderen de onderzoekers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "351b7371-11ca-4f50-8763-9b4acff4088a",
                        "source_entry_id": "8837d9e5-4c44-30f0-8089-dfbcf7eac571",
                        "source_sense_id": "64304768-b85e-34d0-a89e-64e2ccf2fd17",
                        "source_sense_description": "zonder organisatie of planning",
                        "target_lang_word": "unstructured",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unstructured",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abfcf83b-d77b-3c46-8d32-85e577dd0687",
                                        "entry_id": "ba9ad077-8c54-3b9c-bc6b-26dd75fd922b",
                                        "glosses": [
                                            "Lacking structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3839574a-dad1-4b79-a5de-ef4a7c272cde",
                                                "sense_id": "abfcf83b-d77b-3c46-8d32-85e577dd0687",
                                                "text": "His unstructured method of planning scared anyone who had to depend on his schedules."
                                            },
                                            {
                                                "example_id": "719399ba-2ed6-4cb6-90db-8cdf28e0fd82",
                                                "sense_id": "abfcf83b-d77b-3c46-8d32-85e577dd0687",
                                                "text": "Since the day after the 2018 midterm elections, President Donald Trump has spent around 60% of his scheduled time in unstructured “executive time,” Axios reported Sunday."
                                            },
                                            {
                                                "example_id": "2eefff89-1acd-498c-91e4-8fa9d42e1c3a",
                                                "sense_id": "abfcf83b-d77b-3c46-8d32-85e577dd0687",
                                                "text": "Dr. Jessie Voigts, a homeschooler and founder of Wandering Educators, a global community of educators sharing travel experiences, said it doesn’t matter if this time is structured or unstructured, so long as the kids get outside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
