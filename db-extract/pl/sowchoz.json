                        "target_lang_word": "sovkhoz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sovkhoz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ad4f0ca-fc6c-394e-a49d-a98d3355489e",
                                        "entry_id": "0302c8f5-1db4-3f38-9986-8bb0fd01f84b",
                                        "glosses": [
                                            "Variante orthographique de sovkhoze."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d846268-03de-4a39-b48e-33e64f476554",
                                                "sense_id": "0ad4f0ca-fc6c-394e-a49d-a98d3355489e",
                                                "text": "Pour vaincre la force d’inertie inhérente à toute paysannerie traditionnelle, l’État soviétique a eu recours à deux institutions : celle des sovkhoz ou fermes d’Etat, et celle des stations de machines et tracteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f37a3e37-31e4-43eb-bca4-e485ef220f64",
