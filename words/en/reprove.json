{
    "word_family": [
        "reproof",
        "reproval"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40c196db-31e2-3eeb-9fed-5ccec5d323ff",
                    "sense_definition": "To criticize or rebuke someone, often in a gentle or kind manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher had to <w>reprove</w> the student for talking during the quiet reading time.",
                            "target_lang_translations": {
                                "nl": "De leraar moest de leerling <w>berispen</w> omdat hij praatte tijdens het stillezen."
                            }
                        },
                        {
                            "text": "She felt the need to <w>reprove</w> his behavior gently so he would understand his mistake.",
                            "target_lang_translations": {
                                "nl": "Ze voelde de behoefte om zijn gedrag zachtjes te <w>vermanen</w>, zodat hij zijn fout zou begrijpen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebuke",
                        "reprimand",
                        "admonish",
                        "chide"
                    ],
                    "antonyms": [
                        "praise",
                        "commend"
                    ],
                    "common_phrases": [
                        "gently reprove"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand bekritiseren of berispen, vaak op een zachte of vriendelijke manier."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "berispen",
                                "target_lang_sense_clarification": "iemand formeel of streng aanspreken op gedrag"
                            },
                            {
                                "target_lang_word": "bestraffen",
                                "target_lang_sense_clarification": "iemand corrigeren voor een fout"
                            },
                            {
                                "target_lang_word": "vermanen",
                                "target_lang_sense_clarification": "iemand op een vermanende, vaak zachte toon wijzen op een fout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a63f687f-6e6c-3b80-a7ec-eabacaffd230",
                    "sense_definition": "To express disapproval of an action or behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee met to <w>reprove</w> the recent changes to the company policy.",
                            "target_lang_translations": {
                                "nl": "De commissie kwam bijeen om de recente wijzigingen in het bedrijfsbeleid te <w>bekritiseren</w>."
                            }
                        },
                        {
                            "text": "It is difficult to <w>reprove</w> such a bold decision without knowing all the facts.",
                            "target_lang_translations": {
                                "nl": "Het is moeilijk om zo'n gedurfde beslissing te <w>afkeuren</w> zonder alle feiten te kennen."
                            }
                        }
                    ],
                    "synonyms": [
                        "condemn",
                        "criticize"
                    ],
                    "antonyms": [
                        "approve",
                        "endorse"
                    ],
                    "target_lang_definitions": {
                        "nl": "Afkeuring uitspreken over een actie of gedrag."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afkeuren",
                                "target_lang_sense_clarification": "laten weten dat men het niet eens is met een handeling"
                            },
                            {
                                "target_lang_word": "bekritiseren",
                                "target_lang_sense_clarification": "kritiek uiten op een besluit of beleid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6ad5a8c-b6d9-3ade-b2ee-b8ef97f6ddfa",
                    "sense_definition": "To deny, reject, or suppress a feeling or behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>reprove</w> his sudden urge to leave the party early.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde zijn plotselinge drang om het feest vroeg te verlaten te <w>onderdrukken</w>."
                            }
                        },
                        {
                            "text": "She struggled to <w>reprove</w> the feeling of jealousy that arose during the conversation.",
                            "target_lang_translations": {
                                "nl": "Ze had moeite om het gevoel van jaloezie dat tijdens het gesprek opkwam te <w>onderdrukken</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppress",
                        "reject",
                        "deny"
                    ],
                    "antonyms": [
                        "accept",
                        "embrace"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het ontkennen, verwerpen of onderdrukken van een gevoel of gedrag."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onderdrukken",
                                "target_lang_sense_clarification": "een gevoel of impuls proberen te beheersen"
                            },
                            {
                                "target_lang_word": "verwerpen",
                                "target_lang_sense_clarification": "iets niet accepteren of afwijzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec953b97-b34f-3fe3-bf33-09c3ef24b62a",
                    "sense_definition": "To prove something again.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist had to <w>reprove</w> the theory to ensure the results were accurate.",
                            "target_lang_translations": {
                                "nl": "De wetenschapper moest de theorie <w>opnieuw bewijzen</w> om er zeker van te zijn dat de resultaten accuraat waren."
                            }
                        },
                        {
                            "text": "Researchers often <w>reprove</w> existing mathematical theorems to simplify their proofs.",
                            "target_lang_translations": {
                                "nl": "Onderzoekers <w>bewijzen</w> bestaande wiskundige stellingen vaak <w>opnieuw</w> om hun bewijsvoering te vereenvoudigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "reverify",
                        "reconfirm"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets opnieuw bewijzen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opnieuw bewijzen",
                                "target_lang_sense_clarification": "een bewijsvoering herhalen"
                            },
                            {
                                "target_lang_word": "herbevestigen",
                                "target_lang_sense_clarification": "de juistheid van iets opnieuw vaststellen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}