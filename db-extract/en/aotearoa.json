                "senses": [
                    {
                        "sense_id": "c9bc1c65-6860-3573-b0e3-089a73b20521",
                        "entry_id": "8b3642ca-9295-3990-9608-b1a4132b7ca0",
                        "glosses": [
                            "The North Island of New Zealand."
                        ],
                        "tags": [
                            "New-Zealand",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "189eaed9-a763-43b8-a1eb-cbebb44c6867",
                                "sense_id": "c9bc1c65-6860-3573-b0e3-089a73b20521",
                                "text": "he found in the sea this island Aotearoa (the northern island of New Zealand), and he thought he would land there."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa41325b-52f6-35f5-ac42-2b0e73023272",
                        "entry_id": "8b3642ca-9295-3990-9608-b1a4132b7ca0",
                        "glosses": [
                            "New Zealand, a country in Oceania; the Māori name, used especially in a Polynesian or precolonial context."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "7753e151-7416-415b-9203-d6522e1ea12a",
                                "sense_id": "aa41325b-52f6-35f5-ac42-2b0e73023272",
                                "text": "There then arose a triangle of settlement across the vast Pacific, which had as its points Hawai‘i, Rapa Nui and Aotearoa."
                            },
                            {
                                "example_id": "37a7defb-2c86-4d79-8177-069f486d4038",
                                "sense_id": "aa41325b-52f6-35f5-ac42-2b0e73023272",
                                "text": "Aotearoa / rugged individual / glistens like a pearl at the bottom of the world [...]."
                            },
                            {
                                "example_id": "507d5c92-9598-4ed0-8ef2-5919e3951631",
                                "sense_id": "aa41325b-52f6-35f5-ac42-2b0e73023272",
                                "text": "The Maori in Aotearoa (the pair of major islands which Europeans have known as New Zealand) were part of the same oceanic culture."
                            },
                            {
                                "example_id": "122b623b-bed9-49a3-8663-4b1dcb0fbbe9",
                                "sense_id": "aa41325b-52f6-35f5-ac42-2b0e73023272",
                                "text": "You were a professor at the University of Hawai'i at Hilo and I know you went to Aotearoa to have some time there and gain some experiences."
                            },
                            {
                                "example_id": "002f1a0d-34ad-493b-8fc3-a85762732466",
                                "sense_id": "aa41325b-52f6-35f5-ac42-2b0e73023272",
                                "text": "\"We set a target for ourselves, Aotearoa, you've done it, but let's keep going,\" Ardern said, using a Maori name for New Zealand at a vaccination site, according to the Newshub news service."
                            }
                        ]
                    }
