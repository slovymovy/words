                "senses": [
                    {
                        "sense_id": "2f1eb24b-bccb-35e2-969c-9a94368a2e47",
                        "entry_id": "8425df49-d310-30cb-a2ee-dae898718c8e",
                        "glosses": [
                            "предмет, выставляемый для обозрения в музее или на выставке"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "11d8c6bb-74dd-36aa-a8b8-a36fc2d6bef0",
                        "entry_id": "8425df49-d310-30cb-a2ee-dae898718c8e",
                        "glosses": [
                            "перен., разг., груб. () пожилой человек, старик"
                        ],
                        "tags": [
                            "часто шутл."
                        ],
