                "senses": [
                    {
                        "sense_id": "eb889d68-3a08-3fbf-97bf-f81f1d07fcce",
                        "entry_id": "d45f0d43-5597-3f5c-aec4-7650f352e29d",
                        "glosses": [
                            "Administrer un anxiolytique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce45ca94-fd14-41a1-9dcf-5578ea53d9eb",
                                "sense_id": "eb889d68-3a08-3fbf-97bf-f81f1d07fcce",
                                "text": "Et pour commencer vous allez me prendre une petite semaine d'arrêt maladie avec un gentil cocktail pour dormir et s'anxiolytiser."
                            },
                            {
                                "example_id": "1172d3e4-4340-46d1-bdce-2661c9eaf12b",
                                "sense_id": "eb889d68-3a08-3fbf-97bf-f81f1d07fcce",
                                "text": "Mais on parvient tout de même à s'épuiser, on se stresse, on s'antalgise pour oublier, on s'anxiolytise pour tenir, on s'alcoolise sans raison, on se surmène, mais dans le fond c’est ce qu’on voulait."
                            }
                        ]
                    },
                    {
                        "sense_id": "6da3e3db-c9bf-3b90-af41-7f5925776e15",
                        "entry_id": "d45f0d43-5597-3f5c-aec4-7650f352e29d",
                        "glosses": [
                            "Avoir un effet anxiolytique sur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22713a72-afde-4716-af3a-bf73940e7be2",
                                "sense_id": "6da3e3db-c9bf-3b90-af41-7f5925776e15",
                                "text": "La poésie m'anxiolytise."
                            }
                        ]
                    }
