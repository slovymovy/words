                    {
                        "sense_id": "8ed8e626-4b82-3b5c-b3aa-35e4e8a17cad",
                        "entry_id": "33457788-32ba-3118-8113-ab5de5a76fc0",
                        "glosses": [
                            "Vorschrift, die besagt, dass sich niemand in öffentlichen Räumen verschleiern darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61e996a-ff6b-401f-96a0-4cd02abb1ef4",
                                "sense_id": "8ed8e626-4b82-3b5c-b3aa-35e4e8a17cad",
                                "text": "Er ist gegen den Bau von Minaretten an europäischen Moscheen, begrüßt das belgische Verschleierungsverbot und schlägt um Mullahs und Imame einen großen Bogen."
                            },
                            {
                                "example_id": "220b896a-f483-4095-b8fc-5981944ee917",
                                "sense_id": "8ed8e626-4b82-3b5c-b3aa-35e4e8a17cad",
                                "text": "Selbst der Staatsrat empfahl im März, das Verschleierungsverbot auf bestimmte Orte und auf bestimmte Behördengänge zu beschränken."
                            }
                        ],
