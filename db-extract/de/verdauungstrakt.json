                ],
                "senses": [
                    {
                        "sense_id": "0fc1b3ef-d2b2-3ad7-9299-4afe86943732",
                        "entry_id": "5d5cffa5-c4fd-3c8e-9454-fe8a7a0c2248",
                        "glosses": [
                            "das Organsystem zur Aufnahme, der Verdauung und der Ausscheidung der Nahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3424f7-8ba9-40f9-90ca-7cb699e97f93",
                                "sense_id": "0fc1b3ef-d2b2-3ad7-9299-4afe86943732",
                                "text": "Der Verdauungstrakt besteht aus den Mundwerkzeugen, der Mundhöhle (Kopfteil), der Speiseröhre, dem Magen und dem Darm (Rumpfteil)."
                            },
                            {
                                "example_id": "bf9e8e00-0024-4aa7-9e30-067ea4a0d6d1",
                                "sense_id": "0fc1b3ef-d2b2-3ad7-9299-4afe86943732",
                                "text": "„Ich hatte keine Ahnung, wie wir vom Verdauungstrakt von Kühen hierher gekommen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d053e95-b489-42cd-bc7c-9b6871b64e9a",
                        "source_entry_id": "5d5cffa5-c4fd-3c8e-9454-fe8a7a0c2248",
                        "source_sense_id": "0fc1b3ef-d2b2-3ad7-9299-4afe86943732",
                        "source_sense_description": "Verdauungssystem",
                        "target_lang_word": "digestive system",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digestive system",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e499cf82-16fe-351e-ab94-7eb84b686d42",
                                        "entry_id": "1fdbdd4e-bc90-3fed-8b5b-5a10f9d0dee6",
                                        "glosses": [
                                            "A system of organs for the purpose of digesting food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a098a0-c8fb-4c5a-9f16-0128e7455498",
                                                "sense_id": "e499cf82-16fe-351e-ab94-7eb84b686d42",
                                                "text": "All the food that you eat goes through your digestive system and is digested."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f3218a0-9e6f-4e3a-8579-d0d9efd07d08",
                        "source_entry_id": "5d5cffa5-c4fd-3c8e-9454-fe8a7a0c2248",
                        "source_sense_id": "0fc1b3ef-d2b2-3ad7-9299-4afe86943732",
                        "source_sense_description": "Verdauungssystem",
                        "target_lang_word": "tractus digestif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7963d361-450e-4967-a0b4-f40c067ba97b",
                        "source_entry_id": "5d5cffa5-c4fd-3c8e-9454-fe8a7a0c2248",
                        "source_sense_id": "0fc1b3ef-d2b2-3ad7-9299-4afe86943732",
                        "source_sense_description": "Verdauungssystem",
                        "target_lang_word": "appareil digestif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appareil digestif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85503407-a859-3e0e-9e82-e5fa793a100f",
                                        "entry_id": "08a56a4b-d60b-3ddc-b6d5-adf3bf1468a4",
                                        "glosses": [
                                            "Ensemble d’organes de natures diverses formant un appareil permettant la prise de nourriture, sa digestion, l’absorption des nutriments et l’élimination des déchets, chez les animaux pourvus d’un tube digestif, incluant le tube digestif proprement dit et ses glandes annexes (foie, pancréas, glandes salivaires)."
                                        ],
                                        "tags": [
                                            "Gastro-entérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69789c94-9a03-4c6a-aa6f-cdd8381a346d",
                                                "sense_id": "85503407-a859-3e0e-9e82-e5fa793a100f",
                                                "text": "L’appareil digestif se présente sous forme d'un long tube plus ou moins contourné, le tube digestif, qui s'étend de la bouche à l'anus (…). Il se divise en 5 segments principaux morphologiquement et histologiquement différenciés, et fonctionnellement spécialisés : […]."
                                            },
                                            {
                                                "example_id": "e3844fd8-70a7-425d-9803-9e196858ad6e",
                                                "sense_id": "85503407-a859-3e0e-9e82-e5fa793a100f",
                                                "text": "Son injection induit une bonne immunité générale qui empêche le virus de passer de l’appareil digestif au système nerveux central."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
