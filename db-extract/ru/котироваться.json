                                "target_senses": [
                                    {
                                        "sense_id": "4efca7d0-c092-33b9-8ef3-cc2f601d61b5",
                                        "entry_id": "b960f3db-97ea-32c6-a850-fa595b66ef9e",
                                        "glosses": [
                                            "ein Wertpapier zum amtlichen Handel an der Börse zulassen und in das amtliche Kursblatt aufnehmen"
                                        ],
                                        "tags": [
                                            "finance",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e891a09d-2216-4eee-b5e5-8e17031d8018",
                                                "sense_id": "4efca7d0-c092-33b9-8ef3-cc2f601d61b5",
                                                "text": "Die Aktien sind an der SWX Swiss Exchange sowie am Prime Standard Segment (TecDAX) in Frankfurt kotiert."
                                            },
                                            {
                                                "example_id": "85257531-6783-4e82-a9bf-a0a7d78dc61c",
                                                "sense_id": "4efca7d0-c092-33b9-8ef3-cc2f601d61b5",
                                                "text": "Der Gabelstapler-Hersteller Kion Group kündigte am Montag an, Aktien im regulierten Markt der Frankfurter Wertpapierbörse kotieren zu lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e046c043-03f2-3f4b-a430-286b67a7ad68",
                                        "entry_id": "b960f3db-97ea-32c6-a850-fa595b66ef9e",
                                        "glosses": [
                                            "Punkte kartieren, deren Höhen im Gelände bestimmt wurden"
                                        ],
                                        "tags": [
                                            "geography",
                                            "outdated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
