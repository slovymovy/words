                ],
                "translations": [
                    {
                        "translation_id": "37514faf-3daa-47b2-aefb-1c254abbad75",
                        "source_entry_id": "c204a547-acf9-3ad9-ae17-dae92826b0d1",
                        "source_sense_id": "40ce161c-2887-37e1-bfd7-2d8e8c871fa5",
