                        "glosses": [
                            "Donner un caractère rappelant Sénèque à."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6b12a6d2-c6c3-3577-a220-ec56da96a5e7",
                        "entry_id": "e5af4810-6daa-3357-bf14-f0c87fa2745e",
                        "glosses": [
                            "Raisonner à la manière de Sénèque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0698adaa-2e8a-4421-b85c-f0c9f2908d4b",
                                "sense_id": "6b12a6d2-c6c3-3577-a220-ec56da96a5e7",
                                "text": "L’auteur des Essais, dit-il, « sénécise » ; il est stoïcien quand Sénèque est stoïcien, épicurien quand Sénèque est épicurien."
                            },
                            {
                                "example_id": "6090a7da-2e6a-490a-9f4b-5eedd2fc10ca",
                                "sense_id": "6b12a6d2-c6c3-3577-a220-ec56da96a5e7",
                                "text": "Henri III, qui avait dans quelque mesure sénécisé comme « protecteur » de l’Académie, n’eut-il pas aussi commerce avec Sénèque comme inspirateur ou dédicataire de quelque insigne ouvrage ?"
                            }
                        ]
                    }
