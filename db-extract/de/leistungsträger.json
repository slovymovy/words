                        "entry_id": "5b551ae6-a3bd-36c9-9789-f1e5a67ac21c",
                        "glosses": [
                            "Einrichtung, die Sozialleistungen erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ffea16b-b5be-43db-adc3-c9127a29d662",
                                "sense_id": "684a6832-5a36-3153-b7ea-52a337a284d1",
                                "text": "„Eine Leistungsgewährung könne in Ausnahmefällen nur für einen kurzen Zeitraum erfolgen, wenn die Krankenkasse als vorrangiger Leistungsträger dies aus irgendwelchen Gründen ablehne.“"
                            }
                        ],
