                "senses": [
                    {
                        "sense_id": "9ad3f671-f648-3d4b-bb96-dd574860f4dd",
                        "entry_id": "847eecb6-1086-3f23-9ca4-b214e73f8933",
                        "glosses": [
                            "Transformer en granite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7816bf16-9069-4427-9996-0ece8e47863d",
                                "sense_id": "9ad3f671-f648-3d4b-bb96-dd574860f4dd",
                                "text": "De nouveaux faciès migmatiques apparaissent de ce fait, surtout dans les zones où le matériel à granitiser était basique (Kaysersberg)."
                            },
                            {
                                "example_id": "a6f16d6b-695f-4875-96ae-41e758aa32ca",
                                "sense_id": "9ad3f671-f648-3d4b-bb96-dd574860f4dd",
                                "text": "Au cours d'une durée aussi importante, plusieurs chaînes ont largement le temps d'évoluer, de se plisser, de se granitiser et d'être finalement érodées."
                            }
                        ]
                    }
