                "entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                "word": "salonard",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf66c50e-9cca-4b3e-9f1e-903c624c6f30",
                        "entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "salonards"
                    },
                    {
                        "form_id": "78a3ce34-3618-4b8a-a95f-23b7c9fc3d9f",
                        "entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "salonarde"
                    },
                    {
                        "form_id": "19b54712-c22e-4cc8-a53e-fd1bde4a0668",
                        "entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "salonardes"
                    },
                    {
                        "form_id": "b9349fbc-2629-499f-bb9b-7d2b79e9fb07",
                        "entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                        "tags": [],
                        "form": "salonnard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86a15565-9520-304c-bfbd-883fe5dc4886",
                        "entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                        "glosses": [
                            "Relatif aux salons de la bonne société."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0ce3eae6-43de-43be-ad0c-122f49a7f9a4",
                                "sense_id": "86a15565-9520-304c-bfbd-883fe5dc4886",
                                "text": "Je l'avais appelé « philosophe salonard » car je pressentais bien qu'il couperait court au sujet. Qu'en pensez- vous?... Mais « l'autre » coupa court comme ce philosophe salonard : - Cela sera pire encore si nous ne l'appelions pas !"
                            },
                            {
                                "example_id": "e4301cf0-5385-4d31-98d0-31da66b5ce4f",
                                "sense_id": "86a15565-9520-304c-bfbd-883fe5dc4886",
                                "text": "“Tout est fait chez moi pour nourrir au mieux leurs exigences sans en faire des chats de salon.” Ils doivent donc rester naturels sans devenir sauvages, être suffisamment cultivés sans devenir pour autant “salonards”. Là est la ligne de crête sur laquelle se tient Karine."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4624c76-bbf6-3d25-ba83-aed3c22850c3",
                        "entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                        "glosses": [
                            "Qualifie la musique de chambre."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9eee6a0d-956c-4f4a-b1b8-ef166e427d78",
                                "sense_id": "d4624c76-bbf6-3d25-ba83-aed3c22850c3",
                                "text": "Loin des rêveries salonardes dont trop de pianistes en mal de romantisme ont fait leur \"beurre\", Krystian Zimmerman sert son rachmaninov saignant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5087a4b1-534f-4c3b-818c-2ea0d9928978",
                        "source_entry_id": "ba6c1d93-0b6e-37e8-8fd4-9127c235cc3c",
                        "target_lang_word": "snob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A person who wishes to be seen as a member of the upper classes and who looks down on those perceived to have inferior or unrefined tastes."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e4278e-4cf4-4cb5-b0b9-53d04a53adf1",
                                                "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                                "text": "Proceed as a snob climbing the social ladder, namely, know the best people in the neighbourhood, then the best people they know. The end is not that of snobbery, but an eternal treasure."
                                            },
                                            {
                                                "example_id": "7184a856-b022-4099-bb50-2b6c7a56fdb3",
                                                "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                                "text": "Outside of his own set he was considered rather a snob, but as his set was the set, it never worried him."
                                            },
                                            {
                                                "example_id": "f5e1cd33-9948-47c7-ab50-75c2da1e6136",
                                                "sense_id": "040f09ec-1302-3d03-9e69-81a63bc94d12",
                                                "text": "If wanting the best things in life means being a snob then glory hallelujah I'm a snob."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c69bae15-4eed-37d2-9ce7-ca2c97f35f0b",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A cobbler or shoemaker."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7512023-2988-4d0a-b611-bced42f4711e",
                                                "sense_id": "c69bae15-4eed-37d2-9ce7-ca2c97f35f0b",
                                                "text": "The snobs were also kind to him, and gave him a pair of boots which they assured him were of a type and quality reserved entirely for officers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A member of the lower classes; a commoner."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff387c0-e104-45c4-afa9-b5dcfa7c42cd",
                                                "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                                "text": "'D'ye know a slap-up sort of button, when you see it?' said the youth. 'Don't look at mine, if you ain't a judge, because these lions' heads was made for men of taste: not snobs.'"
                                            },
                                            {
                                                "example_id": "3567f307-3734-4eed-be4d-61226d60d920",
                                                "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                                "text": "I like better gin-and-water than claret. I like a sanded floor in Carnaby Market better than a chalked one in Mayfair. I prefer Snobs, I own it."
                                            },
                                            {
                                                "example_id": "250682cf-3544-4e55-ae0d-68260914c83b",
                                                "sense_id": "8363c953-8023-3e1f-a6e3-fb5c9abed3fe",
                                                "text": "I tell you, sir, that I have a brain of my own, and that I should feel myself to be a snob and a slave if I did not use it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa8097f-d9cf-34d3-8e9c-5e103f1f0633",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A workman who works for lower wages than his fellows, especially one who will not join a strike (a scab)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6805bded-0970-3ff6-b509-7052dc3bf768",
                                        "entry_id": "fb5f48bf-be39-386e-b9b0-b1af721f6333",
                                        "glosses": [
                                            "A townsman, as opposed to a gownsman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
