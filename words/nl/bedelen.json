    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec6633a7-6989-3089-b7cd-a1586bdea21b",
                    "sense_definition": "om een aalmoes of geld vragen bij vreemden om in het levensonderhoud te voorzien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "om aalmoezen vragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man zat op de hoek van de straat te <w>bedelen</w> om wat kleingeld.",
                            "target_lang_translations": {
                                "en": "The man was sitting on the street corner <w>begging</w> for some change."
                            }
                        },
                        {
                            "text": "Het is in deze stad verboden om op straat te <w>bedelen</w> voor geld.",
                            "target_lang_translations": {
                                "en": "It is forbidden in this city to <w>beg</w> for money on the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "schooien"
                    ],
                    "common_phrases": [
                        "om geld bedelen",
                        "op straat bedelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To ask strangers for alms or money in order to support oneself."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beg",
                                "target_lang_sense_clarification": "to ask for money or food"
                            },
                            {
                                "target_lang_word": "panhandle",
                                "target_lang_sense_clarification": "to beg in a public place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4d1e5bc-4476-3fa4-8bdc-9985fb6742ae",
                    "sense_definition": "aanhoudend en dringend blijven vragen om iets dat men graag wil hebben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanhoudend vragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind bleef de hele middag <w>bedelen</w> om een ijsje.",
                            "target_lang_translations": {
                                "en": "The child kept <w>begging</w> for an ice cream all afternoon."
                            }
                        },
                        {
                            "text": "Je moet niet zo <w>bedelen</w> om aandacht bij je vrienden.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>beg</w> for attention from your friends like that."
                            }
                        }
                    ],
                    "synonyms": [
                        "smeken"
                    ],
                    "common_phrases": [
                        "om een gunst bedelen",
                        "om aandacht bedelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To persistently and urgently keep asking for something that one strongly desires."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beg",
                                "target_lang_sense_clarification": "to plead or entreat"
                            },
                            {
                                "target_lang_word": "implore",
                                "target_lang_sense_clarification": "to ask desperately"
                            },
                            {
                                "target_lang_word": "pester",
                                "target_lang_sense_clarification": "to annoy by asking repeatedly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e43094b9-717e-3967-be69-05c69b0cef6b",
                    "sense_definition": "het uitspreken van gebeden tot een godheid",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten wordt gesproken over monniken die vroom hun getijden <w>bedelen</w>.",
                            "target_lang_translations": {
                                "en": "Ancient texts speak of monks who piously <w>pray</w> their hours."
                            }
                        },
                        {
                            "text": "Zij <w>bedelden</w> hun gebeden in de vroege ochtendstond.",
                            "target_lang_translations": {
                                "en": "They <w>chanted</w> their prayers in the early morning hours."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vrijwel uitsluitend in historische of religieuze context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The act of reciting prayers to a deity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pray",
                                "target_lang_sense_clarification": "to recite prayers"
                            },
                            {
                                "target_lang_word": "chant",
                                "target_lang_sense_clarification": "to recite in a rhythmic way"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8847eaca-7627-382d-ae0b-863a3458373f",
                    "sense_definition": "een bepaald deel van iets aan iemand toewijzen of schenken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toewijzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De organisatie <w>bedeelde</w> de arme gezinnen met voedselpakketten.",
                            "target_lang_translations": {
                                "en": "The organization <w>provided</w> the poor families with food parcels."
                            }
                        },
                        {
                            "text": "De natuur heeft hem rijkelijk <w>bedeeld</w> met een groot muzikaal talent.",
                            "target_lang_translations": {
                                "en": "Nature has richly <w>endowed</w> him with great musical talent."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met talent bedeeld",
                        "iemand rijkelijk bedelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To assign or grant a specific part of something to someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "endow",
                                "target_lang_sense_clarification": "to provide with a quality or asset"
                            },
                            {
                                "target_lang_word": "bestow",
                                "target_lang_sense_clarification": "to present as a gift or honor"
                            },
                            {
                                "target_lang_word": "allocate",
                                "target_lang_sense_clarification": "to distribute for a purpose"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c899da8-6ffa-3096-9338-5835e97513b3",
                    "sense_definition": "een geheel in verschillende porties of delen verdelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De erfenis werd eerlijk onder de drie broers <w>bedeeld</w>.",
                            "target_lang_translations": {
                                "en": "The inheritance was fairly <w>apportioned</w> among the three brothers."
                            }
                        },
                        {
                            "text": "Men moet de schaarse middelen zorgvuldig <w>bedelen</w> over de bevolking.",
                            "target_lang_translations": {
                                "en": "One must carefully <w>distribute</w> the scarce resources among the population."
                            }
