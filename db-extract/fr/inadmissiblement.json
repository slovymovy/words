                ],
                "translations": [
                    {
                        "translation_id": "21eaa6d5-db3f-4aca-a8a5-496830158680",
                        "source_entry_id": "a004b519-9fb2-398a-86e2-beb1e731f83d",
                        "source_sense_id": "8dcc84b9-c15a-3e72-8f3d-39fd6024dafb",
                        "target_lang_word": "unzulässig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzulässig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e62aef7e-1bd0-3989-892b-af5837bc63b3",
                                        "entry_id": "7dfaaaa3-5864-3ef7-8beb-74478e997640",
                                        "glosses": [
                                            "nicht zulässig, nicht zugelassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a51b46-050f-40bc-b62e-b36229ce9a3f",
                                                "sense_id": "e62aef7e-1bd0-3989-892b-af5837bc63b3",
                                                "text": "Ist es unzulässig, daraus zu zitieren?"
                                            },
                                            {
                                                "example_id": "0fc7f801-4b65-4ef0-b627-b419aa02defe",
                                                "sense_id": "e62aef7e-1bd0-3989-892b-af5837bc63b3",
                                                "text": "„Eine ärztlich gebotene schmerzlindernde Medikation bei einem sterbenden Patienten wird nämlich nicht dadurch unzulässig, dass sie als unbeabsichtigte, aber in Kauf genommene unvermeidbare Nebenfolge den Todeseintritt beschleunigen kann.“"
                                            },
                                            {
                                                "example_id": "c21aa979-66bb-4fef-92c4-2eb90a27505d",
                                                "sense_id": "e62aef7e-1bd0-3989-892b-af5837bc63b3",
                                                "text": "„Das Gericht deutet zwar auch an, dass es einen solchen Vergleich mit den Rechteinhabern nicht per se für unzulässig halte – eine Opt-In-Lösung, bei der die Autoren zustimmten, sei durchaus denkbar.“"
                                            },
                                            {
                                                "example_id": "304ef76d-34b8-4a0c-a2c3-4d0caf5541b3",
                                                "sense_id": "e62aef7e-1bd0-3989-892b-af5837bc63b3",
                                                "text": "„Ich sage nicht, dass die Eurozone zusammenbricht, aber dass immer unzulässigere Maßnahmen getroffen werden, um die Länder in der Eurozone zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "056c4eea-1726-477e-bb21-38d22ff7e78b",
                        "source_entry_id": "a004b519-9fb2-398a-86e2-beb1e731f83d",
                        "source_sense_id": "8dcc84b9-c15a-3e72-8f3d-39fd6024dafb",
                        "target_lang_word": "inadmissibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inadmissibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11b993c5-8113-3e03-94a8-0809ba6cb9a8",
                                        "entry_id": "ab7239a7-8742-374f-bcb7-b0bd12038ae3",
                                        "glosses": [
                                            "In an inadmissible way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af47348e-5d02-4b79-868e-8d11e869efb1",
                                                "sense_id": "11b993c5-8113-3e03-94a8-0809ba6cb9a8",
                                                "text": "Still, it is not clear how far socialists ought to go in \"restricting capitalist acts between consenting adults,\" since doing so seems to impinge, inadmissibly, on individuals' freedoms."
                                            }
                                        ]
                                    }
                                ]
                            }
