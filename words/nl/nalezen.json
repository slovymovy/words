{
    "word_family": [
        "lezen",
        "voorlezen",
        "herlezen",
        "uitlezen",
        "doorlezen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1aa9dec4-4dfe-3f7b-b9d6-61dca1e039f1",
                    "sense_definition": "Een tekst nogmaals lezen om te controleren op fouten of om te zien of men niets over het hoofd heeft gezien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "controleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor de zekerheid heb ik het document toch nog even <w>nagelezen</w>.",
                            "target_lang_translations": {
                                "en": "Just to be sure, I <w>read over</w> the document anyway."
                            }
                        },
                        {
                            "text": "Je moet je eigen e-mail altijd goed <w>nalezen</w> voordat je hem verstuurt.",
                            "target_lang_translations": {
                                "en": "You should always <w>proofread</w> your own email carefully before sending it."
                            }
                        }
                    ],
                    "synonyms": [
                        "controleren",
                        "nakijken",
                        "herlezen"
                    ],
                    "common_phrases": [
                        "een brief nalezen",
                        "een tekst nalezen"
                    ],
                    "target_lang_definitions": {
                        "en": "To read a text again to check for errors or to ensure nothing has been overlooked."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "proofread",
                                "target_lang_sense_clarification": "to read and correct a text"
                            },
                            {
                                "target_lang_word": "check",
                                "target_lang_sense_clarification": "to verify by reading"
                            },
                            {
                                "target_lang_word": "read over",
                                "target_lang_sense_clarification": "to read through to check for mistakes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e9702e8-23bf-30b9-98f8-6d431b61fb09",
                    "sense_definition": "Een tekst grondig doorlezen op zoek naar specifieke informatie of details.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "controleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>las</w> het hele stuk <w>na</w> op spel- en stijlfouten maar hij kon niets ontdekken.",
                            "target_lang_translations": {
                                "en": "He <w>checked</w> the entire piece for spelling and style errors, but he couldn't find anything."
                            }
                        },
                        {
                            "text": "Stap voor stap kon ik <w>nalezen</w> hoe zij haar Amerikaanse visum had geregeld.",
                            "target_lang_translations": {
                                "en": "Step by step, I could <w>read</w> how she had arranged her American visa."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorlezen",
                        "bestuderen"
                    ],
                    "common_phrases": [
                        "op fouten nalezen"
                    ],
                    "target_lang_definitions": {
                        "en": "To read a text thoroughly in search of specific information or details."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "read through",
                                "target_lang_sense_clarification": "to read carefully from start to finish"
                            },
                            {
                                "target_lang_word": "look up",
                                "target_lang_sense_clarification": "to search for information in a text"
                            },
                            {
                                "target_lang_word": "consult",
                                "target_lang_sense_clarification": "to refer to a text for information"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}