                    "frequency": "High",
                    "semantic_group_id": "jouet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la fête d'anniversaire, nous avons gonflé des dizaines de <w>ballons</w> de toutes les couleurs."
                        },
                        {
                            "text": "La petite fille pleure car son <w>ballon</w> rouge s'est envolé dans le ciel."
                        }
