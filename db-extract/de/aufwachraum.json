                "senses": [
                    {
                        "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                        "entry_id": "9bd729a3-b132-3328-8c13-3c0279acff9b",
                        "glosses": [
                            "Raum, in dem man nach einer Operation mit einer Sedierung oder Vollnarkose unter Beobachtung aufwacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d4ee4f-c15e-4f43-95a5-2cba1cdb6850",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "„Ann-Kathrin Jäger arbeitet als Krankenschwester […] im Aufwachraum und überwacht die Patientientinnen und Patienten nach der Narkose.“"
                            },
                            {
                                "example_id": "ab2bcc8c-efbd-4651-ac42-9cb85de2910f",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "Während der Coronapandemie wurden Aufwachräume zu Intensivstationen mit Beatmungsgeräten umgewidmet, um genügend Kapazitäten für die vielen Patienten zu haben."
                            },
                            {
                                "example_id": "c6acf029-34a9-46fb-a155-78b917bfd479",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "In diesem Krankenhaus ist im Aufwachraum Platz für acht Betten."
                            },
                            {
                                "example_id": "6c70afcc-b309-4eb4-b956-6cb5eee957c2",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "Im Aufwachraum geht es normalerweise sehr ruhig zu."
                            },
                            {
                                "example_id": "5a1f3306-2c69-4744-9acc-66cda1aa195b",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "[Coronapandemie:] „Tritt der Katastrophenfall ein, so können zusätzliche fünf weitere Betten im Aufwachraum der Operationsabteilung betrieben werden.“"
                            },
                            {
                                "example_id": "0b0e5b33-00c0-4e39-94ff-d37f3b66cb4f",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "[Werdende Väter während der Coronapandemie:] „Im Fall eines Kaiserschnitts steht die Begleitperson allerdings auch dann außen vor: Sie hat weder Zutritt zum OP, noch zum Aufwachraum.“"
                            },
                            {
                                "example_id": "32f3ff5a-5453-4c86-b251-4e515f550030",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "„«Im Aufwachraum sagte man mir, dass das Kreuzband vollständig gerissen ist», erzählt Murisier im Spitalbett.“"
                            },
                            {
                                "example_id": "c95bbecf-baaa-410e-b8ac-6a68ba671850",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "„Wird ein Sauerstoffmangel nach einer Vollnarkose im Aufwachraum nicht erkannt, können Hirnschädigungen die Folge sein.“"
                            },
                            {
                                "example_id": "f850db18-b454-4ecd-b3b4-c3832c0ef18c",
                                "sense_id": "76aa2412-4e66-3a82-aa11-55ac80630577",
                                "text": "„[…] rund 30 Prozent der Patienten, die im Aufwachraum im Krankenhaus nach einer Operation zu sich kommen, geht es erst mal richtig schlecht: Viele leiden an Übelkeit, müssen sich übergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
