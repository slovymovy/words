                    {
                        "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                        "entry_id": "90ee0de8-51db-3d2f-afd5-4a637bba326c",
                        "glosses": [
                            "Mauvais temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d71ba3-905c-4ceb-846b-b5faa8637b55",
                                "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                                "text": "Si les grains ont souffert de l’intempérie des saisons, il faudra recourir au criblage qui produit ordinairement un pour cent de déchet, lequel sera vendu au profit de la République."
                            },
                            {
                                "example_id": "1f1d9a0a-14db-48e6-9e57-c05481476221",
                                "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                                "text": "Cette couverture, tordue par les intempéries du climat parisien, s’avançait de trois pieds sur la rue."
                            },
                            {
                                "example_id": "0e5ea1d0-dda1-47fe-a859-97566656869e",
                                "sense_id": "bd6c820b-15f2-30de-adec-eb3387e3be33",
                                "text": "Les intempéries meurtrières des Alpes-Maritimes avaient été classées orange, mais pas rouge. C’est quoi l’alerte rouge ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0f7c560-c9fe-36db-9d4d-c51ccff6056c",
                        "entry_id": "90ee0de8-51db-3d2f-afd5-4a637bba326c",
                        "glosses": [
                            "Mauvaise constitution des humeurs du corps."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ebf0b6e9-b7d4-4502-ab14-b7c6bbcaccb6",
                                "sense_id": "a0f7c560-c9fe-36db-9d4d-c51ccff6056c",
                                "text": "Ce qui marque une intempérie dans le parenchyme splénique, c’est-à-dire la rate."
                            }
                        ]
                    }
