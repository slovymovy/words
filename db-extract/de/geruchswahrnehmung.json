                ],
                "senses": [
                    {
                        "sense_id": "27dd29a1-5fd3-3bbf-90cb-5ee692236dcc",
                        "entry_id": "50841ff1-ae85-3ea4-88d3-c043fb452fe5",
                        "glosses": [
                            "Aufnahme und Verarbeitung physikalischer Reize durch das Sinnesorgan; Geruchssinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aef031d-8232-4ef6-b23a-ee6754c7b003",
                                "sense_id": "27dd29a1-5fd3-3bbf-90cb-5ee692236dcc",
                                "text": "„Zunächst erfolgt die Geruchswahrnehmung über die Cilien (Flimmerhärchen), die in gebündelter Form zu jeweils sechs oder acht Härchen auf einer Zelle der Riechschleimhaut sitzen.“"
                            },
                            {
                                "example_id": "e47132ce-b462-4a49-b248-ce71883d30bc",
                                "sense_id": "27dd29a1-5fd3-3bbf-90cb-5ee692236dcc",
                                "text": "„Die Geruchswahrnehmung ist einer der ältesten unserer Sinne, aber in ihrer Funktionsweise immer noch kaum verstanden.“"
                            },
                            {
                                "example_id": "cd3753c2-6252-4da6-8436-031d3448c62d",
                                "sense_id": "27dd29a1-5fd3-3bbf-90cb-5ee692236dcc",
                                "text": "„Denn die Forscher sind sich sicher, dass das Wissen um die Entwicklung der frühkindlichen Geruchswahrnehmung nicht nur die Ernährung von Kleinkindern verbessern könnte, sondern auch dazu beiträgt, die Entstehung ernährungsbedingter Krankheiten zu verstehen.“"
                            },
                            {
                                "example_id": "e4753933-52b7-4b29-aa0b-3f0bd1642934",
                                "sense_id": "27dd29a1-5fd3-3bbf-90cb-5ee692236dcc",
                                "text": "„Dennoch dauerte es bis in die 50er-Jahre des 20. Jahrhunderts, bis die gründliche Erforschung der Geruchswahrnehmung der Insekten begann.“"
                            },
                            {
                                "example_id": "65a90d79-e3e6-4102-9d24-9aae8ca45289",
                                "sense_id": "27dd29a1-5fd3-3bbf-90cb-5ee692236dcc",
                                "text": "„Bei sinunasalen Riechstörungen wird die eingeatmete Luft auf ihrem Weg zur Riechschleimhaut behindert - damit können Duftstoffe auch keine Geruchswahrnehmung auslösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
