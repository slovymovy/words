                    },
                    {
                        "sense_id": "a3fef719-dcf7-33ee-b1ee-633ffdbfb3d8",
                        "entry_id": "4a3da673-cf1d-3dc8-b8e1-281282a0f619",
                        "glosses": [
                            "zob. świt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4287b6e6-8d85-47eb-9e65-cd1e4d071fe7",
                                "sense_id": "a3fef719-dcf7-33ee-b1ee-633ffdbfb3d8",
                                "text": "Miłość wasza podobna do chmur na świtaniu • albo do rosy, która prędko znika."
                            },
                            {
                                "example_id": "c8f1eb36-da77-4d7b-b2b9-3929ead9dcaf",
                                "sense_id": "a3fef719-dcf7-33ee-b1ee-633ffdbfb3d8",
                                "text": "I wszedł na górę, łamał chleb i spożywał, a mówił jeszcze długo, bo aż do świtania."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
