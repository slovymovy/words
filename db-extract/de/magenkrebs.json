                "senses": [
                    {
                        "sense_id": "fb20c392-f213-3020-a188-5fef79a240cd",
                        "entry_id": "9cefbf71-d076-3ddc-a436-85757f06b2c6",
                        "glosses": [
                            "bösartige Tumorerkrankung des Magens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f7eeeff-35fd-4f73-b819-e996b637e00a",
                                "sense_id": "fb20c392-f213-3020-a188-5fef79a240cd",
                                "text": "„Er starb 1928 am Magenkrebs; Morphium und Veronal waren die Nothelfer, die ihm auf seinem schweren Weg aus dem Leben ein wenig Linderung verschafften.“"
                            },
                            {
                                "example_id": "58ed095b-d058-4a7d-b39e-f5340c423a0d",
                                "sense_id": "fb20c392-f213-3020-a188-5fef79a240cd",
                                "text": "„Letztlich ist mein Vater an Magenkrebs gestorben.“"
                            },
                            {
                                "example_id": "bced5829-0189-49c8-bd34-e66a91a38ab7",
                                "sense_id": "fb20c392-f213-3020-a188-5fef79a240cd",
                                "text": "„Seit ihr Mann Vassili vor 30 Jahren an Magenkrebs gestorben ist, trägt sie fast nur noch schwarz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
