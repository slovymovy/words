                    {
                        "translation_id": "798c8f10-b079-4ede-96c3-f908d8d49d0b",
                        "source_entry_id": "58d89583-ae72-3371-b665-0e4323ca8d79",
                        "source_sense_id": "d94ecc07-b6ed-3f42-b0d2-ceb0cd843e3d",
                        "target_lang_word": "megafauna",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megafauna",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "a4477c5d-3e9d-33df-b9b7-c037c0cf2db9",
                                        "entry_id": "8dd7e457-e4e0-3bd9-97cd-881cd54bd930",
                                        "glosses": [
                                            "designação paleontológica para o conjunto de animais, mormente mamíferos mas também répteis, aves e peixes, que atingiram grandes dimensões corporais, especialmente no período pleistoceno, grande parte deles extintos no final da última glaciação há cerca de dez mil anos, o que coincidiu com a chegada dos seres humanos modernos em seus habitats"
                                        ],
                                        "tags": [
                                            "Paleontologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca10c3f-b2dd-4a15-bda3-ad5586f9d150",
                                                "sense_id": "a4477c5d-3e9d-33df-b9b7-c037c0cf2db9",
                                                "text": "No período do Pleistoceno, a América do Sul se parecia muito com a savana africana atual. E os dinossauros, há muito tempo desaparecidos, deram lugar a uma megafauna impressionante: mastodontes, antepassados dos elefantes, preguiças gigantes de cinco toneladas e os gliptodontes, tatus do tamanho de um pequeno carro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee271fd3-1ca0-3704-a1e2-6a7d4a4ebbcc",
                                        "entry_id": "8dd7e457-e4e0-3bd9-97cd-881cd54bd930",
                                        "glosses": [
                                            "designação comum aos grandes animais (como por exemplo grandes mamíferos africanos e asiáticos, como elefantes, rinocerontes, girafas, tigres, etc., mamíferos marinhos ou répteis como o dragão-de-comodo) que sobreviveram até o presente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43db318c-3b51-437d-9ef5-1dbcd3db3e3b",
                                                "sense_id": "ee271fd3-1ca0-3704-a1e2-6a7d4a4ebbcc",
                                                "text": "A África é um dos últimos grandes redutos de megafauna do mundo. No entanto, com o crescimento da população e industrialização, leões, zebras e elefantes estão desaparecendo ou sendo deslocados para outras áreas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41de258d-ad9a-38a8-9176-2a334998a36c",
                                        "entry_id": "8dd7e457-e4e0-3bd9-97cd-881cd54bd930",
                                        "glosses": [
                                            "conjunto dos animais que têm maior abundância numa comunidade"
                                        ],
                                        "tags": [
                                            "Ecologia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
