                                    {
                                        "sense_id": "75b6d8b6-b5c4-319f-a185-3f15888c86d8",
                                        "entry_id": "68872475-1671-3a82-bbbb-325d997b79f8",
                                        "glosses": [
                                            "oben offener, geflochtener Behälter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63248ed0-0f66-4a81-bcf0-d14fd93d9a24",
                                                "sense_id": "75b6d8b6-b5c4-319f-a185-3f15888c86d8",
                                                "text": "Wenn Reginas großer Bruder bei der Geburtstagsfeier anwesend ist, ist er bestimmt wieder Hahn im Korb."
                                            },
                                            {
                                                "example_id": "80153dd4-2d00-47f4-90eb-8cce0ce670d9",
                                                "sense_id": "75b6d8b6-b5c4-319f-a185-3f15888c86d8",
                                                "text": "Sie brachten ihrer Großmutter einen Korb voll leuchtend roter Äpfel."
                                            },
                                            {
                                                "example_id": "e55097fd-0bdb-447e-872c-d212915493b7",
                                                "sense_id": "75b6d8b6-b5c4-319f-a185-3f15888c86d8",
                                                "text": "„Dann hatte sie die löchrigen Körbe in der Scheune gesehen und auf YouTube eine Anleitung zum Reparieren und damit genau das gefunden, wonach sie gesucht hatte.“"
                                            },
                                            {
                                                "example_id": "f8eaf3e7-1057-4d2b-b0a6-ecef23543701",
                                                "sense_id": "75b6d8b6-b5c4-319f-a185-3f15888c86d8",
                                                "text": "„Sie hatte sich des Korbes bemächtigt und ließ sich von Robert nach Hause bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60cd8eca-4c43-3eba-883b-2373416a8611",
                                        "entry_id": "68872475-1671-3a82-bbbb-325d997b79f8",
                                        "glosses": [
                                            "Ablehnung eines Antrags"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4fd849-3be1-4f01-8cca-e62409952b49",
                                                "sense_id": "60cd8eca-4c43-3eba-883b-2373416a8611",
                                                "text": "Sie gab ihm einen Korb, nachdem er sie zum Tanzen aufgefordert hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e976c97b-9a39-311d-a990-63b4221c436f",
                                        "entry_id": "68872475-1671-3a82-bbbb-325d997b79f8",
                                        "glosses": [
                                            "Korbgeflecht (für Korb- oder Rattanmöbel)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3843dba6-b534-4a9b-bab0-cdbfa7750cab",
                                                "sense_id": "e976c97b-9a39-311d-a990-63b4221c436f",
                                                "text": "Ich habe auf dem Trödelmarkt eine Truhe aus geflochtenem Korb gekauft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "563ffb39-5f80-3607-bc2f-10ba3ab01bd9",
                                        "entry_id": "68872475-1671-3a82-bbbb-325d997b79f8",
                                        "glosses": [
                                            "Faschine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc4b3ca-31be-431a-baff-3fddded1e743",
                                                "sense_id": "563ffb39-5f80-3607-bc2f-10ba3ab01bd9",
                                                "text": "Zum Bekleiden und Verstärken der Böschungen wurden Körbe eingebracht und mit Pfählen befestigt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a8d497e2-4b10-3321-8572-af5cdef5b171",
                                        "entry_id": "68872475-1671-3a82-bbbb-325d997b79f8",
                                        "glosses": [
