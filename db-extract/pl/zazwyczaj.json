                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "762abaad-034a-40a7-bc98-899b312622dc",
                                                "sense_id": "aab6ec3f-7e5d-34f7-bef2-a0215e69e3ae",
                                                "text": "Jenže politici, kteří netouží proměnit zemi, v níž se drží dočasně část moci, v napěchovaný papiňák, se obvykle snaží rasové vášně tlumit, hledat cesty k soužití, podporovat všechny možné cesty k aspoň částečnému zlepšení, podporovat pozitivní příklady."
                                            }
                                        ]
