                "senses": [
                    {
                        "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                        "entry_id": "29325f0f-912f-38a4-9a01-8594b963caa6",
                        "glosses": [
                            "auf den Erkenntnissen der Wissenschaft beruhend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e468f10-24d1-43a6-9c69-b8dccc6d72f6",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "[Leopoldina:] „In der Coronavirus-Pandemie leistet die Nationalakademie mit Stellungnahmen wissenschaftsbasierte Politikberatung.“"
                            },
                            {
                                "example_id": "0aa4d703-278f-41f1-83b1-37c373fc7785",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "„Beide Parteien fordern eine stärker wissenschaftsbasierte Politik. Fakten statt Ideologie.“"
                            },
                            {
                                "example_id": "dbf62093-6053-4443-902a-55b73c4ed8d3",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "[Greta Thunberg] „ist die Ikone einer weltweite Bewegung vieler junger Menschen, die sich für das Klima und ein wissenschaftsbasiertes, ökologisches Handeln in der Politik einsetzen.“"
                            },
                            {
                                "example_id": "3e2af426-e1de-4c2c-85b1-dd60bd9902df",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "„Der neue US-Präsident Donald Trump hat ein schwieriges Verhältnis zu wissenschaftsbasierten Fakten – Stichwort: Klimawandel.“"
                            },
                            {
                                "example_id": "efd4c91f-54b8-4870-b559-35eba36ebaee",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "[Trump-Regierung:] „Das Gesundheitsministerium wies die Seuchenschutzbehörden an, bestimmte Begriffe wie „Diversität“, „evidenzbasiert“ und „wissenschaftsbasiert“ nicht mehr zu verwenden.“"
                            },
                            {
                                "example_id": "920b1445-9ed5-44d6-9516-aa8e472002f9",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "[Coronapandemie 2020 – Christian Drosten:] „»Daher ist die wissenschaftsbasierte Information der Öffentlichkeit für mich eine genauso wichtige Strategie im Kampf gegen das Virus wie die Entwicklung eines Medikaments oder Impfstoffs.«“"
                            },
                            {
                                "example_id": "2cb67259-e51e-48ab-8688-faee92477ef5",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "[Medizinische Hochschule Hannover:] „»Unsere Kernaufgabe ist, Bildung zu vermitteln und wissenschaftsbasiert auszubilden«, sagt Baum.“"
                            },
                            {
                                "example_id": "38b212ec-850b-4a64-838e-402f2285c4af",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "[Bundesinstitut für Risikobewertung (BfR):] „Mit seiner wissenschaftsbasierten Risikobewertung gibt das BfR wichtige Impulse für den gesundheitlichen Verbraucherschutz innerhalb und außerhalb Deutschlands.“"
                            },
                            {
                                "example_id": "30289a9a-02fd-4454-ba7c-9c128652e2b5",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "„Ein überzeugender, flexibler Mechanismus für wissenschaftsbasierte Politikberatung in der Krise scheint das britische Modell SAGE zu sein, die »Scientific Advisory Group for Emergencies«.“"
                            },
                            {
                                "example_id": "10993d4d-329d-4cfd-b046-51bfe1f56a88",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "[Empfehlunmgen einer Kommission zur Suche nach einem Atommüll-Endlager in Deutschland:] „Diese sehen vor, Deutschland als weiße Landkarte zu betrachten und anhand eines wissenschaftsbasierten Verfahrens den am besten geeigneten Ort zu suchen.“"
                            },
                            {
                                "example_id": "be432f73-e427-4ded-b4a9-6738430eb0ac",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "„Gleichstellungsberichte ermöglichen eine evidenz- und wissenschaftsbasierte Politikberatung und sind in Deutschland die zentrale Grundlage für eine politische Diskussion über zukünftige gleichstellungspolitische Handlungsoptionen.“"
                            },
                            {
                                "example_id": "d1c948c8-e79e-455c-864d-4484edf3e015",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "„Die fehlende statistische oder wissenschaftsbasierte Recherche ist ebenso typisches Merkmal für rechte Publizistik wie eine Rhetorik des Raunens, die pastorale Verheißungs-und Spekulations-Prosa eines bald kommenden Kampfs der sachdienlichen Argumentation vorzieht.“"
                            },
                            {
                                "example_id": "35d9e12c-9b9c-46b1-961d-ff666c1ad0db",
                                "sense_id": "4857d480-c782-352e-bd10-3030e65a35eb",
                                "text": "„Die Verunreinigung von aquatischen und terrestrischen Ökosystemen mit Plastikmüll und Mikroplastikpartikel stellt ein potenzielles Umweltrisiko dar. Wissenschaftsbasierte Aussagen zu den Effekten auf Organismen und Ökosysteme sowie zur Konzentration in der Umwelt sind aktuell jedoch nur bedingt vorhanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
