                "senses": [
                    {
                        "sense_id": "60babdf1-859f-3ce3-a0e6-05e33bbb43af",
                        "entry_id": "78f5c088-ab4b-3e7d-b5fb-ec5c3b4aaaaf",
                        "glosses": [
                            "Échanger dans un contexte où les transactions commerciales entre les nations sont affranchies de prohibitions et de taxes élevées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf1b318-dd2e-446c-b4f8-23da0d8b1fa2",
                                "sense_id": "60babdf1-859f-3ce3-a0e6-05e33bbb43af",
                                "text": "Que peut-on « libre-échanger » avec un partenaire lorsque notre niveau de vie lui est inférieur de plus de 800% ?"
                            },
                            {
                                "example_id": "43400caf-2f8e-425c-9ae6-9265373b1061",
                                "sense_id": "60babdf1-859f-3ce3-a0e6-05e33bbb43af",
                                "text": "Plus on libre-échange, plus on s’enrichit, non?"
                            }
                        ]
                    }
