                    "sense_id": "e45ab10e-dbc7-36fa-8325-91e76ef3351a",
                    "sense_definition": "iets plat maken door eroverheen te lopen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plat maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kampeerders hebben het hoge gras rondom hun tenten helemaal <w>platgelopen</w>.",
                            "target_lang_translations": {
                                "en": "The campers have completely <w>trampled down</w> the tall grass around their tents."
                            }
                        },
                        {
                            "text": "Pas op dat je de jonge plantjes in de tuin niet per ongeluk <w>platloopt</w>.",
                            "target_lang_translations": {
                                "en": "Be careful not to accidentally <w>tread down</w> the young plants in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "platdrukken",
                        "platstappen"
                    ],
                    "common_phrases": [
                        "het gras platlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to flatten something by walking over it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trample down",
                                "target_lang_sense_clarification": "to flatten by walking on"
                            },
                            {
                                "target_lang_word": "tread down",
                                "target_lang_sense_clarification": "to press down with feet"
                            },
                            {
                                "target_lang_word": "flatten",
                                "target_lang_sense_clarification": "by walking over"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e45fbe8-03b0-37cb-9447-c06d2412adfc",
                    "sense_definition": "een plek zo vaak bezoeken dat de natuur of de rust daar wordt aangetast of vernield",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "overmatig bezoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het laatste dat je wilt, is de ongerepte natuur <w>platlopen</w> met horden gelijkgestemde bewonderaars.",
                            "target_lang_translations": {
                                "en": "The last thing you want is to <w>overrun</w> the pristine nature with hordes of like-minded admirers."
                            }
                        },
                        {
                            "text": "Toeristen dreigen dit afgelegen strandje volledig te <w>platlopen</w> nu het op sociale media staat.",
                            "target_lang_translations": {
                                "en": "Tourists are threatening to completely <w>spoil</w> this remote beach now that it is on social media."
                            }
                        }
                    ],
                    "synonyms": [
                        "overrompelen",
                        "vertrappen"
                    ],
                    "common_phrases": [
                        "de natuur platlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to visit a place so frequently that the nature or tranquility is damaged or destroyed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overrun",
                                "target_lang_sense_clarification": "to swarm over a place in large numbers"
                            },
                            {
                                "target_lang_word": "trample",
                                "target_lang_sense_clarification": "to damage a place by excessive foot traffic"
                            },
                            {
                                "target_lang_word": "spoil",
                                "target_lang_sense_clarification": "by visiting too often"
                            }
                        ]
                    }
                }
            ]
        }
    ]
