                    },
                    {
                        "translation_id": "39b204d4-c1bb-4357-b44d-5d5607706376",
                        "source_entry_id": "4cbcb2d0-d409-35bd-a34d-4071e36b3ab1",
                        "source_sense_id": "11696c49-6a6b-3017-bf28-5fb59e9ae25b",
                        "source_sense_description": "a person in business",
                        "target_lang_word": "Unternehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unternehmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                        "entry_id": "46bb1fac-d681-37e6-9af7-ccebbddd0895",
                                        "glosses": [
                                            "Person, die Inhaber oder Eigentümer eines Unternehmens ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a653d79-7236-4a2e-b86c-59fe44f3d857",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„Unternehmer ist eine natürliche oder juristische Person oder eine rechtsfähige Personengesellschaft, die bei Abschluss eines Rechtsgeschäfts in Ausübung ihrer gewerblichen oder selbständigen beruflichen Tätigkeit handelt.“"
                                            },
                                            {
                                                "example_id": "f8674fe3-53b4-473f-b3e9-f8b998b98af3",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„Zum Begriff des Unternehmers gehört nicht notwendig die Kaufmannseigenschaft.“"
                                            },
                                            {
                                                "example_id": "e628ebd2-7b3f-4ba1-8041-edea249d7179",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„Unternehmer im Sinne des Umsatzsteuerrechts ist, wer eine gewerbliche oder berufliche Tätigkeit selbständig ausübt.“"
                                            },
                                            {
                                                "example_id": "9f09d852-317d-4114-9ae3-852823b26838",
                                                "sense_id": "9ac415ef-acbc-3a3a-9ed4-4e85adaf72fd",
                                                "text": "„In der Geschichte habe sie das weggelassen, um den Unternehmer noch mieser darzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d5d233b-6b44-475b-b691-22ff656f858d",
                        "source_entry_id": "4cbcb2d0-d409-35bd-a34d-4071e36b3ab1",
                        "source_sense_id": "11696c49-6a6b-3017-bf28-5fb59e9ae25b",
                        "source_sense_description": "a person in business",
                        "target_lang_word": "Unternehmerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unternehmerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                        "entry_id": "d6210f63-c92d-3dfe-9bc9-842e179cc7cd",
                                        "glosses": [
                                            "weibliche Person, die Inhaberin oder Eigentümerin eines Unternehmens ist; Akteurin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980ec9db-925d-4bf0-989a-c8fe7f570a27",
                                                "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                                "text": "„Als Unternehmer beziehungsweise Unternehmerin bezeichnet man meist den Inhaber eines Unternehmens oder Betriebes, das von dieser Person ebenfalls eigenständig geführt wird.“"
                                            },
                                            {
                                                "example_id": "cae11f1a-1e85-4fa2-a4d9-6579560750b1",
                                                "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                                "text": "„Dorsten: Christel Heiming-Mechlinski ist die „Unternehmerin des Jahres 2013“ in Dorsten.“"
                                            },
                                            {
                                                "example_id": "608457d1-657e-4143-939e-95591d0eb77e",
                                                "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                                "text": "„Was ich aber definitiv niemals werden wollte, ist Unternehmerin und Chefin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f89c85f8-5601-4deb-8cb4-0ed9c310b6de",
                        "source_entry_id": "4cbcb2d0-d409-35bd-a34d-4071e36b3ab1",
                        "source_sense_id": "11696c49-6a6b-3017-bf28-5fb59e9ae25b",
                        "source_sense_description": "a person in business",
                        "target_lang_word": "Geschäftsmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschäftsmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                        "entry_id": "7c242cc5-f4be-31e8-bb88-2358c33eb1df",
                                        "glosses": [
                                            "Person, die ein kommerzielles Geschäft (Unternehmen) leitet oder Geschäfte tätigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de02cab0-c4aa-427a-8f2d-69464ef5dd3e",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "Er gab seinen Beruf vage als Geschäftsmann an."
                                            },
                                            {
                                                "example_id": "afc69888-3207-41d4-91fe-238067f99e4b",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Großvater ist Geschäftsmann und weiß, was der Vater will.“"
                                            },
                                            {
                                                "example_id": "369f99f2-7b0e-4f36-bbe8-a6ea16a1b24b",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Als hartnäckiger Geschäftsmann denkt der neue Präsident langfristig.“"
                                            },
                                            {
                                                "example_id": "40c4a1c8-0257-410f-a43e-482676d327c7",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Auch Sung war eher ein Sammler als ein Geschäftsmann.“"
                                            },
                                            {
                                                "example_id": "977dea58-381b-42c5-a4be-fa21fee3e456",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Haile ist mittlerweile auch einer der erfolgreichsten Geschäftsmänner des Landes.“"
                                            },
                                            {
                                                "example_id": "396daa45-9ba4-43bf-b54d-ac64dfd0c420",
                                                "sense_id": "03e8bce2-8279-366d-95cf-8acf756da5f8",
                                                "text": "„Um diese Geschäfte abzuwickeln, gründeten viele russische Geschäftsleute sogar eigene Firmen in der Türkei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d420391-8ff4-4a88-9b05-d3c77dbc7f1a",
                        "source_entry_id": "4cbcb2d0-d409-35bd-a34d-4071e36b3ab1",
                        "source_sense_id": "11696c49-6a6b-3017-bf28-5fb59e9ae25b",
                        "source_sense_description": "a person in business",
                        "target_lang_word": "Geschäftsfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschäftsfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6666d9de-7985-35d0-b851-8bc015b245c3",
                                        "entry_id": "ebbf88b1-893c-3351-81d7-a99e05d682e7",
                                        "glosses": [
                                            "Frau, die ein Geschäft betreibt oder Geschäfte macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e716bd-a4a4-4dfb-95cd-bc0477a3ef9b",
                                                "sense_id": "6666d9de-7985-35d0-b851-8bc015b245c3",
                                                "text": "„Die schlaueste unter den Insassinnen der gehobenen Abteilung war eine Fälscherin und Geschäftsfrau namens Nelly Kerwin.“"
                                            },
                                            {
                                                "example_id": "552a1400-4d8a-42ff-a1f7-8dc4a55e4a75",
                                                "sense_id": "6666d9de-7985-35d0-b851-8bc015b245c3",
                                                "text": "„Hella Wuolijoki war eine linke Schriftstellerin und Geschäftsfrau im Holzhandel.“"
                                            },
                                            {
                                                "example_id": "c6343d4a-3386-4434-940a-1df9ac6c4a87",
                                                "sense_id": "6666d9de-7985-35d0-b851-8bc015b245c3",
                                                "text": "„Außerdem führt es erfahrungsgemäß zu kompletter gesellschaftlicher Isolation, einem zwar reizvollen, aber der Karriere einer Geschäftsfrau eher abträglichen Zustand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
