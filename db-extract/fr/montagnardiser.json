                "senses": [
                    {
                        "sense_id": "8b9056a6-8728-3d0a-8d24-8b7f2259e218",
                        "entry_id": "37d8117a-851b-33b6-8672-efb8db59291f",
                        "glosses": [
                            "Donner un caractère montagnard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614e5b67-83d8-4725-80b5-08de71cf1f1b",
                                "sense_id": "8b9056a6-8728-3d0a-8d24-8b7f2259e218",
                                "text": "Ce que je voulais dire, c'est que, par rapport à mon cas particulier, je viens juste d'arriver dans la montagne, j'essaie de me \"montagnardiser\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "08a744da-0461-309c-ad05-a33ffea45551",
