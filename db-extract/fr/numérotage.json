        "fr-extract.jsonl": [
            {
                "entry_id": "b86df577-ed9c-321e-bd98-f256918b3cdc",
                "word": "numérotage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "95e414fe-9915-4eb6-acff-6c5feaf1d62d",
                        "entry_id": "b86df577-ed9c-321e-bd98-f256918b3cdc",
                        "tags": [
                            "plural"
                        ],
                        "form": "numérotages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03c7a76c-ee17-3041-a526-c39a6470d763",
                        "entry_id": "b86df577-ed9c-321e-bd98-f256918b3cdc",
                        "glosses": [
                            "Action de numéroter ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99850da4-db69-4a3c-9905-c9edf88348db",
                                "sense_id": "03c7a76c-ee17-3041-a526-c39a6470d763",
                                "text": "À Paris, le numérotage des maisons part de la Seine."
                            },
                            {
                                "example_id": "ec26f208-af16-40ad-9c42-34a35de58dd0",
                                "sense_id": "03c7a76c-ee17-3041-a526-c39a6470d763",
                                "text": "Grâce au numérotage de chaque paragraphe, nous serons dispensé de répéter continuellement les mêmes explications dans les correspondances manuscrites que nous échangeons avec diverses Administrations françaises et étrangères."
                            },
                            {
                                "example_id": "44d72c5b-9516-4d37-9736-2281cb5173e9",
                                "sense_id": "03c7a76c-ee17-3041-a526-c39a6470d763",
                                "text": "Le photographe en blouse noire, resté seul, contempla pour sa délectation personnelle les épreuves qu’il venait de tirer et en commença le numérotage."
                            },
                            {
                                "example_id": "6943a5c0-2045-4ac9-86f9-847e924dc376",
                                "sense_id": "03c7a76c-ee17-3041-a526-c39a6470d763",
                                "text": "L’histoire ne m’intéressait plus : ces rois qui n’avaient que des prénoms, qui étaient tous parents, et qui se faisaient la guerre, je n’arrivais pas, malgré leur numérotage, à les distinguer les uns des autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f400350-6486-3078-b5f5-c36ec3609220",
                        "entry_id": "b86df577-ed9c-321e-bd98-f256918b3cdc",
                        "glosses": [
                            "Action de graduer les qualités de certains produits."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "43af3f4c-921a-40a4-87d9-a735458967ea",
                                "sense_id": "9f400350-6486-3078-b5f5-c36ec3609220",
                                "text": "[…], mais l’habitude commerciale a fait prévaloir pour la soie, le titrage à poids variable et longueur fixe, et pour les autres fils, le numérotage à poids fixe et à longueur variable."
                            }
                        ]
                    }
                ],
