                "senses": [
                    {
                        "sense_id": "36860791-0eaa-39b9-abcd-5e4c7de42711",
                        "entry_id": "d2facb05-50de-36de-97dd-dcff0bf7bb71",
                        "glosses": [
                            "терять способность говорить, становиться немым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94938dd4-c288-4887-85de-a16a3a873b46",
                                "sense_id": "36860791-0eaa-39b9-abcd-5e4c7de42711",
                                "text": "Люди начинали неметь в странных обстоятельствах."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcf0a808-1373-3eee-8c5e-5a622e90ede3",
                        "entry_id": "d2facb05-50de-36de-97dd-dcff0bf7bb71",
                        "glosses": [
                            "перен. терять дар речи, умолкать, застывать в молчании от восторга или страха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b5d94e2-e559-4fef-a541-8ddfd3cafbfe",
                                "sense_id": "fcf0a808-1373-3eee-8c5e-5a622e90ede3",
                                "text": "Обязанность для меня дело священное, закон — я немею перед законом."
                            }
                        ]
                    },
                    {
                        "sense_id": "a896d15a-5eed-332e-bb43-4fe275969cf7",
                        "entry_id": "d2facb05-50de-36de-97dd-dcff0bf7bb71",
                        "glosses": [
                            "утрачивать чувствительность"
                        ],
                        "tags": [
                            "о предмете, части тела"
                        ],
                        "examples": [
                            {
                                "example_id": "15c8a3d8-0602-4179-80fb-aea642944f99",
                                "sense_id": "a896d15a-5eed-332e-bb43-4fe275969cf7",
                                "text": "Пальцы от холода немеют."
                            },
                            {
                                "example_id": "7075f7a7-f276-4e88-b332-d77bf1846dc1",
                                "sense_id": "a896d15a-5eed-332e-bb43-4fe275969cf7",
                                "text": "Его члены сладко немеют от наступившего сна."
                            }
                        ]
                    }
