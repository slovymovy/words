                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ac844a-8b22-427d-85d7-1ff571a7d2e5",
                                "sense_id": "13d51a90-3a83-34d7-a972-f7730fcd7118",
                                "text": "De dienstplichtige soldaat is eigenlijk niet meer dan een amateur die onvoldoende militaire opleiding heeft voor de moderne oorlogsvoering."
                            },
                            {
                                "example_id": "0e7be43c-f28f-469d-a34f-aa53f09ff45c",
                                "sense_id": "13d51a90-3a83-34d7-a972-f7730fcd7118",
                                "text": "Op jacht naar 'n vliegticket, Russen zoeken uitweg voor dienstplichtige zoons"
                            },
                            {
                                "example_id": "92fd6dda-f0d7-4275-9972-d57665ab777a",
                                "sense_id": "13d51a90-3a83-34d7-a972-f7730fcd7118",
                                "text": "Nu was de jongen net als alle anderen opgeroepen en omdat hij dienstplichtig student was zou het een lange diensttijd worden met een officiersopleiding."
