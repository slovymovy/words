                        "tags": [],
                        "examples": [
                            {
                                "example_id": "270aaa74-121e-46a8-bb77-38bed52159ff",
                                "sense_id": "5113a9de-024b-3f86-8608-4b79baa0c5e9",
                                "text": "„Bond bestellte sich einen Americano und sah sich die übereleganten Gäste an, die seiner Ansicht nach zum größten Teil aus Paris stammten, sich hitzig und lebhaft unterhielten und dadurch jene theatralisch intime Atmosphäre der »Heure de I’aperitif« schufen.“"
                            },
                            {
                                "example_id": "b35ac296-419f-464a-aad3-55d8207ff779",
                                "sense_id": "5113a9de-024b-3f86-8608-4b79baa0c5e9",
                                "text": "„Will bringt mir das Übliche, noch ehe ich zum Bestellen komme: Americano, schwarz, mit zwei Extraspritzern Espresso.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
