                ],
                "senses": [
                    {
                        "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                        "entry_id": "6a303849-35e3-3699-8ed7-36b152dbfea1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fd85f61-bfa6-41ab-9aef-035e109039fc",
                                "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                                "text": "Frau Federle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2610304a-1b47-4c9f-926e-ede7d91006ed",
                                "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                                "text": "Herr Federle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c33008d7-04ba-4daa-be34-f70981169276",
                                "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                                "text": "Die Federles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9f81de60-3d7f-4674-9213-1f88525bacc6",
                                "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                                "text": "Der Federle trägt nie die Schals, die die Federle ihm strickt."
                            },
                            {
                                "example_id": "60b8b5bd-7f58-4251-ae9a-c76d38524894",
                                "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Federle kommt, geht der Herr Federle.“"
                            },
                            {
                                "example_id": "41a4fe2f-4a2a-48bc-a46a-3e2d73fa9b66",
                                "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                                "text": "Federle kommt und geht."
                            },
                            {
                                "example_id": "dd4c9b47-e2de-44e8-9194-e73c874fa7a7",
                                "sense_id": "400aac35-09d2-3f93-8b1d-015778db1819",
                                "text": "Federles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
