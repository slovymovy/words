                        "examples": [
                            {
                                "example_id": "2571b6c3-63f7-4b6b-b9a1-efdec901715f",
                                "sense_id": "e7500526-d7fa-307a-bbc9-874f56efa5cc",
                                "text": "Ce troupeau appartenait au juge de Werst, le biró Koltz, lequel payait à la commune un gros droit de brébiage, et qui appréciait fort son pâtour Frik, le sachant très habile à la tonte, et très entendu au traitement des maladies."
                            },
                            {
                                "example_id": "c8b5c0c4-6429-48aa-8cd3-335edcc7e644",
                                "sense_id": "e7500526-d7fa-307a-bbc9-874f56efa5cc",
                                "text": "Je t’ai toujours connu muet comme une tanche, ne retenant et ne ruminant aucune chanson ; car, quand tu t’essayais sur le chalumeau de paille, comme font beaucoup de pâtours, tu changeais tous les airs que tu avais entendus, de telle manière qu’on ne les reconnaissait plus. — (George Sand, Les Maîtres sonneurs, George Bell and sons, 1908, page 43)"
                            }
                        ]
                    }
