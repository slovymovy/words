    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ff909e1a-1b71-3e58-b028-4c9dd0591be3",
                "word": "amassment",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "17ff40fb-81a0-4271-87b3-f5bcb63099b7",
                        "entry_id": "ff909e1a-1b71-3e58-b028-4c9dd0591be3",
                        "tags": [
                            "plural"
                        ],
                        "form": "amassments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f95600fd-2af7-342d-930a-f2f532c5f013",
                        "entry_id": "ff909e1a-1b71-3e58-b028-4c9dd0591be3",
                        "glosses": [
                            "The act of amassing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8942b2d9-b7ba-47be-b6ff-7dde94b1c515",
                                "sense_id": "f95600fd-2af7-342d-930a-f2f532c5f013",
                                "text": "All her energy was devoted to the amassment of a vast fortune."
                            },
                            {
                                "example_id": "39908812-a02e-42b6-87e5-d3e4d2a7aa8c",
                                "sense_id": "f95600fd-2af7-342d-930a-f2f532c5f013",
                                "text": "1654, Walter Charleton, Physiologia Epicuro-Gassendo-Charltoniana, London: Thomas Heath, Book 1, Chapter 2, p. 13,\n… no can know, whether He [God] created either more Atoms then were requisite to the amassment of this World, or more Worlds then this one:"
                            },
                            {
                                "example_id": "a4424f91-df73-48f6-94d7-e5dd8b88dfe5",
                                "sense_id": "f95600fd-2af7-342d-930a-f2f532c5f013",
                                "text": "[...] Curmudgeons among Books, are as discoverable as those among Bags; and [...] they may lose more Honour and Credit, than gain Wisdom or Happiness, by the fruitless Amassment and Imprisonment of either."
                            },
                            {
                                "example_id": "9167ac3f-ca5f-4d15-96cd-a58e7bd51636",
                                "sense_id": "f95600fd-2af7-342d-930a-f2f532c5f013",
                                "text": "Even more than the Russian Bolshevik the American democrat regards wealth with suspicion, and its too eager amassment with a bilious eye."
                            },
                            {
                                "example_id": "660b9578-4f66-41e4-887e-c27516005bae",
                                "sense_id": "f95600fd-2af7-342d-930a-f2f532c5f013",
                                "text": "Empiricism, magpie amassment of cultural detail, produces an ethnographic telephone book."
                            }
                        ]
                    },
                    {
                        "sense_id": "86b244c0-94c0-39e1-9f0d-dbf65e944ef1",
                        "entry_id": "ff909e1a-1b71-3e58-b028-4c9dd0591be3",
                        "glosses": [
                            "That which is amassed; a large quantity (of something)."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "16c89c21-0427-4703-8a08-d99941ccc4ac",
                                "sense_id": "86b244c0-94c0-39e1-9f0d-dbf65e944ef1",
                                "text": "Through the Internet, we have access to an unprecedented amassment of information."
                            },
                            {
                                "example_id": "d87afe5b-dcc5-4b75-ad6c-0e017dc20a68",
                                "sense_id": "86b244c0-94c0-39e1-9f0d-dbf65e944ef1",
                                "text": "[Phancy, i.e. imagination, is] but an amassment of imaginary conceptions, praejudices, ungrounded opinions, and infinite Impostures;"
                            },
                            {
                                "example_id": "d67d7259-1a6e-4a5d-ae5b-d90dbf850511",
                                "sense_id": "86b244c0-94c0-39e1-9f0d-dbf65e944ef1",
                                "text": "[...] many are the means, whereby the Sultan daily adds prodigious Sums to his Revenues, such as, for Example, The obliging all the Great Bashaws and Governours of his Dominions every New-Years-Day to send him Presents, commonly in ready Money, which amounts to an incredible Amassment."
                            },
                            {
                                "example_id": "ccc03d5e-9e41-4b27-b719-35ffa312a7c4",
                                "sense_id": "86b244c0-94c0-39e1-9f0d-dbf65e944ef1",
                                "text": "[...] did he imagine he could carry his amassments with him out of the world? Had he so loved the gems in his life as to dream he could illumine his tomb with them?"
                            },
                            {
                                "example_id": "47d357ed-6892-4a85-a4d0-c323d5dc5c6f",
                                "sense_id": "86b244c0-94c0-39e1-9f0d-dbf65e944ef1",
                                "text": "We had pushed everything into the middle of the floor, and she sat in a rocker on the edge of the amassment, attending to the last year’s baby."
                            },
                            {
                                "example_id": "50a02474-d15c-428a-9e2e-a374ce812c81",
                                "sense_id": "86b244c0-94c0-39e1-9f0d-dbf65e944ef1",
                                "text": "[...] I trawled my way through the staggering amassment of papers and journals and tomes that chronicle the newest developments in the astonishingly fast-moving world of modern geology."
                            }
                        ]
                    }
