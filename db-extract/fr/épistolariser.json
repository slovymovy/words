                        "entry_id": "ac70aa4e-9941-360b-a05b-32975df28f06",
                        "glosses": [
                            "Donner un caractère épistolaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01dc89f-ca1c-4df8-9a9e-f8c71c86030a",
                                "sense_id": "76cee17e-5277-3922-b031-67df4da04d2c",
                                "text": "Aussi prend-il soin d’« épistolariser » autant que possible sa liaison."
                            },
                            {
                                "example_id": "284ec426-1d40-4d8c-bdb5-1185242adf09",
                                "sense_id": "76cee17e-5277-3922-b031-67df4da04d2c",
                                "text": "Tout en souhaitant au lecteur qu’il prenne plaisir à découvrir ainsi les multiples facettes d’une culture médiatique « épistolarisée », terminons cette introduction par quelques remerciements."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cf581db-a185-37ea-9bb6-34e557822b55",
                        "entry_id": "ac70aa4e-9941-360b-a05b-32975df28f06",
                        "glosses": [
