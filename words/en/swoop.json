{
    "word_family": [
        "sweeping",
        "sweep"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a445304-3eca-3077-a4d5-ee4cb5fba7da",
                    "sense_definition": "To fly or glide downwards suddenly",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle <w>swooped</w> down from the sky to catch its prey.",
                            "target_lang_translations": {
                                "cs": "Orel se <w>snesl</w> z oblohy, aby chytil svou kořist."
                            }
                        },
                        {
                            "text": "The hawk <w>swooped</w> toward the field with incredible speed.",
                            "target_lang_translations": {
                                "cs": "Jestřáb se neuvěřitelnou rychlostí <w>vrhl</w> směrem k poli."
                            }
                        }
                    ],
                    "synonyms": [
                        "dive",
                        "plunge"
                    ],
                    "common_phrases": [
                        "swoop down"
                    ],
                    "target_lang_definitions": {
                        "cs": "prudce se snést nebo vrhnout dolů (často při letu)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "snést se",
                                "target_lang_sense_clarification": "pohyb směrem dolů, typicky u ptáků"
                            },
                            {
                                "target_lang_word": "vrhnout se dolů",
                                "target_lang_sense_clarification": "prudký a rychlý pohyb směrem k zemi"
                            },
                            {
                                "target_lang_word": "slétnout",
                                "target_lang_sense_clarification": "rychlý let směrem dolů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "789584b4-fd4b-36b0-b5b5-580fc72087d3",
                    "sense_definition": "To move swiftly and suddenly, often to attack or seize something",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police <w>swooped</w> in to arrest the suspects at the warehouse.",
                            "target_lang_translations": {
                                "cs": "Policie <w>vpadla</w> do skladu, aby zatkla podezřelé."
                            }
                        },
                        {
                            "text": "Investors <w>swooped</w> on the company after the stock price dropped.",
                            "target_lang_translations": {
                                "cs": "Investoři se <w>vrhli</w> na společnost poté, co cena akcií klesla."
                            }
                        }
                    ],
                    "synonyms": [
                        "pounce",
                        "descend"
                    ],
                    "common_phrases": [
                        "swoop in"
                    ],
                    "target_lang_definitions": {
                        "cs": "rychle a nečekaně se objevit, často za účelem útoku nebo zásahu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vpadnout",
                                "target_lang_sense_clarification": "náhlý a nečekaný příchod nebo zásah"
                            },
                            {
                                "target_lang_word": "vrhnout se",
                                "target_lang_sense_clarification": "agresivní nebo rychlý útok na cíl"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba4a77aa-fd59-3e32-a1db-a3ccfeb7720a",
                    "sense_definition": "To seize or catch something quickly",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird <w>swooped</w> up the insect before it could fly away.",
                            "target_lang_translations": {
                                "cs": "Pták hmyz <w>popadl</w> dříve, než mohl uletět."
                            }
                        },
                        {
                            "text": "He <w>swooped</w> up the fallen papers before the wind blew them away.",
                            "target_lang_translations": {
                                "cs": "Rychle <w>sebral</w> popadané papíry, než je vítr odvál."
                            }
                        }
                    ],
                    "synonyms": [
                        "snatch",
                        "grab"
                    ],
                    "target_lang_definitions": {
                        "cs": "rychle něco uchopit nebo sebrat"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "popadnout",
                                "target_lang_sense_clarification": "rychlé a rozhodné uchopení předmětu"
                            },
                            {
                                "target_lang_word": "sebrat",
                                "target_lang_sense_clarification": "rychlé zvednutí něčeho ze země"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f8dcfbd-7039-39fd-a9de-f633185e5e4d",
                    "sense_definition": "A sudden downward movement or plunge",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>swoop</w>, the bird caught the fish.",
                            "target_lang_translations": {
                                "cs": "Jedním rychlým <w>snesením</w> pták chytil rybu."
                            }
                        },
                        {
                            "text": "The roller coaster made a terrifying <w>swoop</w> toward the ground.",
                            "target_lang_translations": {
                                "cs": "Horská dráha provedla děsivý <w>střemhlavý let</w> k zemi."
                            }
                        }
                    ],
                    "synonyms": [
                        "dive",
                        "plunge"
                    ],
                    "common_phrases": [
                        "made a swoop"
                    ],
                    "target_lang_definitions": {
                        "cs": "prudký pohyb směrem dolů"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "střemhlavý let",
                                "target_lang_sense_clarification": "prudký sestupný pohyb"
                            },
                            {
                                "target_lang_word": "náhlý sestup",
                                "target_lang_sense_clarification": "rychlý pohyb směrem k zemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8df3f358-c0c6-36c4-bedf-ae8b399b91e1",
                    "sense_definition": "A sudden act of seizing or taking something",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company took control of the market in one single <w>swoop</w>.",
                            "target_lang_translations": {
                                "cs": "Společnost ovládla trh <w>jedním rázem</w>."
                            }
                        },
                        {
                            "text": "They cleared the entire room in one <w>swoop</w>.",
                            "target_lang_translations": {
                                "cs": "Vyklidili celou místnost <w>jedním vrzem</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "seizure",
                        "grab"
                    ],
                    "common_phrases": [
                        "in one swoop"
                    ],
                    "target_lang_definitions": {
                        "cs": "náhlý akt zmocnění se něčeho"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jedním rázem",
                                "target_lang_sense_clarification": "vyjádření rychlosti a úplnosti akce"
                            },
                            {
                                "target_lang_word": "jedním vrzem",
                                "target_lang_sense_clarification": "idiomatické vyjádření pro rychlé vyřízení věci"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}