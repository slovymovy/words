                },
                {
                    "sense_id": "1ad69425-c9f5-3672-8b09-7523a79236eb",
                    "sense_definition": "Exprime le doute ou l'incrédulité face à une affirmation : cela reste à prouver ou à voir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "doute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils affirment que le projet sera achevé dans les délais prévus, mais <w>voire</w>."
                        },
                        {
                            "text": "Tu penses qu'elle acceptera cette proposition sans protester ? <w>Voire</w> !"
