                            {
                                "example_id": "b3d62158-21af-4b26-b426-c4192ac2a4c0",
                                "sense_id": "8b56ec66-fad3-33af-a6aa-bba70d4c9cc4",
                                "text": "scrubby crops"
                            },
                            {
                                "example_id": "cdbb9dc6-8e41-47a7-bec5-5d3bdaae3f08",
                                "sense_id": "8b56ec66-fad3-33af-a6aa-bba70d4c9cc4",
                                "text": "scrubby cattle"
                            },
                            {
                                "example_id": "384ab5b2-d7b9-437e-b863-f850ca71b5b9",
                                "sense_id": "8b56ec66-fad3-33af-a6aa-bba70d4c9cc4",
                                "text": "This sort of literary slop-work will not suffice for your walking in the roads of life to any good purpose. It is bad work. It is scrubby work."
                            },
                            {
                                "example_id": "43cb2e6f-8a49-49d2-a90e-612aa6fc7c07",
                                "sense_id": "8b56ec66-fad3-33af-a6aa-bba70d4c9cc4",
                                "text": "Too little Potash in the fertilizer used produces a \"scrubby\" crop, just as a lack of sufficient grain fed to stock means a \"scrubby\" animal. Free: An illustrated book which tells what Potash is, how it should be used, and how much Potash a well-balanced fertilizer should contain, is sent free to all applicants. Send your address. GERMAN KALI WORKS, 92 Nassau St., New York."
                            },
                            {
                                "example_id": "c6f19d2e-f090-4207-a9df-3bcf7428900e",
                                "sense_id": "8b56ec66-fad3-33af-a6aa-bba70d4c9cc4",
                                "text": "The red clay of Oklahoma and the sands of the west Texas desert country produce scrubby crops, oil and football players. For the hardy, lean and tough people who inhabit this country, the crops are a last resort, oil a hopeful dream and football a religion."
                            }
                        ]
                    }
