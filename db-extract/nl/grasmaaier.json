                                        "sense_id": "fa3db78c-d2b7-3094-ac33-2e525dfc853a",
                                        "entry_id": "be439c85-b61f-3e22-951a-b83e4e615271",
                                        "glosses": [
                                            "Alternative spelling of lawnmower."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38c06959-8204-45de-b17e-2daf1ecb306c",
                                                "sense_id": "fa3db78c-d2b7-3094-ac33-2e525dfc853a",
                                                "text": "Aside from his interest in the above company, Mr. Johnson is president of the Pastime Lawn Mower Co. and the International Specialty Co"
                                            },
                                            {
                                                "example_id": "dc87a8e9-3331-4d36-949f-b6cf6d8c1553",
                                                "sense_id": "fa3db78c-d2b7-3094-ac33-2e525dfc853a",
                                                "text": "1900 Walter Hines Page, Arthur Wilson Page - The World's Work ...: A History of Our Time\nThe tractor is so simple that any boy or girl may operate it, walk-ing and steering it as if it were a lawn mower, but without pushing"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "152bc0b6-7bd1-4d86-a78b-25d80284d401",
                        "source_entry_id": "c5017415-3241-3ad8-8e37-d17c278b4f89",
                        "target_lang_word": "tondeuse à gazon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tondeuse à gazon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a01374-23a2-3d48-b237-393842a26f6f",
                                        "entry_id": "e3708002-9b78-3df4-81fa-25856abcd286",
                                        "glosses": [
                                            "Machine manuelle ou motorisée, qui sert à tondre l’herbe ou le gazon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd01d22-8f7a-4f1b-85b0-b23a70b0031a",
                                                "sense_id": "d3a01374-23a2-3d48-b237-393842a26f6f",
                                                "text": "Du point de vue émission de COV, une heure de fonctionnement de tondeuse à gazon, de tronçonneuse ou de moteur hors-bord équivaut respectivement à un parcours de 80, 320 ou 1300 km en voiture dépolluée; […]."
                                            },
                                            {
                                                "example_id": "c54fc306-1041-456f-8261-962c48f1df69",
                                                "sense_id": "d3a01374-23a2-3d48-b237-393842a26f6f",
                                                "text": "Il en va de même pour les lames de votre tondeuse à gazon ! Les lames tournantes qui se trouvent sous votre tondeuse finissent avec le temps par s’émousser."
                                            },
                                            {
                                                "example_id": "f75b1dbb-4b8d-4348-bed4-3a512965c627",
                                                "sense_id": "d3a01374-23a2-3d48-b237-393842a26f6f",
                                                "text": "— Tu fais des recherches sur quoi ? Pas sur les tondeuses à gazon, j'espère.\n— Pourquoi diable les tondeuses à gazon ?\n— Parce que tu regardes toujours les catalogues de tondeuses à gazon. Tu meurs d’envie d'en acheter une.,"
                                            },
                                            {
                                                "example_id": "12683e08-cad9-4c68-9507-877aed7bef7e",
                                                "sense_id": "d3a01374-23a2-3d48-b237-393842a26f6f",
                                                "text": "Il explique ainsi que si la réglementation du bruit des tondeuses à gazon n'a pas par nature de dimension transnationale, une intervention de l'Union peut tout de même être justifiée conformément à l’exigence de la réalisation du marché intérieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
