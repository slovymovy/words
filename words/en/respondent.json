{
    "word_family": [
        "respond",
        "response",
        "responsive",
        "responsiveness",
        "responsibly",
        "responsibility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34b97fa8-ab13-3887-9c38-5320e18f1980",
                    "sense_definition": "A person who provides answers to a survey, questionnaire, or research study.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "research_participant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>respondent</w> completed the online survey in less than five minutes.",
                            "target_lang_translations": {
                                "ru": "<w>Респондент</w> заполнил онлайн-опрос менее чем за пять минут."
                            }
                        },
                        {
                            "text": "Each survey <w>respondent</w> received a small gift card as a token of appreciation.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>участник</w> опроса получил небольшую подарочную карту в знак благодарности."
                            }
                        }
                    ],
                    "synonyms": [
                        "participant",
                        "interviewee"
                    ],
                    "antonyms": [
                        "interviewer",
                        "researcher"
                    ],
                    "common_phrases": [
                        "survey respondent",
                        "anonymous respondent",
                        "average respondent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, отвечающее на вопросы анкеты, опросника или участвующее в исследовательском опросе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "респондент",
                                "target_lang_sense_clarification": "участник опроса или исследования"
                            },
                            {
                                "target_lang_word": "опрашиваемый",
                                "target_lang_sense_clarification": "лицо, проходящее опрос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e8303e-cbeb-38ea-ac36-ed642fa6369d",
                    "sense_definition": "A person against whom a legal petition is filed, especially in divorce or appeal cases.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_parties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>respondent</w> has thirty days to file a formal reply to the court petition.",
                            "target_lang_translations": {
                                "ru": "У <w>ответчика</w> есть тридцать дней, чтобы подать официальный ответ на судебный иск."
                            }
                        },
                        {
                            "text": "In this divorce <w>respondent</w> case, the husband is the one being sued for legal separation.",
                            "target_lang_translations": {
                                "ru": "В этом деле о разводе <w>ответчиком</w> является муж, против которого подан иск о раздельном проживании."
                            }
                        }
                    ],
                    "synonyms": [
                        "defendant"
                    ],
                    "antonyms": [
                        "petitioner",
                        "appellant",
                        "plaintiff"
                    ],
                    "common_phrases": [
                        "divorce respondent",
                        "named respondent",
                        "respondent filed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, к которому предъявлен иск или апелляция, особенно в делах о разводе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ответчик",
                                "target_lang_sense_clarification": "сторона в судебном процессе"
                            },
                            {
                                "target_lang_word": "респондент",
                                "target_lang_sense_clarification": "ответчик по апелляции или в бракоразводном процессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "436fb7b0-e559-311f-9cdb-c02260030222",
                    "sense_definition": "A person who reacts or replies to something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "replier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a quick <w>respondent</w> to any email sent his way.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>отвечал</w> на любое присланное ему электронное письмо."
                            }
                        },
                        {
                            "text": "The <w>respondent</w> to the emergency call arrived at the scene within minutes.",
                            "target_lang_translations": {
                                "ru": "<w>Ответивший</w> на экстренный вызов прибыл на место происшествия в течение нескольких минут."
                            }
                        }
                    ],
                    "synonyms": [
                        "replier",
                        "answerer"
                    ],
                    "antonyms": [
                        "questioner",
                        "asker"
                    ],
                    "common_phrases": [
                        "quick respondent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который реагирует или отвечает на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвечающий",
                                "target_lang_sense_clarification": "тот, кто дает ответ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b82c6965-8114-34ac-b34b-33296a64494f",
                    "sense_definition": "Being in accordance or corresponding to something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "corresponding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rewards were <w>respondent</w> to the level of effort each employee put in.",
                            "target_lang_translations": {
                                "ru": "Вознаграждение было <w>соответствующим</w> уровню усилий, приложенных каждым сотрудником."
                            }
                        },
                        {
                            "text": "They sought a solution that was <w>respondent</w> to the needs of the community.",
                            "target_lang_translations": {
                                "ru": "Они искали решение, которое бы <w>отвечало</w> нуждам сообщества."
                            }
                        }
                    ],
                    "synonyms": [
                        "corresponding",
                        "accordant"
                    ],
                    "antonyms": [
                        "discrepant"
                    ],
                    "common_phrases": [
                        "respondent to"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в соответствии или отвечающий чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствующий",
                                "target_lang_sense_clarification": "согласующийся с чем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}