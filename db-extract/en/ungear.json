                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auskuppeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49b3d6bc-0f9f-3aba-a3a1-a165eabd7ffe",
                                        "entry_id": "df01e454-4eb6-3fb4-bf82-d148ae401825",
                                        "glosses": [
                                            "einen Motor vom Getriebe durch Bedienung der Kupplung trennen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57682cdb-f4de-44bb-84b2-37bbda540591",
                                                "sense_id": "49b3d6bc-0f9f-3aba-a3a1-a165eabd7ffe",
                                                "text": "Halten Sie genügend Abstand zum Vorderwagen, dann sind Sie sicherer unterwegs und können Tempounterschiede besser ausgleichen. Grünlichtphasen beobachten, rechtzeitig auskuppeln und rollen lassen."
                                            },
                                            {
                                                "example_id": "18d79185-1d3c-44fc-92e7-4d75407eecec",
                                                "sense_id": "49b3d6bc-0f9f-3aba-a3a1-a165eabd7ffe",
                                                "text": "Nicht lenken, nicht bremsen, nicht beschleunigen, keine hektischen Fahrmanöver, Fahrzeug ausgekuppelt rollen lassen und Lenkrad gerade halten: Das rät der ADAC bei Aquaplaning."
                                            },
                                            {
                                                "example_id": "cf9822b1-7308-4c08-969e-13b695e7b0b7",
                                                "sense_id": "49b3d6bc-0f9f-3aba-a3a1-a165eabd7ffe",
                                                "text": "Laut Polizei erreichte der Mann die hohen Geschwindigkeiten, indem er bergab das Getriebe seines Lastwagen auskuppelte und so immer schneller wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
