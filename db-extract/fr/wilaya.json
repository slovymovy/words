                "senses": [
                    {
                        "sense_id": "6af09f8a-9ea6-3faf-8ff0-cdb5372e8ddb",
                        "entry_id": "340c1aa1-3333-30dd-a108-9fe4ed79a999",
                        "glosses": [
                            "Division administrative qui existe dans plusieurs pays africains et asiatiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7426fad2-e5d0-4ae2-9f40-47e6d86cb192",
                                "sense_id": "6af09f8a-9ea6-3faf-8ff0-cdb5372e8ddb",
                                "text": "Cette lettre destinée à Si Belaïd, chef du Conseil de la zone III de la Wilaya IV, saisie sur le cadavre d’un rebelle, atteste de l’efficacité militaire et politique du combat engagé par les groupes d’autodéfense."
                            },
                            {
                                "example_id": "2a2c909e-8900-4854-9e2f-8a8319d5f2c2",
                                "sense_id": "6af09f8a-9ea6-3faf-8ff0-cdb5372e8ddb",
                                "text": "Abane Ramdane voulait maintenir la primauté des politiques sur les militaires et des wilayas de l’intérieur sur l’armée des frontières, ce dont les colonels de l’ALN ne voulaient pour rien au monde."
                            },
                            {
                                "example_id": "7bf97438-158e-4150-8dfa-d3c688d19b58",
                                "sense_id": "6af09f8a-9ea6-3faf-8ff0-cdb5372e8ddb",
                                "text": "La wilaya (province) d’El Tarf à l’extrême est du pays (700 km à l’est d'Alger) a été la plus durement touchée, avec au moins 30 morts dont 11 enfants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24bebd16-a4c3-45cd-b2df-4cd370ecf082",
                        "source_entry_id": "340c1aa1-3333-30dd-a108-9fe4ed79a999",
                        "source_sense_id": "6af09f8a-9ea6-3faf-8ff0-cdb5372e8ddb",
