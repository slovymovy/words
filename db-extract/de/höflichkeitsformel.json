                "senses": [
                    {
                        "sense_id": "8c4f1038-cb25-3c31-bfca-15195ae26c69",
                        "entry_id": "bdd2aeba-7f0a-3056-96e1-ee4c8a233bf8",
                        "glosses": [
                            "fester sprachlicher Ausdruck (ohne tiefere Bedeutung), der im Rahmen des höflichen Umgangs miteinander verwendet/erwartet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "756fd39a-52c8-4688-9053-fdc7682a9a9a",
                                "sense_id": "8c4f1038-cb25-3c31-bfca-15195ae26c69",
                                "text": "„Man kann es sich nicht vorstellen, mit welchen Einfällen im 18. Jahrhundert die Schreiber von Briefen sich mit Höflichkeitsformeln übertrafen, wenn sie Post an Persönlichkeiten, Verwaltungen oder Gerichte schickten.“"
                            },
                            {
                                "example_id": "587e65ec-4b61-491a-9715-0878e1f28a81",
                                "sense_id": "8c4f1038-cb25-3c31-bfca-15195ae26c69",
                                "text": "„Ich empfand, daß dieser eine Tag voller merkwürdiger Erfahrungen mich ihre liebe, tapfere Natur besser kennenlernen ließ, als es Jahre vermocht hätten, die man damit verbringt, die üblichen Höflichkeitsformeln auszutauschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
