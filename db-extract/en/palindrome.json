                                "target_senses": [
                                    {
                                        "sense_id": "289eb580-9da2-3e46-b280-783b665c4708",
                                        "entry_id": "194f79f8-6b9d-3ea6-a3ba-350494c5f525",
                                        "glosses": [
                                            "Texte dont la succession des lettres ou des chiffres est la même quand on le parcourt de gauche à droite ou de droite à gauche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea303fc6-127f-49e6-8f1d-7db69f1e9119",
                                                "sense_id": "289eb580-9da2-3e46-b280-783b665c4708",
                                                "text": "Un palindrome peut être un seul mot, comme « ressasser », une courte phrase, comme « engage le jeu que je le gagne » ; ou un texte plus long."
                                            },
                                            {
                                                "example_id": "d6b10626-d603-4360-b423-2fd8a2d4f70b",
                                                "sense_id": "289eb580-9da2-3e46-b280-783b665c4708",
                                                "text": "Le palindrome est un mot que l’on peut lire à l’endroit et à l'envers comme « radar » ou « Abba ».\nSi, en 2019, « lol » et « tkt » (= t’inquiète) étaient les palindromes préférés, en 2020, c’est « kayak » et « Xanax » que l’on retrouve sur le podium […]."
                                            },
                                            {
                                                "example_id": "4bc8cb6e-e4ce-4ffd-be09-23426777c1e0",
                                                "sense_id": "289eb580-9da2-3e46-b280-783b665c4708",
                                                "text": "« Oh cet écho » est un palidrome."
                                            },
                                            {
                                                "example_id": "f60741b7-c71e-4e28-addf-d87152f3794b",
                                                "sense_id": "289eb580-9da2-3e46-b280-783b665c4708",
                                                "text": "22-02-2022 est un palindrome correspondant à la date du 22 février 2022."
                                            },
                                            {
                                                "example_id": "afaf7cc9-b332-4966-aedd-8c500e0e39a3",
                                                "sense_id": "289eb580-9da2-3e46-b280-783b665c4708",
                                                "text": "(En apposition) 1991 est une année palindrome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa89d19-0843-391e-b0aa-a3d7be2b5ebd",
                                        "entry_id": "194f79f8-6b9d-3ea6-a3ba-350494c5f525",
                                        "glosses": [
                                            "Séquence palindromique."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d3b8983-83dd-463b-acb6-d9c5ab7b2f50",
                        "source_entry_id": "52277a8e-6e0d-3595-b864-cce965ed7b78",
                        "source_sense_description": "a sequence of units that reads the same forwards as backwards",
                        "target_lang_word": "Palindrom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palindrom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9b9ec7b-cfa8-381d-8a18-162b72e336dc",
                                        "entry_id": "1a8e2d87-5e56-3954-9a98-731768903967",
                                        "glosses": [
                                            "ein Wort oder ein Satz, der sowohl vorwärts als auch rückwärts gelesen dieselbe oder zumindest eine sinnvolle Bedeutung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079e2042-5a6f-41f9-95a1-31176da7000d",
                                                "sense_id": "e9b9ec7b-cfa8-381d-8a18-162b72e336dc",
                                                "text": "Palindrome im Deutschen sind zum Beispiel: „Reliefpfeiler – Reliefpfeiler, Rentner - Rentner.“"
                                            },
                                            {
                                                "example_id": "fd931f08-ae74-41e9-b6bc-e6e4d63d58eb",
                                                "sense_id": "e9b9ec7b-cfa8-381d-8a18-162b72e336dc",
                                                "text": "„Aus zwei Palindromen P und Q lässt sich bei zerlegbarem P=v,vᴿ ein drittes Palindrom S bilden mit S=v,Q,vᴿ. Beispielsweise ergibt sich aus P = 'Regallager' und Q = 'neben' das neue Palindrom S = 'Regalnebenlager'.“"
                                            },
                                            {
                                                "example_id": "aa3c233a-9d3e-450f-8a4d-fae09b1fd45b",
                                                "sense_id": "e9b9ec7b-cfa8-381d-8a18-162b72e336dc",
                                                "text": "„Ich kannte eine Ninel, das Palindrom von Lenin…“"
                                            },
                                            {
                                                "example_id": "46ed6f75-b552-49d3-84c3-edb0fa9d3c2a",
                                                "sense_id": "e9b9ec7b-cfa8-381d-8a18-162b72e336dc",
                                                "text": "„Er ist ein Palindrom, das heißt, er ist von hinten wie von vorn gleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "828bda39-2f94-3300-be22-0de92fce5c25",
                                        "entry_id": "1a8e2d87-5e56-3954-9a98-731768903967",
                                        "glosses": [
                                            "Ziffernfolge, die sowohl vorwärts als auch rückwärts gelesen denselben Zahlenwert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d072c438-2352-43be-a886-98632f4da966",
                                                "sense_id": "828bda39-2f94-3300-be22-0de92fce5c25",
                                                "text": "Es ist ein ungelöstes Problem, ob die Zahl 196 nach einer endlichen Zahl von Inversionen ein Palindrom ergibt, wenn man ihre Ziffern in umgekehrter Reihenfolge aufschreibt (691), die beiden Zahlen addiert (196 + 691 = 887) und diese Operation wiederholt fortsetzt (887 + 788 = 1675)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fc62841c-6888-3312-bae3-235464e2ee81",
                                        "entry_id": "1a8e2d87-5e56-3954-9a98-731768903967",
                                        "glosses": [
                                            "ein Wort, welches identisch ist mit seiner Spiegelung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f85f1e8-4859-4da8-b20a-905b3959daf1",
                                                "sense_id": "fc62841c-6888-3312-bae3-235464e2ee81",
                                                "text": "Die Wörter w_1=aba und w_2=babbab über dem Alphabet Σ={a,,b} sind Palindrome."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7c2fb635-477f-3584-859b-9d52206da92a",
                                        "entry_id": "1a8e2d87-5e56-3954-9a98-731768903967",
                                        "glosses": [
                                            "Basensequenz von DNA oder RNA, die gegenläufig bei komplementärer Basenpaarung die gleiche Basenfolge ergibt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
