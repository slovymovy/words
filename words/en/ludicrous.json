                    "sense_id": "9972a53a-1b30-3cd5-945d-9031dbc5bf45",
                    "sense_definition": "Completely unreasonable, idiotic, or unthinkable, often in a way that is funny or absurd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absurdity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician made a <w>ludicrous</w> attempt to run for office without any funding or support.",
                            "target_lang_translations": {
                                "ru": "Политик предпринял <w>нелепую</w> попытку баллотироваться на пост без какого-либо финансирования или поддержки."
                            }
                        },
                        {
                            "text": "It is a <w>ludicrous</w> suggestion to think that we can finish this entire project by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Это <w>абсурдное</w> предложение — думать, что мы сможем закончить весь этот проект к завтрашнему утру."
                            }
                        }
                    ],
                    "synonyms": [
                        "laughable",
                        "ridiculous",
                        "risible"
                    ],
                    "antonyms": [
                        "reasonable",
                        "sensible",
                        "serious"
                    ],
                    "common_phrases": [
                        "ludicrous suggestion",
                        "absolutely ludicrous",
                        "ludicrous amount"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенно необоснованный, идиотский или немыслимый, часто в смешном или абсурдном ключе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нелепый",
