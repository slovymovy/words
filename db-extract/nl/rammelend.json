                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c21ebd1b-f816-3e33-acf1-037d27fb2087",
                        "entry_id": "ddb6c344-439d-3612-a106-99d4b304bec9",
                        "glosses": [
                            "van een geluid gemaakt door zaken die niet goed vastzitten of liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aebf9569-f483-42b5-830e-1a59b6af0bdf",
                                "sense_id": "c21ebd1b-f816-3e33-acf1-037d27fb2087",
                                "text": "Wat gaan burgemeester en wethouders van Berkelland doen aan de 'rammelende’ stenen in de Oudestraat in Neede? Dat vraagt CDA-raadslid Maikel van der Neut zich af."
                            },
                            {
                                "example_id": "1a8e1ef1-3cc5-4d78-922c-5b5e172205e0",
                                "sense_id": "c21ebd1b-f816-3e33-acf1-037d27fb2087",
                                "text": ",,Alleen kijken hè’’, klinkt het jolig vanuit een glazen kantoortje. ,,Hier hou ik van’’, roept Erades enthousiast als hij aan een rammelende stang draait."
                            }
                        ]
                    },
                    {
                        "sense_id": "4da2cfe7-8cdb-3713-b400-e421024ea90c",
                        "entry_id": "ddb6c344-439d-3612-a106-99d4b304bec9",
                        "glosses": [
                            "van iets dat het van slechte kwaliteit is; van iets dat het slecht georganiseerd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3000184-de2d-43e6-b0f7-f8cfd5793388",
                                "sense_id": "4da2cfe7-8cdb-3713-b400-e421024ea90c",
                                "text": "Daar zou veel kritiek te lezen zijn op de rammelende hulp aan overstromingsslachtoffers. Frankrijk en Duitsland hebben Iran inmiddels reddingsboten geleverd."
                            }
                        ]
                    }
