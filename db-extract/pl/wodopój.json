                                "target_word": "водопой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53e512e0-7dd2-3dad-a42b-fcb126a72e1e",
                                        "entry_id": "a0641099-f3f6-3ec0-856d-a2697c0d1ad5",
                                        "glosses": [
                                            "место на реке, озере и т. п., где поят скот или куда приходят пить звери"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f7c98d-6fd1-43b3-ab5f-9f567d88167e",
                                                "sense_id": "53e512e0-7dd2-3dad-a42b-fcb126a72e1e",
                                                "text": "На водопой скот гонят три бабы, а прежде гоняла одна."
                                            },
                                            {
                                                "example_id": "010f5446-ccbb-47b1-b37a-b2e355441366",
                                                "sense_id": "53e512e0-7dd2-3dad-a42b-fcb126a72e1e",
                                                "text": "На отмели мы увидели следы молодых и взрослых лосей, приходивших к водопою, но самих животных не видно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ecd8c9d-4580-3384-8e88-5491588085e7",
                                        "entry_id": "a0641099-f3f6-3ec0-856d-a2697c0d1ad5",
                                        "glosses": [
                                            "устар. питьё воды, поение водой (обычно о зверях, животных)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad4f8d8a-1e9f-402a-88ea-f32e00c135f1",
                                                "sense_id": "5ecd8c9d-4580-3384-8e88-5491588085e7",
                                                "text": "Перед вечером иду опять гулять, купаться и наконец возвращаюсь присутствовать при вечернем водопое."
                                            },
                                            {
                                                "example_id": "266b9d58-6519-4936-abe6-a7ab197e9805",
                                                "sense_id": "5ecd8c9d-4580-3384-8e88-5491588085e7",
                                                "text": "Такими местами служат колодцы, возле которых бывает обыкновенно разлито немного водицы при водопое скота."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
