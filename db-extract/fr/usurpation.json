        "fr-extract.jsonl": [
            {
                "entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                "word": "usurpation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "30483930-8efd-4f6c-ba2d-7accd719afdf",
                        "entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                        "tags": [
                            "plural"
                        ],
                        "form": "usurpations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                        "entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                        "glosses": [
                            "Action d’usurper ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7844e447-6cd4-4ef0-a542-a893b60a04c0",
                                "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                                "text": "J’en appellerai à Rome contre toi, répondit le grand maître, pour usurpation sur les immunités et privilèges de notre ordre."
                            },
                            {
                                "example_id": "a7dea2a6-d7b8-4798-b0fd-dd2279aa994f",
                                "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                                "text": "Les États-Unis ont hérité de l’Angleterre ce système d’envahissement et d’usurpation continuel qui est un des points les plus saillants du caractère britannique."
                            },
                            {
                                "example_id": "217846be-57dc-41bf-87d8-fb2f007ddfac",
                                "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                                "text": "[…], il se laissa imposer le titre de roi des Français sous le nom de Louis-Philippe Iᵉʳ (7 août 1830). C'était une usurpation audacieuse de la souveraineté nationale; l'avènement de la branche cadette peut être qualifiée un escamotage."
                            }
                        ]
                    },
                    {
                        "sense_id": "24180d4e-3776-3643-bc76-eab32134a172",
                        "entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                        "glosses": [
                            "La chose même qui est usurpée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3e0128e6-e8b2-41d9-af68-c488fb68446b",
                                "sense_id": "24180d4e-3776-3643-bc76-eab32134a172",
                                "text": "La plupart des terres de cette seigneurie n’étaient que des usurpations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70a8c09d-20c4-454a-a811-8945ea344fb8",
                        "source_entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                        "target_lang_word": "Aneignung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aneignung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "Inbesitznahme einer herrenlosen Sache"
                                        ],
                                        "tags": [
                                            "Sachenrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21153ecf-1dee-498e-835d-c678598bf082",
                                                "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                                "text": "„Mit der privaten Aneignung des Grund und Bodens, der sowohl als wichtigstes Produktionsmittel als auch als Produktionsgegenstand diente, war auch die private Aneignung des Viehs verbunden.“"
                                            },
                                            {
                                                "example_id": "ad1b9df3-1c23-460f-8326-9c1ddc86c28c",
                                                "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                                "text": "„Dazu wurde vertreten, dass sich die Aneignung von herrenlosem Land in Deutsch-Südwestafrika nicht als besonderes Vorrecht des Schutzgebietsfiskus darstelle, da es auch von Privaten ausgeübt werden könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "unrechtmäßige Inbesitznahme einer Sache"
                                        ],
                                        "tags": [
                                            "Sachenrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98dae93-56cc-484f-9095-3b5514eae51e",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„Die englische Herrschaft über Irland ging in den folgenden 200 Jahren mit einer weitgehenden Aneignung des Grundbesitzes durch die Engländer und einer Lähmung der irischen Wirtschaft einher.“"
                                            },
                                            {
                                                "example_id": "5a085802-1310-4ae1-b285-c2dd0df010d4",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„So raubte der IS etwa beim Einmarsch in Mossul im vergangenen Jahr Millionen von Dollar aus den Tresoren der örtlichen Banken – ganz zu schweigen von der Aneignung des Militärgeräts der irakischen Armee, die Hals über Kopf aus der Stadt geflüchtet war und den Terroristen damit einiges an Ausgaben ersparte.“"
                                            },
                                            {
                                                "example_id": "a42dc293-9d2c-466b-ad56-ccc410d5f490",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„Chinas historische Begründung für seine Expansion im Südchinesischen Meer ist nicht anerkannt und mit der Aneignung der Inseln verstößt China gegen das Seerechtsübereinkommen der Vereinten Nationen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "Erwerb von Wissen, Fähigkeiten, Verhaltensweisen, Ideologien oder Ähnlichem, beispielsweise durch Lernen, Üben oder Angewöhnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e014f35c-d498-41dc-9384-18612d9c07d6",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Die Aneignung einer Fremdsprache unterscheidet sich von der Aneignung einer Zweitsprache primär dadurch, dass der erste Prozess nur auf einige Stunden pro Woche reduziert ist.“"
                                            },
                                            {
                                                "example_id": "65f65ea2-2903-4842-b108-2f98df256d2e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Trotz der Aneignung von Traditionen bleibt Picasso immer er selbst.“"
                                            },
                                            {
                                                "example_id": "9bb334ba-5629-4556-9c75-719b4883e0a3",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Übersehen wird dabei, dass es beim Denglischen nicht um eine aktive, aufgeschlossene Aneignung des Fremden geht, sondern um eine wachsende sprachliche Monokultur auch unter den Intellektuellen.“"
                                            },
                                            {
                                                "example_id": "f5692867-042b-4ccb-a28e-95f8e23a280e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Der Traditionsbruch und die Öffnung zum Westen, zu dem ja auch die teilweise Aneignung des Leninismus gehört, hätten es tatsächlich geschafft, dass sich die Nation jetzt gegenüber dem Westen behaupten könne - was jedoch keineswegs heißt, dass historische Kontinuitäten als Legitimationsquelle für die Kommunisten nicht wichtig wären.“"
                                            },
                                            {
                                                "example_id": "a6f32482-30e2-43f5-a2a0-72ad68c163b4",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Zentral sei in der Wiener Lehrerausbildung nun die Aneignung von etwa 30 Kernkompetenzen wie zum Beispiel der Innovationskompetenz, der Reflexionskompetenz, der Prüfungskompetenz, des Durchhaltevermögens oder gar der Kompetenzorientierungskompetenz.“"
                                            },
                                            {
                                                "example_id": "1a5b930a-3ba3-4879-938f-3c866ee7640e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Musik sei entstanden durch Vermischung der Kulturen und Wanderung. Er mache die Musik, die er fühle. ‚Wenn jemand anders sagt, das ist kulturelle Aneignung, dann interessiert mich das einen Scheißdreck‘, so Schneider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad407b8c-d183-45f8-8472-a8efbb1531ca",
                        "source_entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                        "target_lang_word": "Führung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Führung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6f637c-2ecd-3bb6-842d-bd96adc1b4b7",
                                        "entry_id": "a47907c1-036f-3a63-b359-6e62d907e211",
                                        "glosses": [
                                            "die Handlung, der Prozess oder die Tätigkeit, ein bewegliches Objekt oder eine Person/Personengruppe zu steuern, in eine Richtung oder ein Verhalten zu weisen oder zu führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b809cc-7f5b-4f36-aacd-79d71b7a7547",
                                                "sense_id": "ea6f637c-2ecd-3bb6-842d-bd96adc1b4b7",
                                                "text": "Der Manager übernahm die Führung des Projekts, damit der Betrieb das Ziel erreichte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64fd8d96-7cb6-3acb-a870-7d37c815e277",
                                        "entry_id": "a47907c1-036f-3a63-b359-6e62d907e211",
                                        "glosses": [
                                            "das Recht oder die Rolle einer leitenden Person in einem Unternehmen, Leitungsaufgaben auszuführen, insbesondere zu personellen Maßnahmen, wie Arbeitseinteilung, Personaleinstellung und -entlassung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600c48ba-adfe-45dd-baa5-5cd92358dca2",
                                                "sense_id": "64fd8d96-7cb6-3acb-a870-7d37c815e277",
                                                "text": "Der Geschäftsführer hat die Führung über das Personal und entschied leider bei dem Konkurs, 500 Arbeiter zu entlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e38d01eb-6b74-397e-8b23-d03c41155c00",
                                        "entry_id": "a47907c1-036f-3a63-b359-6e62d907e211",
                                        "glosses": [
                                            "eine leitende oder führende (Spitzen-)Person oder Personengruppe, welche in einem Unternehmen, einer Institution, einer Partei, einem Verein oder Ähnlichem, Führungsaufgaben ausführen darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c637eab-3401-45cb-8d7f-670e15f95a39",
                                                "sense_id": "e38d01eb-6b74-397e-8b23-d03c41155c00",
                                                "text": "Werner sollte sich gestern für sein schlechtes Benehmen bei der Führung verantworten."
                                            },
                                            {
                                                "example_id": "326c00d8-d533-43d1-bf5d-d6166f56ef5c",
                                                "sense_id": "e38d01eb-6b74-397e-8b23-d03c41155c00",
                                                "text": "„In der Parole der Montagsdemonstrationen nun wird dieser Vorstellungsinhalt genau umgedreht: Nicht das Volk zieht an der Führung, sondern die Führung zieht am Volk vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9e63d03e-91b3-3ce4-9bca-90e67884b11f",
                                        "entry_id": "a47907c1-036f-3a63-b359-6e62d907e211",
                                        "glosses": [
                                            "das Objekt selbst, wie etwa ein Maschinenelement, welches einem anderen Bauteil beziehungsweise Bauelement eine bestimmte, zielgerichtete, geführte Bewegungsrichtung oder Position aufzwingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f53f8175-0486-4401-b238-9a536fc38833",
                                                "sense_id": "9e63d03e-91b3-3ce4-9bca-90e67884b11f",
                                                "text": "Der Ständer ist mit Führungen an die Maschine befestigt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a60c7548-d034-3776-a29c-201e93fe2456",
                                        "entry_id": "a47907c1-036f-3a63-b359-6e62d907e211",
                                        "glosses": [
                                            "eine geleitete Besichtigung, zumeist mit entsprechenden Erklärungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5701f78-7be6-4ef3-9af1-37215f30e12c",
                                                "sense_id": "a60c7548-d034-3776-a29c-201e93fe2456",
                                                "text": "Viele Museen bieten Führungen an."
                                            },
                                            {
                                                "example_id": "2bcc9d5f-5148-40cb-a44d-622a03570c87",
                                                "sense_id": "a60c7548-d034-3776-a29c-201e93fe2456",
                                                "text": "„Dann aber klingelte eine Glocke und rief zur Führung, und Papa und ich gingen mit einer Gruppe von Menschen durch die Burg, die von einem Burgführer geführt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "5f43a2b9-85a9-3dc7-95b8-fe3e6b9c9df6",
                                        "entry_id": "a47907c1-036f-3a63-b359-6e62d907e211",
                                        "glosses": [
                                            "zeitlicher oder räumlicher Vorsprung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c63a2d3-036b-4d69-b900-aa10ccdd1ba1",
                                                "sense_id": "5f43a2b9-85a9-3dc7-95b8-fe3e6b9c9df6",
                                                "text": "Bayern München liegt mit 2:1 in Führung."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "969d434c-445c-47fc-9d3a-a357244903bd",
