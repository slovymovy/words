    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd47203c-3f3e-3698-af9e-378ce4b87b6c",
                    "sense_definition": "A great flood or a very heavy downpour of rain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>deluge</w> continued for hours, drenching the land and slowing traffic to a halt.",
                            "target_lang_translations": {
                                "ru": "<w>Ливень</w> продолжался несколько часов, пропитав землю влагой и парализовав движение транспорта."
                            }
                        },
                        {
                            "text": "After the sudden <w>deluge</w> of rain, the streets were completely underwater.",
                            "target_lang_translations": {
                                "ru": "После внезапного <w>потопа</w>, вызванного дождем, улицы полностью ушли под воду."
                            }
                        }
                    ],
                    "synonyms": [
                        "flood",
                        "downpour",
                        "inundation",
                        "torrent"
                    ],
                    "antonyms": [
                        "drought"
                    ],
                    "common_phrases": [
                        "sudden deluge",
                        "deluge of rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное наводнение или очень мощный проливной дождь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потоп",
                                "target_lang_sense_clarification": "сильное наводнение"
                            },
                            {
                                "target_lang_word": "ливень",
                                "target_lang_sense_clarification": "сильный дождь"
                            },
                            {
                                "target_lang_word": "наводнение",
                                "target_lang_sense_clarification": "затопление местности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae5d6e8-cf12-3f04-8c3d-864d10d91197",
                    "sense_definition": "An overwhelming amount of something that arrives all at once.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overwhelm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rock concert was a <w>deluge</w> of sound that left the audience breathless.",
                            "target_lang_translations": {
                                "ru": "Рок-концерт превратился в настоящий <w>поток</w> звука, от которого у зрителей перехватило дыхание."
                            }
                        },
                        {
                            "text": "The company received a <w>deluge</w> of complaints after the software update failed.",
                            "target_lang_translations": {
                                "ru": "Компания получила <w>лавину</w> жалоб после неудачного обновления программного обеспечения."
                            }
                        }
                    ],
                    "synonyms": [
                        "flood",
                        "avalanche",
                        "barrage",
                        "torrent"
                    ],
                    "antonyms": [
                        "trickle"
                    ],
                    "common_phrases": [
                        "deluge of complaints",
                        "deluge of information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огромное количество чего-либо, поступающее одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "большое количество информации или жалоб"
                            },
                            {
                                "target_lang_word": "лавина",
                                "target_lang_sense_clarification": "огромная масса чего-либо"
                            },
                            {
                                "target_lang_word": "град",
                                "target_lang_sense_clarification": "множество ударов, вопросов или критики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1953d957-dd55-3f17-88ef-684c4aa09311",
                    "sense_definition": "A specialized system for flooding an area with water to extinguish a fire in an emergency.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fire_safety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warehouse is protected by a high-capacity <w>deluge</w> system to prevent fire spread.",
                            "target_lang_translations": {
                                "ru": "Склад защищен мощной <w>дренчерной</w> системой для предотвращения распространения огня."
                            }
                        },
                        {
                            "text": "In the event of an overtemperature condition, the <w>deluge</w> system sprays cooling water immediately.",
                            "target_lang_translations": {
                                "ru": "В случае перегрева <w>противопожарная</w> система немедленно распыляет охлаждающую воду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deluge system",
                        "deluge gun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специализированная система для затопления территории водой с целью тушения пожара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дренчерная система",
                                "target_lang_sense_clarification": "технический термин для систем пожаротушения"
                            },
                            {
                                "target_lang_word": "система водяного завеса",
                                "target_lang_sense_clarification": "противопожарная защита"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33ca8cde-c148-3412-a88d-ad72741bdc2d",
                    "sense_definition": "To flood a place with a large volume of water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some areas were <w>deluged</w> with a month's worth of rain in just 24 hours.",
                            "target_lang_translations": {
                                "ru": "Некоторые районы были <w>затоплены</w> месячной нормой осадков всего за 24 часа."
                            }
                        },
                        {
                            "text": "The river burst its banks and <w>deluged</w> the nearby farmland.",
                            "target_lang_translations": {
                                "ru": "Река вышла из берегов и <w>залила</w> близлежащие сельскохозяйственные угодья."
                            }
                        }
                    ],
                    "synonyms": [
                        "flood",
                        "inundate",
                        "submerge",
                        "swamp"
                    ],
                    "antonyms": [
                        "drain"
                    ],
                    "common_phrases": [
                        "deluged with rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затопить какое-либо место большим объемом воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затоплять",
                                "target_lang_sense_clarification": "покрывать водой"
                            },
                            {
                                "target_lang_word": "заливать",
                                "target_lang_sense_clarification": "наполнять водой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0104564-eb1d-3301-a479-7bae05b0b443",
                    "sense_definition": "To overwhelm someone with a huge quantity of something, such as work or information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overwhelm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the announcement, they were <w>deluged</w> with requests for more information.",
                            "target_lang_translations": {
                                "ru": "После объявления их <w>завалили</w> просьбами о предоставлении дополнительной информации."
                            }
                        },
                        {
                            "text": "The customer service team was <w>deluged</w> with calls following the product launch.",
                            "target_lang_translations": {
                                "ru": "Служба поддержки была <w>засыпана</w> звонками после запуска продукта."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelm",
                        "swamp",
                        "inundate",
                        "bombard"
                    ],
                    "common_phrases": [
                        "deluged with requests",
                        "deluged with mail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завалить кого-либо огромным количеством чего-либо (работой, информацией)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заваливать",
                                "target_lang_sense_clarification": "обременять работой или просьбами"
                            },
                            {
                                "target_lang_word": "наводнять",
                                "target_lang_sense_clarification": "заполнять рынок или пространство"
                            },
                            {
                                "target_lang_word": "засыпать",
                                "target_lang_sense_clarification": "вопросами или письмами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9438556c-778d-3dcd-83f4-c4560d77efd9",
                    "sense_definition": "The great flood described in religious texts like the Bible and the Qur'an.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flood",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Many ancient cultures have stories that parallel the biblical account of the <w>Deluge</w>.",
                            "target_lang_translations": {
                                "ru": "У многих древних культур есть истории, параллельные библейскому повествованию о <w>Всемирном потопе</w>."
                            }
                        },
                        {
                            "text": "Noah built an ark to save his family and animals from the <w>Deluge</w>.",
                            "target_lang_translations": {
                                "ru": "Ной построил ковчег, чтобы спасти свою семью и животных от <w>Потопа</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Great Flood"
                    ],
                    "common_phrases": [
                        "the Deluge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Великий потоп, описанный в религиозных текстах, таких как Библия и Коран."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Всемирный потоп",
                                "target_lang_sense_clarification": "библейское событие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}