                        "glosses": [
                            "Donner un caractère photovoltaïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eca300c-7c05-4fef-bf5a-6beea5b6daa5",
                                "sense_id": "c3680144-eab2-30f8-bea9-3e8c0fbbb3a0",
                                "text": "\"Photovoltaïser\" les routes, c'est photovoltaïser des surface \"existantes\", sans se mettre à construire des immenses fermes un peu partout."
                            },
                            {
                                "example_id": "ba1f8ea8-cbce-429b-bf01-59c1e48b3a23",
                                "sense_id": "c3680144-eab2-30f8-bea9-3e8c0fbbb3a0",
                                "text": "Je signe parce qu'au Revest aussi la municipalité veut photovoltaïser le plateau de Tourris"
                            },
                            {
                                "example_id": "2c3f08fb-4968-40f9-82b7-144aa3cf24d5",
                                "sense_id": "c3680144-eab2-30f8-bea9-3e8c0fbbb3a0",
                                "text": "Sympatique rassemblement à Uxegney dans le manège « photovoltaïsé » des écuries de la Violle de Hugues Bonvalot et Sandra Perini."
                            }
                        ]
                    }
