                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2f5b8407-2d2d-31f4-9165-d5e47058f52a",
                        "entry_id": "09a66af0-e515-3f2a-a6f8-2186a271face",
                        "glosses": [
                            "A traverse table."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45d9842-04d8-462c-b23e-ae519c387a8b",
                                "sense_id": "2f5b8407-2d2d-31f4-9165-d5e47058f52a",
                                "text": "As the pithead (Fig. 15) had not been designed for large wide gauge cars it was necessary to replace the usual runround with a traverser."
                            },
                            {
                                "example_id": "17b9d804-01e7-48fc-8bd6-8f6b6eb31cb6",
                                "sense_id": "2f5b8407-2d2d-31f4-9165-d5e47058f52a",
                                "text": "Before I left Paris I had the chance to visit La Chapelle depot. I was fascinated by the place. Basically, the steam depot is divided into two halves, the repair side and the steam side, with a traverser in between."
                            },
                            {
                                "example_id": "99a99ec7-a053-4d8f-bb7d-33428bed1377",
                                "sense_id": "2f5b8407-2d2d-31f4-9165-d5e47058f52a",
                                "text": "The outside sidings and test areas are rail-connected at the western end to the Down Service line, whilst the test area and assembly area are connected via a traverser at the eastern end of the site."
                            }
                        ]
                    }
                ],
