                                    },
                                    {
                                        "sense_id": "90e085f3-0050-33a7-838f-e2288d29a38c",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "A recognizable natural or man-made feature used for navigation."
