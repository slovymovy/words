{
    "word_family": [
        "sleight-of-hand"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b4e9e76-9dc9-37c3-882f-d8f8f3c40003",
                    "sense_definition": "The use of cunning or craft to achieve a goal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cunning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician relied on <w>sleight</w> rather than honest persuasion to win the election.",
                            "target_lang_translations": {
                                "ru": "Политик полагался на <w>хитрость</w>, а не на честное убеждение, чтобы выиграть выборы."
                            }
                        },
                        {
                            "text": "Through sheer <w>sleight</w> and determination, she managed to outsmart her competitors.",
                            "target_lang_translations": {
                                "ru": "Благодаря чистой <w>хитрости</w> и решимости ей удалось перехитрить своих конкурентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "craftiness",
                        "guile",
                        "cunning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование хитрости или коварства для достижения цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "уловка, коварство"
                            },
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием"
                            },
                            {
                                "target_lang_word": "коварство",
                                "target_lang_sense_clarification": "скрытый обман"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91b328c4-dd15-3a58-9a1a-4e73bb6e84cb",
                    "sense_definition": "A clever trick or feat performed with such speed and skill that it is difficult to see how it was done.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician performed a <w>sleight</w> that left the entire audience completely amazed.",
                            "target_lang_translations": {
                                "ru": "Иллюзионист показал <w>фокус</w>, который привел всю публику в полное изумление."
                            }
                        },
                        {
                            "text": "It was a simple <w>sleight</w> of hand that made the coin disappear from his palm.",
                            "target_lang_translations": {
                                "ru": "Это была простая <w>ловкость</w> рук, благодаря которой монета исчезла из его ладони."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "artifice",
                        "maneuver"
                    ],
                    "common_phrases": [
                        "sleight of hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусный трюк или фокус, выполняемый с такой быстротой и мастерством, что трудно заметить, как он был сделан."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фокус",
                                "target_lang_sense_clarification": "ловкий трюк"
                            },
                            {
                                "target_lang_word": "трюк",
                                "target_lang_sense_clarification": "иллюзионный прием"
                            },
                            {
                                "target_lang_word": "ловкость",
                                "target_lang_sense_clarification": "ловкий прием, как в sleight of hand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bff39440-45bf-3366-b3ac-465ae681ec84",
                    "sense_definition": "Great skill or dexterity in performing a task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played the complex piece with incredible <w>sleight</w> and grace.",
                            "target_lang_translations": {
                                "ru": "Пианист исполнил сложное произведение с невероятной <w>ловкостью</w> и изяществом."
                            }
                        },
                        {
                            "text": "Years of practice gave the surgeon the <w>sleight</w> required for such delicate operations.",
                            "target_lang_translations": {
                                "ru": "Годы практики дали хирургу <w>сноровку</w>, необходимую для столь деликатных операций."
                            }
                        }
                    ],
                    "synonyms": [
                        "dexterity",
                        "skill",
                        "adroitness"
                    ],
                    "antonyms": [
                        "clumsiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое мастерство или сноровка при выполнении какой-либо задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловкость",
                                "target_lang_sense_clarification": "физическая или моторная сноровка"
                            },
                            {
                                "target_lang_word": "сноровка",
                                "target_lang_sense_clarification": "умение и навык"
                            },
                            {
                                "target_lang_word": "мастерство",
                                "target_lang_sense_clarification": "высокий уровень умения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a8b7528e-27fa-3823-bf87-e5672e6c2fc7",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by a professor named <w>Sleight</w>.",
                            "target_lang_translations": {
                                "ru": "Исследовательская работа была написана профессором по фамилии <w>Слайт</w>."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Sleight</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я познакомился с человеком по фамилии мистер <w>Слайт</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Слайт",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}