                "senses": [
                    {
                        "sense_id": "ef9d86bc-b52c-3996-a1ff-9c1a2590ff95",
                        "entry_id": "6c3250c5-58b9-3068-8b26-6058cc805293",
                        "glosses": [
                            "Dormir plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfdeae13-6f44-4afd-b45e-e93572214e0a",
                                "sense_id": "ef9d86bc-b52c-3996-a1ff-9c1a2590ff95",
                                "text": "Pour y résister, on n'a encore rien trouvé de mieux que de dormir, et même \"surdormir\" durant les quatre ou cinq jours précédant l'épreuve."
                            },
                            {
                                "example_id": "80dbf6f0-7fc5-477d-b4e0-a140247ad326",
                                "sense_id": "ef9d86bc-b52c-3996-a1ff-9c1a2590ff95",
                                "text": "Mon occupation préférée: rêver, rajouter de l'équipement à mes pj, rire, DORMIR, SURDORMIR, enfin comme vous voyez trop de choses."
                            }
                        ]
                    }
