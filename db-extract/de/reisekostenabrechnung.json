                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a1c1301-8a6a-375c-ae07-d10bc9733d01",
                        "entry_id": "cddf46e3-71bd-32ff-b127-6d58b1ab8f9c",
                        "glosses": [
                            "Genehmigungsantrag oder Dokument, auf dem die entstandenen Kosten zu einer Geschäfts- oder Dienstreise detailliert dargelegt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6c1fe4-0a7c-4b2a-8ef7-7b9608602648",
                                "sense_id": "6a1c1301-8a6a-375c-ae07-d10bc9733d01",
                                "text": "„Eine ordnungsgemäße Reisekostenabrechnung ist notwendig, damit die Finanzbehörde (z. B. bei Betriebsprüfungen) nachvollziehen kann, ob die Reisekosten im Einklang mit den steuerlichen Vorschriften stehen.“"
                            },
                            {
                                "example_id": "c92bee37-6ef9-4cbd-afe8-5f7f450b7a73",
                                "sense_id": "6a1c1301-8a6a-375c-ae07-d10bc9733d01",
                                "text": "„Von der eintägigen Inlandsreise bis zum mehrtägigen Auslandsaufenthalt - wir sind in allen Fällen der Reisekostenabrechnung Ihr kompetenter Partner!“"
                            },
                            {
                                "example_id": "94a06ea2-e6c4-4cb8-9d95-bba45874de9f",
                                "sense_id": "6a1c1301-8a6a-375c-ae07-d10bc9733d01",
                                "text": "„Kann eine falsche Reisekostenabrechnung Grund für eine Kündigung sein? “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
