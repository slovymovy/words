                ],
                "senses": [
                    {
                        "sense_id": "504af33e-9d17-3ed3-8094-abbdd4beb3a6",
                        "entry_id": "a696fb41-3ccb-3c64-9b19-c9fda7a40218",
                        "glosses": [
                            "een product, middel dat een organisme kan gebruiken om zich te voeden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9061d9b7-8aa5-4740-872e-dbdb481bcdc0",
                                "sense_id": "504af33e-9d17-3ed3-8094-abbdd4beb3a6",
                                "text": "Het bedrijf is een gigant in zuivel, snacks en andere voedingsmiddelen."
                            },
                            {
                                "example_id": "7eff1c24-1fa7-40f7-acad-0142f2a6ade0",
                                "sense_id": "504af33e-9d17-3ed3-8094-abbdd4beb3a6",
                                "text": "Kleurstoffen zorgen ervoor dat de natuurlijke kleur van het voedingsmiddel minder snel gaat vervagen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da8080d6-546b-48b5-be59-b6ed7944ce5d",
                        "source_entry_id": "a696fb41-3ccb-3c64-9b19-c9fda7a40218",
                        "source_sense_id": "504af33e-9d17-3ed3-8094-abbdd4beb3a6",
                        "source_sense_description": "een product, middel dat een organisme kan gebruiken om zich te voeden",
                        "target_lang_word": "Nahrungsmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nahrungsmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                        "entry_id": "fc4e76e1-1347-3afd-8219-40985cdee0d4",
                                        "glosses": [
                                            "Speisen und Getränke, die dem Menschen und seinem Körper zur Ernährung, also seiner Versorgung mit Energie, Baustoffen und Vitaminen dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e19faf-09c0-4bdf-85dc-71423b4ec831",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "Nur wertvolle Nahrungsmittel sollten den Hunger vieler Kinder stillen."
                                            },
                                            {
                                                "example_id": "856f4297-3173-4980-924a-16ca14660850",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Mit dem Begriff Nahrungsmittel bezeichnet man eine inhomogene Gruppe organischer Stoffe tierischer oder pflanzlicher Herkunft und deren Zubereitungen, sowie bestimmte Salze und Flüssigkeiten.“"
                                            },
                                            {
                                                "example_id": "119600ca-b7b0-4047-946d-a566fcfb09fc",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Die heute am weitesten verbreitete, schonendste und effektivste Methode zum Haltbarmachen von Nahrungsmitteln ist […] die Kühlung bzw. Tiefkühlung.“"
                                            },
                                            {
                                                "example_id": "7d6f9a40-4778-425f-8833-7bb094ef2c30",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            },
                                            {
                                                "example_id": "1e0a50ac-6fe7-4700-8d7b-87ab794e078b",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            },
                                            {
                                                "example_id": "39261fde-d8e1-48a2-989a-dd571df90787",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Wir durften nicht einmal ein Boot an Land schicken, um frische Nahrungsmittel zu beschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
