                ],
                "senses": [
                    {
                        "sense_id": "8cb85016-813b-3042-89d8-3b7d019dd2b7",
                        "entry_id": "abf39830-710b-3a80-970f-8dcf80d9ad3e",
                        "glosses": [
                            "uit, volgens of met betrekking tot de Bijbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d5908d1-a24e-4e74-94c2-c6f68a7325f7",
                                "sense_id": "8cb85016-813b-3042-89d8-3b7d019dd2b7",
                                "text": "Nederlandse uitdrukkingen gaan vaker op Bijbelse voorbeelden terug dan mensen zich realiseren."
                            },
                            {
                                "example_id": "4b54485b-02b7-42ca-a685-de3a95d859d0",
                                "sense_id": "8cb85016-813b-3042-89d8-3b7d019dd2b7",
                                "text": "„Dit is de koele realiteit”, zegt Wallen. „Ik zeg dit niet uit hoogmoed, ik zeg het niet uit arrogantie, ik zeg het als een Bijbels feit.” Hij wipt op de bal van zijn voet, op het ritme van zijn zinnen. „Niet iedereen hoort bij de familie van God. Niet iedereen gaat naar de hemel. Niet iedereen zal gered worden.”"
                            }
                        ]
                    }
                ],
