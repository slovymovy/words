    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03903884-a96a-368a-bff7-8d4c9bc7dfe2",
                    "sense_definition": "Ustalić, zdefiniować lub sprecyzować coś, nadając temu jasne granice lub znaczenie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ustalanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <w>określić</w> dokładny termin naszego spotkania.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>определить</w> точное время нашей встречи."
                            }
                        },
                        {
                            "text": "Trudno <w>określić</w> przyczynę tego dziwnego zjawiska.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>определить</w> причину этого странного явления."
                            }
                        }
                    ],
                    "synonyms": [
                        "zdefiniować",
                        "ustalić",
                        "sprecyzować"
                    ],
                    "common_phrases": [
                        "określić cel",
                        "określić zasady",
                        "określić stanowisko"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установить, дать определение или уточнить что-либо, придав этому ясные границы или значение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определить",
                                "target_lang_sense_clarification": "выяснить, установить или описать сущность чего-либо"
                            },
                            {
                                "target_lang_word": "установить",
                                "target_lang_sense_clarification": "назначить или зафиксировать параметры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80566e09-b6af-3561-9343-bc6bb4abc30d",
                    "sense_definition": "Zająć konkretne stanowisko lub wyrazić swoje poglądy w danej sprawie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ustalanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej trudnej sytuacji musisz wreszcie <w>określić</w> się po której stronie stoisz.",
                            "target_lang_translations": {
                                "ru": "В этой сложной ситуации ты должен наконец <w>определиться</w>, на чьей стороне ты стоишь."
                            }
                        },
                        {
                            "text": "Politycy nie chcieli <w>określić</w> się jednoznacznie przed wyborami.",
                            "target_lang_translations": {
                                "ru": "Политики не хотели <w>определиться</w> однозначно перед выборами."
                            }
                        }
                    ],
                    "synonyms": [
                        "zadeklarować się",
                        "opowiedzieć się"
                    ],
                    "common_phrases": [
                        "określić się jasno"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять конкретную позицию или выразить свои взгляды по какому-либо вопросу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определиться",
                                "target_lang_sense_clarification": "принять решение, занять позицию"
                            },
                            {
                                "target_lang_word": "высказаться",
                                "target_lang_sense_clarification": "ясно выразить свою точку зрения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82876ef3-8b2f-3e09-8fdd-0112ac53dbf5",
                    "sense_definition": "Aspekt dokonany od czasownika <w>określać</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ustalanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Również w świecie ludzkim <w>określone</w> zachowania wywołują konkretne efekty.",
                            "target_lang_translations": {
                                "ru": "Также и в человеческом мире <w>определённые</w> действия вызывают конкретные результаты."
                            }
                        },
                        {
                            "text": "Badacze porównują różne języki, by <w>określić</w> stopień ich pokrewieństwa.",
                            "target_lang_translations": {
                                "ru": "Исследователи сравнивают разные языки, чтобы <w>определить</w> степень их родства."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенный вид глагола, означающий завершенное действие по установлению или определению чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определить",
                                "target_lang_sense_clarification": "установить, выяснить, назначить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
