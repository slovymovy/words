                        "examples": [
                            {
                                "example_id": "d30d5e85-91f0-4510-8745-c7c1f1f4b8af",
                                "sense_id": "7f0ad8d1-90e0-30a8-b5f6-279ebade7d34",
                                "text": "„Die griechischen Städte Unteritaliens traten jetzt als römische Bündner ohne Ausnahme unter römische Herrschaft.“"
                            },
                            {
                                "example_id": "3bb283a1-b425-449c-929d-c97c007c4681",
                                "sense_id": "7f0ad8d1-90e0-30a8-b5f6-279ebade7d34",
                                "text": "„Insbesondere Pythagoras hatte durch seine Schule in Kroton in Unteritalien einen großen Einfluss auf die weitere Entwicklung der griechischen Mathematik.“"
                            }
                        ],
