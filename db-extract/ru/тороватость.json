                "senses": [
                    {
                        "sense_id": "fb7cc37d-09a3-3d9a-bf5e-5ae4905a7b9a",
                        "entry_id": "feaa6e7b-19b9-3f52-9a11-39e062326203",
                        "glosses": [
                            "устар. свойство по значению прилагательного тороватый [1]; щедрость, расточительство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b13492e6-47c8-48cd-a1ff-221846d41941",
                                "sense_id": "fb7cc37d-09a3-3d9a-bf5e-5ae4905a7b9a",
                                "text": "Сами они не подбирают своих денег, да и окружающие только дивятся таким счастливцам, не помышляя обогатить свой карман их чудесной тороватостью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50846b48-e518-4ec3-910d-03ea35d8cac4",
                        "source_entry_id": "feaa6e7b-19b9-3f52-9a11-39e062326203",
                        "source_sense_id": "fb7cc37d-09a3-3d9a-bf5e-5ae4905a7b9a",
                        "source_sense_description": "щедрость",
                        "target_lang_word": "liberality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b89d16eb-26f0-36e3-b244-58254bdf8c20",
                                        "entry_id": "0e1e4fe2-52ac-3c6a-ab3d-62a27c433976",
                                        "glosses": [
                                            "The property of being liberal; generosity; charity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34a67c1a-28f0-4ec2-b586-cc1ee25ec00b",
                                                "sense_id": "b89d16eb-26f0-36e3-b244-58254bdf8c20",
                                                "text": "That liberality is but cast away / Which makes us borrow what we cannot pay."
                                            },
                                            {
                                                "example_id": "258e3089-7b34-478b-a0d9-a87e9f993297",
                                                "sense_id": "b89d16eb-26f0-36e3-b244-58254bdf8c20",
                                                "text": "She preferred that Lord Rotheles's liberality should take a purely personal direction. Whatever decorations might be lavished upon her dressing-room, the dowager would have to leave them behind her; not so those which filled the prodigality of red morocco cases on her toilette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9857856d-687b-3dcd-9ca6-2e9477e7b2bb",
                                        "entry_id": "0e1e4fe2-52ac-3c6a-ab3d-62a27c433976",
                                        "glosses": [
                                            "A gift; a gratuity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab7244e-561d-460e-9078-0e8f7a89eaba",
                                                "sense_id": "9857856d-687b-3dcd-9ca6-2e9477e7b2bb",
                                                "text": "A prudent man is not impoverished by his liberalities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b674f6a-7d08-32ae-9e6d-43c48193e0fb",
                                        "entry_id": "0e1e4fe2-52ac-3c6a-ab3d-62a27c433976",
                                        "glosses": [
                                            "Candor."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9331e569-5bb4-3a83-9f73-b2f6e121e103",
                                        "entry_id": "0e1e4fe2-52ac-3c6a-ab3d-62a27c433976",
                                        "glosses": [
                                            "Impartiality."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88329ad5-1315-46e3-8b59-ff8149ea221d",
                        "source_entry_id": "feaa6e7b-19b9-3f52-9a11-39e062326203",
                        "source_sense_id": "fb7cc37d-09a3-3d9a-bf5e-5ae4905a7b9a",
                        "source_sense_description": "щедрость",
                        "target_lang_word": "generosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "The trait of being willing to donate money, resources, or time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "124d1a34-6d02-42f6-8061-edfb97559151",
                                                "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                                "text": "We have mentioned generosity as an outstanding virtue required in Sioux life."
                                            },
                                            {
                                                "example_id": "af3b519b-1b30-40e4-86d2-9349caa59d6a",
                                                "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c39d05-8817-3a5f-8502-01456a0da097",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "A generous act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff657602-ade2-48ac-ac63-7f6624dfa1ee",
                                                "sense_id": "f4c39d05-8817-3a5f-8502-01456a0da097",
                                                "text": "May the generosities of the founders of these halls, be rewarded by the fair and holy characters which shall be here formed[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6596a999-1ebb-3e79-8a1d-c8c2147ede36",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "The trait of being abundant, more than adequate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "094aa45d-7608-3f25-8e90-21f61d857e91",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "Good breeding; nobility of stock."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0028200b-6fc8-45bb-af5e-ede8427bedbf",
                        "source_entry_id": "feaa6e7b-19b9-3f52-9a11-39e062326203",
                        "source_sense_id": "fb7cc37d-09a3-3d9a-bf5e-5ae4905a7b9a",
                        "source_sense_description": "щедрость",
                        "target_lang_word": "munificence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "munificence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                                        "entry_id": "83e3f4a7-f0c1-30f1-a82b-4df546bb2d80",
                                        "glosses": [
                                            "The quality of being munificent; generosity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "838436c1-95d8-4dae-9f00-7cdc1349766e",
                                                "sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                                                "text": "Now the happy king laid the forehead of thankſgiving upon the duſt of gratitude; he opened the doors of his wealth to the four winds, and enriched the world, at once, with his munificence."
                                            },
                                            {
                                                "example_id": "72f02305-ccf6-4a85-b0a7-58f291d85865",
                                                "sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                                                "text": "And surely, no form of munificence should entitle to a more grateful and lasting remembrance, than that which promotes the right education of youth;..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "munificence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e985a06-b1ae-3af0-88b6-95109cad95ee",
                                        "entry_id": "1d03dcdb-0924-31a7-8fdf-af981288ee0a",
                                        "glosses": [
                                            "Means of defence; fortification."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccb15649-c972-4e11-a838-fac5271d4794",
                                                "sense_id": "5e985a06-b1ae-3af0-88b6-95109cad95ee",
                                                "text": "Untill that Locrine for his Realmes defence,\nDid head against them make and strong munificence"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
