                        "glosses": [
                            "Action de déposer des tracts, ou des prospectus, entre l'essuie-glace et le pare-brise des véhicules en stationnement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4b66674f-96c8-41f7-bb53-466a91a4a570",
                                "sense_id": "62e48d20-7189-31a9-9ef1-73410c5bb83f",
                                "text": "Il m'a serré la main. Ensuite, il m'a expliqué le boîtage, le tractage, le parebrisage. Le parebrisage consistait à glisser des tracts sous les essuie-glaces, souvent parce que des digicodes interdisaient l'accès aux boites aux lettres."
                            },
                            {
                                "example_id": "8fa2a75a-4588-4675-87ce-61d970bf8713",
                                "sense_id": "62e48d20-7189-31a9-9ef1-73410c5bb83f",
                                "text": "Une agence recherche des personnes pour distribuer des flyers et faire du parebrisage à proximité de centres commerciaux et de sorties de métro."
                            }
                        ]
