                    {
                        "sense_id": "f3b17e53-2e08-3860-80e6-b91d978bdc07",
                        "entry_id": "90b78eef-25a1-3624-9f82-d49735860849",
                        "glosses": [
                            "En partie automatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d06ec2-d1bd-404c-8e16-03543b41458d",
                                "sense_id": "f3b17e53-2e08-3860-80e6-b91d978bdc07",
                                "text": "Il sera équipé de la technologie du hors-jeu semi-automatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "37f7947f-cbc7-3976-a705-f3cfc3d4eb6b",
                        "entry_id": "90b78eef-25a1-3624-9f82-d49735860849",
                        "glosses": [
                            "Qui nécessite un certain degré d’intervention humaine, en parlant des machines ou de programme informatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c8ac843-7dc9-44d2-883a-f59354bcf459",
                                "sense_id": "37f7947f-cbc7-3976-a705-f3cfc3d4eb6b",
                                "text": "Une laveuse, une boucheuse, une étiqueteuse... semi-automatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "024b18cc-a900-387d-b3a5-4578a9dce0dc",
                        "entry_id": "90b78eef-25a1-3624-9f82-d49735860849",
                        "glosses": [
                            "Qui se charge automatiquement mais dont chaque coup nécessite l’intervention humaine."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bfd30d2-2ccf-4409-8c35-d184cc7982cd",
                        "source_entry_id": "90b78eef-25a1-3624-9f82-d49735860849",
                        "target_lang_word": "halbautomatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
