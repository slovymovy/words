                                            },
                                            {
                                                "example_id": "d2503e18-e2be-40c3-a379-f9986e874de2",
                                                "sense_id": "de43b202-f81a-3e34-9866-c3f7de07d1fe",
                                                "text": "disproportionate impact"
                                            },
                                            {
                                                "example_id": "012a2577-8d5e-411b-bad2-65013b78ccb4",
                                                "sense_id": "de43b202-f81a-3e34-9866-c3f7de07d1fe",
                                                "text": "disproportionate response"
                                            },
                                            {
                                                "example_id": "a225b5c2-1542-405d-aa02-796ed455104c",
                                                "sense_id": "de43b202-f81a-3e34-9866-c3f7de07d1fe",
                                                "text": "They faced a disproportionate share of the costs."
                                            },
                                            {
                                                "example_id": "a431001f-ce3f-4b79-925a-a8ee03e99e02",
                                                "sense_id": "de43b202-f81a-3e34-9866-c3f7de07d1fe",
                                                "text": "The punishment seemed disproportionate to the crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af01f1dd-3f23-3b23-907f-723f3ed6b3ac",
                                        "entry_id": "0dc9ec89-7315-311e-8916-587f7df85152",
                                        "glosses": [
                                            "Out of proportion."
                                        ],
                                        "tags": [],
