                ],
                "senses": [
                    {
                        "sense_id": "5475e290-6a2e-354a-831f-b3be682836e6",
                        "entry_id": "4b4767bf-29bb-307a-b5a1-c3cc3597d535",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d18a9c-d548-4217-80f9-0fb46fc2aa4d",
                                "sense_id": "5475e290-6a2e-354a-831f-b3be682836e6",
                                "text": "Его жена, Елизавета Трофимовна, откормленная, сырая старуха, с распущенными седыми волосами, сидела в зале на диване, тряслась всем телом и, как пьяная, бессмысленно поводила глазами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af911378-d30a-4b92-a0f2-aa3928b48ed2",
                        "source_entry_id": "4b4767bf-29bb-307a-b5a1-c3cc3597d535",
                        "source_sense_id": "5475e290-6a2e-354a-831f-b3be682836e6",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Elizabeth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elizabeth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf24f6ca-b13b-344b-8688-fe1f84ce9b0c",
                                        "entry_id": "1885a243-73b4-3a75-99d3-e2fca20585f6",
                                        "glosses": [
                                            "A female given name from Hebrew, popular since the 16th century."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdcf7662-545c-4870-8077-a9729ae572c5",
                                                "sense_id": "bf24f6ca-b13b-344b-8688-fe1f84ce9b0c",
                                                "text": "Most happy letters! framed by skilful trade, / With which that happy name was first designed, - - - / Ye three Elizabeths! for ever live, / That three such graces did unto me give."
                                            },
                                            {
                                                "example_id": "8acc6048-053b-4d81-969e-fa86cfb22a7d",
                                                "sense_id": "bf24f6ca-b13b-344b-8688-fe1f84ce9b0c",
                                                "text": "\"Because if you say it over and over to yourself, darling, it really is a quite strange-sounding name, isn't it? It's just as strange as any other from the Old Testament, Mehetabel or Hepsibah or Shulamith, and any of them might have got to be as fashionable as Elizabeth if a queen had been called by them."
                                            },
                                            {
                                                "example_id": "04653a1e-8ab7-4ab8-b962-23c31ffefa11",
                                                "sense_id": "bf24f6ca-b13b-344b-8688-fe1f84ce9b0c",
                                                "text": "No one ever called Elizabeth Tannenbaum stunning, but most men found her attractive. Hardly anyone called her Elizabeth, either. An \"Elizabeth\" was regal, cool, an eyecatching beauty. A \"Betsy\" was pleasant to look at, a tiny bit overweight, capable, but still fun to be with."
                                            },
                                            {
                                                "example_id": "5d71e27d-cda0-4fde-9f95-3594d72590e8",
                                                "sense_id": "bf24f6ca-b13b-344b-8688-fe1f84ce9b0c",
                                                "text": "Davey was found by her daughter, Elizabeth, according to a statement read in court and reported by local paper The Northern Echo.\n“I went upstairs, my mam’s bedroom door was wide open, and I saw her lying on her back with her head under the bed,” Elizabeth said in court."
                                            }
                                        ]
                                    },
