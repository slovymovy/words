                    "frequency": "Middle",
                    "semantic_group_id": "norm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn gedrag <w>wijkt</w> nogal <w>af</w> van de maatschappelijke normen in dit land.",
                            "target_lang_translations": {
