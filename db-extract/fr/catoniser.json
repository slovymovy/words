                "senses": [
                    {
                        "sense_id": "193c95a5-95ff-355c-963c-5633238d9f45",
                        "entry_id": "fc169a0f-6a6d-3817-b9eb-1d46e7471615",
                        "glosses": [
                            "Parler comme Caton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9ec9e6-ad68-4594-94a5-6e8932152925",
                                "sense_id": "193c95a5-95ff-355c-963c-5633238d9f45",
                                "text": "Et l’ami Rameau, s’il se mettait un jour à marquer du mépris pour la fortune, les femmes, la bonne chère, l’oisiveté, à catoniser, que serait-il ? un hypocrite."
                            },
                            {
                                "example_id": "4d835baf-4506-45e7-bc0a-e39dd4e0b78f",
                                "sense_id": "193c95a5-95ff-355c-963c-5633238d9f45",
                                "text": "Laissons-les catoniser contre les sectes nouvelles en train de ronger par la base le culte des anciens dieux protecteurs de notre gloire, et scipioniser contre les Barbares en train de dévorer peu à peu les frontières de l’Empire !"
                            },
                            {
                                "example_id": "ffc95b17-ebe3-442a-b6df-ad796c1d4282",
                                "sense_id": "193c95a5-95ff-355c-963c-5633238d9f45",
                                "text": "Tu catonises"
                            }
                        ]
                    },
                    {
                        "sense_id": "ea18875b-1398-31b8-85cc-cc38c4da182e",
                        "entry_id": "fc169a0f-6a6d-3817-b9eb-1d46e7471615",
                        "glosses": [
                            "Avoir des mœurs austères semblables à celle de Caton l’Ancien."
