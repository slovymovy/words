                    {
                        "form_id": "28a3ff23-5f59-4a4e-ab89-a3317dc5603c",
                        "entry_id": "aa28089f-6e42-3af0-a8d9-c5d3fb754112",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… убаю́кивать"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64f720f9-8820-3c4b-9e71-02019714f27e",
                        "entry_id": "aa28089f-6e42-3af0-a8d9-c5d3fb754112",
                        "glosses": [
                            "укачивая и напевая, заставлять уснуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5bfd06d-7827-44e8-9d29-bb6a1d791f45",
                                "sense_id": "64f720f9-8820-3c4b-9e71-02019714f27e",
                                "text": "Аркадий Иванович, не говоря более праздного слова, взял молча Васю на руки, как ребёнка, несмотря на то что Вася был не совсем коротенький, но довольно длинный, только худой, и преловко начал его носить из угла в угол по комнате, показывая вид, что его убаюкивает."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce107cc6-cf97-39a2-ac04-d85bf71d0fd6",
                        "entry_id": "aa28089f-6e42-3af0-a8d9-c5d3fb754112",
                        "glosses": [
                            "перен. нагонять дремоту, усыплять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10251ad9-72cc-4242-8da5-038961b2ba42",
                                "sense_id": "ce107cc6-cf97-39a2-ac04-d85bf71d0fd6",
                                "text": "Воздух был напитан древесным запахом; шум еще продолжался, но в нем не было ничего страшного. Он, как старая знакомая песня, убаюкивал и усыплял Елену."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9f7e396-0916-3f58-ad7d-53a59659ea97",
                        "entry_id": "aa28089f-6e42-3af0-a8d9-c5d3fb754112",
                        "glosses": [
                            "перен. успокаивать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6184974a-a6cf-411f-9599-eca92e76e60d",
                                "sense_id": "d9f7e396-0916-3f58-ad7d-53a59659ea97",
                                "text": "Однообразная кропотливая работа каким-то непонятным образом убаюкивала его мысли, он ни о чём не думал, и время проходило быстро."
                            },
                            {
                                "example_id": "0ebf8aa9-3226-4cf0-a552-ac85324a28cf",
                                "sense_id": "d9f7e396-0916-3f58-ad7d-53a59659ea97",
                                "text": "Не убаюкивать надо партию, — а развивать в ней бдительность…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fadfee2a-beff-46d5-afdc-51c8d225ad19",
                        "source_entry_id": "aa28089f-6e42-3af0-a8d9-c5d3fb754112",
                        "target_lang_word": "rock to sleep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4e47964f-351e-41d6-a7d4-81de2ec3525d",
                        "source_entry_id": "aa28089f-6e42-3af0-a8d9-c5d3fb754112",
                        "target_lang_word": "lull",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "965ffa1a-3e35-3fe1-b7e6-8ff709c233cf",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period of rest or soothing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41eca79e-7034-3e1b-b89f-06ae765c7e82",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period of reduced activity; a respite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period without waves or wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1683cc-d82e-415b-886b-a90aa909fcec",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "[…] during the lull, wind shifted to S. E. […]"
                                            },
                                            {
                                                "example_id": "77369223-699a-443d-814b-80838a942a9f",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "After the lull the wind does not appear to have blown with any great strength […]"
                                            },
                                            {
                                                "example_id": "d9017816-f1dc-4b24-a31a-e1ca711f0de6",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "The air under each cloud has spent time near the surface, has been slowed and backed by friction—it is a lull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "An extended pause between sets of waves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2064f61-1eb9-4d8a-8b65-c54a78bbf676",
                                                "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                                "text": "It is advisable to leave the surf zone during the lull between sets of larger waves, waiting outside the surf zone for a lull."
                                            },
                                            {
                                                "example_id": "bcc33ee5-86e7-490f-8dd4-61464ec0b522",
                                                "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                                "text": "About 2 hours in, a long lull cleared everyone out, and then it started getting a little more consistent and pushing chest ta neck high."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                        "entry_id": "c343b338-f2d4-3f39-b035-449beb7f2da8",
                                        "glosses": [
                                            "To cause to rest by soothing influences; to compose; to calm"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d070aad3-2f21-4000-9440-34a2a85df0c3",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "To lull him soft a sleepe"
                                            },
                                            {
                                                "example_id": "e6740966-2645-4e2e-acfd-5073c1eac1ae",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "Such ſweet compulſion doth in muſick ly, / To lull the daughers of Neceſſity,"
                                            },
                                            {
                                                "example_id": "6f049317-63e3-452b-b6b7-1e2845e8b9d1",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "To lull with song an aching heart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7cd12f-8ef6-3de9-8e55-91a8aa486f10",
                                        "entry_id": "c343b338-f2d4-3f39-b035-449beb7f2da8",
                                        "glosses": [
                                            "To become gradually calm; to subside; to cease or abate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30bc07a6-ce06-44f5-8ba3-747b72cb2c95",
                                                "sense_id": "6e7cd12f-8ef6-3de9-8e55-91a8aa486f10",
                                                "text": "The storm lulled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a6ce1e6-9772-452d-8bd1-94758b3383d4",
                        "source_entry_id": "aa28089f-6e42-3af0-a8d9-c5d3fb754112",
                        "target_lang_word": "einlullen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einlullen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b4531f4-d4d6-32bb-a983-75bbcb6b6501",
                                        "entry_id": "58f42633-369a-37dd-9667-5840743711a9",
                                        "glosses": [
                                            "jemanden (meist Kleinkinder) mit beruhigenden Worten oder Gesang in den Schlaf bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ac7439b-d4cb-46f7-a50a-c5c11536e0e5",
                                                "sense_id": "1b4531f4-d4d6-32bb-a983-75bbcb6b6501",
                                                "text": "Nach der schweren, aber überstandenen Krankheit ließ er sich leicht in den Schlaf einlullen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5636b387-8511-3038-88a3-b9fbe8717cb7",
                                        "entry_id": "58f42633-369a-37dd-9667-5840743711a9",
                                        "glosses": [
                                            "jemanden mit bestimmten psychologischen Methoden in einen unwirklichen, wirklichkeitsfernen Zustand, in einen Traum, in einen hypnotischen Zustand bringen, eine Illusion hervorrufen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "921441ab-6c5b-4369-8f90-0d83abf82251",
                                                "sense_id": "5636b387-8511-3038-88a3-b9fbe8717cb7",
                                                "text": "Du solltest es langsam besser wissen. Wieso lässt du dich schon wieder von ihr einlullen?"
                                            },
                                            {
                                                "example_id": "46c4acbb-91e6-4b7a-90d0-9bda39df581e",
                                                "sense_id": "5636b387-8511-3038-88a3-b9fbe8717cb7",
                                                "text": "„Der Gesandte verdankte sein Glück lediglich dem schönen Geschlecht, da er im höchsten Grade die Kunst besaß, Gefühle der Liebe einzulullen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
