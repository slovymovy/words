                "senses": [
                    {
                        "sense_id": "b9ab1719-2795-3639-98d3-635e481ef27d",
                        "entry_id": "58558728-4888-3fdd-9b24-56f19422e62d",
                        "glosses": [
                            "ein Gegenstand, durch dessen Einsatz man intensiven Gestank verbreiten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3afd1b14-6a2f-4e9f-b0d1-9f3107ce9fe8",
                                "sense_id": "b9ab1719-2795-3639-98d3-635e481ef27d",
                                "text": "„Schließlich erscheint ein Zug Schutzpolizei und schafft die Randalierer unter Knüppeleinsatz aus dem Saal - wobei ein übermäßiges Arsenal weiterer Stinkbomben sichergestellt wird, die man, wohl aus Gründen der Selbstschonung, nicht geworfen hat.“"
                            },
                            {
                                "example_id": "f061939f-9d05-442e-a00e-4e928302ca69",
                                "sense_id": "b9ab1719-2795-3639-98d3-635e481ef27d",
                                "text": "„Ich bestelle Stinkbomben.“"
                            },
                            {
                                "example_id": "95f6fc64-efa3-4609-b429-29bf71d65ad8",
                                "sense_id": "b9ab1719-2795-3639-98d3-635e481ef27d",
                                "text": "„Der Pöbel schlug ihnen die Schaufenster ein und warf Stinkbomben in ihre Geschäfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
