{
    "word_family": [
        "глубокий",
        "глубоко",
        "глубь",
        "глубинный",
        "углубить",
        "углубление",
        "углубляться"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50129b49-bf85-391b-8b9e-e6251dea1a71",
                    "sense_definition": "Расстояние от поверхности до дна, до наиболее удалённой точки или внутрь чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "физическая глубина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Максимальная <w>глубина</w> этого озера достигает двадцати метров.",
                            "target_lang_translations": {
                                "en": "The maximum <w>depth</w> of this lake reaches twenty meters."
                            }
                        },
                        {
                            "text": "На большой <w>глубине</w> вода остаётся очень холодной даже жарким летом.",
                            "target_lang_translations": {
                                "en": "At great <w>depth</w>, the water remains very cold even in hot summer."
                            }
                        }
                    ],
                    "antonyms": [
                        "мель"
                    ],
                    "common_phrases": [
                        "большая глубина",
                        "на глубине",
                        "измерить глубину"
                    ],
                    "target_lang_definitions": {
                        "en": "The distance from the surface to the bottom, to the most distant point, or into the interior of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depth",
                                "target_lang_sense_clarification": "physical vertical or inward measurement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7822e753-75f1-33a2-9ccf-1081e8c332b1",
                    "sense_definition": "Глубокое место или пространство, находящееся далеко внизу, под толщей воды.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "физическая глубина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Большая рыба медленно скрылась в тёмной морской <w>глубине</w>.",
                            "target_lang_translations": {
                                "en": "A large fish slowly vanished into the dark <w>depths</w> of the sea."
                            }
                        },
                        {
                            "text": "Подводная лодка осторожно погрузилась в морские <w>глубины</w>.",
                            "target_lang_translations": {
                                "en": "The submarine carefully submerged into the ocean <w>depths</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "глубь"
                    ],
                    "antonyms": [
                        "мель"
                    ],
                    "common_phrases": [
                        "морские глубины",
                        "погрузиться в глубину"
                    ],
                    "target_lang_definitions": {
                        "en": "A deep place or space located far down, typically under a body of water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depths",
                                "target_lang_sense_clarification": "deep waters or deep underground space"
                            },
                            {
                                "target_lang_word": "deep",
                                "target_lang_sense_clarification": "deep part of the sea or ocean"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "410163ef-451c-3912-9d51-90b12166c0c3",
                    "sense_definition": "Внутренняя, наиболее отдалённая от краёв или входа часть какого-либо пространства.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "пространство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили поставить палатку в самой <w>глубине</w> густого леса.",
                            "target_lang_translations": {
                                "en": "We decided to pitch our tent in the very <w>heart</w> of the dense forest."
                            }
                        },
                        {
                            "text": "В <w>глубине</w> комнаты стоял старый шкаф с книгами.",
                            "target_lang_translations": {
                                "en": "At the <w>back</w> of the room stood an old bookcase."
                            }
                        }
                    ],
                    "synonyms": [
                        "глубь"
                    ],
                    "common_phrases": [
                        "в глубине леса",
                        "в глубине комнаты",
                        "в глубине души"
                    ],
                    "target_lang_definitions": {
                        "en": "The interior or remotest part of a space, far from the edges or entrance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depths",
                                "target_lang_sense_clarification": "remote interior of a forest, room, or space"
                            },
                            {
                                "target_lang_word": "heart",
                                "target_lang_sense_clarification": "innermost or central part"
                            },
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "far interior of a room or enclosure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3add6c9-f37a-3f33-851d-4d9355d7aaad",
                    "sense_definition": "Серьёзность, значительность содержания и наличие глубокого смысла.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "абстрактное",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Читателей поразила необыкновенная философская <w>глубина</w> нового романа.",
                            "target_lang_translations": {
                                "en": "Readers were struck by the extraordinary philosophical <w>depth</w> of the new novel."
                            }
                        },
                        {
                            "text": "Его суждения всегда отличались поразительной <w>глубиной</w> и ясностью.",
                            "target_lang_translations": {
                                "en": "His judgments were always distinguished by astonishing <w>profundity</w> and clarity."
                            }
                        }
                    ],
                    "synonyms": [
                        "глубокомыслие"
                    ],
                    "common_phrases": [
                        "глубина мысли",
                        "глубина содержания"
                    ],
                    "target_lang_definitions": {
                        "en": "Seriousness, significance of content, and the presence of profound meaning."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depth",
                                "target_lang_sense_clarification": "complexity and intellectual substance"
                            },
                            {
                                "target_lang_word": "profundity",
                                "target_lang_sense_clarification": "deep intellect, insight, or seriousness"
                            },
                            {
                                "target_lang_word": "profoundness",
                                "target_lang_sense_clarification": "quality of being profound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b33228a-e7c5-3dd3-85e4-0df0602ea2c8",
                    "sense_definition": "Сила, значительность и интенсивность проявления чувств, переживаний или состояний.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "абстрактное",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она почувствовала всю бездонную <w>глубину</w> своего горя и одиночества.",
                            "target_lang_translations": {
                                "en": "She felt the full, bottomless <w>depth</w> of her grief and loneliness."
                            }
                        },
                        {
                            "text": "Музыка передавала невероятную силу и искреннюю <w>глубину</w> чувств.",
                            "target_lang_translations": {
                                "en": "The music conveyed an incredible power and sincere <w>depth</w> of feeling."
                            }
                        }
                    ],
                    "synonyms": [
                        "сила",
                        "интенсивность"
                    ],
                    "common_phrases": [
                        "глубина чувств",
                        "глубина переживаний"
                    ],
                    "target_lang_definitions": {
                        "en": "The strength, significance, and intensity of feelings, experiences, or emotional states."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depth",
                                "target_lang_sense_clarification": "intensity or profundity of emotions"
                            },
                            {
                                "target_lang_word": "profundity",
                                "target_lang_sense_clarification": "intensity or gravity of a feeling"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}