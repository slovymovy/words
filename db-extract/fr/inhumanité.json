            {
                "entry_id": "09a9b738-b7e5-3016-9230-f339e5b1c6f1",
                "word": "inhumanité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a010cd4-c3d0-4399-abd0-40ce1ef2ef74",
                        "entry_id": "09a9b738-b7e5-3016-9230-f339e5b1c6f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "inhumanités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5715a8c-3183-3e4c-a210-28ac7c7d4094",
                        "entry_id": "09a9b738-b7e5-3016-9230-f339e5b1c6f1",
                        "glosses": [
                            "Cruauté excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d82671c-d2cd-4dc5-b1fd-e8ce820b7d71",
                                "sense_id": "e5715a8c-3183-3e4c-a210-28ac7c7d4094",
                                "text": "Le marbre partout, même aux lambris, nous paraît être le décor spécial Louis XlV, avec quelque inhumanité mais dans une somptuosité héroïque."
                            },
                            {
                                "example_id": "22cd7c28-3588-4cc6-97e4-c93569adc379",
                                "sense_id": "e5715a8c-3183-3e4c-a210-28ac7c7d4094",
                                "text": "Une démesure dont l’histoire nous enseigne (songeons au nazisme) qu’elle peut conduire à l’inhumanité absolue."
                            },
                            {
                                "example_id": "f504b1f4-da3d-4bc2-83d0-70730944df6c",
                                "sense_id": "e5715a8c-3183-3e4c-a210-28ac7c7d4094",
                                "text": "C’est seulement en regardant Shoah que la conscience contemplait avec effroi l’étendue possible de sa propre inhumanité."
                            },
                            {
                                "example_id": "da7b1a1c-6246-4510-9f33-35cba70da9de",
                                "sense_id": "e5715a8c-3183-3e4c-a210-28ac7c7d4094",
                                "text": "En 1938, après l’Autriche, notre monde s’était habitué à l’inhumanité, au déni du droit et à la brutalité, comme jamais auparavant pendant un siècle."
                            },
                            {
                                "example_id": "75d6a62c-8ff6-4be7-a399-9b104a4c919d",
                                "sense_id": "e5715a8c-3183-3e4c-a210-28ac7c7d4094",
                                "text": "Acte d’inhumanité envers des vaincus."
                            },
                            {
                                "example_id": "d281c283-4733-4713-be98-5aa9aea3caa3",
                                "sense_id": "e5715a8c-3183-3e4c-a210-28ac7c7d4094",
                                "text": "Il l’a traité avec inhumanité."
                            }
                        ]
                    },
                    {
                        "sense_id": "e359f49f-a624-304c-938b-60b57160f074",
                        "entry_id": "09a9b738-b7e5-3016-9230-f339e5b1c6f1",
                        "glosses": [
                            "Ensemble d'actes cruels."
                        ],
                        "tags": [
                            "Quelquefois"
                        ],
                        "examples": [
                            {
                                "example_id": "6d1ac97a-f5f4-4b13-9cb5-2761809b5f0d",
                                "sense_id": "e359f49f-a624-304c-938b-60b57160f074",
                                "text": "Exercer de grandes inhumanités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59b1f5fa-d5cb-4cde-a8e4-1e0fedae67cf",
                        "source_entry_id": "09a9b738-b7e5-3016-9230-f339e5b1c6f1",
                        "target_lang_word": "Unmenschlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unmenschlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                        "entry_id": "1eb49b8c-1995-3bd6-a949-137632686b3c",
                                        "glosses": [
                                            "die Eigenschaft, unmenschlich zu sein oder unmenschliches Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484ebe76-9ec3-4a84-93be-aa6f954cdf83",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "Die Unmenschlichkeit der Tierindustrie überzeugt viele vom Veganismus."
                                            },
                                            {
                                                "example_id": "cf87b492-5731-443b-8a96-76888d655c59",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "„Jahraus, jahrein hallen die Zeitungen von den Unmenschlichkeiten des Sultans wider.“"
                                            },
                                            {
                                                "example_id": "87f12f7e-cb3d-4d05-9145-81cd3c105419",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "„Die Unmenschlichkeit von Hitlers Regime hatte ihn moralisch stumpf gemacht – und ebenso Roosevelt.“"
                                            },
                                            {
                                                "example_id": "6f02a881-4a51-497f-b735-24a2fc69175e",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "„Es war eine Verbindung von Unmenschlichkeit und Bürokratie, die die Unmenschlichkeit noch unmenschlicher machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
