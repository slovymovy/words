                        "glosses": [
                            "psychoaktywny alkaloid opium (np. morfina, kodeina)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b6c94d-d6bf-4f0a-b26c-2f820474664a",
                                "sense_id": "bdb544ce-238d-3843-8529-8c9e0b6c9b0a",
                                "text": "„Klej” nie był syntetykiem, tylko naturalnym surowcem z opiatów. Z żyznych dolin u stóp Paropamisu ładunek wędrował na barkach tragarzy, w jukach wielbłądów, oślim zaprzęgiem, ciężarówką, kontenerowcem, czołgiem… Opiaty, wyhodowane na ziemi po dnach pradawnych jezior u podnóża afgańskich gór, parły ku Zachodowi na przełaj przez kontynent"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
