                                "target_senses": [
                                    {
                                        "sense_id": "00d99d89-985d-3a89-b3f4-a852fbfd45ce",
                                        "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                                        "glosses": [
                                            "Qui a une seule syllabe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c918d3-7f60-4a1d-b1ac-ab4fa3a5233a",
                                                "sense_id": "00d99d89-985d-3a89-b3f4-a852fbfd45ce",
                                                "text": "« Bon » est adjectif monosyllabique."
                                            },
                                            {
                                                "example_id": "14752c3e-0453-4b22-bd46-27c19e497fe7",
                                                "sense_id": "00d99d89-985d-3a89-b3f4-a852fbfd45ce",
                                                "text": "[…] c’est à peine si quelques-uns parviennent à répéter deux ou trois sons monosyllabiques, ce que font certains chimpanzés de chez nous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f41c5e3-725c-3c4b-aa15-b6c62108d15c",
                                        "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                                        "glosses": [
                                            "Qui est composé de monosyllabes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd2fa26d-b504-413b-b7ab-10062b687384",
                                                "sense_id": "1f41c5e3-725c-3c4b-aa15-b6c62108d15c",
                                                "text": "Le sumérien étant majoritairement monosyllabique, il en aurait résulté des homophones nombreux (des mots différents se prononçant de la même façon, comme en français vers, verre, vert, ver) si la langue n’avait pas utilisé un autre moyen de distinguer entre les différents sens de ces « homophones »."
                                            },
                                            {
                                                "example_id": "9702f2d1-91ea-4338-8f44-d3a43454ee82",
                                                "sense_id": "1f41c5e3-725c-3c4b-aa15-b6c62108d15c",
                                                "text": "Vers monosyllabiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eecfe2a1-4e4a-35e2-acb2-0babea6156e5",
                                        "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                                        "glosses": [
                                            "Qui parle par monosyllabes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35943d8f-a05c-4ab9-bd5a-9398e40f364a",
                                                "sense_id": "eecfe2a1-4e4a-35e2-acb2-0babea6156e5",
                                                "text": "Au téléphone, Lawrence était plus monosyllabique que jamais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
