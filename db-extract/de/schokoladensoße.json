                "senses": [
                    {
                        "sense_id": "09f42978-90a8-3c4c-86d1-8e8ec028c983",
                        "entry_id": "5cbf46fb-4ba1-3e9d-9ee7-60aa5a2066a5",
                        "glosses": [
                            "Soße, die aus geschmolzener Schokolade oder Schokoladenpulver besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6ce6cb-7464-4a1f-8980-1b0d5e0142fd",
                                "sense_id": "09f42978-90a8-3c4c-86d1-8e8ec028c983",
                                "text": "„Zum Nachtisch gab es Vanilleeis mit Schokoladensoße.“"
                            },
                            {
                                "example_id": "b649ff72-fd44-4020-82a5-a596c2b25121",
                                "sense_id": "09f42978-90a8-3c4c-86d1-8e8ec028c983",
                                "text": "„Da waren Erdbeeren mit einer Schüssel Schokoladensoße, köstliche Sandwiches und erfrischende Getränke.“"
                            },
                            {
                                "example_id": "a2962bc9-a789-477c-91d3-58fd316d74f1",
                                "sense_id": "09f42978-90a8-3c4c-86d1-8e8ec028c983",
                                "text": "„Für die Schokoladensoße müssen Sie die Milch in einem kleinen Topf erwärmen und die Schokoladenraspeln rein geben.“"
                            },
                            {
                                "example_id": "bb5f33ba-7c92-45ee-a465-51d1b9c7b0ec",
                                "sense_id": "09f42978-90a8-3c4c-86d1-8e8ec028c983",
                                "text": "„Er räumte die Teller ab, holte das hausgemachte Eis aus dem Gefrierschrank und füllte es in zwei Schalen, die er zusammen mit etwas Schokoladensoße zum Tisch hinübertrug.“"
                            },
                            {
                                "example_id": "88e4b255-6fd2-4821-b823-200bd7d24cc6",
                                "sense_id": "09f42978-90a8-3c4c-86d1-8e8ec028c983",
                                "text": "„Mit ausgefallenen Zutaten lassen sich Schokoladensoßen ganz einfach aufpeppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
