{
    "word_family": [
        "suck",
        "sucking",
        "suckable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ade1b5c-ef00-3ba5-89a7-1f5ac55bd260",
                    "sense_definition": "A person who is easily deceived or tricked.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One poor <w>sucker</w> had actually given her his life savings.",
                            "target_lang_translations": {
                                "cs": "Jeden ubohý <w>naivka</w> jí skutečně dal své celoživotní úspory."
                            }
                        },
                        {
                            "text": "Do you think I am easy and that you can play me for a <w>sucker</w>?",
                            "target_lang_translations": {
                                "cs": "Myslíš si, že jsem snadný cíl a že mě můžeš <w>napálit</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "dupe",
                        "fool",
                        "gull"
                    ],
                    "common_phrases": [
                        "play for a sucker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která se nechá snadno oklamat nebo napálit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "naivka",
                                "target_lang_sense_clarification": "člověk, který je důvěřivý a snadno se nechá oklamat"
                            },
                            {
                                "target_lang_word": "hlupák",
                                "target_lang_sense_clarification": "člověk, který jedná nerozumně a nechá se využít"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "464f13e7-9c95-3fdf-ba6b-89e018620d4e",
                    "sense_definition": "A person who is very fond of or easily attracted to something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a <w>sucker</w> for ghost stories.",
                            "target_lang_translations": {
                                "cs": "Mám <w>slabost pro</w> duchařské příběhy."
                            }
                        },
                        {
                            "text": "He must be a <w>sucker</w> for punishment to try that.",
                            "target_lang_translations": {
                                "cs": "Musí být <w>blázen</w>, že se o to pokouší."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sucker for"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která má k něčemu velkou slabost nebo je něčím snadno nadšená."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slabost pro něco",
                                "target_lang_sense_clarification": "mít k něčemu velkou náklonnost"
                            },
                            {
                                "target_lang_word": "blázen do něčeho",
                                "target_lang_sense_clarification": "být něčím velmi nadšený"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb4977c0-d1a9-3992-a8f6-db598de42cf5",
                    "sense_definition": "A body part or organ used by some animals to stick to surfaces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The octopus uses each <w>sucker</w> on its tentacles to grip the rock.",
                            "target_lang_translations": {
                                "cs": "Chobotnice používá každou <w>přísavku</w> na svých chapadlech, aby se udržela skály."
                            }
                        },
                        {
                            "text": "Small insects often have a <w>sucker</w> on their feet to climb smooth glass.",
                            "target_lang_translations": {
                                "cs": "Drobný hmyz má často na nohou <w>přísavky</w>, aby mohl lézt po hladkém skle."
                            }
                        }
                    ],
                    "synonyms": [
                        "suction cup"
                    ],
                    "target_lang_definitions": {
                        "cs": "Orgán nebo část těla některých živočichů sloužící k přichycení k povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přísavka",
                                "target_lang_sense_clarification": "orgán sloužící k přichycení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c9c28b7-6a07-3fe9-b97c-f34a6a1639a4",
                    "sense_definition": "An unwanted shoot growing from the roots or base of a plant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should remove every <w>sucker</w> from the base of the rose bush.",
                            "target_lang_translations": {
                                "cs": "Měl bys odstranit každý <w>přízemní výhonek</w> z báze růžového keře."
                            }
                        },
                        {
                            "text": "The tree is wasting energy on a <w>sucker</w> instead of growing fruit.",
                            "target_lang_translations": {
                                "cs": "Strom plýtvá energií na <w>odnož</w>, místo aby plodil ovoce."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nežádoucí výhonek rostoucí z kořenů nebo báze rostliny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přízemní výhonek",
                                "target_lang_sense_clarification": "nežádoucí výhon vyrůstající z kořenů"
                            },
                            {
                                "target_lang_word": "odnož",
                                "target_lang_sense_clarification": "boční výhon rostliny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "708b0a92-2218-3c13-a302-ff63f234746d",
                    "sense_definition": "To trick or deceive someone into doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman <w>suckered</w> him into signing an expensive contract.",
                            "target_lang_translations": {
                                "cs": "Prodejce ho <w>napálil</w>, aby podepsal drahou smlouvu."
                            }
                        },
                        {
                            "text": "They <w>suckered</w> the poor man out of his money.",
                            "target_lang_translations": {
                                "cs": "Toho ubohého muže <w>obelstili</w> a připravili o peníze."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "deceive",
                        "cheat"
                    ],
                    "common_phrases": [
                        "suckered into"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Někoho oklamat nebo podvést, aby něco udělal."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "napálit",
                                "target_lang_sense_clarification": "někoho podvést"
                            },
                            {
                                "target_lang_word": "obelstít",
                                "target_lang_sense_clarification": "někoho lstí přimět k něčemu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe36e4c7-5bb7-3d70-afed-6836feefa855",
                    "sense_definition": "To remove unwanted shoots from a plant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers must <w>sucker</w> tobacco plants to ensure better leaf quality.",
                            "target_lang_translations": {
                                "cs": "Farmáři musí u tabáku <w>vylamovat zálistky</w>, aby zajistili lepší kvalitu listů."
                            }
                        },
                        {
                            "text": "It is necessary to <w>sucker</w> the tomato plants throughout the summer.",
                            "target_lang_translations": {
                                "cs": "Je nutné během celého léta <w>vylamovat zálistky</w> u rajčat."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Odstraňování nežádoucích výhonků z rostliny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vylamovat zálistky",
                                "target_lang_sense_clarification": "odstraňování bočních výhonů u rostlin"
                            },
                            {
                                "target_lang_word": "odstraňovat výhonky",
                                "target_lang_sense_clarification": "technická činnost při pěstování rostlin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}