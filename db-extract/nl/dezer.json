                                "example_id": "0cd32807-a318-45c2-9054-28b2d86093d8",
                                "sense_id": "bb365a00-18f5-365c-b0df-216c123dd4b3",
                                "text": "Hij zal daar een dezer dagen wel naar terugkeren."
                            },
                            {
                                "example_id": "37eb043b-de1d-4e83-bd1e-f7e1057bd75e",
                                "sense_id": "bb365a00-18f5-365c-b0df-216c123dd4b3",
                                "text": "Een dezer dagen zouden ze langskomen, had hij op enthousiaste toon gemeld."
                            }
                        ]
