                ],
                "senses": [
                    {
                        "sense_id": "6ae22118-fa05-3f7e-8c2f-e69a82a24bae",
                        "entry_id": "a6ad94fe-1900-35ef-8761-9fe28247a23f",
                        "glosses": [
                            "zum Frühstück zur Selbstbedienung aufgebaute Speisen und Getränke in einem Restaurant, Hotel oder dergleichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "729c2b16-9f39-489e-80fa-de5b60b7cc35",
                                "sense_id": "6ae22118-fa05-3f7e-8c2f-e69a82a24bae",
                                "text": "„Stellen Sie sich vor, Sie sind verreist und stehen morgens am Frühstücksbüfett Ihres Hotels.“"
                            },
                            {
                                "example_id": "240080ea-e778-4bc0-8a23-537ae8096fa3",
                                "sense_id": "6ae22118-fa05-3f7e-8c2f-e69a82a24bae",
                                "text": "„Zu den trendig ausgestatteten und zertifizierten Passivhaus-Hotels gehören auch ein Spa zur Entspannung nach dem Sport und ein Frühstücksbüfett mit regionalen Produkten, bei dem sich die Gäste ihr Rührei selbst brutzeln können.“"
                            },
                            {
                                "example_id": "961da37a-6e09-47b1-8bb6-1092c23919d7",
                                "sense_id": "6ae22118-fa05-3f7e-8c2f-e69a82a24bae",
                                "text": "„Der Kaffee am Frühstücksbüfett des Hotels war nicht schlecht, für portugiesische Verhältnisse allerdings enttäuschend.“"
                            },
                            {
                                "example_id": "57cffc45-dba0-47c3-aa23-160f25064189",
                                "sense_id": "6ae22118-fa05-3f7e-8c2f-e69a82a24bae",
                                "text": "„Sauber ja, freundlich nein - und das gelobte Frühstücksbüfett besteht im Mexico aus pappigem Gebäck, auf die Tische geworfenem Plastikgeschirr und einem mit grauem Milchschaum bekrönten Cappuccino.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
