                ],
                "senses": [
                    {
                        "sense_id": "6b1e9d4e-5127-3e97-a35e-431c571c65c1",
                        "entry_id": "e58f879a-1200-3b8b-94f9-2d65fa94ad0d",
                        "glosses": [
                            "Mitglied einer Gruppe von sehr ursprünglichen Bakterien, die Photosynthese treiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a7c51c0-fc61-4122-8bd5-458a451ae0f6",
                                "sense_id": "6b1e9d4e-5127-3e97-a35e-431c571c65c1",
                                "text": "Die Cyanobakterien metabolisierten im Paläoproterozoikum und setzten dabei gewaltige Mengen an Sauerstoff frei, der sich zunehmend in der Atmosphäre anhäufte."
                            },
                            {
                                "example_id": "d6a61fed-3de6-4f71-9a42-f658cb5c1137",
                                "sense_id": "6b1e9d4e-5127-3e97-a35e-431c571c65c1",
                                "text": "„Cyanobakterien besiedeln vermutlich bereits seit mehr als 3,5 Mrd. Jahren die Erde und zählen damit zu den ältesten Lebensformen überhaupt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "febad462-3d46-4c70-9b02-1d103a797e05",
                        "source_entry_id": "e58f879a-1200-3b8b-94f9-2d65fa94ad0d",
                        "source_sense_id": "6b1e9d4e-5127-3e97-a35e-431c571c65c1",
                        "source_sense_description": "Mitglied einer Gruppe von sehr ursprünglichen Bakterien, die Photosynthese treiben",
                        "target_lang_word": "cyanobacterium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyanobacterium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1850f04e-53a1-3f0b-9f5f-fd72e178f364",
                                        "entry_id": "6af915ed-3fff-3187-8b17-7815990070ac",
                                        "glosses": [
                                            "Any of very many photosynthetic prokaryotic microorganisms, of phylum Cyanobacteria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee56748-e097-47c7-81f0-a0021a1ef1a9",
                                                "sense_id": "1850f04e-53a1-3f0b-9f5f-fd72e178f364",
                                                "text": "At some point in the first billion years of life, cyanobacteria, or blue-green algae, learned to tap into a freely available resource – the hydrogen that exists in spectacular abundance in water."
                                            },
                                            {
                                                "example_id": "2d39d1d6-8485-403b-9fc5-acbe6b5a6fbf",
                                                "sense_id": "1850f04e-53a1-3f0b-9f5f-fd72e178f364",
                                                "text": "Photosynthesis was established some billion years ago by ancient bacterial precursors of modern cyanobacteria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "263d8dda-cb92-4b5d-bf26-5ca1871c468c",
                        "source_entry_id": "e58f879a-1200-3b8b-94f9-2d65fa94ad0d",
                        "source_sense_id": "6b1e9d4e-5127-3e97-a35e-431c571c65c1",
                        "source_sense_description": "Mitglied einer Gruppe von sehr ursprünglichen Bakterien, die Photosynthese treiben",
                        "target_lang_word": "cyanobactérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyanobactérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                        "entry_id": "4ebaa313-a2ee-343f-bcc0-c5a07745171c",
                                        "glosses": [
                                            "Sous-classe de bactéries (procaryotes) bleu-vert, marron ou rouge foncé. Elles pratiquent une photosynthèse aérobie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e4c80eb-5697-42a5-bd67-601442829556",
                                                "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                                "text": "Une masse de cyanobactéries proliférant dans l’eau est appelée efflorescence ou fleur d’eau."
                                            },
                                            {
                                                "example_id": "383b775e-869a-4621-81cf-e5f07223f11a",
                                                "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                                "text": "Une meilleure connaissance de la diversité des microorganismes associés aux thrombolites et stromatolites actuels souligne cependant que plusieurs groupes taxonomiques autres que les cyanobactéries pourraient être impliqués dans leur formation (Paerl et al. 2001 ; Couradeau et al. 2011) remettant en cause le lien d’exclusivité souvent fait entre stromatolite et photosynthese oxygénique."
                                            },
                                            {
                                                "example_id": "9ead2e44-10f0-48bc-b141-219a8552144f",
                                                "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                                "text": "Certaines algues microscopiques, et en particulier les cyanobactéries ou cyanophycées (appelées autrefois algues bleues ou algues bleues/vertes) peuvent produire plusieurs types de toxines (les cyanotoxines), susceptibles d’agir sur des organes cibles différents (foie, système nerveux, reins, intestins)."
                                            },
                                            {
                                                "example_id": "f0b1ef8c-7b99-470f-8881-8a98395a5b82",
                                                "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                                "text": "Les oxycaroténoïdes des microalgues et des cyanobactéries détruisent l’oxygène singulet et, en même temps, protègent la surexposition à la lumière solaire les membranes photosynthétiques."
                                            },
                                            {
                                                "example_id": "738dd54e-a67c-4f11-8506-db183e00c438",
                                                "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                                "text": "Certes, la cyanobactérie, de son nom savant, prend ses aises avec les chaleurs estivales, mais la vraie raison de sa floraison, c’est l’agriculture et l’élevage intensifs."
                                            },
                                            {
                                                "example_id": "78884adb-a7a9-4294-976e-caf680698b85",
                                                "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                                "text": "En effet, dans le cas des lichens au sens strict, les cyanobactéries sont emprisonnées entre les hyphes du champignon, alors que chez Geosyphon, les cyanobactéries sont à l’intérieur des cellules du champignon."
                                            },
                                            {
                                                "example_id": "a0e5e371-99da-4ac7-8920-745693f83745",
                                                "sense_id": "5be4d03c-f370-3339-b3e7-11fe7c81faa1",
                                                "text": "L’origine probable : des cyanobactéries, de même qu’au lac de Daumesnil (12ᵉ arrondissement)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
