                "translations": [
                    {
                        "translation_id": "01963db5-98f0-4c92-a4ea-8d914712088f",
                        "source_entry_id": "ae30f864-0a6a-3c11-86bd-00a9d9c5ea23",
                        "source_sense_id": "242ebc5e-2840-38a1-be2c-aab46d98542f",
                        "target_lang_word": "Perücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c07d7f-d520-330e-81c6-58d0b462dd10",
                                        "entry_id": "7f9b1acf-8a10-3b70-b2a9-63edb388231b",
                                        "glosses": [
                                            "ein Haarersatz; eine handwerklich angefertigte Nachahmung natürlich gewachsener Haare, des Haarschopfes; eine künstliche Kopfbedeckung; eine Zweitfrisur, die das Naturhaar ersetzen oder ergänzen sollen"
                                        ],
                                        "tags": [
                                            "Friseurhandwerk",
                                            "[Mode"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895ba770-d610-4fce-b0b2-d81d63f16b52",
                                                "sense_id": "f5c07d7f-d520-330e-81c6-58d0b462dd10",
                                                "text": "Klaus trägt eine Perücke, um seine Glatze zu verstecken."
                                            },
                                            {
                                                "example_id": "e785b60b-f5e9-45eb-b12d-d7ccf61c1fa4",
                                                "sense_id": "f5c07d7f-d520-330e-81c6-58d0b462dd10",
                                                "text": "„Er trug eine untadelig gepuderte Perücke und ein Jackett aus Seidenbrokat.“"
                                            },
                                            {
                                                "example_id": "c34c17e0-a838-480e-8e9a-b0061de09f61",
                                                "sense_id": "f5c07d7f-d520-330e-81c6-58d0b462dd10",
                                                "text": "„Die Frau hob den von einer Perücke bedeckten Kopf.“"
                                            },
                                            {
                                                "example_id": "7832d58e-4c57-4160-bd69-3d3c31bde3ac",
                                                "sense_id": "f5c07d7f-d520-330e-81c6-58d0b462dd10",
                                                "text": "„Ein Offizier mit roter Jacke, gepuderter Perücke und Dreispitz trat auf ein Podium und verlas die Aufruhrakte.“"
                                            },
                                            {
                                                "example_id": "04b2a023-f5fe-4ad2-ad1e-1d1ac2555955",
                                                "sense_id": "f5c07d7f-d520-330e-81c6-58d0b462dd10",
                                                "text": "„Von blattlosen Baobabs baumelten kugelförmige Früchte, und die Kronen der Mangobäume hingen wie zerzauste Perücken über ihren Stämmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
