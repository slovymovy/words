                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The quality of being uninteresting; boring; humorless or irksome."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9eae842-3b2a-4dde-9451-0191c4d27b66",
                                                "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                                                "text": "If to raise malicious smiles at the infirmities or misfortunes of those who have never injured us be the province of wit or Humour, Heaven grant me a double Portion of Dullness—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94769bf-51cb-3f2f-af31-15a21321f48c",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "Lack of interest or excitement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The lack of visual brilliance; want of sheen."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ad8e207-7d45-47e3-8180-59e2a5d5e6eb",
                                                "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                                                "text": "dullness of autumn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d666009-b4a3-32a2-b985-e9eee4c3335a",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "bluntness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f409a5a0-b913-30f7-a144-e2aa94056048",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "The quality of not perceiving or kenning things distinctly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2e0863-2cbb-4687-a6d8-79fb0a569c39",
                                                "sense_id": "f409a5a0-b913-30f7-a144-e2aa94056048",
                                                "text": "dullness of sight, or of hearing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "572b30c9-72f3-3661-9606-15b65cfc82f3",
                                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                                        "glosses": [
                                            "Drowsiness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f2ca56-8d54-4dba-a99d-30c018943622",
                                                "sense_id": "572b30c9-72f3-3661-9606-15b65cfc82f3",
                                                "text": "Prospero: […]Thou art inclin'd to sleep. 'Tis a good dulness, / And give it way— I know thou canst not choose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf0fe739-254a-4763-b474-5e91ca0ba398",
                        "source_entry_id": "4577212a-2a59-3f88-be5f-efadc9f28b04",
                        "target_lang_word": "heaviness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heaviness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7ce84f-b58c-3687-bbc5-a96e304708a8",
                                        "entry_id": "7e66c4d4-bec5-3e5e-8a2f-ecf3396924c2",
                                        "glosses": [
                                            "The state of being heavy; weight, weightiness, force of impact or gravity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29a8a37a-9c6e-48c3-a088-44ccc53f4625",
                                                "sense_id": "4f7ce84f-b58c-3687-bbc5-a96e304708a8",
                                                "text": "This figure, immobile and static in his heaviness, was assumed to be deeply asleep and therefore to introduce a note of humorous anecdotality to what should have been a tragic scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                        "entry_id": "7e66c4d4-bec5-3e5e-8a2f-ecf3396924c2",
                                        "glosses": [
                                            "Oppression; dejectedness, sadness; low spirits."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9143c2a-1ade-41d7-bdaa-5ec6b816bf0c",
                                                "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                                "text": "Firſt got vvith guile, and then preſeru'd vvith dread, / And after ſpent with pride and lauiſhneſſe, / Leauing behind them griefe and heauineſſe."
                                            },
                                            {
                                                "example_id": "b0a8ae17-c546-425b-bd85-054705cc5669",
                                                "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                                "text": "By ſo much the more ſhall I to-morrovv be at the height of heart-heavineſs."
                                            },
                                            {
                                                "example_id": "79d0f50c-d263-4cdc-a288-4579023b77c1",
                                                "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                                "text": "[W]hen man ſigheth, (as the Apoſtle ſaith) as burthened vvith inviſcerate intereſts, longing to put on this pure ſpirituall veſture of Filiall love, this kind of heavineſſe of ſpirit, may be ſaid to make his love vveight in heaven; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc32e0b5-3f74-3d5a-b4f2-088ec8a0b727",
                                        "entry_id": "7e66c4d4-bec5-3e5e-8a2f-ecf3396924c2",
                                        "glosses": [
                                            "Drowsiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8ed79b-6f85-4f2e-8038-ee9248683dbb",
                                                "sense_id": "fc32e0b5-3f74-3d5a-b4f2-088ec8a0b727",
                                                "text": "The ſtrangeneſs of your ſtory put / Heavineſs in me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
