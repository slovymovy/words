                },
                {
                    "sense_id": "baf9d0c0-c3da-36e0-a055-1b8212b94099",
                    "sense_definition": "A distinct colour variation characteristic of a species in biology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The black bear sometimes exhibits a cinnamon colour <w>phase</w>.",
                            "target_lang_translations": {
                                "ru": "У черного медведя иногда встречается цветовая <w>морфа</w> оттенка корицы.",
                                "zh": "黑熊有时会出现肉桂色的<w>色型</w>。"
                            }
