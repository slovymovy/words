                "senses": [
                    {
                        "sense_id": "8c3e05f9-6543-33c3-b360-92825fa07877",
                        "entry_id": "32584d72-e750-3256-b8de-5efae74bd0c5",
                        "glosses": [
                            "jährlich während des zwölften und letzten Monats (Ḏū 'l-Ḥiǧǧa) im islamischen Kalenderjahr stattfindende (sogenannte „große“) Pilgerfahrt zur Kaaba nach Mekka, die als eine der fünf Säulen des Islam jede volljährige Person muslimischen Glaubens einmal im Leben unternehmen soll"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "c4805106-6f20-446e-87ab-a78649d339c7",
                                "sense_id": "8c3e05f9-6543-33c3-b360-92825fa07877",
                                "text": "„Derzeit befinden sich mehr als zwei Millionen Muslime in Saudiarabien, um den Haddsch, die jährliche Pilgerfahrt der Gläubigen nach Mekka, zu absolvieren.“"
                            },
                            {
                                "example_id": "f08824ee-80a3-4fe1-b50a-18246649ec4e",
                                "sense_id": "8c3e05f9-6543-33c3-b360-92825fa07877",
                                "text": "„Mohammedanische Tungusenhäuptlinge fliegen nach Mekka zur Haddsch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
