{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c42bed5-e9f3-3ae9-adcd-580f8dad4868",
                    "sense_definition": "A member of a nomadic people traditionally known as gypsies.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical texts from the region often referred to the local <w>faw</w> community with derogatory labels.",
                            "target_lang_translations": {
                                "ru": "Исторические тексты региона часто упоминали местную общину <w>шотландских цыган</w> с использованием уничижительных ярлыков."
                            }
                        },
                        {
                            "text": "The term <w>faw</w> was once used in parts of Scotland to describe traveling groups.",
                            "target_lang_translations": {
                                "ru": "Термин <w>шотландские цыгане</w> когда-то использовался в некоторых частях Шотландии для описания кочевых групп."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель кочевого народа, традиционно называемого цыганами (устаревшее, шотландский диалект)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шотландские цыгане",
                                "target_lang_sense_clarification": "историческое название кочевых групп в Шотландии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7957cabf-5179-3eed-9559-23e6d2120ea6",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian <w>Faw</w> documented the local traditions extensively.",
                            "target_lang_translations": {
                                "ru": "Историк <w>Фо</w> подробно задокументировал местные традиции."
                            }
                        },
                        {
                            "text": "Many people with the name <w>Faw</w> can trace their ancestry back to the northern counties.",
                            "target_lang_translations": {
                                "ru": "Многие люди с фамилией <w>Фо</w> могут проследить свое происхождение до северных графств."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фо",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9790d1ba-3236-3b89-b144-0927d146e672",
                    "sense_definition": "An exclamation of disgust or contempt, an alternative form of <w>faugh</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Faw</w>! I cannot believe you would suggest such a dishonest plan.",
                            "target_lang_translations": {
                                "ru": "<w>Тьфу</w>! Не могу поверить, что ты предложил такой нечестный план."
                            }
                        },
                        {
                            "text": "He dismissed the entire argument with a sharp <w>faw</w> and walked away.",
                            "target_lang_translations": {
                                "ru": "Он отмахнулся от всего спора резким <w>«фу»</w> и ушел."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее отвращение или презрение (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу",
                                "target_lang_sense_clarification": "междометие, выражающее брезгливость"
                            },
                            {
                                "target_lang_word": "тьфу",
                                "target_lang_sense_clarification": "междометие, выражающее презрение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "255889bf-bf05-3b19-99cd-e8bf6a6ca3c4",
                    "sense_definition": "A pronunciation spelling of <w>for</w>, used to represent specific regional or historical accents.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character in the novel asked, what are you looking <w>faw</w>?",
                            "target_lang_translations": {
                                "ru": "Персонаж в романе спросил: «Что ты <w>ищешь</w>?»"
                            }
                        },
                        {
                            "text": "The dialect writing used <w>faw</w> to capture the specific sound of the speaker.",
                            "target_lang_translations": {
                                "ru": "В диалектном письме использовалось <w>«для»</w>, чтобы передать специфическое произношение говорящего."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used to represent non-standard pronunciation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Диалектное написание предлога «for» (для), передающее особенности произношения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для",
                                "target_lang_sense_clarification": "передача значения предлога for"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}