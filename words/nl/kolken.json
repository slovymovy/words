{
    "word_family": [
        "kolk",
        "kolking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d88fcc7-3f64-3c1a-9ba0-78dadacb18e6",
                    "sense_definition": "In een draaiende of kolkende beweging stromen of bewegen (van vloeistoffen)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "water_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water begon hevig te <w>kolken</w> rond de pijlers van de brug.",
                            "target_lang_translations": {
                                "en": "The water began to <w>swirl</w> violently around the pillars of the bridge."
                            }
                        },
                        {
                            "text": "Door de hevige regen zag je de rivier <w>kolken</w>.",
                            "target_lang_translations": {
                                "en": "Due to the heavy rain, you could see the river <w>churning</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wervelen",
                        "mengen"
                    ],
                    "common_phrases": [
                        "wild kolken",
                        "kolken van water"
                    ],
                    "target_lang_definitions": {
                        "en": "To flow or move in a swirling or eddying motion (of liquids)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swirl",
                                "target_lang_sense_clarification": "water or liquid moving in a circle"
                            },
                            {
                                "target_lang_word": "whirlpool",
                                "target_lang_sense_clarification": "to form a whirlpool or eddy"
                            },
                            {
                                "target_lang_word": "churn",
                                "target_lang_sense_clarification": "of water, moving violently"
                            },
                            {
                                "target_lang_word": "eddy",
                                "target_lang_sense_clarification": "moving in circular currents"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e0b1bb-4785-3912-bfc8-44c0475ea06e",
                    "sense_definition": "Door een draaiende waterstroom stijgen, dalen of een gat slijten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "water_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was al snel een diep gat in de dijk <w>gekolkt</w>.",
                            "target_lang_translations": {
                                "en": "A deep hole had soon been <w>scoured</w> into the dike."
                            }
                        },
                        {
                            "text": "Het rivierwater kan grote gaten in de bodem <w>kolken</w>.",
                            "target_lang_translations": {
                                "en": "The river water can <w>hollow out</w> large holes in the bed."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een gat kolken"
                    ],
                    "target_lang_definitions": {
                        "en": "To erode a hole or cause to rise/fall through swirling water motion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hollow out",
                                "target_lang_sense_clarification": "by swirling water action"
                            },
                            {
                                "target_lang_word": "scour",
                                "target_lang_sense_clarification": "erode a bed or bank by water flow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3d32f5b-db9e-3eb3-9a3b-4929e9b93da0",
                    "sense_definition": "Heftige emoties ervaren en nauwelijks kunnen onderdrukken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>kolkte</w> inwendig van woede, maar bleef naar buiten toe heel kalm.",
                            "target_lang_translations": {
                                "en": "He was <w>seething</w> inside with anger, but remained outwardly very calm."
                            }
                        },
                        {
                            "text": "De spanning liet het publiek <w>kolken</w> van emotie.",
                            "target_lang_translations": {
                                "en": "The tension made the audience <w>churn</w> with emotion."
                            }
                        }
                    ],
                    "synonyms": [
                        "koken",
                        "zinderen"
                    ],
                    "common_phrases": [
                        "kolken van woede",
                        "inwendig kolken"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience intense emotions and barely be able to suppress them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seethe",
                                "target_lang_sense_clarification": "with anger or strong emotion"
                            },
                            {
                                "target_lang_word": "boil",
                                "target_lang_sense_clarification": "inside with anger or emotion"
                            },
                            {
                                "target_lang_word": "churn",
                                "target_lang_sense_clarification": "emotions swirling inside"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e28cbc4-b58e-3086-bbf3-e6f56ac81024",
                    "sense_definition": "Meervoudsvorm van <w>kolk</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er ontstonden gevaarlijke <w>kolken</w> in de wilde rivier.",
                            "target_lang_translations": {
                                "en": "Dangerous <w>whirlpools</w> formed in the wild river."
                            }
                        },
                        {
                            "text": "De werkers maakten de <w>kolken</w> langs de weg schoon.",
                            "target_lang_translations": {
                                "en": "The workers cleaned the <w>gullies</w> along the road."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of kolk"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of kolk (whirlpool/eddy or street gully/catch basin)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whirlpools",
                                "target_lang_sense_clarification": "swirling water bodies"
                            },
                            {
                                "target_lang_word": "eddies",
                                "target_lang_sense_clarification": "circular water currents"
                            },
                            {
                                "target_lang_word": "gullies",
                                "target_lang_sense_clarification": "roadside drains"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}