                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e149eca5-da64-4d54-b057-8c9a445ea512",
                                "sense_id": "623b42aa-03b6-358c-aadb-499a13b3ae92",
                                "text": "Бабы-скотницы, подбирая поневы, босыми, еще белыми, не загоревшими ногами шлепая по грязи, с хворостинами бегали за мычавшими, ошалевшими от весенней радости телятами, загоняя их на двор."
                            }
                        ]
                    }
