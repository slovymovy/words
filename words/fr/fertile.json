                        "sol fertile"
                    ]
                },
                {
                    "sense_id": "3a72b7a4-a303-3eb5-b187-6cc0fb1ca4e3",
                    "sense_definition": "Qui a la capacité biologique de se reproduire ou d'engendrer des descendants.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
