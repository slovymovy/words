                        "entry_id": "756c5b53-a598-38c7-a894-bb48f038be7c",
                        "glosses": [
                            "Personnage principal de la pièce Tartuffe ou l'Imposteur, de Molière."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "b1eadb25-8277-448b-acc1-80507de57069",
                                "sense_id": "37f6cd8e-a2a3-3145-9805-7cfb13a79141",
                                "text": "Tous deux venaient de loin en loin pour ne pas effaroucher mademoiselle Sylvie, ils causaient avec Rogron sous divers prétextes, et s’impatronisaient avec une réserve et des façons que le grand Tartufe eût admirées."
                            }
                        ]
                    }
