                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f536bd4-1505-4a51-bfed-8bf8c240a621",
                                "sense_id": "392aff27-0fac-3517-bb95-c86be50f0772",
                                "text": "„Weder Indianer noch Weiße wollten mit mir über die Legenden vom Schlangengott reden, denen ich auf der Spur war.“"
                            },
                            {
                                "example_id": "25cfc180-5126-468d-a603-2a0d729088ea",
                                "sense_id": "392aff27-0fac-3517-bb95-c86be50f0772",
                                "text": "„Vor dem Kampf wagte der angsehene tibetanische Lama Bill Lum Li einen Blick in die Zukunft, indem er den urzeitlichen Schlangengott von Valusien beschwor und unzweifelhafte Hinweise auf einen Sieg beider Parteien erhielt.“"
                            }
                        ],
