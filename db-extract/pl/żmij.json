                        ],
                        "examples": [
                            {
                                "example_id": "e0b7f67e-654c-435c-8e54-665f19e0f141",
                                "sense_id": "eb9dd049-be17-33e2-83f6-d47b70f5a46a",
                                "text": "A spod onego mogilnego chrustu, spod ostatniej warszty, kiedy to już dobrze przygrzało, wypełznął żmij – rozciągnął się, skurczył, znów się rozciągnął, podniósł łba i do boru poszedł…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c29de543-ccf5-3389-92bf-60cc28128ac7",
                        "entry_id": "82e09ae8-589f-3ee4-8d68-6e37a9ce0e62",
                        "glosses": [
                            "żmija, osoba podstępna"
                        ],
                        "tags": [
                            "metaphoric",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d74d16cd-e8e6-4cc1-9d44-0f863b308e5c",
                                "sense_id": "c29de543-ccf5-3389-92bf-60cc28128ac7",
                                "text": "Mam nadzieję, że owego żmiję Tuhaj-bejowicza Bóg wyda w twoje ręce albo Nowowiejskiego, nad którego krzywdą szczerze boleję."
                            }
