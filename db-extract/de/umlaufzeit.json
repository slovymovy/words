                ],
                "senses": [
                    {
                        "sense_id": "98585eec-74b6-3b9c-925b-31686800c6db",
                        "entry_id": "a1725a7d-fef5-3145-bdc4-8e8627a7cbb2",
                        "glosses": [
                            "Dauer der periodischen Bewegung eines Himmelskörpers um einen anderen bis zur Ausgangsposition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327b9bcf-2351-4f2e-b1db-a847a656f9d7",
                                "sense_id": "98585eec-74b6-3b9c-925b-31686800c6db",
                                "text": "„Nach den gleichen Überlegungen ist die Zeit zwischen zwei gleichen Mondphasen länger als die Umlaufzeit des Mondes um die Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b2d0e29-058f-34db-b6e8-2fdf3e7d101e",
                        "entry_id": "a1725a7d-fef5-3145-bdc4-8e8627a7cbb2",
                        "glosses": [
                            "Dauer bis zur Rückkehr eines Transportmittels (zur Zentrale)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "657cd0d1-e6d3-45e7-8fac-1be4ce4c0025",
                                "sense_id": "3b2d0e29-058f-34db-b6e8-2fdf3e7d101e",
                                "text": "„Durch den Einsatz von zwei Lkw ergebe sich, daß bei der vorgenannten Umlaufzeit ca. alle halbe Stunden ein Lkw auf dem Deponiegelände vorfahre.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "01d3c63e-21b1-36d6-87de-4bc9bcc7156c",
                        "entry_id": "a1725a7d-fef5-3145-bdc4-8e8627a7cbb2",
                        "glosses": [
                            "Dauer einer Ampelschaltung mit allen Phasen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c7b3d0-ebd6-45ca-8b4c-359582b2234a",
                                "sense_id": "01d3c63e-21b1-36d6-87de-4bc9bcc7156c",
                                "text": "„Es ergibt sich eine variable Umlaufzeit aus der Summe der Ampelphasen.“"
                            },
                            {
                                "example_id": "220a542d-bc84-4d3e-8146-49c622b14f44",
                                "sense_id": "01d3c63e-21b1-36d6-87de-4bc9bcc7156c",
                                "text": "„‚Ampeln haben für gewöhnlich eine variable Umlaufzeit, die zwischen 45 und 120 Sekunden liegt‘, erläutert Lemmer.“"
                            },
                            {
                                "example_id": "8a2101a4-ed07-4571-b945-5b95ae194a08",
                                "sense_id": "01d3c63e-21b1-36d6-87de-4bc9bcc7156c",
                                "text": "„Während der Umlaufzeit wird ein Signalprogramm einmal vollständig durchlaufen.“"
                            },
                            {
                                "example_id": "1669d9bd-5b3d-4e04-83e3-4f285a47daa2",
                                "sense_id": "01d3c63e-21b1-36d6-87de-4bc9bcc7156c",
                                "text": "„Die Umlaufzeit der Ampel Am Weiher/Ring2 beträgt tags 90 Sekunden: 62 Sekunden Grün für die Autos, 17 Sekunden für die Fußgänger und elf Sekunden ‚Schutzzeit‘, damit ein Fußgänger, der gerade noch bei Grün losgeht, den Straßenrand erreicht, bevor die Autofahrer Gas geben.“"
                            },
                            {
                                "example_id": "08f7e19d-8bdb-445d-be18-b0f444bb1512",
                                "sense_id": "01d3c63e-21b1-36d6-87de-4bc9bcc7156c",
                                "text": "„Die zuständigen Stellen des Magistrats der Stadt Wien werden ersucht die Umlaufzeit der Ampel Dommayergasse / Hietzinger Kai von derzeit 140 Sekunden auf 70 Sekunden zu halbieren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
