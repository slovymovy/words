                ],
                "translations": [
                    {
                        "translation_id": "078e7fd9-d48e-43fb-903d-57a8d25f3a93",
                        "source_entry_id": "717d6060-f6cd-3d6c-aa7a-57c700f81b25",
                        "source_sense_id": "14ff405e-baae-34d9-a5e9-12f2cd458e6b",
                        "source_sense_description": "de vrouw van een zoon of dochter",
                        "target_lang_word": "Schwiegertochter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwiegertochter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "426e9067-2881-347f-897b-f6e0cf9ff57e",
                                        "entry_id": "317e74aa-ee5f-3c08-b32f-b517ff3a61b5",
                                        "glosses": [
                                            "Ehefrau des Sohnes oder der Tochter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8923a7fc-43cb-41b2-bbca-0e890da02df9",
                                                "sense_id": "426e9067-2881-347f-897b-f6e0cf9ff57e",
                                                "text": "Seine Schwiegertochter hat einen Sohn geboren."
                                            },
                                            {
                                                "example_id": "61d43f6b-fdf3-49d1-b398-3e0497b78ada",
                                                "sense_id": "426e9067-2881-347f-897b-f6e0cf9ff57e",
                                                "text": "„Aber vielleicht haben Mütter mit Schwiegertöchtern von vornherein ein Problem; die alte Frau mit der jungen, die Erfahrene mit der Neuen, da sind Ängste der Verdrängung und Eifersucht nicht weit.“"
                                            },
                                            {
                                                "example_id": "3c34734b-73da-4bb8-a0db-1ae1ebc7514c",
                                                "sense_id": "426e9067-2881-347f-897b-f6e0cf9ff57e",
                                                "text": "„Eine Schwiegermutter, die jünger aussieht als ihre künftige Schwiegertochter, ein Vater, der zittert wie der Hoden eines Teppichklopfers – ich wäre misstrauisch.“"
                                            },
                                            {
                                                "example_id": "ab19ff14-eabf-4f6b-9d35-3df8b63e92b5",
                                                "sense_id": "426e9067-2881-347f-897b-f6e0cf9ff57e",
                                                "text": "„Nach dem Mittagessen ging er zu seiner Schwiegertochter.“"
                                            },
                                            {
                                                "example_id": "dcce0639-94e4-443d-b583-5384cc32375d",
                                                "sense_id": "426e9067-2881-347f-897b-f6e0cf9ff57e",
                                                "text": "„Die Schwiegermutter entdeckte der Schwiegertochter, daß Rotermunds Ausmistung seines Zimmers in ihr die schlimmsten Befürchtungen weckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "705048cd-e1aa-4d0e-b72f-bce74121a99e",
                        "source_entry_id": "717d6060-f6cd-3d6c-aa7a-57c700f81b25",
                        "source_sense_id": "14ff405e-baae-34d9-a5e9-12f2cd458e6b",
                        "source_sense_description": "de vrouw van een zoon of dochter",
                        "target_lang_word": "daughter-in-law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daughter-in-law",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                        "entry_id": "bacc60e8-01ed-3d77-a903-1353ee0cbc22",
                                        "glosses": [
                                            "The wife of one's child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91ca37b-741f-4adf-a423-888cb2cd01ad",
                                                "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                                "text": "For I am come to ſet a man at variance* againſt his father, ⁊ the daughter againſt her mother, and the daughter in law againſt her mother in law."
                                            },
                                            {
                                                "example_id": "6c9efc53-0cd9-4546-a529-f24dbfa892b5",
                                                "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                                "text": "They discovered Weller had two daughters and a daughter-in-law in the same cemetery."
                                            },
                                            {
                                                "example_id": "cb788cf9-60ae-429b-9eb8-e77200a15a2f",
                                                "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                                "text": "And we can watch how that plays out as Trump attempts to get his daughter-in-law, Lara, into the U.S. Senate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a5c83a-1b53-4a5f-9e24-8b921c4a68ba",
                        "source_entry_id": "717d6060-f6cd-3d6c-aa7a-57c700f81b25",
                        "source_sense_id": "14ff405e-baae-34d9-a5e9-12f2cd458e6b",
                        "source_sense_description": "de vrouw van een zoon of dochter",
                        "target_lang_word": "belle-fille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belle-fille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79619245-6c53-3d85-a20d-42b0c9d738c4",
                                        "entry_id": "8621ef82-269d-336e-b4c8-be0d3240310e",
                                        "glosses": [
                                            "Fille née d’un lit antérieur de l’un ou de l’autre des deux époux."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b382eb4-caf8-42c5-b3b8-2121291713db",
                                                "sense_id": "79619245-6c53-3d85-a20d-42b0c9d738c4",
                                                "text": "C’est votre belle-fille, vous avez épousé son père."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2233242b-a0b1-3249-b538-7ebdaebd0186",
                                        "entry_id": "8621ef82-269d-336e-b4c8-be0d3240310e",
                                        "glosses": [
                                            "Épouse du fils ou de la fille."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17306d0-6eeb-4fd4-aeb9-2504e4ccd847",
                                                "sense_id": "2233242b-a0b1-3249-b538-7ebdaebd0186",
                                                "text": "M. et Mme Baudoyer, père et mère du nouveau directeur, étaient jouissants de la gloire de leur fils et de leur belle-fille."
                                            },
                                            {
                                                "example_id": "ed9f0593-688c-43d2-adaa-229710d2166d",
                                                "sense_id": "2233242b-a0b1-3249-b538-7ebdaebd0186",
                                                "text": "Quand le marchand d’huile comprit quel marché de dupe il avait fait, il ne lui était plus permis de se débarrasser d’Aristide ; la dot d’Angèle se trouvait engagée dans des spéculations qui tournaient mal. Il dut garder le ménage chez lui, exaspéré, frappé au cœur par le gros appétit de sa belle-fille et par les fainéantises de son fils. Vingt fois, s’il avait pu les désintéresser, il aurait mis à la porte cette vermine qui lui suçait le sang, selon son énergique expression."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13420593-7cdc-4fbe-bf6c-e22a2a2ebbd8",
                        "source_entry_id": "717d6060-f6cd-3d6c-aa7a-57c700f81b25",
                        "source_sense_id": "14ff405e-baae-34d9-a5e9-12f2cd458e6b",
                        "source_sense_description": "de vrouw van een zoon of dochter",
                        "target_lang_word": "bru",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bru",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dee8f0e-e267-3d85-af51-deda2b82cbf8",
                                        "entry_id": "241c01d1-284e-3a78-a29f-11cf8ccdaad7",
                                        "glosses": [
                                            "ou Épouse du fils ou de la fille de quelqu’un."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11c0fd7b-7163-4ef0-b456-7c93378f758d",
                                                "sense_id": "8dee8f0e-e267-3d85-af51-deda2b82cbf8",
                                                "text": "Par un hasard assez rare, elle était au mieux avec sa bru ; il faut dire qu’Angèle n’avait pas une volonté et qu’on pouvait disposer d’elle comme d’un meuble."
                                            },
                                            {
                                                "example_id": "151c54c3-588e-4a5b-9435-b0212bd97dc8",
                                                "sense_id": "8dee8f0e-e267-3d85-af51-deda2b82cbf8",
                                                "text": "Le fils aîné de Mariette est à la guerre. Avec elle est restée sa bru, la frêle, taciturne et héroïque Anne-Marie, […]."
                                            },
                                            {
                                                "example_id": "36484abe-a353-481d-ae88-4b7d1a271ca7",
                                                "sense_id": "8dee8f0e-e267-3d85-af51-deda2b82cbf8",
                                                "text": "La belle-mère ne se consolait pas d’avoir une bru qui lui ressemblât si peu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bru",
                                "target_lang_code": "fr",
