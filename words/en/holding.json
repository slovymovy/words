                            },
                            {
                                "target_lang_word": "mülk",
                                "target_lang_sense_clarification": "sahip olunan arazi veya taşınmaz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "789efa73-f731-341f-af87-e10b7089c0f7",
                    "sense_definition": "A company formed to own the stock of other companies and control their operations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "assets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank is part of a large international <w>holding</w> based in Europe.",
                            "target_lang_translations": {
                                "ru": "Банк является частью крупного международного <w>хо́лдинга</w>, базирующегося в Европе.",
                                "tr": "Banka, Avrupa merkezli büyük bir uluslararası <w>holdingin</w> parçasıdır."
                            }
                        },
                        {
                            "text": "They formed a <w>holding</w> company to manage the various subsidiaries.",
                            "target_lang_translations": {
                                "ru": "Они создали <w>хо́лдинговую</w> компанию для управления различными дочерними предприятиями.",
                                "tr": "Çeşitli bağlı ortaklıkları yönetmek için bir <w>holding</w> şirketi kurdular."
                            }
