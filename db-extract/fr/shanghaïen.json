                        "entry_id": "f59e0807-1ab3-386d-af29-5ae12c7b3f59",
                        "glosses": [
                            "Habitant de Shanghaï, personne originaire de Shanghaï."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9267e45e-fe4a-4023-b3c5-c54a15d8e25e",
                                "sense_id": "d6a6ccf2-bcf1-3a72-be08-b7b0402aad61",
                                "text": "Ce n’était pas fin Shanghaïen, mais un Chinois du Nord ou du Turkestan :[…]."
                            },
                            {
                                "example_id": "fbd7f981-d58d-4b28-a26e-0488500cafdc",
                                "sense_id": "d6a6ccf2-bcf1-3a72-be08-b7b0402aad61",
                                "text": "Il en faudrait pourtant davantage pour démotiver Lu Minqi, un Shanghaïen de 20 ans employé du géant des assurances Ping An."
                            },
                            {
                                "example_id": "127ef324-68fe-4d4c-92ab-c4b2b76b1011",
                                "sense_id": "d6a6ccf2-bcf1-3a72-be08-b7b0402aad61",
                                "text": "Hergé a une autre source d'information : Tchang Tchong-Jen, un Shanghaïen du même âge que lui, inscrit aux Beaux-Arts de Bruxelles."
                            }
                        ]
                    }
