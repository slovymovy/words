                                "sense_id": "b7f7fc4d-22f6-302a-a47a-dd5270e77a5b",
                                "text": "Prothorax bright green, narrow, the dorsal middle with a broad carneous stripe continuous with that the head, entire, each side of this a black line dilating posteriorly."
                            },
                            {
                                "example_id": "733b7c99-9b29-42d3-87f2-0eb4a3a271de",
                                "sense_id": "b7f7fc4d-22f6-302a-a47a-dd5270e77a5b",
                                "text": "Secondaries dark fuscous with a carneous shade which obtains on the fringes ."
                            },
                            {
                                "example_id": "3c175853-9943-4e36-bc74-639c3a15ed7a",
                                "sense_id": "b7f7fc4d-22f6-302a-a47a-dd5270e77a5b",
                                "text": "A carneous fringe each side of the body, just above the legs."
                            }
                        ]
                    }
