                                    {
                                        "sense_id": "cabae79e-b9ad-32d9-857c-6a52e7f9f563",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Lack of pertinence; irrelevance."
