        "fr-extract.jsonl": [
            {
                "entry_id": "2c247199-66b6-363c-9242-468f5b4f5cbd",
                "word": "tendelet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "299421f3-584f-45e6-9b85-e90355ed4a5e",
                        "entry_id": "2c247199-66b6-363c-9242-468f5b4f5cbd",
                        "tags": [
                            "plural"
                        ],
                        "form": "tendelets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a2b689e-fe96-30a7-a578-c32227e38b59",
                        "entry_id": "2c247199-66b6-363c-9242-468f5b4f5cbd",
                        "glosses": [
                            "Petite tente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285ec680-bdb9-45a0-ab97-b5598c567cbd",
                                "sense_id": "6a2b689e-fe96-30a7-a578-c32227e38b59",
                                "text": "À d’autres temps, pour plus tard, les grands voyages à travers le monde, au dos des chameaux sur des selles turques, ou sous le tendelet des éléphants ;"
                            },
                            {
                                "example_id": "6a9f19f9-c1dc-489a-924a-a4c25b702f4b",
                                "sense_id": "6a2b689e-fe96-30a7-a578-c32227e38b59",
                                "text": "Il vit alors que sa tête était abritée sous un tendelet d’étoffe bleue, que maintenaient une série de petits bâtons piqués dans le sable, — le tout projetant sur lui, avec des contours bizarres, une ombre nette et cendrée…"
                            }
                        ]
                    },
                    {
                        "sense_id": "858b9e83-0a27-3ba5-90b7-454375f79c70",
                        "entry_id": "2c247199-66b6-363c-9242-468f5b4f5cbd",
                        "glosses": [
                            "Sorte de petite tente, de pièce d’étoffe destinée à protéger une embarcation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bd29b1-90d6-4736-b903-9eb9c8ed27c7",
                                "sense_id": "858b9e83-0a27-3ba5-90b7-454375f79c70",
                                "text": "Les armes de Votre Majesté garnissent la poupe, et le tendelet est d’une estoffe d’or à fond bleu, au lieu que le tendelet du Grand-Seigneur est de drap rouge, et celuy du Grand-Visir de drap vert. Le tendelet sert à se mettre à couvert des rayons du soleil et des injures du temps,"
                            },
                            {
                                "example_id": "d5d19993-5cc7-42bb-978f-4cf23c68c140",
                                "sense_id": "858b9e83-0a27-3ba5-90b7-454375f79c70",
                                "text": "Cela s’enrichissait encore de pavillons de toutes nuances et de toutes formes, des tendelets pour les chaloupes."
                            }
                        ]
                    },
                    {
                        "sense_id": "045deb5f-8123-3073-91ba-beec2a1fe4a5",
                        "entry_id": "2c247199-66b6-363c-9242-468f5b4f5cbd",
                        "glosses": [
                            "Pièce de toile ou de cuir destinée à protéger les places extérieures d’un coupé ou d'un autre type de véhicule découvert."
                        ],
                        "tags": [
                            "Automobilisme"
                        ],
                        "examples": [
                            {
                                "example_id": "ea9d0bfc-e1d0-44fc-b9cd-4d0448f7135c",
                                "sense_id": "045deb5f-8123-3073-91ba-beec2a1fe4a5",
                                "text": "À tout le moins, tirons de notre rencontre ce profit de nous reposer un peu, abrités du vent de bise par le tendelet du chariot."
                            },
                            {
                                "example_id": "769bcbc4-3e76-4992-bb11-b523b08a4f3c",
                                "sense_id": "045deb5f-8123-3073-91ba-beec2a1fe4a5",
                                "text": "Ce tendelet, en tissu caoutchouté, s’enroule automatiquement sur un rouleau fixé près de la toiture, et va, en cas de pluie, s’assembler au pare-brise au moyen d’une gorge fendue."
                            }
                        ]
                    }
                ],
