        "nl-extract.jsonl": [
            {
                "entry_id": "88d45c28-3797-318f-a3ff-7f3e8a2a00df",
                "word": "gelijkelijk",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31f0cb6c-b7e7-3aea-b185-b6cbf47657c2",
                        "entry_id": "88d45c28-3797-318f-a3ff-7f3e8a2a00df",
                        "glosses": [
                            "gelijk, hetzelfde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04a96021-3002-42d2-8d82-9c86accb1492",
                                "sense_id": "31f0cb6c-b7e7-3aea-b185-b6cbf47657c2",
                                "text": "Iedere Nederlander heeft gelijkelijk recht de leden van algemeen vertegenwoordigende organen te verkiezen alsmede tot lid van deze organen te worden verkozen, behoudens bij de wet gestelde beperkingen en uitzonderingen.(Grondwet Artikel 4)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25999563-7e6a-413f-a3f4-d3ed8ebb35fc",
                        "source_entry_id": "88d45c28-3797-318f-a3ff-7f3e8a2a00df",
                        "source_sense_id": "31f0cb6c-b7e7-3aea-b185-b6cbf47657c2",
                        "target_lang_word": "alike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "715983d1-b35f-3e70-b592-343062f728f3",
                                        "entry_id": "e44c8dcc-f161-31c4-91c2-2e63efa7a70e",
                                        "glosses": [
                                            "Having resemblance or similitude; similar; without difference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "893a85a4-3034-49f3-a4fd-032a2176a0fe",
                                                "sense_id": "715983d1-b35f-3e70-b592-343062f728f3",
                                                "text": "Twins are physically alike, that is, similar-looking people on the outside."
                                            },
                                            {
                                                "example_id": "64a02a7d-0c88-46e9-a75a-4268039e8be2",
                                                "sense_id": "715983d1-b35f-3e70-b592-343062f728f3",
                                                "text": "The wide prospect up stream was grey and lowering, the long still-distant waterfront of Dundee, and the Fife shore were alike colourless, and there was ample evidence of rough weather not far ahead."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01a17a37-5d3b-3889-adf3-cccca6139156",
                                        "entry_id": "240abe18-9c8b-35c0-aef2-1b36989c071d",
                                        "glosses": [
                                            "In the same manner, form, or degree; in common; equally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ccf0f73-bff2-4083-8d2e-b117a897ba13",
                                                "sense_id": "01a17a37-5d3b-3889-adf3-cccca6139156",
                                                "text": "We are all alike concerned in religion."
                                            },
                                            {
                                                "example_id": "d254963f-8efd-4556-8f1e-e3cfe9a04068",
                                                "sense_id": "01a17a37-5d3b-3889-adf3-cccca6139156",
                                                "text": "As the Knight himself seemed tacitly to disclaim alike interest and controul over the immediate favourite of his lady, young Roland was, by circumstances, exempted from the strict discipline to which, as the retainer of a Scottish man of rank, he would otherwise have been subjected, according to all the rigour of the age."
                                            },
                                            {
                                                "example_id": "5fb19340-c47e-4ccd-b49d-7291842e0d26",
                                                "sense_id": "01a17a37-5d3b-3889-adf3-cccca6139156",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers, of errand not wholly obvious to their fellows, yet of such sort as to call into query alike the nature of their errand and their own relations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1580fbb-15a9-31a6-b010-a53ec6ea59f1",
                                        "entry_id": "240abe18-9c8b-35c0-aef2-1b36989c071d",
                                        "glosses": [
                                            "In the same manner, form, or degree; in common; equally.",
                                            "Used after a list of subjects to indicate that something applies equally to all of them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a632066-cd83-4740-aca0-741d099ff7f7",
                                                "sense_id": "f1580fbb-15a9-31a6-b010-a53ec6ea59f1",
                                                "text": "The new policy will benefit employees and customers alike."
                                            },
                                            {
                                                "example_id": "82e83028-8e40-4e54-9aa3-84f31129de5a",
                                                "sense_id": "f1580fbb-15a9-31a6-b010-a53ec6ea59f1",
                                                "text": "In the words of an official report (that might well apply to all the railways): \"Public interest in the region of Cuenca is not favourable towards completion of the railway, probably because it has shifted towards the road construction programme now being favoured by the Government and public alike.\""
                                            },
                                            {
                                                "example_id": "08e77d72-c4cc-4227-a41d-72af7d51fd01",
                                                "sense_id": "f1580fbb-15a9-31a6-b010-a53ec6ea59f1",
                                                "text": "There is a dangerous censoriousness pulsing through American society. In small towns and big cities alike, would-be commissars are fighting, in the name of a distinct minority of Americans, to stifle open discussion and impose their views on the community at large. Dissenters, when they speak out, are hounded, ostracized and sometimes even forced from their jobs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "471f34b9-642d-4bfc-b7b7-48eed4423375",
                        "source_entry_id": "88d45c28-3797-318f-a3ff-7f3e8a2a00df",
                        "source_sense_id": "31f0cb6c-b7e7-3aea-b185-b6cbf47657c2",
                        "target_lang_word": "all the same",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all the same",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f44383b-ca1d-3322-b6a4-1c19f1958a6e",
                                        "entry_id": "2474d775-a418-314d-b7fb-7e6a0c599285",
                                        "glosses": [
                                            "Making no significant difference."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25d705e-22fb-45b3-b19a-0c8913b8863c",
                                                "sense_id": "2f44383b-ca1d-3322-b6a4-1c19f1958a6e",
                                                "text": "Near-synonym: all one"
                                            },
                                            {
                                                "example_id": "9a50c03d-bd8e-48d1-99c6-0a66b0186659",
                                                "sense_id": "2f44383b-ca1d-3322-b6a4-1c19f1958a6e",
                                                "text": "It's all the same to me if you want to leave early."
                                            },
                                            {
                                                "example_id": "34857182-cf93-4810-bf77-da3c35bfb312",
                                                "sense_id": "2f44383b-ca1d-3322-b6a4-1c19f1958a6e",
                                                "text": "Certainly, many women have found me interesting. All the same, the women closest to me are invariably deeply dissatisfied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d0a0b20-2fdd-314e-aba6-21469bbe3586",
                                        "entry_id": "2474d775-a418-314d-b7fb-7e6a0c599285",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see all, same."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff0fc545-58bf-4395-8197-34e73a87920e",
                                                "sense_id": "6d0a0b20-2fdd-314e-aba6-21469bbe3586",
                                                "text": "His speeches are all the same."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all the same",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b64103b-a390-33fe-a842-807c07421284",
                                        "entry_id": "b5d0da07-3760-3e60-8060-b4d3f6a33633",
                                        "glosses": [
                                            "Anyway; nevertheless; nonetheless."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25f3d51e-455c-4b4e-ae96-966d9cc5b055",
                                                "sense_id": "4b64103b-a390-33fe-a842-807c07421284",
                                                "text": "He knew it was risky. He did it all the same."
                                            },
                                            {
                                                "example_id": "6221b302-07c7-4477-8eff-68cdd16e2c14",
                                                "sense_id": "4b64103b-a390-33fe-a842-807c07421284",
                                                "text": "It's sleeting. All the same, I'll take the dog out."
                                            },
                                            {
                                                "example_id": "5df63070-987d-4c9a-89b8-945d8eaa01ea",
                                                "sense_id": "4b64103b-a390-33fe-a842-807c07421284",
                                                "text": "So GCN calls and I'm thinking — what can I say in the pages of an anti-racist, but all the same White newspaper? What will I choose not to say?"
                                            },
                                            {
                                                "example_id": "842e11ae-cf67-4b09-a5c9-d774c199cd48",
                                                "sense_id": "4b64103b-a390-33fe-a842-807c07421284",
                                                "text": "It's a distant solar system / I tried to phone but they don't list 'em / So I asked her for a number all the same"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00e81d7c-0639-4f7a-a2ff-0613fea4e47e",
                        "source_entry_id": "88d45c28-3797-318f-a3ff-7f3e8a2a00df",
                        "source_sense_id": "31f0cb6c-b7e7-3aea-b185-b6cbf47657c2",
                        "target_lang_word": "equally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                        "entry_id": "c437f5b0-2e08-33a4-9428-6647e0fb20a6",
                                        "glosses": [
                                            "In an equal manner; in equal shares or proportion; with equal and impartial justice; evenly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4035306-4358-4029-b909-31b301618a92",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "All citizens are equally taxed."
                                            },
                                            {
                                                "example_id": "4f29a561-e1c3-49b4-90af-58fc98681568",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "The pie was divided equally among the guests."
                                            },
                                            {
                                                "example_id": "0fb3bca3-463e-4a6e-a648-13519b297074",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "They shared equally in the spoils."
                                            },
                                            {
                                                "example_id": "16d66741-8ef9-4045-abc0-982778f7ba0e",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "And when their ſcattered armie is ſubdu’d:\nAnd you march on their ſlaughtered carkaſſes,\nShare equally the gold that bought their liues,\nAnd liue like Gentlmen in Perſea, […]"
                                            },
                                            {
                                                "example_id": "c74c8e28-0ef6-4e0c-b7a4-07afa81c4c78",
                                                "sense_id": "029d355b-9ffc-3242-9a52-72e22abf6494",
                                                "text": "You have to give them credit, rarely does a character appeal equally to four-year-old children and middle-aged aunts posting tepid jokes and fake Oscar Wilde quotes on their timelines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "665410fc-a4e5-30ed-ad95-26b596086072",
                                        "entry_id": "c437f5b0-2e08-33a4-9428-6647e0fb20a6",
                                        "glosses": [
                                            "In equal degree or extent; just as."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8790eec-4eb4-4b6b-b7d8-15328aa0cd1a",
                                                "sense_id": "665410fc-a4e5-30ed-ad95-26b596086072",
                                                "text": "The gas stations are equally far from the highway."
                                            },
                                            {
                                                "example_id": "4a06f7c9-a1a5-4bbd-9e44-5b9690fa421b",
                                                "sense_id": "665410fc-a4e5-30ed-ad95-26b596086072",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd4e538a-0714-3012-b072-70395f0449cf",
                                        "entry_id": "c437f5b0-2e08-33a4-9428-6647e0fb20a6",
                                        "glosses": [
                                            "Used to link two or more coordinate elements"
                                        ],
                                        "tags": [
                                            "conjunctive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7235afb9-7b90-49d2-92e4-ce22c9af897a",
                                                "sense_id": "bd4e538a-0714-3012-b072-70395f0449cf",
                                                "text": "John suffered setbacks at his job. Equally, Frank's business slowed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
