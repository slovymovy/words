                        "glosses": [
                            "Membre d’un groupe humain qui colonise une partie de la Sibérie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6258d75e-08c5-4b5d-997c-7f394f3d6c19",
                                "sense_id": "a56bdb11-5da1-37b8-860e-51460d615534",
                                "text": "Chaque Tchoutche porte, pendu à son cou, un petit sac de cuir qui renferme du tabac et du sucre. Un morceau de sucre, qui a été longtemps enfermé avec du tabac, en est imprégné et en est d’autant plus agréable au Tchoutche."
                            }
                        ]
