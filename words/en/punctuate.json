{
    "word_family": [
        "punctuation",
        "punctuator",
        "punctual",
        "punctuality"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f9c0006-85fe-3cf4-9296-6407c9d16499",
                    "sense_definition": "To insert punctuation marks into written text to clarify meaning and structure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remember to <w>punctuate</w> your sentences correctly with commas and periods.",
                            "target_lang_translations": {
                                "de": "Denken Sie daran, Ihre Sätze mit Kommas und Punkten richtig zu <w>interpunktieren</w>."
                            }
                        },
                        {
                            "text": "The student struggled to <w>punctuate</w> the dialogue properly in his story.",
                            "target_lang_translations": {
                                "de": "Der Schüler tat sich schwer damit, die Dialoge in seiner Geschichte richtig zu <w>interpunktieren</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "punctuate correctly",
                        "punctuate a sentence"
                    ],
                    "target_lang_definitions": {
                        "de": "Satzzeichen in einen geschriebenen Text setzen, um dessen Bedeutung und Struktur zu verdeutlichen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "interpunktieren",
                                "target_lang_sense_clarification": "Satzzeichen setzen"
                            },
                            {
                                "target_lang_word": "Zeichen setzen",
                                "target_lang_sense_clarification": "Satzzeichen einfügen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e97d62da-aa0c-3da7-8289-a4a1b82b087c",
                    "sense_definition": "To interrupt or occur at intervals throughout an event or speech.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker's lecture was <w>punctuated</w> by bursts of applause from the audience.",
                            "target_lang_translations": {
                                "de": "Der Vortrag des Redners wurde immer wieder von Beifallsausbrüchen des Publikums <w>unterbrochen</w>."
                            }
                        },
                        {
                            "text": "Loud thunderclaps continued to <w>punctuate</w> the quiet evening.",
                            "target_lang_translations": {
                                "de": "Laute Donnerschläge <w>durchbrachen</w> weiterhin die Stille des Abends."
                            }
                        }
                    ],
                    "synonyms": [
                        "interrupt",
                        "intersperse"
                    ],
                    "common_phrases": [
                        "punctuated by"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Ereignis oder eine Rede wiederholt unterbrechen oder darin in regelmäßigen Abständen auftreten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unterbrechen",
                                "target_lang_sense_clarification": "wiederholt stören oder durchbrechen"
                            },
                            {
                                "target_lang_word": "durchsetzen",
                                "target_lang_sense_clarification": "von etwas durchsetzt oder begleitet sein"
                            },
                            {
                                "target_lang_word": "durchbrechen",
                                "target_lang_sense_clarification": "eine Phase oder Kontinuität unterbrechen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3a01aff-9d20-3bb4-ac3e-3d0b91a0a7f4",
                    "sense_definition": "To emphasize, highlight, or give special stress to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slammed her hand on the table to <w>punctuate</w> her demand.",
                            "target_lang_translations": {
                                "de": "Sie schlug mit der Hand auf den Tisch, um ihrer Forderung Nachdruck zu verleihen und sie zu <w>unterstreichen</w>."
                            }
                        },
                        {
                            "text": "He shook his head vigorously to <w>punctuate</w> his complete disagreement.",
                            "target_lang_translations": {
                                "de": "Er schüttelte heftig den Kopf, um seine völlige Ablehnung zu <w>bekräftigen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "emphasize",
                        "stress",
                        "underline"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas besonders hervorheben, betonen oder unterstreichen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unterstreichen",
                                "target_lang_sense_clarification": "besonders betonen oder hervorheben"
                            },
                            {
                                "target_lang_word": "bekräftigen",
                                "target_lang_sense_clarification": "einer Aussage Nachdruck verleihen"
                            },
                            {
                                "target_lang_word": "betonen",
                                "target_lang_sense_clarification": "hervorheben"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "61589e73-97aa-32f7-bd10-df816fcf8769",
                    "sense_definition": "Having tiny spots, points, or depressions; point-like.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient developed a <w>punctuate</w> rash across both of his shoulders.",
                            "target_lang_translations": {
                                "de": "Der Patient entwickelte einen <w>punktförmigen</w> Ausschlag an beiden Schultern."
                            }
                        },
                        {
                            "text": "Microscopic examination revealed tiny <w>punctuate</w> marks on the leaf's surface.",
                            "target_lang_translations": {
                                "de": "Die mikroskopische Untersuchung ergab winzige, <w>punktförmige</w> Flecken auf der Blattoberfläche."
                            }
                        }
                    ],
                    "synonyms": [
                        "punctiform",
                        "spotted"
                    ],
                    "common_phrases": [
                        "punctuate rash"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit winzigen Punkten, Flecken oder Vertiefungen versehen; punktförmig."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "punktförmig",
                                "target_lang_sense_clarification": "in Form kleiner Punkte"
                            },
                            {
                                "target_lang_word": "getupft",
                                "target_lang_sense_clarification": "mit winzigen Punkten oder Flecken übersät"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}