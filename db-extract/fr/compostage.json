            {
                "entry_id": "ff9feb78-cf6a-3717-9a38-539ed9ddefaf",
                "word": "compostage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9ad6195b-f03b-48fb-8b88-66da59038cf0",
                        "entry_id": "ff9feb78-cf6a-3717-9a38-539ed9ddefaf",
                        "tags": [
                            "plural"
                        ],
                        "form": "compostages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45b559b0-8bc2-352a-9a02-d6d69987ed2a",
                        "entry_id": "ff9feb78-cf6a-3717-9a38-539ed9ddefaf",
                        "glosses": [
                            "Action de composter un ticket, un billet de train, d'affranchir avec un composteur."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "21e095cd-039b-4f2c-a38d-790898c62793",
                                "sense_id": "45b559b0-8bc2-352a-9a02-d6d69987ed2a",
                                "text": "Le compostage est obligatoire avant de monter dans le train."
                            },
                            {
                                "example_id": "b43e51c5-8363-4601-ab34-2ed4ad3590b4",
                                "sense_id": "45b559b0-8bc2-352a-9a02-d6d69987ed2a",
                                "text": "Viterdo glisse son billet dans l'appareil de compostage.\n– De plus en plus compliqués, ces appareils, dit Louis. Heureusement que je ne voyage plus..."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6060d9a-745f-362f-be1d-986da1d88313",
                        "entry_id": "ff9feb78-cf6a-3717-9a38-539ed9ddefaf",
                        "glosses": [
                            "Dégradation biologique contrôlée de matières organiques par décomposition aérobie, produisant un amendement organique appelé compost."
                        ],
                        "tags": [
                            "Sciences de l’environnement",
                            "Gestion des déchets"
                        ],
                        "examples": [
                            {
                                "example_id": "4a4ad59b-629f-42e0-9e9a-92dc5d5a0f96",
                                "sense_id": "c6060d9a-745f-362f-be1d-986da1d88313",
                                "text": "Le compostage domestique n'est autre que la reproduction d'un phénomène naturel au bénéfice du jardinier."
                            },
                            {
                                "example_id": "4ce9dc25-cd18-4735-857e-1a3379ca7e8f",
                                "sense_id": "c6060d9a-745f-362f-be1d-986da1d88313",
                                "text": "Le lombricompostage est une variante du compostage reposant sur l'utilisation de vers de terre (lombrics) pour consommer et dégrader la matière organique du déchet."
                            },
                            {
                                "example_id": "91116d18-22ea-4f82-a9b2-c2136c43ae9a",
                                "sense_id": "c6060d9a-745f-362f-be1d-986da1d88313",
                                "text": "Une bonne circulation de l'air au sein du tas et surtout du bac de compostage est primordiale. En remplissant votre composteur de déchets végétaux, ajoutez régulièrement des branchages sur une dizaine de centimètres."
                            },
                            {
                                "example_id": "d3f87348-03d2-49ec-8c24-b82ce2dd1c47",
                                "sense_id": "c6060d9a-745f-362f-be1d-986da1d88313",
                                "text": "Du fait que les excréments sont compostables à moyenne et grande échelle, peut-être serez-vous tenté de les introduire dans le compostage domestique malgré les recommandations contraires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6d889e8-1b3b-4199-9313-d20c6f25e7d4",
                        "source_entry_id": "ff9feb78-cf6a-3717-9a38-539ed9ddefaf",
                        "source_sense_description": "Action de composter un ticket",
                        "target_lang_word": "Entwertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entwertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c02bfdef-2aaf-38ef-9795-2390a2754f13",
                                        "entry_id": "1c75de72-f9c3-3087-bba4-ac0ce96e74df",
                                        "glosses": [
                                            "das Ungültigmachen, das Abstempeln (z. B. von Eintrittskarten, Fahrkarten, Briefmarken), um eine nochmalige Verwendung zu verhindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c01e60c-57a4-48c5-a4b3-b3d3f9e254b5",
                                                "sense_id": "c02bfdef-2aaf-38ef-9795-2390a2754f13",
                                                "text": "„Wegen doppelter Entwertung wurde sie als Schwarzfahrerin angezeigt und sollte ein erhöhtes Beförderungsentgelt zahlen.“"
                                            },
                                            {
                                                "example_id": "e7f1a0db-67ae-4eda-8da6-3fb1818668c1",
                                                "sense_id": "c02bfdef-2aaf-38ef-9795-2390a2754f13",
                                                "text": "„Am 1. November 1849 gab es natürlich noch keine Stempel, die speziell zur Entwertung von Briefmarken gedient hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                        "entry_id": "1c75de72-f9c3-3087-bba4-ac0ce96e74df",
                                        "glosses": [
                                            "das Herabsetzen im Wert, der Verlust an Wert (insbesondere von Geld)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c397efaf-daf7-4ee3-85d6-a3b5057756fb",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Schau nur, Leo wird nach Paris ziehen; bei der Entwertung der Krone könnten wir euch unmöglich mit Francs unterstützen und ihr würdet vielleicht ins Elend kommen, ohne daß Papa helfen kann.“"
                                            },
                                            {
                                                "example_id": "7c1e3156-03f0-44bb-a040-f5fc6597edfe",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Wir erleben seit kurzem eine rasante Entwertung des Europa-Begriffs.“"
                                            },
                                            {
                                                "example_id": "0bd94adc-d25b-4558-9448-5db5492a8909",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Im Sommer 1923 indes zerstörte die immer raschere Entwertung der Mark die Wirtschaft, es drohten Lebensmittelknappheit und Massenelend, und das Reich stand kurz vor der Auflösung.“"
                                            },
                                            {
                                                "example_id": "2e0a2c14-b431-40e5-af7c-95bc1ea6da08",
                                                "sense_id": "0efe5bd3-9e4e-36b2-9ee3-04eceb610d21",
                                                "text": "„Die Jugendlichen befürchteten kaum Beschäftigungsrisiken, erwarteten vielmehr ein Ansteigen der fachpraktischen und berufstheoretischen Qualifikationsanforderungen und hofften, daß technische Innovationen nicht zu einer Entwertung der Facharbeit führen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
