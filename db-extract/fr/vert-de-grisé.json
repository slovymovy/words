                "senses": [
                    {
                        "sense_id": "789e8124-59f0-35a2-82eb-9b4184422d4c",
                        "entry_id": "6aa91054-3eda-3fbd-aca6-3a5ab9fa9a81",
                        "glosses": [
                            "Qui est couvert de vert-de-gris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f71a8c-d7ac-4f95-9279-03a4406b7566",
                                "sense_id": "789e8124-59f0-35a2-82eb-9b4184422d4c",
                                "text": "Parce que vous mêlez à la cire des cierges\nVotre affreux suif vert-de-grisé."
                            },
                            {
                                "example_id": "1339680f-6486-4d33-bdd2-e5561e6131ac",
                                "sense_id": "789e8124-59f0-35a2-82eb-9b4184422d4c",
                                "text": "De chaque côté de la chaussée se hérissent des aloès énormes, agitant leurs coutelas ; de gigantesques cactus aux palettes vert-de-grisées, aux tronçons difformes, se tordent hideusement comme des boas monstrueux, comme des échines de cachalots échoués."
                            },
                            {
                                "example_id": "6667d008-7c0e-4126-8cc7-34787f0990a3",
                                "sense_id": "789e8124-59f0-35a2-82eb-9b4184422d4c",
                                "text": "À onze heures, nous rentrions à l’hôtel Bristol, après une promenade autour des jardins de la Hofburg, sous un clair de lune excessif qui ruisselait sous les coupoles vert-de-grisées et les toits brillants du palais."
                            },
                            {
                                "example_id": "e5bf4dda-63d9-4804-b359-e68893d2b1de",
                                "sense_id": "789e8124-59f0-35a2-82eb-9b4184422d4c",
                                "text": "D'autres renégats (car le converti est toujours le renégat de quelque chose), plus respectueux des causes perdues, les ont pieusement ensevelis dans quelque coin de la cave ou du jardin : ce sont ces dieux-là que nous retrouvons vert-de-grisés."
                            },
                            {
                                "example_id": "a767097f-eb3f-42a1-8a01-457d68b3e25f",
                                "sense_id": "789e8124-59f0-35a2-82eb-9b4184422d4c",
                                "text": "Un muret de brique vert-de-grisé s’ouvrait sur un large panorama."
                            }
                        ]
                    }
                ],
