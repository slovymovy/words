                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>tar</w> the roof to prevent any leaks during the winter.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>засмолить</w> крышу, чтобы предотвратить протечки зимой."
                            }
                        },
                        {
                            "text": "The workers began to <w>tar</w> the driveway early in the morning.",
                            "target_lang_translations": {
                                "ru": "Рано утром рабочие начали <w>гудронировать</w> подъездную дорожку."
                            }
