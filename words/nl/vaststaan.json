{
    "word_family": [
        "vaststelling",
        "vaststand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f1ed540-ae59-3bad-a577-ad9cdf4d9f57",
                    "sense_definition": "buiten twijfel zijn; zeker of bewezen zijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>staat</w> nu wel <w>vast</w> dat we volgende week gaan verhuizen.",
                            "target_lang_translations": {
                                "fr": "Il <w>est</w> désormais <w>certain</w> que nous déménagerons la semaine prochaine."
                            }
                        },
                        {
                            "text": "De investeringsmaatschappij trekt alleen geld uit voor projecten waarvan <w>vaststaat</w> dat ze winst opleveren.",
                            "target_lang_translations": {
                                "fr": "La société d'investissement ne débloque des fonds que pour des projets dont il <w>est établi</w> qu'ils sont rentables."
                            }
                        }
                    ],
                    "common_phrases": [
                        "als een paal boven water vaststaan"
                    ],
                    "target_lang_definitions": {
                        "fr": "Être certain, prouvé ou hors de doute"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "être certain",
                                "target_lang_sense_clarification": "ne faire aucun doute"
                            },
                            {
                                "target_lang_word": "être établi",
                                "target_lang_sense_clarification": "démontré ou prouvé"
                            },
                            {
                                "target_lang_word": "être sûr",
                                "target_lang_sense_clarification": "assuré"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21340059-7958-3de4-8e30-47b6d4f9187b",
                    "sense_definition": "onveranderlijk bepaald zijn of fysiek niet kunnen bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbeweeglijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De afspraak <w>staat</w> definitief <w>vast</w> in onze agenda.",
                            "target_lang_translations": {
                                "fr": "Le rendez-vous <w>est</w> définitivement <w>fixé</w> dans notre agenda."
                            }
                        },
                        {
                            "text": "Door de hevige sneeuwval bleven veel auto's op de snelweg <w>vaststaan</w>.",
                            "target_lang_translations": {
                                "fr": "En raison des fortes chutes de neige, de nombreuses voitures sont restées <w>bloquées</w> sur l'autoroute."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Être fixé de manière définitive, ou être bloqué sans pouvoir bouger"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "être fixé",
                                "target_lang_sense_clarification": "décidé définitivement, prévu"
                            },
                            {
                                "target_lang_word": "être bloqué",
                                "target_lang_sense_clarification": "immobilisé physiquement"
                            },
                            {
                                "target_lang_word": "être coincé",
                                "target_lang_sense_clarification": "immobilisé"
                            }
                        ]
                    }
                }
            ]
        }
    ]
