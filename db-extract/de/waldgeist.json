                "senses": [
                    {
                        "sense_id": "af762733-9ded-3be3-ba33-61d04d840d4a",
                        "entry_id": "e8d4aec2-87ef-3b77-b33d-e3a3f1be1ad0",
                        "glosses": [
                            "im Wald lebender Geist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a61c1681-a4a8-471f-bd89-a4ce029b64cd",
                                "sense_id": "af762733-9ded-3be3-ba33-61d04d840d4a",
                                "text": "„Ihre Augen kamen mir manchmal wie die Augen eines dämonischen Waldgeistes oder einer Tiergöttin vor, so unermesslich alt, dass sie nicht ganz menschlich sein konnten.“"
                            },
                            {
                                "example_id": "f7260d13-10cb-4ee5-98e4-21e48d6a01e2",
                                "sense_id": "af762733-9ded-3be3-ba33-61d04d840d4a",
                                "text": "„In diesem schwachen Licht war nur der ungefähre Umriss des Mannes sichtbar: Er sah dünn und zerbrechlich wie ein Waldgeist aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
