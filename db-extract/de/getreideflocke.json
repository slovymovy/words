                "senses": [
                    {
                        "sense_id": "57480be5-58e6-3248-b0ad-567e49d1b46f",
                        "entry_id": "571f4743-1682-3e70-8247-7de0428fbf94",
                        "glosses": [
                            "behandeltes Getreidekorn in Form einer Flocke"
