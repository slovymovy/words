                ],
                "senses": [
                    {
                        "sense_id": "d002850f-9ea1-36ce-8b71-757bc308f94e",
                        "entry_id": "604d4456-51c9-388c-994f-ceea7d8a345a",
                        "glosses": [
                            "Livre de prières où se trouve tout l’office catholique des dimanches et des principales fêtes de l’année."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92689c5a-667b-4f7d-8661-04f92ecd9c77",
                                "sense_id": "d002850f-9ea1-36ce-8b71-757bc308f94e",
                                "text": "Vers les dix heures, il alla en grande pompe acheter un eucologe, ou livre de prières, magnifiquement relié par Muller."
                            },
                            {
                                "example_id": "a39432cf-9a4e-4532-a0b4-fc59a142548d",
                                "sense_id": "d002850f-9ea1-36ce-8b71-757bc308f94e",
                                "text": "Bouvard, dans un fauteuil à ses côtés, lui prit son Eucologe et s’arrêta aux litanies de la Vierge."
                            },
                            {
                                "example_id": "ea913787-886d-4967-89a0-9203c22ee610",
                                "sense_id": "d002850f-9ea1-36ce-8b71-757bc308f94e",
                                "text": "En guise de table de nuit, il installa un antique prie-Dieu dont l’intérieur pouvait contenir un vase et dont l’extérieur supportait un eucologe."
                            },
                            {
                                "example_id": "215236df-80f3-472f-b562-011b45feeea9",
                                "sense_id": "d002850f-9ea1-36ce-8b71-757bc308f94e",
                                "text": "Le tronc sacerdotal, une seconde immobile, perdit l’équilibre dans le geste effrayant des bras mécaniquement distendus en haut vers l’âme en fuite, et vint rouler jusqu’au premier rang des jeunes volontaires qui se préparaient à suivre l’office avec attention dans de petits eucologes de la maison Mame, dorés sur tranche et reliés en maroquin noir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccf2eb54-835a-489c-9008-5aa673900439",
                        "source_entry_id": "604d4456-51c9-388c-994f-ceea7d8a345a",
                        "source_sense_id": "d002850f-9ea1-36ce-8b71-757bc308f94e",
                        "source_sense_description": "livre de prières",
                        "target_lang_word": "Gebetbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebetbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                        "entry_id": "746f2ae5-e83b-3a2a-be8e-270d0804305e",
                                        "glosses": [
                                            "Buch mit Gebeten, vor allem für die Verwendung im Gottesdienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3abe406d-125a-4810-ac93-191725e55f43",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Das so lange erwartete gemeinsame Gebet- und Gesangbuch für die katholischen Gemeinden im deutschen Sprachbereich, das »Gotteslob«, liegt nun vor.“"
                                            },
                                            {
                                                "example_id": "98ca9127-0eca-4e3e-b524-f5b89f88cac9",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Sie hielt ihr Gebetbuch in der Hand.“"
                                            },
                                            {
                                                "example_id": "ddbf5500-c89c-4b6a-8212-093305d84a4c",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Jüdische Druckereien machten ihren größten Umsatz mit dem Verlegen von Gebetbüchern und mit traditionellen religiösen Werken.“"
                                            },
                                            {
                                                "example_id": "803134b8-1642-4bc9-92ab-e2a34cdd4756",
                                                "sense_id": "f31f6645-30b4-346a-95ef-c3291a5e6c34",
                                                "text": "„Prinzessin Marja wagte sie nicht zu fragen, zog die Tür wieder hinter sich zu, setzte sich bald mit dem Gebetbuch in ihren Lehnstuhl und kniete bald vor dem Schrein mit den Heiligenbildern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
