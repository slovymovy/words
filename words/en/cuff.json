{
    "word_family": [
        "handcuff",
        "cufflink"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ce1710c-477e-3100-8657-5fc09c6bc352",
                    "sense_definition": "The end of a shirt sleeve that covers the wrist.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fastened the shiny silver <w>cuffs</w> of his dress shirt before putting on his suit jacket.",
                            "target_lang_translations": {
                                "ru": "Он застегнул блестящие серебряные <w>манжеты</w> своей парадной рубашки, прежде чем надеть пиджак.",
                                "zh": "他穿上西装外套前，先扣好了礼服衬衫那对闪亮的银色<w>袖口</w>。",
                                "cs": "Předtím, než si oblékl sako, si zapnul lesklé stříbrné <w>manžety</w> své společenské košile."
                            }
                        },
                        {
                            "text": "She rolled up her shirt <w>cuffs</w> to keep them clean while washing the dishes.",
                            "target_lang_translations": {
                                "ru": "Она закатала <w>манжеты</w> рубашки, чтобы не испачкать их во время мытья посуды.",
                                "zh": "她洗碗时把衬衫的<w>袖口</w>卷了起来，以免弄脏。",
                                "cs": "Při mytí nádobí si vyhrnula <w>manžety</w> košile, aby je neušpinila."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shirt cuff",
                        "roll up cuffs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конец рукава рубашки, закрывающий запястье.",
                        "zh": "衬衫或其他上衣袖子的末端、覆盖手腕的部分。",
                        "cs": "Konec rukávu košile, který zakrývá zápěstí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манжета",
                                "target_lang_sense_clarification": "на рукаве рубашки"
                            },
                            {
                                "target_lang_word": "обшлаг",
                                "target_lang_sense_clarification": "отворот рукава"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "袖口",
                                "target_lang_sense_clarification": "衬衫或上衣袖子覆盖手腕的部分"
                            },
                            {
                                "target_lang_word": "袖口边",
                                "target_lang_sense_clarification": "较正式说法"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "manžeta",
                                "target_lang_sense_clarification": "zakončení rukávu košile"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17b50c36-e42e-3f2d-9a79-6f048f1cdabc",
                    "sense_definition": "The end of a pants leg when folded up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor suggested adding <w>cuffs</w> to the trousers to give them a more classic look.",
                            "target_lang_translations": {
                                "ru": "Портной предложил сделать <w>отвороты</w> на брюках, чтобы придать им более классический вид.",
                                "zh": "裁缝建议给这条裤子加上<w>翻边</w>，这样看起来更经典。",
                                "cs": "Krejčí navrhl přidat na kalhoty <w>záložky</w>, aby vypadaly více klasicky."
                            }
                        },
                        {
                            "text": "He shook out the sand that had gathered in the <w>cuffs</w> of his pants after walking on the beach.",
                            "target_lang_translations": {
                                "ru": "Он вытряхнул песок, скопившийся в <w>отворотах</w> брюк после прогулки по пляжу.",
                                "zh": "他在海滩上走了一圈后，把积在裤子<w>翻边</w>里的沙子抖了出来。",
                                "cs": "Poté, co se prošel po pláži, vyklepal písek, který se nahromadil v <w>záložkách</w> jeho kalhot."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn-up"
                    ],
                    "common_phrases": [
                        "pants cuff",
                        "trouser cuff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загнутый вверх нижний край брючины.",
                        "zh": "裤腿底端向上折起的部分。",
                        "cs": "Spodní okraj nohavice kalhot, který je ohrnutý směrem nahoru."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отворот",
                                "target_lang_sense_clarification": "на брюках"
                            },
                            {
                                "target_lang_word": "манжета",
                                "target_lang_sense_clarification": "на брюках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻边",
                                "target_lang_sense_clarification": "裤腿末端向上折起的部分"
                            },
                            {
                                "target_lang_word": "裤脚翻边",
                                "target_lang_sense_clarification": "较具体地指裤腿底部的翻折"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "záložka",
                                "target_lang_sense_clarification": "ohnutý okraj nohavice"
                            },
                            {
                                "target_lang_word": "manžeta",
                                "target_lang_sense_clarification": "ozdobný ohrnutý okraj nohavice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d1ff0f6-149d-3ba0-a53e-66ab77e2ee28",
                    "sense_definition": "A handcuff.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restraints",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer clicked the metal <w>cuffs</w> shut around the suspect's wrists.",
                            "target_lang_translations": {
                                "ru": "Полицейский защелкнул металлические <w>наручники</w> на запястьях подозреваемого.",
                                "zh": "警察咔嗒一声把金属<w>手铐</w>锁在了嫌疑人的手腕上。",
                                "cs": "Policista zacvakl kovová <w>pouta</w> kolem zápěstí podezřelého."
                            }
                        },
                        {
                            "text": "He sat quietly in the back of the patrol car with the <w>cuffs</w> tight behind his back.",
                            "target_lang_translations": {
                                "ru": "Он тихо сидел на заднем сиденье патрульной машины с туго затянутыми за спиной <w>наручниками</w>.",
                                "zh": "他双手反铐，戴着紧紧的<w>手铐</w>，安静地坐在警车后座。",
                                "cs": "Seděl tiše na zadním sedadle policejního vozu s <w>pouty</w> pevně utaženými za zády."
                            }
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "manacle"
                    ],
                    "common_phrases": [
                        "put in cuffs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наручник.",
                        "zh": "手铐。",
                        "cs": "Kovový nástroj k omezení pohybu rukou; pouta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наручники",
                                "target_lang_sense_clarification": "средство ограничения свободы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手铐",
                                "target_lang_sense_clarification": "警方用来铐住双手的金属约束器具"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pouta",
                                "target_lang_sense_clarification": "policejní prostředek k omezení svobody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7f9817c-c2d0-35eb-bf0e-a5cb8c3a2911",
                    "sense_definition": "A blow, especially with the open hand; a box; a slap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_blows",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naughty child received a light <w>cuff</w> on the ear from his frustrated grandfather.",
                            "target_lang_translations": {
                                "ru": "Непослушный ребенок получил легкий <w>подзатыльник</w> по уху от расстроенного дедушки.",
                                "zh": "那个淘气的孩子挨了沮丧的爷爷轻轻一个<w>耳光</w>。",
                                "cs": "Nezbedné dítě dostalo od svého rozladěného dědečka lehký <w>pohlavek</w>."
                            }
                        },
                        {
                            "text": "He avoided the sudden <w>cuff</w> by ducking quickly to the side.",
                            "target_lang_translations": {
                                "ru": "Он уклонился от внезапного <w>удара</w>, быстро пригнувшись в сторону.",
                                "zh": "他猛地往旁边一闪，躲开了那突如其来的一<w>巴掌</w>。",
                                "cs": "Vyhnul se náhlé <w>facce</w> tím, že se rychle shýbl stranou."
                            }
                        }
                    ],
                    "synonyms": [
                        "slap",
                        "box",
                        "blow",
                        "cuffing"
                    ],
                    "common_phrases": [
                        "kick and cuff"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly literary or historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар, особенно ладонью; подзатыльник; шлепок.",
                        "zh": "一击，尤指用张开的手打的一下；耳光，巴掌。",
                        "cs": "Úder, zejména otevřenou dlaní; facka nebo pohlavek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подзатыльник",
                                "target_lang_sense_clarification": "удар по затылку или шее"
                            },
                            {
                                "target_lang_word": "шлепок",
                                "target_lang_sense_clarification": "удар открытой ладонью"
                            },
                            {
                                "target_lang_word": "манжет",
                                "target_lang_sense_clarification": "удар рукой (устаревшее)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耳光",
                                "target_lang_sense_clarification": "尤其指打在头部或脸部的一掌"
                            },
                            {
                                "target_lang_word": "巴掌",
                                "target_lang_sense_clarification": "泛指用手打的一下"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pohlavek",
                                "target_lang_sense_clarification": "úder dlaní do hlavy"
                            },
                            {
                                "target_lang_word": "facka",
                                "target_lang_sense_clarification": "úder dlaní do tváře"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bf728bb-4f2a-333e-a019-eb1b7f1ee5bd",
                    "sense_definition": "A glove or mitten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old dialect, they referred to the thick winter glove as a protective <w>cuff</w>.",
                            "target_lang_translations": {
                                "ru": "В старом диалекте толстую зимнюю перчатку называли защитной <w>рукавицей</w>.",
                                "zh": "在旧时方言里，他们把厚实的冬季<w>手套</w>称作一种防护用品。",
                                "cs": "Ve starém nářečí označovali tlustou zimní rukavici jako ochrannou <w>rukavici</w>."
                            }
                        },
                        {
                            "text": "He pulled the heavy leather <w>cuffs</w> over his hands before handling the thorny bushes.",
                            "target_lang_translations": {
                                "ru": "Он натянул на руки тяжелые кожаные <w>рукавицы</w>, прежде чем взяться за колючие кусты.",
                                "zh": "在去碰那些带刺的灌木之前，他先戴上了厚重的皮<w>手套</w>。",
                                "cs": "Než začal manipulovat s trnitými keři, natáhl si na ruce těžké kožené <w>rukavice</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "glove",
                        "mitten"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or archaic usage for handwear"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перчатка или рукавица.",
                        "zh": "手套或连指手套。",
                        "cs": "Rukavice nebo palčák (zastarale nebo nářečně)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рукавица",
                                "target_lang_sense_clarification": "плотная защитная перчатка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手套",
                                "target_lang_sense_clarification": "方言或古旧用法，指厚实的防护手套"
                            },
                            {
                                "target_lang_word": "连指手套",
                                "target_lang_sense_clarification": "更具体地指连指手套或厚手闷子"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rukavice",
                                "target_lang_sense_clarification": "ochrana rukou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81ff0b85-8527-3928-90fc-1858a2fbccfd",
                    "sense_definition": "The scruff of the neck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother cat gently picked up her kitten by the <w>cuff</w> of its neck.",
                            "target_lang_translations": {
                                "ru": "Кошка-мать осторожно взяла котенка за <w>шкирку</w>.",
                                "zh": "母猫轻轻叼起了小猫的<w>后颈皮</w>。",
                                "cs": "Kočičí matka jemně zvedla své kotě za <w>kůži na šíji</w>."
                            }
                        },
                        {
                            "text": "He grabbed the thief by the <w>cuff</w> of his neck before he could run away.",
                            "target_lang_translations": {
                                "ru": "Он схватил вора за <w>шкирку</w>, прежде чем тот успел убежать.",
                                "zh": "他一把抓住小偷的<w>后颈</w>，没让他跑掉。",
                                "cs": "Popadl zloděje za <w>límec</w> dřív, než stihl utéct."
                            }
                        }
                    ],
                    "synonyms": [
                        "scruff",
                        "nape"
                    ],
                    "common_phrases": [
                        "cuff of the neck"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in specific dialects to mean scruff"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Загривок, шкирка.",
                        "zh": "后颈；后颈皮。",
                        "cs": "Zátylek nebo kůže na krku (často u zvířat)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкирка",
                                "target_lang_sense_clarification": "загривок"
                            },
                            {
                                "target_lang_word": "загривок",
                                "target_lang_sense_clarification": "задняя часть шеи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后颈皮",
                                "target_lang_sense_clarification": "脖子后面可抓起的皮肉，常用于动物"
                            },
                            {
                                "target_lang_word": "后颈",
                                "target_lang_sense_clarification": "脖子后部"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "za krkem",
                                "target_lang_sense_clarification": "místo na zadní straně krku"
                            },
                            {
                                "target_lang_word": "kůže na šíji",
                                "target_lang_sense_clarification": "volná kůže za krkem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "883fbea3-24d7-31a8-bfa4-38d693aa1354",
                    "sense_definition": "A surgical procedure in which parts of the body that were not previously connected are stitched together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon carefully constructed a gastric <w>cuff</w> during the complex bariatric procedure.",
                            "target_lang_translations": {
                                "ru": "Хирург аккуратно сформировал желудочную <w>манжету</w> во время сложной бариатрической операции.",
                                "zh": "在这台复杂的减重手术中，外科医生小心地构建了一个胃部<w>环形缝合部</w>。",
                                "cs": "Chirurg během složitého bariatrického zákroku pečlivě vytvořil žaludeční <w>manžetu</w>."
                            }
                        },
                        {
                            "text": "Post-operative imaging showed that the newly formed <w>cuff</w> was healing perfectly without leaks.",
                            "target_lang_translations": {
                                "ru": "Послеоперационная томография показала, что вновь сформированная <w>манжета</w> заживает отлично, без протеканий.",
                                "zh": "术后影像显示，新形成的<w>环形缝合部</w>愈合得很好，没有渗漏。",
                                "cs": "Pooperační zobrazení ukázalo, že nově vytvořená <w>manžeta</w> se perfektně hojí bez úniků."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хирургическая процедура, при которой сшиваются ранее не соединенные части тела; манжета.",
                        "zh": "一种外科结构，指把原本未连接的身体部分缝合后形成的环状部位。",
                        "cs": "Chirurgický zákrok, při kterém se sešívají části těla do kruhového tvaru; manžeta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манжета",
                                "target_lang_sense_clarification": "в хирургии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环形缝合部",
                                "target_lang_sense_clarification": "医学上缝合形成的环状结构"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "manžeta",
                                "target_lang_sense_clarification": "chirurgický termín pro kruhový spoj"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01ea5ebb-003d-309b-b477-c32d6fb24676",
                    "sense_definition": "To handcuff.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restraining_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officers had to <w>cuff</w> the suspect quickly to prevent him from escaping.",
                            "target_lang_translations": {
                                "ru": "Полицейским пришлось быстро <w>заковать в наручники</w> подозреваемого, чтобы не дать ему сбежать.",
                                "zh": "警官们不得不迅速给嫌疑人<w>铐上手铐</w>，以防他逃跑。",
                                "cs": "Policisté museli podezřelého rychle <w>poutat</w>, aby mu zabránili v útěku."
                            }
                        },
                        {
                            "text": "They will <w>cuff</w> him and lead him out of the courtroom in front of the cameras.",
                            "target_lang_translations": {
                                "ru": "На него <w>наденут наручники</w> и выведут из зала суда под прицелом телекамер.",
                                "zh": "他们会当着镜头给他<w>铐上手铐</w>，然后把他带出法庭。",
                                "cs": "Nasadí mu <w>pouta</w> a vyvedou ho ze soudní síně před kamerami."
                            }
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "shackle",
                        "manacle"
                    ],
                    "antonyms": [
                        "uncuff"
                    ],
                    "common_phrases": [
                        "cuff the suspect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надеть наручники.",
                        "zh": "给人戴上手铐。",
                        "cs": "Nasadit někomu pouta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заковать в наручники",
                                "target_lang_sense_clarification": "надеть наручники"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铐上手铐",
                                "target_lang_sense_clarification": "给人戴上手铐"
                            }
                        ],
