{
    "word_family": [
        "pit",
        "fall"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85bc8b84-3d82-370e-a58e-76ab256b7a45",
                    "sense_definition": "A potential, hidden problem or danger that is easily encountered but not immediately obvious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hazard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is usually a simple task, but you should know the <w>pitfalls</w> before you attempt it yourself.",
                            "target_lang_translations": {
                                "de": "Es ist normalerweise eine einfache Aufgabe, aber Sie sollten die <w>Fallstricke</w> kennen, bevor Sie es selbst versuchen."
                            }
                        },
                        {
                            "text": "The consultant helped the company avoid a common <w>pitfall</w> in the early stages of the project.",
                            "target_lang_translations": {
                                "de": "Der Berater half dem Unternehmen, in den frühen Phasen des Projekts eine häufige <w>Falle</w> zu vermeiden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "common pitfall",
                        "avoid a pitfall",
                        "potential pitfall"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine versteckte Schwierigkeit oder Gefahr, die nicht sofort erkennbar ist, aber leicht zu Problemen führen kann."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fallstrick",
                                "target_lang_sense_clarification": "versteckte Gefahr oder Erschwernis"
                            },
                            {
                                "target_lang_word": "Falle",
                                "target_lang_sense_clarification": "übertragen: tückische Schwierigkeit"
                            },
                            {
                                "target_lang_word": "Stolperstein",
                                "target_lang_sense_clarification": "Hindernis, das Probleme bereiten kann"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31164325-b5ce-361f-a023-4dd0af39af82",
                    "sense_definition": "A trap consisting of a concealed hole in the ground designed to capture animals or people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters dug a deep <w>pitfall</w> and covered it with branches and leaves to catch the tiger.",
                            "target_lang_translations": {
                                "de": "Die Jäger gruben eine tiefe <w>Fallgrube</w> und bedeckten sie mit Ästen und Blättern, um den Tiger zu fangen."
                            }
                        },
                        {
                            "text": "He nearly stepped into a hidden <w>pitfall</w> while walking through the dense jungle.",
                            "target_lang_translations": {
                                "de": "Beim Gehen durch den dichten Dschungel wäre er fast in eine versteckte <w>Fallgrube</w> getreten."
                            }
                        }
                    ],
                    "synonyms": [
                        "trap",
                        "trapping pit"
                    ],
                    "common_phrases": [
                        "concealed pitfall",
                        "dig a pitfall"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine getarnte Grube im Boden, die zum Fangen von Tieren oder Menschen dient."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fallgrube",
                                "target_lang_sense_clarification": "getarnte Grube zum Fangen"
                            },
                            {
                                "target_lang_word": "Fanggrube",
                                "target_lang_sense_clarification": "Grube zum Fangen von Wild"
                            },
                            {
                                "target_lang_word": "Wildgrube",
                                "target_lang_sense_clarification": "speziell für die Jagd auf Wildtiere"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cba79313-0a59-348d-b5f8-3c4faeb710b8",
                    "sense_definition": "A common response to a recurring problem that is usually ineffective and risks being highly counterproductive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hazard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using global variables in this software architecture is a classic <w>pitfall</w> that leads to bugs.",
                            "target_lang_translations": {
                                "de": "Die Verwendung globaler Variablen in dieser Softwarearchitektur ist ein klassisches <w>Antipattern</w>, das zu Fehlern führt."
                            }
                        },
                        {
                            "text": "The developer explained why this specific coding pattern was a dangerous <w>pitfall</w> for the team.",
                            "target_lang_translations": {
                                "de": "Der Entwickler erklärte, warum dieses spezifische Programmiermuster ein gefährlicher <w>Fallstrick</w> für das Team war."
                            }
                        }
                    ],
                    "synonyms": [
                        "antipattern",
                        "dark pattern"
                    ],
                    "common_phrases": [
                        "classic pitfall"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein gängiges, aber ineffektives oder kontraproduktives Lösungsmuster für ein wiederkehrendes Problem, insbesondere in der Softwareentwicklung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Antipattern",
                                "target_lang_sense_clarification": "kontraproduktives Entwurfsmuster in der Softwareentwicklung"
                            },
                            {
                                "target_lang_word": "Fehlmuster",
                                "target_lang_sense_clarification": "ungeeignete oder fehleranfällige Vorgehensweise"
                            },
                            {
                                "target_lang_word": "Fallstrick",
                                "target_lang_sense_clarification": "tückischer Entwicklungsfehler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30934adb-c045-3b86-97a7-72f6e4534558",
                    "sense_definition": "A drop or subsidence in the ground level caused by mining activities below.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>pitfall</w> resulted in a drop of about three feet in the platform level over several months.",
                            "target_lang_translations": {
                                "de": "Diese <w>Erdsenkung</w> führte über mehrere Monate hinweg zu einem Absinken des Bahnsteigniveaus um etwa einen Meter."
                            }
                        },
                        {
                            "text": "The railway track required constant leveling due to the <w>pitfall</w> caused by the nearby coal mine.",
                            "target_lang_translations": {
                                "de": "Das Eisenbahngleis musste aufgrund des durch die nahegelegene Kohlemine verursachten <w>Bergschadens</w> ständig nivelliert werden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ground pitfall"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mining context"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Absinken der Erdoberfläche infolge von bergbaulichen Aktivitäten im Untergrund."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bergschaden",
                                "target_lang_sense_clarification": "Schaden oder Absenkung durch Bergbau"
                            },
                            {
                                "target_lang_word": "Erdsenkung",
                                "target_lang_sense_clarification": "Absinken des Bodenniveaus"
                            },
                            {
                                "target_lang_word": "Pinge",
                                "target_lang_sense_clarification": "trichterförmige Vertiefung durch Bergbau"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}