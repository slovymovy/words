                "senses": [
                    {
                        "sense_id": "6297d1ae-fb17-3e72-bd1d-f91351a3232a",
                        "entry_id": "6a7f06ab-4a5d-375c-9649-9a12a3c1c302",
                        "glosses": [
                            "Enfant, gamin."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f88cbc2a-2764-493a-853d-e7da745b83ad",
                                "sense_id": "6297d1ae-fb17-3e72-bd1d-f91351a3232a",
                                "text": "Vers 14 heures, les minots montent jouer au ballon contre l’église Notre-Dame de Nazareth et me reluquent avec méfiance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42098ada-1083-45f8-94db-1a89b7391ddc",
                        "source_entry_id": "6a7f06ab-4a5d-375c-9649-9a12a3c1c302",
                        "source_sense_id": "6297d1ae-fb17-3e72-bd1d-f91351a3232a",
                        "target_lang_word": "kiddo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiddo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a49244-abe5-3b2b-b8f9-2077633ed8ef",
                                        "entry_id": "9943d49e-d19a-353f-b07d-854c9d02d3b0",
                                        "glosses": [
                                            "A close friend; especially used as a form of address."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "Philippines",
                                            "US",
                                            "colloquial",
                                            "endearing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e4829a-1fe1-4b79-9dc4-05bf62890d66",
                                                "sense_id": "38a49244-abe5-3b2b-b8f9-2077633ed8ef",
                                                "text": "Okay, kiddo, I gotta run."
                                            },
                                            {
                                                "example_id": "9744b6d3-9f5f-439c-aeaf-1850f39782ab",
                                                "sense_id": "38a49244-abe5-3b2b-b8f9-2077633ed8ef",
                                                "text": "“Hey, Rick.” “Oh, hey, kiddo. How's your Saturday?” “You know, super chill. W-W-Whatcha doin'?” “Eh, nothing adventurous. You know that race of Underground Dwelling Cannibal Horse People that we're always fighting?” “Yeah, the CHUDs. W-W-What about 'em? “Well, don't tell anybody, but I'm working on a bioweapon to use against them, so I got this barrel of horse semen from your mom's hospital and I'm just gonna, you know, subject it to some otherworldly forces.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749acf12-c7b6-3fa3-895c-6f989b86b041",
                                        "entry_id": "9943d49e-d19a-353f-b07d-854c9d02d3b0",
                                        "glosses": [
                                            "A child."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "Philippines",
                                            "US",
                                            "colloquial",
                                            "endearing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17fdd0b9-ee52-4e66-bf98-a4d00449a21b",
                                                "sense_id": "749acf12-c7b6-3fa3-895c-6f989b86b041",
                                                "text": "The books say it's normal. Toddlers often stop napping around this age, and the average amount of sleep needed by a two-year-old is between nine and thirteen hours. My kiddo cuts logs for twelve hours at a stretch, so she's plenty rested."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
