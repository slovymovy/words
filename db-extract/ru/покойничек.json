                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43a247d-8e67-4fe8-88a2-f949bd7d42f1",
                                "sense_id": "717d37dc-f4a9-385b-b794-ae064d5f2d8d",
                                "text": "У нас по каждому покойничку особ канон за единоумершего; никогда самого малого опущения не бывает."
                            },
                            {
                                "example_id": "77c609c0-9f0b-49b9-a413-6ea1e542669d",
                                "sense_id": "717d37dc-f4a9-385b-b794-ae064d5f2d8d",
                                "text": "Слышу я, шамкает: «Леночка, глянь-ка, // Вон покойничка хоронить везут»."
                            }
                        ]
                    }
