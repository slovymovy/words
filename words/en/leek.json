                    "frequency": "Low",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hikers often mistake the <w>broadleaf</w> <w>wild</w> <w>leek</w> for other edible plants in the forest.",
                            "target_lang_translations": {
                                "ru": "Туристы часто принимают <w>дикий лук</w> за другие съедобные растения в лесу."
                            }
