{
    "word_family": [
        "shadowy",
        "overshadow",
        "foreshadow",
        "shadeless",
        "unshadowed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18834531-f846-3c6e-b69c-9fdc892375e8",
                    "sense_definition": "A dark shape that appears on a surface when an object blocks the light.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall tree cast a long <w>shadow</w> across the grass.",
                            "target_lang_translations": {
                                "ru": "Высокое дерево отбрасывало длинную <w>тень</w> на траву.",
                                "zh": "高大的树在草地上投下了长长的<w>影子</w>。"
                            }
                        },
                        {
                            "text": "My <w>shadow</w> followed me as I walked down the sunny street.",
                            "target_lang_translations": {
                                "ru": "Моя <w>тень</w> следовала за мной, пока я шёл по солнечной улице.",
                                "zh": "我走在阳光明媚的街道上，我的<w>影子</w>一直跟着我。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cast a shadow",
                        "long shadow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тёмный силуэт, возникающий на поверхности, когда объект преграждает путь свету.",
                        "zh": "物体遮挡光线后在表面形成的暗影。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "тёмный силуэт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "影子",
                                "target_lang_sense_clarification": "物体遮挡光线形成的暗影"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0706800a-e1aa-3d34-a9cf-c59af5c7106d",
                    "sense_definition": "An area of relative darkness or gloom caused by the blocking of light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief waited quietly in the <w>shadows</w> of the alley.",
                            "target_lang_translations": {
                                "ru": "Вор тихо ждал в <w>тени</w> переулка.",
                                "zh": "小偷静静地躲在巷子的<w>阴影</w>里等待。"
                            }
                        },
                        {
                            "text": "She stepped out of the <w>shadow</w> and into the bright sunlight.",
                            "target_lang_translations": {
                                "ru": "Она вышла из <w>тени</w> на яркий солнечный свет.",
                                "zh": "她从<w>阴影</w>中走出来，步入明亮的阳光下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shade",
                        "darkness"
                    ],
                    "common_phrases": [
                        "in the shadows",
                        "emerge from the shadows"
                    ],
                    "target_lang_definitions": {
                        "ru": "Область относительной темноты или мрака, куда не попадает прямой свет.",
                        "zh": "因光线被遮挡而形成的相对黑暗或阴暗的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "неосвещённое место"
                            },
                            {
                                "target_lang_word": "полумрак",
                                "target_lang_sense_clarification": "слабая освещённость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴影",
                                "target_lang_sense_clarification": "光线被遮挡的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "867ecf3d-a4d5-3796-b4a9-a73f1e300fa0",
                    "sense_definition": "A dominating or negative influence that affects a situation or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that he was always living in the <w>shadow</w> of his famous brother.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что всегда живёт в <w>тени</w> своего знаменитого брата.",
                                "zh": "他觉得他总是活在他那位著名兄弟的<w>阴影</w>之下。"
                            }
                        },
                        {
                            "text": "The recent scandal cast a <w>shadow</w> over the celebration.",
                            "target_lang_translations": {
                                "ru": "Недавний скандал бросил <w>тень</w> на празднование.",
                                "zh": "最近的丑闻给庆祝活动蒙上了一层<w>阴影</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "live in the shadow",
                        "cast a shadow over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доминирующее или негативное влияние, омрачающее ситуацию или жизнь человека.",
                        "zh": "对某人或某事产生负面影响的支配性力量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "метафорическое влияние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴影",
                                "target_lang_sense_clarification": "比喻负面影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc4dae7e-8a20-3dc2-95a5-4149c01e6715",
                    "sense_definition": "A very small degree or slight trace of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "trace_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury found him guilty beyond a <w>shadow</w> of a doubt.",
                            "target_lang_translations": {
                                "ru": "Присяжные признали его виновным без <w>тени</w> сомнения.",
                                "zh": "陪审团认定他有罪，对此没有<w>一丝</w>怀疑。"
                            }
                        },
                        {
                            "text": "There was not a <w>shadow</w> of annoyance on her face when I asked.",
                            "target_lang_translations": {
                                "ru": "На её лице не было и <w>тени</w> раздражения, когда я спросил.",
                                "zh": "当我询问时，她的脸上没有流露出<w>一丝</w>不悦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shadow of a doubt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Малейшая доля или слабый признак чего-либо.",
                        "zh": "极小的程度或微弱的迹象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "малейший признак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一丝",
                                "target_lang_sense_clarification": "极小的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b016b5e9-6a24-3e09-a0a7-815b8972d5ce",
                    "sense_definition": "An imperfect, faint, or weakened representation of something or someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weak_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After his long illness, he was just a <w>shadow</w> of his former self.",
                            "target_lang_translations": {
                                "ru": "После долгой болезни он был лишь <w>тенью</w> самого себя в прошлом.",
                                "zh": "大病初愈后，他已不再是当年的那个<w>影子</w>了。"
                            }
                        },
                        {
                            "text": "The movie was only a pale <w>shadow</w> of the original book.",
                            "target_lang_translations": {
                                "ru": "Фильм оказался лишь бледной <w>тенью</w> оригинальной книги.",
                                "zh": "这部电影只是原著苍白的<w>影子</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shadow of his former self",
                        "pale shadow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бледное, слабое подобие того, чем кто-то или что-то было раньше.",
                        "zh": "某人或某物不完整、微弱的残余或表现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "бледное подобие"
                            },
                            {
                                "target_lang_word": "призрак",
                                "target_lang_sense_clarification": "что-то исчезающее или нереальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "影子",
                                "target_lang_sense_clarification": "微弱的残余"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcf102ab-1b9b-3038-abef-1156cf343824",
                    "sense_definition": "A person who secretly follows another to watch their actions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_follower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective realized he had a <w>shadow</w> following him everywhere.",
                            "target_lang_translations": {
                                "ru": "Детектив понял, что за ним повсюду следует <w>шпик</w>.",
                                "zh": "侦探意识到有个<w>跟踪者</w>一直跟着他。"
                            }
                        },
                        {
                            "text": "The police put a <w>shadow</w> on the suspect to track his movements.",
                            "target_lang_translations": {
                                "ru": "Полиция приставила <w>шпика</w> к подозреваемому, чтобы отследить его передвижения.",
                                "zh": "警方派了一名<w>跟踪者</w>监视嫌疑人的行踪。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который тайно следует за другим, чтобы наблюдать за его действиями.",
                        "zh": "秘密跟踪他人以观察其行为的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпик",
                                "target_lang_sense_clarification": "тайный агент (разг.)"
                            },
                            {
                                "target_lang_word": "преследователь",
                                "target_lang_sense_clarification": "тот, кто следит"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跟踪者",
                                "target_lang_sense_clarification": "秘密跟随的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c9436d-935b-3c8e-974a-7a61e6a54fa9",
                    "sense_definition": "An inseparable companion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_follower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That dog has become her constant <w>shadow</w> since she adopted him.",
                            "target_lang_translations": {
                                "ru": "Эта собака стала её постоянной <w>тенью</w> с тех пор, как она её приютила.",
                                "zh": "自从收养了那只狗，它就成了她的<w>跟屁虫</w>。"
                            }
                        },
                        {
                            "text": "Wherever the celebrity went, his bodyguard was his <w>shadow</w>.",
                            "target_lang_translations": {
                                "ru": "Куда бы ни пошла знаменитость, телохранитель был его <w>тенью</w>.",
                                "zh": "无论那位名人去哪儿，他的保镖都像他的<w>跟屁虫</w>一样跟着。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неразлучный спутник.",
                        "zh": "形影不离的同伴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "постоянный спутник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跟屁虫",
                                "target_lang_sense_clarification": "形影不离的同伴（口语）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c449f834-47ef-33a8-b3c9-f8fdfd8c0943",
                    "sense_definition": "An unconscious aspect of the personality which the conscious ego does not identify in itself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jung believed that integrating the <w>shadow</w> is essential for personal growth.",
                            "target_lang_translations": {
                                "ru": "Юнг считал, что интеграция <w>тени</w> необходима для личностного роста.",
                                "zh": "荣格认为，整合<w>阴影</w>对于个人成长至关重要。"
                            }
                        },
                        {
                            "text": "She explored the darker aspects of her <w>shadow</w> during therapy.",
                            "target_lang_translations": {
                                "ru": "Она исследовала тёмные стороны своей <w>тени</w> во время терапии.",
                                "zh": "她在治疗过程中探索了自己<w>阴影</w>中较黑暗的一面。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "psychology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бессознательный аспект личности, который сознательное «я» не признает в себе.",
                        "zh": "人格中意识自我未察觉的潜意识层面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "психологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴影",
                                "target_lang_sense_clarification": "心理学概念"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ec7917b-6151-3341-9e11-65c6378bbc05",
                    "sense_definition": "To follow someone secretly and closely to observe their actions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_follow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The private investigator was hired to <w>shadow</w> the husband for a week.",
                            "target_lang_translations": {
                                "ru": "Частного детектива наняли <w>следить</w> за мужем в течение недели.",
                                "zh": "私家侦探受雇<w>跟踪</w>那名丈夫一周。"
                            }
                        },
                        {
                            "text": "I had a strange feeling that someone was <w>shadowing</w> me on my way home.",
                            "target_lang_translations": {
                                "ru": "У меня было странное чувство, что кто-то <w>следит</w> за мной по дороге домой.",
                                "zh": "回家的路上，我有一种奇怪的感觉，好像有人在<w>跟踪</w>我。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shadow a suspect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно и неотступно следовать за кем-то, наблюдая за его действиями.",
                        "zh": "秘密且紧密地跟随某人以观察其行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следить",
                                "target_lang_sense_clarification": "тайно наблюдать"
                            },
                            {
                                "target_lang_word": "ходить по пятам",
                                "target_lang_sense_clarification": "неотступно следовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跟踪",
                                "target_lang_sense_clarification": "秘密跟随"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d850f4f1-b978-3aae-850b-0b922048a0ae",
                    "sense_definition": "To accompany a professional during their work day to learn about their job.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_learn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New employees usually <w>shadow</w> a mentor before working independently.",
                            "target_lang_translations": {
                                "ru": "Новые сотрудники обычно <w>наблюдают за работой</w> наставника перед тем, как начать работать самостоятельно.",
                                "zh": "新员工在独立工作前通常会<w>见习</w>一位导师。"
                            }
                        },
                        {
                            "text": "I am going to <w>shadow</w> the marketing director to understand her role.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь <w>наблюдать за работой</w> директора по маркетингу, чтобы понять её роль.",
                                "zh": "我打算<w>见习</w>市场总监，以了解她的职责。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "job shadowing",
                        "shadow a manager"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сопровождать специалиста в течение рабочего дня, чтобы перенять опыт.",
                        "zh": "在工作日陪同专业人员以学习其工作内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдать за работой",
                                "target_lang_sense_clarification": "учиться на примере"
                            },
                            {
                                "target_lang_word": "стажироваться",
                                "target_lang_sense_clarification": "проходить практику"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "见习",
                                "target_lang_sense_clarification": "通过观察学习工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb4f4fdb-f988-3847-a9e5-71cadef23f3e",
                    "sense_definition": "To cast a shade or darkness over something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action_darken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Large storm clouds began to <w>shadow</w> the valley below.",
                            "target_lang_translations": {
                                "ru": "Большие грозовые тучи начали <w>затенять</w> долину внизу.",
                                "zh": "巨大的乌云开始<w>遮蔽</w>下方的山谷。"
                            }
                        },
                        {
                            "text": "The brim of his hat <w>shadowed</w> his eyes, hiding his expression.",
                            "target_lang_translations": {
                                "ru": "Поля шляпы <w>затеняли</w> его глаза, скрывая выражение лица.",
                                "zh": "帽檐<w>遮蔽</w>了他的双眼，掩盖了他的表情。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслонять свет, погружать в тень.",
                        "zh": "遮挡光线，使某处变暗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затенять",
                                "target_lang_sense_clarification": "закрывать свет"
                            },
                            {
                                "target_lang_word": "омрачать",
                                "target_lang_sense_clarification": "делать мрачным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遮蔽",
                                "target_lang_sense_clarification": "遮挡光线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edb011d7-c2fa-3e79-bb9a-d8b0fec0ce46",
                    "sense_definition": "To make a variable inaccessible by declaring another variable of the same name within a specific scope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you declare a local variable with that name, it will <w>shadow</w> the global one.",
                            "target_lang_translations": {
                                "ru": "Если вы объявите локальную переменную с таким именем, она <w>затенит</w> глобальную.",
                                "zh": "如果你用那个名字声明一个局部变量，它会<w>遮蔽</w>全局变量。"
                            }
                        },
                        {
                            "text": "The compiler warned that the inner loop variable <w>shadows</w> an outer variable.",
                            "target_lang_translations": {
                                "ru": "Компилятор предупредил, что переменная внутреннего цикла <w>затеняет</w> внешнюю переменную.",
                                "zh": "编译器警告说，内部循环变量<w>遮蔽</w>了一个外部变量。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "programming"
                        }
