                                "target_senses": [
                                    {
                                        "sense_id": "54855a48-f69f-3f9f-a1db-8cb1b2b5e06f",
                                        "entry_id": "f4e7f836-29c3-37d6-b309-ec0dcbe88606",
                                        "glosses": [
                                            "Ce qui reste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5226b7d4-8499-49ce-8c05-14f3cf458253",
                                                "sense_id": "54855a48-f69f-3f9f-a1db-8cb1b2b5e06f",
                                                "text": "Ils se pourléchaient en vantant les rillons, ces résidus de porc sautés dans sa graisse et qui ressemblent à des truffes cuites ; ils douanaient mon panier, n’y trouvaient que des fromages d’Olivet, ou des fruits secs, et m’assassinaient d’un — Tu n’as donc pas de quoi ? qui m’apprit à mesurer la différence mise entre mon frère et moi."
                                            },
                                            {
                                                "example_id": "d89e7fc1-4498-4317-b6da-9eeb9d804479",
                                                "sense_id": "54855a48-f69f-3f9f-a1db-8cb1b2b5e06f",
                                                "text": "Toutes les parties idéologiques des traités locarniens sont tombées l'une après l'autre. Et le résidu constitue l'alliance."
                                            },
                                            {
                                                "example_id": "0d8c5a8b-2351-4a92-9c45-b7c18a0a2d06",
                                                "sense_id": "54855a48-f69f-3f9f-a1db-8cb1b2b5e06f",
                                                "text": "Ces résidus d’opium ont été retrouvés dans des vases en céramique découverts à Yehud (centre), dans des tombes cananéennes mises au jour en 2012 et vieilles de plus de 3 500 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "719af059-05bd-32bf-8434-eda0157812d5",
                                        "entry_id": "f4e7f836-29c3-37d6-b309-ec0dcbe88606",
                                        "glosses": [
                                            "Matière qui reste après une opération chimique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66d0b30-2555-401f-b670-75c36294cd48",
                                                "sense_id": "719af059-05bd-32bf-8434-eda0157812d5",
                                                "text": "Les cendres, traitées par l’eau bouillante, abandonnent la potasse et laissent un résidu qui sert d’engrais."
                                            },
                                            {
                                                "example_id": "e434afdf-ee3a-4642-b5de-90ed2d7e226a",
                                                "sense_id": "719af059-05bd-32bf-8434-eda0157812d5",
                                                "text": "Traitement des résidus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e74000-8500-3c5d-8e0a-f3a724fcc18c",
                                        "entry_id": "f4e7f836-29c3-37d6-b309-ec0dcbe88606",
                                        "glosses": [
                                            "Matière qui reste après une opération chimique.",
                                            "Liquide non évaporé à l’issue d’une distillation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f20c8ebc-19c4-4bf4-95f2-e2b0d9ff36d0",
                                                "sense_id": "33e74000-8500-3c5d-8e0a-f3a724fcc18c",
                                                "text": "Le résidu de la distillation du goudron est noir, d’une forte consistance d’extrait ; distillé une seconde fois en y ajoutant de l'eau, il fournit un liquide roux, aigre, amer et astringent, ayant l’odeur d’empyreume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "233da300-7cf6-3b27-b228-db6c546b8341",
                                        "entry_id": "f4e7f836-29c3-37d6-b309-ec0dcbe88606",
                                        "glosses": [
                                            "Ce qui reste inexpliqué dans certaines théories."
                                        ],
