                            {
                                "target_lang_word": "danser en ronde",
                                "target_lang_sense_clarification": "exécuter une danse circulaire"
                            },
                            {
                                "target_lang_word": "mener la ronde",
                                "target_lang_sense_clarification": "danser en groupe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0ec1149-73e4-3f56-a6e8-a0bc5d11af22",
                    "sense_definition": "recht en vlak maken met een rei of een ander gereedschap",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman moet de vloer goed <w>reien</w> voordat hij de tegels legt.",
                            "target_lang_translations": {
                                "fr": "L'artisan doit bien <w>dresser à la règle</w> le sol avant de poser les carreaux."
                            }
                        },
                        {
                            "text": "Ze gaan de muur zorgvuldig <w>reien</w> voor een strak resultaat.",
                            "target_lang_translations": {
                                "fr": "Ils vont <w>égaliser</w> soigneusement le mur pour un résultat parfait."
                            }
                        }
                    ],
                    "synonyms": [
                        "egaliseren",
                        "vlakken"
                    ],
                    "common_phrases": [
                        "vloer reien"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rendre droit et plat à l'aide d'une règle de maçon ou d'un outil similaire"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dresser à la règle",
                                "target_lang_sense_clarification": "égaliser un sol ou un mur"
                            },
                            {
                                "target_lang_word": "égaliser",
                                "target_lang_sense_clarification": "rendre une surface plane"
                            }
