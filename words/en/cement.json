                    "sense_definition": "A small town located in Caddo County, Oklahoma, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The population of <w>Cement</w> is quite small, reflecting its status as a rural town.",
                            "target_lang_translations": {
                                "ru": "Население города <w>Семент</w> довольно мало, что отражает его статус сельского городка."
                            }
                        },
                        {
                            "text": "He grew up in <w>Cement</w>, Oklahoma, before moving to the big city.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>Сементе</w>, штат Оклахома, прежде чем переехать в большой город."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifically Oklahoma, USA"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой город, расположенный в округе Каддо, штат Оклахома, США."
                    },
                    "translations": {
