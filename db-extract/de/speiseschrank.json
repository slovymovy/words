                "senses": [
                    {
                        "sense_id": "9730973c-af1c-35af-9c54-b478ace0a316",
                        "entry_id": "1c3ed3cd-995f-3c45-94e4-2048a58f1d23",
                        "glosses": [
                            "Schrank zur Unterbringung von Lebensmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a44fbe09-18d9-4dfe-a077-7fd3fd827897",
                                "sense_id": "9730973c-af1c-35af-9c54-b478ace0a316",
                                "text": "„Ich machte mich schnellen Schrittes auf den Heimweg, um zu sehen, ob ich noch etwas im Speiseschrank hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
