                "senses": [
                    {
                        "sense_id": "59974a62-596c-3eb2-a576-53853625d606",
                        "entry_id": "56717e37-86d0-31d3-b874-6f9b7f0217e9",
                        "glosses": [
                            "een voortstuwende kracht waarmee toestellen in beweging worden gebracht en gehouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7bb875b-135a-4bac-a324-f8ab489d3dcd",
                                "sense_id": "59974a62-596c-3eb2-a576-53853625d606",
                                "text": "Al na een paar sessies met Miriam kon hij zich tot in detail de reparatie van de GS herinneren: hij had een mankementje aan de achterasaandrijving zo handig verholpen dat hij een compleet nieuwe aandrijving in rekening kon brengen zonder ook maar één vervangend onderdeel te hoeven kopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16712221-ef12-4cdb-b7f7-81ffec22731c",
                        "source_entry_id": "56717e37-86d0-31d3-b874-6f9b7f0217e9",
                        "source_sense_id": "59974a62-596c-3eb2-a576-53853625d606",
                        "target_lang_word": "Antrieb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antrieb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0359c6dc-03de-311a-8432-8b0a859dc8de",
                                        "entry_id": "e5531d2c-237d-3407-a029-9898a47654f4",
                                        "glosses": [
                                            "technische Vorrichtung, die etwas treibt, die etwas in Bewegung versetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03972c1d-4da2-4e8e-8ed4-fc6231e7846a",
                                                "sense_id": "0359c6dc-03de-311a-8432-8b0a859dc8de",
                                                "text": "Mein Spielzeugauto ist mit einem elektrischen Antrieb ausgestattet."
                                            },
                                            {
                                                "example_id": "e7bc822e-1308-4711-8a6c-55c7161816e6",
                                                "sense_id": "0359c6dc-03de-311a-8432-8b0a859dc8de",
                                                "text": "„Denn es war gar nicht so einfach, den Antrieb nach hinten zu verlagern, den Motorradmotor mit einem automobilen Renngetriebe zu verheiraten und die unterschiedlichen Schaltkreise miteinander zu verknüpfen, erzählt er von den Kniffen der Konstruktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1cace33-0fb4-3f2e-bd8e-5e0f342230d7",
                                        "entry_id": "e5531d2c-237d-3407-a029-9898a47654f4",
                                        "glosses": [
                                            "innere Motivation etwas zu tun; der Grund für eine Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47058bf8-77ec-4ca2-9bfc-1d9f4bbf7e4c",
                                                "sense_id": "c1cace33-0fb4-3f2e-bd8e-5e0f342230d7",
                                                "text": "Schließlich veranlasste die Stadtverwaltung die Räumung der wilden Müllkippe aus eigenem Antrieb."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "664b798b-c297-4bff-a818-42f743268bb6",
                        "source_entry_id": "56717e37-86d0-31d3-b874-6f9b7f0217e9",
                        "source_sense_id": "59974a62-596c-3eb2-a576-53853625d606",
                        "target_lang_word": "propulsion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propulsion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8612a7e-3d9c-3fbe-b26e-6d1eaf935a80",
                                        "entry_id": "116d9ba7-ef7f-3e8b-b9ab-98f7818069a0",
                                        "glosses": [
                                            "The process of propelling, driving, or pushing, typically forward or onward; a propulsive force or impulse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                        "entry_id": "116d9ba7-ef7f-3e8b-b9ab-98f7818069a0",
                                        "glosses": [
                                            "That which propels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "511b89cd-f98e-4ff8-a517-97daff576ddb",
                                                "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                                "text": "However, nuclear propulsion provides a very high specific impulse and consistent, long duration energy source."
                                            },
                                            {
                                                "example_id": "bddd4b46-da35-4ff7-b7c6-af863f4c30af",
                                                "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                                "text": "This propulsion provides an initial velocity for the vehicle in a short time span."
                                            },
                                            {
                                                "example_id": "d4820fe3-c51a-4654-af9f-bee71402a757",
                                                "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                                "text": "Solar-electric propulsion accelerates a spacecraft by means of a low-thrust ion jet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6083b2c-6a22-4104-a93b-7b1d3c26af6d",
                        "source_entry_id": "56717e37-86d0-31d3-b874-6f9b7f0217e9",
                        "source_sense_id": "59974a62-596c-3eb2-a576-53853625d606",
                        "target_lang_word": "propulsion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propulsion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7b1b36-53a3-3d0a-88c5-db0c12235f3f",
                                        "entry_id": "71434ccf-ad93-33dc-a9cc-2df176274bd0",
                                        "glosses": [
                                            "Mouvement qui porte vers un point, action de propulser."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04e111e4-5b51-4556-a20a-2bcb396b9c4f",
                                                "sense_id": "9b7b1b36-53a3-3d0a-88c5-db0c12235f3f",
                                                "text": "La propulsion, dit-elle en me rendant le mètre, c’est la combinaison de mon élan et de la pression des porteurs sur la barre. Plus ils poussent, plus je vais haut."
                                            },
                                            {
                                                "example_id": "777e3ac1-24ca-4cf7-b38a-aae9e8654bec",
                                                "sense_id": "9b7b1b36-53a3-3d0a-88c5-db0c12235f3f",
                                                "text": "Le développement des missiles a été plus difficile et plus long que prévu, notamment pour parvenir à maîtriser les structures, les nouveaux matériaux composites, les systèmes de navigation et la propulsion solide."
                                            },
                                            {
                                                "example_id": "c78d1492-985b-40d0-986b-b334e7f6f453",
                                                "sense_id": "9b7b1b36-53a3-3d0a-88c5-db0c12235f3f",
                                                "text": "Force de propulsion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
