                "senses": [
                    {
                        "sense_id": "8d15079e-34ef-3476-9c02-b9a0ea4f3da2",
                        "entry_id": "b74b531e-093d-3c21-8944-5b5212d9001c",
                        "glosses": [
                            "Alternative form of dead pool (“a point at which a reservoir no longer has enough water”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "82ac84b5-8a7b-4434-af7b-f54bccce03ca",
                                "sense_id": "8d15079e-34ef-3476-9c02-b9a0ea4f3da2",
                                "text": "The base of the saddle dam is at an approximate elevation of 10,080 feet, which appears to be about 25 feet above the minimum pool water level. This option would necessitate complete drainage of the reservoir (to deadpool) so that this could be engineered to accommodate a stable channel and inlet area for the micro-tunnel."
                            },
                            {
                                "example_id": "e0608852-b242-4f06-9330-078c8b77a857",
                                "sense_id": "8d15079e-34ef-3476-9c02-b9a0ea4f3da2",
                                "text": "The hydraulic head is the difference between the normal maximum water surface elevation and the deadpool (e.g. the water level below which water can no longer be discharged) elevation."
                            },
                            {
                                "example_id": "0dbdf357-bc84-4d30-b4e3-c5d89e0b9cad",
                                "sense_id": "8d15079e-34ef-3476-9c02-b9a0ea4f3da2",
                                "text": "Now many dams are approaching deadpool, without enough water to even flow past the dam or turn the electric generators, and more and more rivers don't even reach the sea, even the mighty Nile."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe752915-9316-32f0-a6c6-0b9a8c643fca",
                        "entry_id": "b74b531e-093d-3c21-8944-5b5212d9001c",
                        "glosses": [
                            "Alternative form of dead pool (“a game of predicting when people will die”)."
                        ],
