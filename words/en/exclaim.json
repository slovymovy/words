{
    "word_family": [
        "exclamation",
        "exclamatory",
        "exclamative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd778872-3504-3a7d-8fdb-ea610d20617d",
                    "sense_definition": "To cry out suddenly due to strong emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stopped to <w>exclaim</w> at the beauty of the sunset.",
                            "target_lang_translations": {
                                "ru": "Она остановилась, чтобы <w>воскликнуть</w> от красоты заката."
                            }
                        },
                        {
                            "text": "The guests were laughing and <w>exclaiming</w> about the cold weather.",
                            "target_lang_translations": {
                                "ru": "Гости смеялись и <w>восклицали</w> по поводу холодной погоды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exclaim at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко вскрикнуть или выразить сильную эмоцию голосом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскри́кивать",
                                "target_lang_sense_clarification": "издавать внезапный крик от сильного чувства"
                            },
                            {
                                "target_lang_word": "восклица́ть",
                                "target_lang_sense_clarification": "выражать сильное чувство словами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e1b27ea-740e-318c-9900-426cd569840c",
                    "sense_definition": "To say something suddenly and with strong emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the name of heaven, who art thou, she <w>exclaimed</w>.",
                            "target_lang_translations": {
                                "ru": "— Ради всего святого, кто ты такой? — <w>воскликнула</w> она."
                            }
                        },
                        {
                            "text": "He <w>exclaimed</w> that he was completely innocent of the crime.",
                            "target_lang_translations": {
                                "ru": "Он <w>воскликнул</w>, что совершенно невиновен в этом преступлении."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произнести что-либо внезапно, с сильным эмоциональным окрасом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воскли́кнуть",
                                "target_lang_sense_clarification": "громко и эмоционально произнести фразу"
                            },
                            {
                                "target_lang_word": "вскрича́ть",
                                "target_lang_sense_clarification": "резко и громко выкрикнуть"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1b80452-1af4-3819-b0ae-0ade595a8ff1",
                    "sense_definition": "An exclamation or outcry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vocalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem was filled with bitter <w>exclaims</w> against fate.",
                            "target_lang_translations": {
                                "ru": "Стихотворение было наполнено горькими <w>восклицаниями</w> против судьбы."
                            }
                        },
                        {
                            "text": "She could not hide her <w>exclaims</w> of surprise when the news arrived.",
                            "target_lang_translations": {
                                "ru": "Она не могла скрыть своих <w>восклицаний</w> удивления, когда пришли новости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание или громкий выкрик (устаревшее или литературное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восклица́ние",
                                "target_lang_sense_clarification": "эмоциональное высказывание"
                            },
                            {
                                "target_lang_word": "вы́крик",
                                "target_lang_sense_clarification": "резкий, громкий звук или фраза"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}