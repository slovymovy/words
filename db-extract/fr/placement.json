                "senses": [
                    {
                        "sense_id": "6512ef56-c21b-3b1a-bc40-814d852ff5ef",
                        "entry_id": "cc0a83b9-36a8-3f5c-a6b7-41e61886e89f",
                        "glosses": [
                            "Action de placer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "719d685a-7760-4570-b39f-949cc55eae24",
                                "sense_id": "6512ef56-c21b-3b1a-bc40-814d852ff5ef",
                                "text": "Le placement d’une bibliothèque."
                            },
                            {
                                "example_id": "97443b7e-2e67-4f28-a96e-4b8337cb8577",
                                "sense_id": "6512ef56-c21b-3b1a-bc40-814d852ff5ef",
                                "text": "Le placement des convives autour d’une table."
                            }
                        ]
                    },
                    {
                        "sense_id": "337bf2c8-c70b-3655-ad2d-086f85e79966",
                        "entry_id": "cc0a83b9-36a8-3f5c-a6b7-41e61886e89f",
                        "glosses": [
                            "Vente ou emploi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2399ada2-b3ab-445b-a0ba-9fbe9ab1a3e3",
                                "sense_id": "337bf2c8-c70b-3655-ad2d-086f85e79966",
                                "text": "L’alcool méthylique, du fait de son indétonance, paraît devoir trouver un placement facile et rémunérateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "fabb5b3d-26a6-3178-b9d1-a444e9daf20c",
                        "entry_id": "cc0a83b9-36a8-3f5c-a6b7-41e61886e89f",
                        "glosses": [
                            "Action de placer de l’argent ; argent placé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595d57c3-f178-4be5-870f-84f9baefc7f1",
                                "sense_id": "fabb5b3d-26a6-3178-b9d1-a444e9daf20c",
                                "text": "Il a fait un placement avantageux, un placement sûr, un placement de père de famille."
                            },
                            {
                                "example_id": "a5e39f60-fbd7-40d4-84eb-38e04108016c",
                                "sense_id": "fabb5b3d-26a6-3178-b9d1-a444e9daf20c",
                                "text": "– Alors, toi, tu prêtes, à ton tour, l’argent que tu viens d’emprunter.\n– Comment ça ? Je ne le prête pas : je le place.\n– C’est la même chose. Un placement, c’est un prêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "e04df8e2-a593-32b2-8c2b-4481ef1ead77",
                        "entry_id": "cc0a83b9-36a8-3f5c-a6b7-41e61886e89f",
                        "glosses": [
                            "Opération de la phase d’étude qui consiste à définir l’emplacement de chaque élément d’un circuit."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
