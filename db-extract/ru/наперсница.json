                "senses": [
                    {
                        "sense_id": "240f8756-a32b-3b00-bb07-fa18eab9bd77",
                        "entry_id": "ac217b95-7aea-3bba-ab94-66ce8b0661df",
                        "glosses": [
                            "устар. женск. к наперсник; доверенное лицо, которому поверяют сокровенные мысли и тайны; подруга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec71554-71a2-4d1f-b466-f8d2bb49a6df",
                                "sense_id": "240f8756-a32b-3b00-bb07-fa18eab9bd77",
                                "text": "Прежде она дарила доверие, как будто из милости, только своей наперснице и подруге, жене священника."
                            }
                        ]
                    },
                    {
                        "sense_id": "6109d8a3-69fe-3d5e-9b77-8cb1c89a290c",
                        "entry_id": "ac217b95-7aea-3bba-ab94-66ce8b0661df",
                        "glosses": [
                            "устар. любовница, наложница"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ba90a3-94b2-46f4-84b1-2160fc49cf6c",
                                "sense_id": "6109d8a3-69fe-3d5e-9b77-8cb1c89a290c",
                                "text": "Не всякому дано любви хмельной напиток // Разбавить дружбы трезвою водой // И дотянуть его до старости глубокой // С наперсницей, когда-то молодой."
                            }
                        ]
                    }
                ],
