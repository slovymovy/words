                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da219184-6519-4851-ad09-54c1067eee4a",
                                "sense_id": "51cd46ae-174c-374c-90d8-9d6ba43ee81d",
                                "text": "Een rasterelektronenmicroscoop werkt door middel van een zeer fijne, scherp gefocuste elektronenbundel die het oppervlak van een preparaat in rastervorm aftast."
                            }
                        ]
                    }
                ],
