                        "target_lang_word": "graze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a27bf6c-6b00-33f5-9715-d6f9802c38c3",
                                        "entry_id": "b10fd7e1-0e82-3666-9887-80bedb96ea03",
                                        "glosses": [
                                            "The act of grazing; a scratching or injuring lightly on passing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d322826-1cda-3afe-9282-5f46c199a97a",
                                        "entry_id": "b10fd7e1-0e82-3666-9887-80bedb96ea03",
                                        "glosses": [
                                            "A light abrasion; a slight scratch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c65c395-8687-3056-9413-ef6fc583584d",
                                        "entry_id": "b10fd7e1-0e82-3666-9887-80bedb96ea03",
                                        "glosses": [
                                            "The act of animals feeding from pasture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d05e73d4-557f-4caf-984d-21c6df0aa180",
                                                "sense_id": "6c65c395-8687-3056-9413-ef6fc583584d",
                                                "text": "If it be sundown, when the herds are returning from their daily graze in the long grass of the jungle, clouds of dust will be marking their track along every approach to the village […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "graze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e449baf-00cc-370b-9a2c-1da04ef071b1",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To feed or supply (cattle, sheep, etc.) with grass; to furnish pasture for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c109b0fb-0110-4114-8172-3a82ba037d6b",
                                                "sense_id": "1e449baf-00cc-370b-9a2c-1da04ef071b1",
                                                "text": "He hath a Houſe and Barn in repair, a Field or two to graze his Cows, with a Garden and Orchard."
                                            },
                                            {
                                                "example_id": "3f4bc559-a08d-49bd-9494-bd9200dd6a26",
                                                "sense_id": "1e449baf-00cc-370b-9a2c-1da04ef071b1",
                                                "text": "Although it is perfectly good meadowland, none of the villagers has ever grazed animals on the meadow on the other side of the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a1707b-60da-344d-9398-03c220b86237",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To feed on; to eat (growing herbage); to eat grass from (a pasture)"
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3073fcc-8def-4acb-b6e0-ccb91dbd2ded",
                                                "sense_id": "62a1707b-60da-344d-9398-03c220b86237",
                                                "text": "Cattle graze in the meadows."
                                            },
                                            {
                                                "example_id": "a761e6ab-54a7-4ce8-b987-f284b5b6fc86",
                                                "sense_id": "62a1707b-60da-344d-9398-03c220b86237",
                                                "text": "The lambs vvith vvolves ſhall graze the verdant mead, / And boys in flovv'ry bands the tyger lead; […]"
                                            },
                                            {
                                                "example_id": "5eaba07e-ea9d-4cae-90b6-b819cf25147f",
                                                "sense_id": "62a1707b-60da-344d-9398-03c220b86237",
                                                "text": "The bird [Canada goose] is more often found on land than other waterfowl because of its love for seeds and grains. The long neck is well adapted for grazing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163e5f15-3b2b-31a0-b794-65f1b3bf2feb",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To tend (cattle, etc.) while grazing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d15dc6-b30b-459a-a24f-31f401a71097",
                                                "sense_id": "163e5f15-3b2b-31a0-b794-65f1b3bf2feb",
                                                "text": "Shylock: When Jacob grazed his uncle Laban's sheep"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca63d329-3ee0-3b84-8cd9-c12a00ca644f",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To eat small amounts of food periodically throughout the day, rather than at fixed mealtimes, often not in response to hunger."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de894762-8da2-4a5e-811c-6a443512f78c",
                                                "sense_id": "ca63d329-3ee0-3b84-8cd9-c12a00ca644f",
                                                "text": "Furthermore, people who take the time to sit down to proper meals find their food more satisfying than people who graze throughout the day. If you skip meals, you will inevitably end up snacking on more high-fat high-sugar foods."
                                            },
                                            {
                                                "example_id": "af44b0b9-9531-4413-b708-372c3713cf56",
                                                "sense_id": "ca63d329-3ee0-3b84-8cd9-c12a00ca644f",
                                                "text": "Many people, however, snack and graze from roughly the time they wake up until shortly before they go to bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "862a88d5-36f1-3e03-bc12-2198fb0643b3",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To shoplift by consuming food or drink items before reaching the checkout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d9bc8e-6b74-42d6-9c74-b087b93d6d1e",
                                                "sense_id": "862a88d5-36f1-3e03-bc12-2198fb0643b3",
                                                "text": "Grazing refers to customers who consume food items before paying for them, for example, a customer bags one and a half pounds of grapes in the produce department, eats some as she continues her shopping […]"
                                            },
                                            {
                                                "example_id": "5584f75f-5efd-40f2-bfdf-3a33d39e55ae",
                                                "sense_id": "862a88d5-36f1-3e03-bc12-2198fb0643b3",
                                                "text": "Had the Grievant attempted to pay for the Mylanta or actually paid for it, then she would not be guilty of grazing or shoplifting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e72170-eed4-3495-8f38-b0a78b805bf0",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To rub or touch lightly the surface of (a thing) in passing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "650d740b-2f31-4f03-9f74-d9956d2e93d5",
                                                "sense_id": "44e72170-eed4-3495-8f38-b0a78b805bf0",
                                                "text": "the bullet grazed the wall"
                                            },
                                            {
                                                "example_id": "25e23cc9-0e72-405b-8a57-89b44f259769",
                                                "sense_id": "44e72170-eed4-3495-8f38-b0a78b805bf0",
                                                "text": "But in that gale, the port, the land, is that ship’s direst jeopardy; she must fly all hospitality; one touch of land, though it but graze the keel, would make her shudder through and through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d3b34dc-9f0f-39c8-9f81-e22a10434903",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To cause a slight wound to; to scratch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b317c84-4400-4b49-8e1b-29723222b828",
                                                "sense_id": "3d3b34dc-9f0f-39c8-9f81-e22a10434903",
                                                "text": "to graze one's knee"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915094d8-aabd-3329-bfe4-86d4303d4c8b",
                                        "entry_id": "ecca3cbe-c727-3faa-a712-0c98931facf3",
                                        "glosses": [
                                            "To yield grass for grazing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041d78d6-57fc-447e-9210-85b5617fd050",
                                                "sense_id": "915094d8-aabd-3329-bfe4-86d4303d4c8b",
                                                "text": "The sewers must be kept so as the water may not stay too long in the spring; for then the ground continueth the wet, whereby it will never graze to purpose that year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94fb4661-1b3a-419e-81a6-7184d0b8b181",
                        "source_entry_id": "33b5293b-0bfe-3b6b-9a07-f20b3cd42192",
                        "source_sense_id": "fc5aad0e-3b57-3078-99aa-e6597d768b47",
                        "source_sense_description": "eine Verletzung der Haut, die durch starke und schnelle Reibung entsteht",
                        "target_lang_word": "abrasion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrasion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f357d288-cac1-3f87-b47d-91fcdc444889",
                                        "entry_id": "f0293f3d-c4a5-33c6-a905-934bae7ae9e1",
                                        "glosses": [
                                            "Action d’abraser, d’enlever en grattant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2398e6b-b159-4965-9a0a-1f7de6524df2",
                                                "sense_id": "f357d288-cac1-3f87-b47d-91fcdc444889",
                                                "text": "Les diamants, pour l’usage de bijoux ou d’outils, sont généralement façonnés par une série d’opérations dont certaines impliquent l’abrasion du diamant par de la poudre de diamant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95506458-07d9-323e-9592-d81a113b021a",
                                        "entry_id": "f0293f3d-c4a5-33c6-a905-934bae7ae9e1",
                                        "glosses": [
                                            "Conséquence de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4072601-efc1-4058-bebc-dabfe1b93aea",
                                                "sense_id": "95506458-07d9-323e-9592-d81a113b021a",
                                                "text": "L’abrasion des dents de cette vache la rend presque incapable de se nourrir."
                                            },
                                            {
                                                "example_id": "3b660ef1-a116-4949-ad9e-1cc5140276d8",
                                                "sense_id": "95506458-07d9-323e-9592-d81a113b021a",
                                                "text": "Selon le Laboratoire fédéral d’essai des matériaux et de recherche (Empa), l’ abrasion des pneus représenterait ainsi une part estimée à 90% des microplastiques rejetés dans l’environnement en Suisse, chaque habitant-e du pays produisant en moyenne 1,4 kg d’usure de pneu par an."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a481161f-ba3b-36c1-9c44-64aa27c07f88",
                                        "entry_id": "f0293f3d-c4a5-33c6-a905-934bae7ae9e1",
                                        "glosses": [
                                            "Érosion causée par attrition (frottement) venant des matériaux de toutes tailles transportés par les eaux et les glaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d61ab5-0e23-4807-9c2b-cbf514ad31e2",
                                                "sense_id": "a481161f-ba3b-36c1-9c44-64aa27c07f88",
                                                "text": "Les torrents et les glaciers forment les paysages montagneux grâce à une abrasion efficace et constante."
                                            },
                                            {
                                                "example_id": "22d42973-ea02-4685-ad8b-04bbdc0e2535",
                                                "sense_id": "a481161f-ba3b-36c1-9c44-64aa27c07f88",
                                                "text": "Le maçon a effectué une longue abrasion de la pierre pour la rendre lisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38aeb61d-a1c8-3618-b349-3e893ba3e0ac",
                                        "entry_id": "f0293f3d-c4a5-33c6-a905-934bae7ae9e1",
                                        "glosses": [
