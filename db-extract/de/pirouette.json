                "senses": [
                    {
                        "sense_id": "19943488-f70f-3bca-ac06-1ded915aa9e5",
                        "entry_id": "e8a349ba-12bf-382a-990d-e952d9ba5abf",
                        "glosses": [
                            "eine zentrierte einfache oder mehrfache schnelle Drehung um die eigene Körperhochachse"
                        ],
                        "tags": [
                            "Tanz",
                            "Eiskunstlauf"
                        ],
                        "examples": [
                            {
                                "example_id": "1817f069-6aea-4694-bef9-be41089eabad",
                                "sense_id": "19943488-f70f-3bca-ac06-1ded915aa9e5",
                                "text": "Die jungen Eiskunstläuferinnen gleiten leicht übers Eis und drehen kunstvoll eine Pirouette."
                            },
                            {
                                "example_id": "6e3c4554-f678-4f7c-b348-8d211eb2a249",
                                "sense_id": "19943488-f70f-3bca-ac06-1ded915aa9e5",
                                "text": "„Sie machte Luftsprünge, Pirouetten, Kapriolen, Beinschläge, kurz alle Possen einer Ballettratte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a51910eb-f844-30f6-ad8b-103609c29e5b",
                        "entry_id": "e8a349ba-12bf-382a-990d-e952d9ba5abf",
                        "glosses": [
                            "Reitfigur, bei der eine Wendung des Pferdes um die Hinterhand vollführt wird"
                        ],
                        "tags": [
                            "Kunstreiten"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
