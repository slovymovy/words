{
    "word_family": [
        "antipersonnel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef17779f-4060-323c-86d5-3ba1b22dcd8a",
                    "sense_definition": "The people who work for an organization, company, or serve in the military, considered as a group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "staff_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only authorized <w>personnel</w> are allowed to enter the laboratory.",
                            "target_lang_translations": {
                                "ru": "Только уполномоченный <w>персонал</w> имеет право входить в лабораторию.",
                                "zh": "只有获得授权的<w>人员</w>才允许进入实验室。"
                            }
                        },
                        {
                            "text": "The general thanked all military <w>personnel</w> for their service and dedication.",
                            "target_lang_translations": {
                                "ru": "Генерал поблагодарил весь <w>личный состав</w> за службу и преданность делу.",
                                "zh": "将军感谢了全体<w>官兵</w>的服役与奉献。"
                            }
                        }
                    ],
                    "synonyms": [
                        "staff",
                        "workforce",
                        "employees",
                        "manpower"
                    ],
                    "common_phrases": [
                        "authorized personnel",
                        "military personnel",
                        "medical personnel",
                        "key personnel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, работающие в организации, компании или служащие в армии, рассматриваемые как единая группа.",
                        "zh": "在组织、公司工作或在军队服役的人员，被视为一个整体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "персонал",
                                "target_lang_sense_clarification": "сотрудники организации"
                            },
                            {
                                "target_lang_word": "личный состав",
                                "target_lang_sense_clarification": "в армии или силовых структурах"
                            },
                            {
                                "target_lang_word": "кадры",
                                "target_lang_sense_clarification": "квалифицированные работники"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人员",
                                "target_lang_sense_clarification": "泛指组织或机构的成员"
                            },
                            {
                                "target_lang_word": "全体人员",
                                "target_lang_sense_clarification": "强调作为一个整体的员工"
                            },
                            {
                                "target_lang_word": "官兵",
                                "target_lang_sense_clarification": "特指军队中的人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dedb1c6-2779-3a79-b548-e78c0c0c4c0c",
                    "sense_definition": "The department in an organization that deals with hiring, training, and administrative issues regarding employees.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hr_dept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should contact <w>personnel</w> if you have questions about your paycheck.",
                            "target_lang_translations": {
                                "ru": "Вам следует обратиться в <w>отдел кадров</w>, если у вас есть вопросы по поводу зарплаты.",
                                "zh": "如果你对工资有疑问，应该联系<w>人事部</w>。"
                            }
                        },
                        {
                            "text": "The <w>personnel</w> manager is conducting interviews for the new position today.",
                            "target_lang_translations": {
                                "ru": "Менеджер по <w>персоналу</w> сегодня проводит собеседования на новую должность.",
                                "zh": "<w>人事</w>经理今天正在为新职位进行面试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "human resources",
                        "HR"
                    ],
                    "common_phrases": [
                        "personnel department",
                        "personnel manager",
                        "personnel office"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдел в организации, занимающийся наймом, обучением и административными вопросами сотрудников.",
                        "zh": "组织中负责招聘、培训和处理员工行政事务的部门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдел кадров",
                                "target_lang_sense_clarification": "подразделение организации"
                            },
                            {
                                "target_lang_word": "служба персонала",
                                "target_lang_sense_clarification": "HR-отдел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人事部",
                                "target_lang_sense_clarification": "负责员工管理的部门"
                            },
                            {
                                "target_lang_word": "人力资源部",
                                "target_lang_sense_clarification": "现代企业中负责员工管理的部门"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "538c8ccd-eb63-38e2-86fb-afb07cdebb92",
                    "sense_definition": "A single member of an organization, especially within the armed forces or security services.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staff_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An army <w>personnel</w> was injured during the training exercise yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера во время учений был ранен <w>военнослужащий</w>.",
                                "zh": "一名<w>军人</w>在昨天的训练演习中受伤了。"
                            }
                        },
                        {
                            "text": "Each security <w>personnel</w> must wear a badge while on duty.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>сотрудник</w> службы безопасности должен носить бейдж во время дежурства.",
                                "zh": "每位安保<w>人员</w>在值勤时都必须佩戴胸牌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "member",
                        "employee"
                    ],
                    "common_phrases": [
                        "army personnel",
                        "security personnel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный член организации, особенно в вооруженных силах или службах безопасности.",
                        "zh": "组织中的单个成员，尤指在武装部队或安全部门中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "военнослужащий",
                                "target_lang_sense_clarification": "в армии"
                            },
                            {
                                "target_lang_word": "сотрудник",
                                "target_lang_sense_clarification": "работник службы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人员",
                                "target_lang_sense_clarification": "指代单个成员"
                            },
                            {
                                "target_lang_word": "军人",
                                "target_lang_sense_clarification": "特指军队成员"
                            },
                            {
                                "target_lang_word": "员工",
                                "target_lang_sense_clarification": "指代机构中的个人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}