                                "example_id": "850ae917-3595-4817-9f4a-de17cb7a1867",
                                "sense_id": "a4072405-3bbb-36ca-a7e1-f0dabbd60ea1",
                                "text": "Dis voir si t'auras le courage de te mettre la ceinture quand tu verras des tas de petites fesses poumer autour de toi... hein ? Dis le contraire, vilaine grosse guiguitte, toujours à l'éveil, vilain trésor d'homme, tout le temps occupé de ses baloches […]."
                            },
                            {
                                "example_id": "cb7418e5-493f-47ec-b875-a2d3e041880f",
                                "sense_id": "a4072405-3bbb-36ca-a7e1-f0dabbd60ea1",
                                "text": "Si vous êtes intéressés par des permas, ça nous aiderait beaucoup, et bien sûr vous pourrez poumer !"
                            },
                            {
                                "example_id": "9a5ecf51-5e96-4bcc-bf53-4a2510758a00",
                                "sense_id": "a4072405-3bbb-36ca-a7e1-f0dabbd60ea1",
                                "text": "Je voudrais poumer avec tout le monde dans cette salle et plus particulièrement mes Officiers."
                            },
                            {
                                "example_id": "ca98cfb0-9433-42a1-afdb-4cd3eb253c00",
                                "sense_id": "a4072405-3bbb-36ca-a7e1-f0dabbd60ea1",
                                "text": "Vous devez aller chercher des signatures de tous les Officiers quand vous les avez poumés."
                            },
                            {
                                "example_id": "f36030bd-b517-464a-bda5-50e6c1584a70",
                                "sense_id": "a4072405-3bbb-36ca-a7e1-f0dabbd60ea1",
                                "text": "Bref, tous les ingrédients pour atteindre notre mission ultime qui rappelons-le est de POUMER ET FAIRE SAQUER DES HECTOS"
                            }
                        ]
