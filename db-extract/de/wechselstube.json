                                            {
                                                "example_id": "b1356233-024d-4487-828f-505396c56dbb",
                                                "sense_id": "4d05428b-e56c-32da-a353-44bc606f1c33",
                                                "text": "Potřeboval vyměnit peníze a soused u stolu, v poměrech zběhlý už od loňska, mu poradil, že v malém krámku nedaleko hotelu směňují peníze v lepším kurzu než ve směnárně nebo v bance."
                                            },
                                            {
                                                "example_id": "290af6e1-8e60-4889-805a-71c9116e5756",
                                                "sense_id": "4d05428b-e56c-32da-a353-44bc606f1c33",
                                                "text": "Pro zjištění použitelného kurzu není důležité, jak vysokou částku příslušné měny zaměstnanec směnil, ale to, že směnil v bance nebo směnárně (nikoliv v obchodě nebo u poskytovatele nějaké služby) v zahraničí."
                                            }
                                        ]
                                    }
