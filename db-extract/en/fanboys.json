                        "examples": [
                            {
                                "example_id": "3af4e2d2-8c9b-42b8-ab1d-ec88b74b5ae8",
                                "sense_id": "04f197c7-438d-3f0d-9c62-97f0440c4998",
                                "text": "The risk is greater with subordinating conjunctions (see “Starting a Sentence with Because”), but the FANBOYS are sometimes considered guilty by association: […]"
                            },
                            {
                                "example_id": "3f4541c7-32cc-4aa1-aa26-17c95022df37",
                                "sense_id": "04f197c7-438d-3f0d-9c62-97f0440c4998",
                                "text": "These FANBOYS help create compound sentences, and when they serve this role, a comma comes before their use."
                            },
                            {
                                "example_id": "086a5484-3538-4392-9703-a01ea1a4b5d0",
                                "sense_id": "04f197c7-438d-3f0d-9c62-97f0440c4998",
                                "text": "Avoid putting a comma immediately after any of the FANBOYS."
                            }
                        ]
