                    {
                        "sense_id": "2251636d-9921-3a26-831b-d18bfb39e677",
                        "entry_id": "8972977e-1f6b-310d-818c-b895a9a44406",
                        "glosses": [
                            "D’une manière idéale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b3e6d7-6f8b-4d30-bf94-d78029673a4f",
                                "sense_id": "2251636d-9921-3a26-831b-d18bfb39e677",
                                "text": "Imaginez, au milieu des horreurs du siècle, un lieu privilégié, une sorte de retraite angélique idéalement silencieuse et fermée."
                            },
                            {
                                "example_id": "8140f5af-be93-48aa-aa05-57460590a177",
                                "sense_id": "2251636d-9921-3a26-831b-d18bfb39e677",
                                "text": "Ces trente mille francs inespérés le grisaient encore plus que la purée septembrale, il les maniait idéalement entre ses pouces."
                            }
                        ]
                    }
                ],
