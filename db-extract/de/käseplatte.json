                    {
                        "sense_id": "749414d0-4327-321c-8c0d-979b115ebfdc",
                        "entry_id": "0b59ef41-64be-3e9c-9497-9c687a2dedc1",
                        "glosses": [
                            "(größerer) Teller, Servierplatte oder Ähnliches, auf dem unterschiedliche Sorten Käse angerichtet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87563c38-bba2-4a15-9488-96a378378dd1",
                                "sense_id": "749414d0-4327-321c-8c0d-979b115ebfdc",
                                "text": "Wenn du die Platten für die Schulanfangsfeier bestellst, vergiß bitte nicht die Käseplatte!"
                            },
                            {
                                "example_id": "1d51ea23-db07-4fa6-9096-b8f702b73cbd",
                                "sense_id": "749414d0-4327-321c-8c0d-979b115ebfdc",
                                "text": "„Dazu gab es einen Salat aus eingelegtem Gemüse und als Abschluss eine Käseplatte und spanische Orangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
