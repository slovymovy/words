                ],
                "senses": [
                    {
                        "sense_id": "6b12c760-ba66-3447-9c50-b7e67a32b615",
                        "entry_id": "b2c00aaa-ae1c-31ea-a9dd-89f99127fc72",
                        "glosses": [
                            "Sorte de porc sauvage de la famille des Tayassuidae, les trois espèces actuelles sont essentiellement sud-américaines."
                        ],
                        "tags": [
                            "Histoire naturelle"
                        ],
                        "examples": [
                            {
                                "example_id": "c0152196-7f8d-43f7-bd03-38e9d7377a7d",
                                "sense_id": "6b12c760-ba66-3447-9c50-b7e67a32b615",
                                "text": "Glenarvan tua fort adroitement un pécari « tay-tetre, » pachyderme à poil fauve très bon à manger, qui valait son coup de fusil."
                            },
                            {
                                "example_id": "f1a67fc0-76c4-4da4-bdc4-10d830bd92c2",
                                "sense_id": "6b12c760-ba66-3447-9c50-b7e67a32b615",
                                "text": "Le pécari à lèvres blanches, vivant en Amérique centrale et du Sud, a vu ses effectifs diminuer de 89 % au Costa Rica et de 84 % au Mexique et au Guatemala. Il figure maintenant sur la liste des espèces vulnérables. Parmi les causes de ce déclin : la chasse et la disparition de son habitat."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffe1d870-6c9d-3d3b-97c3-a021fb113fd6",
                        "entry_id": "b2c00aaa-ae1c-31ea-a9dd-89f99127fc72",
                        "glosses": [
                            "Cuir de cet animal."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "8d69cded-84f7-4560-b127-6b2dcec32b94",
                                "sense_id": "ffe1d870-6c9d-3d3b-97c3-a021fb113fd6",
                                "text": "On trouve des chaussures ou des vestes en pécari, mais il est utilisé essentiellement pour la confection de gants haut de gamme."
                            },
                            {
                                "example_id": "96c85a91-387c-429c-8103-38efd771b606",
                                "sense_id": "ffe1d870-6c9d-3d3b-97c3-a021fb113fd6",
                                "text": "Ils ne brasseront jamais que les millions des autres. On leur en laissera quelques miettes, pour le standing, pour les chemises de soie, pour les gants de pécari fumé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8fff50c-a983-450e-94b9-d8ba4f560d69",
                        "source_entry_id": "b2c00aaa-ae1c-31ea-a9dd-89f99127fc72",
