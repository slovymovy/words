                        "examples": [
                            {
                                "example_id": "a3a4a180-ff38-4396-bdd4-0924fe08b703",
                                "sense_id": "f20031a1-d203-3ab8-a8a5-85aecef154cd",
                                "text": "Sans oublier l’observation des blancs d’œufs dans un liquide, l’ovomancie, l’interprétation de la position et la forme des nuages, la néphélomancie, les dessins formés par des gouttes de cire fondue au contact de l’eau, la céromancie."
                            }
                        ]
                    }
                ],
