                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e77fe0d-eb2c-32fc-afa4-af5508b80cfa",
                                        "entry_id": "43478b9f-a21b-3b46-939b-c4d3b810a43f",
                                        "glosses": [
                                            "A member of the religious order founded by St. Dominic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Dominican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a5f340-fd90-38a3-8938-a2e73167d6aa",
                                        "entry_id": "c5d88cda-ae90-3e8f-a9e3-89b468587170",
                                        "glosses": [
                                            "Of, from, or pertaining to the Dominican Republic, or its people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61711d13-6850-4e81-ba21-ae479613ffdc",
                                                "sense_id": "79a5f340-fd90-38a3-8938-a2e73167d6aa",
                                                "text": "And while the Dominican economy grew by 4.9% last year, high inflation rates in both 2022 (8.8%) and 2023 (4.8%) have taken a toll on the population’s quality of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffae2fb2-e6e8-336d-93d1-bc95fbfb3f44",
                                        "entry_id": "c5d88cda-ae90-3e8f-a9e3-89b468587170",
                                        "glosses": [
                                            "Of, from, or pertaining to Dominica, or its people."
                                        ],
