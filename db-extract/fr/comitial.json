                ],
                "senses": [
                    {
                        "sense_id": "141486de-f22b-3650-b023-dc4c8bc6f6bd",
                        "entry_id": "224a663b-5373-33d9-aee8-380716c63751",
                        "glosses": [
                            "Utilisé dans la locution « mal comitial », synonyme d’épilepsie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9358a0d9-d1ab-4ad2-8fcd-63e62b76d766",
                                "sense_id": "141486de-f22b-3650-b023-dc4c8bc6f6bd",
                                "text": "M. Debove dit que l'hystérie symptomatique du plomb, de l'alcool est à l'hystérie vraie ce que l'épilepsie symptomatique est au vrai mal comitial."
                            },
                            {
                                "example_id": "42227de5-3710-438d-b999-86eaa68b9a9c",
                                "sense_id": "141486de-f22b-3650-b023-dc4c8bc6f6bd",
                                "text": "Si la lésion ou l'hypersensibilité locale intéresse l'écorce cérébrale, le même précipité fera éclater l'accès comitial."
                            }
                        ]
                    },
                    {
                        "sense_id": "2287a3dc-56f0-33c7-b68a-f9775ab0f4c5",
                        "entry_id": "224a663b-5373-33d9-aee8-380716c63751",
                        "glosses": [
                            "Provoqué par l’épilepsie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bb61381d-37d0-487e-b9e6-b4be98054519",
                                "sense_id": "2287a3dc-56f0-33c7-b68a-f9775ab0f4c5",
                                "text": "Des renseignements pris sur ses antécédents, il résulte qu'il n'avait jamais présenté d'accidents comitiaux ni dans sa jeunesse, ni avant de se livrer aux excès de boissons."
                            },
                            {
                                "example_id": "e607cca2-a7b5-4097-93b8-6696cb16776e",
                                "sense_id": "2287a3dc-56f0-33c7-b68a-f9775ab0f4c5",
                                "text": "L'homme bien coiffé consulta une grande feuille quadrillée, suspendue au pied du lit.\n— Vous avez été transéaté dans notre service de gastro-entérologie, à la suite d'une crise comitiale survenue dans un contexte d’exogénose."
                            },
                            {
                                "example_id": "27b6c644-4d0c-42f0-995e-d6f308b96eb3",
                                "sense_id": "2287a3dc-56f0-33c7-b68a-f9775ab0f4c5",
                                "text": "En outre, une crise comitiale chez un éthylique peut signifier la présence d'une carence vitaminique (encéphalopathie de Gayet-Wernicke)."
                            }
                        ]
                    }
