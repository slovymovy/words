                        "source_sense_id": "e109693f-11bf-3bff-b070-1c80c73c3e4d",
                        "target_lang_word": "Flak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                        "entry_id": "3bf3cd8c-1e82-3747-b68a-5b523522da37",
                                        "glosses": [
                                            "zur Abwehr von Luftangriffen dienliche Waffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e472a935-3841-4053-8f97-ad502ec05ade",
                                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                                "text": "Wir hatten sehr schnell keine Flak mehr."
                                            },
                                            {
                                                "example_id": "10248d14-f034-4b52-8522-c00ae18b4ea5",
                                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                                "text": "„Das sind die Geschosse der Flaks.“"
                                            },
                                            {
                                                "example_id": "a3c3a6af-1f6d-4d1b-8b19-0024dfb41a03",
                                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                                "text": "„Nur die Flak meldete sich von ferne.“"
                                            },
                                            {
                                                "example_id": "8cce8b5b-ac6d-4f7c-bd3e-1fe03ebc1b10",
                                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                                "text": "„Die Flak schoß auch nicht, die war bloß eine Attrappe.“"
                                            },
                                            {
                                                "example_id": "7aa80064-2dfc-4d8f-bcc1-1f8a582f980d",
                                                "sense_id": "fbc13b5d-2a33-3027-8e22-ba5a63d88be6",
                                                "text": "„Dann donnerte die Flak los, daß die Fensterscheiben dröhnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
