                    },
                    {
                        "form_id": "65e51a61-a2a8-400a-9df4-ea40b33e14fb",
                        "entry_id": "cbc2e700-5aad-3a4d-9c7f-0870285b2705",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\ɑ.blœʁ\\"
                    },
                    {
                        "form_id": "fb3d2bf6-b6a6-4b92-9242-cf1ef99c4454",
                        "entry_id": "cbc2e700-5aad-3a4d-9c7f-0870285b2705",
                        "tags": [
                            "feminine"
                        ],
                        "form": "hâbleuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                        "entry_id": "cbc2e700-5aad-3a4d-9c7f-0870285b2705",
                        "glosses": [
                            "Personne qui hâble, qui parle avec exagération, emphase et vantardise."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f6e3709f-6ee4-4efd-b18b-998a6f2f4411",
                                "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                "text": "Quand on voudra citer un hâbleur, un vantard, un belître, incapable de modérer sa langue, un fier-à-bras qui menace s'avaler le monde, on parlera d'Adhémar de Trémazenc de Capestang !"
                            },
                            {
                                "example_id": "373a79a8-305f-47dd-9f25-c99b74343f25",
                                "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                "text": "« Après tout, songea-t-il, ce n’est peut-être qu’un hâbleur, comme tous ces prodigues ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe133c67-ce51-47ef-b63b-b3ed6b49c0b9",
                        "source_entry_id": "cbc2e700-5aad-3a4d-9c7f-0870285b2705",
                        "source_sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                        "target_lang_word": "braggart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                        "entry_id": "d4263855-a5b4-3026-8f30-e680ffd76e90",
                                        "glosses": [
                                            "Someone who constantly brags or boasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ee1c6c-31ca-432b-a027-b58643e30774",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "O I could play the woman with mine eyes, / And Braggart with my tongue."
                                            },
                                            {
                                                "example_id": "8c28d36b-c048-4b66-bfc6-354dfea54a86",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "Shallow water gives a great splash, and so a braggart has ever been contemptible in my eyes."
                                            },
                                            {
                                                "example_id": "a0252817-6318-4df5-bf66-61e17cd51ecd",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "A very good resolve to make and keep, if you would also keep any friends you make, is never to speak of anyone without, in imagination, having them overhear what you say. One often hears the exclamation “I would say it to her face!” At least be very sure that this is true, and not a braggart’s phrase and then—nine times out of ten think better of it and refrain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                        "entry_id": "861e2e01-a1f5-3da6-9ac2-773aa61cf329",
                                        "glosses": [
                                            "Characterized by boasting; boastful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1db0ef-a178-4608-a7ea-1eb19c556420",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "O my fair Mistress, Truth! Shall I quit thee, / For huffing, braggart, puft Nobility?"
                                            },
                                            {
                                                "example_id": "ebb6c33c-8136-4fda-81ff-ca2f33315b95",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "Captain [Benjamin] Bonneville was delighted with the game look of these cavaliers of the mountains, welcomed them heartily to his camp, and ordered a free allowance of grog to regale them, which soon put them in the most braggart spirits."
                                            },
                                            {
                                                "example_id": "22616bb0-e631-4830-8ad3-c9cdce94b965",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "He took him on the long walks of which he was fond, and made him in some sort his humble confidant, talking to him of himself and his plans with large and braggart vagueness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "940f9591-7000-4ecb-8dcd-4b534c4a4be1",
                        "source_entry_id": "cbc2e700-5aad-3a4d-9c7f-0870285b2705",
                        "source_sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                        "target_lang_word": "hablador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hablador",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "88b669a2-9790-3e92-9d2d-7b7f113a34a0",
                                        "entry_id": "a6aa522c-9dcf-3662-b22b-e03ffd6853e1",
                                        "glosses": [
                                            "Que gusta de hablar mucho."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edba4051-29c7-4245-a093-c566d985f2fb",
                                                "sense_id": "88b669a2-9790-3e92-9d2d-7b7f113a34a0",
                                                "text": "Él, de costumbre, tan simpático y hablador con todo el mundo, no abrió la boca en toda la noche"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b19d21f4-f45b-354c-a985-536ce27c0655",
                                        "entry_id": "a6aa522c-9dcf-3662-b22b-e03ffd6853e1",
                                        "glosses": [
                                            "Que gusta hablar en demasía, importunando a los demás con impertinencias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9c91a0-eb6b-495f-8a20-296d96cd86f4",
                                                "sense_id": "b19d21f4-f45b-354c-a985-536ce27c0655",
                                                "text": "El primero es un criollo blanco, dominador y prepotente, hablador y manipulador"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2e7d5448-2c97-3db7-ad9f-46e39cf8a947",
                                        "entry_id": "a6aa522c-9dcf-3662-b22b-e03ffd6853e1",
                                        "glosses": [
                                            "Persona que dice y critica todo lo que ve y oye de manera poco discreta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb0170d-7a8e-4148-9100-9f1f27e75dab",
                                                "sense_id": "2e7d5448-2c97-3db7-ad9f-46e39cf8a947",
                                                "text": "¡Así que a ver venga por otra cicatero!, ¡eso le está bien por ser hablador!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1786ea16-747d-3a5a-ab0b-0d48a91d4d1a",
                                        "entry_id": "a6aa522c-9dcf-3662-b22b-e03ffd6853e1",
                                        "glosses": [
                                            "Que se comporta con arrogancia y cuenta mentiras."
                                        ],
