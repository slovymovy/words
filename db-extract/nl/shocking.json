                                                "example_id": "f1711be6-a2c2-4066-ae53-cd6890334b15",
                                                "sense_id": "1cbb1c73-29df-3382-803d-019325921ea3",
                                                "text": "His behaviour is very disturbing."
                                            },
                                            {
