                "senses": [
                    {
                        "sense_id": "d0b3ccb0-822b-301d-90e0-ec18dfc2196e",
                        "entry_id": "14be07c8-729b-3090-9018-712c5a25744f",
                        "glosses": [
                            "een proef waarbij men kijkt of iemand geschikt is voor een optreden in een televisieprogramma of film"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8f10cd-aa0c-46af-b156-9edafd06ceaf",
                                "sense_id": "d0b3ccb0-822b-301d-90e0-ec18dfc2196e",
                                "text": "Het castingbureau plaatste het protocol vrijdag op hun site. Voortaan vinden de audities en screentests plaats in een speciaal daarvoor ingerichte auditieruimte op het kantoor van Kemna Casting."
                            },
                            {
                                "example_id": "6453b0f2-2332-4d16-a655-b5937a7bdac8",
                                "sense_id": "d0b3ccb0-822b-301d-90e0-ec18dfc2196e",
                                "text": "Meer dan honderd meteorologen deden een gooi naar de functie, na het vertrek van Erwin Kroll. In november hield de NOS een screentest voor geïnteresseerden. Daarna volgde sollicitatiegesprekken met een kleine groep kanshebbers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ec9d3b3-6f07-46f0-b5ad-f0782b1f1192",
                        "source_entry_id": "14be07c8-729b-3090-9018-712c5a25744f",
                        "source_sense_id": "d0b3ccb0-822b-301d-90e0-ec18dfc2196e",
                        "target_lang_word": "screen test",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "screen test",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f5560ac-bd4c-3c79-8501-94a3cefb8493",
                                        "entry_id": "4f613676-1a78-35e6-9db5-e6dc2d868062",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see screen, test; a test of, or involving, a screen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78f1647f-e0cc-3beb-b67d-ba7246212e60",
                                        "entry_id": "4f613676-1a78-35e6-9db5-e6dc2d868062",
                                        "glosses": [
                                            "A filmed audition to test (and demonstrate) an actor's screen-acting ability and/or suitability for a particular role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87e93449-d913-4dd1-8fbe-32fc8e310d87",
                                                "sense_id": "78f1647f-e0cc-3beb-b67d-ba7246212e60",
                                                "text": "Alan Ladd's wife spotted the budding beauty and suggested that Julie attend a screen test for a bit part in something called The Girl and the Gorilla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7492b46-e0b3-3861-ac40-43a9491f4d61",
                                        "entry_id": "4f613676-1a78-35e6-9db5-e6dc2d868062",
                                        "glosses": [
                                            "A test for the presence of a particular substance; such a test that by extension tests for a particular organism or medical condition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5d7741a-c5fe-3592-812f-caf2bc81aed9",
                                        "entry_id": "4f613676-1a78-35e6-9db5-e6dc2d868062",
                                        "glosses": [
                                            "Synonym of rough ride."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958ee55b-bd9a-4019-86ab-5917bf220f3e",
                                                "sense_id": "a5d7741a-c5fe-3592-812f-caf2bc81aed9",
                                                "text": "One of the reasons for the charges was knowledge of a tradition among some police of what they called in Baltimore \"a rough ride\" (Fernandez, 2015). The practice is to place a handcuffed prisoner face-down in the back of a police van without securing him to the seat, and then intentionally driving in a reckless manner to throw the suspect around without any way of protecting himself from injury. When David was in police work, officers used to talk about the old-fashioned \"screen test\" which used a similar technique. The officer would put the prisoner in the back seat of a patrol car in handcuffs, but not in a seat belt. Then the officer would slam on the brakes of the patrol car so that the prisoner would lunge forward, face first into the screen separating the prisoner from the police officer in the front seat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "screen test",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76fc1732-cc12-3be7-ab75-a1866372512c",
                                        "entry_id": "4c3be8be-5e2d-3a2e-8a46-ef3f5f513a2a",
                                        "glosses": [
                                            "To audition via a screen test."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c12deca-3587-4378-addd-297f76f2fc0e",
                                                "sense_id": "76fc1732-cc12-3be7-ab75-a1866372512c",
                                                "text": "According to Garrett, \"1,400 candidates were interviewed, 90 were screen tested, 149,000 feet of black and white film and 13,000 feet of Technicolor was shot in those tests.\""
                                            },
                                            {
                                                "example_id": "2ffcd390-bb92-40dd-b11e-fe51f8660873",
                                                "sense_id": "76fc1732-cc12-3be7-ab75-a1866372512c",
                                                "text": "Also considered was Carroll Baker. Baker screen tested, but failed to win the part."
                                            },
                                            {
                                                "example_id": "d6a37f8f-8dd2-409f-9220-0956eed6cd11",
                                                "sense_id": "76fc1732-cc12-3be7-ab75-a1866372512c",
                                                "text": "They would humble-brag about the last commercial they'd booked or how they'd screen-tested for a TV pilot last week, and their sleazy managers would say, \"Our little Portia is a booking machine!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45468e27-b3a0-3c47-9fee-df455b101ee7",
                                        "entry_id": "4c3be8be-5e2d-3a2e-8a46-ef3f5f513a2a",
                                        "glosses": [
                                            "To test for a particular substance, organism or medical condition by means of a screen test."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f13693-c8e9-4718-9014-f910d642cbe3",
                                                "sense_id": "45468e27-b3a0-3c47-9fee-df455b101ee7",
                                                "text": "He testified Moses' that^([sic – meaning that Moses']) blood screen tested positive for cocaine metabolites and Moses' urine screen tested positive for cocaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f82077-3676-32c6-9fa5-69df86f6e6df",
                                        "entry_id": "4c3be8be-5e2d-3a2e-8a46-ef3f5f513a2a",
                                        "glosses": [
                                            "To subject (someone) to a screen test."
                                        ],
