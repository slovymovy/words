                                    {
                                        "sense_id": "f4cf6809-e82d-370f-8e82-f96232d6aa85",
                                        "entry_id": "b99ca983-4903-3406-8856-905ef152d6df",
                                        "glosses": [
                                            "Adelgazamiento excesivo por culpa de una enfermedad o falta de alimento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f99b335-ed5c-4a67-a252-3ca189410922",
                                                "sense_id": "f4cf6809-e82d-370f-8e82-f96232d6aa85",
                                                "text": "«3. Desnutrición y diversas carencias.– En alguna ocasión aparece progresiva emaciación coincidente casi siempre con síndromes diarreicos o de malabsorción, así como carencias diversas (arriboflavinosis, síndromes pelagroides, etc.)»."
                                            },
                                            {
                                                "example_id": "b08e836f-273b-4976-a819-b8084195aa95",
                                                "sense_id": "f4cf6809-e82d-370f-8e82-f96232d6aa85",
                                                "text": "«Mencionó dicho autor la presencia de amenorrea, estreñimiento, pérdida de apetito, bradicardia, respiración lenta y emaciación como los síntomas más importantes con ausencia de patología somática y unido todo ello a una actividad incansable»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
