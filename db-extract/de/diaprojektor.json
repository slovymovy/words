                        "sense_id": "7bfbabe3-a2cd-3a99-83e0-942031c73574",
                        "entry_id": "e9e45781-e102-38e5-9b83-ee3a2842f197",
                        "glosses": [
                            "Gerät, mit dem gerahmte Dias (Diapositive) projiziert werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "236bf5f4-27a9-4663-babd-f6f47af81806",
                                "sense_id": "7bfbabe3-a2cd-3a99-83e0-942031c73574",
                                "text": "„Die obigen Fotos wurden von McClintock mit einer Laterna Magica erzeugt, ein Projektionsgerät, das vom 17. bis zum 20. Jahrhundert weit verbreitet war und mit dem vor allem im 19. Jahrhundert erste, meist händisch kolorierte Fotografien auf kleinen Glasscheiben, wie mit einem Diaprojektor, an die Wand geworfen wurden.“"
                            },
                            {
                                "example_id": "943da16d-fe35-4b7f-8032-42b3b149e1d3",
                                "sense_id": "7bfbabe3-a2cd-3a99-83e0-942031c73574",
                                "text": "„Auf einem alten Telefonbuch stand tatsächlich ein Diaprojektor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
