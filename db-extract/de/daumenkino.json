                                        "entry_id": "b70011cd-d49f-3973-bc4f-7a43555e7320",
                                        "glosses": [
                                            "Carnet d’images qui donne une impression de mouvement lorsque les pages sont feuilletées rapidement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72821ef9-0bc9-4754-9c84-97cae1c8cf9a",
                                                "sense_id": "8d3dd840-808d-3722-bc83-28e89c9478e2",
                                                "text": "Le Folioscope, sous l’apparence d’un simple carnet de poche, vous donne la curieuse surprise d’une série de petits personnages animés, aux mouvements très naturellement exécutés."
                                            },
                                            {
                                                "example_id": "37c9fe16-d3b3-45b4-bf32-5a6d104591fe",
                                                "sense_id": "8d3dd840-808d-3722-bc83-28e89c9478e2",
                                                "text": "De carte en carte, la ville grandit à vue d’œil comme un enfant sur les photographies, comme si l’on feuilletait un furieux folioscope."
                                            }
                                        ]
