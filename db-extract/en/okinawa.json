                    },
                    {
                        "sense_id": "c1a1d602-2934-3c83-a5d3-58e99f22536c",
                        "entry_id": "588d1db0-5543-3127-ac16-aa2286f23baa",
                        "glosses": [
                            "The main island of the Okinawa and Ryukyu Islands, in Okinawa Prefecture, Japan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08bb0b18-7ee5-4ee3-822f-097773d7e13a",
                                "sense_id": "c1a1d602-2934-3c83-a5d3-58e99f22536c",
                                "text": "Anyone who knew our military installation in Okinawa knew it was a room full of gasoline waiting for someone to strike a match. We had forty-two bases on the island with more than twenty thousand personnel. All of them were living and conducting exercises right up against Okinawan civilian neighborhoods."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0cfd02b-157e-31c9-9dc7-583c33d04c7a",
                        "entry_id": "588d1db0-5543-3127-ac16-aa2286f23baa",
                        "glosses": [
                            "The second-largest city on Okinawa Island, in Okinawa Prefecture, Japan."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69b9f39f-6897-3e83-933e-d489e79f6e9d",
                        "entry_id": "588d1db0-5543-3127-ac16-aa2286f23baa",
                        "glosses": [
                            "The Battle of Okinawa, which took place on the island of Okinawa in 1945."
