                        "examples": [
                            {
                                "example_id": "2e29205e-7dd3-4c7b-a231-aaeff48e6456",
                                "sense_id": "99a8d98d-a86b-3319-9b01-22a4b09c412a",
                                "text": "Sur ce principe existe ainsi une élite ultra-resserrée de méga-nuages ayant autour d’eux des millions et parfois un milliard d’internautes : Google (recherche et outils en ligne), Wikipedia (savoir), Amazon (commerce), Linkedin (gestion de carrières), Facebook (vie sociale), Microsoft (logiciels et services en ligne), Apple (matériel et magasin en ligne), Twitter (flux instantanés), etc."
                            },
                            {
                                "example_id": "72ebb1b1-3335-4b6b-ab3e-17eae408287a",
                                "sense_id": "99a8d98d-a86b-3319-9b01-22a4b09c412a",
                                "text": "Être ultra-resserré sans la balle et déployé avec, une stratégie qui permet de combler les lacunes individuelles quand le ballon est perdu."
                            },
                            {
                                "example_id": "acdcf9cf-6986-4184-82ae-862f38c94074",
                                "sense_id": "99a8d98d-a86b-3319-9b01-22a4b09c412a",
                                "text": "Nous vous proposons d’utiliser une échelle ultra-resserrée', composée de seulement trois questions, pour évaluer la centralité absolue du travail dans votre vie."
                            }
                        ]
                    }
