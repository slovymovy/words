                    ],
                    "common_phrases": [
                        "инвестиционный портфель",
                        "портфель заказов",
                        "кредитный портфель",
                        "портфель акций"
                    ],
                    "target_lang_definitions": {
                        "en": "A collection of financial assets, orders, or investments held by an individual or company.",
                        "de": "Eine Gesamtheit von Finanzanlagen, Aufträgen oder Investitionen, die von einer Person oder einem Unternehmen gehalten werden."
