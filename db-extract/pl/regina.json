                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9dcf65-e8c1-4bd0-9fb1-0edaec58a6ed",
                                "sense_id": "bf16fe47-5096-3ba3-b886-471aa14e48f1",
                                "text": "On w prostocie ducha nawet panią Reginę uważa za charakter kryształowy."
                            },
                            {
                                "example_id": "d639a58c-e1fb-4e6f-a6ac-fbe98b5a9cda",
                                "sense_id": "bf16fe47-5096-3ba3-b886-471aa14e48f1",
                                "text": "Właśnie wracamy od Reginy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "41e56fca-ec46-3e4f-be17-ac157ac2d287",
                        "entry_id": "8198f865-45c3-363c-9cc3-1f82c70ade1f",
                        "glosses": [
                            "jednostka osadnicza w Stanach Zjednoczonych, w stanie Nowy Meksyk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e53708-a72d-42f6-85c8-84e053169621",
                                "sense_id": "41e56fca-ec46-3e4f-be17-ac157ac2d287",
                                "text": "Przybysze w XVII wieku osiedli w Reginie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "07a1f2d6-f110-300b-bf5a-32e137850c2b",
