                                "example_id": "1094a9a9-c51d-4d1a-9e2a-fa12753e27d9",
                                "sense_id": "09e32afb-35a7-3b96-84b0-f83fe32c3f32",
                                "text": "„Scanlon hatte die Streifenbeamten des Viertels mit großzügigen Summen bestochen.“"
                            },
                            {
                                "example_id": "ecbb6a3a-3cd5-4034-8aef-8bd35fa4764f",
                                "sense_id": "09e32afb-35a7-3b96-84b0-f83fe32c3f32",
                                "text": "„Die beiden Streifenbeamten sitzen eine ganze Weile stumm in ihrem Wagen und sehen dem sich entfernenden Pick-up nach.“"
                            }
                        ],
