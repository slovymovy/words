                            }
                        },
                        {
                            "text": "Opgelucht dat het vermoeiende <w>karwei</w> er eindelijk op zat fietste ik rustig terug naar huis.",
                            "target_lang_translations": {
                                "en": "Relieved that the tiring <w>task</w> was finally over, I cycled quietly back home."
                            }
