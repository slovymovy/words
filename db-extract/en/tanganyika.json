                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Танганьи́ка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "817b9127-637c-3c93-a4a6-0a3e0f496852",
                                        "entry_id": "1e4e3d52-2305-35c9-9638-d94fcdbc031b",
                                        "glosses": [
                                            "геогр., гидрол., лимнол. первое по протяжённости и второе по глубине озеро в мире, расположенное в Восточной Африке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bda622f-0c6d-462f-89c8-87286c05e3ba",
                                                "sense_id": "817b9127-637c-3c93-a4a6-0a3e0f496852",
                                                "text": "В 1858 году британские путешественники Ричард Бёртон и Джон Спик в ходе поисков истоков Нила открыли озеро Танганьика."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8f11f17-d420-3e83-abd6-ca05cc748f40",
                                        "entry_id": "1e4e3d52-2305-35c9-9638-d94fcdbc031b",
                                        "glosses": [
                                            "истор. территория в Восточной Африке, находившаяся под управлением Великобритании в 1919–1961 гг."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab96f312-cadd-47d4-818c-c783df13d722",
                                                "sense_id": "d8f11f17-d420-3e83-abd6-ca05cc748f40",
                                                "text": "В 1940 году были основаны, наверное, два самых знаменитых в мире заповедника: национальный парк Серенгети в Танзании (тогда — в Танганьике) и Беловежская Пуща в Белоруссии (тогда — в СССР)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eaf1f05-3e25-36b9-8cff-d3b0c5a08ed1",
                                        "entry_id": "1e4e3d52-2305-35c9-9638-d94fcdbc031b",
                                        "glosses": [
                                            "истор. независимое государство, которым стала территория [2] в 1961 г., объединившееся с Занзибаром в современную Танзанию в 1964 г."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec891d01-2a2d-4ebe-83cc-ee98d59bc989",
                                                "sense_id": "2eaf1f05-3e25-36b9-8cff-d3b0c5a08ed1",
                                                "text": "Сказал, что говорит по-английски, сам из Танганьики, зовут Мак сокращённо, а вообще Абу Макемо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d80d424-8f99-3e83-a6ba-728bd46601f6",
                                        "entry_id": "1e4e3d52-2305-35c9-9638-d94fcdbc031b",
                                        "glosses": [
                                            "геогр. название материковой части Танзании"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e808fd3-c093-3470-8e71-e7b5dda23bc7",
                                        "entry_id": "1e4e3d52-2305-35c9-9638-d94fcdbc031b",
                                        "glosses": [
                                            "геогр. провинция на юго-востоке Демократической Республики Конго"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
