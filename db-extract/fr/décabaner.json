                "senses": [
                    {
                        "sense_id": "c730c02c-7a90-35a8-b7d3-cb03b3ab3390",
                        "entry_id": "cc526f01-ec85-353a-a47d-89fee423d34e",
                        "glosses": [
                            "Partir, changer de lieu de résidence ou de campement."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a3583f1c-92da-4366-a1b1-fbddc22509bf",
                                "sense_id": "c730c02c-7a90-35a8-b7d3-cb03b3ab3390",
                                "text": "Pars dans les bois et dis à tes parents de décabaner !"
                            },
                            {
                                "example_id": "b16812be-bdb6-45de-a45c-6bed3ff6f500",
                                "sense_id": "c730c02c-7a90-35a8-b7d3-cb03b3ab3390",
                                "text": "Ils trouvèrent nos bons Chrétiens et Néophites, lors qu’ils venoient de décabaner pour enfoncer davantage dans les bois, et qu’ils étoient chargez de femmes, d’enfans et de bagage; ce qui ne leur donna pas le loisir de se mettre en défense."
                            },
                            {
                                "example_id": "c2353103-fef4-463f-94b9-2a002d73c7ed",
                                "sense_id": "c730c02c-7a90-35a8-b7d3-cb03b3ab3390",
                                "text": "Le terrien ne peut, à la façon du chasseur amérindien, décabaner selon ses caprices et ceux du gibier, et dresser autour d’un piquet sa tente légère, car s’il est le gardien de sa maison, sa maison le garde."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1d91868-f7e4-3685-9c58-873e7474eab8",
                        "entry_id": "cc526f01-ec85-353a-a47d-89fee423d34e",
                        "glosses": [
                            "Partir, changer de lieu de résidence."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "e5425e4f-f8aa-433b-8636-95fca2f4dd31",
                                "sense_id": "b1d91868-f7e4-3685-9c58-873e7474eab8",
                                "text": "Tu vois, Jeanne, on va se décabaner."
                            }
                        ]
                    }
                ],
