            "senses": [
                {
                    "sense_id": "edad3034-9149-3e67-af43-d791c1bb123b",
                    "sense_definition": "The act of relaxing or resting in a lazy, reclining manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rest_or_hang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His weekend was spent in quiet <w>lolling</w> on the comfortable sofa.",
                            "target_lang_translations": {
                                "cs": "Víkend strávil tichým <w>lenošením</w> na pohodlné pohovce."
                            }
                        },
                        {
                            "text": "Too much idle <w>lolling</w> will keep you from finishing your chores.",
                            "target_lang_translations": {
                                "cs": "Příliš mnoho zahálčivého <w>povalování</w> ti zabrání dokončit povinnosti."
                            }
