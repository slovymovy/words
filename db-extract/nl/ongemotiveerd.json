                        "target_lang_word": "unmotivated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmotivated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7814441b-50fa-3c9d-bcd8-29fc2f713187",
                                        "entry_id": "3d184c67-5e7a-39cf-bb73-9d7c872979a8",
                                        "glosses": [
                                            "Lacking motivation, without impetus to strive or excel."
                                        ],
                                        "tags": [
                                            "of a person or persons"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e2f23a-7846-46ba-8876-71c5a6468a0a",
                                                "sense_id": "7814441b-50fa-3c9d-bcd8-29fc2f713187",
                                                "text": "Near-synonym: demotivated"
                                            },
                                            {
                                                "example_id": "2675f21d-e064-4581-a4da-fc4ef07c6b3d",
                                                "sense_id": "7814441b-50fa-3c9d-bcd8-29fc2f713187",
                                                "text": "an unmotivated student"
                                            },
                                            {
                                                "example_id": "2981a29a-21d9-4105-b4c9-7ecd071678c7",
                                                "sense_id": "7814441b-50fa-3c9d-bcd8-29fc2f713187",
                                                "text": "When a typically chatty employee who often participates in meetings and is engaged and enthusiastic suddenly becomes unmotivated and quieter, that person could be at risk for burnout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d09b76-c06e-34f1-9297-85e3fb8b6ce7",
                                        "entry_id": "3d184c67-5e7a-39cf-bb73-9d7c872979a8",
                                        "glosses": [
                                            "For which there is no motive, or no apparent rational motive."
                                        ],
                                        "tags": [
                                            "of an act or behavior"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd280812-d36c-4404-a26e-a0948f9c2e22",
                                                "sense_id": "f4d09b76-c06e-34f1-9297-85e3fb8b6ce7",
                                                "text": "Near-synonym: unprovoked"
                                            },
                                            {
                                                "example_id": "bda5db34-158c-47a0-9b5b-bafd991e1cb2",
                                                "sense_id": "f4d09b76-c06e-34f1-9297-85e3fb8b6ce7",
                                                "text": "an unmotivated murder"
                                            },
                                            {
                                                "example_id": "87f0226f-10ac-45dc-bd7a-ba1ee9372caa",
                                                "sense_id": "f4d09b76-c06e-34f1-9297-85e3fb8b6ce7",
                                                "text": "An inherited etymology should not involve too many unmotivated irrregular sound changes aor ^([sic]) non-trivial semantic shifts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b06b1c62-a6af-49f9-89ae-0b7a8fb4b618",
                        "source_entry_id": "bbbd9ab2-719a-33fb-bce2-f1b9ce9f4e9a",
                        "source_sense_id": "e02ce139-874a-3c0e-b161-1f84a90c2e49",
                        "source_sense_description": "zonder enige toelichting (waarom iets moet of waarom iemand iets vind)",
                        "target_lang_word": "unfounded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfounded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d09fc4c8-6394-3081-b601-ab7ba26d8716",
                                        "entry_id": "06f6799e-a0e4-398c-b034-fca0c3ad2ace",
                                        "glosses": [
                                            "Having no strong foundation; not based on solid reasons or facts."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59457124-ee02-4ecb-887c-510d4cf5c7ee",
                                                "sense_id": "d09fc4c8-6394-3081-b601-ab7ba26d8716",
                                                "text": "an unfounded report; unfounded fears"
                                            },
                                            {
                                                "example_id": "5a858dfa-7b83-454a-9df9-94723cb38f47",
                                                "sense_id": "d09fc4c8-6394-3081-b601-ab7ba26d8716",
                                                "text": "[…] my chiefest design ever since the seventeenth year of my age […] consisted in elaborating such demonstrations in Natural Philosophy, as might serve to unfold the natures of Beings in relation to the Art of Physick, hitherto so uncertain, blind, and unfounded on Art […]"
                                            },
                                            {
                                                "example_id": "2a30e93e-ac1d-48ae-a4ec-58294b298251",
                                                "sense_id": "d09fc4c8-6394-3081-b601-ab7ba26d8716",
                                                "text": "[…] such unfounded conjectures are best answered by neglect."
                                            },
                                            {
                                                "example_id": "47472bea-6dc2-4c49-a509-ab65553f321d",
                                                "sense_id": "d09fc4c8-6394-3081-b601-ab7ba26d8716",
                                                "text": "The gloom of her first anticipations was proved to have been unfounded."
                                            },
                                            {
                                                "example_id": "e79771f2-bc2b-4851-bde1-d11923d5bb5e",
                                                "sense_id": "d09fc4c8-6394-3081-b601-ab7ba26d8716",
                                                "text": "“He give a name,” said Mrs. Hall—an assertion which was quite unfounded—“but I didn’t rightly hear it.”"
                                            },
                                            {
                                                "example_id": "1e26f664-58d9-4b92-9961-e04611c76120",
                                                "sense_id": "d09fc4c8-6394-3081-b601-ab7ba26d8716",
                                                "text": "[…] the allegation that his lordship never allowed Jewish people to enter the house or any Jewish staff to be employed is utterly unfounded […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36c64323-04ec-3712-a3f6-95f06ffd1523",
                                        "entry_id": "06f6799e-a0e4-398c-b034-fca0c3ad2ace",
                                        "glosses": [
                                            "Not having been founded or instituted."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75f1695-f263-4229-b5f5-94cdb3db1c88",
                                                "sense_id": "36c64323-04ec-3712-a3f6-95f06ffd1523",
                                                "text": "Even the great world as yet undiscovered, the cities as yet unfounded, and the history as yet unwritten, are lost: fallen from the beginning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ffff5c6-ba23-3b8d-b6c5-471f31138edc",
                                        "entry_id": "06f6799e-a0e4-398c-b034-fca0c3ad2ace",
                                        "glosses": [
                                            "Bottomless."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da8ac5ec-100a-4f03-84b2-15dbc85d7262",
                                                "sense_id": "9ffff5c6-ba23-3b8d-b6c5-471f31138edc",
                                                "text": "[…] from them I go\nThis uncouth errand sole, and one for all\nMy self expose, with lonely steps to tread\nTh’ unfounded deep […]"
                                            },
                                            {
                                                "example_id": "c5f08303-6af7-48c8-8581-4e2aea2f7af1",
                                                "sense_id": "9ffff5c6-ba23-3b8d-b6c5-471f31138edc",
                                                "text": "He makes this Glob so spacious and fair\nUnfix’d, unprop’d, unfounded any where,\nHang, like a Water-bubble in the Air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
