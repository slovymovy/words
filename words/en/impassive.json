{
    "word_family": [
        "impassivity",
        "impassively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb1ab15a-b3c5-3a30-9905-a6262f78c951",
                    "sense_definition": "Having or showing no emotion or reaction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotionless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>impassive</w> guard did not even blink when the alarm started ringing.",
                            "target_lang_translations": {
                                "zh": "当警报响起时，那位<w>面无表情的</w>警卫甚至连眼睛都没眨一下。"
                            }
                        },
                        {
                            "text": "She maintained an <w>impassive</w> expression while listening to the difficult news.",
                            "target_lang_translations": {
                                "zh": "听着这个艰难的消息时，她保持着<w>毫无波澜的</w>表情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unemotional",
                        "dispassionate",
                        "stolid"
                    ],
                    "common_phrases": [
                        "impassive expression",
                        "impassive face"
                    ],
                    "target_lang_definitions": {
                        "zh": "不表露情感的；神色冷漠的；面无表情的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "面无表情的",
                                "target_lang_sense_clarification": "脸上没有表情"
                            },
                            {
                                "target_lang_word": "神情木然的",
                                "target_lang_sense_clarification": "神色呆滞冷淡，不起波澜"
                            },
                            {
                                "target_lang_word": "无动于衷的",
                                "target_lang_sense_clarification": "对外界刺激没有反应或情绪起伏"
                            },
                            {
                                "target_lang_word": "冷漠的",
                                "target_lang_sense_clarification": "态度冷淡，缺乏情感流露"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64d9202a-5cb3-32d7-9e70-1585e88e2f48",
                    "sense_definition": "Completely still or motionless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "motionless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue stood <w>impassive</w> in the center of the quiet garden.",
                            "target_lang_translations": {
                                "zh": "雕像<w>纹丝不动地</w>矗立在幽静的花园中央。"
                            }
                        },
                        {
                            "text": "He remained <w>impassive</w> as the crowd moved quickly around him.",
                            "target_lang_translations": {
                                "zh": "尽管人群在他周围匆匆穿梭，他依然<w>伫立不动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "motionless",
                        "still",
                        "stationary"
                    ],
                    "target_lang_definitions": {
                        "zh": "纹丝不动的；毫无知觉或反应的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纹丝不动的",
                                "target_lang_sense_clarification": "形容完全静止"
                            },
                            {
                                "target_lang_word": "静止不动的",
                                "target_lang_sense_clarification": "完全没有动作或移动"
                            },
                            {
                                "target_lang_word": "泰然不动的",
                                "target_lang_sense_clarification": "安稳静止，不为所动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}