                                "target_senses": [
                                    {
                                        "sense_id": "c42af485-a8f4-3c3d-ab19-a5bdaac5a215",
                                        "entry_id": "2b4efafc-d137-3124-b280-d821747a1309",
                                        "glosses": [
                                            "A person who lives on an island."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9785196-ee02-442f-b849-ad9671479944",
                                                "sense_id": "c42af485-a8f4-3c3d-ab19-a5bdaac5a215",
                                                "text": "Susan happily introducing speaker Steve Smith, Channel Eleven’s newzanchor, ya’know, and an islandophile from wayyy back – and as of this writing, a newly retired islander and fisherman."
                                            },
                                            {
                                                "example_id": "096276e6-3f6b-4ef8-b272-71cf9a2476b2",
                                                "sense_id": "c42af485-a8f4-3c3d-ab19-a5bdaac5a215",
                                                "text": "The Foreign and Commonwealth Office (FCO) has categorically ruled out any new negotiations saying the future of the Falklands can only be decided by the islanders themselves in accordance with the UN principle of self-determination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b518faed-65d5-496d-b184-8f81c40a9aca",
                        "source_entry_id": "7271f0d3-1733-39b6-be2c-fbdf02368df9",
                        "source_sense_id": "6ed1929c-fa3a-3a13-869d-ab29aaa1e490",
                        "source_sense_description": "iemand die op een eiland woont",
                        "target_lang_word": "insulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6df3d8a3-6ad0-3a04-9155-5a64db841de4",
                                        "entry_id": "e2614a91-0c27-397f-b4fb-ff73df7b6419",
                                        "glosses": [
                                            "Habitant des îles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba539df-90d6-49ba-b4ce-dc3468008f37",
                                                "sense_id": "6df3d8a3-6ad0-3a04-9155-5a64db841de4",
                                                "text": "C’était un insulaire et un pêcheur hors pair, qui rapportait toujours plus de homards que les autres, et cela semblait une qualification suffisante."
                                            },
                                            {
                                                "example_id": "46f2bf62-8856-4e71-8227-f462d9cdf85c",
                                                "sense_id": "6df3d8a3-6ad0-3a04-9155-5a64db841de4",
                                                "text": "Les insulaires de la mer Pacifique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33df1f12-02b0-3fd4-8218-d205e493e948",
                                        "entry_id": "aa850ff0-76dc-3155-9d0e-b0efe621155c",
                                        "glosses": [
                                            "Relatif aux îles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ab6a39-f82b-43b5-bb2d-1f3def27ca9d",
                                                "sense_id": "33df1f12-02b0-3fd4-8218-d205e493e948",
                                                "text": "La sûreté du pays étant suffisamment garantie par sa position insulaire, l’action militaire n’y prit jamais une grande importance."
                                            },
                                            {
                                                "example_id": "096be736-852d-4f26-9c6c-b06fc28b5386",
                                                "sense_id": "33df1f12-02b0-3fd4-8218-d205e493e948",
                                                "text": "Bien qu'elle confine au cercle polaire, l’Islande est située presque entièrement dans la zone tempérée; on pourrait croire qu'elle jouit d'un climat insulaire et uniforme, grâce surtout à l'influence du Gulf-Stream qui adoucit la température de la Norwége ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e493144a-99c7-39c3-8902-c649b0cdc383",
                                        "entry_id": "aa850ff0-76dc-3155-9d0e-b0efe621155c",
                                        "glosses": [
                                            "Qui habite une île."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb2fe88-ce0d-4e4d-8b61-555b7189276b",
                                                "sense_id": "e493144a-99c7-39c3-8902-c649b0cdc383",
                                                "text": "L’endémisme est particulièrement développé dans trois sortes de flores : les flores isolées, les flores montagnardes, les flores insulaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
