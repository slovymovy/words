                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e3fc062-f4ef-34c2-94bb-4066a1f6dfaf",
                        "entry_id": "fecd5f7f-fbb5-3fa2-8963-8c939502ed9c",
                        "glosses": [
                            "Bach"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "f266cac0-6150-4f04-a454-a011b88bd520",
                                "sense_id": "7e3fc062-f4ef-34c2-94bb-4066a1f6dfaf",
                                "text": "„Sród takich pól przed laty, nad brzegiem ruczaju, / Na pagórku niewielkim, we brzozowym gaju, / Stał dwór szlachecki, z drzewa, lecz podmurowany; / Świéciły się zdaleka pobielane ściany, / Tém bielsze że odbite od ciemnéj zieleni / Topoli, co go bronią od wiatrów jesieni.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54480708-2d76-4905-b18a-8d6ddf159456",
                        "source_entry_id": "fecd5f7f-fbb5-3fa2-8963-8c939502ed9c",
                        "source_sense_id": "7e3fc062-f4ef-34c2-94bb-4066a1f6dfaf",
                        "source_sense_description": "poetisch: Bach",
                        "target_lang_word": "Bach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                        "entry_id": "681a7179-8b4d-326c-b9b5-a5de57418e6e",
                                        "glosses": [
                                            "kleiner, natürlicher Wasserlauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd6e2ac6-6e4d-4d35-aa7f-8046c3189bd0",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„Auf jeden Fall war dieser Bach die spirituelle Quelle unseres Bezirks.“"
                                            },
                                            {
                                                "example_id": "475fc62a-570b-411d-9f49-ab5f861eb7fa",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "Es führte ein kleiner Steg über den Bach."
                                            },
                                            {
                                                "example_id": "0f01df32-1e95-4548-8997-27351eb3afcc",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„Lustig quasselt der seichte Bach. / Scheinchen scheppern darüber flach.“"
                                            },
                                            {
                                                "example_id": "ed315401-9ab6-4e90-9c29-7303e2bb3467",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„An den schulfreien Nachmittagen pflegten wir in den Bächen und Teichen vor der Stadt Molche und Fische zu fangen und auf den Wiesen Schmetterlinge und Käfer.“"
                                            },
                                            {
                                                "example_id": "30196c18-fb3f-4510-9493-b70b346783b6",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„Plötzlich, vor einer Bodensenke, in die sich ein Bach ergoß, warf sich das Tier seitwärts, sprang in den Grund, und sie wurde kopfüber aus dem Sattel geschmissen, und, ehe sie sich's versah, lag sie auf dem Boden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17f610da-0048-3a94-9094-e251f9ca5d7a",
                                        "entry_id": "681a7179-8b4d-326c-b9b5-a5de57418e6e",
                                        "glosses": [
                                            "der Asteroid mit der Nummer 1814"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e6e958-ee5b-4f36-ac08-892fa5c8588e",
                                                "sense_id": "17f610da-0048-3a94-9094-e251f9ca5d7a",
                                                "text": "Bach wurde im Januar 1932 von K. Reinmuth in Heidelberg entdeckt. Benannt ist er nach Johann Sebastian Bach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8de61d00-ad5c-3e0d-b481-58ca2e723cd3",
                                        "entry_id": "681a7179-8b4d-326c-b9b5-a5de57418e6e",
                                        "glosses": [
                                            "Fachausdruck für mehrere untereinander stehende Wortzwischenräume, die sich dem Auge des Betrachters zu einem „Bach“ [1] verbinden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab255c1d-bd9a-4391-a28c-5dc50be47552",
                                                "sense_id": "8de61d00-ad5c-3e0d-b481-58ca2e723cd3",
                                                "text": "Bäche „lassen sich oft mit wenig Aufwand durch leichte Variation in Schriftgröße, Breite des Satzspiegels oder Silbentrennung eines langen Wortes am Ende einer der vorangehenden Zeilen beheben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                        "entry_id": "ac7a665b-87b4-3b7a-8538-47ca6a77fed4",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname, auch in der Form von Bach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab60170a-97b7-4785-927f-d993140f6666",
                                                "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                                "text": "Günter Bach unternimmt seit 1995 keine Wattwanderungen mehr."
                                            },
                                            {
                                                "example_id": "61afefd1-96d6-4397-9ad9-2d60f0627fce",
                                                "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                                "text": "Bachs haben wieder Äpfel aus dem Alten Land mitgebracht."
                                            },
                                            {
                                                "example_id": "c4e3347e-4c14-4947-bbce-de012ba99806",
                                                "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                                "text": "Die Bach konnte noch auf einen Mülleimer hüpfen, aber der Bach wurde vom Hund gebissen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "580b57ce-911d-3f48-a09e-ae5d6e76e006",
                                        "entry_id": "fed597b3-9dda-3b30-8cf1-d8acfe924431",
