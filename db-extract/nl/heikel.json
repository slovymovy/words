                "senses": [
                    {
                        "sense_id": "5ce216ff-0855-3c2f-aeb1-12368d8e079b",
                        "entry_id": "394274fa-62f7-31c2-9875-51efc72fe00b",
                        "glosses": [
                            "van een onderwerp dat het een moeilijke en pijnlijke kwestie betreft waar moeilijk over te praten valt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51bed33d-3943-4284-b0c9-30a56f709ce2",
                                "sense_id": "5ce216ff-0855-3c2f-aeb1-12368d8e079b",
                                "text": "Toen de staatssecretaris in de Tweede Kamer had gesproken over de loterij inclusief het heikele onderwerp van de vergoeding, stuurde de loterij de redacties van kranten onmiddellijk haar repliek."
                            },
                            {
                                "example_id": "f671381b-c227-4b24-8e2c-6f68f675d644",
                                "sense_id": "5ce216ff-0855-3c2f-aeb1-12368d8e079b",
                                "text": "Mo zweeg. Hij moest dit even laten bezinken. Zelfmoord was een heikele kwestie binnen de islam en de pil van Drion was in feite een zelfmoordpil. Voor mensen die hun eigen leven namen wachtte het eeuwige hellevuur. Het was binnen zijn geloof weliswaar niet verboden, maar het werd wel sterk afgekeurd. In de jihad golden weer andere wetten en werden zelfmoordterroristen heilige martelaars."
                            }
                        ]
                    }
