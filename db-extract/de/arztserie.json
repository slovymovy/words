                "senses": [
                    {
                        "sense_id": "a572542b-f9eb-326d-91e6-ff9a35842cdb",
                        "entry_id": "3e044c82-904b-34e7-80bc-baf5d3a3e5c8",
                        "glosses": [
                            "regelmäßig erscheinende Fernsehsendung, in der mindestens ein Arzt die Hauptfigur ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c6a3d8-7411-46bc-928a-c6d0c1c445c9",
                                "sense_id": "a572542b-f9eb-326d-91e6-ff9a35842cdb",
                                "text": "„Vielleicht gibt es doch noch Hoffnung auf Heilung - ganz wie in den guten, alten Arztserien.“"
                            },
                            {
                                "example_id": "f1d82115-6530-4150-bc5f-b22017d7c059",
                                "sense_id": "a572542b-f9eb-326d-91e6-ff9a35842cdb",
                                "text": "„Die durchschnittliche staatlich finanzierte TV-Serie, ob Soap, Heimatfilm, Arztserie oder Krimi, strahlt ein hohes Maß an Vertrauen in den Staat aus, stellt die Gesellschaft als grundsätzlich heil dar und fordert uns nicht zum Nachdenken auf: Alles ist gut, wie es ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
