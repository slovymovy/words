                "senses": [
                    {
                        "sense_id": "9aea0483-0092-33b5-a211-2036e142f9cf",
                        "entry_id": "45cc87a5-cfaa-3799-9286-c679649ab1e6",
                        "glosses": [
                            "verschiedene Leinengewebe, besonders: gitterartiges, festes Gewebe in Leinwandbindung für Stickereien oder für Fliegen- und Luftfenster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71185709-02b0-443b-8e71-2f79a2bff1ff",
                                "sense_id": "9aea0483-0092-33b5-a211-2036e142f9cf",
                                "text": "auf Kanevas sticken"
                            },
                            {
                                "example_id": "40e93508-4eae-4c65-a1bc-e37e7d7ba3a6",
                                "sense_id": "9aea0483-0092-33b5-a211-2036e142f9cf",
                                "text": "Auf Kanevas werden hauptsächlich der gewöhnliche Kreuzstich und seine Abarten (Gobelinstich, Webstich) ausgeführt sowie der sehr feine Petitpoint-Stich, welcher sehr zarte, mosaikartige Bildnerei ermöglicht."
                            },
                            {
                                "example_id": "3d74f355-fa36-4010-92e8-c2a0e74cc92d",
                                "sense_id": "9aea0483-0092-33b5-a211-2036e142f9cf",
                                "text": "Er stellte fest, dass der Stoff an einigen Stellen so dünn wie Kanevas geworden war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "895c6cd4-4f45-3609-a1cc-c9a13137ed6e",
                        "entry_id": "45cc87a5-cfaa-3799-9286-c679649ab1e6",
                        "glosses": [
                            "Szenarium, das in der Commedia dell'Arte den Handlungsablauf festlegt und von den Schauspielern durch Improvisation ausgefüllt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
