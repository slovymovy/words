                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                        "entry_id": "c840b545-8c39-33eb-af93-e2e6064a9c9a",
                                        "glosses": [
                                            "rechtlich bindende Vereinbarung zwischen mindestens zwei verschiedenen Partnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8567a6-ffbe-43d3-b235-0e04d357c7f6",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "Auch wenn wir Freunde sind, haben wir einen Vertrag aufgesetzt, als ich Peters Auto kaufte."
                                            },
                                            {
                                                "example_id": "7cc73868-0f51-4c7b-960f-e3699cfa55cd",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Daphne beklagte sich über ihren Vertrag und über die Nebenrechte.“"
                                            },
                                            {
                                                "example_id": "dff64fe9-0ec0-430e-9fab-60bd57083832",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Bei Milch, Käse und Joghurt gibt es längerfristige Verträge, nur beim Streichfett verhandeln Molkereien und Handel ihre Kontrakte monatlich neu.“"
                                            },
                                            {
                                                "example_id": "27686aeb-feab-44d3-8268-b84586abd2e8",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Er wurde von Kapitän Johnston aufgenommen, unterschrieb den Vertrag und schloss sich uns am folgenden Tag in Seemannsplünnen an.“"
                                            },
                                            {
                                                "example_id": "49bedcfd-a4e6-40d4-8fd3-0d318dad6001",
                                                "sense_id": "62056a88-8f68-3c69-9be1-35792e80e6ab",
                                                "text": "„Remarque hat einen sehr lukrativen Vertrag abgeschlossen, und Alfred Scherz hofft, den Bestsellerautor langfristig an sein Haus binden zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
