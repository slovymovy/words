                "word": "disintermediation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "436ce443-ba5a-48f0-b371-6f6ae1333a7b",
                        "entry_id": "7f34f554-2239-3396-ae48-0d357dc841fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "disintermediations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c3794fd-2c1c-3736-94ff-eb385553b84a",
                        "entry_id": "7f34f554-2239-3396-ae48-0d357dc841fc",
                        "glosses": [
                            "The removal of funds from a financial institution such as a bank for direct purchase of financial instruments."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "212e0d62-e6bc-4d8b-a814-8c5ffda8c55f",
                                "sense_id": "3c3794fd-2c1c-3736-94ff-eb385553b84a",
                                "text": "Any disintermediation crisis, such as has occurred three times since 1966, causes mortgage money to dry up and slow down new housing construction which the country desperately needs."
                            }
                        ]
                    },
                    {
                        "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                        "entry_id": "7f34f554-2239-3396-ae48-0d357dc841fc",
                        "glosses": [
                            "The removal of an intermediary from a commercial transaction."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e6cbff80-84b1-4582-8989-3a1d288e943e",
                                "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                                "text": "The news industry is undergoing a massive disintermediation due to the ubiquitous low-cost communication made possible by the internet."
                            },
                            {
                                "example_id": "fdb1d8f4-66c7-4b40-9aac-faaf31a268a2",
                                "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                                "text": "New-media thinkers, with their appetite for disintermediation and creative destruction, implicitly endorse and advance this transformation."
                            },
                            {
                                "example_id": "cc024190-6a4e-4d0b-9798-21d519ab8941",
                                "sense_id": "b51ce50e-2d1d-3109-b20a-db1fbe08f068",
                                "text": "The logic of disintermediation seems self-evident: By putting factories directly in contact with stores, by helping customers order directly from manufacturers, by letting riders coordinate with drivers, you cut out a needless source of waste and inefficiency."
                            }
                        ]
                    }
                ],
