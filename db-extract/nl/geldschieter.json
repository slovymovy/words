                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Die Geldgeber sind unzufrieden.“"
                                            },
                                            {
                                                "example_id": "8b869875-6ea1-47bc-b73c-269db0f6d991",
                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Anatol besass einen Pass, einen Postfahrschein, zehntausend Rubel von seiner Schwester und weitere zehntausend Rubel, die ihm Dolochow von irgendeinem Geldgeber verschafft hatte.“"
                                            },
                                            {
                                                "example_id": "95493269-a7dc-4959-b1c9-773eba17d708",
                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Zu den Geldgebern gehörte auch der Jugendstil-Zeichner Marcus Behmer.“"
                                            },
                                            {
                                                "example_id": "f36505b1-dd3b-462f-b6c3-cc9ed233744b",
                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Einer der Geldgeber der Stolbergs war Hans Luder, der Vater des Reformators.“"
                                            }
                                        ],
