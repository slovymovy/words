{
    "word_family": [
        "porterage",
        "port",
        "portable",
        "portage",
        "portal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99ca2e28-00cc-3b5f-a338-9df343bb1b3e",
                    "sense_definition": "A person employed to carry luggage and other loads, especially in a railway station, airport, or hotel.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "carrying_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>porter</w> helped us carry our heavy suitcases to the hotel room.",
                            "target_lang_translations": {
                                "ru": "<w>Носильщик</w> помог нам донести тяжелые чемоданы до гостиничного номера."
                            }
                        },
                        {
                            "text": "When we arrived at the station, a <w>porter</w> was waiting to assist with the bags.",
                            "target_lang_translations": {
                                "ru": "Когда мы прибыли на станцию, <w>носильщик</w> уже ждал, чтобы помочь с сумками."
                            }
                        }
                    ],
                    "synonyms": [
                        "carrier",
                        "baggage handler"
                    ],
                    "common_phrases": [
                        "railway porter",
                        "hotel porter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для переноски багажа и других грузов, особенно на вокзалах, в аэропортах или отелях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носильщик",
                                "target_lang_sense_clarification": "человек, переносящий багаж"
                            },
                            {
                                "target_lang_word": "грузчик",
                                "target_lang_sense_clarification": "рабочий, занимающийся погрузкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c37702d3-da5b-385e-9cbd-d47abfbafe22",
                    "sense_definition": "A person in charge of the entrance of a large building, such as a block of flats or a college.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "building_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>porter</w> at the front desk asked to see my identification before letting me in.",
                            "target_lang_translations": {
                                "ru": "<w>Портье</w> на стойке регистрации попросил предъявить удостоверение личности, прежде чем впустить меня."
                            }
                        },
                        {
                            "text": "If you lose your keys, you should speak to the night <w>porter</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы потеряете ключи, вам следует обратиться к ночному <w>портье</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorman",
                        "gatekeeper",
                        "concierge"
                    ],
                    "common_phrases": [
                        "night porter",
                        "college porter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, отвечающий за вход в большое здание, такое как многоквартирный дом или колледж."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портье",
                                "target_lang_sense_clarification": "служащий в вестибюле отеля или здания"
                            },
                            {
                                "target_lang_word": "швейцар",
                                "target_lang_sense_clarification": "дежурный у входа"
                            },
                            {
                                "target_lang_word": "вахтёр",
                                "target_lang_sense_clarification": "дежурный в учреждении или общежитии"
                            },
                            {
                                "target_lang_word": "консьерж",
                                "target_lang_sense_clarification": "ответственный за порядок в жилом доме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0acfee9a-2927-378c-8acf-b0958a4aaa46",
                    "sense_definition": "A dark style of beer, similar to stout, that was originally popular among street and river porters.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered a pint of <w>porter</w> and sat by the fireplace.",
                            "target_lang_translations": {
                                "ru": "Он заказал пинту <w>портера</w> и сел у камина."
                            }
                        },
                        {
                            "text": "This brewery is famous for its rich and chocolatey <w>porter</w>.",
                            "target_lang_translations": {
                                "ru": "Эта пивоварня славится своим насыщенным шоколадным <w>портером</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stout"
                    ],
                    "common_phrases": [
                        "pint of porter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темный сорт пива, похожий на стаут, который изначально был популярен среди уличных и речных носильщиков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портер",
                                "target_lang_sense_clarification": "сорт темного пива"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fc110f0-0fc2-369f-8c2a-32755c704a0f",
                    "sense_definition": "A person who adapts software so that it can be used on a different computer system or platform.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software <w>porter</w> spent weeks ensuring the game ran smoothly on the new console.",
                            "target_lang_translations": {
                                "ru": "<w>Портер</w> программного обеспечения потратил недели, добиваясь плавной работы игры на новой консоли."
                            }
                        },
                        {
                            "text": "He is a well-known Linux <w>porter</w> in the open-source community.",
                            "target_lang_translations": {
                                "ru": "Он известный <w>портер</w> Linux в сообществе открытого ПО."
                            }
                        }
                    ],
                    "common_phrases": [
                        "software porter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специалист, адаптирующий программное обеспечение для работы на другой компьютерной системе или платформе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портер",
                                "target_lang_sense_clarification": "специалист по портированию ПО"
                            },
                            {
                                "target_lang_word": "разработчик портирования",
                                "target_lang_sense_clarification": "технический специалист"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66b9c5ac-774d-37ef-905f-fd1d961fc07e",
                    "sense_definition": "To work as a porter or to carry items in the manner of a porter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his summers <w>portering</w> supplies up to the mountain base camp.",
                            "target_lang_translations": {
                                "ru": "Летом он подрабатывал <w>переноской</w> припасов в базовый лагерь в горах."
                            }
                        },
                        {
                            "text": "The job involves <w>portering</w> heavy equipment between different hospital departments.",
                            "target_lang_translations": {
                                "ru": "Работа включает в себя <w>транспортировку</w> тяжелого оборудования между различными отделениями больницы."
                            }
                        }
                    ],
                    "synonyms": [
                        "carry",
                        "transport"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать носильщиком или переносить вещи подобно носильщику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать носильщиком",
                                "target_lang_sense_clarification": "выполнять обязанности носильщика"
                            },
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "транспортировать груз вручную"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "679b7234-84b5-3d67-86d9-1318bd1d4893",
                    "sense_definition": "A common English surname that originally referred to someone who worked as a <w>porter</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous composer Cole <w>Porter</w> wrote many classic American songs.",
                            "target_lang_translations": {
                                "ru": "Знаменитый композитор Коул <w>Портер</w> написал множество классических американских песен."
                            }
                        },
                        {
                            "text": "Professor <w>Porter</w> will be giving a lecture on history this afternoon.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Портер</w> сегодня днем прочтет лекцию по истории."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "occupational origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия, которая изначально относилась к человеку, работавшему носильщиком или привратником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Портер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8edbb8d6-60a7-3879-9b68-9b0bf8c9625f",
                    "sense_definition": "A given name used for both males and females.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "given_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "They decided to name their newborn son <w>Porter</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать своего новорожденного сына <w>Портер</w>."
                            }
                        },
                        {
                            "text": "<w>Porter</w> is becoming a more popular choice for a first name lately.",
                            "target_lang_translations": {
                                "ru": "В последнее время имя <w>Портер</w> становится все более популярным выбором."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личное имя, используемое как для мужчин, так и для женщин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Портер",
                                "target_lang_sense_clarification": "личное имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77606f1d-84d0-386a-a9c0-02753e7357dd",
                    "sense_definition": "The name of several towns and communities in the United States.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The family moved to a small house in <w>Porter</w>, Indiana.",
                            "target_lang_translations": {
                                "ru": "Семья переехала в небольшой дом в <w>Портере</w>, штат Индиана."
                            }
                        },
                        {
                            "text": "There is a town called <w>Porter</w> located in Niagara County.",
                            "target_lang_translations": {
                                "ru": "В округе Ниагара есть город под названием <w>Портер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких городов и населенных пунктов в Соединенных Штатах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Портер",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}