                "senses": [
                    {
                        "sense_id": "27422e92-fd21-3943-89fc-47481034e0a3",
                        "entry_id": "53fc053d-787b-30f4-bc6d-a6053fe68b7e",
                        "glosses": [
                            "Personne dont le métier est l’étude des champignons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c32b6075-41cc-4404-b26c-5c20b03a8bc0",
                                "sense_id": "27422e92-fd21-3943-89fc-47481034e0a3",
                                "text": "Le mycologue doit saisir toutes les occasions de décrire avec détail et précision de soumettre à l’expérimentation et de figurer, les formes de champignons hyphomycètes qu’il peut rencontrer."
                            },
                            {
                                "example_id": "a93f6229-5293-4625-903a-fa5d31d5140c",
                                "sense_id": "27422e92-fd21-3943-89fc-47481034e0a3",
                                "text": "Elle était une mycologue très avertie, à lʼœil très sûr, lorsquʼelle rédigea, en août 1845, un mémoire argumenté sur un champignon quʼelle nomma Botrytis vastatrix Lib. et quʼelle identifia comme lʼagent responsable dʼune maladie ravageant les pommes de terre à travers lʼEurope."
                            }
                        ]
                    }
                ],
