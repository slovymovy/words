                            {
                                "target_lang_word": "owe",
                                "target_lang_sense_clarification": "be under obligation to pay"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kosten",
                                "target_lang_sense_clarification": "einen bestimmten Preis haben"
                            },
                            {
                                "target_lang_word": "zustehen",
                                "target_lang_sense_clarification": "Anspruch auf Zahlung haben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
