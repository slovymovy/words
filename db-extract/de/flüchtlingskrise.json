                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ab677c1-dfef-484f-bedc-a7893479c877",
                                "sense_id": "4182fc84-4b96-3701-840f-b4c271840631",
                                "text": "Der libysche Menschenrechtsaktivist Ayoob Sufian aus der Stadt Zuwara fühlt sich durch die aktuellen Zustände an 2015 erinnert, der Höhepunkt der Flüchtlingskrise."
                            }
                        ]
