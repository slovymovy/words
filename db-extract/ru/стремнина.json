                "senses": [
                    {
                        "sense_id": "5d08a9a5-a00a-3ff5-89e1-906fb5462875",
                        "entry_id": "7079ba06-dc30-3000-a985-e1368761c3b7",
                        "glosses": [
                            "место в реке, потоке с бурным стремительным течением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4f8d71-07b9-494a-8508-6a1f9e0a2ab5",
                                "sense_id": "5d08a9a5-a00a-3ff5-89e1-906fb5462875",
                                "text": "Крохотную лодочку начала безжалостно бросать крутая стремнина – шипящие волны пенились, норовя забраться внутрь."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d2c7d7f-b081-3cde-bb1b-f063b7b8e925",
                        "entry_id": "7079ba06-dc30-3000-a985-e1368761c3b7",
                        "glosses": [
                            "устар. крутой скалистый обрыв; глубокое ущелье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cffdf605-6f8b-4838-a938-171f392df58a",
                                "sense_id": "7d2c7d7f-b081-3cde-bb1b-f063b7b8e925",
                                "text": "Кавказ подо мною. Один в вышине, / Стою над снегами у края стремнины…"
                            }
                        ]
                    }
                ],
                "translations": [
