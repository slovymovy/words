{
    "word_family": [
        "derogation",
        "derogatory",
        "derogatorily"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11c55eac-2da5-343f-8957-cb29485a9a9f",
                    "sense_definition": "To express a low opinion of someone or something; to belittle or disparage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disparage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unfair to <w>derogate</w> the hard work of others just because you disagree with their methods.",
                            "target_lang_translations": {
                                "zh": "仅仅因为不同意别人的方法就去<w>贬低</w>他们的辛勤付出是不公平的。"
                            }
                        },
                        {
                            "text": "The manager was warned not to <w>derogate</w> his colleagues during the team meeting.",
                            "target_lang_translations": {
                                "zh": "经理受到了警告，不要在团队会议上<w>贬损</w>同事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vilify",
                        "depreciate",
                        "decry"
                    ],
                    "antonyms": [
                        "praise",
                        "laud",
                        "glorify"
                    ],
                    "target_lang_definitions": {
                        "zh": "贬低、轻视或贬损某人或某事物的价值。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贬低",
                                "target_lang_sense_clarification": "降低对人或成果的评价"
                            },
                            {
                                "target_lang_word": "贬损",
                                "target_lang_sense_clarification": "用言语轻视或贬低"
                            },
                            {
                                "target_lang_word": "轻视",
                                "target_lang_sense_clarification": "看不顺眼或不放在眼里"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38e3cb10-3273-340e-af16-ac70601458bf",
                    "sense_definition": "To reduce the value, authority, or quality of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disparage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such unprofessional behavior <w>derogates</w> from the reputation of the entire organization.",
                            "target_lang_translations": {
                                "zh": "这种不专业的行为会<w>损害</w>整个机构的声誉。"
                            }
                        },
                        {
                            "text": "The new policy <w>derogates</w> from the authority previously held by the local council.",
                            "target_lang_translations": {
                                "zh": "新政策<w>削弱</w>了地方议会此前享有的权威。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "derogate from"
                    ],
                    "target_lang_definitions": {
                        "zh": "削弱、损害或降低（价值、声誉、权威等）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "破坏或削弱声誉、权威"
                            },
                            {
                                "target_lang_word": "削弱",
                                "target_lang_sense_clarification": "使权威或影响力降低"
                            },
                            {
                                "target_lang_word": "贬损",
                                "target_lang_sense_clarification": "降低价值或尊严"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6a93817-403f-33cc-bfe0-bfd0dacade42",
                    "sense_definition": "To behave in a way that is unworthy of one's status or character.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that accepting such a menial task would <w>derogate</w> from his noble standing.",
                            "target_lang_translations": {
                                "zh": "他觉得接受这样卑微的任务会<w>有失</w>自己高贵的<w>身份</w>。"
                            }
                        },
                        {
                            "text": "A true leader should never <w>derogate</w> by engaging in petty public arguments.",
                            "target_lang_translations": {
                                "zh": "真正的领导者绝不应参与琐碎的公开争吵而<w>自贬身价</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in formal or literary contexts regarding social status."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "做出有失身份、品格或体面的行为；自降身价。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有失身份",
                                "target_lang_sense_clarification": "做出不符合自身地位的举止"
                            },
                            {
                                "target_lang_word": "自贬身价",
                                "target_lang_sense_clarification": "做出自损尊严或威信的行为"
                            },
                            {
                                "target_lang_word": "失损体面",
                                "target_lang_sense_clarification": "损害自己的名誉或风度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cc1bc80-79c8-3b50-b975-c46f21a11db6",
                    "sense_definition": "To partially repeal or modify a law or formal agreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new amendment <w>derogates</w> the previous statute regarding property rights.",
                            "target_lang_translations": {
                                "zh": "新修正案<w>部分废除</w>了之前关于财产权的法规。"
                            }
                        },
                        {
                            "text": "The treaty was <w>derogated</w> by the subsequent signing of the emergency protocol.",
                            "target_lang_translations": {
                                "zh": "随后紧急议定书的签署对该条约进行了<w>减损</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（法律或协议等）部分废除、减损或偏离。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "部分废除",
                                "target_lang_sense_clarification": "使法规或条款的部分效力失效"
                            },
                            {
                                "target_lang_word": "减损",
                                "target_lang_sense_clarification": "在法律上对条约或权利作克减或削减"
                            },
                            {
                                "target_lang_word": "克减",
                                "target_lang_sense_clarification": "法律专业术语，指暂时背离或限制权利"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}