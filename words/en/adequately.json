        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c239882b-69ed-3390-aea9-8a51853fb03e",
                    "sense_definition": "In a way that is sufficient to satisfy a requirement or meet a specific need.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new safety measures <w>adequately</w> address the concerns raised by the staff during the meeting.",
                            "target_lang_translations": {
                                "ru": "Новые меры безопасности <w>адекватно</w> решают проблемы, поднятые сотрудниками во время собрания."
                            }
                        },
                        {
                            "text": "It is important to <w>adequately</w> prepare for the exam if you want to achieve a high grade.",
                            "target_lang_translations": {
                                "ru": "Важно <w>надлежащим образом</w> подготовиться к экзамену, если вы хотите получить высокий балл."
                            }
                        }
                    ],
                    "synonyms": [
                        "sufficiently",
                        "satisfactorily",
                        "appropriately"
                    ],
                    "antonyms": [
                        "inadequately",
                        "insufficiently",
                        "poorly"
                    ],
                    "common_phrases": [
                        "adequately prepare",
                        "adequately address",
                        "adequately fund",
                        "adequately explain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способом, достаточным для удовлетворения требований или нужд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адекватно",
                                "target_lang_sense_clarification": "соответствующим образом"
                            },
                            {
                                "target_lang_word": "надлежащим образом",
                                "target_lang_sense_clarification": "как того требуют правила или обстоятельства"
                            },
                            {
                                "target_lang_word": "достаточно",
                                "target_lang_sense_clarification": "в необходимой степени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fd20b90-0ab6-36f7-9efb-2c39e7b3e9d6",
                    "sense_definition": "In a manner that is only just enough or barely satisfactory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old heater performed <w>adequately</w> during the mild winter, but it struggled when the temperature dropped.",
                            "target_lang_translations": {
                                "ru": "Старый обогреватель работал <w>удовлетворительно</w> в мягкую зиму, но не справлялся, когда температура падала."
                            }
                        },
                        {
                            "text": "While the hotel was <w>adequately</w> clean, it certainly did not meet the luxury standards we expected.",
                            "target_lang_translations": {
                                "ru": "Хотя в отеле было <w>приемлемо</w> чисто, он определенно не соответствовал ожидаемым нами стандартам роскоши."
                            }
                        }
                    ],
                    "synonyms": [
                        "passably",
                        "tolerably"
                    ],
                    "antonyms": [
                        "excellently",
                        "perfectly"
                    ],
                    "common_phrases": [
                        "perform adequately",
                        "adequately clean"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способом, который является лишь минимально приемлемым или едва удовлетворительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворительно",
                                "target_lang_sense_clarification": "на среднем уровне, без излишеств"
                            },
                            {
                                "target_lang_word": "приемлемо",
                                "target_lang_sense_clarification": "сносно, но не отлично"
                            },
                            {
                                "target_lang_word": "посредственно",
                                "target_lang_sense_clarification": "не очень хорошо, на грани допустимого"
                            }
                        ]
                    }
                }
            ]
        }
    ]
