                        "glosses": [
                            "Espace séparant deux pôles du circuit magnétique d’un électro-aimant ou autre appareil électromagnétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55dc07d2-a315-4a48-847e-f9e0b6c63013",
                                "sense_id": "cccdcb56-7f70-3923-a952-44e2e41c8df1",
                                "text": "L’intensité du courant continu et du courant alternatif à laquelle, pour un entrefer donné, mais variable, obtenu par l’interposition de pièces non magnétiques, une armature de masse variable se détachait."
                            },
                            {
                                "example_id": "b9d6f4d0-88de-44b7-b6c4-212031bb0565",
                                "sense_id": "cccdcb56-7f70-3923-a952-44e2e41c8df1",
                                "text": "En effet, I_d crée un flux dans l’axe des aimants de la machine; il contribue donc à fluxer ou défluxer l’entrefer."
                            }
                        ]
                    }
                ],
