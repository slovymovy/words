                            {
                                "target_lang_word": "bizar",
                                "target_lang_sense_clarification": "zeer vreemd of ongewoon"
                            },
                            {
                                "target_lang_word": "absurd",
                                "target_lang_sense_clarification": "onlogisch of dwaas"
                            },
                            {
                                "target_lang_word": "grotesk",
                                "target_lang_sense_clarification": "buitenissig of vreemd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "101ab0e8-0de3-3ce2-b5dd-a60e2055a3eb",
                    "sense_definition": "To behave in a silly or playful way; to caper.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were <w>anticking</w> around the garden all afternoon.",
                            "target_lang_translations": {
                                "nl": "De kinderen waren de hele middag in de tuin <w>zot aan het doen</w>."
                            }
                        },
                        {
                            "text": "He began <w>anticking</w> on stage to distract the audience from his mistake.",
                            "target_lang_translations": {
                                "nl": "Hij begon op het podium <w>kuren uit te halen</w> om het publiek af te leiden van zijn fout."
                            }
                        }
                    ],
                    "synonyms": [
                        "caper",
                        "frolic"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich op een dwaze of speelse manier gedragen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kuren uithalen",
                                "target_lang_sense_clarification": "zich vreemd of ondeugend gedragen"
                            },
                            {
                                "target_lang_word": "zot doen",
                                "target_lang_sense_clarification": "zich speels en dwaas gedragen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
