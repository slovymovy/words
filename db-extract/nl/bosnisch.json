                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "592b3180-df6a-3b21-a98c-c047b6b1e1b1",
                                        "entry_id": "47efa43c-94f5-3369-a4f9-b222adb2ed05",
