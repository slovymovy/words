        "fr-extract.jsonl": [
            {
                "entry_id": "3b425790-c585-347c-9c8c-8e5573bb062d",
                "word": "trompe-la-mort",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ddb2c37-b9cd-3795-88f5-c0a1dba121e1",
                        "entry_id": "3b425790-c585-347c-9c8c-8e5573bb062d",
                        "glosses": [
                            "Personne que la mort semble épargner malgré un âge très avancé, une maladie grave ou de grands dangers."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f86ef0b3-c784-4484-bf9c-b689a5ffa0be",
                                "sense_id": "6ddb2c37-b9cd-3795-88f5-c0a1dba121e1",
                                "text": "On les appelait parfois les die hards, les trompe-la-mort. Sexagénaires ventripotents ou septuagénaires replets, ils se déguisaient pour ressembler aux jeunes gens qu’ils avaient été : canotiers de paille et vestes en madras, un peu risibles, attendrissants et encombrants."
                            }
                        ]
                    },
                    {
                        "sense_id": "2df2fe7c-cde3-3f6d-b597-275eb4f3ff5b",
                        "entry_id": "3b425790-c585-347c-9c8c-8e5573bb062d",
                        "glosses": [
                            "Personne qui accomplit des actes dangereux au risque de se tuer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc3c9ce-5075-449d-80b9-72880c354212",
                                "sense_id": "2df2fe7c-cde3-3f6d-b597-275eb4f3ff5b",
                                "text": "Tous les Trompe-la-mort fin ronds défoncés, titubant dans tous les coins de village depuis quatre jours. Une foiridon phénoménale !…"
                            },
                            {
                                "example_id": "0ddc97f8-9611-4f93-a60e-e6764bd12267",
                                "sense_id": "2df2fe7c-cde3-3f6d-b597-275eb4f3ff5b",
                                "text": "Pendant longtemps, les reporters de guerre ont été considérés comme des trompe-la-mort à l’expérience incommunicable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9853fdc4-8e97-4aef-918e-6bcd2371970d",
                        "source_entry_id": "3b425790-c585-347c-9c8c-8e5573bb062d",
                        "target_lang_word": "daredevil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daredevil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "224227a1-f0cd-391d-b9a1-40f59899d007",
                                        "entry_id": "a7af527f-12da-3dab-ade7-c5e19cf7ceb5",
                                        "glosses": [
                                            "A person who engages in very risky behavior, especially one who is motivated by a craving for excitement or attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31981f6e-993f-43a1-8cfc-b4839cdbfb55",
                                                "sense_id": "224227a1-f0cd-391d-b9a1-40f59899d007",
                                                "text": "Even as a youngster, Steven was a bit of a daredevil riding up homemade wooden ramps on his BMX."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daredevil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e6244e2-7d39-395c-aaa3-ce10c9288bda",
                                        "entry_id": "6905e1b4-760e-3b75-b576-1fd3dc6c812b",
                                        "glosses": [
                                            "Recklessly bold; adventurous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc7bc5e-6b2f-4bf6-902e-52105bdd8735",
                                                "sense_id": "7e6244e2-7d39-395c-aaa3-ce10c9288bda",
                                                "text": "The climactic scene of “Rebel without a Cause” is the group of very daredevil teens playing chicken."
                                            },
                                            {
                                                "example_id": "fad6068b-c564-4869-8051-e7d1f3cfd16b",
                                                "sense_id": "7e6244e2-7d39-395c-aaa3-ce10c9288bda",
                                                "text": "Not only do they glide gracefully with burdens on their heads, they bend to pick money that has been flung at them; dash across roads with cars zooming by and the most daredevil do all this with a child strapped to their back."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daredevil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27a556c9-c751-3d1e-acaa-f7752c4256a9",
                                        "entry_id": "4128c0da-7cde-39e6-9fb9-0307c9e0b95a",
                                        "glosses": [
                                            "To behave in a reckless, adventurous, or physically risky manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
