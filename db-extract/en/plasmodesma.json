                        "cross_references": [
                            {
                                "target_word": "plasmodesme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1111801-8e54-34ef-87f9-afad0618a985",
                                        "entry_id": "4b1c0416-b1fa-3b41-93b4-0d21edb490b4",
                                        "glosses": [
                                            "Canal très fin traversant la paroi végétale et bordé par la membrane plasmique, qui permet la circulation d’éléments divers entre les cytoplasmes de cellules voisines et, partant, dans l’ensemble de la plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "642164bb-5473-4c5d-9ed0-cef9d1ee5f05",
                                                "sense_id": "f1111801-8e54-34ef-87f9-afad0618a985",
                                                "text": "Les cellules sont connectées entre elles par un plasmodesme, minuscule canal de 20 à 40 nanomètres de diamètre qui traverse la paroi cellulaire et permet de connecter deux cellules voisines."
                                            },
                                            {
                                                "example_id": "e9a1eabc-bbac-4ee9-bb4f-5d6b6800f255",
                                                "sense_id": "f1111801-8e54-34ef-87f9-afad0618a985",
                                                "text": "Chez les plantes, la paroi cellulosique est interrompue par des pores, les plasmodesmes (de desmos = lien). À leur niveau, il y a continuité entre les cytoplasmes des deux cellules adjacentes ; ils autorisent les molécules à migrer plus facilement d’une cellule à l’autre chez les végétaux que chez les animaux."
                                            }
                                        ]
                                    }
                                ]
                            }
