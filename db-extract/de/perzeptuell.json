                ],
                "senses": [
                    {
                        "sense_id": "a56540dc-f958-39f7-8c1f-25c9398e8465",
                        "entry_id": "b08fe0f8-8988-38b7-a071-8a90450ed332",
                        "glosses": [
                            "auf Wahrnehmung beruhend, durch Wahrnehmung umgesetzt oder entstanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1083495d-1154-4f47-9356-16570042b681",
                                "sense_id": "a56540dc-f958-39f7-8c1f-25c9398e8465",
                                "text": "Das perzeptuelle Gedächtnis hilft dem Menschen, bekannte Personen, Orte und Gegenstände wiederzuerkennen."
                            },
                            {
                                "example_id": "522e173c-7f32-41c1-85c2-f33b5a62b047",
                                "sense_id": "a56540dc-f958-39f7-8c1f-25c9398e8465",
                                "text": "„Wie Studien zeigen, reagieren Weibchen auf das allererste Signal, das sie in einem vielstimmigen männlichen Balzkonzert wahrnehmen (in Fachkreisen wird das als »hervorspringende Wahrnehmung« oder perzeptuelle Salienz bezeichnet).“"
                            },
                            {
                                "example_id": "e7c43ead-0bb0-48cd-8c2a-d7c9fb7e1516",
                                "sense_id": "a56540dc-f958-39f7-8c1f-25c9398e8465",
                                "text": "„Auf der nächsten Stufe erfolgt die „perzeptuelle Organisation“ der Eindrücke, d.h. es erfolgt eine Synthese dieser ersten sensorischen Eindrücke wie Farben oder Töne zu einem Perzept eines Objektes, das später wiedererkannt werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
