                },
                {
                    "sense_id": "cda5a611-74ef-3112-9c4b-73c981610f8c",
                    "sense_definition": "op zichzelf staand, niet vergeleken met of afhankelijk van iets anders",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onafhankelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>absolute</w> bevolking van het dorp was laag vergeleken met de stad.",
                            "target_lang_translations": {
                                "en": "The <w>absolute</w> population of the village was low compared to the city."
                            }
                        },
                        {
                            "text": "In de natuurkunde spreekt men vaak over de <w>absolute</w> temperatuur in Kelvin.",
                            "target_lang_translations": {
                                "en": "In physics, one often speaks about the <w>absolute</w> temperature in Kelvin."
                            }
                        }
                    ],
                    "antonyms": [
