                        ]
                    },
                    {
                        "translation_id": "5ce3a927-51b9-4110-8bf2-fddb70e517d4",
                        "source_entry_id": "7de0df52-65e6-3260-9474-b3152919a796",
                        "source_sense_id": "5d4ee853-e94a-39f6-a18b-7221955921f7",
                        "source_sense_description": "country in Eastern Europe",
                        "target_lang_word": "Oekraïne",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oekraïne",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "272834dd-bcd2-370d-afab-197782c1ae43",
                                        "entry_id": "cc8fe0d3-9a16-33b2-b45b-b5882c56ffa2",
                                        "glosses": [
                                            "een land in Oost-Europa met als hoofdstad Kiev"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9aeb2f7-5f0c-4ec5-b0ae-e877ede6afcf",
                                                "sense_id": "272834dd-bcd2-370d-afab-197782c1ae43",
                                                "text": "Oekraïne is iets groter dan Frankrijk. Het is een gebied dat je niet zomaar kunt bezetten. „Zelfs de 190.000 militairen die nu zijn ingezet zijn onvoldoende om het land te controleren”, zegt Tim Sweijs, defensie-expert bij het The Hague Centre for Strategic Studies."
                                            },
                                            {
                                                "example_id": "f903251a-eaf0-40a3-a79a-58a060e6e9d3",
                                                "sense_id": "272834dd-bcd2-370d-afab-197782c1ae43",
                                                "text": "Westerse landen hebben de afgelopen maanden meer dan 330 miljard dollar aan bezittingen van rijke Russen en de Russische centrale bank bevroren. Dat is omgerekend zo'n 314 miljard euro. Reden hiervan is de de Russische inval in Oekraïne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a37d674-c485-4cf6-bea6-ef794cb078c5",
                        "source_entry_id": "7de0df52-65e6-3260-9474-b3152919a796",
                        "source_sense_id": "5d4ee853-e94a-39f6-a18b-7221955921f7",
                        "source_sense_description": "country in Eastern Europe",
                        "target_lang_word": "Ukraine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ukraine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08da47c0-dbcc-3bb1-a115-83498f390270",
                                        "entry_id": "de07e51d-0713-3b7c-804d-418520ef7fcf",
                                        "glosses": [
                                            "Pays d’Europe, entouré par la mer Noire au sud, la Russie à l’est, la Biélorussie au nord-ouest, la Pologne à l’ouest-nord-ouest, la Slovaquie, la Hongrie et la Roumanie à l’ouest et la Moldavie au sud-ouest. Sa capitale est Kyiv."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "968671c2-bda9-488e-ba02-ff9a3dcae64c",
                                                "sense_id": "08da47c0-dbcc-3bb1-a115-83498f390270",
                                                "text": "Il termina son petit exposé en m’apprenant la récente formation, en Ukraine, sous les auspices de l’Angleterre et de la France, de légions tchécoslovaques, destinées à seconder les efforts de l’Entente et à lutter contre les bolchevicks."
                                            },
                                            {
                                                "example_id": "fd69f787-378d-4154-a467-b489ddbd6dbe",
                                                "sense_id": "08da47c0-dbcc-3bb1-a115-83498f390270",
                                                "text": "Après une révolution qui n’a pas tenu ses promesses en 2014 et le redécoupage de ses frontières, l’Ukraine est à un tournant de son histoire."
                                            },
                                            {
                                                "example_id": "36e2fef8-c2e3-41e2-90f1-cd3a16feea21",
                                                "sense_id": "08da47c0-dbcc-3bb1-a115-83498f390270",
                                                "text": "Poignée de main entre Recep Tayyip Erdogan et Volodymyr Zelensky, le 18 août à Lviv (Ukraine)."
                                            },
                                            {
                                                "example_id": "e1f16cb9-1403-4ef9-941d-7f4317dbe008",
                                                "sense_id": "08da47c0-dbcc-3bb1-a115-83498f390270",
                                                "text": "Je n’ai plus ni bonheur ni liberté\nUne seule espérance m’est restée :\nRevenir un jour dans ma belle Ukraine,\nRevoir une fois ma terre lointaine,\nContempler encore le Dniepr si bleu\n— Y vivre ou mourir importe bien peu —,\nRevoir une fois les tertres, les plaines,\nEt brûler au feu des pensées anciennes…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1de7e37-f4c4-47f3-a4a8-0d0f023d6ad7",
                        "source_entry_id": "7de0df52-65e6-3260-9474-b3152919a796",
                        "source_sense_id": "5d4ee853-e94a-39f6-a18b-7221955921f7",
                        "source_sense_description": "country in Eastern Europe",
                        "target_lang_word": "Ukraine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ukraine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                        "entry_id": "0d2cc581-17d7-35d2-94bb-b9b44ac1bd0e",
                                        "glosses": [
                                            "ein seit 1991 unabhängiger Staat in Osteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544fec27-ffde-4a79-9fe4-82cfa86bbd1d",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "Die Ukraine ist berühmt für die Herzlichkeit ihrer Menschen."
                                            },
                                            {
                                                "example_id": "9f68d193-b668-4b61-95d4-08a52378b81d",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "Kiew ist die Hauptstadt der Ukraine."
                                            },
                                            {
                                                "example_id": "b176a1a2-e0ee-41aa-b52c-fd1a3e7aeac7",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "„Die Hubschrauberpilotin wurde weit über die Grenzen der Ukraine hinaus bekannt, als sie auf dem Höhepunkt des Krieges in der Ostukraine im Sommer 2014 von prorussischen Separatisten gefangen genommen und nach Russland entführt wurde.“"
                                            },
                                            {
                                                "example_id": "b7bac3ab-dc7f-4821-aa8f-00814924f561",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "„Russland attackiert die Ukraine - dabei geht es im Kern darum, dass Moskau die Unabhängigkeit Kiews nicht akzeptiert.“"
                                            },
                                            {
                                                "example_id": "38246f76-42b8-4862-90d5-666c2322bc77",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "„Russland hat im Krieg gegen die Ukraine hohe Verluste erlitten.“"
                                            },
                                            {
                                                "example_id": "60f28b07-eb2e-4f87-b197-e3a9e9aa868a",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "„Die Ukraine ist fast das korrupteste Land Europas. Zumindest nach dem Korruptionsindex von Transparency International. Dort belegt sie Platz 122 von 180.“"
                                            },
                                            {
                                                "example_id": "d38836f3-75e4-4c7f-ab0f-591ec32ab980",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "„Im 17. Jahrhundert wurden große Gebiete der heutigen Ukraine Teil des russischen Imperiums.“"
                                            },
                                            {
                                                "example_id": "8c4f7717-789d-4361-9a2f-16847f981e0a",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "„Im Dezember 1991 gehörte die Ukraine zusammen mit Russland und Belarus zu den drei Schwesterrepubliken, die die Auflösung der Sowjetunion besiegelten.“"
                                            },
                                            {
                                                "example_id": "d118b41d-992d-47f5-b2d1-761499f3fb09",
                                                "sense_id": "6da800ab-e7bb-3df8-907f-f8e505a23976",
                                                "text": "„Im Jahr 1997 erkannte Moskau mit der Unterzeichnung des sogenannten \"Großen Vertrags\" die Grenzen der Ukraine an, inklusive der mehrheitlich von ethnischen Russen bewohnten Halbinsel Krim.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "854a3724-e54d-4b52-bd78-e624ce0bd74f",
