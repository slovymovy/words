                    {
                        "translation_id": "754cc477-ac20-4179-bfd1-3db1331e85e2",
                        "source_entry_id": "e3a1bb28-2569-30d5-b544-feffa99727bf",
                        "source_sense_id": "d19c2ce7-f53c-344f-9d61-392f4007b075",
