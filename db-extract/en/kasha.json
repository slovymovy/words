                                        "entry_id": "c071028e-824e-3ab0-9043-02e692d5e8a2",
                                        "glosses": [
                                            "spreparowane ziarna zbóż (np. gryki, jęczmienia) przygotowane do gotowania"
                                        ],
                                        "tags": [],
