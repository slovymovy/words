                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "198e14d5-ce38-36aa-807b-8c417f85886e",
                                        "entry_id": "ca49a1c8-c82c-3c9d-a018-1da2da99d2a4",
                                        "glosses": [
                                            "To bring disgrace upon someone or something; to shame."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Ireland",
                                            "New-Zealand",
                                            "South-Africa",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470ef276-3273-4bac-9b0e-470bf2bc2502",
                                                "sense_id": "198e14d5-ce38-36aa-807b-8c417f85886e",
                                                "text": "You have dishonoured the family."
                                            },
                                            {
                                                "example_id": "c2f9b31b-cf89-4cb0-9b80-e685a0a3e2b7",
                                                "sense_id": "198e14d5-ce38-36aa-807b-8c417f85886e",
                                                "text": "Still, in the very fullest blaze of gospel light, while we see that both Christ and His work are most ungratefully and flagrantly dishonoured, by our persistings in the attempt to do for ourselves what He has told us we cannot do, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f59757a1-a4ff-3484-847c-55a398bae476",
                                        "entry_id": "ca49a1c8-c82c-3c9d-a018-1da2da99d2a4",
                                        "glosses": [
                                            "To refuse to accept something, such as a cheque; to not honor."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Ireland",
                                            "New-Zealand",
                                            "South-Africa",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8989a903-2588-4ec2-853e-a134e1b58c49",
                                                "sense_id": "f59757a1-a4ff-3484-847c-55a398bae476",
                                                "text": "disworshipping and dishonouring God"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d38d177e-0b49-3a2b-9975-534438117263",
                                        "entry_id": "ca49a1c8-c82c-3c9d-a018-1da2da99d2a4",
                                        "glosses": [
                                            "To violate or rape."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "Ireland",
                                            "New-Zealand",
                                            "South-Africa",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9a6e7e3-1945-48ed-8440-d9b0dec05695",
                                                "sense_id": "d38d177e-0b49-3a2b-9975-534438117263",
                                                "text": "“My men, the schooner coming up on our weather quarter is a Portuguese pirate. His character is known; he scuttles all the ships he boards, dishonours the women, and murders the crew.”"
                                            }
                                        ]
