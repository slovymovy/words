                    "frequency": "Middle",
                    "semantic_group_id": "overgang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe regisseur zorgde voor een <w>naadloze</w> overgang tussen de verschillende scènes.",
