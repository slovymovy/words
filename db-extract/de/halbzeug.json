                        "source_sense_description": "Produktion: zum Zeitpunkt der Inventur noch nicht vollständig fertiggestellte Produktionsstücke",
                        "target_lang_word": "work in progress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "work in progress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a63b1f-90f9-33d2-9787-1fa9b424a4ad",
                                        "entry_id": "44794dee-1ed7-3afb-a3c7-89385ad43a5d",
                                        "glosses": [
                                            "Work that has been started, but is not complete."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4cbcaa-c06a-44be-b1cc-c9be65dc704f",
                                                "sense_id": "c3a63b1f-90f9-33d2-9787-1fa9b424a4ad",
                                                "text": "All the efforts to make a New Man are still work in progress."
                                            },
                                            {
                                                "example_id": "da66c171-5555-4283-9ce6-b226120cb856",
                                                "sense_id": "c3a63b1f-90f9-33d2-9787-1fa9b424a4ad",
                                                "text": "A group of seven close friends and lovers happened to be gay and writers with books either recently published or about to be published, and who lived in Manhattan, decided it might be fun and useful to have get-togethers to read work-in-progress to each other for feedback."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da095b7d-8aca-34d7-94ff-69f0b5de4e20",
                                        "entry_id": "44794dee-1ed7-3afb-a3c7-89385ad43a5d",
                                        "glosses": [
                                            "A project that has been started but is not complete."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce794324-9a41-401c-ac74-b05baa547693",
                                                "sense_id": "da095b7d-8aca-34d7-94ff-69f0b5de4e20",
                                                "text": "Reorganizing my office is a work in progress."
                                            },
                                            {
                                                "example_id": "2278a8b2-5174-4325-946b-381604096c08",
                                                "sense_id": "da095b7d-8aca-34d7-94ff-69f0b5de4e20",
                                                "text": "Refurbishing Okehampton station, kept basically sound under ownership by Devon Council, remains a work in progress and scheduled for completion next spring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82794318-1eb1-3dc8-8633-04bcd9d1e6bd",
                                        "entry_id": "44794dee-1ed7-3afb-a3c7-89385ad43a5d",
                                        "glosses": [
                                            "Something that is in the process of improving."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "827a72ac-19d2-4a02-9ca5-12316ea3d0a1",
                                                "sense_id": "82794318-1eb1-3dc8-8633-04bcd9d1e6bd",
                                                "text": "They remain a work in progress but in a match many felt would see the new Arsenal's flaws exposed, Emery and his players can regard this as a highly satisfactory result and performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6167dad-ff70-39cd-a9ba-cc9e59367f75",
                                        "entry_id": "44794dee-1ed7-3afb-a3c7-89385ad43a5d",
                                        "glosses": [
                                            "A portion of inventory that represents goods which are no longer salable as raw materials, but not yet salable as finished goods, work in process."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8961138c-72b2-4dd4-8c20-5559449fa1ed",
                                                "sense_id": "c6167dad-ff70-39cd-a9ba-cc9e59367f75",
                                                "text": "Work in progress has dramatically declined due to reduced production cycle times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
