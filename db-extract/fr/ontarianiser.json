                "senses": [
                    {
                        "sense_id": "bcfa3660-2d4e-38f4-bd1d-5067ed11d81c",
                        "entry_id": "af7568ef-9088-3a97-9e31-11a6db5d3e66",
                        "glosses": [
                            "Donner un caractère ontarien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbb01f6-f204-4d29-ba28-dd3712a63af5",
                                "sense_id": "bcfa3660-2d4e-38f4-bd1d-5067ed11d81c",
                                "text": "Ces réformes eurent pour effet d’ontarianiser la minorité canadienne-française dont le sort se joue de plus en plus dans le cadre provincial."
                            },
                            {
                                "example_id": "028509cd-54f8-49e6-8c20-b15c410e28e5",
                                "sense_id": "bcfa3660-2d4e-38f4-bd1d-5067ed11d81c",
                                "text": "Ce sont des familles qui risquent de \"s’ontarianiser\"."
                            },
                            {
                                "example_id": "e820e0b1-0a0a-4940-929c-3733b881cfe0",
                                "sense_id": "bcfa3660-2d4e-38f4-bd1d-5067ed11d81c",
                                "text": "Elle en ajoute même lorsqu’elle écrit ci-dessous que sa décision de déquébéciser en ontarionisant l’Outaouais est « le prolongement d’une stratégie (d’anglicisation) de marque qui inspire confiance (parce qu’en anglais! ou parce qu’ontarien!) et notre intention d’ouvrir des magasins qui sont accessibles et commodes…(avec des noms anglais) pour une clientèle (québécoise)…»!!!"
                            }
                        ]
                    }
                ],
