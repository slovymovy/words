                "senses": [
                    {
                        "sense_id": "374a8ab9-3b0c-3cd6-95fd-6cf160ea4ac5",
                        "entry_id": "f853a0bb-61ad-3b28-91de-bfb89645bf2e",
                        "glosses": [
                            "One who comprehends."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e5134bc-8514-4747-a095-f06d4e1e723d",
                                "sense_id": "374a8ab9-3b0c-3cd6-95fd-6cf160ea4ac5",
                                "text": "Less-skilled comprehenders do not know when it is appropriate to draw inferences."
                            },
                            {
                                "example_id": "37b75a6c-36d3-4428-804a-40db1b592f93",
                                "sense_id": "374a8ab9-3b0c-3cd6-95fd-6cf160ea4ac5",
                                "text": "This mental representation provides the comprehender with a general plan according to which he can organize, interrelate and memorize the incoming information."
                            },
                            {
                                "example_id": "1ca48aeb-37e5-4ebe-a8fa-6f7a91405bd3",
                                "sense_id": "374a8ab9-3b0c-3cd6-95fd-6cf160ea4ac5",
                                "text": "There is no seer beside him, no hearer beside him, no comprehender beside him, no knower beside him."
                            }
                        ]
                    }
                ],
