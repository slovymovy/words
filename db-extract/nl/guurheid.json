                                    },
                                    {
                                        "sense_id": "5a3a46af-1f87-3f4a-bc5c-20830ddf6878",
                                        "entry_id": "dba222ed-e8b7-318c-b3ad-f121625ca808",
                                        "glosses": [
                                            "A measure of how rough something is, such as a surface"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
