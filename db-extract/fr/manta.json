            {
                "entry_id": "ca68689f-a20c-37d2-9a56-652b34cbde28",
                "word": "Manta",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f36d913d-8e56-3a73-b7ff-aed4ad65cca8",
                        "entry_id": "ca68689f-a20c-37d2-9a56-652b34cbde28",
                        "glosses": [
                            "Nom donné par la marque automobile Opel à deux modèles successifs de coupés sportifs, produits de 1970 à 1988."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "6bb71b2f-0472-405f-b671-98edcbfb81aa",
                                "sense_id": "f36d913d-8e56-3a73-b7ff-aed4ad65cca8",
                                "text": "Restylée en 1982, la Manta B poursuit sa carrière jusqu’en 1988, avant d’être remplacée par la spectaculaire Calibra."
                            },
                            {
                                "example_id": "936d316a-1dc5-4e12-8193-7e9f56e5ae41",
                                "sense_id": "f36d913d-8e56-3a73-b7ff-aed4ad65cca8",
                                "text": "La Manta allie le côté sportif avec une ligne racée avec l’habitacle d’une berline, car une petite famille peut prendre place à son bord, la Manta s’offrait aux jeunes pères de famille qui souhaitaient conserver une voiture atypique."
                            },
                            {
                                "example_id": "61d8a1ff-979c-499f-a0d5-461466b92185",
                                "sense_id": "f36d913d-8e56-3a73-b7ff-aed4ad65cca8",
                                "text": "Cette belle Manta représente une belle époque où le constructeur au «Blitz» nous proposait des propulsions intéressantes, fiables et assez performantes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
