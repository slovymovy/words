                                    {
                                        "sense_id": "964fedea-3660-3ec5-a6c7-d700c334ed92",
                                        "entry_id": "c5c0b6f6-2b28-3e14-a5aa-b01bbeaf2050",
                                        "glosses": [
                                            "Prénom russe, équivalent de Dimitri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c17a991-1799-4bc7-b794-917f99de7a82",
                                                "sense_id": "964fedea-3660-3ec5-a6c7-d700c334ed92",
                                                "text": "« Nous savons que la cérémonie principale sera le 3 septembre, ainsi que les funérailles, mais l’emploi du temps du président ne lui permettra pas d’être là », a déclaré le porte-parole de la présidence russe, Dmitri Peskov."
                                            },
                                            {
                                                "example_id": "87292397-1c36-4dde-b009-3ce2422899e1",
                                                "sense_id": "964fedea-3660-3ec5-a6c7-d700c334ed92",
                                                "text": "Evguéni Prigojine est présumé mort après le crash mercredi soir d’un avion qui le transportait de Moscou à Saint-Pétersbourg aux côtés de son bras droit Dmitri Outkine et d’autres responsables de Wagner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b41f5fce-376e-456d-8f16-8889e5ac0f2b",
                        "source_entry_id": "3001c53b-9b3c-3296-a859-9e0fd8364e02",
                        "source_sense_id": "91fc7276-13e9-30fd-b0ac-11f5422f3435",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Demetrius",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demetrius",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02018875-3418-3a57-836e-0714ee056f65",
                                        "entry_id": "fd13a51c-bc3d-3d5e-9a00-bc4c122cd577",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01a2f81-0ead-43d0-9cfa-6a84480438dc",
                                                "sense_id": "02018875-3418-3a57-836e-0714ee056f65",
                                                "text": "Demetrius hath good report of all men, and of the trueth it ſelfe: yea, and we alſo beare record, and ye know that our record is true."
                                            },
                                            {
                                                "example_id": "95b3dbd2-685d-4b98-a7f8-5dd71c5e0079",
                                                "sense_id": "02018875-3418-3a57-836e-0714ee056f65",
                                                "text": "The easy names were the ones she forgot. But this one wasn't easy and it was like the swaggering name of some football player from Alabama and that's how she remembered it, Demetrius, badly burned in the other tower, the south tower."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
