                "word": "WADA",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14aeacb8-f58e-3323-a003-966157e9ce32",
                        "entry_id": "6bc091ce-2f44-3361-a8be-43d358f0d00e",
                        "glosses": [
                            "Acronym of World Anti-Doping Agency"
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d1b08208-efa9-4ef3-a71e-bb74cb3b1e31",
                                "sense_id": "14aeacb8-f58e-3323-a003-966157e9ce32",
                                "text": "Mr. Tygart, who came to prominence for successfully pursuing doping cases against the track star Marion Jones and the cyclist Lance Armstrong, has long contended that WADA is insufficiently dedicated to holding dopers and their enablers to account."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88255992-5df5-4159-b10e-970046362922",
                        "source_entry_id": "6bc091ce-2f44-3361-a8be-43d358f0d00e",
                        "source_sense_id": "14aeacb8-f58e-3323-a003-966157e9ce32",
                        "source_sense_description": "Translations",
                        "target_lang_word": "AMA",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "AMA",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d68d4d-1ad9-38f3-90f4-a7112054e874",
                                        "entry_id": "814c7009-710c-34e7-873a-22fe0c80f9df",
                                        "glosses": [
                                            "Récompense américaine du monde de la musique."
                                        ],
                                        "tags": [
                                            "Distinction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbe94cff-651b-4bd8-b6d1-68c5fca911f6",
                                                "sense_id": "a9d68d4d-1ad9-38f3-90f4-a7112054e874",
                                                "text": "Pour info, les AMA sont décernés sur base d’une étude des acheteurs de musique, alors que les Grammys se basent sur les votes de membres de l’industrie de la musique."
                                            },
                                            {
                                                "example_id": "4afdb5e0-3c28-44a1-97c0-3d279c6fd5b1",
                                                "sense_id": "a9d68d4d-1ad9-38f3-90f4-a7112054e874",
                                                "text": "Après avoir été intronisé au Rock & Roll Hall of Fame, voilà que Lionel Richie recevra un Icon Award, le 18ᵉ de sa carrière - un record -, lors des American Music Awards (AMA), lundi."
                                            },
                                            {
                                                "example_id": "dcd8d0fc-d2d9-422f-864f-d73265451343",
                                                "sense_id": "a9d68d4d-1ad9-38f3-90f4-a7112054e874",
                                                "text": "Mais le concurrent de cette cérémonie, les AMA, leur décerne trois précieux prix dont celui de tournée de l’année."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
