                                        "entry_id": "40381ed0-531e-3aa4-8b2f-8187aea093a5",
                                        "glosses": [
                                            "A primitive, savage or uncivilized person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
