                "senses": [
                    {
                        "sense_id": "53cdd4aa-d534-32fb-86e0-62104154d105",
                        "entry_id": "22f843e3-48d4-361c-85fa-3f37a569ba33",
                        "glosses": [
                            "Ronde russe, réservée aux jeunes filles, pratiquée traditionnellement de Pâques à fin juillet, sur une musique lente à quatre temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b465da07-41bd-4af4-8c3c-0a533f842517",
                                "sense_id": "53cdd4aa-d534-32fb-86e0-62104154d105",
                                "text": "Ce sont de petites légendes, des ballades recueillies dans la bouche des femmes et le plus souvent chantées dans les danses du chorovod, cette farandole gigantesque qui, comme le \"kolo\" serbe, entraîne dans ses replis harmonieux la population féminine d’un village tout entier."
                            },
                            {
                                "example_id": "6b25d365-2ebf-4d86-9821-b50f0b3180df",
                                "sense_id": "53cdd4aa-d534-32fb-86e0-62104154d105",
                                "text": "Le cosaque de la garde faisant danser aux jeunes filles le chorovod, danse orbiculaire; …"
                            }
                        ]
                    }
                ],
