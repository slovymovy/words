                "senses": [
                    {
                        "sense_id": "82a0634a-6346-3767-b520-c7971e94454c",
                        "entry_id": "1af2b3fb-67d9-32d3-b912-8efb26338fbe",
                        "glosses": [
                            "Habitant ou originaire de la Campanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63536ded-3f02-4b00-bcac-7618add56302",
                                "sense_id": "82a0634a-6346-3767-b520-c7971e94454c",
                                "text": "Un Grec valait plus qu’un Campanien, celui-ci plus qu’un Gaulois ou un Espagnol."
                            },
                            {
                                "example_id": "faed0ad5-dbdd-4586-a9b7-3945b96aed83",
                                "sense_id": "82a0634a-6346-3767-b520-c7971e94454c",
                                "text": "Car, dès que les Campaniens eurent offert aux Romains, comme indemnité, le domaine de la Campanie, le sénat les prit sous sa protection, & ordonna aux Samnites de se retirer."
                            }
                        ]
                    }
                ],
