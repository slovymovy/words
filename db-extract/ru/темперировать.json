                                        "sense_id": "45451084-b81b-39d3-8ecd-bd11ee646a72",
                                        "entry_id": "31cabc18-1f77-39e7-af6e-15f69db54412",
                                        "glosses": [
                                            "die Temperatur von etwas so verändern, wie sie gewünscht wird/wie sie als angenehm/passend empfunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0b9212-7a70-4f2d-8467-c2a51485bef7",
                                                "sense_id": "45451084-b81b-39d3-8ecd-bd11ee646a72",
                                                "text": "Guten Wein sollte man wohl temperieren, bevor man ihn gustiert."
                                            },
                                            {
                                                "example_id": "ddb0b48b-2f6f-45de-945a-618438aed600",
                                                "sense_id": "45451084-b81b-39d3-8ecd-bd11ee646a72",
                                                "text": "Temperieren Sie die Konzentration anschließend auf 25 Grad Celsius."
                                            },
                                            {
                                                "example_id": "46e7a43c-e0c6-4c08-bb37-1f763f557d85",
                                                "sense_id": "45451084-b81b-39d3-8ecd-bd11ee646a72",
                                                "text": "„Die Krankenschwester war schon länger wach, stellte in der sogenannten Gästeküche die Heizstrahler auf die höchste Stufe, um bei dieser Kälte die Räume zumindest ein bißchen zu temperieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c7acac6-63db-3d8b-bcd3-2c29a6ae0bbb",
                                        "entry_id": "31cabc18-1f77-39e7-af6e-15f69db54412",
                                        "glosses": [
                                            "Gefühle, Emotionen oder Ähnliches bändigen"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11d99dea-bbbc-4bf4-89ec-3ea0eda6bae3",
                                                "sense_id": "1c7acac6-63db-3d8b-bcd3-2c29a6ae0bbb",
                                                "text": "„Aber nun temperierte man das System, und das System temperierte den heißen Drang zum Suchen. Man hatte einen Waffenstillstand geschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5cf7e57d-e623-35be-b767-39abbf120a41",
                                        "entry_id": "31cabc18-1f77-39e7-af6e-15f69db54412",
                                        "glosses": [
                                            "in einem Stimmungssystem einige Intervalle so stimmen, dass sie von ihrer akustischen Reinheit geringfügig abweichen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7334c6b-22f6-473d-83de-3d8918f81d01",
                                                "sense_id": "5cf7e57d-e623-35be-b767-39abbf120a41",
                                                "text": "Beim Stimmen des Klaviers beginnt man mit einer Oktave, um das Klangbild wohl zu temperieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
