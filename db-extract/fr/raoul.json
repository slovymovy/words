                    },
                    {
                        "translation_id": "1058bee6-a3f6-4c95-b67d-4ddb47696032",
                        "source_entry_id": "d4acc6eb-c2b8-32c1-8e22-ead7517a7d4d",
                        "source_sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                        "source_sense_description": "prénom",
                        "target_lang_word": "Ralph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ralph",
