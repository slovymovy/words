                                "sense_id": "708deb9c-b8da-3164-8f43-c981133775a4",
                                "text": "A low exclamation of horror escaped from Nancy Dampier’s lips. She turned ashily pale."
                            },
                            {
                                "example_id": "8bf8d7dd-c036-477a-a090-9c331a709494",
                                "sense_id": "708deb9c-b8da-3164-8f43-c981133775a4",
                                "text": "A man was standing on top of the bluff, ashily silhouetted against the night sky."
                            }
