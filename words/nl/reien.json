                    "sense_id": "33c15ced-b813-392f-96e2-620b6592191f",
                    "sense_definition": "een rondedans uitvoeren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dorpsbewoners bleven vrolijk <w>reien</w> rond het kampvuur.",
                            "target_lang_translations": {
                                "fr": "Les villageois ont continué à <w>danser en ronde</w> joyeusement autour du feu de camp."
                            }
                        },
                        {
                            "text": "Zij hielden elkaars hand vast om vrolijk te <w>reien</w>.",
                            "target_lang_translations": {
                                "fr": "Ils se tenaient la main pour <w>danser en ronde</w> avec joie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vrolijk reien"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary/historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Exécuter une ronde ou une danse en cercle"
                    },
                    "translations": {
