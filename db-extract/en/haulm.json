                    {
                        "translation_id": "3894d6ec-661c-4d82-928b-9d09deb0230b",
                        "source_entry_id": "9807d42d-b13f-3a96-b626-63c6672fb689",
                        "source_sense_description": "an individual plant stem",
                        "target_lang_word": "Halm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7eb7b04-bb7f-3e8f-95ca-b0dde526f871",
                                        "entry_id": "dabaa8f0-709d-389d-9a2d-dec41bd5df79",
                                        "glosses": [
                                            "biegsame (hohler) Sprossachse von Gräsern oder Getreide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00d413d-6a04-4770-ab6e-73aac9e17e4f",
                                                "sense_id": "c7eb7b04-bb7f-3e8f-95ca-b0dde526f871",
                                                "text": "„Ein grauer Stein fiel aus der Luft herab. Hierauf erhob sich Wogen der Halme und wildes Rascheln dort, wo er eingeschlagen. Als ob ein kleiner Wirbelwind an jener Stelle entstehe, sträubten sich die Ähren.“"
                                            },
                                            {
                                                "example_id": "90f32642-dfee-442d-b878-378797731df6",
                                                "sense_id": "c7eb7b04-bb7f-3e8f-95ca-b0dde526f871",
                                                "text": "„Die kurzen Halme moderner Weizensorten können schwere Ähren tragen.“"
                                            },
                                            {
                                                "example_id": "144a33e4-f0b8-4397-9dbe-6ecafbb6b273",
                                                "sense_id": "c7eb7b04-bb7f-3e8f-95ca-b0dde526f871",
                                                "text": "„Die Halme pikten im Nacken, doch es roch wunderbar.“"
                                            },
                                            {
                                                "example_id": "b818d86f-6636-4399-8cf4-2681643bdcda",
                                                "sense_id": "c7eb7b04-bb7f-3e8f-95ca-b0dde526f871",
                                                "text": "„Am Ufer stoßen Halme durch die Wasseroberfläche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
