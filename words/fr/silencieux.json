{
    "word_family": [
        "silence",
        "silencieusement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34ab3730-9960-3798-b359-4fd7d2ebaf63",
                    "sense_definition": "Qui ne produit pas de bruit ou n'en produit que très peu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau lave-linge est particulièrement <w>silencieux</w> pendant la nuit."
                        },
                        {
                            "text": "La chouette effectue un vol <w>silencieux</w> pour surprendre ses proies."
                        }
                    ],
                    "synonyms": [
                        "calme",
                        "tranquille"
                    ],
                    "antonyms": [
                        "bruyant"
                    ],
                    "common_phrases": [
                        "moteur silencieux",
                        "vol silencieux"
                    ]
                },
                {
                    "sense_id": "d3d07cee-7481-31dd-9a8d-a268ec5d7623",
                    "sense_definition": "Qui s'abstient de parler, qui garde temporairement le silence.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves sont restés <w>silencieux</w> dès que le professeur est entré dans la classe."
                        },
                        {
                            "text": "Elle est devenue soudainement <w>silencieuse</w> après avoir appris la mauvaise nouvelle."
                        }
                    ],
                    "synonyms": [
                        "calme"
                    ],
                    "antonyms": [
                        "bavard"
                    ],
                    "common_phrases": [
                        "rester silencieux",
                        "demeurer silencieux"
                    ]
                },
                {
                    "sense_id": "f6cfbe58-1a50-36c1-8d27-17e4c07226c3",
                    "sense_definition": "Qualifie un lieu calme, où règne le silence et où l'on n'entend aucun bruit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous promenions dans une rue <w>silencieuse</w> du vieux village."
                        },
                        {
                            "text": "La bibliothèque était complètement <w>silencieuse</w> à cette heure matinale."
                        }
                    ],
                    "synonyms": [
                        "calme",
                        "tranquille"
                    ],
                    "antonyms": [
                        "bruyant"
                    ],
                    "common_phrases": [
                        "rue silencieuse",
                        "nuit silencieuse"
                    ]
                },
                {
                    "sense_id": "b5d9d3b6-64d9-3c38-84df-4819800e2032",
                    "sense_definition": "Qualifie une personne réservée qui a l'habitude de parler peu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractère",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un collègue très <w>silencieux</w> qui préfère écouter attentivement les autres."
                        },
                        {
                            "text": "Sa nature timide et <w>silencieuse</w> la rend parfois difficile à cerner."
                        }
                    ],
                    "synonyms": [
                        "taciturne",
                        "taiseux"
                    ],
                    "antonyms": [
                        "bavard",
                        "loquace"
                    ],
                    "common_phrases": [
                        "homme silencieux"
                    ]
                },
                {
                    "sense_id": "84909b52-e063-3a3d-a58e-b9887c5440d1",
                    "sense_definition": "Qui est exprimé sans paroles ni cris, de manière contenue ou intime.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il manifestait son profond mécontentement par une colère <w>silencieuse</w>."
                        },
                        {
                            "text": "Elle lui a adressé un regard chargé d'un reproche <w>silencieux</w>."
                        }
                    ],
                    "common_phrases": [
                        "colère silencieuse",
                        "reproche silencieux"
                    ]
                },
                {
                    "sense_id": "7b63571b-ce27-3ee4-985e-6079e4592278",
                    "sense_definition": "Qui agit, évolue ou progresse sans attirer l'attention ou sans qu'on en parle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imperceptible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hypertension est souvent désignée comme un tueur <w>silencieux</w> par les spécialistes."
                        },
                        {
                            "text": "Cette crise financière entraîne une dégradation <w>silencieuse</w> du niveau de vie."
                        }
                    ],
                    "common_phrases": [
                        "tueur silencieux",
                        "maladie silencieuse"
                    ]
                }
            ]
        },
        {
