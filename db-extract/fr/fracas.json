        "fr-extract.jsonl": [
            {
                "entry_id": "c30a87bb-5cc5-3259-baca-1b362206c410",
                "word": "fracas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf72a0f1-01e9-3048-94a4-bd8060310d05",
                        "entry_id": "c30a87bb-5cc5-3259-baca-1b362206c410",
                        "glosses": [
                            "Bruit semblable à celui d’une chose qui se brise en éclats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad63f8be-2190-4335-81fb-c6680bfd4bc6",
                                "sense_id": "cf72a0f1-01e9-3048-94a4-bd8060310d05",
                                "text": "La rupture des glaces s'opérait avec un fracas extraordinaire, comparable parfois à des décharges d'artillerie."
                            },
                            {
                                "example_id": "fb3f9197-51ab-4c1b-8a3f-8b08526d4a7f",
                                "sense_id": "cf72a0f1-01e9-3048-94a4-bd8060310d05",
                                "text": "Enfin l’arbre tomba avec un horrible fracas et s’ouvrit dans toute sa longueur, […]."
                            },
                            {
                                "example_id": "410222bb-ff5c-4641-80bd-98b069e8ba21",
                                "sense_id": "cf72a0f1-01e9-3048-94a4-bd8060310d05",
                                "text": "Bitche n'est plus qu'une vaste fournaise : le sifflement des obus, les craquements de l'incendie, l'effondrement des maisons, […], toutes les terreurs, tous les fracas emplissent l'air."
                            },
                            {
                                "example_id": "93c1b78f-c0d1-4a89-bf3f-489feeeec16a",
                                "sense_id": "cf72a0f1-01e9-3048-94a4-bd8060310d05",
                                "text": "Un fracas effroyable, accompagné d'une éruption de poussière et de fumée, annonça qu'une des autres façades venait de s’effondrer, […]."
                            },
                            {
                                "example_id": "5562c0ce-3854-4b20-a107-4f3fbe54c830",
                                "sense_id": "cf72a0f1-01e9-3048-94a4-bd8060310d05",
                                "text": "Le châssis grinça encore, puis, dans un crissement horripilant, le levier joua et la roue trembla et retomba dans l'eau dans un fracas tonitruant."
                            }
                        ]
                    },
                    {
                        "sense_id": "323d0273-d0d6-3c78-9f1d-88bd05e5e48c",
                        "entry_id": "c30a87bb-5cc5-3259-baca-1b362206c410",
                        "glosses": [
                            "Tout ce qui se fait avec tumulte, avec désordre et grand bruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9b32277-3165-4a0a-abdf-42dbe0455bad",
                                "sense_id": "323d0273-d0d6-3c78-9f1d-88bd05e5e48c",
                                "text": "Le fracas de l'orchestre leur arrivait, assourdissant. Par instants, les violons dominaient le vacarme qu'ils semblaient apaiser, caresser, contenir, mais le saxo, le piston, la clarinette et surtout la trompette […] se mettaient ensemble à mugir et à pétarader de telle sorte que personne ne parlait plus."
                            },
                            {
                                "example_id": "bafc3c9a-e073-40e8-8ad8-bae5e3fce804",
                                "sense_id": "323d0273-d0d6-3c78-9f1d-88bd05e5e48c",
                                "text": "Au fracas grinçant des roues, se devinait le cheminement des camions."
                            },
                            {
                                "example_id": "8d52fda3-6e6d-4224-bad5-7bf1cffc8297",
                                "sense_id": "323d0273-d0d6-3c78-9f1d-88bd05e5e48c",
                                "text": "Les Belges tenaient un rang très-distingué parmi les Gaulois, […]. Ceux-ci remplissaient tout le monde connu du fracas de leurs armes ; leurs bandes aventureuses étaient partout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65a03ba0-0972-4b45-82d9-adfcc50ddf5e",
                        "source_entry_id": "c30a87bb-5cc5-3259-baca-1b362206c410",
                        "target_lang_word": "Krach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5ed80a-d145-3381-9211-43ad908edcb0",
                                        "entry_id": "711f8ad0-a41d-34f1-884a-f2f7be208d0e",
                                        "glosses": [
                                            "ohne Plural: sehr lautes, unangenehmes Geräusch; plötzliches, hartes, sehr lautes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952bb89c-e73d-411a-a850-a9c3c55161b8",
                                                "sense_id": "9f5ed80a-d145-3381-9211-43ad908edcb0",
                                                "text": "Der Krach gestern war unbeschreiblich."
                                            },
                                            {
                                                "example_id": "88b58e92-9253-4c3d-8508-e48e57eb6764",
                                                "sense_id": "9f5ed80a-d145-3381-9211-43ad908edcb0",
                                                "text": "„Er hatte zu flippern begonnen, es signalisierte rot, blau, grün aus allen Ecken und dazu aus der Musikbox der Krach, vor lauter Krach hörte man den Krach nicht mehr.“"
                                            },
                                            {
                                                "example_id": "37524af9-0db6-4605-ab82-42af90468454",
                                                "sense_id": "9f5ed80a-d145-3381-9211-43ad908edcb0",
                                                "text": "„Kaum im Bunker angekommen, gingen der Krach und das schon Getöse los.“"
                                            },
                                            {
                                                "example_id": "69245240-cf89-4ee9-a6ef-8de6dc143411",
                                                "sense_id": "9f5ed80a-d145-3381-9211-43ad908edcb0",
                                                "text": "„Erst bei Schönberg war der Krach so schnell wieder weg, wie er aufgetreten war.“"
                                            },
                                            {
                                                "example_id": "295ee8cd-8df1-40c7-9e47-82a847670409",
                                                "sense_id": "9f5ed80a-d145-3381-9211-43ad908edcb0",
                                                "text": "„4 – 3 – 2 – 1 – 0: Mit ohrenbetäubendem Krach, großen Dampfwolken und grellem Feuerschein hebt das Space-Shuttle ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eeba512c-639b-3152-b063-cbaf11cd6316",
                                        "entry_id": "711f8ad0-a41d-34f1-884a-f2f7be208d0e",
                                        "glosses": [
                                            "heftige, laute Auseinandersetzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e03d58-cbaa-4487-91db-53cf9e05118f",
                                                "sense_id": "eeba512c-639b-3152-b063-cbaf11cd6316",
                                                "text": "Wir hatten einen großen Krach miteinander."
                                            },
                                            {
                                                "example_id": "8c082fad-2b0b-491f-9f93-1517552ff050",
                                                "sense_id": "eeba512c-639b-3152-b063-cbaf11cd6316",
                                                "text": "„Aber ich war nicht sicher, ob er das, was ich mit Marie getan hatte, ohne Krach hinnehmen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "813056df-5d47-4b44-bdb5-2a8976296862",
                        "source_entry_id": "c30a87bb-5cc5-3259-baca-1b362206c410",
                        "target_lang_word": "Getöse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Getöse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b8e04d-e47a-3fb7-8805-8a2808938bc0",
                                        "entry_id": "616892a9-571a-31fe-b0b2-3a41ea17a11d",
                                        "glosses": [
                                            "anhaltendes, lautes Geräusch, verursacht etwa durch Naturereignisse, Wasser, Wind, Verkehr oder eine Menschenmenge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60d1c3f-351a-40ff-8927-9bd0c711885d",
                                                "sense_id": "a4b8e04d-e47a-3fb7-8805-8a2808938bc0",
                                                "text": "Die Dampf-Eruptionen sahen aus, als ob ein gewaltiger Geysir Dampf und Erdbrocken mit lautem Getöse in die Luft schleuderte."
                                            },
                                            {
                                                "example_id": "30227f12-0626-4dbc-a819-26a0a92f39fb",
                                                "sense_id": "a4b8e04d-e47a-3fb7-8805-8a2808938bc0",
                                                "text": "Wirklich drang von draußen her das Getöse einer vielköpfigen Menge zu ihnen."
                                            },
                                            {
                                                "example_id": "c8c7b44c-b918-45e9-99e0-f2644ad74df3",
                                                "sense_id": "a4b8e04d-e47a-3fb7-8805-8a2808938bc0",
                                                "text": "In den Pausen zwischen den Aschen- und Regengüssen hörte man ein unterirdisches Getöse in der Erde und die wild brausenden Wogen des aufgeregten Meeres."
                                            },
                                            {
                                                "example_id": "7a3c342f-8236-4e78-beba-356ddef246eb",
                                                "sense_id": "a4b8e04d-e47a-3fb7-8805-8a2808938bc0",
                                                "text": "Er sah um sich in der Stube, da hörte er noch einen Schuß fallen und hörte Getöse in der Mühle und Geschrei durch das Geklapper."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e5b5667-922b-39a3-8035-a832c315bd4f",
                                        "entry_id": "616892a9-571a-31fe-b0b2-3a41ea17a11d",
                                        "glosses": [
                                            "Aufsehen, Wirbel um eine Sache, die großartig angekündigt oder beworben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab2ee6a-cb92-446c-b645-305e3b2ce72c",
                                                "sense_id": "4e5b5667-922b-39a3-8035-a832c315bd4f",
                                                "text": "Was sich hingegen in den Köpfen der anwesenden Journalisten festsetzte, war der klare Eindruck, dass die mit großem Getöse angekündigte deutsche Präsidentschaft nicht imstande war, eine Pressekonferenz zu organisieren."
                                            },
                                            {
                                                "example_id": "65a9c10e-4253-43f5-b7a8-83ae388901a1",
                                                "sense_id": "4e5b5667-922b-39a3-8035-a832c315bd4f",
                                                "text": "Mit viel Getöse als letzte Chance zelebriert, mündete die griechische Expedition in ein Desaster."
                                            },
                                            {
                                                "example_id": "e2fcf985-6b2b-4a61-bb75-b7bf6608861c",
                                                "sense_id": "4e5b5667-922b-39a3-8035-a832c315bd4f",
                                                "text": "Das Getöse der „Reformer“ legt allerdings den Verdacht nahe, dass selbstständiges Denken vom Normalbürger gar nicht gewollt ist, weil es das reibungslose Funktionieren stören könnte."
                                            },
                                            {
                                                "example_id": "e5259a2a-3886-4d5b-95cf-588eb4ae820d",
                                                "sense_id": "4e5b5667-922b-39a3-8035-a832c315bd4f",
                                                "text": "Die in Wien zur Sensation stilisierten Zellen werden in Innsbruck seit vielen Jahren ohne Getöse erforscht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2825bf64-aabc-4fc2-9570-36b99df37013",
