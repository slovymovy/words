                                        "sense_id": "25cbba2f-f500-32ce-a787-15172415629f",
                                        "entry_id": "c6624397-02b2-3531-bc9e-3d8fef1429e3",
                                        "glosses": [
                                            "iemand die niet meer gelooft in 'de ware' religie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8537084e-41b0-44d0-b4ed-c962fd6b29ce",
                                                "sense_id": "25cbba2f-f500-32ce-a787-15172415629f",
                                                "text": "Het verwijt van Rome was vooral dat hij als aartsketter de eenheid en de vrede van het land had gebroken."
                                            },
                                            {
                                                "example_id": "c3821d64-626d-4bc0-afba-8d46238f2c09",
                                                "sense_id": "25cbba2f-f500-32ce-a787-15172415629f",
                                                "text": "Ik loop met vader terug naar huis. „De aartsketter!” barst vader opeens los. „Op de brandstapel ermee! Dat gespuis hoort hier niet vrij rond te lopen!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4ffa2df-0bf9-435c-9715-0d58afe39751",
                        "source_entry_id": "f0a295d1-334f-35b7-9ddd-fe37109fff4e",
                        "source_sense_id": "f576e9d6-db8a-3377-993a-9651f6fa32df",
