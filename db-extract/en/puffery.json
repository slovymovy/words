                                    {
                                        "sense_id": "2d9bebe5-c415-3323-8f7c-6d5d6774e7e4",
                                        "entry_id": "d495c85d-628f-3dde-bb7b-1fb77d7ab594",
                                        "glosses": [
                                            "Handlung, etwas besonders lobend hervorzuheben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "936bbc19-5aad-4948-8bf1-709341997fd7",
                                                "sense_id": "2d9bebe5-c415-3323-8f7c-6d5d6774e7e4",
                                                "text": "„Einer von jenen Berliner Camelots, die auf der Antarktis des Rückens eine Tafel mit der Aufschrift »Hier ist die … Zeitung erhältlich« tragen, schrie mir eine andere Anpreisung ins Ohr: „Das Blatt der Heiratslustigen“.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "642738a5-c624-3727-819e-a3ea93c85722",
                                        "entry_id": "d495c85d-628f-3dde-bb7b-1fb77d7ab594",
                                        "glosses": [
                                            "Vorgang, besonders lobend hervorgehoben zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84ae030-9da4-4864-a4e8-5c2ff05ddf72",
                                                "sense_id": "642738a5-c624-3727-819e-a3ea93c85722",
                                                "text": "„In den meisten Fenstern der Geschäfte und Läden lagen die Sachen nämlich verstreut und ohne große Anpreisung einfach herum, und viele dieser bloß daliegenden Sachen sahen so aus, als lägen sie bereits seit Jahren in diesem Fenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
