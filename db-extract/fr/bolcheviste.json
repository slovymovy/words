                        "examples": [
                            {
                                "example_id": "8b6d6d14-3e41-4b42-a1db-146f1ca21df0",
                                "sense_id": "5c7f6268-4df4-337e-b626-523deb8367b2",
                                "text": "Comme vous devez les détester, ces bolchevistes ! dit Hester Wayne au prince Namourof."
                            },
                            {
                                "example_id": "6d514451-0ca7-4276-8452-6b5d635ce717",
                                "sense_id": "5c7f6268-4df4-337e-b626-523deb8367b2",
                                "text": "« Cher ami, il y a deux choses en ce monde qu’on ne peut pas savoir exactement : si l’on n’est pas trompé par une femme et si un bolcheviste est sincère… »"
                            },
                            {
                                "example_id": "d8263bd2-4f9b-4ed5-acad-67176f237968",
                                "sense_id": "5c7f6268-4df4-337e-b626-523deb8367b2",
                                "text": "Si bien que, au fur et à mesure que les Allemands évacuaient les pays occupés, les bolchevistes russes les occupaient avec leurs troupes."
                            }
                        ]
                    }
