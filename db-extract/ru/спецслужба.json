                    },
                    {
                        "translation_id": "54e56afb-f2e1-481d-9916-72d8257a5f24",
                        "source_entry_id": "e9545b06-7ae9-3a33-a4c0-16f4843ae84f",
                        "source_sense_id": "d8ac568d-c1ea-3ca3-9b5f-eb0ad774e6aa",
                        "target_lang_word": "servizio segreto",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ed9685d0-602d-46e7-8265-3ed063894bc9",
                        "source_entry_id": "e9545b06-7ae9-3a33-a4c0-16f4843ae84f",
                        "source_sense_id": "d8ac568d-c1ea-3ca3-9b5f-eb0ad774e6aa",
                        "target_lang_word": "Geheimdienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheimdienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58f9c2d9-e86f-33f8-b301-ddcf3a9c6d5e",
                                        "entry_id": "969df0d4-0d9b-3d88-b7cf-4fd1ddd98a75",
                                        "glosses": [
                                            "Behörde, die verdeckt vor der Öffentlichkeit für den Staat Informationen besorgt, um ihn vor Gefahren und Gegnern zu schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8375de68-0c3e-4d4b-854e-7a9b975a025b",
                                                "sense_id": "58f9c2d9-e86f-33f8-b301-ddcf3a9c6d5e",
                                                "text": "„Traditionell wird die Kryptographie von den Geheimdiensten aller Staaten genutzt.“"
                                            },
                                            {
                                                "example_id": "8a175f21-3110-41c4-95a3-620d62c4380b",
                                                "sense_id": "58f9c2d9-e86f-33f8-b301-ddcf3a9c6d5e",
                                                "text": "„Er war der Bruder eines Attentäters, der Schwager eines Volksfeindes, und er ist aus dem Geheimdienst ausgetreten.“"
                                            },
                                            {
                                                "example_id": "ab54d5b2-87ed-4106-afc4-0694100887f4",
                                                "sense_id": "58f9c2d9-e86f-33f8-b301-ddcf3a9c6d5e",
                                                "text": "„Nach seinem Ausscheiden aus dem Geheimdienst steigt er in den internationalen Handel mit Blutdiamanten aus dem Kongo ein.“"
                                            },
                                            {
                                                "example_id": "029ea583-a366-4e37-9b51-f06c41f8044a",
                                                "sense_id": "58f9c2d9-e86f-33f8-b301-ddcf3a9c6d5e",
                                                "text": "„Die Regierung ließ mit scharfer Munition auf Demonstranten schießen, Geheimdienste meucheln, reguläre Soldaten bekämpfen die Bevölkerung.“"
                                            },
                                            {
                                                "example_id": "5f241f36-dbb6-4b97-b190-44e60706acd1",
                                                "sense_id": "58f9c2d9-e86f-33f8-b301-ddcf3a9c6d5e",
                                                "text": "„Das Lager gehörte zum NKWD, wie der Geheimdienst geheißen hatte, bevor die Staatssicherheitsabteilung zum MGB wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a917181-16a9-421a-a1c2-c750d86bdced",
                        "source_entry_id": "e9545b06-7ae9-3a33-a4c0-16f4843ae84f",
                        "source_sense_id": "d8ac568d-c1ea-3ca3-9b5f-eb0ad774e6aa",
