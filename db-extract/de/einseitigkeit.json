                "senses": [
                    {
                        "sense_id": "e05ab80b-60ea-3703-a5fc-08b2dc466d51",
                        "entry_id": "43001e1f-a225-3c2f-a843-df8de8637241",
                        "glosses": [
                            "Zustand, dass etwas nur für eine Seite gilt oder nur aus einer Sichtweise betrachtet wird"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "253911a4-ee40-414e-944b-77c60abc6ce8",
                                "sense_id": "e05ab80b-60ea-3703-a5fc-08b2dc466d51",
                                "text": "„Das zeitgenössische Irkutsk unterscheidet sich vom sowjetischen sichtbar dadurch, dass die Einseitigkeit der sowjetischen Erinnerung durch eine Vielfalt ersetzt wurde.“"
                            },
                            {
                                "example_id": "0768ddcb-5ffa-4596-b46b-469b62f918e6",
                                "sense_id": "e05ab80b-60ea-3703-a5fc-08b2dc466d51",
                                "text": "„Auf diese Weise hatten wir ein schönes Feedback und lösten die Einseitigkeit des Witzeerzählens von der Bühne herab zu einer Art kommunikativem Stammtisch auf, jedenfalls in Ansätzen.“"
                            },
                            {
                                "example_id": "f366bdf8-fe0d-4762-a173-5e863039836e",
                                "sense_id": "e05ab80b-60ea-3703-a5fc-08b2dc466d51",
                                "text": "„Diese Einseitigkeit ist ergreifend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "623e2947-6ca1-4ba5-a123-2b39442b64a4",
                        "source_entry_id": "43001e1f-a225-3c2f-a843-df8de8637241",
                        "source_sense_id": "e05ab80b-60ea-3703-a5fc-08b2dc466d51",
                        "source_sense_description": "Zustand, dass etwas nur für eine Seite gilt oder nur aus einer Sichtweise betrachtet wird",
                        "target_lang_word": "one-sidedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one-sidedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb6430d-2805-332c-a016-810c2588b193",
                                        "entry_id": "08f7a408-bdba-33ed-9c36-21066441f5b1",
                                        "glosses": [
                                            "The state of being one-sided; partiality, bias."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff1ebc6-9560-4ea8-a948-d9f5ec18f231",
                                                "sense_id": "dbb6430d-2805-332c-a016-810c2588b193",
                                                "text": "The Premier League leaders did what many people thought was beyond them in their last European excursion, at the home of Borussia Dortmund, and they made light work of overcoming Marseille on a night when the one-sidedness was not reflected by their inability to add to Jack Wilshere's two goals."
                                            },
                                            {
                                                "example_id": "01f41bd2-7f81-4f34-b4f1-d596edc679ce",
                                                "sense_id": "dbb6430d-2805-332c-a016-810c2588b193",
                                                "text": "Living in Germany, I see it as my human responsibility to call it out for its one-sidedness, its hypocrisy and its acquiesence in the ethnic cleansing of Gaza."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75473ab1-bdc3-462d-a4a6-051fbfad9dfa",
                        "source_entry_id": "43001e1f-a225-3c2f-a843-df8de8637241",
                        "source_sense_id": "e05ab80b-60ea-3703-a5fc-08b2dc466d51",
                        "source_sense_description": "Zustand, dass etwas nur für eine Seite gilt oder nur aus einer Sichtweise betrachtet wird",
                        "target_lang_word": "partialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fbf90cc-aaf0-34c7-aedb-d48f5dfa2df8",
                                        "entry_id": "91342deb-ad0b-31b1-a4d6-dd9e8d565f2b",
                                        "glosses": [
                                            "Disposition à favoriser une personne, une opinion plutôt qu’une autre, préférence marquée à son égard et contraire à la justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2450e97f-0181-4746-8e48-5f432071f301",
                                                "sense_id": "7fbf90cc-aaf0-34c7-aedb-d48f5dfa2df8",
                                                "text": "Tous les souverains de la race normande avaient témoigné la partialité la plus marquée pour leurs sujets normands ; les lois […] avaient été fixées comme un joug sur le cou des habitants subjugués, surcroît féodal, des chaînes dont ils étaient chargés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
