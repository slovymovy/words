            {
                "entry_id": "e7a03d4f-0027-3598-aa26-504ef5267ae1",
                "word": "Muppet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e58d8233-e403-4ab0-a59f-2c16825ec50e",
                        "entry_id": "e7a03d4f-0027-3598-aa26-504ef5267ae1",
                        "tags": [
                            "plural"
                        ],
                        "form": "Muppets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "812f1cbb-b455-32d1-83a8-a497d178fd42",
                        "entry_id": "e7a03d4f-0027-3598-aa26-504ef5267ae1",
                        "glosses": [
                            "A term of endearment, used with a young girl"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0df27826-3a10-42d2-a18a-483cf8549b23",
                                "sense_id": "812f1cbb-b455-32d1-83a8-a497d178fd42",
                                "text": "\"Mamma, I see Mr. Joshua Parker coming up the road in his gray hat with the black band,\" announced the daughter emphatically, craning her neck to see over the evergreens. “Do you, Muppet? Then he is coming to call at the rectory; for he never wears his hat except when he is going to make a call, — and there is nowhere to call at but here.\""
                            },
                            {
                                "example_id": "5f9a6a80-d32c-4d89-9cdb-e2d37d2472f5",
                                "sense_id": "812f1cbb-b455-32d1-83a8-a497d178fd42",
                                "text": "“I thought we were pretty happy the way we were,” Aunt Holly said, ruffling Jamie's hair. “I'm happy. Aren't you, Muppet?“"
                            },
                            {
                                "example_id": "158164cf-af93-471a-815a-f1e47e3ed9af",
                                "sense_id": "812f1cbb-b455-32d1-83a8-a497d178fd42",
                                "text": "You know my little Muppet, Abby may not be able to find out if there is anything untoward going on at the institute, but I sure can."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
