                                        "sense_id": "cb9bbeb4-0687-3ba8-9caa-8ed6df4f357b",
                                        "entry_id": "3384c942-0f2b-36de-8967-0fe8259d4be0",
                                        "glosses": [
                                            "Active help from a person, organization, etc., such as an orderly sharing of space or resources."
                                        ],
                                        "tags": [
