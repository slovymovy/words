                "forms": [
                    {
                        "form_id": "ddd22026-1407-4bdc-b7f9-5b4573cf0bed",
                        "entry_id": "44320a40-73fa-350e-a1fa-d627bd5a4502",
                        "tags": [
                            "plural"
                        ],
                        "form": "mangelwurzels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90f3e6a8-1714-354e-97a8-7cfb3ffdf88c",
                        "entry_id": "44320a40-73fa-350e-a1fa-d627bd5a4502",
                        "glosses": [
                            "A root vegetable, variety of Beta vulgaris, cultivated chiefly as cattle feed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdbaccc4-a606-435b-b45f-d3aa838f8b39",
                                "sense_id": "90f3e6a8-1714-354e-97a8-7cfb3ffdf88c",
                                "text": "I have not written to my beloved Amelia for these many weeks past, for what news was there to tell of the sayings and doings at Humdrum Hall, as I have christened it; and what do you care whether the turnip crop is good or bad; whether the fat pig weighed thirteen stone or fourteen; and whether the beasts thrive well upon mangelwurzel?"
                            },
                            {
                                "example_id": "72a29f16-ec48-42d8-9d6a-a7f1422964a7",
                                "sense_id": "90f3e6a8-1714-354e-97a8-7cfb3ffdf88c",
                                "text": "Wheat and barley, oats and hay,\nClover, beans, and mangel-wurzels"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc68e16e-f457-430b-9d7d-b68e16620137",
                        "source_entry_id": "44320a40-73fa-350e-a1fa-d627bd5a4502",
                        "source_sense_id": "90f3e6a8-1714-354e-97a8-7cfb3ffdf88c",
                        "source_sense_description": "root vegetable",
                        "target_lang_word": "krmná řepa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f8bd91e9-29c1-4cc4-904e-3a96e5e7945d",
                        "source_entry_id": "44320a40-73fa-350e-a1fa-d627bd5a4502",
                        "source_sense_id": "90f3e6a8-1714-354e-97a8-7cfb3ffdf88c",
                        "source_sense_description": "root vegetable",
                        "target_lang_word": "betterave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betterave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                        "entry_id": "003bd6c1-5e36-3df6-8a3e-7db3e100a44a",
                                        "glosses": [
                                            "Variété de bette à racine charnue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b80c575-3755-4683-9bb2-fcec78278150",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "Il y a des betteraves blanches, il y en a de jaunes, de rouges, et de marbrées, et quelquefois la pellicule est rouge et la chair est blanche."
                                            },
                                            {
                                                "example_id": "91357a5a-e7f5-4cf7-982b-ad0c232d80b7",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "Au milieu des champs de blé et de betteraves, le coron des Deux-Cent-Quarante dormait sous la nuit noire."
                                            },
                                            {
                                                "example_id": "06a3c528-8a31-49f7-a197-11acdb6853a2",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "La France inventa le sucre de betterave lorsque le sucre de canne vint à manquer, à la suite du blocus continental."
                                            },
                                            {
                                                "example_id": "768e5711-a527-4ede-b596-3ea42cec4b87",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "Lorsque l'on fait cuire les betteraves au four, et c'est la meilleure façon de les cuire, il faut d'abord les laver à l'eau-de-vie commune."
                                            },
                                            {
                                                "example_id": "b6b2e9d5-ab45-49c4-be30-4de7cea24245",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "Dès sa première communion, gagé par l'un ou par l'autre, gardeur de chèvre, ou de vaches, aide-berger, sarcleur de betteraves, bûcheron à l'occasion, il était sans l'avoir appris devenu habile […]."
                                            },
                                            {
                                                "example_id": "71c07842-e435-450e-a756-2aa7df34c4b3",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "Depuis 1916-24, les betteraviers profitent de la « parité » : le même prix leur est payé par l’État pour leurs betteraves, qu'elles servent à fabriquer du sucre ou qu'il y ait distillation en alcool."
                                            },
                                            {
                                                "example_id": "1628c3e5-c39b-4266-84ba-246cdab6ff8a",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "J'aimais ça biner les betteraves, c'était mon dada, ma vie. C'était un plaisir pour moi de démarier les betteraves. On commençait le 15 avril."
                                            },
                                            {
                                                "example_id": "8151f024-c9f4-4bb2-bde9-a14af9761e87",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "Avec un camarade et un cousin, il s’est fait engager à Ozoir-la-Ferrière, où il s’en va biner, pendant six semaines, la betterave."
                                            },
                                            {
                                                "example_id": "e73d5e19-e89b-42b0-b1f3-11354c524cee",
                                                "sense_id": "59f2acab-5b90-39c3-8f36-65dd2dfe5d19",
                                                "text": "Les habitants parmi les plus malheureux sont arrivés au point de se faire cuire des betteraves pour manger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f3ef4f-fba9-3590-81bc-3aa77c82b438",
                                        "entry_id": "003bd6c1-5e36-3df6-8a3e-7db3e100a44a",
                                        "glosses": [
