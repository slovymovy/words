                    {
                        "sense_id": "1d765c26-398c-349f-9537-b941752d0d5a",
                        "entry_id": "fc99edb5-67d4-382f-b8ff-7675e1978ff3",
                        "glosses": [
                            "To open (a bottle or other container sealed with a cork or stopper) by removing the cork or stopper from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a69b8fd-95e8-4612-ac82-7b13092c105a",
                                "sense_id": "1d765c26-398c-349f-9537-b941752d0d5a",
                                "text": "uncork a bottle of wine"
                            },
                            {
                                "example_id": "a363d28b-9d97-40f5-bc13-32d7177b411e",
                                "sense_id": "1d765c26-398c-349f-9537-b941752d0d5a",
                                "text": "After Compiègne, André uncorked a bottle of his Vin Rosé which went down uncommonly well and we reached Aulnoye without further incident."
                            }
                        ]
                    },
                    {
                        "sense_id": "55c970c3-c50c-36c0-ba86-79a085ec6eea",
                        "entry_id": "fc99edb5-67d4-382f-b8ff-7675e1978ff3",
                        "glosses": [
                            "To release."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "15bf515a-70df-4545-844c-dac0dbdee89c",
                                "sense_id": "55c970c3-c50c-36c0-ba86-79a085ec6eea",
                                "text": "The 11 September attacks uncorked a whirlwind of outlandish conspiracy theories."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a210663-5e32-4e6c-8bec-81984e280f3c",
                        "source_entry_id": "fc99edb5-67d4-382f-b8ff-7675e1978ff3",
                        "source_sense_description": "to open by removing the cork or stopper from",
                        "target_lang_word": "déboucher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déboucher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15486c68-07d2-3784-940c-1930b50ea04e",
                                        "entry_id": "09208dd4-3cde-35a1-8d15-456a238447e9",
                                        "glosses": [
                                            "Débarrasser de ce qui bouche, de ce qui obstrue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6f390f1-d007-4c7e-b8e5-8ab95902a007",
                                                "sense_id": "15486c68-07d2-3784-940c-1930b50ea04e",
                                                "text": "Déboucher les chemins, les passages. Déboucher une porte. Déboucher le tuyau d’une pipe (Par extension) Déboucher une pipe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c893e35-7363-3d01-bcd6-69180a5ebe08",
                                        "entry_id": "09208dd4-3cde-35a1-8d15-456a238447e9",
                                        "glosses": [
                                            "Débarrasser de son bouchon."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20481993-365d-4baa-ab54-af42f328baa6",
                                                "sense_id": "0c893e35-7363-3d01-bcd6-69180a5ebe08",
                                                "text": "L’aubergiste accourait. Plié sur ses genoux, il y serrait les bouteilles, comme dans un étau, et les débouchait d’une poigne solide."
                                            },
                                            {
                                                "example_id": "f58c258c-0bbb-4d34-b7ad-c88866d1f0f8",
                                                "sense_id": "0c893e35-7363-3d01-bcd6-69180a5ebe08",
                                                "text": "Ils s'attablent dans de bons restaurants, se font déboucher des bouteilles de Châteauneuf-du-Pape, dégustent des liqueurs."
                                            },
                                            {
                                                "example_id": "6c90f037-5651-4429-9ec8-f5575889a2be",
                                                "sense_id": "0c893e35-7363-3d01-bcd6-69180a5ebe08",
                                                "text": "— Ça, dit-il, c’est très bien. Parce qu’on peut déboucher une bouteille sans la remuer… Du vin pareil, si on le bouscule, c’est un crime."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déboucher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77ee6c4b-6745-3229-ab41-fb5a6e6281a1",
                                        "entry_id": "51574fe1-82cf-312d-b3a7-7b35d5db6d11",
                                        "glosses": [
                                            "Sortir d’un endroit resserré pour passer dans un lieu plus ouvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b733ab-03d6-4d16-9763-816bc40234c3",
                                                "sense_id": "77ee6c4b-6745-3229-ab41-fb5a6e6281a1",
                                                "text": "Mais, comme elle débouchait enfin sur la place Gaillon, la jeune fille s'arrêta net de surprise."
                                            },
                                            {
                                                "example_id": "e160f87e-3639-4119-9428-fdfd7f819482",
                                                "sense_id": "77ee6c4b-6745-3229-ab41-fb5a6e6281a1",
                                                "text": "Après avoir traversé le pont, on débouche sur place des Carmes où fut érigée, en 1885, la statue du conventionnel Grégoire."
                                            },
                                            {
                                                "example_id": "082f5224-9a9b-43c5-a9e7-420a73963afa",
                                                "sense_id": "77ee6c4b-6745-3229-ab41-fb5a6e6281a1",
                                                "text": "Il déboucha bientôt devant plusieurs chalets, construits en planches comme le dernier, avec chacun une sorte de véranda mal peinte en blanc, […]."
                                            },
                                            {
                                                "example_id": "c4363b9c-5e50-4720-ad3a-5e8bd45769c5",
                                                "sense_id": "77ee6c4b-6745-3229-ab41-fb5a6e6281a1",
                                                "text": "Point besoin de souligner que cette brigade de spahis, […], serait incapable de s’opposer aux chars de la 1ʳᵉ Panzer, quand ceux-ci déboucheraient de la vallée de la Bar et se répandraient dans la dépression de Vendresse au cours de l’après-midi du 14 mai."
                                            },
                                            {
                                                "example_id": "67366fdf-69f4-4e2e-991f-389d6dbad6b6",
                                                "sense_id": "77ee6c4b-6745-3229-ab41-fb5a6e6281a1",
                                                "text": "J'emprunte une allée bordée de fusains et débouche sur la cour centrale où un palefrenier et un maître de manège s'engueulent virilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84883ff3-f64d-3d36-9706-1ba31555ad32",
                                        "entry_id": "51574fe1-82cf-312d-b3a7-7b35d5db6d11",
                                        "glosses": [
                                            "Sortir par l’endroit où il a son embouchure, en parlant d'un fleuve, d'une rivière, d'un canal, voire d'une route"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae947baa-6df6-4f48-b793-1580f539848f",
                                                "sense_id": "84883ff3-f64d-3d36-9706-1ba31555ad32",
                                                "text": "Vallon de Bouafles. — La craie marneuse est très développée dans les vallons qui viennent déboucher à Bouafles ; elle est très nettement visible en particulier, un peu en amont de Basse-Copette sur la route de Campneuseville et elle monte là extrêmement haut."
                                            },
                                            {
                                                "example_id": "236a1e05-e787-408f-8d8b-90eba006fece",
                                                "sense_id": "84883ff3-f64d-3d36-9706-1ba31555ad32",
                                                "text": "Ajoutons, enfin, que la Meuse n'est pas réservée aux seuls canoëistes, et que, de Pont-à-Bar, près de Sedan, où débouche le canal des Ardennes, jusqu'à Liège, les bateaux à moteur trouveront une navigation aussi facile que pittoresque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6244cd1-372b-36d4-b140-0be645c5244d",
                                        "entry_id": "51574fe1-82cf-312d-b3a7-7b35d5db6d11",
                                        "glosses": [
                                            "Aboutir."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce2db2f2-322e-45d4-865a-8b89b1525af7",
                                                "sense_id": "c6244cd1-372b-36d4-b140-0be645c5244d",
                                                "text": "Les changements à répétition des règles débouchent sur des imbroglios administratifs et juridiques inextricables et l’illégalité ouvre la porte à tous les trafics, mafias et répressions policières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
