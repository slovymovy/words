                ],
                "senses": [
                    {
                        "sense_id": "a4d88574-23ac-3854-ab47-4c72615f0567",
                        "entry_id": "d2f4228f-c043-30ae-89f1-5421d9c87c52",
                        "glosses": [
                            "ein Geschoss, das durch Abprallen an einem anderen Gegenstand unkontrolliert durch die Gegend fliegt"
                        ],
                        "tags": [
                            "Waffenkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "3b747e65-844d-44a7-a0b2-d2492ebc119b",
                                "sense_id": "a4d88574-23ac-3854-ab47-4c72615f0567",
                                "text": "Er wurde von einem Querschläger getroffen und musste zur Behandlung ins Krankenhaus."
                            },
                            {
                                "example_id": "743eab58-b477-4e99-a7d8-6fd251ec07e8",
                                "sense_id": "a4d88574-23ac-3854-ab47-4c72615f0567",
                                "text": "„Wir stehen hinter der Grabenwand und lauern, Gewehrkugeln spritzen lichtzuckend in die Erde, Querschläger surren, Leuchtkugeln entfalten sich, schweben mit weißfahlem Schein über den Drahtverhauen, alle Geräusche vermischen sich mit den Stimmen der Nacht.“"
                            },
                            {
                                "example_id": "6ff1f943-c870-4932-9205-5e9c489d5dca",
                                "sense_id": "a4d88574-23ac-3854-ab47-4c72615f0567",
                                "text": "„Lassehn ist in einen Hausflur gesprungen, ein Querschläger fährt dicht neben ihm in die Wand und bestäubt ihn kalkweiß.“"
                            },
                            {
                                "example_id": "77b9db56-f72b-469f-9eea-3654383288e3",
                                "sense_id": "a4d88574-23ac-3854-ab47-4c72615f0567",
                                "text": "„Querschläger prallten an den Hauswänden ab und ließen den Putz bröckeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ceae1dbd-6707-3fb5-b496-3085bc364e38",
                        "entry_id": "d2f4228f-c043-30ae-89f1-5421d9c87c52",
                        "glosses": [
                            "eine Person, die sich Anordnungen hartnäckig widersetzt oder diese bewusst unterläuft"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "372942e1-b0b1-34b5-a495-d4c694fda5ac",
                        "entry_id": "d2f4228f-c043-30ae-89f1-5421d9c87c52",
                        "glosses": [
                            "derjenige Bergmann, der Gestein löst"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "61fefc45-b00c-48ac-91cd-7d7adbc3fe12",
                                "sense_id": "372942e1-b0b1-34b5-a495-d4c694fda5ac",
                                "text": "Die Arbeit als Querschläger erfüllt Kasimir schon lange nicht mehr mit Freude."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2173b59f-68f6-4d25-a715-c712ee31148c",
                        "source_entry_id": "d2f4228f-c043-30ae-89f1-5421d9c87c52",
                        "source_sense_id": "a4d88574-23ac-3854-ab47-4c72615f0567",
                        "target_lang_word": "ricochet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ricochet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15f0ccc8-0c2e-34fe-a0b8-c195aac7a26b",
                                        "entry_id": "737857c3-0058-3f06-a3ce-06703928fbd3",
                                        "glosses": [
                                            "A method of firing a projectile so that it skips along a surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd097b7e-8a46-3865-9669-07ac9b68af77",
                                        "entry_id": "737857c3-0058-3f06-a3ce-06703928fbd3",
                                        "glosses": [
                                            "An instance of ricocheting; a glancing rebound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81cf918-aa8d-43e6-9618-98016c89198e",
                                                "sense_id": "fd097b7e-8a46-3865-9669-07ac9b68af77",
                                                "text": "And you've not been hit / By flying lead / You'd better close your eyes / Bow your head / Wait for the ricochet"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ricochet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1004801f-d80e-3279-83dc-979aafefb180",
                                        "entry_id": "9ca8b224-f827-3e50-86c4-00f3d600a5c3",
                                        "glosses": [
                                            "To rebound off something wildly in a seemingly random direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace64dcf-adf0-4845-862a-b9d7b87a5792",
                                                "sense_id": "1004801f-d80e-3279-83dc-979aafefb180",
                                                "text": "Everything that could go right for England did although they never felt lucky and they chuckled at Kane’s third that ricocheted off his heel while he was looking the other way."
                                            },
                                            {
                                                "example_id": "c331d8cd-81c3-4791-80fb-20c64a003367",
                                                "sense_id": "1004801f-d80e-3279-83dc-979aafefb180",
                                                "text": "The truth is that our love / Will ricochet through eternity"
                                            },
                                            {
                                                "example_id": "3d8e5671-cc88-4b15-b1c8-328f78268ded",
                                                "sense_id": "1004801f-d80e-3279-83dc-979aafefb180",
                                                "text": "Before the interval an Alibade strike ricocheted off the back of Bright after Ifeoma Onumonu’s cutback. Then in added time Uchenna Kanu smacked a header off the top of the bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee27fef7-f16d-374e-a086-c4734a4358b8",
                                        "entry_id": "9ca8b224-f827-3e50-86c4-00f3d600a5c3",
                                        "glosses": [
                                            "To operate upon by ricochet firing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf00c6e4-3722-446d-8099-e2330b2b8183",
                        "source_entry_id": "d2f4228f-c043-30ae-89f1-5421d9c87c52",
                        "source_sense_id": "a4d88574-23ac-3854-ab47-4c72615f0567",
                        "target_lang_word": "ricochet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ricochet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "453a1ed0-96a6-3eb5-95f6-7924c43a33b9",
                                        "entry_id": "54967a04-ba4f-3dfd-a19b-d99c5127f515",
                                        "glosses": [
                                            "Rebond que fait une pierre plate et légère jetée obliquement sur la surface de l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b875297-07fa-4ad4-9072-34958fb7c95b",
                                                "sense_id": "453a1ed0-96a6-3eb5-95f6-7924c43a33b9",
                                                "text": "Tu as vu papa, ma pierre a fait quatre ricochets de suite !"
                                            },
                                            {
                                                "example_id": "90961db5-a35b-4703-953f-8b52f7b0cbe1",
                                                "sense_id": "453a1ed0-96a6-3eb5-95f6-7924c43a33b9",
                                                "text": "J'adore faire des ricochets du bord de la rivière."
                                            },
                                            {
                                                "example_id": "5021e2df-426c-469c-bf7b-d39a19f35ec2",
                                                "sense_id": "453a1ed0-96a6-3eb5-95f6-7924c43a33b9",
                                                "text": "À la personne qui nous accompagne, on ne dit jamais : « Regarde, je vais faire des ricochets. » Tout est dans le non-dit, presque au deuxième degré, mais pas tout à fait quand même. Si l’on tente des ricochets, c’est qu’on n’a pas envie de se moquer de soi-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13b14521-f684-3e08-b7fb-b321e77cd8ab",
                                        "entry_id": "54967a04-ba4f-3dfd-a19b-d99c5127f515",
                                        "glosses": [
                                            "Rebondissement sur le sol ou sur un obstacle quelconque d’un projectile de canon ou d’arme à feu."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a8c979-9467-45f0-9159-5ea62681a0dd",
                                                "sense_id": "13b14521-f684-3e08-b7fb-b321e77cd8ab",
                                                "text": "Cet obus, cette balle a fait ricochet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7feab93-db26-39bc-89b2-af8029dc50cc",
                                        "entry_id": "54967a04-ba4f-3dfd-a19b-d99c5127f515",
                                        "glosses": [
                                            "Rebond volontaire d’un projectile d’artillerie, destiner à accroître les pertes de l’ennemi."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdfcd069-d1ad-4eb5-a433-58a57119cc58",
                                                "sense_id": "d7feab93-db26-39bc-89b2-af8029dc50cc",
                                                "text": "On tire à ricochets lorsqu’on fait arriver le projectile sur les points les plus près de l’objet qu’on veut battre, & qu’il parcourt ensuite en bondissant & renversant tout ce qu’il rencontre à des points éloignés."
                                            },
                                            {
                                                "example_id": "b4bdf074-8fbc-46bb-a0d3-169cfd07db92",
                                                "sense_id": "d7feab93-db26-39bc-89b2-af8029dc50cc",
                                                "text": "Nous avions fait, selon l’habitude, la promenade au polygone, assisté à l’étude du tir à ricochet, écouté et raconté paisiblement les histoires de guerre, discuté sur l’école Polytechnique, sur sa formation, son utilité, ses défauts, et sur les hommes au teint jaune qu’avait fait pousser ce terroir géométrique."
                                            },
                                            {
                                                "example_id": "47cbd9bf-7d09-49a4-9371-105f42e63f93",
                                                "sense_id": "d7feab93-db26-39bc-89b2-af8029dc50cc",
                                                "text": "Les batteries à ricochets sont armées de cinq pièces au moins et mieux de huit ou dix pour chaque face à ricocher."
                                            },
                                            {
                                                "example_id": "6d5e9283-ebb8-499b-b1cc-547c0d9893aa",
                                                "sense_id": "d7feab93-db26-39bc-89b2-af8029dc50cc",
                                                "text": "Lors d’un siège, le tir indirect à ricochet permet en positionnant correctement les batteries, de prendre en enfilade les éléments surélevés (chemin couverts, courtine...) des ouvrages fortifiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "670b71a6-9902-3ae6-9867-40185f78a6b9",
                                        "entry_id": "54967a04-ba4f-3dfd-a19b-d99c5127f515",
                                        "glosses": [
                                            "Conséquence, effet indirect, enchaînement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93aff07-3a19-4bfa-9bf9-1bcf3fc24bc4",
                                                "sense_id": "670b71a6-9902-3ae6-9867-40185f78a6b9",
                                                "text": "La nouvelle m'est parvenue par ricochet."
                                            },
                                            {
                                                "example_id": "9e419df4-290b-47e9-a333-e52ecf0b9ca6",
                                                "sense_id": "670b71a6-9902-3ae6-9867-40185f78a6b9",
                                                "text": "Un éreintage manqué est un accident déplorable ; c'est une flèche qui se retourne, ou au moins vous dépouille la main en partant, une balle dont le ricochet peut vous tuer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdac6040-6fad-39d6-b84a-1b838294c677",
                                        "entry_id": "54967a04-ba4f-3dfd-a19b-d99c5127f515",
                                        "glosses": [
                                            "Suite d’événements amenés les uns par les autres."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ad8663-31d3-4930-a1e0-5702a60a6a3f",
                                                "sense_id": "cdac6040-6fad-39d6-b84a-1b838294c677",
                                                "text": "Un ricochet de fourberies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
