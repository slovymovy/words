                "senses": [
                    {
                        "sense_id": "85d143b3-fb8b-3260-ba0f-2015a3a10ade",
                        "entry_id": "4939b975-2fa3-3c65-bdf8-37e4270c5fd6",
                        "glosses": [
                            "człowiek, który dopuszcza się szachrajstw"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea8b352-361a-4ed1-a02f-2583dc53b758",
                                "sense_id": "85d143b3-fb8b-3260-ba0f-2015a3a10ade",
                                "text": "Ci sami ludzie, którzy mnie ostrzegają, że Suzin jest hultaj, przed miesiącem pisali do Suzina, że ja jestem bankrut, szachraj, ekspowstaniec."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51fe3341-f511-4dbf-b474-4dfe97789a2c",
                        "source_entry_id": "4939b975-2fa3-3c65-bdf8-37e4270c5fd6",
                        "source_sense_id": "85d143b3-fb8b-3260-ba0f-2015a3a10ade",
                        "target_lang_word": "шаромыга",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шаромыга",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4681671f-aa40-379f-a98f-47bce26b2776",
                                        "entry_id": "262d3416-093e-34aa-8851-eb2f89b9286f",
                                        "glosses": [
                                            "прост., уничиж. то же, что шаромыжник; тот, кто любит поживиться на чужой счёт; мошенник, бродяга, дармоед"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53acc3b4-d2e6-4643-9f15-93d1fe100cd0",
                                                "sense_id": "4681671f-aa40-379f-a98f-47bce26b2776",
                                                "text": "Началась борьба; отчаяние, казалось, удесятерило его силы; он уже заносил ногу за порог, он был уж на лестнице, как вдруг у самого его носа, неизвестно откуда, вырос удивительного размера городовой, а в ушах пренеприятно зазвучало: «А куда ты, шаромыга, лезешь?»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e526b31e-abe1-4408-bd20-62c0c4c24b13",
                        "source_entry_id": "4939b975-2fa3-3c65-bdf8-37e4270c5fd6",
                        "source_sense_id": "85d143b3-fb8b-3260-ba0f-2015a3a10ade",
                        "target_lang_word": "шаромыжник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шаромыжник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b103f94b-90fd-3ed0-840b-c89c8bfa8560",
                                        "entry_id": "ea8e33be-3be9-3d92-9019-b49872848ff7",
                                        "glosses": [
                                            "прост., неодобр. тот, кто любит поживиться на чужой счёт"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d3c1a65-090a-3d90-81d2-7bc92d754dcf",
                                        "entry_id": "ea8e33be-3be9-3d92-9019-b49872848ff7",
                                        "glosses": [
                                            "прост., неодобр. тот, кто может украсть, обмануть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e77def-ff48-48b5-8053-1ee634633478",
                                                "sense_id": "5d3c1a65-090a-3d90-81d2-7bc92d754dcf",
                                                "text": "Извозчик, увидав, как я два раза пробежал по двору, чтоб доставать деньги, должно быть догадавшись, зачем я бегаю, слез с дрожек и, несмотря на то, что казался мне таким добрым, громко начал говорить, с видимым желанием уколоть меня, о том, как бывают шаромыжники, которые не платят за езду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f1933e8-cdfc-3f7b-93b3-6f9525b22e5a",
                                        "entry_id": "ea8e33be-3be9-3d92-9019-b49872848ff7",
                                        "glosses": [
