                        "sense_id": "8982d2b4-21ac-3fe3-a4ae-c661f537ac5d",
                        "entry_id": "8f342b31-fab1-3488-beff-8b3792de89fe",
                        "glosses": [
                            "White heath (Erica arborea), a thorny Mediterranean shrub."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "482d9f2e-8e49-3571-90a4-5127de6cf5d6",
                        "entry_id": "8f342b31-fab1-3488-beff-8b3792de89fe",
                        "glosses": [
                            "A pipe for smoking, made from the roots of that shrub."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6716ab7-45b4-41c1-abb3-1554ec9b583b",
                                "sense_id": "482d9f2e-8e49-3571-90a4-5127de6cf5d6",
                                "text": "Then he put the insulted pipe in his pocket, corked himself up with the immense briar, and sneered at Cripps over the top of it."
                            }
                        ]
                    }
                ],
