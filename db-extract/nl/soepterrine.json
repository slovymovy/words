                        "sense_id": "bee98408-2500-3207-b8d4-0774c97fc9f9",
                        "entry_id": "a1fa4854-1e9a-35c4-b356-ee0b255a2838",
                        "glosses": [
                            "een geglazuurde diepe schaal om soep of stoofpot uit te serveren"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "9112f79a-298d-491b-aea0-a919d3e9c0f7",
                                "sense_id": "bee98408-2500-3207-b8d4-0774c97fc9f9",
                                "text": "De soepterrine was zoek, dus hebben we maar een grote pan gebruikt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fe90c34-de9c-4107-8ef2-dc3cd1a630ea",
                        "source_entry_id": "a1fa4854-1e9a-35c4-b356-ee0b255a2838",
                        "source_sense_id": "bee98408-2500-3207-b8d4-0774c97fc9f9",
                        "source_sense_description": "een geglazuurde schaal om soep of stoofpot uit te serveren",
                        "target_lang_word": "Suppenschüssel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suppenschüssel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abe56223-d00b-3b8a-be0e-ed89b59379ec",
                                        "entry_id": "e2422cd0-53f5-3660-9e00-2a6454770343",
                                        "glosses": [
                                            "Schüssel, in der Suppe serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee53d9d6-2766-449b-a1a6-fc370220e8c5",
                                                "sense_id": "abe56223-d00b-3b8a-be0e-ed89b59379ec",
                                                "text": "„Was der Vater essen wollt’, unten auf der Erde rollt; Suppe, Brot und alle Bissen, alles ist herabgerissen; Suppenschüssel ist entzwei, und die Eltern stehn dabei.“"
                                            },
                                            {
                                                "example_id": "45183996-1a0e-49a1-b370-0332dd540ea9",
                                                "sense_id": "abe56223-d00b-3b8a-be0e-ed89b59379ec",
                                                "text": "„In die dampfende Suppenschüssel mit langen Nudeln, Rindfleischstreifen und Zwiebeln mischt man mit den Stäbchen noch Sojabohnensprossen, Bananenblütenstreifen und spinatartiges Grünzeug namens Morning Glory, dazu ein bisschen Chili- oder Fischsoße.“"
                                            },
                                            {
                                                "example_id": "14845186-74d4-4238-85f4-a73beba39631",
                                                "sense_id": "abe56223-d00b-3b8a-be0e-ed89b59379ec",
                                                "text": "„Die alte Dienerin knickste, die Patronin legte den Deckel auf die Suppenschüssel und winkte leicht mit der Hand, der Patron, dessen Schnurrbart noch schwärzer als vordem glänzte, warf einen prüfenden Blick über Tisch und Gast, wobei er das Tischtuch andeutend zurechtzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8899b52-61c9-42f7-93f3-b76185718ffd",
                        "source_entry_id": "a1fa4854-1e9a-35c4-b356-ee0b255a2838",
                        "source_sense_id": "bee98408-2500-3207-b8d4-0774c97fc9f9",
                        "source_sense_description": "een geglazuurde schaal om soep of stoofpot uit te serveren",
                        "target_lang_word": "Suppenterrine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suppenterrine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7562dc5-c7bb-368b-a992-6889300a2ad0",
                                        "entry_id": "5d2a9058-640f-3a63-8daa-a1a75becfc81",
                                        "glosses": [
                                            "Suppenschüssel, die meist besonders verziert ist, auf einem Fuß/mehreren Füßen steht und einen Deckel hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ead40f2-f9ad-42a3-9535-afd5d8fe8147",
                                                "sense_id": "b7562dc5-c7bb-368b-a992-6889300a2ad0",
                                                "text": "„Michel steckt nämlich den Kopf in die Suppenterrine, um an die letzten Tropfen zu kommen, bleibt dann aber stecken.“"
                                            },
                                            {
                                                "example_id": "de35782f-03ad-4349-abb8-3877b38e9ce8",
                                                "sense_id": "b7562dc5-c7bb-368b-a992-6889300a2ad0",
                                                "text": "„Auf ein Zeichen des Patrons nahm die Patronin von dem Tablett, das Milta niedersenkte, die Suppenterrine, stellte sie auf den Tisch und schöpfte, indem sie sich flüchtig vor Robert neigte, mit einer silbernen Kelle einige Löffel voll auf seinen Teller.“"
                                            },
                                            {
                                                "example_id": "19034bde-07eb-474b-98ce-e5b19b2c66f1",
                                                "sense_id": "b7562dc5-c7bb-368b-a992-6889300a2ad0",
                                                "text": "„Er hatte eine Suppenterrine mit Gulasch vor sich und einen großen Schöpflöffel in der Hand und fraß selbstvergessen.“"
                                            },
                                            {
                                                "example_id": "10ed1077-0490-4bb3-919a-59e7548668b1",
                                                "sense_id": "b7562dc5-c7bb-368b-a992-6889300a2ad0",
                                                "text": "„Mitten auf der Anrichte zwischen Tellern stand eine Suppenterrine, die mit gelben Blumensträußen bemalt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
