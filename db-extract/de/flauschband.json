                "senses": [
                    {
                        "sense_id": "f7561e93-4089-3a49-a1ff-3f7702c8ffa7",
                        "entry_id": "466a059f-12bb-3d0d-aff2-daba7f7b6d0b",
                        "glosses": [
                            "Bestandteil eines Klettverschlusses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e99636-a638-49ea-9010-4756385af1e0",
                                "sense_id": "f7561e93-4089-3a49-a1ff-3f7702c8ffa7",
                                "text": "„Beim Anbringen der Hakenbänder empfiehlt es sich, diese je seitlich an den Gips anzukleben, damit man mit dem Flauschband einen guten Zug auf den Spalt geben kann.“"
                            },
                            {
                                "example_id": "b6fefd2e-630b-4b6e-ab1b-d55cb707dbe7",
                                "sense_id": "f7561e93-4089-3a49-a1ff-3f7702c8ffa7",
                                "text": "„Eine große Gefriertüte wird innen mit dem Klettteil des selbstklebenden Klettbandes […] beklebt, die Innenseite der Pappe wird links und rechts vom Schlitz mit dem Flauschband des selbst klebenden Klettbandes […] beklebt.“"
                            },
                            {
                                "example_id": "80c65311-4b8a-435e-9308-b797600f1ee5",
                                "sense_id": "f7561e93-4089-3a49-a1ff-3f7702c8ffa7",
                                "text": "„Sie besitzt eine angenähte Kapuze, Schulterklappen, ein Flauschband zum Anbringen des Namensschildes […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
