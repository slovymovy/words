                "senses": [
                    {
                        "sense_id": "de778298-3a30-32e8-abda-fb4a083f92e9",
                        "entry_id": "1929c10d-ce9c-3e80-8d16-f2ff6927ec13",
                        "glosses": [
                            "Harmoniser de manière excessive."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cb2b0c6e-3138-4636-95d3-f0651a815d76",
                                "sense_id": "de778298-3a30-32e8-abda-fb4a083f92e9",
                                "text": "Il harmonise et surharmonise de l’information."
                            },
                            {
                                "example_id": "d3408d1a-690b-4c34-8c0f-fec71d367a1c",
                                "sense_id": "de778298-3a30-32e8-abda-fb4a083f92e9",
                                "text": "Il a cependant été plusieurs fois vérifié que cette approche dégrade la qualité segmentale en surharmonisant le signal."
                            },
                            {
                                "example_id": "e717fb40-e83b-4ef4-a738-f300b036716d",
                                "sense_id": "de778298-3a30-32e8-abda-fb4a083f92e9",
                                "text": "Bref, on ne va pas refaire le débat, mais peut-être qu’il y a des cas où on n’est pas obligé, comme le dit Nouill, d’\"hypercorriger\" ou surharmoniser, surtout quand c’est discutable…"
                            }
                        ]
                    }
