                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nord-ouest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddee8823-07f3-3557-8956-a403f6a845ee",
                                        "entry_id": "ade40b35-a280-3952-9888-dec5310a676b",
                                        "glosses": [
                                            "Point de l’horizon qui est entre le nord et l’ouest. Il correspond à l'azimut 315°."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3a942a-0cb6-413b-a963-e922b2aafd41",
                                                "sense_id": "ddee8823-07f3-3557-8956-a403f6a845ee",
                                                "text": "La colonne descend dans la vallée au Sud du camp et suit le cours du ruisseau d’Aïn El-Fert à l’Ouest, puis au Nord-Ouest."
                                            },
                                            {
                                                "example_id": "48dd4486-e1e0-4d1c-967c-577d30671837",
                                                "sense_id": "ddee8823-07f3-3557-8956-a403f6a845ee",
                                                "text": "Que ce soit vers la Champagne mancelle au nord-ouest, le Maine angevin au sud, ou le Perche à l’est – dont le sépare la vallée de la Braye –, ses coteaux ont gardé la couverture boisée originelle."
                                            },
                                            {
                                                "example_id": "745528aa-5c34-45d1-a14e-4d3785823097",
                                                "sense_id": "ddee8823-07f3-3557-8956-a403f6a845ee",
                                                "text": "Or, en 1915, le professeur A. Lacroix découvrait dans des échantillons rapportés du nord-ouest de Madagascar, une roche comparable, mais non identique qu’il appela « fasibitikite »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a4feae0-5aca-38d9-8da3-6f30f1ae3968",
                                        "entry_id": "ade40b35-a280-3952-9888-dec5310a676b",
                                        "glosses": [
                                            "Vent qui souffle entre le nord et l’ouest."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8783dea-b0e6-4e67-ba70-299a6375fd8e",
                                                "sense_id": "2a4feae0-5aca-38d9-8da3-6f30f1ae3968",
                                                "text": "Le nord-ouest est ordinairement froid et pluvieux."
                                            },
                                            {
                                                "example_id": "5988a903-ded0-4f6f-8276-5a70a4d60e0a",
                                                "sense_id": "2a4feae0-5aca-38d9-8da3-6f30f1ae3968",
                                                "text": "Les sautes de vent incessantes continuaient bien à faire alterner les journées tièdes de pluie avec ces matins de gel ; mais chaque fois que le nord-ouest reprenait, il était un peu plus froid, cousin un peu plus proche des souffles glacés de l’hiver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nord-ouest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7094e923-c6f5-3f85-8da0-5ebfe7f10ca7",
                                        "entry_id": "7b6622ea-90e0-3922-8354-44ee4748989a",
                                        "glosses": [
                                            "Qui vient du nord-ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cddac1c5-5fbb-42ec-8664-e90339379ecc",
                                                "sense_id": "7094e923-c6f5-3f85-8da0-5ebfe7f10ca7",
                                                "text": "Le vent est nord-ouest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f865a68f-03bf-4202-801c-2a23b9acda16",
