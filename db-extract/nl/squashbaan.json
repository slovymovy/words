                        "glosses": [
                            "ruimte waarin squash kunt spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a8a841e-9a1f-49e0-8733-e7a271d0ab3f",
                                "sense_id": "194a7253-2499-3c77-9c87-90634c1bbf8e",
                                "text": "Een jacuzzi op het balkon? Een volledig aan rolstoelgebruik aangepast appartement? Een brede glazen trap naar de eerste of tweede verdieping? Een welnessruimte met dakterras? Of toch maar een thuisbioscoop met airconditioning? En wat doen we met de gemeenschappelijke ruimtes? Een inpandig zwembad of een squashbaan? Roept u maar! Nijhuis Bouw in Rijssen ontwiikkelt samen met woningcorporatie De Woonplaats een complex met 'droomappartementen' in de punt van de Lonnekerspoorlaan en Voortsweg is bijzonder in Enschede."
                            },
                            {
                                "example_id": "2a05178b-35e1-4a9d-972a-f47046669293",
                                "sense_id": "194a7253-2499-3c77-9c87-90634c1bbf8e",
                                "text": "De Fransman Mathieu Castagnet heeft misschien wel voor het knapste punt ooit op een squashbaan gezorgd. In zijn wedstrijd tegen de Engelsman Daryl Selby maakte hij met een enorme snoekduik een schier onmogelijke bal."
                            },
                            {
                                "example_id": "dfd62096-2ee4-419e-a316-0704fedf23dc",
                                "sense_id": "194a7253-2499-3c77-9c87-90634c1bbf8e",
                                "text": "Laurens Jan Anjema maakt donderdag zijn opwachting in de glazen squashbaan op het podium van het nieuwe Luxor Theater."
                            }
                        ]
                    }
