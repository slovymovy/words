                                                "sense_id": "e91b1ebd-b18f-3d96-b5aa-6485d234235a",
                                                "text": "„Sein Gesicht strahlte vor Selbstzufriedenheit.“"
                                            },
                                            {
                                                "example_id": "a339eb07-c4e2-4205-b58d-2c095a029a52",
                                                "sense_id": "e91b1ebd-b18f-3d96-b5aa-6485d234235a",
                                                "text": "„Eigentlich hätte er weiter nichts zu sagen brauchen, denn Julies Gesicht strahlte bereits von Triumph und Selbstzufriedenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
