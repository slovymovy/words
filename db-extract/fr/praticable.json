            {
                "entry_id": "99976deb-da0d-3169-97a7-1566c5737d89",
                "word": "praticable",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e75be177-421c-44ce-9353-35e6d2c1fd85",
                        "entry_id": "99976deb-da0d-3169-97a7-1566c5737d89",
                        "tags": [
                            "plural"
                        ],
                        "form": "praticables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                        "entry_id": "99976deb-da0d-3169-97a7-1566c5737d89",
                        "glosses": [
                            "Partie, le plus souvent mobile, d’un décor, qui n’est pas seulement figurée, mais aménagée de telle sorte que l’on puisse y aller et venir, monter et descendre comme dans une construction réelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9129064-bd25-466d-be3e-1164b93ccc38",
                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                "text": "Cette fois, les praticables s’effondraient en se tordant, les dessous flambaient pour tout de bon."
                            },
                            {
                                "example_id": "abadf622-54c3-42ac-bd27-0f42ca347928",
                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                "text": "L’homme au carnet avait quitté sa place et lestement escaladé les marches du praticable qui reliait le plateau à la salle."
                            },
                            {
                                "example_id": "b4164a0c-1261-4986-b5ba-930ad7787f1e",
                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                "text": "Et ce fut l'entrée de Manola... Il resta un instant sur le haut du praticable avant de descendre."
                            },
                            {
                                "example_id": "edc29a49-a5ec-48bf-b317-40fc208007eb",
                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                "text": "Un praticable d’un mètre de hauteur supportait une table équipée de micros et trois chaises."
                            }
                        ]
                    },
                    {
                        "sense_id": "78604330-ab14-34fe-87b4-03d0d0dc83e6",
                        "entry_id": "99976deb-da0d-3169-97a7-1566c5737d89",
                        "glosses": [
                            "Zone délimitée au sol sur laquelle les gymnastes réalisent un enchaînement acrobatique en gymnastique artistique ou rythmique."
                        ],
                        "tags": [
                            "Gymnastique"
                        ],
                        "examples": [
                            {
                                "example_id": "5ea2fdce-fa76-467d-bfd2-19f75508048b",
                                "sense_id": "78604330-ab14-34fe-87b4-03d0d0dc83e6",
                                "text": "En principe, le praticable sur lequel nous faisions notre mouvement au sol était constitué de ressorts, au dessus desquels il y avait un plancher et le tout était recouvert de tapis moelleux et d’une moquette."
                            },
                            {
                                "example_id": "e635ed86-78c0-4a67-8915-c5f65df6122d",
                                "sense_id": "78604330-ab14-34fe-87b4-03d0d0dc83e6",
                                "text": "Ils espèrent imiter Simone Biles, la reine de la gym, qui a vite retrouvé un niveau époustouflant, malgré deux ans loin des praticables."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
