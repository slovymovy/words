                        "examples": [
                            {
                                "example_id": "1bc732df-6717-425b-88c3-979b39b0e821",
                                "sense_id": "acc8096a-6f9e-349c-bf14-61d724a19061",
                                "text": "Ich gebe keinen Pfennig dafür.",
                                "translation": "我才不会花钱买这东西。"
                            },
                            {
                                "example_id": "2e7d7518-c04e-4bbd-bb03-8816db2682e6",
                                "sense_id": "acc8096a-6f9e-349c-bf14-61d724a19061",
                                "text": "Er drehte jeden Pfennig dreimal um, ehe er ihn ausgab.",
                                "translation": "他十分省钱。"
                            },
                            {
                                "example_id": "1fef4b3d-e74d-41fb-9e55-ee7a56d44bb4",
                                "sense_id": "acc8096a-6f9e-349c-bf14-61d724a19061",
                                "text": "Das ist keine fünf Pfennig/Pfennige wert.",
                                "translation": "这玩意半分钱都不值。"
                            }
                        ]
                    }
