                                "example_id": "94d4b92b-f43c-482c-ab30-3ea4d4b9cb7a",
                                "sense_id": "cf6e3ecf-28e9-3f1c-8da9-a256b85cf717",
                                "text": "„Sechs Tage in der Woche stellten sie ihre Netze auf und fingen Lachse und Störe, die mit der Flut flussaufwärts schwammen.“"
                            }
                        ],
