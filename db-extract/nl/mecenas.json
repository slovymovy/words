                "forms": [
                    {
                        "form_id": "7e9dc1af-80fa-4020-9b22-e7ccd75c8fde",
                        "entry_id": "356b5f01-f946-3628-91d7-eaaedcd4f1c2",
                        "tags": [
                            "plural"
                        ],
                        "form": "mecenassen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b263bf1c-0326-35a2-a9b5-0c7b3714bdb0",
                        "entry_id": "356b5f01-f946-3628-91d7-eaaedcd4f1c2",
                        "glosses": [
                            "iemand die kunstenaars en wetenschappers financieel ondersteunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1c8f34-43aa-4d6a-b836-f2a6d4136428",
                                "sense_id": "b263bf1c-0326-35a2-a9b5-0c7b3714bdb0",
                                "text": "Een geheimtip: als u de elektriseermachine bliksems wilt zien maken, moet u uw ticket op voorhand boeken op de webstek van het museum, én de bijkomende optie voor de ‘theatertour’ kiezen. Twee acteurs nemen u dan mee naar een voor het publiek gesloten deel van het woonhuis van mecenas Pieter Teyler, voor een (spannende) trip door leven en werk van Nobelprijswinnaar Hendrik Antoon Lorentz, begin vorige eeuw directeur van Teylers."
                            },
                            {
                                "example_id": "7f9e0cd0-d7f8-4583-860e-eaf3f17cb206",
                                "sense_id": "b263bf1c-0326-35a2-a9b5-0c7b3714bdb0",
                                "text": "Melchers, ook wel bekend als de mecenas van de Achterhoek, is boos en teleurgesteld. De 79-jarige steenrijke zakenman schonk Ruurlo het Willinkmuseum, dat eind juni zijn deuren opende. Dat kostte de gemeenschap geen cent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c301f2ed-44f7-4207-942a-aba626d64b9e",
                        "source_entry_id": "356b5f01-f946-3628-91d7-eaaedcd4f1c2",
                        "source_sense_id": "b263bf1c-0326-35a2-a9b5-0c7b3714bdb0",
                        "source_sense_description": "iemand die kunstenaars en wetenschappers financieel ondersteunt",
                        "target_lang_word": "Maecenas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maecenas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "317d2a41-ce6b-35e1-8795-4a8faa7deaa8",
                                        "entry_id": "dd7ad6a6-13c9-3e72-88df-cb97c35cfce5",
                                        "glosses": [
                                            "A generous benefactor; specifically, a patron of literature or art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499f05a9-2e0e-4c51-a9d0-9bd5dbfc6458",
                                                "sense_id": "317d2a41-ce6b-35e1-8795-4a8faa7deaa8",
                                                "text": "[…] thou art his dear and loving friend, good and gracious Lord and Master, his Maecenas."
                                            },
                                            {
                                                "example_id": "7e845d54-a6b8-4f4e-a2a9-7533c347a496",
                                                "sense_id": "317d2a41-ce6b-35e1-8795-4a8faa7deaa8",
                                                "text": "[O]ur young gentleman was shewn into another room, where half a dozen of his fellow-adherents waited for their Mæcenas, who in a few minutes appeared, with a most gracious aspect, received the compliments of the morning, and sat down to breakfast, in the midst of them, without any further ceremony."
                                            },
                                            {
                                                "example_id": "11d365f0-a584-44b7-b5cc-409813c3cbd7",
                                                "sense_id": "317d2a41-ce6b-35e1-8795-4a8faa7deaa8",
                                                "text": "The government […] maintained one of the largest armies in Europe; it developed what became, by the 1780s, a navy as big as the British; and it played the role of cultural Maecenas."
                                            },
                                            {
                                                "example_id": "b912a2b6-1b20-4223-b52a-89479ba2b14f",
                                                "sense_id": "317d2a41-ce6b-35e1-8795-4a8faa7deaa8",
                                                "text": "The contemporary art space created within the Palais de Tokyo (also home to the Paris Museum of Modern Art) is a pretty sad example of government as Maecenas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7715dd7-fddd-42bf-bc3e-cfb096fb1573",
                        "source_entry_id": "356b5f01-f946-3628-91d7-eaaedcd4f1c2",
                        "source_sense_id": "b263bf1c-0326-35a2-a9b5-0c7b3714bdb0",
                        "source_sense_description": "iemand die kunstenaars en wetenschappers financieel ondersteunt",
                        "target_lang_word": "mecenas",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mecenas",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2360d88c-c89a-3dc8-96b9-a16c5793afb9",
                                        "entry_id": "dda1e3d7-1e77-3f89-b406-db848f8d1a12",
                                        "glosses": [
                                            "Príncipe o persona poderosa que patrocina a literatos o artistas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e62e323-55ed-478b-b3f1-65904cc139e7",
                                                "sense_id": "2360d88c-c89a-3dc8-96b9-a16c5793afb9",
                                                "text": "Además, también se han recuperado las relaciones que mantuvieron entre sí y con mecenas y marchantes: de esta manera emerge otra historia del arte que completa el relato tradicional."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
