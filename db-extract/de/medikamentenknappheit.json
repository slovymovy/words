                                "example_id": "50ff3a77-2412-452d-b152-19bcd731a3b1",
                                "sense_id": "aa56ffc7-63b0-30ac-b341-d877a06ac16f",
                                "text": "„Die Corona-Ausbreitung hat die Medikamentenknappheit zusätzlich verschärft.“"
                            },
                            {
                                "example_id": "9375f8b0-fbcb-4550-b4ad-a91538044bfa",
                                "sense_id": "aa56ffc7-63b0-30ac-b341-d877a06ac16f",
                                "text": "„Es könnte dann zu teilweise leeren Lebensmittelregalen und Medikamentenknappheiten in Großbritannien kommen.“"
                            }
