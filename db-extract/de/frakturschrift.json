                ],
                "senses": [
                    {
                        "sense_id": "cfa5e0be-53d7-3080-8a1b-73847052bd86",
                        "entry_id": "df11fe48-b855-3849-8aa9-de66ced5105b",
                        "glosses": [
                            "die Schrift Fraktur"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3640d243-ae82-4b1d-9d88-62c5af4c9820",
                                "sense_id": "cfa5e0be-53d7-3080-8a1b-73847052bd86",
                                "text": "Ich kann die Frakturschrift so schlecht lesen."
                            },
                            {
                                "example_id": "1ec3cbf7-8a69-464c-9ec8-e36c07fd8533",
                                "sense_id": "cfa5e0be-53d7-3080-8a1b-73847052bd86",
                                "text": "„Die gotische und die im 15. Jahrhundert aus ihr entstehende (eigentliche) Frakturschrift bilden die Grundlage der deutschen Schrift, die erst in unserem Jahrhundert von der lateinischen als Schreibschrift und Druckschrift verdrängt wurde.“"
                            },
                            {
                                "example_id": "8f0dfc61-9cd1-4c4f-9035-78abcb6ce448",
                                "sense_id": "cfa5e0be-53d7-3080-8a1b-73847052bd86",
                                "text": "„Die Frakturschrift und ihre Abwandlungen waren nicht nur in Deutschland neben der Antiqua die hauptsächliche Buch- und Zeitungsschrift, sondern auch bei Polen, Tschechen, Slowaken und in den baltischen und skandinavischen Ländern gebräuchlich.“"
                            },
                            {
                                "example_id": "2765fa7f-91be-4c12-82b9-e18d3a5ac1ea",
                                "sense_id": "cfa5e0be-53d7-3080-8a1b-73847052bd86",
                                "text": "„Der eine R-Zettel weist einen Schriftsatz in Frakturschrift auf, während der andere in einer serifenlosen Groteskschrift gesetzt ist.“"
                            },
                            {
                                "example_id": "24644b44-40d9-4dd4-b054-e1f1796c3308",
                                "sense_id": "cfa5e0be-53d7-3080-8a1b-73847052bd86",
                                "text": "„Hier muss man berücksichtigen, dass es in den damaligen Handschriften und bei der Frakturschrift im Buch zwei Arten s gab: das lang-s und das rund-s.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0ce64ef-e2bf-3b11-8ad9-2d816dc8b3be",
                        "entry_id": "df11fe48-b855-3849-8aa9-de66ced5105b",
                        "glosses": [
                            "einzelne Schriftart aus der Fraktur-Gruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fe0752-4ecb-4223-87ba-81ec194b8f90",
                                "sense_id": "c0ce64ef-e2bf-3b11-8ad9-2d816dc8b3be",
                                "text": "Johann Gottlob Immanuel Breitkopf entwickelte eine berühmte Frakturschrift."
                            }
                        ],
