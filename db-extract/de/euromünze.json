                "senses": [
                    {
                        "sense_id": "c2bb0755-187f-31c1-b766-2dbfd9b96446",
                        "entry_id": "0da92d23-95b4-3dd3-936f-d2735d4f2da6",
                        "glosses": [
                            "Münze der Währung Euro"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82f3ef80-6eb2-4b9a-8b86-231c0a244d42",
                                "sense_id": "c2bb0755-187f-31c1-b766-2dbfd9b96446",
                                "text": "„Die Euromünzen wurden zusammen mit den Eurobanknoten ab dem 1. Januar 2002 eingeführt.“"
                            },
                            {
                                "example_id": "f4d5d94d-2a6f-4619-9012-dc8fbb04a6d9",
                                "sense_id": "c2bb0755-187f-31c1-b766-2dbfd9b96446",
                                "text": "„Signor Di Marco hält eine Euromünze hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1450da28-aad2-4a95-a3a7-db723ea4fa40",
                        "source_entry_id": "0da92d23-95b4-3dd3-936f-d2735d4f2da6",
                        "source_sense_id": "c2bb0755-187f-31c1-b766-2dbfd9b96446",
