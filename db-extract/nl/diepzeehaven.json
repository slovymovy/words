                        "glosses": [
                            "haven die vanuit de zee door grote zeeschepen bereikt kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8468b732-5204-4a01-800d-185db9af0444",
                                "sense_id": "5089178d-2c88-3fed-a50c-56f1860a6bce",
                                "text": "Uitbreiden: en dan vooral zo snel mogelijk de diepzeehaven van de Franse stad Cherbourg in handen krijgen."
                            },
                            {
                                "example_id": "18d157d1-ae6d-48d6-82e9-dbfcdbd868af",
                                "sense_id": "5089178d-2c88-3fed-a50c-56f1860a6bce",
                                "text": "De Brazilianen willen in de toekomst stroom uit Suriname en Guyana kunnen importeren. Daarnaast zijn er plannen voor een gaspijpleiding tussen de drie buurlanden, een diepzeehaven (in Guyana) en wegen. Met andere woorden: verregaande integratie tussen de drie landen, die ook de onderlinge handel moet stimuleren. Die is namelijk, ondanks de nabijheid, bescheiden."
                            }
                        ]
                    }
