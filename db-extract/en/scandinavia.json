                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58317417-b565-49a5-b849-ec4cceaa6ea2",
                                                "sense_id": "c973ec98-e82a-3b29-914c-7e4fbe605085",
                                                "text": "„Im 7. Jahrtausend dürfte auch Skandinavien eisfrei gewesen sein. In dieser Zeit folgte auf das Yoldia-Meer, das über Mittelschweden eine Verbindung zur Nordsee hatte, der sogenannte Ancylus-See.“"
                                            },
                                            {
                                                "example_id": "289cbc90-d6aa-4ff6-85d0-12be81ff61a1",
                                                "sense_id": "c973ec98-e82a-3b29-914c-7e4fbe605085",
                                                "text": "„Gleichzeitig könnte der Vulkanausbruch auch das Ende der Trichterbecherkultur in Skandinavien eingeläutet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
