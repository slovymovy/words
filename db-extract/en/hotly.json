                        "entry_id": "e7d56a4e-0107-3cb5-8e40-d5a2de68c143",
                        "glosses": [
                            "έντονα, σφοδρά, με τρόπο θυμωμένο ή έντονο, ή με πολύ ισχυρά συναισθήματα"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0361470-f3b2-4267-a195-da321c1442ce",
                                "sense_id": "2dfc3bfa-7afc-345f-a88a-0e669416fec3",
                                "text": "Immigration is currently a hotly debated topic.",
                                "translation": "Η μετανάστευση είναι αυτή τη στιγμή ένα θέμα που συζητείται έντονα."
                            },
                            {
                                "example_id": "d4e8d009-7284-4a5f-865d-2a208b4204a5",
                                "sense_id": "2dfc3bfa-7afc-345f-a88a-0e669416fec3",
                                "text": "The results were hotly disputed.",
                                "translation": "Τα αποτελέσματα αμφισβητήθηκαν έντονα."
                            },
                            {
                                "example_id": "b4c097c2-18a2-4fcb-9515-0e3fdf0d4540",
                                "sense_id": "2dfc3bfa-7afc-345f-a88a-0e669416fec3",
                                "text": "The proposal was hotly criticized by the opposition.",
                                "translation": "Η πρόταση σφοδρά επικρίθηκε από την αντιπολίτευση."
                            }
                        ]
                    },
                    {
                        "sense_id": "657abc82-5d0e-3c2b-b739-f259b86a2e74",
                        "entry_id": "e7d56a4e-0107-3cb5-8e40-d5a2de68c143",
                        "glosses": [
                            "σφοδρά, σθεναρά, με σφοδρότητα ή αποφασιστικότητα, με στόχο την επίτευξη επιτυχίας"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dedca8f8-ce68-4fa3-9d1e-66629da0bf02",
                                "sense_id": "657abc82-5d0e-3c2b-b739-f259b86a2e74",
                                "text": "The campaign was hotly contested by both sides.",
                                "translation": "Η εκστρατεία διεκδικήθηκε σφοδρά/σθεναρά και από τις δύο πλευρές."
                            }
                        ]
                    },
                    {
                        "sense_id": "b77d53d1-96aa-3db9-8b24-852c28c53fea",
                        "entry_id": "e7d56a4e-0107-3cb5-8e40-d5a2de68c143",
                        "glosses": [
                            "στενά, καταπόδας, με μεγάλη ταχύτητα, αμέσως μετά, συνήθως για καταδίωξη"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f4c660c-514b-4413-a6f5-a03046c54a01",
                                "sense_id": "b77d53d1-96aa-3db9-8b24-852c28c53fea",
                                "text": "She left the theater, hotly pursued by the Press.",
                                "translation": "Έφυγε από το θέατρο, καταδιωκόμενη στενά/καταπόδας από τον Τύπο."
                            }
                        ]
                    }
