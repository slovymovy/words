                        "target_lang_word": "embodiment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embodiment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30f2ecc7-a5ec-3b8c-b347-f1c5d9954052",
                                        "entry_id": "8a8cc5d7-9865-3550-adc9-8956e82ffc19",
                                        "glosses": [
                                            "The process of embodying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdc2da48-1e49-39f7-b085-bb5053dd697c",
                                        "entry_id": "8a8cc5d7-9865-3550-adc9-8956e82ffc19",
                                        "glosses": [
                                            "A physical entity typifying an abstract concept."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf40382f-c93c-4d3b-af85-0de57f639252",
                                                "sense_id": "cdc2da48-1e49-39f7-b085-bb5053dd697c",
                                                "text": "You are the very embodiment of beauty."
                                            },
                                            {
                                                "example_id": "c5763e5b-308a-4085-81cd-81f4426286ea",
                                                "sense_id": "cdc2da48-1e49-39f7-b085-bb5053dd697c",
                                                "text": "The law is the true embodiment / Of everything that's excellent. / It has no kind of fault or flaw, / And I, my Lords, embody the law."
                                            },
                                            {
                                                "example_id": "85be7034-587a-403d-9558-397a5917e960",
                                                "sense_id": "cdc2da48-1e49-39f7-b085-bb5053dd697c",
                                                "text": "And with his trademark smoking jackets and pipes – and the silk pajamas he would often wear to work – Hefner became the embodiment of a sexually adventurous yet urbane image and lifestyle, a seeming role model for generations of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f73cd31-e8ff-30aa-9f06-389ea36fbe55",
                                        "entry_id": "8a8cc5d7-9865-3550-adc9-8956e82ffc19",
                                        "glosses": [
                                            "The ways that knowledge, personality, culture, etc. are modulated by being experienced through a physical body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "686b38ec-f19f-4fe5-bdac-eb122e261ebd",
                                                "sense_id": "5f73cd31-e8ff-30aa-9f06-389ea36fbe55",
                                                "text": "In many respects, the genre [science fiction] was exceptionally well suited to extrapolate from contemporary social concerns and promote visions of alternative societies, new forms of embodiment, and novel pathways for desire and pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d58563a5-dad9-4c5a-a06e-c3e6a869441a",
                        "source_entry_id": "2a44d6b2-28a7-342c-8862-31440bfb4167",
                        "source_sense_id": "fe7a59d0-41b9-3c8d-b3d9-74bddd15aba3",
                        "source_sense_description": "Darstellung von etwas/jemand durch eine Figur mit ähnlichen/gleichen Eigenschaften",
                        "target_lang_word": "personification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A person, thing or name typifying a certain quality or idea; an embodiment or exemplification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1688a5c0-8aa1-4e7b-b1ae-e6869779f355",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "Adolf Hitler was the personification of anti-Semitism."
                                            },
                                            {
                                                "example_id": "41d88554-d9b9-46bc-9aed-53309f6c53fb",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "He might have sat for a personification of fear: if he moved, he seemed rather afraid of his own shadow following him too closely; if he laughed, he soon checked himself, quite alarmed at the sound."
                                            },
                                            {
                                                "example_id": "4fa256ba-c9b9-447e-8bda-6eacb7666477",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "De Coude was the personification of coolness—was he not the best shot in France?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A literary device in which an inanimate object or an idea is given human qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261f660c-c3b9-4669-8b3e-f55079e01faf",
                                                "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                                "text": "The writer used personification to convey her ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "An artistic representation of an abstract quality as a human"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c6de46-4d09-475e-a82f-9e63dfe8bc6e",
                                                "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                                "text": "The Grim Reaper is a personification of death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
