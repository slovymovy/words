                "senses": [
                    {
                        "sense_id": "00c6e80a-c32d-3447-808e-e9488a31cde5",
                        "entry_id": "8fb8973b-efd8-3c60-b8d2-1cc05f19cf9b",
                        "glosses": [
                            "Qui vibre ; qui est mis en vibration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43495c3-9acd-46cc-babd-056fc3e96c3a",
                                "sense_id": "00c6e80a-c32d-3447-808e-e9488a31cde5",
                                "text": "Onze heures sonnaient à Saint-Germain-l’Auxerrois. Maurevel compta l’un après l’autre chaque battement de marteau qui retentissait vibrant et lugubre dans la nuit […]"
                            },
                            {
                                "example_id": "c8fac266-1435-4add-ab44-6e0dcb9aea8f",
                                "sense_id": "00c6e80a-c32d-3447-808e-e9488a31cde5",
                                "text": "Dans le tamis vibrant électrique Hummer, les vibrations sont provoquées par voie électro-magnétique. Elles se produisent perpendiculairement à la surface tamisante […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7a5fdd60-8072-3f6c-a5da-65e86ba526ec",
                        "entry_id": "8fb8973b-efd8-3c60-b8d2-1cc05f19cf9b",
                        "glosses": [
                            "Qualifie une voix forte et puissante."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6cad55ab-a06d-44b3-bd5e-873a22f5e27d",
                                "sense_id": "7a5fdd60-8072-3f6c-a5da-65e86ba526ec",
                                "text": "À une table, un acteur de théâtre mal rasé réclama un bloody mary d’une voix un peu trop vibrante."
                            }
                        ]
                    },
                    {
                        "sense_id": "27c41cfd-2791-3b04-8e32-b91641a32bd8",
                        "entry_id": "8fb8973b-efd8-3c60-b8d2-1cc05f19cf9b",
                        "glosses": [
                            "Qualifie le pouls qui lorsqu’il est grand, dur, prompt et fréquent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "84ba4c3d-d16d-3598-b2e7-fc9e0ea6f58b",
                        "entry_id": "8fb8973b-efd8-3c60-b8d2-1cc05f19cf9b",
                        "glosses": [
                            "Qui est plein d’ardeur ; qui est plein de sentiment."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b3583d8f-4f05-4c5d-bd7a-a601063165fc",
                                "sense_id": "84ba4c3d-d16d-3598-b2e7-fc9e0ea6f58b",
                                "text": "Un discours vibrant."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae9f903a-1c7b-3b70-9935-8915a4ac55d3",
                        "entry_id": "8fb8973b-efd8-3c60-b8d2-1cc05f19cf9b",
                        "glosses": [
                            "En parlant d'un cheval, maniable, qui répond bien aux sollicitations, disponible et à l'écoute de son pilote."
