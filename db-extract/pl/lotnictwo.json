                    {
                        "translation_id": "c9ae85d6-d0e3-4401-bfa9-b534f89e3ed4",
                        "source_entry_id": "cfd26705-be69-39f2-b188-8f144244c9a9",
                        "source_sense_id": "f7e41b77-0b7c-3657-aa47-e0db41adac4a",
                        "target_lang_word": "aviation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aviation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8537cd6-3542-3918-a2a3-88656488c9cd",
                                        "entry_id": "134ce1c1-e717-348f-83f0-e16f594674f7",
                                        "glosses": [
                                            "Tout ce qui concerne l’emploi des avions."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc57cd83-d59d-47b3-a495-83bd9aedec45",
                                                "sense_id": "e8537cd6-3542-3918-a2a3-88656488c9cd",
                                                "text": "En aviation, c’est comme à la guerre : celui qui tient le plus longtemps est le vainqueur certain."
                                            },
                                            {
                                                "example_id": "9bd9dc1c-13dd-4706-9037-9bf51676eab8",
                                                "sense_id": "e8537cd6-3542-3918-a2a3-88656488c9cd",
                                                "text": "École d’aviation. — appareils d’aviation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9d1ea9e-2bf5-39af-85d0-7cd7770168ce",
                                        "entry_id": "134ce1c1-e717-348f-83f0-e16f594674f7",
                                        "glosses": [
                                            "Toute formation qui utilise les aéronefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d3913e-bdc3-484a-a1cb-6eca7717fdf3",
                                                "sense_id": "c9d1ea9e-2bf5-39af-85d0-7cd7770168ce",
                                                "text": "À l’instant où von Greim transmet l’ordre de Hitler d'ouvrir une brèche dans les lignes russes avec l’aviation, le pavillon rouge des Soviets flotte sur les trois-quarts de Berlin."
                                            },
                                            {
                                                "example_id": "04129037-7663-41b7-adb4-9c793e50ee69",
                                                "sense_id": "c9d1ea9e-2bf5-39af-85d0-7cd7770168ce",
                                                "text": "11 mai. — Comme le 10, l’aviation ennemie agit en force dès le matin, s'attaquant de façon plus méthodique aux positions et à leurs abords immédiats."
                                            },
                                            {
                                                "example_id": "d5241b00-1dc5-4dea-a8a4-75326e65010f",
                                                "sense_id": "c9d1ea9e-2bf5-39af-85d0-7cd7770168ce",
                                                "text": "Transmettez ceci à l'amiral Cotaloz: “Le général Petizos n'a plus d'aviation: nous avons abattu son appareil!”"
                                            },
                                            {
                                                "example_id": "f6eeaae1-6a50-495e-a35c-161c367b7b88",
                                                "sense_id": "c9d1ea9e-2bf5-39af-85d0-7cd7770168ce",
                                                "text": "Une dizaine d’aviations militaires à travers la planète utilisent des Global Express sous diverses configurations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76861834-0871-3f6a-ba19-c5a8a60dbf67",
                                        "entry_id": "134ce1c1-e717-348f-83f0-e16f594674f7",
                                        "glosses": [
                                            "Terrain d’aviation"
                                        ],
                                        "tags": [
                                            "Afrique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b654d9d2-2b16-4ad2-9bca-c73a1d279b8a",
                                                "sense_id": "76861834-0871-3f6a-ba19-c5a8a60dbf67",
                                                "text": "Aller à l'aviation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
