{
    "word_family": [
        "remarque",
        "remarquable",
        "remarquablement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a0e5f12-80b9-35d0-ae29-3ab4f80aa8e8",
                    "sense_definition": "Prendre conscience de quelque chose par la vue ou par l'esprit ; s'apercevoir de quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai tout de suite <w>remarqué</w> son absence lors de notre réunion d'hier matin."
                        },
                        {
                            "text": "Elle a vite <w>remarqué</w> un changement dans son comportement depuis quelques jours."
                        }
                    ],
                    "synonyms": [
                        "apercevoir",
                        "constater",
                        "noter"
                    ],
                    "antonyms": [
                        "ignorer"
                    ]
                },
                {
                    "sense_id": "a02de7a3-0585-3b18-8853-e330e4415a36",
                    "sense_definition": "Faire observer quelque chose à quelqu'un ; formuler une observation ou une réflexion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fait <w>remarquer</w> aux participants que la séance devait obligatoirement se terminer à midi."
                        },
                        {
                            "text": "« Cette solution comporte certains risques imprévus », <w>remarqua</w> prudemment le conseiller financier."
                        }
                    ],
                    "synonyms": [
                        "signaler",
                        "souligner"
                    ],
                    "common_phrases": [
                        "faire remarquer"
                    ]
                },
                {
                    "sense_id": "b11f4455-1f66-3ae7-b6ea-b878ff825db7",
                    "sense_definition": "Distinguer ou repérer quelqu'un ou quelque chose au milieu d'un groupe en raison d'une particularité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune joueur s'est fait <w>remarquer</w> par ses très belles passes pendant le match."
                        },
                        {
                            "text": "Elle a facilement été <w>remarquée</w> parmi la foule grâce à son manteau rouge vif."
                        }
                    ],
                    "synonyms": [
                        "distinguer",
                        "repérer"
                    ],
                    "common_phrases": [
                        "se faire remarquer"
                    ]
                },
                {
                    "sense_id": "7ad8dd7b-86c0-3ff2-9bb0-2b53caf87970",
                    "sense_definition": "Appliquer de nouveau une marque sur un objet ; <w>marquer</w> de nouveau.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan a dû <w>remarquer</w> toutes les pièces de bois pour faciliter leur assemblage final."
                        },
                        {
                            "text": "Après les intempéries, les géomètres ont <w>remarqué</w> à la peinture rouge les bornes effacées."
                        }
                    ]
                }
            ]
        }
    ]
}