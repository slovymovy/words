                                    },
                                    {
                                        "sense_id": "fbd14f42-3c35-363c-8f5f-775e1090afed",
                                        "entry_id": "60d7b5e2-8714-3723-916b-3b34408702d1",
                                        "glosses": [
                                            "Decline, degradation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32400731-7cc0-312a-a92c-42ccdbffc056",
                                        "entry_id": "60d7b5e2-8714-3723-916b-3b34408702d1",
                                        "glosses": [
                                            "A reaction that takes place in gelatinized starch when the amylose and amylopectin chains realign themselves, largely responsible for bread becoming stale."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "097ca525-f662-47a6-bec1-b0df8b0c0456",
                                                "sense_id": "32400731-7cc0-312a-a92c-42ccdbffc056",
                                                "text": "The major reason that bread stales is not moisture loss, but rather a process called retrogradation, in which the starch molecules in the bread crystallize."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52c8c4b2-541b-4709-bc96-389a5053346b",
                        "source_entry_id": "cbfe743f-d614-337d-9014-e670acfe83a3",
                        "source_sense_id": "cbfd5979-8e40-31f4-aeda-e2922d63d6e7",
                        "target_lang_word": "rétrogradation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétrogradation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d346152-1ce4-3423-8f35-8727a9ce4eb5",
                                        "entry_id": "7aacc5ee-8a47-3b92-818b-1b9b34c23215",
                                        "glosses": [
                                            "Mouvement rétrograde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f22bdda-1255-4478-a767-ce2c4bea9249",
                                                "sense_id": "0d346152-1ce4-3423-8f35-8727a9ce4eb5",
                                                "text": "Marx […] ne songeait pas qu'il pût se produire une révolution ayant un idéal de rétrogradation ou même de conservation sociale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2d1586-36f9-3a16-aa52-bb1fdb6dcea9",
                                        "entry_id": "7aacc5ee-8a47-3b92-818b-1b9b34c23215",
                                        "glosses": [
                                            "Mouvement apparent de recul d’une planète dans le ciel par rapport aux étoiles, observée depuis la Terre, due à la différence de vitesses orbitales entre la Terre et la planète observée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f75c207-e0ed-4344-82a9-894259f98f77",
                                                "sense_id": "2e2d1586-36f9-3a16-aa52-bb1fdb6dcea9",
                                                "text": "Une des observations les plus curieuses faites de tout temps sur la voûte céleste est la rétrogradation des planètes extérieures, tout particulièrement celle de Mars, la plus proche de la Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd147bf-fb51-3fff-b1d0-2ead23c8b6d7",
                                        "entry_id": "7aacc5ee-8a47-3b92-818b-1b9b34c23215",
                                        "glosses": [
                                            "Mouvement rétrograde des points équinoxiaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb8518d-3800-4d6c-8ea2-35d9dbc7fcdc",
                                                "sense_id": "6cd147bf-fb51-3fff-b1d0-2ead23c8b6d7",
                                                "text": "Les rétrogradations du soleil et de la lune peuvent survenir en raison de l’obliquité du ciel qui se trouve par moments contraint à obliquer ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8961c36a-7a0f-3ed4-8a60-50ea04c1d179",
                                        "entry_id": "7aacc5ee-8a47-3b92-818b-1b9b34c23215",
                                        "glosses": [
                                            "Mesure disciplinaire par laquelle un sous-officier est reporté à un grade inférieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e73f1627-5b9d-4ed6-9b32-e886ee4e5a99",
                                                "sense_id": "8961c36a-7a0f-3ed4-8a60-50ea04c1d179",
                                                "text": "Aujourd’hui même, je vais demander votre rétrogradation… Et vous irez dans l’autre compagnie donner un peu de tintouin au capitaine Trugex, qui a la réputation d’être un vrai meneur d’hommes, lui !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae711d0e-ae43-30ab-9264-eb385f946624",
                                        "entry_id": "7aacc5ee-8a47-3b92-818b-1b9b34c23215",
                                        "glosses": [
                                            "Déplacement à un rang inférieur, par exemple d’un professeur vers un poste moins élevé dans la hiérarchie ressentie de l’Éducation Nationale, ou d’un club sportif à une division inférieure."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f3c85b2-6d1c-40e4-91ea-1126af73ffda",
                                                "sense_id": "ae711d0e-ae43-30ab-9264-eb385f946624",
                                                "text": "À la rentrée, les six profs apprennent qu’en plus de la plainte au pénal le rectorat a engagé une procédure disciplinaire. Ils risquent un blâme, une rétrogradation ou, pire, une révocation."
                                            },
                                            {
                                                "example_id": "9e731e13-65ae-4066-af96-b8693a0c1810",
                                                "sense_id": "ae711d0e-ae43-30ab-9264-eb385f946624",
                                                "text": "Le CNOSF et la FFF ne sont pas obligés juridiquement de suivre le Tribunal : la décision de rétrogradation d’une division n’a pas été prise par la DNCG pour un état de cessation de paiement mais pour un non respect de l’engagement pris il y a un an sur le maintien des fonds propres et un manque de garanties sur le financement 2022-2023."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "182ec060-60ac-3317-bc1a-a84e93478df6",
                                        "entry_id": "7aacc5ee-8a47-3b92-818b-1b9b34c23215",
                                        "glosses": [
                                            "Fait de passer une vitesse inférieure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
