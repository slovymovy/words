                            {
                                "target_lang_word": "для готовки",
                                "target_lang_sense_clarification": "о продуктах или предметах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaa1aa45-6d73-36e1-89ef-9762d2aad9f2",
                    "sense_definition": "Of a lower quality, suitable for use as an ingredient in recipes rather than for drinking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't use the expensive wine; just use some <w>cooking</w> sherry for the sauce.",
                            "target_lang_translations": {
                                "ru": "Не используй дорогое вино; просто возьми немного <w>кулинарного</w> хереса для соуса."
                            }
                        },
                        {
                            "text": "The recipe calls for a splash of <w>cooking</w> brandy.",
                            "target_lang_translations": {
                                "ru": "По рецепту нужно добавить немного <w>бренди для готовки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cooking sherry",
                        "cooking wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более низкого качества, подходящий для использования в качестве ингредиента, а не для употребления в чистом виде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулинарный",
                                "target_lang_sense_clarification": "о вине или жирах низкого качества"
                            },
                            {
                                "target_lang_word": "для готовки",
                                "target_lang_sense_clarification": "не для питья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ba08572-2bbb-345a-8cd9-148ecba56a37",
                    "sense_definition": "Currently happening, in progress, or gaining momentum.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Now that the team is finally working together, things are really <w>cooking</w>.",
                            "target_lang_translations": {
                                "ru": "Теперь, когда команда наконец работает вместе, дела действительно <w>идут полным ходом</w>."
                            }
                        },
                        {
                            "text": "The party started slowly, but by midnight, the music was <w>cooking</w>.",
                            "target_lang_translations": {
                                "ru": "Вечеринка началась вяло, но к полуночи музыка уже вовсю <w>качала</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "really cooking"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe something going well or with energy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий в данный момент, находящийся в процессе развития или набирающий обороты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кипеть",
                                "target_lang_sense_clarification": "о бурной деятельности"
                            },
                            {
                                "target_lang_word": "идти полным ходом",
                                "target_lang_sense_clarification": "об успешном процессе"
                            }
                        ]
                    }
                }
            ]
        },
        {
