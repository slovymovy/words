                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7e240ce-458d-30ad-b9f2-45ddd86b24d0",
                        "entry_id": "b3319fb7-299b-3269-8d5c-d20f731be0ac",
                        "glosses": [
                            "Zutat, Inhaltsstoff, besonders in Bezug auf eine Arznei, auf eine zubereitete Speise oder eines Drinks"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc50f40-489c-4d4a-910a-784ae9842875",
                                "sense_id": "b7e240ce-458d-30ad-b9f2-45ddd86b24d0",
                                "text": "„Oft kommt es auf hauchzarte Nuancen der Ingredienzien an, oft sind die Ingredienzien halb so fein wie ihr Aroma.“"
                            },
                            {
                                "example_id": "74b32649-4b44-4b7d-957d-61ff63230c3d",
                                "sense_id": "b7e240ce-458d-30ad-b9f2-45ddd86b24d0",
                                "text": "„Er sah jetzt, wie die Knaben silberne Gefäße herbeitrugen und sie auf das Tischchen neben dem Altar stellten. Es roch sogleich nach Ölen, Zichorie und allen möglichen Kräutern. Fieberhaft arbeitete der Priester und mischte die Ingredienzien durcheinander.“"
                            },
                            {
                                "example_id": "3ce60b09-8746-4414-ab29-3cb235cda42e",
                                "sense_id": "b7e240ce-458d-30ad-b9f2-45ddd86b24d0",
                                "text": "„Allein die Geschichte Lydias hatte alle dramatischen und mysteriösen Ingredienzien, die ich von einer Liebe in Jericho erwartete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1aad167-2ecf-423f-8262-dd3fb65554a7",
                        "source_entry_id": "b3319fb7-299b-3269-8d5c-d20f731be0ac",
                        "source_sense_id": "b7e240ce-458d-30ad-b9f2-45ddd86b24d0",
                        "target_lang_word": "ingredient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingredient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                        "entry_id": "61292dd1-b7c0-3a21-9530-35062e8264e9",
                                        "glosses": [
                                            "One of the substances present in a mixture, especially food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "483ebca7-f0f3-4ab9-9bdc-b459c4ec416d",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "Holonyms: mixture; whole"
                                            },
                                            {
                                                "example_id": "d3c3f717-e24a-491e-9511-d66d8176dfdd",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "Near-synonyms: constituent, component"
                                            },
                                            {
                                                "example_id": "f3a18261-2409-4802-b4b1-3b5612e78474",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "The ingredients of a Spanish omelette are potatoes, eggs, onion, and a little salt."
                                            },
                                            {
                                                "example_id": "ca2aad46-263c-43a3-9f56-39edfa906c06",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "By way of analysis we may proceed from compounds to ingredients."
                                            },
                                            {
                                                "example_id": "718ad2e2-3509-48ef-a57a-b2163b38d0fe",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "Water is the chief ingredient in all the animal fluids and solids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                        "entry_id": "61292dd1-b7c0-3a21-9530-35062e8264e9",
                                        "glosses": [
                                            "A necessary element to achieve a certain goal; a component."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d132453a-2436-4f56-986d-55291288cf49",
                                                "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                                "text": "Holonym: end result"
                                            },
                                            {
                                                "example_id": "794acde7-8d1c-4675-8a0e-cc467c036e43",
                                                "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                                "text": "Innovation is just one ingredient for continued growth."
                                            },
                                            {
                                                "example_id": "ae57666d-af79-4e01-94a8-0559cad3d619",
                                                "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                                "text": "Patience and understanding are key ingredients for a long-lasting marriage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d680d6a4-2751-4cef-b0b2-e5c0cea0fc12",
                        "source_entry_id": "b3319fb7-299b-3269-8d5c-d20f731be0ac",
                        "source_sense_id": "b7e240ce-458d-30ad-b9f2-45ddd86b24d0",
                        "target_lang_word": "ingrédient",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingrédient",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a619c0bf-d37b-38f1-af8b-01dd06d3b3f9",
                                        "entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                                        "glosses": [
                                            "Chacune des substances, y compris les additifs alimentaires, qui entrent dans la composition d’un médicament, d’une boisson, d’un mets ou de quelque autre mélange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e171b8c-3952-4185-901b-a24a03497170",
                                                "sense_id": "a619c0bf-d37b-38f1-af8b-01dd06d3b3f9",
                                                "text": "Végétariens et végétaliens seront heureux d'apprendre que les veloutés, gâteaux et la plupart des wraps sont réalisés avec des ingrédients d’origine végétale."
                                            },
                                            {
                                                "example_id": "44a2481f-95a8-4482-9bfd-739ca25a34e4",
                                                "sense_id": "a619c0bf-d37b-38f1-af8b-01dd06d3b3f9",
                                                "text": "Pour le faumage façon « ricotta », mixez les ingrédients jusqu'à obtenir une consistance relativement lisse. Goûtez afin d'ajuster l'assaisonnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4b9ce5-00ee-3bdb-9438-8db4ebd65597",
                                        "entry_id": "af088e56-5eab-346c-9e94-4a260211c280",
                                        "glosses": [
                                            "Élément nécessaire à un état ou à la réussite d'une activité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78549b77-92d8-48d0-b279-f6ffef851672",
                                                "sense_id": "ad4b9ce5-00ee-3bdb-9438-8db4ebd65597",
                                                "text": "Depuis Ulysse et Pénélope, depuis Adam et Ève, nous nous racontons, de génération en génération, que l'amour, que le couple, est un ingrédient du bonheur."
                                            },
                                            {
                                                "example_id": "f4494cee-89fc-465f-a7c0-6f7e5f22017d",
                                                "sense_id": "ad4b9ce5-00ee-3bdb-9438-8db4ebd65597",
                                                "text": "Au-delà d'une bonne infrastructure logicielle, les deux ingrédients essentiels du télétravail, ce sont la souplesse et la confiance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
