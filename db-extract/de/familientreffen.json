                "senses": [
                    {
                        "sense_id": "cc7ed04c-42ad-3967-b0fb-b675bcc050c9",
                        "entry_id": "d891b885-d915-3f3f-96eb-c328bbd18d27",
                        "glosses": [
                            "Zusammenkunft mehrerer Verwandter, Familienangehöriger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c45de5-89fd-4fbd-a381-05ae599ebfd3",
                                "sense_id": "cc7ed04c-42ad-3967-b0fb-b675bcc050c9",
                                "text": "Anlässlich des Todes des Familienältesten wurde ein Familientreffen einberufen."
                            },
                            {
                                "example_id": "cb388843-aca9-4884-a9a5-c58999e9ec44",
                                "sense_id": "cc7ed04c-42ad-3967-b0fb-b675bcc050c9",
                                "text": "„Jeder zehnte Befragte gibt an, dass ihn die Familientreffen an der besinnlichen Jahreszeit am meisten stören.“"
                            },
                            {
                                "example_id": "5953f834-6f7c-4e0a-b5c1-238527da6a63",
                                "sense_id": "cc7ed04c-42ad-3967-b0fb-b675bcc050c9",
                                "text": "„Um an diesem Familientreffen in Weiß teilnehmen zu können, müssen wir eigentlich nur unsere Rückflüge umbuchen und ein paar Kleinigkeiten erledigen.“"
                            },
                            {
                                "example_id": "7d87df3f-60e5-46aa-8824-d6a3c42eb103",
                                "sense_id": "cc7ed04c-42ad-3967-b0fb-b675bcc050c9",
                                "text": "„Nach seinem zweiten Krankenhausaufenthalt erzählte der Mann den Ärzten, dass er einige Tage zuvor an einem Familientreffen in South Dakota teilgenommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
