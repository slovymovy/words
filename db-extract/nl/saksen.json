                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0556652e-bb27-4cfc-a48a-47cae140d896",
                                                "sense_id": "5f62a83f-d685-3e50-9eb8-50ccdf08d4e8",
                                                "text": "Dresden ist die Hauptstadt Sachsens."
                                            },
                                            {
                                                "example_id": "0486f5e0-07e6-4988-aed6-0d9c1cb52a4d",
                                                "sense_id": "5f62a83f-d685-3e50-9eb8-50ccdf08d4e8",
                                                "text": "„Sachsen […] hat nur 0,2 Prozent der Landesfläche für Windparks freigegeben, und in Bayern sind sogar nur 0,1 Prozent.“"
                                            },
                                            {
                                                "example_id": "c5260374-df10-4703-9798-ee84890c86bb",
                                                "sense_id": "5f62a83f-d685-3e50-9eb8-50ccdf08d4e8",
                                                "text": "Sachsen liegt im Südosten Deutschlands."
                                            },
                                            {
                                                "example_id": "34bedbbd-d7a1-4b6d-91aa-3caba8013bcd",
                                                "sense_id": "5f62a83f-d685-3e50-9eb8-50ccdf08d4e8",
                                                "text": "Ich bin in Sachsen geboren."
                                            },
                                            {
                                                "example_id": "4fab695c-1bcf-45fe-b39c-313574663a49",
                                                "sense_id": "5f62a83f-d685-3e50-9eb8-50ccdf08d4e8",
                                                "text": "Ich habe in Sachsen meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "ff2f2e6a-251c-41ca-a4ab-4e68887c72a1",
                                                "sense_id": "5f62a83f-d685-3e50-9eb8-50ccdf08d4e8",
                                                "text": "Nach Sachsen führen viele Wege."
                                            }
                                        ],
