                                    {
                                        "sense_id": "13177078-32e6-310d-ad37-4a45b377c622",
                                        "entry_id": "0c684cf5-ad60-36f4-8d11-68458c9070a3",
                                        "glosses": [
                                            "A device used to ram; a ramrod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8594f1a7-ee3d-4500-965b-3871673e979c",
                                                "sense_id": "13177078-32e6-310d-ad37-4a45b377c622",
                                                "text": "Now use your rammer to pack it tightly into the barrel."
                                            },
                                            {
                                                "example_id": "eda18477-6732-4d6d-b1e0-422c341a5fff",
                                                "sense_id": "13177078-32e6-310d-ad37-4a45b377c622",
                                                "text": "A \"mooner,\" fond of staring into shop windows, or watching the labourers pulling up the pavement to inspect the gas-pipes, or listening stolidly to the dull \"pech\" of the paviour's rammer on the flags."
                                            },
                                            {
                                                "example_id": "3cc513bf-b2a5-4c85-b0e4-151687832271",
                                                "sense_id": "13177078-32e6-310d-ad37-4a45b377c622",
                                                "text": "[…] I put my waterproof over the muzzle of one gun, and made a sort of wigwam with two or three rammers that I found, and lay along the tail of another gun […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d34b7563-4293-37a3-8c26-c133ecae8a0c",
                                        "entry_id": "0c684cf5-ad60-36f4-8d11-68458c9070a3",
                                        "glosses": [
                                            "One who, or that, rams."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03adeac7-81df-46e3-b21e-bc8cbc254b53",
                                                "sense_id": "d34b7563-4293-37a3-8c26-c133ecae8a0c",
                                                "text": "the Zeppelin Rammer"
                                            },
                                            {
                                                "example_id": "07c2c68e-314e-4034-872f-aa13e9e7fda0",
                                                "sense_id": "d34b7563-4293-37a3-8c26-c133ecae8a0c",
                                                "text": "The loader […] placed the cartridge in the muzzle and shoved it in as far as he could. The rammer rammed it home, the gun captain inserting his priming wire to make sure."
                                            }
                                        ]
