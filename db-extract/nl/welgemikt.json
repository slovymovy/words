                        "examples": [
                            {
                                "example_id": "2503a1c2-a5a5-42df-9bdf-691c4283d822",
                                "sense_id": "89a47acf-83b2-34e5-a774-419c891f6a25",
                                "text": "Als een sluipschutter zette ze alles en iedereen met een welgemikt schot schaakmat, haar ploegmaat annex grootste concurrente Annemiek van Vleuten incluis."
                            },
                            {
                                "example_id": "358f3801-5a0e-473b-8b59-9f7f22ff89b3",
                                "sense_id": "89a47acf-83b2-34e5-a774-419c891f6a25",
                                "text": "Een Nederlandse boordschutter heeft met een welgemikt schot uit een legerhelikopter vluchtende drugskoeriers ingerekend. De militair schoot tijdens een spectaculaire achtervolging in het Caribisch gebied de motor van het bootje aan flarden, waardoor de drugshandelaren geen kant meer op konden."
                            },
                            {
                                "example_id": "a815cdfd-db92-413b-8346-904a43bb3d27",
                                "sense_id": "89a47acf-83b2-34e5-a774-419c891f6a25",
                                "text": "Met een welgemikt schot slaagde zij erin de laatste vogel van dit weekend uit zijn lijden te verlossen. Kirsty Horstman eiste vrijdag de titel op bij zowel het groeps- en familieschieten als het dorpskoning(in) schieten."
                            }
