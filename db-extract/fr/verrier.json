                        "form": "verrière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                        "entry_id": "05213ec5-5da3-3dd2-9ec2-008d947d25e5",
                        "glosses": [
                            "Artisan qui fait du verre et des ouvrages de verre."
                        ],
                        "tags": [
                            "Métier",
                            "Verrerie"
                        ],
                        "note": "ne pas confondre avec vitrier",
                        "examples": [
                            {
                                "example_id": "3f1653a9-6a7b-44f4-b264-baa24fff7d1e",
                                "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                                "text": "Personne n’ignore, en effet, que les verriers sont tous gentils-hommes de naissance et ne montrent qu’à leurs fils le noble métier de souffleur."
                            },
                            {
                                "example_id": "7afe2a82-2658-4b94-9fec-b521bc8e36ed",
                                "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                                "text": "Et jamais, en somme, l’on n’a découvert le nom de l’un des premiers architectes, de l’un des sculpteurs, de l’un des verriers de cette cathédrale ?"
                            },
                            {
                                "example_id": "b300fbd4-88f7-43be-91cf-031c6f08f273",
                                "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                                "text": "Nos verriers de l’Est, reprend M. Daum, ont un tact parfait en ce genre de fabrication limonadière et du Nord au Midi les amateurs français en sont tributaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02aaf47b-a632-4094-b2d0-a95edb1fb233",
                        "source_entry_id": "05213ec5-5da3-3dd2-9ec2-008d947d25e5",
                        "source_sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
