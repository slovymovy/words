                ],
                "translations": [
                    {
                        "translation_id": "4fe6443d-42c8-49cc-9f0f-4cedf555a75f",
                        "source_entry_id": "ebb5edea-e3c5-3456-849c-c77fbc94f087",
                        "source_sense_id": "e3be035c-6404-3506-9a61-57a47072f8fa",
                        "source_sense_description": "een stevige, beschermende huls voor een bril",
                        "target_lang_word": "Brillenetui",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brillenetui",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85613524-1dd6-3cd5-af9e-fee0abf6ed7a",
                                        "entry_id": "c0ce6b8e-0d61-3b85-b46c-12f0189e39d3",
                                        "glosses": [
                                            "kleines, festes Behältnis für die Aufbewahrung einer Brille"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19ac360d-252b-47ba-9d22-c95504c03e9e",
                                                "sense_id": "85613524-1dd6-3cd5-af9e-fee0abf6ed7a",
                                                "text": "„Ein Antrag wurde laut dem Kurznachrichtendienst Twitter beispielsweise von einem Industriellen eingereicht, der unter anderem Waagen, Feuerlöscher und Brillenetuis herstellt.“"
                                            },
                                            {
                                                "example_id": "9544dab0-030b-4cb9-a30e-3d6c210297ae",
                                                "sense_id": "85613524-1dd6-3cd5-af9e-fee0abf6ed7a",
                                                "text": "„Der \"Tele-Art Fax Sender\", nicht größer als ein flaches Brillenetui, funktioniert an fast allen Fernsprechern, ohne daß ein spezieller Anschluß erforderlich wäre.“"
                                            },
                                            {
                                                "example_id": "4adf5254-32fa-4ed3-b894-c424d0977f81",
                                                "sense_id": "85613524-1dd6-3cd5-af9e-fee0abf6ed7a",
                                                "text": "„Erst als er Notizbuch, Stift, Brillenetui, Stirnlampe und Reiseführer in übersichtlicher Anordnung auf dem Boden platziert hatte – alle Gegenstände nach Größe sortiert und in einem 90-Grad-Winkel zur Wand – schien er sich zu entspannen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
