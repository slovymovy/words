                    {
                        "sense_id": "31e8190d-bfb1-3ae8-bf0b-54ff4c3aeb86",
                        "entry_id": "bc1dc878-6054-37f6-96f8-8afc833a53db",
                        "glosses": [
                            "To gleam, glisten, or coruscate."
                        ],
                        "tags": [
                            "archaic",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ded9419-7928-49f3-ba2f-835801403ee3",
                                "sense_id": "31e8190d-bfb1-3ae8-bf0b-54ff4c3aeb86",
                                "text": "All that gliſters is not gold."
                            },
                            {
                                "example_id": "bfd8d9cf-9a18-4bb7-90c2-a16f2880d500",
                                "sense_id": "31e8190d-bfb1-3ae8-bf0b-54ff4c3aeb86",
                                "text": "But, as the Phœnix on my Front doth gliſter, / Thou ſhalt the Finials of my Frame illuſtre."
                            },
                            {
                                "example_id": "f648ef6b-ad82-4e0c-be80-f45bb9214534",
                                "sense_id": "31e8190d-bfb1-3ae8-bf0b-54ff4c3aeb86",
                                "text": "[…] strangely she glistered in the sun / as she leaped forth in the sun […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
