                "senses": [
                    {
                        "sense_id": "ced28eec-bc2a-3529-ba91-2b46f4b743f7",
                        "entry_id": "de553266-a7de-3ad2-8ccb-a45fc7fc1cca",
                        "glosses": [
                            "Se dit d’une substance étrangère à une espèce donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32fea21a-efdd-494c-a498-719b1506d342",
                                "sense_id": "ced28eec-bc2a-3529-ba91-2b46f4b743f7",
                                "text": "\"Nous avons remarqué que des espèces bactériennes présentes dans nos échantillons de lait maternel avaient une fonction commune de destruction de substances étrangères, ou xénobiotiques, qui pourrait jouer un rôle de protection contre des toxines et des substances polluantes\", explique Emmanuel Gonzalez."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5aa6e4c-b81b-3030-bcb2-608336066c24",
                        "entry_id": "de553266-a7de-3ad2-8ccb-a45fc7fc1cca",
                        "glosses": [
                            "Se dit d’une substance étrangère à l’ensemble des organismes vivants."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f188cd91-4d68-3a14-9977-b8753237ffeb",
                        "entry_id": "de553266-a7de-3ad2-8ccb-a45fc7fc1cca",
                        "glosses": [
                            "Se dit d'un produit chimique se comportant comme un toxique ou un allergène vis-à-vis de l'organisme du patient où on le trouve."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
