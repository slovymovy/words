                                "target_senses": [
                                    {
                                        "sense_id": "2761a6bd-0a28-342a-9174-2b038a9f4842",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "Any hoofed mammal of the genus Capra."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c4f3224-a103-474c-8cbb-3d9547dbd296",
                                                "sense_id": "2761a6bd-0a28-342a-9174-2b038a9f4842",
                                                "text": "The first thing that greets you on entering the church is a notice asking you not to vex the goat, since it renders valuable service in keeping the churchyard tidy."
                                            },
                                            {
                                                "example_id": "ac8ea1e7-1c9e-4153-8190-b44bd7cb055e",
                                                "sense_id": "2761a6bd-0a28-342a-9174-2b038a9f4842",
                                                "text": "Folkestone: Network Rail and the White Cliffs Countryside Project have procured a herd of goats to keep vegetation on the slopes of Folkestone Warren under control, and to encourage rare species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf38e7b-a0ac-3949-b79f-4b107d1d12b5",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "Any hoofed mammal of the genus Capra.",
                                            "The meat of the aforementioned animal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ccf72d9-80c6-423b-b331-28467fc2fa49",
                                                "sense_id": "bcf38e7b-a0ac-3949-b79f-4b107d1d12b5",
                                                "text": "Ugh, we're having goat for dinner again."
                                            },
                                            {
                                                "example_id": "1ba148bd-c0b9-4865-9a95-82d64c4cff21",
                                                "sense_id": "bcf38e7b-a0ac-3949-b79f-4b107d1d12b5",
                                                "text": "Joshua could not stop himself from scooping more goat on his plate: Paul had cooked it so long that the meat seemed to melt like hot, syrupy candy in his mouth. Joshua remembered goat as a stringy dark meat, but the red spicy mass before him was nothing like he recalled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f68f6e-69de-38e5-be5f-9bc2dfa4252c",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "A lecherous man."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "614b8456-ca1b-34c4-892b-31378d5d8bee",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "A scapegoat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "021eb5aa-e840-41db-a54b-89b32014f7fa",
                                                "sense_id": "614b8456-ca1b-34c4-892b-31378d5d8bee",
                                                "text": "Fernando Rodney, the goat in Sunday's 10th inning loss to Tampa Bay, threw three nearly perfect innings in relief on Tuesday after being demoted from the closer role."
                                            },
                                            {
                                                "example_id": "ee6fe44f-dc83-46e8-bd60-536b1d6cb92d",
                                                "sense_id": "614b8456-ca1b-34c4-892b-31378d5d8bee",
                                                "text": "1997, \"1997 World Series\", Game 7, bottom 11th inning, TV broadcast on NBC Sports, early morning October 27, 1997; words by Bob Costas\nTony Fernández, who has worn hero's laurels throughout the postseason including earlier in this seventh game of the World Series, now cruel as it may seem, perhaps being fitted for goat horns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b4b19a-d2b1-307d-b299-da98776438a5",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "A Pontiac GTO car."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f876f23f-9af5-351d-8e7d-c8ba56f4f4c7",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "A person who is not easily understood by a speech recognition system; contrasted with sheep."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8698554-6de8-3a05-ad92-20f4b46fb995",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "A fool, loser, or object of ridicule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1e8d5b2-3bca-4517-8f38-75e67cb4ca1f",
                                                "sense_id": "b8698554-6de8-3a05-ad92-20f4b46fb995",
                                                "text": "Samaurez said over his shoulder, “In fact, I missed being the class goat by only three places.” Gwen patted his arm, “But, look H-Two, George Pickett was the goat and see how famous he became.”"
                                            },
                                            {
                                                "example_id": "67734352-4cb7-4556-93b4-07e9133be8a1",
                                                "sense_id": "b8698554-6de8-3a05-ad92-20f4b46fb995",
                                                "text": "...Butch was the goat in that deal and innocent of the trap he was placed in."
                                            },
                                            {
                                                "example_id": "b2fd5e1f-8ee2-4661-a914-914563211e52",
                                                "sense_id": "b8698554-6de8-3a05-ad92-20f4b46fb995",
                                                "text": "“If Osterman wants to play the goat, why should you help him out?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aed2219a-7010-39fd-9b90-b64e7d65ae9f",
                                        "entry_id": "82dd6286-3010-3154-b80b-f39e291e9c32",
                                        "glosses": [
                                            "A blocker who is isolated behind the opposing team's blockers, so as to slow down the pack."
                                        ],
