                    {
                        "sense_id": "b36df5f9-d689-3cdb-84a0-834729703422",
                        "entry_id": "c2a1c86d-9c4b-32c7-b0e6-6218a439d7c2",
                        "glosses": [
                            "een vernieuwde, verbeterde versie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5237acf5-4042-4d39-9980-7e73f076edcd",
                                "sense_id": "b36df5f9-d689-3cdb-84a0-834729703422",
                                "text": "Updates maakten de huidige LHC steeds een beetje sterker. Op termijn loopt men met de huidige versneller echter tegen een grens op. De FCC zal door zijn grotere formaat deeltjes met grofweg tienmaal meer energie op elkaar kunnen schieten dan het maximum van de LHC."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8219e79-e1c2-3123-9d82-b1867cc43af7",
                        "entry_id": "c2a1c86d-9c4b-32c7-b0e6-6218a439d7c2",
                        "glosses": [
                            "een gemoderniseerde versie van een computerprogramma"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35be73cc-f2ad-442a-8b43-74105aa55ed4",
                                "sense_id": "d8219e79-e1c2-3123-9d82-b1867cc43af7",
                                "text": "Er is een update voor dit programma beschikbaar. Wilt u deze nu downloaden?"
                            },
                            {
                                "example_id": "47f40ebf-e845-4531-a3fe-27058bdabaaf",
                                "sense_id": "d8219e79-e1c2-3123-9d82-b1867cc43af7",
                                "text": "De Marshelikopter Ingenuity van NASA heeft na ruim een jaar 28 vluchten gemaakt, maar maakt zich nu op voor een zware winter op de rode planeet. NASA moet een update doorvoeren voordat de helikopter opnieuw kan vliegen. Op dit moment wordt hij door een sensorfout aan de grond gehouden."
                            }
                        ]
                    }
                ],
