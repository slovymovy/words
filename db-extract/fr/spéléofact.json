                                    {
                                        "sense_id": "05526c4c-45fb-3b5b-b614-2d0bdf5705ce",
                                        "entry_id": "4d2f8f06-aa66-396d-8bb7-d1ee1b00b2fc",
                                        "glosses": [
                                            "item deliberately extracted from a speleothem for the purpose of usage in a particular function"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd1f79ab-0474-4422-a012-2bc2cb4be812",
                                                "sense_id": "05526c4c-45fb-3b5b-b614-2d0bdf5705ce",
                                                "text": "Speleofacts, like artifacts, are formed by removal of material, addition of material, or both. Speleofacts are of two general types: speleogens, such as scour troughs, dome-pits, and drip pockets, form by solution and corrasion excavating cave rock and sediments; speleothems, such as flowstone, stalactites, and cave pearls, form by deposition of calcite within the cave."
                                            },
                                            {
                                                "example_id": "0e26c8da-5803-45e0-9b86-260e2f2de7ba",
                                                "sense_id": "05526c4c-45fb-3b5b-b614-2d0bdf5705ce",
                                                "text": "Note that the burnt bone was covered by a reddish and blackened speleofact"
                                            },
                                            {
                                                "example_id": "e36ffa23-e96a-4fc2-80a8-618a3a1a3d36",
                                                "sense_id": "05526c4c-45fb-3b5b-b614-2d0bdf5705ce",
                                                "text": "Prehistoric humans intentionally modified stalagmites in the Cova Dones cave in Spain, forming over 100 structures—known as speleofacts—as a result."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
