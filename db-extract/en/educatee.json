                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dddfd39f-2e26-4cb2-bfee-cde3c7814989",
                        "source_entry_id": "d596a7a6-e298-33ad-a293-600307997e00",
                        "source_sense_id": "1b7c39a2-856d-3689-9438-228e01ad351b",
                        "source_sense_description": "someone who is being educated",
                        "target_lang_word": "Schüler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schüler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                        "entry_id": "1c373418-5fed-31bb-b5a0-b034582e9e54",
                                        "glosses": [
                                            "Person, die eine Schule besucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "756b3195-86f9-4ed4-828f-f77f1fa0a43d",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "„Denn seit die Kultusministerkonferenz die Vereinbarung aufgehoben hat, Musik in der Sekundarstufe I als Pflichtfach zu unterrichten, ist es vielerorts nur mehr Wahlpflichtfach – und die Schüler wählen es in der siebten Klasse ab.“"
                                            },
                                            {
                                                "example_id": "206527c1-d27c-4d45-9c11-b460b9212e56",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "Oft arbeiteten die Schüler bis tief in die Nacht."
                                            },
                                            {
                                                "example_id": "0b7831e9-26c0-4bfb-8006-0f591fe40000",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "„Ich war ein miserabler Schüler.“"
                                            },
                                            {
                                                "example_id": "7e5073c5-55c5-4e1c-b10e-05b5361965ad",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "Dank höherer Geburtenraten und Zuwanderung wird die Zahl der Schüler in Deutschland in den nächsten Jahren deutlich ansteigen."
                                            },
                                            {
                                                "example_id": "2ab58b05-c377-4071-b961-0ed56602783a",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "Haben ihre Schüler bei der Grammatik ein Aha-Erlebnis, fühlt sich die Lehrerin in ihrer Arbeit bestätigt."
                                            },
                                            {
                                                "example_id": "5d6ec078-b767-4178-a810-c2dc03d90af9",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "Im niedersächsischen Landkreis Cloppenburg ist ein Schüler während des Unterrichts im Schwimmbad ertrunken."
                                            },
                                            {
                                                "example_id": "3d80094f-f12e-4642-ae6b-f5491f67ec14",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "„Wie John feststellte, waren seine beiden Schüler ungefähr gleich begabt, nur besaß Jako eine etwas bessere Auffassungsgabe als sein Mitschüler.“"
                                            },
                                            {
                                                "example_id": "67df6698-a502-4934-ab2f-0801ed94b179",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "Sie geben nicht auf: Nach dem „March for Our Lives“ organisieren die Schüler, die das Massaker an einer Schule im US-amerikanischen Parkland überlebt haben, die nächste große Protestaktion für mehr Waffenkontrolle."
                                            },
                                            {
                                                "example_id": "a3795444-0084-43bf-a0fa-a0a669fa0bb6",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "In einer Studie der DAK-Gesundheit gaben 43 Prozent der deutschen Schüler an, unter Stress zu leiden. […] Regelmäßig beklagen sich mindestens ein Drittel der Schüler über Kopfschmerzen, Schlafprobleme und Rückenschmerzen."
                                            },
                                            {
                                                "example_id": "8eb27d3b-16df-495c-b51e-ab6b74097e4c",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "Schüler von fünf Schulen in Niedersachsen haben am Dienstag in den Weltraum gefunkt und mit dem deutschen Astronauten Alexander Gerst auf der Internationalen Raumstation (ISS) gesprochen."
                                            },
                                            {
                                                "example_id": "3e215119-8257-49e7-a352-9b5f70e015e2",
                                                "sense_id": "828c499b-1f73-3458-9ca7-57d4d3b96a7f",
                                                "text": "[Privatschulen als Reparaturwerkstatt sind für diese] ein Problem, da sie nicht auf verhaltensauffällige Schüler ausgerichtet seien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05e76b44-2f28-305b-bc40-1767d04fbb9b",
                                        "entry_id": "1c373418-5fed-31bb-b5a0-b034582e9e54",
                                        "glosses": [
                                            "jemand, der die Lehren eines bestimmten Lehrers vertritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c3d9e0-14f6-4a63-b2cb-d4f33c992daa",
                                                "sense_id": "05e76b44-2f28-305b-bc40-1767d04fbb9b",
                                                "text": "Platon war der berühmteste Schüler des Sokrates."
                                            },
                                            {
                                                "example_id": "21093b03-717c-4427-9595-79a7da57288d",
                                                "sense_id": "05e76b44-2f28-305b-bc40-1767d04fbb9b",
                                                "text": "Euathlos war ein Schüler des antiken griechischen Sophisten Protagoras, der im 5. Jahrhundert v. Chr. lebte."
                                            },
                                            {
                                                "example_id": "bb796d28-925f-4485-97a5-093cce4d4d10",
                                                "sense_id": "05e76b44-2f28-305b-bc40-1767d04fbb9b",
                                                "text": "Die größten Schüler Freuds waren C. G. Jung und Alfred Adler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
