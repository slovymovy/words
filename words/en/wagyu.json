            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6e49c38-1178-3e3d-81a1-90d42714c700",
                    "sense_definition": "High-quality beef obtained from certain Japanese cattle breeds, known for its rich flavor and heavy marbling of fat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cattle_and_meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant is famous for serving tender <w>wagyu</w> cooked over charcoal.",
                            "target_lang_translations": {
                                "zh": "这家餐厅以供应炭烤鲜嫩<w>和牛</w>而闻名。"
                            }
                        },
                        {
                            "text": "He decided to order a <w>wagyu</w> burger despite the high price on the menu.",
                            "target_lang_translations": {
                                "zh": "尽管菜单上的价格很高，他还是决定点一个<w>和牛</w>汉堡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Kobe"
                    ],
                    "common_phrases": [
                        "wagyu beef",
                        "wagyu burger",
                        "wagyu steak"
                    ],
                    "target_lang_definitions": {
                        "zh": "源自特定日本品种牛的高品质牛肉，以其浓郁风味和丰富的大理石油花著称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "和牛",
                                "target_lang_sense_clarification": "牛肉"
                            },
                            {
                                "target_lang_word": "和牛肉",
                                "target_lang_sense_clarification": "牛肉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7a5da12-b24d-3897-b81b-f9e3e5e87233",
                    "sense_definition": "Any of several breeds of cattle native to Japan, bred specifically to produce meat with a high percentage of unsaturated fat and intense marbling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cattle_and_meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers raise <w>wagyu</w> in quiet environments to ensure the animals stay stress-free.",
                            "target_lang_translations": {
                                "zh": "农户在安静的环境中饲养<w>和牛</w>，以确保它们不受压力。"
                            }
                        },
                        {
                            "text": "Several ranches in Australia now specialize in breeding fullblood Japanese <w>wagyu</w>.",
                            "target_lang_translations": {
                                "zh": "澳大利亚的几个牧场现在专门繁殖纯种日本<w>和牛</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wagyu cattle"
                    ],
                    "target_lang_definitions": {
                        "zh": "原产于日本的数种肉牛品种的统称，专门培育以生产具有高度不饱和脂肪和大理石油花的肉质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "和牛",
                                "target_lang_sense_clarification": "牛的品种或活牛"
                            },
                            {
                                "target_lang_word": "日本牛",
                                "target_lang_sense_clarification": "牛的品种"
                            }
                        ]
                    }
                }
            ]
        }
