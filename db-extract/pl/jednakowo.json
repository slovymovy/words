                    {
                        "sense_id": "ab6ba921-736a-325d-8eae-be796d51c59b",
                        "entry_id": "f14e70f7-4a5c-3ce2-9ec4-52e4fb3854e6",
                        "glosses": [
                            "tak samo, identycznie, w taki sam sposób"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92034087-b2dc-4690-98f0-2d52ab13906f",
                                "sense_id": "ab6ba921-736a-325d-8eae-be796d51c59b",
                                "text": "Z siostrą zawsze ubieramy się jednakowo, bo jesteśmy bliźniaczkami."
                            },
                            {
                                "example_id": "307c1fc4-31dd-4226-8a2d-45a3992cbb7d",
                                "sense_id": "ab6ba921-736a-325d-8eae-be796d51c59b",
                                "text": "On bowiem stworzył małego i wielkiego / i jednakowo o wszystkich się troszczy, / ale możnym grozi surowe badanie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60192e9f-5047-48e2-b1db-1617afc83235",
                        "source_entry_id": "f14e70f7-4a5c-3ce2-9ec4-52e4fb3854e6",
                        "source_sense_id": "ab6ba921-736a-325d-8eae-be796d51c59b",
                        "target_lang_word": "identically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70c7e356-0a7c-37ea-8439-75194735bcc7",
                                        "entry_id": "44e3fff1-affa-3e46-ba8d-94db2a3864af",
                                        "glosses": [
                                            "In an identical manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45514da4-d827-487b-a924-a4fbd7d47843",
                                                "sense_id": "70c7e356-0a7c-37ea-8439-75194735bcc7",
                                                "text": "It was hard to tell the twins apart: they even spoke identically."
                                            },
                                            {
                                                "example_id": "6e914930-cbcf-4e67-9964-3327a33e0443",
                                                "sense_id": "70c7e356-0a7c-37ea-8439-75194735bcc7",
                                                "text": "It was inevitable that such a system should lead to the wide use of nicknames to distinguish identically named members of a family[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36bbc59d-311c-3125-9d4a-c0491977d7e5",
                                        "entry_id": "44e3fff1-affa-3e46-ba8d-94db2a3864af",
                                        "glosses": [
                                            "In terms of an identity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdf6e97-d597-4210-9ad8-99c243089563",
                                                "sense_id": "36bbc59d-311c-3125-9d4a-c0491977d7e5",
                                                "text": "two expressions that are identically equal to each other"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7317ec3-2c30-4e5f-9f92-c2bb44f0999a",
                        "source_entry_id": "f14e70f7-4a5c-3ce2-9ec4-52e4fb3854e6",
                        "source_sense_id": "ab6ba921-736a-325d-8eae-be796d51c59b",
                        "target_lang_word": "uniformément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uniformément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "089a8245-2588-30c0-a84d-27c873c2c0aa",
                                        "entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                                        "glosses": [
                                            "D’une manière uniforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebedc9a3-6964-41a6-beb4-4f465d19ce91",
                                                "sense_id": "089a8245-2588-30c0-a84d-27c873c2c0aa",
                                                "text": "Tous les habitants de ce village sont vêtus uniformément,"
                                            },
                                            {
                                                "example_id": "2ce40c85-d806-4e6a-b13f-b25d9c1e737d",
                                                "sense_id": "089a8245-2588-30c0-a84d-27c873c2c0aa",
                                                "text": "Nous avons disposé de DNTBP et de DNOC uniformément marqués au ¹⁴C sur le noyau benzénique. La pénétration foliaire et racinaire, ainsi que la translocation du DNTBP sont lentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26938581-f28e-36d5-973d-291ce2ddb006",
                                        "entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                                        "glosses": [
                                            "Toujours égal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b08d6035-a933-47b4-bad1-d8db3e84deda",
                                                "sense_id": "26938581-f28e-36d5-973d-291ce2ddb006",
                                                "text": "Dans le deuxième cas, montrer que le mouvement est uniformément accéléré en vérifiant que la vitesse varie linéairement avec le temps (v = at + b) ou, ce qui est équivalent, en vérifiant que les intervalles entre les points forment une progression arithmétique de raison r = a(Δt)²."
                                            },
                                            {
                                                "example_id": "c63a39ee-e8c1-47cd-b2ea-0cbee001485d",
                                                "sense_id": "26938581-f28e-36d5-973d-291ce2ddb006",
                                                "text": "Le mouvement uniformément varié est celui dans lequel la vitesse varie proportionnellement au temps ; uniformément accéléré, si la vitesse va en augmentant ; uniformément retardé, si elle va en diminuant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "245218a8-6b76-4e1a-9f6f-031866ecfd20",
                        "source_entry_id": "f14e70f7-4a5c-3ce2-9ec4-52e4fb3854e6",
                        "source_sense_id": "ab6ba921-736a-325d-8eae-be796d51c59b",
                        "target_lang_word": "gleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
