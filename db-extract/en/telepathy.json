                                "target_senses": [
                                    {
                                        "sense_id": "55f08b8e-8517-37b2-b532-ec3d5e0b53ba",
                                        "entry_id": "d3423ea5-4c71-3aa0-ae1b-baf63a1ebb04",
                                        "glosses": [
                                            "die Fähigkeit zu wissen, was eine andere Person denkt; der Versuch, fremde Gedanken zu erraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee87ab7-2de9-42f0-9c7c-50602addae59",
                                                "sense_id": "55f08b8e-8517-37b2-b532-ec3d5e0b53ba",
                                                "text": "Er verblüffte sein Publikum mit Gedankenlesen."
                                            },
                                            {
                                                "example_id": "0f6dbc19-f9ba-4011-947a-f879443545ef",
                                                "sense_id": "55f08b8e-8517-37b2-b532-ec3d5e0b53ba",
                                                "text": "„Eine primitive Form des Gedankenlesens ist ja heute bereits möglich - mit den bildgebenden Verfahren in der Medizin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
