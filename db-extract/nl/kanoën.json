                        ],
                        "examples": [
                            {
                                "example_id": "216545dc-9e0f-4158-b610-d175d06a1306",
                                "sense_id": "77368c0b-d494-3243-b190-86c676d6bf1c",
                                "text": "En bovendien, ze had al een vriend, die zou woedend zijn, als hij hoorde, dat ze met een jongen uit haar klas gekanood en gezwommen en gevrijd had!"
                            },
                            {
                                "example_id": "e715e304-0eb3-48b1-89ab-30316d8d81a4",
                                "sense_id": "77368c0b-d494-3243-b190-86c676d6bf1c",
                                "text": "Kanoën is een kleine sport in Nederland, maar wereldwijd erg populair. De kanobond koestert de talenten in de aanloop naar de Spelen van Londen in 2012."
                            }
                        ]
                    },
                    {
                        "sense_id": "52682524-0e88-38ce-90d6-1b918063139a",
                        "entry_id": "3d1e1d33-3067-3fb3-b879-ac52cc4413f3",
                        "glosses": [
                            "zich per kano ergens naartoe begeven."
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "411e7dfa-2f00-47c0-8077-93fdafec16ec",
                                "sense_id": "52682524-0e88-38ce-90d6-1b918063139a",
                                "text": "Ze waren naar het eilandje gekanood."
                            }
                        ]
