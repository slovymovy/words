                "senses": [
                    {
                        "sense_id": "6a02b9f4-4250-3162-9942-209a31225141",
                        "entry_id": "43b7b729-d641-335d-afe3-59195103d41d",
                        "glosses": [
                            "Betrieb, der Bauarbeiten durchführt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "385d0ae8-e3c3-45b2-9c0f-b9e23227db77",
                                "sense_id": "6a02b9f4-4250-3162-9942-209a31225141",
                                "text": "Der Bürgermeister und die Baufirma legten gestern den Grundstein für die neue Turnhalle."
                            },
                            {
                                "example_id": "1b67c968-47e9-4c2a-be7e-aa64889613b1",
                                "sense_id": "6a02b9f4-4250-3162-9942-209a31225141",
                                "text": "„Die Baufirmen melden die höchsten Umsätze seit über 20 Jahren.“"
                            },
                            {
                                "example_id": "a9ceda95-5e62-4028-8ae4-59ba7fbdaf19",
                                "sense_id": "6a02b9f4-4250-3162-9942-209a31225141",
                                "text": "„Nicht lange nach seiner Gesellenprüfung ging die Baufirma in Konkurs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
