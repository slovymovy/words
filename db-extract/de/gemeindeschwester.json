                        "entry_id": "c08ab0b2-70f6-30c7-920f-b435c1b3009a",
                        "glosses": [
                            "für eine Gemeinde zuständige Krankenschwester, die oft ambulant tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e85430c-e5b1-4647-83d5-e71c2f19db43",
                                "sense_id": "ebbe977f-4fa8-3213-915f-a28829a6cd3b",
                                "text": "„Die thüringische Landesregierung könne sich durchaus die flächendeckende Einführung von Gemeindeschwestern vorstellen, um die Versorgung im ländlichen Raum zu stabilisieren, so Ramelow.“"
                            },
                            {
                                "example_id": "d240abe3-789a-4baa-b4c3-81df7a1f4a32",
                                "sense_id": "ebbe977f-4fa8-3213-915f-a28829a6cd3b",
                                "text": "„Noch am Ankunftstag sah die Gemeindeschwester, Schwester Mariechen, nach ihr.“"
                            }
                        ],
