                ],
                "senses": [
                    {
                        "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                        "entry_id": "131ba514-2958-3794-8e2f-e7fd2dcd1f5c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef65df13-64b0-43a1-bd26-df899529f27c",
                                "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                                "text": "Frau Ihde ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ade3fc2e-9596-4c4a-bd1d-bfe97f89a955",
                                "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                                "text": "Herr Ihde wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "786c3c6e-3be8-47f8-af6e-004cf687625c",
                                "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                                "text": "Die Ihdes kommen heute aus Vorarlberg."
                            },
                            {
                                "example_id": "c91388da-7167-48ed-934d-b228e69fbbe8",
                                "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                                "text": "Der Ihde trägt nie die Schals, die die Ihde ihm strickt."
                            },
                            {
                                "example_id": "d670e2a5-0b5e-46e6-bd17-f0956a6adad4",
                                "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ihde kommt, geht der Herr Ihde.“"
                            },
                            {
                                "example_id": "785b07d1-e930-4dac-a8c3-d982562a3c00",
                                "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                                "text": "Ihde kommt und geht."
                            },
                            {
                                "example_id": "42140a3a-25d8-4fd9-b2fe-1566abdd8528",
                                "sense_id": "207fabb4-636d-352f-9157-7a161f7147b8",
                                "text": "Ihdes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
