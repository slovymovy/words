                                    {
                                        "sense_id": "ebfd2356-847f-3d5f-8fb9-4a92db2c3189",
                                        "entry_id": "eb622442-0339-36e7-91fb-99b8937b4f46",
                                        "glosses": [
                                            "een veelvoorkomende vorm van lijkbezorging, naast een begrafenis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bbe392-e56b-411a-b11a-9461370dfb42",
                                                "sense_id": "ebfd2356-847f-3d5f-8fb9-4a92db2c3189",
                                                "text": "\"Mogelijk is het terrein hier vroeger als begraafplaats gebruikt\", menen de amateurarcheologen. Nadat Karel de Grote in het jaar 785 een verbod uitvaardigde op lijkverbranding, was het tot begin 19de eeuw gebruikelijk lijken te begraven in en rondom de kerk, zoals ook het geval was bij de Pancratiuskerk."
                                            },
                                            {
                                                "example_id": "c53b8d11-f540-4df1-b1b1-f38fc0f2773a",
                                                "sense_id": "ebfd2356-847f-3d5f-8fb9-4a92db2c3189",
                                                "text": "Varanasi, de spirituele hoofdstad van India aan de heilige Ganges, met lijkverbrandingen als 'attractie', ook voor toeristen."
                                            },
                                            {
                                                "example_id": "df587220-98c0-4de2-ba0f-c3f9922cdf67",
                                                "sense_id": "ebfd2356-847f-3d5f-8fb9-4a92db2c3189",
                                                "text": "In Wie is de Reisleider? gaat Patty Brard op de culturele toer. De diva bezoekt een lijkverbranding op de Ganges. \"Dit is het allermooiste stukje dat ik in jaren van de wereld gezien heb.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
