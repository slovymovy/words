                        "form_id": "b36b878a-3a16-48c2-925a-3190d08a1d16",
                        "entry_id": "3fa5e969-3561-3b95-b4e9-f26405a83f0b",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Methodist"
                    },
                    {
                        "form_id": "c7cfd1d5-a144-4231-9e79-510a51f65175",
                        "entry_id": "3fa5e969-3561-3b95-b4e9-f26405a83f0b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Methodist"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "912b00f7-f52a-33fa-92a3-ee16d9e6e753",
                        "entry_id": "3fa5e969-3561-3b95-b4e9-f26405a83f0b",
                        "glosses": [
                            "Of or pertaining to the branch of Christianity that descends from the religious societies overseen by John Wesley (1703–1791) among others."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c15f2040-cf09-41f0-9de0-fbf5abd26e2a",
                                "sense_id": "912b00f7-f52a-33fa-92a3-ee16d9e6e753",
                                "text": "Clinton’s faith is something she developed as a child growing up in Park Ridge, Illinois, attending the suburb’s First Methodist Church."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9f77e93-eac5-4a92-b529-e0fea752e4e1",
                        "source_entry_id": "3fa5e969-3561-3b95-b4e9-f26405a83f0b",
                        "source_sense_id": "912b00f7-f52a-33fa-92a3-ee16d9e6e753",
                        "source_sense_description": "of or relating to Methodism",
                        "target_lang_word": "méthodiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méthodiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                                        "entry_id": "8e835e90-5edf-399b-af02-a4d81a93b79d",
                                        "glosses": [
                                            "Relatif au mouvement du méthodisme et à ses adhérents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca533859-17e6-4cdd-8682-bfaa0c2056d7",
                                                "sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                                                "text": "La base doctrinale des sociétés méthodistes fut les trente-neuf articles de l'Eglise anglicane, que Wesley donna comme confes­sion de foi à l'Eglise méthodiste d'Amérique, après leur avoir fait subir quelques retouches."
                                            },
                                            {
                                                "example_id": "1c616830-6640-45f6-be62-aeb2f16eb20e",
                                                "sense_id": "b59754f8-200d-3eae-a4a2-e40dc336643a",
                                                "text": "On comprend bien des choses si l'on sait que chacun de ces hommes devait être enterré selon les rites de sa bande, avec tout ce qu'il peut y avoir de prières : catholiques, juives, puritaines, presbytériennes, méthodistes, parsies, jaines, musulmanes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méthodiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "310d89c2-3958-3e38-b7ae-0659998c496f",
                                        "entry_id": "6fe99c5c-2506-32f1-8451-e25fb2db9a57",
                                        "glosses": [
                                            "Adhérent au méthodisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b29793-e7b8-4946-b10f-2afb51735b65",
                                                "sense_id": "310d89c2-3958-3e38-b7ae-0659998c496f",
                                                "text": "Parmi les nouvelles recrues de Wesley, se comptaient … le commentateur Joseph Benson, repoussé comme Méthodiste de l'université d'Oxford, et qui devint l'une des lumières de la société;"
                                            },
                                            {
                                                "example_id": "d06d505c-0019-4a0d-9328-29c39b06bc6c",
                                                "sense_id": "310d89c2-3958-3e38-b7ae-0659998c496f",
                                                "text": "Ce ne fut que tout à fait à la fin de sa vie que Wesley, désespérant de faire la paix avec l’Église établie, se résigna à ordonner lui-même des prêtres, et par là fonda, contre son gré, la secte dissidente des Méthodistes wesleyens qui, dès 1810, comptait déjà deux cent trente mille membres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
