                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "92cea4e2-b8ea-4cef-b2ff-3a012ba4919b",
                                "sense_id": "daae70de-6f1c-3b81-95d7-0078b4deb4e1",
                                "text": "Alfred Guignard raconte qu'un toumané, expédié par son colonel aux bureaux du trésor, suppléa par l'imagination aux lacunes de sa science protocolaire, et répondit : « Oui, mon trésor » au fonctionnaire dont le titre lui était inconnu."
                            },
                            {
                                "example_id": "9c2f36c2-376c-4ac2-b2a1-d85102e9aba9",
                                "sense_id": "daae70de-6f1c-3b81-95d7-0078b4deb4e1",
                                "text": "L'agilité des Annamites les a fait surnommer Chats, la couleur des Soudanais Cirages ou Lions Noirs. Les Sénégalais sont dit aussi Tumanés, d'après un prénom indigène."
                            }
                        ]
                    }
