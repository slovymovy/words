            "senses": [
                {
                    "sense_id": "2ffa595d-a1c1-36b9-a70a-819041ec6768",
                    "sense_definition": "een verzameling mensen van laag allooi of met een slechte reputatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitschot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat stuk <w>schorem</w> komt bij mij de deur niet in!",
                            "target_lang_translations": {
                                "en": "That piece of <w>scum</w> is not coming through my door!"
                            }
                        },
                        {
                            "text": "De politie moest ingrijpen toen het <w>schorem</w> de ruiten van de winkels begon in te slaan.",
                            "target_lang_translations": {
                                "en": "The police had to intervene when the <w>riff-raff</w> started smashing the shop windows."
                            }
                        }
                    ],
                    "synonyms": [
                        "tuig",
                        "geteisem",
                        "geboefte",
                        "gespuis",
                        "janhagel",
                        "schorriemorrie",
                        "uitschot"
                    ],
                    "common_phrases": [
                        "stuk schorem",
                        "het ergste schorem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A collection of people of low character or with a bad reputation; a group of undesirable individuals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "riff-raff",
                                "target_lang_sense_clarification": "disreputable or undesirable people"
                            },
                            {
                                "target_lang_word": "scum",
                                "target_lang_sense_clarification": "worthless or contemptible people"
                            },
                            {
                                "target_lang_word": "rabble",
                                "target_lang_sense_clarification": "a disorderly crowd or the lowest class of people"
                            },
                            {
                                "target_lang_word": "scoundrels",
                                "target_lang_sense_clarification": "dishonest or unscrupulous people"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b6ea80-412d-32c4-8f5d-6e25b04dfbf4",
                    "sense_definition": "onware beweringen of bedrieglijke praatjes",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leugens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geloof hem niet want hij vertelt alleen maar <w>schorem</w> tegen je.",
                            "target_lang_translations": {
                                "en": "Don't believe him because he's only telling you <w>lies</w>."
                            }
                        },
                        {
                            "text": "Die politicus verkoopt weer een hoop <w>schorem</w> om stemmen te winnen.",
                            "target_lang_translations": {
                                "en": "That politician is peddling a lot of <w>rubbish</w> again to win votes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "minder gebruikelijk in standaardtaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Untrue statements, deceptive talk, or nonsense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rubbish",
                                "target_lang_sense_clarification": "nonsense or worthless talk"
                            },
                            {
                                "target_lang_word": "lies",
                                "target_lang_sense_clarification": "false statements"
                            },
                            {
                                "target_lang_word": "hogwash",
                                "target_lang_sense_clarification": "insincere or meaningless talk"
                            }
                        ]
                    }
                }
