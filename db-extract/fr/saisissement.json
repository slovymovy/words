                                                "sense_id": "96aaef9e-6f9b-3a9c-a805-6b73a65c8f5e",
                                                "text": "The train hit the buffers with a great shock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f1484dd-e0dc-39d4-a438-59fac10223dd",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A sudden, heavy impact.",
                                            "Something so surprising that it is stunning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea3fc00e-bf2e-318a-8943-3e6976db3ad5",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A sudden, heavy impact.",
                                            "A sudden or violent mental or emotional disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf642d84-59ce-4de8-ad2b-7c41eb5b39d5",
                                                "sense_id": "ea3fc00e-bf2e-318a-8943-3e6976db3ad5",
                                                "text": "A tremendous shock arises when a secret is discovered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c539fb-30e2-3ef4-8dd0-b5e190dc1095",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A sudden, heavy impact.",
                                            "Electric shock, a sudden burst of electrical energy hitting a person or animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15526545-701c-4b8e-9064-952a6c0566c9",
                                                "sense_id": "59c539fb-30e2-3ef4-8dd0-b5e190dc1095",
                                                "text": "But as was the case with pacemakers, external defibrillators were unwieldy, and the shocks they delivered—in the rare cases when patients were still conscious—were painful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1fd7a12-b5a8-3624-92a7-f8fd96ad8211",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A sudden, heavy impact.",
                                            "A state of distress following a mental or emotional disturbance, often caused by news or other stimuli."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b098873c-7f95-4323-9233-19049374f832",
                                                "sense_id": "c1fd7a12-b5a8-3624-92a7-f8fd96ad8211",
                                                "text": "Fans were in shock in the days following the singer's death."
                                            },
                                            {
                                                "example_id": "19bd2c28-ab64-4386-8d56-e1aac7019d41",
                                                "sense_id": "c1fd7a12-b5a8-3624-92a7-f8fd96ad8211",
                                                "text": "\". . . Maureen, I don't feel sad. I don't feel anything. What's wrong with me?\"\n\"Nothing, Cae,\" she said. \"You just haven't been able to take it in yet. Absorb the shock of it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65e9e9c7-626b-38fb-8c94-20bd3b403edc",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A sudden, heavy impact.",
                                            "Circulatory shock, a medical emergency characterized by the inability of the circulatory system to supply enough oxygen to meet tissue requirements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c9809cd-cbab-3ba6-82e1-3e685aa9d9fc",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A sudden, heavy impact.",
                                            "A shock wave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea4ea656-c84d-494e-8de9-cf04e9b25beb",
                                                "sense_id": "2c9809cd-cbab-3ba6-82e1-3e685aa9d9fc",
                                                "text": "Several reflected shocks enter the bomb core in rapid succession, each helping to compress it to its maximum density."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b084056-3385-3740-add9-a90a40d27009",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A shock absorber (typically in the suspension of a vehicle)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "910c1250-2597-40db-a181-39dad0593ff9",
                                                "sense_id": "4b084056-3385-3740-add9-a90a40d27009",
                                                "text": "If your truck's been riding rough, it might need new shocks."
                                            },
                                            {
                                                "example_id": "66632275-1fcb-4675-ab75-e14b853f346a",
                                                "sense_id": "4b084056-3385-3740-add9-a90a40d27009",
                                                "text": "We're bonin' on the dark blocks / Wearin' out the shocks, wettin' up the dashboard clock"
                                            },
                                            {
                                                "example_id": "8a836289-17d6-4a9e-bcda-f9f925f34fd3",
                                                "sense_id": "4b084056-3385-3740-add9-a90a40d27009",
                                                "text": "At the rear, you'll find a single, centrally mounted shock, the now-familiar single-sided swingarm and BMW's Paralever shaft-drive system, which does away with most of a shafty's chassis-jacking bugaboos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e15c7f-1792-3c32-a0bd-0c7248e42c7e",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A discontinuity arising in the solution of a partial differential equation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7440f29-5406-3e14-a6b3-c0dfde2d1dde",
                                        "entry_id": "c5c81518-f816-3795-bbe8-9afdf62ed36d",
                                        "glosses": [
                                            "A chemical added to a swimming pool to moderate the chlorine levels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4524dbd4-727a-4032-bd71-81003f2ff27f",
                                                "sense_id": "e7440f29-5406-3e14-a6b3-c0dfde2d1dde",
                                                "text": "The warehouse that caught fire contained 99% trichloroisocyanuric acid (TCCA) – used to make chlorinated tablets to control bacteria and algae – and 99% dichloroisocyanuric acid (DCCA), which is used to make swimming pool shock – a treatment used to help break down contaminants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
