                        "glosses": [
                            "Qui concerne ces produits, leur fabrication et leur commercialisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f771253-6207-4b7f-8eaf-8b19d5c0b1d2",
                                "sense_id": "467b17ca-ca12-36a9-871f-d5f3ef1ad4f0",
                                "text": "Le segment dermo-cosmétique est porté par l’innovation et, chaque année, de nouvelles technologies et de nouveaux actifs sont lancés."
                            },
                            {
                                "example_id": "2bfed55f-8f3f-48f8-b352-3ab1dba772fc",
                                "sense_id": "467b17ca-ca12-36a9-871f-d5f3ef1ad4f0",
                                "text": "Après s’être engagée dans le secteur de la recherche dermo-cosmétique, Poietis s’est depuis focalisée sur les applications thérapeutiques tout en commençant à commercialiser sa propre imprimante 3D."
                            },
                            {
                                "example_id": "b2bf8911-f413-4f83-a1f0-fd06c0486bd1",
                                "sense_id": "467b17ca-ca12-36a9-871f-d5f3ef1ad4f0",
                                "text": "Vous êtes une industrie dermo-cosmétique ? Forts de ses nombreuses années d’expérience en conception, optimisation de recettes de nettoyage et validation du nettoyage de produits cosmétiques, notre connaissance des requis réglementaires et notre vision pragmatique nous permettent de vous accompagner tout au long de vos projets."
                            }
                        ]
                    }
