                        "sense_id": "54a8321e-37a5-3c91-954b-13b99f8e8833",
                        "entry_id": "dca2d308-1c42-37c3-a883-a14643195e8c",
                        "glosses": [
                            "broek voor een vrouw die veel lijkt op een rokje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41f4eba-3a34-4042-aa8f-cfaf2b60e921",
                                "sense_id": "54a8321e-37a5-3c91-954b-13b99f8e8833",
                                "text": "Na twee jaar zijn de culottes, ook wel broekrok genoemd, nog steeds geen succès fou in Nederland. Wie ze niet aandurft in de stad, zou de driekwart, zeer wijde broek toch in overweging moeten nemen voor op de camping. Zeker modellen met een elastiek in de taille zijn supercomfortabel. Je kunt er mee zitten en hurken, en als het gras drassig is blijven de pijpen droog."
                            }
                        ]
                    }
