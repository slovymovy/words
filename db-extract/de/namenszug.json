                "senses": [
                    {
                        "sense_id": "bf3c318b-3656-351e-8eb7-41ed39aa6572",
                        "entry_id": "7fa7cff6-6649-34dc-b8f8-4aee6e12eeb4",
                        "glosses": [
                            "schriftliche Form des Namens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd03447e-413b-4d2e-9017-c47686f49660",
                                "sense_id": "bf3c318b-3656-351e-8eb7-41ed39aa6572",
                                "text": "„Das Motiv ist ein Oktogon, das den Diamanten im Ring der Fürstin repräsentiert, umgeben von ihrem Namenszug.“"
                            },
                            {
                                "example_id": "dfdfc212-0419-4fc0-8400-571492a45145",
                                "sense_id": "bf3c318b-3656-351e-8eb7-41ed39aa6572",
                                "text": "„Unterzeichnet war die Karte, in deutscher Kurrentschrift und mit kleinem Anfangsbuchstaben, mit jenem charakteristischen Namenszug ›brecht‹, der heute auf Buchdeckeln zu finden ist.“"
                            },
                            {
                                "example_id": "fb77b693-faa9-4372-9d9a-2be7c3df6503",
                                "sense_id": "bf3c318b-3656-351e-8eb7-41ed39aa6572",
                                "text": "„Eiferer haben, so liest man, eine bronzene Frauenfigur mit ihrem Namenszug, die im Stadtpark an sie erinnern sollte, mit Farbe übergossen und aus ihrem Sockel zu reißen versucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7df5ac68-cd3a-4927-8114-9062397ae941",
                        "source_entry_id": "7fa7cff6-6649-34dc-b8f8-4aee6e12eeb4",
                        "source_sense_id": "bf3c318b-3656-351e-8eb7-41ed39aa6572",
                        "source_sense_description": "schriftliche Form des Namens",
                        "target_lang_word": "signature",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9943ed-b46d-3311-b625-8077937e8d06",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "A person's name, written by that person, used as identification or to signify approval of accompanying material, such as a legal contract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3feb6a-32dd-409e-ab90-cc65a7731c95",
                                                "sense_id": "5d9943ed-b46d-3311-b625-8077937e8d06",
                                                "text": "Thus, when he drew up instructions in lawyer language […] his clerks […] understood him very well. If he had written a love letter, or a farce, or a ballade, or a story, no one, either clerks, or friends, or compositors, would have understood anything but a word here and a word there. For his signature, however, that was different."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f783a19-18af-38a7-910b-827e7c0fcdef",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "An act of signing one's name; an act of producing a signature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c06357dc-df0a-4506-bfcf-678ef74ab09b",
                                                "sense_id": "4f783a19-18af-38a7-910b-827e7c0fcdef",
                                                "text": "IN COMMENTS during signature of the bill yesterday during “Agriculture Day” at the Illinois State Fair in Springfield, Thompson agreed with farmers that land needs to be protected."
                                            },
                                            {
                                                "example_id": "e48d0074-246f-4760-8989-c5cdcf1710d2",
                                                "sense_id": "4f783a19-18af-38a7-910b-827e7c0fcdef",
                                                "text": "[She ate with herself] during the whole evening, during supper, during her signature of unintelligible papers at her father's desk, when he told her gruffly that she would now have an income of £350 a year minus income tax, which would return to her in some mysterious way […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "557f7261-f02f-33b3-92ca-ec120e2754f2",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "The part of a doctor’s prescription containing directions for the patient."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "864a1024-a92b-3724-8ca8-d30174c5b68a",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "Signs on the stave indicating key and tempo, composed of the key signature and the time signature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bee8323b-0c54-3d73-9692-0ad600e79cf8",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "A group of four (or a multiple of four) sheets printed such that, when folded, they become a section of a book."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee571140-189c-3718-9ac5-a6df6a8c5afd",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "A pattern used for matching the identity of a virus, the parameter types of a method, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25853c51-6e50-3311-ab34-80da0de0549c",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "Data attached to a message that guarantees that the message originated from its claimed source."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74db8ee3-3588-3782-a742-8887f56bd0e7",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "A mark or sign of implication."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64ec0024-3a12-47a7-bb87-ecec7bb6d1d7",
                                                "sense_id": "74db8ee3-3588-3782-a742-8887f56bd0e7",
                                                "text": "the natural and indelible signature of God, which human souls […] are supposed to be stamped with"
                                            },
                                            {
                                                "example_id": "2e84316d-eaef-4192-a0f5-0f7fc8ad092a",
                                                "sense_id": "74db8ee3-3588-3782-a742-8887f56bd0e7",
                                                "text": "The TACOM Vehicle Signature Reduction program is concerned with reducing the noise signature detectability of military vehicles in combat."
                                            },
                                            {
                                                "example_id": "776f0387-2d0a-490e-82f4-d43f74432df3",
                                                "sense_id": "74db8ee3-3588-3782-a742-8887f56bd0e7",
                                                "text": "A “signature” was placed on all things by God to indicate their affinities — but it was hidden, hence the search for arcane knowledge. Knowing was guessing and interpreting, not observing or demonstrating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6ce719-d2b3-333a-b9ea-9ec8927da0f6",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "A distinguishing feature or product."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f821d8-dc0f-40ae-9462-60fe0d0bf727",
                                                "sense_id": "ea6ce719-d2b3-333a-b9ea-9ec8927da0f6",
                                                "text": "A great beginning is the goose-liver terrine with truffles, one of the chef's signatures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d298c664-9099-36bb-a9a5-122513ced203",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "A tuple specifying the sign of coefficients in any diagonal form of a quadratic form."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f1dc3d8-875c-3c92-b9cb-edc31ae9d633",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "A resemblance between the external character of a disease and those of some physical agent, for instance, that existing between the red skin of scarlet fever and a red cloth; supposed to indicate this agent in the treatment of the disease."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2646994d-2068-3df0-82a3-16a02225f317",
                                        "entry_id": "ada10b20-42f2-3d8b-a57a-8c9da5ef26c5",
                                        "glosses": [
                                            "Text (or images, etc.) appended to a user's emails, newsgroup posts, forum posts, etc. as a way of adding a personal touch or including contact details."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4dfb5a2-bca6-4bee-8486-6b3ab2678656",
                                                "sense_id": "2646994d-2068-3df0-82a3-16a02225f317",
                                                "text": "Your signature must not exceed three lines of text, or 600 pixels in height."
                                            },
                                            {
                                                "example_id": "ed4033cb-b774-4022-99f8-de000cfbeaf2",
                                                "sense_id": "2646994d-2068-3df0-82a3-16a02225f317",
                                                "text": "forum signature generator"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "signature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                        "entry_id": "f4601f9d-574a-355d-994c-d006f3b4aeba",
                                        "glosses": [
                                            "Distinctive, characteristic, indicative of identity."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a3c6e4-3c24-4060-afa7-18243a3bc7c8",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "In its gallant effort to shun the mass-market fragrance industry for something more personal, Le Labo has, unwittingly, created the most ubiquitous scent in fashion; a signature scent that is so signature you can recognize it in every city in the world[…]."
                                            },
                                            {
                                                "example_id": "f016ad47-7e87-4d13-992f-161d3a32e17a",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Rabbit in mustard sauce is my signature dish."
                                            },
                                            {
                                                "example_id": "dd829f52-6a24-41a1-bccb-b9b12fd24bab",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "The signature route of the airline is its daily flight between Buenos Aires and Madrid."
                                            },
                                            {
                                                "example_id": "10109266-f9cc-459e-ac3c-b11f603c71f1",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Consider Las Fallas of Valencia, Spain, arguably the most signature of signature ephemera."
                                            },
                                            {
                                                "example_id": "41c59971-33e6-4192-80cd-0f230fd924ea",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Considered the most signature effect of the Tudor Revival style, half-timbering derived its distinctive[…]."
                                            },
                                            {
                                                "example_id": "4f4c7d80-07d3-4642-8017-74c63bba7d33",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "But it was perhaps the most signature shot Williams ever made in an Illinois uniform, a bullying basket in which he used his power to pound Stoudamire,[…]."
                                            },
                                            {
                                                "example_id": "ea0051d4-bc06-48db-96bd-98d5fb469703",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "He credited his wife, who is British, for giving him the inspiration for Tigger’s signature phrase: TTFN. TA-TA for now."
                                            },
                                            {
                                                "example_id": "91dfaa86-91be-407a-96f1-54506ca01cbe",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Restaurant staff were in the process of serving Le Caprice's signature dessert: frozen berries with a hot white chocolate sauce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
