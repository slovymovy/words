                "senses": [
                    {
                        "sense_id": "e390c17e-8f32-37b5-9475-3fb5eb48fa19",
                        "entry_id": "ed9a67ba-9634-3b74-8dbf-6b8aeb24ed68",
                        "glosses": [
                            "Umgestaltung, sodass etwas mit weniger Aufwand, Einsatz, Personal funktioniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dd82dd0-c2c8-412b-a8e4-053ae96f14a7",
                                "sense_id": "e390c17e-8f32-37b5-9475-3fb5eb48fa19",
                                "text": "„Verschlankung und Restrukturierung von Unternehmen stellen heute Manager und Mitarbeiter vor neue Herausforderungen.“"
                            },
                            {
                                "example_id": "e631c2b9-ce06-442d-b610-fd088fffc888",
                                "sense_id": "e390c17e-8f32-37b5-9475-3fb5eb48fa19",
                                "text": "„Der Umbau geht einher mit einer Verschlankung der Produktpalette und ist sowohl für die Kunden als auch die Mitarbeiter das aktuell wichtigste Projekt.“"
                            },
                            {
                                "example_id": "aa470dd9-d7e8-4589-a5af-abc3a1dee9d1",
                                "sense_id": "e390c17e-8f32-37b5-9475-3fb5eb48fa19",
                                "text": "„Der britische Regierungschef David Cameron will als eine Art Gegenleistung für einen britischen Verbleib Reformen durchsetzen, die auf eine Verschlankung der Kommission hinauslaufen könnten.“"
                            },
                            {
                                "example_id": "775919b6-1f1f-4b67-8e17-6123f3c839ae",
                                "sense_id": "e390c17e-8f32-37b5-9475-3fb5eb48fa19",
                                "text": "„Tui hatte schon im Februar mitgeteilt, dass es im Zuge eines Strategie- und Wachstumsprogramms in Teilbereichen zu Verschlankungen kommen könne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
