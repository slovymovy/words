                ],
                "senses": [
                    {
                        "sense_id": "2ef76581-5417-37bf-a293-6761e301faf4",
                        "entry_id": "6334359a-a18f-3aec-bdc1-f532b479b37f",
                        "glosses": [
                            "Erroneous or false representation; an unfair or dishonest account or exposition; a false statement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc202fce-f623-41d9-b17c-d4c4c1a6858d",
                                "sense_id": "2ef76581-5417-37bf-a293-6761e301faf4",
                                "text": "Near-synonyms: mischaracterization, misportrayal"
                            },
                            {
                                "example_id": "b166ca41-85d7-4f87-8451-7133de294726",
                                "sense_id": "2ef76581-5417-37bf-a293-6761e301faf4",
                                "text": "[…] for unless a matter be true enough to stand a good deal of misrepresentation, its truth is not of a very robust order, […]"
                            },
                            {
                                "example_id": "0b898ae8-418d-4add-abcb-be694a4e0a2a",
                                "sense_id": "2ef76581-5417-37bf-a293-6761e301faf4",
                                "text": "I was especially astonished at one of their many misrepresentations: I mean when they told you that you must be careful not to let me deceive you – the implication being that I am a skilful speaker."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3b77a98-7851-385d-8542-eb270719ec63",
                        "entry_id": "6334359a-a18f-3aec-bdc1-f532b479b37f",
                        "glosses": [
                            "Incorrect or unfaithful representation in the capacity of agent or official representative, such as of a principal in a matter of business, or of constituents in legislation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f67fa922-2da9-321d-bf4e-252bde284ddf",
                        "entry_id": "6334359a-a18f-3aec-bdc1-f532b479b37f",
                        "glosses": [
                            "Faultiness in a map projection, estimated with regard to its unequal scale in different parts and to its distortion of angles."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
