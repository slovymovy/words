                "senses": [
                    {
                        "sense_id": "42746772-1c61-33f7-beb3-39f73cebc403",
                        "entry_id": "abcabcd6-2d66-30c4-b447-3eaac6f465be",
                        "glosses": [
                            "Structure bordante entourant un orifice d'entrée de certaines plantes ou animaux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "760222db-79ec-301a-983d-ce377cafad7e",
                        "entry_id": "abcabcd6-2d66-30c4-b447-3eaac6f465be",
                        "glosses": [
                            "Chez les mousses, il correspond au bord de l'ouverture des sporanges par où sortent les spores."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990ad43e-4cf9-4f53-adbf-62abd59ea2c7",
                                "sense_id": "760222db-79ec-301a-983d-ce377cafad7e",
                                "text": "Les caractéristiques de la génération sporophytique (soie, capsule, opercule, coiffe et péristome) des mousses ont longtemps été employées dans la classification des grandes lignées."
                            }
                        ]
                    },
                    {
                        "sense_id": "45c64294-70f7-3580-a58c-491954a77d76",
                        "entry_id": "abcabcd6-2d66-30c4-b447-3eaac6f465be",
                        "glosses": [
                            "Chez les plantes carnivores, il correspond au rebord de la bouche, à l'entrée du tube digestif."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39d1134a-c987-3df1-aac7-94504e83c8ca",
                        "entry_id": "abcabcd6-2d66-30c4-b447-3eaac6f465be",
                        "glosses": [
                            "Chez les escargots, il correspond au bord libre de la coquille. Il est dit bordé lorsqu'il est épais."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a2fc27ec-85ae-311a-82c7-86bb6ca32f13",
                        "entry_id": "abcabcd6-2d66-30c4-b447-3eaac6f465be",
                        "glosses": [
                            "Chez les oursins, il correspond à la partie qui entoure la bouche ou à l'orifice inférieur du test."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fa73d9a-bf60-4dad-a0c0-8280638c55ab",
                        "source_entry_id": "abcabcd6-2d66-30c4-b447-3eaac6f465be",
                        "target_lang_word": "peristome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peristome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bde0206c-aa49-3887-b265-91354d50e0b6",
                                        "entry_id": "483ef171-89b3-3e9d-9b1f-0f8c35366ce8",
                                        "glosses": [
                                            "One or two rings of tooth-like appendages surrounding the opening of the capsule of many mosses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd15d242-d2cd-4af6-922a-889e7daae235",
                                                "sense_id": "bde0206c-aa49-3887-b265-91354d50e0b6",
                                                "text": "Its removal does not, however, leave the mouth of the capsule wide open, for around the margin are two circles of pointed teeth forming the peristome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e54f659a-7b1d-37be-ab79-ae63253c45c8",
                                        "entry_id": "483ef171-89b3-3e9d-9b1f-0f8c35366ce8",
                                        "glosses": [
                                            "The parts of or surrounding the mouths of numerous invertebrates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4217a532-eee9-4715-b1fc-f47abfd4e32f",
                                                "sense_id": "e54f659a-7b1d-37be-ab79-ae63253c45c8",
                                                "text": "We can distinguish therefore in the body of a polyp the column, circular or oval in section, forming the trunk, resting on a base or foot and surmounted by the crown of tentacles, which enclose an area termed the peristome, in the centre of which again is the mouth. […] The mouth may be level with the surface of the peristome, or may be projecting and trumpet-shaped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0cc24b9-956f-3121-972d-aee1aa1f6e35",
                                        "entry_id": "483ef171-89b3-3e9d-9b1f-0f8c35366ce8",
                                        "glosses": [
                                            "The lip, or edge of the aperture, of a spiral shell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
