                ],
                "senses": [
                    {
                        "sense_id": "26ac7cbc-013a-37e1-835d-798983c56941",
                        "entry_id": "331538dd-ab52-34b0-ad8c-df270da1c640",
                        "glosses": [
                            "Wissenschaft, die sich mit Zeichensystemen aller Art (zum Beispiel: Bilderschrift, Gestik, Formeln, Sprache, Verkehrszeichen) befasst und versucht, sie zu beschreiben und zu erklären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd7c896-ebff-450d-8fa8-e4a0a23ef768",
                                "sense_id": "26ac7cbc-013a-37e1-835d-798983c56941",
                                "text": "„Und man sagt dann, man könne von Semiologie sprechen, wenn man an eine allgemeine Disziplin denke, die Zeichen untersucht und sprachliche Zeichen nur als eine besondere Provinz betrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69ffeec4-9704-31c9-9da1-4a36311849b1",
                        "entry_id": "331538dd-ab52-34b0-ad8c-df270da1c640",
                        "glosses": [
                            "Lehre von den Anzeichen für eine Erkrankung oder Verletzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9044e7d-829c-439f-8288-fbf2f70bb3e5",
                                "sense_id": "69ffeec4-9704-31c9-9da1-4a36311849b1",
                                "text": "„Semiotik ist die Lehre von den Zeichen des widernatürlichen Zustandes. Man kann sie auch Semiologie nennen, aber man muß in diesem Falle mehr die Theorie der Zeichen als die gesammte Lehre davon verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
