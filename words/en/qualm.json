    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0c6562b-cb7b-380b-9a90-8b47a3f1d8aa",
                    "sense_definition": "A prick of the conscience; an uneasy feeling of doubt or hesitation about the morality of an action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt_scruple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney had no <w>qualms</w> about representing clients accused of serious crimes."
                        },
                        {
                            "text": "She felt a sudden <w>qualm</w> of guilt after lying to her parents about where she had been."
                        }
                    ],
                    "synonyms": [
                        "compunction",
                        "scruple"
                    ],
                    "common_phrases": [
                        "have no qualms",
                        "qualm of conscience",
                        "without a qualm"
                    ]
                },
                {
                    "sense_id": "7a086ae2-eb1f-3079-b591-01fbcfe0ce6e",
                    "sense_definition": "A feeling of apprehension, unease, or misgiving about a future course of action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt_scruple",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite her initial <w>qualms</w>, she decided to accept the risky job offer abroad."
                        },
                        {
                            "text": "He expressed serious <w>qualms</w> about the safety regulations currently in place."
                        }
                    ],
                    "synonyms": [
                        "apprehension",
                        "misgiving",
                        "unease",
                        "uneasiness"
                    ],
                    "common_phrases": [
                        "serious qualms",
                        "qualms about leaving"
                    ]
                },
                {
                    "sense_id": "355384e2-be0e-3334-9048-817136fb4d54",
                    "sense_definition": "A sudden sensation of sickness, nausea, or faintness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>qualm</w> overtook him as the small boat rocked violently on the waves."
                        },
                        {
                            "text": "She had to sit down immediately until the dizzying <w>qualm</w> passed."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used less frequently in modern English for physical nausea"
                        }
                    ]
                },
                {
