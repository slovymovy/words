                                            {
                                                "example_id": "d10b9f8f-e0ad-4b02-a2ab-0a0890de59d8",
                                                "sense_id": "fbfa0166-97c9-3c8d-8d86-e3c913dd9e63",
                                                "text": "Była pierwsza w południe, kiedy pan Ignacy zbliżał się do sklepu, zawstydzony i niespokojny."
