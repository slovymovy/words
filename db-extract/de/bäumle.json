                "senses": [
                    {
                        "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                        "entry_id": "bfde412c-615d-3875-8ec3-ff3e12f6365f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf124bdf-5254-4df6-85e5-fe6cbe649019",
                                "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                                "text": "Frau Bäumle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2a8a0cd2-ab4b-4438-bdfb-230175dc8e2c",
                                "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                                "text": "Herr Bäumle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cb607b70-f487-4aa5-bcdc-59159360eeef",
                                "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                                "text": "Die Bäumles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6a345743-4998-49e9-89da-95061352850c",
                                "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                                "text": "Der Bäumle trägt nie die Pullover, die die Bäumle ihm strickt."
                            },
                            {
                                "example_id": "98ed2114-08a8-4058-8330-170af16b916d",
                                "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bäumle kommt, geht der Herr Bäumle.“"
                            },
                            {
                                "example_id": "7c730b73-8f18-47ed-9473-c04822788490",
                                "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                                "text": "Bäumle kommt und geht."
                            },
                            {
                                "example_id": "fce2693e-c30e-4ee0-ad56-d97ee33055a5",
                                "sense_id": "f8600c35-d27f-3f43-89c9-240d7e773be9",
                                "text": "Bäumles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
