                        "cross_references": [
                            {
                                "target_word": "rietvoorn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5d0b5c0d-4f07-39eb-b19c-f37f24cc8f40",
                                        "entry_id": "1a1ea86b-47ee-3648-9d2a-4df34fe8928c",
                                        "glosses": [
                                            "Scardinius erythrophthalmus karperachtige zoetwatervis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2a147b-bd84-49e2-84b7-dbed016eb10c",
                                                "sense_id": "5d0b5c0d-4f07-39eb-b19c-f37f24cc8f40",
                                                "text": "De ruisvoorn, ook wel rietvoorn, \"rode rijer\" en \"roodvoorn\" genoemd, wordt ongeveer 35 centimeter lang en weegt dan ruim 500 gram. De grootste die tot op heden in Nederland is aangetroffen was 48 cm lang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3876d857-753f-4bed-8e00-8d23f24e7ad8",
                        "source_entry_id": "72f9f182-a100-39d8-b0b3-43ef60fcf036",
                        "source_sense_description": "fish Scardinius erythrophthalmus",
                        "target_lang_word": "rotengle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rotengle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                        "entry_id": "b4dbcdaf-919f-37e9-9e64-4197b8071fee",
                                        "glosses": [
                                            "Espèce de poisson osseux d’eau douce, des eaux calmes d’Europe et d’Asie, proche du gardon, dont les nageoires anale et ventrales ainsi que la queue et l’iris de l'œil sont de couleur rouge vif, de la famille des cyprinidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c2f8487-c209-48e4-936f-0a16ab4fe601",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "Présent dans toute l’Europe, à l’exception de l’Espagne et de l’Écosse, le rotengle se rencontre surtout dans la calme zone à brème, en lacs et en étangs."
                                            },
                                            {
                                                "example_id": "7a61d291-1ce6-44df-9f5a-b94fe386fc36",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "Le rotengle est toujours prompt à saisir les esches près de la surface."
                                            },
                                            {
                                                "example_id": "26f3cd7b-c8c2-4879-a9f8-db8a9243383c",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "Il pêchait parfois dans le canal situé au-dessus du moulin, alimenté par la rivière, dans les grands calmes où les rotengles, les poissons-chats et les carpes venaient se nourrir de grains concassés en balançant leurs flancs dans la lumière."
                                            },
                                            {
                                                "example_id": "8d2f6630-10a5-4d2d-b65d-f6ceba4dca0e",
                                                "sense_id": "325085f8-cfda-31f0-94aa-5c4fc84e70d6",
                                                "text": "À l’automne, il nage dans les boucles du Tadouchou un grand nombre de rotengles, de saumons sibériens, d’ombles chevaliers, de saumons roses à bosse et de saumons kéta du Pacifique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81b4344e-ac76-4551-a260-0bc22aac65c1",
                        "source_entry_id": "72f9f182-a100-39d8-b0b3-43ef60fcf036",
                        "source_sense_description": "fish Scardinius erythrophthalmus",
                        "target_lang_word": "Rotfeder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rotfeder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afbb9278-e6e4-3295-aca0-5306a3b37414",
                                        "entry_id": "c9a67431-236e-3e39-873a-06e2f828464e",
                                        "glosses": [
                                            "Süßwasserfisch mit großen Schuppen und orangeroten Flossen, der in Schwärmen in einigen Gewässern Europas und Westasiens lebt (Scardinius erythrophthalmus)"
                                        ],
                                        "tags": [
                                            "speziell Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d70bda-3259-4146-b2f4-e2fe00450b4c",
                                                "sense_id": "afbb9278-e6e4-3295-aca0-5306a3b37414",
                                                "text": "„Zwei Libellen tanzten vorbei, ein Wasserhuhn gründelte und ein Schwarm kleiner Rotfedern sonnte sich dicht unterm Wasserspiegel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
