        "fr-extract.jsonl": [
            {
                "entry_id": "33b45ab0-08e1-3121-a758-94d53c1c72eb",
                "word": "hypocritement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "52fcd01f-131c-39a4-bb2f-193944842496",
                        "entry_id": "33b45ab0-08e1-3121-a758-94d53c1c72eb",
                        "glosses": [
                            "D’une manière hypocrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72f6219-2766-4bb3-a2ea-d0e529b91ed4",
                                "sense_id": "52fcd01f-131c-39a4-bb2f-193944842496",
                                "text": "Elle l’avait regardé bien en face. Il s’imagina que, si elle avait mis une arrière-pensée dans ses paroles, elle l’aurait regardé hypocritement ; il n’osa donc pas répondre comme à une provocation."
                            },
                            {
                                "example_id": "4774cf04-a58a-419e-ba40-64f181e9de63",
                                "sense_id": "52fcd01f-131c-39a4-bb2f-193944842496",
                                "text": "Toutes les religions, plus ou moins hypocritement, ont prêché leur « Aimez-vous les uns les autres I »."
                            },
                            {
                                "example_id": "bde567d9-2680-4256-9a52-9b1ebd9ba487",
                                "sense_id": "52fcd01f-131c-39a4-bb2f-193944842496",
                                "text": "Cet autre paysan du Danube regagna son toit à Blangy, regarda choir une à une ses illusions, vit sa république finit en queue d’empereur, et tomba dans une complète misère, sous les yeux de Rigou, qui sut hypocritement l’y réduire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c24610ac-6c83-49f4-a6b7-e257a4a9af9d",
                        "source_entry_id": "33b45ab0-08e1-3121-a758-94d53c1c72eb",
                        "source_sense_id": "52fcd01f-131c-39a4-bb2f-193944842496",
                        "target_lang_word": "falsely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falsely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                        "entry_id": "034d856e-cc91-386e-9613-25146cefc7d1",
                                        "glosses": [
                                            "In a false manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1c1f23-2096-4444-a485-3c1380a713e5",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "He protested his innocence to the end, claiming he had been falsely charged and convicted."
                                            },
                                            {
                                                "example_id": "65a30b8b-6180-4117-aba8-767ef1b3d580",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "This could not be more falsely stated."
                                            },
                                            {
                                                "example_id": "24cad39d-5f38-414e-a4cc-6980323b3674",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "Our insensitive laughter echoes even more falsely now."
                                            },
                                            {
                                                "example_id": "ea6ec17d-0583-4b71-b56a-0b3cfd29c4de",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "And on none of them does the name ring more falsely than on Robert Southey."
                                            },
                                            {
                                                "example_id": "8a1622e8-80be-45e6-94ad-77757122ccdf",
                                                "sense_id": "71dbd519-957d-3408-b453-f0ac7d25b9b4",
                                                "text": "President Donald Trump falsely claimed Thursday that some states saw gas prices fall to just $1.98 on Wednesday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "735adc1a-f8b2-4169-94e7-25f37341e44f",
                        "source_entry_id": "33b45ab0-08e1-3121-a758-94d53c1c72eb",
