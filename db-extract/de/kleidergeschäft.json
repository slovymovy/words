                "senses": [
                    {
                        "sense_id": "685c59bc-d733-38f1-87c5-28270ac2ea4f",
                        "entry_id": "e28cbcd7-ea8a-3f63-ad64-81ec033ca879",
                        "glosses": [
                            "Betrieb, der Bekleidung verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcd02375-1e67-46a0-812c-2788902c172d",
                                "sense_id": "685c59bc-d733-38f1-87c5-28270ac2ea4f",
                                "text": "„Er trug ein weißes Hemd mit Schlips unter dem Wams, und in Magnus á Gerdunums Kleidergeschäft hatte er sich eine dänische Hose mit Bügelfalten gekauft.“"
                            },
                            {
                                "example_id": "1c027248-56c8-4107-a960-99079fb1811c",
                                "sense_id": "685c59bc-d733-38f1-87c5-28270ac2ea4f",
                                "text": "„Ich ging zu dem Kleidergeschäft.“"
                            },
                            {
                                "example_id": "21886d39-aa68-4460-8099-933f1c936060",
                                "sense_id": "685c59bc-d733-38f1-87c5-28270ac2ea4f",
                                "text": "„Alex Portnoy erinnert sich auch, wie seine Mutter mit ihm, als er elf war, in das Kleidergeschäft seines Onkels ging, um eine Badehose für den Jungen zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
