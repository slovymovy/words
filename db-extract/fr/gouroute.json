                        "sense_id": "19214cd3-b947-380a-ac74-c6c16593c90c",
                        "entry_id": "ebed9a27-1212-3f99-bb3d-ac740fbe1551",
                        "glosses": [
                            "Maitresse spirituelle hindoue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7054e265-8764-4e6a-bbcf-1d7e71891991",
                                "sense_id": "19214cd3-b947-380a-ac74-c6c16593c90c",
                                "text": "Or le tournant de l’histoire entre le célèbre compositeur (Dujardin) et la femme de l’ambassadeur se produit lors d’une de ces interminables séances de câlins dispensés par mère Amma, « gouroute » du Kerala…"
                            }
                        ]
                    },
                    {
                        "sense_id": "98ff7ca5-4ae6-3d6f-ad6e-03b3fd556bbf",
                        "entry_id": "ebed9a27-1212-3f99-bb3d-ac740fbe1551",
                        "glosses": [
                            "Experte dans un domaine particulier dont les avis sont largement reconnus et respectés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4923a21f-32b3-4122-a31e-4e800d4c7bdd",
                                "sense_id": "98ff7ca5-4ae6-3d6f-ad6e-03b3fd556bbf",
                                "text": "La gouroute du zéro déchet doit son succès à sa méthode autant qu’à son physique de Française aux cheveux brillants qui rassure les Américains."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fe333fe-cffe-30b6-bbc6-cf27dad6bcaf",
                        "entry_id": "ebed9a27-1212-3f99-bb3d-ac740fbe1551",
                        "glosses": [
                            "Cheffe d’un petit groupe spirituel, manipulateur, sectaire, fantaisiste, ou même dangereux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eafea3d-5b32-4d17-8865-3ad407b5208b",
                                "sense_id": "6fe333fe-cffe-30b6-bbc6-cf27dad6bcaf",
                                "text": "Luce Barbe, la gouroute en fuite dans l’affaire des Deux Soleils, a été interpelée ce jeudi matin par les gendarmes du Morbihan."
                            }
                        ]
                    }
