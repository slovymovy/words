                ],
                "senses": [
                    {
                        "sense_id": "67892d18-ea51-3487-9e8d-cc8c2e49a7bd",
                        "entry_id": "f8d4dad8-fa8e-3f96-bb68-c4f42a0d738d",
                        "glosses": [
                            "die eindeutige Nummer einer Kreditkarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35494b2a-8c7a-4194-8183-e2c3df9a8941",
                                "sense_id": "67892d18-ea51-3487-9e8d-cc8c2e49a7bd",
                                "text": "„Dennoch könnte die Übermittlung der Kreditkartennummer, des Namens des Inhabers und Ablaufdatums der Karte für Bedenken bei Kreditkartenbesitzern sorgen.“"
                            },
                            {
                                "example_id": "ca8251c4-9a84-42e5-b92d-1f4d7d03bf09",
                                "sense_id": "67892d18-ea51-3487-9e8d-cc8c2e49a7bd",
                                "text": "„Verfügen Betrüger über Name und Kreditkartennummer eines Bankkunden, können sie auf dessen Kosten einkaufen.“"
                            },
                            {
                                "example_id": "4fc848fb-7ad8-4991-828d-5bae6b7a23a6",
                                "sense_id": "67892d18-ea51-3487-9e8d-cc8c2e49a7bd",
                                "text": "„Auch Hunderte Deutsche seien von dem Identitätsdiebstahl betroffen. Sie hätten zuvor Namen, Adresse und Kreditkartennummer bei Bestellungen in ähnlichen Onlineshops angegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
