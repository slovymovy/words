                                                "sense_id": "0b554eb5-b7a3-3874-bb6c-a77651ef09b8",
                                                "text": "Hoera! Ik ben jarig."
                                            },
                                            {
                                                "example_id": "1f4bcb6e-f2d3-4ed6-af80-3a965bdfdf3f",
                                                "sense_id": "0b554eb5-b7a3-3874-bb6c-a77651ef09b8",
                                                "text": "Leve de koningin! Hoera! Hoera! Hoera!"
