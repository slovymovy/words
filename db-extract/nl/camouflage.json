                                    },
                                    {
                                        "sense_id": "86e66982-2ab6-38ce-9d72-e96849fad60f",
                                        "entry_id": "a578ddd3-724b-35d2-9ff4-ccc32cd1af5c",
                                        "glosses": [
                                            "The act of disguising."
