                ],
                "translations": [
                    {
                        "translation_id": "a1ab9859-3280-4289-984c-9fe010c3739d",
                        "source_entry_id": "cfcb15bb-43ad-3a13-b71c-6dc0c3e01c6a",
                        "source_sense_id": "68e8c08b-4fe3-3b58-88f4-a74f424b6c8d",
                        "source_sense_description": "een ruimte waarvan de temperatuur verhoogd wordt, zodat het lichaam begint te zweten (een zweetbad)",
                        "target_lang_word": "Sauna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sauna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84210019-a47f-38b0-a4f9-1e7d7e580f9a",
                                        "entry_id": "bee65e24-13cc-3cda-a3b8-d5175b2a89e5",
                                        "glosses": [
                                            "für das Schwitzen der Anwesenden geschaffener Raum mit sehr hoher Temperatur und niedriger Luftfeuchtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a115b081-76d5-460b-a593-16dd1fb7fbaf",
                                                "sense_id": "84210019-a47f-38b0-a4f9-1e7d7e580f9a",
                                                "text": "Nach 10 Minuten in der Sauna ging er in den Schnee hinaus, um sich abzukühlen."
                                            },
                                            {
                                                "example_id": "f419df1e-e796-41c6-85f9-7a141c8e766c",
                                                "sense_id": "84210019-a47f-38b0-a4f9-1e7d7e580f9a",
                                                "text": "„Sexuelle Fantasien haben in der Sauna nichts verloren.“"
                                            },
                                            {
                                                "example_id": "e1ac51eb-3526-4d4e-8055-70fbee1b13cf",
                                                "sense_id": "84210019-a47f-38b0-a4f9-1e7d7e580f9a",
                                                "text": "„Es gibt drei Millionen Saunas in Finnland, mehr als es Autos im Lande gibt.“"
                                            },
                                            {
                                                "example_id": "fd523751-947b-422c-8082-54ef153a1d85",
                                                "sense_id": "84210019-a47f-38b0-a4f9-1e7d7e580f9a",
                                                "text": "„Mein innigster Wunsch, ausschließlich mit gleichgeschlechtlichen Menschen in der Sauna zusammen zu sein, hat keinen religiösen Hintergrund.“"
                                            },
                                            {
                                                "example_id": "1ba77254-99ef-4c99-a034-b9cc2892f66f",
                                                "sense_id": "84210019-a47f-38b0-a4f9-1e7d7e580f9a",
                                                "text": "„Das Haus ist nicht neu (der Vermieter lebt in Helsinki), ein gewöhnliches Inselhaus in gewöhnlicher Lage, mit eingebauter Sauna, zwei großen Zimmern, überdachter Terrasse mit Blick zum Meer, von Wacholderbüschen und Kiefern umgeben.“"
                                            },
                                            {
                                                "example_id": "ada1c628-23c2-453e-b853-015a136b3785",
                                                "sense_id": "84210019-a47f-38b0-a4f9-1e7d7e580f9a",
                                                "text": "„Sie fächelte sich Luft zu. »Das ist ja die reinste Sauna hier.« »Im Moment ist es überall wie in der Sauna.« “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34233f94-9107-377a-83ac-c465f7f1b9cc",
                                        "entry_id": "bee65e24-13cc-3cda-a3b8-d5175b2a89e5",
                                        "glosses": [
                                            "Aufenthalt in ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82aec78c-060b-47f5-b80e-7a60af8ae092",
                                                "sense_id": "34233f94-9107-377a-83ac-c465f7f1b9cc",
                                                "text": "„Sie fächelte sich Luft zu. »Das ist ja die reinste Sauna hier.« »Im Moment ist es überall wie in der Sauna.« “"
                                            },
                                            {
                                                "example_id": "c31d24a7-694f-4b48-a157-4fdc4a43defa",
                                                "sense_id": "34233f94-9107-377a-83ac-c465f7f1b9cc",
                                                "text": "Nach drei Saunen fühlte er sich wie neugeboren."
                                            },
                                            {
                                                "example_id": "e089d5d4-f022-4ca6-a893-a0573b9f0318",
                                                "sense_id": "34233f94-9107-377a-83ac-c465f7f1b9cc",
                                                "text": "Während einer Sauna können viele Personen auf das Beste entspannen."
                                            },
                                            {
                                                "example_id": "52494f09-cdfb-4c4b-be7a-d742cd1cbfe2",
                                                "sense_id": "34233f94-9107-377a-83ac-c465f7f1b9cc",
                                                "text": "Die starke Schweißproduktion bei einer Sauna gefällt nicht jedem."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c8cccc4-e213-43d2-b7af-e349a9a96ce1",
