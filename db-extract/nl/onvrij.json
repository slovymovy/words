                            {
                                "target_word": "bound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f49e5fc9-679e-358d-a528-8270f67c2151",
                                        "entry_id": "84d211a7-6b01-352c-a905-b762071e4e4b",
                                        "glosses": [
                                            "Ready, prepared."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c54d2ab-8d51-425c-a07b-2ce4f49ee361",
                                                "sense_id": "f49e5fc9-679e-358d-a528-8270f67c2151",
                                                "text": "This certain,—that a band of war / Has for two days been ready boune, / At prompt command to march from Doune […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c7be90-ac7a-30ea-9cb1-26c9c377383a",
                                        "entry_id": "84d211a7-6b01-352c-a905-b762071e4e4b",
                                        "glosses": [
                                            "Ready to start or go (to); moving in the direction (of)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e267a3c4-35e2-40f9-a961-20128bed212a",
                                                "sense_id": "88c7be90-ac7a-30ea-9cb1-26c9c377383a",
                                                "text": "Which way are you bound? —I'm already homeward bound."
                                            },
                                            {
                                                "example_id": "8915b23a-789b-4b5e-9647-7f6f971a38b8",
                                                "sense_id": "88c7be90-ac7a-30ea-9cb1-26c9c377383a",
                                                "text": "Is that message bound for me?"
                                            },
                                            {
                                                "example_id": "09f8a74a-d950-4ad0-bc73-a41b8f0ed46d",
                                                "sense_id": "88c7be90-ac7a-30ea-9cb1-26c9c377383a",
                                                "text": "Ar. […]and for the reſt o'th' Fleet / (Which I diſpers'd) they all haue met againe, / And are vpon the Mediterranean Flote / Bound ſadly home for Naples, / Suppoſing that they ſaw the Kings ſhip wrackt, / And his great perſon periſh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f467e7f-4ef3-357f-8e20-24e3c83fa1ee",
                                        "entry_id": "84d211a7-6b01-352c-a905-b762071e4e4b",
                                        "glosses": [
                                            "Very likely (to), certain to"
                                        ],
                                        "tags": [
                                            "with-infinitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c27729-582e-4e4f-b67c-3a4578f06c34",
                                                "sense_id": "1f467e7f-4ef3-357f-8e20-24e3c83fa1ee",
                                                "text": "They were bound to come into conflict eventually."
                                            },
                                            {
                                                "example_id": "03cf0bce-8c65-4948-9195-0af0dd2f1398",
                                                "sense_id": "1f467e7f-4ef3-357f-8e20-24e3c83fa1ee",
                                                "text": "When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose. And the queerer the cure for those ailings the bigger the attraction. A place like the Right Livers' Rest was bound to draw freaks, same as molasses draws flies."
                                            },
                                            {
                                                "example_id": "aff2cd13-a0ab-4a6a-915a-5cd6e3d818a9",
                                                "sense_id": "1f467e7f-4ef3-357f-8e20-24e3c83fa1ee",
                                                "text": "Don’t go around tonight— / Well, it’s bound to take your life: / There’s a bad moon on the rise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ba4cbfa-db83-3be5-9771-04a92cb3827a",
                                        "entry_id": "f6f9d454-a722-3a9d-9705-e05846da130b",
                                        "glosses": [
                                            "A boundary, the border which one must cross in order to enter or leave a territory."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5fe190c-ee89-495e-9e97-3659b8efb3d4",
                                                "sense_id": "2ba4cbfa-db83-3be5-9771-04a92cb3827a",
                                                "text": "I reached the northern bound of my property, took a deep breath and walked on."
                                            },
                                            {
                                                "example_id": "59721d6a-e971-473d-91db-20781d24fea6",
                                                "sense_id": "2ba4cbfa-db83-3be5-9771-04a92cb3827a",
                                                "text": "Somewhere within these bounds you may find a buried treasure."
                                            },
                                            {
                                                "example_id": "7b46b501-1c3b-47cf-a49e-c01505ef6378",
                                                "sense_id": "2ba4cbfa-db83-3be5-9771-04a92cb3827a",
                                                "text": "Wyth cry unreverent,\nBefore the sacrament,\nWythin the holy church bowndis,\nThat of our fayth the grownd is."
                                            },
                                            {
                                                "example_id": "dbe2002b-bbcf-4493-821c-21599ffb1f42",
                                                "sense_id": "2ba4cbfa-db83-3be5-9771-04a92cb3827a",
                                                "text": "It was sung from the top of the oldest house in the burgh every June at the Common riding, which served both for a perambulation of the bounds of the common pastures or Haughs and to commemorate the young men of Harwick[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653fa800-da36-35fe-803c-9a375a92fd4d",
                                        "entry_id": "f6f9d454-a722-3a9d-9705-e05846da130b",
                                        "glosses": [
                                            "A value which is known to be greater or smaller than a given set of values."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a31d3eb-6c1c-3710-9abb-603b94ac535c",
                                        "entry_id": "1a9abe33-aea2-3a5f-b07d-513fdc14dc2d",
                                        "glosses": [
                                            "To surround a territory or other geographical entity; to form the boundary of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cc89938-67b4-49f8-a2ec-5fd245de3a96",
                                                "sense_id": "9a31d3eb-6c1c-3710-9abb-603b94ac535c",
                                                "text": "France, Portugal, Gibraltar and Andorra bound Spain."
                                            },
                                            {
                                                "example_id": "02209439-776f-43a9-8403-c6a2362ae216",
                                                "sense_id": "9a31d3eb-6c1c-3710-9abb-603b94ac535c",
                                                "text": "Kansas is bounded by Nebraska on the north, Missouri on the east, Oklahoma on the south and Colorado on the west."
                                            },
                                            {
                                                "example_id": "9b480f03-85e3-49f2-a0b7-ac076f87643e",
                                                "sense_id": "9a31d3eb-6c1c-3710-9abb-603b94ac535c",
                                                "text": "Mexico is bounded on the north by the United States of America, whose frontier is marked as follows: from the mouth of the Rio Bravo, or Rio Grande del Norte, following the course of the river to the parallel of 31° 47'; […]"
                                            },
                                            {
                                                "example_id": "b0163773-c69f-4be0-a899-964e50fa31ab",
                                                "sense_id": "9a31d3eb-6c1c-3710-9abb-603b94ac535c",
                                                "text": "The Scottish Region is issuing a Day Rail-Rover Ticket, available at 12 hours' notice, permitting unlimited travel in an area bounded by Edinburgh, St. Andrews, Dundee, Perth, Comrie, Callander, Stirling and Falkirk for 25s. (children, 12s. 6d.). . . ."
                                            }
