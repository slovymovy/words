                "senses": [
                    {
                        "sense_id": "0b8b51e2-e85c-38ee-9d52-66591060c5ee",
                        "entry_id": "a771e547-7ec8-32ff-a770-e5c8ed9257ee",
                        "glosses": [
                            "kleine Gruppe von Personen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d55eca8c-02d2-4803-9f68-70a317c588d5",
                                "sense_id": "0b8b51e2-e85c-38ee-9d52-66591060c5ee",
                                "text": "„Die Generationen waren zusammengeschrumpft, und die paar Leutchen, die hier noch immer die Ruhestätte eines ihrer Lieben haben mochten, waren entweder zu schwach, um sich die von Trümmern verstellten Gehwege zuzumuten, oder zu zartbesaitet, um den Anblick solchen Vandalismus' zu ertragen.“"
                            },
                            {
                                "example_id": "0c60c7ad-3162-455a-ba8e-ae7f19d3b50b",
                                "sense_id": "0b8b51e2-e85c-38ee-9d52-66591060c5ee",
                                "text": "„Sie stand an der Poolkante und betrachtete die alten Leutchen, die sie gleichfalls, auf ihre Shuffleboard-Stecken gelehnt, musterten.“"
                            },
                            {
                                "example_id": "0d5272ea-0a35-4196-b68b-7bd37621db77",
                                "sense_id": "0b8b51e2-e85c-38ee-9d52-66591060c5ee",
                                "text": "„›Trotzdem... ein guter Rat, den Ihr Leutchen wohl gebrauchen könnt. Tun Sie Ihrer Organisation einen Gefallen. Betrachten Sie dieses Versteck aus aufgeflogen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
