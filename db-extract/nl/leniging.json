                        "sense_id": "faeb694e-0b2d-33c8-a8a0-aeafffbc1cf4",
                        "entry_id": "c2d4f8a7-62bc-3f54-ac56-24112152f8b7",
                        "glosses": [
                            "het oplossen of minder zwaar maken van een nood, probleem of schuld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c8e5955-6bf0-48b0-86ba-73ea08f6e510",
                                "sense_id": "faeb694e-0b2d-33c8-a8a0-aeafffbc1cf4",
                                "text": "Het hilarische hoogtepunt van de nationale verontwaardiging was de NS-belofte dat er plastic plaszakken in de treinen kwamen ter leniging van de hoogste nood. Uiteindelijk eiste de Tweede Kamer per motie een toilet in elke trein en zwichtten de spoorwegen."
                            },
                            {
                                "example_id": "4afbf4d6-7831-4cd0-aae3-d2a82941e4ee",
                                "sense_id": "faeb694e-0b2d-33c8-a8a0-aeafffbc1cf4",
                                "text": "Of neem senator Elizabeth Warren, die de sociale beweging die Bernie Sanders heeft losgemaakt nu in haar verkiezingscampagne oppakt door het ene gedegen wetsvoorstel na het andere te publiceren: van leniging van studieschulden tot meer vermogensbelasting, van plannen om woningen, kinderopvang en gezondheidszorg betaalbaarder te maken tot voorstellen om big tech op te splitsen."
                            }
                        ]
                    }
