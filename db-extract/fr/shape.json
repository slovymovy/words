                                    {
                                        "sense_id": "d3ae8bc5-6955-3389-818c-471dce1e50e4",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "The status or condition of something"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2812735-9665-49f3-b67b-8da5fb602d81",
                                                "sense_id": "d3ae8bc5-6955-3389-818c-471dce1e50e4",
                                                "text": "The used bookshop wouldn’t offer much due to the poor shape of the book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2008ed4d-dcc2-3a2e-9225-c110b5242d0c",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "Condition of personal health, especially muscular health."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47da9c70-4b7f-4098-9ee6-d7c286489f59",
                                                "sense_id": "2008ed4d-dcc2-3a2e-9225-c110b5242d0c",
                                                "text": "The vet checked to see what kind of shape the animal was in."
                                            },
                                            {
                                                "example_id": "fe3199a9-4a6d-4222-9ae3-ac04e58310cb",
                                                "sense_id": "2008ed4d-dcc2-3a2e-9225-c110b5242d0c",
                                                "text": "We exercise to keep in good physical shape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7491c1c0-cabd-36ae-b3d7-53ba35eb712d",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "A graphical representation of an object's form or its external boundary, outline, or external surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96247735-d87c-4219-9ac3-a773557ac183",
                                                "sense_id": "7491c1c0-cabd-36ae-b3d7-53ba35eb712d",
                                                "text": "What shape shall we use for the cookies? Stars, circles, or diamonds?"
                                            },
                                            {
                                                "example_id": "be13b8a9-71a3-4ca7-94e3-239e3ed1f206",
                                                "sense_id": "7491c1c0-cabd-36ae-b3d7-53ba35eb712d",
                                                "text": "No design right can exist in features of appearance of a product which are solely dictated by the product's technical function (see Dyson Ltd v Vax Ltd [2010] EWHC 1923 (Pat) which held the shape of the Dyson vacuum cleaner to be unregisterable as it was purely functional) [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abfb7a52-9423-35f0-bd07-4d55c8038b69",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "Form; formation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66b23f35-f74f-4535-a6fb-a51544091527",
                                                "sense_id": "abfb7a52-9423-35f0-bd07-4d55c8038b69",
                                                "text": "Your head is a funny shape, rather oblong."
                                            },
                                            {
                                                "example_id": "576b9c6f-1d45-496d-8ab5-516767f94e36",
                                                "sense_id": "abfb7a52-9423-35f0-bd07-4d55c8038b69",
                                                "text": "What if God's plans and actions do mold the shape of human events?"
                                            },
                                            {
                                                "example_id": "3db694d0-8317-4140-bb55-5d7e8ddce521",
                                                "sense_id": "abfb7a52-9423-35f0-bd07-4d55c8038b69",
                                                "text": "A formal feature indicating a pre-Roman origin is word-final i, which is rare in the inherited nominal and adjectival lexicon. On the basis of this we may conclude that ispéli is likely the original shape of this word."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372e7f00-831b-3a96-87fd-bdc419146fd6",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "A rolled or hammered piece, such as a bar, beam, angle iron, etc., having a cross section different from merchant bar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "babb1584-8270-3c0e-9f92-fcaee99abb8c",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "A piece which has been roughly forged nearly to the form it will receive when completely forged or fitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ca989da-34db-38af-84f8-cc79a5695729",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "A mould for making blancmange, jelly, etc., or a piece of such food formed moulded into a particular shape."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d59f7b6d-8abc-4a41-9d30-cc88fb7eb57f",
                                                "sense_id": "1ca989da-34db-38af-84f8-cc79a5695729",
                                                "text": "And if I 'm late for supper there 's a dish of macaroni cheese you must put in the oven and a tin of tomatoes to eat with it. And there is a little rhubarb and shape."
                                            },
                                            {
                                                "example_id": "4beddfbc-92c4-4fb7-9b08-25eb4bc9cdec",
                                                "sense_id": "1ca989da-34db-38af-84f8-cc79a5695729",
                                                "text": "It was brawn and shape for high tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "105f464a-94e9-33f2-b37b-18ab26e05567",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
                                            "A loaded die."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db284e68-d6dd-43cc-9105-bc9bb45502b1",
                                                "sense_id": "105f464a-94e9-33f2-b37b-18ab26e05567",
                                                "text": "A top cheater seldom ever uses shapes or loaded dice because they do not assure you of winning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e14b9d-2fd6-3f89-93f9-7397826425e3",
                                        "entry_id": "7e81a928-7576-36cd-a5f0-acda03e5253b",
                                        "glosses": [
