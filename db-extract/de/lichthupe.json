                    {
                        "sense_id": "32daf475-ef7c-397d-acda-726a2556da3a",
                        "entry_id": "ce17b8b2-d862-3dc9-8afd-582a0af11afa",
                        "glosses": [
                            "Vorrichtung, mit der man die Fernscheinwerfer bzw. den Glühfaden des Fernlichts an Kraftfahrzeugen aktivieren kann, um damit zu Blinken, d. h. einen kurzen Lichtimpuls zu erzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4746d988-3a05-4951-918b-cd8689815590",
                                "sense_id": "32daf475-ef7c-397d-acda-726a2556da3a",
                                "text": "Mit der Lichthupe muss man vorsichtig umgehen."
                            },
                            {
                                "example_id": "00415d10-b2d0-46c5-ac8a-fc2c8ed34180",
                                "sense_id": "32daf475-ef7c-397d-acda-726a2556da3a",
                                "text": "„Der Fahrer betätigt die Lichthupe, um sich zu bedanken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
