                "senses": [
                    {
                        "sense_id": "018b9efd-9fb2-3fbf-92fe-5594d7cdbdb9",
                        "entry_id": "2d1e0f17-85d3-31db-8011-0221f72445e9",
                        "glosses": [
                            "eine vom Teufel gegossene Flintenkugel, die jederzeit absolut sicher trifft; eine durch teuflischen Zauber „frei“ gemachte, das heißt geschützte Kugel"
                        ],
                        "tags": [
                            "Jagdmythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4534fa54-b054-4f87-9b34-2e382f8249ef",
                                "sense_id": "018b9efd-9fb2-3fbf-92fe-5594d7cdbdb9",
                                "text": "Nach der Sage treffen von sieben mit Hilfe des Teufels erlangten Freikugeln sechs unfehlbar; die siebte Kugel lenkt der Teufel."
                            },
                            {
                                "example_id": "f1f0de1d-0e3d-4d5b-a84e-16c4535d9c1d",
                                "sense_id": "018b9efd-9fb2-3fbf-92fe-5594d7cdbdb9",
                                "text": "„Nachdem er diesen beim Wettschießen mit den Bauern vertan hat, akzeptiert er die Freikugeln des zweiten Jägerburschen Kaspar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
