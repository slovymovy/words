                    }
                ],
                "translations": [
                    {
                        "translation_id": "484ce647-651d-4bdb-9140-e5c0a791bacd",
                        "source_entry_id": "e9c5e1d3-513d-397a-beaf-7d26ca69ec7b",
                        "target_lang_word": "féconder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "féconder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1eae5a21-04a5-3342-8a86-848889e1f907",
                                        "entry_id": "07536510-7a10-3a2e-8599-e6414d51b98a",
                                        "glosses": [
                                            "Rendre fécond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f3ad55-4e58-4278-8ec5-514e0c07fcb9",
                                                "sense_id": "1eae5a21-04a5-3342-8a86-848889e1f907",
                                                "text": "Féconder un champ."
                                            },
                                            {
                                                "example_id": "8c77a0e5-d42f-43fd-b20d-5eba72edf276",
                                                "sense_id": "1eae5a21-04a5-3342-8a86-848889e1f907",
                                                "text": "La pluie a fécondé la campagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a5c9c3-15c7-386f-a7e2-3add5ced7bea",
                                        "entry_id": "07536510-7a10-3a2e-8599-e6414d51b98a",
                                        "glosses": [
                                            "Initier la reproduction sexuelle, en transformant un ovule en œuf."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d3a568a-a013-4603-ad86-062d6b761039",
                                                "sense_id": "d1a5c9c3-15c7-386f-a7e2-3add5ced7bea",
                                                "text": "Tous les ans, M. Millardet féconde des vignes américaines par du pollen des vignes françaises."
                                            },
                                            {
                                                "example_id": "1edce55a-d654-4baf-a64f-37f883fb9b5e",
                                                "sense_id": "d1a5c9c3-15c7-386f-a7e2-3add5ced7bea",
                                                "text": "Quelle foi en la longévité de l’homme, en sa force créatrice, en sa toute-puissance sur la femme, ces extraordinaires histoires d’hommes de cent ans fécondant encore leurs épouses, recevant leurs servantes dans leur lit, accueillant les jeunes veuves et les vierges qui passent !"
                                            },
                                            {
                                                "example_id": "36f7f7be-4226-4c17-9a58-26faf9127bd7",
                                                "sense_id": "d1a5c9c3-15c7-386f-a7e2-3add5ced7bea",
                                                "text": "– Donc, Marcelle est enceinte, se dit le colonel qui vient de se retirer dans sa chambre. Et moi qui hésitais à la regarder trop longtemps comme si j’avais eu peur de la féconder à distance !"
                                            },
                                            {
                                                "example_id": "19bab1fe-f7bf-4afd-9cc0-04e0df30ae95",
                                                "sense_id": "d1a5c9c3-15c7-386f-a7e2-3add5ced7bea",
                                                "text": "À mesure que les ovules quittent le ventre de la femelle, ils sont fécondés par le mâle. La semence s’échappe par l’orifice anal."
                                            },
                                            {
