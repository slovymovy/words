                    {
                        "translation_id": "e2a1b8d1-34f8-443e-9ec7-6a73cd53a090",
                        "source_entry_id": "a0b7dd3b-693f-381f-86e8-067974950ed0",
                        "source_sense_description": "temps après l’accouchement",
                        "target_lang_word": "Puerperium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puerperium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f50c736e-5c11-30a0-9479-e4c45a5e44f3",
                                        "entry_id": "ef1f4631-14d3-3652-a733-f553b1deca3a",
                                        "glosses": [
                                            "Wochenbett, die sechs bis acht Wochen nach der Entbindung, in denen sich die Geschlechtsorgane der Frau (mit Ausnahme der Brüste) auf den Zustand vor der Schwangerschaft zurückbilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322c7d32-1217-4600-9c1a-cb67535ce426",
                                                "sense_id": "f50c736e-5c11-30a0-9479-e4c45a5e44f3",
                                                "text": "„Er geht davon aus, dass jeder Uterus, der nach dem Puerperium unter die virginellen Proportionen heruntergeht, als atrophisch angesehen werden muss.“"
                                            },
                                            {
                                                "example_id": "be0c34f5-7e18-406e-921f-2e72d6bc8dbd",
                                                "sense_id": "f50c736e-5c11-30a0-9479-e4c45a5e44f3",
                                                "text": "„Dass Puerperien und Abortus auf vorhandene Krankheitsprocesse verschlimmernd einwirken, wird jeder zugeben, und so gilt es auch für die rheumatoide Arthritis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "447e51fc-4d44-4d5b-8e0d-e6c0800a84eb",
                        "source_entry_id": "a0b7dd3b-693f-381f-86e8-067974950ed0",
                        "source_sense_description": "temps après l’accouchement",
                        "target_lang_word": "Wochenbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wochenbett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41e0684f-34ad-3642-ab75-522b5de0f3c5",
                                        "entry_id": "a3f0f7a9-fd57-36f3-8940-cc396c42f5a2",
                                        "glosses": [
                                            "die sechs bis acht Wochen nach der Entbindung, in denen sich die weiblichen Geschlechtsorgane mit Ausnahme der Brüste auf ihren normalen Zustand vor der Schwangerschaft zurückentwickeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0105d4b4-69d6-4795-a440-26574079a8ea",
                                                "sense_id": "41e0684f-34ad-3642-ab75-522b5de0f3c5",
                                                "text": "„Comber war so vermögend, dass er außer Rachel noch männliche Dienstboten und während des Wochenbetts seiner Frau zusätzlich eine Krankenpflegerin beschäftigen konnte.“"
                                            },
                                            {
                                                "example_id": "d97cd6d9-a791-4145-9f4c-f81250fe0f92",
                                                "sense_id": "41e0684f-34ad-3642-ab75-522b5de0f3c5",
                                                "text": "„Die Mutter sei im Wochenbett gestorben, der Vater ein Jahr später bei einem Autounfall.“"
                                            },
                                            {
                                                "example_id": "85b534fe-f1f0-488f-8eae-67a334e6b01e",
                                                "sense_id": "41e0684f-34ad-3642-ab75-522b5de0f3c5",
                                                "text": "„Eine Frau kam wegen Stupor und Mutismus, aufgetreten im Wochenbett, zur stationären Behandlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3393155-62fb-4b37-bcae-1fcb2b1f9da1",
                        "source_entry_id": "a0b7dd3b-693f-381f-86e8-067974950ed0",
                        "source_sense_description": "temps après l’accouchement",
                        "target_lang_word": "Kindbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindbett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                        "entry_id": "5630d242-0c38-3ffc-8fd9-df0ea77988d9",
                                        "glosses": [
                                            "die ersten sechs bis acht Wochen nach der Entbindung, während derer sich die weiblichen Geschlechtsorgane mit Ausnahme der Brüste auf ihren normalen Zustand vor der Schwangerschaft zurückbilden"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8969813-1741-4ce8-bfa6-a28b969a317a",
                                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                                "text": "Frauen im Kindbett sind stark infektionsgefährdet."
                                            },
                                            {
                                                "example_id": "3584c4e3-7c86-4948-b152-4df8981e4b2e",
                                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                                "text": "„Seine Frau hatte er im Kindbett verloren.“"
                                            },
                                            {
                                                "example_id": "c488efd0-3f6d-4e6a-bee4-ffae1a191055",
                                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                                "text": "„McKennoch, dem die Frau vor kurzem im Kindbett weggestorben, geachtet und rüstig, meinte, sie könnten sich ebensogut zusammentun, zwei ledige Hälften jede für sich, das hätte wenig Sinn.“"
                                            },
                                            {
                                                "example_id": "f7a4de54-348c-4882-8736-5894487a5f3d",
                                                "sense_id": "3c0945e6-59dd-30b4-868e-1ea726d2bfe4",
                                                "text": "„Vielleicht konnte sie sich auch darum nicht als Ehefrau und Mutter sehen, Kindbetten sind riskant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3feb487d-ce36-4767-b54e-f2d7992a0432",
