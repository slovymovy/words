                        "form": "barricadetjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a50b998-fb45-3a64-af55-1c295fe973f9",
                        "entry_id": "c03c0698-5b39-3042-be36-28937e85f8c0",
                        "glosses": [
                            "straatversperring die de doorgang door een straat onmogelijk maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc3596b-17d0-48fd-82ce-b8604860cb97",
                                "sense_id": "3a50b998-fb45-3a64-af55-1c295fe973f9",
                                "text": "De oproerlingen richtten veel barricades op om de politietroepen tegen te houden."
                            }
                        ]
                    },
                    {
                        "sense_id": "69f97f35-9d92-37ca-af09-1962f22db47a",
                        "entry_id": "c03c0698-5b39-3042-be36-28937e85f8c0",
                        "glosses": [
                            "op de barricade gaan: protesteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8742f26e-0114-43b4-9c79-3f9a5e555a62",
                                "sense_id": "69f97f35-9d92-37ca-af09-1962f22db47a",
                                "text": "Hij klom voor ieder onrecht op de barricade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d664ecc4-adcd-42fc-b69b-eb12d863e809",
                        "source_entry_id": "c03c0698-5b39-3042-be36-28937e85f8c0",
                        "source_sense_id": "3a50b998-fb45-3a64-af55-1c295fe973f9",
                        "source_sense_description": "straatversperring die de doorgang door een straat onmogelijk maakt",
                        "target_lang_word": "Barrikade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barrikade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "443d700a-5488-3b2d-9bd1-ea6d2e76ad2b",
                                        "entry_id": "2b860ad0-bc50-3d02-a0a4-2b73c8bc6dcc",
                                        "glosses": [
                                            "Schutzwall im Straßenkampf, der aus Gegenständen des alltäglichen Lebens meist improvisiert zusammengestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c41fb674-e270-46d1-b7f5-e95a80f45f0c",
                                                "sense_id": "443d700a-5488-3b2d-9bd1-ea6d2e76ad2b",
                                                "text": "„Manche Politiker sterben auf Barrikaden, auf denen sie gar nicht gestanden sind.“ (François Mitterrand)"
                                            },
                                            {
                                                "example_id": "3622ece9-720c-4e81-b43b-63f70327b0ef",
                                                "sense_id": "443d700a-5488-3b2d-9bd1-ea6d2e76ad2b",
                                                "text": "Die Soldaten errichteten eine Barrikade, um den Nachschublastern den Weg zu verbauen."
                                            },
                                            {
                                                "example_id": "8cc9ae0f-44fc-40af-aeaf-d74bc30eed79",
                                                "sense_id": "443d700a-5488-3b2d-9bd1-ea6d2e76ad2b",
                                                "text": "„Am Schwaanschen Tor wurden Barrikaden gebaut.“"
                                            },
                                            {
                                                "example_id": "68913aa7-c5da-4b38-b858-9d05f6c07285",
                                                "sense_id": "443d700a-5488-3b2d-9bd1-ea6d2e76ad2b",
                                                "text": "„Die Prager bauten in der Nacht vom 5. Mai knapp zweitausend Barrikaden.“"
                                            },
                                            {
                                                "example_id": "4a74dbf3-1491-4c01-94bd-c7a3cf231bf8",
                                                "sense_id": "443d700a-5488-3b2d-9bd1-ea6d2e76ad2b",
                                                "text": "„Hinter der Barrikade sprangen wilde Gestalten herum, plötzlich fielen Schüsse.“"
                                            },
                                            {
                                                "example_id": "16464464-a500-425f-bfe8-eb05f53fb53d",
                                                "sense_id": "443d700a-5488-3b2d-9bd1-ea6d2e76ad2b",
                                                "text": "„Das Geschrei hinter der Barrikade im Tor war verstummt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89c48957-652b-4c9c-bf61-7f726774759b",
                        "source_entry_id": "c03c0698-5b39-3042-be36-28937e85f8c0",
                        "source_sense_id": "3a50b998-fb45-3a64-af55-1c295fe973f9",
                        "source_sense_description": "straatversperring die de doorgang door een straat onmogelijk maakt",
                        "target_lang_word": "barricade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barricade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fabf693-67be-334e-8daa-be0a707bddc3",
                                        "entry_id": "338f17cc-a4af-31a3-9c22-c84e546c162b",
                                        "glosses": [
                                            "A barrier constructed across a road, especially as a military defence"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28cdfb1d-3b65-3480-82cc-eaa57f903945",
                                        "entry_id": "338f17cc-a4af-31a3-9c22-c84e546c162b",
                                        "glosses": [
                                            "An obstacle, barrier, or bulwark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "080c4b76-eec2-4ded-b48b-d6245690589e",
                                                "sense_id": "28cdfb1d-3b65-3480-82cc-eaa57f903945",
                                                "text": "Such a barricade as would greatly annoy, or absolutely stop, the currents of the atmosphere."
                                            },
                                            {
                                                "example_id": "0c012bed-8dca-4b14-aec2-653fdb6d9279",
                                                "sense_id": "28cdfb1d-3b65-3480-82cc-eaa57f903945",
                                                "text": "Her future friend from grade six, Millie Mirarch, was often caught in various parts of the school being told that she was extremely pretty —for a girl with teeth held together by a metal wire that protruded well beyond the barricade of her lips."
                                            },
                                            {
                                                "example_id": "016985f0-ae79-4351-83bc-71930d43977f",
                                                "sense_id": "28cdfb1d-3b65-3480-82cc-eaa57f903945",
                                                "text": "Salah will ask himself forever how he did not score at least one goal here. He might have nightmares featuring the face of Courtois, such was the one-man barricade he formed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffc9c73b-2fb4-3a79-9e60-f80180fa6a54",
                                        "entry_id": "338f17cc-a4af-31a3-9c22-c84e546c162b",
                                        "glosses": [
                                            "A place of confrontation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45d9ea28-0d4b-4fdc-9d29-51d4912f3d8d",
                                                "sense_id": "ffc9c73b-2fb4-3a79-9e60-f80180fa6a54",
                                                "text": "I have a friend who finds the whole idea of a gay marching band distasteful on the grounds that it replicates straight culture. I'm not ready to follow her to the barricades on that because I think that to some extent the sight of women banging bass drums and men prancing around in pink spandex has to undermine a patriarchal and heterosexist assumption or two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "175f2d2c-12ae-3c0d-97d3-b852d02dea82",
                                        "entry_id": "338f17cc-a4af-31a3-9c22-c84e546c162b",
                                        "glosses": [
                                            "Line of people standing behind or closest to the barricade in the pit section of a live music concert."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "barricade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6967f275-789e-3856-94dd-782494e8e928",
                                        "entry_id": "171f136b-f7f0-3092-b3be-da629ea44a8d",
                                        "glosses": [
                                            "To close or block a road etc., as, or using, a barricade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3f10ee-0913-4565-bc96-0e48a6dd61ac",
                                                "sense_id": "6967f275-789e-3856-94dd-782494e8e928",
                                                "text": "I stood beside the sources of the Arveiron, which take their rise in a glacier, that with slow pace is advancing down from the summit of the hills, to barricade the valley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad83ae8-320f-35fa-a346-a26465aa2782",
                                        "entry_id": "171f136b-f7f0-3092-b3be-da629ea44a8d",
                                        "glosses": [
                                            "To keep someone in (or out), using a blockade, especially ships in a port."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
