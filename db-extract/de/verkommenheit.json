                                        "glosses": [
                                            "tentativo di ricavare un vago piacere, appunto insano ed immorale, tramite la mortificazione, il danno, addirittura la violenza, la menomazione, quindi persino ferite e/o lesioni e gli effetti di questi, perciò normalmente indesiderati"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
