                        "glosses": [
                            "Of, relating to, or discharging sanies; ichorous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c2cfa4-f765-476a-8a19-e12740dd4537",
                                "sense_id": "28d0bfbd-c4e9-307b-8e2f-13b16a3849a8",
                                "text": "Furthermore, I touched with the pure solution the most sanious portions, especially the portions of the bones."
                            },
                            {
                                "example_id": "9a240f85-e19a-4884-bd17-1f7e397435e2",
                                "sense_id": "28d0bfbd-c4e9-307b-8e2f-13b16a3849a8",
                                "text": "The ulcers are then, also, more sanious and humid."
                            },
                            {
                                "example_id": "d13912fc-9d3a-4a1d-9eb9-e3c5d3d2a7dc",
                                "sense_id": "28d0bfbd-c4e9-307b-8e2f-13b16a3849a8",
                                "text": "The discharge from the nose associated with the presence of a fibrous polypus is as a rule more scanty, and thinner, more sanious, and more liable to become foul and ozamic than the mucous discharge usually associated with the presence of the softer growths."
                            }
                        ]
                    }
