                        "glosses": [
                            "Auflistung von Hotels mit den wichtigsten Informationen in einer bestimmten Gegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14f3262f-fded-4f4b-a7e6-7d1fa9331b82",
                                "sense_id": "f84a725f-55a1-3db6-9038-4d3ff6d7fe24",
                                "text": "„Es sei nicht zumutbar, wenn sich die von der Bundeswehr gebuchten Übernachtungshotels in einem Viertel befänden, ‚das der homosexuellen Szene zuzuordnen‘ sei, noch dazu in der Nähe ‚einschlägiger Lokale‘. Mit dem Schreiben reagiert das Ministerium auf den Protest eines Hotels in der Kölner Innenstadt, das die Bundeswehr vor einigen Monaten aus ihrem Hotelverzeichnis gestrichen hatte.“"
                            }
