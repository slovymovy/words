                "senses": [
                    {
                        "sense_id": "765c4d0d-080a-3833-aac7-24834c8ddcca",
                        "entry_id": "8272dc15-b2a1-313b-8ff6-d0b48a7b2791",
                        "glosses": [
                            "one-man show; solo exhibition"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f495f7e0-77df-4afc-90a2-91c71e0cf8d4",
                                "sense_id": "765c4d0d-080a-3833-aac7-24834c8ddcca",
                                "text": "\"Ich bin bereit, daran mitzuwirken. Aber ich bin es nur, wenn wir dann wirklich eine Mannschaft haben, ein Team haben. Das ist dann weder eine One-Man-Show noch ein One-Woman-Show, das ist dann eine Mannschaft, ein Team.\""
                            },
                            {
                                "example_id": "f13b57b3-9d8a-4384-aad6-be47adab61e7",
                                "sense_id": "765c4d0d-080a-3833-aac7-24834c8ddcca",
                                "text": "Es war keine One-Man-Show, sondern richtiges Teamwork.",
                                "translation": "It was no one-man show, but real teamwork.",
                                "english": "It was no one-man show, but real teamwork."
                            }
                        ]
                    }
