    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                "word": "unceremoniously",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0d614a50-87df-428a-932b-511eff81bcd8",
                        "entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more unceremoniously"
                    },
                    {
                        "form_id": "bf4afe21-1575-4a62-830f-c75e504ec1da",
                        "entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unceremoniously"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                        "entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                        "glosses": [
                            "In an unceremonious manner, abruptly, without the due formalities."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49bef1e-270c-40ef-95f7-63f6984881f0",
                                "sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                                "text": "Encountering difficulties with the parcels’ unhelpful recipient, the deliveryman unceremoniously dumped the packages in the street outside the door."
                            },
                            {
                                "example_id": "14ef131d-3037-4f42-9f61-51b678a433e3",
                                "sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                                "text": "Given these operational constraints and a renewed focus on the environment, plans to electrify the [Windermere] branch resurfaced in 2013 when the Department for Transport consented to a £16 million scheme to erect wires by 2024. Unfortunately, it was one of a trio of projects to then be unceremoniously scrapped by former Secretary of State for Transport Chris Grayling in July 2017, in response to spiralling costs on the Great Western Electrification Programme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f5d7b8f-a7a9-4f4e-b5cc-18b0164f3b37",
                        "source_entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                        "source_sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "sans cérémonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans cérémonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c644dd9-2bd7-349c-b618-2c9ada9f903d",
                                        "entry_id": "e82b00f6-2a20-3b1d-9549-3a18b86d8339",
                                        "glosses": [
                                            "Sans façons, de manière informelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f66af78-6e4f-41a0-bce0-f3689519862e",
                                                "sense_id": "3c644dd9-2bd7-349c-b618-2c9ada9f903d",
                                                "text": "Tel était son raisonnement et son désir secret : qu’un beau jour, alors qu’elle serait assise, loin des pensées et des souvenirs, dans la solitude, son cœur dise \"assez\" et que sa vie longue, errante, bouleversée et trop coupable s’éteigne sans cérémonie."
                                            },
                                            {
                                                "example_id": "2b646135-9be8-4e91-b60c-f80a95323503",
                                                "sense_id": "3c644dd9-2bd7-349c-b618-2c9ada9f903d",
                                                "text": "On aurait dit qu’un club de gentlemen avait été propulsé sans cérémonie sur un bateau à aubes du Mississippi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80a48b21-5f4f-479b-92af-f28f8526f330",
                        "source_entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                        "source_sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "brusquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brusquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                        "entry_id": "82c0c783-c8f1-33f2-936c-a1fc6db995fc",
                                        "glosses": [
                                            "D’une manière brusque, inattendue ou soudaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "371e672b-b57b-4d75-9bfa-33dc15450ce6",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Nous en profitons pour bifurquer brusquement et nous arrivons enfin en zigzaguant à nous mettre hors de la portée de notre intrus."
                                            },
                                            {
                                                "example_id": "03e2df45-a321-4a0c-be3b-7c6c8824974e",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Il agit donc sur la tirette, le rideau se releva brusquement, et alors, à la stupéfaction générale, on vit saint Jean-Baptiste, en pyjama bleu de ciel, […]"
                                            },
                                            {
                                                "example_id": "dcddf69d-92c0-49fa-84af-f82f920fa0b6",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Comme ils franchissaient le seuil, des formes invisibles surgirent, brusquement, de l'ombre. C'était les slouguis qui se précipitaient, menaçants. Mᵐᵉ Durelle poussa un cri."
                                            },
                                            {
                                                "example_id": "8a453ece-0e37-4a9b-93cc-dd79ef22cd65",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "La vie, après de longs mois d'hivernage, avait été arrêtée brusquement par l'arrivée de navire de la délivrance."
                                            },
                                            {
                                                "example_id": "1507e152-8e90-46d8-9477-4064bd2c1d70",
                                                "sense_id": "d42d4f0c-ee46-3840-8140-d1cd6fbd2e19",
                                                "text": "Cette assimilation au statut « d’homme », ce nivellement, cette rapidité de communication profonde avec les gens de notre âge, cet univers quotidien brusquement peuplé de gens de quarante ans finissent par être si évident à Berthoux qu’il hyper-simplifie et se met à inclure dans sa quarantaine tout individu qui recoupe son orbite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f281aaf3-a67a-4b97-ad80-6c246d984623",
                        "source_entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                        "source_sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "abruptement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abruptement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                        "entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                                        "glosses": [
                                            "De façon brutale, et non graduelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa97ea87-cb12-4cd4-ac7d-71fd8d95b30d",
                                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                                "text": "Ne pas annoncer abruptement un diagnostic de mort imminente peut être assimilé à une forme d'hypocrisie."
                                            },
                                            {
                                                "example_id": "e39a6e8b-de2a-4b7a-91e7-15ce641fa4ab",
                                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                                "text": "Hier, il a prononcé un discours hallucinant – tellement truffé de mensonges que de grands médias américains ont même dû mettre fin abruptement à sa diffusion, du jamais-vu."
                                            },
                                            {
                                                "example_id": "683c01d4-26d0-4ab5-bc87-f4aaf1f7e7d5",
                                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                                "text": "L’aveu tombe abruptement lorsque la présidente, Aurore Pecquet, l’interroge sur ses loisirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0dd6916-7e41-4deb-9ec2-a4fb8031dcf8",
                        "source_entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                        "source_sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
