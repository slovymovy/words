                },
                {
                    "sense_id": "12ebe8d6-d727-3fd7-9f19-0e4737924f96",
                    "sense_definition": "Iets in overweging nemen of de voor- en nadelen bekijken voordat men een besluit neemt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decision_making",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>denkt</w> <w>na</w> over een verhuizing naar het buitenland.",
                            "target_lang_translations": {
                                "en": "She is <w>thinking</w> about moving abroad.",
                                "ru": "Она <w>обдумывает</w> переезд за границу.",
                                "it": "Sta <w>riflettendo</w> su un trasferimento all'estero."
                            }
                        },
                        {
                            "text": "We hebben er lang over <w>nagedacht</w>, maar we doen het toch niet.",
                            "target_lang_translations": {
                                "en": "We <w>thought</w> about it for a long time, but we are not doing it anyway.",
                                "ru": "Мы долго <w>размышляли</w> над этим, но всё же не будем этого делать.",
                                "it": "Ci abbiamo <w>pensato</w> a lungo, ma alla fine non lo faremo."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwegen",
                        "peinzen",
                        "overpeinzen"
                    ],
                    "common_phrases": [
                        "erover nadenken"
                    ],
                    "target_lang_definitions": {
                        "en": "To take something into consideration or weigh the pros and cons before making a decision.",
                        "ru": "Принимать что-то во внимание или взвешивать за и против перед принятием решения.",
                        "it": "Prendere in considerazione qualcosa o valutare i pro e i contro prima di prendere una decisione."
                    },
