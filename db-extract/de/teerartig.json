                "senses": [
                    {
                        "sense_id": "4f671e25-44ee-369b-a58a-45b043c0e5e4",
                        "entry_id": "a6d8067c-b329-3a52-96fe-7ef9af4c2f80",
                        "glosses": [
                            "Teer ähnelnd, an Teer erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555b9b2b-c5eb-4716-8428-cbafbb713eb8",
                                "sense_id": "4f671e25-44ee-369b-a58a-45b043c0e5e4",
                                "text": "„Die Gebäude waren von einer dicken teerartigen Substanz überzogen, die Ähnlichkeit mit dem geschmolzenen Schneckenschleim auf seiner Uniform besaß.“"
                            },
                            {
                                "example_id": "7396f614-8751-40fd-a12c-1be91f1905ca",
                                "sense_id": "4f671e25-44ee-369b-a58a-45b043c0e5e4",
                                "text": "„Die Dose schien leer zu sein, doch an ihrer Innenseite klebten Reste einer teerartigen Substanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
