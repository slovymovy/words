                        "glosses": [
                            "Subir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2397fbc8-a8a2-43e3-be79-a3b0c9edaa37",
                                "sense_id": "ac096ed4-8bd2-3fec-9734-8a9e740d184e",
                                "text": "Dehors, les saules décrochent, tout à coup se redressent avant de resubir, la terre est éteinte."
                            },
                            {
                                "example_id": "81e87f37-99fd-4363-abc0-aaf774850a63",
                                "sense_id": "ac096ed4-8bd2-3fec-9734-8a9e740d184e",
                                "text": "Le malade doit resubir les déceptions qu'il a éprouvées quand il était enfant, pour pouvoir travailler dessus et les dépasser."
                            }
                        ]
                    }
