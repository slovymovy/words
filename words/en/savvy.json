                            }
                        },
                        {
                            "text": "With his <w>savvy</w> marketing strategies, the startup quickly gained a large market share.",
                            "target_lang_translations": {
                                "ru": "Благодаря его <w>продуманным</w> маркетинговым стратегиям стартап быстро завоевал большую долю рынка."
                            }
                        }
                    ],
                    "synonyms": [
                        "canny"
                    ],
                    "common_phrases": [
                        "savvy businesswoman",
                        "savvy marketing strategies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal or business contexts to describe practical knowledge."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проницательный, хорошо информированный, сообразительный и практичный."
                    },
                    "translations": {
                        "ru": [
                            {
