                                        "glosses": [
                                            "The act by which things are combined or brought together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "807c0bb5-ac22-4420-b426-b89c9ac250d7",
                                                "sense_id": "c2059486-5d15-3c81-b962-16115c756ab9",
                                                "text": "these little combinings together, of friends, for objects in themselves extremely laudable, but which the law terms conspiracies"
                                            }
