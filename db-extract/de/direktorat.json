                "senses": [
                    {
                        "sense_id": "8ac6c263-363b-3e64-950d-0733307e915d",
                        "entry_id": "87806af6-7ee3-3c5a-af79-8ae0532d4cf8",
                        "glosses": [
                            "dienstliche Stellung einer leitenden Persönlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf806e3-a253-4f63-bead-275361cb1aa5",
                                "sense_id": "8ac6c263-363b-3e64-950d-0733307e915d",
                                "text": "„Daher entschloß man sich schließlich unter dem Direktorat von Julius Hardeland, 1878 ein Missionsseminar im Stile derjenigen der RMG und der Basler Mission einzurichten, in dem die Ausbildung sechs Jahre dauerte.“"
                            },
                            {
                                "example_id": "3ae57742-d283-42d3-929a-de44000a96b3",
                                "sense_id": "8ac6c263-363b-3e64-950d-0733307e915d",
                                "text": "„Dafür wurde nun im Krieg ein Direktorat nach dem anderen aus dem Boden gestampft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2946ede3-8b03-3674-84cf-8ee880099512",
                        "entry_id": "87806af6-7ee3-3c5a-af79-8ae0532d4cf8",
                        "glosses": [
                            "Zeit, die einer leitende Persönlichkeit ihre dienstliche Stellung innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8d950b-d107-4d8a-8140-ae38d78b3f7c",
                                "sense_id": "2946ede3-8b03-3674-84cf-8ee880099512",
                                "text": "„Sein Direktorat dauerte von 1884 bis 1924.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9806c454-9ec1-3caa-a88c-373b45c88cf1",
                        "entry_id": "87806af6-7ee3-3c5a-af79-8ae0532d4cf8",
                        "glosses": [
                            "Amtsraum einer leitenden Persönlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a5eb2f4-b5c4-4d88-86f0-cfd2c4d22a34",
                                "sense_id": "9806c454-9ec1-3caa-a88c-373b45c88cf1",
                                "text": "„Nach dem sehr offenen Gespräch dauerte es nicht lange und Nicolas wurde ins Direktorat gerufen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
