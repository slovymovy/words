                                "target_senses": [
                                    {
                                        "sense_id": "ea6e82e3-d589-3412-ba00-6f7ef04aa1bc",
                                        "entry_id": "b329a13b-6b4c-3742-b7c4-eff369e83fe2",
                                        "glosses": [
                                            "The property of being mutual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a8e4bf-b70c-44c4-979f-d4f715d1ca6c",
                                                "sense_id": "ea6e82e3-d589-3412-ba00-6f7ef04aa1bc",
                                                "text": "The mutuality of mutually assured destruction is key to its function as a deterrent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dd1fe7f-c2cf-43a6-b7b6-519dd356ad63",
                        "source_entry_id": "340a63da-d185-3685-acc1-bc87ab95975b",
                        "source_sense_description": "свойство",
                        "target_lang_word": "reciprocity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reciprocity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca3671a-1b23-36b9-8f03-85b5fd59273e",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "The characteristic of being reciprocal, e.g. of a relationship between people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0042d1cc-fa49-4d21-988d-a32fadbc522b",
                                                "sense_id": "6ca3671a-1b23-36b9-8f03-85b5fd59273e",
                                                "text": "In a friendship, reciprocity occurs where the contribution of each party meets the expectations of the other party."
                                            },
                                            {
                                                "example_id": "86aa0878-b5d1-432b-9f99-1b8e26b70979",
                                                "sense_id": "6ca3671a-1b23-36b9-8f03-85b5fd59273e",
                                                "text": "There might be benefit on one side, and obligation on the other; but their reciprocity of affection, their mutual exchange of small kindnesses—those strongest rivets of common attachment—were no more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56dae442-1642-38a0-8544-b5e918b47d36",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "A reciprocal relationship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ad3642a-7468-3e66-9492-761db6665529",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "A relation of mutual dependence or action or influence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d341069-d082-3e70-9467-c64ce0727012",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "A reciprocal construction involves two noun phrases where each of the participants occupies both the role of agent and patient with respect to the other. see: Wikipedia:Reciprocal pronoun."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f950f99-0507-3d86-9fd1-69b4074a75e8",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "The mutual exchange of rights, privileges or obligations between nations. see: Wikipedia:Reciprocity (international relations)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3676cb6-61cd-3f12-9d2c-c632ca0787e7",
                                        "entry_id": "27898fe7-e68a-34c4-b1fc-62d44857c1d6",
                                        "glosses": [
                                            "The responses of individuals to the actions of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20870c64-af73-42f3-be23-b50b5b0c7a7c",
                        "source_entry_id": "340a63da-d185-3685-acc1-bc87ab95975b",
                        "source_sense_description": "свойство",
                        "target_lang_word": "réciprocité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réciprocité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                        "entry_id": "736f3581-809b-313c-9c97-436e37546154",
                                        "glosses": [
                                            "État, qualité, caractère de ce qui est réciproque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825413cc-929c-4f83-99af-17f5baa5ed5f",
                                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                                "text": "E.-H. Weber a fait remarquer que le nerf vague se trouve en réciprocité d'action avec le grand sympathique. Ce dernier est fort peu développé chez les serpents, […]."
                                            },
                                            {
                                                "example_id": "04f9e5a7-0dae-44e3-9e69-103b0e377f53",
                                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                                "text": "Le système de la réciprocité dans sa forme moderne est le fils ainé du protectionnisme ; s'il en adoucit légèrement les rigueurs, il est l'incarnation même de sa pensée."
                                            },
                                            {
                                                "example_id": "d5f4f573-b5d1-424b-94b4-25990b6ff865",
                                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                                "text": "La destruction des systèmes de réciprocité africains par la colonisation et la généralisation de la domination du marché capitaliste conduisent à l’ethnocide, à l’« économicide » et au génocide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
