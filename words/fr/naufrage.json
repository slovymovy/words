                    "frequency": "Middle",
                    "semantic_group_id": "perte_navire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipage a été secouru juste avant le <w>naufrage</w> du navire marchand."
                        },
                        {
                            "text": "Les survivants racontent comment ils ont échappé à ce terrible <w>naufrage</w> en pleine nuit."
                        }
                    ],
                    "common_phrases": [
