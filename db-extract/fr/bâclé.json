                        "glosses": [
                            "Qui est fait trop vite et sans soin."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "03ef3a1f-3d42-39f8-bffc-34875082d51f",
                        "entry_id": "34911c2b-d6a4-3cb8-9b24-a4e862c140e7",
                        "glosses": [
                            "En parlant d’une porte, d’une fenêtre : fermé avec une bâcle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fed22c1-4019-4156-b301-3f947f6a598b",
                                "sense_id": "03ef3a1f-3d42-39f8-bffc-34875082d51f",
                                "text": "Une porte ’bâclée'."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a971a8e-6684-39f8-aabf-53c4aaa12005",
                        "entry_id": "34911c2b-d6a4-3cb8-9b24-a4e862c140e7",
                        "glosses": [
                            "En parlant d’un port, d’une rivière : fermé (pour cause de gel). — (Bescherelle, 1845 ; Larousse du xixᵉ siècle ; et Nouveau Larousse illustré)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c48e0d5e-ac25-37f2-b35a-00916e6f33a4",
                        "entry_id": "34911c2b-d6a4-3cb8-9b24-a4e862c140e7",
                        "glosses": [
                            "En parlant d’un bateau : amarré, disposé dans un certain ordre. — (Bescherelle, 1845 ; et Larousse du xixᵉ siècle)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8cb8ff-5e6b-4c3a-9b72-2bd14aa74eff",
                                "sense_id": "c48e0d5e-ac25-37f2-b35a-00916e6f33a4",
                                "text": "À Wapping Old Stairs, les bateaux, bâclés dans un ordre parfait, s’avancent si loin à l’intérieur qu’ils ont l’air de se promener dans les rues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d770cc51-0b13-4fe6-b183-99edec61e3bc",
