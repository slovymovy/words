                "senses": [
                    {
                        "sense_id": "ab2f1086-521d-33e0-be44-d8796507f0a5",
                        "entry_id": "1b189bfa-0a82-356f-a628-9c577ca9b661",
                        "glosses": [
                            "wertvoller, erstrebenswerter, aber nicht lebensnotwendiger Gegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f826d12b-b037-4712-8ff4-58c1309ba9ea",
                                "sense_id": "ab2f1086-521d-33e0-be44-d8796507f0a5",
                                "text": "„Bücher gehörten, neben Möbeln und weit vor den für die meisten Menschen unerreichbaren privaten Automobilen, zu den wichtigsten Luxusgütern.“"
                            },
                            {
                                "example_id": "1d35f5a4-f1b0-4474-ba4b-cf9e7024d2ca",
                                "sense_id": "ab2f1086-521d-33e0-be44-d8796507f0a5",
                                "text": "[Jakarta/Indonesien:] „Trotzdem ist trinkbares Wasser ein Luxusgut. Überhaupt ist Wasser für die 18 Millionen Menschen im Ballungsgebiet ein Grund zur täglichen Sorge. Ursache ist der unverantwortliche Umgang mit Abwässern jeder Art.“"
                            }
                        ],
