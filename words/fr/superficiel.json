{
    "word_family": [
        "superficie",
        "superficialité",
        "superficiellement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "373c8753-7c1e-32b2-a51a-98ae15162668",
                    "sense_definition": "Qui ne pénètre pas en profondeur, qui n'affecte que la surface extérieure d'un corps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a rassuré en disant que ce n'était qu'une blessure <w>superficielle</w>."
                        },
                        {
                            "text": "En été, la couche <w>superficielle</w> du sol s'assèche rapidement sous le soleil."
                        }
                    ],
                    "antonyms": [
                        "profond"
                    ],
                    "common_phrases": [
                        "blessure superficielle",
                        "couche superficielle"
                    ]
                },
                {
                    "sense_id": "bb8bda07-0223-32af-876b-6ea164e690ab",
                    "sense_definition": "Qui reste à la surface des choses, sans réflexion approfondie ni recherche du détail.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son analyse du problème est restée très <w>superficielle</w> et manque de précision."
                        },
                        {
                            "text": "Un examen <w>superficiel</w> du dossier ne permettra pas de déceler les erreurs."
                        }
                    ],
                    "synonyms": [
                        "léger"
                    ],
                    "antonyms": [
                        "profond"
                    ],
                    "common_phrases": [
                        "examen superficiel",
                        "analyse superficielle"
                    ]
                },
                {
                    "sense_id": "2776851d-fea7-364c-8557-e8bfa2e7b631",
                    "sense_definition": "Qui s'attache uniquement aux apparences, à la futilité, et manque de sérieux ou de maturité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme <w>superficiel</w> n'accorde d'importance qu'aux vêtements et aux apparences."
                        },
                        {
                            "text": "Certains pensent qu'elle est <w>superficielle</w>, mais elle cache une grande sensibilité."
                        }
                    ],
                    "synonyms": [
                        "léger"
                    ],
                    "antonyms": [
                        "profond"
                    ],
                    "common_phrases": [
                        "homme superficiel",
                        "esprit superficiel"
                    ]
                },
                {
                    "sense_id": "90789d07-c4f3-3822-9fd2-8ac4de947c4c",
                    "sense_definition": "Qui est relatif à une aire ou à la surface extérieure d'un corps.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tension <w>superficielle</w> permet à certains insectes de marcher sur l'eau."
                        },
                        {
                            "text": "Cette formule permet de calculer l'énergie <w>superficielle</w> de la matière."
                        }
                    ],
                    "synonyms": [
                        "surfacique"
                    ],
                    "common_phrases": [
                        "tension superficielle"
                    ]
                }
            ]
        }
    ]
}