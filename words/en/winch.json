{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cb663c8-abcf-31ae-b17b-4ec47ede811b",
                    "sense_definition": "A mechanical device consisting of a drum around which a rope or cable is wound, used for hauling or hoisting heavy loads.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "winch_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They attached the cable from the <w>winch</w> to the front of the stuck vehicle.",
                            "target_lang_translations": {
                                "ru": "Они прикрепили трос от <w>лебёдки</w> к передней части застрявшего автомобиля."
                            }
                        },
                        {
                            "text": "The sailors turned the <w>winch</w> by hand to raise the heavy cargo onto the deck.",
                            "target_lang_translations": {
                                "ru": "Моряки вручную крутили <w>ворот</w>, чтобы поднять тяжёлый груз на палубу."
                            }
                        }
                    ],
                    "synonyms": [
                        "windlass"
                    ],
                    "common_phrases": [
                        "electric winch",
                        "hand winch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое грузоподъёмное или тяговое устройство в виде барабана, на который наматывается трос или канат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лебёдка",
                                "target_lang_sense_clarification": "механизм для подъёма или подтягивания грузов"
                            },
                            {
                                "target_lang_word": "ворот",
                                "target_lang_sense_clarification": "простое грузоподъёмное устройство с вращаемым валом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32e96cd9-e393-3941-a135-2e0b2d8c37c8",
                    "sense_definition": "A kick made by an animal out of impatience or uneasiness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a sudden <w>winch</w>, the frightened mule threw the rider onto the ground.",
                            "target_lang_translations": {
                                "ru": "Внезапным <w>ударом копыт</w> испуганный мул сбросил всадника на землю."
                            }
                        },
                        {
                            "text": "The horse gave an impatient <w>winch</w> as the stable boy approached.",
                            "target_lang_translations": {
                                "ru": "Лошадь нетерпеливо <w>брыкнула</w>, когда конюх подошёл ближе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар ногой (брыкание), сделанный животным от нетерпения или беспокойства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брыкание",
                                "target_lang_sense_clarification": "удар ногой животного"
                            },
                            {
                                "target_lang_word": "лягание",
                                "target_lang_sense_clarification": "резкий удар копытом или ногой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7097ebe8-773d-3283-820a-4e1c71eb77a3",
                    "sense_definition": "A female practitioner of magic; a witch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old stories told of an evil <w>winch</w> living deep within the dark forest.",
                            "target_lang_translations": {
                                "ru": "Старинные предания рассказывали о злой <w>ведьме</w>, жившей в глубине тёмного леса."
                            }
                        },
                        {
                            "text": "The villagers believed the old <w>winch</w> had cast a curse on their crops.",
                            "target_lang_translations": {
                                "ru": "Жители деревни верили, что старая <w>колдунья</w> прокляла их урожай."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete variant of witch"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, занимающаяся магией и колдовством; ведьма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведьма",
                                "target_lang_sense_clarification": "колдунья"
                            },
                            {
                                "target_lang_word": "колдунья",
                                "target_lang_sense_clarification": "женщина-маг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7a9ed0c-be09-34bb-9bdb-bfac23396e73",
                    "sense_definition": "To haul, pull, or lift something using a mechanical winch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "winch_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue crew managed to <w>winch</w> the injured hiker up to the helicopter.",
                            "target_lang_translations": {
                                "ru": "Спасателям удалось <w>поднять на лебёдке</w> пострадавшего туриста в вертолёт."
                            }
                        },
                        {
                            "text": "They used a tow truck to slowly <w>winch</w> the vehicle out of the muddy ditch.",
                            "target_lang_translations": {
                                "ru": "Они использовали эвакуатор, чтобы медленно <w>вытянуть лебёдкой</w> автомобиль из грязного кювета."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoist",
                        "haul"
                    ],
                    "common_phrases": [
                        "winch up",
                        "winch in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать, подтягивать или перемещать что-либо с помощью лебёдки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать с помощью лебёдки",
                                "target_lang_sense_clarification": "подъём груза"
                            },
                            {
                                "target_lang_word": "тянуть лебёдкой",
                                "target_lang_sense_clarification": "вытягивание или перемещение"
                            },
                            {
                                "target_lang_word": "вытягивать лебёдкой",
                                "target_lang_sense_clarification": "вытаскивание машины или груза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbec94e9-a42c-389b-a24e-32a7389093b7",
                    "sense_definition": "To kiss passionately; to make out or snog.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "winch_romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two teenagers stood in the alley outside the dance and started to <w>winch</w>.",
                            "target_lang_translations": {
                                "ru": "Двое подростков стояли в переулке возле танцев и принялись <w>целоваться</w>."
                            }
                        },
                        {
                            "text": "They spent the entire evening <w>winching</w> in the back row of the cinema.",
                            "target_lang_translations": {
                                "ru": "Они провели весь вечер, <w>милуясь</w> на заднем ряду кинотеатра."
                            }
                        }
                    ],
                    "synonyms": [
                        "snog",
                        "kiss"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scottish and Northern English slang"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Informal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Страстно целоваться, миловаться (шотландский и североанглийский сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целоваться",
                                "target_lang_sense_clarification": "страстно целоваться"
                            },
                            {
                                "target_lang_word": "лизаться",
                                "target_lang_sense_clarification": "жаргонный вариант"
                            },
                            {
                                "target_lang_word": "миловаться",
                                "target_lang_sense_clarification": "обниматься и целоваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4761f6a8-6df1-3450-bbf4-dab54cbe5e8e",
                    "sense_definition": "To date or court someone romantically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "winch_romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent most of that summer trying to <w>winch</w> a girl from the neighbouring village.",
                            "target_lang_translations": {
                                "ru": "Он провёл большую часть того лета, пытаясь <w>приударить за</w> девушкой из соседней деревни."
                            }
                        },
                        {
                            "text": "Before they decided to marry, they had been <w>winching</w> for over two years.",
                            "target_lang_translations": {
                                "ru": "Прежде чем решить пожениться, они <w>встречались</w> больше двух лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "court",
                        "date"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scottish usage"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Встречаться, ухаживать за кем-либо в романтическом плане."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "быть парой"
                            },
                            {
                                "target_lang_word": "ухаживать",
                                "target_lang_sense_clarification": "добиваться взаимности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "867b35df-0fa8-3050-9e87-89bbb69b929c",
                    "sense_definition": "To flinch or shrink back, as from pain or distress; to <w>wince</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even when faced with punishment, the defiant prisoner refused to <w>winch</w>.",
                            "target_lang_translations": {
                                "ru": "Даже столкнувшись с наказанием, непокорный узник отказался <w>дрогнуть</w>."
                            }
                        },
                        {
                            "text": "He did not <w>winch</w> once as the physician dressed the painful wound.",
                            "target_lang_translations": {
                                "ru": "Он ни разу не <w>поморщился</w>, пока лекарь перевязывал болезненную рану."
                            }
                        }
                    ],
                    "synonyms": [
                        "flinch",
                        "wince",
                        "cringe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic spelling or form of wince"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вздрагивать, сжиматься или пятиться от боли либо испуга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздрагивать",
                                "target_lang_sense_clarification": "от боли или неожиданности"
                            },
                            {
                                "target_lang_word": "морщиться",
                                "target_lang_sense_clarification": "от боли или неприятного ощущения"
                            },
                            {
                                "target_lang_word": "сжиматься",
                                "target_lang_sense_clarification": "от страха или боли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7c98a07-2385-3f58-a066-ec2d87fcf389",
                    "sense_definition": "To kick out impatiently or restlessly, as an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The irritated donkey began to <w>winch</w> whenever anyone drew near.",
                            "target_lang_translations": {
                                "ru": "Раздражённый осёл начинал <w>брыкаться</w> каждый раз, когда кто-то подходил близко."
                            }
                        },
                        {
                            "text": "She backed away as the startled beast began to rear and <w>winch</w>.",
                            "target_lang_translations": {
                                "ru": "Она отступила назад, когда испуганный зверь начал вставать на дыбы и <w>лягаться</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Брыкаться, лягаться от нетерпения или раздражения (о животных)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брыкаться",
                                "target_lang_sense_clarification": "лягаться ногами от беспокойства"
                            },
                            {
                                "target_lang_word": "лягаться",
                                "target_lang_sense_clarification": "бить копытами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9e474655-cf6e-3c76-af1c-1bdd186b438e",
                    "sense_definition": "An English surname derived from Old English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Winch</w> delivered an insightful lecture on early British legal history.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Уинч</w> прочёл глубокую лекцию по ранней британской истории права."
                            }
                        },
                        {
                            "text": "Records indicate that the <w>Winch</w> family has lived in this parish for centuries.",
                            "target_lang_translations": {
                                "ru": "Записи указывают на то, что семья <w>Уинч</w> жила в этом приходе на протяжении столетий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name of Old English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия древнеанглийского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уинч",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}