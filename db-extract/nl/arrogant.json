                    {
                        "form_id": "136db4fb-260e-4230-846d-d58aa3f9fd49",
                        "entry_id": "aa84377a-1e26-3719-a3d7-f80bd279ec96",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "arroganters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                        "entry_id": "aa84377a-1e26-3719-a3d7-f80bd279ec96",
                        "glosses": [
                            "te veel met zichzelf ingenomen, verwaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "451f7861-9cd1-4b0a-b5b1-af9610819675",
                                "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                                "text": "Heb jij mij verraden? Wat ben je toch een arrogante kwal!"
                            },
                            {
                                "example_id": "91e03a61-5087-4731-ba4f-af18d4854341",
                                "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                                "text": "De arrogante leerling pronkte met zijn hoge cijfers."
                            },
                            {
                                "example_id": "725b72e6-ae1f-4061-a867-52842039938c",
                                "sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                                "text": "Maar vergis je niet, dit was geen utopisch paradijs. Er waren de nodige vervelende lui, die onbeschoft, arrogant of verwend waren en ik deed mijn best om ze te vermijden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5319000-8675-4c74-a0d5-ae57494bc4d5",
                        "source_entry_id": "aa84377a-1e26-3719-a3d7-f80bd279ec96",
                        "source_sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                        "target_lang_word": "arrogant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2470dad-962f-3a30-be57-2fb11ff28b6f",
                                        "entry_id": "3bd3ce46-434b-38a3-ba66-6523064ef33d",
                                        "glosses": [
                                            "überheblich und genüsslich seine vermeintlich besseren Einflüsse oder Fähigkeiten zeigend; selbstgefällig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626d9b69-01c4-4f3d-8740-ef8cf8b15199",
                                                "sense_id": "c2470dad-962f-3a30-be57-2fb11ff28b6f",
                                                "text": "„Ich kann sein arrogantes Lächeln einfach nicht mehr sehen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf45fcbf-d211-40d9-afcf-9c41ad957565",
                        "source_entry_id": "aa84377a-1e26-3719-a3d7-f80bd279ec96",
                        "source_sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
                        "target_lang_word": "arrogant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrogant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                        "entry_id": "ebd4659c-5835-3082-9b42-f78701068884",
                                        "glosses": [
                                            "Having excessive pride in oneself, often with contempt or disrespect for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88bf0fb7-948a-4b90-a0be-af07b276b784",
                                                "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                                "text": "The demand to be loved is the greatest of all arrogant presumptions."
                                            },
                                            {
                                                "example_id": "f7bc0e6e-059d-4fb6-bccf-dff151a63cec",
                                                "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                                "text": "Call me a braggart, call me arrogant. People at ABC (and elsewhere) have called me worse. But when you need the job done on deadline, you’ll call me."
                                            },
                                            {
                                                "example_id": "7cfc5ab0-f747-4b34-bbc8-f336a03b0dbf",
                                                "sense_id": "8ad6ff21-ad73-3216-b08e-146b18bc1b9a",
                                                "text": "Transport Minister Marples, meanwhile, used arrogant rhetoric and showed his personal contempt for railways when confirming in Parliament that a third of the network was to be closed even before the survey results were known."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f804f9f3-c776-496a-a260-10717dfe1824",
                        "source_entry_id": "aa84377a-1e26-3719-a3d7-f80bd279ec96",
                        "source_sense_id": "045584d6-16e5-3f2c-ad6e-4d1755dabe77",
