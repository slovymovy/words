                "senses": [
                    {
                        "sense_id": "725b46fd-4ff3-38b0-9862-b6279a6b6335",
                        "entry_id": "3b0a86d8-224e-3d37-84c8-7b7ea78b6a93",
                        "glosses": [
                            "theater geschikt voor het uitvoeren popmuziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15302f8-c269-4eab-8ea8-7cbe4fc7e566",
                                "sense_id": "725b46fd-4ff3-38b0-9862-b6279a6b6335",
                                "text": "De legendarische Grandmaster Flash komt op donderdag 28 november voor een optreden naar het Zwolse poppodium Hedon. De 61-jarige Joseph Saddler, zoals zijn echte naam luidt, is één van de grootste pioniers van hiphopmuziek. Met zijn groep The Furious Five scoorde hij in 1982 de iconische hit ‘The Message’."
                            },
                            {
                                "example_id": "2d0f1089-85dc-4fd3-871c-983ceb9b91bc",
                                "sense_id": "725b46fd-4ff3-38b0-9862-b6279a6b6335",
                                "text": "Die blijdschap en vreugde maakte al snel plaats voor verwarring en teleurstelling: Dream Theater bleek zonder aankondiging zijn sets te hebben aangepast. Geen drie uur durend concert met Scenes of a Memory, terwijl daarmee wel werd gepromoot door festivals en poppodia, maar een flink ingekorte show met maar één nummer van het album."
                            },
                            {
                                "example_id": "b0d4df27-b181-417c-9034-3f6e0806d067",
                                "sense_id": "725b46fd-4ff3-38b0-9862-b6279a6b6335",
                                "text": "Vorig jaar won de Slingerbeurs de Persprijs en het BAM!Festival de Publieksprijs. De genomineerden dit keer zijn: AtelierZ, poppodium Metropool, Stichting Zomerfeesten Beckum, Stichting Tuindorp, Lokaal Fonds Hengelo (Fulldauer), Wijkracht, Voedselbank Midden-Twente en Stichting Sint Nicolaasstad."
                            }
                        ]
                    }
                ],
