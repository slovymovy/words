                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff6b73f3-be85-4ddf-b64a-b65df527792a",
                        "source_entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
                        "source_sense_description": "a dent",
                        "target_lang_word": "Abdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0948d9a6-a8ce-3d4b-853c-926a00c50a94",
                                        "entry_id": "711ce717-5089-3135-830d-eb99664f0f1a",
                                        "glosses": [
                                            "Plural 1: das Abdrücken eines härteren Gegenstandes in einen weicheren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51263ad-0acf-4f5e-8483-952716ffc86b",
                                                "sense_id": "0948d9a6-a8ce-3d4b-853c-926a00c50a94",
                                                "text": "Schon wieder schwarze Abdrücke auf dem Teppich."
                                            },
                                            {
                                                "example_id": "40dcb326-249e-46ea-b1a8-4cb06715b986",
                                                "sense_id": "0948d9a6-a8ce-3d4b-853c-926a00c50a94",
                                                "text": "„An der Stelle, wo früher der Tisch gestanden hat, ist jetzt kein Tisch mehr, aber dort, wo seine Beine waren, sieht man immer noch die vier Abdrücke im Fußboden.“"
                                            },
                                            {
                                                "example_id": "70ea613b-8465-4d0b-84e1-4b6d7c894993",
                                                "sense_id": "0948d9a6-a8ce-3d4b-853c-926a00c50a94",
                                                "text": "„Der Fußboden war dicht besät mit den Abdrücken eines nackten Fußes – er war klar umrissen und gut abgezeichnet, vollendet in seiner Form, aber dieser Fuß war kaum halb so groß wie der eines normalen Mannes.“"
                                            },
                                            {
                                                "example_id": "b24a1b64-6ded-4b30-873e-cd456d8ed09b",
                                                "sense_id": "0948d9a6-a8ce-3d4b-853c-926a00c50a94",
                                                "text": "„Sie waren höchst erstaunt, als sie lasen, daß es auf Steinen Abdrücke von Libellen, von Vogelfüßen gibt; und nachdem sie in einem Band von Rorets Handbuch geblättert hatten, begannen sie, nach Fossilien zu suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bd24b39-6bc2-3065-bebf-efcdd4f5902b",
                                        "entry_id": "711ce717-5089-3135-830d-eb99664f0f1a",
                                        "glosses": [
                                            "Plural 2: das Abdrucken eines Druckkörpers oder einer Druckform (z. B. auf einen zu bedruckenden Stoff)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02df0a19-f22a-4f30-9d1e-b8b5373bcaf6",
                                                "sense_id": "5bd24b39-6bc2-3065-bebf-efcdd4f5902b",
                                                "text": "Die Abdrucke müssen noch sortiert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "93a5bec5-126a-38b1-a97d-529005c7acd1",
                                        "entry_id": "711ce717-5089-3135-830d-eb99664f0f1a",
                                        "glosses": [
                                            "nur Singular: das Abdrucken z. B. eines Bildes in einem Printmedium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b3a79b-5d4e-4015-b863-3dd1ab1a2c1b",
                                                "sense_id": "93a5bec5-126a-38b1-a97d-529005c7acd1",
                                                "text": "Der Abdruck dieses Fotos ist nicht gestattet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
