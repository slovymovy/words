                        "sense_id": "8929f713-e387-3710-b4d2-55e3542813d9",
                        "entry_id": "d8139cfa-0c61-3954-994b-3ada32f61bfc",
                        "glosses": [
                            "vrouw met een donkere huidskleur en vaak zwart kroeshaar wier voorouders afkomstig zijn uit Afrika bezuiden de Sahara"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60c7a5a-6bc1-4f3c-a372-8e329b8a4289",
                                "sense_id": "8929f713-e387-3710-b4d2-55e3542813d9",
                                "text": "„De allermooiste negerin van de hele wereld en haar blonde wonderschone vriendin verdwijnen in de bocht”, staat in Gipharts roman Ik ook van jou uit 1992. Het zinnetje in het best verkochte debuut van dat jaar was indertijd niet aanstootgevend. Vorige week besloot uitgeverij Nijgh & Van Ditmar tot een jubileumeditie. De vraag was alleen: wat te doen met het woord ‘negerin’ dat enkele malen in de roman voorkomt? Giphart: „Ik kwam daarop omdat in het Rijksmuseum de titels en omschrijvingen werden aangepast: ‘zwarte negerin’ werd bijvoorbeeld ‘Surinaams meisje’. Die beslissing riep toen veel discussie op. Met de uitgeverij heb ik er in verband met deze jubileumuitgave veel over gesproken. Negerin is nu een vervelend woord, in de jaren negentig niet. Ik vind het nog steeds ingewikkeld. We hebben het zo gelaten, nu zou ik de verteller niet meer zo laten denken.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea6ab67a-9a83-4fba-b17d-ad09a8e557ef",
                        "source_entry_id": "d8139cfa-0c61-3954-994b-3ada32f61bfc",
                        "source_sense_id": "8929f713-e387-3710-b4d2-55e3542813d9",
                        "source_sense_description": "vrouw met een donkere huidskleur en vaak zwart kroeshaar wier voorouders afkomstig zijn uit Afrika bezuiden de Sahara",
                        "target_lang_word": "Negerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Negerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99e68d54-799b-3717-aa3c-9a8353aa0fe5",
                                        "entry_id": "fd92281c-4c65-370d-b319-1f148a80a8bd",
                                        "glosses": [
                                            "eine dunkelhäutige weibliche Person subsaharischer Abstammung"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ca58361-425a-49eb-a87f-ab15c9cfb301",
                                                "sense_id": "99e68d54-799b-3717-aa3c-9a8353aa0fe5",
                                                "text": "„Die Negerinnen entfernten sich.“"
                                            },
                                            {
                                                "example_id": "f607b2c2-2883-404c-a50a-233def23b6f6",
                                                "sense_id": "99e68d54-799b-3717-aa3c-9a8353aa0fe5",
                                                "text": "„Während der Woche hielt sie den Betrieb allein in Gang und hatte nur eine Negerin für Küche und Hausarbeit.“"
                                            },
                                            {
                                                "example_id": "9e4c2887-a8a6-4450-8976-2c244076839b",
                                                "sense_id": "99e68d54-799b-3717-aa3c-9a8353aa0fe5",
                                                "text": "„Dort wirtschafteten und arbeiteten nämlich zwei wohlbeleibte, von der benachbarten, einem wohlhabenden Mann aus Little Rock gehörenden Mühle geliehene Negerinnen, um für manche, die schon eine weite Strecke Weges gekommen, Frühstück zu bereiten und unterdessen auch wieder die nötigen Vorbereitungen zum Mittagessen zu treffen.“"
                                            },
                                            {
                                                "example_id": "56c183b1-0a45-49d3-82f1-403ffcace4fc",
                                                "sense_id": "99e68d54-799b-3717-aa3c-9a8353aa0fe5",
                                                "text": "„Im Haus der Isabeau wurden Negerinnen und Mestizinnen gehalten.“"
                                            },
                                            {
                                                "example_id": "623b8e76-0e5d-45c6-9f1c-f5569e602522",
                                                "sense_id": "99e68d54-799b-3717-aa3c-9a8353aa0fe5",
                                                "text": "„Er wußte, daß sie als Tochter eines spanischen Kaufmanns und einer Negerin in der amerikanischen Stadt St. Louis geboren worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "193ae6a8-5587-4d8a-901d-a0ff51e72a65",
                        "source_entry_id": "d8139cfa-0c61-3954-994b-3ada32f61bfc",
                        "source_sense_id": "8929f713-e387-3710-b4d2-55e3542813d9",
                        "source_sense_description": "vrouw met een donkere huidskleur en vaak zwart kroeshaar wier voorouders afkomstig zijn uit Afrika bezuiden de Sahara",
                        "target_lang_word": "negress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a48b0b0b-dba9-3240-a728-ebee9670fa15",
                                        "entry_id": "38669ef1-82ea-32fc-83e0-99ea792cb342",
                                        "glosses": [
                                            "A black female."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f95b5b7-0e7a-4196-a98c-0b24e326af6e",
                                                "sense_id": "a48b0b0b-dba9-3240-a728-ebee9670fa15",
                                                "text": "Directly they were trotted off in their little pea-green and gilt carriage, guardian negress and all, I went into the shop, about which I had all this time been loafingly prowling, and called, clapping my hands, for some violet sherbet, […]"
                                            },
                                            {
                                                "example_id": "fd25b39f-02f2-4fd8-a5a9-bcc86f45cb6b",
                                                "sense_id": "a48b0b0b-dba9-3240-a728-ebee9670fa15",
                                                "text": "1995, A. J. Verdelle, The Good Negress (book title)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54b106d6-b80c-4ff9-ba8d-b1f449b6b59f",
                        "source_entry_id": "d8139cfa-0c61-3954-994b-3ada32f61bfc",
                        "source_sense_id": "8929f713-e387-3710-b4d2-55e3542813d9",
                        "source_sense_description": "vrouw met een donkere huidskleur en vaak zwart kroeshaar wier voorouders afkomstig zijn uit Afrika bezuiden de Sahara",
                        "target_lang_word": "négresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "négresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d693c5b-c864-3295-b6c4-ada63707633d",
                                        "entry_id": "97b3610c-9f92-3965-a908-a525edea9c7f",
                                        "glosses": [
                                            "Femme à la peau noire. Note : jusque vers 1920-1930 ce terme n’est pas perçu comme injurieux. référence nécessaire (résoudre le problème)"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d31dd4-d474-47a4-8c9c-36ac3d7934a1",
                                                "sense_id": "8d693c5b-c864-3295-b6c4-ada63707633d",
                                                "text": "Elle se tourna vers moi, et je fus étrangement surpris en apercevant une négresse !"
                                            },
                                            {
                                                "example_id": "feab5a3e-e623-4b01-be14-8a0d1e4246e7",
                                                "sense_id": "8d693c5b-c864-3295-b6c4-ada63707633d",
                                                "text": "Mais elles ont beau être aimables naturellement, et richement vêtues, elles ne font tout au plus que partager les regards des hommes avec les filles indiennes de leur suite qu’elles font marcher aux portières de leurs carrosses : ces négresses sont si jolies et si-mignonnes, que souvent on les préfère à leurs maîtresses."
                                            },
                                            {
                                                "example_id": "4889045b-6a9c-4a99-a7a6-1142fd95d4fa",
                                                "sense_id": "8d693c5b-c864-3295-b6c4-ada63707633d",
                                                "text": "Une négresse de quatorze ou quinze ans, d’une beauté extraordinaire, vint nous ouvrir la barrière d’une maison qui tenait à la fois de la ferme d’un Anglais et de l’habitation d’un colon."
                                            },
                                            {
                                                "example_id": "a69eba78-83ef-43be-be9c-b8dadf8ce700",
                                                "sense_id": "8d693c5b-c864-3295-b6c4-ada63707633d",
                                                "text": "Avez-vous aperçu quelque part la belle négresse ?"
                                            },
                                            {
                                                "example_id": "13657598-82b8-4f31-a107-df2836939eb7",
                                                "sense_id": "8d693c5b-c864-3295-b6c4-ada63707633d",
                                                "text": "Et puis il ne me traitait pas en négresse, mais en vraie femme que je suis, tu comprends?"
                                            },
                                            {
                                                "example_id": "6f9e7da9-3175-4c8a-973d-af637824bd7e",
                                                "sense_id": "8d693c5b-c864-3295-b6c4-ada63707633d",
                                                "text": "Il en est des métisses comme des négresses, des niakouées et des crouilles : sous leurs airs de mijaurées, ce sont quand même de bonnes bourreuses à qui il ne faut pas en promettre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21b92d63-d6b2-3e6f-89b8-db422be63107",
                                        "entry_id": "97b3610c-9f92-3965-a908-a525edea9c7f",
                                        "glosses": [
                                            "Esclave noire."
                                        ],
                                        "tags": [
                                            "Esclavagisme",
                                            "Emploi à manier avec précaution"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4065612b-1487-4d8e-ac44-f82692900321",
                                                "sense_id": "21b92d63-d6b2-3e6f-89b8-db422be63107",
                                                "text": "Il est établi que toute femme peut sortir seule ; la plupart se font suivre par une négresse, mais ce n’est pas d’obligation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2647e1-c32b-3dcd-a4fe-2f6d02a3f098",
                                        "entry_id": "97b3610c-9f92-3965-a908-a525edea9c7f",
                                        "glosses": [
                                            "Ustensile de cuisine désignant un bac à friture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae9a1065-fa51-4994-974b-0b3e39efd2ee",
                                                "sense_id": "ca2647e1-c32b-3dcd-a4fe-2f6d02a3f098",
                                                "text": "À ses narines surgissent ici et là, à quoi qu’il soit occupé, des croches de parfums surannés, l’odeur des pelures de reinettes ou des zestes de peaux d’orange que sa grand-mère laissait brûler sur le dessus de la cuisinière pour chasser les miasmes microbiens et les esprits malins ou pour embaumer la pièce, et celle, puissante, corsée, qui excite et dilate à y penser son organe olfactif, du café, acheté vert en Belgique, le jour qu’elle le torréfiait, sur sa négresse d’où elle avait ôté trois des cercles du foyer, dans un brûloir cylindrique, pourvu de quatre pieds en fourche comme un tournebroche, dont elle tournait patiemment la manivelle, dans un sens et puis dans l’autre, autant de temps qu’il fallait, alimentant son feu de pallées de boulets, avant de pouvoir épardre les grains fumants, noirs et huileux, sur la feuille de papier fort, marron, étalé sur le sol, qu’elle repliait, une fois le café refroidi transvidé dans sa boîte en fer blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "107a934c-974c-3ef1-979f-e72a4628eda3",
                                        "entry_id": "97b3610c-9f92-3965-a908-a525edea9c7f",
                                        "glosses": [
                                            "Puce."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9910641-ea78-35ef-a43c-f78177b55497",
                                        "entry_id": "97b3610c-9f92-3965-a908-a525edea9c7f",
                                        "glosses": [
                                            "Bouteille de vin."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40f35b3-ec8b-4b03-9e64-5c795d4efbe6",
                                                "sense_id": "a9910641-ea78-35ef-a43c-f78177b55497",
                                                "text": "Dans un coin de la boutique, le tas des négresses mortes grandissait, un cimetière de bouteilles sur lequel on poussait les ordures de la nappe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf2eaab-6dbf-304c-babd-55beaceda704",
                                        "entry_id": "97b3610c-9f92-3965-a908-a525edea9c7f",
                                        "glosses": [
                                            "Caisse entourée de toile noire."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d0daf3-7b9d-446e-b4e8-106e7b230071",
                                                "sense_id": "0bf2eaab-6dbf-304c-babd-55beaceda704",
                                                "text": "Eh ! eh ! eh !… c’est seulement pas si lourd que la négresse de la femme noyée du canal Saint-Martin… n’est-ce pas, mon homme ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "négresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "096c0d66-4451-3ddb-9e09-4aee7426ddbb",
                                        "entry_id": "0ad814a8-b4eb-349f-8c3a-beac9911fef6",
                                        "glosses": [
                                            "Féminin singulier de nègre."
                                        ],
                                        "tags": [
