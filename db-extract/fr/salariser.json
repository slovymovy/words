                        "glosses": [
                            "Donner un statut salarié à (une personne, une situation, un revenu... qui n’avait pas ce statut)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650dc93d-ced8-4bfa-ad63-28a82274d87c",
                                "sense_id": "fd48ef6b-9a44-32ec-9874-04e0498ef7e3",
                                "text": "C'est bien pourquoi le capitalisme n'a pas intérêt à libérer la femme du travail domestique, tant qu'il n'a pas besoin de salariser sa force de travail ;"
                            },
