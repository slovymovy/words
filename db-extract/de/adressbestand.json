                "senses": [
                    {
                        "sense_id": "d6971a22-b90f-387c-a466-a5c32a372d67",
                        "entry_id": "446e6786-0b82-3760-96d3-8686bd6eda80",
                        "glosses": [
                            "Sammlung von Adressen in analoger oder elektronischer Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd26747-e177-447d-93c9-62a31b171128",
                                "sense_id": "d6971a22-b90f-387c-a466-a5c32a372d67",
                                "text": "Listbroker können zur Kontrolle der Nutzungshäufigkeit von verkauften Adressbeständen bestimmte Adressen einfügen, die nicht der eingekauften Zielgruppe entsprechen und deren Eingangspost kontrolliert wird."
                            },
                            {
                                "example_id": "0db8c496-86e8-4cd0-8115-e8a26817959d",
                                "sense_id": "d6971a22-b90f-387c-a466-a5c32a372d67",
                                "text": "Ein Listbroker verfügt über Marktkenntnisse und vielfältige Kontakte zu Unternehmen, die bereit sind, ihren Adressbestand für Werbezwecke zur Verfügung zu stellen."
                            },
                            {
                                "example_id": "3301a2ea-d7aa-44cb-b170-b3e0179fa099",
                                "sense_id": "d6971a22-b90f-387c-a466-a5c32a372d67",
                                "text": "Der Adressbestand wächst stetig, die Ärzte können sich selbst eintragen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
