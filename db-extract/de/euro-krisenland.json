                ],
                "senses": [
                    {
                        "sense_id": "3877d9a7-6394-3ed5-81cc-55bfb654ef98",
                        "entry_id": "5d0848ed-06ad-3f59-b6e4-75da2712f719",
                        "glosses": [
                            "Staat, der in der sogenannten Eurokrise steckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd15236-fce8-4265-8700-0c91d3659e0d",
                                "sense_id": "3877d9a7-6394-3ed5-81cc-55bfb654ef98",
                                "text": "„Außenminister Frank-Walter Steinmeier hat dem Euro-Krisenland Griechenland weitere deutsche Unterstützung zugesagt.“"
                            },
                            {
                                "example_id": "07e863c1-68af-41be-aac2-cce0fc0ca45b",
                                "sense_id": "3877d9a7-6394-3ed5-81cc-55bfb654ef98",
                                "text": "„Bundesfinanzminister Wolfgang Schäuble (CDU) hat in der Debatte über weitere Griechenland-Hilfen die Rettungsprogramme für andere Euro-Krisenländer ausdrücklich als Erfolg gewertet.“"
                            },
                            {
                                "example_id": "b1e3c2ef-4a6c-421f-a5e4-008f944cca6e",
                                "sense_id": "3877d9a7-6394-3ed5-81cc-55bfb654ef98",
                                "text": "„Athen profitiert in großem Maße davon, dass die Europäische Zentralbank (EZB) Anleihen des Euro-Krisenlandes aufgekauft hat.“"
                            },
                            {
                                "example_id": "b78e811f-c8ea-46e1-bdea-83b77ddadc03",
                                "sense_id": "3877d9a7-6394-3ed5-81cc-55bfb654ef98",
                                "text": "„Die Lohnstückkosten in den Euro-Krisenländern sind laut DIHK-Studie spürbar gesunken, die Ungleichgewichte in den Handelsbilanzen passen sich an.“"
                            },
                            {
                                "example_id": "78b28017-3cb6-4112-b733-174406775079",
                                "sense_id": "3877d9a7-6394-3ed5-81cc-55bfb654ef98",
                                "text": "„Das anhaltende Zögern des Euro-Krisenlands Spanien vor einem Hilferuf in Richtung der Rettungsfonds sorge für wieder steigende Unsicherheit, kommentierte Marktstratege Ishaq Siddiqi von ETX Capital.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
