                        "entry_id": "7f73b5ba-6c9a-392f-870f-31cc1ee55d9f",
                        "glosses": [
                            "ugotować dużo jedzenia, przyrządzić większą ilość potraw"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae43cc0-911c-408a-ae6f-614db8657c58",
                                "sense_id": "5509dd77-c87e-3561-bf39-82cb40b3b2f2",
                                "text": "Mamo, nagotowałaś tej zupy jak dla pułku wojska."
                            },
                            {
                                "example_id": "a969bb1d-e003-49d0-97ad-df75af9307dd",
                                "sense_id": "5509dd77-c87e-3561-bf39-82cb40b3b2f2",
                                "text": "Marta nagotowała gołąbków, bigosów, flaczków, a goście jedzą tylko sałatkę warzywną."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
