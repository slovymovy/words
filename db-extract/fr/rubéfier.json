                        "glosses": [
                            "Rendre rouge, enflammé, par l’application des rubéfiants."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "46161e63-2b95-3ab9-acd2-aefc2d700277",
                        "entry_id": "5b22ab3c-2e01-3c12-be46-0f6ac682c8cf",
                        "glosses": [
                            "Colorer en rouge du sol ou des roches par l'action des oxydes de fer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49943281-6bd7-48b3-88af-ef3c7ea738ac",
                                "sense_id": "46161e63-2b95-3ab9-acd2-aefc2d700277",
                                "text": "A l'Ouest de la Trappe existent des sols rubéfiés, extrêmement aréneux (avec plus de 90 % de sable), sur grès dunaire. Ils sont probablement d'origine résiduelle et partiellement d'origine d'origine éolienne et colluviale."
                            },
                            {
                                "example_id": "c9c66753-495f-45fc-b7d6-ee0b121ccd5b",
                                "sense_id": "46161e63-2b95-3ab9-acd2-aefc2d700277",
                                "text": "Irriter la peau, la rendre rouge."
                            }
                        ]
                    }
