                    },
                    {
                        "translation_id": "6d079464-e031-41f4-b083-ae7274e12358",
                        "source_entry_id": "38937784-cf40-33c5-b691-bad8bd8c1cde",
                        "source_sense_description": "act of killing unlawfully",
                        "target_lang_word": "Totschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
                                        "entry_id": "714bde67-b075-3fbc-8413-8a11cdd9c52d",
                                        "glosses": [
                                            "vorsätzliche Tötung einer Person, bei der die Kriterien für einen Mord nicht vorliegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b739bf-4cba-478a-be6d-f2d10abb4da7",
                                                "sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
                                                "text": "Wer einen Menschen tötet, ohne Mörder zu sein, begeht einen Totschlag und wird mit Freiheitsstrafe nicht unter fünf Jahren bestraft."
                                            },
                                            {
                                                "example_id": "84e9d3a2-8aa2-45ad-a36d-69ef072829ca",
                                                "sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
                                                "text": "„Um halb vier wurde Henriette Bernhard des Totschlags an Schwester Angelika schuldig gesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15c62f74-3e97-3976-8cb8-bae52acc0405",
                                        "entry_id": "714bde67-b075-3fbc-8413-8a11cdd9c52d",
                                        "glosses": [
                                            "Tötung eines Menschen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d77f1c09-a705-428e-9994-0b4112528fae",
                                                "sense_id": "15c62f74-3e97-3976-8cb8-bae52acc0405",
                                                "text": "Die ersten 25 Jahre seines Lebens hatte Simplicissimus nur Plünderungen und Totschlag erlebt."
                                            },
                                            {
                                                "example_id": "7abab2fd-cde0-416f-bca7-4d5a41baa7e8",
                                                "sense_id": "15c62f74-3e97-3976-8cb8-bae52acc0405",
                                                "text": "„Es kommt mir vor, als ob er in seinem Gebirgstale die letzten tausend Jahre verschlafen hätte, denn daß er sich damals in der Bahn vor uns eines Totschlags rühmte, den er vielleicht auch in der Tat begangen hatte, war ein altertümlicher Zug, der an die Zeiten erinnerte, wo man dergleichen mit einem Wergeld oder durch den Waldgang ehrenhaft ordnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0e0a9a7-8415-4b78-986d-2bb328d7a9ac",
                        "source_entry_id": "38937784-cf40-33c5-b691-bad8bd8c1cde",
                        "source_sense_description": "act of killing unlawfully",
                        "target_lang_word": "[Verbrechen] mit Todesfolge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ceea96c3-5592-4b2f-93a9-bcf109c61c3b",
                        "source_entry_id": "38937784-cf40-33c5-b691-bad8bd8c1cde",
                        "source_sense_description": "act of killing unlawfully",
                        "target_lang_word": "fahrlässige Tötung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fahrlässige Tötung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c4ca40a-3aa7-31a3-97c9-a0e79e4f1e64",
                                        "entry_id": "143cd20c-65ef-37a3-8b0c-10d0086c6a05",
                                        "glosses": [
                                            "ungewollte, vermeidbare Tötung eines Menschen"
                                        ],
                                        "tags": [
                                            "Straftat"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43fca06-4235-4a34-a8d0-d15eeb691358",
                                                "sense_id": "5c4ca40a-3aa7-31a3-97c9-a0e79e4f1e64",
                                                "text": "„Letztlich ist es nichts anderes als fahrlässige Tötung mit einem Fahrzeug, was dem Mann höchstens zwei, drei Jahre auf Staatskosten einbringen wird.“"
                                            },
                                            {
                                                "example_id": "d9339c38-3cad-4303-aaaa-b7c1b2864469",
                                                "sense_id": "5c4ca40a-3aa7-31a3-97c9-a0e79e4f1e64",
                                                "text": "„Lesnick, dem man noch höchstens sechs Monate Kampf gegen den Lungenkrebs gab, hatte von einem hochrangigen Beamten im Justizministerium ein Versprechen erwirkt: Nach seinem Tod sollten alle vertraulichen Akten, die er zur Verfügung gestellt hatte, vernichtet werden; die Verurteilung seiner Tochter wegen fahrlässiger Tötung im Straßenverkehr würde aufgehoben, das Bewährungsregister gelöscht werden, und alle bei Bundes-, Stadt- und Staatsgerichten vorliegenden Aufzeichnungen über Lesnick sollten ebenso in Flammen aufgehen wie die Unterlagen über seine Vertrauensbrüche gegenüber subversiven Patienten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
