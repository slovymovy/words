                            },
                            {
                                "target_lang_word": "student",
                                "target_lang_sense_clarification": "a person formally enrolled at an educational institution"
                            },
                            {
                                "target_lang_word": "schoolchild",
                                "target_lang_sense_clarification": "a child attending school"
                            }
                        ],
                        "ru": [
                            {
