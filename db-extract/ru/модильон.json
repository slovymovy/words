                    },
                    {
                        "translation_id": "295e63b9-05b7-4723-aa23-93d921ced9bd",
                        "source_entry_id": "cbeb641a-5b8a-3000-9cb6-ef4826cb5691",
                        "source_sense_id": "c01be729-9a33-3c8c-ad2b-863483ba32ca",
                        "target_lang_word": "modillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                                        "entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                                        "glosses": [
                                            "Chacune des consoles décoratives disposées régulièrement sous une corniche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db4c555-58c8-417f-bed9-6a7a07915923",
                                                "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                                                "text": "En traversant le bourg de Garchy, on s’arrête pour jeter un coup-d’œil sur l’abside à pans coupés de son église, et pour considérer l’entablement garni de têtes de clous et soutenu par des modillons ornés de feuilles de fantaisie et de figures bizarres d’animaux."
                                            },
                                            {
                                                "example_id": "7260d31b-1ab4-4edc-b7f0-14e8af90bffe",
                                                "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                                                "text": "Les deux tours … se couronnent d’un diadème de mâchicoulis exhaussé sur un parapet dont les modillons rappellent le style rapporté des croisades."
                                            },
                                            {
                                                "example_id": "40f80d6a-688a-4b7d-9509-15863c948db2",
                                                "sense_id": "d6cc702c-235a-3905-bfc6-a6d5ebff97d1",
                                                "text": "L’auteur des étranges modillons d’Ardentes est venu à Sassierges-Saint-Germain, petite localité voisine, pour réaliser le décor de la porte occidentale de l’église. Celle-ci est un reflet parfait, quoique plus simple, du portail nord de Saint-Martin : même archivolte sculptée de demi-cercles opposés deux à deux, même alignement de rosaces sur les claveaux de la voussure médiane à l'arête torique, même mouluration complexe des tailloirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e43e4ef3-abb3-33c2-9851-160c3f1a312b",
                                        "entry_id": "255cb9d1-a534-38e5-9a6f-a5ff3faf133a",
                                        "glosses": [
                                            "Ornement propre aux ordres ionique, corinthien et composite, placé sous le larmier de la corniche et figurant l’extrémité des chevrons du comble."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
