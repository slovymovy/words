                        "entry_id": "4fe49363-0789-3ba5-8da0-967e2ab7b75f",
                        "glosses": [
                            "Wein, der aus Reben der Sorte Rivaner (Müller-Thurgau) hergestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfa382a-82fc-462f-8fe6-7fcb717cca7e",
                                "sense_id": "afb2bdbe-2d82-3a63-bcf0-70f39f29e1bd",
                                "text": "\"Trocken und halbtrocken ausgebaut wird der Müller-Thurgau heute sehr häufig auch in Deutschland als Rivaner bezeichnet, nach den ursprünglich vermuteten Elternreben Riesling und Silvaner.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
