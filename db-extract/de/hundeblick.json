                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d47db0-4151-4158-839c-a2208839cb81",
                                "sense_id": "ed253894-5914-34b6-906d-b38ed942dfe3",
                                "text": "„Wobei der letzte Satz seinen kurz traurigen Hundeblick in ein böses Grinsen verwandelt.“"
                            },
                            {
                                "example_id": "e8846ff8-9579-4450-8066-b6ed4e8c8e93",
                                "sense_id": "ed253894-5914-34b6-906d-b38ed942dfe3",
                                "text": "„Dengelmann blieb stehen, unwillig schaute ich ihm ins Gesicht, und er bedachte mich mit einem Hundeblick, den ich noch nie zuvor an ihm gesehen hatte.“"
                            }
                        ],
