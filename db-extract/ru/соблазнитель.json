                                        ],
                                        "note": "Dans ce sens l'on emploie l'article défini",
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e20684c5-e760-4484-a6dc-1e40101aa5cf",
                        "source_entry_id": "6e77c96f-7d37-3af9-b526-83c0cbc13317",
