                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6450964c-9770-41de-8e53-684212783ea2",
                                "sense_id": "ad340e44-babd-3a75-bcad-61742ea54b0a",
                                "text": "\"Ough! ough! ough!\" groaned the old woman; \"he wants to go, away from the nest where he was warmed, and nursed, and brought up."
                            },
                            {
                                "example_id": "c942d1d0-5b9d-4bd1-b65d-cd218bd055f6",
                                "sense_id": "ad340e44-babd-3a75-bcad-61742ea54b0a",
                                "text": "We strove to extort from him the cause of this ebullition of passion, but he only shook his head in reply to our questions, and uttered a guttural \"ough.\""
                            },
                            {
                                "example_id": "359f6d7b-f1d4-4b29-a280-ebf2f7abdf38",
                                "sense_id": "ad340e44-babd-3a75-bcad-61742ea54b0a",
                                "text": "Ough! A door opened, a white-haired secretarial head, but wearing a compassionate expression, appeared, and a skinny forefinger beckoned me into the sanctuary."
                            }
                        ]
                    }
