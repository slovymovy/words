                            },
                            {
                                "target_lang_word": "中止",
                                "target_lang_sense_clarification": "中途停下或停止进行"
                            },
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "中途停止学业或工作等"
                            }
                        ]
