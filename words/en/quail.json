{
    "word_family": [
        "quail-pipe"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90dc2840-e4b1-3fb7-b37b-96e6fa056462",
                    "sense_definition": "To lose heart or courage; to shrink back in fear or cower.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even the bravest soldiers would <w>quail</w> before the sheer size of the enemy army.",
                            "target_lang_translations": {
                                "pl": "Nawet najodważniejsi żołnierze <w>ulękliby się</w> przed samą wielkością armii wroga."
                            }
                        },
                        {
                            "text": "She refused to <w>quail</w> under his intimidating gaze and stood her ground.",
                            "target_lang_translations": {
                                "pl": "Odmówiła <w>ugięcia się</w> pod jego zastraszającym spojrzeniem i nie ustąpiła."
                            }
                        }
                    ],
                    "synonyms": [
                        "cower",
                        "flinch",
                        "recoil",
                        "shrink"
                    ],
                    "antonyms": [
                        "confront",
                        "face"
                    ],
                    "common_phrases": [
                        "quail before",
                        "quail with fear"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stracić odwagę lub ducha; cofnąć się ze strachu lub skulić się."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przestraszyć się",
                                "target_lang_sense_clarification": "poczuć nagły strach"
                            },
                            {
                                "target_lang_word": "skulić się ze strachu",
                                "target_lang_sense_clarification": "ze strachu"
                            },
                            {
                                "target_lang_word": "tchórzyć",
                                "target_lang_sense_clarification": "tracić odwagę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "100fb5ea-6e0d-3d73-b5d6-acaa82bae208",
                    "sense_definition": "To daunt, frighten, or subdue someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden thunderclap seemed to <w>quail</w> the young children in the room.",
                            "target_lang_translations": {
                                "pl": "Nagły trzask pioruna zdawał się <w>przerażać</w> małe dzieci w pokoju."
                            }
                        },
                        {
                            "text": "Nothing could <w>quail</w> his determined spirit, not even the threat of failure.",
                            "target_lang_translations": {
                                "pl": "Nic nie mogło <w>złamać</w> jego zdeterminowanego ducha, nawet groźba porażki."
                            }
                        }
                    ],
                    "synonyms": [
                        "daunt",
                        "frighten",
                        "intimidate",
                        "cow"
                    ],
                    "antonyms": [
                        "encourage",
                        "hearten"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used transitively in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zastraszyć, przerazić lub podporządkować sobie kogoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zastraszyć",
                                "target_lang_sense_clarification": "odebrać komuś śmiałość"
                            },
                            {
                                "target_lang_word": "sterroryzować",
                                "target_lang_sense_clarification": "wzbudzić lęk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58d4ee10-e785-36f5-bc35-813ba79e43dd",
                    "sense_definition": "Of courage, faith, or resolve: to slacken, weaken, or give way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the hours dragged on without rescue, their hope began to <w>quail</w>.",
                            "target_lang_translations": {
                                "pl": "W miarę jak godziny mijały bez ratunku, ich nadzieja zaczęła <w>słabnąć</w>."
                            }
                        },
                        {
                            "text": "His resolve did not <w>quail</w> despite the immense pressure from his peers.",
                            "target_lang_translations": {
                                "pl": "Jego determinacja nie <w>zachwiała się</w> pomimo ogromnej presji ze strony rówieśników."
                            }
                        }
                    ],
                    "synonyms": [
                        "falter",
                        "weaken",
                        "fade",
                        "flag"
                    ],
                    "antonyms": [
                        "strengthen",
                        "endure"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly literary or historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "O odwadze, wierze lub determinacji: osłabnąć, zachwiać się lub ustąpić."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zachwiać się",
                                "target_lang_sense_clarification": "o determinacji lub nadziei"
                            },
                            {
                                "target_lang_word": "osłabnąć",
                                "target_lang_sense_clarification": "o sile ducha lub wierze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6a40d41-e7ac-3b49-8d07-154b0fff7a50",
                    "sense_definition": "To waste away, fade, or wither.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beautiful blossoms began to <w>quail</w> under the harsh summer sun.",
                            "target_lang_translations": {
                                "pl": "Piękne kwiaty zaczęły <w>więdnąć</w> pod palącym letnim słońcem."
                            }
                        },
                        {
                            "text": "Without proper care, the young plants will quickly <w>quail</w> and die.",
                            "target_lang_translations": {
                                "pl": "Bez odpowiedniej pielęgnacji młode rośliny szybko <w>zmarnieją</w> i obumrą."
                            }
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "fade",
                        "decay"
                    ],
                    "antonyms": [
                        "flourish",
                        "thrive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically to describe physical fading or withering"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Marnieć, więdnąć lub niszczeć."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "więdnąć",
                                "target_lang_sense_clarification": "o roślinach"
                            },
                            {
                                "target_lang_word": "marnieć",
                                "target_lang_sense_clarification": "tracić siły życiowe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bb31dae-f938-3c43-86b6-887a73949f20",
                    "sense_definition": "To curdle or coagulate, as milk does.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "curdle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding acid to the warm milk will cause it to <w>quail</w> immediately.",
                            "target_lang_translations": {
                                "pl": "Dodanie kwasu do ciepłego mleka sprawi, że natychmiast się <w>zwarzy</w>."
                            }
                        },
                        {
                            "text": "The chef watched the sauce carefully to ensure the dairy did not <w>quail</w>.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni uważnie obserwował sos, aby upewnić się, że nabiał się nie <w>zwarzył</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "curdle",
                        "coagulate",
                        "clot"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily regional or archaic culinary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Warzyć się, ścinać się lub koagulować (np. o mleku)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "warzyć się",
                                "target_lang_sense_clarification": "o mleku lub sosie"
                            },
                            {
                                "target_lang_word": "ścinać się",
                                "target_lang_sense_clarification": "o białku lub nabiale"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be29b9d8-bfe1-36d7-836a-5b2abc30c7d6",
                    "sense_definition": "Any of various small, short-tailed game birds of the Old World family Phasianidae or the New World family Odontophoridae.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the distinctive call of a wild <w>quail</w> hiding in the tall grass.",
                            "target_lang_translations": {
                                "pl": "Usłyszeliśmy charakterystyczny głos dzikiej <w>przepiórki</w> ukrywającej się w wysokiej trawie."
                            }
                        },
                        {
                            "text": "The hunter spotted a covey of <w>quail</w> flushing from the brush.",
                            "target_lang_translations": {
                                "pl": "Myśliwy dostrzegł stadko <w>przepiórek</w> zrywających się z zarośli."
                            }
                        }
                    ],
                    "common_phrases": [
                        "covey of quail",
                        "wild quail"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dowolny z małych ptaków łownych o krótkim ogonie z rodziny kurowatych lub zębatolic."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przepiórka",
                                "target_lang_sense_clarification": "ptak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b4ce51a-a0ef-3c5d-b50d-94201ba8cc7d",
                    "sense_definition": "The meat of the quail bird eaten as food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant served roasted <w>quail</w> with a rich cherry reduction sauce.",
                            "target_lang_translations": {
                                "pl": "Restauracja serwowała pieczoną <w>przepiórkę</w> z bogatym wiśniowym sosem redukcyjnym."
                            }
                        },
                        {
                            "text": "He ordered the grilled <w>quail</w> as an appetizer for the special dinner.",
                            "target_lang_translations": {
                                "pl": "Zamówił grillowaną <w>przepiórkę</w> jako przystawkę na tę wyjątkową kolację."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roasted quail",
                        "quail eggs"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mięso przepiórki spożywane jako pokarm."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przepiórka",
                                "target_lang_sense_clarification": "danie mięsne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8004c536-f7b6-3b10-8a1f-12c6d48f477f",
                    "sense_definition": "A prostitute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old Elizabethan play made a crude joke about a man who loved his <w>quails</w>.",
                            "target_lang_translations": {
                                "pl": "Stara elżbietańska sztuka zawierała prostacki żart o człowieku, który kochał swoje <w>nierządnice</w>."
                            }
                        },
                        {
                            "text": "In historical slang, a <w>quail</w> was a term used to describe a woman of the night.",
                            "target_lang_translations": {
                                "pl": "W dawnym slangu słowo to było określeniem używanym do opisania <w>kurtyzany</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "prostitute",
                        "harlot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "historical Elizabethan slang"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Prostytutka (historyczny slang)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nierządnica",
                                "target_lang_sense_clarification": "archaicznym językiem"
                            },
                            {
                                "target_lang_word": "kurtyzana",
                                "target_lang_sense_clarification": "dawne określenie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "92a6d1e4-0706-3045-981d-fee7156f88a2",
                    "sense_definition": "A surname from Scottish Gaelic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Quail</w> and his family to join us for the weekend dinner.",
                            "target_lang_translations": {
                                "pl": "Zaprosiliśmy pana <w>Quaila</w> i jego rodzinę na weekendowy obiad."
                            }
                        },
                        {
                            "text": "The local library has a section dedicated to the historical records of the <w>Quail</w> family.",
                            "target_lang_translations": {
                                "pl": "Lokalna biblioteka ma sekcję poświęconą historycznym dokumentom rodziny <w>Quail</w>."
                            }
                        }
                    ],
                    "traits": [
