                "senses": [
                    {
                        "sense_id": "a61807af-56cb-36ce-9d7f-342e28e4522b",
                        "entry_id": "037c5b6b-2f16-3089-9593-1c6258daa882",
                        "glosses": [
                            "Gesamtheit der Knochen (und Muskeln) des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db7585d-cf31-48e4-9149-bd563904811a",
                                "sense_id": "a61807af-56cb-36ce-9d7f-342e28e4522b",
                                "text": "„Der Bewegungs- und Stützapparat hält uns aufrecht und stabil und ist für unsere Mobilität zuständig.“"
                            },
                            {
                                "example_id": "bde638c3-250e-4cad-985d-43753fe1c184",
                                "sense_id": "a61807af-56cb-36ce-9d7f-342e28e4522b",
                                "text": "„Ich kannte meine Mutter nur an Krücken gehend oder mit einem Stützapparat oder im Bett liegend oder sitzend im Rollstuhl.“"
                            },
                            {
                                "example_id": "52e9dbeb-862e-4474-a98b-81a495a15b6f",
                                "sense_id": "a61807af-56cb-36ce-9d7f-342e28e4522b",
                                "text": "„Der Bewegungs- und Stützapparat beinhaltet Knochen, Gelenke, Muskeln und Sehnen.“"
                            }
                        ],
