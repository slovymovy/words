                        ],
                        "examples": [
                            {
                                "example_id": "b09afd6a-8ebc-4bee-8d39-bf67a2911666",
                                "sense_id": "03937b87-5a0d-3b59-bea7-75b58b9e3d56",
                                "text": "Not intensely bloody decapitation, but the sort of violence you'd see in a fifteener."
                            }
                        ]
                    },
                    {
                        "sense_id": "d383a1e2-8284-3acc-bf0a-b478de09c071",
                        "entry_id": "95ce48f8-1ff5-3424-884f-e806ea81a905",
                        "glosses": [
                            "A book or other printed item that was printed in the 15th century (thus, during the first half-century of printing)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ef8d4f59-50f3-46cc-9397-5e428cf380c1",
                                "sense_id": "d383a1e2-8284-3acc-bf0a-b478de09c071",
                                "text": "When here and there throughout those volumes you meet with titles of books now either unknown entirely or of the greatest rarity; when you find the Colophon from the end or the \"insignum typographi\" from the first leaf of a rare \"fifteener\" pasted down with dozens of others varying in value, you cannot bless the memory of the antiquarian shoemaker, John Bagford."
                            }
                        ]
                    }
