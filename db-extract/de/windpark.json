                                        "entry_id": "a3ebc4c9-f731-3095-9cbf-be56e178ccb0",
                                        "glosses": [
                                            "een groep bij elkaar geplaatste windturbines"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09615e2f-4892-441d-8d71-19dc76c0252e",
                                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                                "text": "Recordjaar 2014 zal niet snel worden overtroffen, maar dat is te verklaren door grote eenmalige investeringen die toen werden gedaan. Zo investeerde het Canadese Northland Power ruim 1,6 miljard euro in een windpark op zee, en pompte Google 600 miljoen euro in een datacentrum in de Groningse Eemshaven."
                                            },
                                            {
                                                "example_id": "bc247df5-8fa6-45ec-9c54-9b30fb28ebcc",
                                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                                "text": "\"Ons plan voor een windpark op het Lochter ging in 2016 niet door, maar de gemeente moet toch de duurzaamheidsdoelstelling halen\", zegt Brughuis."
                                            },
                                            {
                                                "example_id": "bbd1f95a-19c2-49b5-b578-b33614393f56",
                                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                                "text": "Niets staat de komst van een tweede offshore windpark voor de Zeeuwse kust nog in de weg. De benodigde 1,3 miljard euro voor de bouw is rond. Dat melden de gezamenlijke exploitanten, waaronder Shell en Eneco."
                                            },
                                            {
                                                "example_id": "6f4ba562-29d2-4385-ada9-587f2bcb3e89",
                                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                                "text": "Het belang van de natuur moet zwaar wegen bij de aanleg van nieuwe windparken op zee. Dat zegt minister Jetten van Klimaat en Energie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8b5e612-3284-414d-a606-6776bcb41d9b",
                        "source_entry_id": "cf7db544-7e92-34fb-9368-6c729e29b073",
                        "source_sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                        "source_sense_description": "Bereich mit mehreren Windkraftanlagen",
                        "target_lang_word": "windmolenpark",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windmolenpark",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                                        "entry_id": "72dd24db-5930-337d-b7b3-fab53d6f17e3",
                                        "glosses": [
                                            "een gebied waar windenergie gewonnen wordt met behulp van een aantal molens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103bf00e-d315-4687-ae3f-838a92afb2c0",
                                                "sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                                                "text": "Er zijn plannen voor een groot windmolenpark op de Doggersbank."
                                            },
                                            {
                                                "example_id": "611ccb69-497e-4988-a4c7-6ccb27c7d918",
                                                "sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                                                "text": "Nederland en België hebben na enkele jaren overleg een akkoord bereikt over de scheepvaartroutes op de Noordzee. Commerciële schepen zullen voortaan om de windmolenparken van beide landen heen moeten varen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
