                "senses": [
                    {
                        "sense_id": "b599fdfd-0f38-309d-898b-722e87198ef7",
                        "entry_id": "45c05abf-cd35-326a-950a-c286da5cc8eb",
                        "glosses": [
                            "Schlafstörung, bei der der Betroffene besondere Schwierigkeiten beim Einschlafen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1ce31e-1847-4d02-afeb-734c1da0482b",
                                "sense_id": "b599fdfd-0f38-309d-898b-722e87198ef7",
                                "text": "„Eine Einschlafstörung liegt in der Regel vor, wenn Sie als Erwachsener mehr als eine halbe Stunde brauchen, bis Sie einschlafen.“"
                            },
                            {
                                "example_id": "e3430537-d2cd-4741-a14c-a4c64de5e2d3",
                                "sense_id": "b599fdfd-0f38-309d-898b-722e87198ef7",
                                "text": "„Was eine Einschlafstörung genau ist, welche Ursachen Einschlafstörungen haben und was Betroffene dagegen tun können, erfahren Interessierte in diesem Artikel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
