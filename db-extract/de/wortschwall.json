                ],
                "senses": [
                    {
                        "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                        "entry_id": "f45a2ab9-ebd6-3303-94de-ec7817b8a7c3",
                        "glosses": [
                            "ununterbrochener, wortreicher Redefluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441cbeef-912c-4dfc-98ca-e664e954c86f",
                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                "text": "„Er sprach viel und schnell, und dieser Wortschwall stand in auffälligem Gegensatz zu der Aura der Tüchtigkeit, die sein Reich charakterisierte.“"
                            },
                            {
                                "example_id": "b3e41175-b79a-410c-af5d-442c4da642eb",
                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                "text": "„Schon in den ersten Minuten wurde mir klar, dass es eine ganze Weile dauern würde, bis ich aus diesem Wortschwall etwas Verständliches herausfiltern könnte.“"
                            },
                            {
                                "example_id": "7cc3a979-7743-44bc-a403-5d87ea4803ad",
                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                "text": "„Ich höre ihren Diskussionen zu, ich denke an Lauenstein, an den Wortschwall, an die Tatenlosigkeit, an die Feigheit.“"
                            },
                            {
                                "example_id": "126e0501-67be-4b5a-9ef6-785710620a7f",
                                "sense_id": "3bddeeb6-3ea0-3423-a130-1537a5d87d78",
                                "text": "„Eine häßliche, aber aufgeweckte Frau hatte bei mir vorgesprochen und mich mit einem echt italienischen Wortschwall gebeten, ich möge mich beim Magistrat dafür einsetzen, daß man der Truppe, der sie angehöre, die Spielerlaubnis erteile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
