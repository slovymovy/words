                            {
                                "example_id": "9b9a9603-e4f6-4a7a-b282-ae8859bc4836",
                                "sense_id": "75bbcf7f-5b05-3a22-acf2-81318c4ff187",
                                "text": "Saba is net als Bonaire en Sint Eustatius een bijzondere gemeente van Nederland sinds 10 oktober 2010. Sinds kort is ook de Nederlandse huwelijkswetgeving van kracht op die drie eilanden. Op Aruba, Curaçao en Sint Maarten is het niet mogelijk voor mensen van hetzelfde geslacht om te trouwen. Wel kan een dergelijk huwelijk worden bijgeschreven in de burgerlijke stand."
                            },
                            {
                                "example_id": "8b99ef3d-52f6-4a6c-99a2-3b9854e7d953",
                                "sense_id": "75bbcf7f-5b05-3a22-acf2-81318c4ff187",
                                "text": "Maandag komen in Borne tientallen ambtenaren uit het grensgebied bijeen om te praten over allerlei problemen die verschillende huwelijkswetgeving levert."
                            }
                        ]
