                "senses": [
                    {
                        "sense_id": "532c9e0d-2903-38e1-89be-15b2707e8567",
                        "entry_id": "86cd05d0-ab30-36de-9455-2c01663eeaed",
                        "glosses": [
                            "Relatif à Gibran Khalil Gibran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bf663b-f7c0-404f-ad97-65f90314c6bc",
                                "sense_id": "532c9e0d-2903-38e1-89be-15b2707e8567",
                                "text": "L'expression imagée n'est pas gratuite. Elle n'est pas non plus une expression-miniature, dans le sens byzantin ou une expression décorative dans le sens arabo-andalou, mais l' essence même du langage gibranien est dans sa capacité à exprimer, en pleine liberté et avec une pénétration éclatante, le mouvement de l'âme."
                            },
                            {
                                "example_id": "70f8dfb5-c898-4ff7-8ba1-2903a4127bd3",
                                "sense_id": "532c9e0d-2903-38e1-89be-15b2707e8567",
                                "text": "Ensuite, il est question de réinscrire la production littéraire gibranienne dans la vaste histoire littéraire de sa communauté."
                            }
                        ]
                    }
                ],
