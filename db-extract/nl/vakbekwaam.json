                                        "sense_id": "8ad6ebb2-3013-3ae7-a1a2-3204a31d0132",
                                        "entry_id": "2483051d-b6b0-393d-86a0-2c1bddccac78",
                                        "glosses": [
                                            "present participle and gerund of can"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27e3dbd-5cfc-4da2-a6b2-5f531bc96c81",
                                                "sense_id": "8ad6ebb2-3013-3ae7-a1a2-3204a31d0132",
                                                "text": "I might be able to go."
                                            },
                                            {
                                                "example_id": "69adf446-76c2-4d5b-b758-d3869db9f9db",
                                                "sense_id": "8ad6ebb2-3013-3ae7-a1a2-3204a31d0132",
                                                "text": "I have been able to go, since I was seven."
                                            },
                                            {
                                                "example_id": "999fabfa-ef74-4076-8e9f-ffcb4b3c078e",
                                                "sense_id": "8ad6ebb2-3013-3ae7-a1a2-3204a31d0132",
                                                "text": "I had been able to go before."
