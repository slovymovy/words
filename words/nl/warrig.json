{
    "word_family": [
        "war",
        "verwarren",
        "verwarring",
        "warboel"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e831cc1c-534f-3117-9426-022b31900d04",
                    "sense_definition": "niet geordend of onduidelijk gestructureerd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wanordelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kamer was een <w>warrige</w> bende na het grote feest van gisteravond.",
                            "target_lang_translations": {
                                "en": "The room was a <w>disorganized</w> mess after the big party last night."
                            }
                        },
                        {
                            "text": "Hij presenteerde een <w>warrig</w> plan dat niemand in de vergadering echt begreep.",
                            "target_lang_translations": {
                                "en": "He presented a <w>muddled</w> plan that no one in the meeting really understood."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaotisch",
                        "wanordelijk",
                        "onduidelijk"
                    ],
                    "antonyms": [
                        "geordend",
                        "overzichtelijk",
                        "helder"
                    ],
                    "common_phrases": [
                        "een warrig plan",
                        "warrige boel"
                    ],
                    "target_lang_definitions": {
                        "en": "not organized or unclearly structured"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disorganized",
                                "target_lang_sense_clarification": "lacking order or structure"
                            },
                            {
                                "target_lang_word": "muddled",
                                "target_lang_sense_clarification": "confused and lacking clarity"
                            },
                            {
                                "target_lang_word": "chaotic",
                                "target_lang_sense_clarification": "completely disordered"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f3818a3-24fd-3fe4-b71d-155ffc9b45a0",
                    "sense_definition": "geestelijk verward of onsamenhangend in gedachten en spraak",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geestelijke verwarring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertelde me een <w>warrig</w> verhaal waar ik helemaal niets van kon begrijpen.",
                            "target_lang_translations": {
                                "en": "He told me a <w>rambling</w> story that I couldn't understand at all."
                            }
                        },
                        {
                            "text": "De oude man was een beetje <w>warrig</w> en wist niet meer waar hij was.",
                            "target_lang_translations": {
                                "en": "The old man was a bit <w>confused</w> and no longer knew where he was."
                            }
                        }
                    ],
                    "synonyms": [
                        "verward",
                        "onsamenhangend",
                        "in de war",
                        "incoherent"
                    ],
                    "antonyms": [
                        "helder",
                        "lucide"
                    ],
                    "common_phrases": [
                        "een warrig verhaal",
                        "warrig overkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "mentally confused or incoherent in thoughts and speech"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confused",
                                "target_lang_sense_clarification": "unable to think clearly"
                            },
                            {
                                "target_lang_word": "incoherent",
                                "target_lang_sense_clarification": "expressed in a confusing way"
                            },
                            {
                                "target_lang_word": "rambling",
                                "target_lang_sense_clarification": "lengthy and confused speech"
                            },
                            {
                                "target_lang_word": "disoriented",
                                "target_lang_sense_clarification": "confused about time or place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7148daf8-1bf3-34b9-8265-7398df0840fd",
                    "sense_definition": "vol met knopen of door elkaar zittend, meestal gezegd van haar of draden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke verwarring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange fietstocht in de wind had zij erg <w>warrig</w> haar.",
                            "target_lang_translations": {
                                "en": "After a long bike ride in the wind, she had very <w>tangled</w> hair."
                            }
                        },
                        {
                            "text": "De visser probeerde de <w>warrige</w> draden van zijn net weer uit elkaar te halen.",
                            "target_lang_translations": {
                                "en": "The fisherman tried to untangle the <w>knotted</w> threads of his net."
                            }
                        }
                    ],
                    "synonyms": [
                        "verward"
                    ],
                    "antonyms": [
                        "glad",
                        "gekamd"
                    ],
                    "common_phrases": [
                        "warrig haar"
                    ],
                    "target_lang_definitions": {
                        "en": "full of knots or tangled together, usually said of hair or threads"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tangled",
                                "target_lang_sense_clarification": "twisted together in a confused mass"
                            },
                            {
                                "target_lang_word": "messy",
                                "target_lang_sense_clarification": "untidy, especially hair"
                            },
                            {
                                "target_lang_word": "knotted",
                                "target_lang_sense_clarification": "full of knots"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
