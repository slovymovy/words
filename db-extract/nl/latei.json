                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "374b51f3-226c-41bc-8960-d3077b3488d8",
                        "source_entry_id": "627ba2bd-09f4-319b-92cd-74daf6f4aa61",
