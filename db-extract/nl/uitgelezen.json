                                "example_id": "01e08b79-625d-419d-831e-c14b5b313136",
                                "sense_id": "b1028dab-d4da-3457-8e5f-485fe7e02d07",
                                "text": "Dit boek bevat een uitgelezen selectie van gedichten van bekende dichters.",
