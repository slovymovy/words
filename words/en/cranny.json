{
    "word_family": [
        "crannied"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c051a48-50d6-34f8-9e69-1a4046c6cb4a",
                    "sense_definition": "A small, narrow opening, fissure, or crevice in a wall or other surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spider hid itself deep within a dark <w>cranny</w> of the old stone wall.",
                            "target_lang_translations": {
                                "cs": "Pavouk se schoval hluboko do tmavé <w>škvíry</w> ve staré kamenné zdi."
                            }
                        },
                        {
                            "text": "Dust had collected in every <w>cranny</w> of the neglected attic room.",
                            "target_lang_translations": {
                                "cs": "Prach se usadil v každé <w>skulině</w> zanedbaného podkrovního pokoje."
                            }
                        }
                    ],
                    "synonyms": [
                        "crevice",
                        "fissure",
                        "chink",
                        "crack"
                    ],
                    "common_phrases": [
                        "nooks and crannies"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý, úzký otvor, trhlina nebo štěrbina ve zdi či jiném povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škvíra",
                                "target_lang_sense_clarification": "obecné označení pro úzkou mezeru"
                            },
                            {
                                "target_lang_word": "puklina",
                                "target_lang_sense_clarification": "trhlina v pevném materiálu, např. ve skále nebo zdi"
                            },
                            {
                                "target_lang_word": "skulina",
                                "target_lang_sense_clarification": "malý otvor nebo mezera"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a71240-f86a-3fc3-8259-a32bc00431cc",
                    "sense_definition": "A specialized tool used for shaping the necks of glass bottles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glassblower used a <w>cranny</w> to refine the neck of the bottle.",
                            "target_lang_translations": {
                                "cs": "Sklář použil <w>nástroj na tvarování hrdel</w> k úpravě hrdla láhve."
                            }
                        },
                        {
                            "text": "Traditional glassmaking requires a <w>cranny</w> for consistent bottle production.",
                            "target_lang_translations": {
                                "cs": "Tradiční sklářství vyžaduje <w>nástroj na tvarování hrdel</w> pro konzistentní výrobu lahví."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Specializovaný nástroj používaný skláři k tvarování hrdel lahví."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0be8818-4485-3499-8701-a83f99726649",
                    "sense_definition": "To develop or become filled with small cracks or fissures.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry earth began to <w>cranny</w> under the intense summer heat.",
                            "target_lang_translations": {
                                "cs": "Vyprahlá země začala pod intenzivním letním žárem <w>pukat</w>."
                            }
                        },
                        {
                            "text": "The aging plaster started to <w>cranny</w> across the entire ceiling.",
                            "target_lang_translations": {
                                "cs": "Stárnoucí omítka začala na celém stropě <w>praskat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "crack",
                        "fissure"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvářet nebo se plnit malými trhlinami či prasklinami."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "praskat",
                                "target_lang_sense_clarification": "vznikat trhlinám v materiálu"
                            },
                            {
                                "target_lang_word": "pukat",
                                "target_lang_sense_clarification": "tvořit se trhlinám vlivem sucha nebo stáří"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "422f0b49-9dd5-38f3-ad52-a50dc6c29680",
                    "sense_definition": "To pass through or enter into small openings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold air began <w>crannying</w> through the gaps in the window frame.",
                            "target_lang_translations": {
                                "cs": "Studený vzduch začal <w>pronikat</w> mezerami v okenním rámu."
                            }
                        },
                        {
                            "text": "The wind was <w>crannying</w> through the ruins of the ancient castle.",
                            "target_lang_translations": {
                                "cs": "Vítr <w>pronikal</w> zříceninami starobylého hradu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pronikat nebo procházet malými otvory."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pronikat",
                                "target_lang_sense_clarification": "dostávat se skrz úzké prostory"
                            },
                            {
                                "target_lang_word": "protahovat se",
                                "target_lang_sense_clarification": "procházet úzkým otvorem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d782ae1d-7505-3bf5-aa7e-a4fcb24fadfc",
                    "sense_definition": "A historical term for a clerk who writes in English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The colonial office employed a local <w>cranny</w> to manage the records.",
                            "target_lang_translations": {
                                "cs": "Koloniální úřad zaměstnával místního <w>písaře</w>, aby spravoval záznamy."
                            }
                        },
                        {
                            "text": "Every <w>cranny</w> was responsible for copying official documents by hand.",
                            "target_lang_translations": {
                                "cs": "Každý <w>písař</w> byl zodpovědný za ruční opisování úředních dokumentů."
                            }
                        }
                    ],
                    "synonyms": [
                        "clerk",
                        "scribe"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical term used in colonial contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Historický termín pro úředníka nebo písaře v koloniální správě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "písař",
                                "target_lang_sense_clarification": "osoba zabývající se ručním opisováním dokumentů"
                            },
                            {
                                "target_lang_word": "úředník",
                                "target_lang_sense_clarification": "administrativní pracovník"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5efe17c4-3854-35a2-881d-933c2cfb3636",
                    "sense_definition": "A historical term for a person of mixed-race heritage in India who worked as a copyist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administrative staff included many a <w>cranny</w> during the British Raj.",
                            "target_lang_translations": {
                                "cs": "Administrativní personál zahrnoval během Britské Indie mnoho <w>písařů</w>."
                            }
                        },
                        {
                            "text": "The role of the <w>cranny</w> was essential for maintaining colonial archives.",
                            "target_lang_translations": {
                                "cs": "Role <w>písaře</w> byla pro udržování koloniálních archivů zásadní."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical term used in colonial India."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Historický termín pro osobu smíšeného původu v Indii, která pracovala jako písař."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        }
    ]
}