    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e30ec906-73e5-3b3a-a256-e00d37fcb109",
                "word": "toothsome",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0b07ff29-7359-42b7-83ec-63d65a9f0552",
                        "entry_id": "e30ec906-73e5-3b3a-a256-e00d37fcb109",
