                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d1ae20-b2ec-41c4-9f05-246af9caf800",
                                "sense_id": "4f1cb013-4665-399c-ab5b-bcea56487030",
                                "text": "[…] if they do not owe their allegiance to shamanism or Buddhism, then most surely they commit themselves to some perverse form of Confucianism or belletristic foolishness."
                            },
                            {
                                "example_id": "a4346050-b7c3-4f00-b498-8ace1d715717",
                                "sense_id": "4f1cb013-4665-399c-ab5b-bcea56487030",
                                "text": "The guest list was a roll call of belletristic London."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d98c9f9-5175-3201-b487-bdd9b28a27f1",
                        "entry_id": "7dc7a100-3424-3eca-b373-7e7b954c7bca",
                        "glosses": [
                            "Written or appreciated for aesthetic value rather than content"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49486805-cf51-4209-a54e-c84ce3a23980",
                                "sense_id": "0d98c9f9-5175-3201-b487-bdd9b28a27f1",
                                "text": "I had already concluded that not one of my writings was publishable, having myself analyzed the faults of my belletristic production."
                            }
                        ]
