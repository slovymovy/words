                    }
                ],
                "senses": [
                    {
                        "sense_id": "d026b776-15e9-36c0-98d9-e1fc8361aec4",
                        "entry_id": "407a4091-0957-3186-ad54-bdc629824b70",
                        "glosses": [
                            "dem Grad nach, stufenweise, sich allmählich oder in kleinen Schritten ändernd oder unterscheidend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578e17cf-6123-4b80-b2a7-bcba8b3aed06",
                                "sense_id": "d026b776-15e9-36c0-98d9-e1fc8361aec4",
                                "text": "„Diese lassen sich kontinuierlich auf nächst höhere zurückführen, womit ein gradweiser Prozess der Abstraktion einhergeht.“"
                            },
                            {
                                "example_id": "0f5caf63-75bd-4e64-b655-6a8fb9dd9de0",
                                "sense_id": "d026b776-15e9-36c0-98d9-e1fc8361aec4",
                                "text": "„Gewiss ist die Wahrnehmung richtig, dass zwischen meines Vaters geistiger Struktur und der seiner Zeitgenossen kein grundsätzlicher, nur ein gradweiser Unterschied besteht.“"
                            },
                            {
                                "example_id": "044ded23-d6ae-4a6c-bfed-735622ce2a60",
                                "sense_id": "d026b776-15e9-36c0-98d9-e1fc8361aec4",
                                "text": "„Wo man von gradweiser Annäherung spricht, denkt man sich eine Skala.“"
                            },
                            {
                                "example_id": "8d9874f1-a442-45d4-a3fe-1d41c273cace",
                                "sense_id": "d026b776-15e9-36c0-98d9-e1fc8361aec4",
                                "text": "„Bei diesen aber läßt sich ein gradweises Fortschreiten in der Ausbildung dieser Gehirnteile feststellen, das mit ihren zunehmenden intellektuellen Leistungen, soweit wir darüber etwas wissen, annähernd Schritt hält.“"
                            },
                            {
                                "example_id": "bad0cb25-d5a2-44bb-8c28-2b822bf0a046",
                                "sense_id": "d026b776-15e9-36c0-98d9-e1fc8361aec4",
                                "text": "„Dienten dieselben an den Enden der Tastnerven angebrachten mikroskopisch kleinen Sinnorgane für beide Zwecke, und also sowohl zur Wahrnehmung des Drucks und seiner gradweisen Verschiedenheiten, als auch zur Wahrnehmung der Wärme und Kälte und ihrer gradweisen Unterschiede, hätte die Empfindung von Wärme und Kälte ihren Grund in der Wahrnehmung desjenigen Drucks, der dadurch entstünde, dass die Wärme die Körper ausdehnt, die Kälte aber ihr Volumen vermindert; so würde nur ein einziger Sinn, der Tastsinn, in der Haut anzunehmen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
