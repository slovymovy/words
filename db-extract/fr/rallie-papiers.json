                        "examples": [
                            {
                                "example_id": "ce45b7a3-a025-4c61-9703-9f91639dc69f",
                                "sense_id": "b816deb9-2b09-3505-aa10-ff7637356adc",
                                "text": "Avec une pareille allure, pouvait-on être une vraie chrétienne, une épouse parfaite ? Et que signifiait ce goût récent du cheval, ces rallie-papiers ?"
                            },
                            {
                                "example_id": "218d9721-fb7e-4f5a-b7a4-dacf3ecc9740",
                                "sense_id": "b816deb9-2b09-3505-aa10-ff7637356adc",
                                "text": "Les rallie-papiers sont des courses à travers champs ou sous bois. On forme une meute composée d'un nombre illimité de coureurs et conduits par un chef d'équipage; deux ou trois coureurs choisis parmi les meilleurs et les plus expérimentés représentent l'animal traqué; […]."
                            }
                        ]
                    }
