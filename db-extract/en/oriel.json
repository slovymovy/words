                "senses": [
                    {
                        "sense_id": "6a93e977-c6a3-321b-8447-8d8456113f67",
                        "entry_id": "e7f3358a-4289-3b0e-91cf-2ab2188763a8",
                        "glosses": [
                            "A large polygonal recess in a building, such as a bay window, forming a protrusion on the outer wall."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aade8a5e-5c23-4ce8-bf7f-029759a4819c",
                                "sense_id": "6a93e977-c6a3-321b-8447-8d8456113f67",
                                "text": "The middle window of the oriel before her, just caught and reflected back the crimson light and colour. The ground below looked bright and warm compared with the shade around."
                            },
                            {
                                "example_id": "2d66d812-fbef-41c9-b88d-cfe4cdc08e5e",
                                "sense_id": "6a93e977-c6a3-321b-8447-8d8456113f67",
                                "text": "The beams that thro' the Oriel shine / Make prisms in every carven glass, / And beaker brimm'd with noble wine."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2454c23-f035-3a3c-8831-2fa7377bfd51",
                        "entry_id": "e7f3358a-4289-3b0e-91cf-2ab2188763a8",
                        "glosses": [
                            "A small apartment next to a hall, used for dining."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d681811f-6d1f-4564-a17d-779c748562ab",
                        "source_entry_id": "e7f3358a-4289-3b0e-91cf-2ab2188763a8",
                        "source_sense_description": "recess in a building, protruding on the outer wall",
                        "target_lang_word": "erker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a852bef2-7748-30dc-a4bc-b09c834a184e",
                                        "entry_id": "16b2c05e-9f21-3f81-8066-a251c50bb390",
                                        "glosses": [
                                            "uitbouw aan een gevel waardoor een kamer boven de straat of tuin uitspringt, vaak met veel ramen zodat er meer licht in de kamer valt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6240b8c7-50d6-4f20-a4de-a55a7ceb55dd",
                                                "sense_id": "a852bef2-7748-30dc-a4bc-b09c834a184e",
                                                "text": "De net bijgebouwde erker zorgde voor wat meer schaduw in de tuin."
                                            },
                                            {
                                                "example_id": "b086185d-9eca-4cdb-8d7b-f5c9ac2ccdca",
                                                "sense_id": "a852bef2-7748-30dc-a4bc-b09c834a184e",
                                                "text": "Ze dronken voorzichtig van een halve fles laat geoogste moezelwijn, voor namelijk om iets voor zich te hebben staan op de mooi gesneden tafel in de erker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "315d50b0-de45-4b8a-9a56-1b92f62174c1",
                        "source_entry_id": "e7f3358a-4289-3b0e-91cf-2ab2188763a8",
                        "source_sense_description": "recess in a building, protruding on the outer wall",
                        "target_lang_word": "Erker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                        "entry_id": "a5c90b42-3c81-3020-a93f-8ff28ac25740",
                                        "glosses": [
                                            "geschlossener, mit Fenstern versehener Vorbau an Gebäuden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94282b00-389b-4ff0-8a13-5ad528fdb645",
                                                "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                                "text": "Wenn ich mal ein Haus baue, dann muss es unbedingt einen Erker haben."
                                            },
                                            {
                                                "example_id": "3a4fdfa1-e4c9-4a4b-8b59-d78e4e476ece",
                                                "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                                "text": "„Cecilienhof war erst 1917, ein Jahr vor dem Ende des Ersten Weltkriegs, fertig gestellt worden, ein Landsitz mit 176 Räumen im überladenen Tudor-Stil: lauter Erker, ein Wald von Schornsteinen, efeuumschlungene Fachwerkfassaden.“"
                                            },
                                            {
                                                "example_id": "8e324153-e1c2-4a27-9041-e75e03ebd1b0",
                                                "sense_id": "0fa94a7e-1a8e-3aa2-bec9-48758cc2f860",
                                                "text": "„Die weißgetünchte zweistöckige Villa mit hohen Sprossenfenstern und einem runden Erker an der rechten Seite lag am Ende eines parkähnlichen Grundstücks.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
