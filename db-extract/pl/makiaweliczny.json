                                        "glosses": [
                                            "dem Machtinteresse den Vorrang gegenüber der Moral gebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5e35d2-593e-4932-b03b-0290da009a0c",
                                                "sense_id": "c0feb54f-7bbf-3445-9756-2ad6cb991daf",
                                                "text": "Der neue Chefeinkäufer legt eine eindeutig machiavellistische Haltung an den Tag."
                                            }
