                    },
                    {
                        "translation_id": "87b43303-1f72-400d-a3a4-d385070befad",
                        "source_entry_id": "3cee0e57-5bea-3fd9-9172-1aaba0ac4b4f",
                        "source_sense_id": "6a7011c3-8763-3fbb-a1e4-21e441b5940a",
                        "target_lang_word": "clip",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clip",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf162c6-d558-3f15-805e-9efe0054ebcd",
                                        "entry_id": "a703bec8-79d9-3fa9-a263-a5b5c55fc894",
                                        "glosses": [
                                            "Vidéo musicale, œuvre multimédia, principalement audiovisuelle et communément courte, réalisée pour promouvoir une chanson."
                                        ],
                                        "tags": [
                                            "Faux anglicisme",
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b2c1d1-6324-406c-b086-cbb12c86e38c",
                                                "sense_id": "5bf162c6-d558-3f15-805e-9efe0054ebcd",
                                                "text": "[…], je n’avais rien vu d’aussi torride depuis un clip d’Enrique Iglesias sur MCM (groupe Lagardère) dans lequel l’Ibère chaudard se frottait le chorizo sur la partie arrière d’une jeune et plantureuse intellectuelle des pays de l’Est."
                                            },
                                            {
                                                "example_id": "377e0912-d2dc-431a-be50-835c04c3c1e1",
                                                "sense_id": "5bf162c6-d558-3f15-805e-9efe0054ebcd",
                                                "text": "Cargo de nuit, qu’il a réalisé pour Axel Bauer, fut d’ailleurs le premier clip francophone à être programmé sur MTV aux États-Unis en 1984— l’autre atout du clip étant de chorégraphier les mouvements."
                                            },
                                            {
                                                "example_id": "3f44cf19-ee03-4d97-b787-d0b51bbb94a1",
                                                "sense_id": "5bf162c6-d558-3f15-805e-9efe0054ebcd",
                                                "text": "Dans une interview donnée mardi à France 3, le rappeur grenoblois expliquait que tout est factice dans le clip : armes et drogues. Il doit à présent s’en expliquer devant la justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a2df0a-b2df-3315-af22-d00d15435f75",
                                        "entry_id": "a703bec8-79d9-3fa9-a263-a5b5c55fc894",
                                        "glosses": [
                                            "Un contenu vidéo court, indépendamment de la présence d'une bande musicale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e784483a-bbc7-42ca-81f4-715ac4451599",
                                                "sense_id": "86a2df0a-b2df-3315-af22-d00d15435f75",
                                                "text": "Sur les vidéos analysées par Bruxelles, la quasi-totalité des clips publiés par les influenceurs, soit 97 %, affichaient « des contenus commerciaux » en oubliant « systématiquement » de prévenir les internautes que leur message était commandité moyennant finance par des marques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clip",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4654320b-7424-39cf-a533-007109c80fa5",
                                        "entry_id": "d8759912-9bd1-3838-9dfd-fd2aad1fab32",
                                        "glosses": [
                                            "Bijou monté sur une pince, broche, boucle d'oreille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb096cb-b241-4168-9a41-a36f6c1c4f05",
                                                "sense_id": "4654320b-7424-39cf-a533-007109c80fa5",
                                                "text": "Alors son clip d'oreille se détache, et tombe dans cette bouche ouverte."
                                            },
                                            {
                                                "example_id": "daf2c371-6b34-4906-bca3-90640addfaac",
                                                "sense_id": "4654320b-7424-39cf-a533-007109c80fa5",
                                                "text": "Laurence se mit à jouer avec le clip doré qui ornait le revers du tailleur de sa grand-mère Charlotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b284293f-9831-30b2-941b-01e5c0716eda",
                                        "entry_id": "d8759912-9bd1-3838-9dfd-fd2aad1fab32",
                                        "glosses": [
                                            "Pince à cheveux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96108a9b-d20c-3436-8fa3-4c6e662b29e9",
                                        "entry_id": "d8759912-9bd1-3838-9dfd-fd2aad1fab32",
                                        "glosses": [
                                            "Pince, agrafe chirurgicale servant à pincer un vaisseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f1a1eb-10f6-4df2-b36e-3f70926dbeff",
                                                "sense_id": "96108a9b-d20c-3436-8fa3-4c6e662b29e9",
                                                "text": "L'activité vasodépressive des médullaires des reins sténosés est inférieure à celle des médullaires des reins normaux opposés prélevés lors de la pose du clip artériel."
                                            },
                                            {
                                                "example_id": "580d8114-79bd-49b2-9612-c419e586c8ae",
                                                "sense_id": "96108a9b-d20c-3436-8fa3-4c6e662b29e9",
                                                "text": "Longtemps je me suis endormie dans la frayeur que le clip en plastique logé dans ma tête par le chirurgien ne se décolle pendant mon sommeil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c8435e-e991-3829-86cf-359b5e35bd6a",
                                        "entry_id": "d8759912-9bd1-3838-9dfd-fd2aad1fab32",
                                        "glosses": [
                                            "Pince, agrafe chirurgicale servant à pincer un vaisseau.",
                                            "Toute sorte d'objet, de mécanisme servant à pincer, bloquer, fermer ou fixer quelque chose. Agrafe de stylo."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e58f468f-722f-4480-8dd0-78c9d4195bcc",
                                                "sense_id": "93c8435e-e991-3829-86cf-359b5e35bd6a",
                                                "text": "Portefeuille porte-portable Voici une pochette de ceinture (fermeture par clip ou bouton pression) qui allie les fonctions de portefeuille à celle d'un étui pour portable."
                                            },
                                            {
                                                "example_id": "6be96cdc-6dff-440f-b366-3c532dd2946a",
                                                "sense_id": "93c8435e-e991-3829-86cf-359b5e35bd6a",
                                                "text": "D'ailleurs ils ont rompu. (Il enleva ses boucles d'oreille à clip.) Les apparences sont contre lui, je vous l'accorde, mais peut être qu'il a de bonnes raisons pour avoir agi ainsi."
                                            },
                                            {
                                                "example_id": "8e609269-92f8-4e5d-bda2-4c4846d490bc",
                                                "sense_id": "93c8435e-e991-3829-86cf-359b5e35bd6a",
                                                "text": "Elle prend la forme d'un footpod qui s'accroche à l'une de nos chaussures, avec un simple clip en plastique sur les lacets, et qui pèse 7 g."
                                            },
                                            {
                                                "example_id": "ec8b7ee4-6a42-4ade-a051-a291f0368c33",
                                                "sense_id": "93c8435e-e991-3829-86cf-359b5e35bd6a",
                                                "text": "Clips pour la fixation du lambris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clip",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9634ca6f-7831-311b-a925-c17e2e1d8aae",
                                        "entry_id": "acebbf7c-3302-3a8f-a88a-dd7cbafa40bf",
                                        "glosses": [
                                            "Bruit de ciseaux de coiffeur, de pas sur le sol, de cisaille de jardinier, clapotis, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d73262cc-6040-4c2d-8e41-228cfe84e528",
                                                "sense_id": "9634ca6f-7831-311b-a925-c17e2e1d8aae",
                                                "text": "Elle m'a coupé les cheveux. Clip-clip, plusieurs mèches."
                                            },
                                            {
                                                "example_id": "fc3d086f-0000-4666-97b0-c0e2668c09c3",
                                                "sense_id": "9634ca6f-7831-311b-a925-c17e2e1d8aae",
                                                "text": "Clip, clip, clip, clap... Traîné par un cheval étique, le corbillard glissait sur la route luisante de pluie."
                                            },
                                            {
                                                "example_id": "12aba139-abe2-4a9b-ae3f-5c5d85580345",
                                                "sense_id": "9634ca6f-7831-311b-a925-c17e2e1d8aae",
                                                "text": "Clip, clip, clip, faisaient contre la coque les clapotis de l'eau, aussi réguliers qu'un balancier d'horloge. Clip, clip, clip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
