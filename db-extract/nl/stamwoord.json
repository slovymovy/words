                                    },
                                    {
                                        "sense_id": "4fee74be-5686-36b3-b67f-1e44d2471317",
                                        "entry_id": "4de9c5b5-9653-3384-97eb-5b9e060305b2",
                                        "glosses": [
                                            "A premixed portion of a track for use in audio mastering and remixing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19eed503-e28c-4883-914c-8692476a6d44",
                                                "sense_id": "4fee74be-5686-36b3-b67f-1e44d2471317",
                                                "text": "Stem mastering processes a mix by breaking it down into several manageable pieces—that is, stereo stems. The stem approach allows the mastering engineer the opportunity to make larger or smaller changes to separate mix elements before the final compression and limiting are applied to the complete mix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a700e8b-1ce9-3491-96a3-17921477c138",
                                        "entry_id": "4de9c5b5-9653-3384-97eb-5b9e060305b2",
                                        "glosses": [
                                            "The vertical or nearly vertical forward extension of the keel, to which the forward ends of the planks or strakes are attached."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b86d175f-c825-3fa8-a580-c3f70fc5e727",
                                        "entry_id": "4de9c5b5-9653-3384-97eb-5b9e060305b2",
                                        "glosses": [
                                            "The front part of a vessel."
