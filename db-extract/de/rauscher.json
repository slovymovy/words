                ],
                "senses": [
                    {
                        "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                        "entry_id": "b29c3005-0c82-3c43-a86c-f53e9c5f3083",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7f069d-aac3-4f4e-91ec-f630a383216f",
                                "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                                "text": "Frau Rauscher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cb984745-1ebc-4ba1-ab11-40eb5416f90d",
                                "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                                "text": "Herr Rauscher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fd322d48-9907-4bac-9cc4-647af6bc0671",
                                "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                                "text": "Die Rauschers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2594b1b5-5537-4f69-b625-19727251b76f",
                                "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                                "text": "Der Rauscher trägt nie die Schals, die die Rauscher ihm strickt."
                            },
                            {
                                "example_id": "41d39c91-4839-49ea-8d3a-bfd607812b62",
                                "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rauscher kommt, geht der Herr Rauscher.“"
                            },
                            {
                                "example_id": "f16ec541-37e8-433a-8d2d-8be555273261",
                                "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                                "text": "Rauscher kommt und geht."
                            },
                            {
                                "example_id": "c6ec68cd-fbf8-467f-bdf8-50854df1f51f",
                                "sense_id": "78e2ea29-e858-3481-90be-78772728fa2b",
                                "text": "Rauschers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
