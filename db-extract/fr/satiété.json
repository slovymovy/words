        "fr-extract.jsonl": [
            {
                "entry_id": "c1ff6227-c07d-35ec-94e1-14e6004faf76",
                "word": "satiété",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1499e599-84f6-45dd-a0bd-05599b8a5d4d",
                        "entry_id": "c1ff6227-c07d-35ec-94e1-14e6004faf76",
                        "tags": [
                            "plural"
                        ],
                        "form": "satiétés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb03d8c7-02c7-32b3-9f63-21617cea31e5",
                        "entry_id": "c1ff6227-c07d-35ec-94e1-14e6004faf76",
                        "glosses": [
                            "État d’une personne dont la faim est complètement satisfaite, qui est entièrement rassasiée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94326ccb-09ce-4f8d-a9f2-95b976eff3b5",
                                "sense_id": "eb03d8c7-02c7-32b3-9f63-21617cea31e5",
                                "text": "Manger jusqu’à satiété, jusqu’à la satiété."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff993a85-4e60-3c4f-84e4-a5c3f720a6d4",
                        "entry_id": "c1ff6227-c07d-35ec-94e1-14e6004faf76",
                        "glosses": [
                            "Se dit aussi de la soif satisfaite, principalement avec l’eau, le mot étant alors suivi d’un adjectif qualificatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80565016-e046-47c3-81ea-52073bdb06ac",
                                "sense_id": "ff993a85-4e60-3c4f-84e4-a5c3f720a6d4",
                                "text": "Les réponses comportementales étaient en bon accord avec l'évaluation subjective de leur soif et de leur satiété hydrique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8ddd0cd-3a67-4883-9e86-b0dd3bd229e6",
                        "source_entry_id": "c1ff6227-c07d-35ec-94e1-14e6004faf76",
                        "target_lang_word": "satiety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satiety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31040c0f-7958-30c3-9d50-3ae391b872ae",
                                        "entry_id": "deb40e06-1c9c-329d-a00f-1fe2707b65ca",
                                        "glosses": [
                                            "The state of being satiated."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19d8c1e-6194-4a30-b843-267be4f4a173",
                                                "sense_id": "31040c0f-7958-30c3-9d50-3ae391b872ae",
                                                "text": "Eating half of that loaf of bread has left me in a state of utter satiety."
                                            },
                                            {
                                                "example_id": "effe64ba-c460-44c5-aacd-cf16085ab8e3",
                                                "sense_id": "31040c0f-7958-30c3-9d50-3ae391b872ae",
                                                "text": "Satiety and mortification are the extremes of vanity, and both are equally attended by envy, hatred, malice, and all uncharitableness."
                                            },
                                            {
                                                "example_id": "581f9c21-cfe0-4c39-9fbd-444b8344ce61",
                                                "sense_id": "31040c0f-7958-30c3-9d50-3ae391b872ae",
                                                "text": "Surgical techniques have also been instrumental in understanding the pathways leading to satiety..."
                                            },
                                            {
                                                "example_id": "75205bdc-c247-4126-ab64-01315caa923a",
                                                "sense_id": "31040c0f-7958-30c3-9d50-3ae391b872ae",
                                                "text": "On the other hand, early satiety did not correlate with delayed gastric emptying..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c500fe18-6fa3-47a7-b3ab-0deb5193d586",
                        "source_entry_id": "c1ff6227-c07d-35ec-94e1-14e6004faf76",
                        "target_lang_word": "repletion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repletion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf17bc3-b213-311d-932e-378e401b2380",
                                        "entry_id": "ac45d2cc-df78-3687-8cb0-c08f0a5d1ca6",
                                        "glosses": [
                                            "The condition of being replete; fullness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf556028-097b-48f4-b18a-4e3750dfe80a",
                                                "sense_id": "4cf17bc3-b213-311d-932e-378e401b2380",
                                                "text": "Fiddle de dee, the whole thing is neither more nor less than a substitute for the masquerade, which luckily became so gross, it died of repletion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad4ceca-23e9-3107-a7da-350bb44b9792",
                                        "entry_id": "ac45d2cc-df78-3687-8cb0-c08f0a5d1ca6",
                                        "glosses": [
                                            "Plethora of the blood."
                                        ],
