                ],
                "senses": [
                    {
                        "sense_id": "86991c2e-60ef-3656-a709-c80e6c1d6447",
                        "entry_id": "8a5a7e3d-829b-3f48-8f16-6ab666ee152b",
                        "glosses": [
                            "Subgenre der Science-Fiction, für das retrofuturistische, mit Dampf betriebene Apparate und Maschinen, sowie Elemente der viktorianischen Ära charakteristisch sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cacbcbdb-c80b-4adb-b941-fe1071306047",
                                "sense_id": "86991c2e-60ef-3656-a709-c80e6c1d6447",
                                "text": "Jules Verne und der Wilde Westen sind wichtige Inspirationsquellen für Steampunk."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20caaedf-66f6-49e4-8f6b-6949addd80c4",
                        "source_entry_id": "8a5a7e3d-829b-3f48-8f16-6ab666ee152b",
                        "source_sense_id": "86991c2e-60ef-3656-a709-c80e6c1d6447",
                        "target_lang_word": "steampunk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steampunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "106daeb0-6e36-393f-88da-30b72b8c836b",
                                        "entry_id": "d4f56ea7-bcdc-30d1-ab6c-e88a24cdd77c",
                                        "glosses": [
                                            "A subgenre of science fiction that depicts advanced technology combined with Victorian style and aesthetics, such as steam-powered machines and vehicles, visible gears and screws and people dressed in 19th-century attires."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c806c5-f3e0-4231-996e-539d2fffe879",
                                                "sense_id": "106daeb0-6e36-393f-88da-30b72b8c836b",
                                                "text": "There's railroad trains, a lot of steam-driven stuff, but that's about it. More ‘steam punk’, I suppose."
                                            },
                                            {
                                                "example_id": "cdeff023-72a3-4a64-9286-c611ef1016c9",
                                                "sense_id": "106daeb0-6e36-393f-88da-30b72b8c836b",
                                                "text": "It is also the vision of steampunk, a subculture that is the aesthetic expression of a time-traveling fantasy world, one that embraces music, film, design and now fashion, all inspired by the extravagantly inventive age of dirigibles and steam locomotives, brass diving bells and jar-shaped protosubmarines."
                                            },
                                            {
                                                "example_id": "c7396de4-fa73-4d9b-a588-d584bf11e7e1",
                                                "sense_id": "106daeb0-6e36-393f-88da-30b72b8c836b",
                                                "text": "The [Arboath North Signal Box] locking room's collection of chains, pulleys and wires resembles the inside of a piano, stretching to the 72-levered frame above. Lovers of steampunk will find it especially pleasing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e2a91ee-f454-307b-8fef-074b2fe021ef",
                                        "entry_id": "d4f56ea7-bcdc-30d1-ab6c-e88a24cdd77c",
                                        "glosses": [
                                            "A writer of steampunk fiction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42cbb25a-6b59-42e5-b6e7-97dc7dd909a6",
                                                "sense_id": "5e2a91ee-f454-307b-8fef-074b2fe021ef",
                                                "text": "Personally, I think Victorian fantasies are going to be the next big thing, as long as we can come up with a fitting collective term for Powers, [James] Blaylock and myself. Something based on the appropriate technology of the era; like steam-punks, perhaps..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c175aa0-89aa-3293-815e-588b7c9429af",
                                        "entry_id": "d4f56ea7-bcdc-30d1-ab6c-e88a24cdd77c",
                                        "glosses": [
                                            "A person cosplaying as a steampunk character."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b9bd3a-0fb9-4083-b40d-3c38a58ddf0b",
                                                "sense_id": "0c175aa0-89aa-3293-815e-588b7c9429af",
                                                "text": "It wound up being an overwhelmingly positive experience that made me appreciate the steampunks around me even more."
                                            },
                                            {
                                                "example_id": "9d66925d-c498-42f0-8412-a69b1a2455fb",
                                                "sense_id": "0c175aa0-89aa-3293-815e-588b7c9429af",
                                                "text": "It is extremely rare that you speak to someone who says \"I want to be an ....\" This would suggest that for the vast majority of steampunks their choice of outfit (at least intitially) is less a conscious attempt at portrayal and more of a spontaneous and potentially subconscious growth of an idea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "steampunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83d438e3-c8ee-35a9-82da-0e733200fec8",
                                        "entry_id": "cb4289f2-bfed-3284-b876-92e65c24cbb6",
                                        "glosses": [
                                            "To depict in a steampunk manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8011f5e-31d8-4484-893c-c4eacff37051",
                                                "sense_id": "83d438e3-c8ee-35a9-82da-0e733200fec8",
                                                "text": "[Director Paul W.S.] Anderson's answer to the question of what to update in this film seems to be: steampunk everything. Hence the elaborate airship contraptions and weapons, all made in wood and iron and powered by choo-choo engines. What seems to be missing is the why. When far-fetched techno-bits and bobs are put into a story, these items must have a meaning and purpose. Here, the gadgets are throwaway items used for their visual effect, then discarded."
                                            },
                                            {
                                                "example_id": "d95273c6-1fd9-4ea0-962b-73b73c9ac6aa",
                                                "sense_id": "83d438e3-c8ee-35a9-82da-0e733200fec8",
                                                "text": "There is also a strong draw on literature and film for ideas. Some steampunks will take a favorite character, such as Boba Fett, Alice, Dorothy, Professor Snape, or Sherlock Holmes, and “steampunk” him or her out by adding elements of leather (or faux leather), gears, clock parts, electricity, motors, and so on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "496ee0c3-5d16-44ff-a372-0652231b533d",
                        "source_entry_id": "8a5a7e3d-829b-3f48-8f16-6ab666ee152b",
                        "source_sense_id": "86991c2e-60ef-3656-a709-c80e6c1d6447",
                        "target_lang_word": "steampunk",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steampunk",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e58f80-2273-30c4-9a8c-2cd9ca5c2823",
                                        "entry_id": "8ab92718-1354-3dd6-84d3-2a8acc264b48",
                                        "glosses": [
                                            "Sous-genre de la science-fiction se déroulant généralement au XIXᵉ ou au début du XXᵉ siècle, et devant son nom à l’utilisation massive de technologies en avance sur leur temps, mais à base de machines à vapeur ou, plus généralement, mouvement artistique fondé sur cette esthétique."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e8145f0-6cc8-4981-999b-f079116a49cd",
                                                "sense_id": "c6e58f80-2273-30c4-9a8c-2cd9ca5c2823",
                                                "text": "Le retour en grâce du steampunk en constitue la plus belle preuve, son esthétique baroque et surchargée suscitant un vif engouement auprès d'un public conséquent."
                                            },
                                            {
                                                "example_id": "008a3ef1-ad7e-4bb2-81b2-87fcb45e1cfb",
                                                "sense_id": "c6e58f80-2273-30c4-9a8c-2cd9ca5c2823",
                                                "text": "L’esthétique steampunk peut rapidement prendre la forme d’une série de clichés : prenez un aventurier, une espionne, un savant et un mécanicien, habillez-les avec des vêtements de la fin du XIXᵉ siècle, ajoutez quelques accessoires science-fictifs à base de rouages et de pièces cuivrées, et le tour est joué !"
                                            },
                                            {
                                                "example_id": "ec3302ca-22f9-44d4-af06-30f83756eec4",
                                                "sense_id": "c6e58f80-2273-30c4-9a8c-2cd9ca5c2823",
                                                "text": "Broc’land geek au 6 avenue Léo-Lagrange avec vente, échange, partage de la passion geek, pop culture, miniatures, jouets vintage, lego, playmo, univers steampunk, jeux de rôle, héros, fantasy, science-fiction (9h-17h, entrée 3 €, gratuit - de 10 ans)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
