                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49476804-7269-4a88-965f-d92c854cbe9e",
                                "sense_id": "0ce9c9c7-52f4-30e0-8dd6-9bb1ab805bd8",
                                "text": "Do Krakowa przybył wierny współpracownik zmarłego króla, arcybiskup gnieźnieński, Wojciech Jastrzębiec."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
