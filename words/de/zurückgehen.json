                        "ins Hotel zurückgehen"
                    ]
                },
                {
                    "sense_id": "dfdddb14-8192-3ab9-af02-5c68d2843676",
                    "sense_definition": "an Menge, Umfang, Intensität oder Wert abnehmen; geringer oder niedriger werden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abnahme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Arbeitslosigkeit in der Region ist im vergangenen Jahr deutlich <w>zurückgegangen</w>."
                        },
                        {
                            "text": "Nach den starken Regenfällen <w>ging</w> das Hochwasser der Flüsse glücklicherweise schnell <w>zurück</w>."
                        }
                    ],
                    "synonyms": [
                        "abnehmen",
                        "sinken",
                        "nachlassen"
                    ],
                    "antonyms": [
                        "zunehmen"
                    ],
                    "common_phrases": [
                        "deutlich zurückgehen",
                        "um zehn Prozent zurückgehen"
                    ]
                },
                {
                    "sense_id": "4c5bf3d3-8a7e-30e2-bd6b-20c65842180d",
                    "sense_definition": "seinen Ursprung oder seine Ursache in etwas Vergangenem haben (meist mit „auf“ konstruiert)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ursprung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele unserer heutigen Traditionen <w>gehen</w> auf Bräuche des Mittelalters <w>zurück</w>."
                        },
                        {
                            "text": "Die Entdeckung dieser Krankheit <w>geht</w> auf einen berühmten Forscher <w>zurück</w>."
                        }
                    ],
                    "synonyms": [
                        "herrühren",
                        "herstammen",
                        "entstammen"
                    ],
                    "common_phrases": [
                        "auf Traditionen zurückgehen",
                        "auf das Mittelalter zurückgehen"
                    ]
                },
                {
                    "sense_id": "f2bedffc-1cdf-3864-9fa4-e32c430a0a0b",
                    "sense_definition": "sich zeitlich, gedanklich oder in einer Untersuchung mit früheren Entwicklungsstadien befassen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rueckblick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Um die Bedeutung moderner Wörter zu ergründen, müssen Linguisten oft zu ihren historischen Wurzeln <w>zurückgehen</w>."
                        },
                        {
                            "text": "In diesem Kapitel <w>ging</w> der Historiker bis zur Gründung des Staates <w>zurück</w>."
