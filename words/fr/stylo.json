                                "tr": "Affedersiniz, bir an için <w>kaleminizi</w> ödünç alabilir miyim?",
                                "es": "Perdone, ¿me podría prestar su <w>bolígrafo</w> un momento?",
                                "zh": "打扰一下，能借您的<w>钢笔</w>用一会儿吗？"
                            }
                        },
                        {
                            "text": "J'écris toujours mes lettres avec un <w>stylo</w> à bille bleu.",
                            "target_lang_translations": {
                                "en": "I always write my letters with a blue <w>ballpoint pen</w>.",
                                "ru": "Я всегда пишу письма синей <w>шариковой ручкой</w>.",
                                "nl": "Ik schrijf mijn brieven altijd met een blauwe <w>balpen</w>.",
                                "de": "Ich schreibe meine Briefe immer mit einem blauen <w>Kugelschreiber</w>.",
                                "pl": "Zawsze piszę listy niebieskim <w>długopisem</w>.",
                                "it": "Scrivo sempre le mie lettere con una <w>penna a sfera</w> blu.",
                                "cs": "Své dopisy vždy píšu modrou <w>propiskou</w>.",
                                "tr": "Mektuplarımı her zaman mavi bir <w>tükenmez kalemle</w> yazarım.",
                                "es": "Siempre escribo mis cartas con un <w>bolígrafo</w> azul.",
                                "zh": "我写信总是用一支蓝色的<w>圆珠笔</w>。"
                            }
