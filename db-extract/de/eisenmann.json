                ],
                "senses": [
                    {
                        "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                        "entry_id": "946cb28f-9d63-3657-b37d-32ff5c93264f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0abe13e0-b696-4133-a8d9-c201fcef2417",
                                "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                                "text": "Frau Eisenmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8253441b-0193-4099-bd03-2fba9b5875f3",
                                "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                                "text": "Herr Eisenmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5ba36a60-b868-44b1-8e0b-982371a5fd80",
                                "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                                "text": "Die Eisenmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8171e761-db17-4a8b-89ec-334965ea12ba",
                                "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                                "text": "Der Eisenmann trägt nie die Schals, die die Eisenmann ihm strickt."
                            },
                            {
                                "example_id": "0938355d-06e9-4372-bb2f-10af3a4f207a",
                                "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eisenmann kommt, geht der Herr Eisenmann.“"
                            },
                            {
                                "example_id": "39fded00-afe3-4a07-aef7-7eb521506339",
                                "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                                "text": "Eisenmann kommt und geht."
                            },
                            {
                                "example_id": "0de16167-66eb-4768-b889-024c6ea2a69b",
                                "sense_id": "480ef569-393d-34d4-9b01-8ec0f1d0c562",
                                "text": "Eisenmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
