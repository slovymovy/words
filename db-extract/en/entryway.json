                                "target_senses": [
                                    {
                                        "sense_id": "ea46f4fa-da57-3d8c-b97a-4e9c1763ff5a",
                                        "entry_id": "99363193-b9b2-3a00-a07a-fe6392751265",
                                        "glosses": [
                                            "kleiner Vorraum eines Gebäudes, der hinter der Haustür beginnt und mit einer weiteren Tür vom restlichen Innenraum abgetrennt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35a2eb68-eb71-4e35-be52-f11931ef756e",
                                                "sense_id": "ea46f4fa-da57-3d8c-b97a-4e9c1763ff5a",
                                                "text": "„Ihre Zigarettenstummel liegen im Windfang, auf der Kellertreppe und auf den Gartenbeeten.“"
                                            },
                                            {
                                                "example_id": "4f713d99-5caa-460f-bfb9-bade1e82b5cf",
                                                "sense_id": "ea46f4fa-da57-3d8c-b97a-4e9c1763ff5a",
                                                "text": "„Das Gesetz- und Gerichtshaus, Islands Gerichtshaus stand vor dem Zusammensturz, die Sodetorfwände da und dort umgefallen, das Holzwerk verfault, die Windfänge zerbrochen, alles Gebälk schief, die Türen aus ihren Angeln, Löcher im Fußboden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da133a90-0dee-3130-8ae9-afa97a4c0671",
                                        "entry_id": "99363193-b9b2-3a00-a07a-fe6392751265",
                                        "glosses": [
                                            "bei Fenstern oder Türen angebrachter Vorbau zum Schutz vor kalter Luft, die von außen eindringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0ee382-bfd4-4ddf-ba17-f91b711e12d8",
                                                "sense_id": "da133a90-0dee-3130-8ae9-afa97a4c0671",
                                                "text": "„Das Gesetz- und Gerichtshaus, Islands Gerichtshaus stand vor dem Zusammensturz, die Sodetorfwände da und dort umgefallen, das Holzwerk verfault, die Windfänge zerbrochen, alles Gebälk schief, die Türen aus ihren Angeln, Löcher im Fußboden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "714c21d0-38a2-3f87-be7f-4603bf7f5e38",
