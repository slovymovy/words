                "senses": [
                    {
                        "sense_id": "84b4b672-7531-37a1-95ce-038770caa981",
                        "entry_id": "3aeb3f3e-3b9a-36ee-aced-bd0ec7c394ee",
                        "glosses": [
                            "eine zweifach ungesättigte Carbonsäure, die als Konservierungsmittel beziehungsweise Lebensmittelzusatzstoff verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "424d9cc9-6a20-4a3a-b2d5-95c6833f1d91",
                                "sense_id": "84b4b672-7531-37a1-95ce-038770caa981",
                                "text": "Die Sorbinsäure reagiert mit Alkoholen zu Estern."
                            },
                            {
                                "example_id": "bffc6e82-d3b3-451c-91e3-9bf98f448b42",
                                "sense_id": "84b4b672-7531-37a1-95ce-038770caa981",
                                "text": "„In der Natur ist eine Vorstufe der Sorbinsäure, die Parasorbinsäure, in Vogelbeeren enthalten. Die Vogelbeere Sorbus aucuparia war auch der Namensgeber der Sorbinsäure.“"
                            },
                            {
                                "example_id": "f8e969e3-d3b6-45d5-9728-2691a700c3e3",
                                "sense_id": "84b4b672-7531-37a1-95ce-038770caa981",
                                "text": "„Allerdings enthalten die Beeren Parasorbinsäure, die zu Magenproblemen führen kann. Durch Kochen wird die Parasorbinsäure zu Sorbinsäure abgebaut, die gut verträglich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
