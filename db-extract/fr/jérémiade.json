                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "566217cb-6313-3a66-9ec5-18d90f6a4cc8",
                                        "entry_id": "575d8a51-5a66-3e54-99c3-b6d0a64f3988",
                                        "glosses": [
                                            "Lamentación o muestra exagerada de dolor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0ec1ab-9c27-44bb-a081-688f1c56a9fc",
                                                "sense_id": "566217cb-6313-3a66-9ec5-18d90f6a4cc8",
                                                "text": "«Al menos tuvimos conocimientos de que los indios andaban muy debilitados por las lluvias, pues aunque estaban más acostumbrados que nosotros a ellas, aquel año lloraron los cielos la peor jeremiada de cuantas recordaban los viejos del lugar, tal vez con el propósito de apaciguar a los mortales»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
