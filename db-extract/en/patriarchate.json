                        "source_sense_id": "b2d5a179-d922-3dea-9f86-9e32bdded300",
                        "source_sense_description": "der Sitz eines kirchlichen Patriarchen; Patriarchat",
                        "target_lang_word": "Patriarchat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patriarchat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                        "entry_id": "6f2f7157-94b9-3123-bf28-40579ae391a5",
                                        "glosses": [
                                            "Gesellschaftsform, bei der die Männer die Vorherrschaft haben"
                                        ],
                                        "tags": [
                                            "Geschlecht n"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc945157-28f9-4750-a366-046133e65ca4",
                                                "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                                "text": "Das Patriarchat ist auch heute noch eine sehr verbreitete Gesellschaftsstruktur."
                                            },
                                            {
                                                "example_id": "3f2a6f8c-80ed-4678-8608-4a07b3056c2d",
                                                "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                                "text": "„Mit ihr ist das fahrlässige Weib in das fahrende Patriarchat der Herren eingebrochen und kreuzt mit seiner angestammten Rechthaberei und Hysterie die männliche Fahrbahn.“"
                                            },
                                            {
                                                "example_id": "60546641-d971-4a27-816c-6812fee6f502",
                                                "sense_id": "f51ee266-413c-3bc9-b2b5-f239d448d498",
                                                "text": "„Mit mir setzte sich Amalia hin und erklärte mir, dass wir in einem Patriarchat lebten und dass die Regeln für Männer und Frauen daher unfairerweise verschieden und vor allem stark zum Nachteil der Frauen, aber auch zum Nachteil vieler Männer beschaffen seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4794f57c-af25-32ba-af68-ce92405ce7e9",
                                        "entry_id": "6f2f7157-94b9-3123-bf28-40579ae391a5",
                                        "glosses": [
                                            "Amtsbereich eines kirchlichen Patriarchen"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
