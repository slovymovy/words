                ],
                "senses": [
                    {
                        "sense_id": "5098b0b5-d818-35be-abf3-91a64b872df4",
                        "entry_id": "5512f279-bf7f-3eb3-a6b2-218556a05147",
                        "glosses": [
                            "о дороге, улице и т.п.: имеющий глубокие колеи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feaaf3c4-743d-4880-94f3-23316a659da7",
                                "sense_id": "5098b0b5-d818-35be-abf3-91a64b872df4",
                                "text": "Дождь обращал в непроходную грязь колеистый разъезженный шлях."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73f3ac25-7a70-4fe7-acad-9c16a72fb561",
                        "source_entry_id": "5512f279-bf7f-3eb3-a6b2-218556a05147",
                        "source_sense_id": "5098b0b5-d818-35be-abf3-91a64b872df4",
                        "target_lang_word": "rutty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rutty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3d639ac-90fa-30bf-b554-339ef3d0d956",
                                        "entry_id": "76e8f700-0b13-30e2-9b53-9ef645eedbc1",
                                        "glosses": [
                                            "Imprinted with ruts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6435b74-cc46-4e31-b05d-bb7f6eaa835a",
                                                "sense_id": "b3d639ac-90fa-30bf-b554-339ef3d0d956",
                                                "text": "a rutty country road"
                                            },
                                            {
                                                "example_id": "ce077c5b-27f3-4754-b9b1-e0814c76ec44",
                                                "sense_id": "b3d639ac-90fa-30bf-b554-339ef3d0d956",
                                                "text": "But I’m oblig’d each day to roam\nMany a furlong from my home,\nAnd cry, good luck, whene’er I pick\nFrom off the ground a single stick;\nOr, in some long and rutty lane,\nI find by chance a single grain."
                                            },
                                            {
                                                "example_id": "fdcb609b-cda6-46c8-9f3e-51ef49a3c394",
                                                "sense_id": "b3d639ac-90fa-30bf-b554-339ef3d0d956",
                                                "text": "[…] old acquaintances separated by long rutty distances, or cooled acquaintances separated by misunderstandings concerning runaway calves […]"
                                            },
                                            {
                                                "example_id": "c454594e-3621-4d77-ad7c-d7ece126a30d",
                                                "sense_id": "b3d639ac-90fa-30bf-b554-339ef3d0d956",
                                                "text": "We drove way out to the desert the other side of town and turned on a rutty dirt road that made the car bounce as never before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c22b31-38a2-3641-8d5c-502293ee8420",
                                        "entry_id": "76e8f700-0b13-30e2-9b53-9ef645eedbc1",
                                        "glosses": [
                                            "In a rut (dull routine)."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69d4b2aa-5b5e-4a58-a0b7-853ffa2107ee",
                                                "sense_id": "21c22b31-38a2-3641-8d5c-502293ee8420",
                                                "text": "Constantly vary your way of doing things; avoid humdrum, rutty, and monotonous ways."
                                            },
                                            {
                                                "example_id": "71d12f3b-cd48-47bf-92a3-39682cb59a3a",
                                                "sense_id": "21c22b31-38a2-3641-8d5c-502293ee8420",
                                                "text": "Everywhere we see men who have gone to seed early, become rutty and uninteresting, because they worked too much and played too little."
                                            },
                                            {
                                                "example_id": "302ac87c-4d83-4365-bb11-b6dde744d456",
                                                "sense_id": "21c22b31-38a2-3641-8d5c-502293ee8420",
                                                "text": "We get lazy, then the church becomes rutty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c0924e-a422-3968-a934-146147c1aad7",
                                        "entry_id": "76e8f700-0b13-30e2-9b53-9ef645eedbc1",
                                        "glosses": [
                                            "Related to a rut; being in a state of sexual arousal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bfcd709-da5c-4a17-be7b-bca2adf01aff",
                                                "sense_id": "53c0924e-a422-3968-a934-146147c1aad7",
                                                "text": "I am lying here stifling in the rutty goat smell"
                                            },
                                            {
                                                "example_id": "f0ad1b05-be6f-442d-92c8-a67a61a4a244",
                                                "sense_id": "53c0924e-a422-3968-a934-146147c1aad7",
                                                "text": "You may even get picked up by a German soldier. They’re a rutty bunch now that they’re away from their fat frauleins and meeting some real French women."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rutty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b761d5b4-0054-3c94-9a3c-ff43cb5a458c",
                                        "entry_id": "906776a5-5aef-3140-abb2-cc30deb9205b",
                                        "glosses": [
                                            "Full of roots."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5107de88-02f1-4945-8ff3-77eb5f1f6acc",
                                                "sense_id": "b761d5b4-0054-3c94-9a3c-ff43cb5a458c",
                                                "text": "[…] the shoare of siluer streaming Themmes,\nWhose rutty Bancke, the which his Riuer hemmes,\nWas paynted all with variable flowers,"
                                            },
                                            {
                                                "example_id": "0cb4cef5-daa4-40cb-acba-41c6be09fbc7",
                                                "sense_id": "b761d5b4-0054-3c94-9a3c-ff43cb5a458c",
                                                "text": "[…] whistling reeds, that rutty Iordan laues,\nAnd with their verdure his white head embraues,\nTo chide the windes,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rutty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a339e8-307e-3b39-b57f-6783771310de",
                                        "entry_id": "4632b3e3-273c-3701-8fc8-776dfeae3498",
                                        "glosses": [
                                            "A unit of weight used for metals, precious stones and medicines, equivalent to 1+¹⁄₂ grains."
                                        ],
                                        "tags": [
                                            "India",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a128227-5286-4f64-b1b3-ac59687006b3",
                                                "sense_id": "b9a339e8-307e-3b39-b57f-6783771310de",
                                                "text": "[…] they immediately desired to capitulate, and sent him, by way of ransom, a perfect diamond weighing two hundred and twenty four ruttys […]"
                                            },
                                            {
                                                "example_id": "ef36377e-db3e-4dd1-b2f3-6d99eeb0a0c8",
                                                "sense_id": "b9a339e8-307e-3b39-b57f-6783771310de",
                                                "text": "1858, Henry Yule, Narrative of the Mission … to the Court of Ava, London: Smith, Elder, Appendix, “Note on Metals, Minerals, &c., of Burma,” p. 348,\n[Sapphires] of ten to fifteen rutties without a flaw are common, whereas a perfect ruby of that size is hardly ever seen."
                                            },
                                            {
                                                "example_id": "37edd762-6ee2-4234-a8d0-52c940d9d24f",
                                                "sense_id": "b9a339e8-307e-3b39-b57f-6783771310de",
                                                "text": "[…] vast numbers of infatuated wretches have accustomed themselves to consume from 6 rutties (9 grains) to a rupee’s weight (180 grains) of nearly pure opium daily […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
