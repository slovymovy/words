                                        "entry_id": "422c7c11-6442-3c6d-9ad0-3dc973c86aa2",
                                        "glosses": [
                                            "weibliche Person, die im Gottesdienst die Orgel spielt und/oder den Chor leitet"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77bd25d8-8505-482f-9f7a-2615db18db65",
                                                "sense_id": "fc94df42-cfc0-361c-9740-05610c0b0dfa",
                                                "text": "„Ein Großteil der im Gesangbuch aufgeführten Gesänge sind Wechselgesänge, d. h. solche, bei denen die Gemeinde mit einem Kantor oder einer Kantorin abwechselnd singt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
