                        "glosses": [
                            "Unkempt, shabby, or in a state of disrepair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4808eae-6b83-4800-8aa5-5f28c03a7562",
                                "sense_id": "a3fa8a54-661f-3ffe-a354-91739d47e79e",
                                "text": "He liked to wear an old ragtag coat that was so threadbare that he'd get sunburned through it."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fb470ef-72c9-3636-b293-6859a1b2088d",
                        "entry_id": "b4ee2456-4a6c-39c6-a186-fd948c43c4cf",
                        "glosses": [
                            "Very diverse; having irregular and dissimilar components."
