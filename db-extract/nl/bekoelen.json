                                    {
                                        "sense_id": "279920a9-7418-3e0a-a7ae-7c4b07cafe97",
                                        "entry_id": "ca8090fd-d8f5-3531-a0e4-29299fc27b6b",
                                        "glosses": [
                                            "To become cooler; to be reduced in temperature."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fecb748b-8d80-4822-bee1-501e4d2b1774",
                                                "sense_id": "279920a9-7418-3e0a-a7ae-7c4b07cafe97",
                                                "text": "You can drink the coffee when it's cooled down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030494fc-6c83-3120-a207-34104d73d38a",
                                        "entry_id": "ca8090fd-d8f5-3531-a0e4-29299fc27b6b",
                                        "glosses": [
                                            "To become less agitated or excited."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e796e49-bea8-4809-80eb-965052c456d8",
                                                "sense_id": "030494fc-6c83-3120-a207-34104d73d38a",
                                                "text": "I'd love to go to Israel, but I'll have to wait until the violence cools down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb297fb9-317a-3b28-b822-cc0935c65df5",
                                        "entry_id": "ca8090fd-d8f5-3531-a0e4-29299fc27b6b",
                                        "glosses": [
                                            "To decrease in degree or intensity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7649c776-26f2-432f-a4b6-1200e026d54c",
                                                "sense_id": "cb297fb9-317a-3b28-b822-cc0935c65df5",
                                                "text": "The increase in spending in the United States last month follows a revised 1.4 percent month-over-month gain in March, when prices for gasoline soared amid Russia’s invasion of Ukraine. Gas prices cooled down slightly in April but were still at elevated levels, while oil prices remain volatile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294438ec-b6f7-3f5a-8390-e15e049b4638",
                                        "entry_id": "ca8090fd-d8f5-3531-a0e4-29299fc27b6b",
                                        "glosses": [
                                            "To cause (something) to become cooler; to reduce the temperature of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1206cc3a-ec8b-45c4-a63e-09179eb14845",
                                                "sense_id": "294438ec-b6f7-3f5a-8390-e15e049b4638",
                                                "text": "We had to cool down the equipment with water before using it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "068328dc-2336-31d0-9a39-4b1f63d1aa37",
                                        "entry_id": "ca8090fd-d8f5-3531-a0e4-29299fc27b6b",
                                        "glosses": [
                                            "To cause (someone) to become less agitated or excited."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5479b933-126f-4670-b5cf-ca7f7ad2aac3",
                                                "sense_id": "068328dc-2336-31d0-9a39-4b1f63d1aa37",
                                                "text": "Dave was kicking and screaming, so I had to cool him down with some mellow music."
                                            },
                                            {
                                                "example_id": "8ecbafaa-a356-40fa-a207-b435b755a7ec",
                                                "sense_id": "068328dc-2336-31d0-9a39-4b1f63d1aa37",
                                                "text": "I'm oversexed. Write me and see if you can cool me down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
