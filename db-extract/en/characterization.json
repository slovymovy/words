    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4bc93003-e203-3651-9244-9438f873b2f6",
                "word": "characterization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7d37e353-cf88-43c7-a1d6-8729aacf7f77",
                        "entry_id": "4bc93003-e203-3651-9244-9438f873b2f6",
