                "senses": [
                    {
                        "sense_id": "41634049-0694-3c1c-996c-8c748a6884a0",
                        "entry_id": "916957dd-d173-374a-b2b8-1811dc12f454",
                        "glosses": [
                            "Pulvériser un insecticide, par extension, détruire les nuisibles, désinfecter."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "20c9713b-5a0d-4885-a9d7-38bb60ac772f",
                                "sense_id": "41634049-0694-3c1c-996c-8c748a6884a0",
                                "text": "— Citadine ! Tu ne sais pas que les mouches à l'automne quittent les champs pour se glisser dans les maisons mal défendues, où il fait bon hiverner derrière les meubles ? Si tu chauffes, la chaleur les réveille. Alors phase deux : tu rentres, tu flytoxes, tu ressors pour laisser agir. Après le dîner, phase trois : tu balaies, en faisant bien attention à ne pas trop écraser de mouches sous tes pieds."
                            },
                            {
                                "example_id": "0a21c299-196b-4d24-bcca-5e8d89d284a1",
                                "sense_id": "41634049-0694-3c1c-996c-8c748a6884a0",
                                "text": "On va quand même pas être obligé de la flytoxer !"
                            },
                            {
                                "example_id": "3253d66c-e5f4-403c-a875-26199e44e04c",
                                "sense_id": "41634049-0694-3c1c-996c-8c748a6884a0",
                                "text": "Une mouche flytoxée qui tombe du plafond"
                            },
                            {
                                "example_id": "db2d6881-67a7-4e7f-acf3-624752509fb8",
                                "sense_id": "41634049-0694-3c1c-996c-8c748a6884a0",
                                "text": "Ensuite il faudra bien flytoxer la vermine"
                            }
                        ]
                    }
                ],
