                ],
                "translations": [
                    {
                        "translation_id": "138ce6a9-a324-4f51-a7d7-ade4e452f7c6",
                        "source_entry_id": "531d47fb-006e-329f-8282-889054ae8d95",
                        "source_sense_id": "24215d37-cab1-3c6b-bec6-88dbdb15e759",
                        "target_lang_word": "fabricant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fabricant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                        "entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                                        "glosses": [
                                            "Industriel ou artisan qui fabrique ou qui fait fabriquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7fb0542-6f5f-494f-81d6-2a53fd42ca7a",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Si les fabricants vantent ses propriétés anxiolytiques, anti-inflammatoires, neuroprotectrices et antalgiques, l’association invite à en nuancer la fiabilité."
                                            },
                                            {
                                                "example_id": "1bca39d3-5f00-4c2a-acd1-99f34951da42",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Si l’Allemagne n’a point conquis encore la place qui devrait lui revenir dans le monde économique […], cela tient à ce que, pendant longtemps, ses fabricants crurent qu'il était habile d’inonder le marché avec de la camelote ; bien que la production allemande se soit fort améliorée depuis quelques années, elle ne jouit point encore d’une très haute considération."
                                            },
                                            {
                                                "example_id": "41b82e74-c6c3-4c77-ba5e-431dc79455ac",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Les docteurs du Talmud ne donnaient-ils pas eux-mêmes l'exemple en exerçant, pour assurer leur gagne-pain, les métiers les plus humbles, tels que forgerons, ou savetier, ou fabricant d'épingles, etc. ?"
                                            },
                                            {
                                                "example_id": "c5fc0ff8-2dd4-40b1-bb53-ed67da2edbd7",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Si j'étais fabricant de gilets en Kevlar, j'aurais peut-être envie de faire appel à un arachnologue, autrement dit à un spécialiste des araignées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
