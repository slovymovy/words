                "senses": [
                    {
                        "sense_id": "b111f709-ff07-3b36-9fb1-db3339343b53",
                        "entry_id": "bc3c303c-309e-3ad6-83ee-bd048f88bf27",
                        "glosses": [
                            "Démontrer la fausseté (d’un concept, d’une théorie, etc.)."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c4e0f8de-80d5-48bc-8a5f-669be3240f84",
                                "sense_id": "b111f709-ff07-3b36-9fb1-db3339343b53",
                                "text": "Scott Brando, l’éditeur du site UFO Of Interest, s’est d’ailleurs fait une spécialité de débunker ses vidéos."
                            },
                            {
                                "example_id": "c8779933-a072-4f6f-ac35-7dff1af3782f",
                                "sense_id": "b111f709-ff07-3b36-9fb1-db3339343b53",
                                "text": "Et puis en pleine guerre froide, les Russes auraient eu grand plaisirs de débunker les USA."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c78622f-0285-4f42-8188-920ad848735c",
                        "source_entry_id": "bc3c303c-309e-3ad6-83ee-bd048f88bf27",
                        "source_sense_id": "b111f709-ff07-3b36-9fb1-db3339343b53",
                        "target_lang_word": "debunk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                        "entry_id": "9d5702fc-e76c-3f8c-808a-1e8a4945f5d2",
                                        "glosses": [
                                            "To discredit, or expose to ridicule the falsehood or the exaggerated claims of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d2d86ef-4704-4a48-944d-8410eae10065",
                                                "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                                "text": "I am reading Nick Sousanis’ PhD dissertation-as-a-comic Unflattening. It debunks the primacy of word over image in Western culture and suggests that the two are equal partners in meaning-making."
                                            },
                                            {
                                                "example_id": "5a7c5226-fc91-4a73-9fcc-603838d6d1bb",
                                                "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                                "text": "The explosion story was thoroughly debunked on National Public Radio in November 1999."
                                            },
                                            {
                                                "example_id": "f738ac20-1ad1-4c0e-82cd-9aefb8409f74",
                                                "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                                "text": "debunk a theory"
                                            },
                                            {
                                                "example_id": "be61a89a-b597-407c-8cae-6a8068bd7d13",
                                                "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                                "text": "We began to debunk, with the aid of such Bowdlerisations of Freud as now trickled though, human motive, and learned to diagnose our mental discomforts as repressions and inhibitions—an accomplishment which gave me a good deal of relief."
                                            },
                                            {
                                                "example_id": "1b70a909-cf2c-411e-b129-6b86919eac56",
                                                "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                                "text": "This is what I mean by saying that the pseudoskeptics aren't actually skeptics in a genuine sense; they're believers in some other system, out to attack and debunk what they don't believe in while trying to appear open minded and scientific, even though they're not."
                                            },
                                            {
                                                "example_id": "aa104c0a-5247-484d-ad83-cbb21661f13b",
                                                "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                                "text": "For many of the Capitol rioters and others who believe Mr. Trump won, it was not a large leap to “Stop the Steal” from a pathway of conspiratorial steppingstones that included the “Pizzagate” claim of 2016 that Democrats were running a child sex ring in the back of a popular Washington pizza parlor, the debunked allegation that a low-level Democratic National Committee aide was murdered for leaking Hillary Clinton’s emails and many more."
                                            },
                                            {
                                                "example_id": "f4484ee1-119c-49ed-b296-520cb0a426f8",
                                                "sense_id": "a22d6ef9-4d89-3af4-b163-9584fa09dfb5",
                                                "text": "Another of my favourite themes has been debunking promises of new technology. Over the years, I have enjoyed watching the lack of progress on driverless cars, drone deliveries, hyperloop, and maglev."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f865442-c759-3528-bc1d-0878819409e1",
                                        "entry_id": "a94ac8e7-92ee-3ba8-aeb0-86ea9955645a",
                                        "glosses": [
                                            "A debunking; the act by which something is debunked."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
