                "senses": [
                    {
                        "sense_id": "fd7cd981-e73d-3712-b134-ce47225cc1a6",
                        "entry_id": "bfcb8f82-5011-3fae-ab64-c55a36f6b9fc",
                        "glosses": [
                            "kleurrijke los om de nek gebonden das"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ac07e2-22b9-4455-a64f-296eb262a3d8",
                                "sense_id": "fd7cd981-e73d-3712-b134-ce47225cc1a6",
                                "text": "Excentrieke wiskundige uit Esonne, vlakbij Parijs. Met zijn halflange haar en ouderwetse zijden strikdas is Villani een bekende persoonlijkheid. Hij won eerder de Fields-medaille, zeg maar de Nobelprijs voor de wiskunde. Nu schiet hij president Macron te hulp door zich kandidaat te stellen voor diens partij LREM."
                            },
                            {
                                "example_id": "4a7cb230-ce99-48f6-8a40-6c2f31a63f67",
                                "sense_id": "fd7cd981-e73d-3712-b134-ce47225cc1a6",
                                "text": "Voorbij waren de bejubelde televisie-lezingen waarin hij de gevestigde opvattingen over het verleden (en als het zo uitkwam het heden) wegveegde met een provocerende tirade, de strikdas als propellor van zijn spotzucht."
                            },
                            {
                                "example_id": "756714a1-efe3-444d-8b1f-c8d63735e28d",
                                "sense_id": "fd7cd981-e73d-3712-b134-ce47225cc1a6",
                                "text": "Volgens traditie hangt de gravure in het poortgebouw altijd scheef en mogen alleen de oudste cadetten van een bepaalde trap gebruik maken. In de eetzaal worden de officieren in opleiding bediend door obers met strikdas en zwart vest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
