                ],
                "senses": [
                    {
                        "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                        "entry_id": "1c46bf64-0e90-370e-8eb1-91bda078ac20",
                        "glosses": [
                            "Meerenge zwischen der Insel Fehmarn und dem schleswig-holsteinischen Festland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f69f3a-0a1b-4411-a6a6-6f7c47f5ebd7",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Die Brücke überspannt den zirka 1300 m breiten Fehmarnsund, der durch die beidseitigen, insgesamt 337 m langen Rampen auf 963 m eingeengt wird.“"
                            },
                            {
                                "example_id": "3622baaa-9966-4095-a884-fd28eeecfe38",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Bereits ab 1940, nach der Besetzung Dänemarks im Zweiten Weltkrieg, wurden im Auftrag des Hamburger Gauleiters Kaufmann von dem Architekten Heinrich Bartmann Pläne erarbeitet, sowohl den Fehmarnsund als auch den Fehmarnbelt mit Brücken für Eisenbahn und Autobahn zu überqueren.“"
                            },
                            {
                                "example_id": "8b400974-66a6-415e-a67b-f60a00a67c76",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "[Schlagzeile:] „Zusätzlich zur alten Brücke – Fehmarnsund bekommt neuen Tunnel“"
                            },
                            {
                                "example_id": "7ffb98a3-12ed-40f1-a7c5-74d1458d03ed",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Der Tunnel nach Dänemark muss vorbereitet werden: die Bundesstraße über die Insel wird vierspurig ausgebaut und auch über den Fehmarnsund muss ein neuer Tunnel hinüber zum deutschen Festland gebohrt werden, um die alte Fehmarnsundbrücke zu entlasten.“"
                            },
                            {
                                "example_id": "fc007db3-2f9d-4d3f-bb55-67a5f675fcdc",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Im 2. Quartal 2021 begannen im Fehmarnsund die Arbeiten zur Erkundung des Baugrundes.“"
                            },
                            {
                                "example_id": "78916464-ac85-4de9-b4d2-222dbb106515",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "[2029] „soll nicht nur die feste Fehmarnbeltquerung nach Dänemark fertiggestellt sein, sondern auch der Tunnel durch den schmalen Fehmarnsund zwischen dem Festland und der Insel.“"
                            },
                            {
                                "example_id": "e2c28546-2543-4227-8772-0f84f4ce343e",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Auch die neue Kostenangabe enthält aber weder einen Ersatz für die marode Brücke über den Fehmarnsund noch Lärmschutzmaßnahmen entlang der Strecke.“"
                            },
                            {
                                "example_id": "94ee29d7-dbe9-4229-9b9a-273df72ba9ed",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Alande finden sich aufgrund des nur leichten Salzwasseranteils sehr häufig in der Küstenzone der Ostsee (Wismarbucht, schwedische Schären, um die Insel Åland und am Fehmarnsund).“ [Anmerkung: 'Aland' ist eine Fischart]"
                            },
                            {
                                "example_id": "21bb5a16-8827-424f-8ee3-7b6d3a8523d3",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Dafür genießen die Oltmanns tagsüber einen Traumblick auf den Fehmarnsund.“"
                            },
                            {
                                "example_id": "d8bf0c32-72b5-4381-9109-8432abe77f06",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "„Unsere Segel-Route läuft ab Neustadt durch den Fehmarnsund, gen Norden durch den großen Belt, das Kattegat zum Limfjord (Dänemark).“"
                            },
                            {
                                "example_id": "b2f3e9c0-16f7-40e2-a6fc-6d46c7bf80d1",
                                "sense_id": "05f5a41d-404f-38b3-b3f8-5d62b26dc8b8",
                                "text": "[Wetterbericht für Schleswig-Holstein vom 16.2.2022:] „Am Mittwoch gibt es anfangs neben einzelnen Schauern auch trockene Phasen, aber kaum Sonne. Rasch jedoch von der Nordsee her erneut dichte Wolken mit Regenfällen. Höchstwerte 8 Grad am Fehmarnsund bis 11 Grad in Wentorf bei Hamburg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
