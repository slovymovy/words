                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c866ea1-73f5-3f30-a8c7-d6c904b36b1d",
                    "sense_definition": "The action, sound, or motion of something that bubbles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentle <w>bubbling</w> of the brook was the only sound in the quiet forest.",
                            "target_lang_translations": {
                                "ru": "Тихое <w>журчание</w> ручья было единственным звуком в безмолвном лесу."
                            }
                        },
                        {
                            "text": "We listened to the soft <w>bubbling</w> of the soup as it simmered on the stove.",
                            "target_lang_translations": {
                                "ru": "Мы слушали тихое <w>клокотание</w> супа, пока он томился на плите."
                            }
                        }
                    ],
                    "synonyms": [
                        "gurgling",
                        "effervescence"
                    ],
                    "common_phrases": [
                        "gentle bubbling"
                    ],
                    "target_lang_definitions": {
