        "fr-extract.jsonl": [
            {
                "entry_id": "c634a820-f5a2-3604-8815-81ce1a1dd784",
                "word": "halde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a0cb5d42-768a-48aa-860a-f157b902813c",
                        "entry_id": "c634a820-f5a2-3604-8815-81ce1a1dd784",
                        "tags": [
                            "plural"
                        ],
                        "form": "haldes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bb662dd-0a97-3fc7-a864-d02ae810eee8",
                        "entry_id": "c634a820-f5a2-3604-8815-81ce1a1dd784",
                        "glosses": [
                            "Amoncellement formé dans une mine par les déchets et stériles issus de l’extraction du minerai."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc31a03-db0c-4975-a0bf-27affd4d75c0",
                                "sense_id": "5bb662dd-0a97-3fc7-a864-d02ae810eee8",
                                "text": "Un échantillon recueilli sur l’ancienne halde d’une des mines présente peu de galène englobée dans du quartz ferrugineux."
                            },
                            {
                                "example_id": "42b27159-c990-47ea-841b-532fb06013ca",
                                "sense_id": "5bb662dd-0a97-3fc7-a864-d02ae810eee8",
                                "text": "Comme elle a cotoyé les fossiles de Roger Blais, l'équipe du MPE est familière à l'argilite et peut plus facilement l'identifier parmi les immenses haldes de matériel excavé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f98d3d-a9d0-49fc-967e-033d5af522a4",
                        "source_entry_id": "c634a820-f5a2-3604-8815-81ce1a1dd784",
                        "source_sense_id": "5bb662dd-0a97-3fc7-a864-d02ae810eee8",
                        "target_lang_word": "Abraumhalde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abraumhalde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e10e096a-e6b3-384a-a5e5-10cdac570bda",
                                        "entry_id": "68bb0c6a-6c7b-3c08-85b1-0db87445af0a",
                                        "glosses": [
                                            "künstliche Aufschüttung (Halde) aus das Nutzmineral überdeckenden abgebauten Gesteinsschichten (Abraum) im Tagebau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41548a7-367b-42f7-95de-6ce21db77ee1",
                                                "sense_id": "e10e096a-e6b3-384a-a5e5-10cdac570bda",
                                                "text": "„So ist aus der weiß-grauen Abraumhalde in den letzten Jahren ein grüner Berg entstanden, der sich wesentlich besser in die Landschaft einpasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74621781-1876-4a1c-b215-d5a739e45385",
                        "source_entry_id": "c634a820-f5a2-3604-8815-81ce1a1dd784",
                        "source_sense_id": "5bb662dd-0a97-3fc7-a864-d02ae810eee8",
                        "target_lang_word": "Halde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1668a6d-cad5-3953-84ad-374c71cda31a",
                                        "entry_id": "aec2a701-63f6-3145-b979-a09fd85b0289",
                                        "glosses": [
                                            "künstliche, vom Menschen geschaffene Erhebung, Aufschüttung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c87b5d3-b9ea-404b-811a-ff53f3f17eef",
                                                "sense_id": "b1668a6d-cad5-3953-84ad-374c71cda31a",
                                                "text": "Die Halde muss endlich abgetragen werden."
                                            },
                                            {
                                                "example_id": "5920ba48-0722-412d-8746-503717a60762",
                                                "sense_id": "b1668a6d-cad5-3953-84ad-374c71cda31a",
                                                "text": "„Die Halde hinten am Strand, wo die gesprengten Gesteinsmassen abgelagert worden waren, verschwand als Erstes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f48deb09-88e5-3737-9239-ffc92ae5d435",
                                        "entry_id": "aec2a701-63f6-3145-b979-a09fd85b0289",
                                        "glosses": [
                                            "Abhang oder Seite eines Berges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e501423-a060-4f82-8ad7-42e2d6814101",
                                                "sense_id": "f48deb09-88e5-3737-9239-ffc92ae5d435",
                                                "text": "Warum baust du dein Haus nicht an der Halde? Du hättest einen schönen Blick aufs Tal."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
