                        "examples": [
                            {
                                "example_id": "f04e1d36-d474-4388-aeb9-a2bd6cb931d5",
                                "sense_id": "341ec12a-0d08-3d6b-adf3-21d5458630d7",
                                "text": "\"As for Little John, he lay abed, snoring lustily, till the sun was high in the heavens.\"",
                                "translation": "\"Little John seinerseits lag im Bett, laut schnarchend, bis die Sonne hoch am Himmel stand.\""
                            },
                            {
                                "example_id": "cb141813-c4d7-4b59-9719-3cd71ebd61d2",
                                "sense_id": "341ec12a-0d08-3d6b-adf3-21d5458630d7",
                                "text": "\"However, I could imagine myself killing Brown; there was no law against that; and that was the thing I used always to do the moment I was abed.\"",
                                "translation": "\"Jedoch könnte ich mir vorstellen Brown zu töten, da gab es kein Gesetz dagegen, und dies war diese Sache die ich immer in diesem Moment tat, wenn ich im Bett träumte.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
