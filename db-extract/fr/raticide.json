                                    {
                                        "sense_id": "509dcb21-a885-3919-a378-b413c253e89b",
                                        "entry_id": "d58f2e43-04c6-34ed-aa5f-5caff7b9cc06",
                                        "glosses": [
                                            "Gift zur Bekämpfung von Ratten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f115b16-8f1b-4e19-ab29-bc5d2f91fff0",
                                                "sense_id": "509dcb21-a885-3919-a378-b413c253e89b",
                                                "text": "Das neue Rattengift hatte eine tödliche Wirkung."
                                            },
                                            {
                                                "example_id": "e8531c34-a7ce-4700-99af-0c7f6196fac2",
                                                "sense_id": "509dcb21-a885-3919-a378-b413c253e89b",
                                                "text": "„Er verstand genug von Chemie, um zu erkennen, daß es Rattengift war.“"
                                            }
