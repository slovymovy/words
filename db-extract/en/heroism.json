                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heldentum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90965a2b-b704-3fb8-ad8f-e7e6ab5c4bdf",
                                        "entry_id": "c690870d-9720-3935-9603-ca0423e9fa17",
                                        "glosses": [
                                            "Einstellung/Tat, die zeigt, dass jemand Risiken für sich selbst eingeht, um eine gute Tat zu tun; sehr mutiges Auftreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a26d3ce-85c4-43f4-bd3b-f73aacc02039",
                                                "sense_id": "90965a2b-b704-3fb8-ad8f-e7e6ab5c4bdf",
                                                "text": "„Dem haftet etwas Rebellisches an, ein Hauch von Heldentum.“"
                                            },
                                            {
                                                "example_id": "cd3c9f8c-4345-41bc-b6c4-45582848e39e",
                                                "sense_id": "90965a2b-b704-3fb8-ad8f-e7e6ab5c4bdf",
                                                "text": "„Heute, nach zwei Weltkriegen, ist die Begeisterung für deutsches Heldentum verflogen.“"
                                            },
                                            {
                                                "example_id": "d7496d8d-a45c-40bf-bd36-dd42593f8bdc",
                                                "sense_id": "90965a2b-b704-3fb8-ad8f-e7e6ab5c4bdf",
                                                "text": "„Alles ist in ein freundliches Licht getaucht, der Ritter ist von mildem Heldentum, dass die Aufgaben, die ihm gestellt werden, von großer Albernheit sind, wird übergangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
