                ],
                "senses": [
                    {
                        "sense_id": "dee2deae-4055-3559-8a47-c6acf10321f8",
                        "entry_id": "86451703-7d03-35b5-ae52-1694d32cb5b6",
                        "glosses": [
                            "geistig-seelische Problemlage, die nach einer Sinnfindung verlangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e98670-cb11-4560-89c0-a72f8b53aeea",
                                "sense_id": "dee2deae-4055-3559-8a47-c6acf10321f8",
                                "text": "„Eine Sinnkrise im Alltag oder Berufsleben kann für den dynamischen Menschen und Sinnsucher ein fruchtbarer Moment, ein Auslöser sein, auf Entdeckungsreise nach Alternativen zu gehen.“"
                            },
                            {
                                "example_id": "f7a9a716-6603-43b0-85f2-644ed7946c69",
                                "sense_id": "dee2deae-4055-3559-8a47-c6acf10321f8",
                                "text": "„Für eine Midlife-Crisis bin ich entschieden zu alt. Wahrscheinlich ist es eine allgemeine Sinnkrise, die mich beutelt. Ich liege in meinem schönen Hotelzimmer, schaue hinaus auf den Leuchtturm und frage mich: Was soll das alles?“"
                            },
                            {
                                "example_id": "a33b81b2-36d3-45d4-b51c-242dc6ccf046",
                                "sense_id": "dee2deae-4055-3559-8a47-c6acf10321f8",
                                "text": "„Kam die so genannte Generation X Anfang der Neunziger ihrer Sinnkrise noch mit ein paar Joints und etwas Grunge-Rock bei, müssen heute stärkere Mittel aufgefahren werden.“"
                            },
                            {
                                "example_id": "ce1ada99-7051-45f3-9dee-2f9457d1f99e",
                                "sense_id": "dee2deae-4055-3559-8a47-c6acf10321f8",
                                "text": "„Sie spricht von einer Sinnkrise, die ebenso problematisch sei wie die Wirtschaftskrise.“"
                            },
                            {
                                "example_id": "be16e49d-dc98-4e2e-868c-3448c1149ae8",
                                "sense_id": "dee2deae-4055-3559-8a47-c6acf10321f8",
                                "text": "„Zäh verlief indes das vergangene Jahr, als er sich nach 14 Jahren von seiner Trainerin Ute Schinkitz trennte und die Sinnkrise in allen Facetten durchlebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
