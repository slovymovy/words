                    {
                        "sense_id": "2effcf54-99c5-31f6-a622-5e103d00078b",
                        "entry_id": "5731f830-ad4d-31f5-9443-93cd2ca68d85",
                        "glosses": [
                            "Soaked or dirtied by urine."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c127b90d-b539-4b16-b5b5-9f6188ec28d9",
                                "sense_id": "2effcf54-99c5-31f6-a622-5e103d00078b",
                                "text": "David's father immediately threw his baby's pissy clothes into the wash."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bdadd4f-c035-3b95-8d76-ae84ac40caaa",
                        "entry_id": "5731f830-ad4d-31f5-9443-93cd2ca68d85",
                        "glosses": [
                            "Resembling or smelling like urine."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "3757124d-24a8-4851-ab1c-acd5b030a7aa",
                                "sense_id": "8bdadd4f-c035-3b95-8d76-ae84ac40caaa",
                                "text": "Dan Valentine works as a bartender in a pissy and discreet Boston Village gay bar called \"Bonaparte's\"."
                            },
                            {
                                "example_id": "20b96492-7efb-45fd-84ca-5dd082839d06",
                                "sense_id": "8bdadd4f-c035-3b95-8d76-ae84ac40caaa",
                                "text": "I admit the car still has a pissy smell from what happened last year."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd8678e0-ffc6-3bce-b80d-04ba156e23b7",
                        "entry_id": "5731f830-ad4d-31f5-9443-93cd2ca68d85",
                        "glosses": [
                            "Resembling or smelling like urine.",
                            "Weak and drizzly."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "037242d3-6192-4e2f-b6cf-3de553b36b97",
                                "sense_id": "fd8678e0-ffc6-3bce-b80d-04ba156e23b7",
                                "text": "I wish these pissy rain showers would either build up into a storm or go away."
                            }
                        ]
                    },
                    {
                        "sense_id": "89830781-e34e-3fbc-9689-7e3670539385",
                        "entry_id": "5731f830-ad4d-31f5-9443-93cd2ca68d85",
                        "glosses": [
                            "Anal retentive, whinging and pernickety."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "bfcf65df-4db7-48cb-85ae-7b9ceeb24859",
                                "sense_id": "89830781-e34e-3fbc-9689-7e3670539385",
                                "text": "Stop being pissy: you knew what I meant when I said \"Don't touch the dial\", but you prodded the dial with a fork."
                            }
                        ]
