                        "glosses": [
                            "A virus that specifically infects bacteria."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0210e397-d7f7-4480-aa38-be9ca9de8eed",
                                "sense_id": "2c0158bd-d604-38a3-977c-dfff7ba9a10f",
                                "text": "Another possibility is to enlist a bacteriophage, a kind of virus, to hunt down and kill harmful bacteria for us."
                            }
                        ]
                    }
                ],
