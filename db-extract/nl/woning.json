                    },
                    {
                        "form_id": "de250a87-f0cb-4e9d-81c0-2d44b42c33e7",
                        "entry_id": "595f4882-144a-3744-8582-f2436c425fac",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "woninkjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68efe89d-6030-32c6-b36e-3e0992c766f5",
                        "entry_id": "595f4882-144a-3744-8582-f2436c425fac",
                        "glosses": [
                            "een doorgaans afgesloten constructie waarin men kan leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5324678c-7fa7-491b-b38c-168ac1e9a82f",
                                "sense_id": "68efe89d-6030-32c6-b36e-3e0992c766f5",
                                "text": "In het flatgebouw waren 20 woningen gereed voor bewoning."
                            },
                            {
                                "example_id": "ab347400-fd81-4380-9c04-1966229b5443",
                                "sense_id": "68efe89d-6030-32c6-b36e-3e0992c766f5",
                                "text": "Tegelijkertijd kennen de dagelijkse zorgen van mensen over werk, wijk en woning geen pauzeknop."
                            },
                            {
                                "example_id": "3a5eb695-5b94-4880-919a-621c3f783d29",
                                "sense_id": "68efe89d-6030-32c6-b36e-3e0992c766f5",
                                "text": "Het voorarrest van de 24-jarige man die drie mensen zou hebben doodgeschoten in het Rotterdamse stadsdeel IJsselmonde is met twee weken verlengd. Sendric S. werd op 2 januari opgepakt in een woning in het stadsdeel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ae91547-97c3-4713-acab-2818b7f6d12f",
                        "source_entry_id": "595f4882-144a-3744-8582-f2436c425fac",
                        "source_sense_id": "68efe89d-6030-32c6-b36e-3e0992c766f5",
                        "source_sense_description": "een doorgaans afgesloten constructie waarin men kan leven",
                        "target_lang_word": "Wohnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                        "entry_id": "e7bf0e44-a9f1-39e8-ae0b-29575265baaf",
                                        "glosses": [
                                            "ein Raum oder mehrere Räume, die innerhalb eines Hauses einen abgeschlossenen Bereich bilden und für einen ein- oder mehrköpfigen Haushalt zum Wohnen dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad4b09a-f5c1-4e5e-8de2-4a994e3e4f9f",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "Nach 18 Jahren Hotel Mama habe ich nun endlich eine eigene Wohnung."
                                            },
                                            {
                                                "example_id": "49b3feca-d391-4b41-8d09-aa060fb6a491",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "„Die Wohnung war sehr hell und schön, zunächst gab es eine große Diele und daneben drei größere Zimmer.“"
                                            },
                                            {
                                                "example_id": "0a4b71ae-c29e-475e-98f6-c59a1e4146f9",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "„Und nun war er wieder daheim in seiner Wohnung.“"
                                            },
                                            {
                                                "example_id": "c6f71072-d0df-4d6e-8c20-94766a984b6b",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "„Er erkämpft aber beim Provinzgouverneur bessere Wohnungen für die Évolués in Stanleyville.“"
                                            },
                                            {
                                                "example_id": "e26cec86-4d0c-4e17-ad46-b5686218637f",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "„Wir fahren zu ihrer Wohnung zurück.“"
                                            },
                                            {
                                                "example_id": "2d6aba22-ede7-41c7-8c96-c61b62809eba",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "„Ob Studierende oder Senioren, Familien mit Kindern und geringem Einkommen - viele von ihnen benötigen bezahlbare Wohnungen.“"
                                            },
                                            {
                                                "example_id": "6cc3d0ea-dc0d-4ef5-a308-6cb882289fdb",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "übertragen: „Eine Wohnung im Himmel erwartet dich, wenn du stirbst.“"
                                            },
                                            {
                                                "example_id": "01732fd9-fa9d-4105-b1fb-f9d09e5c3ecf",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "übertragen: „Salomos Weihegebet begründet diesen liturgischen Brauch, indem es die besondere, nur hier gegebene einzigartige Zuordnung des einzigen Hauses Gottes auf Erden, desjenigen von Jerusalem, zu seiner Wohnung im Himmel hervorhebt.“"
                                            },
                                            {
                                                "example_id": "eba3638c-4c56-4ad6-a858-1acb27258185",
                                                "sense_id": "de627a48-20bf-3440-a7c1-1fe3476ad9a3",
                                                "text": "übertragen: „Nun hatte aber in der Nähe der Wohnung des Hasen ein alter Dachs seinen Bau; das war ein alter Hagestolz, ein griesgrämiger Kerl und ein Geizhals dazu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "672fca7b-041e-4d95-b628-5ae16b66e0b6",
                        "source_entry_id": "595f4882-144a-3744-8582-f2436c425fac",
