                {
                    "sense_id": "4526587b-dd10-33e6-9232-3148f6d49b52",
                    "sense_definition": "Een bloem van het plantengeslacht Lilium, vaak met grote, trompetvormige bloembladen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bloemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de tuin staat een prachtige witte <w>lelie</w> die heerlijk ruikt.",
                            "target_lang_translations": {
                                "en": "In the garden stands a beautiful white <w>lily</w> that smells wonderful."
                            }
                        },
                        {
                            "text": "Zij kocht een <w>lelie</w> in pot om haar woonkamer op te fleuren.",
                            "target_lang_translations": {
                                "en": "She bought a potted <w>lily</w> to brighten up her living room."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witte lelie",
                        "lelie in pot"
                    ],
                    "target_lang_definitions": {
                        "en": "A flower of the plant genus Lilium, often with large, trumpet-shaped petals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lily",
                                "target_lang_sense_clarification": "the flower"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6adf81d-324d-327e-9acb-05b06b94916a",
                    "sense_definition": "Een gestileerd heraldisch symbool, ook wel bekend als de fleur-de-lis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "symbolen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het wapenschild van de koninklijke familie is versierd met een gouden <w>lelie</w>.",
                            "target_lang_translations": {
                                "en": "The royal family's coat of arms is decorated with a golden <w>fleur-de-lis</w>."
                            }
                        },
                        {
                            "text": "De Franse <w>lelie</w> is een bekend symbool in de geschiedenis van de heraldiek.",
                            "target_lang_translations": {
                                "en": "The French <w>lily</w> is a well-known symbol in the history of heraldry."
                            }
