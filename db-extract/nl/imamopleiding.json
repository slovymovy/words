                        "examples": [
                            {
                                "example_id": "b5a28c98-c883-4357-b430-81bed5f0cdbb",
                                "sense_id": "97e5042e-fbf5-3451-974d-0906a9fc06bd",
                                "text": "Drie jaar geleden stopte Inholland met de imamopleiding, de enige praktische opleiding in Nederland die er was. Minister Bussemaker wil dat de opleiding weer terugkomt om meer in Nederland geschoolde imams in de moskeeën te krijgen, ofwel 'polderimams'. Ze hoopt dat zij radicalisering onder moskeebezoekers tegengaan."
                            },
                            {
                                "example_id": "b54beb03-9e8b-4570-a753-f2cb2e8ca59d",
                                "sense_id": "97e5042e-fbf5-3451-974d-0906a9fc06bd",
                                "text": "Bussemaker wil geschrapte imamopleiding nieuw leven inblazen: De opleiding tot geestelijk verzorger en imam moet opnieuw van start. Minister Bussemaker heeft er bij de hogescholen Windesheim, Inholland en de Vrije Universiteit op aangedrongen dat zij om de tafel gaan om de HBO- opleiding opnieuw op te zetten."
                            }
                        ]
                    }
