                    {
                        "sense_id": "c26cc060-d5db-33ad-9b6c-f217694496ea",
                        "entry_id": "adef18ae-ca05-3263-a45a-a2f45e454c4d",
                        "glosses": [
                            "Samen oder Früchte habend, die reich an Proteinen sind; eiweißreich"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf4eb324-dbc8-4e4f-bf79-2c214f5cb2fa",
                        "source_entry_id": "adef18ae-ca05-3263-a45a-a2f45e454c4d",
                        "source_sense_id": "c26cc060-d5db-33ad-9b6c-f217694496ea",
                        "source_sense_description": "Botanik: Samen oder Früchte habend, die reich an Proteinen sind; eiweißreich",
                        "target_lang_word": "eiweißreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eiweißreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                        "entry_id": "d30d69e3-bb9e-3ab6-9e21-05d3b4dc9f3c",
                                        "glosses": [
                                            "erhebliche Mengen des Nährstoffs Eiweiß enthaltend oder zu sich nehmend; reich an Eiweiß"
                                        ],
                                        "tags": [
                                            "Ernährung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc428cb4-6839-439f-8b28-fd1a0159761d",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„[…] das ungefilterte Bier aus den eiweißreichen Getreidesorten schmeckt nicht nur, sondern trägt auch noch zu einer gesunden Umwelt bei.“"
                                            },
                                            {
                                                "example_id": "8a588f67-cf53-4d91-8a45-b4080b3f7d6e",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "Nüsse sind eiweißreich."
                                            },
                                            {
                                                "example_id": "b67e2c5b-a56f-4ba1-a119-7a35cfbd4977",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Linsen sind sehr eiweißreich: Teilweise enthalten sie sogar mehr Eiweiß als Lebensmittel tierischer Herkunft.“"
                                            },
                                            {
                                                "example_id": "0ecf5dc1-8d82-4ab2-8c51-801b66693891",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Amarant ist sehr eiweißreich und enthält zudem relativ viel Eisen sowie ungesättigte Fettsäuren.“"
                                            },
                                            {
                                                "example_id": "e7a3c024-0518-4476-8487-3613f3649153",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Das Fleisch der Dorade ist fest, mager und sehr schmackhaft, außerdem ist es sehr eiweißreich und enthält viele wichtige Mineralstoffe wie Kalzium, Phosphor und Magnesium.“"
                                            },
                                            {
                                                "example_id": "cd9dbfd6-0eea-4009-affc-dc9b3c6bc5d4",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "Ganz grundsätzlich ist das eine eiweißreiche und kohlenhydratarme Diät."
                                            },
                                            {
                                                "example_id": "e0248da2-41b4-4860-8ece-b48128e7c8cb",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„[Krabbenbrötchen sind ein] gesunder, eiweißreicher Power-Snack, der weder schwer im Magen liegt, noch sich hinterhältig auf den Hüften absetzt.“"
                                            },
                                            {
                                                "example_id": "7f756d1b-1dc7-4c8d-bcbc-0aa4c767a515",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "[Maya-Nüsse:] „Die eiweißreiche Frucht wird gesammelt, geröstet und zu Keksen oder Milchshakes verarbeitet und dann verkauft.“"
                                            },
                                            {
                                                "example_id": "be2d7cb7-7859-4a16-bbbe-70505faec340",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Besonders eiweißreiche Ersatzmehle sind gut geeignet, um für eine Low-Carb-Ernährung den Weizen zu ersetzen.“"
                                            },
                                            {
                                                "example_id": "e98ce82f-9055-4c36-ab17-18aa121930d7",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Viele Studien weltweit bestätigen, dass beispielsweise Kinder, die eine eiweißreiche Kost mit viel Milch zu sich nehmen, später im Leben größer sind als Kinder, die wenig Milch bekommen, betont Elio Riboli vom Imperial College London.“"
                                            },
                                            {
                                                "example_id": "ab7f9f3e-4680-4bc4-9271-77b0dfc93d52",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Das Futter für Igel muss fetthaltig und eiweißreich sein.“"
                                            },
                                            {
                                                "example_id": "4289f650-672c-4478-94f3-47f4ec390e91",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Spitzmäuse finden unter Totholz Deckung, Schutz und eiweißreiche Nahrung in Form von Insekten.“"
                                            },
                                            {
                                                "example_id": "f0a1646e-bf0d-4262-bcf4-682c1568cb03",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Zuckmücken, Büschelmücken, Wiesenschnaken - es gibt unzählige Mückenarten in Deutschland, keine von ihnen saugt Blut. Einzig Stechmücken, und davon auch nur die Weibchen, versorgen sich mit eiweißreichen Blutmahlzeiten.“"
                                            },
                                            {
                                                "example_id": "58b95990-49fc-4fbb-bbd1-13b421eaa0ca",
                                                "sense_id": "bdc717dc-7871-3064-8769-4e60a1615cb3",
                                                "text": "„Das eiweißreiche Kraftfutter zur Tiermast importiert Deutschland aus ursprünglich tropischen Regenwäldern und Savannen, die wegen der hohen Nachfrage aus der Landwirtschaft zerstört wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
