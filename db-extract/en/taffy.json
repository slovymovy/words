                "senses": [
                    {
                        "sense_id": "a81af2a3-b8cc-30ed-b7ce-c7049c5f4318",
                        "entry_id": "cd1c0811-1c7e-3cac-a576-d04733543721",
                        "glosses": [
                            "A soft, chewy candy made from boiled sugar, molasses, or corn syrup and butter."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3c5d61c3-d8a7-3364-8ae3-d085eb8d0e8c",
                        "entry_id": "cd1c0811-1c7e-3cac-a576-d04733543721",
                        "glosses": [
                            "Flattery."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b8c8f13a-4379-4663-950d-ab3c7c438c35",
                                "sense_id": "3c5d61c3-d8a7-3364-8ae3-d085eb8d0e8c",
                                "text": "[…] if these statistices should seem to fail to tally with the facts, in places, do not nudge your neighbor, or press your foot upon his toes, or manifest, by any other sign, your awareness that taffy is being distributed."
                            },
                            {
                                "example_id": "799e1452-9873-4445-93dc-f7878eb4f84a",
                                "sense_id": "3c5d61c3-d8a7-3364-8ae3-d085eb8d0e8c",
                                "text": "Cut out the taffy. Who's your friend?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b53ff8d1-ecbe-312b-9d82-878dfd028560",
                        "entry_id": "cd1c0811-1c7e-3cac-a576-d04733543721",
                        "glosses": [
                            "Welsh person."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f8b2f7f-b362-44ef-b460-e708ce013e71",
                                "sense_id": "b53ff8d1-ecbe-312b-9d82-878dfd028560",
                                "text": "\"Some people may find Taffy a bit derogatory but a lot of people are interested in displaying that on their vehicles. That's a way they can express their Welshness. But we haven't sold any plates with combinations of 'boyo'.\""
                            }
                        ]
                    }
