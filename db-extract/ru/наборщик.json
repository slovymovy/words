                    {
                        "translation_id": "32662e4f-ff45-4b94-99fb-a85e4b6627d4",
                        "source_entry_id": "db167a30-3ca7-34c2-972a-2de7fc4debf8",
                        "source_sense_description": "рабочий типографии, занятый набором",
                        "target_lang_word": "Setzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Setzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                        "entry_id": "5f2a2652-1521-3ff3-ae9f-8a35c75a910f",
                                        "glosses": [
                                            "Druckwesen: Person, die einen vorgegebenen Text für den Druck vorbereitet, Kurzwort für Schriftsetzer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e15adb9a-77b9-4d39-9447-ceba9c835155",
                                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                                "text": "„Münzer hatte sich von einem Setzer, der nach Hause ging, das Blatt bringen lassen, um zu prüfen, ob alles in Ordnung sei.“"
                                            },
                                            {
                                                "example_id": "f7061d82-6299-4818-96a8-9526da9dafcb",
                                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                                "text": "„Stuff selbst hatte berichten müssen von dem Angriff auf Gareis, der auf einer Wiese explodierten Bombe, von dem vorläufig unaufgeklärten Überfall auf einen Setzer in der Redaktion der »Bauernschaft«, von den Bauernverhaftungen.“"
                                            },
                                            {
                                                "example_id": "1f2bbcf7-363f-496a-8a24-c2b89e90c612",
                                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                                "text": "„Dies ist leicht erklärlich, hatte der Setzer doch den Satzspiegel stets vor Augen, so dass Umbruchfehler nur bei grober Nachlässigkeit hätten vorkommen können.“"
                                            },
                                            {
                                                "example_id": "4542f8f8-e765-40d2-a017-17cc41949ade",
                                                "sense_id": "0566c35d-f856-362e-9db8-17d75282fbad",
                                                "text": "„Der Hintergrund war der, dass die Kollekte eines gesamten Monats auf Abwege geraten war, während sie sich in der Obhut des Setzers befand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b18658ab-3227-4889-bbfd-e42c93a64935",
                        "source_entry_id": "db167a30-3ca7-34c2-972a-2de7fc4debf8",
                        "source_sense_description": "рабочий типографии, занятый набором",
                        "target_lang_word": "compositeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
