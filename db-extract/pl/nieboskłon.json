                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skyline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fa06bc7-2811-3ad7-aff1-e7be97d6ea44",
                                        "entry_id": "89a4fb69-6100-36c6-9c1c-13adcf2be30d",
                                        "glosses": [
                                            "The line that seems to be the boundary of the sky and the ground; the horizon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75043e44-715e-3797-b0f1-78b2ce5afb00",
                                        "entry_id": "89a4fb69-6100-36c6-9c1c-13adcf2be30d",
                                        "glosses": [
                                            "The horizontal silhouette of a city or building against the sky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ef6ce19-1e52-4a1f-b093-715ee6c2973b",
                                                "sense_id": "75043e44-715e-3797-b0f1-78b2ce5afb00",
                                                "text": "Our arrival at Worcester is heralded by the appearance of the city's cathedral tower, a solid square structure that's dominated the skyline since the 12th century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b9c47d-d5a7-37cc-9d78-b18a7ddbe526",
                                        "entry_id": "89a4fb69-6100-36c6-9c1c-13adcf2be30d",
                                        "glosses": [
                                            "A path of movement, especially military movement, producing a silhouette above terrain features visible from the location of likely observers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c159c9e-73f0-32d3-92e1-614141c93f02",
                                        "entry_id": "89a4fb69-6100-36c6-9c1c-13adcf2be30d",
                                        "glosses": [
                                            "A panel on the front page of a newspaper outlining some of the features to be found inside."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66ff957a-c4a0-370f-9da8-d112af5a0d06",
                                        "entry_id": "89a4fb69-6100-36c6-9c1c-13adcf2be30d",
                                        "glosses": [
                                            "Ellipsis of skyline operator."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
