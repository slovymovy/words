                "senses": [
                    {
                        "sense_id": "6cc76f1e-63f9-3b18-8e33-4cf20fa49c2d",
                        "entry_id": "5d6f7b42-3d2c-33bd-ba1b-b24629c9373a",
                        "glosses": [
                            "Tunnel, durch den eine Autobahn führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d5f74f-ba4d-4236-af2f-fb7bc5cd9324",
                                "sense_id": "6cc76f1e-63f9-3b18-8e33-4cf20fa49c2d",
                                "text": "„Die Zufahrten von der A3 auf die Stadtautobahn im Kreuz Köln-Ost sind wegen der bevorstehenden Sanierung des Kalker Autobahntunnels gesperrt, ebenso die Auffahrt Buchheimer Ring; auf der Autobahn selbst stehen nur noch zwei statt drei Spuren in jeder Richtung zur Verfügung.“"
                            },
                            {
                                "example_id": "64703d87-bf3b-4aad-aded-80604e8c2e53",
                                "sense_id": "6cc76f1e-63f9-3b18-8e33-4cf20fa49c2d",
                                "text": "„Ein Autobahntunnel bei Tokio ist für mehrere Autofahrer zur Todesfalle geworden: Beim Einsturz eines mehr als hundert Meter langen Deckenabschnitts kamen am Sonntag nach Polizeiangaben neun Menschen ums Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
