                "senses": [
                    {
                        "sense_id": "f0230346-f652-305c-a491-463e60b94557",
                        "entry_id": "c9f2ebb4-2cd8-31bb-86b1-a4a67d188ea4",
                        "glosses": [
                            "von Drusen bewohntes Dorf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0692b41a-0a34-4f28-92e5-d97a66e53c26",
                                "sense_id": "f0230346-f652-305c-a491-463e60b94557",
                                "text": "„Die Muslime wurden deportiert, während die Drusen in andere Drusendörfer der Umgebung gehen durften.“"
                            },
                            {
                                "example_id": "620b4e2f-971c-4b67-99e2-8f0d68daa81e",
                                "sense_id": "f0230346-f652-305c-a491-463e60b94557",
                                "text": "„Zehntausende Bewohner des Golans hatten ihre Häuser verloren, aber Hauptmann Michal Cohen aus dem Hauptquartier des Nordkommandos fand die Zeit, dem Büro des Verteidigungsministers einen ausführlichen Bericht über die Ergebnisse einer Untersuchung zu schicken, die Beschwerden aus dem Drusendorf Bukata nachgegangen war: Die Maultiere von Hassan Jussuf Abu Schahin weideten unbeaufsichtigt in der Nähe der Waffenstillstandslinie und hatten vielleicht sogar schon die Grenze nach Syrien überquert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
