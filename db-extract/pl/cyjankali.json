                                        "examples": [
                                            {
                                                "example_id": "d4febb77-904f-4f1c-8799-4a59ba5564fe",
                                                "sense_id": "a3f89dca-5aaf-35f3-bfc2-2690699fd05c",
                                                "text": "Das Opfer wurde mit Zyankali getötet."
                                            },
                                            {
                                                "example_id": "9eff55d4-a09c-4b77-8b15-10e3f49b20c2",
                                                "sense_id": "a3f89dca-5aaf-35f3-bfc2-2690699fd05c",
                                                "text": "„Wir hätten uns auch Zyankali besorgen können, ein Stoff, der im Frühjahr 1945, besonders in Berlin, gefragt war wie nie zuvor.“"
                                            },
                                            {
                                                "example_id": "d79da7d1-2d85-4825-af17-1608ff3b7a91",
                                                "sense_id": "a3f89dca-5aaf-35f3-bfc2-2690699fd05c",
                                                "text": "„Während der Vernehmung beging er Selbstmord durch Verschlucken eines Mantelknopfes aus gepresstem Zyankali.“"
                                            },
                                            {
                                                "example_id": "2b2bf05e-460c-43da-b4b5-ab6a2121d3c2",
                                                "sense_id": "a3f89dca-5aaf-35f3-bfc2-2690699fd05c",
                                                "text": "„Ing. Czerniaków hatte mittels Zyankali Selbstmord begangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
