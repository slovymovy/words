                "senses": [
                    {
                        "sense_id": "14bc5490-6ff9-3f70-b9eb-3e4328393a0f",
                        "entry_id": "f120a9d7-92e8-3e95-ad72-077e50632c07",
                        "glosses": [
                            "Qui est composé de protéines ; qui contient des protéines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4956a0b-c8ac-4496-a5bb-5fb354787ada",
                                "sense_id": "14bc5490-6ff9-3f70-b9eb-3e4328393a0f",
                                "text": "[…] ; c'est précisément pour réparer les pertes de nos organes en matières protéinées qu'on soumet les malades au régime de la viande."
                            },
                            {
                                "example_id": "1b8669a2-8186-451b-951f-ba25c2f11e53",
                                "sense_id": "14bc5490-6ff9-3f70-b9eb-3e4328393a0f",
                                "text": "La diète protéinée reproduit donc une situation de jeûne long où la lipolyse (et donc la perte de poids) entraîne une libération d'acides gras qui deviennent dès lors prépondérants dans la fourniture d'énergie […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83af692b-52b4-4415-a58d-a41e13c7a7f8",
                        "source_entry_id": "f120a9d7-92e8-3e95-ad72-077e50632c07",
                        "source_sense_id": "14bc5490-6ff9-3f70-b9eb-3e4328393a0f",
                        "target_lang_word": "proteinaceous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proteinaceous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2958aea-f4a4-34dc-8012-2d5ef614a83e",
                                        "entry_id": "9a097df8-56a3-3674-9a13-cddffd826508",
                                        "glosses": [
                                            "Of, pertaining to, or consisting of protein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f4f427c-a66c-4104-b436-a91478751f55",
                                                "sense_id": "e2958aea-f4a4-34dc-8012-2d5ef614a83e",
                                                "text": "By enabling delivery fo active components beneath the skin, the sting and venom opened a bonanza of opportunities for the evolution of highly specific and active components, particularly proteinaceous materials."
                                            },
                                            {
                                                "example_id": "9c29c270-e2bf-47c8-83c1-1de52cba187f",
                                                "sense_id": "e2958aea-f4a4-34dc-8012-2d5ef614a83e",
                                                "text": "A few types of molecules get sensed by receptors on the tongue. Protons coming off of acids ping receptors for \"sour.\" Sugars get received as \"sweet.\" Bitter, salty, and the proteinaceous flavor umami all set off their own neural cascades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
