                                                "sense_id": "72aabadf-0fa6-3186-a36e-d4d8496fdadb",
                                                "text": "„Gegenüber den Toren am diesseitigen Ufer wollte er wieder zu ihnen stoßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f26471b0-118d-31a7-9f54-1533ee034388",
                                        "entry_id": "27105734-7332-3fbc-803d-545179591875",
                                        "glosses": [
                                            "auf das Diesseits, das Irdische bezogen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b8e35e3-dfe9-4bc9-b4e1-199778586a1a",
                                                "sense_id": "f26471b0-118d-31a7-9f54-1533ee034388",
                                                "text": "„Die diesseitige ontologische Interpretation des Todes liegt vor jeder ontischjenseitigen Spekulation.“"
                                            }
                                        ],
