                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "competitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't like playing against him because he is such a <w>sweat</w>.",
                            "target_lang_translations": {
                                "ru": "Мне не нравится играть против него, потому что он такой <w>задрот</w>.",
                                "zh": "我不喜欢和他对战，因为他简直是个<w>拼命三郎</w>。"
                            }
                        },
                        {
                            "text": "The lobby was full of <w>sweats</w> trying to improve their rankings.",
                            "target_lang_translations": {
                                "ru": "Лобби было полно <w>задротов</w>, пытающихся повысить свой рейтинг.",
                                "zh": "大厅里挤满了试图提高排名的<w>拼命三郎</w>。"
                            }
                        }
