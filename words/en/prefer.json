{
    "word_family": [
        "preference",
        "preferable",
        "preferential",
        "preferment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85ec9986-2d63-3744-8175-f725da405c0a",
                    "sense_definition": "To like one thing or person better than another; to choose one thing over another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>prefer</w> tea to coffee because it is more relaxing.",
                            "target_lang_translations": {
                                "ru": "Я <w>предпочитаю</w> чай кофе, потому что он больше расслабляет."
                            }
                        },
                        {
                            "text": "Most people <w>prefer</w> <w>to</w> <w>stay</w> home when the weather is this bad.",
                            "target_lang_translations": {
                                "ru": "Большинство людей <w>предпочитают</w> оставаться дома, когда погода такая плохая."
                            }
                        }
                    ],
                    "synonyms": [
                        "forechoose"
                    ],
                    "antonyms": [
                        "disprefer"
                    ],
                    "common_phrases": [
                        "prefer to stay",
                        "prefer tea to coffee",
                        "would prefer it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любить одну вещь или человека больше, чем другого; выбирать одно вместо другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предпочитать",
                                "target_lang_sense_clarification": "делать выбор в пользу чего-либо"
                            },
                            {
                                "target_lang_word": "предпочесть",
                                "target_lang_sense_clarification": "совершить выбор в конкретной ситуации"
                            },
                            {
                                "target_lang_word": "отдавать предпочтение",
                                "target_lang_sense_clarification": "выбирать среди вариантов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e525eb60-3bf9-30cd-9fe9-6ddac3667c0c",
                    "sense_definition": "To officially present or submit something, such as a legal accusation, to an authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim decided to <w>prefer</w> <w>charges</w> against the suspect after the incident.",
                            "target_lang_translations": {
                                "ru": "Потерпевший решил <w>предъявить</w> обвинения подозреваемому после инцидента."
                            }
                        },
                        {
                            "text": "The prosecutor will <w>prefer</w> a formal complaint to the court tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Прокурор <w>подаст</w> официальную жалобу в суд завтра утром."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prefer charges",
                        "prefer a complaint"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually used in the context of preferring charges"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально представлять или подавать что-либо, например, судебное обвинение, в органы власти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предъявлять",
                                "target_lang_sense_clarification": "официально выдвигать обвинения"
                            },
                            {
                                "target_lang_word": "подавать",
                                "target_lang_sense_clarification": "направлять жалобу или иск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36add51d-6310-3e13-8dfa-5800ee26323d",
                    "sense_definition": "To promote or advance someone to a higher rank, office, or position of honor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king chose to <w>prefer</w> his most loyal advisor to the rank of duke.",
                            "target_lang_translations": {
                                "ru": "Король решил <w>возвысить</w> своего самого верного советника до титула герцога."
                            }
                        },
                        {
                            "text": "In historical texts, many were <w>preferred</w> to high honors based on their social standing.",
                            "target_lang_translations": {
                                "ru": "В исторических текстах многих <w>удостаивали</w> высоких почестей на основании их социального положения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preferred to honors"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English for promotion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повышать кого-либо в звании, должности или продвигать по службе (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвигать",
                                "target_lang_sense_clarification": "по службе или в звании"
                            },
                            {
                                "target_lang_word": "возвышать",
                                "target_lang_sense_clarification": "давать более высокий статус"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}