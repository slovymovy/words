                "senses": [
                    {
                        "sense_id": "b52395fe-fac2-3342-9e2b-1886bce038bb",
                        "entry_id": "5fdb80d7-4b61-36ff-8b42-09d32c7ffb2c",
                        "glosses": [
                            "Streich, der oft dazu dient, um sich über andere lustig zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce7eb47-25c2-45a2-b9f4-0b0c876b9def",
                                "sense_id": "b52395fe-fac2-3342-9e2b-1886bce038bb",
                                "text": "„Bei den auf TikTok und YouTube präsentierten Pranks finden sich noch weitere Tatbestände wie Nötigung, Beleidigung und das Verwenden von Kennzeichen verfassungswidriger Organisationen.“"
                            },
                            {
                                "example_id": "d59768dc-5550-4091-80db-cb22b5a318a9",
                                "sense_id": "b52395fe-fac2-3342-9e2b-1886bce038bb",
                                "text": "„Im vergangenen Jahr hatte er ein Video von einem Prank veröffentlicht, in dem er - geschickt platziert in der Nähe von Polizisten - so tut, als würde er Wände mit Graffiti besprühen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f76cdf81-d1ba-4018-8d3f-a1f3ce71b929",
                        "source_entry_id": "5fdb80d7-4b61-36ff-8b42-09d32c7ffb2c",
                        "source_sense_id": "b52395fe-fac2-3342-9e2b-1886bce038bb",
                        "source_sense_description": "Streich, der oft dazu dient, um sich über andere lustig zu machen",
                        "target_lang_word": "prank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d4af3b-896b-3d20-9594-b4032b2eb491",
                                        "entry_id": "44e3b796-0cfd-3361-889f-5ea35ee4fc25",
                                        "glosses": [
                                            "A practical joke or mischievous trick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21852f52-623e-4866-99c3-7963e523940a",
                                                "sense_id": "e0d4af3b-896b-3d20-9594-b4032b2eb491",
                                                "text": "play a prank"
                                            },
                                            {
                                                "example_id": "24d55929-28ee-483b-a574-04a75646df18",
                                                "sense_id": "e0d4af3b-896b-3d20-9594-b4032b2eb491",
                                                "text": "pull a prank on someone"
                                            },
                                            {
                                                "example_id": "8b771988-4e4a-4882-8b41-c0a1dba3a7e1",
                                                "sense_id": "e0d4af3b-896b-3d20-9594-b4032b2eb491",
                                                "text": "He pulled a gruesome prank on his sister."
                                            },
                                            {
                                                "example_id": "c9804db2-af7d-4ee0-a14e-00e1bde3b1a3",
                                                "sense_id": "e0d4af3b-896b-3d20-9594-b4032b2eb491",
                                                "text": "His pranks have been too broad to bear with."
                                            },
                                            {
                                                "example_id": "beb2e85c-02b7-4936-a929-645441dd2f06",
                                                "sense_id": "e0d4af3b-896b-3d20-9594-b4032b2eb491",
                                                "text": "The harpies […] played their accustomed pranks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e956e417-c80f-34b8-9b58-36e20005841f",
                                        "entry_id": "44e3b796-0cfd-3361-889f-5ea35ee4fc25",
                                        "glosses": [
                                            "An evil deed; a malicious trick, an act of cruel deception."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ad1c46-6215-4243-b0f0-ed5ab13959de",
                                                "sense_id": "e956e417-c80f-34b8-9b58-36e20005841f",
                                                "text": "She played a cruel prank on him."
                                            },
                                            {
                                                "example_id": "4bd358e3-2465-40bc-8430-0183c1415fe5",
                                                "sense_id": "e956e417-c80f-34b8-9b58-36e20005841f",
                                                "text": "Lilius Geraldus ſaith,that Hercules after all his mad prankes vpon his wife and children, was perfectly cured by a purge of Hellebor,which an Anticyrian adminiſtred vnto him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17a6e49f-4aca-341b-a040-f1e0ebdb58aa",
                                        "entry_id": "dabc7f9c-2a38-3b34-8cbe-7d5e59929d50",
                                        "glosses": [
                                            "To perform a practical joke on; to trick and make a fool of someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c6d435-44d4-4a57-bd1a-0047b5950ed6",
                                                "sense_id": "17a6e49f-4aca-341b-a040-f1e0ebdb58aa",
                                                "text": "“If someone’s pranking me,” Rowlands remembered thinking, “they’re going to great lengths to make it work.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1ad6834-50a2-3c5b-abc8-9de31d421a42",
                                        "entry_id": "dabc7f9c-2a38-3b34-8cbe-7d5e59929d50",
                                        "glosses": [
                                            "To perform a practical joke on; to trick and make a fool of someone.",
                                            "To make a prank call to (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb3f8248-1dab-3095-86e8-2d264f8fdcea",
                                        "entry_id": "dabc7f9c-2a38-3b34-8cbe-7d5e59929d50",
                                        "glosses": [
                                            "To call someone's phone and hang up before they answer, so as to send them a notification (of a missed call) without incurring fees."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15231148-516d-47b6-98d6-118cd59322c5",
                                                "sense_id": "bb3f8248-1dab-3095-86e8-2d264f8fdcea",
                                                "text": "Hey man, prank me when you wanna get picked up."
                                            },
                                            {
                                                "example_id": "dceb2059-ac88-47da-8682-6f46ecb018f2",
                                                "sense_id": "bb3f8248-1dab-3095-86e8-2d264f8fdcea",
                                                "text": "I don't have your number in my phone; can you prank me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "017710ba-67d4-3d72-92aa-f78d624ebb84",
                                        "entry_id": "dabc7f9c-2a38-3b34-8cbe-7d5e59929d50",
                                        "glosses": [
                                            "To adorn in a showy manner; to dress or equip ostentatiously."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d61d1c-08ca-44c4-93d1-5a2cdcb10813",
                                                "sense_id": "017710ba-67d4-3d72-92aa-f78d624ebb84",
                                                "text": "In sumptuous tire she ioyd her selfe to prancke"
                                            },
                                            {
                                                "example_id": "b33883cc-9ec5-41a7-b765-cd8324ba9032",
                                                "sense_id": "017710ba-67d4-3d72-92aa-f78d624ebb84",
                                                "text": "1748, James Thomson, The Castle of Indolence, B:II\nAnd there a Seaſon atween June and May,\nHalf prankt with Spring, with Summer half imbrown'd,\nA liſtleſs Climate made, where, Sooth to ſay,\nNo living Wight could work, ne cared even for Play."
                                            },
                                            {
                                                "example_id": "bc1db58c-3a13-4690-ad36-cb4d97eb9d17",
                                                "sense_id": "017710ba-67d4-3d72-92aa-f78d624ebb84",
                                                "text": "Flora, wanton-eyed\nFor birth, and with all flowrets prankt and pied:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b4513fb-2aba-3bd9-901e-3b81ecc0b2f2",
                                        "entry_id": "dabc7f9c-2a38-3b34-8cbe-7d5e59929d50",
                                        "glosses": [
                                            "To make an ostentatious show."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e8f855-1669-4257-b5ad-846f99e7f313",
                                                "sense_id": "6b4513fb-2aba-3bd9-901e-3b81ecc0b2f2",
                                                "text": "White houses prank where once were huts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
