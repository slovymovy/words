                                "target_senses": [
                                    {
                                        "sense_id": "b53378eb-011e-3194-a0a6-2761a450790f",
                                        "entry_id": "847a18ad-ddd8-35b2-b9d9-9e6d4ba3c2db",
                                        "glosses": [
                                            "The first compartment of the stomach of a cow or other ruminants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d72d7e6-b83a-4275-9cd9-0942c8213c0b",
                                                "sense_id": "b53378eb-011e-3194-a0a6-2761a450790f",
                                                "text": "In the newborn ruminant the abomasum is about as large as the rumen and remains relatively large as long as only milk is consumed (Brugnone, 1809). As the young ruminant consumes forages, the reticulum, and particularly the rumen, develop rapidly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "708cd747-c375-4321-8d55-1d01d6c62958",
                        "source_entry_id": "0c992e27-1625-3954-b7eb-41f38d3648c2",
                        "source_sense_id": "8ee9ed0b-0ac7-3935-8b5f-e946d15a1106",
                        "target_lang_word": "panza",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panza",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3b64ad64-2008-3ab6-8469-c4e2ac585ce3",
                                        "entry_id": "1e5556a6-41b6-39ef-977f-26cd3f6d94b5",
                                        "glosses": [
                                            "Parte delantera del abdomen, sobre todo cuando abulta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510c3184-468f-4ce8-8cf4-06f4d2516a48",
                                                "sense_id": "3b64ad64-2008-3ab6-8469-c4e2ac585ce3",
                                                "text": "«Como un relámpago leonado, el perro se abalanza sobre la perra, se introduce en su panza y cobra forma en su interior»."
                                            },
                                            {
                                                "example_id": "56cf6f1b-81b1-4204-8a31-b314b401a7f1",
                                                "sense_id": "3b64ad64-2008-3ab6-8469-c4e2ac585ce3",
                                                "text": "«Imagínate cómo voy a preferir quedarme aburrida en esta casa tan grande, mientras tú te rascas la panza frente al río, rodeado de árboles, en esa preciosura de chalet que tenemos en el Cajón del Maipo»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d1a56e3-3a58-3b00-bb00-ab7d6aa78284",
                                        "entry_id": "1e5556a6-41b6-39ef-977f-26cd3f6d94b5",
                                        "glosses": [
                                            "Parte abultada y saliente de culaquier objeto"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "016a4486-c094-3bdc-9182-e7fc4d91ee33",
                                        "entry_id": "1e5556a6-41b6-39ef-977f-26cd3f6d94b5",
                                        "glosses": [
                                            "Primero de los cuatro estómagos de los rumiantes"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
