                "senses": [
                    {
                        "sense_id": "0d0b5594-6fde-3ed6-841a-fb55ac7b6339",
                        "entry_id": "8e8c0ff5-d0c4-3f16-a5de-d170442e8d4f",
                        "glosses": [
                            "разжечь, зажечь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c06c24-ffe0-48ac-8be4-0d1f2a5bd52a",
                                "sense_id": "0d0b5594-6fde-3ed6-841a-fb55ac7b6339",
                                "text": "Это не означает, однако, полную безопасность. Я в сельской местности вырос и знаю, что перестоявший перегной (навоз, компост, силос) может загореться. И запалить всё вокруг."
                            }
                        ]
                    },
                    {
                        "sense_id": "47865365-d26d-3f2c-bad2-73543c7d226a",
                        "entry_id": "8e8c0ff5-d0c4-3f16-a5de-d170442e8d4f",
                        "glosses": [
                            "перен., разг. выдать того, кто как-либо скрывался"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be12a4b0-e86b-40fc-80f6-10cdda972121",
                                "sense_id": "47865365-d26d-3f2c-bad2-73543c7d226a",
                                "text": "Главный герой пытался скрыться от преследователей в кустах, но его запалил прохожий с собакой."
                            }
                        ]
                    }
                ],
