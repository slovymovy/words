                },
                {
                    "sense_id": "8580b8ad-03de-340b-b3d9-0cdb5727d1f5",
                    "sense_definition": "Rencontre ou conférence organisée entre spécialistes pour débattre de questions scientifiques, médicales ou techniques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "colloque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux chercheurs ont participé à ces <w>entretiens</w> annuels consacrés aux maladies rares."
                        },
                        {
                            "text": "Elle a présenté ses récents travaux lors des grands <w>entretiens</w> de cardiologie à Paris."
                        }
                    ],
                    "synonyms": [
                        "colloque",
                        "conférence",
                        "congrès",
                        "réunion",
                        "séminaire"
                    ]
                }
            ]
        }
