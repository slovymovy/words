                ],
                "senses": [
                    {
                        "sense_id": "76619f20-84cd-396e-bbda-ca8e36409c5b",
                        "entry_id": "7a74ad43-5e46-366c-a7fe-f779f82fd74f",
                        "glosses": [
                            "der Teil des propositionalen Aktes, mit dem ein Sprecher über seinen Gegenstand etwas aussagt"
                        ],
                        "tags": [
                            "speziell Sprechakttheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "808dbf7d-6abe-4f61-9831-fd7965d184da",
                                "sense_id": "76619f20-84cd-396e-bbda-ca8e36409c5b",
                                "text": "Mit einer Äußerung wie „Angela Merkel ist die derzeitige Bundeskanzlerin“ besteht der Prädikationsakt darin, dass der Sprecher zu einer bestimmten Person, in diesem Fall Angela Merkel, eine Aussage macht, und zwar die Feststellung, das sie die Funktion der Bundeskanzlerin ausübt."
                            },
                            {
                                "example_id": "a3582902-ff23-4bc1-a4bc-d7cb7d8c8a79",
                                "sense_id": "76619f20-84cd-396e-bbda-ca8e36409c5b",
                                "text": "Prädikationsakt und Referenzakt machen zusammen den propositionalen Akt aus."
                            },
                            {
                                "example_id": "e38ba820-676d-4af2-befc-06f849bafdf8",
                                "sense_id": "76619f20-84cd-396e-bbda-ca8e36409c5b",
                                "text": "„Der Vollzug sprecherseitiger Prädikationsakte als Anweisungen für hörerseitige Referenzakte präsupponiert, daß die verwendeten Prädikatoren in der gemeinsamen Alltagserfahrung oder Interaktionsgeschichte oder auch im voraufgehenden Kotext hinreichend eingeführt sind (…).“"
                            },
                            {
                                "example_id": "cd4b2360-fa06-4808-b0bb-b179b37714b1",
                                "sense_id": "76619f20-84cd-396e-bbda-ca8e36409c5b",
                                "text": "„Während der Äußerungsakt keine eigenständige theoretische Beachtung erfährt, wird der propositionale Akt näher als die Kombination eines Referenzaktes (in dem die Bezugnahme auf die »Welt« erfolgt) und eines Prädikationsaktes (in dem eine Aussage über »Welt« gemacht wird) verstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
