                        "glosses": [
                            "An elector or chooser; one of two persons appointed by a court to return a jury or serve a writ when the sheriff and the coroners are disqualified."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "6f0dc734-0606-4109-9cf1-6b9b17599f49",
                                "sense_id": "d830ba04-7ef0-361b-b422-868654433f0a",
                                "text": "Maryland Rules of Court, 1985: When the sheriff is a party to or interested in an action so as to be disqualified from serving or executing process, the court, on application of any interested party, may appoint an elisor to serve or execute the process."
                            }
                        ]
                    }
