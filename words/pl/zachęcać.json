{
    "word_family": [
        "zachęta",
        "zachęcić",
        "zachęcający",
        "zachęcenie",
        "zachęcanie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72663c08-b0e9-3bc2-9838-66aebf181cbb",
                    "sense_definition": "próbować wzbudzić w kimś chęć do zrobienia czegoś lub zainteresowanie czymś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "motywowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciele często <w>zachęcają</w> uczniów do czytania książek w wolnym czasie.",
                            "target_lang_translations": {
                                "ru": "Учителя часто <w>поощряют</w> учеников читать книги в свободное время."
                            }
                        },
                        {
                            "text": "Moja mama zawsze stara się <w>zachęcać</w> do nauki moje młodsze rodzeństwo.",
                            "target_lang_translations": {
                                "ru": "Моя мама всегда старается <w>побуждать</w> к учебе моих младших братьев и сестер."
                            }
                        }
                    ],
                    "synonyms": [
                        "przekonywać",
                        "namawiać",
                        "nakłaniać",
                        "mobilizować",
                        "inspirować."
                    ],
                    "antonyms": [
                        "zrażać"
                    ],
                    "common_phrases": [
                        "zachęcać do nauki",
                        "zachęcać do współpracy",
                        "zachęcać do zakupu"
                    ],
                    "target_lang_definitions": {
                        "ru": "пытаться вызвать у кого-либо желание что-то сделать или интерес к чему-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поощрять",
                                "target_lang_sense_clarification": "стимулировать к действию"
                            },
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "настойчиво просить или предлагать что-то сделать"
                            },
                            {
                                "target_lang_word": "побуждать",
                                "target_lang_sense_clarification": "склонять к какому-либо действию"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "давать толчок к развитию интереса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "607a1622-3901-3002-8283-499c1d59b685",
                    "sense_definition": "wzbudzać w samym sobie chęć do działania lub pozytywne nastawienie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motywowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdego ranka <w>zachęcam się</w> do ćwiczeń, myśląc o swoim zdrowiu.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я <w>подбадриваю себя</w> делать упражнения, думая о своем здоровье."
                            }
                        },
                        {
                            "text": "Musisz <w>zachęcać się</w> do pracy, nawet gdy brakuje ci energii.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>мотивировать себя</w> на работу, даже когда тебе не хватает энергии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zachęcać się do działania"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать в самом себе желание действовать или позитивный настрой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбадривать себя",
                                "target_lang_sense_clarification": "внушать себе уверенность"
                            },
                            {
                                "target_lang_word": "настраивать себя",
                                "target_lang_sense_clarification": "подготавливать себя психологически"
                            },
                            {
                                "target_lang_word": "мотивировать себя",
                                "target_lang_sense_clarification": "находить стимул для работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e8a95c9-5745-3fdb-af00-e1e0e656443a",
                    "sense_definition": "wzajemnie motywować się w grupie lub parze do podjęcia jakiegoś wysiłku",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motywowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sportowcy w drużynie <w>zachęcają się</w> nawzajem przed każdym ważnym meczem.",
                            "target_lang_translations": {
                                "ru": "Спортсмены в команде <w>подбадривают друг друга</w> перед каждым важным матчем."
                            }
                        },
                        {
                            "text": "Podczas trudnej wędrówki turyści <w>zachęcali się</w> do dalszego marszu.",
                            "target_lang_translations": {
                                "ru": "Во время трудного похода туристы <w>подбадривали друг друга</w> продолжать путь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zachęcać się nawzajem"
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно мотивировать друг друга в группе или паре к совершению каких-либо усилий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбадривать друг друга",
                                "target_lang_sense_clarification": "взаимно воодушевлять"
                            },
                            {
                                "target_lang_word": "стимулировать друг друга",
                                "target_lang_sense_clarification": "взаимно побуждать к действию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
