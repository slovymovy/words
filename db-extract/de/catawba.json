                        "glosses": [
                            "ausgestorbene Sprache, die vom gleichnamigen Volk im Nordamerika gesprochen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2e5b60d-c511-478c-9b69-9c3dff6b2b20",
                                "sense_id": "87655d02-dff4-384a-afc6-38064b7b5618",
                                "text": "„Am 01. August 1996 starb der US-Indianer Samuel Taylor Blue. Als letzter Catawba-Indianer, dessen Stamm zu den Sioux zählte und am Catawba-River lebte, beherrschte er das ursprüngliche Catawba. Mit ihm starb auch die Sprache. Dies ist bei weitem kein Einzelfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
