                "senses": [
                    {
                        "sense_id": "49636a73-1d84-388d-a5f8-97796149ce6c",
                        "entry_id": "9278f2e6-1617-3fb9-923a-bb71feca2ffa",
                        "glosses": [
                            "to castrate"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6e4cde16-a0b6-3b2a-a3e0-c3663dea1303",
                        "entry_id": "9278f2e6-1617-3fb9-923a-bb71feca2ffa",
                        "glosses": [
                            "to deprive (a theory, a doctrine etc.) of vivacity"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8038eeb-a3b3-4770-a048-ec1faff5c995",
                                "sense_id": "6e4cde16-a0b6-3b2a-a3e0-c3663dea1303",
                                "text": "«Мудрёное ны́нче вре́мя! — ду́мала она́, — тако́е мудрёное, что и неви́нный за винова́того как ра́з сойдёт! Начну́т, э́то, ша́рить, а ты о́коло где́-нибудь спря́талась, — ан и о́коло поша́рят! Где была́? по како́му слу́чаю? каки́м мане́ром? — го́споди, спаси́ и поми́луй!» Ста́ло быть, мо́жете себе́ предста́вить, как она́ была́ ра́да, когда́ её излови́ли и все мы́сли и чу́вства у ней вы́холостили!",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            }
                        ]
                    }
                ],
