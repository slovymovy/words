                    {
                        "sense_id": "04dd8d7f-93a7-3de4-9b2c-feae1ad31e84",
                        "entry_id": "fc951d5f-a38b-3587-bec3-59ec55d4bd11",
                        "glosses": [
                            "dizziness; also: tipsiness"
                        ],
                        "tags": [
                            "masculine",
