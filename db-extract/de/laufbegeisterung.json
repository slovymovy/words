                "senses": [
                    {
                        "sense_id": "3b74ab9a-c023-3645-98af-152edda487e2",
                        "entry_id": "2d5684c4-af78-3815-b118-049241ca26ac",
                        "glosses": [
                            "sehr starke, überschwängliche Freude am Laufen; Leidenschaft fürs Laufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03913178-4764-44fc-b46d-cf5fb4f3ac74",
                                "sense_id": "3b74ab9a-c023-3645-98af-152edda487e2",
                                "text": "„Dort machte ihr das Laufen immer am meisten Spaß, so dass sie oft ganz alleine ihre Runden auf der Bahn drehte, während die anderen Kinder am normalen Vereinstraining teilnahmen (und sich vermutlich auch ein bisschen über Franzis Laufbegeisterung gewundert haben).“"
                            },
                            {
                                "example_id": "4062b82a-677b-4d6b-baff-5cb6e19596bc",
                                "sense_id": "3b74ab9a-c023-3645-98af-152edda487e2",
                                "text": "„Der teilweise frische Wind tat der Laufbegeisterung keinen Abbruch.“"
                            },
                            {
                                "example_id": "0657c907-2adc-4d45-bb05-d436c92b3a4b",
                                "sense_id": "3b74ab9a-c023-3645-98af-152edda487e2",
                                "text": "„Unsere kenianischen Athleten lieben es ihre Laufbegeisterung an die Jüngsten weiterzugeben.“"
                            },
                            {
                                "example_id": "1fc85528-6078-4618-8a12-fb2e0c17cf3f",
                                "sense_id": "3b74ab9a-c023-3645-98af-152edda487e2",
                                "text": "„Ein Teil der Spenden wird für Projekte der Katarina Witt-Stiftung verwendet - und so können viele junge Menschen mit Behinderung von der Laufbegeisterung der Teilnehmer profitieren.“"
                            },
                            {
                                "example_id": "b83a1ee0-8c2b-4550-b01f-47d1c21af7c6",
                                "sense_id": "3b74ab9a-c023-3645-98af-152edda487e2",
                                "text": "„Es war der bisher größte Lauf in der südostspanischen Hafenstadt mit außergewöhnlicher Laufbegeisterung seit Pandemiebeginn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
