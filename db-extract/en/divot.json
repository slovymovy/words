                        "source_sense_description": "piece of turf",
                        "target_lang_word": "Grassode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grassode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e61c3316-a970-394c-a6ec-21769db9ff3a",
                                        "entry_id": "be36f4da-2a16-317c-bc3b-2c238a1dd1bf",
                                        "glosses": [
                                            "ein abgestochenes Stück Gras"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad5738c-739e-4e6c-b5b6-0455652dd298",
                                                "sense_id": "e61c3316-a970-394c-a6ec-21769db9ff3a",
                                                "text": "„Seine Männer stechen Grassoden aus, fünf Zentimeter dick, einen Meter lang, einen Viertelmeter breit.“"
                                            },
                                            {
                                                "example_id": "fd51b996-d924-4f77-b0dc-06d6312c2522",
                                                "sense_id": "e61c3316-a970-394c-a6ec-21769db9ff3a",
                                                "text": "„Um ein Auseinanderfließen des Erdhügels bei Regen zu verhindern, wurde er mit Grassoden abgedeckt und mit einem Steinkranz umgeben.“"
                                            },
                                            {
                                                "example_id": "4c0b911e-4356-43c6-b746-6a6e482dc5b3",
                                                "sense_id": "e61c3316-a970-394c-a6ec-21769db9ff3a",
                                                "text": "„Das Dach ist mit Grassoden gedeckt.“"
                                            },
                                            {
                                                "example_id": "32ef1427-5789-40da-b750-f6293d8b5422",
                                                "sense_id": "e61c3316-a970-394c-a6ec-21769db9ff3a",
                                                "text": "„Der Silo wurde mit Getreide gefüllt, der Ausgang mit Brettern und Grassoden luftdicht abgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d108a098-8500-4413-8cef-4d62e3aed49b",
                        "source_entry_id": "b95fee52-5d6c-3b7c-a000-0983cfa52831",
