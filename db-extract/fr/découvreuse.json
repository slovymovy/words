                                    {
                                        "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                        "entry_id": "da5d1566-bdd9-3e77-b39f-c5e40457e52e",
                                        "glosses": [
                                            "One who discovers: a person who has discovered something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b978042-14b5-4a5d-b0f2-092db21348b1",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "[W]hen the flowꝛes there haue been ſufficiently wꝛought, they [bees] ſend abꝛoade their diſcouerers to finde out moꝛe foode."
                                            },
                                            {
                                                "example_id": "5933d33f-b98a-42a2-bbe7-9e847ad56f87",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "The ſpecies of elaſtic fluid, which its great diſcoverer, Dr. Prieſtley, denominated the dephlogiſticated nitrous air, and others have ſince called gazeous oxyd of azot, is in general not unknown to chemiſts, though they are unacquainted with its compoſition, its moſt extraordinary effects, and probably with its perfect preparation."
                                            },
                                            {
                                                "example_id": "5fc94570-db2e-43c6-a7eb-7e278689f523",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "[M]any of the most successful discoverers of metallic wealth have been entirely ignorant of the methods by which a great mine should be opened, developed, and worked."
                                            },
                                            {
                                                "example_id": "b7973313-c383-4742-992a-421ea9012fd2",
                                                "sense_id": "c4e6b56d-a19a-3ff2-8bde-4559c21e8ab8",
                                                "text": "But this was subterfuge to defeat the curiosity of a chance discoverer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
