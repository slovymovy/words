                    }
                ],
                "senses": [
                    {
                        "sense_id": "184cf4ff-e269-3eed-b1e6-3c3958ef2ec5",
                        "entry_id": "b07e578a-25fe-37ed-ae05-a932de1c1440",
                        "glosses": [
                            "Qui n’est plus attaché par une bride."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8943191-4ebe-40db-900e-7c8bade2739e",
                                "sense_id": "184cf4ff-e269-3eed-b1e6-3c3958ef2ec5",
                                "text": "Les chevaux débridés et dessellés."
                            }
                        ]
                    },
                    {
                        "sense_id": "c78c72ed-85b0-3c55-80b8-a5df50730e38",
                        "entry_id": "b07e578a-25fe-37ed-ae05-a932de1c1440",
                        "glosses": [
                            "Qui ne se donne pas de limites."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ff620df2-a5f9-47ea-b67e-6c34865f6681",
                                "sense_id": "c78c72ed-85b0-3c55-80b8-a5df50730e38",
                                "text": "Le « Green Friday » est trop récent pour que son effet réel soit mesuré, alors que le « Black Friday » devrait encore battre des records de chiffre d’affaires. Mais l’événement alternatif semble refléter un rejet du consumérisme débridé d’une partie de la société."
                            }
                        ]
                    },
                    {
                        "sense_id": "48335596-d33b-388e-845d-67119c0b435d",
                        "entry_id": "b07e578a-25fe-37ed-ae05-a932de1c1440",
                        "glosses": [
                            "Qualifie les yeux qui ont été opérés pour ne plus être bridés ; dont l'épicanthus a été réduit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ececb75a-076c-4378-b7d8-f5c1be4e6f38",
                                "sense_id": "48335596-d33b-388e-845d-67119c0b435d",
                                "text": "Une Japonaise aux yeux débridés."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e9756f4-bfa3-3b34-82c0-a94757253b66",
                        "entry_id": "b07e578a-25fe-37ed-ae05-a932de1c1440",
                        "glosses": [
                            "Qualifie un engin dont le bridage a été retiré, lui permettant ainsi de dépasser les limites originelles, notamment une vitesse artificiellement limitée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c3cd0c4-aaf2-4563-9f28-e6dac3b1fec2",
                                "sense_id": "4e9756f4-bfa3-3b34-82c0-a94757253b66",
                                "text": "Un tel rendez-vous obligatoire aurait aussi permis de mieux repérer les deux-roues débridés ou kités. Ces deux-roues trafiqués sont dangereux — d’après la dernière enquête de la Fédération française de l’assurance (ex-Fédération française des sociétés d’assurance) menée en 2007, un conducteur de deux-roues accidenté sur deux conduisait un véhicule débridé et les dommages corporels progressaient de 30 % avec le débridage."
                            },
                            {
                                "example_id": "b7e43b65-da8c-4a29-90f5-67a3be9af40d",
                                "sense_id": "4e9756f4-bfa3-3b34-82c0-a94757253b66",
                                "text": "Soit parce qu’ils ont débridé leur moteur, soit parce qu’ils utilisent des speedelec ou des fat bikes qui sont, en fait, des cyclomoteurs déguisés en vélo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7898d662-0f22-4914-8393-90b00a0b824e",
                        "source_entry_id": "b07e578a-25fe-37ed-ae05-a932de1c1440",
