                        ],
                        "form": "копира́йтами"
                    },
                    {
                        "form_id": "8f4f4ed3-5788-4c67-b67e-37e345287e91",
                        "entry_id": "1eef5e73-3081-346d-93bf-364e5d14abc3",
                        "tags": [
