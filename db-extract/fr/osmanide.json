                                            {
                                                "example_id": "52f96d93-caa9-4a79-ba9f-df4f7e920a04",
                                                "sense_id": "8b7a3d93-2dfc-393c-a9f8-86367fe6f583",
                                                "text": "Thus the period of Turkish occupation was the “dynasty of the Osmanids.”"
