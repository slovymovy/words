        "fr-extract.jsonl": [
            {
                "entry_id": "ed2fb5f1-2b80-3b89-ba5a-21c51b5db407",
                "word": "antiquaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "87a1bcbe-73e5-4d2b-808d-dcde8d9c2195",
                        "entry_id": "ed2fb5f1-2b80-3b89-ba5a-21c51b5db407",
                        "tags": [
                            "plural"
                        ],
                        "form": "antiquailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70fa9dba-07ee-3e6a-a5c9-05312fe7d6f0",
                        "entry_id": "ed2fb5f1-2b80-3b89-ba5a-21c51b5db407",
                        "glosses": [
                            "Ensemble de certaines choses antiques de peu de valeur."
                        ],
                        "tags": [
                            "collective",
                            "familiar"
                        ],
                        "note": "Il s’emploie surtout au pluriel",
                        "examples": [
                            {
                                "example_id": "01328e1e-962c-4875-bb8f-c0203beb7465",
                                "sense_id": "70fa9dba-07ee-3e6a-a5c9-05312fe7d6f0",
                                "text": "Ces modes-là renaissent, disait-il, les antiquailles font fureur, et les jeunes femmes de ma vieillesse s’habillent comme les vieilles femmes de mon enfance."
                            },
                            {
                                "example_id": "f96fa7bb-2115-4d8c-8857-558007aaddc3",
                                "sense_id": "70fa9dba-07ee-3e6a-a5c9-05312fe7d6f0",
                                "text": "C’était Yolande de Foix. La jalousie des femmes se sentant menacées dans leurs succès et réduites à l’état de laiderons ou d’antiquailles l’avait bien reconnue avant qu’elle ne se fût démasquée."
                            },
                            {
                                "example_id": "b42c2ff3-a79e-4f9a-9e4a-5f702cceeb0c",
                                "sense_id": "70fa9dba-07ee-3e6a-a5c9-05312fe7d6f0",
                                "text": "J’ai autrefois habité une vieille maison de province qui était un vrai paradis pour les chats, à cause de ses longs et noirs corridors, de ses galetas encombrés d’antiquailles et de meubles, de ses combles jamais visités et tout à fait propices aux secrètes installations, …."
                            },
                            {
                                "example_id": "18b83a79-2d9a-4fdc-baec-3919874cabc5",
                                "sense_id": "70fa9dba-07ee-3e6a-a5c9-05312fe7d6f0",
                                "text": "« Il y a une cachette, là, disait-il, j’y ai vu mettre des antiquailles, flambeaux, pendules… »"
                            },
                            {
                                "example_id": "0e2abdd6-ac49-4894-9772-405c204ff8ba",
                                "sense_id": "70fa9dba-07ee-3e6a-a5c9-05312fe7d6f0",
                                "text": "Son frère aîné, devenu marbrier dans la petite ville, lui avait trouvé une fiancée riche dont il avait converti la dot en antiquailles avantageuses ; le commerce avait prospéré ; de temps en temps un « ou » ou un « z » rappelait, au tournant d’une phrase, les origines étrangères de M. Lazare Feracci, mais c’était une sorte de grâce dans sa bouche savante de vieil homme expérimenté."
                            },
                            {
                                "example_id": "da212320-1922-4489-9618-45639e9d3293",
                                "sense_id": "70fa9dba-07ee-3e6a-a5c9-05312fe7d6f0",
                                "text": "Fleetwinch avait cru devoir sacrifier au goût de l'antiquaille et il avait installé partout des cheminées ouvertes, destinées à des feux de bois."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
