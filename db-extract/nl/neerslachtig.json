                        "examples": [
                            {
                                "example_id": "dd7d05c8-bcb4-4404-8c8b-c1d392575add",
                                "sense_id": "42b1c918-219a-3e0c-bc8b-350af1168b5d",
                                "text": "Het neerslachtige meisje voerde helemaal niets meer uit."
                            },
                            {
                                "example_id": "9d5a10cc-4d46-43f5-87e7-7f4cffdae2fc",
                                "sense_id": "42b1c918-219a-3e0c-bc8b-350af1168b5d",
                                "text": "Hoewel zijn collega's volwassen mannen waren, hadden ze een manier om over vrouwen te praten die hem even neerslachtig als beschaamd maakte."
                            }
                        ]
                    }
