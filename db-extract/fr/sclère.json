                        "cross_references": [
                            {
                                "target_word": "Sklera",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "daac504f-156f-3164-bedd-9d48c8e81bb4",
                                        "entry_id": "ad01c0b0-2549-320c-9c68-9de4e9c5d115",
                                        "glosses": [
                                            "die äußere, feste, undurchsichtige Hülle des Augapfels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cdb5b8c-8c82-433a-9e75-dbeb38109873",
                                                "sense_id": "daac504f-156f-3164-bedd-9d48c8e81bb4",
                                                "text": "„Wie dieses, ist das Wirbeltierauge ein Linsenange, dessen Netzhaut etwa drei Viertel einer Kugel bildet und von einer widerstandsfähigen Sklera gestützt wird; die Linse wird etwa an ihrem Äquator von ihrem Tragapparat umfaßt; vor der Linse eine Iris mit erweiterungsfähiger Pupille und eine gewölbte durchsichtige Hornhaut.“"
                                            },
                                            {
                                                "example_id": "f2e8e15a-be70-4d72-bcbb-324d00b08998",
                                                "sense_id": "daac504f-156f-3164-bedd-9d48c8e81bb4",
                                                "text": "Die Sklera „ist an ihrer Außenfläche von einer dünnen, elastischen, gefäßhaltigen Haut, der Episklera, überzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "883d3df9-75ac-4b59-865e-9dd48c3382ba",
                        "source_entry_id": "6b9adb3d-405f-3a3e-8fea-19f509b6a52d",
                        "source_sense_id": "7a3dc107-2115-3da7-8a6a-259c347fac15",
                        "target_lang_word": "sclera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sclera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "390f4410-d999-3afb-969b-a0122dc4b55f",
                                        "entry_id": "31b7f8cc-6451-3c5c-9eb3-5c5b42ec9adc",
                                        "glosses": [
                                            "The white of the eye; the tough outer coat of the eye that covers the eyeball except for the cornea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baabfeb4-4e80-4978-af39-751fe3d67408",
                                                "sense_id": "390f4410-d999-3afb-969b-a0122dc4b55f",
                                                "text": "She'd been back a week and it was clear that college-level track was kicking her ass, the sclera in her normally wide manga-eyes were shot through with blood vessels."
                                            },
                                            {
                                                "example_id": "ac0f1607-d42d-4165-a9ea-7a4abbb5847e",
                                                "sense_id": "390f4410-d999-3afb-969b-a0122dc4b55f",
                                                "text": "Such pressures explain why humans are peculiar in having our rather small irises set against a white background—the sclera—in our eyes. Anyone watching us can infer where we are looking or whom we are looking at."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
