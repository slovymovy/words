                        "entry_id": "49ff2774-4baf-390c-b370-a0939be732fa",
                        "glosses": [
                            "Kuss, den man gibt, wenn man zu Bett geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9866a46-3f91-42e6-b46c-25d7c964ba65",
                                "sense_id": "8aa87d78-ee02-3446-97cb-ab3131d45a28",
                                "text": "Sie gab ihren Eltern einen Gutenachtkuss und ging zu Bett."
                            },
                            {
                                "example_id": "b24becb7-cb6d-4cf5-85c1-c35fdd0af931",
                                "sense_id": "8aa87d78-ee02-3446-97cb-ab3131d45a28",
                                "text": "„Bevor wir un auf dem Gang trennen, gebe ich ihr einen Gutenachtkuss auf die Stirn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
