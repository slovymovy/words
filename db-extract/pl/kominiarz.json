                        "target_lang_word": "ramoneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ramoneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                        "entry_id": "c1334427-49a0-360f-b75a-8112e360cc93",
                                        "glosses": [
                                            "Celui dont le métier est de ramoner les cheminées."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Hygiène"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4859ebb1-8a34-41e0-a39a-21c062645244",
                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Un petit ramoneur."
                                            },
                                            {
                                                "example_id": "530f22f4-7cc9-4583-9530-55de12a8da1c",
                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Il était noir comme un ramoneur."
                                            },
                                            {
                                                "example_id": "969f4e62-54c0-439a-8d08-98b1d50c5315",
                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Un jeune ramoneur dont la figure bouffie était noire, le corps brun de suie, les vêtements déguenillés, tendit la main à cet homme pour lui arracher ses derniers sous."
                                            },
                                            {
                                                "example_id": "15d2e77b-a918-4735-a7f1-1a10bfafecbe",
                                                "sense_id": "254f3c77-11f9-30e6-a240-88661c75bb99",
                                                "text": "Les ramoneurs savoyards étaient aussi revenus, poussant leur cri d’automne, qui déjà, les années précédentes, me serrait le cœur à me faire pleurer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a4c699-22ff-37da-97e1-2c5f1cf05aeb",
                                        "entry_id": "c1334427-49a0-360f-b75a-8112e360cc93",
                                        "glosses": [
                                            "Synonyme de tanagre du cerfeuil (papillon)."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2d3b075-abfb-3eee-a114-6dd757c4abd7",
                                        "entry_id": "c1334427-49a0-360f-b75a-8112e360cc93",
                                        "glosses": [
                                            "Partisan de Jean-Philippe Rameau."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "608f52c0-d61f-4b46-8ad7-1b999b465ae1",
                                                "sense_id": "a2d3b075-abfb-3eee-a114-6dd757c4abd7",
                                                "text": "Debussy eut ses debussystes, comme Wagner ses wagnériens, Rameau ses ramistes ou ramoneurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
