                                        "glosses": [
                                            "A Jewish paramilitary organization in the British Mandate of Palestine (1921–48), which became the core of the Israel Defense Forces (IDF)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
