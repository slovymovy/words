                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proteome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d95212f-7122-38a6-9191-6de795522088",
                                        "entry_id": "2951f1f2-6d0a-3984-8332-6913a010df1f",
                                        "glosses": [
                                            "The complete set of proteins encoded by a particular genome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "876c8c8a-d578-4d2c-9fe3-43c9ef60a8aa",
                                                "sense_id": "9d95212f-7122-38a6-9191-6de795522088",
                                                "text": "Two-dimensional (2-D) gel electrophoresis allows the separation of thousands of proteins, and provides the means for separating the proteome (the PROTEin complement expressed by a genOME) of a simple species, or the protein component of a complex tissue."
                                            },
                                            {
                                                "example_id": "c0148a75-9baf-4be9-aa24-a6665e41cd36",
                                                "sense_id": "9d95212f-7122-38a6-9191-6de795522088",
                                                "text": "So now the quest is to crack the human proteome – a concept so novel that the term proteome didn't even exist a decade ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "291892df-9250-4ffe-83da-14b644ff2fd5",
                        "source_entry_id": "e8cac823-9a58-39ae-9fba-b6a338712222",
                        "source_sense_id": "78f82c45-e4e4-3b4e-aa7e-76898d5fa623",
                        "target_lang_word": "protéome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protéome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06b7d001-779c-369b-acb8-688666632688",
                                        "entry_id": "fe4d925f-9d23-316f-a591-75ddf4419e58",
                                        "glosses": [
                                            "Ensemble des protéines codées par un génome, à un moment déterminé, et caractérisées par leur quantité et leur conformation."
                                        ],
                                        "tags": [
                                            "Bioinformatique",
                                            "Biologie moléculaire",
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2bad547-742e-40c3-9eac-2651b83ac386",
                                                "sense_id": "06b7d001-779c-369b-acb8-688666632688",
                                                "text": "En outre, l’outil a prédit les protéomes presque complets de 20 autres organismes, dont ceux de la souris, du rat, de la drosophile (mouche du vinaigre), du poisson zèbre et de la bactérie E. coli."
                                            },
                                            {
                                                "example_id": "23a4a267-5cff-495e-abb6-afc0cfdd7c02",
                                                "sense_id": "06b7d001-779c-369b-acb8-688666632688",
                                                "text": "L’absence de peptides spécifiques aux mâles prouve que la dent a appartenu à un individu féminin, mais le « protéome » s’est avéré trop dégradé pour pouvoir conclure quant à l’espèce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
