{
    "word_family": [
        "precipitate",
        "precipitous",
        "precipitously",
        "precipitant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9226ae7c-5a10-3b28-99b1-b0360e19b1fe",
                    "sense_definition": "Any form of water, such as rain, snow, sleet, or hail, that falls to the ground from the atmosphere.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecast predicts heavy <w>precipitation</w> in the form of snow for the entire weekend.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды предсказывает сильные <w>осадки</w> в виде снега на все выходные.",
                                "tr": "Hava durumu tahmini, tüm hafta sonu boyunca kar şeklinde şiddetli <w>yağış</w> bekliyor."
                            }
                        },
                        {
                            "text": "Farmers are worried because there has been very little annual <w>precipitation</w> this year.",
                            "target_lang_translations": {
                                "ru": "Фермеры обеспокоены, так как в этом году выпало очень мало годовых <w>осадков</w>.",
                                "tr": "Çiftçiler endişeli çünkü bu yıl çok az yıllık <w>yağış</w> düştü."
                            }
                        }
                    ],
                    "synonyms": [
                        "rainfall",
                        "downpour"
                    ],
                    "antonyms": [
                        "drought"
                    ],
                    "common_phrases": [
                        "annual precipitation",
                        "heavy precipitation",
                        "frozen precipitation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая форма воды, такая как дождь, снег или град, выпадающая на землю из атмосферы.",
                        "tr": "Atmosferden yeryüzüne düşen yağmur, kar, dolu gibi her türlü su biçimi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осадки",
                                "target_lang_sense_clarification": "атмосферные явления"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yağış",
                                "target_lang_sense_clarification": "yağmur, kar vb. atmosferik olaylar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f9d5394-ccd0-359a-a4fd-6147c3d9f6c0",
                    "sense_definition": "A chemical reaction in which a solid substance forms and settles out of a liquid solution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemical <w>precipitation</w> occurred immediately after the two clear liquids were mixed together.",
                            "target_lang_translations": {
                                "ru": "Химическое <w>осаждение</w> произошло сразу после того, как две прозрачные жидкости были смешаны.",
                                "tr": "İki berrak sıvı karıştırıldıktan hemen sonra kimyasal <w>çökelme</w> gerçekleşti."
                            }
                        },
                        {
                            "text": "Scientists used <w>precipitation</w> to remove impurities from the water sample during the experiment.",
                            "target_lang_translations": {
                                "ru": "Ученые использовали <w>осаждение</w> для удаления примесей из пробы воды во время эксперимента.",
                                "tr": "Bilim insanları, deney sırasında su numunesindeki empüriteleri uzaklaştırmak için <w>çöktürme</w> yöntemini kullandılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "sedimentation",
                        "deposition"
                    ],
                    "antonyms": [
                        "dissolution"
                    ],
                    "common_phrases": [
                        "chemical precipitation",
                        "rate of precipitation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическая реакция, при которой твердое вещество образуется и выделяется из жидкого раствора.",
                        "tr": "Sıvı bir çözeltiden katı bir maddenin oluşarak dibe çökmesi şeklindeki kimyasal tepkime."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осаждение",
                                "target_lang_sense_clarification": "процесс образования осадка"
                            },
                            {
                                "target_lang_word": "выпадение в осадок",
                                "target_lang_sense_clarification": "химическая реакция"
                            },
                            {
                                "target_lang_word": "осадок",
                                "target_lang_sense_clarification": "результат реакции"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çökelme",
                                "target_lang_sense_clarification": "kimyasal süreç"
                            },
                            {
                                "target_lang_word": "çökme",
                                "target_lang_sense_clarification": "katı maddenin sıvıdan ayrılması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6076958-37ce-3a67-817d-9c8cb040880f",
                    "sense_definition": "The quality of acting with unwise or rash haste; sudden speed in action or thought.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general's <w>precipitation</w> in ordering the attack led to an unnecessary loss of troops.",
                            "target_lang_translations": {
                                "ru": "<w>Поспешность</w> генерала при отдаче приказа об атаке привела к ненужным потерям войск.",
                                "tr": "Generalin saldırı emri vermekteki <w>aceleciliği</w>, gereksiz asker kaybına yol açtı."
                            }
                        },
                        {
                            "text": "He realized he had acted with undue <w>precipitation</w> and regretted his impulsive decision.",
                            "target_lang_translations": {
                                "ru": "Он понял, что действовал с излишней <w>опрометчивостью</w>, и пожалел о своем импульсивном решении.",
                                "tr": "Gereksiz bir <w>acelecilikle</w> hareket ettiğini anladı ve bu anlık kararından pişman oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "hastiness",
                        "rashness",
                        "impetuosity"
                    ],
                    "antonyms": [
                        "deliberation",
                        "caution"
                    ],
                    "common_phrases": [
                        "undue precipitation",
                        "act with precipitation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство действовать с неразумной или опрометчивой поспешностью; внезапная быстрота в действиях или мыслях.",
                        "tr": "Düşüncesizce veya aceleyle hareket etme durumu; eylem veya düşüncedeki ani telaş."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поспешность",
                                "target_lang_sense_clarification": "опрометчивость"
                            },
                            {
                                "target_lang_word": "опрометчивость",
                                "target_lang_sense_clarification": "необдуманная быстрота"
                            },
                            {
                                "target_lang_word": "стремительность",
                                "target_lang_sense_clarification": "внезапная скорость"
                            }
                        ],
                        "tr": [
