                "senses": [
                    {
                        "sense_id": "edfab1bc-e635-3074-b76c-934c98521031",
                        "entry_id": "0a4c7ca3-38c7-3a8a-87b0-c649e4c06cc3",
                        "glosses": [
                            "Lehrerin, die Musik unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0141a8b7-c493-45ed-8e46-5fde7bcb961a",
                                "sense_id": "edfab1bc-e635-3074-b76c-934c98521031",
                                "text": "„Der Griechischlehrer, der, wie alle wussten, seine erste Frau an einen Schüler verloren hatte, war inzwischen erneut verheiratet, abermals mit einer sehr jungen und sehr schönen Musiklehrerin.“"
                            },
                            {
                                "example_id": "c4b1bbc8-52a7-41bb-a002-ca228d242a64",
                                "sense_id": "edfab1bc-e635-3074-b76c-934c98521031",
                                "text": "„1882 als Tochter eines Feldwebels und einer Musiklehrerin in Düsseldorf geboren, hatte sie Unterricht bei bedeutenden Pädagogen, darunter bei Theodor Leschetizky, dem Lehrer Artur Schnabels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
