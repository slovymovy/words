                "senses": [
                    {
                        "sense_id": "157149a9-4a34-3379-8303-879ea39f3578",
                        "entry_id": "6d4d85be-0780-317c-9559-112c9e4e011a",
                        "glosses": [
                            "Maßeinheit der Geruchsstoffkonzentration in Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85304cd-ebf6-448e-bb76-3d45291e6b8d",
                                "sense_id": "157149a9-4a34-3379-8303-879ea39f3578",
                                "text": "„Eine Geruchseinheit (GE) ist diejenige Menge (Teilchenzahl) Geruchsträger, die - verteilt in 1m³ Neutralluft – entsprechend der Definition der Geruchsschwelle gerade eben eine Geruchsempfindung auslöst.“"
                            },
                            {
                                "example_id": "27f323cb-1a39-472d-9db2-f4d019430bc2",
                                "sense_id": "157149a9-4a34-3379-8303-879ea39f3578",
                                "text": "„Die Geruchseinheit GE/m³ ist unabhängig von der stofflichen Zusammensetzung des Geruchs.“"
                            },
                            {
                                "example_id": "e5eeaffa-8550-412c-95d0-892549564fe2",
                                "sense_id": "157149a9-4a34-3379-8303-879ea39f3578",
                                "text": "„Die Einheit der Größe ”Geruchsstoffkonzentration” ist Geruchseinheit (GE) durch Volumeneinheit (m³), also GE/m³.“"
                            },
                            {
                                "example_id": "c4c92f6a-79c4-480f-8ed1-acc0ed411c85",
                                "sense_id": "157149a9-4a34-3379-8303-879ea39f3578",
                                "text": "„Der Geruchsstoffstrom (Geruchseinheiten GE/m³), ermittelt aus Emissionsmassenstrom (m³/h) und Geruchsstoffkonzentration in der Abluft (GE/h) […]“"
                            },
                            {
                                "example_id": "b165a63a-665b-4835-8dc4-6d7f7dbe98db",
                                "sense_id": "157149a9-4a34-3379-8303-879ea39f3578",
                                "text": "„In der Ausbreitungsrechnung werden zunächst Konzentrationswerte für den emittierten Geruchsstoff (GE/m³ - Geruchseinheit pro Kubikmeter) berechnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
