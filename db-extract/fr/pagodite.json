                        "sense_id": "6db96c21-e13a-3590-94f3-6d734a567fdf",
                        "entry_id": "d029a04e-6395-3c9a-ae9b-e02506622344",
                        "glosses": [
                            "Nom donné à différents silicates du groupe des argiles utilisés en Chine pour tailler de petites figurines nommés magots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35708e12-9c02-4708-bf7a-efb3f02fac97",
                                "sense_id": "6db96c21-e13a-3590-94f3-6d734a567fdf",
                                "text": "On trouve sous le nom de pagodite des silicates d'aluminium proche de la pyrophyllite, ainsi que des silicates de magnésium. Les couleurs les plus courantes de le pagodite sont le blanc, le rouge et le vert."
                            },
                            {
                                "example_id": "5f57e5fe-5ecd-4063-b8d9-d67fe5b3eee2",
                                "sense_id": "6db96c21-e13a-3590-94f3-6d734a567fdf",
                                "text": "Les Khas Lovés, du village de Vong Sa, utilisent ces galets de pagodite et en font surtout des pipes artistement travaillées."
                            }
                        ]
                    }
                ],
