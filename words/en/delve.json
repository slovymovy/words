{
    "word_family": [
        "delver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "039c49b1-1cee-382f-9159-e517ed44ae88",
                    "sense_definition": "To search thoroughly and carefully for information or to investigate a subject in great detail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist decided to <w>delve</w> into the archives to find the truth about the old scandal.",
                            "target_lang_translations": {
                                "ru": "Журналист решил <w>покопаться</w> в архивах, чтобы выяснить правду о старом скандале.",
                                "cs": "Novinář se rozhodl <w>pátrat</w> v archivech, aby zjistil pravdu o starém skandálu."
                            }
                        },
                        {
                            "text": "She was intensely eager to <w>delve</w> into the mystery of the missing documents.",
                            "target_lang_translations": {
                                "ru": "Ей очень хотелось <w>вникнуть</w> в тайну пропавших документов.",
                                "cs": "Byla velmi dychtivá <w>zkoumat</w> záhadu ztracených dokumentů."
                            }
                        }
                    ],
                    "synonyms": [
                        "investigate",
                        "research"
                    ],
                    "antonyms": [
                        "ignore",
                        "neglect"
                    ],
                    "common_phrases": [
                        "delve into the mystery",
                        "delve into the past",
                        "delve deeper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно и внимательно искать информацию или детально исследовать какой-либо вопрос.",
                        "cs": "Důkladně a pečlivě vyhledávat informace nebo podrobně zkoumat nějaké téma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углубляться",
                                "target_lang_sense_clarification": "в изучение вопроса или темы"
                            },
                            {
                                "target_lang_word": "копаться",
                                "target_lang_sense_clarification": "в книгах, документах или деталях"
                            },
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "в архивах или бумагах"
                            },
                            {
                                "target_lang_word": "вникать",
                                "target_lang_sense_clarification": "в суть дела"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pátrat",
                                "target_lang_sense_clarification": "intenzivně se snažit najít informace"
                            },
                            {
                                "target_lang_word": "zkoumat",
                                "target_lang_sense_clarification": "podrobně studovat danou problematiku"
                            },
                            {
                                "target_lang_word": "hrabat se",
                                "target_lang_sense_clarification": "neformálně prohledávat (např. v archivech)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce69399c-17b8-32c4-8180-e6a72deaa5b0",
                    "sense_definition": "To dig into the ground, especially using a tool like a shovel or spade.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener began to <w>delve</w> into the hard soil to prepare the flower bed for spring.",
                            "target_lang_translations": {
                                "ru": "Садовник начал <w>копать</w> твердую почву, чтобы подготовить клумбу к весне.",
                                "cs": "Zahradník začal <w>rýt</w> tvrdou půdu, aby připravil záhon na jaro."
                            }
                        },
                        {
                            "text": "He spent the entire afternoon helping his father <w>delve</w> the earth for the new fence posts.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, помогая отцу <w>рыть</w> землю под новые столбы для забора.",
                                "cs": "Strávil celé odpoledne tím, že pomáhal otci <w>kopat</w> zem pro nové sloupky plotu."
                            }
                        }
                    ],
                    "antonyms": [
                        "fill"
                    ],
                    "common_phrases": [
                        "delve the earth"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often replaced by 'dig' in modern contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Копать землю, особенно с использованием инструментов, таких как лопата.",
                        "cs": "Kopat do země, zejména pomocí nástroje, jako je rýč nebo lopata."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копать",
                                "target_lang_sense_clarification": "землю или яму"
                            },
                            {
                                "target_lang_word": "рыть",
                                "target_lang_sense_clarification": "углубление в почве"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "kopat",
                                "target_lang_sense_clarification": "vytvářet prohlubeň v zemi pomocí nástroje"
                            },
                            {
                                "target_lang_word": "rýt",
                                "target_lang_sense_clarification": "obdělávat půdu rýčem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "917f2a69-2cdf-3d05-b81b-997798e902ad",
                    "sense_definition": "A pit, den, or a hole made by digging.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "excavation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal retreated into a deep <w>delve</w> far beneath the roots of the ancient tree.",
                            "target_lang_translations": {
                                "ru": "Животное скрылось в глубокой <w>норе</w> далеко под корнями древнего дерева.",
                                "cs": "Zvíře se stáhlo do hluboké <w>nory</w> daleko pod kořeny starého stromu."
                            }
                        },
                        {
                            "text": "I put the clods on top the <w>delve</w> and gave it all a good thumping down with my feet.",
                            "target_lang_translations": {
                                "ru": "Я положил комья земли поверх <w>ямы</w> и хорошенько притоптал всё это ногами.",
                                "cs": "Hroudy jsem dal navrch <w>jámy</w> a všechno jsem to pořádně udusal nohama."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Яма, логово или отверстие, сделанное путем копания.",
                        "cs": "Jáma, doupě nebo otvor vytvořený kopáním."
                    },
                    "translations": {
