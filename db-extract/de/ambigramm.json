                "senses": [
                    {
                        "sense_id": "e7ef019c-c36c-35af-9e66-e8c1d277af8b",
                        "entry_id": "aae9f983-9d5a-3e23-818f-d595b06854dc",
                        "glosses": [
                            "Symbol oder Schriftzug, bei dem durch andere Anordnung (zum Beispiel durch Drehung) derselbe oder ein neuer Schriftzug/Symbol zu sehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3751f951-0b42-42e4-96e7-8fe8d5875bbb",
                                "sense_id": "e7ef019c-c36c-35af-9e66-e8c1d277af8b",
                                "text": "Ambigramme werden auch gerne als Vorlage für Tattoos genommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "138a041e-b9e0-4f8b-befb-f7028fee594e",
                        "source_entry_id": "aae9f983-9d5a-3e23-818f-d595b06854dc",
                        "source_sense_id": "e7ef019c-c36c-35af-9e66-e8c1d277af8b",
                        "source_sense_description": "Symbol oder Schriftzug, bei dem durch andere Anordnung ein neuer Schriftzug/Symbol zu sehen ist",
                        "target_lang_word": "ambigram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambigram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb8db258-cd36-317e-b054-4e2f24b3a204",
                                        "entry_id": "d010edcf-1a38-3957-a592-71f6e765b1da",
                                        "glosses": [
                                            "A calligraphic design that may be read as the same word or phrase (or sometimes different words or phrases) when oriented in two different ways, usually when reflected along a vertical or horizontal axis or when rotated through 180 degrees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30acbf38-1f3a-45e2-8b29-997008df24b9",
                                                "sense_id": "fb8db258-cd36-317e-b054-4e2f24b3a204",
                                                "text": "Two nonvisual factors provide dissymmetry and prevent the ambigram from existing in a static equilibrium; most of the letters in an ambigram metamorphose into other letters when reversed; and each of those accompanying sentences provides a different idea of the word's meaning."
                                            },
                                            {
                                                "example_id": "96d685c8-eb77-40a6-8ddd-3bef7a68f38b",
                                                "sense_id": "fb8db258-cd36-317e-b054-4e2f24b3a204",
                                                "text": "1997, Research and Education Networking, Volume 8, Issues 1-6, page 290,\nAn ambigram is a word that reads the same right-side-up and upside-down. MOW is a natural ambigram, for instance, but any word can be flipped if the right graphic artist gets his hands on it."
                                            },
                                            {
                                                "example_id": "0009e08d-92bd-4453-adea-5241e9e9d6ae",
                                                "sense_id": "fb8db258-cd36-317e-b054-4e2f24b3a204",
                                                "text": "Next, I imagine that Switch #2 causes me every single weekend (and every other spare moment as well) to elect, instead of designing ambigrams or working hard on my book about being a strange loop, to spend hours on end watching professional football games on a huge-screen television and delightedly ogling all the busty babes in the beer ads."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d91b0f27-ebfb-4368-ba1b-f59969790d6d",
                        "source_entry_id": "aae9f983-9d5a-3e23-818f-d595b06854dc",
                        "source_sense_id": "e7ef019c-c36c-35af-9e66-e8c1d277af8b",
                        "source_sense_description": "Symbol oder Schriftzug, bei dem durch andere Anordnung ein neuer Schriftzug/Symbol zu sehen ist",
