                        "examples": [
                            {
                                "example_id": "d077791b-ab0a-476b-bc5e-5e8493a37bcf",
                                "sense_id": "dc88d1f8-920e-3601-b85a-177293f2247e",
                                "text": "W tym jasnym widzeniu historii nie było miejsca na mitologizowanie dulszczyzny. Mitologizowanie to uprawiała szczególnie literatura naturalistyczna, nie wychodząca na ogół poza krąg wyolbrzymionego świata drobnomieszczańskiego"
                            },
                            {
                                "example_id": "90672207-bd3e-4529-9c32-9a0ee4bf2f39",
                                "sense_id": "dc88d1f8-920e-3601-b85a-177293f2247e",
                                "text": "Po zamachu majowym, który również nie osłabił mitologizowania Marszałka, obóz sanacyjny mógł już bez większych przeszkód kreować własną wizję odzyskania niepodległości"
                            }
                        ],
