                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fc8e1417-e32e-4314-b3a7-11d99d87d9f4",
                                "sense_id": "fd9b6f99-b965-3dac-bc26-cbeac23dc6d9",
                                "text": "„Ännchen hat ein ganz nasses Gesicht gehabt, und meine Mutter hat auch immer mit dem Sacktuch die Augen gewischt, und die Cora ist blaß gewesen. Sie hat aber gesagt, man muß nicht traurig sein, sondern man muß sich freuen auf das Wiedersehen.“"
                            },
                            {
                                "example_id": "5dcd98a7-3260-444d-a313-87bf8fd9ef6b",
                                "sense_id": "fd9b6f99-b965-3dac-bc26-cbeac23dc6d9",
                                "text": "„Und er überreichte ihm das Sacktuch mit dem eingeknoteten Geld.“"
                            },
                            {
                                "example_id": "5f3a4d5e-f021-4f43-8fbb-42f15887146c",
                                "sense_id": "fd9b6f99-b965-3dac-bc26-cbeac23dc6d9",
                                "text": "„Viktor Emanuel hat die Strauchen und braucht täglich drei neue Sacktücher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
