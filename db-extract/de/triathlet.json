                        "examples": [
                            {
                                "example_id": "f2984253-de99-4b21-b6b9-297eb1e6f4df",
                                "sense_id": "7b01b41b-3238-3916-8042-1bf2644a3afa",
                                "text": "„Wir entscheiden auch nicht immer im Sinne der NADA: Triathlet Michael Weiss wurde von uns freigesprochen, weil Zeugen vor uns nicht erschienen sind.“"
                            },
                            {
                                "example_id": "1faed156-0592-4f78-823a-e20c37f83990",
                                "sense_id": "7b01b41b-3238-3916-8042-1bf2644a3afa",
                                "text": "„Erst seit Anfang Mai betreut er Hentzel, der zuvor zwei Jahre ohne Trainer war. Ein Fehler, wie der Triathlet im Nachhinein feststellen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
