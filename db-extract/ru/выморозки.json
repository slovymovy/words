                "senses": [
                    {
                        "sense_id": "24eb8c11-dc61-38bd-a7e5-bf0f58f59d18",
                        "entry_id": "0eb40bee-5288-358e-a533-c8beb4116f38",
                        "glosses": [
                            "спец., устар. алкогольные напитки, сделавшиеся крепче оттого, что выморожена входившая в их состав вода"
                        ],
                        "tags": [
                            "ед. нет"
                        ],
                        "examples": [
                            {
                                "example_id": "2d2f0315-ebfb-40a6-aaf7-2cc29af7c0bc",
                                "sense_id": "24eb8c11-dc61-38bd-a7e5-bf0f58f59d18",
                                "text": "Большая часть офицеров пила выморозки…"
                            },
                            {
                                "example_id": "0e88b7eb-f9f3-4fc4-824f-62befa595322",
                                "sense_id": "24eb8c11-dc61-38bd-a7e5-bf0f58f59d18",
                                "text": "Мало содрать с живого кожу — так давай закапывать в лёд, как бутылку вина на выморозки!"
                            },
                            {
                                "example_id": "da45246d-8d40-4418-8cda-fa259b571380",
                                "sense_id": "24eb8c11-dc61-38bd-a7e5-bf0f58f59d18",
                                "text": "Я подошёл к дремавшей в углу Кире со стаканом чудесных выморозков и начал тост — что-то насчёт огненных глаз, освещающих нам путь, — но она меня перебила…"
                            },
                            {
                                "example_id": "4bbd101f-675c-4783-b9ac-339895ac9bf8",
                                "sense_id": "24eb8c11-dc61-38bd-a7e5-bf0f58f59d18",
                                "text": "— Гаврилыч… Поищи-ка там, в задке брички моей, выморозки там остались домашние. Откупори да разлей по стаканам."
                            }
                        ]
                    }
