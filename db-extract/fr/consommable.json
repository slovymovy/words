                    {
                        "sense_id": "114d65df-36a8-3462-b676-869edbf1e461",
                        "entry_id": "8e79e3c5-5625-37cc-b34a-b4445ca893da",
                        "glosses": [
                            "Produit dont l’utilisation entraîne sa destruction ou une telle altération qu’il doit être remplacé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb5b7ff-5aac-4e5e-bb51-c6d2344576c8",
                                "sense_id": "114d65df-36a8-3462-b676-869edbf1e461",
                                "text": "« Un animal de compagnie n’est ni un consommable ni un jouet » : le ministre de l'Agriculture annonce un renforcement des mesures de protection des animaux de compagnie"
                            },
                            {
                                "example_id": "8edc3fb3-410b-47bf-80b9-86051ff84849",
                                "sense_id": "114d65df-36a8-3462-b676-869edbf1e461",
                                "text": "Les conducteurs de deux-roues y trouveront également des équipements (blousons, casques...), des pièces et des consommables."
                            }
                        ]
                    },
                    {
                        "sense_id": "91b7b6ab-0dfd-35d9-958a-aca0822aa966",
                        "entry_id": "8e79e3c5-5625-37cc-b34a-b4445ca893da",
                        "glosses": [
                            "Produit constituant une recharge pour un certain type de matériel."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f0308467-9a80-4a97-a0fa-d95d1f7a9088",
                                "sense_id": "91b7b6ab-0dfd-35d9-958a-aca0822aa966",
                                "text": "La limitation volontaire des fonctionnalités qui ne sont pas liées à l’absence d’un consommable quelconque serait ainsi un moyen pour la marque de forcer la vente de cartouches, y compris si l’utilisateur ne souhaite pas imprimer, mais simplement utiliser des fonctions annexes de son imprimante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aac3128a-eecb-4acf-987a-b8d307660bd8",
                        "source_entry_id": "8e79e3c5-5625-37cc-b34a-b4445ca893da",
