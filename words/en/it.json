{
    "word_family": [
        "itself",
        "its"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "7ff7f9f3-228d-3a69-95f4-bd985f20f9dc",
                    "sense_definition": "The third-person singular neuter personal pronoun used to refer to an inanimate object, abstract entity, or non-human living thing.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronoun_referent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Take this book and put <w>it</w> on the shelf.",
                            "target_lang_translations": {
                                "ru": "Возьми эту книгу и положи <w>её</w> на полку."
                            }
                        },
                        {
                            "text": "I found a poor little cat and <w>it</w> seems to be half starving.",
                            "target_lang_translations": {
                                "ru": "Я нашел бедного котенка, и кажется, <w>он</w> умирает от голода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "put it on",
                        "take it as"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личное местоимение третьего лица единственного числа, используемое для обозначения неодушевленного предмета, абстрактного понятия или животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "он",
                                "target_lang_sense_clarification": "для существительных мужского рода"
                            },
                            {
                                "target_lang_word": "она",
                                "target_lang_sense_clarification": "для существительных женского рода"
                            },
                            {
                                "target_lang_word": "оно",
                                "target_lang_sense_clarification": "для существительных среднего рода"
                            },
                            {
                                "target_lang_word": "это",
                                "target_lang_sense_clarification": "указание на предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df14e691-e464-3257-84d9-1dc391ad55f3",
                    "sense_definition": "The impersonal pronoun used as the subject of a statement about weather, time, or distance.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dummy_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>It</w> is nearly ten o'clock in the morning.",
                            "target_lang_translations": {
                                "ru": "<w>Сейчас</w> почти десять часов утра."
                            }
                        },
                        {
                            "text": "<w>It</w> is very cold today so you should wear a coat.",
                            "target_lang_translations": {
                                "ru": "Сегодня очень <w>холодно</w>, так что тебе стоит надеть пальто."
                            }
                        }
                    ],
                    "common_phrases": [
                        "it is cold",
                        "it is time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безличное местоимение, используемое в качестве подлежащего в предложениях о погоде, времени или расстоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "это",
                                "target_lang_sense_clarification": "в безличных предложениях"
                            },
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "при указании времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8c3fe1c-7cdc-3993-92e7-834908e70ee4",
                    "sense_definition": "Used to identify a person, often when they are not yet known or are on the phone.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hello, <w>it</w> is me, John, calling from the office.",
                            "target_lang_translations": {
                                "ru": "Привет, <w>это</w> я, Джон, звоню из офиса."
                            }
                        },
                        {
                            "text": "Someone is at the door; who is <w>it</w>?",
                            "target_lang_translations": {
                                "ru": "Кто-то у двери; кто <w>это</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "it is me",
                        "who is it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для идентификации личности, часто когда человек еще не известен или при разговоре по телефону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "это",
                                "target_lang_sense_clarification": "при представлении или опознании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b328353f-1528-396e-8725-dd8a5766571e",
                    "sense_definition": "A third-person singular personal pronoun used to refer to a baby or child, especially when the gender is unknown.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "pronoun_referent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took the baby and held <w>it</w> tenderly in her arms.",
                            "target_lang_translations": {
                                "ru": "Она взяла младенца и нежно держала <w>его</w> на руках."
                            }
                        },
                        {
                            "text": "The poor baby was crying because <w>it</w> was hungry.",
                            "target_lang_translations": {
                                "ru": "Бедный малыш плакал, потому что <w>он</w> был голоден."
                            }
                        }
                    ],
                    "common_phrases": [
                        "held it in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личное местоимение третьего лица единственного числа, используемое по отношению к младенцу или ребенку, особенно если пол неизвестен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "он",
                                "target_lang_sense_clarification": "о ребенке (м.р.)"
                            },
                            {
                                "target_lang_word": "она",
                                "target_lang_sense_clarification": "о ребенке (ж.р.)"
                            },
                            {
                                "target_lang_word": "оно",
                                "target_lang_sense_clarification": "о младенце (ср.р.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df8a4520-3c0f-36b0-a4fa-22da4bb7b45c",
                    "sense_definition": "A placeholder for a delayed subject or object, often followed by a 'to' infinitive or a 'that' clause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dummy_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>It</w> is easy to see how she would think that.",
                            "target_lang_translations": {
                                "ru": "Легко <w>понять</w>, почему она так подумала."
                            }
                        },
                        {
                            "text": "I find <w>it</w> odd that you would say such a thing.",
                            "target_lang_translations": {
                                "ru": "Мне кажется <w>странным</w>, что ты такое говоришь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "it is easy",
                        "find it odd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное подлежащее или дополнение, за которым обычно следует инфинитив с 'to' или придаточное предложение с 'that'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "это",
                                "target_lang_sense_clarification": "вводное слово в предложении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a507900-9d4f-3e77-af61-44e9254a64ab",
                    "sense_definition": "The end of something; a situation where there is no more of something or no further action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are there more students in this class, or is this <w>it</w>?",
                            "target_lang_translations": {
                                "ru": "В этом классе есть еще ученики или это <w>все</w>?"
                            }
                        },
                        {
                            "text": "That is <w>it</w>, I am not going to any more stores today.",
                            "target_lang_translations": {
                                "ru": "На этом <w>всё</w>, я больше не пойду сегодня по магазинам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "this is it",
                        "that is it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in spoken English to signal completion."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конец чего-либо; ситуация, когда больше ничего нет или никакие дальнейшие действия невозможны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё",
                                "target_lang_sense_clarification": "в значении завершения"
                            },
                            {
                                "target_lang_word": "это всё",
                                "target_lang_sense_clarification": "конец ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8ca12ab-9f32-3bc6-8434-9d0f458f73f4",
                    "sense_definition": "A desirable quality or ability, especially the quality of being successful or fashionable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After all these years of performing, she still has <w>it</w>.",
                            "target_lang_translations": {
                                "ru": "После стольких лет выступлений у неё всё еще есть <w>талант</w>."
                            }
                        },
                        {
                            "text": "He really has <w>it</w> when it comes to public speaking.",
                            "target_lang_translations": {
                                "ru": "У него действительно есть <w>дар</w>, когда дело касается публичных выступлений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "still got it",
                        "has it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe an intangible star quality."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Желаемое качество или способность, особенно качество успеха или обаяния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "талант",
                                "target_lang_sense_clarification": "особая искра"
                            },
                            {
                                "target_lang_word": "изюминка",
                                "target_lang_sense_clarification": "неуловимое качество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26e631cb-fab4-397a-b888-ee46d2f812dd",
                    "sense_definition": "Referring to sexual intercourse or other sexual activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "euphemism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I caught them doing <w>it</w> in the back of the car.",
                            "target_lang_translations": {
                                "ru": "Я застукал их за <w>этим</w> на заднем сиденье машины."
                            }
                        },
                        {
                            "text": "Is man really the only animal who does <w>it</w> face to face?",
                            "target_lang_translations": {
                                "ru": "Неужели человек — единственное животное, которое делает <w>это</w> лицом к лицу?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "doing it",
                        "getting it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "A common euphemism for sex."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначение полового акта или другой сексуальной активности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "это",
                                "target_lang_sense_clarification": "эвфемизм для секса"
                            },
                            {
                                "target_lang_word": "заниматься этим",
                                "target_lang_sense_clarification": "о сексе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b8cdcb2-bce9-3b4d-8e31-6a04f95c32da",
                    "sense_definition": "Abbreviation for information technology.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you tried calling the <w>IT</w> department to fix your computer?",
                            "target_lang_translations": {
                                "ru": "Ты пробовал звонить в <w>ИТ</w>-отдел, чтобы починить компьютер?"
                            }
                        },
                        {
                            "text": "He works in <w>IT</w> and manages all the company servers.",
                            "target_lang_translations": {
                                "ru": "Он работает в сфере <w>информационных технологий</w> и управляет всеми серверами компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "info tech"
                    ],
                    "common_phrases": [
                        "IT department",
                        "IT systems"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура для информационных технологий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ИТ",
                                "target_lang_sense_clarification": "информационные технологии"
                            },
                            {
                                "target_lang_word": "ай-ти",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "831c2ebd-2caa-337e-849d-8a3517374278",
                    "sense_definition": "The person who chases and tries to catch other players in the game of tag.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tag, you are <w>it</w>! Now you have to catch me.",
                            "target_lang_translations": {
                                "ru": "Салки, ты <w>во́да</w>! Теперь ты должен меня поймать."
                            }
                        },
                        {
                            "text": "In the next game, Adam and Tom will be <w>it</w>.",
                            "target_lang_translations": {
                                "ru": "В следующей игре Адам и Том будут <w>водить</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "you are it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который догоняет и пытается поймать других игроков в игре в догонялки (салочки)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "во́да",
                                "target_lang_sense_clarification": "ведущий в игре"
                            },
                            {
                                "target_lang_word": "водящий",
                                "target_lang_sense_clarification": "тот, кто водит"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ca0e718e-3c58-3df9-b215-6f2de946a561",
                    "sense_definition": "Most fashionable, popular, or in vogue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This designer handbag is definitely the <w>it</w> bag of the season.",
                            "target_lang_translations": {
                                "ru": "Эта дизайнерская сумка определенно <w>самая модная</w> сумка сезона."
                            }
                        },
                        {
                            "text": "She became the new <w>it</w> girl after her performance in the movie.",
                            "target_lang_translations": {
                                "ru": "Она стала новой <w>иконой стиля</w> после своей роли в кино."
                            }
                        }
                    ],
                    "common_phrases": [
                        "it girl",
                        "it bag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in fashion journalism."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый модный, популярный или актуальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тот самый",
                                "target_lang_sense_clarification": "культовый, популярный"
                            },
                            {
                                "target_lang_word": "самый модный",
                                "target_lang_sense_clarification": "в тренде"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}