                    }
                ],
                "senses": [
                    {
                        "sense_id": "98f07b93-2882-34a5-9f91-0859f4ac63b2",
                        "entry_id": "19f43e4f-45fb-345f-ab29-980124d6b3f1",
                        "glosses": [
                            "naczelny wódz w niektórych armiach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7135d1-aca4-45af-a174-5c33d166c8e6",
                                "sense_id": "98f07b93-2882-34a5-9f91-0859f4ac63b2",
                                "text": "Ale generalissimus Franco zwodził Hitlera. Stawiał niemożliwe do spełnienia żądania finansowe, domagał się tak wielkich dostaw surowców strategicznych, że nie wytrzymałaby tego niemiecka gospodarka"
                            },
                            {
                                "example_id": "22f2f306-58a7-4cc6-a32e-7cedcfeeeaeb",
                                "sense_id": "98f07b93-2882-34a5-9f91-0859f4ac63b2",
                                "text": "Kotielnikow postanowił być szczery i zaryzykować nawet gniew i niełaskę generalissimusa, ale pomysł był idiotyczny, a jego realizacja mogła na lata zaabsorbować będący i tak w fatalnym stanie przemysł stoczniowy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eb5acb5-d974-4b1c-a73c-00a6119ad887",
                        "source_entry_id": "19f43e4f-45fb-345f-ab29-980124d6b3f1",
                        "source_sense_id": "98f07b93-2882-34a5-9f91-0859f4ac63b2",
                        "target_lang_word": "generalissimo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generalissimo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d08b90a-0003-3e19-ac3f-81d35205427b",
                                        "entry_id": "40ef8114-a4cc-3c29-b01d-f95cda13b8b5",
                                        "glosses": [
                                            "A supreme commander of the armed forces of a country, especially one who is also a political leader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b255b5ec-398e-4c83-ab21-be5e1526a1cd",
                                                "sense_id": "1d08b90a-0003-3e19-ac3f-81d35205427b",
                                                "text": "Where stands Marshal Chiang Kai-shek in this conflict of opinion concerning the tactics which China should adopt towards the aggressor? Chiang Kai-shek, according to officials who know his mind with whom I have talked, is all for resistance—as soon as he thinks he can win! “It is a fatal mistake for the Japanese to imagine that I will not fight under any circumstances,” he has said. But the Chinese Generalissimo is too well versed in the philosophy of his country not to recollect that it is foolish to fight with the certainty of defeat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ccb7b13-f412-4dd7-bd73-4ce9fd8219aa",
                        "source_entry_id": "19f43e4f-45fb-345f-ab29-980124d6b3f1",
