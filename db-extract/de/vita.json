                "senses": [
                    {
                        "sense_id": "831a2ab1-4c73-304e-954a-6a57e31d4011",
                        "entry_id": "93161575-dddb-382a-8fba-a4215332b5af",
                        "glosses": [
                            "Lebensbeschreibung Heiliger und antiker oder mittelalterlicher Persönlichkeiten"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "63482148-41fe-40ea-b114-2cb58b3f256a",
                                "sense_id": "831a2ab1-4c73-304e-954a-6a57e31d4011",
                                "text": "„Der französische Zeichner Golo nähert sich der abenteuerlichen Vita eines mysteriösen Schriftstellers.“"
                            },
                            {
                                "example_id": "baebef61-3a53-4400-b729-219fad87d77d",
                                "sense_id": "831a2ab1-4c73-304e-954a-6a57e31d4011",
                                "text": "„Sein Schüler und Nachfolger als Abt von Aniane, Ardo Smaragdus, hat kurz nach dem Tod Benedikts eine Vita des Heiligen geschrieben.“"
                            },
                            {
                                "example_id": "75231d9c-5258-4424-a485-e0d1a7c0eb62",
                                "sense_id": "831a2ab1-4c73-304e-954a-6a57e31d4011",
                                "text": "„Im allgemeinen wird die Vita des [heiligen] Benedikt von vielen immer noch eher ein wenig belächelt und als erbauliche, legendenumrangte [sic!] Literatur verlegen bei Seite gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06cd0b52-6cbe-312d-8d4a-9f526f438889",
                        "entry_id": "93161575-dddb-382a-8fba-a4215332b5af",
                        "glosses": [
                            "persönlicher Lebenslauf"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "63bcc132-339f-42e7-a726-1d219cf7041b",
                                "sense_id": "06cd0b52-6cbe-312d-8d4a-9f526f438889",
                                "text": "„Der französische Zeichner Golo nähert sich der abenteuerlichen Vita eines mysteriösen Schriftstellers.“"
                            },
                            {
                                "example_id": "858c224c-241e-4b76-b2c2-2ac4a5a746ed",
                                "sense_id": "06cd0b52-6cbe-312d-8d4a-9f526f438889",
                                "text": "„26 Jahre ist [er] jung, doch seine Vita liest sich schon extrem beeindruckend.“"
                            },
                            {
                                "example_id": "876946af-3c16-416e-8cde-bb44dd6f1782",
                                "sense_id": "06cd0b52-6cbe-312d-8d4a-9f526f438889",
                                "text": "„Er verschwieg Fakten aus seiner Vita.“"
                            },
                            {
                                "example_id": "5d660749-1541-48e0-b3bf-13954badc62a",
                                "sense_id": "06cd0b52-6cbe-312d-8d4a-9f526f438889",
                                "text": "„Mit der Ehrung Jüngers steht in Frankfurt zugleich das zur Diskussion und Kritik, was seine Vita in seltener Komprimierung enthält – die in die Gegenwart hineinragende, offenbar erst ansatzweise aufgearbeitete deutsche Geschichte des 20. Jahrhunderts.“"
                            },
                            {
                                "example_id": "5ff5fa9b-9e04-433e-a8fa-41626374613a",
                                "sense_id": "06cd0b52-6cbe-312d-8d4a-9f526f438889",
                                "text": "[Über die Kanzlerkandidatin Annalena Baerbock 2021:] „Wie gut Baerbock Politik macht, entscheidet sich nicht an der Frage, ob sie ihre Vita etwas geliftet hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
