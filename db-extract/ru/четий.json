                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64f78ac6-355f-3eae-ba59-34d2d3cd637f",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "The process of interpreting written language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ba43569-d244-4966-89c1-15e857ea0c56",
                                                "sense_id": "64f78ac6-355f-3eae-ba59-34d2d3cd637f",
                                                "text": "The student is behind in his reading by several chapters."
                                            },
                                            {
                                                "example_id": "73a812f7-56c1-41bb-84b8-7d4c415b3868",
                                                "sense_id": "64f78ac6-355f-3eae-ba59-34d2d3cd637f",
                                                "text": "That's my reading of the current situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f56cb1-461b-3eef-b946-d47e28d2629c",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "The process of interpreting written language.",
                                            "The process of interpreting a symbol, a sign or a measuring device."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b62bc648-c94b-338b-b0c6-a27a0306147e",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "The process of interpreting written language.",
                                            "An interpretation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34def6cb-3483-35fc-b05e-b7134b921c49",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "A value indicated by a measuring device."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620202c3-dc3c-4c33-aeb9-4fedfda2c443",
                                                "sense_id": "34def6cb-3483-35fc-b05e-b7134b921c49",
                                                "text": "He glanced across and took note of the speedometer reading."
                                            },
                                            {
                                                "example_id": "da9f9ff9-af3e-4908-98b0-272eead455f7",
                                                "sense_id": "34def6cb-3483-35fc-b05e-b7134b921c49",
                                                "text": "He noted that fine dust readings have been higher in Seoul than in Beijing recently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0afa5e61-af41-3d7f-a024-5b20d0f2fe2b",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "An event at which written material is read aloud."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "634d3fd0-fabb-457f-822d-69ea7fabc9c0",
                                                "sense_id": "0afa5e61-af41-3d7f-a024-5b20d0f2fe2b",
                                                "text": "I attended a poetry reading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94461631-0da6-3e42-a83c-6b07e54b46db",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "A pronunciation associated with a particular character or word; particularly in East Asian scripts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbccf33e-d3fd-4d7d-8460-b7dd9095a3cf",
                                                "sense_id": "94461631-0da6-3e42-a83c-6b07e54b46db",
                                                "text": "Some Chinese characters have numerous readings."
                                            },
                                            {
                                                "example_id": "18c89710-6af4-43c9-a921-647fde981204",
                                                "sense_id": "94461631-0da6-3e42-a83c-6b07e54b46db",
                                                "text": "Recent reports from Taiwan (Formosa), although fragmentary, begin to give a picture of economic conditions following the conclusion of the war. Now officially referred to as Taiwan Province, the island's former Japanese administration is being replaced by Chinese officials with little change, at least as yet, in the administrative pattern. Although there is no indication that ideographs will be changed, Chinese readings rather than Japanese will be followed for place names. Taihoku, for example, will be read in our alphabet as Taipei. This city presumably will continue to be the capital of Taiwan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d17a12ac-e5e7-32e2-ae70-602f2b8f2a27",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "Something to read; reading material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae900a22-7fa0-36d8-920a-7e1e5ffc1901",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "The extent of what one has read."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5856633e-416d-48c5-a68d-f265cd9f4a30",
                                                "sense_id": "ae900a22-7fa0-36d8-920a-7e1e5ffc1901",
                                                "text": "He's a man of good reading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "952ff6ec-bcb0-3f32-809c-82f674cd5a49",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "One of several stages a bill passes through before becoming law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01c5a0cd-d293-3f58-943c-68c0b79d255d",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "A piece of literature or passage of scripture read aloud to an audience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "573a3a33-125c-4d89-ad3d-2c7349491bf1",
                                                "sense_id": "01c5a0cd-d293-3f58-943c-68c0b79d255d",
                                                "text": "After the homily there will be two readings from the Bible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d309cf3-e7e8-39b9-b48d-eb3a07ee2223",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "The content of a reading list."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2bbc363-7c0d-37f4-8374-40674b8bbdde",
                                        "entry_id": "b483f0f7-0889-37ac-8dab-1907bfd748b8",
                                        "glosses": [
                                            "The act or process of imagining sequences of potential moves and responses without actually placing stones."
                                        ],
