                "senses": [
                    {
                        "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                        "entry_id": "d8ddaf09-7346-3f66-823a-68ffb7a58a9a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7627f4c2-884d-41ff-9835-083a02553444",
                                "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                                "text": "Frau Heverhagen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d585723e-9d3a-44e1-82e1-0fa0da6ed094",
                                "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                                "text": "Herr Heverhagen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "16092ecf-9e92-45d7-8286-5c25109460d1",
                                "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                                "text": "Die Heverhagens fliegen heute nach Sydney."
                            },
                            {
                                "example_id": "19ad968f-5d35-42d8-8dc1-76cba07f1040",
                                "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                                "text": "Der Heverhagen trägt nie die Pullover, die die Heverhagen ihm strickt."
                            },
                            {
                                "example_id": "5cb06a8a-73fa-459c-8ad1-30a1c81cbbc0",
                                "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heverhagen kommt, geht der Herr Heverhagen.“"
                            },
                            {
                                "example_id": "e1457e3c-9f1e-4f50-b49e-f7b48270f5a7",
                                "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                                "text": "Heverhagen kommt und geht."
                            },
                            {
                                "example_id": "b006524c-e2bc-4365-95ec-864dfb53de94",
                                "sense_id": "51ab423e-2e61-356a-a351-0197d24f05a9",
                                "text": "Heverhagens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
