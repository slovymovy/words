        "fr-extract.jsonl": [
            {
                "entry_id": "6478adb6-2c53-33fc-8d74-5d9f3501b4da",
                "word": "événement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d2b29951-dfc4-4e2e-ab53-8e640463c0d8",
                        "entry_id": "6478adb6-2c53-33fc-8d74-5d9f3501b4da",
                        "tags": [
                            "plural"
                        ],
                        "form": "événements"
                    },
                    {
                        "form_id": "ef29ba57-9ba7-498e-8880-28db62853466",
                        "entry_id": "6478adb6-2c53-33fc-8d74-5d9f3501b4da",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "évènement"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                        "entry_id": "6478adb6-2c53-33fc-8d74-5d9f3501b4da",
                        "glosses": [
                            "Variante orthographique de évènement."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4695e5c6-4d00-4b25-b74b-97bbca8a4c2d",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Une accusation de complot contre la vie de Napoléon III fut abandonnée par prudence ; l’idée était dans l’air, on craignait d’évoquer l’événement."
                            },
                            {
                                "example_id": "86e1957a-2742-4e18-b33a-1283ae14c7fd",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Ces légers événements s’évanouissent comme des scènes de comédie sur lesquelles le rideau tombe."
                            },
                            {
                                "example_id": "0b14ee03-2c2c-4568-86da-a2d783e33b74",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Cet événement a pour but de créer, en priorité chez les jeunes, une véritable culture de la sécurité routière en leur apportant les connaissances et les compétences nécessaires pour devenir des usagers de la route responsables et prudents."
                            },
                            {
                                "example_id": "40bd5970-6246-4b06-801e-83e828a0fee6",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Ce fut un événement parisien du plus haut chic."
                            },
                            {
                                "example_id": "b17e4c83-78e9-471b-acb4-95ecf31415ba",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Les événements où vous pourriez sombrer avant longtemps seront des événements européens."
                            },
                            {
                                "example_id": "32b2454e-8e4e-49c6-a887-f6971cd74a93",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Peut-être attendait-il que les événements se précisassent avant de sortir de son maintien."
                            },
                            {
                                "example_id": "c647f2e0-f5ef-49dd-9170-99dda0f47ea7",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "[…] la comtesse fit incarcérer le meurtrier et, après jugement, celui-ci fut pendu. L’exécution eut lieu le jour de Pourim. Quand le roi, informé de l’événement, sut qu’un de ses sujets avait été hissé à la potence le jour où les juifs célébraient, par des réjouissances, le souvenir de la pendaison d’Aman, il entra en fureur."
                            },
                            {
                                "example_id": "d5073927-1b4f-4a6d-b995-8953e0d188ab",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Sans remonter à l’événement traumatique fondateur que furent les massacres de la Saint-Barthélemy, on rappellera que la minorité réformée fut l'objet, sous Louis XIV, d'un « mémoricide » sans précédent : […]."
                            },
                            {
                                "example_id": "c26096a3-bd41-4aef-9e0d-9762245e8d28",
                                "sense_id": "18cfb8f1-6595-308e-8f1f-f5fa00444b28",
                                "text": "Alain Badiou définit l'événement comme quelque chose qui sort de la loi immédiate des choses, qui vient remplir un vide dans une situation, mais sans faire partie de la situation même."
                            }
                        ]
                    }
                ],
