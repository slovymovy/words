                "senses": [
                    {
                        "sense_id": "4947a73a-0296-3f4c-bebf-8b7a2d1968e0",
                        "entry_id": "d0078a76-2856-39ff-998c-4bff36454d59",
                        "glosses": [
                            "Geburt von Kälbern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf99e052-b061-4ef4-a7d5-02c52bbe6193",
                                "sense_id": "4947a73a-0296-3f4c-bebf-8b7a2d1968e0",
                                "text": "„Der Tierarzt schloss Krankheiten aus und stellte bei jeder Kuh fest, wann mit der Kalbung zu rechnen war.“"
                            },
                            {
                                "example_id": "fc2aa481-4705-44b5-9378-8bf725ff73bb",
                                "sense_id": "4947a73a-0296-3f4c-bebf-8b7a2d1968e0",
                                "text": "„Da sie gewohnt war, ihr Herrchen in die Ställe zu begleiten, hatte er sie heute wegen der bevorstehenden Kalbung im Haus gelassen.“"
                            },
                            {
                                "example_id": "c2e20fa9-fb5e-4830-a10a-bbd0d5b12f5d",
                                "sense_id": "4947a73a-0296-3f4c-bebf-8b7a2d1968e0",
                                "text": "„Dabei ist insbesondere die Vermeidung von Verfettung wichtig, da Verfettung vor der Kalbung und Fettabbau nach der Kalbung die Futteraufnahme reduzieren.“"
                            },
                            {
                                "example_id": "b104fe5a-f2ab-4225-80ea-422396b32723",
                                "sense_id": "4947a73a-0296-3f4c-bebf-8b7a2d1968e0",
                                "text": "„Tier hatte die letzte Kalbung nicht überlebt und das Jungtier auch nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
