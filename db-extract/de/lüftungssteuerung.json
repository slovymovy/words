                "senses": [
                    {
                        "sense_id": "a6900ecb-12f9-36bc-bd38-d2f2baebda8f",
                        "entry_id": "70177f2b-bc9c-32f7-beea-bcc474f291a3",
                        "glosses": [
                            "technische Einrichtung zur Lüftungsanlage, um die Funktion zu definieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0e13a0-b48d-4c81-a8a9-2482181b3476",
                                "sense_id": "a6900ecb-12f9-36bc-bd38-d2f2baebda8f",
                                "text": "„Die CO2 Lüftungssteuerung misst laufend das CO2 Gas und entscheidet automatisch wenn die Lüftung einsetzen muss.“"
                            },
                            {
                                "example_id": "70ccbdd6-098f-496f-86e6-545f5a1a6cb9",
                                "sense_id": "a6900ecb-12f9-36bc-bd38-d2f2baebda8f",
                                "text": "„Ziel der Lüftungssteuerung ist ein geringer Lüftungswärmeverlust.“"
                            },
                            {
                                "example_id": "fafa645e-ce3f-48db-b2eb-7ec8786e1263",
                                "sense_id": "a6900ecb-12f9-36bc-bd38-d2f2baebda8f",
                                "text": "„Bei der Sanierung des Gymnasiums in Sonthofen lag der Schwerpunkt auf einer energiesparenden Gebäudetechnik mit automatischer, am tatsächlichen Bedarf ausgerichteten Lüftungssteuerung.“"
                            },
                            {
                                "example_id": "2bcb3193-e0d0-4975-8a40-2d2773b29495",
                                "sense_id": "a6900ecb-12f9-36bc-bd38-d2f2baebda8f",
                                "text": "„Diese elektrische Lüftungssteuerung in Modulbauweise dient zur Ansteuerung von Antrieben zur täglichen Lüftung.“"
                            },
                            {
                                "example_id": "8adc3f74-51a4-4cdf-a482-5b1ca650df69",
                                "sense_id": "a6900ecb-12f9-36bc-bd38-d2f2baebda8f",
                                "text": "„Die intelligente Taupunkt Lüftungssteuerung 100 - 700 entlüftet die Räume nur, wenn die Außenluft überhaupt in der Lage ist Feuchtigkeit aufzunehmen und transportieren zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
