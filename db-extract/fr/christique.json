                                "target_senses": [
                                    {
                                        "sense_id": "bc9add73-3d69-3d64-b457-e6daf1913a81",
                                        "entry_id": "d8ec216a-d0f8-3952-aaaf-0f3312149050",
                                        "glosses": [
                                            "vom Christentum geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a8b394-087b-4b78-89d9-f9db26f0fad6",
                                                "sense_id": "bc9add73-3d69-3d64-b457-e6daf1913a81",
                                                "text": "„Ein Abendland setzt ein Morgenland voraus. Denkt man sie sich zusammen, als zweipolige Welt, so enthält die Idee des christlichen Abendlandes in sich die allgemeinere Vorstellung einer Kultur, die sich gegen die nichtchristlichen Völker Afrikas und Asiens ähnlich abschließt und als einzigartig und höherwertig versteht wie die griechische Welt gegen die ‚Barbaren‘.“"
                                            },
                                            {
                                                "example_id": "a95063e4-39d5-4aea-88a2-c0dbb2eb31fe",
                                                "sense_id": "bc9add73-3d69-3d64-b457-e6daf1913a81",
                                                "text": "„Das Reich der Rus verwandelt sich auf diese Weise nach und nach in ein christliches Imperium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4adbb4a9-13b5-3652-9860-b8a200c84247",
                                        "entry_id": "d8ec216a-d0f8-3952-aaaf-0f3312149050",
                                        "glosses": [
                                            "dem Christentum entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73064440-defb-4360-9cab-3dacdbcbf496",
                                                "sense_id": "4adbb4a9-13b5-3652-9860-b8a200c84247",
                                                "text": "Er führt ein christliches Leben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
