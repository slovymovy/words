                        "examples": [
                            {
                                "example_id": "00670f4e-4f2e-4844-a9b9-9f63ab55e7b4",
                                "sense_id": "e4eff029-0eaf-3ef7-badf-4dace88a1ab4",
                                "text": "„Ich habe mich danach nie wieder im Tabakhandel versucht.“"
                            },
                            {
                                "example_id": "215144c1-f108-4a78-877c-bd5dea45f094",
                                "sense_id": "e4eff029-0eaf-3ef7-badf-4dace88a1ab4",
                                "text": "„Der Tabakanbau wurde in manchen Ländern verboten, andererseits aber – auch hier zeigt sich die Zwiespältigkeit – wurde der Tabakhandel erlaubt, so in England durch König Jacob zu Beginn des 17. Jahrhunderts, hauptsächlich der Zölle und Abgaben wegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a15d4bd-55d5-37bc-8ecb-31ae2fad6b5a",
                        "entry_id": "c1699cdc-9338-3623-bcf6-62a7f1ba7257",
                        "glosses": [
                            "Laden, in dem mit Tabak gehandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f50fda13-820c-4f6a-8795-19bb59b16a11",
                                "sense_id": "9a15d4bd-55d5-37bc-8ecb-31ae2fad6b5a",
                                "text": "Unser Tabakhandel um die Ecke hat die neue Sorte noch nicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "56537dc8-27da-3d67-855b-d07e05a863e6",
                        "entry_id": "c1699cdc-9338-3623-bcf6-62a7f1ba7257",
                        "glosses": [
                            "Gesamtheit der an [1] Beteiligten"
                        ],
                        "tags": [],
                        "examples": [
                            {
