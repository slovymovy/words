                "senses": [
                    {
                        "sense_id": "86828048-154c-3ab0-8a40-70e846bc1c85",
                        "entry_id": "ab41bbee-05bc-393d-876c-572776ff1546",
                        "glosses": [
                            "Chef eines bestimmten Aufgaben- oder Themengebietes (Ressorts)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5dba1b6-696f-412f-885b-533ea6bc176f",
                                "sense_id": "86828048-154c-3ab0-8a40-70e846bc1c85",
                                "text": "„Der auch für den Sport zuständige Ressortchef Seehofer war mit einer Covid-19-Infektion für vier Wochen in häuslicher Quarantäne und ist nach Angaben seines Ministeriums seit Anfang vergangener Woche wieder in seinem Büro in Berlin.“"
                            },
                            {
                                "example_id": "598fdf47-2664-4f0b-9028-61bdb6c71aa6",
                                "sense_id": "86828048-154c-3ab0-8a40-70e846bc1c85",
                                "text": "„[…] An der Zusammenkunft sollen neben Ashton auch US-Außenminister John Kerry, dessen russischer Kollege Sergej Lawrow sowie der ukrainische Ressortchef Andrij Deschtschizia teilnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f767925d-b5b1-4423-b77a-11b67d6105e4",
                        "source_entry_id": "ab41bbee-05bc-393d-876c-572776ff1546",
                        "source_sense_id": "86828048-154c-3ab0-8a40-70e846bc1c85",
