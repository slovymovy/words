                                        "sense_id": "fd273bc4-c3fe-386a-90f2-c17b72bc9a7a",
                                        "entry_id": "d88379ac-1ddd-3360-ab16-6553d62259d1",
                                        "glosses": [
                                            "das Amt und das Verwaltungsgebiet eines Exarchen"
                                        ],
                                        "tags": [
                                            "vor allem Ostkirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c8a70ba-9707-43a1-8e08-7215496883cd",
                                                "sense_id": "fd273bc4-c3fe-386a-90f2-c17b72bc9a7a",
                                                "text": "„Die Exarchate werden für Gläubige außerhalb der Stammgebiete ihrer Kirchen (siehe Diaspora) unterhalten und können sich über ein oder mehrere Länder erstrecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0adcb137-97e9-3f01-a034-2f47f51c8f01",
                                        "entry_id": "d88379ac-1ddd-3360-ab16-6553d62259d1",
                                        "glosses": [
                                            "der byzantische Teil Italiens um das Gebiet von Ravenna, der nach 554 n. Chr. unter einem Exarchen stand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccebe69-44d7-444a-9a12-9d1c90640d7a",
                                                "sense_id": "0adcb137-97e9-3f01-a034-2f47f51c8f01",
                                                "text": "„So schenkten die Kaiser den Besitzungen in Italien nur wenig Aufmerksamkeit, und die regionalen Machthaber im Exarchat Ravenna und im Dukat von Rom mußten sehen, wie sie mit den dortigen Schwierigkeiten fertig wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
