                                "target_senses": [
                                    {
                                        "sense_id": "ca7c3f29-51bb-393d-9aba-6300c0ef957f",
                                        "entry_id": "8db294b6-cf3c-3dc7-83b9-4c350c0a95c8",
                                        "glosses": [
                                            "Alternative spelling of campervan."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3171a9-cd4f-49cd-8312-6f34ecb8536f",
                                                "sense_id": "ca7c3f29-51bb-393d-9aba-6300c0ef957f",
                                                "text": "On Friday, I picked up our camper van, upgraded to a four sleeper so Elysee and I could each find a neutral corner, which I managed to “prang,” navigating the parking lot, within one hour of signing away my house as security."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24b57de6-2076-40bb-899f-9e04f189f73b",
                        "source_entry_id": "58d99297-e039-3f61-8756-a480718e73b3",
                        "source_sense_id": "371eae58-1815-3c81-b043-51dab3371adb",
                        "target_lang_word": "camper",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camper",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "49dc4007-f7a2-3f04-acf6-ac7b9a4279e5",
                                        "entry_id": "0b5f554f-5815-3298-8a16-b93f20805a16",
                                        "glosses": [
                                            "een auto met een extra ruimte waarin men kan overnachten en/of leven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd2fc3ea-ffdb-42a5-97c3-54cf765b3f70",
                                                "sense_id": "49dc4007-f7a2-3f04-acf6-ac7b9a4279e5",
                                                "text": "Het gezin reisde met de camper naar Frankrijk."
                                            },
                                            {
                                                "example_id": "a49bab06-3a87-4f9e-8361-9dd80edab019",
                                                "sense_id": "49dc4007-f7a2-3f04-acf6-ac7b9a4279e5",
                                                "text": "Het is een horrorscène: tandarts Edwin Smith gaat alle tanden trekken van de pas 17-jarige Larry Hammons. Het gebeurt in een tot tandartspraktijk omgebouwde camper op een verlaten parkeerplaats in de Amerikaanse staat Kentucky. Voordat Larry de camper binnenstapt, in de documentaire That Sugar Film, praat de jongen met de Australische filmmaker Damon Gameau. Larry vertelt hoe hij zijn hele jeugd dagelijks liters Mountain Dew dronk, een frisdrank met veel suiker."
                                            },
                                            {
                                                "example_id": "007e4763-b056-4a15-9710-588dab0cc034",
                                                "sense_id": "49dc4007-f7a2-3f04-acf6-ac7b9a4279e5",
                                                "text": "De zelf omgebouwde camper waar hij in woonde was van alle gemakken voorzien, maar hij was minder dan 800 euro per jaar kwijt aan vaste lasten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b825975-d004-4a05-a8da-05e90af51d00",
                        "source_entry_id": "58d99297-e039-3f61-8756-a480718e73b3",
                        "source_sense_id": "371eae58-1815-3c81-b043-51dab3371adb",
