                ],
                "senses": [
                    {
                        "sense_id": "aab4ba2e-02e8-39e9-b68a-37fe8441e902",
                        "entry_id": "4648705d-58b8-3486-9856-4f0db670a984",
                        "glosses": [
                            "Abschluss nach der Beendigung eines Studiums an einer Universität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8724ac-e429-4939-92d5-344775276ba1",
                                "sense_id": "aab4ba2e-02e8-39e9-b68a-37fe8441e902",
                                "text": "„Die Mehrheit dieser Migranten verfügt demnach über einen Universitätsabschluss und ist entsprechend oft überqualifiziert für einfache Tätigkeiten im Zielland.“"
                            },
                            {
                                "example_id": "a3460949-0308-418c-8439-7d966c0f2626",
                                "sense_id": "aab4ba2e-02e8-39e9-b68a-37fe8441e902",
                                "text": "„Das Foto war am Tag ihres Universitätsabschlusses aufgenommen worden; alle drei zeigen ein breites Lächeln, die Augen größer als auf dem vorigen Foto.“"
                            },
                            {
                                "example_id": "65d99a1b-6220-4495-9eea-b5d13c509527",
                                "sense_id": "aab4ba2e-02e8-39e9-b68a-37fe8441e902",
                                "text": "„Die sehr kleine weibliche urbane Oberschicht, die mehr in London, Dubai und Sydney zu Hause ist, international hochwertige Universitätsabschlüsse hat und sich in Wohlfahrtsorganisationen und der Frauenbewegung engagiert, steht dabei einer breiten Masse von Frauen gegenüber, die weder lesen noch schreiben können und zeit ihres Lebens von ihren männlichen Familienangehörigen nicht einmal in das sieben Kilometer entfernte Distriktzentrum zum Einkaufen mitgenommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
