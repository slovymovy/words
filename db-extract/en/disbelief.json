                                    {
                                        "sense_id": "249e5343-39f3-375b-9088-9011d179c6a3",
                                        "entry_id": "0c6e8d00-cad9-3e52-9136-3cd069cacd51",
                                        "glosses": [
                                            "velké překvapení vyvolané neočekávanou událostí"
                                        ],
