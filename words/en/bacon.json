            "senses": [
                {
                    "sense_id": "c0ae7a4c-9bad-3e7c-b6a3-073c60c0bee5",
                    "sense_definition": "Cured meat from the sides, belly, or back of a pig.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For breakfast, we usually have eggs and <w>bacon</w> with some toast.",
                            "target_lang_translations": {
                                "ru": "На завтрак у нас обычно яичница с <w>беконом</w> и тосты."
                            }
                        },
                        {
                            "text": "The chef prepared a delicious dish of fried <w>bacon</w> and beans for the guests.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил для гостей вкусное блюдо из жареного <w>бекона</w> с фасолью."
                            }
                        }
                    ],
                    "synonyms": [
                        "pork"
                    ],
                    "common_phrases": [
                        "fried bacon",
                        "crispy bacon",
                        "bacon and eggs",
                        "smoked bacon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соленое или копченое мясо с боков, живота или спины свиньи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бекон",
                                "target_lang_sense_clarification": "мясной продукт"
                            },
                            {
                                "target_lang_word": "грудинка",
                                "target_lang_sense_clarification": "часть туши"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3270c39b-4a58-3169-8d7b-2fd2160bfc5d",
                    "sense_definition": "A derogatory term used to refer to the police.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers shouted to their friends to run because the <w>bacon</w> was coming.",
                            "target_lang_translations": {
                                "ru": "Подростки крикнули друзьям бежать, потому что ехали <w>легавые</w>."
                            }
                        },
                        {
                            "text": "He used the slang term <w>bacon</w> when talking about the officers who arrived at the scene.",
                            "target_lang_translations": {
                                "ru": "Он использовал сленговое словечко <w>бекон</w>, говоря об офицерах, прибывших на место происшествия."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
