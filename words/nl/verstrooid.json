                    "frequency": "Middle",
                    "semantic_group_id": "mentale toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verstrooide</w> professor kon zijn sleutels nergens meer vinden.",
                            "target_lang_translations": {
                                "en": "The <w>absent-minded</w> professor could not find his keys anywhere."
                            }
                        },
                        {
                            "text": "Hij keek een beetje <w>verstrooid</w> uit het raam tijdens de belangrijke vergadering.",
                            "target_lang_translations": {
                                "en": "He looked out the window a bit <w>distractedly</w> during the important meeting."
                            }
                        }
