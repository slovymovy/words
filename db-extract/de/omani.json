                            "singular"
                        ],
                        "form": "die Omani"
                    },
                    {
                        "form_id": "4360d789-d4c2-4fdf-8dba-aaea6acc7441",
                        "entry_id": "c7d35918-baee-3de6-b4a1-0d63f38abb12",
                        "tags": [
