                                "example_id": "5559d79f-5ca8-4709-a6c0-e791753a65a6",
                                "sense_id": "e086856c-eb31-36c0-b324-2364f55e099b",
                                "text": "„Auf den knarrenden Holzbohlen des Mittelgangs ging er ein paarmal auf und ab.“"
                            },
                            {
                                "example_id": "b4d08cfe-4dc5-4d64-b0ec-d2a3b05b2fcb",
                                "sense_id": "e086856c-eb31-36c0-b324-2364f55e099b",
                                "text": "„Die dicken Holzbohlen des Gebäudes hatten Feuer gefangen und loderten nun knisternd und laut prasselnd zum Himmel auf.“"
                            }
                        ],
