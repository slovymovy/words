                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Palacz</w> odebrała wczoraj nagrodę za wybitne osiągnięcia w dziedzinie chemii.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Паляч</w> получила вчера награду за выдающиеся достижения в области химии."
                            }
                        },
                        {
                            "text": "Do naszego zespołu dołączyła Anna <w>Palacz</w>, która objęła stanowisko księgowej.",
                            "target_lang_translations": {
                                "ru": "К нашей команде присоединилась Анна <w>Паляч</w>, занявшая должность бухгалтера."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie"
                        }
                    ],
                    "target_lang_definitions": {
