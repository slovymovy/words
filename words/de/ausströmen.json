        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6bb3607-9552-339c-b978-9a382972ab9e",
                    "sense_definition": "von Gasen, Dämpfen oder Flüssigkeiten: aus einem Behälter oder einer Öffnung nach außen dringen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "austreten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen eines defekten Ventils <w>strömte</w> gefährliches Gas unbemerkt in den Keller <w>aus</w>."
                        },
                        {
                            "text": "Die Feuerwehr stellte schnell fest, dass giftige Dämpfe aus der Fabrik <w>ausströmen</w>."
                        }
                    ],
                    "synonyms": [
                        "austreten",
                        "entweichen"
                    ],
                    "antonyms": [
                        "einströmen"
                    ],
                    "common_phrases": [
                        "Gas strömt aus"
                    ]
                },
                {
                    "sense_id": "819e8e7e-e6f9-3205-8f9e-e8635ca4da26",
                    "sense_definition": "eine bestimmte Atmosphäre, ein Gefühl oder eine Eigenschaft unwillkürlich nach außen hin spürbar werden lassen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uebertragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die erfahrene Ärztin <w>strömt</w> während der Behandlung eine beruhigende Gelassenheit <w>aus</w>."
                        },
                        {
                            "text": "Das gemütliche Wohnzimmer mit dem Kamin <w>strömt</w> eine wohlige Wärme <w>aus</w>."
                        }
                    ],
                    "synonyms": [
                        "ausstrahlen",
                        "verbreiten"
                    ],
                    "common_phrases": [
                        "Ruhe ausströmen"
                    ]
                },
                {
                    "sense_id": "1d45397a-b3cf-34c8-a0d3-6a32fa03b8ec",
                    "sense_definition": "von einer Menschenmenge: sich in großer Anzahl gemeinsam aus einem Raum oder Gebäude ins Freie bewegen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "menschenmenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Ende des Konzerts <w>strömten</w> tausende begeisterte Besucher aus der Halle <w>aus</w>."
                        },
                        {
                            "text": "Als die Glocke läutete, <w>strömten</w> alle Kinder gleichzeitig aus dem Schulgebäude <w>aus</w>."
                        }
                    ],
                    "synonyms": [
                        "herausströmen",
                        "hinausdrängen"
                    ],
                    "antonyms": [
                        "hineinströmen"
                    ],
                    "common_phrases": [
                        "aus dem Gebäude ausströmen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76b1f586-2f4b-3792-b8ef-081f8fec62a3",
                    "sense_definition": "das Entweichen eines Stoffes oder das Verlassen eines Ortes durch viele Personen; substantivierter Infinitiv von <w>ausströmen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Anwohner bemerkten das unkontrollierte <w>Ausströmen</w> von Gas rechtzeitig und alarmierten die Rettungskräfte."
                        },
                        {
                            "text": "Durch eine defekte Dichtung kam es zum plötzlichen <w>Ausströmen</w> von heißem Dampf in der Werkstatt."
                        }
                    ],
                    "synonyms": [
