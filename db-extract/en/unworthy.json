                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251acd89-c6e0-4ab4-847c-81f07ae5e28f",
                                                "sense_id": "2e2aba81-0543-35e1-aeac-15a20ee6573a",
                                                "text": "C’est une mesure stupide, s’indigne Ivan Sébla, médecin dans les Yvelines."
                                            }
