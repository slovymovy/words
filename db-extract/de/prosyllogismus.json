                "senses": [
                    {
                        "sense_id": "d539ecb2-010d-3031-9e95-efbbeac8793d",
                        "entry_id": "bc2a859c-4c3d-3ab0-a438-8bbced2b92da",
                        "glosses": [
                            "„Der Schluss einer Schlusskette, dessen Schlusssatz die Prämisse des darauffolgenden Schlusses ist.“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1f3a9f-f36f-4f7d-993e-e3abb437e763",
                                "sense_id": "d539ecb2-010d-3031-9e95-efbbeac8793d",
                                "text": "„Der zusammengesetzte vollständige S. (Schlußkette) besteht aus einer Reihe von zwei oder mehreren Schlüssen, bei welchen der Schlußsatz des vorangehenden (Vorschluß, Prosyllogismus) Vordersatz des folgenden (Nachschluß, Episyllogismus) ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
