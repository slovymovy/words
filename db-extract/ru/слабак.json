                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "61d26e16-1443-3e60-b6a9-e13e65490f55",
                        "entry_id": "2f834182-f72b-3aad-b07b-727c5ef846bc",
                        "glosses": [
                            "перен., разг., пренебр. слабовольный, малодушный, ни на что не способный человек"
                        ],
                        "tags": [],
