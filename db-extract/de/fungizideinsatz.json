                "senses": [
                    {
                        "sense_id": "bf2fd961-d69b-3533-904d-042ea826ad5b",
                        "entry_id": "8b89f824-321b-387b-bbbc-9d74da3d980c",
                        "glosses": [
                            "Verwendung/Einsatz von Fungiziden zur Bekämpfung von schädlichen Pilzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4013412e-e6ba-4626-a063-814a841de4c9",
                                "sense_id": "bf2fd961-d69b-3533-904d-042ea826ad5b",
                                "text": "„Der Fungizideinsatz kann durch die Züchtung von pilzresistenten Sorten verringert werden.“"
                            },
                            {
                                "example_id": "c6120be1-6270-4301-b34f-44b8b38e6972",
                                "sense_id": "bf2fd961-d69b-3533-904d-042ea826ad5b",
                                "text": "„Weizen ist weniger krankheitsresistent und benötigt daher mehr Pestizid- und Fungizideinsatz, wodurch Weizen und Weizenprodukte stärker belastet sind.“"
                            },
                            {
                                "example_id": "e729f234-e7e5-43c6-9325-048f38d4a62f",
                                "sense_id": "bf2fd961-d69b-3533-904d-042ea826ad5b",
                                "text": "„Im Wein-, Hopfen- und Erwerbsobstanbau ist unter der derzeitigen Maxime der Intensivagrikultur eine Produktion ohne Fungizideinsatz nicht mehr denkbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
