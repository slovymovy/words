                                                "sense_id": "16e4f735-1e55-3493-9430-b8dff9418a7f",
                                                "text": "„Vögel reagieren instinktiv, wenn ihnen etwas in der Behausung nicht zusagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7478475-8c43-3638-a952-c93e574734ac",
                                        "entry_id": "31f856de-e6e2-31c4-b8b5-f8192a812a9b",
                                        "glosses": [
                                            "ohne langwieriges Nachdenken, dem Gefühl, einem inneren Impuls folgend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca2d140-9ad9-4078-9a7c-8a64102c3eab",
                                                "sense_id": "d7478475-8c43-3638-a952-c93e574734ac",
                                                "text": "„Doch dann habe der Hund die Zweijährige attackiert. Die Mutter habe instinktiv reagiert und rettete ihrer Tochter so vermutlich das Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
