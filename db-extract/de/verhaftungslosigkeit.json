                ],
                "senses": [
                    {
                        "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                        "entry_id": "255faa2f-3a72-380e-9941-f5464d45afcf",
                        "glosses": [
                            "Zustand ohne Verhaftungen; Zustand/Eigenschaft/Haltung, von äußeren Dingen, Wünschen und so weiter nicht gebunden zu sein, (innere) Freiheit zu besitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a6ebfb-23a9-4338-a515-75bb9ad21bfd",
                                "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                                "text": "„Karma Yoga im Alltag: Enthusiasmus und Verhaftungslosigkeit zusammen machen Spiritualität im täglichen Leben aus.“"
                            },
                            {
                                "example_id": "87d16292-94ef-4260-aa6a-f3c6da5275cb",
                                "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                                "text": "„Großzügigkeit macht das Herz leichter und übt uns in Verhaftungslosigkeit.“"
                            },
                            {
                                "example_id": "a3fc9670-05e8-4fb0-b72a-240276160b1b",
                                "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                                "text": "„Shiva ist der Gott der Schöpfung und Zerstörung, der Gegensätze sowie Symbol für Vergänglichkeit, Verhaftungslosigkeit und Auflösung.“"
                            },
                            {
                                "example_id": "e249ca64-1a15-4c2e-8619-b9bbe4e9f759",
                                "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                                "text": "„Wenn die Verhaftungslosigkeit (viraktatva) und der Wunsch nach Befreiung (mumuksha) schwach sind, wirken die 6 Tugenden, wie Stille der Gedanken/ Ruhe des Geistes (shama), nur wie ein Trugbild des Wassers in der Wüste.“"
                            },
                            {
                                "example_id": "78c956bd-5036-4a9e-91a6-2cd8b8262f8d",
                                "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                                "text": "„Letztlich ist Verhaftungslosigkeit der Schlüssel zum Glück:“"
                            },
                            {
                                "example_id": "3545e747-1fbe-4505-a76e-eea080553448",
                                "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                                "text": "„Ein wichtiges Prinzip: Verhaftungslosigkeit ist der Schlüssel für Enthusiasmus auch bei Misserfolgen.“"
                            },
                            {
                                "example_id": "8bc4b174-0872-4ff2-850e-696d73736f98",
                                "sense_id": "9eed5765-756d-3749-b97d-c324b8479c31",
                                "text": "„Was Verhaftungslosigkeit angeht, habe ich die bisher noch nicht geschafft in Bezug auf Menschen, die ich liebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
