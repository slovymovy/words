                "senses": [
                    {
                        "sense_id": "6ea91006-e1d8-3921-94dc-702d8277b239",
                        "entry_id": "204b0558-aaf7-3b3d-be2b-651aee18b48d",
                        "glosses": [
                            "Embaucher plus que ce qui serait nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17de9780-2348-40dc-8cac-a35179b5c073",
                                "sense_id": "6ea91006-e1d8-3921-94dc-702d8277b239",
                                "text": "Par surcroît, elle élargit ses rangs et surembauche."
                            },
                            {
                                "example_id": "8bb5552d-bb6d-463b-99d6-18c3a1e04fe0",
                                "sense_id": "6ea91006-e1d8-3921-94dc-702d8277b239",
                                "text": "Les usines nationalisées surembauchent et les jeunes ingénieurs n'y connaissent plus le repos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afe8ed5e-5327-4d0e-8dbc-d132a306553c",
                        "source_entry_id": "204b0558-aaf7-3b3d-be2b-651aee18b48d",
                        "source_sense_id": "6ea91006-e1d8-3921-94dc-702d8277b239",
                        "target_lang_word": "overhire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overhire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5651fa-a39c-3b10-9da4-ea894f58f7a4",
                                        "entry_id": "5e698eea-cbb5-3551-a265-50cbc3ddd142",
                                        "glosses": [
                                            "To hire too many employees."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f07c191e-812e-4e08-a883-ce4b4852136a",
                                                "sense_id": "0c5651fa-a39c-3b10-9da4-ea894f58f7a4",
                                                "text": "He borrowed from Sequoia’s presentation and told the staff that Jive needed to conserve cash, make swift and deep cuts and invest based on results instead of ahead of them, as they had when they overhired."
                                            },
                                            {
                                                "example_id": "c147a421-9b87-4419-b5f4-51127a8ed349",
                                                "sense_id": "0c5651fa-a39c-3b10-9da4-ea894f58f7a4",
                                                "text": "“It is now clear to me that we over-hired,” he wrote. A Coinbase spokesman declined to comment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
