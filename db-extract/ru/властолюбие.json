                    },
                    {
                        "translation_id": "ac326bf8-ad26-430a-b277-1ae03e24de4c",
                        "source_entry_id": "266ab5de-cbc7-3a25-beef-a3f113e4468b",
                        "source_sense_id": "1bdae81d-b794-33f7-9be4-ff1984a0a46e",
                        "target_lang_word": "ambition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba72e6d-3908-35e5-ab8a-bad802b34d80",
                                        "entry_id": "a9c29b43-e9ac-3592-8fa3-1788785fb3da",
                                        "glosses": [
                                            "Eager or inordinate desire for some object that confers distinction, as preferment, honor, superiority, political power, or fame; desire to distinguish one's self from other people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b0c8bf-85f2-44f8-91a9-4cdf003bfb9a",
                                                "sense_id": "6ba72e6d-3908-35e5-ab8a-bad802b34d80",
                                                "text": "My daughter, Johanna, wants to be a firefighter very much. She has a lot of ambition."
                                            },
                                            {
                                                "example_id": "a4761de3-2f90-4619-9251-750b02f40ca9",
                                                "sense_id": "6ba72e6d-3908-35e5-ab8a-bad802b34d80",
                                                "text": "The third part of practice hath divers branches, but one principal root in these our times, which is the vast and overspreading ambition and usurpation of the see of Rome; […]"
                                            },
                                            {
                                                "example_id": "4ec6e23d-263d-477a-9a6d-493cbe92deba",
                                                "sense_id": "6ba72e6d-3908-35e5-ab8a-bad802b34d80",
                                                "text": "One is aſtoniſhed hovv ſuch a ſmall ſpot could furniſh Men ſufficient to ſacrifice to the pitiful Ambition of poſſeſſing five or ſix thouſand more Acres, or tvvo or three more Villages: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e992113-8f85-3e00-a6e0-85cd69285a1a",
                                        "entry_id": "a9c29b43-e9ac-3592-8fa3-1788785fb3da",
                                        "glosses": [
                                            "An object of an ardent desire."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5150f59b-53da-4c72-8a5b-4c721f88d56a",
                                                "sense_id": "4e992113-8f85-3e00-a6e0-85cd69285a1a",
                                                "text": "My ambition is to own a helicopter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf75c778-7bad-3a78-b2b5-8d2d936a133b",
                                        "entry_id": "a9c29b43-e9ac-3592-8fa3-1788785fb3da",
                                        "glosses": [
                                            "A desire, as in (sense 1), for another person to achieve these things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9639a09b-628c-357e-92fd-abb5f24f799e",
                                        "entry_id": "a9c29b43-e9ac-3592-8fa3-1788785fb3da",
                                        "glosses": [
                                            "A personal quality similar to motivation, not necessarily tied to a single goal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2c53ff3-d341-3102-9492-67b3f4099cf2",
                                        "entry_id": "a9c29b43-e9ac-3592-8fa3-1788785fb3da",
                                        "glosses": [
                                            "The act of going about to solicit or obtain an office, or any other object of desire; canvassing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d80549-425b-4af8-b26f-c42991495971",
                                                "sense_id": "b2c53ff3-d341-3102-9492-67b3f4099cf2",
                                                "text": "I on th' other ſide / Us'd no ambition to commend my deeds, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ambition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79c83e5a-8c20-3f34-8ffb-32ff723b0525",
                                        "entry_id": "a085cfa5-204a-354d-9ab0-0187c777599e",
                                        "glosses": [
                                            "To seek after ambitiously or eagerly; to covet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78f69089-fd76-444b-87be-412a3011595a",
                                                "sense_id": "79c83e5a-8c20-3f34-8ffb-32ff723b0525",
                                                "text": "Pausanias, ambitioning the sovereignty of Greece, bargains with Xerxes for his daughter in marriage."
                                            }
