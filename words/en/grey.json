{
    "word_family": [
        "greyish",
        "greyness",
        "grey-haired"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dae27e34-3334-3c92-94ae-1ec2f479a1fe",
                    "sense_definition": "Having a color between black and white, like the color of ashes or a cloudy sky.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sky turned <w>grey</w> just before the heavy rain started to fall.",
                            "target_lang_translations": {
                                "ru": "Небо стало <w>серым</w> как раз перед тем, как начался сильный дождь."
                            }
                        },
                        {
                            "text": "She decided to wear a <w>grey</w> suit for her job interview today.",
                            "target_lang_translations": {
                                "ru": "Она решила надеть <w>серый</w> костюм на сегодняшнее собеседование."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grey sky",
                        "grey suit",
                        "dark grey"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonwealth spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий цвет между черным и белым, подобный цвету пепла или облачного неба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серый",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "пасмурный",
                                "target_lang_sense_clarification": "о небе или погоде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f7954bf-f0e0-359f-832f-84f797919636",
                    "sense_definition": "Relating to people of mixed racial heritage, specifically black and white.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "race",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In certain historical contexts, the term <w>grey</w> was used to describe people of mixed ancestry.",
                            "target_lang_translations": {
                                "ru": "В определенных исторических контекстах термин <w>grey</w> использовался для описания людей смешанного происхождения."
                            }
                        },
                        {
                            "text": "The sociologist discussed how <w>grey</w> communities navigated social boundaries during that era.",
                            "target_lang_translations": {
                                "ru": "Социолог обсуждал, как сообщества людей <w>смешанной расы</w> преодолевали социальные границы в ту эпоху."
                            }
                        }
                    ],
                    "synonyms": [
                        "coloured"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often offensive or specific to certain historical regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к людям смешанного расового происхождения, в частности, чернокожим и белым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешанного происхождения",
                                "target_lang_sense_clarification": "о расе"
                            },
                            {
                                "target_lang_word": "цветной",
                                "target_lang_sense_clarification": "устаревший термин для людей смешанной расы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da093b87-cca1-3024-9064-ff3779fed1fb",
                    "sense_definition": "A neutral color intermediate between black and white.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist mixed black and white paint to create a perfect shade of <w>grey</w>.",
                            "target_lang_translations": {
                                "ru": "Художник смешал черную и белую краску, чтобы создать идеальный оттенок <w>серого</w>."
                            }
                        },
                        {
                            "text": "The walls were painted in a light <w>grey</w> to make the room look larger.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в светло-<w>серый</w> цвет, чтобы комната казалась больше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shade of grey",
                        "light grey"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonwealth spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нейтральный цвет, промежуточный между черным и белым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серый цвет",
                                "target_lang_sense_clarification": "название цвета"
                            },
                            {
                                "target_lang_word": "серый",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4cb1edf-ce65-3415-86ca-0857f88dcd88",
                    "sense_definition": "A member of the Royal Scots Greys, a former cavalry regiment of the British Army.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old veteran was proud to have served as a <w>Grey</w> during the war.",
                            "target_lang_translations": {
                                "ru": "Старый ветеран гордился тем, что служил в полку <w>Грейс</w> во время войны."
                            }
                        },
                        {
                            "text": "History books often mention the bravery of the <w>Greys</w> at the Battle of Waterloo.",
                            "target_lang_translations": {
                                "ru": "В исторических книгах часто упоминается храбрость полка <w>Серых</w> в битве при Ватерлоо."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "military jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Военнослужащий полка Королевских шотландских серых, бывшего кавалерийского полка британской армии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грэй",
                                "target_lang_sense_clarification": "солдат полка Royal Scots Greys"
                            },
                            {
                                "target_lang_word": "шотландский серый",
                                "target_lang_sense_clarification": "кавалерист"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb6d33ce-1bd4-3ffb-b9d4-2f4dba792d2a",
                    "sense_definition": "To become or cause to become <w>grey</w>, especially of hair due to aging.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His hair began to <w>grey</w> at the temples when he reached his forties.",
                            "target_lang_translations": {
                                "ru": "Его волосы начали <w>седеть</w> на висках, когда ему исполнилось сорок."
                            }
                        },
                        {
                            "text": "The stress of the new job seemed to <w>grey</w> him overnight.",
                            "target_lang_translations": {
                                "ru": "Казалось, что стресс на новой работе заставил его <w>поседеть</w> за одну ночь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grey at the temples"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonwealth spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться или делать серым, особенно о волосах из-за старения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седеть",
                                "target_lang_sense_clarification": "о волосах"
                            },
                            {
                                "target_lang_word": "поседеть",
                                "target_lang_sense_clarification": "стать седым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a54440cd-7b47-3b3a-a955-1124ce88d24f",
                    "sense_definition": "A common English surname.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Lady Jane <w>Grey</w> is famously known as the Nine Days' Queen.",
                            "target_lang_translations": {
                                "ru": "Леди Джейн <w>Грей</w> известна как «королева на девять дней»."
                            }
                        },
                        {
                            "text": "We are meeting Mr. <w>Grey</w> at the office to discuss the contract.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с мистером <w>Греем</w> в офисе, чтобы обсудить контракт."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "common family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грей",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f169be0-e40a-346f-ae17-723cf68fcabc",
                    "sense_definition": "A river or district in the West Coast region of New Zealand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Grey</w> River flows through the town of Greymouth into the Tasman Sea.",
                            "target_lang_translations": {
                                "ru": "Река <w>Грей</w> протекает через город Греймут и впадает в Тасманово море."
                            }
                        },
                        {
                            "text": "Heavy rainfall caused the <w>Grey</w> to flood its banks last winter.",
                            "target_lang_translations": {
                                "ru": "Прошлой зимой из-за сильных дождей река <w>Грей</w> вышла из берегов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Grey River"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река или район в регионе Уэст-Кост в Новой Зеландии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грей",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee775c64-7274-3ed9-8cdf-9f07b8f932e6",
                    "sense_definition": "An English earldom or title of nobility.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titles",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "Earl <w>Grey</w> was a British Prime Minister after whom the tea is named.",
                            "target_lang_translations": {
                                "ru": "Граф <w>Грей</w> был британским премьер-министром, в честь которого назван чай."
                            }
                        },
                        {
                            "text": "The title of <w>Grey</w> has been held by several prominent figures in British history.",
                            "target_lang_translations": {
                                "ru": "Титул <w>Грей</w> носили несколько видных деятелей британской истории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Earl Grey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Английское графство или дворянский титул."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грей",
                                "target_lang_sense_clarification": "титул"
                            }
                        ]
                    }
                }
            ]
        }
    ]
