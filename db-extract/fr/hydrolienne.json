                "entry_id": "1c124aa6-33e5-3924-a3a6-979e711e1bc8",
                "word": "hydrolienne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4a332573-6a0a-4f11-92ab-22961e542bc8",
                        "entry_id": "1c124aa6-33e5-3924-a3a6-979e711e1bc8",
                        "tags": [
                            "plural"
                        ],
                        "form": "hydroliennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "742c2d0f-99cb-373c-ac8b-5b5f8e9123fa",
                        "entry_id": "1c124aa6-33e5-3924-a3a6-979e711e1bc8",
                        "glosses": [
                            "Turbine immergée qui utilise l’énergie des courants marins, et parfois fluviaux, pour produire de l’électricité."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "bfdc3978-042e-44e0-b466-6bf65990df2d",
                                "sense_id": "742c2d0f-99cb-373c-ac8b-5b5f8e9123fa",
                                "text": "En 2001, une hydrolienne de 100 kW est testée dans le détroit de Messine, entre la Sicile et le bout de la péninsule italienne."
                            },
                            {
                                "example_id": "40703e39-88af-42ab-8117-a7f40ecd52ad",
                                "sense_id": "742c2d0f-99cb-373c-ac8b-5b5f8e9123fa",
                                "text": "On ne peut envisager de récupérer un jour qu’une fraction de cette énergie, au moyen peut-être de grandes hélices sous-marines, « hydroliennes » ou « thalassiennes » comme des firmes des États-Unis envisagent d’en placer dans le Gulf Stream."
                            },
                            {
                                "example_id": "8df03fc1-49d1-414e-8407-b71400f8c0dc",
                                "sense_id": "742c2d0f-99cb-373c-ac8b-5b5f8e9123fa",
                                "text": "Entraînées par la force des courants marins, les deux hydroliennes vont produire de l'énergie électrique sur le même principe que les éoliennes actionnées par la force du vent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcf9e5eb-774c-4bad-897a-d5b9d3c40fdb",
                        "source_entry_id": "1c124aa6-33e5-3924-a3a6-979e711e1bc8",
                        "source_sense_id": "742c2d0f-99cb-373c-ac8b-5b5f8e9123fa",
                        "target_lang_word": "Meeresströmungskraftwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meeresströmungskraftwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c995b49-e8f5-3e6d-9cd3-59ec52dc5965",
                                        "entry_id": "460a7d59-304e-3ddc-af23-be03c7b5bb52",
                                        "glosses": [
                                            "Kraftwerk, mit dem aus der Bewegungsenergie der natürlichen Meeresströmung Elektrizität erzeugt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a013fef4-c86f-43ff-ba5e-cff1b9ea3346",
                                                "sense_id": "1c995b49-e8f5-3e6d-9cd3-59ec52dc5965",
                                                "text": "„Vor der Küste Großbritanniens entstand das erste Meeresströmungskraftwerk der Welt.“"
                                            },
                                            {
                                                "example_id": "cddf3326-3ac0-43f8-bdbb-a2d4ae1fef50",
                                                "sense_id": "1c995b49-e8f5-3e6d-9cd3-59ec52dc5965",
                                                "text": "„Meeresströmungen sind verlässliche Energielieferanten. Deshalb rechnen Experten mit zweistelligen Zuwachsraten für Meeresströmungskraftwerke bis 2020. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdaaa639-ae66-4e26-b585-948d009d3852",
