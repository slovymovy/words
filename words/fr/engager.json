                    ],
                    "synonyms": [
                        "lier",
                        "obliger"
                    ],
                    "antonyms": [
                        "dégager",
                        "libérer"
                    ],
                    "common_phrases": [
                        "engager sa responsabilité",
                        "engager sa parole"
                    ]
                },
                {
                    "sense_id": "70a2fdf0-0776-3c30-bdf5-32e27dd6f5c0",
                    "sense_definition": "Inciter, inviter ou pousser vivement quelqu'un à agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>engage</w> ses étudiants à lire régulièrement des ouvrages spécialisés."
                        },
                        {
                            "text": "Les circonstances actuelles nous <w>engagent</w> à faire preuve d'une grande prudence."
