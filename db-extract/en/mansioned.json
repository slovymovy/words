                        "examples": [
                            {
                                "example_id": "681f3ba2-a4c4-4ecc-80fb-65165515a97a",
                                "sense_id": "c2fdbc20-a4cc-3358-a72e-090d95d1597d",
                                "text": "The etymology of this name is a moot point. Colonel Sykes thought it meant “Nuptial Palace.” Others have thought it meant Two-Mansioned Cave from Du Mahall."
                            },
                            {
                                "example_id": "7f14cec4-4b1d-4149-8a68-0977b5b5061e",
                                "sense_id": "c2fdbc20-a4cc-3358-a72e-090d95d1597d",
                                "text": "Only when we know how 'many-mansioned' the universe of reality really is can we hope to have a philosophy that shall rest upon anything but the flimsiest foundations."
                            },
                            {
                                "example_id": "00745791-d215-48a1-982f-c3458979ecc1",
                                "sense_id": "c2fdbc20-a4cc-3358-a72e-090d95d1597d",
                                "text": "It appears, then, that when individual members of the Scheduled Castes gather their courage to see the gate-keepers of the multi-mansioned and multi-layered bureaucratic edifice to get some help, most of them are unable to make their case […]"
                            }
                        ]
