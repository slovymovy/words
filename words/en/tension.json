{
    "word_family": [
        "tense",
        "tensile",
        "tensioner",
        "tensional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7fbf96cd-947d-3030-a5ca-6127a72d7d4b",
                    "sense_definition": "A feeling of mental or emotional strain, stress, or anxiety.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a great deal of <w>tension</w> before her final driving test.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала сильное <w>напряжение</w> перед своим последним экзаменом по вождению.",
                                "zh": "在最后一次路考前，她感到非常<w>紧张</w>。"
                            }
                        },
                        {
                            "text": "Yoga and meditation are excellent ways to relieve daily <w>tension</w>.",
                            "target_lang_translations": {
                                "ru": "Йога и медитация — отличные способы снять ежедневное <w>напряжение</w>.",
                                "zh": "瑜伽和冥想是缓解日常<w>压力</w>的绝佳方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stress",
                        "anxiety",
                        "strain",
                        "nervousness"
                    ],
                    "antonyms": [
                        "relaxation",
                        "calmness",
                        "relief"
                    ],
                    "common_phrases": [
                        "relieve tension",
                        "reduce tension",
                        "nervous tension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство умственного или эмоционального напряжения, стресса или тревоги.",
                        "zh": "一种精神或情绪上的紧张、压力或焦虑感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжение",
                                "target_lang_sense_clarification": "психическое или эмоциональное состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧张",
                                "target_lang_sense_clarification": "心理或情绪状态"
                            },
                            {
                                "target_lang_word": "压力",
                                "target_lang_sense_clarification": "精神负担"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3446d9e-43f3-3ecf-a7f4-d8aec77e5399",
                    "sense_definition": "A situation in which there is anger, distrust, or lack of understanding between opposing people or groups.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is growing <w>tension</w> between the two neighboring countries.",
                            "target_lang_translations": {
                                "ru": "Между двумя соседними странами растёт <w>напряжённость</w>.",
                                "zh": "两国之间的<w>紧张关系</w>正在加剧。"
                            }
                        },
                        {
                            "text": "My <w>tensions</w> with Eric over his past actions have finally been resolved.",
                            "target_lang_translations": {
                                "ru": "Моя <w>напряжённость</w> в отношениях с Эриком из-за его прошлых поступков наконец-то исчезла.",
                                "zh": "我和埃里克因他过去的行为而产生的<w>隔阂</w>终于消除了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "friction",
                        "hostility",
                        "conflict",
                        "strain"
                    ],
                    "antonyms": [
                        "harmony",
                        "peace",
                        "accord"
                    ],
                    "common_phrases": [
                        "political tension",
                        "racial tension",
                        "source of tension",
                        "tension between"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, в которой существует гнев, недоверие или непонимание между противоборствующими людьми или группами.",
                        "zh": "人与人或群体之间存在愤怒、不信任或缺乏理解的局面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжённость",
                                "target_lang_sense_clarification": "в отношениях или политике"
                            },
                            {
                                "target_lang_word": "натянутость",
                                "target_lang_sense_clarification": "в общении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧张关系",
                                "target_lang_sense_clarification": "人际或政治冲突"
                            },
                            {
                                "target_lang_word": "对立",
                                "target_lang_sense_clarification": "群体间的敌意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35be3293-7d9b-3430-b056-5986de2ab5bb",
                    "sense_definition": "The state of being stretched tight or the degree to which something is stretched.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to adjust the <w>tension</w> on the guitar strings to tune it properly.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно отрегулировать <w>натяжение</w> гитарных струн, чтобы настроить её правильно.",
                                "zh": "你需要调整吉他弦的<w>张力</w>才能准确调音。"
                            }
                        },
                        {
                            "text": "The <w>tension</w> in the rope was so high that it looked ready to snap.",
                            "target_lang_translations": {
                                "ru": "<w>Натяжение</w> веревки было настолько сильным, что казалось, она вот-вот лопнет.",
                                "zh": "绳子上的<w>拉力</w>太大了，看起来随时都会断。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tightness",
                        "tautness"
                    ],
                    "antonyms": [
                        "slack",
                        "looseness"
                    ],
                    "common_phrases": [
                        "surface tension",
                        "under tension",
                        "adjust the tension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние натянутости или степень, до которой что-либо растянуто.",
                        "zh": "物体被拉紧的状态，或某物被拉伸的程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натяжение",
                                "target_lang_sense_clarification": "степень натянутости струны, веревки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张力",
                                "target_lang_sense_clarification": "物理上的拉紧程度"
                            },
                            {
                                "target_lang_word": "拉力",
                                "target_lang_sense_clarification": "绳索或弦的紧绷状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4524e246-59f7-38ac-8f7a-578f87f0d114",
                    "sense_definition": "A feeling of excitement, fear, or anticipation created by a story, film, or situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director used silence to build <w>tension</w> during the movie's climax.",
                            "target_lang_translations": {
                                "ru": "Режиссёр использовал тишину, чтобы нагнетать <w>напряжение</w> во время кульминации фильма.",
                                "zh": "导演利用沉默在电影高潮处营造了<w>悬念</w>。"
                            }
                        },
                        {
                            "text": "The dramatic <w>tension</w> in the novel kept readers guessing until the very end.",
                            "target_lang_translations": {
                                "ru": "Драматическое <w>напряжение</w> в романе заставляло читателей гадать до самого конца.",
                                "zh": "小说中戏剧性的<w>张力</w>让读者直到最后都在猜测结局。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suspense",
                        "anticipation"
                    ],
                    "common_phrases": [
                        "build tension",
                        "dramatic tension",
                        "create tension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство волнения, страха или ожидания, создаваемое историей, фильмом или ситуацией.",
                        "zh": "由故事、电影或情境所营造出的兴奋、恐惧或期待感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжение",
                                "target_lang_sense_clarification": "саспенс, драматизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悬念",
                                "target_lang_sense_clarification": "文学或影视中的紧张感"
                            },
                            {
                                "target_lang_word": "紧张气氛",
                                "target_lang_sense_clarification": "戏剧性的张力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89b197b2-0d2a-32ed-9f17-4854ac284246",
                    "sense_definition": "A force that pulls or stretches something, often transmitted through a rope, cable, or chain.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers must calculate the <w>tension</w> in the cables supporting the bridge.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны рассчитать <w>натяжение</w> тросов, поддерживающих мост.",
                                "zh": "工程师必须计算支撑桥梁的缆索所承受的<w>拉力</w>。"
                            }
                        },
                        {
                            "text": "The <w>tension</w> in the wire is measured in newtons.",
                            "target_lang_translations": {
                                "ru": "<w>Натяжение</w> проволоки измеряется в ньютонах.",
                                "zh": "金属丝的<w>张力</w>以牛顿为单位进行测量。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила, которая тянет или растягивает что-либо, часто передаваемая через веревку, трос или цепь.",
                        "zh": "一种拉动或伸展物体的力，通常通过绳索、电缆或链条传递。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натяжение",
                                "target_lang_sense_clarification": "физическая сила"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉力",
                                "target_lang_sense_clarification": "物理作用力"
                            },
                            {
                                "target_lang_word": "张力",
                                "target_lang_sense_clarification": "工程学中的受力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da77b078-0dc7-31a0-8968-e891b81ea5aa",
                    "sense_definition": "Electrical potential or voltage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is extremely dangerous to fly kites near high <w>tension</w> power lines.",
                            "target_lang_translations": {
                                "ru": "Запускать воздушных змеев рядом с линиями высокого <w>напряжения</w> чрезвычайно опасно.",
                                "zh": "在高<w>压</w>电线附近放风筝极其危险。"
                            }
                        },
                        {
                            "text": "The system operates under high <w>tension</w> to transmit electricity efficiently.",
                            "target_lang_translations": {
                                "ru": "Система работает под высоким <w>напряжением</w> для эффективной передачи электроэнергии.",
                                "zh": "该系统在高<w>电压</w>下运行，以实现高效输电。"
                            }
                        }
                    ],
                    "synonyms": [
                        "voltage"
                    ],
                    "common_phrases": [
                        "high tension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрический потенциал или вольтаж.",
                        "zh": "电势或电压。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряжение",
                                "target_lang_sense_clarification": "электрическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电压",
                                "target_lang_sense_clarification": "电学概念"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44ca7ae3-f32d-32c2-afe4-c9e5a0bad0f0",
                    "sense_definition": "To apply a pulling force to an object to make it tight.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>tensioned</w> the steel cable until it was perfectly straight.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>натягивали</w> стальной трос, пока он не стал совершенно прямым.",
                                "zh": "工人们将钢缆<w>拉紧</w>，直到它完全变直。"
                            }
                        },
                        {
                            "text": "We <w>tensioned</w> the bolts to ensure the structure would not wobble.",
                            "target_lang_translations": {
                                "ru": "Мы <w>затянули</w> болты, чтобы конструкция не шаталась.",
                                "zh": "我们把螺栓<w>拧紧</w>，以确保结构不会晃动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tighten",
                        "stretch"
                    ],
                    "antonyms": [
                        "loosen",
                        "slacken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикладывать тянущую силу к объекту, чтобы сделать его тугим.",
                        "zh": "对物体施加拉力使其变紧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натягивать",
                                "target_lang_sense_clarification": "делать тугим"
                            },
                            {
                                "target_lang_word": "затягивать",
                                "target_lang_sense_clarification": "болты, крепления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉紧",
                                "target_lang_sense_clarification": "使物体变紧"
                            },
                            {
                                "target_lang_word": "拧紧",
                                "target_lang_sense_clarification": "针对螺栓等紧固件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}