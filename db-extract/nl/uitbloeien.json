                                                "example_id": "36cc49f7-2e8e-4e48-bebd-d49c72ef52ed",
                                                "sense_id": "43cc12a5-3675-3a0d-a096-661901af7f7b",
                                                "text": "Such bloomings, Dr. McLaren continued, would require a critical audience, “so that they can be subject to scientific and ethical review, freely available for research and one day, perhaps, for treating diseases.”"
                                            }
                                        ]
                                    },
