                        "sense_id": "6a9433b6-9f4a-3051-abb7-59a446eb266a",
                        "entry_id": "c95b5272-20b1-3c5e-bfcf-eb6bbb698549",
                        "glosses": [
                            "Formation rocheuse karstique due au ruissellement des eaux."
                        ],
                        "tags": [
                            "Spéléologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ae105e53-2c98-4546-83b2-197846180aac",
                                "sense_id": "6a9433b6-9f4a-3051-abb7-59a446eb266a",
                                "text": "Délaissant les pentes de lapiaz nus pourtant tentantes, nous prospectons dans la forêt car l’évolution des processus qui ont façonné le massif a joué un rôle à prendre en considération."
                            },
                            {
                                "example_id": "f421c076-ee19-47f4-b0c2-7c91badad344",
                                "sense_id": "6a9433b6-9f4a-3051-abb7-59a446eb266a",
                                "text": "Il était difficile d’anticiper la survenue d’une patrouille et il fallait éviter les sentiers, se concentrer sur un cheminement forestier hasardeux entre lapiaz et broussailles."
                            },
                            {
                                "example_id": "f145293f-20a7-4761-a335-a4260bb331a9",
                                "sense_id": "6a9433b6-9f4a-3051-abb7-59a446eb266a",
                                "text": "On trouve de beaux lapiaz dans les calcaires de l’Hérault."
                            }
                        ]
                    }
