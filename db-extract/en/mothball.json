                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e72256d-4a36-33b9-bb2d-ed15b4307c01",
                        "entry_id": "8ca9f403-df3e-3714-8363-a1cf9acf3c38",
                        "glosses": [
                            "To store or shelve something no longer used."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5262b642-70af-4d36-8ea5-90786a03e315",
                                "sense_id": "8e72256d-4a36-33b9-bb2d-ed15b4307c01",
                                "text": "They mothballed the old version after the new one came out."
                            },
                            {
                                "example_id": "440d2365-ca32-4e50-be0f-8de4ede16a3b",
                                "sense_id": "8e72256d-4a36-33b9-bb2d-ed15b4307c01",
                                "text": "Before Musk, America’s space industry was moribund. In 2011, NASA mothballed the last space shuttle, after inking a deal with SpaceX to make uncrewed cargo resupply runs to the International Space Station (ISS)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b316599-9936-3ac2-a52a-899b8e4d682b",
                        "entry_id": "8ca9f403-df3e-3714-8363-a1cf9acf3c38",
                        "glosses": [
                            "To stop using (something), but keep it in good condition."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3da084c0-1f14-4b8e-9e62-923dae8e3e0b",
                                "sense_id": "1b316599-9936-3ac2-a52a-899b8e4d682b",
                                "text": "Some schools might have an art studio, an area of forestry in the playground, or a performance stage in the hall – all exceptional assets. Just check they get plenty of use and aren't mothballed while the school concentrates on (you guessed it) maths and literacy."
                            },
                            {
                                "example_id": "d18e8734-1701-42aa-a3ec-e26a503c9cfe",
                                "sense_id": "1b316599-9936-3ac2-a52a-899b8e4d682b",
                                "text": "In the short term NR could well mothball the line given its lack of traffic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7782f8cc-43a1-459d-8475-558b8686cf2d",
                        "source_entry_id": "8ca9f403-df3e-3714-8363-a1cf9acf3c38",
                        "source_sense_description": "to store something no longer used",
                        "target_lang_word": "in de mottenballen leggen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "886091bc-27dd-40b3-b9d9-7ff68e157d58",
                        "source_entry_id": "8ca9f403-df3e-3714-8363-a1cf9acf3c38",
                        "source_sense_description": "to store something no longer used",
                        "target_lang_word": "einmotten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einmotten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b4cb1c8-6da9-3868-a07c-c000ab173c55",
                                        "entry_id": "8824b07d-72d1-3a7c-a46a-8ea54d3c7854",
                                        "glosses": [
                                            "etwas mit einem Mittel zum Schutz gegen Motten einpacken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843f73a4-f556-44d3-82c4-45da748275ef",
                                                "sense_id": "6b4cb1c8-6da9-3868-a07c-c000ab173c55",
                                                "text": "Wenn den Puppensachen kein Schaden werden sollte, mußten sie eingemottet werden. Dazu brauchte man unbedingt Mottenkugeln."
                                            },
                                            {
                                                "example_id": "fa8b9da7-c337-4a06-9d67-9b5fcb80823d",
                                                "sense_id": "6b4cb1c8-6da9-3868-a07c-c000ab173c55",
                                                "text": "Die Einrichtung hatte der Architekt verkauft, Wandas Kleider und sonstige Sachen in einigen Kisten einmotten lassen und auf einen Speicher gestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "88b3a7cb-4e42-357d-8e2b-75d1f3e72be1",
                                        "entry_id": "8824b07d-72d1-3a7c-a46a-8ea54d3c7854",
                                        "glosses": [
                                            "etwas für längere Zeit außer Betrieb nehmen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b7f24b9-c063-4efe-be21-27cb12710dac",
                                                "sense_id": "88b3a7cb-4e42-357d-8e2b-75d1f3e72be1",
                                                "text": "Alle 2000 für den Bevölkerungsschutz noch bereit gehaltenen „Unterkünfte“ werden laut einem Erlass des Bundesinnenministeriums „eingemottet“ oder verkauft."
                                            },
                                            {
                                                "example_id": "9239807f-f4a6-49ce-b80a-ceaf5ccee4ba",
                                                "sense_id": "88b3a7cb-4e42-357d-8e2b-75d1f3e72be1",
                                                "text": "Die „Deutschland“ wird jetzt mindestens bis Frühjahr 2015 eingemottet!"
                                            },
                                            {
                                                "example_id": "8da73cfe-3015-4a23-a6f4-c456f7b557b4",
                                                "sense_id": "88b3a7cb-4e42-357d-8e2b-75d1f3e72be1",
                                                "text": "Aber die Jumbo Jets sollen nach heutigem Stand dort nicht zerlegt, sondern eingemottet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
