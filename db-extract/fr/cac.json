                        "entry_id": "6feb985f-697d-37e1-91cf-48262fb19c1c",
                        "glosses": [
                            "Centre d’art contemporain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86742343-f074-433c-93cd-00f94c965f28",
                                "sense_id": "ff9cedc6-fe92-348d-9680-07366669bb2f",
                                "text": "L’art contemporain est le protagoniste du CAC Málaga, qui revendique les arts plastiques et visuels de la fin du XXe siècle jusqu’à nos jours."
                            },
                            {
                                "example_id": "605f048f-601e-4f47-88c1-6930ccd60cf3",
                                "sense_id": "ff9cedc6-fe92-348d-9680-07366669bb2f",
                                "text": "Le Centre d’Art Contemporain (CAC) de Meymac vient d’obtenir le label Centre d’art d'intérêt national (CACIN)."
                            },
                            {
                                "example_id": "ab9fea40-be86-43f2-816f-480a1b5a83fe",
                                "sense_id": "ff9cedc6-fe92-348d-9680-07366669bb2f",
                                "text": "Le Centre d’art contemporain (CAC) et le Musée d’archéologie Marius Vazeilles se sont associés pour mettre en place une résidence autour du verre, dans le cadre d’une convention territoriale pour l’éducation artistique et culturelle en Nouvelle-Aquitaine."
                            }
                        ]
                    }
