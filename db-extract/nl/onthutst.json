                                    {
                                        "sense_id": "a0bd5f49-44ae-37d2-85a2-426550a7d06a",
                                        "entry_id": "4ebe6527-406b-3a87-bd8b-e2bbbdb0222b",
                                        "glosses": [
                                            "Étonné fortement, surpris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69665f16-9914-463f-afad-21d33ad5fc62",
                                                "sense_id": "a0bd5f49-44ae-37d2-85a2-426550a7d06a",
                                                "text": "Il arriva que monsieur Gazonal, logé dans un maigre garni de la rue Croix-des-Petits-Champs, fut ébahi de voir le palais de la rue de Berlin."
                                            },
                                            {
                                                "example_id": "9b5548c8-a07f-4482-b454-99c0eb1d0f63",
                                                "sense_id": "a0bd5f49-44ae-37d2-85a2-426550a7d06a",
                                                "text": "Ce morceau de rocher avait surnagé par on ne sait quel caprice d’un dieu ébahi et retors, désireux de faire payer ad vitam æternam à ses habitant le karma de leurs malheureux ancêtres."
                                            },
                                            {
                                                "example_id": "8fb510b4-f710-4179-af1e-16acd52725e0",
                                                "sense_id": "a0bd5f49-44ae-37d2-85a2-426550a7d06a",
                                                "text": "Je leur ai annoncé ça qu'il était perdu le bijou… ils m'ont regardé ébahis !… ils tombaient des nues…"
                                            }
                                        ]
                                    }
                                ]
                            },
