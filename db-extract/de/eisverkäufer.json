                                        "sense_id": "e9d50291-4f70-3e18-a4d0-7b535dc61199",
                                        "entry_id": "1f32118b-3e2d-33d2-8e98-d3de65abb7a8",
                                        "glosses": [
                                            "A person who trades in ice; a person employed to deliver block ice to those lacking electric refrigeration."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "600ee012-40d3-31df-a16e-a385392610aa",
                                        "entry_id": "1f32118b-3e2d-33d2-8e98-d3de65abb7a8",
                                        "glosses": [
                                            "A man who is skilled in travelling upon ice, as among glaciers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c2dc20-21d5-4c32-9100-bcd1af36a01a",
                                                "sense_id": "600ee012-40d3-31df-a16e-a385392610aa",
                                                "text": "We were accompanied by our two guides, Jean Baptiste Croz and Michel Croz, of Chamounix, two capital icemen, and worthy fellows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f3dad87-d494-3782-80ca-856c1b81ea6f",
                                        "entry_id": "1f32118b-3e2d-33d2-8e98-d3de65abb7a8",
                                        "glosses": [
                                            "A human figure carved out of ice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c204d85-1138-3b60-a993-2b782be937c7",
                                        "entry_id": "1f32118b-3e2d-33d2-8e98-d3de65abb7a8",
                                        "glosses": [
                                            "An ancient human male mummified in ice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a3ee8c9-59cb-36d6-8288-f485574b659e",
                                        "entry_id": "1f32118b-3e2d-33d2-8e98-d3de65abb7a8",
                                        "glosses": [
                                            "An assassin."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "549b3b20-3038-31fb-bf5d-bfe5c16cabd6",
                                        "entry_id": "1f32118b-3e2d-33d2-8e98-d3de65abb7a8",
                                        "glosses": [
                                            "One who is cool under pressure."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bfd2714-eb93-4f6c-b068-d4d1d8e18d77",
                                                "sense_id": "549b3b20-3038-31fb-bf5d-bfe5c16cabd6",
                                                "text": "Baltiel had always been the iceman, harsh and distant and lacking in sentiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a8b6f8-1f71-3bfc-a496-0aa120ab7149",
                                        "entry_id": "1f32118b-3e2d-33d2-8e98-d3de65abb7a8",
                                        "glosses": [
                                            "A man in attendance at a frozen pond where skating etc. is going on."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2145ddd9-c1d8-40de-9dcf-3b49fa3b147a",
                        "source_entry_id": "13352d2c-0f41-3b8e-8b16-22c259db6589",
                        "source_sense_id": "9f6f9ca5-c02f-3a31-861f-038068c54196",
                        "source_sense_description": "jemand, der (beruflich) Speiseeis verkauft",
                        "target_lang_word": "glacier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glacier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5cdf6c24-65e4-30ad-85ac-413f0cb92319",
                                        "entry_id": "f4a5938b-b28f-3902-9931-3802bde97c73",
                                        "glosses": [
                                            "Celui qui prépare et vend des glaces, des sirops, des fruits glacés."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f2b33f8-cdac-4146-b361-1dfc2dad7bdb",
                                                "sense_id": "5cdf6c24-65e4-30ad-85ac-413f0cb92319",
                                                "text": "Le glacier napolitain n’en persistait pas moins à vouloir fermer boutique."
                                            },
                                            {
                                                "example_id": "d7ce1814-b405-4741-a030-f1326a1cfec0",
                                                "sense_id": "5cdf6c24-65e4-30ad-85ac-413f0cb92319",
                                                "text": "Le raisonnement « les éclairs au café sont des choses délicieuses, des choses délicieuses sont vendues chez les glaciers, donc les éclairs au café sont vendus chez les glaciers » est en revanche incorrect."
                                            },
                                            {
                                                "example_id": "76a04a1a-510d-4f90-a717-7f65a77b9669",
                                                "sense_id": "5cdf6c24-65e4-30ad-85ac-413f0cb92319",
                                                "text": "Il joue un glacier, chemise rose, tablier blanc, pantacourt gris et calot blanc, et conduit un triporteur devant deux gros cylindres verticaux qui tournent sur eux-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e29a8ab-2a18-326d-bf4d-7f092bba394b",
                                        "entry_id": "f4a5938b-b28f-3902-9931-3802bde97c73",
                                        "glosses": [
                                            "Établissement qui vend des glaces et sorbets."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ac02d3e-b31e-4aba-9543-d2fda84b755b",
                                                "sense_id": "6e29a8ab-2a18-326d-bf4d-7f092bba394b",
                                                "text": "Sébastien Gaudard a ouvert Le Grand Café en lieu et place d’un ancien glacier derrière les Folies Bergères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02137adb-45c6-3d69-81df-e3de09bf6cd1",
                                        "entry_id": "f4a5938b-b28f-3902-9931-3802bde97c73",
                                        "glosses": [
                                            "Miroitier, fabricant ou vendeur de glaces de verre."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "547fb8d6-9420-4fa4-9b8c-80cd07954a00",
                                                "sense_id": "02137adb-45c6-3d69-81df-e3de09bf6cd1",
                                                "text": "Le fameux Palais Lumineux fait par les glaciers de Saint-Gobain et les verriers de Saint-Denis pour l’exposition universelle en témoigne, ainsi que les idées de René Lalique et d’Émile Gallé, les deux fondateurs de l’art nouveaux, sur le pouvoir expressif de la glace."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glacier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                        "entry_id": "5e274aa7-a5f8-3b18-86c5-44dc595bdd20",
                                        "glosses": [
                                            "Masse de glace d’origine nivale, formée par l’accumulation et la transformation de la neige, qui s’écoule lentement sous son propre poids sur les terres émergées, principalement en haute montagne ou dans les régions polaires."
                                        ],
                                        "tags": [
                                            "Géographie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4ae5f1-9638-4c4d-8a04-443e0c8bd586",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "La limite des glaciers est bien inférieure à celle des neiges perpétuelles ; car les avalanches, roulant dans des vallées où le soleil ne pénètre jamais, se gèlent à une épaisseur de plusieurs centaines de mètres, et descendent jusque dans les bois et les pâturages."
                                            },
                                            {
                                                "example_id": "34872f42-e673-4a50-a685-a96aab349a14",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "Les glaciers du Spitzberg, bien que très importants, ne débitent pas d’icebergs ; leur conformation ainsi que les fonds réduits de la mer à leur base, ne permettent pas le vêlage d’ice-blocs."
                                            },
                                            {
                                                "example_id": "e084d9f1-b710-4a35-bc63-79b3c9aad0e9",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "Arrive le dernier réchauffement, coïncidant avec le recul, la fonte des glaciers. Il a peu à peu conduit à un climat plus chaud et plus sec que le climat actuel : le climat xérothermique."
                                            },
                                            {
                                                "example_id": "5875c4ab-fde1-445c-a0f2-04d4061b6a9b",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "En 1876, Viollet-Le-Duc publie « Le massif du Mont-Blanc », dans lequel il décrit glaciers et moraines, le tout bien illustré par des dessins."
                                            },
                                            {
                                                "example_id": "91648fa4-b30e-49bd-afe2-841711a17f6f",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "Vingt ans plus tard, en octobre 1664, une nouvelle demande est adressée par les chamoniards : « Les glaciers qui avançaient fort en avant sur les terres semables… » (archives départementales)."
                                            },
                                            {
                                                "example_id": "7a202c4e-2a28-4eb6-a97b-116c6979e021",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "C'est le géologue H. Heinrich, de Hambourg, qui, scrutant au binoculaire les carottes forées dans les sédiments de l’Atlantique nord, a montré dans les années 1990 que les couches formées d’éléments plus grossiers interstratifiés dans les dépôts plus fins devaient provenir des débris arrachés par les glaciers au substrat rocheux des inlandsis."
                                            },
                                            {
                                                "example_id": "33cff50e-2d51-4b6f-aa9e-9dac31f8de9a",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "J’ai longtemps trouvé les glaciers effroyables avant de m’inquiéter pour eux. Ces immenses machines à raboter les reliefs sont des torrents au ralenti, une ponceuse géante qui accomplirait sa tâche sur des siècles, voire des millénaires."
                                            },
                                            {
                                                "example_id": "98da98d9-37a6-4375-9c77-3da82888ae45",
                                                "sense_id": "e1100c62-c822-3b9e-8e69-a56050ee1589",
                                                "text": "Le pays d’Amérique latine est le premier le long des Andes à perdre la totalité de ses glaciers, qui s’étendaient sur une superficie de près de 1 000 hectares il y a plus d’un siècle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glacier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be113615-4c74-303e-a943-4d7ea697faa3",
                                        "entry_id": "a94aef3c-6db6-3aec-8bd1-47eb4b3ccf78",
                                        "glosses": [
                                            "Qualifie la couleur blanche semblable à celle de la neige propre."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38102506-8cd5-4ea9-8860-0fdc81399969",
                                                "sense_id": "be113615-4c74-303e-a943-4d7ea697faa3",
                                                "text": "Lettre manuscrite. Carton de correspondance vélin blanc glacier. Encre noire. Plume épaisse. Écriture droite et pointue."
                                            },
                                            {
                                                "example_id": "eaf214da-6d6c-40b3-b590-e5679d4957f4",
                                                "sense_id": "be113615-4c74-303e-a943-4d7ea697faa3",
                                                "text": "La décoration de la chambre se déclinait en diverses nuances de blanc. […]. Les rideaux de mousseline légère, blanc glacier, étaient doublés de gros-grain vanille et ornés de festons bleu pâle."
                                            },
                                            {
                                                "example_id": "13dff3dc-0c16-4f92-b40c-43c6ff35c0e6",
                                                "sense_id": "be113615-4c74-303e-a943-4d7ea697faa3",
                                                "text": "Vêtus de la tête aux pieds de combinaisons intégrales bleues, grises ou glacier, et le visage entièrement recouvert par des masques filtrants en plastique transparent, ils se sont d’abord entièrement désinfectés avec un jet avant de s’attaquer à la maison de retraite proprement dite, un grand bâtiment moderne à dominante verte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
