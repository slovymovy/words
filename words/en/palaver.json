                    "frequency": "Low",
                    "semantic_group_id": "talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hours of meaningless <w>palaver</w>, no actual decision had been reached."
                        },
                        {
                            "text": "Please get straight to the point without any further <w>palaver</w>."
