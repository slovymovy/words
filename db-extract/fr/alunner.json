                        "glosses": [
                            "Tremper dans une dissolution d’alun, imprégner d’alun."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9ef63051-6ee7-4c53-a695-4a6ee3c9c5e3",
                                "sense_id": "11d373db-ec1f-3862-904f-69455f5b4ba0",
                                "text": "L’Imprimeur eſt quelquefois obligé d’alunner ſon papier, & pour cet effet il fait fondre de l’alun dans de l’eau chaude, ou ſur le feu, & quand cette eau eſt refroidie, il en trempe ſon papier, comme on vient de dire."
                            }
                        ]
                    }
