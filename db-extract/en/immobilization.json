                "senses": [
                    {
                        "sense_id": "b7b620cc-44f1-3cf5-92f0-7a8640c1e17d",
                        "entry_id": "4551b3f1-293e-3c21-8628-3da49138c149",
                        "glosses": [
                            "The act or process of preventing a thing from moving."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4198f26f-737f-4f2e-a059-3349d615adf9",
                                "sense_id": "b7b620cc-44f1-3cf5-92f0-7a8640c1e17d",
                                "text": "The broken bones were able to heal, thanks to the immobilization of her leg in a cast."
                            },
                            {
                                "example_id": "391ae299-8ea1-4ca6-aba8-5e6f0da7897c",
                                "sense_id": "b7b620cc-44f1-3cf5-92f0-7a8640c1e17d",
                                "text": "Treatment of an acute occult dislocation of the ankle consists of immobilization in a snugly fitting plaster-of-paris cast, with little padding."
                            },
                            {
                                "example_id": "49a69fc7-d8b5-4e7e-9531-4732ab3dda25",
                                "sense_id": "b7b620cc-44f1-3cf5-92f0-7a8640c1e17d",
                                "text": "We are also extracting DNA, both from blood collected during immobilizations and from hyena feces."
                            }
                        ]
                    },
                    {
                        "sense_id": "10a4d10d-cab7-3c38-8107-9a3850485120",
                        "entry_id": "4551b3f1-293e-3c21-8628-3da49138c149",
                        "glosses": [
                            "The process in which organic soil matter is decomposed and absorbed by microorganisms, and thus not available to plants."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
