                                "target_senses": [
                                    {
                                        "sense_id": "35131b05-cdd7-319f-8b04-a0f6f89b3168",
                                        "entry_id": "3c9b6041-c0ef-3714-a214-7abad9a07362",
                                        "glosses": [
                                            "Holz des Birkenbaums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe152a35-12c9-46bb-aa8d-d63ceb605852",
                                                "sense_id": "35131b05-cdd7-319f-8b04-a0f6f89b3168",
                                                "text": "Birkenholz ist sehr hochwertig."
                                            },
                                            {
                                                "example_id": "c6e14ef7-308f-4f8d-93b7-d02fe0d8c7e7",
                                                "sense_id": "35131b05-cdd7-319f-8b04-a0f6f89b3168",
                                                "text": "„Die wichtigsten Stücke des Schlittens sind die mehr oder weniger in Hörner aufgekrümmten Kufen, wozu am besten Buchen-, Ahorn- oder Birkenholz verwendet wird.“"
                                            },
                                            {
                                                "example_id": "6caa4209-15d5-4a64-aec4-fb382124392f",
                                                "sense_id": "35131b05-cdd7-319f-8b04-a0f6f89b3168",
                                                "text": "„In der Mitte des mäßig großen Raumes stand der Klapptisch aus Birkenholz, mit Wachstuch überzogen, jetzt von einem blendend weißen Drelltuch bedeckt.“"
                                            },
                                            {
                                                "example_id": "b1f1bcc8-361b-4df7-b574-a63c0aee6f03",
                                                "sense_id": "35131b05-cdd7-319f-8b04-a0f6f89b3168",
                                                "text": "„Die Büros waren mit Möbeln aus hellem Birkenholz eingerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
