                "senses": [
                    {
                        "sense_id": "5cff957c-ef21-3860-89a2-8505c8999254",
                        "entry_id": "dbacffc2-2683-314b-a639-0df1cc73b7d9",
                        "glosses": [
                            "Geschäft mit Waren (vor allem Lebensmittel) aus den Kolonien/aus Übersee"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "e19e1498-974c-4ddf-aab1-3e2db0e16214",
                                "sense_id": "5cff957c-ef21-3860-89a2-8505c8999254",
                                "text": "„In dieser Straße, die an mir vorübergleitet, kenne ich jedes Haus, das Kolonialwarengeschäft, die Drogerie, die Bäckerei.“"
                            },
                            {
                                "example_id": "d46d9a4f-7ed2-48e1-882c-ca7dc38345fd",
                                "sense_id": "5cff957c-ef21-3860-89a2-8505c8999254",
                                "text": "„Doch alles, was er sah, waren zwei Frauen, die aufgeregt gestikulierend hinter der Bretterwand ihres Balkons zum Kolonialwarengeschäft auf der anderen Straßenseite winkten.“"
                            },
                            {
                                "example_id": "1eefe5f2-1b12-4851-9641-9b2c98795388",
                                "sense_id": "5cff957c-ef21-3860-89a2-8505c8999254",
                                "text": "„»Kolonialwarengeschäfte« hießen in meiner Kindheit Geschäfte, in denen es Zimt und Koriander, Pfeffer und Vanille gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
