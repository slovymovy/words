                                "example_id": "b5a9da59-62a8-45ca-99e3-b036ac858d8a",
                                "sense_id": "355ab92c-fbce-3e91-8102-24bb11512a2f",
                                "text": "„Holzdielen, Badewanne, die Einbauküche in weiß - ein Träumchen.“"
                            }
