                "senses": [
                    {
                        "sense_id": "faa6cd3d-7aa9-3b95-b7d2-20c27e6a01c5",
                        "entry_id": "8f975d95-ca71-3c11-bb1f-1c6ee8d880d2",
                        "glosses": [
                            "относящийся к прессовке, прессованию; предназначенный, служащий для прессовки, прессования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e24ab03a-6ae2-4802-8f2c-4e86cf9adc1a",
                                "sense_id": "faa6cd3d-7aa9-3b95-b7d2-20c27e6a01c5",
                                "text": "Промышленность применяла различные смолы на этой основе и прессовочные порошки."
                            },
                            {
                                "example_id": "9b13c969-e9bd-4785-b2f8-3a43ec84619f",
                                "sense_id": "faa6cd3d-7aa9-3b95-b7d2-20c27e6a01c5",
                                "text": "А промышленные предприятия занимают много места лишь потому, что нельзя строить многоэтажные здания, в которых, к примеру, стоит прессовочный станок."
                            }
                        ]
                    }
