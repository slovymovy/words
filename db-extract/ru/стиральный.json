                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40b0bcb-905c-47bf-8254-1ec250f95658",
                                                "sense_id": "c13260dd-b583-3611-8ec4-848e7e0c81ce",
                                                "text": "The washings have a higher concentration of metal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6981df9e-5df2-3fe3-8019-9c7fc45df6ff",
                                        "entry_id": "483485d4-6a1f-3ced-be00-7ae35036631c",
                                        "glosses": [
                                            "The liquid used to wash an ore."
