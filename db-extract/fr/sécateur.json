                                        "entry_id": "3ccf18fe-2f1d-3ad5-9bea-cf4a72e21ca0",
                                        "glosses": [
                                            "(mit einer Hand geführtes) Werkzeug zum Abschneiden oder Zuschneiden von (kleineren) Gartenpflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99ddab4f-6290-4e4d-9dfd-82dc360f39c9",
                                                "sense_id": "edbabff3-6d90-34df-966e-cb5081f76c13",
                                                "text": "„In der Hand hielt er eine Gartenschere, sie war klein und kräftig und mit Draht zusammengebunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6872495f-cf2b-4731-807f-19e84261051b",
