                ],
                "senses": [
                    {
                        "sense_id": "7f5f3e31-36cd-3a06-a4f3-590d7652db13",
                        "entry_id": "203d6aba-621c-3938-9293-2c86dfdb2360",
                        "glosses": [
                            "mittlere Spielphase, die sich an die Eröffnung anschließt und ins Endspiel mündet"
                        ],
                        "tags": [
                            "Brettspiele"
                        ],
                        "examples": [
                            {
                                "example_id": "51b58ed2-4cc7-4134-9d11-7cd264806cb9",
                                "sense_id": "7f5f3e31-36cd-3a06-a4f3-590d7652db13",
                                "text": "Im Mittelspiel zeigt sich der wahre Meister – abseits von auswendig gepaukten Eröffnungsvarianten."
                            },
                            {
                                "example_id": "910e7bcd-ec4a-49ba-836b-bd41da3cd7d8",
                                "sense_id": "7f5f3e31-36cd-3a06-a4f3-590d7652db13",
                                "text": "„Spielen beide Partner die Eröffnung richtig, treten sie in ein Mittelspiel ein, wo Vor- und Nachteile sich die Waage halten.“"
                            },
                            {
                                "example_id": "7c6ce992-db32-4e09-9162-42acdc6b176b",
                                "sense_id": "7f5f3e31-36cd-3a06-a4f3-590d7652db13",
                                "text": "„Mit der psychologisch besseren Eröffnungspartie und der ideenreicheren Taktik im Mittelspiel hatte sich Kasparow einen kleinen Vorteil für das Endspiel verschafft, in dem er mit wissenschaftlicher Akribie seinen Gegner im ‚Zugzwang‘ langsam erwürgte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5c2c7ae-d418-3d16-99c6-f2ff3b7ddf75",
                        "entry_id": "203d6aba-621c-3938-9293-2c86dfdb2360",
                        "glosses": [
                            "inzwischen veraltete Bezeichnung für Eröffnung Mittelgambit"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "bc67a2c3-bcbb-437c-a70e-b594422b05b4",
                                "sense_id": "d5c2c7ae-d418-3d16-99c6-f2ff3b7ddf75",
                                "text": "Das Mittelspiel gehört in die Kategorie der offenen Spiele."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
