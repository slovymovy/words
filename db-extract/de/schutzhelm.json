                        "cross_references": [
                            {
                                "target_word": "hard hat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1de4e721-7b5c-3992-81f3-c316af10d949",
                                        "entry_id": "42279443-2c51-336c-baa9-4070c1087e98",
                                        "glosses": [
                                            "A helmet, usually made from rigid plastic, used on construction sites to protect the head from falling objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c17819f5-5a97-4029-927d-03faa3cf632e",
                                                "sense_id": "1de4e721-7b5c-3992-81f3-c316af10d949",
                                                "text": "My enthusiasm wasn't exactly suppressed - my father had worked for British Rail's property department, and one of my earliest memories was walking around the forlorn buildings at Old Oak Common depot wearing his oversized BR hard hat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
