                    {
                        "form_id": "fa39da19-94fe-4801-a681-910799cb4778",
                        "entry_id": "82823a98-e4ef-3be4-b096-0adb3ca6f294",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sonnenstrahlen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d63346f4-2553-3a1d-bfa7-4ae4e6c172f3",
                        "entry_id": "82823a98-e4ef-3be4-b096-0adb3ca6f294",
                        "glosses": [
                            "ein einzelner Strahl der Sonne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fedce913-df65-424d-abac-d2d0c18c938f",
                                "sense_id": "d63346f4-2553-3a1d-bfa7-4ae4e6c172f3",
                                "text": "„Ein kleines Schiff, vom letzten Sonnenstrahl getroffen, glitt – ein leuchtender Rubin – über den bläulichen Atlas des Wassers.“"
                            },
                            {
                                "example_id": "37c99756-b7b1-4aff-a7ea-c808d5d1cbda",
                                "sense_id": "d63346f4-2553-3a1d-bfa7-4ae4e6c172f3",
                                "text": "„Die durch eine Kombination von Sonnenstrahlen und Schnee erzeugte Helligkeit des Bildeindrucks erinnert an einen geradezu überirdischen Glanz.“"
                            },
                            {
                                "example_id": "ff1dd84d-5d5a-47f1-97ff-72a1a61a5c4e",
                                "sense_id": "d63346f4-2553-3a1d-bfa7-4ae4e6c172f3",
                                "text": "„Der Mond steht noch silbern am Himmel, als die ersten Sonnenstrahlen den felsigen Gipfel des Ras Dashen berühren.“"
                            },
                            {
                                "example_id": "3968e801-65f4-4a7c-9888-30467f79530a",
                                "sense_id": "d63346f4-2553-3a1d-bfa7-4ae4e6c172f3",
                                "text": "„Ein Sonnenstrahl blendet mich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70ff1c88-35bb-4d93-9e2a-9e764979aeca",
