                        ]
                    },
                    {
                        "translation_id": "750860a6-3834-4c95-b773-1ca5fb8498f0",
                        "source_entry_id": "3ab96762-bfde-33cc-bf2e-5cc3912ba957",
                        "source_sense_id": "cbed8cf9-6315-3369-b3f1-a0db91e1a404",
                        "target_lang_word": "dock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe7619ad-1d7c-334f-b571-4232dba0af7f",
                                        "entry_id": "e776b30e-6f9d-3c4f-a556-586c19c5d63e",
                                        "glosses": [
                                            "Any of the genus Rumex of coarse weedy plants with small green flowers related to buckwheat, especially bitter dock (Rumex obtusifolius), and used as potherbs and in folk medicine, especially in curing nettle rash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e00af49-c531-40b6-91e0-6899e443ad8e",
                                                "sense_id": "fe7619ad-1d7c-334f-b571-4232dba0af7f",
                                                "text": "And vnder neath him his courageous ſteed, / The fierce Spumador trode them downe like docks […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f73dcdf4-be3c-324d-8aa6-4eb2bf9b56e7",
                                        "entry_id": "e776b30e-6f9d-3c4f-a556-586c19c5d63e",
                                        "glosses": [
                                            "A burdock plant, or the leaves of that plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6355c5b1-a918-33c4-b0a0-2ceb1351315c",
                                        "entry_id": "f7610299-e980-3025-8856-085b5ca3415c",
                                        "glosses": [
                                            "The fleshy root of an animal's tail; specifically after clipping or cutting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d64155-9c51-4b27-9b3e-7459820fa75f",
                                                "sense_id": "6355c5b1-a918-33c4-b0a0-2ceb1351315c",
                                                "text": "The Dock is about 1 inch thick, and two inches broad, like an Apothecaries Spatule. Of what length the whole, is uncertain, this being only part of it, though it looks as if cut off near the Buttock"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d034b5e-fd2d-374e-b811-b55b14c59896",
                                        "entry_id": "f7610299-e980-3025-8856-085b5ca3415c",
                                        "glosses": [
                                            "The buttocks or anus."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73afa501-f5f6-41f6-a35f-4ae919a299bf",
                                                "sense_id": "5d034b5e-fd2d-374e-b811-b55b14c59896",
                                                "text": "And on a Cuſhion ſtuffed with Flocks, / She clapt her dainty pair of Docks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35cd5016-b6ea-37e1-b83f-cf5cd8661c96",
                                        "entry_id": "f7610299-e980-3025-8856-085b5ca3415c",
                                        "glosses": [
                                            "A leather case used to cover the clipped or cut tail of a horse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4491051e-825d-3783-abfb-0270d0b93cb0",
                                        "entry_id": "099f6cd2-e23c-349e-bb44-6819fea94fd4",
                                        "glosses": [
                                            "To clip or cut off a section of an animal's tail; to practise a caudectomy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150d0519-c79b-4827-9b06-5f0d5b47651f",
                                                "sense_id": "4491051e-825d-3783-abfb-0270d0b93cb0",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                                            },
                                            {
                                                "example_id": "d5e0093b-462c-4d60-bc0d-927ca35c67d8",
                                                "sense_id": "4491051e-825d-3783-abfb-0270d0b93cb0",
                                                "text": "The team have been docked six points at Paris 2024 and Priestman received a one-year football ban from world governing body Fifa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "220efa9f-2ab3-30f3-a681-573bc1788c22",
                                        "entry_id": "099f6cd2-e23c-349e-bb44-6819fea94fd4",
                                        "glosses": [
                                            "To reduce (wages); to deduct from (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd7bb0df-2833-4a4a-b118-d68752214751",
                                                "sense_id": "220efa9f-2ab3-30f3-a681-573bc1788c22",
                                                "text": "Her wages were docked by ten dollars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45abbdd-8bd5-3d77-b4cd-e843880444fc",
                                        "entry_id": "099f6cd2-e23c-349e-bb44-6819fea94fd4",
                                        "glosses": [
                                            "To reduce the wages of (a person)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a5de547-1b27-4601-bde8-01c7ad60dd86",
                                                "sense_id": "e45abbdd-8bd5-3d77-b4cd-e843880444fc",
                                                "text": "They docked me ten dollars for breaking the vase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee46b66-c022-3b48-9e8f-98d441115d25",
                                        "entry_id": "099f6cd2-e23c-349e-bb44-6819fea94fd4",
                                        "glosses": [
                                            "To cut off, bar, or destroy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b979c90a-b755-4267-b070-6dd4ab4ea32f",
                                                "sense_id": "fee46b66-c022-3b48-9e8f-98d441115d25",
                                                "text": "to dock an entail"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a42e7ac-6906-375f-b1a4-c44a4cc25686",
                                        "entry_id": "099f6cd2-e23c-349e-bb44-6819fea94fd4",
                                        "glosses": [
                                            "To pierce holes, as pricking dough with a fork, to prevent excessive rising in the oven."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b61782-03ea-4cff-8c16-a478c428b4ca",
                                                "sense_id": "2a42e7ac-6906-375f-b1a4-c44a4cc25686",
                                                "text": "Pricking holes in the rolled-out pie dough allows the steam to escape while it's baking. Without this, the steam would puff up in bubbles and pockets throughout the crust, which would make some parts of the crust cook too quickly and also result in an uneven surface for your filling. Docking is simple. Just roll out your pie dough and lift it into the pan. After pressing it in and shaping the edge, prick it all over with a fork."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b48e9f94-5c3f-336e-90a7-a89b40591bb0",
                                        "entry_id": "8a1daa39-7b06-3ea1-a06d-5c7314477ae4",
                                        "glosses": [
                                            "A fixed structure attached to shore to which a vessel is secured when in port; usually for loading and unloading."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5bf47be-a31f-450b-84c9-fbb50f3b09a8",
                                                "sense_id": "b48e9f94-5c3f-336e-90a7-a89b40591bb0",
                                                "text": "With just the turn of a shoulder she indicated the water front, where, at the end of the dock on which they stood, lay the good ship, Mount Vernon, river packet, the black smoke already pouring from her stacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25023c8-3704-3393-bb85-51da88c6c59e",
