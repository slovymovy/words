                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encyclopedist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "287be3c3-ef73-3826-8067-122eff545685",
                                        "entry_id": "70bec9a0-8ec9-36bf-97e2-c4f2695f7d2f",
                                        "glosses": [
                                            "A member of a group of French authors who collaborated in the 18th century in the production of the Encyclopédie, under the direction of Denis Diderot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2f28e73-d786-3d70-9f40-a7672323ef07",
                                        "entry_id": "70bec9a0-8ec9-36bf-97e2-c4f2695f7d2f",
                                        "glosses": [
                                            "An author of, or contributor to, an encyclopedia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7826b7d-16b9-4891-85cc-e21fe85b5c94",
                                                "sense_id": "d2f28e73-d786-3d70-9f40-a7672323ef07",
                                                "text": "The root of the mallow in goat's milk excites the sexual urge, according to Pliny the Elder, the Roman encyclopedist of the first century A.D."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f52b219-72f4-473b-b40c-1947067639b8",
                        "source_entry_id": "546824aa-d146-3c7f-98ab-b2ef2d8122a4",
                        "source_sense_id": "ca9a6d1d-01fb-38e6-ac5c-a49644d404d3",
