                "senses": [
                    {
                        "sense_id": "9f25d1e2-d2bd-3831-b9a2-61305b274c6f",
                        "entry_id": "561e84a0-48bb-3252-bb43-daeafd24d458",
                        "glosses": [
                            "Witz um einen Arzt/Ärzte als Protagonisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde61466-e9f1-40cd-b3cf-7c8f542e17ac",
                                "sense_id": "9f25d1e2-d2bd-3831-b9a2-61305b274c6f",
                                "text": "„Der zweite, ein Arztwitz aus den Fünfzigerjahren, beruht auf dem Unterschied zwischen dem Hochdeutschen und dem Bayerischen, dem Honoratiorenbayerisch in München.“"
                            },
                            {
                                "example_id": "1e48b7e5-2198-4361-bcf4-a8fa427c524b",
                                "sense_id": "9f25d1e2-d2bd-3831-b9a2-61305b274c6f",
                                "text": "„Und damit wird sich auch der Arztwitz anpassen und nicht aussterben.“"
                            },
                            {
                                "example_id": "652321d6-6337-4e9a-b3f0-a4716b61f12b",
                                "sense_id": "9f25d1e2-d2bd-3831-b9a2-61305b274c6f",
                                "text": "„Denn mit Arztwitzen darf man über Dinge reden, die sonst verboten sind.“"
                            },
                            {
                                "example_id": "179a2d2b-2941-49e7-bad6-17024a0411d1",
                                "sense_id": "9f25d1e2-d2bd-3831-b9a2-61305b274c6f",
                                "text": "„Was sich anhört wie der Anfang eines mittelmäßigen Arztwitzes, ist aber alles andere als zum Lachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
