                                "example_id": "f4a7f0b7-0bb4-4d9e-9fbe-50495f665bef",
                                "sense_id": "b7425778-f3a5-3d5b-afb0-a10a4d734b29",
                                "text": "En outre, la mobilité des retraités de cette seconde catégorie n’est pas la source de leur européanité, qu’ils avaient déjà développée au cours de leur vie professionnelle."
                            }
                        ]
                    },
