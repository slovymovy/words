                {
                    "sense_id": "254b3fc9-76d7-345e-91d4-ce883b7575b2",
                    "sense_definition": "Revêtement de sol, traditionnellement constitué de lattes de bois, sur lequel on marche dans une pièce.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a posé un beau <w>plancher</w> en chêne massif dans le salon."
                        },
                        {
                            "text": "Le vieux <w>plancher</w> grince chaque fois que quelqu'un traverse le couloir."
                        }
                    ],
                    "common_phrases": [
                        "plancher en bois",
                        "frotter le plancher"
                    ]
                },
                {
                    "sense_id": "944d85e5-6442-3b90-9e11-581c738305d6",
                    "sense_definition": "Limite inférieure ou niveau minimal réglementaire en dessous duquel une valeur ne peut descendre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a fixé un prix <w>plancher</w> pour protéger le revenu des agriculteurs."
                        },
                        {
                            "text": "Le juge a prononcé une peine <w>plancher</w> contre le récidiviste."
                        }
                    ],
                    "common_phrases": [
