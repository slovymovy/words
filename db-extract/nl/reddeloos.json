                        "sense_id": "e1f68884-3f84-3196-9c80-0ca2ec187ac4",
                        "entry_id": "23676ded-5433-33e2-92ff-095348cc8e20",
                        "glosses": [
                            "without any prospect of being saved or helped; unsalvageable; hopeless"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a59f72-87f2-4f96-b3c9-3f8763a6fb5f",
                                "sense_id": "e1f68884-3f84-3196-9c80-0ca2ec187ac4",
                                "text": "Als we niet snel investeerders vinden, is ons plan reddeloos.",
                                "translation": "If we don't find investors soon, our plan is beyond saving.",
                                "english": "If we don't find investors soon, our plan is beyond saving."
                            },
                            {
                                "example_id": "3661f9f2-eab4-4191-b57b-8054ce4c104e",
                                "sense_id": "e1f68884-3f84-3196-9c80-0ca2ec187ac4",
                                "text": "Zonder drinkwater zijn de scheepslui reddeloos verloren.",
                                "translation": "Without drinking water, the sailors are hopelessly lost.",
                                "english": "Without drinking water, the sailors are hopelessly lost."
                            }
                        ]
                    }
