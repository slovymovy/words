                "senses": [
                    {
                        "sense_id": "b2f027a0-caf5-375b-af28-a8f6e3de24c5",
                        "entry_id": "4c82841e-d87b-336d-8130-89b6d83d9cdb",
                        "glosses": [
                            "bevoegd; bekwaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c450e9ae-d949-41bc-8504-4859c0300a46",
                                "sense_id": "b2f027a0-caf5-375b-af28-a8f6e3de24c5",
                                "text": "Het vertrek van een reeks hooggeplaatste functionarissen werd op 5 juli ingeluid door minister van Financiën Rishi Sunak en gezondheidsminister Sajid Javid. Het tweetal uitte bij hun vertrek felle kritiek op Johnson. Ze schreven in een verklaring dat de overheid geen \"goed, competent en serieus werk\" verricht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a6bbed7-370f-4e91-821a-1ddda633fd49",
                        "source_entry_id": "4c82841e-d87b-336d-8130-89b6d83d9cdb",
                        "source_sense_id": "b2f027a0-caf5-375b-af28-a8f6e3de24c5",
                        "source_sense_description": "bevoegd; bekwaam",
                        "target_lang_word": "kompetent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kompetent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71ecb266-74c1-3074-a0df-835f570f91d1",
                                        "entry_id": "49e26e8f-1bcd-3120-b1b0-ae00971d2fd1",
                                        "glosses": [
                                            "fähig, über das nötige Wissen, Können verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17cd1221-55b1-4751-b472-6b2f4b2b77ab",
                                                "sense_id": "71ecb266-74c1-3074-a0df-835f570f91d1",
                                                "text": "„Wer gefahrenträchtige Ereignisse auf sich zutreiben läßt, wird sich bestenfalls als ein gutwilliger, an der Aufgabe wachsender, wohl kaum aber als ein sehr kompetenter Krisenmanager in der akuten Situation erweisen.“"
                                            },
                                            {
                                                "example_id": "b21d9e54-989a-4154-b055-c738177691af",
                                                "sense_id": "71ecb266-74c1-3074-a0df-835f570f91d1",
                                                "text": "Unser Sicherheitschef ist sehr kompetent."
                                            },
                                            {
                                                "example_id": "44fb35f3-173e-4c8a-af44-71607e5f0787",
                                                "sense_id": "71ecb266-74c1-3074-a0df-835f570f91d1",
                                                "text": "„Frank-Walter Steinmeier hingegen erweckt in seinen von Nominalstil geprägten, stärker strukturierten Reden eher den Eindruck des kompetenten Experten, der auf zahlreiche feststehende Wendungen (vor allem Paar- und Drillingsformen) zurückgreift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59abf281-3c6e-3001-970d-9a63a9984c56",
                                        "entry_id": "49e26e8f-1bcd-3120-b1b0-ae00971d2fd1",
                                        "glosses": [
                                            "zuständig, befugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0e4ad2-6ac2-4d40-b653-33b066d1286f",
                                                "sense_id": "59abf281-3c6e-3001-970d-9a63a9984c56",
                                                "text": "Das Gericht verwies den Fall weiter, weil es für solche Fälle nicht kompetent sei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "132bec89-135c-452b-9beb-52cb171afb1d",
                        "source_entry_id": "4c82841e-d87b-336d-8130-89b6d83d9cdb",
                        "source_sense_id": "b2f027a0-caf5-375b-af28-a8f6e3de24c5",
                        "source_sense_description": "bevoegd; bekwaam",
                        "target_lang_word": "competent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "competent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Having sufficient skill, knowledge, ability, or qualifications."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89350273-d8cc-4bf1-b25e-6c12884199da",
                                                "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                                "text": "He is a competent skier and an expert snowboarder."
                                            },
                                            {
                                                "example_id": "771532ae-d746-4da6-98e5-d657990b9ae8",
                                                "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                                "text": "I believe in that myself because it has been explained by competent men as the convolutions of the grey matter."
                                            },
                                            {
                                                "example_id": "9cfa09c6-3425-4bdb-90a4-cf5c49649684",
                                                "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                                                "text": "That as a competent keyless citizen he had proceeded energetically from the unknown to the known through the incertitude of the void."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Having jurisdiction or authority over a particular issue or question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4526445c-9655-4139-a33e-068d7d6e632b",
                                                "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                                                "text": "For any disagreements arising from this contract, the competent court shall be the Springfield Circuit Court."
                                            },
                                            {
                                                "example_id": "0a307a4a-1990-41f3-a04a-84b29b6065e4",
                                                "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                                                "text": "judicial authority having competent jurisdiction"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8610abb-87e5-3107-b1fe-ddcad8fb544f",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Adequate for the purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ed5c2c-5424-46c5-b759-8de43c460cff",
                                                "sense_id": "c8610abb-87e5-3107-b1fe-ddcad8fb544f",
                                                "text": "For if they [birds] had been Viviparous, the burthen of their womb, if they had brought forth any competent number at a time, had been ſo big and heavy, that their wings would have failed them, and ſo every body would have had the wit to catch the Old one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3dad82-30f7-3549-ad68-fba7eb70a7c6",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Functionally in order; functioning adequately."
                                        ],
                                        "tags": [
                                            "of an organ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5bc40ff-76cc-4d27-a98f-3595bb0f9f1c",
                                                "sense_id": "4e3dad82-30f7-3549-ad68-fba7eb70a7c6",
                                                "text": "a competent sphincter;   a competent cervix;   a competent immune system"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ff79dbc-6430-3397-8be0-a590aeb3379a",
                                        "entry_id": "79717090-774b-3d14-886f-600968ebc3d0",
                                        "glosses": [
                                            "Permeable to foreign DNA."
