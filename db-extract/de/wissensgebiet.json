                "senses": [
                    {
                        "sense_id": "c2f96a25-c6a5-35dd-9d4e-6aa06771bae6",
                        "entry_id": "a6186f5c-05d6-34e5-97b6-a68b59d705c4",
                        "glosses": [
                            "thematischer Bereich, in dem Wissen vorhanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5955d00-2fa0-43f9-b7ba-00d9c96e6b21",
                                "sense_id": "c2f96a25-c6a5-35dd-9d4e-6aa06771bae6",
                                "text": "„Sofort fragte er mich, mit welchem Wissensgebiet ich mich beschäftige, und als ich ihm antwortete, ich sei in der Grammatikklasse, glaubte er, ich mache Scherz.“"
                            },
                            {
                                "example_id": "44241366-9fd7-4087-941d-f36facf433cc",
                                "sense_id": "c2f96a25-c6a5-35dd-9d4e-6aa06771bae6",
                                "text": "„Hier kam er zum ersten Male mit all jenen Wissensgebieten in nähere Berührung, die ihm auf der Schule verschlossen blieben: Philosophie, Mathematik und Naturwissenschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
