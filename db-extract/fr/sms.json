            {
                "entry_id": "12df5a56-9bd8-3d48-bacc-902c80e7102a",
                "word": "SMS",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5020da3f-4b90-4ab7-b53c-06b0c34d1f7f",
                        "entry_id": "12df5a56-9bd8-3d48-bacc-902c80e7102a",
