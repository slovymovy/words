                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f25ac4-3d65-38d6-8cd7-41f5317aa9aa",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Overwhelmed by mixed emotions, moved, almost tearful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ff8c71-a51d-402b-8e4f-2be26c13a198",
                                                "sense_id": "09f25ac4-3d65-38d6-8cd7-41f5317aa9aa",
                                                "text": "She became emotional hearing about the passing of her mother."
                                            },
                                            {
                                                "example_id": "24a58dba-76fe-49df-bdaa-be529d868985",
