                                                "sense_id": "eb8980cc-3bd4-3a09-b15f-30c4be3404b7",
                                                "text": "Der Unterboden enthält Ton und ist eisenhaltig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "484fc2f2-9f13-3eaa-b28c-55dbdfacdc6c",
