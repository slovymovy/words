                "senses": [
                    {
                        "sense_id": "759a3b2e-e089-3d6c-8e48-3bc53962e0cd",
                        "entry_id": "dadd5e57-2986-33b3-86c2-6ed460ff28b6",
                        "glosses": [
                            "vol met sap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2350726e-268c-40b2-b5f3-b18673610080",
                                "sense_id": "759a3b2e-e089-3d6c-8e48-3bc53962e0cd",
                                "text": "Hij zat een sappige perzik te eten."
                            },
                            {
                                "example_id": "a707b3d1-bc59-4c65-9aa2-17b9707a35cb",
                                "sense_id": "759a3b2e-e089-3d6c-8e48-3bc53962e0cd",
                                "text": "Veel leuker, maar ook langzamer, is de Route Nationale 7. Veel sterker dan op de Autoroute ervaar je hoe het landschap langzaam van kleur verschiet, van het sappige groen van de Bourgogne naar het azuurblauw van de Méditerranée, via het droge geel van de Provence."
                            }
                        ]
                    },
                    {
                        "sense_id": "27bde92b-c8ec-30a9-bb6a-0a4c246463b1",
                        "entry_id": "dadd5e57-2986-33b3-86c2-6ed460ff28b6",
                        "glosses": [
                            "overdrachtelijk vol opwindende details"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bffa86d-3bbe-4dd4-92b7-88155c18bada",
                                "sense_id": "27bde92b-c8ec-30a9-bb6a-0a4c246463b1",
                                "text": "De journalisten waren er als de kippen bij om dat sappige verhaal openbaar te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
