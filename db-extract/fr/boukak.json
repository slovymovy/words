                        ],
                        "examples": [
                            {
                                "example_id": "cec2b321-1759-4a5b-8394-6bdd4b7adf0e",
                                "sense_id": "4419ca4e-732c-3fe7-be94-1e52e696fe3a",
                                "text": "Un boukak nous avouera que des émissaires rebelles les avaient avertis la veille."
                            },
                            {
                                "example_id": "15007e4c-620c-448c-9459-d93db7c116ef",
                                "sense_id": "4419ca4e-732c-3fe7-be94-1e52e696fe3a",
                                "text": "J'ai pas peur, je suis un fou moi ! Je serais le premier dans la rue à l'attaque moi !!! Je vais dans la rue et je butte les boukaks, moi ! Ça va couiner !!!"
                            }
                        ]
                    }
