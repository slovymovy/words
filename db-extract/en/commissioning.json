                                        "sense_id": "cb9d455a-684f-380f-91d2-0c8a27bc7385",
                                        "entry_id": "8e71e8e4-0edb-3ce5-83fe-8d832c118319",
                                        "glosses": [
                                            "Die erstmalige Nutzung einer Anlage, Maschine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcce8b87-300a-43f4-9e1a-85756c9bc47c",
                                                "sense_id": "cb9d455a-684f-380f-91d2-0c8a27bc7385",
                                                "text": "„In der früheren Sowjetunion nehmen zwischen 1986 und 1996 über ein Dutzend neue Atomkraftwerke ihren Betrieb auf, drei noch im Jahr der Katastrophe. 1987, die Strahlenglut in der Ukraine ist noch nicht verloschen, feiern die Sowjets die Inbetriebnahme eines 1500-Megawatt-Riesen vom Tschernobyl-Typ im später litauischen Ignalina. 1996 steht ein solcher Meiler im westrussischen Kursk vor der Vollendung.“"
                                            },
                                            {
                                                "example_id": "a36153a8-d2b3-4e03-946d-1a0a04d0c537",
                                                "sense_id": "cb9d455a-684f-380f-91d2-0c8a27bc7385",
                                                "text": "„Schon bei der Inbetriebnahme der Harzquer- und Brockenbahn war der Schwerpunkt des Bahnbetriebes kein anderer als heute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3cbc5e7-72b8-4d01-ba0a-e69d8989f34a",
                        "source_entry_id": "5bfb7db7-2ad2-3c69-ad91-c1dde796f6f2",
                        "source_sense_id": "5b3068e9-aace-3e5c-9743-a9bb421c603d",
