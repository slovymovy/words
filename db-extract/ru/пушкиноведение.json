                "senses": [
                    {
                        "sense_id": "290fc9cf-62aa-3356-86f4-a35aaba843cf",
                        "entry_id": "6eff3982-ad1f-3675-9f00-6de75c89df8b",
                        "glosses": [
                            "раздел литературоведения и истории литературы, посвящённый творчеству и биографии русского поэта А. С. Пушкина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2ff3f3-28b9-4a04-b9a2-1a3ecd11f3cb",
                                "sense_id": "290fc9cf-62aa-3356-86f4-a35aaba843cf",
                                "text": "Новое пушкиноведение в лице самых сильных своих основоположников объявило как бы научную секуляризацию образа Пушкина."
                            },
                            {
                                "example_id": "5a11dcae-59be-460f-a284-7a887efc5308",
                                "sense_id": "290fc9cf-62aa-3356-86f4-a35aaba843cf",
                                "text": "Изобилие зарубежных работ в области пушкиноведения и их высокая (высочайшая) ценность не могут заслонить от нас такого уникального феномена-парадокса, как «непереводимость» Пушкина."
                            }
                        ]
                    }
