                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor removed all the unnecessary <w>its</w> from the text.",
                            "target_lang_translations": {
                                "ru": "Редактор удалил все ненужные <w>слова «it»</w> из текста.",
                                "zh": "编辑删除了文中所有多余的<w>“it”</w>。"
                            }
                        },
                        {
                            "text": "He counted the <w>its</w> and thats in the speech.",
                            "target_lang_translations": {
                                "ru": "Он пересчитал все <w>«it»</w> и «that» в этой речи.",
                                "zh": "他数了数演讲中出现的<w>“it”</w>和“that”的次数。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число слова «it»",
                        "zh": "单词“it”的复数形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слова «it»",
                                "target_lang_sense_clarification": "упоминание слова в тексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "“it”这个词",
                                "target_lang_sense_clarification": "指代作为名词使用的单词本身"
                            }
                        ]
                    }
                }
            ]
        }
    ]
