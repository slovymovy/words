                        "entry_id": "e3003375-76d2-307a-ad98-9f80f174e31a",
                        "glosses": [
                            "het geheel van mechanismes binnen de mens of een ander organisme, dat intern zorgt voor de afweer tegen ziekteverwekkers als bacteriën en virussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f88002-9023-48e3-afd7-5dce9fcc1841",
                                "sense_id": "9c4dc26e-82b8-3a03-ad83-ed16f451f319",
                                "text": "Een patiënt met AIDS heeft een gestoord afweersysteem."
                            },
                            {
                                "example_id": "ad92d05b-282d-4949-acf4-daab15d6f6c6",
                                "sense_id": "9c4dc26e-82b8-3a03-ad83-ed16f451f319",
                                "text": "Zulke muizen hebben geen afweersysteem, waardoor ze zeer geschikt zijn voor het testen van geneesmiddelen in de ontwikkelingsfase."
                            }
                        ]
                    }
                ],
