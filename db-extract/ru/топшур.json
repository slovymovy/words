                "senses": [
                    {
                        "sense_id": "f41c9a66-06df-3e84-911c-11e00bc6143b",
                        "entry_id": "dd7f6402-e18e-3bba-b255-cb246fc9dcf8",
                        "glosses": [
                            "муз. алтайский народный щипковый музыкальный инструмент с двумя струнами, аналог лютни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87eb9d23-5eae-440d-9ffc-988788f41987",
                                "sense_id": "f41c9a66-06df-3e84-911c-11e00bc6143b",
                                "text": "Певец принял трубку, поблагодарил кивком головы, отложил в сторону свой топшур, которому тоже нужен отдых, хотя у него и два голоса, а у кайчи только один…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fad4e88-d013-4526-a15a-7dbb60048357",
                        "source_entry_id": "dd7f6402-e18e-3bba-b255-cb246fc9dcf8",
                        "source_sense_id": "f41c9a66-06df-3e84-911c-11e00bc6143b",
                        "target_lang_word": "topshur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topshur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c69c9d5-fe4c-320a-9af9-ae8fa1509c63",
                                        "entry_id": "fac6c34f-eb44-330d-8c24-fdb3e4741048",
                                        "glosses": [
                                            "A plucked two-string lute traditionally used by the Altai people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffdf941b-8960-4487-b896-20e2ec5a33ab",
                                                "sense_id": "6c69c9d5-fe4c-320a-9af9-ae8fa1509c63",
                                                "text": "Favorite instruments of the Mongolians of Xinjiang are the matouqin, the sihu, the sanxian or three-stringed lute and the topshur."
                                            },
                                            {
                                                "example_id": "2da97050-1252-4d16-a0a8-af89e2453b9e",
                                                "sense_id": "6c69c9d5-fe4c-320a-9af9-ae8fa1509c63",
                                                "text": "In these services, traditional instruments like the komus (mouth harp) and topshur (a two-stringed instrument), as well as well-established throat singing techniques, are often used."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
