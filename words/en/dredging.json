{
    "word_family": [
        "dredge",
        "dredger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8092457d-f816-3e7d-8f46-53f9afe6169e",
                    "sense_definition": "present participle and gerund of <w>dredge</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dredge_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The environmental team is currently <w>dredging</w> the canal to remove toxic waste.",
                            "target_lang_translations": {
                                "ru": "Экологическая группа в настоящее время проводит <w>очистку</w> канала для удаления токсичных отходов."
                            }
                        },
                        {
                            "text": "After <w>dredging</w> the river, the water flow improved significantly.",
                            "target_lang_translations": {
                                "ru": "После <w>углубления</w> реки поток воды значительно улучшился."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dredging the river",
                        "dredging up memories"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола dredge (проводить дноуглубительные работы, очищать дно)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очистка",
                                "target_lang_sense_clarification": "процесс удаления ила или мусора со дна"
                            },
                            {
                                "target_lang_word": "углубление",
                                "target_lang_sense_clarification": "процесс увеличения глубины водоема"
                            },
                            {
                                "target_lang_word": "драгирование",
                                "target_lang_sense_clarification": "технический термин для работ с использованием драги"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54295a88-5c05-3a6d-adad-9c5bd523dcdb",
                    "sense_definition": "The act of using a dredger or excavator to clear or deepen a harbour, river, or channel.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dredge_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The port authority announced that the annual <w>dredging</w> of the harbor will begin next week.",
                            "target_lang_translations": {
                                "ru": "Администрация порта объявила, что ежегодные <w>дноуглубительные работы</w> в гавани начнутся на следующей неделе."
                            }
                        },
                        {
                            "text": "Extensive <w>dredging</w> was required to allow larger ships to enter the bay.",
                            "target_lang_translations": {
                                "ru": "Потребовалось масштабное <w>драгирование</w>, чтобы позволить более крупным судам заходить в залив."
                            }
                        }
                    ],
                    "synonyms": [
                        "excavation"
                    ],
                    "common_phrases": [
                        "harbor dredging",
                        "maintenance dredging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по использованию земснаряда или экскаватора для очистки или углубления гавани, реки или канала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дноуглубительные работы",
                                "target_lang_sense_clarification": "официальный технический термин"
                            },
                            {
                                "target_lang_word": "расчистка русла",
                                "target_lang_sense_clarification": "в контексте рек и каналов"
                            },
                            {
                                "target_lang_word": "драгирование",
                                "target_lang_sense_clarification": "процесс работы драги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db8add8b-5213-393a-b8b5-11d93c48eeea",
                    "sense_definition": "The material, such as silt or sediment, that has been brought up from the bottom of a body of water.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dredge_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists analyzed the <w>dredgings</w> from the ocean floor to study ancient marine life.",
                            "target_lang_translations": {
                                "ru": "Ученые проанализировали <w>донные отложения</w>, поднятые с океанского дна, чтобы изучить древнюю морскую жизнь."
                            }
                        },
                        {
                            "text": "The <w>dredgings</w> of the bottom came new types of sediment that surprised the researchers.",
                            "target_lang_translations": {
                                "ru": "В <w>вынутом грунте</w> со дна обнаружились новые типы осадков, которые удивили исследователей."
                            }
                        }
                    ],
                    "synonyms": [
                        "sediment",
                        "silt"
                    ],
                    "common_phrases": [
                        "ocean dredgings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, такой как ил или осадок, поднятый со дна водоема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донные отложения",
                                "target_lang_sense_clarification": "научный термин для поднятого материала"
                            },
                            {
                                "target_lang_word": "вынутый грунт",
                                "target_lang_sense_clarification": "технический термин в строительстве и инженерии"
                            },
                            {
                                "target_lang_word": "ил",
                                "target_lang_sense_clarification": "осадочный материал"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}