    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                    "sense_definition": "Document imprimé ou numérique qui présente l'ensemble des jours, des semaines et des mois d'une année donnée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai accroché un grand <w>calendrier</w> sur le mur pour noter mes rendez-vous importants."
                        },
                        {
                            "text": "Chaque matin de décembre, les enfants ouvrent une case de leur <w>calendrier</w> de l'Avent."
                        }
                    ],
                    "synonyms": [
                        "almanach"
                    ],
                    "common_phrases": [
                        "calendrier de l'Avent",
                        "calendrier mural",
                        "consulter le calendrier"
                    ]
                },
                {
                    "sense_id": "c6786b08-2904-3c29-a5ae-3d83b232e24e",
                    "sense_definition": "Échéancier ou programme prévisionnel fixant les dates successives de réalisation de divers événements ou travaux.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "planification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe fait tout son possible pour respecter le <w>calendrier</w> fixé par la direction."
                        },
                        {
                            "text": "Le ministre a dévoilé le <w>calendrier</w> électoral prévu pour le scrutin du printemps."
                        }
                    ],
                    "common_phrases": [
                        "respecter le calendrier",
                        "calendrier prévisionnel",
                        "calendrier électoral"
                    ]
                },
                {
                    "sense_id": "96bd6fde-a6e1-3dcd-90ac-c34e68954341",
                    "sense_definition": "Système de division et d'organisation du temps en années, mois et jours, fondé sur des cycles astronomiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "systeme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La plupart des pays du monde utilisent aujourd'hui le <w>calendrier</w> grégorien dans la vie quotidienne."
                        },
                        {
                            "text": "Cette fête traditionnelle est fixée d'après les cycles du <w>calendrier</w> lunaire."
                        }
                    ],
                    "common_phrases": [
                        "calendrier lunaire",
                        "calendrier solaire",
                        "calendrier grégorien"
                    ]
                }
            ]
        }
    ]
