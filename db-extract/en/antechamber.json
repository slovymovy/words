                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "217eb87c-a58b-4d1b-9df1-05a151306a2b",
                                                "sense_id": "623ed797-b2f5-3cac-a4da-873468e22636",
                                                "text": "In der Pyramide entdeckte man eine sehr niedrige Tür, die zu einem weiteren Raum führte, zu einer Vorkammer."
