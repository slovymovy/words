                ],
                "senses": [
                    {
                        "sense_id": "acd4f49c-9c48-3ba5-8a12-f8741e8a3c9d",
                        "entry_id": "877f5506-220d-380a-a68a-d42e3447d8f2",
                        "glosses": [
                            "Waffe, die für Kampfhandlungen über größere/große Entfernung geeignet/vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e297864-f59f-4eb0-87db-fbf1260d3ac6",
                                "sense_id": "acd4f49c-9c48-3ba5-8a12-f8741e8a3c9d",
                                "text": "Sowohl der mittelalterliche Langbogen als auch das neuzeitliche Scharfschützengewehr sind Fernkampfwaffen."
                            },
                            {
                                "example_id": "34f3007a-8546-42d6-9447-eec5630804d6",
                                "sense_id": "acd4f49c-9c48-3ba5-8a12-f8741e8a3c9d",
                                "text": "„Die römischen Reiter bevorzugten den Nahkampf gegenüber dem Einsatz von Fernkampfwaffen und der damit verbundenen hellenistischen Kampfweise von Reitern.“"
                            },
                            {
                                "example_id": "f5d8b5d7-28d3-408b-823f-f38e2dff659b",
                                "sense_id": "acd4f49c-9c48-3ba5-8a12-f8741e8a3c9d",
                                "text": "„Die Wagenburg wurde als Oval oder Rechteck errichtet. Da auch Fernkampfwaffen eingesetzt wurden, mussten ihre Gegner in der Regel absitzen und gegen die erhöht postierte Wagenburg anrennen.“"
                            },
                            {
                                "example_id": "405b6e4e-ef59-4a83-9ca2-9d6931e77c28",
                                "sense_id": "acd4f49c-9c48-3ba5-8a12-f8741e8a3c9d",
                                "text": "„Die wichtigsten Fernkampfwaffen der leichten und schweren Reiterei waren Pfeil und Bogen, Wurflanze und Wurfspieß.“"
                            },
                            {
                                "example_id": "a9a9cf9f-4a12-4460-9dfc-f3a05b86265d",
                                "sense_id": "acd4f49c-9c48-3ba5-8a12-f8741e8a3c9d",
                                "text": "„Die Elitisten und Schildmaiden mit den Fernkampfwaffen positionierten sich geschickt, vor ihnen knieten die Männer und Frauen mit den langen Pieken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
