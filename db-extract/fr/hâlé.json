                                "target_senses": [
                                    {
                                        "sense_id": "901d515b-1479-34cf-bc74-d46d3e503543",
                                        "entry_id": "c36de6a6-544d-3c4d-a3b3-22ee50e9ba29",
                                        "glosses": [
                                            "von der Sonne gebräunt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e48732a-0792-4d05-9756-8889d93aadb8",
                                                "sense_id": "901d515b-1479-34cf-bc74-d46d3e503543",
                                                "text": "Urlauber kommen braungebrannt aus den Ferien im Süden zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a566d07-f2f3-4094-aa14-0be521be4378",
                        "source_entry_id": "c4bc58da-98a9-3da8-b5e7-a7ec990be8c7",
                        "source_sense_id": "695eef28-8a60-319f-bd84-8c81a4a582ff",
                        "target_lang_word": "sonnengebräunt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonnengebräunt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "394ec466-fc66-3499-9260-b003307fa25e",
                                        "entry_id": "3072cdd8-16fa-3258-a6d7-d236b3d46374",
                                        "glosses": [
                                            "durch die Einwirkung von Sonnenstrahlen eine braune Hautfarbe erhalten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4546f38-e914-4e0c-946a-72e37cd4137a",
                                                "sense_id": "394ec466-fc66-3499-9260-b003307fa25e",
                                                "text": "„Die Kugel zerschmetterte den sonnengebräunten Schädel des Terroristen, der in ein Dutzend Stücke zersprang, und verspritzte sein Gehirn über das Metallgitter hinter ihm.“"
                                            },
                                            {
                                                "example_id": "0699c17e-f0fe-41dd-9ec5-5c74f8c94859",
                                                "sense_id": "394ec466-fc66-3499-9260-b003307fa25e",
                                                "text": "„Stattdessen erhielt ich selber Besuch. Es war das ein etwa fünfzigjähriger Mann mit aufrechter Haltung und forschen Manieren, von einer fast militärischen Adrettheit, mit sonnengebräuntem Gesicht und harten, grauen Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88e833b2-2d76-4db7-bfe8-b7f978af756a",
                        "source_entry_id": "c4bc58da-98a9-3da8-b5e7-a7ec990be8c7",
                        "source_sense_id": "695eef28-8a60-319f-bd84-8c81a4a582ff",
                        "target_lang_word": "wettergegerbt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wettergegerbt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfad3bed-8fb1-3b83-82f9-39098cf3fe60",
                                        "entry_id": "39741b3e-ae88-3fb2-bb92-873c388c81ea",
                                        "glosses": [
                                            "ledrig seiend als Langzeitfolge von Arbeiten unter freiem Himmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802288a9-354f-4519-9a78-cadc2004ad67",
                                                "sense_id": "bfad3bed-8fb1-3b83-82f9-39098cf3fe60",
                                                "text": "„Ich hatte das Kodak-Foto wiederholt studiert, und sein festes, wettergegerbtes Gesicht mit dem kurzen grauen Bart war unverkennbar.“"
                                            },
                                            {
                                                "example_id": "3b418e4e-c977-4b1c-ad79-28f0d20ae3cb",
                                                "sense_id": "bfad3bed-8fb1-3b83-82f9-39098cf3fe60",
                                                "text": "„Er hatte ihn nur einmal gesehen, als er zwei oder drei Jahre alt gewesen war, aber er hatte das wettergegerbte, zernarbte Gesicht und den schmucken weißen Bart nie vergessen können.“"
                                            },
                                            {
                                                "example_id": "cf229f12-8eb5-435c-a154-c14264692b80",
                                                "sense_id": "bfad3bed-8fb1-3b83-82f9-39098cf3fe60",
                                                "text": "„Auf dem Marktplatz hockten zwei der Delawaren und der Vorreiter Webster mit einer wettergegerbten Alten im Sand.“"
                                            },
                                            {
                                                "example_id": "ff9213ac-3dd0-46c8-8d04-6456625e268e",
                                                "sense_id": "bfad3bed-8fb1-3b83-82f9-39098cf3fe60",
                                                "text": "„›Hai, Anjin-san?‹, sagte der Steuermann, ein Mann wohl in den Dreißigern mit blendend weißen Zähnen und einem breiten, wettergegerbten Gesicht.“"
                                            },
                                            {
                                                "example_id": "6b8119e4-7c7e-4e70-9231-e55f0f56c55d",
                                                "sense_id": "bfad3bed-8fb1-3b83-82f9-39098cf3fe60",
                                                "text": "„Die Propeller wirbelten trockenen Staub und scharfkörnigen Sand in die wettergegerbten Gesichter und gegen die ausgetrockneten Hälse der fünf Männer, die auf dem Asphalt am Rand der ausgeklappten Rampe des Flugzeugs warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4d3d566-2960-4ca1-9cfd-f9520caaad38",
                        "source_entry_id": "c4bc58da-98a9-3da8-b5e7-a7ec990be8c7",
                        "source_sense_id": "695eef28-8a60-319f-bd84-8c81a4a582ff",
                        "target_lang_word": "leathery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leathery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1f14f8c-f591-3c0f-a5ca-250cd12ea445",
                                        "entry_id": "2b72e303-52a4-3f55-ad3c-2af24ef5a0bf",
                                        "glosses": [
                                            "Having the consistency, feel, or texture of leather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1406aed4-e3b1-4bcf-941b-eef64d3ef7a5",
                                                "sense_id": "b1f14f8c-f591-3c0f-a5ca-250cd12ea445",
                                                "text": "The beef jerky was tough and leathery."
                                            },
                                            {
                                                "example_id": "5fc63ac9-eb8c-432e-aff1-02b922991b13",
                                                "sense_id": "b1f14f8c-f591-3c0f-a5ca-250cd12ea445",
                                                "text": "The Agaricales have basidiocarps which are fleshy to subfleshy or rarely, almost leathery (but if the latter then the hymenophore is not poroid)."
                                            },
                                            {
                                                "example_id": "0038a793-a11f-4db3-bd74-9a25e58eceea",
                                                "sense_id": "b1f14f8c-f591-3c0f-a5ca-250cd12ea445",
                                                "text": "It is a staggering work, leathery and reliclike, with most of Pop Art embedded in its fragile surfaces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "049c6983-fe84-406b-ba06-fa48f687302c",
                        "source_entry_id": "c4bc58da-98a9-3da8-b5e7-a7ec990be8c7",
                        "source_sense_id": "695eef28-8a60-319f-bd84-8c81a4a582ff",
                        "target_lang_word": "weather-beaten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weather-beaten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff5ed97-eca2-3ce2-a53e-c7830fd01fc0",
                                        "entry_id": "f20c1c3d-89ae-3da9-ad96-19030d39c75a",
                                        "glosses": [
                                            "Beaten or harassed by the weather; worn or damaged by exposure to the weather or the outdoors, especially to severe weather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d09e45ad-cd5d-4a06-8d78-c4795567444b",
                                                "sense_id": "eff5ed97-eca2-3ce2-a53e-c7830fd01fc0",
                                                "text": "Near-synonym: weathered"
                                            },
                                            {
                                                "example_id": "2f831cbd-0891-4378-abaf-ed8fa43c0659",
                                                "sense_id": "eff5ed97-eca2-3ce2-a53e-c7830fd01fc0",
                                                "text": "Farther down the beach they saw a weather-beaten shack and an upturned boat."
                                            },
                                            {
                                                "example_id": "7e85c8f4-0ffd-41b3-bb25-60d3b42ab90f",
                                                "sense_id": "eff5ed97-eca2-3ce2-a53e-c7830fd01fc0",
                                                "text": "An old man with a weather-beaten face told them that the shack was used seasonally by fishermen."
                                            },
                                            {
                                                "example_id": "f5161b0e-9bf7-49b2-947e-20a4f07a8838",
                                                "sense_id": "eff5ed97-eca2-3ce2-a53e-c7830fd01fc0",
                                                "text": "Rasmus was a tall, powerful man, with a weather-beaten, furrowed face of a good-natured expression."
                                            },
                                            {
                                                "example_id": "3242a4c7-a14d-4da0-8fb5-42062c927c44",
                                                "sense_id": "eff5ed97-eca2-3ce2-a53e-c7830fd01fc0",
                                                "text": "The glass door opened and there entered a thick-set, mud-bespattered, weather-beaten dock laborer with bare head and bare feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
