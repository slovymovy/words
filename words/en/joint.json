                                "target_lang_word": "стык",
                                "target_lang_sense_clarification": "место соприкосновения труб, деталей"
                            },
                            {
                                "target_lang_word": "соедине́ние",
                                "target_lang_sense_clarification": "техническое скрепление"
                            },
                            {
                                "target_lang_word": "шарни́р",
                                "target_lang_sense_clarification": "подвижное соединение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接头",
                                "target_lang_sense_clarification": "管道或部件的连接处"
                            },
                            {
                                "target_lang_word": "连接处",
                                "target_lang_sense_clarification": "通用连接点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f883f134-d82d-352a-aa40-6271af5f9631",
                    "sense_definition": "A place of business, such as a bar, restaurant, or club, often one that is cheap or informal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "place_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We found a great little burger <w>joint</w> downtown that stays open late.",
                            "target_lang_translations": {
                                "ru": "Мы нашли отличное маленькое бургерное <w>заведение</w> в центре, которое работает допоздна.",
                                "zh": "我们在市中心发现了一家很棒的汉堡<w>小店</w>，营业到很晚。"
                            }
                        },
                        {
                            "text": "He doesn't like hanging out in this <w>joint</w> because the music is too loud.",
                            "target_lang_translations": {
                                "ru": "Ему не нравится тусоваться в этом <w>кабаке</w>, потому что музыка слишком громкая.",
                                "zh": "他不爱待在这个<w>地方</w>，因为音乐声太大了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spot"
                    ],
                    "common_phrases": [
                        "burger joint",
                        "pizza joint",
                        "fast-food joint",
                        "clip joint"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to refer to establishments informally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заведение, такое как бар, ресторан или клуб, часто недорогое или неформальное.",
                        "zh": "指酒吧、餐馆或俱乐部等营业场所，通常指廉价或非正式的场所。"
                    },
                    "translations": {
                        "ru": [
