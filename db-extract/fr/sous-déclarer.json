                "senses": [
                    {
                        "sense_id": "13dab5e7-0f44-39ce-a194-b936830df4b3",
                        "entry_id": "9e885443-4519-394d-9bdb-6494e81ae482",
                        "glosses": [
                            "Déclarer moins que la réalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e075796e-8cde-472b-bf9f-d16bf2985519",
                                "sense_id": "13dab5e7-0f44-39ce-a194-b936830df4b3",
                                "text": "Ceci est un principe car en réalité, ce genre de règlement incite certains exportateurs à sous-déclarer leurs recettes."
                            },
                            {
                                "example_id": "7b5a338f-e9ff-4c22-b814-c8165e87a942",
                                "sense_id": "13dab5e7-0f44-39ce-a194-b936830df4b3",
                                "text": "Ceci a dû inciter les éleveurs à moins sous-déclarer (voire à sur-déclarer?) leur cheptel."
                            },
                            {
                                "example_id": "827e4512-371e-42a8-bb8d-31e815c24319",
                                "sense_id": "13dab5e7-0f44-39ce-a194-b936830df4b3",
                                "text": "Selon le ministère de l’Éducation nationale, le harcèlement scolaire touche au moins un élève sur dix, sachant que les faits sont souvent sous-déclarés en raison de la peur des représailles."
                            }
                        ]
                    }
