                "senses": [
                    {
                        "sense_id": "0dcfacc4-fda8-34a6-86df-d93be840cf58",
                        "entry_id": "889c1ca9-8f34-372f-9d0f-eb8d2960f801",
                        "glosses": [
                            "Soumettre (les tabacs reçus dans les magasins) à un traitement qui les prépare aux différents emplois."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a581a769-5f96-3b86-8955-d95b367cdf85",
                        "entry_id": "889c1ca9-8f34-372f-9d0f-eb8d2960f801",
                        "glosses": [
                            "Laisser reposer une viande (jusqu’à un mois) au frigo."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f0d394f6-c867-369d-ac72-c00bf47a476e",
                        "entry_id": "889c1ca9-8f34-372f-9d0f-eb8d2960f801",
                        "glosses": [
                            "Rendre plus mature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5bf0dc8-624e-4217-b34a-039b418466fa",
                                "sense_id": "f0d394f6-c867-369d-ac72-c00bf47a476e",
                                "text": "Laissez mâturer pendant 12 heures à 4 °C, puis turbinez."
                            },
                            {
                                "example_id": "4a9d6daf-5249-4e0b-afc6-2e4c22a0197e",
                                "sense_id": "f0d394f6-c867-369d-ac72-c00bf47a476e",
                                "text": "À la puberté, l’une de ces oogonies commence à mâturer et à augmenter de taille."
                            },
                            {
                                "example_id": "1ef58f18-ef82-4b70-b99c-de616f2ef811",
                                "sense_id": "f0d394f6-c867-369d-ac72-c00bf47a476e",
                                "text": "[…]caniculer, grioler, mâturer. -BP. Mûrir, en parlant des raisins noirs. Quand la couleur apparaît, le raisin est en train de mâturer."
                            },
                            {
                                "example_id": "ea48fad1-7c98-4609-8e37-6f02d0faf0fc",
                                "sense_id": "f0d394f6-c867-369d-ac72-c00bf47a476e",
                                "text": "Toutes les cuvées du champagne Jacquart sont élaborées dans les celliers de la Maison, où mâturent lentement plus de 20 millions de bouteilles."
                            }
                        ]
                    }
