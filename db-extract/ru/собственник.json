                "translations": [
                    {
                        "translation_id": "71a865ca-c80e-426c-bb1f-8da9a7191e8c",
                        "source_entry_id": "c0637c43-3f9f-3a83-aeeb-cf4fa8b7bb71",
                        "target_lang_word": "owner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "owner",
