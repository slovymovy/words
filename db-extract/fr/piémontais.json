                "senses": [
                    {
                        "sense_id": "0db39dda-f8a2-3fe3-ab47-fa1b6a43a451",
                        "entry_id": "e64da631-bc93-39fb-a1f9-8df2fcf5a61a",
                        "glosses": [
                            "Habitant du Piémont, région située au nord-ouest de l’Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70803837-e590-4a27-833e-dc3189871372",
                                "sense_id": "0db39dda-f8a2-3fe3-ab47-fa1b6a43a451",
                                "text": "Mordi, Monsieur, dit-il avec cet horrible accent de la montagne qui ferait au premier mot reconnaître un Piémontais entre cent étrangers, ne sommes-nous pas ici près du Louvre ?"
                            },
                            {
                                "example_id": "e0f791dc-c41f-4789-a9b0-c1e51fb8b29c",
                                "sense_id": "0db39dda-f8a2-3fe3-ab47-fa1b6a43a451",
                                "text": "Dans le fond l’église on entendait les rires étouffés des filles monégasques, on distinguait les mots de : « Piafou ! Piafi ! » qui désignent les Piémontais."
                            },
                            {
                                "example_id": "8bc29af7-1485-447b-9501-6bc79ca587ec",
                                "sense_id": "0db39dda-f8a2-3fe3-ab47-fa1b6a43a451",
                                "text": "Il me fallait cependant une femme pour laver le linge. L'épicier m'indiqua une Piémontaise qui habitait cinq ou six portes au-dessus de nous. C'était une énorme petite femme, encore jeune, au beau visage de madone grasse."
                            }
                        ]
                    }
