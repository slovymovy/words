                        "glosses": [
                            "A moth of species Melese asana, of tropical South America."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94c16b7b-50ee-41bf-8e57-ec106dc7f82f",
                        "source_entry_id": "953c777b-5f08-3038-ab8f-6d0d880040bb",
