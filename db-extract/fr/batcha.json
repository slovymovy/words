                        "glosses": [
                            "En Asie centrale, enfant-serviteur, jeune domestique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac65624-5b4b-4e84-bb14-3ce3fbc771e8",
                                "sense_id": "e4507122-3589-3cca-940f-f4d37a90e7b7",
                                "text": "Le plus jeune de ses batchas, un garçon de treize ans, se glissa jusqu’à lui pour demander :\n— Faut-il rentrer la vaisselle et les samovars ?"
                            },
                            {
                                "example_id": "22114566-11ba-4fd0-a8bd-8403fb3dab28",
                                "sense_id": "e4507122-3589-3cca-940f-f4d37a90e7b7",
                                "text": "Le batcha voué à son service et qui dormait à même le sol dans le corridor devant sa porte, accourrait tout de suite et tout fier de l’habiller. Ce n’était qu’un enfant, mais n’importe qui, sur le domaine et aux environs – et fût-il dans le plein éclat de la vigueur, du mérite et de la liberté – eût tiré gloire de ce geste domestique."
                            }
                        ]
                    }
