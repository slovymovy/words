                                                "example_id": "dcbed679-a393-42cb-bbfe-eca56abf8981",
                                                "sense_id": "15213a33-719a-32b7-a343-cb9abee08370",
                                                "text": "„Du bist mein Schirm und Schild; ich hoffe auf dein Wort.“ Psalm 119.114 - Unter einer Schirmherrschaft stehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "209bd978-23f0-3d05-b650-e9dbe48cab6b",
                                        "entry_id": "82b67ce0-5501-3333-8903-5d4234a08f1f",
                                        "glosses": [
                                            "als Schutz vor dem Regen; Regenschirm"
                                        ],
                                        "tags": [
                                            "konkret"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a300dc8-088d-48e8-8885-af82ec589d6a",
                                                "sense_id": "209bd978-23f0-3d05-b650-e9dbe48cab6b",
                                                "text": "„Mist, ich habe meinen Schirm vergessen. Jetzt werde ich wohl oder übel nass werden.“"
                                            },
                                            {
                                                "example_id": "cb99373a-13a8-46c9-b2b1-f73d4d9e29b2",
                                                "sense_id": "209bd978-23f0-3d05-b650-e9dbe48cab6b",
                                                "text": "„Damen mit äußerst empfindlicher Frisur oder Aliens mit ebenso wasserscheuen Schaltkreisen werden immer einen Schirm mitnehmen, wir norddeutschen Glatzköpfe tun das nie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "aac1cf15-2628-3441-9732-5a2f1c1a9d33",
                                        "entry_id": "82b67ce0-5501-3333-8903-5d4234a08f1f",
                                        "glosses": [
                                            "Kurzform für Bildschirm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c203be57-1332-4ec4-befd-53243593154c",
                                                "sense_id": "aac1cf15-2628-3441-9732-5a2f1c1a9d33",
                                                "text": "„Sir, ich habe ein unbekanntes Flugobjekt ausgemacht.“ - „Geben sie es auf den Schirm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "771e2f74-efc2-308e-9089-3527e3554627",
                                        "entry_id": "82b67ce0-5501-3333-8903-5d4234a08f1f",
                                        "glosses": [
                                            "Kurzform für einen Gegenstand, der vom Aussehen einem Regenschirm nahekommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b97283d4-35a6-4ec9-bca6-911462e09011",
                                                "sense_id": "771e2f74-efc2-308e-9089-3527e3554627",
                                                "text": "Der Schirm des Fallschirmspringers öffnete sich problemlos."
                                            },
                                            {
                                                "example_id": "fe4eff88-9042-420e-be59-6f011bbc40cf",
                                                "sense_id": "771e2f74-efc2-308e-9089-3527e3554627",
                                                "text": "„Heute sind die Schirme und ihre dreifachen Bremssysteme so ausgetüftelt, dass die Versicherungen das Snowkiten nicht mehr als Risikosport einstufen, sondern nur noch als Wagnis.“"
                                            },
                                            {
                                                "example_id": "3609f33e-ce71-4d32-842f-daa173eadb3e",
                                                "sense_id": "771e2f74-efc2-308e-9089-3527e3554627",
                                                "text": "„Der Gleitschirmflieger spielt mit den technischen Möglichkeiten seines Fluggeräts und mit seinen Fertigkeiten: Er zieht den Schirm auf, lässt den Wind in die Kammern greifen und sie aufblähen, […] Er spielt mit den Leinen, den Bremsen, den Kräften des Winde in seinem Gleitschirm.“"
                                            },
                                            {
                                                "example_id": "f747eee5-c3fc-4067-a32a-682e8f006608",
                                                "sense_id": "771e2f74-efc2-308e-9089-3527e3554627",
                                                "text": "„Fliegen Gleitschirme in unterschiedlichen Höhen, müssen die Abstände so gewählt sein, dass der Höhenverlust beim Einklappen oder Sackflug des oberen Schirms nicht zur Kollision mit dem unteren führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93d66172-59d8-41bf-a8fa-9ca45b5173d7",
                        "source_entry_id": "51f6af0b-4ef3-3feb-88c7-996a9a184539",
                        "source_sense_id": "56ae7a4a-1f55-3ce7-b0dc-fc1aa8e1a8f5",
                        "target_lang_word": "Knirps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knirps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5be148a6-8e0e-3c14-8cd7-d8c30f6ecf0f",
                                        "entry_id": "60549c85-f004-37c8-ab06-babe7cee170c",
                                        "glosses": [
                                            "kleiner Junge"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92adf76e-c983-403d-b05c-9c0721dfb5ad",
                                                "sense_id": "5be148a6-8e0e-3c14-8cd7-d8c30f6ecf0f",
                                                "text": "Dieser Knirps stört mich beim Schreiben dieses Eintrags!"
                                            },
                                            {
                                                "example_id": "d62e466c-89b8-42c4-95db-8c7a468416e8",
                                                "sense_id": "5be148a6-8e0e-3c14-8cd7-d8c30f6ecf0f",
                                                "text": "„Die einzige Aufgabe, die ein sizilianischer Knirps bereits in jungen Jahren auferlegt bekommt, ist die, wie ein Wachhund auf seine Schwestern aufzupassen.“"
                                            },
                                            {
                                                "example_id": "235d73d2-7fa0-42d8-a1bf-93777d4d32a2",
                                                "sense_id": "5be148a6-8e0e-3c14-8cd7-d8c30f6ecf0f",
                                                "text": "„Der Krieg in seinem Land hatte die Kindheit abgeschafft und jeden Knirps gezwungen, sofort Verantwortung zu übernehmen.“"
                                            },
                                            {
                                                "example_id": "6b968a01-0e57-4aff-b81c-afcf55e10a04",
                                                "sense_id": "5be148a6-8e0e-3c14-8cd7-d8c30f6ecf0f",
                                                "text": "„Ich hatte wohl schon als Knirps geahnt, dass sich das Erlaubte eher leblos anfühlte und dass das Tabu eine Sünde versprach: die Sünde des Ungehorsams, die Sünde, nach verbotenen Früchten zu greifen.“"
                                            },
                                            {
                                                "example_id": "23c74529-1b37-46d3-8727-ef60a0fdb925",
                                                "sense_id": "5be148a6-8e0e-3c14-8cd7-d8c30f6ecf0f",
                                                "text": "„Der Knirps machte sich mit den Früchten davon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37825576-10cf-3b9a-ab6d-f0016c021354",
                                        "entry_id": "60549c85-f004-37c8-ab06-babe7cee170c",
                                        "glosses": [
                                            "ein unbedeutender und oder kleinwüchsiger Mann"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35772bf5-3822-406d-9de8-a3926046192c",
                                                "sense_id": "37825576-10cf-3b9a-ab6d-f0016c021354",
                                                "text": "Von dem Knirps würde ich mir gar nichts sagen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "99fe4e8e-a00d-3c40-b8fe-7a674036a945",
                                        "entry_id": "60549c85-f004-37c8-ab06-babe7cee170c",
                                        "glosses": [
                                            "zusammenschiebbarer Regenschirm der Marke Knirps^®"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487c7017-97f1-4cfb-bb5c-243c0c4dd912",
                                                "sense_id": "99fe4e8e-a00d-3c40-b8fe-7a674036a945",
                                                "text": "Oh, es beginnt zu regnen! Zum Glück habe ich meinen Knirps dabei!"
                                            }
