                    "sense_definition": "Practical knowledge, understanding, or shrewdness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His business <w>savvy</w> helped him turn the small shop into a successful franchise.",
                            "target_lang_translations": {
                                "ru": "Его деловая <w>смекалка</w> помогла ему превратить маленький магазин в успешную франшизу."
                            }
