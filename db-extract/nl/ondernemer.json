                "senses": [
                    {
                        "sense_id": "7d5957f9-3e99-3013-afef-3f56e653a396",
                        "entry_id": "2b2b8531-7e7a-3f5e-8562-cbe73dabd1d6",
                        "glosses": [
                            "iemand die een bedrijf voor eigen rekening start of runt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "ca161992-8ad0-4a06-8a0c-8db2b6855c75",
                                "sense_id": "7d5957f9-3e99-3013-afef-3f56e653a396",
                                "text": "De startende ondernemer."
                            },
                            {
                                "example_id": "30e76c15-084a-4919-b119-165fb82beb64",
                                "sense_id": "7d5957f9-3e99-3013-afef-3f56e653a396",
                                "text": "Thru-hikers leven in de maatschappij – off-trail – vaak op een strak budget, verdienen geld met seizoenswerk of worden zelfstandig ondernemer."
                            },
                            {
                                "example_id": "fc962908-cd68-464e-a898-b49b57129e97",
                                "sense_id": "7d5957f9-3e99-3013-afef-3f56e653a396",
                                "text": "Slimme puissant rijke ondernemers of kansloos verslaafd aan crack en fentanyl."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6aa2718d-7b11-4392-95e2-84014dceb595",
                        "source_entry_id": "2b2b8531-7e7a-3f5e-8562-cbe73dabd1d6",
                        "source_sense_id": "7d5957f9-3e99-3013-afef-3f56e653a396",
                        "target_lang_word": "entrepreneur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrepreneur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "890fe1f1-8560-332c-8ef6-c8aec2576514",
                                        "entry_id": "e0a69ce1-3be3-30a4-a645-5006dd7966f6",
                                        "glosses": [
                                            "A person who sets up a business; generally, a person who owns and manages a business and assumes its financial risks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734e5876-f31f-41d6-b4ac-73c62217e082",
                                                "sense_id": "890fe1f1-8560-332c-8ef6-c8aec2576514",
                                                "text": "Every rail company worth its salt wanted to connect with London. Interestingly, it was largely that way around - provincial entrepreneurs wanting to connect with the capital, rather than London capitalists seeking to spread outwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef59ada0-a00b-3b80-b8bb-6b30b95ef385",
                                        "entry_id": "e0a69ce1-3be3-30a4-a645-5006dd7966f6",
                                        "glosses": [
                                            "A person who organizes concerts, plays, or other entertainments; the manager of a theatre or similar venue; an impresario."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6191d286-b594-3672-baeb-65b904dba548",
                                        "entry_id": "e0a69ce1-3be3-30a4-a645-5006dd7966f6",
                                        "glosses": [
                                            "A person who serves as an intermediary; a middleman; a go-between."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22c2b3d4-8526-461b-9ba6-f0248bc5f7a8",
                                                "sense_id": "6191d286-b594-3672-baeb-65b904dba548",
                                                "text": "Chicago, it was, by way of compensation, beginning to take on the cosmopolitan cast of culture that it has worn ever since, as entrepreneur between the Old World and the New."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c248b0df-9de4-359a-9262-a2b0dd021dad",
                                        "entry_id": "e0a69ce1-3be3-30a4-a645-5006dd7966f6",
                                        "glosses": [
                                            "A person who manages an artist or performer; an agent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "525a3800-6474-41bf-bf78-f400107fe9d4",
                        "source_entry_id": "2b2b8531-7e7a-3f5e-8562-cbe73dabd1d6",
                        "source_sense_id": "7d5957f9-3e99-3013-afef-3f56e653a396",
                        "target_lang_word": "entrepreneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrepreneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                        "entry_id": "71197670-91c7-30c7-87fe-285b36a259ca",
                                        "glosses": [
                                            "Celui qui dirige une entreprise."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16bbcb19-8b5d-41f9-a2b3-823a3845b7cb",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "De 1793 à 1799, du Bousquier fut entrepreneur des vivres des armées françaises."
                                            },
                                            {
                                                "example_id": "68625578-b665-4d14-9247-f6f06b2a4fe4",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "Les entrepreneurs les plus en vue se nomment Deville ou Wendel."
                                            },
                                            {
                                                "example_id": "6fa351a7-ee19-4943-9499-eeb12b5b2000",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "Le statut d’entrepreneur individuel spécialisé dans la chnouf semble en contradiction avec une vocation de pédagogue se destinant à enseigner les valeurs du sport. À moins de se spécialiser dans le cyclisme."
                                            },
                                            {
                                                "example_id": "d2db67e1-d79b-40ab-86ac-21bbef734dbc",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "Marc de Comans et François de La Planche entrepreneurs de l’establissement de la fabricque et manufacture des tapisseries façon de Flandres"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c27bcf12-1292-3670-9d7c-4dd5919a31d9",
                                        "entry_id": "71197670-91c7-30c7-87fe-285b36a259ca",
                                        "glosses": [
                                            "(Travaux contractuels) Celui qui fait métier d’entreprendre sur contrat certains travaux, notamment de construction, ou de fournir des marchandises, des services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b476a7-263c-4bf0-bfb0-3607ea21c8be",
                                                "sense_id": "c27bcf12-1292-3670-9d7c-4dd5919a31d9",
                                                "text": "Les entrepreneurs avaient emprunté l’argent de la construction. Le locataire avait hypothéqué l’appartement. Tout le pays spéculait sur la propriété foncière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
