                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add9ee0c-02a6-45cf-8984-a06fc21007f2",
                                "sense_id": "77ea0453-d651-3a8b-b0d1-e9e649c396f0",
                                "text": "Le doute s’installe parmi les troupes macronistes, où certains craignent la « balladurisation » de leur champion face à Marine Le Pen."
                            }
                        ]
                    }
