                        ],
                        "examples": [
                            {
                                "example_id": "da5d01cb-f82c-4cae-aaff-71dc07a6b066",
                                "sense_id": "238720b9-a2a4-35d8-bb2a-01bacf36cba0",
                                "text": "But if you then decide you can afford to plant the trees anyway, whatever the effect on the landscape, flora and fauna, nobody can stop you — and again, no-one is going to ask you to unplant them once they're in the ground."
                            },
                            {
                                "example_id": "5026ae5c-fb2f-49a1-86b0-bd650f70b666",
                                "sense_id": "238720b9-a2a4-35d8-bb2a-01bacf36cba0",
                                "text": "Anything you build or plant on your neighbor's land you might have to unbuild or unplant in the future."
                            }
                        ]
                    }
