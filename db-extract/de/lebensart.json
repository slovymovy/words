                "senses": [
                    {
                        "sense_id": "84f3d6cc-0658-3586-9a9f-c1f9a609eb6c",
                        "entry_id": "d8591c22-429b-3189-8992-3ff1cabb19f0",
                        "glosses": [
                            "Die Art und Weise bzw. Eigenart sein eigenes Leben zu gestalten und zu führen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f82d4331-7d5c-40c5-9d46-02715d938199",
                                "sense_id": "84f3d6cc-0658-3586-9a9f-c1f9a609eb6c",
                                "text": "Sie genießt die feine Lebensart."
                            },
                            {
                                "example_id": "91063a87-ca9e-4d08-b38e-e4639d109c4d",
                                "sense_id": "84f3d6cc-0658-3586-9a9f-c1f9a609eb6c",
                                "text": "„Ich fand dort keine feine Lebensart, denn König August war nicht fein, und die Sachsen sind es von Natur aus nicht, wenn ihnen der Herrscher nicht das Beispiel gibt.“"
                            },
                            {
                                "example_id": "9ff13c7d-9395-41b1-a621-6b5d48b3d711",
                                "sense_id": "84f3d6cc-0658-3586-9a9f-c1f9a609eb6c",
                                "text": "„Die Berner Lebensart verwundert ihn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6494c922-cbb8-3f90-8783-fa69487fd150",
                        "entry_id": "d8591c22-429b-3189-8992-3ff1cabb19f0",
                        "glosses": [
                            "Lebensstil, Lebensgestaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d12003-022b-4187-bf71-bbbe30a5998d",
                                "sense_id": "6494c922-cbb8-3f90-8783-fa69487fd150",
                                "text": "„Sie soll auf einem Internat Lebensart lernen, ist mehrere Jahre fort.“"
                            },
                            {
                                "example_id": "be654f6c-0365-4d4e-9222-514130868509",
                                "sense_id": "6494c922-cbb8-3f90-8783-fa69487fd150",
                                "text": "„Die unkomplizierte Lebensart der Polen steht der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "696da073-0174-4362-a103-a1af1a75990c",
                        "source_entry_id": "d8591c22-429b-3189-8992-3ff1cabb19f0",
