                        "glosses": [
                            "beademingsmachine, apparaat om iemand kunstmatig te laten ademen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eff90bc-4c98-4969-859a-291d99fc227b",
                                "sense_id": "22a8fe10-3c3c-32df-87b8-b62513ce85eb",
                                "text": "Tijdens een operatie en op de intensive care afdeling liggen veel patiënten aan een beademingsapparaat"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b345932b-656e-45d8-9a9d-4fdcc9ef833d",
                        "source_entry_id": "8b5d2b66-46e7-3c9c-bd9c-0a63a534075c",
                        "source_sense_id": "22a8fe10-3c3c-32df-87b8-b62513ce85eb",
                        "target_lang_word": "Beatmungsgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beatmungsgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b5dc5b7-2308-3577-b51b-482a5774cbcf",
                                        "entry_id": "bae392f7-6b18-36e8-8d6c-717bdc3e82db",
                                        "glosses": [
                                            "elektrisches/pneumatisches Hilfsmittel zur Beatmung von Patienten mit Atemstillstand oder unzureichender Atmung"
                                        ],
                                        "tags": [
                                            "Pulmologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837a0d82-b8af-4727-b8b9-71c735e02b4e",
                                                "sense_id": "5b5dc5b7-2308-3577-b51b-482a5774cbcf",
                                                "text": "„[…] Bei einem Patiententransfer mit Beatmungsgerät [muss] gewährleistet sein, dass vorhandene Vorräte in den Sauerstoffflaschen ausreichend sind und so eine ununterbrochene Beatmung ermöglichen.“"
                                            },
                                            {
                                                "example_id": "cb7db99a-7f2f-48be-85ff-c65ad8bb673d",
                                                "sense_id": "5b5dc5b7-2308-3577-b51b-482a5774cbcf",
                                                "text": "„Der Körper wird so weit wie möglich entlastet: Auf der Intensivstation braucht er sich um viele Funktionen nicht mehr selbst zu kümmern. Ein Beatmungsgerät übernimmt das Atmen; Herzfrequenz und Blutdruck werden ständig überwacht. Ernährt wird der Patient über eine Magensonde oder über Infusionen.“"
                                            },
                                            {
                                                "example_id": "13261f4a-4481-4fad-972b-b9e6777d4d77",
                                                "sense_id": "5b5dc5b7-2308-3577-b51b-482a5774cbcf",
                                                "text": "„[Christopher] Reeves erste Autobiografie ‚Immer noch Ich‘ enthüllt, dass ihm der Freitod oft näher stand als das mühsame Überleben am künstlichen Beatmungsgerät.“"
                                            },
                                            {
                                                "example_id": "45a50dd5-6dd5-48d6-a8e1-156303815613",
                                                "sense_id": "5b5dc5b7-2308-3577-b51b-482a5774cbcf",
                                                "text": "„Um das Lungenleiden Covid-19 zu behandeln, werden Betroffene auf Intensivstationen mit Beatmungsgeräten versorgt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
