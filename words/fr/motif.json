                        "motif légitime",
                        "pour quel motif"
                    ]
                },
                {
                    "sense_id": "03446dcd-353d-3a75-bbb7-bad44947cfae",
                    "sense_definition": "Élément graphique ou ornement répété sur une surface ou un tissu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dessin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une nouvelle robe d'été ornée de jolis <w>motifs</w> floraux."
                        },
                        {
                            "text": "Ce rideau blanc présente un <w>motif</w> discret qui s'accorde bien avec la pièce."
                        }
