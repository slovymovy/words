{
    "word_family": [
        "traque",
        "traqueur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd8e2e9a-e69e-3664-958a-f1beb6991391",
                    "sense_definition": "Poursuivre une personne sans relâche afin de la capturer ou de l'acculer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "poursuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs <w>traquent</w> le criminel en fuite à travers tout le pays depuis hier."
                        },
                        {
                            "text": "La brigade spéciale a réussi à <w>traquer</w> le suspect jusqu'à sa cachette secrète."
                        }
                    ],
                    "synonyms": [
                        "chasser",
                        "pourchasser"
                    ],
                    "common_phrases": [
                        "traquer un criminel",
                        "traquer un fugitif"
                    ]
                },
                {
                    "sense_id": "ba9ba90a-2d0e-3355-84fe-9fcfbed7a156",
                    "sense_definition": "Rechercher activement et minutieusement des éléments indésirables pour les éliminer ou les corriger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recherche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le correcteur passe des heures à <w>traquer</w> la moindre faute dans ce long manuscrit."
                        },
                        {
                            "text": "Le directeur financier souhaite <w>traquer</w> les dépenses inutiles pour réduire le budget global."
                        }
                    ],
                    "synonyms": [
                        "chasser",
                        "dénicher"
                    ],
                    "common_phrases": [
                        "traquer les erreurs",
                        "traquer le gaspillage"
                    ]
                },
                {
                    "sense_id": "7418d158-db46-3076-b74e-f95648e0a4ae",
                    "sense_definition": "Cerner le gibier ou battre les bois pour l'acculer et le forcer à sortir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chiens ont permis de <w>traquer</w> le cerf au fond de la forêt humide."
                        },
                        {
                            "text": "Depuis l'aube, les rabatteurs <w>traquent</w> les sangliers qui se cachent dans les buissons."
                        }
                    ],
                    "synonyms": [
                        "rabattre",
                        "chasser"
                    ],
                    "common_phrases": [
                        "traquer le gibier"
                    ]
                }
            ]
        }
    ]
