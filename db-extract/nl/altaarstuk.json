                    {
                        "sense_id": "42515f60-687a-37f7-b079-39f9745f0478",
                        "entry_id": "2f5ee27b-4150-362a-bb3f-8a9bd8d977a2",
                        "glosses": [
                            "een kunstwerk dat op het altaar wordt geplaatst"
                        ],
                        "tags": [
                            "schilderkunst"
                        ],
                        "examples": [
                            {
                                "example_id": "d87cfc1e-6654-4349-bfbe-04cf4f49b272",
                                "sense_id": "42515f60-687a-37f7-b079-39f9745f0478",
                                "text": "Daar hing een altaarstuk, Jezus die naar boven zweeft in een lichtschijnsel dat van beneden naar hem toe straalt."
                            },
                            {
                                "example_id": "0c650ee7-5a38-45e4-b8cd-24e47723f612",
                                "sense_id": "42515f60-687a-37f7-b079-39f9745f0478",
                                "text": "De aanbidding van het Lam Gods is een vijftiende-eeuws altaarstuk van de gebroeders Jan en Hubert van Eyck dat speciaal voor de Sint-Baafskathedraal in Gent werd gemaakt. Het wordt als hun meesterwerk beschouwd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f723fbc9-8aa1-424f-9f34-c979c46076fc",
                        "source_entry_id": "2f5ee27b-4150-362a-bb3f-8a9bd8d977a2",
                        "source_sense_id": "42515f60-687a-37f7-b079-39f9745f0478",
                        "source_sense_description": "een kunstwerk dat op het altaar wordt geplaatst",
                        "target_lang_word": "altarpiece",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altarpiece",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                        "entry_id": "c961baa3-edaa-36a5-bff6-7430b12ff68a",
                                        "glosses": [
                                            "a work of art suspended above and behind an altar in a church"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b50dd0b-3f6c-45c4-b8e1-9e0ba3ff2a14",
                                                "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                                "text": "I walked across the concrete to examine the altarpiece of the atomic age. A large crack ran through it."
                                            },
                                            {
                                                "example_id": "967dd6f1-a635-46eb-aec2-fa7269c605e7",
                                                "sense_id": "e3f7b0e1-619a-3c78-9492-36b79ed4a019",
                                                "text": "“It’s this snaggletoothed, little bird-footed homunculus caricature,” Bourneuf said. “Many artists at this time were trying to make new altarpieces. Klee tended to take a very skeptical distance from the sort of grandiose projects of many of his expressionist peers, so I think it’s actually kind of mocking those hopes.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
