                },
                {
                    "sense_id": "ab2aa575-1c89-3dc0-a173-d859ed493212",
                    "sense_definition": "zich in de geest of gedachten bevindend zonder het naar buiten toe te tonen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoewel hij rustig bleef was hij <w>inwendig</w> aan het koken van woede.",
                            "target_lang_translations": {
                                "en": "Although he remained calm, he was <w>inwardly</w> seething with rage."
                            }
                        },
                        {
                            "text": "Zij voelde een <w>inwendige</w> vreugde die niemand aan haar gezicht kon aflezen.",
                            "target_lang_translations": {
                                "en": "She felt an <w>inner</w> joy that no one could read from her face."
                            }
                        }
                    ],
                    "synonyms": [
                        "innerlijk",
                        "geestelijk"
                    ],
                    "antonyms": [
