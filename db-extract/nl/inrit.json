                                    {
                                        "sense_id": "e2eea770-b4ae-35ad-a3c9-56e0bf025843",
                                        "entry_id": "ef9b6870-efa3-323d-a52a-38b0859ddd09",
                                        "glosses": [
                                            "die Fahrt in etwas hinein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19038c41-25df-42ed-bbf5-831dcd6679a8",
                                                "sense_id": "e2eea770-b4ae-35ad-a3c9-56e0bf025843",
                                                "text": "Die Einfahrt in andere europäische Länder blieb ihnen verwehrt."
                                            },
                                            {
                                                "example_id": "3cf1cd18-c467-481c-b75f-b6b00b491e04",
                                                "sense_id": "e2eea770-b4ae-35ad-a3c9-56e0bf025843",
                                                "text": "„Die Züge wurden vor der Einfahrt ins polnische Staatsgebiet, das sich von der Hafenstadt Danzig wie ein Trichter in den Süden zog, verplombt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b10ee16-a3ca-336c-af6a-16be4a2c32fb",
                                        "entry_id": "ef9b6870-efa3-323d-a52a-38b0859ddd09",
                                        "glosses": [
                                            "eine für [1] vorgesehene Öffnung oder Straße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e60ce14-3fb6-4d1e-bfee-e21a5a739bad",
                                                "sense_id": "8b10ee16-a3ca-336c-af6a-16be4a2c32fb",
                                                "text": "Er parkte mitten in der Einfahrt."
                                            },
                                            {
                                                "example_id": "f9d84793-82e5-48b7-acd8-8b7d7c6d6c91",
                                                "sense_id": "8b10ee16-a3ca-336c-af6a-16be4a2c32fb",
                                                "text": "„An der Einfahrt zum Friedhof hatten sich schwarz verhüllte Frauen versammelt.“"
                                            },
                                            {
                                                "example_id": "d59d618a-49b1-4c98-b3e8-e00230f14115",
                                                "sense_id": "8b10ee16-a3ca-336c-af6a-16be4a2c32fb",
                                                "text": "„Sie kurvte die Auffahrt hoch, kurz hinter der Einfahrt zur sechsten Etage hielt sie.“"
                                            },
                                            {
                                                "example_id": "96700adf-2341-4414-a4d0-91052cd82fe5",
                                                "sense_id": "8b10ee16-a3ca-336c-af6a-16be4a2c32fb",
                                                "text": "„Sie parkte in der Einfahrt und ging schnell hinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
