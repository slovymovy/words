                    "sense_id": "ade14553-9d18-30f4-a0cd-48060a10f1dd",
                    "sense_definition": "heel erg eng of beangstigend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sterke_negatieve_beoordeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat smalle bruggetje boven het water is echt <w>doodeng</w> in het donker.",
                            "target_lang_translations": {
                                "en": "That narrow little bridge over the water is really <w>terrifying</w> in the dark."
                            }
                        },
                        {
                            "text": "Veel kinderen vonden het <w>doodeng</w> om alleen naar die oude kelder te gaan.",
                            "target_lang_translations": {
                                "en": "Many children found it <w>really scary</w> to go to that old cellar alone."
                            }
                        }
                    ],
                    "synonyms": [
