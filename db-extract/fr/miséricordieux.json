                        "form_id": "e5870b86-88ad-449e-9354-899c5f9beeb5",
                        "entry_id": "01be458d-385b-3ac9-a399-dcaeea238f26",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "miséricordieuses"
