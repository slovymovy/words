                                "target_senses": [
                                    {
                                        "sense_id": "6d016f57-f8b9-3df7-a559-d33191b8308a",
                                        "entry_id": "335cfbea-d8a6-3ac2-b3f8-8af3c433410c",
                                        "glosses": [
                                            "濁酒，未經過濾程序的米酒，與清酒相對。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6f26c1-3f3b-45dd-9aa3-29f44c18dc86",
                                                "sense_id": "6d016f57-f8b9-3df7-a559-d33191b8308a",
                                                "text": "《太平御覽》卷八四四引三國魏魚豢《魏略》：“太祖時禁酒，而人竊飲之。故難言酒，以白酒為賢人，清酒為聖人。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13bf938b-853d-3b3f-87e6-ebfd9c4f0d03",
                                        "entry_id": "335cfbea-d8a6-3ac2-b3f8-8af3c433410c",
                                        "glosses": [
                                            "泛稱美酒。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78110f94-4795-4f6c-8480-dc1bcb7b692b",
                                                "sense_id": "13bf938b-853d-3b3f-87e6-ebfd9c4f0d03",
                                                "text": "南朝·梁武帝《子夜四時歌‧夏歌》：“玉盤著朱李，金杯盛白酒。”"
                                            },
                                            {
                                                "example_id": "b4995ade-01f1-48bd-9acc-cb9d7b0096e0",
                                                "sense_id": "13bf938b-853d-3b3f-87e6-ebfd9c4f0d03",
                                                "text": "唐·李白《南陵別兒童入京》詩：“白酒初熟山中歸，黃雞啄黍秋正肥。”"
                                            },
                                            {
                                                "example_id": "639d3c69-45a9-4497-96e9-b22413b84ef2",
                                                "sense_id": "13bf938b-853d-3b3f-87e6-ebfd9c4f0d03",
                                                "text": "宋·蘇軾《廣陵會三同舍》詩之一：“廣陵三日飲，相對怳如夢；況逢賢主人，白酒撥春甕。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "561e44b4-4f25-3975-ade9-4e805a249d30",
                                        "entry_id": "335cfbea-d8a6-3ac2-b3f8-8af3c433410c",
                                        "glosses": [
                                            "特指燒酒。又稱白干。即用高粱、玉米、甘薯等粮食或某些果品发酵、蒸馏制成的酒，没有颜色，含酒精量较高。"
                                        ],
