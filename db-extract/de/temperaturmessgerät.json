                "senses": [
                    {
                        "sense_id": "453727bc-4929-3e05-9976-184930689224",
                        "entry_id": "e5c1c555-665d-332e-8f64-93552cef4435",
                        "glosses": [
                            "Gerät zur Bestimmung der Temperatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e513297-2c55-45a7-8db4-7a622fc5678a",
                                "sense_id": "453727bc-4929-3e05-9976-184930689224",
                                "text": "[COVID-19-Pandemie:] „Auf halber Strecke wartet ein Grenzbeamter in grauem Anzug, Atemmaske und ausgestattet mit einem Temperaturmessgerät, das er den Einreisenden wie eine Pistole an die Stirn hält.“"
                            },
                            {
                                "example_id": "ec7da4a8-b33b-4a07-a7ad-d32a0e9abfc8",
                                "sense_id": "453727bc-4929-3e05-9976-184930689224",
                                "text": "„Die Basis-Ausrüstung besteht aus einem Fotoapparat, einer Videokamera und einem Temperaturmessgerät.“"
                            },
                            {
                                "example_id": "6dd10c4b-dde6-4d17-aaf3-183a039c775d",
                                "sense_id": "453727bc-4929-3e05-9976-184930689224",
                                "text": "„In Alzenau werden überwiegend Temperaturmessgeräte für die Industrie hergestellt.“"
                            },
                            {
                                "example_id": "1eb7bdd7-69cf-44a2-8721-af44ae2a5912",
                                "sense_id": "453727bc-4929-3e05-9976-184930689224",
                                "text": "„Zwar seien bei der Firma keine Salmonellen gefunden worden, doch ein Temperaturmessgerät sei defekt, so dass die Speisen möglicherweise nicht auf die nötigen 70 Grad erhitzt worden seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
