                "senses": [
                    {
                        "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                        "entry_id": "a3e86fc2-193b-36ec-a4d9-280e23cfb6e3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8e59fb-2dff-4438-8f3f-77a29268ff3e",
                                "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                                "text": "Frau Gäble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fe8a67bb-5c88-4d84-ad89-69175705efd9",
                                "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                                "text": "Herr Gäble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c90fa8dc-c057-4799-8fc3-13646483b1f7",
                                "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                                "text": "Die Gäbles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "03978831-9ab6-4de5-902a-907d13cc99a3",
                                "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                                "text": "Der Gäble trägt nie die Schals, die die Gäble ihm strickt."
                            },
                            {
                                "example_id": "9c663ace-1fd4-4080-8911-e5dd20e0f562",
                                "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gäble kommt, geht der Herr Gäble.“"
                            },
                            {
                                "example_id": "364d93c5-2069-4fbf-bdad-7b43a8a01e77",
                                "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                                "text": "Gäble kommt und geht."
                            },
                            {
                                "example_id": "aaba79cb-6af5-4d44-ac65-88fab02700aa",
                                "sense_id": "8d894a85-0acf-309a-a3ab-0f42633c32a0",
                                "text": "Gäbles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
