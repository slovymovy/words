{
    "word_family": [
        "writhing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d888b6a-bd26-3696-826c-0ad51483e2d4",
                    "sense_definition": "To twist or wring something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "twist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>writhe</w> the wet cloth to remove the excess water.",
                            "target_lang_translations": {
                                "es": "Empezó a <w>retorcer</w> el paño húmedo para quitar el exceso de agua."
                            }
                        },
                        {
                            "text": "The sculptor would <w>writhe</w> the metal wire into complex shapes.",
                            "target_lang_translations": {
                                "es": "El escultor <w>retorcía</w> el alambre de metal para darle formas complejas."
                            }
                        }
                    ],
                    "synonyms": [
                        "twist",
                        "wring"
                    ],
                    "common_phrases": [
                        "writhe the cloth"
                    ],
                    "target_lang_definitions": {
                        "es": "Torcer o retorcer algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "retorcer",
                                "target_lang_sense_clarification": "Aplicado a objetos como telas o alambres para darles forma o extraer líquido."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e428a2ea-c4c1-3588-bd86-f0c91c034c5d",
                    "sense_definition": "To contort a part of the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "twist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would <w>writhe</w> her hands in frustration during the long wait.",
                            "target_lang_translations": {
                                "es": "Ella <w>contorsionaba</w> sus manos por la frustración durante la larga espera."
                            }
                        },
                        {
                            "text": "The actor had to <w>writhe</w> his face to show extreme pain.",
                            "target_lang_translations": {
                                "es": "El actor tuvo que <w>contorsionar</w> su rostro para mostrar un dolor extremo."
                            }
                        }
                    ],
                    "synonyms": [
                        "contort"
                    ],
                    "common_phrases": [
                        "writhe one's hands"
                    ],
                    "target_lang_definitions": {
                        "es": "Contorsionar una parte del cuerpo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "contorsionar",
                                "target_lang_sense_clarification": "Mover o doblar el cuerpo o sus partes en posiciones forzadas."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeffe26f-e8c4-37a2-8ccb-d683f93a9b98",
                    "sense_definition": "To twist the body, often due to pain or discomfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "twist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured player continued to <w>writhe</w> in agony on the grass.",
                            "target_lang_translations": {
                                "es": "El jugador lesionado continuaba <w>retorciéndose</w> de agonía en el césped."
                            }
                        },
                        {
                            "text": "The snake began to <w>writhe</w> across the hot desert sand.",
                            "target_lang_translations": {
                                "es": "La serpiente comenzó a <w>retorcerse</w> sobre la arena caliente del desierto."
                            }
                        }
                    ],
                    "synonyms": [
                        "squirm",
                        "thrash"
                    ],
                    "common_phrases": [
                        "writhe in agony"
                    ],
                    "target_lang_definitions": {
                        "es": "Torcerse el cuerpo, a menudo debido a dolor o incomodidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "retorcerse",
                                "target_lang_sense_clarification": "Movimiento involuntario del cuerpo causado por dolor intenso."
                            },
                            {
                                "target_lang_word": "contorsionarse",
                                "target_lang_sense_clarification": "Movimiento del cuerpo en posiciones inusuales o forzadas."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "500bd531-5da7-3e29-bde7-72d2614c4480",
                    "sense_definition": "To obtain something by force or pressure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt official tried to <w>writhe</w> a confession from the prisoner.",
                            "target_lang_translations": {
                                "es": "El funcionario corrupto intentó <w>arrancar</w> una confesión al prisionero."
                            }
                        },
                        {
                            "text": "They managed to <w>writhe</w> the truth from him after hours of questioning.",
                            "target_lang_translations": {
                                "es": "Lograron <w>arrancarle</w> la verdad después de horas de interrogatorio."
                            }
                        }
                    ],
                    "synonyms": [
                        "extort",
                        "wrest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is rare and largely historical."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Obtener algo mediante fuerza o presión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "arrancar",
                                "target_lang_sense_clarification": "Obtener algo de alguien mediante presión o insistencia."
                            },
                            {
                                "target_lang_word": "extorsionar",
                                "target_lang_sense_clarification": "Obtener algo mediante coacción."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dce739cf-79e4-3db6-ae01-344c7e27d4e9",
                    "sense_definition": "A twisting or contorted movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "twist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a sudden <w>writhe</w>, the animal escaped the trap.",
                            "target_lang_translations": {
                                "es": "Con una <w>contorsión</w> repentina, el animal escapó de la trampa."
                            }
                        },
                        {
                            "text": "The dancer performed a series of graceful <w>writhes</w> across the stage.",
                            "target_lang_translations": {
                                "es": "El bailarín realizó una serie de elegantes <w>contorsiones</w> por el escenario."
                            }
                        }
                    ],
                    "synonyms": [
                        "contortion",
                        "twist"
                    ],
                    "target_lang_definitions": {
                        "es": "Un movimiento de torsión o contorsión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "contorsión",
                                "target_lang_sense_clarification": "Movimiento o postura forzada del cuerpo."
                            },
                            {
                                "target_lang_word": "retorcimiento",
                                "target_lang_sense_clarification": "Acción de torcer o retorcer."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe39e30b-8a01-390d-bb3a-f14b706ee69a",
                    "sense_definition": "A mathematical measure of the crossings in a knot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>writhe</w> of the knot is calculated using the orientation of its crossings.",
                            "target_lang_translations": {
                                "es": "El <w>retorcimiento</w> del nudo se calcula usando la orientación de sus cruces."
                            }
                        },
                        {
                            "text": "Topologists use the <w>writhe</w> to classify different types of knots.",
                            "target_lang_translations": {
                                "es": "Los topólogos usan el <w>retorcimiento</w> para clasificar diferentes tipos de nudos."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Medida matemática de los cruces en un nudo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "retorcimiento",
                                "target_lang_sense_clarification": "Término técnico en topología para describir la torsión de una curva."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}