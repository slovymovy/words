                    {
                        "form_id": "bb1d0ed7-ae0c-4c55-a44b-529bcfa4c113",
                        "entry_id": "b6be8ef9-9ed6-355c-98f3-4cb8e1c6e306",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Hybris"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c9fcab4-b711-3de3-85f8-6e14bf3db62f",
                        "entry_id": "b6be8ef9-9ed6-355c-98f3-4cb8e1c6e306",
                        "glosses": [
                            "realitätsfernes, maßloses und unangemessenes Vertrauen in die Handlungen der eigenen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebe762c-0eb2-4f5c-b2a2-263310302e26",
                                "sense_id": "5c9fcab4-b711-3de3-85f8-6e14bf3db62f",
                                "text": "„Was Holzinger vortrug, drückte eher Hybris gegenüber der Vergangenheit aus; die Hybris selbstgerechter Menschen, die im nachhinein genau wissen, wie moralisch integer sie sich verhalten hätten, wären sie an der Stelle der Unwürdigen gewesen.“"
                            },
                            {
                                "example_id": "27724502-d0a0-4371-8323-76710eae44ee",
                                "sense_id": "5c9fcab4-b711-3de3-85f8-6e14bf3db62f",
                                "text": "„Auch die Hybris ist mit dem Raum der Höhe verbunden.“"
                            },
                            {
                                "example_id": "5b2e40af-845c-48db-9ce0-23d4facfa4ac",
                                "sense_id": "5c9fcab4-b711-3de3-85f8-6e14bf3db62f",
                                "text": "„Solche Hybris war im imperialistischen 19. Jahrhundert der Normalfall.“"
                            },
                            {
                                "example_id": "914a31b4-4f4d-47ad-8b78-88ea45cb8576",
                                "sense_id": "5c9fcab4-b711-3de3-85f8-6e14bf3db62f",
                                "text": "„Abenteurer wie Carl Peters stellten den Eisernen Kanzler vor vollendete Tatsachen und ließen ihm kaum eine andere Wahl, als sich auf koloniale Hybris einzulassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da539355-6dcf-4e5a-acce-ca98c4b04bea",
                        "source_entry_id": "b6be8ef9-9ed6-355c-98f3-4cb8e1c6e306",
                        "source_sense_id": "5c9fcab4-b711-3de3-85f8-6e14bf3db62f",
                        "source_sense_description": "realitätsfernes, maßloses und unangemessenes Vertrauen in die Handlungen der eigenen Person",
                        "target_lang_word": "hubris",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hubris",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d10cdc0-b88e-30a5-b678-58c2f8ddf2e9",
                                        "entry_id": "6fa0eab0-c843-3821-974c-67f1d05b792a",
                                        "glosses": [
                                            "Excessive pride, presumption, or arrogance (originally toward the gods)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe698461-d608-41e0-81c6-f48268e59900",
                                                "sense_id": "2d10cdc0-b88e-30a5-b678-58c2f8ddf2e9",
                                                "text": "Antitrust prosecutors target big companies that exude hubris."
                                            },
                                            {
                                                "example_id": "f2429aa1-269a-4809-b363-256c1e9c84cb",
                                                "sense_id": "2d10cdc0-b88e-30a5-b678-58c2f8ddf2e9",
                                                "text": "One would have thought that even Trump, despite all his hubris and egotism, would know better than to jump feet first into America’s most sensitive issue: racial division."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6f2bf6e-f370-4a56-8b4e-6254d1f09ae4",
                        "source_entry_id": "b6be8ef9-9ed6-355c-98f3-4cb8e1c6e306",
                        "source_sense_id": "5c9fcab4-b711-3de3-85f8-6e14bf3db62f",
                        "source_sense_description": "realitätsfernes, maßloses und unangemessenes Vertrauen in die Handlungen der eigenen Person",
                        "target_lang_word": "hybris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hybris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f64a1587-d16f-3279-9743-20f6157d96cf",
                                        "entry_id": "ba4fd971-b785-318e-b8ee-e5a4b77bea51",
                                        "glosses": [
                                            "Sentiment violent inspiré par la passion et par l’orgueil ; excès coupable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af694cd-a021-4638-81f0-8602f178f571",
                                                "sense_id": "f64a1587-d16f-3279-9743-20f6157d96cf",
                                                "text": "Certaines notions qui lui sont très familières aux siècles classiques — comme celles de l’hybris et de la némésis — se retrouvent chez des populations aussi peu évoluées que les tribus Moïs du sud de l'Indochine."
                                            },
                                            {
                                                "example_id": "624c3720-41dd-4a1e-9b21-8e924921e00b",
                                                "sense_id": "f64a1587-d16f-3279-9743-20f6157d96cf",
                                                "text": "« Vous comprenez, disait Baillargeau, dans la vigne ce ne sont pas des espèces que nous croisons, ce sont des races, des variétés. On devrait dire des métis et non pas des hybrides, mais la coutume est de parler d'hybrides, et puis cela fait plus noble. … — Vous soutenez que le terme d'hybride est plus noble que celui de métis. D'abord il est impropre et vous en convenez puisqu'il désigne le croisement de deux espèces différentes; ensuite il est grossier, barbare et, de plus, outrageant puisqu'il est tiré du mot grec hybris qui a le sens de viol, alors que métis vient du latin mixtus au sens exquis de ce qui est mêlé, tendrement mêlé, amoureusement mêlé. »"
                                            },
                                            {
                                                "example_id": "aeac764b-08ac-4755-a13a-5eb654499fbc",
                                                "sense_id": "f64a1587-d16f-3279-9743-20f6157d96cf",
                                                "text": "On parle toujours du « fatum », du destin, qui écrase le héros tragique. Or, il s’agit là d’un mot latin ! Dans la tragédie grecque, la fatalité porte le même nom que l’erreur, « l’atè ». C’est « l’hybris » (l’arrogance funeste), détestée des Grecs foncièrement égalitaires, qui, par le sentiment de supériorité qu’elle inspire, mène à l’erreur, à la faute, à « l’atè. »"
                                            },
                                            {
                                                "example_id": "4e1edbb5-9d43-4a96-a111-7f40bd82a04a",
                                                "sense_id": "f64a1587-d16f-3279-9743-20f6157d96cf",
                                                "text": "Hybris, l'esprit d'un « orgueil titanique et divin », avait déjà causé la perte de l'Atlantide-Europe. « Au jour de ta chute, toute la foule au milieu de toi sombrera au coeur des mers... Parce que tu as dit \"Je suis Dieu\"! » (Ez. XXVII, 27; XXVIII, 2)"
                                            },
                                            {
                                                "example_id": "006722d6-0c26-4402-947c-4aa6ed1a3e96",
                                                "sense_id": "f64a1587-d16f-3279-9743-20f6157d96cf",
                                                "text": "Shakespeare invente [dans La tempête] une histoire qui nous renvoie à la philosophie grecque, notamment l’idée d’ordre cosmique mis en péril par un péché capital, très humain : l’hybris, c’est-à-dire l’orgueil de ceux qui ne veulent pas rester à leur place – Antonio, qui usurpe le trône, Stefano et Trinculo qui veulent devenir rois, Caliban qui désire Miranda."
                                            }
                                        ]
                                    }
                                ]
                            },
