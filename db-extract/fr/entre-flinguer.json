                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77d5124-ad48-4168-be81-1a601b103dcb",
                                "sense_id": "0ffd66ae-7e25-35b6-8287-3d32cc1499d6",
                                "text": "Supérieurement entraînés et dotés d’un sens du terrain qui semblait décupler leur nombre, ils achevèrent de déblayer la situation, mettant finalement en fuite une vingtaine d’hommes désorganisés, découragés par les activités de cet ennemi omniprésent, dont les déplacements rapides les poussaient à s’entre-flinguer par erreur."
                            },
                            {
                                "example_id": "81a7430b-f83f-45dd-91c4-b654d563d841",
                                "sense_id": "0ffd66ae-7e25-35b6-8287-3d32cc1499d6",
                                "text": "S'entre-flinguer toutes les 25 secondes au moindre prétexte, c'est rigolo quelques minutes, pas plus..."
                            },
                            {
                                "example_id": "dc4d16d2-4e05-49cb-863d-7467496da6d6",
                                "sense_id": "0ffd66ae-7e25-35b6-8287-3d32cc1499d6",
                                "text": "On y voit des évêques décider d'une série d'assassinats en jouant au billard comme des parrains de la mafia avant de s'entre-flinguer à coups de pistolet."
                            }
                        ]
