{
    "word_family": [
        "medley"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcdb60e6-918c-300b-b4b9-774c3cf31155",
                    "sense_definition": "A collection or mixture of miscellaneous things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a fresh fruit <w>medley</w> for the dessert course.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил на десерт <w>ассорти</w> из свежих фруктов."
                            }
                        },
                        {
                            "text": "The room was filled with a strange <w>medley</w> of old furniture and modern art.",
                            "target_lang_translations": {
                                "ru": "Комната была наполнена странной <w>смесью</w> старой мебели и современного искусства."
                            }
                        }
                    ],
                    "synonyms": [
                        "mashup"
                    ],
                    "common_phrases": [
                        "fruit medley"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание, сочетание или смесь разнообразных предметов или элементов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "разнородных вещей, компонентов или ингредиентов"
                            },
                            {
                                "target_lang_word": "мешанина",
                                "target_lang_sense_clarification": "разговорное о беспорядочном смешении разнородных вещей"
                            },
                            {
                                "target_lang_word": "смешение",
                                "target_lang_sense_clarification": "сочетание разнородных элементов"
                            },
                            {
                                "target_lang_word": "ассорти",
                                "target_lang_sense_clarification": "набор различных видов одного продукта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "200c5543-7b08-3b46-b9f3-6084e946aeff",
                    "sense_definition": "A collection of related songs played or mixed together as a single piece.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band performed a <w>medley</w> of their greatest hits during the concert.",
                            "target_lang_translations": {
                                "ru": "Во время концерта группа исполнила <w>попурри</w> из своих величайших хитов."
                            }
                        },
                        {
                            "text": "She sang a beautiful <w>medley</w> of jazz standards at the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Она спела прекрасное <w>попурри</w> из джазовых стандартов на свадебном приёме."
                            }
