                ],
                "senses": [
                    {
                        "sense_id": "ccf9e8f3-8957-3283-8e48-dce481911b2f",
                        "entry_id": "db20ccf9-cf67-3e3b-a147-e7118b517abe",
                        "glosses": [
                            "Donner un caractère séraphique ; angéliser."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1e83b370-841a-45bb-98f8-3e48e3af65fe",
                                "sense_id": "ccf9e8f3-8957-3283-8e48-dce481911b2f",
                                "text": "Je viens de parcourir à nouveau toute cette plaine familière : clair de lune merveilleux, légère brume qui flotte sur les prés et qui séraphise toute chose."
                            },
                            {
                                "example_id": "46a4c22b-f148-44f9-86a2-11e5c865ee41",
                                "sense_id": "ccf9e8f3-8957-3283-8e48-dce481911b2f",
                                "text": "Près d’elle, sur les bords du lac du Bourget, il séraphisait avec délices"
                            }
                        ]
                    },
                    {
                        "sense_id": "dd26fa6b-a51e-3bd9-bc91-591bb40216b8",
                        "entry_id": "db20ccf9-cf67-3e3b-a147-e7118b517abe",
                        "glosses": [
                            "Prendre un caractère séraphique ; devenir angélique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "d9cb0bd6-5b5d-465d-a6ec-41a769f860cf",
                                "sense_id": "dd26fa6b-a51e-3bd9-bc91-591bb40216b8",
                                "text": "Chez lui les dos terrassés se redressent, les yeux baissés se relèvent, les voix sépulcrales se séraphisent."
                            }
                        ]
                    }
                ],
