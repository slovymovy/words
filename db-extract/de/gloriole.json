                "senses": [
                    {
                        "sense_id": "d657f477-a44f-3f7d-beee-a1446527abe7",
                        "entry_id": "90f9fdee-8da2-3133-84c5-a26db5a70aa8",
                        "glosses": [
                            "Strahlenkranz um den Kopf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6191a2a6-ae45-4fb2-b63b-583f07e72b48",
                                "sense_id": "d657f477-a44f-3f7d-beee-a1446527abe7",
                                "text": "„Aber um jeden Kopf legte die Sonne eine kleine Gloriole.“"
                            },
                            {
                                "example_id": "f6a40d0c-6389-40fa-be67-6de0d7d9b6df",
                                "sense_id": "d657f477-a44f-3f7d-beee-a1446527abe7",
                                "text": "„Mit jedem Schritt den Strand hinauf wuchs sie höher in den starken Schein, bis die Sonne des späten Nachmittags hinter ihrem Kopfe stand wie eine Gloriole.“"
                            },
                            {
                                "example_id": "d8a234a8-0a4e-4ec1-810c-7ea803670f7b",
                                "sense_id": "d657f477-a44f-3f7d-beee-a1446527abe7",
                                "text": "„Auch bei seinem vorreformatorischen Gruppenbild der vierzehn Nothelfer fehlen die Gloriolen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
