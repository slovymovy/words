                        "glosses": [
                            "Celui qui donne son opinion avant une autre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "75ef1eda-22d0-40ea-af3b-cf53b9ce30ee",
                                "sense_id": "b927183c-1f08-3a2f-9111-a9c4fbe1ea72",
                                "text": "[…] : j’observerai seulement que la méthode proposée par le préopinant de faire juger séparément les mêmes juges sur le fait et sur le droit, présenterait plus d’inconvénient que l’ancienne forme d’opiner."
                            },
                            {
                                "example_id": "636dd59d-5590-4d02-ac74-489d199fc98e",
                                "sense_id": "b927183c-1f08-3a2f-9111-a9c4fbe1ea72",
                                "text": "Et moi de même, dit la cousine Grillet, docteur idémiste qui était volontiers de l'avis du préopinant."
                            },
                            {
                                "example_id": "6b087a47-c55c-4afc-ba39-6eb2743ba0f0",
                                "sense_id": "b927183c-1f08-3a2f-9111-a9c4fbe1ea72",
                                "text": "Le préopinant décide ce qui, selon mes faibles lumières, me paraît devoir être l’objet de la discussion."
                            }
                        ]
                    }
