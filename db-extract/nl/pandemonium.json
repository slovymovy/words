                ],
                "senses": [
                    {
                        "sense_id": "731bbad9-a680-3ee1-8d1f-124af7eff81e",
                        "entry_id": "7c07bae9-1bb2-3dca-a5de-01be5bc841b0",
                        "glosses": [
                            "een chaotische toestand met een hels lawaai en drukte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b64432-56f0-40f1-9669-183b5aefc220",
                                "sense_id": "731bbad9-a680-3ee1-8d1f-124af7eff81e",
                                "text": "Kramer maakte van de slotbeweging een groots en grotesk pandemonium, waarin weliswaar niet elk loopje of akkoord loepzuiver klonk. Maar naast zoveel muzikanteske brille is het haast strafbaar om daarover te kniezen."
                            },
                            {
                                "example_id": "37ba147c-bfb3-479e-b1db-6a0237a01f46",
                                "sense_id": "731bbad9-a680-3ee1-8d1f-124af7eff81e",
                                "text": "Wat hebben Angela Merkel, Piet de Jong en Koos van Dam met elkaar gemeen? Zowel de bondskanselier, de overleden oud-premier, als de vertrekkende Syrië-gezant laten (lieten) zich leiden door innerlijke kalmte en bezinning. Zij zijn een oase van rust in de huidige hysterie, in het pandemonium dat dagelijks in de media aan ons voorbijtrekt en maar geen halt weet te houden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ded9c3bb-60a5-492b-9c27-491855e6aef0",
                        "source_entry_id": "7c07bae9-1bb2-3dca-a5de-01be5bc841b0",
                        "source_sense_id": "731bbad9-a680-3ee1-8d1f-124af7eff81e",
                        "source_sense_description": "een chaotische toestand met een hels lawaai en drukte",
                        "target_lang_word": "uproar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
