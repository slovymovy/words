                    {
                        "translation_id": "c22c26ae-34d8-48a5-9496-5846c1990a00",
                        "source_entry_id": "16d79426-f098-32e3-b09b-d6674d9cd113",
                        "source_sense_id": "bb4f7149-4137-328d-981e-2150991beb1d",
