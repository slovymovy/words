                "translations": [
                    {
                        "translation_id": "07c64d9a-5aac-45fa-91ef-fe3e5e1a41a9",
                        "source_entry_id": "624d1337-5d72-3bf1-ae8d-48cd8ac933bf",
                        "source_sense_id": "b5b1b903-952e-38c3-824a-c83db654faee",
