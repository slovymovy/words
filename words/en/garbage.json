                {
                    "sense_id": "d6fe96da-1b43-3b28-8eda-c5c12f9be681",
                    "sense_definition": "Something that is of very poor quality, worthless, or untrue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worthless_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to him, he is just talking <w>garbage</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его, он несет полную <w>чушь</w>.",
                                "tr": "Onu dinleme, sadece <w>saçmalıyor</w>.",
                                "zh": "别听他的，他只是在说<w>废话</w>。"
                            }
                        },
                        {
                            "text": "That movie was absolute <w>garbage</w> and a waste of time.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был полным <w>мусором</w> и пустой тратой времени.",
                                "tr": "O film tam anlamıyla bir <w>çöptü</w> ve zaman kaybıydı.",
                                "zh": "那部电影简直是<w>垃圾</w>，纯属浪费时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "trash",
                        "junk"
                    ],
                    "antonyms": [
                        "treasure",
                        "prize",
                        "asset"
                    ],
                    "common_phrases": [
                        "talk garbage",
                        "absolute garbage",
                        "piece of garbage"
                    ],
                    "traits": [
