                        "form": "русака́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3dc34ac-b148-39a1-b150-545a7cecff78",
                        "entry_id": "d597caa8-32ac-324b-887a-fc8e283a3c36",
                        "glosses": [
                            "зоол., разг. то же, что заяц-русак, серый (русый) заяц вида Lepus europaeus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f1aa6b8-a3cc-4e3b-95cf-8acc4f9769e4",
                                "sense_id": "a3dc34ac-b148-39a1-b150-545a7cecff78",
                                "text": "Русак лежит в степи и на пашне, беляк в лесу и в опушке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a2719a0-1a0c-4af3-b86c-bae228f00ca0",
                        "source_entry_id": "d597caa8-32ac-324b-887a-fc8e283a3c36",
                        "source_sense_id": "a3dc34ac-b148-39a1-b150-545a7cecff78",
                        "target_lang_word": "hare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7575cbee-b2e2-300e-9af6-3cda4e08f366",
                                        "entry_id": "5f3a9e90-be7a-3585-98fb-4dd17ef714be",
                                        "glosses": [
                                            "Any of several plant-eating mammals of the genus Lepus, similar to a rabbit, but larger and with longer ears."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d5250d-62b8-4a43-b380-4d5e345a5ae2",
                                                "sense_id": "7575cbee-b2e2-300e-9af6-3cda4e08f366",
                                                "text": "The hare has a reputation for exciting desire. Hare soup is credited with a particular aphrodisiac value."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be15d271-023d-3ce0-9d5c-c4d2e6e692a8",
                                        "entry_id": "5f3a9e90-be7a-3585-98fb-4dd17ef714be",
                                        "glosses": [
                                            "The meat from this animal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fbf93b-d79a-437d-80a7-73b3f1bbbb88",
                                                "sense_id": "be15d271-023d-3ce0-9d5c-c4d2e6e692a8",
                                                "text": "Ashe bit absent-mindedly into a piece of hare and swore mildly when he burned his tongue."
                                            },
                                            {
                                                "example_id": "1fb27304-2db3-4345-8d59-4345a5c15300",
                                                "sense_id": "be15d271-023d-3ce0-9d5c-c4d2e6e692a8",
                                                "text": "Hare is another delicious meat – it’s more ‘steaky’, darker and richer than rabbit."
                                            },
                                            {
                                                "example_id": "f4b87de3-293c-4313-91b4-e0cbe952d58c",
                                                "sense_id": "be15d271-023d-3ce0-9d5c-c4d2e6e692a8",
                                                "text": "In Milan, jugged hare is flavoured with grated chocolate, which adds colour and depth to the sauce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a9590a3-11dd-37dd-bdaf-4bd014f058c0",
                                        "entry_id": "5f3a9e90-be7a-3585-98fb-4dd17ef714be",
                                        "glosses": [
                                            "The player in a paperchase, or hare and hounds game, who leaves a trail of paper to be followed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76400a8a-a079-33cb-8040-076f4f217473",
                                        "entry_id": "ca88d6bf-6123-358c-b0e2-34792236ce20",
                                        "glosses": [
                                            "To move swiftly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d6538fc-7ce1-40d4-87e3-5d34939b9903",
                                                "sense_id": "76400a8a-a079-33cb-8040-076f4f217473",
                                                "text": "But Wales somehow snaffled possession for fly-half Jones to send half-back partner Mike Phillips haring away with Stoddart in support."
                                            },
                                            {
                                                "example_id": "4ae01aaf-f89a-4d7b-b377-ee5eda83a32a",
                                                "sense_id": "76400a8a-a079-33cb-8040-076f4f217473",
                                                "text": "Desperate, Kim hurls his phone overarm at the creature's forehead. It's a solid chunk of metal and it's a dead hit. Grey reels backwards and cracks his skull against the wall. By the time he recovers, Kim is out of sight, haring away down the left corridor, just echoing, fading footsteps on concrete."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "071819b3-4310-30f4-bae5-b5c34aba7ba4",
                                        "entry_id": "170f3e36-5476-3226-b20b-d9699520847b",
                                        "glosses": [
                                            "To excite; to tease, or worry; to harry."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a07e82-e2eb-4eff-9c23-2713cebca6d9",
                                                "sense_id": "071819b3-4310-30f4-bae5-b5c34aba7ba4",
                                                "text": "To hare and rate them thus at every turn, is not to teach them, but to vex, and torment them to no purpoſe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dafb3954-6450-3e5c-9efe-792bcd1aed0a",
                                        "entry_id": "e53ef3c1-4d1c-3ab8-8720-f3f93256a757",
                                        "glosses": [
                                            "Grey, hoary; grey-haired, venerable (of people)."
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dfea165-57b7-4db4-8dcb-60c8c09d8d53",
                                                "sense_id": "dafb3954-6450-3e5c-9efe-792bcd1aed0a",
                                                "text": "a hare old man"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc288db-a40b-3f22-9f56-c3ef766c7caf",
                                        "entry_id": "e53ef3c1-4d1c-3ab8-8720-f3f93256a757",
                                        "glosses": [
                                            "Cold, frosty (of weather)."
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4300a6e-8c54-4d36-96ca-66676a6c211f",
                                                "sense_id": "cbc288db-a40b-3f22-9f56-c3ef766c7caf",
                                                "text": "a hare day"
                                            }
