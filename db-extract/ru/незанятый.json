                            },
                            {
                                "target_word": "disengaged",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99b4b77d-edc9-31c5-9cb1-362eafc1513c",
                                        "entry_id": "4f49977e-fed8-3a96-9330-0c6d64e89161",
                                        "glosses": [
                                            "Not engaged; at leisure; free from occupation or attachment; unconnected; detached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38cce69b-cfe7-4574-9a16-49716ca6ea55",
                                                "sense_id": "99b4b77d-edc9-31c5-9cb1-362eafc1513c",
                                                "text": "“Calm yourself, dear Arthur,” she said, in her low rich voice, and sniffled sweetly and gravely upon him. Then, with her disengaged hand, she put the hair lightly off his throbbing forehead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5cf85e-b897-3aa0-a321-d41d2bd6c2e0",
                                        "entry_id": "4f49977e-fed8-3a96-9330-0c6d64e89161",
                                        "glosses": [
                                            "Not (socially) engaged; available, free."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5dcfdc-c208-44d9-94e1-8ed5a133e131",
                                                "sense_id": "7e5cf85e-b897-3aa0-a321-d41d2bd6c2e0",
                                                "text": "These perused, the Major took out his pocket-book to see on what days he was disengaged, and which of these many hospitable calls he could afford to accept or decline."
                                            },
                                            {
                                                "example_id": "f29422cb-1af9-4385-be94-7122542d2985",
                                                "sense_id": "7e5cf85e-b897-3aa0-a321-d41d2bd6c2e0",
                                                "text": "‘You must come and dine with us some night. Tuesday? Are you disengaged Tuesday?’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21d2d6cf-e71f-4656-a93a-d2aae06f64bb",
                        "source_entry_id": "9a2e1db9-6879-30a3-b025-23d582e5d74b",
                        "target_lang_word": "idle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db7e693f-fc14-39be-a2b7-6cdef812b21c",
                                        "entry_id": "5da7707d-1c0c-3332-8ca0-2f8376c17405",
                                        "glosses": [
                                            "Empty, vacant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bab5703-363f-3b0e-b470-0b4d83d545cb",
                                        "entry_id": "5da7707d-1c0c-3332-8ca0-2f8376c17405",
                                        "glosses": [
                                            "Not being used appropriately; not occupied; (of time) with no, no important, or not much activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f9647a7-37e6-417f-b593-d513729141b2",
                                                "sense_id": "9bab5703-363f-3b0e-b470-0b4d83d545cb",
                                                "text": "idle hours"
                                            },
                                            {
                                                "example_id": "1fa71a4d-db6b-4d7a-a258-5716c54a4fb4",
                                                "sense_id": "9bab5703-363f-3b0e-b470-0b4d83d545cb",
                                                "text": "My computer hibernates after it has been idle for 30 minutes."
                                            },
                                            {
                                                "example_id": "c206304b-27a8-4570-8cd7-f0add17a02ed",
                                                "sense_id": "9bab5703-363f-3b0e-b470-0b4d83d545cb",
                                                "text": "The majority of accounts require no minimum balance and charge no monthly service fee. Where monthly fees and balance requirements exist, they're low. You earn no interest on the idle money in the account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77a1cc2-6c2e-3c4c-a7a8-e34e27914657",
                                        "entry_id": "5da7707d-1c0c-3332-8ca0-2f8376c17405",
                                        "glosses": [
                                            "Not engaged in any occupation or employment; unemployed; inactive; doing nothing in particular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dea7220a-e746-4d5a-b51b-3519c461f686",
                                                "sense_id": "a77a1cc2-6c2e-3c4c-a7a8-e34e27914657",
                                                "text": "idle workmen"
                                            },
                                            {
                                                "example_id": "19a52078-2d88-460d-ba42-c97a12191120",
                                                "sense_id": "a77a1cc2-6c2e-3c4c-a7a8-e34e27914657",
                                                "text": "Molly the dairymaid came a little way from the rickyard, and said she would pluck the pigeon that very night after work. She was always ready to do anything for us boys; and we could never quite make out why they scolded her so for an idle hussy indoors. It seemed so unjust. Looking back, I recollect she had very beautiful brown eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5578b1c4-a6b4-3ac8-b096-ab028f8829e3",
                                        "entry_id": "5da7707d-1c0c-3332-8ca0-2f8376c17405",
                                        "glosses": [
                                            "Averse to work, labor or employment; lazy; slothful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbdb6c62-6a9a-49c5-8bed-daa71bd7b78f",
                                                "sense_id": "5578b1c4-a6b4-3ac8-b096-ab028f8829e3",
                                                "text": "an idle fellow"
                                            },
                                            {
                                                "example_id": "cbb4e742-ec40-406e-9bcd-84ed167eed17",
                                                "sense_id": "5578b1c4-a6b4-3ac8-b096-ab028f8829e3",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers, the worn-out, passionless men, the enervated matrons of the summer capital,[…]!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f024de-82e6-3022-aa8b-5ec483d394df",
                                        "entry_id": "5da7707d-1c0c-3332-8ca0-2f8376c17405",
                                        "glosses": [
                                            "Of no importance; useless; worthless; vain; trifling; thoughtless; silly."
                                        ],
                                        "tags": [],
                                        "examples": [
