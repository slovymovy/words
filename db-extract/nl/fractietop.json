                        "glosses": [
                            "bestuur van een fractie van een politieke partij in een volksvertegenwoordiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e58edd0-f083-4f05-a7bc-82c70148c9b2",
                                "sense_id": "e8fea3ab-d032-3bce-8175-9b629c17255d",
                                "text": "PvdA-leider Samsom zei in RTL Late Night dat de twee is aangeboden dat ze geen verklaring zouden ondertekenen. In plaats daarvan zouden de fractietop en de twee Kamerleden gezamenlijk voor de camera verschijnen om het vertrouwen in elkaar uit te spreken. Toen Öztürk en Kuznu dat weigerden, was er geen basis meer voor samenwerking, volgens Samsom."
                            },
                            {
                                "example_id": "d10bb825-271d-4ddb-8975-e668f7ed2e4f",
                                "sense_id": "e8fea3ab-d032-3bce-8175-9b629c17255d",
                                "text": "\"Er is heel lang geschorst, bijna een uur. De VVD-fractietop is bij elkaar gaan zitten. Daar is ook geconcludeerd dat dit niet langer kan. Er kwam ook een signaal vanuit de oppositie. Er zijn belletjes gaan rinkelen dat de hele oppositie tegen zou gaan stemmen. In dat geval had hij nog steeds de meerderheid van VVD en PvdA."
                            }
                        ]
                    }
