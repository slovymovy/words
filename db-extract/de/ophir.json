                "senses": [
                    {
                        "sense_id": "2dd1e58c-c483-3b3c-93cc-337cac1dee8a",
                        "entry_id": "8f438984-baae-3adb-ab18-9a7e544a0e8b",
                        "glosses": [
                            "sagenhaftes Goldland im Tanach und Alten Testament"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e30fe43-596f-45b0-a5a8-665bf5cc5164",
                                "sense_id": "2dd1e58c-c483-3b3c-93cc-337cac1dee8a",
                                "text": "„Dass die ‹Entdecker› und Eroberer ihre Reisen als Suche nach mythischen Orten wie dem Goldland Ophir, dem Reich der Amazonen etc. stilisierten oder die Flora und Fauna mit paradiesischen Bildern aus der Bibel verglichen, überrascht nicht.“"
                            },
                            {
                                "example_id": "06da5033-8096-4f98-9bce-a6d90238018d",
                                "sense_id": "2dd1e58c-c483-3b3c-93cc-337cac1dee8a",
                                "text": "„Rhodes richtete seine Blicke auf das Gebiet dahinter, die endlose Savanne nördlich des Limpopo. Dort vermutete man das sagenhafte Goldland Ophir aus dem Alten Testament.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5079823c-bd62-448b-9b5e-bac7c17b6317",
                        "source_entry_id": "8f438984-baae-3adb-ab18-9a7e544a0e8b",
                        "source_sense_id": "2dd1e58c-c483-3b3c-93cc-337cac1dee8a",
