                ],
                "senses": [
                    {
                        "sense_id": "84b9551c-af1b-33a1-b5aa-5141abf01679",
                        "entry_id": "3c8d3346-b46e-30d4-8567-080d0fd002e2",
                        "glosses": [
                            "истор. связанный с культом Вакха, вакханалией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f803d1d0-f3c9-4a59-8e23-a8e37f1e3820",
                                "sense_id": "84b9551c-af1b-33a1-b5aa-5141abf01679",
                                "text": "Часто, бывало, // После оргий вакхальных другие сатиры спешили // Либо в пещеры свои отдохнуть на душистых постелях, // Либо к рощам пугать и преследовать юных пастушек."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c1fc9b8-a42a-319e-8ca9-c5acb70a56f1",
                        "entry_id": "3c8d3346-b46e-30d4-8567-080d0fd002e2",
                        "glosses": [
                            "перен. шумный, исступлённо-весёлый (обычно о пиршестве)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e51075-ebcc-47bc-98f0-5c69516aa7e3",
                                "sense_id": "8c1fc9b8-a42a-319e-8ca9-c5acb70a56f1",
                                "text": "Что смолкнул веселия глас? // Раздайтесь, вакхальны припевы! // Да здравствуют нежные девы // И юные жёны, любившие нас!"
                            }
                        ]
                    }
                ],
