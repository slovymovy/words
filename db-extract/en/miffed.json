                        "entry_id": "ea828e3d-9fa8-3cbe-83e4-029abfcffa76",
                        "glosses": [
                            "Somewhat indignant, irritated, angry, in a snit, put out or annoyed."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "25378c22-3a36-46b5-9d42-133682e73314",
                                "sense_id": "c63ffc98-3fb4-3d10-9882-914911ef6d0a",
                                "text": "I was miffed at Rick for his behavior. I was miffed at the coach, not for his naivete of deafness, but for his arrogance, which converted his ignorance to stupidity."
                            },
                            {
                                "example_id": "1c7904f7-b8ad-435f-a107-931491a54475",
                                "sense_id": "c63ffc98-3fb4-3d10-9882-914911ef6d0a",
                                "text": "And also, it's generally not a good idea to prank someone who's already miffed at you."
                            },
                            {
                                "example_id": "fcfd1ada-e7c2-457a-bf19-91e88d497659",
                                "sense_id": "c63ffc98-3fb4-3d10-9882-914911ef6d0a",
                                "text": "Donors might be miffed to find that a magnificent gift was not earmarked for rescue."
                            }
                        ]
