                                        "sense_id": "49f9c875-af62-3136-ad8a-acfc6a268f39",
                                        "entry_id": "9d10cb30-641a-3ab7-a0cf-83fee3bd1dcd",
                                        "glosses": [
                                            "Individu pointilleux, tatillon, qui ergote."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a739b69-c9fa-470c-aa61-cde70fe003cc",
                                                "sense_id": "49f9c875-af62-3136-ad8a-acfc6a268f39",
                                                "text": "Je ne suis pas un enculeur de mouches, moi. Je fais des chansons. Les cons des lettres, abrutis, n’ont-ils pas compris ?"
                                            },
                                            {
                                                "example_id": "04ff45ef-dfb3-4514-90f5-818716ab78b3",
                                                "sense_id": "49f9c875-af62-3136-ad8a-acfc6a268f39",
                                                "text": "Ce globuleux, je lui trouve pourtant un air enculeur de mouches que ça m’étonne de le voir saboter l’enquête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f58e80cd-d4e5-4096-b0c3-8c484821212a",
                        "source_entry_id": "0cee75aa-8371-3413-ad96-aa556226ea64",
                        "source_sense_id": "36ddfea3-ca40-34fb-9ad6-6ea3642de032",
