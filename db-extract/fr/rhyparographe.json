                        "glosses": [
                            "Peintre qui choisissait des thèmes triviaux."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "929dac40-3091-496e-969c-feed0c5e7b16",
                                "sense_id": "20aeb9a8-b686-31d7-b0b7-9d57cd056657",
                                "text": "Sa spécialité lui valut d’être nommé rhyparographe, peintre d’objets vils."
                            },
                            {
                                "example_id": "ce8de5ea-69ed-4b09-9097-4b348ff72aaa",
                                "sense_id": "20aeb9a8-b686-31d7-b0b7-9d57cd056657",
                                "text": "Je n’en veux plus aux académiciens d’avoir couronné Les Coquelicots puisque, quelques années plus tard, ils ont récompensé un de mes livres. Je sais qu’ils travaillent sur la lettre r de leur dictionnaire : eh bien, s’ils ont besoin d’éclaircissements relativement aux rhapsodes, aux rhéteurs ou aux rhyparographes, je suis naturellement à leur disposition."
                            },
                            {
                                "example_id": "09f6606e-bc01-4264-8cd8-0c21afcb3a50",
                                "sense_id": "20aeb9a8-b686-31d7-b0b7-9d57cd056657",
                                "text": "Piraïcos était un rhyparographe grec."
                            }
                        ]
                    }
