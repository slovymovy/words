{
    "word_family": [
        "dashboard",
        "dashing",
        "dasher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af47d7e2-aaf9-316b-a5ce-c505a5603b44",
                    "sense_definition": "To run or travel somewhere with great speed and urgency.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>dash</w> if we want to catch the last train home.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>побежать</w>, если мы хотим успеть на последний поезд домой.",
                                "zh": "如果我们想赶上回家的末班车，就得<w>冲</w>过去。"
                            }
                        },
                        {
                            "text": "She <w>dashed</w> across the street to avoid the rain.",
                            "target_lang_translations": {
                                "ru": "Она <w>ринулась</w> через улицу, чтобы укрыться от дождя.",
                                "zh": "为了躲雨，她<w>飞奔</w>过了马路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rush",
                        "sprint",
                        "race",
                        "bolt",
                        "hurry",
                        "run",
                        "scoot"
                    ],
                    "antonyms": [
                        "dawdle",
                        "linger"
                    ],
                    "common_phrases": [
                        "dash off",
                        "dash away",
                        "dash across"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бежать или ехать куда-то с большой скоростью и спешкой.",
                        "zh": "以极快的速度匆忙前往某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "двигаться с очень большой скоростью"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "очень быстро бежать или ехать"
                            },
                            {
                                "target_lang_word": "ринуться",
                                "target_lang_sense_clarification": "стремительно броситься"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲",
                                "target_lang_sense_clarification": "快速奔跑"
                            },
                            {
                                "target_lang_word": "飞奔",
                                "target_lang_sense_clarification": "极快地跑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f80ff9f4-2fec-31ee-b224-d97448bdc286",
                    "sense_definition": "To leave a place quickly or suddenly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "movement_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry, but I have to <w>dash</w> now to pick up the kids.",
                            "target_lang_translations": {
                                "ru": "Извините, но мне нужно <w>бежать</w>, чтобы забрать детей.",
                                "zh": "抱歉，我得<w>赶快走</w>去接孩子们了。"
                            }
                        },
                        {
                            "text": "He <w>dashed</w> before I could even say goodbye.",
                            "target_lang_translations": {
                                "ru": "Он <w>убежал</w> прежде, чем я успел даже попрощаться.",
                                "zh": "我还没来得及说再见，他就<w>溜走</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leave",
                        "depart",
                        "take off",
                        "rush off"
                    ],
                    "antonyms": [
                        "stay",
                        "remain"
                    ],
                    "common_phrases": [
                        "must dash",
                        "have to dash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро или внезапно покинуть место.",
                        "zh": "匆忙或突然离开某地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бежать",
                                "target_lang_sense_clarification": "торопиться уйти (разг.)"
                            },
                            {
                                "target_lang_word": "убегать",
                                "target_lang_sense_clarification": "поспешно удаляться"
                            },
                            {
                                "target_lang_word": "смыться",
                                "target_lang_sense_clarification": "незаметно или быстро уйти (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赶快走",
                                "target_lang_sense_clarification": "匆忙离开"
                            },
                            {
                                "target_lang_word": "溜走",
                                "target_lang_sense_clarification": "迅速离开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ac1915e-6a7a-3cfd-b69d-e848c6e7d98f",
                    "sense_definition": "To destroy or ruin something, especially hopes, plans, or expectations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden injury <w>dashed</w> his dreams of becoming a professional athlete.",
                            "target_lang_translations": {
                                "ru": "Внезапная травма <w>разбила</w> его мечты стать профессиональным спортсменом.",
                                "zh": "突如其来的伤病让他的职业运动员梦想<w>破灭</w>了。"
                            }
                        },
                        {
                            "text": "Bad weather <w>dashed</w> our hopes for a sunny picnic.",
                            "target_lang_translations": {
                                "ru": "Плохая погода <w>разрушила</w> наши надежды на солнечный пикник.",
                                "zh": "糟糕的天气<w>粉碎</w>了我们想要阳光明媚野餐的希望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ruin",
                        "destroy",
                        "shatter",
                        "blight",
                        "wreck"
                    ],
                    "antonyms": [
                        "fulfill",
                        "realize"
                    ],
                    "common_phrases": [
                        "dash hopes",
                        "dash dreams",
                        "dash plans"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушить или уничтожить что-то, особенно надежды, планы или ожидания.",
                        "zh": "摧毁或破坏某事物，尤指希望、计划或期望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "уничтожить надежды или мечты"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "привести к краху"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破灭",
                                "target_lang_sense_clarification": "使希望或梦想落空"
                            },
                            {
                                "target_lang_word": "粉碎",
                                "target_lang_sense_clarification": "彻底摧毁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d7d5ad3-1a2d-354e-8d3a-d4f975f91fae",
                    "sense_definition": "To throw something violently against a surface so that it breaks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a fit of anger, he <w>dashed</w> the vase against the wall.",
                            "target_lang_translations": {
                                "ru": "В приступе гнева он <w>разбил</w> вазу о стену.",
                                "zh": "盛怒之下，他把花瓶<w>摔碎</w>在墙上。"
                            }
                        },
                        {
                            "text": "The waves <w>dashed</w> the small boat against the jagged rocks.",
                            "target_lang_translations": {
                                "ru": "Волны <w>разбили</w> маленькую лодку об острые скалы.",
                                "zh": "海浪将小船<w>猛撞</w>在嶙峋的岩石上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smash",
                        "hurl",
                        "fling",
                        "crash"
                    ],
                    "common_phrases": [
                        "dash against",
                        "dash to pieces"
                    ],
                    "target_lang_definitions": {
                        "ru": "С силой бросить что-то о поверхность так, чтобы оно разбилось.",
                        "zh": "猛烈地将某物摔向表面使其破碎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "ударом о поверхность"
                            },
                            {
                                "target_lang_word": "швырнуть",
                                "target_lang_sense_clarification": "сильно бросить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摔碎",
                                "target_lang_sense_clarification": "用力摔打导致破碎"
                            },
                            {
                                "target_lang_word": "猛撞",
                                "target_lang_sense_clarification": "剧烈碰撞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "053a7e1f-1d0c-3e2e-9a5d-7d4bca86dbad",
                    "sense_definition": "To write or draw something very quickly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>dashed</w> off a quick note to her mother before leaving.",
                            "target_lang_translations": {
                                "ru": "Перед уходом она <w>набросала</w> быструю записку маме.",
                                "zh": "离开前，她给母亲<w>草拟</w>了一张简短的字条。"
                            }
                        },
                        {
                            "text": "The artist <w>dashed</w> a rough sketch on the napkin.",
                            "target_lang_translations": {
                                "ru": "Художник <w>набросал</w> грубый эскиз на салфетке.",
                                "zh": "艺术家在餐巾纸上<w>匆匆写下</w>了一幅草图。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scribble",
                        "jot",
                        "scrawl"
                    ],
                    "common_phrases": [
                        "dash off",
                        "dash down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Написать или нарисовать что-то очень быстро.",
                        "zh": "非常快速地书写或绘制某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набросать",
                                "target_lang_sense_clarification": "быстро написать или нарисовать"
                            },
                            {
                                "target_lang_word": "черкнуть",
                                "target_lang_sense_clarification": "быстро написать короткую записку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草拟",
                                "target_lang_sense_clarification": "快速写下"
                            },
                            {
                                "target_lang_word": "匆匆写下",
                                "target_lang_sense_clarification": "快速记录"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a04bc98b-148b-3201-84e7-303e87a5d3f3",
                    "sense_definition": "An act of running somewhere suddenly and hastily.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the rain started, we made a <w>dash</w> for the car.",
                            "target_lang_translations": {
                                "ru": "Когда начался дождь, мы сделали <w>рывок</w> к машине.",
                                "zh": "雨开始下的时候，我们向汽车<w>冲刺</w>。"
                            }
                        },
                        {
                            "text": "The thief made a sudden <w>dash</w> toward the open door.",
                            "target_lang_translations": {
                                "ru": "Вор совершил внезапный <w>бросок</w> к открытой двери.",
                                "zh": "小偷突然向敞开的门<w>猛冲</w>过去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sprint",
                        "rush",
                        "run",
                        "race"
                    ],
                    "common_phrases": [
                        "make a dash",
                        "mad dash",
                        "100-meter dash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в быстром и внезапном беге куда-либо.",
                        "zh": "突然且匆忙地奔向某处的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "бросок",
                                "target_lang_sense_clarification": "стремительное движение к цели"
                            },
                            {
                                "target_lang_word": "пробежка",
                                "target_lang_sense_clarification": "короткий бег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲刺",
                                "target_lang_sense_clarification": "快速奔跑"
                            },
                            {
                                "target_lang_word": "猛冲",
                                "target_lang_sense_clarification": "突然的快速移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f42dbd9f-f207-3eb7-894a-daccceab9a30",
                    "sense_definition": "A punctuation mark (—) used to separate parts of a sentence or indicate a pause.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should use a <w>dash</w> here to add extra emphasis to the phrase.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать здесь <w>тире</w>, чтобы добавить фразе дополнительный акцент.",
                                "zh": "你应该在这里用一个<w>破折号</w>来加强短语的语气。"
                            }
                        },
                        {
                            "text": "The teacher explained the difference between a hyphen and a <w>dash</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил разницу между дефисом и <w>тире</w>.",
                                "zh": "老师解释了连字符和<w>破折号</w>的区别。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "em dash",
                        "en dash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак препинания (—), используемый для разделения частей предложения или обозначения паузы.",
                        "zh": "用于分隔句子部分或表示停顿的标点符号（—）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тире",
                                "target_lang_sense_clarification": "знак препинания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破折号",
                                "target_lang_sense_clarification": "标点符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1af34e18-bc0b-32f8-ad76-11fa8a4c212f",
                    "sense_definition": "A small quantity of a liquid or substance added to a mixture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add a <w>dash</w> of milk to the eggs before whisking them.",
                            "target_lang_translations": {
                                "ru": "Добавьте <w>каплю</w> молока в яйца перед взбиванием.",
                                "zh": "在打蛋前加入<w>少许</w>牛奶。"
                            }
                        },
                        {
                            "text": "The recipe calls for just a <w>dash</w> of salt.",
                            "target_lang_translations": {
                                "ru": "Рецепт требует всего лишь <w>щепотку</w> соли.",
                                "zh": "食谱里只需要<w>一点</w>盐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "splash",
                        "pinch",
                        "drop",
                        "touch",
                        "hint"
                    ],
                    "antonyms": [
                        "lot",
                        "heap"
                    ],
                    "common_phrases": [
                        "dash of salt",
                        "dash of lemon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество жидкости или вещества, добавленное в смесь.",
                        "zh": "添加到混合物中的少量液体或物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капля",
                                "target_lang_sense_clarification": "о жидкости"
                            },
                            {
                                "target_lang_word": "щепотка",
                                "target_lang_sense_clarification": "о сыпучих веществах"
                            },
                            {
                                "target_lang_word": "чуточка",
                                "target_lang_sense_clarification": "совсем немного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少许",
                                "target_lang_sense_clarification": "极小的量"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "少量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42f963c0-1291-32b3-964f-2d1f0192cc7e",
                    "sense_definition": "The control panel in a vehicle containing instruments and controls.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wiped the dust off the <w>dash</w> of his old truck.",
                            "target_lang_translations": {
                                "ru": "Он стер пыль с <w>приборной панели</w> своего старого грузовика.",
                                "zh": "他擦掉了旧卡车<w>仪表盘</w>上的灰尘。"
                            }
                        },
                        {
                            "text": "The warning light on the <w>dash</w> started blinking red.",
                            "target_lang_translations": {
                                "ru": "Предупреждающий индикатор на <w>приборной панели</w> начал мигать красным.",
                                "zh": "<w>仪表盘</w>上的警示灯开始闪烁红光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dashboard",
                        "instrument panel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for dashboard"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Панель управления в транспортном средстве, содержащая приборы и переключатели.",
                        "zh": "车辆中包含仪表和控制装置的面板。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приборная панель",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "торпеда",
                                "target_lang_sense_clarification": "разговорное название передней панели авто"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仪表盘",
                                "target_lang_sense_clarification": "汽车控制面板"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3988c89-bc09-3923-8dac-40c005b7cdd4",
                    "sense_definition": "A quality of stylishness, confidence, and vigor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier in his uniform cut a <w>dash</w> at the ball.",
                            "target_lang_translations": {
                                "ru": "Солдат в форме произвел <w>фурор</w> на балу.",
                                "zh": "身着制服的士兵在舞会上展现了非凡的<w>风度</w>。"
                            }
                        },
                        {
                            "text": "She always dresses with a certain <w>dash</w> and elegance.",
                            "target_lang_translations": {
                                "ru": "Она всегда одевается с определенным <w>шиком</w> и элегантностью.",
                                "zh": "她穿衣总是带着一种独特的<w>气派</w>和优雅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flair",
                        "panache",
                        "style",
                        "verve",
                        "vigor"
                    ],
                    "antonyms": [
                        "dullness"
                    ],
                    "common_phrases": [
                        "cut a dash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, выражающееся в стильности, уверенности и энергичности.",
                        "zh": "一种时髦、自信和充满活力的品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шик",
                                "target_lang_sense_clarification": "элегантность и стиль"
                            },
                            {
                                "target_lang_word": "удаль",
                                "target_lang_sense_clarification": "смелость и бойкость"
                            },
