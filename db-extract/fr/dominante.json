                "senses": [
                    {
                        "sense_id": "cdda57f0-5bb7-328b-b368-86da592b8fb0",
                        "entry_id": "3045aab5-aad0-3024-a649-864fdf576786",
                        "glosses": [
                            "Féminin singulier de dominant."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "5a5933eb-ef8a-453a-97cf-3e3dd7530d5e",
                                "sense_id": "cdda57f0-5bb7-328b-b368-86da592b8fb0",
                                "text": "En dehors des modes littéraires et intellectuelles et au-delà des séparations culturelles et géographiques, Queneau opère ainsi un choix qui n’est pas influencé par la vision « hexagonocentrique » dominante."
                            },
                            {
                                "example_id": "f5ec8aa3-5c9f-4a0b-8312-fce811ee63bd",
                                "sense_id": "cdda57f0-5bb7-328b-b368-86da592b8fb0",
                                "text": "Ce déclin du courage est particulièrement sensible dans la couche dirigeante et dans la couche intellectuelle dominante, d’où l’impression que le courage a déserté la société tout entière."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ce94b73c-a039-32ee-8f9f-6af71bbc9ffe",
