                "senses": [
                    {
                        "sense_id": "ddbceecc-fa47-38a0-b8b2-835cad4e1c8d",
                        "entry_id": "87d1a5c3-e98e-308e-9b91-c0de70a00135",
                        "glosses": [
                            "Petite peau blanche qui vient quelquefois au bout de la langue des oiseaux, particulièrement des poules, et qui les empêche de boire et de pousser leur cri ordinaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "187a257a-e6d9-4d9f-a430-ae80ebb7fd74",
                                "sense_id": "ddbceecc-fa47-38a0-b8b2-835cad4e1c8d",
                                "text": "Ôter la pépie à une poule, à un oiseau."
                            },
                            {
                                "example_id": "97f10bbe-0095-4cfc-8c16-5f6e607753a4",
                                "sense_id": "ddbceecc-fa47-38a0-b8b2-835cad4e1c8d",
                                "text": "Une autre fois on avait oublié de lui donner à boire ; il manqua d’en avoir la pépie, quand on l’en garantit par quelques gouttes d’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2c98a24-8fae-3c6c-8540-553f57185496",
                        "entry_id": "87d1a5c3-e98e-308e-9b91-c0de70a00135",
                        "glosses": [
                            "Grande soif."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "5d67d231-3cdb-4084-a187-79c861bc4487",
                                "sense_id": "e2c98a24-8fae-3c6c-8540-553f57185496",
                                "text": "Avoir la pépie."
                            },
                            {
                                "example_id": "6ba8d6e7-40de-4ca6-b009-bfe2abb804a2",
                                "sense_id": "e2c98a24-8fae-3c6c-8540-553f57185496",
                                "text": "Cet homme n’a pas la pépie, il boit volontiers."
                            }
                        ]
                    }
