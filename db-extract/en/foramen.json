                                "target_senses": [
                                    {
                                        "sense_id": "68bf481c-1687-3a45-b127-45bc3d6f9dcd",
                                        "entry_id": "33f5c9f4-5a7e-3e94-841b-f5e698487b0e",
                                        "glosses": [
                                            "дыра, сквозной проём в каком-либо твёрдом объекте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9ea5c3-7d57-4bad-84e5-7846d69a0cae",
                                                "sense_id": "68bf481c-1687-3a45-b127-45bc3d6f9dcd",
                                                "text": "Котел варился посредине, и дым выходил в отверстие, сделанное в верху кибитки."
                                            },
                                            {
                                                "example_id": "1b40a58c-1784-4fff-9c68-69af3b826b74",
                                                "sense_id": "68bf481c-1687-3a45-b127-45bc3d6f9dcd",
                                                "text": "Просушенную почву растирают и просеивают через сито с отверстиями диаметром 1 мм."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cdbb435-beaa-335d-9ba7-7d8bbf4cc9dc",
                                        "entry_id": "33f5c9f4-5a7e-3e94-841b-f5e698487b0e",
                                        "glosses": [
                                            "место узкого входа в длинную или широкую полость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6bb715-c702-46ce-9030-cdb29d9c8241",
                                                "sense_id": "2cdbb435-beaa-335d-9ba7-7d8bbf4cc9dc",
                                                "text": "Старик смеется и делает «дождик»: зажимает отверстие шланга пальцем, вода рассеивается на мелкие брызги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5e1659e-4c9e-32b1-b40e-2c6ba4ef500e",
                                        "entry_id": "33f5c9f4-5a7e-3e94-841b-f5e698487b0e",
                                        "glosses": [
                                            "узкая глубокая несквозная впадина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2b3b9a-45de-414c-bc04-49be20dcce37",
                                                "sense_id": "e5e1659e-4c9e-32b1-b40e-2c6ba4ef500e",
                                                "text": "Чтобы ввернуть шуруп в твердое дерево, предварительно сделай небольшое отверстие буравчиком, а шуруп смажь каким-либо жиром или мылом."
                                            }
                                        ]
                                    }
