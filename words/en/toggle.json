{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "894ce219-f406-375f-baf5-5534e8097691",
                    "sense_definition": "To switch or alternate between two different states or settings.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toggle_switch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can press this key to <w>toggle</w> between light and dark mode.",
                            "target_lang_translations": {
                                "tr": "Açık ve koyu mod arasında <w>geçiş yapmak</w> için bu tuşa basabilirsiniz."
                            }
                        },
                        {
                            "text": "It is easy to <w>toggle</w> options in the menu whenever you need.",
                            "target_lang_translations": {
                                "tr": "İhtiyacınız olduğunda menüdeki seçenekleri <w>değiştirmek</w> kolaydır."
                            }
                        }
                    ],
                    "synonyms": [
                        "switch",
                        "alternate"
                    ],
                    "common_phrases": [
                        "toggle between",
                        "toggle options"
                    ],
                    "target_lang_definitions": {
                        "tr": "İki farklı durum veya ayar arasında geçiş yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçiş yapmak",
                                "target_lang_sense_clarification": "iki durum arasında değişim sağlama"
                            },
                            {
                                "target_lang_word": "arasında geçiş yapmak",
                                "target_lang_sense_clarification": "iki seçenek/mod arasında değişim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef68fac1-3a32-35e9-90cf-929da9fe500b",
                    "sense_definition": "To turn a feature on or off using a single control, switch, or button.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toggle_switch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Clicking the icon will <w>toggle</w> the sound on or off instantly.",
                            "target_lang_translations": {
                                "tr": "Simgeye tıklamak sesi anında <w>açıp kapatacaktır</w>."
                            }
                        },
                        {
                            "text": "You can <w>toggle</w> settings directly from the main panel.",
                            "target_lang_translations": {
                                "tr": "Ayarları doğrudan ana panelden <w>değiştirebilirsiniz</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toggle on",
                        "toggle settings"
                    ],
                    "target_lang_definitions": {
                        "tr": "Açma/kapatma işlemini tek bir düğme veya kumanda ile yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "açıp kapatmak",
                                "target_lang_sense_clarification": "özelliği etkinleştirip devre dışı bırakmak"
                            },
                            {
                                "target_lang_word": "değiştirmek",
                                "target_lang_sense_clarification": "durumu değiştirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "120870f5-35b2-31e3-9841-c1b99ac7cae6",
                    "sense_definition": "To fasten or fix securely with a pin or rod.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor had to <w>toggle</w> the rope to make sure it held firm.",
                            "target_lang_translations": {
                                "tr": "Denizci, sıkı tuttuğundan emin olmak için halatı bir pimle <w>sabitlenmek</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "They used a pin to <w>toggle</w> the heavy mechanism into place.",
                            "target_lang_translations": {
                                "tr": "Ağır mekanizmayı yerine <w>tutturmak</w> için bir pim kullandılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "secure"
                    ],
                    "antonyms": [
                        "unfasten"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir çubuk veya pim yardımıyla sıkıca sabitlemek veya bağlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tutturmak",
                                "target_lang_sense_clarification": "pim veya çubukla sabitlemek"
                            },
                            {
                                "target_lang_word": "sabitlemek",
                                "target_lang_sense_clarification": "hareketsiz hale getirmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cc91b55-b2ba-3121-bf78-55ba377e8d2c",
                    "sense_definition": "A key, switch, or digital control that alternates between two states.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toggle_mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Click the <w>toggle</w> button to hide the side menu.",
                            "target_lang_translations": {
                                "tr": "Yan menüyü gizlemek için <w>geçiş</w> düğmesine tıklayın."
                            }
                        },
                        {
                            "text": "The app features an easy-to-use <w>toggle</w> switch for notifications.",
                            "target_lang_translations": {
                                "tr": "Uygulama, bildirimler için kullanımı kolay bir <w>açma-kapama</w> düğmesine sahiptir."
                            }
                        }
                    ],
                    "synonyms": [
                        "switch"
                    ],
                    "common_phrases": [
                        "toggle switch",
                        "toggle button"
                    ],
                    "target_lang_definitions": {
                        "tr": "İki durum arasında geçiş sağlayan tuş, anahtar veya dijital kontrol."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçiş anahtarı",
                                "target_lang_sense_clarification": "dijital veya fiziksel geçiş düğmesi"
                            },
                            {
                                "target_lang_word": "anahtar",
                                "target_lang_sense_clarification": "açma/kapama düğmesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25449289-5310-3732-8d24-9ebae579b92b",
                    "sense_definition": "A small rod-shaped button used to fasten clothing, such as a duffle coat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toggle_fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His coat was fastened with a wooden <w>toggle</w> instead of a standard button.",
                            "target_lang_translations": {
                                "tr": "Kabanı, standart bir düğme yerine ahşap bir <w>çubuk düğme</w> ile tutturulmuştu."
                            }
                        },
                        {
                            "text": "She pushed the <w>toggle</w> button through the loop to close her jacket.",
                            "target_lang_translations": {
                                "tr": "Ceketini kapatmak için <w>çubuk düğmeyi</w> halkanın içinden geçirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "button",
                        "fastener"
                    ],
                    "common_phrases": [
                        "wooden toggle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kıyafetleri iliklemek için kullanılan çubuk şeklinde silindir düğme."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çubuk düğme",
                                "target_lang_sense_clarification": "kabanlarda kullanılan silindir şeklinde düğme"
                            },
                            {
                                "target_lang_word": "çintiye",
                                "target_lang_sense_clarification": "halka ve çubuktan oluşan düğme çeşidi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c81163-eac1-30b2-8d70-7f3861d70fef",
                    "sense_definition": "A type of wall anchor or fastener that expands or opens up behind a surface to hold securely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toggle_fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a <w>toggle</w> bolt to hang heavy shelves on drywall safely.",
                            "target_lang_translations": {
                                "tr": "Ağır rafları alçıpan üzerine güvenle asmak için bir <w>kelebek</w> civata kullanın."
                            }
                        },
                        {
                            "text": "The package includes strong <w>toggle</w> anchors for mounting the television.",
                            "target_lang_translations": {
                                "tr": "Paket, televizyonu monte etmek için güçlü <w>kanatlı</w> dübeller içerir."
                            }
                        }
                    ],
                    "synonyms": [
                        "anchor"
                    ],
                    "common_phrases": [
                        "toggle bolt"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüzeyin arkasında açılarak sağlam tutunma sağlayan bir tür duvar dübeli veya bağlantı elemanı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kanatlı dübel",
                                "target_lang_sense_clarification": "boşluklu duvarlar için açılır dübel"
                            },
                            {
                                "target_lang_word": "kelebek dübel",
                                "target_lang_sense_clarification": "arkada açılarak tutunan dübel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "160c4342-29da-3f6f-82dc-8bd6b121b48a",
                    "sense_definition": "A short wooden or metal pin inserted transversely through a rope or chain loop to hold it in place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "toggle_fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor secured the rope using a small wooden <w>toggle</w>.",
                            "target_lang_translations": {
                                "tr": "Denizci, küçük bir ahşap <w>pim</w> kullanarak halatı sabitledi."
                            }
                        },
                        {
                            "text": "A metal <w>toggle</w> kept the heavy chain attached to the ring.",
                            "target_lang_translations": {
                                "tr": "Metal bir <w>birleştirme pimi</w>, ağır zincirin halkaya bağlı kalmasını sağladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "pin"
                    ],
                    "target_lang_definitions": {
                        "tr": "Halat veya zincir halkasından geçirilerek sabitlemeye yarayan kısa ahşap veya metal pim."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çivi",
                                "target_lang_sense_clarification": "sabitleme pimi"
                            },
                            {
                                "target_lang_word": "birleştirme pimi",
                                "target_lang_sense_clarification": "halat/zincir sabitleme pimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e9f0d9c-7051-3f95-af0a-c6578f65e32c",
                    "sense_definition": "A handle or control loop attached to steering lines, as on a parachute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skydiver pulled the right <w>toggle</w> to steer the parachute smoothly.",
                            "target_lang_translations": {
                                "tr": "Paraşütçü, paraşütü yumuşak bir şekilde yönlendirmek için sağ <w>tutamağı</w> çekti."
                            }
                        },
                        {
                            "text": "Keep a firm grip on each steering <w>toggle</w> while descending.",
                            "target_lang_translations": {
                                "tr": "İnerken her bir yönlendirme <w>tutamağını</w> sıkıca tutun."
                            }
                        }
                    ],
                    "synonyms": [
                        "handle"
                    ],
                    "common_phrases": [
                        "steering toggle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Paraşüt gibi araçlarda yönlendirme iplerine bağlı tutamak veya kontrol halkası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yönlendirme tutamağı",
                                "target_lang_sense_clarification": "paraşüt kumanda kolu/halkası"
                            },
                            {
                                "target_lang_word": "kumanda kolu",
                                "target_lang_sense_clarification": "yön verme halkası"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fb083a6-a54a-3544-99fc-b065c2e77410",
                    "sense_definition": "A crosspiece or horizontal wooden support used in carpentry or theatrical set construction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stage crew added a wooden <w>toggle</w> to reinforce the scenery flat.",
                            "target_lang_translations": {
                                "tr": "Sahne ekibi, dekor panosunu güçlendirmek için ahşap bir <w>ara kayıt</w> ekledi."
                            }
                        },
                        {
                            "text": "Check that each <w>toggle</w> in the frame is firmly nailed.",
                            "target_lang_translations": {
                                "tr": "Çerçevedeki her bir <w>destek çıtasının</w> sıkıca çivilendiğinden emin olun."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Marangozlukta veya tiyatro dekoru yapımında kullanılan yatay ahşap destek parçası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ara kayıt",
                                "target_lang_sense_clarification": "ahşap çerçeve içi yatay destek"
                            },
                            {
                                "target_lang_word": "destek çıtası",
                                "target_lang_sense_clarification": "ahşap yapı kuşağı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f69c5296-c749-3ba5-b9f5-8403f26cc4b0",
                    "sense_definition": "A mechanical device consisting of connected arms or levers that amplifies force or changes its direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toggle_mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The press uses a mechanical <w>toggle</w> to exert high pressure efficiently.",
                            "target_lang_translations": {
                                "tr": "Pres, verimli bir şekilde yüksek basınç uygulamak için mekanik bir <w>mafsal sistemi</w> kullanır."
                            }
                        },
                        {
                            "text": "This mechanism relies on a simple <w>toggle</w> to multiply force.",
                            "target_lang_translations": {
                                "tr": "Bu mekanizma, kuvveti çoğaltmak için basit bir <w>dirsekli kaldıraca</w> dayanır."
                            }
                        }
                    ],
                    "synonyms": [
                        "lever"
                    ],
                    "common_phrases": [
                        "toggle joint"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bağlantılı kollardan oluşan ve kuvveti artıran mekanik düzenek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "mafsal mekanizması",
                                "target_lang_sense_clarification": "kaldıraçlı kuvvet artırıcı sistem"
                            },
                            {
                                "target_lang_word": "dirsekli kaldıraç",
                                "target_lang_sense_clarification": "mekanik kuvvet aktarıcı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
