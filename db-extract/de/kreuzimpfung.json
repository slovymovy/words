                "senses": [
                    {
                        "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                        "entry_id": "151db4b3-cb92-3518-9589-bc09e72d749c",
                        "glosses": [
                            "Verabreichen von zwei oder mehr Dosen Impfstoff in zeitlichem Abstand gegen eine Krankheit, bei denen die Dosen auf unterschiedlichen Wirkmechanismen beruhen (beispielsweise eine Kombination aus einem Vektorimpfstoff und einem mRNA-Impfstoff)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698ab2af-da07-4cc4-82a0-3b42dc637d02",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[12.4.2021:] „AstraZeneca-Debatte: Weil Daten zu möglichen Risiken von Kreuzimpfungen bisher fehlen, spricht sich die WHO gegen eine Zweitimpfung mit anderen Vakzinen aus.“"
                            },
                            {
                                "example_id": "564cd7d9-0369-4dd5-a464-bbf7dae16a34",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[28.5.2021:] „Auch Immunologe Carsten Watzl sagt, eine Kreuzimpfung sei besonders effektiv: »Die Antikörperspiegel sind laut erster Studien bei Kreuzimpfungen höher als wenn man zweimal AstraZeneca nehmen würde, und sogar höher, als wenn man zweimal mit Biontech geimpft wird.«“"
                            },
                            {
                                "example_id": "48ee324f-0d1e-4160-9288-7bdaee58a94e",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[3.6.2021:] „Nachdem AstraZeneca im März nur für über 60-Jährige empfohlen worden war, wurde in der Folge oft Biontech zweitverimpft. Ein MHH-Studie macht nun Hoffnung auf eine hohe Wirksamkeit der Kreuzimpfung.“"
                            },
                            {
                                "example_id": "9e40c04c-ef50-4450-abdd-2537722d6381",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[29.6.2021:] „Snape sagte der BBC, dass sein Team im Juli auch Ergebnisse für Kreuzimpfungen mit einem Abstand von 12 Wochen zwischen erster und zweiter Spritze präsentieren werde.“"
                            },
                            {
                                "example_id": "45f7ebe0-8291-49f5-921a-0ab15f032eca",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[2.7.2021:] „Deutschland hat nach Angaben von Bundesgesundheitsminister Jens Spahn ausreichend Impf-Dosen, um die Empfehlung der Ständigen Impfkommission (Stiko) für Kreuzimpfungen umzusetzen.“"
                            },
                            {
                                "example_id": "a5b4e808-5788-4d1c-bbb9-64589f0c7722",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[3.7.2021:] „Die Verwirrung nach der Impfempfehlung für eine sogenannte Kreuzimpfung ist bei den Patienten groß: Welcher Impfstoff kann in welchem zeitlichen Abstand kombiniert werden?“"
                            },
                            {
                                "example_id": "260909fe-ebdc-4438-bffb-42bb929c5e68",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[7.7.2021:] „Auch wer eine Kreuzimpfung erhalten [hat], also zum Beispiel erst mit Astrazeneca und dann mit Biontech/Pfizer oder Moderna geimpft wurde, gilt in der EU als voll geimpft.“"
                            },
                            {
                                "example_id": "ba1f5edd-b763-417d-9c55-a10758cc25dd",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[8.7.2021:] „Die Immunantwort einer Kreuzimpfung sei der zweifachen Impfung mit AstraZeneca \"deutlich überlegen\", so die STIKO.“"
                            },
                            {
                                "example_id": "1801b7da-f740-49be-8cb6-4b23cb92450a",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[8.7.2021:] „Allerdings wurde bei \"Mix and Match\"-Geimpften - so heißt die Kreuzimpfung auf Englisch - häufiger Nebenwirkungen wie Kopfschmerzen, Müdigkeit, Fieber beobachtet.“"
                            },
                            {
                                "example_id": "8ea9b98a-4e1a-4bdd-bbad-b671ad07751c",
                                "sense_id": "185a2180-ec34-3129-b201-3ea8d03e1b63",
                                "text": "[11.7.2021:] „Menschen, die bisher erst eine Impfung mit AstraZeneca bekommen haben, empfiehlt der Mediziner eine sogenannte Kreuzimpfung mit den Wirkstoffen Biontech/Pfizer oder Moderna.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
