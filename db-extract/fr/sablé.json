                "senses": [
                    {
                        "sense_id": "413fddd4-b65b-3410-b3b7-fc30ed3981e1",
                        "entry_id": "ee09173c-b96f-316f-af96-a32565c41ae0",
                        "glosses": [
                            "Dont la pâte est friable et se réduit en poudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6be53f-4565-48c0-85de-ac902dfa4ae7",
                                "sense_id": "413fddd4-b65b-3410-b3b7-fc30ed3981e1",
                                "text": "Galette sablée."
                            }
                        ]
                    },
                    {
                        "sense_id": "54e14bdd-2279-3f3b-82c3-ef0a2eb04e0a",
                        "entry_id": "ee09173c-b96f-316f-af96-a32565c41ae0",
                        "glosses": [
                            "Moucheté de points très fins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8039e6a9-6ffe-455e-8240-d0e124e48ba3",
                                "sense_id": "54e14bdd-2279-3f3b-82c3-ef0a2eb04e0a",
                                "text": "Un objet en laque sablé d’or."
                            }
                        ]
                    },
                    {
                        "sense_id": "0684c464-2d3c-3157-9342-2097b2d6ddba",
                        "entry_id": "ee09173c-b96f-316f-af96-a32565c41ae0",
                        "glosses": [
                            "Qui contient du sable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f8eea3-6839-4287-89ab-fd1d5f53151b",
                                "sense_id": "0684c464-2d3c-3157-9342-2097b2d6ddba",
                                "text": "Une fontaine sablée est un appareil qui filtre l’eau à travers une couche de sable."
                            }
                        ]
                    },
                    {
                        "sense_id": "365f489d-ad3e-38cf-9a43-635d8688f91d",
                        "entry_id": "ee09173c-b96f-316f-af96-a32565c41ae0",
                        "glosses": [
                            "Aspect de certaines pièces en métal qui ont été soumises à l’action d’un jet de sable sous haute pression, à un sablage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b1edf9-da7a-4e49-9d42-4007f5048b14",
                                "sense_id": "365f489d-ad3e-38cf-9a43-635d8688f91d",
                                "text": "La structure du siège est en acier sablé et verni, les sièges sont en bois."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "21b77be9-cb38-3af3-b606-b68fa3ba75a1",
                "word": "sablé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b799ceef-e88f-413f-8635-185d688f4ee6",
                        "entry_id": "21b77be9-cb38-3af3-b606-b68fa3ba75a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "sablés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f30d6a9-3562-3f08-8a75-605bb062a8df",
                        "entry_id": "21b77be9-cb38-3af3-b606-b68fa3ba75a1",
                        "glosses": [
                            "Gâteau sec dont la pâte est friable et se réduit en poudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8351f521-280c-43f7-a0c1-3454ab883cd5",
                                "sense_id": "2f30d6a9-3562-3f08-8a75-605bb062a8df",
                                "text": "Accolez avec un peu de confiture chaque sablé plein avec un sablé troué et saupoudrez-les de sucre glace."
                            },
                            {
                                "example_id": "9b6caeab-54a7-46d0-96f7-c9f8eca42110",
                                "sense_id": "2f30d6a9-3562-3f08-8a75-605bb062a8df",
                                "text": "Ses parents ont préparé des sablés pour le goûter."
                            },
                            {
                                "example_id": "75e229d6-7689-41e2-9ec3-2ada417fcf66",
                                "sense_id": "2f30d6a9-3562-3f08-8a75-605bb062a8df",
                                "text": "Je vous en ferai manger, moi, de la galette normande, de la vraie, et des sablés, je ne vous dis que ça."
                            },
                            {
                                "example_id": "faa8e5dd-129f-4ea1-b0c9-8fd9a39f480d",
                                "sense_id": "2f30d6a9-3562-3f08-8a75-605bb062a8df",
                                "text": "(…) si l’on cuit de la farine à sec, dans une casserole, on obtient une farine « torréfiée » qui, additionnée de beurre, œuf, sucre, fait des sablés « parfaits »."
                            },
                            {
                                "example_id": "bc55a47c-76f3-4af3-9cf4-71638e2f1263",
                                "sense_id": "2f30d6a9-3562-3f08-8a75-605bb062a8df",
                                "text": "Pourquoi s’éreinter à faire des sablés au beurre quand on peut en acheter à l’épicerie ?"
                            }
                        ]
                    }
                ],
