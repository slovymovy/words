                "senses": [
                    {
                        "sense_id": "b778f3c7-3db4-3667-83d1-a6c024a917b3",
                        "entry_id": "171aa20f-a81a-3a3f-95d1-1c140fbe93d4",
                        "glosses": [
                            "Fleurs de beaucoup de fabacées dont les corolles, formées de cinq pétales inégaux, ont quelque ressemblance avec un papillon qui vole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "297eea75-d71a-430b-86b7-7b423b4d1c94",
                                "sense_id": "b778f3c7-3db4-3667-83d1-a6c024a917b3",
                                "text": "Une fleur papilionacée est constituée de 5 pétales : l’étendard, 2 ailes et la carène (2 pétales soudés)."
                            },
                            {
                                "example_id": "91c48b7a-032c-409a-aa5e-704d6c365ebc",
                                "sense_id": "b778f3c7-3db4-3667-83d1-a6c024a917b3",
                                "text": "Presque toutes les fleurs des légumineuses (ou fabacées) sont papilionacées."
                            },
                            {
                                "example_id": "c517a5be-d74e-41d4-b14d-7419e169de86",
                                "sense_id": "b778f3c7-3db4-3667-83d1-a6c024a917b3",
                                "text": "Corolle papilionacée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27513d82-d3e5-46b9-8cce-96111d4bdf38",
                        "source_entry_id": "171aa20f-a81a-3a3f-95d1-1c140fbe93d4",
                        "source_sense_id": "b778f3c7-3db4-3667-83d1-a6c024a917b3",
