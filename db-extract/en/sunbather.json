                                "example_id": "f0c9464a-e181-4a89-902e-11bc2bbe0cc4",
                                "sense_id": "9739b6c7-eeca-3384-8af5-e182787b9841",
                                "text": "I went to the beach to look at the sunbathers, at least some of whom went there to be looked at while they worked on their tans."
                            }
                        ]
                    }
                ],
