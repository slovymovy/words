                                    {
                                        "sense_id": "726dd3fb-eb1f-3538-9bdb-521f4060bce4",
                                        "entry_id": "d8bdbd9f-34ef-3540-8ba2-789d8c569775",
                                        "glosses": [
                                            "(in afrikanischen Savannen der mittelafrikanischen Steppen beheimatetes, in Herden lebendes) großes, langbeiniges, pflanzenfressendes Säugetier (Giraffa camelopardalis) mit einem 2–3 Meter langen Hals, dessen kurzes Fell sandfarben gefärbt und unregelmäßig mit (rost-)braunen Flecken versehen ist, dessen Rücken stark abfällt und auf dessen Stirn sich mehrere fellüberzogene Knochenzapfen befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50d6f636-4006-473a-8c92-9e539250312d",
                                                "sense_id": "726dd3fb-eb1f-3538-9bdb-521f4060bce4",
                                                "text": "Die Giraffe ist ein afrikanisches Huftier."
                                            },
                                            {
                                                "example_id": "b742d9e7-4c42-47c4-b3da-7b1c0611f595",
                                                "sense_id": "726dd3fb-eb1f-3538-9bdb-521f4060bce4",
                                                "text": "„Wenn sich die Giraffen recken, / Hochlaub sucht die spitze Zunge, / Das ihnen so schmeckt, wie junge / Frühkartoffeln mit Butter mir schmecken.“"
                                            },
                                            {
                                                "example_id": "01a14029-b26b-48a2-b88d-dd7a5f69ac03",
                                                "sense_id": "726dd3fb-eb1f-3538-9bdb-521f4060bce4",
                                                "text": "„Die Zahlen sind alarmierend: Einer Studie zufolge, die in der Fachzeitschrift ‚BMC Biology Journal‘ veröffentlicht wurde, gibt es insgesamt noch rund 110.000 Giraffen auf dem afrikanischen Kontinent - einige der Gruppen jedoch seien inzwischen auf wenige hundert geschrumpft.“"
                                            },
                                            {
                                                "example_id": "46c98cab-abc8-4b9a-89ed-e17270628380",
                                                "sense_id": "726dd3fb-eb1f-3538-9bdb-521f4060bce4",
                                                "text": "„Die Giraffe, glaubte er, hat deshalb einen langen Hals, weil sie ihn Generation um Generation nach immer höheren Blättern streckte.“"
                                            },
                                            {
                                                "example_id": "a5a22db2-63e8-44ef-b2d0-93f10419aff9",
                                                "sense_id": "726dd3fb-eb1f-3538-9bdb-521f4060bce4",
                                                "text": "„Vor zehn Jahren lebten schätzungsweise 140.000 Giraffen in Afrika. Heute gibt es weniger als 100.000.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8c85e7f-fa56-38e6-b24d-1c3846287876",
                                        "entry_id": "d8bdbd9f-34ef-3540-8ba2-789d8c569775",
                                        "glosses": [
                                            "mit einem langen, schwenkbaren Arm versehenes Gerät, an dem beispielsweise eine Kamera oder ein (nicht sichtbares) Mikrofon montiert ist"
                                        ],
