                                "fr": "Retrouver des amis est toujours une grande <w>joie</w>.",
                                "de": "Ein Treffen mit Freunden ist immer eine große <w>Freude</w>.",
                                "es": "Reunirse con amigos siempre es una gran <w>alegría</w>.",
                                "it": "Incontrare gli amici è sempre una grande <w>gioia</w>.",
                                "tr": "Arkadaşlar ile buluşmak her zaman büyük bir <w>mutluluktur</w>.",
                                "cs": "Setkání s přáteli je vždy velká <w>radost</w>."
                            }
                        },
                        {
                            "text": "Маленькие <w>радости</w> делают нашу жизнь приятнее.",
                            "target_lang_translations": {
                                "en": "Small <w>joys</w> make our life more pleasant.",
                                "nl": "Kleine <w>vreugdes</w> maken ons leven aangenamer.",
                                "pl": "Małe <w>radości</w> czynią nasze życie przyjemniejszym.",
                                "fr": "Les petits <w>plaisirs</w> rendent notre vie plus agréable.",
                                "de": "Kleine <w>Freuden</w> machen unser Leben angenehmer.",
                                "es": "Las pequeñas <w>alegrías</w> hacen nuestra vida más agradable.",
                                "it": "Le piccole <w>gioie</w> rendono la nostra vita più piacevole.",
                                "tr": "Küçük <w>sevinçler</w> hayatımızı daha keyifli hale getirir.",
                                "cs": "Malé <w>radosti</w> dělají náš život příjemnějším."
                            }
