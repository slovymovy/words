                ],
                "senses": [
                    {
                        "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                        "entry_id": "39c68f5f-b252-3b2c-885a-d80973c1ab25",
                        "glosses": [
                            "Bereich, in dem hauptsächlich Männer tätig sind bzw. der in der Hauptsache durch Männer geprägt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69388e66-c8f1-4def-b681-ce8aacf2516a",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Weltweit ist der Beruf noch immer ganz klar eine Männerdomäne, nur etwa fünf Prozent aller Piloten in der kommerziellen Luftfahrt sind weiblich.“"
                            },
                            {
                                "example_id": "227e41b7-3849-4da2-87ae-33e2bf73128a",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "Schachspielen ist eine Männerdomäne: ca. 90% der Spieler sind männlich, nur eine einzige Frau (Judit Polgár) hat 2.700 Elo-Punkte erreicht (Männer: 123) und in 188 Jahren gab es noch keine einzige Schachweltmeisterin."
                            },
                            {
                                "example_id": "3902dd7f-dc41-462a-8a38-25ce9fe84423",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Go war lange Zeit eine Männerdomäne, ähnlich dem Schach.“"
                            },
                            {
                                "example_id": "0fa1b0b2-bbce-4702-bf63-0b4741b2adf5",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Der Architekturberuf ist eine Männerdomäne.“"
                            },
                            {
                                "example_id": "b4711641-6a25-4257-874f-94c7066db56b",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Noch immer interessieren sich wenige Frauen für ein Studium oder gar eine Hochschulkarriere in Maschinenbau, Elektrotechnik oder Physik. Ist der Einstieg in eine Männerdomäne wirklich so schwer? Können Frauen sich eine Laufbahn als erfolgreiche Professorin nicht vorstellen?“"
                            },
                            {
                                "example_id": "a015da7e-88d7-4f87-8d60-ed4abea477b7",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "[Kfz-Mechatroniker:] „Der Beruf ist eine klassische Männerdomäne. 2019 lag der Frauenanteil bei den neu abgeschlossenen Ausbildungsverträgen in Deutschland bei 4,3 %.“"
                            },
                            {
                                "example_id": "bbde85da-2388-419f-9970-004f094f9f17",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Autowerkstätten sind eine klassische Männerdomäne - der Frauenanteil liegt hier gerade mal bei rund 4.5 Prozent.“"
                            },
                            {
                                "example_id": "d95303e2-15a8-4580-9f01-51a3ae2a4ce1",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "Motorrad- und Formel 1-Rennen sind eine Männerdomäne."
                            },
                            {
                                "example_id": "aa4ce250-09c2-4144-be62-f090d42cfac5",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„In den Zeiten und Kulturen, in denen die Kriegsführung als reine Männerdomäne galt, gab es immer wieder Frauen, die sich als Mann ausgaben und unter dieser Tarnung mit den Männern in den Krieg zogen.“"
                            },
                            {
                                "example_id": "b96ed2a7-2f70-4a37-831b-3a631e941616",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Die klassische Musik ist nach wie vor eine Männerdomäne.“"
                            },
                            {
                                "example_id": "62253387-a5b8-4097-a871-30239701c46b",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Immer mehr Frauen stehen am Dirigentenpult und erobern die einstige Männerdomäne.“"
                            },
                            {
                                "example_id": "10eeeed5-a632-4b69-b5c3-d820efe8755d",
                                "sense_id": "583c6a2e-30da-3be7-963b-69965854e120",
                                "text": "„Festivals sind eine Männerdomäne - zumindest was die Acts auf der Bühne angeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
