                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a10854-9541-470f-acf2-5774361de056",
                                "sense_id": "9b29c559-9446-31b0-8640-7ff6a02849ad",
                                "text": "Hoewel bedoeld om in te trainen, worden trainingspakken ook vaak gedragen als vrijetijdskleding."
                            },
                            {
                                "example_id": "944c5af6-aee4-44e4-b478-81f34bbfba50",
                                "sense_id": "9b29c559-9446-31b0-8640-7ff6a02849ad",
                                "text": "Luc begon zijn fitnesstraining om tien uur. Als warming-up zat hij in zijn trainingspak een sigaret te roken, waarna hij het roeiapparaat uit de kast sleepte, de televisie aanzette en begon te roeien terwijl hij strak naar het beeldscherm staarde."
                            },
                            {
                                "example_id": "1e319cbb-d1df-44f0-b473-c257db574a36",
                                "sense_id": "9b29c559-9446-31b0-8640-7ff6a02849ad",
                                "text": "De jongeman in het trainingspak kwam overeind. Hij kon niet ouder dan achttien zijn."
                            }
                        ]
                    }
