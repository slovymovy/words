                    }
                ],
                "translations": [
                    {
                        "translation_id": "79e2b245-6da7-4933-84a9-c7b4bbb69c29",
                        "source_entry_id": "c984f750-50bf-38d2-b134-cb176618dbea",
                        "source_sense_id": "f0e81911-f28f-31ca-8000-15034c7240e2",
                        "target_lang_word": "combler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "combler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47f79198-d451-332e-a499-f46651512f41",
                                        "entry_id": "579651d2-8839-3e52-8034-3ba8695e5b0f",
                                        "glosses": [
                                            "Remplir jusque par dessus les bords."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4fc2cd0-da11-4a7d-b97f-d9ca2eb1f8f6",
                                                "sense_id": "47f79198-d451-332e-a499-f46651512f41",
                                                "text": "Combler une mesure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f840bdc1-4a4b-318e-baef-f657408bec21",
                                        "entry_id": "579651d2-8839-3e52-8034-3ba8695e5b0f",
                                        "glosses": [
                                            "Faire que ce qui était creux ne le soit plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6430e21-5e3a-40bc-ac59-cf5150ce1bce",
                                                "sense_id": "f840bdc1-4a4b-318e-baef-f657408bec21",
                                                "text": "Venise aura le sort d'Alger, […]. Un jour, par mesure sanitaire, on comblera tous les canaux. Il y passera des tramways de banlieue, c'est à dire des trains de cinq voitures."
                                            },
                                            {
                                                "example_id": "3a7691fd-2b72-4f03-9049-9e19c4e4783b",
                                                "sense_id": "f840bdc1-4a4b-318e-baef-f657408bec21",
                                                "text": "Après le « mur murant » de 1786, les fortifications de 1840 ont été démolies pierre par pierre, et la terre de leurs glacis à servi à combler les fossés de défense dont on l'avait tirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99133844-597b-3e8b-b87c-f760eed0c7ce",
                                        "entry_id": "579651d2-8839-3e52-8034-3ba8695e5b0f",
                                        "glosses": [
                                            "Remplir un vide, compenser un défaut."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c141cc13-8693-4738-bcaf-84a2ed4bc887",
                                                "sense_id": "99133844-597b-3e8b-b87c-f760eed0c7ce",
                                                "text": "Être ultra-resserré sans la balle et déployé avec, une stratégie qui permet de combler les lacunes individuelles quand le ballon est perdu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de43a9a1-8e21-3e91-a053-25c08418d9c3",
                                        "entry_id": "579651d2-8839-3e52-8034-3ba8695e5b0f",
                                        "glosses": [
                                            "Satisfaire ; exaucer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc18dd47-0eae-4ec5-9ee0-d6a34c53af5c",
                                                "sense_id": "de43a9a1-8e21-3e91-a053-25c08418d9c3",
                                                "text": "— C’est bon ?\n— À combler le Prophète, murmura Mokkhi."
                                            },
                                            {
                                                "example_id": "19b5471c-b208-4c29-a312-c3276edc04bb",
                                                "sense_id": "de43a9a1-8e21-3e91-a053-25c08418d9c3",
                                                "text": "En rentrant du dîner, j'ai couché avec Seb dans sa Maserati, mais je n’étais pas comblée, alors, j'ai rappelé N. Il n'a pas décroché et n'a pas répondu à mon sexto non plus. Je suis dépitée et frustrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df19548f-d2b1-34e6-b97e-646d4099bef4",
                                        "entry_id": "579651d2-8839-3e52-8034-3ba8695e5b0f",
                                        "glosses": [
                                            "Charger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b17ae0-e3b3-4847-999c-40d649eaa5b0",
                                                "sense_id": "df19548f-d2b1-34e6-b97e-646d4099bef4",
                                                "text": "J'ai été comblé de faveurs."
                                            },
                                            {
                                                "example_id": "a4002519-0d15-4b6a-88ce-eb7d188b7e40",
                                                "sense_id": "df19548f-d2b1-34e6-b97e-646d4099bef4",
                                                "text": "Mes succès scolaires la comblaient d’orgueil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf0833c8-26a9-37b2-8ebb-b97374e6d9c4",
                                        "entry_id": "579651d2-8839-3e52-8034-3ba8695e5b0f",
                                        "glosses": [
                                            "Mettre le comble à quelque chose, le rendre complet."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
