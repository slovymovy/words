                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "063aba21-db8f-45ab-9b7e-6ddcaedf90dc",
                                "sense_id": "a5b361ac-2c60-328e-a55d-e3643fb4d8cd",
                                "text": "Niet alle werknemers die een dierbare verliezen zijn even tevreden met de steun van hun werkgever. Vooral mensen die hun vakantiedagen moesten inzetten in de rouwperiode misten steun van hun baas."
                            }
                        ]
                    }
