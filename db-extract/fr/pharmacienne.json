        "fr-extract.jsonl": [
            {
                "entry_id": "6fd2be52-06bb-3ca5-8bdd-8495dbe54358",
                "word": "pharmacienne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "693b5170-8fea-4637-9ecd-4691b18dc6ef",
                        "entry_id": "6fd2be52-06bb-3ca5-8bdd-8495dbe54358",
                        "tags": [
