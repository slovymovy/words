                    {
                        "sense_id": "4e0ea24d-d75e-3314-bab9-c3373aaf9357",
                        "entry_id": "a71ce400-071d-3df6-86a6-ca2efe34ba19",
                        "glosses": [
                            "Fils né d’un même accouchement de six enfants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c94c73b4-3f07-4489-84e5-04af23251f74",
                                "sense_id": "4e0ea24d-d75e-3314-bab9-c3373aaf9357",
                                "text": "Un deuxième sextuplé né il y a deux semaines à Vancouver est décédé."
                            },
                            {
                                "example_id": "d4e22ae1-351e-4770-9b9d-8c0f858e25ea",
                                "sense_id": "4e0ea24d-d75e-3314-bab9-c3373aaf9357",
                                "text": "À partir du 24 novembre 2016, ça sera au tour des deux derniers sextuplés de la famille Matsuno (Jyushimatsu & Todomatsu)."
                            }
                        ]
                    },
                    {
                        "sense_id": "b170bd41-8ea9-33c5-91ea-efb359c2251e",
                        "entry_id": "a71ce400-071d-3df6-86a6-ca2efe34ba19",
                        "glosses": [
                            "Fait pour un joueur de marquer six buts au cours d’un même match."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a35b69-bd09-46ba-8e42-bad2e8307d99",
                                "sense_id": "b170bd41-8ea9-33c5-91ea-efb359c2251e",
                                "text": "Contre Aurora, le joueur du club de La Paz réussit un sextuplé pour une victoire 7–2 !"
                            }
                        ]
                    },
                    {
                        "sense_id": "bf4b430f-c4c5-34ab-84c2-b03a8f8324cc",
                        "entry_id": "a71ce400-071d-3df6-86a6-ca2efe34ba19",
                        "glosses": [
                            "Fait pour un joueur ou une équipe de gagner six compétitions lors d’une même saison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ccae266-c3f1-49f0-a501-70c3e4329ccc",
                                "sense_id": "bf4b430f-c4c5-34ab-84c2-b03a8f8324cc",
                                "text": "Pep Guardiola a su tirer le meilleur de ses joueurs en tant qu’entraîneur du FC Barcelone entre 2008 et 2012, parvenant notamment à remporter le fameux sextuplé lors de sa première saison sur le banc du club catalan."
                            }
                        ]
                    }
