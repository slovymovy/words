                    {
                        "sense_id": "943a870f-81bc-3ba2-97f2-e76368965d96",
                        "entry_id": "83a78ca9-e97d-3a2c-a8dc-3c38f9aeade5",
                        "glosses": [
                            "richting waarin projectielen worden weggeschoten"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cb63294e-5c42-36c2-b690-fb2608f715a4",
                        "entry_id": "83a78ca9-e97d-3a2c-a8dc-3c38f9aeade5",
                        "glosses": [
                            "gevechtsterrein tot waar het geschut draagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19dc560-1820-49db-94d7-53a38310ddf0",
                                "sense_id": "cb63294e-5c42-36c2-b690-fb2608f715a4",
                                "text": "Tijdens de oorlog kwam het dorp in zijn geheel in de vuurlinie te liggen."
                            },
                            {
                                "example_id": "c58f7f27-b82b-48fe-93c2-5fde2f4142ca",
                                "sense_id": "cb63294e-5c42-36c2-b690-fb2608f715a4",
                                "text": "Ze wisten de gewonde commando Kevin van de Rijdt uit de vuurlinie te halen, verleenden eerste hulp en droegen hem naar een ommuurde woning. Eenmaal in de helikopter voor gewondenvervoer bleek hij overleden."
                            },
                            {
                                "example_id": "2911c10b-fc9e-4e21-927d-299c5cbe8e53",
                                "sense_id": "cb63294e-5c42-36c2-b690-fb2608f715a4",
                                "text": "Pas in de Tweede Wereldoorlog, toen enkele eilanden in de vuurlinie kwamen te liggen, werden deze traditionele samenlevingen met hun zelfvoorzienende economieën geopend naar de buitenwereld."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf24c881-3a60-3288-8c86-43a469d21328",
                        "entry_id": "83a78ca9-e97d-3a2c-a8dc-3c38f9aeade5",
                        "glosses": [
                            "plaats waar de meeste schade is te verwachten"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "259a8acd-50ea-428e-8b96-acf75ad552e1",
                                "sense_id": "bf24c881-3a60-3288-8c86-43a469d21328",
                                "text": "Geniet nog maar even van de zon vandaag: aan het eind van de middag krijgen Overijssel en Gelderland de volle laag van een onweersstorm. Ook de provincies Brabant en en Limburg liggen in de vuurlinie van zware onweersbuien. ProRail waarschuwt alvast voor overlast doordat bijvoorbeeld omvallende bomen en blikseminslag het treinverkeer verstoren."
                            }
                        ]
                    }
