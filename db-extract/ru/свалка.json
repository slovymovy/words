                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3822217-7d7e-495e-a30b-06700fc3d57c",
                                                "sense_id": "44c671ce-6c79-39ed-954f-49bd4b3b95c9",
