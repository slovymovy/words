                "senses": [
                    {
                        "sense_id": "eab123ee-7962-368e-b6c7-970f47164226",
                        "entry_id": "3b8f1f5a-cf79-39e0-a29d-44e84891ebf4",
                        "glosses": [
                            "Autre orthographe, moins courante, de fantasmer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80fadc63-6eb5-4ea2-87b1-f669b1c94d32",
                                "sense_id": "eab123ee-7962-368e-b6c7-970f47164226",
                                "text": "L'idée de la famille en soi ne me fait pas phantasmer ;"
                            },
                            {
                                "example_id": "e5f42971-8dac-4b38-8fc6-933d4f747d21",
                                "sense_id": "eab123ee-7962-368e-b6c7-970f47164226",
                                "text": "Par exemple, le Surmoi interdit de phantasmer tel état ou de le phantasmer tranquillement, sans perturbation ou prix à payer."
                            },
                            {
                                "example_id": "b0f4f1f1-ac37-4893-acfc-325b63d666a3",
                                "sense_id": "eab123ee-7962-368e-b6c7-970f47164226",
                                "text": "Ce monde est, pour lui, phantasmé à l’instar de la mère mauvaise surprotectrice, étouffant sa liberté et le gavant."
                            }
                        ]
                    }
