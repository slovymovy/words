                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>natuur</w> naar mijn vader wat betreft mijn koppigheid.",
                            "target_lang_translations": {
                                "en": "I <w>take after</w> my father regarding my stubbornness.",
                                "ru": "Я <w>похожу</w> на отца своим упрямством.",
                                "pl": "<w>Wdaję się</w> w mojego ojca, jeśli chodzi o mój upór.",
                                "de": "Ich <w>schlage</w> nach meinem Vater, was meine Sturheit betrifft.",
                                "fr": "Je <w>tiens</w> de mon père en ce qui concerne mon entêtement.",
                                "it": "<w>Prendo da</w> mio padre per quanto riguarda la mia caparbietà.",
                                "cs": "Pokud jde o mou tvrdohlavost, <w>jsem po</w> svém otci.",
                                "tr": "İnatçılık konusunda babama <w>çekmişim</w>.",
                                "es": "Me <w>parezco</w> a mi padre en cuanto a mi terquedad."
