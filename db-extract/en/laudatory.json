                                        "sense_id": "c2cfed80-17b3-30d3-84a3-0a3eb442db1f",
                                        "entry_id": "b97b880b-63ad-385d-bac7-244ad3afc890",
                                        "glosses": [
                                            "Qui loue, qui exprime une louange."
