                "senses": [
                    {
                        "sense_id": "fce37289-ca07-314f-a5f2-7231749645b9",
                        "entry_id": "3e579f47-de77-3d5e-8e37-58e73e92a2c8",
                        "glosses": [
                            "Action d’enjamber ou espace qu’on enjambe, qu’on peut enjamber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f90cfe3-d251-40fe-8d6a-fd4a763f0324",
                                "sense_id": "fce37289-ca07-314f-a5f2-7231749645b9",
                                "text": "À ce tronc si court sont attachés des membres d’une longueur gigantesque : l’enjambée faite est ainsi profitable à une marche fort rapide."
                            },
                            {
                                "example_id": "4669b3cf-3edb-4060-b7a2-6e7049f07f4c",
                                "sense_id": "fce37289-ca07-314f-a5f2-7231749645b9",
                                "text": "Les enjambées dans le temps qui y ont pris place n'ont-elles pas dérouté mes lecteurs? J'espère que non."
                            },
                            {
                                "example_id": "23a86d49-41c6-40c7-a095-c7f854a8ca5d",
                                "sense_id": "fce37289-ca07-314f-a5f2-7231749645b9",
                                "text": "Un lacis, un dédale de petites ruisseaux, de ruisselets, larges d’un pied et qu’on pouvait franchir d’une enjambée; […]."
                            },
                            {
                                "example_id": "e81f29bf-b2fc-450c-bcf0-e0cb36cfbab9",
                                "sense_id": "fce37289-ca07-314f-a5f2-7231749645b9",
                                "text": "Rimbaud aimait battre la campagne autour de Charleville, cheveux en bataille, dans des errances interminables à grandes enjambées, du côté de Romery, Saint-Laurent, Gernelle, pendant lesquelles un vers ou deux jaillissaient. À Romery, il se réfugiait dans une carrière avec son ami Delahaye pour fumer des pipes et écrire."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bb22af0-0e6d-38fc-9759-180f352bab05",
                        "entry_id": "3e579f47-de77-3d5e-8e37-58e73e92a2c8",
                        "glosses": [
                            "Écart entre les deux jambes, pris comme mesure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3d5912-dc35-4049-a9f3-802f4b20c53f",
                                "sense_id": "8bb22af0-0e6d-38fc-9759-180f352bab05",
                                "text": "A gauche, se trouve un jardinet carré qui ne permet pas de faire plus de quatre enjambées en tout sens."
                            }
                        ]
                    }
                ],
