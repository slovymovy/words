                "senses": [
                    {
                        "sense_id": "537de6fc-f6e4-3f58-b895-476c9ede425f",
                        "entry_id": "6526f8bb-d75f-3566-adf7-814bb45e59c2",
                        "glosses": [
                            "betreffende de sterrenkunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9b9fa1-b5c6-4d05-b8d3-eba409cbd24e",
                                "sense_id": "537de6fc-f6e4-3f58-b895-476c9ede425f",
                                "text": "Hun rondleiding begon vlakbij in de Oude Stad, waar Renata hen met vaste hand van bezienswaardigheid naar bezienswaardigheid leidde terwijl ze hen overlaadde met jaartallen en namen over het astronomische uurwerk op het raadhuis uit 1389, over de kruittoren uit de elfde eeuw die in 1475 eerder om esthetische dan om militaire redenen werd omgebouwd en over hoe de Dertigjarige Oorlog begon in de burchtwijk Hradtany met een rel waarbij in 1618 de afgevaardigden, van welke kant ze ook waren, uit een raam werden gegooid."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a8c410a-72ad-3054-afed-f96ba3af4eda",
                        "entry_id": "6526f8bb-d75f-3566-adf7-814bb45e59c2",
                        "glosses": [
                            "buitensporig groot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f96cd19-4de0-4ae2-b49f-9094d2add4fd",
                                "sense_id": "0a8c410a-72ad-3054-afed-f96ba3af4eda",
                                "text": "De wereldwijde spinnenpopulatie doodt ieder jaar een astronomisch aantal (400 tot 800 miljoen ton) insecten, zo blijkt uit een nieuwe studie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b9e47a1-f5d6-4b51-a0cf-42332d098643",
                        "source_entry_id": "6526f8bb-d75f-3566-adf7-814bb45e59c2",
                        "target_lang_word": "astronomisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronomisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d5587d-2962-3015-9dee-d03b325e5525",
                                        "entry_id": "ce1a5dba-d52c-35cb-897d-02e1fdbc2a98",
                                        "glosses": [
                                            "die Astronomie betreffend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7743100-6123-4ddc-81ae-2cba5a426b4e",
                                                "sense_id": "a2d5587d-2962-3015-9dee-d03b325e5525",
                                                "text": "Für astronomische Beobachtungen benötigt man ein gutes Fernrohr."
                                            },
                                            {
                                                "example_id": "052c6f6f-6429-43cd-ab3a-21e15d14ea37",
                                                "sense_id": "a2d5587d-2962-3015-9dee-d03b325e5525",
                                                "text": "„Der Auf- und Untergang der Sonne, des Mondes, der Lichtwechsel des Mondes, der Venus, des Saturnringes und viele andere bedeutsame Erscheinungen entsprachen ihrer Voraussage in den astronomischen Jahrbüchern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05770cb5-4af2-3c16-898a-de2e4804367e",
                                        "entry_id": "ce1a5dba-d52c-35cb-897d-02e1fdbc2a98",
                                        "glosses": [
                                            "sehr groß"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cdc0d19-9d28-43a6-8d19-68c78f77114d",
                                                "sense_id": "05770cb5-4af2-3c16-898a-de2e4804367e",
                                                "text": "Vor Feiertagen gibt es manchmal astronomisch hohe Preise."
                                            },
                                            {
                                                "example_id": "3d4db643-9819-4aeb-a789-eefb6070f7d4",
                                                "sense_id": "05770cb5-4af2-3c16-898a-de2e4804367e",
                                                "text": "Die astronomischen Boni der Investmentbanker sind absurd."
                                            },
                                            {
                                                "example_id": "8481c02e-56ed-4d3a-b1ec-b8d6ba2c6dd5",
                                                "sense_id": "05770cb5-4af2-3c16-898a-de2e4804367e",
                                                "text": "„Das Feierabendbier ist […] in meiner Wahlheimat Stockholm […] eine Institution: Die sonst so astronomischen Preise für alkoholische Getränke werden für das sogenannte Afterwork für ein paar Stunden gesenkt, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2014957b-8001-4d83-b866-fe14b6b66324",
                        "source_entry_id": "6526f8bb-d75f-3566-adf7-814bb45e59c2",
