                    {
                        "translation_id": "2b2e6a84-9202-4a70-8a04-13972539d670",
                        "source_entry_id": "da755993-f57c-34e8-8ce6-7abfa3b9aecb",
                        "source_sense_id": "c51e1b90-ca1e-3e47-b1ea-dfdcd4ccb077",
                        "target_lang_word": "nichtnegativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nichtnegativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5db58d35-bcbd-3b0e-85fa-d474bf5f7fd8",
                                        "entry_id": "390c6add-b0b0-39a8-aca8-880c57eed729",
                                        "glosses": [
                                            "positiv oder gleich Null"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "724a5388-6380-497d-899b-fa3fb373ba3b",
                                                "sense_id": "5db58d35-bcbd-3b0e-85fa-d474bf5f7fd8",
                                                "text": "Zieht man die Wurzel aus einer nichtnegativen Zahl, so erhält man stets ein reelles Ergebnis."
                                            },
                                            {
                                                "example_id": "ae88d93d-853f-4e67-aa06-a744c9eb15bb",
                                                "sense_id": "5db58d35-bcbd-3b0e-85fa-d474bf5f7fd8",
                                                "text": "Die reelle Zahl a heißt genau dann positiv (bzw. negativ oder nichtnegativ), wenn 0<a (bzw. a<0 oder 0≤a) gilt."
                                            },
                                            {
                                                "example_id": "b71d26e3-d423-4c56-a1be-3898061b5c7c",
                                                "sense_id": "5db58d35-bcbd-3b0e-85fa-d474bf5f7fd8",
                                                "text": "Im mathematischen Teilgebiet der Topologie sind die Bettizahlen (nach E. Betti) eine Folge nichtnegativer ganzer Zahlen, die globale Eigenschaften eines topologischen Raumes beschreiben. Sie sind topologische Invarianten."
                                            },
                                            {
                                                "example_id": "e1c37a81-be2a-4c9a-87d7-248e217d6fc6",
                                                "sense_id": "5db58d35-bcbd-3b0e-85fa-d474bf5f7fd8",
                                                "text": "Der Golomb-Code ist eine Darstellungsform für alle nichtnegativen ganzen Zahlen, im Gegensatz zu anderen Codes, die nur einen endlichen Bereich (z. B. 0-255) darstellen können."
                                            },
                                            {
                                                "example_id": "f497ec6f-91a8-4934-babd-f0c853d6a9d4",
                                                "sense_id": "5db58d35-bcbd-3b0e-85fa-d474bf5f7fd8",
                                                "text": "Bestimmte totalnichtnegative Matrizen lassen sich durch ihre Zerlegbarkeit in ein Produkt bidiagonaler nichtnegativer Dreiecksmatrizen charakterisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
