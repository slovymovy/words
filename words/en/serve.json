                            "trait_type": "slang",
                            "comment": "Used in fashion and pop culture contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрировать очень стильный, привлекательный или впечатляющий внешний вид (сленг).",
                        "pl": "Prezentować bardzo stylowy, atrakcyjny lub imponujący wygląd lub postawę (slang)."
                    },
                    "translations": {
