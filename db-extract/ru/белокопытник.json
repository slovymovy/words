                                    {
                                        "sense_id": "ce673476-8958-3a9d-829e-186376816623",
                                        "entry_id": "d724bdf4-c493-373d-919a-5fb3225cb2b1",
                                        "glosses": [
                                            "Petasites hybridus een overblijvende tweehuizige plant uit het geslacht hoefblad uit de composietenfamilie (Asteraceae). De onder meer in België en Nederland voorkomende plant heeft zeer grote bladeren en groeit op vochtige en voedselrijke plaatsen. De rozeachtige bloemhoofdjes staan in een aar die eind maart voor het blad uit de wortelstok tevoorschijn komt. Pas daarna ontwikkelen zich de tot een meter grote bladeren"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32a8db7a-5ff2-4721-96c1-9e8b25a8a5d5",
