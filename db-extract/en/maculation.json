                "senses": [
                    {
                        "sense_id": "a0631672-03cd-3ea9-a629-c13cf5f68ba0",
                        "entry_id": "02633332-eea4-3051-9765-ebf8ce049b37",
                        "glosses": [
                            "The act of spotting; a spot; a blemish."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "193ac7dd-7713-4187-95e1-4d14e160a73a",
                                "sense_id": "a0631672-03cd-3ea9-a629-c13cf5f68ba0",
                                "text": "I speak not ‘be thou true,’ as fearing thee,\nFor I will throw my glove to Death himself,\nThat there’s no maculation in thy heart:"
                            },
                            {
                                "example_id": "b9e40885-e364-43d3-a035-65e859505459",
                                "sense_id": "a0631672-03cd-3ea9-a629-c13cf5f68ba0",
                                "text": "1891, Ambrose Bierce, “A Holy Terror” in Tales of Soldiers and Civilians, San Francisco: E. L. G. Steele, p. 218,\nHe could make out a mottled pattern on the hollow cheeks—the maculations of decay."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4263a88-b724-395e-9044-59ddd15e7ef7",
                        "entry_id": "02633332-eea4-3051-9765-ebf8ce049b37",
                        "glosses": [
                            "A pattern of spots."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "480025fe-e358-4e56-af87-0cb534a22e6f",
                                "sense_id": "f4263a88-b724-395e-9044-59ddd15e7ef7",
                                "text": "Females [of the species Speyeria nokomis] are cream above with heavy black maculation accompanied by much dark suffusion."
                            },
                            {
                                "example_id": "1f34a6b7-fdf1-4ce8-8122-436b17693758",
                                "sense_id": "f4263a88-b724-395e-9044-59ddd15e7ef7",
                                "text": "1990, Mason E. Hale, A Synopsis of the Lichen Genus Xanthoparmelia (Vainio) Hale (Ascomycotina, Parmeliaceae), Washington, DC: Smithsonian Institution Press, p. 195,\n[This lichen] species […] is recognized by […] more or less distinct maculation on the upper surface, and pale brown lower surface."
                            }
                        ]
                    }
