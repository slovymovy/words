                ],
                "senses": [
                    {
                        "sense_id": "aaa32e33-3833-3f05-8b30-7474116d18d6",
                        "entry_id": "0232e4f1-5b44-3cbb-a168-5eaf3e0be18e",
                        "glosses": [
                            "метеорол. устойчивый влажный ветер с сезонной периодичностью в тропических областях, преимущественно приморских"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29472c2-4057-40ad-bbdd-5f360564bafe",
                                "sense_id": "aaa32e33-3833-3f05-8b30-7474116d18d6",
                                "text": "В этот период с морей и океанов сюда поступает затухающий с расстоянием поток влажного воздуха, известный под названием «летний муссон», сезон дождей."
                            },
                            {
                                "example_id": "e42d2f06-c4ef-44ec-9515-e697f354b946",
                                "sense_id": "aaa32e33-3833-3f05-8b30-7474116d18d6",
                                "text": "Бухта не закрыта от зюйда, и становиться в ней на якорь опасно, хотя в это время года, то есть при норд-остовом муссоне, в ней хорошо; зюйдовых ветров нет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3876c94-abc1-46d0-8e8e-5f2af42bcc04",
                        "source_entry_id": "0232e4f1-5b44-3cbb-a168-5eaf3e0be18e",
                        "source_sense_id": "aaa32e33-3833-3f05-8b30-7474116d18d6",
                        "target_lang_word": "monsoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monsoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3a60cf-5709-38d7-8b39-b029ba1f40af",
                                        "entry_id": "f188c629-3ffd-3b11-a22f-03fca93d08c0",
                                        "glosses": [
                                            "Any of a number of winds associated with regions where most rain falls during a particular season."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72d3ee5d-e190-3d2a-b48e-81a21a2dd290",
                                        "entry_id": "f188c629-3ffd-3b11-a22f-03fca93d08c0",
                                        "glosses": [
                                            "Tropical rainy season when the rain lasts for several months with few interruptions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2957bbc-becb-49ff-86cc-9685b4f6880f",
                                                "sense_id": "72d3ee5d-e190-3d2a-b48e-81a21a2dd290",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages. Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66c78f6-cb82-3daa-bb0e-dd3b346f95e0",
                                        "entry_id": "f188c629-3ffd-3b11-a22f-03fca93d08c0",
                                        "glosses": [
                                            "The rains themselves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6bde5bf-ddc3-32cb-b2fb-63e44036ab28",
                                        "entry_id": "f188c629-3ffd-3b11-a22f-03fca93d08c0",
                                        "glosses": [
                                            "Entire meteorological systems with such characteristics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5e27918-e70e-3747-9d35-22fd29ff3c82",
                                        "entry_id": "f188c629-3ffd-3b11-a22f-03fca93d08c0",
                                        "glosses": [
                                            "Any heavy rainstorm."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
