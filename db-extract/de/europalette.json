                        "examples": [
                            {
                                "example_id": "04ef837a-89bc-47f3-a47e-40b8c445a9ca",
                                "sense_id": "b24cf227-7953-3c93-ab88-432184022d8f",
                                "text": "„Ohne die Europalette, die korrekt »Europoolpalette« heißt, blieben ganze Regalkilometer leer.“"
                            },
                            {
                                "example_id": "3d182b61-d2fa-4c8c-9513-d9e769f90013",
                                "sense_id": "b24cf227-7953-3c93-ab88-432184022d8f",
                                "text": "„Die schlichte und eher primitiv, aber verlässlich unkompliziert zusammengehämmerte Europalette bemächtigt sich allmählich, aber zunehmend auch des Alltagslebens.“"
                            }
                        ],
