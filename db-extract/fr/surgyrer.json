                "senses": [
                    {
                        "sense_id": "7ed7d4a8-7a59-3f45-904d-99a97228136c",
                        "entry_id": "fd38661b-0533-361e-a0f8-06c2f5c7728d",
                        "glosses": [
                            "Augmenter la vitesse de rotation d'un corps."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29552ac3-42ae-4180-8875-394b98a6da96",
                        "source_entry_id": "fd38661b-0533-361e-a0f8-06c2f5c7728d",
                        "source_sense_id": "7ed7d4a8-7a59-3f45-904d-99a97228136c",
                        "target_lang_word": "spin up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spin up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "161f1143-a111-3760-afb1-abafade81337",
                                        "entry_id": "7cf7ca65-c616-3c01-bb3a-cb88ae6e1939",
                                        "glosses": [
                                            "To reach a sufficient spinning speed for reads and writes to take place."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5736120b-deef-48aa-8ac4-c15a6b5c04a3",
                                                "sense_id": "161f1143-a111-3760-afb1-abafade81337",
                                                "text": "Plated hard disk surfaces are actually harder and more scratch resistant than read-write heads are. The hard magnetic medium effectively protects itself from head crashes caused by contaminants and the drive's spinning up or down."
                                            },
                                            {
                                                "example_id": "2bd8441c-b8bb-4be2-a663-7cfada4e6636",
                                                "sense_id": "161f1143-a111-3760-afb1-abafade81337",
                                                "text": "The hard drive spun up. The gray screen flickered. The smiley Mac face appeared and soon I was ready to dazzle the world with The Journals Book II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1333aaea-208b-3a10-8199-6b2450f2252a",
                                        "entry_id": "7cf7ca65-c616-3c01-bb3a-cb88ae6e1939",
                                        "glosses": [
                                            "To power up, launch, or instantiate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b398f117-ecbf-4fa1-b800-c3ca9c19b3bd",
                                                "sense_id": "1333aaea-208b-3a10-8199-6b2450f2252a",
                                                "text": "Near-synonyms: spool up; gin up"
                                            },
                                            {
                                                "example_id": "b77995ae-d7e5-4956-a7a5-472289dd2ce5",
                                                "sense_id": "1333aaea-208b-3a10-8199-6b2450f2252a",
                                                "text": "We spun up a virtual server in the cloud to handle the additional load."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a31f7d-3f05-37bc-85f2-5d59a6bd9b84",
                                        "entry_id": "7cf7ca65-c616-3c01-bb3a-cb88ae6e1939",
                                        "glosses": [
                                            "To be brought into full operation; to reach full potential or capacity; to spool up."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47679002-ba83-4754-b7fc-31ae46580754",
                                                "sense_id": "a8a31f7d-3f05-37bc-85f2-5d59a6bd9b84",
                                                "text": "The auditorium opens and the seats fill. As ever, there's a brief, grey dead time while Wheeler waits for all the machinery of the performance to spin up. The anxious feeling is stronger than usual today. It grips him, an uncharacteristic urge to run away. Sure, he thinks. I could just junk my career, right now. Pack it in and make for the stage door. Maybe the taxi'll still be there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38f31ee6-bc77-3128-9f38-16f3eeed6a94",
                                        "entry_id": "7cf7ca65-c616-3c01-bb3a-cb88ae6e1939",
                                        "glosses": [
                                            "To fabricate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75a0a165-1660-462b-8248-bf3e09b5fb4a",
                                                "sense_id": "38f31ee6-bc77-3128-9f38-16f3eeed6a94",
                                                "text": "For the better part of a decade, Donald J. Trump and his allies at Fox News have beguiled some Americans and enraged others as they spun up an alternative world where elections turned on fraud, one political party oppressed another, and one man stood against his detractors to carry his version of truth to an adoring electorate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
