        "fr-extract.jsonl": [
            {
                "entry_id": "94b72198-aee4-3d96-a764-577e36f77b99",
                "word": "sofa",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4cce2bed-b882-4777-a175-746780f48de1",
                        "entry_id": "94b72198-aee4-3d96-a764-577e36f77b99",
                        "tags": [
                            "plural"
                        ],
                        "form": "sofas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36dedec3-46bd-36f9-a50b-622ce891b0a7",
                        "entry_id": "94b72198-aee4-3d96-a764-577e36f77b99",
                        "glosses": [
                            "Sorte d’estrade élevée et couverte d’un tapis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f40bc1c-0f49-45d1-8b09-8645d6cf2604",
                                "sense_id": "36dedec3-46bd-36f9-a50b-622ce891b0a7",
                                "text": "Le grand vizir donnait ses audiences sur un sofa."
                            },
                            {
                                "example_id": "56c0c749-a126-4da2-98b4-fd8b424f4a31",
                                "sense_id": "36dedec3-46bd-36f9-a50b-622ce891b0a7",
                                "text": "Quand le grand vizir recevait les ambassadeurs, on mettait leur siège sur le sofa."
                            },
                            {
                                "example_id": "6fd3b20f-b096-4404-be9f-585c543ba9ba",
                                "sense_id": "36dedec3-46bd-36f9-a50b-622ce891b0a7",
                                "text": "Les honneurs du sofa."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc42c857-4b19-3217-9df0-0f052bf0a41d",
                        "entry_id": "94b72198-aee4-3d96-a764-577e36f77b99",
                        "glosses": [
                            "Sorte de lit de repos, canapé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d6548b-7e97-45ee-b2a7-507fa2755412",
                                "sense_id": "bc42c857-4b19-3217-9df0-0f052bf0a41d",
                                "text": "Nous pique-niquâmes sur le sofa qui servait de lit à Marc."
                            },
                            {
                                "example_id": "73fbdb32-7744-466b-92ff-6a2a83fa0e7b",
                                "sense_id": "bc42c857-4b19-3217-9df0-0f052bf0a41d",
                                "text": "Elle refusa d’un signe de tête, fit un effort pour se lever, s’appuya sur le sofa. Elle était morte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "126f5a7e-3865-4d78-90b7-a7c40b51c9cf",
                        "source_entry_id": "94b72198-aee4-3d96-a764-577e36f77b99",
                        "target_lang_word": "Sofa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sofa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                        "entry_id": "b8b10dd5-9053-3f63-b833-e08e3d8d370d",
                                        "glosses": [
                                            "gepolstertes Sitzmöbel für mindestens zwei Personen mit Arm- und Rückenlehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931b87bd-241a-40fd-82a7-8423de72c7d2",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "Auf dem Sofa saßen schon meine Tanten."
                                            },
                                            {
                                                "example_id": "5dc09a8a-5459-41d6-b0ee-75bb6f1bb4d6",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "Was ist denn hier passiert? Hier sieht es ja aus wie bei Hempels unterm Sofa!"
                                            },
                                            {
                                                "example_id": "854f359b-22c3-4aa5-b746-e14fd1be1f01",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Vor dem Sofa bleibt Klose stehen und blickt auf den schlafenden Lassehn.“"
                                            },
                                            {
                                                "example_id": "fa14bd5b-da9b-4bcd-9436-29b040aaba0a",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Dem Sofa gegenüber waren ein mit blauem Samt bezogener Zweisitzer und zwei Esszimmerstühle aus Rattan aufgestellt.“"
                                            },
                                            {
                                                "example_id": "6136881f-647e-43dd-93cc-beba2af56a04",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Frau von Carayon kniete neben dem Sofa nieder und sprach ihr zu.“"
                                            },
                                            {
                                                "example_id": "52253d77-f115-4114-86cd-6861fb0e12f4",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Er holte seine Geige aus der Ecke hervor, und als ich mich auf dem Sofa ausgestreckt hatte, begann er eine leise, verträumte Melodie zu spielen, vermutlich seine eigene Erfindung, denn er konnte vozüglich improvisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f7e480b-1f02-4c92-9ce9-35c831d26a3f",
                        "source_entry_id": "94b72198-aee4-3d96-a764-577e36f77b99",
                        "target_lang_word": "sofa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sofa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5317547e-182c-35dc-a343-166d9d3c313e",
                                        "entry_id": "d13017ec-612d-3c67-882c-498fde560922",
                                        "glosses": [
                                            "A raised area of a building's floor, usually covered with carpeting, used for sitting."
                                        ],
                                        "tags": [
                                            "East",
                                            "Middle",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e55e7c3-74b3-3225-89c3-c58bb9590ffc",
                                        "entry_id": "d13017ec-612d-3c67-882c-498fde560922",
                                        "glosses": [
                                            "An upholstered seat with a raised back and one or two raised ends, long enough to comfortably accommodate two or more people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "835befc8-58a4-44f8-b801-925c9b1c6843",
                                                "sense_id": "8e55e7c3-74b3-3225-89c3-c58bb9590ffc",
                                                "text": "He bought a big sofa two days before his relatives arrived."
                                            },
                                            {
                                                "example_id": "de315c75-e8ca-4034-80e1-47ed4b3d4e75",
                                                "sense_id": "8e55e7c3-74b3-3225-89c3-c58bb9590ffc",
                                                "text": "His eyes trailed over her feline pose on the sofa, finding her limbs adorable while he tried exasperatedly to extract the truth of licentious revelations from them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sofa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea01d875-549a-384d-ad1f-47c68a87e269",
                                        "entry_id": "7a29e0ce-7052-306c-a354-e8f0d0d2df22",
                                        "glosses": [
                                            "To furnish with one or more sofas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4c6dec-9ab5-480e-8671-a0fcfd399f5b",
                                                "sense_id": "ea01d875-549a-384d-ad1f-47c68a87e269",
                                                "text": "The appearance of a student's apartment, though by no means splendid, is decidedly comfortable ; it is well cushioned and sofaed, with a proper proportion of arm chairs, and a general air of respectability — much better on the whole than our student's rooms ever are."
                                            },
                                            {
                                                "example_id": "af27a5c0-d160-4a07-a9e2-71d015955c9d",
                                                "sense_id": "ea01d875-549a-384d-ad1f-47c68a87e269",
                                                "text": "First, it will surprize you to learn that instead of the venerable simplicity which reigns in St. Stephen's chapel, the H. of Representatives, besides being stoved, carpeted, desked, and sofaed in the most luxurious style, rivals and indeed surpasses the Legislature of Paris in decoration and drapery."
                                            },
                                            {
                                                "example_id": "ff823e2f-07a8-4516-8dd8-1a1a4c9e8d37",
                                                "sense_id": "ea01d875-549a-384d-ad1f-47c68a87e269",
                                                "text": "I and another therefore entirely occupied our stateroom, which was sofaed round, being just large enough for two to lie down and a third to sit with his feet up and his head on his knees."
                                            },
                                            {
                                                "example_id": "588a744f-e62d-4e53-abc5-1eaf64ddc6b5",
                                                "sense_id": "ea01d875-549a-384d-ad1f-47c68a87e269",
                                                "text": "It was a lavish, fully draped, fully sofaed, fully radiator-covered nineteenth-century deluxe German hotel suite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0444c836-9488-3b87-8828-eaefa647ac17",
                                        "entry_id": "7a29e0ce-7052-306c-a354-e8f0d0d2df22",
                                        "glosses": [
                                            "To seat or lay down on a sofa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab95fc1b-e1e9-4b57-ab17-0c9ba85fb442",
                                                "sense_id": "0444c836-9488-3b87-8828-eaefa647ac17",
                                                "text": "Cliques of three or more are formed, each member of which goes in search of victims, and the first female found complaining of pain in the lower part of her back, is immediately run down, corralled, cornered, so to speak, and sans ceremonie she is at once tabled, sofaed or beded, or in the absence of these relics of refinement she is floored or she may have to submit standing (especially if the doctor is in a hury and meets her at the gate or corner drug store) with an unerring plunge, of a not overly clean index finger, the darksome cavern is penetrated and perhaps, not, a cervix is touched and reveals, of course, a lacerated cervix, just as had been predicted."
                                            },
                                            {
                                                "example_id": "31d64e8d-1c8b-4ec6-8a0c-06ff4ab547bb",
                                                "sense_id": "0444c836-9488-3b87-8828-eaefa647ac17",
                                                "text": "A few, feeble words—my first—to tell you I have left my room this morning and am shaven and shorn and dressed and sofaed in my writing room, after a terrible ten days or more."
                                            },
                                            {
                                                "example_id": "18eb1a8a-fccc-4fa4-a758-0498e62ffcab",
                                                "sense_id": "0444c836-9488-3b87-8828-eaefa647ac17",
                                                "text": "Many a time back in my boozing days when I was sofaed too."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sofa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59f5d7c4-499e-3716-842f-c36fa765b144",
                                        "entry_id": "084f7ba9-b83c-390e-b8f6-c5d3c47ad16c",
                                        "glosses": [
                                            "A slave soldier who served in the army of the Mali Empire."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fa7b24c-b222-4f3c-a5e6-fe8521b0353f",
                                                "sense_id": "59f5d7c4-499e-3716-842f-c36fa765b144",
                                                "text": "1884 Sofas conquer northern Sierra Leone. The sofas were soldiers of Mandinka empire builder, Samori Turay. Falaba, capital of Solima Yalunka kingdom, destroyed in the process."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
