                            {
                                "example_id": "63861f9f-6c92-4587-aeef-be600d856583",
                                "sense_id": "4e3f8f33-9a2e-3d2a-965c-03a321c89372",
                                "text": "Een enorme mensenmassa kwam Tom Boonen uitwuiven voor zijn laatste officiële wedstrijd op Belgische bodem. De ex-wereldkampioen hangt zondag na Parijs-Roubaix immers zijn fiets aan de haak, al is er natuurlijk wel nog het afscheid voor zijn fans op 29 april aan het Zilvermeer van Mol."
                            },
                            {
                                "example_id": "58b2c156-5c22-4a09-837f-186e8bf7668e",
                                "sense_id": "4e3f8f33-9a2e-3d2a-965c-03a321c89372",
                                "text": "Omdat de praatpaal vanaf juli helemaal verdwijnt van de Nederlandse snelwegen, wilde ik hem uitwuiven met zijn ontwerper Chrtien Gerrits, tevens mijn voormalige benedenbuurman."
                            }
                        ]
                    }
