                    {
                        "translation_id": "50cf3c67-8f97-40d8-baab-42443913625e",
                        "source_entry_id": "f73671b6-9309-3d0d-942c-72d2a6dc5a76",
                        "source_sense_id": "b8e440af-96d0-3a80-9382-baa618feedba",
