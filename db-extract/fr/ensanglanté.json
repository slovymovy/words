                    },
                    {
                        "form_id": "0a5a50e2-8837-4d88-81cc-4f99156be959",
                        "entry_id": "13b10da6-0751-3f78-badf-edf7f69bce06",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "ensanglantées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2120c0a9-d122-31d3-b715-d6b940b962b0",
                        "entry_id": "13b10da6-0751-3f78-badf-edf7f69bce06",
                        "glosses": [
                            "Qui est couvert de sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216761b8-bed2-4fa6-953c-62bb9cd5a1bc",
                                "sense_id": "2120c0a9-d122-31d3-b715-d6b940b962b0",
                                "text": "Pendant mille ans nous avons garrotté l’humanité sur les chevalets ensanglantés ; […]."
                            },
                            {
                                "example_id": "d98aabbb-8f55-4369-a58e-66dd8f9d083a",
                                "sense_id": "2120c0a9-d122-31d3-b715-d6b940b962b0",
                                "text": "Ils le laissèrent sur le carreau les quatre fers en l'air, la bouche ensanglantée, gueulant des trucs incompréhensibles, genre poursuites pénales, dommages et intérêts, liberté de la presse, le tout au milieu d'une myriade de projos et de micros, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6105585-3c89-3fd3-b792-81741bc6775a",
                        "entry_id": "13b10da6-0751-3f78-badf-edf7f69bce06",
                        "glosses": [
                            "Qualifie les animaux et membres coupés utilisés comme meuble dans les armoiries et d’où goutte du sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8465c026-7daa-4350-821c-ea4b3d59685d",
                                "sense_id": "f6105585-3c89-3fd3-b792-81741bc6775a",
                                "text": "De gueules au chevron d'or accompagné en chef de deux fleurs de lis d'or et en pointe d'une main ouverte d'argent, posée en pal, le poignet ensanglanté de gueules, qui est de la famille Narbaja de la province d’Alava → voir illustration « main ensanglantée »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92df97cd-ee60-4180-8ecd-109a6bb3b1d8",
                        "source_entry_id": "13b10da6-0751-3f78-badf-edf7f69bce06",
                        "source_sense_id": "2120c0a9-d122-31d3-b715-d6b940b962b0",
                        "source_sense_description": "Qui est couvert de sang",
                        "target_lang_word": "blutig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blutig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0d6cf40-3c1c-3cf1-96bf-15df70520313",
                                        "entry_id": "a162e1e1-9ace-37bb-b3fe-41d72e713dda",
                                        "glosses": [
                                            "mit Blut (verschmutzt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9566888-551f-47bf-9b91-6053a176f695",
                                                "sense_id": "d0d6cf40-3c1c-3cf1-96bf-15df70520313",
                                                "text": "Nach dem Mord wusch er seine blutigen Hände."
                                            },
                                            {
                                                "example_id": "431ff11b-08e6-41f4-9e42-434e49d6e75d",
                                                "sense_id": "d0d6cf40-3c1c-3cf1-96bf-15df70520313",
                                                "text": "„Schwerwiegende Infektionskrankheiten des Magen-Darm-Traktes, die mit blutigen Durchfällen und Fieberschüben einhergingen, waren zu allen Zeiten die gefürchteten Begleiter des Heeres.“"
                                            },
                                            {
                                                "example_id": "f9c0c77d-a26f-4405-b553-6495a6652854",
                                                "sense_id": "d0d6cf40-3c1c-3cf1-96bf-15df70520313",
                                                "text": "„Das ahnungslose Bereitstellen von Freilichtplätzen mit kindergroßen Schachfiguren in zahlreichen Großstadtparks lässt vermuten, dass das Wissen um die einstige blutige Praxis des Adelsspiels verlorengegangen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac44ab84-0f2d-3543-ba6b-6ef0917b43f2",
                                        "entry_id": "a162e1e1-9ace-37bb-b3fe-41d72e713dda",
                                        "glosses": [
                                            "mit vielen Toten / Verletzten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee4c151-bf35-4a09-921f-4905d5fd76f5",
                                                "sense_id": "ac44ab84-0f2d-3543-ba6b-6ef0917b43f2",
                                                "text": "„Das ahnungslose Bereitstellen von Freilichtplätzen mit kindergroßen Schachfiguren in zahlreichen Großstadtparks lässt vermuten, dass das Wissen um die einstige blutige Praxis des Adelsspiels verlorengegangen ist.“"
                                            },
                                            {
                                                "example_id": "e5037050-d7f7-4d1c-b3ee-8829621b55dc",
                                                "sense_id": "ac44ab84-0f2d-3543-ba6b-6ef0917b43f2",
                                                "text": "Es war der blutigste Anschlag der letzten 2 Monate."
                                            },
                                            {
                                                "example_id": "7e81b27e-d603-4e6e-afe9-7097e80cc248",
                                                "sense_id": "ac44ab84-0f2d-3543-ba6b-6ef0917b43f2",
                                                "text": "„Die Schlachten zwischen Österreichern und Italienern zählen zu den blutigsten und sinnlosesten der europäischen Kriegsgeschichte.“"
                                            },
                                            {
                                                "example_id": "4ea7f0ab-b108-48ce-bc8b-64924453a653",
                                                "sense_id": "ac44ab84-0f2d-3543-ba6b-6ef0917b43f2",
                                                "text": "„Die Briten brauchten zwei Jahre, um diesen Aufstand blutig niederzuschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df87ef7e-c353-35a9-9e56-1b5f2f0d915f",
                                        "entry_id": "a162e1e1-9ace-37bb-b3fe-41d72e713dda",
                                        "glosses": [
                                            "im besonderen Maße"
                                        ],
                                        "tags": [
                                            "intensivierend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58c7bd0-c325-445d-85d1-c4b2c5c91f4e",
                                                "sense_id": "df87ef7e-c353-35a9-9e56-1b5f2f0d915f",
                                                "text": "Ich bin ein blutiger Anfänger."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d4c9f0a9-d42c-3ec6-9c3f-6e4147e1efec",
                                        "entry_id": "a162e1e1-9ace-37bb-b3fe-41d72e713dda",
                                        "glosses": [
                                            "nur sehr leicht gekocht, im Kern roh"
                                        ],
                                        "tags": [
                                            "über Fleisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d13716c9-1454-447c-afbd-0608c2abb81b",
                                                "sense_id": "d4c9f0a9-d42c-3ec6-9c3f-6e4147e1efec",
                                                "text": "„Er fand ein Restaurant in einer Seitenstraße und aß ein blutig gebratenes Steak mit Bratkartoffeln und anschließend ein Stück gedeckten Kirschkuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
