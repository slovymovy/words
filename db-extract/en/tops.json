                    {
                        "sense_id": "8a2ca6d3-3877-3f5b-ba5c-6bfd746c68e4",
                        "entry_id": "cd857022-b1c6-3f97-afb2-1c0bda02f75d",
                        "glosses": [
                            "Great; excellent."
                        ],
                        "tags": [
                            "dated",
