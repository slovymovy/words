                                    },
                                    {
                                        "sense_id": "019a8b2f-ca3f-3b16-812e-827c7e2d3dec",
                                        "entry_id": "0efa0bae-6817-39ba-9bef-0778080a510b",
                                        "glosses": [
                                            "Relatif à l’Anjou, ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c022b16-a1d1-4cef-965f-cce4709eb1bb",
                                                "sense_id": "019a8b2f-ca3f-3b16-812e-827c7e2d3dec",
                                                "text": "Personne, dans l’Anjou, n’entendait mieux et ne pouvait prononcer plus nettement le français angevin que le rusé vigneron."
                                            },
                                            {
                                                "example_id": "7a374fc5-b9e6-4b67-b61c-cdedc417839f",
                                                "sense_id": "019a8b2f-ca3f-3b16-812e-827c7e2d3dec",
                                                "text": "« Davantage d’avantages,\nAvantagent d’avantage »\nLui dis-je, quand elle revint\nAvec ses seins angevins…\n(deux fois dix !)\n« Permets donc que je lutine\nCette poitrine angevine… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "593d3a21-cfab-3855-9347-b792390232c9",
                                        "entry_id": "0efa0bae-6817-39ba-9bef-0778080a510b",
                                        "glosses": [
                                            "Relatif à Anjou, ancienne ville québécoise, désormais arrondissement de la ville de Montréal ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
