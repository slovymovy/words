                        "glosses": [
                            "прост. обнажиться или обнажить или часть своего тела"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53080ab-3063-4c74-8b67-d4c7f2497d3e",
                                "sense_id": "4c65ac9d-6be1-39f2-b719-973bb209a449",
                                "text": "Но у ворот усадьбы вдруг ерзнула из шубы, даже заголилась вся, и ноги ее повисли за санями."
                            },
                            {
                                "example_id": "d0eeea3e-c74b-41a8-96ff-8c39cf447e4e",
                                "sense_id": "4c65ac9d-6be1-39f2-b719-973bb209a449",
                                "text": "А если я по пояс заголюсь, вас с ним это не будет смущать?"
                            }
                        ]
                    }
