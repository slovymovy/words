                ],
                "senses": [
                    {
                        "sense_id": "16e0e141-4f04-31a3-926c-16c5631fa6ba",
                        "entry_id": "91db327b-9a81-35b3-a9a7-cb4201ff3b00",
                        "glosses": [
                            "Fromage de la Drôme ou de l’Ardèche au lait de chèvre à pâte molle à croûte naturelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec2b5000-c311-42b2-a300-eb6dfc492a5f",
                                "sense_id": "16e0e141-4f04-31a3-926c-16c5631fa6ba",
                                "text": "Devant mon air surpris, elle m'a expliqué que c'était du chèvre, que c'était très bon et que ça s'appelait du picodon. Le nom m'a fait rire. Nous avons pouffé ensemble."
                            },
                            {
                                "example_id": "b6990473-b00c-46c2-a4c1-a690e3c86403",
                                "sense_id": "16e0e141-4f04-31a3-926c-16c5631fa6ba",
                                "text": "Le picodon est un petit fromage de chèvre, de races alpine chamoisée et saanen."
                            },
                            {
                                "example_id": "ae4a4727-f48d-4cb8-8e75-fcd4f94389d4",
                                "sense_id": "16e0e141-4f04-31a3-926c-16c5631fa6ba",
                                "text": "Le picodon est un fromage au lait cru de chèvre à pâte molle et à croûte naturelle produit dans les Cévennes ardéchoises, dans une partie de la vallée du Rhône et dans les Préalpes drômoises, en France."
                            }
                        ]
                    }
                ],
