        "fr-extract.jsonl": [
            {
                "entry_id": "82338c1c-f03d-3eda-a65f-dcbbbbe376bb",
                "word": "Retourne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e3dde3cf-2d48-3ffd-ac64-75b0139ef6d6",
                        "entry_id": "82338c1c-f03d-3eda-a65f-dcbbbbe376bb",
                        "glosses": [
                            "Rivière tributaire de la rivière Aisne."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "f8a5b07f-f37d-4328-8660-df0f6d017b10",
                                "sense_id": "e3dde3cf-2d48-3ffd-ac64-75b0139ef6d6",
                                "text": "L'autre au contraire s'applique au Châtelet-sur-Retourne, dont la position, naturellement protégée par la rivière de Retourne et autrefois par des marais, a dû recevoir des défenses artificielles longtemps avant que la féodalité y installât le château dont on voit, près d'une motte, les ruines."
                            },
                            {
                                "example_id": "6abbb5d3-98c5-42e0-8aba-56db4b7a07a0",
                                "sense_id": "e3dde3cf-2d48-3ffd-ac64-75b0139ef6d6",
                                "text": "Tous ces villages sont traversés par la rivière la Retourne, qui prend sa source sur le territoire de Leffincourt, canton de Machault. La Retourne traverse le territoire du Châtelet à l'Est et à l'Ouest."
                            },
                            {
                                "example_id": "57b9c51e-9ceb-4488-9f9e-f59c67be19be",
                                "sense_id": "e3dde3cf-2d48-3ffd-ac64-75b0139ef6d6",
                                "text": "Dans l'après-midi, les têtes de colonnes allemandes se présentent pour tenter le passage de la Retourne, appuyées par de l'artillerie en position au sud de Saint-Loup-en-Champagne."
                            },
                            {
                                "example_id": "3dcd0629-506a-42ff-b6a1-8a963f77cb0a",
                                "sense_id": "e3dde3cf-2d48-3ffd-ac64-75b0139ef6d6",
                                "text": "L'artillerie divisionnaire et l'artillerie de corps (au total quatre groupes) sont réparties en surveillance au sud de la Retourne, depuis la voie ferrée jusqu'à Alincourt."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fcb858e7-51f8-39bd-bdf0-347c69ff55ad",
                "word": "retourne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ba02cd87-7a7f-45d5-9709-b01812e1bda1",
                        "entry_id": "fcb858e7-51f8-39bd-bdf0-347c69ff55ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "retournes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "649eee28-b0d7-3509-a1e5-67d5700128e7",
                        "entry_id": "fcb858e7-51f8-39bd-bdf0-347c69ff55ad",
                        "glosses": [
                            "Carte qu’on retourne à certains jeux, à la fin de la distribution, et qui détermine ordinairement l’atout. Dans certains jeux on dit virade."
                        ],
                        "tags": [
                            "Jeu de cartes"
                        ],
                        "examples": [
                            {
                                "example_id": "25a867f2-93a7-4090-af71-e946ed100172",
                                "sense_id": "649eee28-b0d7-3509-a1e5-67d5700128e7",
                                "text": "De quelle couleur est la retourne ?"
                            },
                            {
                                "example_id": "d1d8afaa-5c07-4b4c-acc2-2a308c54971c",
                                "sense_id": "649eee28-b0d7-3509-a1e5-67d5700128e7",
                                "text": "La retourne est de pique, à cœur, est en pique."
                            },
                            {
                                "example_id": "1202d6b5-9969-4ef7-b6f7-d60bfcc66ea1",
                                "sense_id": "649eee28-b0d7-3509-a1e5-67d5700128e7",
                                "text": "La retourne détermine l’atout."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
