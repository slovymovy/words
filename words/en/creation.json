    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12072e57-7e22-36a8-b06c-f199cbbe632d",
                    "sense_definition": "The act of creating something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government announced the <w>creation</w> of new jobs in the technology sector.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило о <w>создании</w> новых рабочих мест в технологическом секторе.",
                                "zh": "政府宣布在科技领域<w>创造</w>了新的就业机会。"
                            }
                        },
                        {
                            "text": "We need to focus on wealth <w>creation</w> to improve the economy.",
                            "target_lang_translations": {
                                "ru": "Нам нужно сосредоточиться на <w>создании</w> богатства для улучшения экономики.",
                                "zh": "我们需要专注于财富的<w>创造</w>以改善经济。"
                            }
                        }
                    ],
                    "synonyms": [
                        "formation",
                        "production",
                        "establishment",
                        "generation",
                        "making"
                    ],
                    "antonyms": [
                        "destruction",
                        "abolition",
                        "elimination"
                    ],
                    "common_phrases": [
                        "job creation",
                        "wealth creation",
                        "creation of value",
                        "creation of new"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по созданию чего-либо",
                        "zh": "创造某事物的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "созидание",
                                "target_lang_sense_clarification": "творческий процесс"
                            },
                            {
                                "target_lang_word": "сотворение",
                                "target_lang_sense_clarification": "возникновение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创造",
                                "target_lang_sense_clarification": "指从无到有或通过努力产生新事物"
                            },
                            {
                                "target_lang_word": "建立",
                                "target_lang_sense_clarification": "指机构、制度或关系的设立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82fa1740-1a5f-3fa7-8f2e-dad640f4526c",
                    "sense_definition": "Something created such as an invention or artwork.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef presented his latest culinary <w>creation</w> to the guests.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар представил гостям своё последнее кулинарное <w>творение</w>.",
                                "zh": "厨师向客人们展示了他最新的烹饪<w>作品</w>。"
                            }
                        },
                        {
                            "text": "She wore a unique fashion <w>creation</w> designed specifically for the event.",
                            "target_lang_translations": {
                                "ru": "На ней было уникальное модное <w>творение</w>, созданное специально для этого мероприятия.",
                                "zh": "她穿了一件专为此次活动设计的独特时尚<w>作品</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "invention",
                        "work",
                        "masterpiece",
                        "product",
                        "concoction"
                    ],
                    "common_phrases": [
