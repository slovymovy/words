                "senses": [
                    {
                        "sense_id": "7f1eaa6e-5237-3df4-8b8f-ce7d9720ceea",
                        "entry_id": "4a514624-f865-3f02-9f6a-3f680ecd3534",
                        "glosses": [
                            "Bedrohung/Verfolgung von Personen, die der Hexerei verdächtigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929d55ce-25be-4557-bbe5-b13232f7d33e",
                                "sense_id": "7f1eaa6e-5237-3df4-8b8f-ce7d9720ceea",
                                "text": "„Was war es, das den Hexenmythos belebte, was aber auch die grauenhaften Hexenverfolgungen ausgelöst hat?“"
                            },
                            {
                                "example_id": "00202a25-2e7e-43ae-a081-4a411f5b35e6",
                                "sense_id": "7f1eaa6e-5237-3df4-8b8f-ce7d9720ceea",
                                "text": "„Vom Erscheinungen des ›Hexenhammers‹ an (1487) rechnet man den Beginn der eigentlichen Hexenverfolgungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b7ad5d9-12b1-4b1c-b5fd-2d721f7a2aef",
                        "source_entry_id": "4a514624-f865-3f02-9f6a-3f680ecd3534",
                        "source_sense_id": "7f1eaa6e-5237-3df4-8b8f-ce7d9720ceea",
                        "source_sense_description": "Bedrohung/Verfolgung von Personen, die der Hexerei verdächtigt werden",
                        "target_lang_word": "witch-hunt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "witch-hunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60025d81-e3c3-340c-a4f5-ef4c9131b24f",
                                        "entry_id": "a3f8f6fc-2345-3814-9edf-6eb77401537a",
                                        "glosses": [
                                            "A search for people believed to be using sorcery or harmful magic, typically in order to persecute or punish them."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "037d3b3e-8752-4752-8cdd-a9ae5e12d0f8",
                                                "sense_id": "60025d81-e3c3-340c-a4f5-ef4c9131b24f",
                                                "text": "To-night ye will see. It is the great witch-hunt, and many will be smelt out as wizards and slain."
                                            },
                                            {
                                                "example_id": "bc61b173-6e80-477b-b393-d42f7a30c372",
                                                "sense_id": "60025d81-e3c3-340c-a4f5-ef4c9131b24f",
                                                "text": "The rupturing of British rule over India in the rebellion of 1857 permitted a great witch-hunt, with lethal effects, to occur among the tribes of northern India."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66e21cb8-7df8-39fe-b480-7b8ced43acc2",
                                        "entry_id": "a3f8f6fc-2345-3814-9edf-6eb77401537a",
                                        "glosses": [
                                            "An attempt to find and punish or harass a group of people perceived as a threat, usually on ideological or political grounds."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b989fb3-2c86-4555-94d1-9d1c5315e504",
                                                "sense_id": "66e21cb8-7df8-39fe-b480-7b8ced43acc2",
                                                "text": "Rank-and-file Communists everywhere are led away on a senseless witch-hunt after 'Trotskyists'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6525406-2a2b-3ee7-a2ba-94a0f47f3316",
                                        "entry_id": "a3f8f6fc-2345-3814-9edf-6eb77401537a",
                                        "glosses": [
                                            "A public or political campaign or investigation which smears a person or group."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "279db058-654f-4b6f-9665-9b3a36998502",
                                                "sense_id": "e6525406-2a2b-3ee7-a2ba-94a0f47f3316",
                                                "text": "Even fewer people could believe that the UNCW administration would actually undertake a witch hunt against me, even going so far as to invoke their right to read my personal e-mails because they were on the university's system."
                                            },
                                            {
                                                "example_id": "259c2dc9-8587-4fff-a382-6b9e9e31fbbc",
                                                "sense_id": "e6525406-2a2b-3ee7-a2ba-94a0f47f3316",
                                                "text": "I defended myself vigorously on that complaint as well; also mentioning that Julie Ann Wilks had always disliked me and had been conducting “a witch hunt” against me. As soon as I said the words “witch hunt” Katy interrupted and wouldn't let me continue […]"
                                            },
                                            {
                                                "example_id": "4729c2ff-4275-43e9-89ed-6dc65dacbf07",
                                                "sense_id": "e6525406-2a2b-3ee7-a2ba-94a0f47f3316",
                                                "text": "The media is really on a witch-hunt against me. False reporting, and plenty of it - but we will prevail!"
                                            },
                                            {
                                                "example_id": "cb5a222b-a420-477a-9135-5f81e8fde506",
                                                "sense_id": "e6525406-2a2b-3ee7-a2ba-94a0f47f3316",
                                                "text": "“It is striking how poorly his usual playbook will work for the Epstein files debacle,” Ford wrote, adding that Trump “cannot credibly claim that he is the victim of some kind of ‘witch hunt,’ even though he is trying to do so.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "witch-hunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6203aa5-7e67-3bbc-b99d-564421342270",
                                        "entry_id": "c0d3aef5-6b60-32e7-9c4e-8283908a1599",
                                        "glosses": [
                                            "To perform a witch-hunt."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb816882-114d-4221-aa78-776e3cf19a15",
                        "source_entry_id": "4a514624-f865-3f02-9f6a-3f680ecd3534",
                        "source_sense_id": "7f1eaa6e-5237-3df4-8b8f-ce7d9720ceea",
                        "source_sense_description": "Bedrohung/Verfolgung von Personen, die der Hexerei verdächtigt werden",
                        "target_lang_word": "witch-hunting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "witch-hunting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec91188a-18e6-3327-907c-d573dc1ebcb9",
                                        "entry_id": "6a50eee2-f88a-3d67-9460-c7d487c74d9a",
                                        "glosses": [
                                            "Engagement in a witch-hunt; searching for witches or for evidence against them."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50259c57-c1b1-4f98-8820-6fe6440e354a",
                                                "sense_id": "ec91188a-18e6-3327-907c-d573dc1ebcb9",
                                                "text": "Witch-hunting has often been prominent both in revolutionary movements which directly opposed and helped to end colonialism or white supremacy, and in the successor states, under native regimes, which emerged out of the former colonies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e7698b-e270-3487-b347-76b20602309a",
                                        "entry_id": "6a50eee2-f88a-3d67-9460-c7d487c74d9a",
                                        "glosses": [
                                            "Engagement in a political witch-hunt; unjust or ideological persecution."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acda10b1-36f7-49da-bfeb-3380f9cee55e",
                                                "sense_id": "d2e7698b-e270-3487-b347-76b20602309a",
                                                "text": "Noble had accused the Rugby Football League of \"an element of witch-hunting\" before accompanying Fielden to his disciplinary hearing, which he admitted was \"disruptive\" in cup final week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
