                                                "example_id": "c3342d17-2aee-478b-bbe2-4c6eaa48f608",
                                                "sense_id": "dc01ca50-dbb2-350c-a56d-42a2a7bea43f",
                                                "text": "„Eine letzte Schraube fixierte mein Kinn.“"
                                            },
                                            {
                                                "example_id": "1034841c-3188-46ae-87ac-5a72c9ba61b9",
                                                "sense_id": "dc01ca50-dbb2-350c-a56d-42a2a7bea43f",
                                                "text": "„Sie keuchten, wenn sie die Schraube anzogen, schöpften den Zucker aus der Bütte, bobachteten die Spundlöcher und amüsierten sich köstlich.“"
                                            }
