                    {
                        "translation_id": "77d8a278-c53e-4ec1-a0af-9ff43c48fb2d",
                        "source_entry_id": "d14f9c35-e6a6-3e31-a1f9-d0eccb257b76",
                        "source_sense_id": "46b74f77-7f31-3f46-b7f5-f5e0f98fe315",
                        "source_sense_description": "scheikundig element met symbool Ti en atoomnummer 22",
                        "target_lang_word": "Titan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Titan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "414357ed-8090-3b46-a0ce-eb9d8a6148ba",
                                        "entry_id": "ddfe78e8-11fc-3ace-a61f-f88ad1eaa348",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 22, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e987bf4-3049-4474-8d5d-1957cbe361b3",
                                                "sense_id": "414357ed-8090-3b46-a0ce-eb9d8a6148ba",
                                                "text": "Titan ist ein hartes und korrosionsbeständiges Metall und das einzige Element, das in einer reinen Stickstoffatmosphäre brennt."
                                            },
                                            {
                                                "example_id": "bb9d65fa-6c40-479e-910a-a612ee4d5867",
                                                "sense_id": "414357ed-8090-3b46-a0ce-eb9d8a6148ba",
                                                "text": "„So lösten die bisher aus Titan hergestellten Hüftgelenke oder Kieferimplantate, im Gegensatz zu Nickel, keinerlei Allergien aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Titan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09d553bd-3a15-3f69-b597-1a89345326e8",
                                        "entry_id": "98e20dbc-a2cb-35f2-b88a-2df51ad91bd9",
                                        "glosses": [
                                            "Gott des ältesten Göttergeschlechts der griechischen Mythologie"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8469a9-ae5f-454c-9018-feba4559f969",
                                                "sense_id": "09d553bd-3a15-3f69-b597-1a89345326e8",
                                                "text": "Kronos war Anführer der Titanen."
                                            },
                                            {
                                                "example_id": "1e99e672-3687-44da-ad33-d3cc25dcd227",
                                                "sense_id": "09d553bd-3a15-3f69-b597-1a89345326e8",
                                                "text": "„Manche Archäologen sind der Ansicht, dass die sogenannten Jupiter-Giganten-Säulen, die den Himmelsgott im Kampf mit den Titanen darstellen, die keltische Stele in römischer Zeit weiterführen, weil sie nur in gallischen Gebieten vorkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "470d1ce3-6385-311a-8dfc-af67407bd203",
                                        "entry_id": "98e20dbc-a2cb-35f2-b88a-2df51ad91bd9",
                                        "glosses": [
                                            "Person mit Fähigkeiten, die weit über das normale Maß hinausgehen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8745efe3-b599-43c7-864f-f36a561cac2c",
                                                "sense_id": "470d1ce3-6385-311a-8dfc-af67407bd203",
                                                "text": "Als Dichter ist er ein Titan."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Titan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "540506df-60b7-3337-8112-2edb5ee6c1db",
                                        "entry_id": "3be056ad-c8dc-3ea4-ad74-5705ed114d36",
                                        "glosses": [
                                            "Mond des Planeten Saturn"
                                        ],
                                        "tags": [],
                                        "examples": [
