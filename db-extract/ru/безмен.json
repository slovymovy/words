                                                "sense_id": "e3f2a076-6312-31d0-8303-41077c45eaf0",
                                                "text": "Le levier d’un peson. Le crochet d’un peson."
                                            },
                                            {
                                                "example_id": "8e3df31c-f974-414a-91c3-f46700f97ec1",
                                                "sense_id": "e3f2a076-6312-31d0-8303-41077c45eaf0",
                                                "text": "Peson à ressort. Peson à contrepoids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d7d5144-f717-3e3a-9e2b-46482de85f0f",
