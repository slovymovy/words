                    {
                        "translation_id": "a2620fb2-0933-48c4-bd50-200b13cb70a0",
                        "source_entry_id": "aea8726b-ee4e-375f-aff1-d1dd68099aca",
                        "source_sense_id": "af56318f-c674-3ca1-b8f0-9c73254a29e0",
                        "target_lang_word": "Krepppapier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krepppapier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                        "entry_id": "43a69dd0-cf3c-337b-b4ea-d3b36658bc87",
                                        "glosses": [
                                            "lockeres, weiches Papier, das zur Erhöhung seiner Elastizität fein und unregelmäßig gefältelt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fddb397-2c28-474c-8701-6e826f251ef9",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„Die dazu bestimmten angefeuchteten Bogen werden in jenen gefalzten Bogen fest eingeschlagen und ein- oder zweimal unter der Presse behandelt, wie solche Bogen, die in Krepppapier verwandelt werden sollen.“"
                                            },
                                            {
                                                "example_id": "91943108-e586-4c5b-8736-a90eb8fe3e98",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„Das Heilzimmer in der Meckelburgwohnung war mangels Tapeten für diesen Anlaß mit Kreppapier ausgeschlagen worden: schwarz mit grünen und roten Streifen, im Katakombenstil.“"
                                            },
                                            {
                                                "example_id": "b3bf31fd-78c4-4e31-bf9a-a9218f23a555",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„Den Schreibmaschinentisch hat die Sekretärin in eine mit blauem Kreppapier geschmückte Theke verwandelt: Rhönbier, Brauner und Weißer.“"
                                            },
                                            {
                                                "example_id": "323575c5-89a1-40ef-be99-832da44a60ef",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„Bekannt wurde sein Produkt unter dem Kürzel Hakle. Damals bestand eine Rolle aus 1000 Blatt rauen Krepppapiers.“"
                                            },
                                            {
                                                "example_id": "70a7cd7a-ec59-4b24-88dd-1073f2c4e967",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„1911 ging es mit Klosett- und Leibwäschepapieren los, schon bald folgte die Produktion von Pergament- und Krepppapieren.“"
                                            },
                                            {
                                                "example_id": "c3829828-5b4d-448f-956d-9794a3208710",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„Noch im Alter erinnerte sich Henri Matisse an die ‚japanischen Krepppapiere‘.“"
                                            },
                                            {
                                                "example_id": "6b30254e-2bdc-4ea4-8983-8c9cf18f1c56",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„Im Häftlingskrankenbau war es besser",
                                                "translation": "etwas Zellstoff“"
                                            },
                                            {
                                                "example_id": "ba9eb8c7-64fe-4456-bfa5-44b3040121aa",
                                                "sense_id": "3a9ec284-8236-34f3-a6a6-9467d7401731",
                                                "text": "„Sie hat sich aus Krepppapier einen Indianerkopfschmuck gebastelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
