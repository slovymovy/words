                        "glosses": [
                            "Reparaturset für aufblasbare Gegenstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3905435-116e-40c3-b5c4-1a2a92655646",
                                "sense_id": "8eaaa17b-3578-31de-b1f9-771163b009eb",
                                "text": "„Zur Behebung kommt beim Fahrrad und Motorrad das Pickzeug (siehe dort) zum Einsatz.“"
                            },
                            {
                                "example_id": "a4e1db06-ca2b-4e92-bb89-a6d4cce564f9",
                                "sense_id": "8eaaa17b-3578-31de-b1f9-771163b009eb",
                                "text": "„Habt ihr eigentlich ein Pickzeug mitgenommen? Meine Luftmatratze hat nämlich ein Loch.“"
                            },
                            {
                                "example_id": "2b5e1ba6-2d30-4ba6-baf7-9b6d6b839ddb",
                                "sense_id": "8eaaa17b-3578-31de-b1f9-771163b009eb",
                                "text": "„Wie sonst beim Fahrradschlauch nahm Rudi sein Pickzeug und klebte das kleine Loch auf dem Bootsrand zu.“"
                            },
                            {
                                "example_id": "07bfebe4-976a-42ec-bf8e-8f1908b4636e",
                                "sense_id": "8eaaa17b-3578-31de-b1f9-771163b009eb",
                                "text": "„‚Vielleicht kann man das Loch kleben? Pickzeug habe ich mit‘, meinte Peter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
