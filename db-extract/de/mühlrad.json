                "senses": [
                    {
                        "sense_id": "36ba998d-7874-3fd7-8d56-053cd76aa03d",
                        "entry_id": "b808d848-6e1a-3827-bb80-4c8c27397754",
                        "glosses": [
                            "radförmige Konstruktion, die Wasserkraft über Wellen und Zahnräder auf eine Mühle überträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f984047-4893-480c-b380-12fd53ce1c7b",
                                "sense_id": "36ba998d-7874-3fd7-8d56-053cd76aa03d",
                                "text": "Das Mühlrad der alten Mühle wurde im letzten Jahr restauriert."
                            },
                            {
                                "example_id": "ef8d8608-bee4-485c-a40c-241cfde458c5",
                                "sense_id": "36ba998d-7874-3fd7-8d56-053cd76aa03d",
                                "text": "„So muss es sich anfühlen, wenn einem ein Mühlrad von den Schultern genommen ist.“"
                            },
                            {
                                "example_id": "cf13d96e-4bd8-4c18-9c26-d7945ade9e0f",
                                "sense_id": "36ba998d-7874-3fd7-8d56-053cd76aa03d",
                                "text": "„Die grüne Hügelkette mit Wald und Wiesen, mit dem Bach, der das Mühlrad trieb, das war der Friede nach stundenlangem Flug über verwüstetes Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
