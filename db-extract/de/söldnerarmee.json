                "senses": [
                    {
                        "sense_id": "c0a8b512-96c8-3e37-bc5e-f7c4a455aba6",
                        "entry_id": "291176d4-6d47-3b35-bcc7-a40d105f8cfa",
                        "glosses": [
                            "Armee aus freiwilligen, zumeist fremdländischen Soldaten, die gegen Bezahlung angeworben und zeitlich (und vertraglich) befristet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44850489-a929-45c9-abf2-9df619dce03a",
                                "sense_id": "c0a8b512-96c8-3e37-bc5e-f7c4a455aba6",
                                "text": "„Die Welt wäre ihm offengestanden; er hätte nach Amerika oder Indien gehen oder sich einer Söldnerarmee anschließen können.“"
                            },
                            {
                                "example_id": "c38517a6-dbe0-4725-b513-95089fcf8c1f",
                                "sense_id": "c0a8b512-96c8-3e37-bc5e-f7c4a455aba6",
                                "text": "„Der Übergang von einer Söldnerarmee zu einem stehenden Heer warf die Frage nach einer Soldatenversorgung auf.“"
                            },
                            {
                                "example_id": "976bdba2-156d-4dec-90b5-3251be79267f",
                                "sense_id": "c0a8b512-96c8-3e37-bc5e-f7c4a455aba6",
                                "text": "„In den 1490er Jahren nahm diese Nähe auch militärische Gestalt an, als Şehinşah Selim anbot, ihm seine Karamaniden als eine Art Söldnerarmee auszuleihen.“"
                            },
                            {
                                "example_id": "5cff5ed4-d4c5-430e-bce5-94dc68d935f3",
                                "sense_id": "c0a8b512-96c8-3e37-bc5e-f7c4a455aba6",
                                "text": "„Die neuartigen Schusswaffen der Söldnerarmee von Hess schlagen tiefe Breschen in die Reihen der Kaisertreuen.“"
                            },
                            {
                                "example_id": "4605318a-ffd1-4920-93e6-5a658c03d380",
                                "sense_id": "c0a8b512-96c8-3e37-bc5e-f7c4a455aba6",
                                "text": "„Angeblich wollte König Erik Holstein mit einer deutschen Söldnerarmee angreifen.“"
                            },
                            {
                                "example_id": "bb5dca38-e71b-419b-8acc-c2f4cd29bfdf",
                                "sense_id": "c0a8b512-96c8-3e37-bc5e-f7c4a455aba6",
                                "text": "„Ihr Vater war jedoch Mitglied einer mächtigen Söldnerarmee aus Schotten und Engländern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
