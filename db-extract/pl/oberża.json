                    {
                        "translation_id": "23235f59-f92d-415d-8dba-6e1f6ce6d06c",
                        "source_entry_id": "3e9c680d-609a-3b2d-9b56-37910da863d0",
                        "source_sense_id": "8b2e252c-ab7e-3c9a-af3c-e559c1dc5d15",
                        "target_lang_word": "Gasthaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gasthaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25aa516e-32b4-3b31-8286-861efd2893d9",
                                        "entry_id": "72ddce3d-e364-3550-a1c8-58da16715c75",
                                        "glosses": [
                                            "Einrichtung, Haus, in dem man als Gast essen, trinken und/oder übernachten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146776b4-40e0-4ffd-95f0-2914ee98e569",
                                                "sense_id": "25aa516e-32b4-3b31-8286-861efd2893d9",
                                                "text": "Das Gasthaus \"Zum Löwen\" ist vor mehr als 100 Jahren erbaut worden."
                                            },
                                            {
                                                "example_id": "56efd341-9810-4e55-88a0-d0893d91938c",
                                                "sense_id": "25aa516e-32b4-3b31-8286-861efd2893d9",
                                                "text": "„Dort drängten sich Gasthäuser, in denen Banden von Prostituierten und Straßenräubern Unterkunft gefunden hatten.“"
                                            },
                                            {
                                                "example_id": "7d922e12-f747-4078-81e2-7b025cbcd749",
                                                "sense_id": "25aa516e-32b4-3b31-8286-861efd2893d9",
                                                "text": "„Das Gasthaus war ein schön saniertes Haus, das im Ortszentrum stand.“"
                                            },
                                            {
                                                "example_id": "0fdea3b2-d02e-4220-94b1-e6bcbd0313ad",
                                                "sense_id": "25aa516e-32b4-3b31-8286-861efd2893d9",
                                                "text": "„Gemeint sind damit natürlich Gasthäuser und Schankwirtschaften.“"
                                            },
                                            {
                                                "example_id": "48fdc370-9e22-4b14-ad03-eaeed9065635",
                                                "sense_id": "25aa516e-32b4-3b31-8286-861efd2893d9",
                                                "text": "„Das Gasthaus ist am frühen Abend geschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
