                "senses": [
                    {
                        "sense_id": "57ca47f6-1e6f-3363-99d6-c267dca59317",
                        "entry_id": "edd86b29-73c7-3c4a-b9f2-8f9f7c180b74",
                        "glosses": [
                            "kleine Kapelle für die Andacht des Gartenbesitzers im Garten, oder für Reisende und Besucher des Gartens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a85b9c7-33bf-4806-983b-c493bd50f6f5",
                                "sense_id": "57ca47f6-1e6f-3363-99d6-c267dca59317",
                                "text": "„Nachdem die Hochschule für Technik Stuttgart das Häuschen, das in der Nachkriegszeit lange als Schafstall diente, vor einem Jahr einer bauhistorischen Untersuchung unterzogen hat und Professor Dr. Peter Schneider zum Schluss gekommen ist, dass es sich dabei ursprünglich wohl um eine Gartenkapelle des Fabrikanten Arnold Staub gehandelt hat (wir berichteten), besprach der Kuchener Arbeitskreis SBI mit dem Landesdenkmalamt, wie man das Gebäude in die Gesamtanlage der ‚Fabrik‘ mit Park und historischer Arbeitersiedlung einbeziehen könnte.“"
                            },
                            {
                                "example_id": "a18266d7-846e-4376-8332-3420b8ec4438",
                                "sense_id": "57ca47f6-1e6f-3363-99d6-c267dca59317",
                                "text": "„Aus dem übriggebliebenen Stamm wurde kurzerhand eine Gartenkapelle gebaut.“"
                            },
                            {
                                "example_id": "42e8bab3-fc27-494c-9578-dd6065b1d329",
                                "sense_id": "57ca47f6-1e6f-3363-99d6-c267dca59317",
                                "text": "„Die Gartenkapelle ist der Grotte des letzten Abendmahls nachempfunden, das Altarbild eine Nachbildung desselben Bildes wie in Jerusalem.“"
                            },
                            {
                                "example_id": "85af43c9-809a-4a1a-901f-e777b1dbf0db",
                                "sense_id": "57ca47f6-1e6f-3363-99d6-c267dca59317",
                                "text": "„Von diesem Gehöft blieben nur einige Mauerzüge und die Gartenkapelle erhalten, die weiter genutzt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
