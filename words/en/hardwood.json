{
    "word_family": [
        "hardwood-floor",
        "softwood"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03fa0c22-0bb5-3460-879c-c4dfd46ff4bd",
                    "sense_definition": "The tough, durable wood from broad-leaved trees, such as oak or maple, used for making furniture and floors.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wood_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to install <w>hardwood</w> floors throughout the entire living room.",
                            "target_lang_translations": {
                                "ru": "Мы решили установить полы из <w>твердой древесины</w> во всей гостиной."
                            }
                        },
                        {
                            "text": "The dining table is made of solid <w>hardwood</w> to ensure it lasts for generations.",
                            "target_lang_translations": {
                                "ru": "Обеденный стол изготовлен из цельной <w>древесины лиственных пород</w>, чтобы он прослужил нескольким поколениям."
                            }
                        }
                    ],
                    "antonyms": [
                        "softwood"
                    ],
                    "common_phrases": [
                        "hardwood floor",
                        "solid hardwood",
                        "polished hardwood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочная и долговечная древесина лиственных пород деревьев, таких как дуб или клен, используемая для изготовления мебели и полов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древесина лиственных пород",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "твердая древесина",
                                "target_lang_sense_clarification": "плотный материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "457fd303-6af8-3f88-9111-43fdd3602fcc",
                    "sense_definition": "The wood from any dicotyledonous tree, regardless of its actual physical hardness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In botanical terms, balsa is classified as a <w>hardwood</w> even though it is very soft.",
                            "target_lang_translations": {
                                "ru": "С ботанической точки зрения бальса классифицируется как <w>лиственная порода</w>, хотя она очень мягкая."
                            }
                        },
                        {
                            "text": "The classification of <w>hardwood</w> depends on the seed structure of the tree species.",
                            "target_lang_translations": {
                                "ru": "Классификация <w>лиственной древесины</w> зависит от структуры семян вида дерева."
                            }
                        }
                    ],
                    "antonyms": [
                        "softwood"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical botanical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесина любого двудольного дерева, независимо от ее фактической физической твердости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лиственная древесина",
                                "target_lang_sense_clarification": "ботаническая классификация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4db62ab-eee0-3b9d-973f-985bc9b34cc5",
                    "sense_definition": "A tree or species of tree that produces hardwood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest is primarily composed of ancient <w>hardwoods</w> like oak and beech.",
                            "target_lang_translations": {
                                "ru": "Лес в основном состоит из древних <w>лиственных деревьев</w>, таких как дуб и бук."
                            }
                        },
                        {
                            "text": "This specific <w>hardwood</w> has been planted extensively throughout the hills to prevent erosion.",
                            "target_lang_translations": {
                                "ru": "Эта конкретная <w>твердолиственная порода</w> была широко высажена на холмах для предотвращения эрозии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deciduous hardwood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дерево или вид дерева, дающий твердую древесину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лиственное дерево",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "твердолиственная порода",
                                "target_lang_sense_clarification": "тип дерева"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89429be5-1b5a-3574-a4e0-5c5fceda6b1a",
                    "sense_definition": "A basketball court, or the sport of basketball itself, referring to the wooden floor of the arena.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The star player returned to the <w>hardwood</w> after a long injury break.",
                            "target_lang_translations": {
                                "ru": "Звездный игрок вернулся на <w>паркет</w> после длительного перерыва из-за травмы."
                            }
                        },
                        {
                            "text": "Legends of the game have spent countless hours practicing on the <w>hardwood</w>.",
                            "target_lang_translations": {
                                "ru": "Легенды игры провели бесчисленные часы, тренируясь на <w>площадке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "court"
                    ],
                    "common_phrases": [
                        "on the hardwood"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports journalism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Баскетбольная площадка или сам баскетбол, в контексте деревянного покрытия арены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паркет",
                                "target_lang_sense_clarification": "баскетбольная площадка"
                            },
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "игровое поле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a9103283-0810-36b0-82bc-eb7f781bcc75",
                    "sense_definition": "Made of or relating to interlocking boards of <w>hardwood</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hardwood</w> surface was polished until it shone like a mirror.",
                            "target_lang_translations": {
                                "ru": "<w>Деревянная</w> поверхность была отполирована до зеркального блеска."
                            }
                        },
                        {
                            "text": "They chose a <w>hardwood</w> finish for the kitchen cabinets to match the floor.",
                            "target_lang_translations": {
                                "ru": "Они выбрали отделку <w>из твердой древесины</w> для кухонных шкафов, чтобы она сочеталась с полом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hardwood finish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из досок твердой древесины или относящийся к ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревянный",
                                "target_lang_sense_clarification": "из твердых пород"
                            },
                            {
                                "target_lang_word": "из лиственных пород",
                                "target_lang_sense_clarification": "материал изделия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}