{
    "word_family": [
        "bunny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d62346a-2d72-3236-8af9-d5088c3d9158",
                    "sense_definition": "A bread roll that is served with a savoury filling such as a hamburger or hot dog.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the grilled hamburger on a fresh <w>bun</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи поджаренный гамбургер на свежую <w>булочку</w>."
                            }
                        },
                        {
                            "text": "The sesame seed <w>bun</w> was toasted perfectly for the sandwich.",
                            "target_lang_translations": {
                                "ru": "<w>Булочка</w> с кунжутом была идеально поджарена для сэндвича."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hamburger bun",
                        "hot dog bun",
                        "sesame seed bun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Булочка, которая подается с несладкой начинкой, например, для гамбургера или хот-дога."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булочка",
                                "target_lang_sense_clarification": "для бургеров или хот-догов"
                            },
                            {
                                "target_lang_word": "булка",
                                "target_lang_sense_clarification": "хлебное изделие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd7caf43-da8b-3d84-b936-c55594b069a2",
                    "sense_definition": "A small bread roll that is sweetened or spiced.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ate a delicious cinnamon <w>bun</w> for breakfast this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня на завтрак мы съели вкусную <w>булочку</w> с корицей."
                            }
                        },
                        {
                            "text": "The bakery sells a sweet <w>bun</w> topped with white icing.",
                            "target_lang_translations": {
                                "ru": "В пекарне продается сладкая <w>плюшка</w>, покрытая белой глазурью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cinnamon bun",
                        "sticky bun",
                        "sweet bun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая сладкая или пряная булочка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булочка",
                                "target_lang_sense_clarification": "сладкая выпечка"
                            },
                            {
                                "target_lang_word": "плюшка",
                                "target_lang_sense_clarification": "сдобное изделие"
                            },
                            {
                                "target_lang_word": "сайка",
                                "target_lang_sense_clarification": "вид белой булки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55ac5188-f30b-3771-9a39-ef0f9d809382",
                    "sense_definition": "A roll of hair worn at the back of the head.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hairstyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tied her long hair into a messy <w>bun</w> before starting her workout.",
                            "target_lang_translations": {
                                "ru": "Перед тренировкой она собрала свои длинные волосы в небрежный <w>пучок</w>."
                            }
                        },
                        {
                            "text": "The ballerina wore a tight <w>bun</w> to keep her hair out of her face.",
                            "target_lang_translations": {
                                "ru": "Балерина сделала тугой <w>узел</w>, чтобы волосы не лезли в лицо."
                            }
                        }
                    ],
                    "synonyms": [
                        "hair bun",
                        "chignon"
                    ],
                    "common_phrases": [
                        "messy bun",
                        "tight bun",
                        "hair bun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прическа в виде собранных на затылке волос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пучок",
                                "target_lang_sense_clarification": "прическа"
                            },
                            {
                                "target_lang_word": "узел",
                                "target_lang_sense_clarification": "из волос"
                            },
                            {
                                "target_lang_word": "шиньон",
                                "target_lang_sense_clarification": "накладной или собранный элемент прически"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "843f6e94-9c53-3004-93e2-f90f3c4d17f3",
                    "sense_definition": "A clipping of <w>bunny</w> (rabbit).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She brought home two new <w>buns</w> to join the menagerie!",
                            "target_lang_translations": {
                                "ru": "Она принесла домой двух новых <w>зайек</w>, чтобы пополнить свой зверинец!"
                            }
                        },
                        {
                            "text": "The little <w>bun</w> hopped across the garden looking for carrots.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>кроля</w> прыгал по саду в поисках морковки."
                            }
                        }
                    ],
                    "synonyms": [
                        "bun-bun"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal pet name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова «кролик» (bunny)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зайка",
                                "target_lang_sense_clarification": "ласковое название кролика"
                            },
                            {
                                "target_lang_word": "кроля",
                                "target_lang_sense_clarification": "разговорное от кролик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ef62c4f-b9a9-35fc-9996-01c5ff420bc3",
                    "sense_definition": "A buttock.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been doing squats to get tight <w>buns</w> for the summer.",
                            "target_lang_translations": {
                                "ru": "Он делал приседания, чтобы подкачать <w>булки</w> к лету."
                            }
                        },
                        {
                            "text": "The athlete showed off his nice <w>buns</w> in the tight cycling shorts.",
                            "target_lang_translations": {
                                "ru": "Атлет продемонстрировал свои отличные <w>ягодицы</w> в облегающих велосипедках."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tight buns",
                        "nice buns"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ягодица."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булки",
                                "target_lang_sense_clarification": "жаргонное обозначение ягодиц"
                            },
                            {
                                "target_lang_word": "ягодицы",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "183eac96-de1f-39c6-b24e-2fbc7cba29c2",
                    "sense_definition": "A marijuana cigarette or joint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrived just as they were about to light the <w>bun</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция прибыла как раз в тот момент, когда они собирались поджечь <w>косяк</w>."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon smoking a <w>bun</w> in the park.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, раскуривая <w>плюшку</w> в парке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сигарета с марихуаной или косяк."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косяк",
                                "target_lang_sense_clarification": "наркотический сленг"
                            },
                            {
                                "target_lang_word": "плюшка",
                                "target_lang_sense_clarification": "кусочек гашиша"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2df87d6f-a47d-324d-9654-d764ac8be8e4",
                    "sense_definition": "To form the hair into a bun.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hairstyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bunning</w> her hair, she left her childhood bedroom for the hall.",
                            "target_lang_translations": {
                                "ru": "<w>Собирая</w> волосы в пучок, она вышла из своей детской спальни в коридор."
                            }
                        },
                        {
                            "text": "She decided to <w>bun</w> her hair because it was too hot outside.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>заколоть</w> волосы, потому что на улице было слишком жарко."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать волосы в пучок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать в пучок",
                                "target_lang_sense_clarification": "о волосах"
                            },
                            {
                                "target_lang_word": "закалывать",
                                "target_lang_sense_clarification": "делать прическу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0e83223-81ed-3ede-a886-715e032298c4",
                    "sense_definition": "To shoot someone with a firearm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lyrics describe how the gang members intend to <w>bun</w> their rivals.",
                            "target_lang_translations": {
                                "ru": "В тексте песни описывается, как члены банды намерены <w>пристрелить</w> своих соперников."
                            }
                        },
                        {
                            "text": "Don't care about your crew, <w>bun</w> them any day.",
                            "target_lang_translations": {
                                "ru": "Плевать на твою банду, <w>шлепну</w> их в любой день."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "street slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Застрелить кого-либо из огнестрельного оружия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристрелить",
                                "target_lang_sense_clarification": "уличный сленг"
                            },
                            {
                                "target_lang_word": "шлепнуть",
                                "target_lang_sense_clarification": "криминальный жаргон"
                            }
                        ]
                    }
                }
            ]
        },
        {
