{
    "word_family": [
        "nucenie",
        "zanucić",
        "podnucić",
        "nucik"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc775dc6-7018-38c0-9d02-665029e4be1f",
                    "sense_definition": "śpiewać cicho, półgłosem lub bez użycia słów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "śpiewanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama cicho <w>nuciła</w> kołysankę swojemu dziecku.",
                            "target_lang_translations": {
                                "ru": "Мама тихо <w>напевала</w> колыбельную своему ребенку."
                            }
                        },
                        {
                            "text": "Podczas pracy często <w>nucę</w> swoją ulubioną melodię.",
                            "target_lang_translations": {
                                "ru": "Во время работы я часто <w>напеваю</w> свою любимую мелодию."
                            }
                        }
                    ],
                    "synonyms": [
                        "podśpiewywać"
                    ],
                    "common_phrases": [
                        "cicho nucić"
                    ],
                    "target_lang_definitions": {
                        "ru": "петь тихо, вполголоса или без слов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напевать",
                                "target_lang_sense_clarification": "петь тихо, часто без слов"
                            },
                            {
                                "target_lang_word": "мурлыкать",
                                "target_lang_sense_clarification": "напевать себе под нос, часто с закрытым ртом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82bd8e68-9426-3835-b494-b1a0c14798a7",
                    "sense_definition": "wydawać melodyjne dźwięki (o ptakach)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "śpiewanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczesnym rankiem ptaki w ogrodzie zaczynają <w>nucić</w> swoje pieśni.",
                            "target_lang_translations": {
                                "ru": "Ранним утром птицы в саду начинают <w>петь</w> свои песни."
                            }
                        },
                        {
                            "text": "Słowik <w>nucił</w> tak pięknie, że wszyscy zatrzymali się, by posłuchać.",
                            "target_lang_translations": {
                                "ru": "Соловей <w>пел</w> так красиво, что все остановились, чтобы послушать."
                            }
                        }
                    ],
                    "synonyms": [
                        "śpiewać",
                        "ćwierkać"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать мелодичные звуки (о птицах)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петь",
                                "target_lang_sense_clarification": "издавать птичьи трели"
                            },
                            {
                                "target_lang_word": "щебетать",
                                "target_lang_sense_clarification": "издавать короткие, звонкие звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bbd8c13-aac7-31a1-88eb-4fd194495d65",
                    "sense_definition": "wydawać monotonny, brzęczący dźwięk (o owadach)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dźwięki owadów",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W upalne popołudnie pszczoły <w>nucą</w> nad kwiatami w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "В жаркий полдень пчелы <w>жужжат</w> над цветами в саду."
                            }
                        },
                        {
                            "text": "W lesie słychać było, jak owady <w>nucą</w> w wysokiej trawie.",
                            "target_lang_translations": {
                                "ru": "В лесу было слышно, как насекомые <w>жужжат</w> в высокой траве."
                            }
                        }
                    ],
                    "synonyms": [
                        "brzęczeć",
                        "bzyczeć"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать монотонный, жужжащий звук (о насекомых)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жужжать",
                                "target_lang_sense_clarification": "издавать характерный звук крыльями"
                            },
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "издавать низкий монотонный звук"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}