                "senses": [
                    {
                        "sense_id": "d95fc24c-8675-39ce-b508-efa247359ae5",
                        "entry_id": "025f4710-34f3-31e6-9f0a-6f6394dd1c37",
                        "glosses": [
                            "Herstellung von etwas Fehlendem oder dringend Gebrauchtem; sich selbst damit versorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8533d04-931f-49e4-9d66-8c9f422d98cb",
                                "sense_id": "d95fc24c-8675-39ce-b508-efa247359ae5",
                                "text": "„Vergleich des Einsatzes der Primärenergieträger und des Verhältnisses der Eigenversorgung und des Importanteils 2002 und 2012 für Deutschland.“"
                            },
                            {
                                "example_id": "14fc3069-3b71-490d-9e24-f89fc1559741",
                                "sense_id": "d95fc24c-8675-39ce-b508-efa247359ae5",
                                "text": "„In einem Interview der \"Neuen Energie\" zeigte sich Herr Dr. Born, scheidender Generalsekretär des Deutschen Bauernverbands, hinsichtlich der Eigenversorgung der Landwirtschaft mit Strom und Kraftstoff sehr zuversichtlich: […]“"
                            },
                            {
                                "example_id": "f2b0a978-6bee-4cff-a88f-0b1a081d4b3e",
                                "sense_id": "d95fc24c-8675-39ce-b508-efa247359ae5",
                                "text": "„Der Autobauer Daimler hat in den vergangenen Jahren gleich an mehreren Standorten eigene Blockheizkraftwerke gebaut. «Mit dem Ausbau der Eigenversorgung möchten wir auch die Versorgungssicherheit des Werkes erhöhen», heißt es in Stuttgart.“"
                            },
                            {
                                "example_id": "9a2a29f2-ec61-4411-8333-7906fffb6146",
                                "sense_id": "d95fc24c-8675-39ce-b508-efa247359ae5",
                                "text": "„Der Begriff der Kundenanlage erleichtert die Eigenversorgung mit Strom z.B. durch ein BHKW.“"
                            },
                            {
                                "example_id": "a982f243-509a-4837-9661-32218c42e096",
                                "sense_id": "d95fc24c-8675-39ce-b508-efa247359ae5",
                                "text": "„Die Bundesregierung puscht die Eigenversorgung jetzt mit einem Förderprogramm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
