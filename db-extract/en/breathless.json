                    {
                        "form_id": "cba8d838-80d3-462d-8294-52ef7c32bab0",
                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most breathless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90d021ff-dc24-39a3-b9d2-685128cd0535",
                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                        "glosses": [
                            "Having difficulty breathing; gasping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f686da41-09ab-4c5d-b340-f47b81842892",
                                "sense_id": "90d021ff-dc24-39a3-b9d2-685128cd0535",
                                "text": "In thoughtless and breathless fear I rushed forward to avoid this host of demons, but while flying thus still more frightful and distorted shapes appeared, and I fancied I felt their hands clutching me."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cde8de3-1eec-3aed-82ca-51631e6c346f",
                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                        "glosses": [
                            "That makes one hold one's breath (with excitement etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac3294c2-71a5-4e7f-a92a-06dbde244a99",
                                "sense_id": "8cde8de3-1eec-3aed-82ca-51631e6c346f",
                                "text": "By that stage Sevilla were down to 10 men and Jorge Sampaoli, their manager, had been sent to the stands as a breathless encounter started to spiral out of control."
                            },
                            {
                                "example_id": "31a3b5f7-997e-41c4-81e3-1df1ca428c08",
                                "sense_id": "8cde8de3-1eec-3aed-82ca-51631e6c346f",
                                "text": "The plane buzzed on at a breathless speed. Bob had been in a plane before, and he had no fear. Indeed, but for the strange circumstances, he would have enjoyed that breathless rush through space."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fbe8287-acfd-325c-ad62-e172bf28d97a",
                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                        "glosses": [
                            "Not breathing; dead or apparently so."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8880934c-eed4-34c3-930f-8db2db224cec",
                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                        "glosses": [
                            "Having no wind; still, calm or airless."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fa36589a-bc7f-358c-b1c1-27616a798b8e",
                        "entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                        "glosses": [
                            "Having a somewhat hysterical tone, using over-emotive language."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b84e389-dbaa-4324-82d4-4c0ffa80406f",
                                "sense_id": "fa36589a-bc7f-358c-b1c1-27616a798b8e",
                                "text": "In breathless prose that risks making Dr Pachauri, who will be 70 this year, a laughing stock among the serious, high-minded scientists,"
                            },
                            {
                                "example_id": "a207bc27-fb51-41af-a786-e1ff4af0859e",
                                "sense_id": "fa36589a-bc7f-358c-b1c1-27616a798b8e",
                                "text": "The more some of us learn, the harder it gets to take each breathless headline seriously."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "355c3425-4582-4b4a-824c-83bde15fd80d",
                        "source_entry_id": "42da2b57-0632-30f7-ac5c-71e7a5f201d7",
                        "source_sense_description": "having difficulty breathing; gasping",
                        "target_lang_word": "atemlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atemlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7c0584-dd3a-3bc9-924c-dbe8ea3c5608",
                                        "entry_id": "f98945b6-346b-33e3-b965-8eec5e88f20d",
                                        "glosses": [
                                            "schwer atmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c81a06-db8a-4e6f-9f16-8f5b97dc8a8c",
                                                "sense_id": "0b7c0584-dd3a-3bc9-924c-dbe8ea3c5608",
                                                "text": "„Der Sonderling lief dem Hut mit Känguruhsprüngen nach, während er atemlos einige Worte hervorstieß, von denen es nicht immer leicht war, den Zusammenhang zu erraten […].“"
                                            },
                                            {
                                                "example_id": "bf3c6f2c-5a26-4515-86b6-f7c15bed7898",
                                                "sense_id": "0b7c0584-dd3a-3bc9-924c-dbe8ea3c5608",
                                                "text": "[Covid-19-Erkrankungen:] „Zahlreiche Patienten sind noch lange nach ihrer Genesung atemlos und müde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c22a5db-984d-3488-8723-246fd217549f",
                                        "entry_id": "f98945b6-346b-33e3-b965-8eec5e88f20d",
                                        "glosses": [
                                            "in schneller Abfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da4a2158-9f89-49f5-b794-cf1c0469fabb",
                                                "sense_id": "7c22a5db-984d-3488-8723-246fd217549f",
                                                "text": "„In einer Zeit, die atemlos SMS und Twitter-Nachrichten versendet, wirken Briefe anachronistisch in ihrer Langsamkeit und Länge.“"
                                            },
                                            {
                                                "example_id": "082f84da-6f52-41f4-8971-f53bc278301c",
                                                "sense_id": "7c22a5db-984d-3488-8723-246fd217549f",
                                                "text": "„Die atemlose Geschwindigkeit des Hollywoodkinos wirkt im Vergleich beinahe wie ein klaustrophobisches Korsett, eine bloße Kulisse, die zusammenbricht, sobald Stillstand eintritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4845b225-bc93-3cf0-a7e0-093cecd34024",
                                        "entry_id": "f98945b6-346b-33e3-b965-8eec5e88f20d",
                                        "glosses": [
                                            "voller Erwartung, Spannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f589e7ca-009d-40c1-b1ce-0bfeecfb08dc",
                                                "sense_id": "4845b225-bc93-3cf0-a7e0-093cecd34024",
                                                "text": "„Aber der Geschichte, die er erzählt, würde man kaum so atemlos zuhören und zusehen, wäre sie nicht zugleich mit jener Sicherheit ins Bild gesetzt, die jede Szene, jede Kamerafahrt, jede Gestik der Personen als fraglos und selbstverständlich erscheinen läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
