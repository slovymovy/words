                                                "sense_id": "73a7ecaa-f966-3790-85fb-49ff2b57985a",
                                                "text": "Wirf das Dingelchen rüber!"
                                            },
                                            {
                                                "example_id": "c0543cd5-41d2-4d8f-a4f0-15e37231e455",
                                                "sense_id": "73a7ecaa-f966-3790-85fb-49ff2b57985a",
                                                "text": "Zu einer Puppenstube gehören jede Menge kleine Dingelchen."
                                            }
