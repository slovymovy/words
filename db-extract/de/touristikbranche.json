                "senses": [
                    {
                        "sense_id": "2b1bc9c9-3589-3d64-8249-d3735757222e",
                        "entry_id": "0f1813d8-8850-3b2f-8fe5-61f452b171d1",
                        "glosses": [
                            "Geschäftszweig, der sich vor allem mit der Vermittlung von Reisen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b321aa-9945-4563-973e-96062834308a",
                                "sense_id": "2b1bc9c9-3589-3d64-8249-d3735757222e",
                                "text": "„Damit wurde die gesamte europäische Touristikbranche innerhalb knapp drei Monaten zum noch nie dagewesenen Stillstand gebracht.“"
                            },
                            {
                                "example_id": "44ee5af5-71b7-4f18-bd3a-08e922cff6d9",
                                "sense_id": "2b1bc9c9-3589-3d64-8249-d3735757222e",
                                "text": "„Mit dem herannahenden Sommer traten die Sorgen der Touristikbranche in den Mittelpunkt.“"
                            },
                            {
                                "example_id": "b6af333b-ee10-4d20-8204-80f9340da0bb",
                                "sense_id": "2b1bc9c9-3589-3d64-8249-d3735757222e",
                                "text": "„Der Einzelhandel, die Musikindustrie, die Touristikbranche und die Medienindustrie durchleben diesen Wandel bereits seit längerem.“"
                            },
                            {
                                "example_id": "7c02b0f3-be44-400c-b129-df0d82c356da",
                                "sense_id": "2b1bc9c9-3589-3d64-8249-d3735757222e",
                                "text": "„Durch den Lockdown der Corona-Pandemie wird die Touristikbranche zusammenbrechen, heißt es in den Medien.“"
                            },
                            {
                                "example_id": "552642ad-e30d-44c0-b489-c215f544477d",
                                "sense_id": "2b1bc9c9-3589-3d64-8249-d3735757222e",
                                "text": "„Im Zuge des enormen Wachstums der letzten Jahrzehnte entwickelte sich die Touristikbranche zu einer zentralen Größe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
