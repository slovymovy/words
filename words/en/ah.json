{
    "word_family": [
        "aha"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "7c3c703b-1842-3857-a658-9f0b2d018b08",
                    "sense_definition": "An expression used to show various emotions such as understanding, relief, surprise, or pleasure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ah</w>, I understand what you mean now.",
                            "target_lang_translations": {
                                "ru": "<w>А</w>, теперь я понимаю, что вы имеете в виду.",
                                "tr": "<w>Ah</w>, ne demek istediğini şimdi anlıyorum."
                            }
                        },
                        {
                            "text": "<w>Ah</w>! It feels so good to finally sit down after a long day.",
                            "target_lang_translations": {
                                "ru": "<w>О</w>! Как же хорошо наконец присесть после долгого дня.",
                                "tr": "<w>Ah</w>! Uzun bir günden sonra nihayet oturmak çok iyi hissettiriyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "oh",
                        "aha"
                    ],
                    "common_phrases": [
                        "ah well",
                        "ah yes",
                        "ah I see"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение, используемое для проявления различных эмоций, таких как понимание, облегчение, удивление или удовольствие.",
                        "tr": "Anlama, rahatlama, şaşkınlık veya zevk gibi çeşitli duyguları ifade etmek için kullanılan bir ünlem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "выражение догадки, понимания или узнавания"
                            },
                            {
                                "target_lang_word": "о",
                                "target_lang_sense_clarification": "выражение удовольствия, облегчения или сильного чувства"
                            },
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "выражение удивления или сожаления"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ah",
                                "target_lang_sense_clarification": "genel duygu ifadesi"
                            },
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "rahatlama veya şaşkınlık ifadesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad31d87a-5175-302d-a720-a696526667c3",
                    "sense_definition": "A sound used to fill space or rhythm, particularly in singing or music.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_filler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chorus of the song is just the singer going <w>ah</w>, <w>ah</w>, <w>ah</w>.",
                            "target_lang_translations": {
                                "ru": "Припев песни — это просто певец, поющий <w>а</w>, <w>а</w>, <w>а</w>.",
                                "tr": "Şarkının nakaratı sadece şarkıcının <w>ah</w>, <w>ah</w>, <w>ah</w> demesinden ibaret."
                            }
                        },
                        {
                            "text": "Everyone joined in to sing the <w>ah</w> part of the melody.",
                            "target_lang_translations": {
                                "ru": "Все присоединились, чтобы спеть партию <w>а</w> в этой мелодии.",
                                "tr": "Herkes melodinin <w>ah</w> kısmını söylemek için katıldı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук, используемый для заполнения паузы или ритма, особенно в пении или музыке.",
                        "tr": "Özellikle şarkı söylerken veya müzikte boşluğu doldurmak ya da ritim sağlamak için kullanılan bir ses."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "вокальный звук"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ah",
                                "target_lang_sense_clarification": "vokal ses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39869ea5-8226-3b60-92bb-89b83f7bf1cf",
                    "sense_definition": "Used to indicate that the speaker has realized something or has been proven right, often with a slightly superior tone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "realization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ah</w>, so you finally admit that I was right all along.",
                            "target_lang_translations": {
                                "ru": "<w>Ага</w>, значит, ты наконец признаешь, что я был прав всё это время.",
                                "tr": "<w>Ah</w>, demek sonunda başından beri haklı olduğumu kabul ediyorsun."
                            }
                        },
                        {
                            "text": "<w>Ah</w>, now I see why you were hiding the letter from me.",
                            "target_lang_translations": {
                                "ru": "<w>А</w>, теперь я вижу, почему ты прятал от меня это письмо.",
                                "tr": "<w>Ah</w>, şimdi mektubu benden neden sakladığını anlıyorum."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на то, что говорящий что-то осознал или оказался прав, часто с оттенком превосходства.",
                        "tr": "Konuşmacının bir şeyi fark ettiğini veya haklı çıktığını belirtmek için kullanılır, genellikle hafif üstten bir tonla."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ага",
                                "target_lang_sense_clarification": "торжествующее подтверждение догадки"
                            },
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "внезапное понимание сути дела"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ha",
                                "target_lang_sense_clarification": "fark etme veya anlama"
                            },
                            {
                                "target_lang_word": "hıh",
                                "target_lang_sense_clarification": "haklı çıkma veya küçümseme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe020c54-f8af-35c5-83c3-72f13184a3fd",
                    "sense_definition": "An instance of the sound or word 'ah', often expressing amazement or delight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_instance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the oohs and <w>ahs</w> of the crowd as the fireworks exploded.",
                            "target_lang_translations": {
                                "ru": "Мы слышали охи и <w>ахи</w> толпы, когда взрывались фейерверки.",
                                "tr": "Havai fişekler patladığında kalabalığın ooh ve <w>ah</w> seslerini duyabiliyorduk."
                            }
                        },
                        {
                            "text": "Her performance received many appreciative <w>ahs</w> from the audience.",
                            "target_lang_translations": {
                                "ru": "Ее выступление вызвало много одобрительных <w>ахов</w> у аудитории.",
                                "tr": "Performansı seyircilerden birçok takdir dolu <w>ah</w> sesi aldı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oohs and ahs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пример звука или слова «ах», часто выражающий изумление или восторг.",
                        "tr": "Genellikle hayranlık veya zevk ifade eden 'ah' sesinin veya kelimesinin bir örneği."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "существительное, обозначающее возглас"
                            },
                            {
                                "target_lang_word": "возглас",
                                "target_lang_sense_clarification": "звук удивления"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ah",
                                "target_lang_sense_clarification": "ünlem olarak kullanılan isim"
                            },
                            {
                                "target_lang_word": "ahlar",
                                "target_lang_sense_clarification": "çoğul kullanım"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ef8e1c1-3de5-3513-9831-6c888817d7e9",
                    "sense_definition": "To make the sound 'ah', usually to express delight, wonder, or agreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests oohed and <w>ahed</w> over the beautiful wedding cake.",
                            "target_lang_translations": {
                                "ru": "Гости охали и <w>ахали</w> над красивым свадебным тортом.",
                                "tr": "Konuklar güzel düğün pastasına bakıp ooh ve <w>ah</w> çektiler."
                            }
                        },
                        {
                            "text": "He <w>ahed</w> in satisfaction after taking a sip of the cold drink.",
                            "target_lang_translations": {
                                "ru": "Он удовлетворенно <w>ахнул</w>, сделав глоток холодного напитка.",
                                "tr": "Soğuk içecekten bir yudum aldıktan sonra memnuniyetle <w>ah</w> çekti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ooh and ah"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать звук «ах», обычно для выражения восторга, удивления или согласия.",
                        "tr": "Genellikle zevk, hayranlık veya onay ifade etmek için 'ah' sesini çıkarmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ахать",
                                "target_lang_sense_clarification": "издавать восклицания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ah çekmek",
                                "target_lang_sense_clarification": "duygusal ses çıkarma"
                            },
                            {
                                "target_lang_word": "ahlamak",
                                "target_lang_sense_clarification": "ünlemleme eylemi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "b4f41230-6b07-3f70-bf3d-8c9744962bd1",
                    "sense_definition": "A representation of the pronoun 'I' reflecting a specific regional pronunciation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pronoun_dialect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Well, <w>ah</w> don't know about that, said the old man from the porch.",
                            "target_lang_translations": {
                                "ru": "Ну, <w>я</w> ничего об этом не знаю, — сказал старик с крыльца.",
                                "tr": "Valla, <w>ben</w> o konuda bir şey bilmiyorum, dedi sundurmadaki yaşlı adam."
                            }
                        },
                        {
                            "text": "If <w>ah</w> ever see him again, I will tell him the truth.",
                            "target_lang_translations": {
                                "ru": "Если <w>я</w> когда-нибудь увижу его снова, я скажу ему правду.",
                                "tr": "Eğer onu tekrar görürsem, <w>ben</w> ona gerçeği söyleyeceğim."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Scottish, Southern US, or AAVE"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант произношения местоимения «я» (I), отражающий специфический региональный акцент.",
                        "tr": "Belirli bir bölgesel telaffuzu yansıtan 'ben' (I) zamirinin bir temsili."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я",
                                "target_lang_sense_clarification": "диалектное произношение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ben",
                                "target_lang_sense_clarification": "standart zamir karşılığı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "df792bc7-7639-31b4-994a-f54a2fe4685c",
                    "sense_definition": "A particle added to the end of a sentence to turn it into a question seeking confirmation or clarification.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "particle_tag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are going to the market later, <w>ah</w>?",
                            "target_lang_translations": {
                                "ru": "Ты пойдешь на рынок позже, <w>а</w>?",
                                "tr": "Daha sonra markete gidiyorsun, <w>değil mi</w>?"
                            }
                        },
                        {
                            "text": "It is very hot outside today, <w>ah</w>?",
                            "target_lang_translations": {
                                "ru": "Сегодня на улице очень жарко, <w>да</w>?",
                                "tr": "Bugün dışarısı çok sıcak, <w>değil mi</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "is it",
                        "izzit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Singapore and Malaysia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица, добавляемая в конец предложения, чтобы превратить его в вопрос, требующий подтверждения или уточнения.",
                        "tr": "Bir cümleyi onay veya açıklama isteyen bir soruya dönüştürmek için cümlenin sonuna eklenen bir parçacık."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "вопросительная частица"
                            },
                            {
                                "target_lang_word": "да",
                                "target_lang_sense_clarification": "запрос подтверждения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değil mi",
                                "target_lang_sense_clarification": "onay alma"
                            },
                            {
                                "target_lang_word": "ha",
                                "target_lang_sense_clarification": "soru eki yerine kullanım"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}