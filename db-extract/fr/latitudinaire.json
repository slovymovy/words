                "entry_id": "131997cf-397b-382e-b02f-f70ca39d9398",
                "word": "latitudinaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c28fea68-cdc7-4078-bcad-d56664d255ee",
                        "entry_id": "131997cf-397b-382e-b02f-f70ca39d9398",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "latitudinaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a2fb90d-e148-344a-b908-4594e8f3ce9f",
                        "entry_id": "131997cf-397b-382e-b02f-f70ca39d9398",
                        "glosses": [
                            "Qui ne suit pas strictement une doctrine religieuse en particulier dans ce qu’elle pourrait avoir de contraignant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd963302-bb4e-43d3-b79b-28cb7bb4c0f4",
                                "sense_id": "7a2fb90d-e148-344a-b908-4594e8f3ce9f",
                                "text": "Voilà un raisonnement qui vous fera frémir, mais vous savez que mon frère est un peu latitudinaire et je parierais que l’Église n’est pas du même sentiment que lui sur ces questions de grâce."
                            },
                            {
                                "example_id": "303de45f-52af-43d4-9ab8-f1c955b12ea7",
                                "sense_id": "7a2fb90d-e148-344a-b908-4594e8f3ce9f",
                                "text": "Cet homme fut John Wesley. Au début de sa vie il avait été, à Oxford, un anglican latitudinaire et qui tenait la foi pour un consentement rationnel."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c7e011d-7a29-3196-9a19-18acc16e7221",
                        "entry_id": "131997cf-397b-382e-b02f-f70ca39d9398",
                        "glosses": [
                            "Qualifie toute personne ou toute opinion, large et complaisante à l’excès."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "00cb9784-956f-4342-b45e-19658f907047",
                                "sense_id": "2c7e011d-7a29-3196-9a19-18acc16e7221",
                                "text": "Des principes latitudinaires."
                            },
                            {
                                "example_id": "a070c1b3-5324-450c-8df8-851243040b55",
                                "sense_id": "2c7e011d-7a29-3196-9a19-18acc16e7221",
                                "text": "Or je ne sais pas quelles sont les secrètes ressources latitudinaires de votre religion, mais vous devez certes mettre votre point d’honneur à ne pas mourir en mauvais état."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d94d240-9318-44e5-863a-6baea68a51c7",
                        "source_entry_id": "131997cf-397b-382e-b02f-f70ca39d9398",
                        "target_lang_word": "latitudinarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latitudinarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c72a9a3c-ecbb-3c7b-9a6c-077ab17895b9",
                                        "entry_id": "18d754b9-dc5d-328e-b5e4-3d77f7f45fc7",
                                        "glosses": [
                                            "Not restrained; not confined by precise limits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95bcd260-3b33-38d0-8d04-973ff73b0e96",
                                        "entry_id": "18d754b9-dc5d-328e-b5e4-3d77f7f45fc7",
                                        "glosses": [
                                            "Tolerant, especially of other people's religious views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1075d8cc-6e92-4c59-ba85-8509c6cc13cf",
                                                "sense_id": "95bcd260-3b33-38d0-8d04-973ff73b0e96",
                                                "text": "’Tis probable, that the Account here given of the Religion of the Natives of Madagascar, may, by Some, be thought a mere Fiction, and inserted with no other View, than to advance some Latitudinarian Principles […]"
                                            },
                                            {
                                                "example_id": "98011726-00ec-49e1-adae-57ddcfe6b899",
                                                "sense_id": "95bcd260-3b33-38d0-8d04-973ff73b0e96",
                                                "text": "1859, S. Austin Allibone, A Critical Dictionary of English Literature, Philadelphia: Childs & Peterson, Volume I, under the entry “Franklin, Benjamin,” p. 630,\nIt is not to be doubted that intimacies with English freethinkers at this period, and with French deists and atheists at a later stage in his life, did much to engender those latitudinarian sentiments upon religious subjects which Franklin is known to have entertained."
                                            },
                                            {
                                                "example_id": "7941c016-f522-4d61-99d5-61625067892a",
                                                "sense_id": "95bcd260-3b33-38d0-8d04-973ff73b0e96",
                                                "text": "[…] their political tactics were to be more closely coordinated with Moscow and their latitudinarian approach to cultural affairs was to be replaced by Zdanov’s uncompromising thesis of the ‘two cultures’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6128fd25-5114-3035-8c6c-b8a52526e750",
                                        "entry_id": "18d754b9-dc5d-328e-b5e4-3d77f7f45fc7",
                                        "glosses": [
                                            "Lax in moral or religious principles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "latitudinarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5adba470-4488-393a-84d7-4d127a29060e",
                                        "entry_id": "7581b402-e8c8-3d4e-8599-9dc7bd372b0c",
                                        "glosses": [
                                            "A person who is tolerant of others' religious views."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
