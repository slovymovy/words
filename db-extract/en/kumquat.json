                    {
                        "translation_id": "93ea1731-338f-41a9-817b-41711188b09f",
                        "source_entry_id": "f94ca008-852e-34fd-b812-3676ad98888b",
                        "source_sense_id": "2b692fbb-db39-38ef-be13-60fd1661ff7d",
