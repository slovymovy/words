                        "entry_id": "fc2045dd-07ec-3766-8a11-e2aad89a6edb",
                        "glosses": [
                            "Not deserving of trust; unreliable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e8ae95-1960-4a64-8d63-892d20d42112",
                                "sense_id": "d794f9ca-4db1-3151-9b51-53aefce8fd42",
                                "text": "While a corrupt Chuch and untrustworthy nobles and kings scraped for power, businessmen in Italy honored pledges of businessmen from England and Scandinavia. This trust (some have called it honor among thieves) is still a hallmark of modern brokerage."
                            }
                        ]
