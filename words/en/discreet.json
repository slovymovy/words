{
    "word_family": [
        "discreetly",
        "discreetness",
        "discretion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2240e661-a53a-3580-b0bd-9bbb25de07e2",
                    "sense_definition": "Respectful of privacy or secrecy and exercising caution to avoid causing embarrassment or offense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_conduct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel staff is trained to be <w>discreet</w> about the identities of their famous guests.",
                            "target_lang_translations": {
                                "ru": "Персонал отеля обучен быть <w>тактичным</w> в отношении личностей своих знаменитых гостей."
                            }
                        },
                        {
                            "text": "She made a <w>discreet</w> inquiry about the job opening without letting her current boss know.",
                            "target_lang_translations": {
                                "ru": "Она навела <w>сдержанные</w> справки о вакансии, не ставя в известность своего нынешнего начальника."
                            }
                        }
                    ],
                    "synonyms": [
                        "tactful",
                        "diplomatic",
                        "prudent",
                        "circumspect"
                    ],
                    "antonyms": [
                        "indiscreet",
                        "tactless",
                        "rash"
                    ],
                    "common_phrases": [
                        "discreet inquiry",
                        "discreet silence",
                        "remain discreet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий уважение к частной жизни или тайне и соблюдающий осторожность, чтобы не вызвать смущения или обиды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тактичный",
                                "target_lang_sense_clarification": "проявляющий чувство меры и уважение к другим"
                            },
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "умеющий хранить секреты и не привлекать лишнего внимания"
                            },
                            {
                                "target_lang_word": "осмотрительный",
                                "target_lang_sense_clarification": "действующий осторожно, чтобы избежать проблем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "555818d4-c949-3513-a1ea-f96ada9dc470",
                    "sense_definition": "Intentionally unobtrusive or inconspicuous so as not to attract attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security cameras were placed in a <w>discreet</w> location where they wouldn't be noticed by customers.",
                            "target_lang_translations": {
                                "ru": "Камеры видеонаблюдения были размещены в <w>незаметном</w> месте, где покупатели их бы не увидели."
                            }
                        },
                        {
                            "text": "He wore a <w>discreet</w> grey suit that allowed him to blend into the crowd easily.",
                            "target_lang_translations": {
                                "ru": "На нем был <w>неброский</w> серый костюм, который позволял ему легко слиться с толпой."
                            }
                        }
                    ],
                    "synonyms": [
                        "inconspicuous",
                        "unobtrusive",
                        "subtle",
                        "low-key"
                    ],
                    "antonyms": [
                        "flashy",
                        "obvious",
                        "conspicuous",
                        "showy"
                    ],
                    "common_phrases": [
                        "discreet distance",
                        "discreet packaging",
                        "discreet logo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно неброский или малозаметный, чтобы не привлекать к себе внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаметный",
                                "target_lang_sense_clarification": "не привлекающий внимания окружающих"
                            },
                            {
                                "target_lang_word": "неброский",
                                "target_lang_sense_clarification": "скромный по виду, не бросающийся в глаза"
                            },
                            {
                                "target_lang_word": "скромный",
                                "target_lang_sense_clarification": "простой и не вызывающий интереса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}