                "senses": [
                    {
                        "sense_id": "2b866610-92dc-34f1-b2b7-f6bb213cd5a0",
                        "entry_id": "90b055a3-aa5c-343f-9f8b-90580fcf0466",
                        "glosses": [
                            "Calèche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c82d1bc-9da3-452a-ad10-20fa7f28c1b1",
                                "sense_id": "2b866610-92dc-34f1-b2b7-f6bb213cd5a0",
                                "text": "Là sont les diverses voitures offertes en location… d’imposantes calèches de famille à huit ressorts, barouches gracieux, lourds landaux, coupés coquets…"
                            },
                            {
                                "example_id": "15a85f59-e507-4ad9-a3f2-6acf6e00b927",
                                "sense_id": "2b866610-92dc-34f1-b2b7-f6bb213cd5a0",
                                "text": "C'est le Piccadilly de cette époque qu'a peint Eugène Lami, ses barouches, ses mails-coachs, ses voyageurs débarquant de la malle de Douvres, en chapeau haut de forme, en ombrelles vertes."
                            }
                        ]
                    }
                ],
