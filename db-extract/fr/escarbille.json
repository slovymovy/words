        "fr-extract.jsonl": [
            {
                "entry_id": "ec6ef442-4544-3b7a-bd7a-2b94f186975a",
                "word": "escarbille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf79fa93-c67b-486c-816a-e5795e4fe28f",
                        "entry_id": "ec6ef442-4544-3b7a-bd7a-2b94f186975a",
                        "tags": [
                            "plural"
                        ],
                        "form": "escarbilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41ccd74e-02f5-33ba-a926-5546b34bb6f4",
                        "entry_id": "ec6ef442-4544-3b7a-bd7a-2b94f186975a",
                        "glosses": [
                            "Morceau de braise incomplètement brûlé et que l’on retrouve dans les fumées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d6fe95a-4142-4586-bca6-24c7948f800c",
                                "sense_id": "41ccd74e-02f5-33ba-a926-5546b34bb6f4",
                                "text": "Des escarbilles sortaient de la cheminée de la locomotive."
                            },
                            {
                                "example_id": "3fc4d1f5-b90d-4053-9d4a-9a8e53bd9ebe",
                                "sense_id": "41ccd74e-02f5-33ba-a926-5546b34bb6f4",
                                "text": "Plus près, entourant la chaire, débordant de la nef sur les bas-côtés, une couche de vieilles filles, noires, dures et biscornues comme des escarbilles, vraiment une charretée de résidus, un dépotoir de boîtes à cendre comme on en voit autour des gares."
                            },
                            {
                                "example_id": "d9edf82c-6c87-4517-91dc-0b59b49efc00",
                                "sense_id": "41ccd74e-02f5-33ba-a926-5546b34bb6f4",
                                "text": "Je ne pensais qu'à cette insolite rue de Tombouctou, qui tourne tout de suite à la gauche d'un pont aux grilles noires encrassées d'escarbilles […]."
                            },
                            {
                                "example_id": "ba01c630-f869-450e-b645-5dda748857ef",
                                "sense_id": "41ccd74e-02f5-33ba-a926-5546b34bb6f4",
                                "text": "Penchée à la portière, j’offrais mon visage au vent et aux escarbilles et je me jurais de ne jamais ressembler aux voyageurs aveuglément entassés dans la chaleur des compartiments."
                            },
                            {
                                "example_id": "0b72b745-b57b-43bb-b78d-b0b4916868bd",
                                "sense_id": "41ccd74e-02f5-33ba-a926-5546b34bb6f4",
                                "text": "Michel-Charles aide galamment Blanchette à sortir de dessous sa paupière une escarbille, à vrai dire invisible, mais qui, dit-elle, lui fait mal."
                            },
                            {
                                "example_id": "076f6c84-b9a2-491b-b756-10f324e39a9f",
                                "sense_id": "41ccd74e-02f5-33ba-a926-5546b34bb6f4",
                                "text": "Une bûche s’écroula dans la cheminée, projetant une volée d’escarbilles. « J’aurais dû acheter un pare-feu… » grommela Houellebecq avant de tremper les lèvres dans son verre d’alcool."
                            }
                        ]
                    },
                    {
                        "sense_id": "897783b5-966e-3369-9fb5-59ab3425c4af",
                        "entry_id": "ec6ef442-4544-3b7a-bd7a-2b94f186975a",
                        "glosses": [
                            "Fraisil ; cendres incomplètement brûlées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cebbb44d-4c23-4f56-b750-41a1a702a944",
                                "sense_id": "897783b5-966e-3369-9fb5-59ab3425c4af",
                                "text": "[…] ; les villages traversés, sans perdre beaucoup de leur rusticité primitive, montrent cependant ces traces noirâtres, ces tas d'escarbilles que crée toujours la consommation fréquente de la houille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed53cd05-2152-44c6-85b5-bf1cfd6b78e5",
                        "source_entry_id": "ec6ef442-4544-3b7a-bd7a-2b94f186975a",
                        "source_sense_description": "Petite braise dans la fumée",
                        "target_lang_word": "grit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db518025-4c65-307a-84c0-4dbcd6faa3a5",
                                        "entry_id": "78cc9aab-fd8a-30ab-8e59-82dbf8618097",
                                        "glosses": [
                                            "A collection of hard small materials, such as dirt, ground stone, debris from sandblasting or other such grinding, or swarf from metalworking."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b5edad-0fd9-4d16-9ac6-274dbe7b929b",
                                                "sense_id": "db518025-4c65-307a-84c0-4dbcd6faa3a5",
                                                "text": "The flower beds were white with grit from sand blasting the flagstone walkways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b6a6679-8816-3a3c-a7dd-1b2fdb855a9c",
                                        "entry_id": "78cc9aab-fd8a-30ab-8e59-82dbf8618097",
                                        "glosses": [
                                            "A collection of hard small materials, such as dirt, ground stone, debris from sandblasting or other such grinding, or swarf from metalworking.",
                                            "Sand or a sand–salt mixture spread on wet and, especially, icy roads and footpaths to improve traction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbef7c42-85e0-3bb6-aa33-af5aa00aeb55",
                                        "entry_id": "78cc9aab-fd8a-30ab-8e59-82dbf8618097",
                                        "glosses": [
                                            "Small, hard, inedible particles in food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b96316-748c-43ac-b298-8edfe604d4fe",
                                                "sense_id": "cbef7c42-85e0-3bb6-aa33-af5aa00aeb55",
                                                "text": "These cookies seem to have grit from nutshells in them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c77b060-acc5-3c2b-9760-72401d27625e",
                                        "entry_id": "78cc9aab-fd8a-30ab-8e59-82dbf8618097",
                                        "glosses": [
                                            "A measure of the size of abrasive grains, such as those on sandpaper, and thus their relative coarseness or fineness; the smaller the number, the coarser the abrasive: thus, 60 is rough, 600 is fine, and 3000 is ultrafine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a70e5dfe-75f0-4114-8203-9570af33d1cc",
                                                "sense_id": "7c77b060-acc5-3c2b-9760-72401d27625e",
                                                "text": "I need a sheet of 100 grit sandpaper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2477edc-a928-355c-bdbe-a78e5a96d3a4",
                                        "entry_id": "78cc9aab-fd8a-30ab-8e59-82dbf8618097",
                                        "glosses": [
                                            "A hard, coarse-grained siliceous sandstone; gritstone. Also, a finer sharp-grained sandstone, e.g., grindstone grit."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66133b1a-8d2f-3f2f-b233-65f672efe4ab",
                                        "entry_id": "78cc9aab-fd8a-30ab-8e59-82dbf8618097",
                                        "glosses": [
                                            "Strength of mind; courage or fearlessness; fortitude."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f0f1aa7-7d58-4805-a447-3407f88ddfaf",
                                                "sense_id": "66133b1a-8d2f-3f2f-b233-65f672efe4ab",
                                                "text": "That kid with the cast on his arm has the grit to play dodgeball."
                                            },
                                            {
                                                "example_id": "15bfd59f-31c0-4d8f-a4f6-9cfce49c616c",
                                                "sense_id": "66133b1a-8d2f-3f2f-b233-65f672efe4ab",
                                                "text": "They came to a rising ground , not sharp , but long ; and here youth and grit and sober living told more than ever."
                                            },
                                            {
                                                "example_id": "a92bbf95-4f4e-41d7-9d6b-81a0c4b6f3d5",
                                                "sense_id": "66133b1a-8d2f-3f2f-b233-65f672efe4ab",
                                                "text": "If you are overcome by a man of grit, he insolently makes you conscious of your own weakness"
                                            },
                                            {
                                                "example_id": "6b6112b0-0a51-40fd-aaa2-5183f14fd523",
                                                "sense_id": "66133b1a-8d2f-3f2f-b233-65f672efe4ab",
                                                "text": "Although working under very unpleasant conditions they never grumbled, and to the end showed continuous grit; and in addition to this several examples of sheer heroism were displayed."
                                            },
                                            {
                                                "example_id": "77ac1ec9-ba2f-4eb1-9452-9bfb738ac1c3",
                                                "sense_id": "66133b1a-8d2f-3f2f-b233-65f672efe4ab",
                                                "text": "But what their admirers call grit and critics deem shamelessness can overshadow another essential element of the Clinton school: a willingness to put on the hair shirt of humility to regain power."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04aca745-7ea2-3275-8d11-5bb1e45eab74",
                                        "entry_id": "c6e71da0-3368-37b5-94e9-fc4ea09ca838",
                                        "glosses": [
                                            "Apparently only in grit one's teeth: to clench, particularly in reaction to pain or anger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3e7481-47ed-4157-bbdc-8ee44ea003d8",
                                                "sense_id": "04aca745-7ea2-3275-8d11-5bb1e45eab74",
                                                "text": "We had no choice but to grit our teeth and get on with it."
                                            },
                                            {
                                                "example_id": "0dc5c1d4-7f49-4e1e-8d07-c973f33987d3",
                                                "sense_id": "04aca745-7ea2-3275-8d11-5bb1e45eab74",
                                                "text": "He has a sleeping disorder and grits his teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e2538f-f32b-3584-a896-5c9019bea166",
                                        "entry_id": "c6e71da0-3368-37b5-94e9-fc4ea09ca838",
                                        "glosses": [
                                            "To cover with grit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "318f683d-2f6b-322c-95e5-a5a47a85dc87",
                                        "entry_id": "c6e71da0-3368-37b5-94e9-fc4ea09ca838",
                                        "glosses": [
                                            "To give forth a grating sound, like sand under the feet; to grate; to grind."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
