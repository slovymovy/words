                "senses": [
                    {
                        "sense_id": "4e5aa363-6993-3ec4-ae12-c04219b9728f",
                        "entry_id": "d6f9d623-842a-3112-920f-891d6c329c05",
                        "glosses": [
                            "Pour une ancre à jas amovible ou mobile, retirer le jas ou l’aligner sur la verge, afin de la ranger plus facilement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "122bcafa-6e8c-4ec4-8c55-dd868227fae8",
                                "sense_id": "4e5aa363-6993-3ec4-ae12-c04219b9728f",
                                "text": "Si la saillie du jas est gênante pour le tir des pièces d'artillerie, on déjale en faisant glisser le jas horizontalement vers l'intérieur et en le laissant engagé dans la culasse par son extrémité, ce qui permet de le ramener en place sans difficulté."
                            }
                        ]
                    }
