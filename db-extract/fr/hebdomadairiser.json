                "senses": [
                    {
                        "sense_id": "ffb3f1cc-440a-3ee7-a750-d4a0fec24b4e",
                        "entry_id": "1cc30cea-12b1-32cf-afe7-03e564548ff6",
                        "glosses": [
                            "Donner un caractère hebdomadaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7e56b9-56f7-494f-bf3d-96879e22236a",
                                "sense_id": "ffb3f1cc-440a-3ee7-a750-d4a0fec24b4e",
                                "text": "Inutile de dire que, pour les journaux, surtout s’ils ont décidé de s’hebdomadairiser, c’est une manne."
                            },
                            {
                                "example_id": "036bac99-7c16-485f-85af-f2f9661abc5f",
                                "sense_id": "ffb3f1cc-440a-3ee7-a750-d4a0fec24b4e",
                                "text": "Mais on ne reproche déjà que trop, non sans raison, au Monde, de s’ « hebdomadairiser »."
                            }
                        ]
                    }
