                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contrainte_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se sentait <w>captive</w> d'un mode de vie qui ne lui convenait plus du tout."
