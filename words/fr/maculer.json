            "pos": "verb",
            "senses": [
                {
                    "sense_id": "afa913a0-b76a-36e6-b330-6e954a8d58e2",
                    "sense_definition": "Couvrir ou salir de taches.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souiller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'encre fraîche a coulé sur la table et a fini par <w>maculer</w> sa belle nappe blanche."
                        },
                        {
                            "text": "Il a fait tomber son stylo, risquant de <w>maculer</w> de taches l'ensemble de ses devoirs scolaires."
                        }
                    ],
                    "synonyms": [
                        "tacher",
                        "souiller",
                        "salir"
                    ],
                    "antonyms": [
                        "nettoyer",
                        "laver"
                    ],
                    "common_phrases": [
                        "maculer de taches",
                        "maculer de sang"
                    ]
                },
                {
                    "sense_id": "c823c9c5-b1de-340d-b1ec-c75ed90a90ed",
                    "sense_definition": "Salir d'encre des feuilles ou des estampes en les frottant ou en les manipulant avant leur séchage complet.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "imprimerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan doit manipuler ces gravures avec précaution afin de ne pas <w>maculer</w> le papier encore humide."
                        },
                        {
                            "text": "Un empilement trop rapide risque de <w>maculer</w> les épreuves qui viennent tout juste d'être imprimées."
                        }
                    ],
                    "common_phrases": [
                        "maculer les épreuves"
                    ]
                },
                {
                    "sense_id": "31e3afde-5c6e-3fc6-9116-082cf5ef3ff7",
                    "sense_definition": "Se salir ou déposer de l'encre fraîche sur d'autres supports par frottement, en parlant de papiers imprimés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "imprimerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faites attention en empilant ces affiches car l'encre n'est pas sèche et elles <w>maculent</w> très facilement."
                        },
                        {
                            "text": "Si l'encre reste trop grasse, les feuilles de journal <w>maculent</w> dès qu'on les prend en main."
                        }
                    ],
                    "synonyms": [
                        "déteindre"
                    ]
                }
            ]
        }
    ]
