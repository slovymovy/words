                "senses": [
                    {
                        "sense_id": "29cac804-3e18-349d-bccc-2f5e018a4b7e",
                        "entry_id": "c778ddb2-f813-3ef3-bcc8-5a6bac24a9a0",
                        "glosses": [
                            "Erziehung/Unterricht mit dem Ziel, zum korrekten/sicheren Verhalten im Verkehr anzuleiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f9e61be-5733-4ee1-b4ae-febd1e83d6ec",
                                "sense_id": "29cac804-3e18-349d-bccc-2f5e018a4b7e",
                                "text": "„Verkehrserziehung ist auch schon bei Heinrich Hoffmann angesagt.“"
                            },
                            {
                                "example_id": "f9f93bc7-8e4e-4e06-93b4-69686f8caaa6",
                                "sense_id": "29cac804-3e18-349d-bccc-2f5e018a4b7e",
                                "text": "„Einen wichtigen Beitrag liefert die Verkehrspsychologie auch im Bereich der Verkehrserziehung.“"
                            },
                            {
                                "example_id": "2985418d-122d-4fa9-9cf2-b3e5b9e41d38",
                                "sense_id": "29cac804-3e18-349d-bccc-2f5e018a4b7e",
                                "text": "„Verkehrserziehung muss mehr leisten als Unfälle zu vermeiden. Sie muss einen Beitrag leisten zur Humanisierung und Persönlichung des Verkehrsumgangs.“"
                            },
                            {
                                "example_id": "37d952b6-17ee-4f38-afa3-b014e7d10259",
                                "sense_id": "29cac804-3e18-349d-bccc-2f5e018a4b7e",
                                "text": "„Wollen Eltern ihre kleinen Kinder zwecks Verkehrserziehung mit dem Fahrrad begleiten, müssen Sie getrennt von ihnen auf der Fahrbahn fahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
