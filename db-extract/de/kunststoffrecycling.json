                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfbc19b5-c697-46fb-b2c4-15e4f2030890",
                                "sense_id": "cb60b1dc-4ac7-3744-8dcf-0f95fcfda636",
                                "text": "„Dem Kunststoffrecycling kommt eine besondere Bedeutung hinsichtlich der Ressourcenschonung, der Verminderung der CO2-Emmissionen und der Energieeffizienz zu.“"
                            },
                            {
                                "example_id": "07806ee1-a942-4735-be4e-0578f74fe31a",
                                "sense_id": "cb60b1dc-4ac7-3744-8dcf-0f95fcfda636",
                                "text": "„In diesem Artikel soll zum ein Überblick über die unterschiedlichen Verfahren des Kunststoffrecyclings gegeben werden.“"
                            },
                            {
                                "example_id": "e747f628-7214-426d-9d18-4e6850d0c3e9",
                                "sense_id": "cb60b1dc-4ac7-3744-8dcf-0f95fcfda636",
                                "text": "„Viele Menschen glauben nicht an Kunststoffrecycling. Denn Kunststoffrecycling ist gar nicht so einfach.“"
                            }
                        ],
