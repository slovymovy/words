                "senses": [
                    {
                        "sense_id": "1c93aa58-aa82-33df-a48f-8eb439506e89",
                        "entry_id": "ddf6f009-79c2-364a-9695-ab01c0207fce",
                        "glosses": [
                            "Doctrine du mouvement d’écologie ou des partis politiques écologistes, visant au respect de l’environnement, sa protection, sa préservation ou sa restauration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b40dc6af-0677-4a5e-89f3-ac81e7d5f774",
                                "sense_id": "1c93aa58-aa82-33df-a48f-8eb439506e89",
                                "text": "L’écologisme a trois préoccupations : la conservation des ressources naturelles, la préservation des écosystèmes naturels et la hantise de la dégradation du milieu de vie."
                            },
                            {
                                "example_id": "a8fea062-63de-494c-bde1-6019ca773bf6",
                                "sense_id": "1c93aa58-aa82-33df-a48f-8eb439506e89",
                                "text": "L’écologisme (ou environnementalisme) est à la fois un courant de pensée, un corpus de valeurs et de propositions incluant notamment celles du mouvement écologiste."
                            }
                        ]
                    }
                ],
                "translations": [
