                                        "examples": [
                                            {
                                                "example_id": "4d441bfc-2d62-44c2-87a4-c738bb7b7047",
                                                "sense_id": "d2d10065-59b8-39d4-b887-47542d8146cc",
                                                "text": "Une nation, une ville, une rue commerçante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b995461d-800a-35c9-93e7-916b24b2b94c",
                                        "entry_id": "3adcd69c-1c6a-3b4a-8bc6-761978e1fc89",
                                        "glosses": [
                                            "Qui a le sens du commerce, qui est doué pour le commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89f325d-de6a-436a-a426-035511ae16ba",
                                                "sense_id": "b995461d-800a-35c9-93e7-916b24b2b94c",
                                                "text": "Ce patron de café n’offre jamais un verre à ses clients, même les plus fidèles. Il n’est pas très commerçant."
                                            }
