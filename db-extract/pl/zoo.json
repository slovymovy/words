                                        "sense_id": "c0a5c0f9-a498-3431-a13f-0931fa255bc3",
                                        "entry_id": "a5026d71-65fc-3271-8b7e-4b7d8f94594e",
                                        "glosses": [
                                            "een instelling die zich bezighoudt met het verzorgen en kweken van exotische diersoorten en het tonen ervan aan betalend publiek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f79581f8-f18e-42af-8849-8b24886d5dcc",
                                                "sense_id": "c0a5c0f9-a498-3431-a13f-0931fa255bc3",
                                                "text": "Blijdorp is de diergaarde van Rotterdam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aada5704-651e-4a4b-92e2-e21e0f1b6405",
                        "source_entry_id": "0883b376-e0ef-39b6-a1ec-e335338cdd23",
                        "source_sense_id": "24006dec-10ce-343f-96a4-a486e372d00a",
                        "target_lang_word": "Zoo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zoo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05ca5a6f-d364-3d38-b4c2-d0db45d7ac34",
                                        "entry_id": "0af544ad-1e62-3b06-a006-fdcdb4674eb1",
                                        "glosses": [
                                            "eine Einrichtung, eine Tierhaltung, die meist wissenschaftlich geleitet ist und welche der Bildung, Forschung, Erholung und dem Artenschutz dient. In der breiten Öffentlichkeit werden aber auch andere Tierhaltungen wie größere Wildgehege und Volierensammlungen als solche verstanden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1da18b5-50b4-4d12-8c6a-0fee7fada201",
                                                "sense_id": "05ca5a6f-d364-3d38-b4c2-d0db45d7ac34",
                                                "text": "Ich gehe heute mit meinen Kindern in den Zoo."
                                            },
                                            {
                                                "example_id": "a4717d31-5bab-45a8-aae8-b9367ca8da60",
                                                "sense_id": "05ca5a6f-d364-3d38-b4c2-d0db45d7ac34",
                                                "text": "„Stundenlanges Beobachten der Tiere im Zoo macht schließlich schwindlig.“"
                                            },
                                            {
                                                "example_id": "5c61522e-003c-4f5c-b7b2-1ccd635f6339",
                                                "sense_id": "05ca5a6f-d364-3d38-b4c2-d0db45d7ac34",
                                                "text": "„Mit diesem Großvater ging man nicht in den Zoo oder in Eisdielen,wie es die Kinder in Deutschland taten.“"
                                            },
                                            {
                                                "example_id": "bf76abb1-e779-4d9e-8e8d-327237d975ae",
                                                "sense_id": "05ca5a6f-d364-3d38-b4c2-d0db45d7ac34",
                                                "text": "„Ich ließ mein Fahrrad am Zoo stehen, ohne es auch nur zu erwähnen.“"
                                            },
                                            {
                                                "example_id": "eb6e9fac-c828-43e9-b4b3-c41691acfdb3",
                                                "sense_id": "05ca5a6f-d364-3d38-b4c2-d0db45d7ac34",
                                                "text": "„Nach dem Tod von Prinz Eugen, der schließlich an einer Lungenentzündung und nicht an einer Kriegsverletzung starb, wurden seine riesige bibliothekarische Sammlung sowie sein gesamter Besitz – unter anderem bestehend aus mehreren Palästen, viel Geld, zahlreichen Kunstwerken, Ländereien und einem gigantischen Zoo mit unzähligen Tieren – seiner Nichte Anna Viktoria vermacht; er hatte nämlich vergessen, ein Testament zu schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d697fdbd-f3e6-42c8-89e3-96636e41540c",
                        "source_entry_id": "0883b376-e0ef-39b6-a1ec-e335338cdd23",
                        "source_sense_id": "24006dec-10ce-343f-96a4-a486e372d00a",
                        "target_lang_word": "зоопа́рк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зоопа́рк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "583ba01e-aa08-36ea-9b20-43ddab072037",
                                        "entry_id": "1be015e7-a23d-3099-942f-de0d3f73e11f",
                                        "glosses": [
                                            "сокр. от зоологический парк; просветительское, природоохранное и научное учреждение, в котором собрана коллекция живых животных различных видов"
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49764250-5163-401d-89ae-22e5688ecd18",
                                                "sense_id": "583ba01e-aa08-36ea-9b20-43ddab072037",
                                                "text": "Я давно мечтал пойти в зоопарк и посмотреть на зверей."
                                            },
                                            {
                                                "example_id": "cb866520-3174-4516-bbf9-b595329e3911",
                                                "sense_id": "583ba01e-aa08-36ea-9b20-43ddab072037",
                                                "text": "И он припомнил, как когда-то, ещё мальчишкой, впервые увидел в зоопарке медведя, вот так же расхаживавшего в своей клетке туда-сюда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39377cd5-e3f2-3691-9d14-f9c4c63ea04d",
                                        "entry_id": "1be015e7-a23d-3099-942f-de0d3f73e11f",
                                        "glosses": [
                                            "перен., неодобр. сборище людей, ведущих себя наподобие животных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd4a7ad9-ac77-49c2-8513-a05d0be88ede",
                                                "sense_id": "39377cd5-e3f2-3691-9d14-f9c4c63ea04d",
                                                "text": "Судя по последним комментам, здесь собрался просто зоопарк, махровый сброд баранов, неизвестно кем и где выращенный."
                                            },
                                            {
                                                "example_id": "ecb77171-bc48-4576-bd58-dd069dd751bc",
                                                "sense_id": "39377cd5-e3f2-3691-9d14-f9c4c63ea04d",
                                                "text": "Российский законодатель никоим образом не оставлен наедине с пугающим зоопарком современной ему исполнительной системы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaa825e7-f4a4-3842-8eb4-6eb89ced80ae",
                                        "entry_id": "1be015e7-a23d-3099-942f-de0d3f73e11f",
                                        "glosses": [
                                            "спец. совокупность различных инструментов, выполняющих одну и ту же задачу и несовместимых друг с другом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f383de-8b5d-42fb-a6ac-cd44ba1522c5",
                                                "sense_id": "eaa825e7-f4a4-3842-8eb4-6eb89ced80ae",
                                                "text": "Зоопарк операционных систем."
                                            },
                                            {
                                                "example_id": "33f0a318-41c7-4d48-91d7-13d38416d192",
                                                "sense_id": "eaa825e7-f4a4-3842-8eb4-6eb89ced80ae",
                                                "text": "Что-то с форматами файлов караоке совсем зоопарк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e687ce15-d97f-3687-977c-33077f1e4391",
                                        "entry_id": "1be015e7-a23d-3099-942f-de0d3f73e11f",
                                        "glosses": [
                                            "комп. информационная система, на которую установлено вредоносное программное обеспечение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec1f8dc-61eb-4ce9-ba13-9c8c63150344",
                                                "sense_id": "e687ce15-d97f-3687-977c-33077f1e4391",
                                                "text": "Совсем в другую категорию входят любители ускорителей, улучшайзеров и любителей «так шоб как в маке, и бесплатна!!!11», но мне кажется у них на компьютере априори зоопарк :)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
