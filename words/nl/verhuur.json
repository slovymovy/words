                        "ru": [
                            {
                                "target_lang_word": "сдаешь",
                                "target_lang_sense_clarification": "в аренду или внаем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19a312ee-7405-3bf0-9b18-dff2c5b981de",
                    "sense_definition": "Gebiedende wijs van <w>verhuren</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verhuur</w> je huis niet zonder goede afspraken.",
                            "target_lang_translations": {
                                "en": "Do not <w>rent out</w> your house without good agreements.",
                                "ru": "Не <w>сдавай</w> свой дом без четких договоренностей."
                            }
                        },
                        {
                            "text": "<w>Verhuur</w> die lege kamer en verdien wat extra geld.",
                            "target_lang_translations": {
                                "en": "<w>Rent out</w> that empty room and earn some extra money.",
                                "ru": "<w>Сдай</w> ту пустую комнату и заработай немного дополнительных денег."
                            }
