                        "glosses": [
                            "Pertaining to aeolotropy; of a body or substance, having physical properties (e.g., electric conductivity, refractive index) that depend on the direction in which they are measured."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ec0ad89-d8c9-47c1-bbeb-c02153bc2015",
                                "sense_id": "0c6b7bf3-1b8c-3dce-9480-2811026a92d9",
                                "text": "An individual body […] may be isotropic in one quality or class of qualities, but æolotropic in others."
                            },
                            {
                                "example_id": "ceda17b3-26ac-4103-9720-4150d2f6e450",
                                "sense_id": "0c6b7bf3-1b8c-3dce-9480-2811026a92d9",
                                "text": "On extending his [Mitscherlich's] inquiry to other aelotropic crystals he observed a similar variation, and was thus led, in 1825, to the discovery that aelotropic crystals, when heated, expand unequally in the direction of dissimilar axes."
                            }
                        ]
                    }
