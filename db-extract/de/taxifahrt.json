                    {
                        "sense_id": "495032ed-d29c-3981-9c90-88af15f5d1d1",
                        "entry_id": "564e04af-58b8-3498-8907-22068d5687ca",
                        "glosses": [
                            "das Zurücklegen einer Wegstrecke mit einem Taxi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f39dea-212a-44c7-b2b5-251551c808a3",
                                "sense_id": "495032ed-d29c-3981-9c90-88af15f5d1d1",
                                "text": "Ich spare mir die teure Taxifahrt und nehme lieber die Straßenbahn."
                            },
                            {
                                "example_id": "e7b42baa-2168-4493-9ad2-312a00f582d6",
                                "sense_id": "495032ed-d29c-3981-9c90-88af15f5d1d1",
                                "text": "„Edgar hat mir diese Taxifahrt nie ganz verziehen.“"
                            },
                            {
                                "example_id": "c1923c5d-5fb7-4c6d-92c2-340b36992b02",
                                "sense_id": "495032ed-d29c-3981-9c90-88af15f5d1d1",
                                "text": "„Es begann mit dem zweiten Flug seines Lebens, gefolgt von einer Taxifahrt vom Flughafen zum Windermere Hotel in Hyde Park (wo er allerdings nur die erste Nacht blieb).“"
                            }
                        ],
