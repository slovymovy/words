                ],
                "senses": [
                    {
                        "sense_id": "c0d21733-48dd-32ef-b557-662bfa1fe3c8",
                        "entry_id": "5f851329-b522-3181-89e3-1ac4c77f7378",
                        "glosses": [
                            "strukturelle (typologische) Eigenschaft, die allen europäischen Sprachen gemeinsam sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271f2835-381a-40f2-b81e-da89f8e40f92",
                                "sense_id": "c0d21733-48dd-32ef-b557-662bfa1fe3c8",
                                "text": "„Das Inventar der Europeme sollte die obigen Anforderungen erfüllen und die Ergebnisse der bisherigen Universalienforschung in Form einer absoluten Quantitfizierung widerspiegeln.“"
                            },
                            {
                                "example_id": "9fca0a4a-9dea-496b-9bd2-b2668b1a6ae4",
                                "sense_id": "c0d21733-48dd-32ef-b557-662bfa1fe3c8",
                                "text": "„Haarmann arbeitet insgesamt 16 Europeme heraus, von denen einige auch Erkenntniswert für unsere Arbeit haben können (…).“"
                            },
                            {
                                "example_id": "c9d69ea7-29a2-40e0-a6bd-703abf03a5e3",
                                "sense_id": "c0d21733-48dd-32ef-b557-662bfa1fe3c8",
                                "text": "„Diese \"Europeme\" sind aber im Grunde nichts anderes als der kleinste gemeinsame Nenner des in den ausgewählten Sprachen Festgestellten.“"
                            },
                            {
                                "example_id": "ba44e5d7-e25d-40d1-8423-3d72e9b2d931",
                                "sense_id": "c0d21733-48dd-32ef-b557-662bfa1fe3c8",
                                "text": "„Zu diesen gesamteuropäischen Merkmalen oder sogenannten Europemen zählen unter anderem das Bestehen bestimmter und unbestimmter Artikel, die morphologische Kennzeichnung des Komparativs, der nominativsprachliche Charakter, der subjektlose Gebrauch von Infinitiven oder die freie Parataxe mit und.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
