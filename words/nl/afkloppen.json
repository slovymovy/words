{
    "word_family": [
        "kloppen",
        "klopper",
        "aankloppen",
        "bekloppen",
        "uitkloppen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f672c05a-878a-3ebe-aad1-0589b3473542",
                    "sense_definition": "door middel van kloppen of slaan stof of vuil verwijderen van kleding of andere voorwerpen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reinigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet je jas goed <w>af</w> te <w>kloppen</w> voordat je de woonkamer binnenstapt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>brush off</w> your coat properly before you step into the living room."
                            }
                        },
                        {
                            "text": "Hij <w>klopte</w> na de lange wandeling het droge zand van zijn broek <w>af</w>.",
                            "target_lang_translations": {
                                "en": "After the long walk, he <w>brushed</w> the dry sand <w>off</w> his trousers."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitkloppen"
                    ],
                    "common_phrases": [
                        "zand afkloppen",
                        "kleding afkloppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove dust or dirt from clothing or other items by beating, brushing, or tapping"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brush off",
                                "target_lang_sense_clarification": "remove dust or dirt by brushing or tapping"
                            },
                            {
                                "target_lang_word": "beat off",
                                "target_lang_sense_clarification": "remove dust by striking or patting"
                            },
                            {
                                "target_lang_word": "dust off",
                                "target_lang_sense_clarification": "clean off loose particles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "959492db-87ec-3655-bb5c-66344b6e935e",
                    "sense_definition": "uit bijgeloof op hout tikken om mogelijk onheil na een optimistische uitspraak af te wenden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bijgeloof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben dit jaar nog niet ziek geweest, maar laten we snel even <w>afkloppen</w>.",
                            "target_lang_translations": {
                                "en": "I haven't been sick yet this year, but let's quickly <w>touch wood</w>."
                            }
                        },
                        {
                            "text": "Hij <w>klopte</w> direct op hout <w>af</w> toen hij zei dat alles volgens plan verliep.",
                            "target_lang_translations": {
                                "en": "He immediately <w>knocked on wood</w> when he said everything was going according to plan."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op hout afkloppen",
                        "even afkloppen"
                    ],
                    "target_lang_definitions": {
                        "en": "to tap on wood out of superstition to ward off bad luck after making an optimistic statement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock on wood",
                                "target_lang_sense_clarification": "primarily US"
                            },
                            {
                                "target_lang_word": "touch wood",
                                "target_lang_sense_clarification": "primarily UK and Commonwealth"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}