                                "target_lang_sense_clarification": "情感表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a16a49-fb25-334c-9527-a16b2ad78897",
                    "sense_definition": "To kill or defeat someone completely.",
                    "learner_level": "C2",
