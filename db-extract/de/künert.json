                ],
                "senses": [
                    {
                        "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                        "entry_id": "d2d87bf4-a6dd-34dc-becd-b6225b50a655",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "292140f1-d07c-4ef3-a26e-875f8f6fc352",
                                "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                                "text": "Frau Künert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1440bf1f-838e-4114-b898-e4f9946f6595",
                                "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                                "text": "Herr Künert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2dc37920-ea1b-49d9-b894-8a4e9934f196",
                                "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                                "text": "Die Künerts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3b937c9f-b2b9-4c4d-be74-e6e9031678e0",
                                "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                                "text": "Der Künert trägt nie die Schals, die die Künert ihm strickt."
                            },
                            {
                                "example_id": "200d92ff-2121-42cf-987b-5ddc96fd2b7c",
                                "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Künert kommt, geht der Herr Künert.“"
                            },
                            {
                                "example_id": "f1904a93-45f0-4ade-839b-c3d12c514d8a",
                                "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                                "text": "Künert kommt und geht."
                            },
                            {
                                "example_id": "110c9ffb-e6d0-419e-bbb7-f5ac4c382186",
                                "sense_id": "c2590576-dec5-30b1-bfc7-827f063b4681",
                                "text": "Künerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
