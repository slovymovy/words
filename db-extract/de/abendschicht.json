                            {
                                "example_id": "57e8f8ae-ceb6-49c5-ad85-99ba20ae7e57",
                                "sense_id": "7b422e50-ba36-382a-a10e-42bc2e5059ae",
                                "text": "„In Finnland protestierten Hafenbeschäftigte während der Morgen- und Abendschicht.“"
                            },
                            {
                                "example_id": "e2cddf44-a5f1-44bc-80f5-ba424b6e5d75",
                                "sense_id": "7b422e50-ba36-382a-a10e-42bc2e5059ae",
                                "text": "„Der Nachmittag geht zu Ende, der Büroarbeitstag ebenfalls. Bald wird die Abendschicht der Barkeeper, Imbissbräter, Tänzerinnen und Prostituierten ihren Dienst antreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
