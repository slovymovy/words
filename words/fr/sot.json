                    "sense_id": "d4ebdfbf-185c-39b9-91cf-baa6a4a99715",
                    "sense_definition": "Qui manque de bon sens, d'intelligence ou de jugement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne suis pas si <w>sot</w> que de croire toutes ses promesses.",
                            "target_lang_translations": {
                                "en": "I'm not so <w>foolish</w> as to believe all his promises.",
                                "ru": "Я не настолько <w>глуп</w>, чтобы верить всем его обещаниям.",
                                "de": "Ich bin nicht so <w>dumm</w>, allen seinen Versprechen zu glauben.",
                                "es": "No soy tan <w>tonto</w> como para creer todas sus promesas.",
                                "zh": "我还没<w>笨</w>到会相信他所有的承诺。"
                            }
                        },
                        {
                            "text": "Cette bête paraît bien <w>sotte</w> quand elle court après sa propre queue.",
                            "target_lang_translations": {
                                "en": "This animal looks very <w>silly</w> when it chases its own tail.",
                                "ru": "Это животное выглядит очень <w>глупым</w>, когда гоняется за собственным хвостом.",
                                "de": "Dieses Tier wirkt ziemlich <w>dumm</w>, wenn es seinem eigenen Schwanz hinterherjagt.",
                                "es": "Este animal parece bastante <w>tonto</w> cuando persigue su propia cola.",
                                "zh": "这只动物追着自己的尾巴转的时候，看起来非常<w>愚蠢</w>。"
                            }
                        }
