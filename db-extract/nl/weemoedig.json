                                        "glosses": [
                                            "zu Wehmut anregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b272f730-5a5b-4d12-b934-88ab01b129bf",
                                                "sense_id": "ab36f7ac-43ae-346a-a834-0a482b4d0cee",
                                                "text": "Er begann dem Instrument einige wehmütige Klänge zu entlocken."
                                            }
