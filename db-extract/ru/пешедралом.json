    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "a36e3ed3-99f9-36a3-998c-4d4449685f0a",
                "word": "пешедралом",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "99944b1a-4219-3d8f-8d0f-2bcbafc6c325",
                        "entry_id": "a36e3ed3-99f9-36a3-998c-4d4449685f0a",
                        "glosses": [
                            "прост. то же, что пешком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c007eabe-4f38-4edd-a2d5-6f8fcf7431a3",
                                "sense_id": "99944b1a-4219-3d8f-8d0f-2bcbafc6c325",
                                "text": "Возница же хлещет кнутом, ему без разницы, едем мы или по своей воле топаем пешедралом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "108c5772-faaf-4727-8693-525aa14f1374",
                        "source_entry_id": "a36e3ed3-99f9-36a3-998c-4d4449685f0a",
                        "source_sense_id": "99944b1a-4219-3d8f-8d0f-2bcbafc6c325",
                        "target_lang_word": "on foot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on foot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68a13ba3-1f55-3843-a2f0-7c3d289adc83",
                                        "entry_id": "a8e591e7-30f5-32a7-a3d2-204973909d1c",
                                        "glosses": [
                                            "On one's feet; walking, jogging or running but not in a vehicle or on the back of an animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e355d4-82fc-4ba7-9d5e-224e8e133732",
                                                "sense_id": "68a13ba3-1f55-3843-a2f0-7c3d289adc83",
                                                "text": "The pub's not far: let's go on foot."
                                            },
                                            {
                                                "example_id": "0dd1056a-4dc4-4d08-bb84-07f74e140c93",
                                                "sense_id": "68a13ba3-1f55-3843-a2f0-7c3d289adc83",
                                                "text": "At the same time, the encroachment of vegetation proceeds apace, and broom and brambles have already made portions of the line impassable, even on foot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8e2add1-61ae-3097-9361-9bbf2a7de121",
                                        "entry_id": "a8e591e7-30f5-32a7-a3d2-204973909d1c",
                                        "glosses": [
                                            "On the move; astir."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34e82013-6ae1-3be0-97c6-6e2bb4096175",
                                        "entry_id": "a8e591e7-30f5-32a7-a3d2-204973909d1c",
                                        "glosses": [
                                            "In progress or in preparation; active, in operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d1d5172-4c91-4ef2-9a01-2917d8799903",
                                                "sense_id": "34e82013-6ae1-3be0-97c6-6e2bb4096175",
                                                "text": "[W]ithin a short time it was generally believed at Naples, that a treaty of marriage was on foot between Zeluco and the young lady in question […]."
                                            },
                                            {
                                                "example_id": "1e75ec81-3773-4d7a-89db-000afadcea38",
                                                "sense_id": "34e82013-6ae1-3be0-97c6-6e2bb4096175",
                                                "text": "‘I didn't know anything of this sort was on foot.’ Brangwen smiled awkwardly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "109d49b4-0a85-456d-89b2-5ef3ce021b86",
                        "source_entry_id": "a36e3ed3-99f9-36a3-998c-4d4449685f0a",
                        "source_sense_id": "99944b1a-4219-3d8f-8d0f-2bcbafc6c325",
                        "target_lang_word": "afoot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afoot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d0a73af-1bc3-3a12-a1cf-b82c9a891d9d",
                                        "entry_id": "07efc022-74e1-387e-8d18-72f460de6eaa",
                                        "glosses": [
                                            "On foot. (means of locomotion, walking)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b42150-1e71-4e2e-bfe3-d89ac707938a",
                                                "sense_id": "4d0a73af-1bc3-3a12-a1cf-b82c9a891d9d",
                                                "text": "Is it fit, let your mightyship say, / That I, like some pitiful flirt, / Should tarry within doors all day, / Or else trudge it afoot in the dirt?"
                                            },
                                            {
                                                "example_id": "6718e852-1094-4aa0-bbc2-838b3dff32fd",
                                                "sense_id": "4d0a73af-1bc3-3a12-a1cf-b82c9a891d9d",
                                                "text": "\"The dogs were no sooner let loose, than the hare was afoot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63112a93-c7d0-398c-8b38-483bf68b27eb",
                                        "entry_id": "07efc022-74e1-387e-8d18-72f460de6eaa",
                                        "glosses": [
                                            "On foot. (support of the body, standing)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "faa74ea2-bf8d-3c3c-84af-ed2063ca2b5b",
                                        "entry_id": "07efc022-74e1-387e-8d18-72f460de6eaa",
                                        "glosses": [
                                            "In motion; in action; astir; stirring; in progress."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6dc496e-bb51-4cee-89ee-bb472febb4e9",
                                                "sense_id": "faa74ea2-bf8d-3c3c-84af-ed2063ca2b5b",
                                                "text": "Hamlet: […]I prithee, when thou seest that act afoot, / Even with the very comment of thy soul / Observe mine uncle:[…]"
                                            },
                                            {
                                                "example_id": "cbb82a41-1629-41f2-a4a3-4c4cf2dcf45d",
                                                "sense_id": "faa74ea2-bf8d-3c3c-84af-ed2063ca2b5b",
                                                "text": "Possibly some chemical experiment was afoot; possibly----Well, it was no business of mine to speculate upon why he wanted it."
                                            },
                                            {
                                                "example_id": "bc4fd1ad-f296-4b57-8f4e-20ca8b05a6fc",
                                                "sense_id": "faa74ea2-bf8d-3c3c-84af-ed2063ca2b5b",
                                                "text": "In San Francisco and in New Jersey, to quote two other examples, plans are afoot to subsidise new commuter line construction or existing operations out of toll revenue from state highways or bridges."
                                            },
                                            {
                                                "example_id": "9d5239c5-e287-490b-a4a1-da3e4a8c4cd5",
                                                "sense_id": "faa74ea2-bf8d-3c3c-84af-ed2063ca2b5b",
                                                "text": "‘Patience,’ said Slartibartfast again. ‘Great things are afoot.’¶ ‘That's what you said last time we met,’ said Arthur.¶ ‘They were,’ said Slartibartfast.¶ ‘Yes, that's true,’ admitted Arthur.¶ All, however, that seemed to be afoot was a ceremony of some kind."
                                            },
                                            {
                                                "example_id": "7c8dc47c-ab78-4e9d-971a-db8daed6c3e5",
                                                "sense_id": "faa74ea2-bf8d-3c3c-84af-ed2063ca2b5b",
                                                "text": "“Has anyone seen Laszlo? I can't find him anywhere. And it's really not like him.” “Oh... Laszlo's missing, eh?” “Yeah.” “Mm, the game is afoot.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afoot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbc34706-2cc1-3c84-8c7f-d409ae8bdbcb",
                                        "entry_id": "f14d7979-8e7d-3af1-ba4f-5211961552a0",
                                        "glosses": [
                                            "That is on foot, in motion, in action, in progress."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b42294-de26-4721-b9f5-8890d589c855",
                                                "sense_id": "fbc34706-2cc1-3c84-8c7f-d409ae8bdbcb",
                                                "text": "Sunny moves through these final days quickly, easily, buoyed by routine even though change is afoot in all directions."
                                            },
                                            {
                                                "example_id": "1790b326-cc8f-4f90-afef-348e8cad10e0",
                                                "sense_id": "fbc34706-2cc1-3c84-8c7f-d409ae8bdbcb",
                                                "text": "Now there are plans afoot to introduce a couple of extra trains to the timetable in December, with the long-term goal of a doubling of the service to eight trains a day."
                                            },
                                            {
                                                "example_id": "15fa9c0c-6753-4ff6-8436-df890a5e952d",
                                                "sense_id": "fbc34706-2cc1-3c84-8c7f-d409ae8bdbcb",
                                                "text": "“These poor exocomps are being tortured with meaningless, repetitive tasks. I knew there was foul play afoot.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
