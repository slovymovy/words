                        "examples": [
                            {
                                "example_id": "14910c86-1f90-4f16-8cbb-fe21d8a054ec",
                                "sense_id": "6f3cbc4f-9eec-3b08-8c22-5b58aafc7c6e",
                                "text": "„Vor diesem Paradigmenwechsel hatten die Deutschen sehr wohl darüber geklagt, wie sehr sie im Krieg, in der Gefangenschaft und während der Nachkriegsarmut gelitten hätten.“"
                            },
                            {
                                "example_id": "f9c559ae-c613-4191-9fbf-8f824bb15b35",
                                "sense_id": "6f3cbc4f-9eec-3b08-8c22-5b58aafc7c6e",
                                "text": "„Einen Paradigmenwechsel hatte auch die Zeit der Aufklärung nicht vollbringen können.“"
                            }
                        ],
