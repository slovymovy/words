                                                "sense_id": "71aa745c-92e8-3ff5-95c0-7ea0e5e20a5d",
                                                "text": "The old seadog knew the storm was coming long before the rest of the crew were aware of it."
                                            },
                                            {
                                                "example_id": "fbcaf745-ce4e-48cb-9b71-63cb8c7a60d1",
                                                "sense_id": "71aa745c-92e8-3ff5-95c0-7ea0e5e20a5d",
                                                "text": "The two admiral-ambassadors were themselves two worlds apart. Kirk, now deceased, remained very much a seadog in both speech and mannerism. He was curt and seldom smiled, while Wright, a bit hard of hearing, was always courteous."
                                            }
                                        ]
