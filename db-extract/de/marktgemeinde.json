                    {
                        "sense_id": "9cd2c345-7bb7-307b-8f2c-79a113a7a5cf",
                        "entry_id": "5cfbea01-ac31-3b8f-98ed-3b2d8610023f",
                        "glosses": [
                            "Gemeinde mit dem Recht, einen Markt abhalten zu dürfen, (meist) nur noch mit einem Namenszusatz in Bayern und Österreich"
                        ],
                        "tags": [
                            "früher",
                            "heute"
                        ],
                        "examples": [
                            {
                                "example_id": "c2d0eb0d-ea65-4b20-8897-e23f450f8281",
                                "sense_id": "9cd2c345-7bb7-307b-8f2c-79a113a7a5cf",
                                "text": "Was unterscheidet eine Marktgemeinde von einem Marktflecken?"
                            },
                            {
                                "example_id": "6b1be7ed-e3e6-40a5-b721-d16ecd6482b2",
                                "sense_id": "9cd2c345-7bb7-307b-8f2c-79a113a7a5cf",
                                "text": "„Obwohl die Marktgemeinde bereits eine breit gefächerte Palette von familienorientierten Maßnahmen anbietet, wird ständig an weiteren Verbesserungen für Familien mit Kindern gearbeitet.“"
                            }
                        ],
