                            }
                        },
                        {
                            "text": "They distributed a fair portion to <w>eatche</w> according to his individual need.",
                            "target_lang_translations": {
                                "ru": "Они выделили справедливую долю <w>каждому</w> в соответствии с его индивидуальными потребностями."
