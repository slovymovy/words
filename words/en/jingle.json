{
    "word_family": [
        "jingler",
        "jingling",
        "jingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a0fb327-44b2-3c8e-a8c1-544542a775f0",
                    "sense_definition": "A memorable short song or tune used in advertising to promote a product or service.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "advertising_tune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That radio station's catchy <w>jingle</w> has been stuck in my head all morning.",
                            "target_lang_translations": {
                                "ru": "Этот приставучий рекламный <w>джингл</w> радиостанции крутится у меня в голове все утро."
                            }
                        },
                        {
                            "text": "The company hired a famous musician to write an advertising <w>jingle</w> for their new product.",
                            "target_lang_translations": {
                                "ru": "Компания наняла известного музыканта, чтобы написать рекламную <w>мелодию</w> для их нового продукта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "advertising jingle",
                        "catchy jingle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запоминающаяся короткая песня или мелодия, используемая в рекламе для продвижения товара или услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джингл",
                                "target_lang_sense_clarification": "рекламный музыкальный ролик"
                            },
                            {
                                "target_lang_word": "рекламная мелодия",
                                "target_lang_sense_clarification": "короткий музыкальный фрагмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01ab36bc-444d-3df1-abb3-a7f268ae68cd",
                    "sense_definition": "The light, ringing sound of metal or glass clattering against itself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metallic_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He heard the familiar <w>jingle</w> of keys in the door and knew his roommate was home.",
                            "target_lang_translations": {
                                "ru": "Он услышал знакомое <w>звяканье</w> ключей в двери и понял, что его сосед по комнате дома."
                            }
                        },
                        {
                            "text": "The quiet room was filled with the soft <w>jingle</w> of coins in his pocket.",
                            "target_lang_translations": {
                                "ru": "Тихая комната наполнилась тихим <w>бренчанием</w> монет в его кармане."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinkle",
                        "ring"
                    ],
                    "common_phrases": [
                        "jingle of keys",
                        "jingle of coins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий звенящий звук соприкасающихся металлических или стеклянных предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "металлический или стеклянный"
                            },
                            {
                                "target_lang_word": "звяканье",
                                "target_lang_sense_clarification": "легкий отрывистый звук"
                            },
                            {
                                "target_lang_word": "бренчание",
                                "target_lang_sense_clarification": "звук монет или ключей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3613cba1-75c3-3b0b-b312-e607f181fe0d",
                    "sense_definition": "A small piece of metal attached to a musical instrument, such as a tambourine, that makes a jangling sound when played.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "instrument_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She shook the tambourine, but one metal <w>jingle</w> was loose and did not ring properly.",
                            "target_lang_translations": {
                                "ru": "Она потрясла тамбурин, но одна металлическая <w>тарелочка</w> разболталась и не звенела как надо."
                            }
                        },
                        {
                            "text": "The dancer wore ankle bracelets with small brass <w>jingles</w> that sounded with every step.",
                            "target_lang_translations": {
                                "ru": "На танцовщице были браслеты на щиколотках с маленькими латунными <w>бубенцами</w>, которые звенели при каждом шаге."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая металлическая пластинка или бубенец на музыкальном инструменте (например, на бубне), издающие звенящий звук при игре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бубенец",
                                "target_lang_sense_clarification": "маленький колокольчик"
                            },
                            {
                                "target_lang_word": "тарелочка",
                                "target_lang_sense_clarification": "металлическая деталь тамбурина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c72e35b7-f080-390e-85a1-daba8e780778",
                    "sense_definition": "A brief telephone call.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "phone_call",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give me a <w>jingle</w> when you find out what time the meeting starts.",
                            "target_lang_translations": {
                                "ru": "Сделай мне <w>звонок</w>, когда узнаешь, во сколько начинается собрание."
                            }
                        },
                        {
                            "text": "I will give you a quick <w>jingle</w> tomorrow morning to confirm our plans.",
                            "target_lang_translations": {
                                "ru": "Я быстро <w>наберу</w> тебя завтра утром, чтобы подтвердить наши планы."
                            }
                        }
                    ],
                    "synonyms": [
                        "ring",
                        "bell"
                    ],
                    "common_phrases": [
                        "give a jingle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to mean a phone call"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий телефонный звонок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонок",
                                "target_lang_sense_clarification": "телефонный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b0ce120-de1b-3d9b-89bf-8296d4922394",
                    "sense_definition": "Coin money; cash.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had plenty of paper bills but not much <w>jingle</w> left in his pockets.",
                            "target_lang_translations": {
                                "ru": "У него было много бумажных купюр, но в карманах почти не осталось <w>мелочи</w>."
                            }
                        },
                        {
                            "text": "They asked everyone to donate whatever spare <w>jingle</w> they could afford.",
                            "target_lang_translations": {
                                "ru": "Они попросили всех пожертвовать любую лишнюю <w>звонкую монету</w>, которую они могли себе позволить."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Slang term for coins or money"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелочь, монеты; наличные деньги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелочь",
                                "target_lang_sense_clarification": "монеты в кармане"
                            },
                            {
                                "target_lang_word": "звонкая монета",
                                "target_lang_sense_clarification": "металлические деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cf72493-2578-3d26-9ceb-b82896c34c77",
                    "sense_definition": "A light, two-wheeled horse-drawn carriage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They traveled in a traditional <w>jingle</w> along the bumpy roads of southern Ireland.",
                            "target_lang_translations": {
                                "ru": "Они путешествовали в традиционной <w>двуколке</w> по ухабистым дорогам южной Ирландии."
                            }
                        },
                        {
                            "text": "The old horse pulled the wooden <w>jingle</w> through the narrow streets of the town.",
                            "target_lang_translations": {
                                "ru": "Старая лошадь тащила деревянную <w>повозку</w> по узким улицам городка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Historically used in Ireland"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Refers to an obsolete mode of transport"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий двухколесный экипаж, запряженный лошадью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двуколка",
                                "target_lang_sense_clarification": "легкий двухколесный экипаж"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f72db365-1445-3a7e-b192-5c0f46c7fc34",
                    "sense_definition": "To make a light, ringing sound of metal or glass clattering against itself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "make_metallic_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal keys <w>jingled</w> in his pocket as he ran down the stairs.",
                            "target_lang_translations": {
                                "ru": "Металлические ключи <w>звенели</w> в его кармане, когда он сбегал по лестнице."
                            }
                        },
                        {
                            "text": "The small silver bells on her bracelet <w>jingle</w> with every movement of her wrist.",
                            "target_lang_translations": {
                                "ru": "Маленькие серебряные колокольчики на ее браслете <w>позвякивают</w> при каждом движении ее запястья."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinkle",
                        "ring"
                    ],
                    "common_phrases": [
                        "jingle in a pocket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать легкий звенящий звук при соприкосновении металлических или стеклянных предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звенеть",
                                "target_lang_sense_clarification": "издавать металлический звук"
                            },
                            {
                                "target_lang_word": "звякать",
                                "target_lang_sense_clarification": "издавать отрывистый звон"
                            },
                            {
                                "target_lang_word": "бренчать",
                                "target_lang_sense_clarification": "тихо позвякивать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92602a5c-6d7e-30c0-97d9-1a894bc71a49",
                    "sense_definition": "To cause something to make a light, ringing sound of metal or glass clattering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "make_metallic_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>jingled</w> her car keys to get the playful puppy's attention.",
                            "target_lang_translations": {
                                "ru": "Она <w>позвенела</w> ключами от машины, чтобы привлечь внимание игривого щенка."
                            }
                        },
                        {
                            "text": "He nervously <w>jingled</w> the loose change in his trousers while waiting for the interview.",
                            "target_lang_translations": {
                                "ru": "Он нервно <w>бренчал</w> мелочью в брюках в ожидании собеседования."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinkle"
                    ],
                    "common_phrases": [
                        "jingle keys",
                        "jingle coins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо издавать легкий звенящий металлический или стеклянный звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звенеть",
                                "target_lang_sense_clarification": "заставлять звенеть, например, ключами"
                            },
                            {
                                "target_lang_word": "звякать",
                                "target_lang_sense_clarification": "позвякивать чем-либо"
                            },
                            {
                                "target_lang_word": "бренчать",
                                "target_lang_sense_clarification": "греметь монетами или ключами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8a4612c-6105-37f9-8c55-f0795056e1b6",
                    "sense_definition": "To rhyme or sound with a repetitive, simple, and catchy rhythm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rhyme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The simple verses of the nursery rhyme <w>jingle</w> pleasantly in a way children love.",
                            "target_lang_translations": {
                                "ru": "Простые стихи детского стишка приятно <w>рифмуются</w> — так, как это нравится детям."
                            }
                        },
                        {
                            "text": "The poet's lines <w>jingle</w> too much, making the serious subject sound trivial.",
                            "target_lang_translations": {
                                "ru": "Строки поэта звучат слишком <w>монотонно-просто</w>, из-за чего серьезная тема кажется тривиальной."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рифмоваться или звучать с простым, монотонным и легко запоминающимся ритмом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звучать монотонно",
                                "target_lang_sense_clarification": "о стихах с простой рифмой"
                            },
                            {
                                "target_lang_word": "рифмоваться",
                                "target_lang_sense_clarification": "иметь простой, навязчивый ритм"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "854f99d7-61b4-3fce-b28e-e4a00520374a",
                    "sense_definition": "A county of Xinzhou, Shanxi, China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The agricultural reforms in <w>Jingle</w> County led to a significant increase in crop yields.",
                            "target_lang_translations": {
                                "ru": "Сельскохозяйственные реформы в уезде <w>Цзинлэ</w> привели к значительному росту урожайности."
                            }
                        },
                        {
                            "text": "Many historical documents record the ancient trade routes that passed through <w>Jingle</w>.",
                            "target_lang_translations": {
                                "ru": "Множество исторических документов фиксируют древние торговые пути, проходившие через <w>Цзинлэ</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Jingle County"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уезд городского округа Синьчжоу в провинции Шаньси, Китай."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Цзинлэ",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}