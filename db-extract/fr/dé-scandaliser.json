                        "glosses": [
                            "Faire perdre son caractère scandaleux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c38a47-8680-4606-9f59-e299d6537b67",
                                "sense_id": "d1b1430c-c3d3-341d-b6e0-6d9ad0be5f6d",
                                "text": "Dans un sens, tout argent qui se retrouve dans la catégorie Nᵒ 2.4 pourrait être «dé-scandalisé» en étant transféréré dans la Nᵒ 2.3 (oeuvres caritatives)."
                            },
                            {
                                "example_id": "82ddb173-f720-4db2-8fbd-213aeb87adb6",
                                "sense_id": "d1b1430c-c3d3-341d-b6e0-6d9ad0be5f6d",
                                "text": "Elle est donc complice puisqu’elle dé-scandalise l’ensemble des pratiques de la Police qui sont par essence des pratiques violentes"
                            }
                        ]
                    },
                    {
                        "sense_id": "98dfd3b7-eaa2-3aea-889b-92f5d6d312e4",
                        "entry_id": "505796c7-2d4b-3aa6-8dd5-edf0654c7c5a",
                        "glosses": [
                            "Faire cesser d’être scandalisé."
                        ],
                        "tags": [],
                        "examples": [
