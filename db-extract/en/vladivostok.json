                                    {
                                        "sense_id": "2db2dad9-391b-3611-9564-c690887d91f4",
                                        "entry_id": "58e93e24-6c6f-34fb-961e-6926b509b8f8",
                                        "glosses": [
                                            "Ville de Russie, située au bord de la mer du Japon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5194e712-c723-4d19-9663-18d803822096",
                                                "sense_id": "2db2dad9-391b-3611-9564-c690887d91f4",
                                                "text": "Une fresque couvre tout le plafond. Elle représente Vladivostok et Moscou. D’un côté le port, les navires, des pêcheurs, nuances orangées sur la mer. De l’autre, la place Rouge et les dames endimanchées."
                                            },
                                            {
                                                "example_id": "60535f2b-cb32-4d66-9b74-ffbc98e12d94",
                                                "sense_id": "2db2dad9-391b-3611-9564-c690887d91f4",
                                                "text": "Un seul chemin de fer possédera un plus long développement, une fois achevé : ce sera le Grand-Transsibérien qui, de l’Oural à Vladivostok, comptera six mille cinq cents kilomètres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
