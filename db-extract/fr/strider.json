                ],
                "senses": [
                    {
                        "sense_id": "2e426bd9-cf27-3e6f-be05-3cbf31d8d0bb",
                        "entry_id": "b89559b3-6539-3b38-a83d-eac2e2a30a75",
                        "glosses": [
                            "Émettre un bruit strident."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86aa71e3-091b-4083-8c1a-488f062c2034",
                                "sense_id": "2e426bd9-cf27-3e6f-be05-3cbf31d8d0bb",
                                "text": "C’est qu’une balle qui vous stride à l’oreille vous semble précisément destinée."
                            },
                            {
                                "example_id": "b598cb0d-0ffa-4c00-b0ca-d51de2a16c53",
                                "sense_id": "2e426bd9-cf27-3e6f-be05-3cbf31d8d0bb",
                                "text": "Soudain, un bruissement d’appel strida et, tandis que la multitude se dressait, hypnotique, on entendit gronder le Grand Planétaire […]."
                            },
                            {
                                "example_id": "5ce6cbc2-da0c-49d6-ae51-9c7edbcf7c7d",
                                "sense_id": "2e426bd9-cf27-3e6f-be05-3cbf31d8d0bb",
                                "text": "Brusquement, je sursautai, surpris par la scie qui, après un instant de repos, reprenait son activité sans crier gare. Tout d’abord, elle strida, lorsqu’on la mit en marche, puis émit un doux ronronnement satisfait dès que les dents d’acier entamèrent la planche qu’on lui livrait sur le chariot."
                            }
                        ]
                    }
                ],
