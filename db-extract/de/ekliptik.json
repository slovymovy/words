                    {
                        "translation_id": "661fbbc6-6ec8-4b8b-b90e-11a2da5f475f",
                        "source_entry_id": "30b08562-8816-3e12-8ef3-3e9c9cf8ebe2",
                        "source_sense_id": "a2e15237-089a-322e-b6e3-c20f388d6a00",
                        "source_sense_description": "Projektionen des Verlaufes der Sonne am Himmel und des Verlaufes der Erde um die Sonne",
                        "target_lang_word": "écliptique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écliptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89f4b0ab-cdbd-3b99-91e2-de5fc5773a8e",
                                        "entry_id": "b5aebb62-5cca-3b5a-9eb2-1689b13abe17",
                                        "glosses": [
                                            "Plan géométrique contenant l’orbite de la Terre autour du soleil et, approximativement, les orbites des autres planètes principales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27315873-46a9-449d-822a-ea6273bcaed7",
                                                "sense_id": "89f4b0ab-cdbd-3b99-91e2-de5fc5773a8e",
                                                "text": "Pour renfermer le cours de toutes les Planètes dans un même espace, on s'est avisé d'élargir l’écliptique de part & d'autre; on en a fait comme une espèce de ceinture à laquelle on a donné le nom de zodiaque : c'est encore un terme emprunté du grec, & qui signifie porte-animaux."
                                            },
                                            {
                                                "example_id": "02fb429a-642d-45f4-81e5-5fdba0bd1607",
                                                "sense_id": "89f4b0ab-cdbd-3b99-91e2-de5fc5773a8e",
                                                "text": "L’orbite de l’astéroïde Toutatis se confond pratiquement avec l’écliptique ce qui constitue un facteur important de collision avec la Terre."
                                            },
                                            {
                                                "example_id": "45484078-e00e-4b4e-94ac-76b0593b1337",
                                                "sense_id": "89f4b0ab-cdbd-3b99-91e2-de5fc5773a8e",
                                                "text": "La différence des saisons est due à l’inclinaison de l’écliptique sur l’équateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eba56001-915e-3440-bc3c-4c5521bbcf77",
                                        "entry_id": "b5aebb62-5cca-3b5a-9eb2-1689b13abe17",
                                        "glosses": [
                                            "Cercle vu de la Terre résultant de l’intersection du plan (sens 1) avec la sphère céleste, et contenant la trajectoire annuelle du Soleil."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1632757d-98d1-4157-adc7-cfe9c46e60c9",
                                                "sense_id": "eba56001-915e-3440-bc3c-4c5521bbcf77",
                                                "text": "L’écliptique est le cercle définissant les douze constellations du zodiaque."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écliptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7531dd89-56e2-3693-98a6-4681d7571e8e",
                                        "entry_id": "43f59148-1472-3abd-a8a9-3e9d31754a99",
                                        "glosses": [
                                            "En relation avec l’écliptique (Nom (1-2))."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a7398a-ec43-417d-86fb-269716b486e9",
                                                "sense_id": "7531dd89-56e2-3693-98a6-4681d7571e8e",
                                                "text": "Les coordonnées écliptiques de Saturne figurent dans le tableau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5383725b-bf59-3105-b399-2746288b3dbb",
                                        "entry_id": "43f59148-1472-3abd-a8a9-3e9d31754a99",
                                        "glosses": [
                                            "Lié ou propice aux éclipses."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be042ff0-c721-447d-af5c-daa861b799ac",
                                                "sense_id": "5383725b-bf59-3105-b399-2746288b3dbb",
                                                "text": "Les pleines lunes ne sont pas toutes écliptiques, car la lune ne tourne pas exactement dans le plan de l’orbite terrestre."
                                            },
                                            {
                                                "example_id": "bc0d400c-e7c4-43fc-bbbe-aa56a4c5cc8c",
                                                "sense_id": "5383725b-bf59-3105-b399-2746288b3dbb",
                                                "text": "Une conjonction écliptique."
                                            },
                                            {
                                                "example_id": "2bbc1ada-562f-40d1-ad47-3a1cda3bd080",
                                                "sense_id": "5383725b-bf59-3105-b399-2746288b3dbb",
                                                "text": "Les éclipses de soleil et de lune se produisent toujours dans le plan écliptique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
