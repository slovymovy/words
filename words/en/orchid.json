{
    "word_family": [
        "orchidaceous",
        "orchideous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8158b6ad-0afd-3138-a32a-bf1cf5a1aec0",
                    "sense_definition": "A plant of the orchid family (Orchidaceae), bearing unusually-shaped flowers of beautiful colours.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orchid_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully watered the delicate <w>orchid</w> sitting on her windowsill.",
                            "target_lang_translations": {
                                "ru": "Она осторожно полила нежную <w>орхидею</w>, стоявшую на подоконнике."
                            }
                        },
                        {
                            "text": "The botanical garden has a stunning collection of rare <w>orchids</w> from the rainforest.",
                            "target_lang_translations": {
                                "ru": "В ботаническом саду собрана потрясающая коллекция редких <w>орхидей</w> из тропических лесов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wild orchid",
                        "grow orchids",
                        "orchid flower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение семейства орхидных (Orchidaceae) с необычной формой цветков красивой окраски."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орхидея",
                                "target_lang_sense_clarification": "цветок или растение семейства орхидных"
                            },
                            {
                                "target_lang_word": "ятрышник",
                                "target_lang_sense_clarification": "дикорастущее растение семейства орхидных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a423e4aa-b3ea-3045-a6e4-a482e65af943",
                    "sense_definition": "A light bluish-red, violet-red or purple colour.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "orchid_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls of the bedroom were painted in a soft shade of <w>orchid</w>.",
                            "target_lang_translations": {
                                "ru": "Стены спальни были выкрашены в нежный <w>орхидейный</w> оттенок."
                            }
                        },
                        {
                            "text": "She chose a beautiful silk dress in deep <w>orchid</w> for the evening gala.",
                            "target_lang_translations": {
                                "ru": "Для вечернего торжества она выбрала красивое шелковое платье насыщенного <w>лилового</w> цвета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shade of orchid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светлый синевато-красный, фиолетово-красный или пурпурный цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орхидейный цвет",
                                "target_lang_sense_clarification": "светло-пурпурный или лиловый оттенок"
                            },
                            {
                                "target_lang_word": "цвет орхидеи",
                                "target_lang_sense_clarification": "нежно-фиолетовый оттенок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c08acaf2-81cf-30f4-99dd-37da98755b79",
                    "sense_definition": "Having a light purple colour.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "orchid_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridesmaids wore lovely <w>orchid</w> gowns that matched the spring theme.",
                            "target_lang_translations": {
                                "ru": "Подружки невесты были одеты в прелестные <w>лиловые</w> платья, соответствующие весенней тематике."
                            }
                        },
                        {
                            "text": "He decorated the room with <w>orchid</w> ribbons and white balloons.",
                            "target_lang_translations": {
                                "ru": "Он украсил комнату лентами <w>цвета орхидеи</w> и белыми шарами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "orchid bridesmaid dresses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий светло-пурпурный или лиловый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орхидейный",
                                "target_lang_sense_clarification": "имеющий цвет орхидеи (светло-лиловый)"
                            },
                            {
                                "target_lang_word": "лиловый",
                                "target_lang_sense_clarification": "светло-фиолетовый оттенок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}