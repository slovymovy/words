                "senses": [
                    {
                        "sense_id": "5c1331a4-6e4f-3289-9a9d-db1a79841ecd",
                        "entry_id": "f06584fe-6bb3-3f34-b6cd-80f43036a7f9",
                        "glosses": [
                            "van iets dat het de aandacht trekt; van iets dat men er zich bij betrokken voelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d89f80-bc52-40df-a411-a5cf2db1f8d4",
                                "sense_id": "5c1331a4-6e4f-3289-9a9d-db1a79841ecd",
                                "text": "O wat wankelde Nederland in de laatste minuten. Steeds kwamen ze weer, die handige Japanners. In de tengere lijven nog steeds zoveel energie. Precies hetgeen Nederland zo miste in het slot van meeslepende achtste finale."
                            },
                            {
                                "example_id": "37dfeb2a-ed41-427d-a399-8b4a82185461",
                                "sense_id": "5c1331a4-6e4f-3289-9a9d-db1a79841ecd",
                                "text": "Op meeslepende muziek van de dj’s werd het begin van de zomer door ruim 1500 bezoekers uitbundig gevierd."
                            },
                            {
                                "example_id": "20a978a8-6802-4c4c-b689-df2f7da5a68f",
                                "sense_id": "5c1331a4-6e4f-3289-9a9d-db1a79841ecd",
                                "text": "In de meeslepende apotheose, waarin het elke game ongelooflijk spannend was, sloeg Nadal op de rand van de invallende duisternis toe met 9-7."
                            }
                        ]
                    }
                ],
