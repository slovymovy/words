        "de-extract.jsonl": [
            {
                "entry_id": "5e878885-5e86-392d-8ceb-56c9ee8cc436",
                "word": "ehrlicherweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d246880-2bd5-3e21-a751-23c5a3048433",
                        "entry_id": "5e878885-5e86-392d-8ceb-56c9ee8cc436",
                        "glosses": [
                            "auf eine Art und Weise, die ehrlich ist; aufrichtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9f3a6e-8c35-4d8e-9205-b6661664f438",
                                "sense_id": "0d246880-2bd5-3e21-a751-23c5a3048433",
                                "text": "„Natürlich könnten Arbeiter, wie auch schon in Frankreich geschehen, einzelne Manager vorübergehend in Geiselhaft nehmen, um bessere Bedingungen für Stellenstreichungen zu erpressen. Aber eine ernsthafte Revolte, wollte sie mehr sein als Folklore, müsste sich ehrlicherweise gegen das System als solches wenden. Das aber scheint niemand zu wollen.“"
                            },
                            {
                                "example_id": "c0c1387a-13be-4c4b-bd47-1284e580ddf4",
                                "sense_id": "0d246880-2bd5-3e21-a751-23c5a3048433",
                                "text": "„Und es hat, wie er ehrlicherweise zugibt, bei ihm eine Weile gedauert, bis ihm der Antitotalitarismus so zur zweiten Natur geworden war wie dem französischen Genossen, der sich immer als linker Antikommunist verstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b6fee0b-7359-493a-aa5f-3659d20a73dc",
                        "source_entry_id": "5e878885-5e86-392d-8ceb-56c9ee8cc436",
                        "source_sense_id": "0d246880-2bd5-3e21-a751-23c5a3048433",
                        "source_sense_description": "auf eine Art und Weise, die ehrlich ist; aufrichtig",
                        "target_lang_word": "honestly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                        "entry_id": "5841d707-cf1e-35ae-a32a-aa320f52e3e6",
                                        "glosses": [
                                            "In an honest manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f47224-adce-4cba-b951-4f1d25aae945",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "He answered the questions honestly."
                                            },
                                            {
                                                "example_id": "dfd8017f-109d-4648-b244-05c9c5d7ea7f",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "You honestly quit your tools; quit a most muddy confused coil of sore work, short rations, of sorrows, dispiritments and contradictions, having now honestly done with it all; — and await, not entirely in a distracted manner, what the Supreme Powers, and the Silences and the Eternities may have to say to you."
                                            },
                                            {
                                                "example_id": "e8f7b1a5-4848-4bf5-9be4-717a53399ac4",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "I can't honestly say that I feel any elatement at the prospect."
                                            },
                                            {
                                                "example_id": "442f14ec-7a46-41b0-93fa-063d624a9ca6",
                                                "sense_id": "04ef993b-3222-341c-ba20-b1b8b5f98738",
                                                "text": "Nevertheless, you must know (if I am to speak honestly to you) that I do not repent me those dallyings in enchanted fields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75406bb5-24d9-3028-8fe2-bf93e549265f",
                                        "entry_id": "5841d707-cf1e-35ae-a32a-aa320f52e3e6",
                                        "glosses": [
                                            "Frankly, to be honest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9a6216-1d40-4d3e-91b5-2237de473c20",
                                                "sense_id": "75406bb5-24d9-3028-8fe2-bf93e549265f",
                                                "text": "Honestly, I didn't believe a word she said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "honestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9a2e5d-bd9e-35f1-adf4-cbc214c61626",
                                        "entry_id": "b4df50d1-7d4e-3216-b748-72ab564d082d",
                                        "glosses": [
                                            "Used to express exasperation, dismay, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd40b95-57cc-478f-83b5-28372d72cbab",
                                                "sense_id": "ec9a2e5d-bd9e-35f1-adf4-cbc214c61626",
                                                "text": "Honestly! I want to finish this work and you keep interrupting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fef56cf6-62c0-4fd8-94f4-3fedbfd740c3",
                        "source_entry_id": "5e878885-5e86-392d-8ceb-56c9ee8cc436",
                        "source_sense_id": "0d246880-2bd5-3e21-a751-23c5a3048433",
                        "source_sense_description": "auf eine Art und Weise, die ehrlich ist; aufrichtig",
                        "target_lang_word": "truly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af5d81d9-34dc-35d8-b49c-058e04ba84bf",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "In accordance with the facts; truthfully, accurately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc5354c-d4ed-4096-ba05-4f3495fb3ba0",
                                                "sense_id": "af5d81d9-34dc-35d8-b49c-058e04ba84bf",
                                                "text": "He adds, very truly, that what was fatal to such philosophies as his was not Christianity but the Copernican theory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "Honestly, genuinely, in fact, really."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b21dcd-a0e7-4e0a-b486-12ef8e9041f7",
                                                "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                                "text": "That is truly all I know."
                                            },
                                            {
                                                "example_id": "0a3366fe-aec5-4d4c-a483-2e1e3882bcc0",
                                                "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                                "text": "Truly, that is all I know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca53d8b-438e-4811-8f30-6313344a18ba",
                                                "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                                "text": "You are truly silly."
                                            },
                                            {
                                                "example_id": "7ad9062e-7f14-4f5b-8635-642cde38cd75",
                                                "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                                "text": "I’m distantly related to the truly great writer, Chaim Potok, which for a magazine editor seems like a good thing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
