{
    "word_family": [
        "revive",
        "revivalist",
        "revivalism",
        "revivify"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11df9cbe-9113-3a1e-bfdb-12574d31ebd8",
                    "sense_definition": "A renewed interest in or the flourishing of something, such as a style, culture, or activity, after a period of decline.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "renewal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is experiencing a cultural <w>revival</w> with many new art galleries opening downtown.",
                            "target_lang_translations": {
                                "ru": "Город переживает культурное <w>возрождение</w>: в центре открывается множество новых художественных галерей."
                            }
                        },
                        {
                            "text": "The band's latest tour sparked a massive <w>revival</w> of interest in their early music.",
                            "target_lang_translations": {
                                "ru": "Последний тур группы вызвал массовое <w>оживление</w> интереса к их ранней музыке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cultural revival",
                        "economic revival",
                        "post-punk revival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возобновление интереса или расцвет чего-либо (стиля, культуры, деятельности) после периода упадка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возрождение",
                                "target_lang_sense_clarification": "культурное или духовное"
                            },
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "активизация деятельности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "990348d3-fa2b-37b8-8956-3ce72f68cf2a",
                    "sense_definition": "The return to popularity or use of a specific fashion, practice, or trend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renewal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There has been a surprising <w>revival</w> of vinyl records among younger music fans.",
                            "target_lang_translations": {
                                "ru": "Среди молодых меломанов наблюдается удивительное <w>возвращение</w> популярности виниловых пластинок."
                            }
                        },
                        {
                            "text": "The fashion <w>revival</w> of the eighties brought back neon colors and oversized jackets.",
                            "target_lang_translations": {
                                "ru": "<w>Возвращение</w> моды восьмидесятых вернуло неоновые цвета и куртки оверсайз."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fashion revival",
                        "style revival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение популярности или использования определенной моды, практики или тренда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращение",
                                "target_lang_sense_clarification": "в моду или обиход"
                            },
                            {
                                "target_lang_word": "возобновление",
                                "target_lang_sense_clarification": "интереса к стилю"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a49a835-6b07-326a-a764-998a9f84136b",
                    "sense_definition": "An improvement in the condition, strength, or fortunes of someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team needs a major <w>revival</w> in form if they want to win the championship.",
                            "target_lang_translations": {
                                "ru": "Команде нужен серьезный <w>подъем</w> формы, если они хотят выиграть чемпионат."
                            }
                        },
                        {
                            "text": "After a long illness, the patient showed a sudden <w>revival</w> of energy and spirit.",
                            "target_lang_translations": {
                                "ru": "После долгой болезни у пациента случился внезапный <w>прилив</w> сил и бодрости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revival of spirits",
                        "sudden revival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшение состояния, силы или положения кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "сил или экономики"
                            },
                            {
                                "target_lang_word": "прилив",
                                "target_lang_sense_clarification": "энергии или сил"
                            },
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "улучшение состояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "886a32e9-9bb7-32eb-ae60-9d0768a454a7",
                    "sense_definition": "A period of renewed religious interest or a series of meetings intended to increase religious faith.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher traveled across the country holding a religious <w>revival</w> in every small town.",
                            "target_lang_translations": {
                                "ru": "Проповедник ездил по стране, проводя религиозные <w>собрания</w> в каждом маленьком городке."
                            }
                        },
                        {
                            "text": "Historians often study the Islamic <w>revival</w> that took place during that century.",
                            "target_lang_translations": {
                                "ru": "Историки часто изучают исламское <w>возрождение</w>, имевшее место в том веке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "religious revival",
                        "Islamic revival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период возобновления религиозного интереса или серия собраний для укрепления веры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "религиозное возрождение",
                                "target_lang_sense_clarification": "духовный подъем"
                            },
                            {
                                "target_lang_word": "ревиваль",
                                "target_lang_sense_clarification": "специальный термин для религиозных собраний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ee63663-d547-3a9a-a214-858c5a2aabc9",
                    "sense_definition": "The restoration of legal force, validity, or the reinstatement of a legal action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued for the <w>revival</w> of a debt that had been barred by the statute of limitations.",
                            "target_lang_translations": {
                                "ru": "Адвокат настаивал на <w>восстановлении</w> долга, срок исковой давности по которому истек."
                            }
                        },
                        {
                            "text": "The court ordered the <w>revival</w> of the lawsuit after new evidence was presented.",
                            "target_lang_translations": {
                                "ru": "Суд постановил <w>возобновить</w> дело после представления новых доказательств."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revival of a debt",
                        "legal revival"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановление юридической силы, действительности или возобновление судебного дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возобновление",
                                "target_lang_sense_clarification": "судебного процесса или иска"
                            },
                            {
                                "target_lang_word": "восстановление",
                                "target_lang_sense_clarification": "юридической силы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}