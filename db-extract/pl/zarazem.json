                ],
                "senses": [
                    {
                        "sense_id": "faaa5c49-9863-370d-b044-2a09aa2ad873",
                        "entry_id": "94d9ab4b-6e03-3bbc-b38b-c82654c17bf8",
                        "glosses": [
                            "zur selben Zeit, gleichzeitig, zugleich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0fd43b3-9a3a-4e5d-ab68-16da63c913d0",
                                "sense_id": "faaa5c49-9863-370d-b044-2a09aa2ad873",
                                "text": "„Ziemia była de nomine Rzeczypospolitej, ale pustynna, na której pastwisk Rzeczpospolita Tatarom pozwalała, wszakże, gdy kozacy często bronili, więc to pastwisko było i pobojowiskiem zarazem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ed8e170-ac47-43e1-8cf3-48d7c80bedfc",
                        "source_entry_id": "94d9ab4b-6e03-3bbc-b38b-c82654c17bf8",
                        "source_sense_id": "faaa5c49-9863-370d-b044-2a09aa2ad873",
                        "source_sense_description": "zur selben Zeit, gleichzeitig, zugleich",
                        "target_lang_word": "gleichzeitig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichzeitig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "zur selben/gleichen Zeit ablaufend, stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49837d2-81c0-43cc-a8bf-242674918503",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "Ich kann nicht gleichzeitig an verschiedenen Orten sein."
                                            },
                                            {
                                                "example_id": "078a879a-2b28-4615-ae03-f171711d8851",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„Seit der Jahrtausendwende könne jedoch ein Rückgang der Deutschlernenden bei gleichzeitigem Anstieg der Englischlernenden festgestellt werden.“"
                                            },
                                            {
                                                "example_id": "66fadb38-67bc-437f-9ba9-54ecd3ade6e7",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "auch noch, daneben, zugleich"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd657abb-350d-46ca-8119-0ccc5303950c",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„K. wartete noch ein Weilchen, sah von seinem Kopfkissen aus die alte Frau, die ihm gegenüber wohnte und die ihn mit einer an ihr ganz ungewöhnlichen Neugierde beobachtete, dann aber, gleichzeitig befremdet und hungrig, läutete er.“"
                                            },
                                            {
                                                "example_id": "915b2cf7-ea87-4aec-a48f-a00c5ed5c151",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Er war Edelmann und gleichzeitig Prolet."
                                            },
                                            {
                                                "example_id": "23df94f1-c644-441c-994c-690d3d55ddf7",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Unser Nachbar ist gleichzeitig unser Vermieter."
                                            },
                                            {
                                                "example_id": "dc804a4b-abf5-4711-804a-c64e6eb998a4",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„Gleichzeitig könnte der Vulkanausbruch auch das Ende der Trichterbecherkultur in Skandinavien eingeläutet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1e1f04b-5eae-439a-b598-075b4206fcdf",
                        "source_entry_id": "94d9ab4b-6e03-3bbc-b38b-c82654c17bf8",
                        "source_sense_id": "faaa5c49-9863-370d-b044-2a09aa2ad873",
                        "source_sense_description": "zur selben Zeit, gleichzeitig, zugleich",
                        "target_lang_word": "zugleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                        "entry_id": "0b5f7d23-8979-3259-8235-55ffabf05930",
                                        "glosses": [
                                            "zur gleichen Zeit mit etwas anderem ablaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580bfc59-c95d-4be5-9d1e-95dab9e857d0",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "Es stürmte und regnete zugleich."
                                            },
                                            {
                                                "example_id": "9c824681-45a8-4d2e-a1a3-7514c91cf707",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "Sie lachte und weinte zugleich."
                                            },
                                            {
                                                "example_id": "da0a49af-f58a-46ff-a1cc-4a9627a084f2",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "„Richtig wäre es gewesen, den Menschen in beiden Teilen Deutschlands reinen Wein einzuschenken und ihnen zugleich Zuversicht zu vermitteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                        "entry_id": "0b5f7d23-8979-3259-8235-55ffabf05930",
                                        "glosses": [
                                            "auch noch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ae7547-15b2-407b-8d23-7f0cedf1f280",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Zugleich mit dem Sturm kam heftiger Regen auf."
                                            },
                                            {
                                                "example_id": "64815d40-dc87-4309-84f8-5c6d4d654a63",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Sie ist Unternehmerin und zugleich Mutter einer vierjährigen Tochter."
                                            },
                                            {
                                                "example_id": "e7250c8f-8b15-4ac0-ac30-214f0c59dd5f",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Das Buch ist zugleich informativ und spannend."
                                            },
                                            {
                                                "example_id": "0292c0a5-3df2-4f3a-8274-79abfa7e0e18",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "„Die Holzdielen sind herausgerissen, aber in der Turnhalle, die zugleich Aula war, hängen noch die Basketballkörbe an der Wand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
