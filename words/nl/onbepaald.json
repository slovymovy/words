                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "в математическом или абстрактном контексте"
                            },
                            {
                                "target_lang_word": "безграничный",
                                "target_lang_sense_clarification": "в значении не имеющий видимых пределов"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "indeterminate",
