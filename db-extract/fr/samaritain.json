                ],
                "senses": [
                    {
                        "sense_id": "a458d8e2-53e6-35de-8769-69fc143e09c3",
                        "entry_id": "ab92e046-6cc2-381e-8603-e2582b14c066",
                        "glosses": [
                            "Habitant de Samarie."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "eeefb873-87fd-4ec8-959c-136e9c2a61f4",
                                "sense_id": "a458d8e2-53e6-35de-8769-69fc143e09c3",
                                "text": "Une parabole célèbre de Jésus-Christ, dans la Bible, fait intervenir un bon Samaritain."
                            },
                            {
                                "example_id": "98c16ae7-2dd8-4aba-9516-e386d454b35b",
                                "sense_id": "a458d8e2-53e6-35de-8769-69fc143e09c3",
                                "text": "Il avait aperçu devant la fosse le Grand Ange des Samaritains, tout couvert d’yeux et brandissant un immense glaive, rouge, et dentelé comme une flamme."
                            },
                            {
                                "example_id": "759508ea-0335-4e73-865c-f8b5e1c2f1bf",
                                "sense_id": "a458d8e2-53e6-35de-8769-69fc143e09c3",
                                "text": "Les Samaritains, du point de vue des Juifs pieux, sont pires que les païens : des parias, la lie de l'humanité."
                            },
                            {
                                "example_id": "d9be1529-0d58-4b83-82d1-4a78480d5999",
                                "sense_id": "a458d8e2-53e6-35de-8769-69fc143e09c3",
                                "text": "Les tensions entre Juifs et Samaritains se ravivent dans ces années-là, les seconds tentant notamment de saboter le fonctionnement du Sanhédrin lors de la diffusion de la date des néoménies et des fêtes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c049a26-8108-422d-87c9-f770514f1973",
                        "source_entry_id": "ab92e046-6cc2-381e-8603-e2582b14c066",
