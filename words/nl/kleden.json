                            }
                        },
                        {
                            "text": "In dit bedrijf is het de gewoonte om je zakelijk te <w>kleden</w>.",
                            "target_lang_translations": {
                                "en": "In this company, it is customary to <w>dress</w> professionally."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volgens de mode kleden",
                        "stijlvol kleden"
