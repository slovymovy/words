                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a5ded07-9feb-3300-8d1f-c30cf837614d",
                        "entry_id": "727c155a-4d3b-3c29-bb79-1399a14d36ff",
                        "glosses": [
                            "Femme transgenre ou un homme gay efféminé en Thaïlande."
                        ],
                        "tags": [
                            "LGBTQ",
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "2bef25ae-2dc7-4151-999f-41ac051c95e6",
                                "sense_id": "8a5ded07-9feb-3300-8d1f-c30cf837614d",
                                "text": "— C'est un katoï, chuchota la mère abbesse, ce qui peut se traduire par ladyboy. Un être émasculé, qui n'est ni homme ni femme."
                            },
                            {
                                "example_id": "9c4e178c-ef65-4e18-bf57-c06febebe183",
                                "sense_id": "8a5ded07-9feb-3300-8d1f-c30cf837614d",
                                "text": "Apsara était la plus zélée d'entre elles, car d'après la croyance populaire, une katoï paye les erreurs qu'elle a commises dans une vie antérieure."
                            },
                            {
                                "example_id": "32577aab-dfb7-4309-b78d-53987af8b3c6",
                                "sense_id": "8a5ded07-9feb-3300-8d1f-c30cf837614d",
                                "text": "Timoléon ne mentionne pas les katoï, les travestis qui se produisaient dans des épisodes du Ramakien, version siamoise du Râmâyana."
                            },
                            {
                                "example_id": "01f567d7-c231-4473-81c8-2756b66a54ba",
                                "sense_id": "8a5ded07-9feb-3300-8d1f-c30cf837614d",
                                "text": "En Inde, les hijra composent ces êtres du troisième sexe ; en Thaïlande, ils forment la classe des katoï ; en Polynésie, en Océanie, la société reconnaît l'existence d'un troisième genre ; […]."
                            },
                            {
                                "example_id": "fbecbb2a-5349-4960-8d1e-9a0515e473e6",
                                "sense_id": "8a5ded07-9feb-3300-8d1f-c30cf837614d",
                                "text": "Pour finir, Naya me dit que ce type de femme, ici, en Thaïlande, on les appelle des katoïs, des hommes devenus femmes par leurs obligations de travail, de vie, et de bien-être."
                            },
                            {
                                "example_id": "c80e6581-8a6d-4511-8f18-f2a2b4d8eaa9",
                                "sense_id": "8a5ded07-9feb-3300-8d1f-c30cf837614d",
                                "text": "Liz avait profité de ses escales à San-Francisco et Atlanta pour glaner quelques informations sur Internet à propos des katoïs d'Asie du Sud-Est et des salzikrums de Mésopotamie."
                            }
                        ]
                    }
