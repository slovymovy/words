                "senses": [
                    {
                        "sense_id": "db934dde-8a68-353d-8276-eb9a26ad15d4",
                        "entry_id": "7024f0e1-680b-3f97-9fd0-f6a20e6623f1",
                        "glosses": [
                            "Retirer les divers débris, en particulier végétaux, pris dans la laine."
                        ],
                        "tags": [
                            "Industrie textile"
                        ],
                        "examples": [
                            {
                                "example_id": "7bd5d239-295b-4481-a2d1-6f3706332e08",
                                "sense_id": "db934dde-8a68-353d-8276-eb9a26ad15d4",
                                "text": "Au lieu de disposer notre système à égrateronner sur une carde comme il a été expliqué, nous pouvons grouper les organes qui le composent : peigne-hérisson, lames-cloisons, lames-râteaux, rouleaux intermédiaires, etc., de façon à constituer un appareil égrateronneur indépendant qui pourrait s’appliquer à la préparation et à l’épuration de la laine en général pour le travail en peigné ou en cardé."
                            }
                        ]
                    }
