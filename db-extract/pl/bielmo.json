                        ]
                    },
                    {
                        "translation_id": "dd5a4deb-09eb-4bbe-ac3c-2bcb3f652276",
                        "source_entry_id": "30444d01-8e54-34e0-869b-dd7f894c08c1",
                        "source_sense_id": "75e58f8d-1c0d-3231-97ca-4886c0eb5483",
                        "target_lang_word": "бельмо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бельмо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f368f0-ccb0-3488-a7ca-c072c801262b",
                                        "entry_id": "b64959e0-bda4-37e3-9d83-5ebbddd95f85",
                                        "glosses": [
                                            "анат. беловатое пятно на роговой оболочке глаза, образовавшееся после её воспаления или при повреждении глаза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dfb8359-5b0b-4d2f-8706-4604bfcf3147",
                                                "sense_id": "a4f368f0-ccb0-3488-a7ca-c072c801262b",
                                                "text": "Глаз очень красен и воспалён и на зрачке начинает образовываться бельмо."
                                            },
                                            {
                                                "example_id": "87cbdaa7-e0c4-4c70-8c68-a764383a92a0",
                                                "sense_id": "a4f368f0-ccb0-3488-a7ca-c072c801262b",
                                                "text": "Его шашка отчаянно билась о ребра лошади, а белая худая лошадь, вся усыпанная от старости гречкой и с бельмом на правом глазу, судорожно вертела коротким хвостом и издавала в такт своему безобразному галопу резкие, отрывистые, как выстрелы, звуки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9cc99f-3df7-35bf-904f-86bc24645c77",
                                        "entry_id": "b64959e0-bda4-37e3-9d83-5ebbddd95f85",
                                        "glosses": [
                                            "мн. ч. груб., прост. глаза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d1c41c3-f65e-40dc-8c8b-bd60457e5871",
                                                "sense_id": "7f9cc99f-3df7-35bf-904f-86bc24645c77",
                                                "text": "Чего ты на меня свои бельмы выпучил?"
                                            },
                                            {
                                                "example_id": "3291cafd-b690-4af9-931c-58f678e1bfd7",
                                                "sense_id": "7f9cc99f-3df7-35bf-904f-86bc24645c77",
                                                "text": "— Постой, говорит, я ещё с тобой поговорю, рожа-то мне знакомая, — сам бельмы на меня так и пялит."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
