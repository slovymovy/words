                "senses": [
                    {
                        "sense_id": "542d2261-d48a-3134-8902-06a5c2aadfb0",
                        "entry_id": "40008962-4ed0-314c-b05b-a3c8390a7ab5",
                        "glosses": [
                            "Enlever les nervures."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "86f90c44-020f-43f5-ab5e-882135ead8dd",
                                "sense_id": "542d2261-d48a-3134-8902-06a5c2aadfb0",
                                "text": "énervurer quelques feuilles de chou cavalier (chou à vache) et les couper en lamelles de 2 à 3 cm."
                            },
                            {
                                "example_id": "c31f2244-ce50-45d8-a56f-c9878fe1e7e7",
                                "sense_id": "542d2261-d48a-3134-8902-06a5c2aadfb0",
                                "text": "Le temps lui a fait le squelette le long de ses nervures. Elles s'énervurent."
                            },
                            {
                                "example_id": "b5505701-01cd-4ad8-88c8-fe5c344ab1ca",
                                "sense_id": "542d2261-d48a-3134-8902-06a5c2aadfb0",
                                "text": "Puis énervurez le foi gras, en tirant sur les nerfs avec une pince à épiler, pour ne pas le casser, puis tassez-le légèrement sur la préparation."
                            }
                        ]
                    }
