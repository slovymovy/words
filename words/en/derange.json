{
    "word_family": [
        "derangement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28f84d4d-9a94-3dc5-a84a-ecae21a908ec",
                    "sense_definition": "To cause someone to go insane or lose their mental balance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The extreme isolation and fear began to <w>derange</w> his mind over the long winter months.",
                            "target_lang_translations": {
                                "ru": "Крайняя изоляция и страх за долгие зимние месяцы начали <w>помрачать</w> его разум."
                            }
                        },
                        {
                            "text": "Tragic grief threatened to completely <w>derange</w> the young soldier.",
                            "target_lang_translations": {
                                "ru": "Трагическое горе грозило окончательно <w>свести с ума</w> молодого солдата."
                            }
                        }
                    ],
                    "synonyms": [
                        "crazify",
                        "unhinge"
                    ],
                    "common_phrases": [
                        "derange the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сводить с ума, лишать душевного или психического равновесия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сводить с ума",
                                "target_lang_sense_clarification": "лишать рассудка"
                            },
                            {
                                "target_lang_word": "помрачать рассудок",
                                "target_lang_sense_clarification": "о разуме, сознании"
                            },
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "нарушать психическое равновесие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a7833d2-b7c7-38a7-b0ca-63201dfbcfc6",
                    "sense_definition": "To throw something into confusion or disorder; to disturb the regular arrangement of.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic crisis threatened to <w>derange</w> the natural distribution of resources.",
                            "target_lang_translations": {
                                "ru": "Внезапный экономический кризис угрожал <w>расстроить</w> естественное распределение ресурсов."
                            }
                        },
                        {
                            "text": "Sudden gusts of wind would <w>derange</w> the neat piles of documents on her desk.",
                            "target_lang_translations": {
                                "ru": "Внезапные порывы ветра <w>приводили в беспорядок</w> аккуратные стопки документов на её столе."
                            }
                        }
                    ],
                    "synonyms": [
                        "disarrange",
                        "disorder",
                        "disorganize"
                    ],
                    "antonyms": [
                        "arrange",
                        "order"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English for physical disorder"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в беспорядок или замешательство; нарушать привычное расположение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "нарушать порядок, систему"
                            },
                            {
                                "target_lang_word": "приводить в беспорядок",
                                "target_lang_sense_clarification": "о вещах или расположении"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "о структуре или порядке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "939af526-11d9-302b-91ca-1d65f051b610",
                    "sense_definition": "To disrupt someone's plans or schedule; to cause inconvenience to.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope my late arrival does not <w>derange</w> your evening plans in any way.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, моё позднее прибытие никоим образом не <w>расстроит</w> ваши планы на вечер."
                            }
                        },
                        {
                            "text": "The unexpected blizzard managed to <w>derange</w> the entire railway timetable for days.",
                            "target_lang_translations": {
                                "ru": "Неожиданная метель умудрилась на несколько дней <w>нарушить</w> всё расписание движения поездов."
                            }
                        }
                    ],
                    "synonyms": [
                        "disrupt",
                        "inconvenience"
                    ],
                    "common_phrases": [
                        "derange plans"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Срывать, расстраивать чьи-либо планы или график; создавать неудобства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "о планах, намерениях"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "о графике, расписании"
                            },
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "делать невозможным выполнение планов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69e261d8-2a76-395d-94c1-4e35ec9754be",
                    "sense_definition": "To cause a machine, mechanism, or organ to malfunction or become inoperative.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A severe electrical surge can easily <w>derange</w> the sensitive navigation instruments.",
                            "target_lang_translations": {
                                "ru": "Сильный скачок напряжения может легко <w>вывести из строя</w> чувствительные навигационные приборы."
                            }
                        },
                        {
                            "text": "Excessive pressure will <w>derange</w> the delicate internal mechanism of the clock.",
                            "target_lang_translations": {
                                "ru": "Чрезмерное давление <w>расстроит</w> тонкий внутренний механизм часов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern contexts outside specialized or historical texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить к сбою или выходу из строя механизм, прибор или орган."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "нарушать нормальную работу механизма"
                            },
                            {
                                "target_lang_word": "выводить из строя",
                                "target_lang_sense_clarification": "ломать, делать неработоспособным"
                            },
                            {
                                "target_lang_word": "нарушать работу",
                                "target_lang_sense_clarification": "о механизме или функции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}