                    },
                    {
                        "sense_id": "1d015cb2-9308-3f27-be43-e5edaf2b3968",
                        "entry_id": "83001e65-79b4-3885-b581-c6cbad836918",
                        "glosses": [
                            "weibliche Person, für die man freundschaftliche oder Liebesgefühle entwickelt hat"
                        ],
