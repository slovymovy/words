    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45dff4a5-7005-3cbf-a8e9-54563ff45816",
                "word": "woodwind",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d06c82f5-1a3d-47f9-8000-afca1e5481df",
                        "entry_id": "45dff4a5-7005-3cbf-a8e9-54563ff45816",
                        "tags": [
