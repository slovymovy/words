                                        "entry_id": "920dab75-f67b-3c05-8f97-169b6f3e4681",
                                        "glosses": [
                                            "нахождение, личное пребывание в конкретном месте в данный момент"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cd5ee17-4d1d-4fc9-97ba-347a7936382f",
                                                "sense_id": "92248b17-db11-3125-9db1-4980f5cce772",
                                                "text": "Карл Иванович… Портил всякий разговор своим присутствием."
                                            },
                                            {
                                                "example_id": "ac5a2c10-6ef4-4ba4-950f-1ceb716a0a97",
                                                "sense_id": "92248b17-db11-3125-9db1-4980f5cce772",
                                                "text": "Ваше присутствие здесь неуместно."
                                            },
                                            {
                                                "example_id": "2c27383d-1e65-411b-a5c0-03151bb6379d",
                                                "sense_id": "92248b17-db11-3125-9db1-4980f5cce772",
                                                "text": "В моем присутствии."
                                            },
                                            {
                                                "example_id": "b6c625c9-90ac-4cf2-a586-031073c6814b",
                                                "sense_id": "92248b17-db11-3125-9db1-4980f5cce772",
                                                "text": "Он оскорбил его в присутствии всех."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b1b26d9-59e4-31c7-96e2-0a547bd01bbc",
                                        "entry_id": "920dab75-f67b-3c05-8f97-169b6f3e4681",
                                        "glosses": [
                                            "офиц., устар. выполнение служебных обязанностей в казённом учреждении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a89af3ec-7feb-4058-96d3-1b2d7f124e8d",
                                                "sense_id": "2b1b26d9-59e4-31c7-96e2-0a547bd01bbc",
                                                "text": "Сегодня в канцелярии присутствия нет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af3103c5-a5c2-3abb-93b7-97525491cf1a",
                                        "entry_id": "920dab75-f67b-3c05-8f97-169b6f3e4681",
                                        "glosses": [
                                            "истор. правительственное учреждение в дореволюционной России, а также помещение, занимаемое им ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "672f42cf-7c5d-4d56-938f-79a3b6e8d84b",
                                                "sense_id": "af3103c5-a5c2-3abb-93b7-97525491cf1a",
                                                "text": "Уездное по воинским делам присутствие."
                                            },
                                            {
                                                "example_id": "4d6ddc33-9224-4a27-9271-9413a1ab0233",
                                                "sense_id": "af3103c5-a5c2-3abb-93b7-97525491cf1a",
                                                "text": "В рекрутское присутствие привели его раздетого."
                                            },
                                            {
                                                "example_id": "07c0a57a-3077-4d2b-bb98-8577e1864bf0",
                                                "sense_id": "af3103c5-a5c2-3abb-93b7-97525491cf1a",
                                                "text": "Недели через две свезли его в рекрутское присутствие, да и забрили лоб."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
