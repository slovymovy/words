                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6dd6056-e3e4-3d5d-88c2-7e43055abffa",
                        "entry_id": "0adaae0e-5d38-3dba-96c2-485939c85901",
                        "glosses": [
                            "Hagard, stupéfait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d892cc7-e0c3-419f-9fe3-2c754ac0b299",
                                "sense_id": "c6dd6056-e3e4-3d5d-88c2-7e43055abffa",
                                "text": "Tel, dans un tourbillon de poussière et de bruit,\nMalgré les cavaliers pleins d’une clameur vaine,\nLe cortège effaré se disperse et s’enfuit."
                            },
                            {
                                "example_id": "ca0bca9b-a97e-4472-9b8b-f9ac11541c73",
                                "sense_id": "c6dd6056-e3e4-3d5d-88c2-7e43055abffa",
                                "text": "Elle tenait par la main Pépé, et Jean la suivait, tous les trois brisés du voyage, effarés et perdus au milieu du vaste Paris, (…)."
                            },
                            {
                                "example_id": "b93d495b-8251-4056-a0c6-46dd18d7c7f3",
                                "sense_id": "c6dd6056-e3e4-3d5d-88c2-7e43055abffa",
                                "text": "Ethel eut pour moi un regard effaré."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe036712-a2ce-33ff-bf85-1b079c1c23d8",
                        "entry_id": "0adaae0e-5d38-3dba-96c2-485939c85901",
                        "glosses": [
                            "Se dit d'un cheval debout sur ses pattes arrière et battant l’air des antérieures. À rapprocher d’acculé, cabré, effarouché, effrayé, forcené et furieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48e9bcb-22e3-473d-8560-1629fccbfd8b",
                                "sense_id": "fe036712-a2ce-33ff-bf85-1b079c1c23d8",
                                "text": "Écartelé : au I, d’argent, au cheval effaré de sable ; au II, du quartier des Barons militaires de l’Empire ; au III, parti d’azur, à la ruche d’or et d’azur à la croix d’or ; au IV, d’argent, à trois merlettes de sable, qui est du Baron Rémy Joseph Isidore Exelmans → voir illustration « cheval effaré »"
                            }
                        ]
                    }
                ],
