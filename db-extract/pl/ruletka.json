                    },
                    {
                        "form_id": "0a3382f8-57b4-4510-809f-b474effcfc5c",
                        "entry_id": "d807c99f-0fc5-3c1d-addc-6f9f26402e46",
                        "tags": [
                            "vocative",
                            "plural"
                        ],
                        "form": "ruletki"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a43c1c55-23e4-368e-9b29-e5e397b68b78",
                        "entry_id": "d807c99f-0fc5-3c1d-addc-6f9f26402e46",
                        "glosses": [
                            "gra hazardowa polegająca na obstawianiu, na którym polu obracającej się tarczy zatrzyma się poruszająca się kulka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68881125-2068-490d-acbb-169c9ccbe795",
                                "sense_id": "a43c1c55-23e4-368e-9b29-e5e397b68b78",
                                "text": "Ruletka internetowa to wyjątkowa gra, która łączy w sobie cechy gier hazardowych i losowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "dfe13321-2f28-3826-8fc0-21b3130b8218",
                        "entry_id": "d807c99f-0fc5-3c1d-addc-6f9f26402e46",
                        "glosses": [
                            "obrotowa tarcza podzielona na ponumerowane pola, używana do gry w ruletkę (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f28b2c1-1489-47fd-b5d5-681afa14f9b9",
                                "sense_id": "dfe13321-2f28-3826-8fc0-21b3130b8218",
                                "text": "Gość przy stole z ruletką z niedowierzaniem patrzył, jak kula zatrzymuje się na pięćdziesiątcetrójce."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6001acc8-c884-3a02-8977-49e188944b97",
                        "entry_id": "d807c99f-0fc5-3c1d-addc-6f9f26402e46",
                        "glosses": [
                            "sytuacja, której zakończenie trudno przewidzieć"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "0acce6c9-e027-489f-b804-acec3a25a1f4",
                                "sense_id": "6001acc8-c884-3a02-8977-49e188944b97",
                                "text": "Kwantowa ruletka dopuszcza też inne warianty, jak na przykład przemianę higsonu w cztery leptony — parę elektronów i parę mionów — przy udziale wirtualnego bozonu Z."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35886187-4380-4e67-ac7c-6c850bcd7792",
                        "source_entry_id": "d807c99f-0fc5-3c1d-addc-6f9f26402e46",
                        "source_sense_id": "a43c1c55-23e4-368e-9b29-e5e397b68b78",
                        "target_lang_word": "roulette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roulette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f32776e8-f9b3-3142-afae-b95b90c6f7f0",
                                        "entry_id": "6737724c-44ec-33ef-b66f-92753cfd5137",
                                        "glosses": [
                                            "A game of chance in which a small ball is made to move round rapidly on a circle divided off into numbered (usually red and black) spaces. When the ball stops, it indicates the result of a variety of wagers permitted by the game."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "254408ef-eccb-3c5f-a914-a4d5bb410d04",
                                        "entry_id": "6737724c-44ec-33ef-b66f-92753cfd5137",
                                        "glosses": [
                                            "An instance of risk-taking, especially when the downside exceeds the upside (contrary to the game of roulette where only the wager is lost)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4e33eb8-5455-4981-aa04-b8e2622493c7",
                                                "sense_id": "254408ef-eccb-3c5f-a914-a4d5bb410d04",
                                                "text": "By contrast giving treatments open-label slows everything down by leading us up blind alleys while playing roulette with our patients' lives."
                                            },
                                            {
                                                "example_id": "f3602c98-fc98-48cb-9a6c-22c646409a82",
                                                "sense_id": "254408ef-eccb-3c5f-a914-a4d5bb410d04",
                                                "text": "Doctors and health officials said that the WRC-TV documentary, \"DPT: Vaccine Roulette,\" emphasized the risks of the vaccine while ignoring the dangers of the disease, which has been almost wiped out in this country."
                                            },
                                            {
                                                "example_id": "13f317c5-4992-4cff-acc3-44f3a289a43c",
                                                "sense_id": "254408ef-eccb-3c5f-a914-a4d5bb410d04",
                                                "text": "They would all rather take their chances with the existing policy-making roulette rather than follow process discipline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c0cf96d-f30d-3135-b445-0275b8a1e4b6",
                                        "entry_id": "6737724c-44ec-33ef-b66f-92753cfd5137",
                                        "glosses": [
                                            "A small toothed wheel used by engravers to roll over a plate in order to produce rows of dots."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "734fa01f-b318-3127-a98c-1ba81092fe0b",
                                        "entry_id": "6737724c-44ec-33ef-b66f-92753cfd5137",
                                        "glosses": [
                                            "A similar wheel used to roughen the surface of a plate, as in making alterations in a mezzotint."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb42261d-55f2-3edb-a20f-124ad10bd0c4",
                                        "entry_id": "6737724c-44ec-33ef-b66f-92753cfd5137",
                                        "glosses": [
                                            "The locus of a point on a plane curve that rolls without slipping along another fixed plane curve."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f02e21d3-0527-30ef-a33a-7f26d777b8ad",
                                        "entry_id": "6737724c-44ec-33ef-b66f-92753cfd5137",
                                        "glosses": [
                                            "Any of the small incisions on a sheet of stamps, used as an alternative to perforations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a0d7b92-9922-3ad7-bde5-499dbe5b62ed",
                                        "entry_id": "6737724c-44ec-33ef-b66f-92753cfd5137",
                                        "glosses": [
                                            "A cylindrical curler for the hair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "roulette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "418bae3c-40ab-3b73-8ed8-ee04292a4283",
                                        "entry_id": "47314f25-d861-3045-adc8-f1e0b0bcd4e8",
                                        "glosses": [
                                            "To separate or decorate by incisions made with a small toothed wheel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "973c77cb-1256-42ca-bb68-e0ccc040f55f",
                                                "sense_id": "418bae3c-40ab-3b73-8ed8-ee04292a4283",
                                                "text": "to roulette a sheet of postage stamps"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5efff7b9-7cb3-4a6c-8c18-8f3b8d0e1f48",
