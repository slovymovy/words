                "entry_id": "92773524-919e-3223-986f-0f7b8dc03a21",
                "word": "childless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83a14af3-9d47-30c5-bb0c-cb60680bf6d2",
                        "entry_id": "92773524-919e-3223-986f-0f7b8dc03a21",
                        "glosses": [
                            "Not having any children."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5488bb11-9ffc-46b8-ab00-91a32257413f",
                                "sense_id": "83a14af3-9d47-30c5-bb0c-cb60680bf6d2",
                                "text": "I am a lone wolf, a solitary man, wandering through a world in which I have no part. I am wifeless—childless—who is it speaks of the childless as the dead twigs on the tree of life?"
                            },
                            {
                                "example_id": "5f727964-0e00-4b48-ae77-4e3bfdcc871a",
                                "sense_id": "83a14af3-9d47-30c5-bb0c-cb60680bf6d2",
                                "text": "“He’s a 70-year-old childless warmonger and he has no stake in the future of this country,” Dans said. “He is the very reason that MAGA started in the first place, and we only have to look at 2016 when he was a vehement Trump hater. A leopard doesn’t change its spots.”"
                            }
                        ]
                    }
                ],
