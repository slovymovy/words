                                "zh": "表格的左侧列包含了每一行的<w>行标题</w>。"
                            }
                        },
                        {
                            "text": "Make sure each <w>stub</w> clearly describes the data in its corresponding row.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что каждое <w>название строки</w> четко описывает данные в соответствующем ряду.",
                                "zh": "确保每个<w>行标题</w>都能清晰地描述其对应行的数据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sidehead"
                    ],
                    "common_phrases": [
                        "table stub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заголовок строки в таблице.",
                        "zh": "表格中每一行的标题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боковик",
                                "target_lang_sense_clarification": "заголовок строки таблицы"
