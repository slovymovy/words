                    },
                    {
                        "translation_id": "4f3d559f-3731-49bf-842f-e1b8164dd091",
                        "source_entry_id": "7ca02270-6ad5-3d69-9716-efa52a8c2d91",
                        "source_sense_id": "9b1b869e-7480-391e-9b48-6acf7aeaac81",
                        "source_sense_description": "to cry weakly",
                        "target_lang_word": "pleurnicher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleurnicher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                        "entry_id": "32add363-1c19-3aa2-a2cd-dde5f97111ba",
                                        "glosses": [
                                            "Affecter de pleurer, avoir un ton larmoyant, essayer de pleurer, comme les enfants qui veulent que l’on s’attendrisse et que l’on leur cède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebd775f0-c0bc-4e53-8eff-fbb474db8879",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "Un nouveau silence se fit. Mme Sidonie ne pleurnichait plus."
                                            },
                                            {
                                                "example_id": "59343719-df11-43fc-9b80-7147e9bb7e66",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "Ça ne sert à rien de pleurnicher comme tu le fais et du moment qu’on va arranger la chose…"
                                            },
                                            {
                                                "example_id": "16c1132e-d513-4768-b91d-2bd52b31f138",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "« Ils viendront solliciter en pleurnichant des dégrèvements d’impôts », me dit un fonctionnaire […] « et ils risquent au baccara, au chemin de fer, des fortunes tous les soirs. »"
                                            },
                                            {
                                                "example_id": "36a711c1-472d-430e-b37b-aa0e80616272",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "La mère, Rita, sosie de Greta Garbo, se gavait de chips et de massepains, se saoulait de Marie Brizard et procrastinait dans son lit. Elle pleurnichait, ruminait sa mauvaise fortune et celle de son mari, […]."
                                            },
                                            {
                                                "example_id": "046b72c7-3f0b-4138-9d66-5a166dafb657",
                                                "sense_id": "1cb46c45-a267-3d28-b7d9-a005b7033080",
                                                "text": "Enfin un joueur qui ne pleurniche pas et sait qu'il est cher payé pour se faire plaisir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff0e0253-30af-45e7-8730-830795251e3b",
                        "source_entry_id": "7ca02270-6ad5-3d69-9716-efa52a8c2d91",
                        "source_sense_id": "9b1b869e-7480-391e-9b48-6acf7aeaac81",
                        "source_sense_description": "to cry weakly",
                        "target_lang_word": "geindre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87e27940-8ca9-3996-8cd0-fdeb18c910af",
                                        "entry_id": "249fab40-3552-3702-9412-e2e54e993b76",
                                        "glosses": [
                                            "Se lamenter, gémir, se plaindre à diverses reprises d’une voix languissante et non articulée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e359458c-70b8-412b-8a26-49b47454d1e1",
                                                "sense_id": "87e27940-8ca9-3996-8cd0-fdeb18c910af",
                                                "text": "Les vieillards les plus débiles restaient dans leurs lits, et il n’y avait point de maison où l’on ne trouvât cinq ou six lits où geignaient les aïeuls."
                                            },
                                            {
                                                "example_id": "27433969-f30d-4761-8ab4-70e0bb61b54f",
                                                "sense_id": "87e27940-8ca9-3996-8cd0-fdeb18c910af",
                                                "text": "Elle recommença ses doléances, elle se mit à geindre de plus belle sur le manque de fortune qui la faisait échouer au port."
                                            },
                                            {
                                                "example_id": "b35f065c-a75a-455e-a7b7-cafa5b8c2776",
                                                "sense_id": "87e27940-8ca9-3996-8cd0-fdeb18c910af",
                                                "text": "[…], et il se mit en quête de la sœur Sainte-Marthe, qu'il ne rencontra qu'à l'autre bout de la salle, au chevet d'un blessé qui geignait et qu'elle s’évertuait à consoler."
                                            },
                                            {
                                                "example_id": "ee904a3c-435a-45ae-81c9-6b0179270024",
                                                "sense_id": "87e27940-8ca9-3996-8cd0-fdeb18c910af",
                                                "text": "Le court trajet du platane à sa chambre lui parut interminable ; et elle geignait involontairement, demandant à s’asseoir, à s’arrêter, accablée par une sensation intolérable de pesanteur dans le ventre."
                                            },
                                            {
                                                "example_id": "90ec7e03-222c-4e37-9934-f6fc7f249741",
                                                "sense_id": "87e27940-8ca9-3996-8cd0-fdeb18c910af",
                                                "text": "Évoquant sa nuit à Boucicaut, elle me dit : « Les femmes du peuple, tu sais comment elles geignent. » « Les infirmières, dans les hôpitaux, elles ne travaillent que pour l’argent. Alors… » C’étaient des phrases routinières, mécaniques comme la respiration, mais tout de même animées par sa conscience : impossible de les entendre sans gêne. Je m’attristais du contraste entre la vérité de son corps souffrant et les billevesées dont sa tête était farcie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "geindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c23190ae-57bd-39ba-83bb-cf35e90f569f",
                                        "entry_id": "12f52083-8eeb-3644-abe8-e1e52dc660ea",
                                        "glosses": [
                                            "Fait de se lamenter, de gémir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "471c4019-ed9f-4bb9-9c05-de147ee979b1",
                                                "sense_id": "c23190ae-57bd-39ba-83bb-cf35e90f569f",
                                                "text": "Ça semblait comme le geindre d’un nourrisson."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "geindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7c7153-e7fb-37dd-a51a-163ff32f8d2f",
                                        "entry_id": "34a4cae5-509a-3e0b-8614-4b18800a00d3",
                                        "glosses": [
                                            "Variante de gindre, ouvrier boulanger."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "807a41c0-8643-4983-973d-3c44d33374c2",
                                                "sense_id": "4e7c7153-e7fb-37dd-a51a-163ff32f8d2f",
                                                "text": "Et Mahoudeau exagérait ses brutalités voulues, les mains convulsées, ainsi qu’un geindre dont les poings pétriraient un monde"
                                            },
                                            {
                                                "example_id": "377576f9-9d0b-4d65-bd52-e41d04641970",
                                                "sense_id": "4e7c7153-e7fb-37dd-a51a-163ff32f8d2f",
                                                "text": "Avoue-toi cela, Vingtras ; ne mets pas à ton acquit la pâleur qui t’a envahi la face devant le geindre fusillé !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
