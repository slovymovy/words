                                    },
                                    {
                                        "sense_id": "63ebc7eb-151a-32ce-acdf-d70645045296",
                                        "entry_id": "cdbeda0f-c191-3ac1-a634-439746adf46d",
                                        "glosses": [
                                            "speziell der Gewöhnliche Beifuß, Artemisia vulgaris"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "686c97a7-b03f-4459-a1df-3cbc75492927",
                                                "sense_id": "63ebc7eb-151a-32ce-acdf-d70645045296",
                                                "text": "Beifuß wächst gerne auf Brachflächen und Baustellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc078499-550b-338a-af46-78ea5d9a931a",
                                        "entry_id": "cdbeda0f-c191-3ac1-a634-439746adf46d",
                                        "glosses": [
                                            "Küchengewürz aus den Blütenständen von [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324218b3-61df-4a54-8530-0b421fe983ca",
                                                "sense_id": "cc078499-550b-338a-af46-78ea5d9a931a",
                                                "text": "Fette Fleischgerichte würzt man mit Beifuß."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d865540-4b04-4646-8cca-1ec0423234f9",
