                        "glosses": [
                            "boek waarin de notulen van vergaderingen worden opgeschreven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc3b9e9-2438-4d88-979e-dc454e7eca49",
                                "sense_id": "e90aeadf-9c51-3ba4-8a7e-8551746c7fb5",
                                "text": "Het topstuk is het notulenboek van de vereniging, met alle verslagen uit de beginperiode tot de jaren negentig."
                            },
                            {
                                "example_id": "8fdb5522-2ea0-48d4-9b48-3933782b1414",
                                "sense_id": "e90aeadf-9c51-3ba4-8a7e-8551746c7fb5",
                                "text": "„In het notulenboek lees je over jaren met 20.000 bezoekers, kun je nagaan hoe de ijsbaan in trek was. Lekker beschut in het bos en er was altijd een fijne sfeer.”"
                            },
                            {
                                "example_id": "7050ec6c-83aa-48e7-a08b-0cb535d80c9e",
                                "sense_id": "e90aeadf-9c51-3ba4-8a7e-8551746c7fb5",
                                "text": "In het notulenboek van het Maria-lyceum is op 27 maart 1945 te lezen dat er één leerlinge te betreuren viel. Geen woord over de joodse meisjes. Ze bestonden na hun afscheid op school gewoon niet meer."
                            }
                        ]
                    }
