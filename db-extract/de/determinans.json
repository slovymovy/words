                "senses": [
                    {
                        "sense_id": "fc6dce66-1344-3c1d-a466-f02f42ecf049",
                        "entry_id": "1b5157e3-71cc-3c82-94ca-261a6d46a75a",
                        "glosses": [
                            "Erster Teil eines Determinativkompositums"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "095ff8a0-aad2-42a8-b29a-e733e9cbe1f9",
                                "sense_id": "fc6dce66-1344-3c1d-a466-f02f42ecf049",
                                "text": "„Dampfschiff“ ist ein \"Determinativkompositum\", bei dem das Determinans „Dampf“ das \"Determinatum\" „Schiff“ näher bestimmt und z.B. von \"Segelschiff\", \"Schulschiff\" etc. unterscheidet."
                            },
                            {
                                "example_id": "92445244-2930-491d-b2dc-3ba98d8e5330",
                                "sense_id": "fc6dce66-1344-3c1d-a466-f02f42ecf049",
                                "text": "„Offenbar gibt es während der 1. Zeitscheibe und wahrscheinlich schon viel früher einen produktiven Wortbildungsprozess, der fremde Determinantien auf nativen Basen operieren lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc7b03ee-54cc-32dd-bae8-a77d83897964",
                        "entry_id": "1b5157e3-71cc-3c82-94ca-261a6d46a75a",
                        "glosses": [
                            "der Teil einer Wortgruppe, der einen anderen näher bestimmt."
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "b5e128e3-2de8-4d61-8af7-ca26f950292d",
                                "sense_id": "cc7b03ee-54cc-32dd-bae8-a77d83897964",
                                "text": "In der Wortgruppe \"der Junge\" ist \"der\" Determinans zu \"Junge\"."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d35e0979-c2a8-4ca3-8d64-999ef45edd6d",
                        "source_entry_id": "1b5157e3-71cc-3c82-94ca-261a6d46a75a",
                        "source_sense_id": "cc7b03ee-54cc-32dd-bae8-a77d83897964",
                        "source_sense_description": "Teil einer Wortgruppe, der einen anderen näher bestimmt",
                        "target_lang_word": "determiner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "determiner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "Someone or something that determines, or helps to determine, something else.",
                                            "A factor that defines something, or one among several that define it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "974c854a-bc71-4e99-9c84-05b36213291f",
                                                "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                                "text": "Near-synonym: definer"
                                            },
                                            {
                                                "example_id": "31f0b0e2-9b2c-435d-a4d3-a9dbfd00fade",
                                                "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                                "text": "In quality management, the determiners of quality sometimes differ across use cases."
                                            },
                                            {
                                                "example_id": "9103ef97-90d7-4377-8a59-c4f7433fe465",
                                                "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                                "text": "The \"steel-yards\" and \"measures\" were the only determiners of weight and quantity — as the hour-glass and sun dial were of time — possessed at first (so far as appears) by the passengers of the Pilgrim ship […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "Someone or something that determines, or helps to determine, something else.",
                                            "Someone or something (especially a sentient agent) that determines; a decider of a disposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c506831a-1491-4ca0-bc93-13329e02d75c",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "The software is the determiner if no input is given before the prompt times out."
                                            },
                                            {
                                                "example_id": "704fa524-b976-463f-93fb-cc6df5b50552",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "Near-synonyms: decider, decisor, disposer, definer, arbiter, arbitrator, decisionmaker"
                                            },
                                            {
                                                "example_id": "e3e85424-9830-4d69-86d3-4e82756b82d0",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "He is the determiner [usually referring to God (in theological contexts) and job roles (in administrative contexts)]"
                                            },
                                            {
                                                "example_id": "f7961e6f-478c-4a08-a6b6-cfb7a04d4205",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "Who is the determiner? [administratively or theologically]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e1ff242-19fc-32e2-a4c7-166b63cb6818",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "A member of a class of words functioning in a noun phrase to identify or distinguish a referent without describing or modifying it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0d98f5-3464-4612-a6f5-155124feb309",
                                                "sense_id": "1e1ff242-19fc-32e2-a4c7-166b63cb6818",
                                                "text": "Definite articles, indefinite articles, and cardinal numbers acting as quantifiers are types of determiners."
                                            },
                                            {
                                                "example_id": "07305908-b299-4ce1-a613-6a07d60fb56a",
                                                "sense_id": "1e1ff242-19fc-32e2-a4c7-166b63cb6818",
                                                "text": "Near-synonym: determinative (broadly synonymous)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac838aa1-e712-33e2-b379-fa9811a37543",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "A dependent function in a noun phrase that marks it as definite or indefinite. This function is usually filled by words in the determinative class but may be filled by other elements such as a genitive pronoun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8b89d7-f50c-4e31-8681-fcccd3abde4f",
                                                "sense_id": "ac838aa1-e712-33e2-b379-fa9811a37543",
                                                "text": "Near-synonym: determinative (broadly synonymous)"
                                            },
                                            {
                                                "example_id": "675b29b7-5cf1-465a-9c27-7119db39bc99",
                                                "sense_id": "ac838aa1-e712-33e2-b379-fa9811a37543",
                                                "text": "In the sentence \"Many people voted for him,\" the word many is a determiner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "222f2176-53f4-4066-bcf7-3b4376d54ed9",
                        "source_entry_id": "1b5157e3-71cc-3c82-94ca-261a6d46a75a",
