                                                "sense_id": "b2ff2be6-4676-3115-9e02-e1c6cb0aa180",
                                                "text": "Der schönste Junge der Welt ist Patrick."
                                            },
                                            {
                                                "example_id": "fd8b63a6-01f0-432b-9d99-546718d3f6b9",
                                                "sense_id": "b2ff2be6-4676-3115-9e02-e1c6cb0aa180",
                                                "text": "Der Patrick hat die Franziska lieb."
                                            },
                                            {
                                                "example_id": "c71132be-1c9c-4927-a5be-ae2451c96e98",
                                                "sense_id": "b2ff2be6-4676-3115-9e02-e1c6cb0aa180",
