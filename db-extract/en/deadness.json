                        "entry_id": "6a729577-dd4e-31c9-aae1-8862912bfcc8",
                        "glosses": [
                            "The state of not being alive; lifelessness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a0f50980-30e5-4390-8429-7b0d7f3c56eb",
                                "sense_id": "bebccb31-6ed3-35da-8ade-38fe5ed1fe43",
                                "text": "O may it be my constant care to watch and pray; the neglect of which was the chief cause of my former deadness."
                            }
                        ]
                    },
                    {
                        "sense_id": "06e250ca-cc57-339a-b019-1c581fb56135",
                        "entry_id": "6a729577-dd4e-31c9-aae1-8862912bfcc8",
                        "glosses": [
                            "A lack of elasticity."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8f7adf0c-a599-4f3d-aa8c-77297fd77be1",
                                "sense_id": "06e250ca-cc57-339a-b019-1c581fb56135",
                                "text": "He complained that the deadness of the balls affected his game."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e158779-0412-37fe-b622-a2cb826be0e0",
                        "entry_id": "6a729577-dd4e-31c9-aae1-8862912bfcc8",
                        "glosses": [
                            "A lack of sparkle in a fizzy drink."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f37545bd-564f-401d-9727-0d2965bec4ae",
                                "sense_id": "0e158779-0412-37fe-b622-a2cb826be0e0",
                                "text": "The deadness of the champagne made it undrinkable."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb76676c-543e-305e-9a28-3af5a69177c5",
                        "entry_id": "6a729577-dd4e-31c9-aae1-8862912bfcc8",
                        "glosses": [
                            "A lack of animation in a person."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "506db213-a6ff-4d2f-a06d-636bd46c9798",
                                "sense_id": "fb76676c-543e-305e-9a28-3af5a69177c5",
                                "text": "The deadness of his expression told everything, without him having to speak."
                            }
                        ]
                    }
