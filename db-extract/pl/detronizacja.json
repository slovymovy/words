                                        "glosses": [
                                            "Removal from a superior place in a hierarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6cb81ea-0713-473e-b452-6723d7ff95d4",
                                                "sense_id": "943fdcdd-4c47-32b3-9d66-a643ab0e3a04",
                                                "text": "I felt the first inkling of a thing that presently grew quite clear in my mind, that oppressed me for many days, a sense of dethronement, a persuasion that I was no longer a master, but an animal among the animals, under the Martian heel."
                                            }
                                        ]
