                                "target_senses": [
                                    {
                                        "sense_id": "75d1ac1c-d2dc-356e-b8d7-7b07625cd87e",
                                        "entry_id": "d516afbd-3dd5-36a7-9512-60be6dab9707",
                                        "glosses": [
                                            "zu jeder Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5067d448-d7ef-4698-9c1e-4b968a4789ff",
                                                "sense_id": "75d1ac1c-d2dc-356e-b8d7-7b07625cd87e",
                                                "text": "Er blieb ihr immer treu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebb591a4-00ba-3e09-8d24-79a981ffb462",
                                        "entry_id": "d516afbd-3dd5-36a7-9512-60be6dab9707",
                                        "glosses": [
                                            "in häufig wiederkehrenden Intervallen; immer wenn: jedes Mal, wenn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36ea16b4-76da-4676-910c-f65167838ccb",
                                                "sense_id": "ebb591a4-00ba-3e09-8d24-79a981ffb462",
                                                "text": "Warum rennst du denn immer so?"
                                            },
                                            {
                                                "example_id": "fa2cde0f-5c33-44bf-b26e-037f325093fa",
                                                "sense_id": "ebb591a4-00ba-3e09-8d24-79a981ffb462",
                                                "text": "Immer wenn ich ihn treffe, grüßt er freundlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4eeda3ab-23e9-3291-bd09-ccc5c6cda5a2",
                                        "entry_id": "d516afbd-3dd5-36a7-9512-60be6dab9707",
                                        "glosses": [
                                            "weist auf eine beständige Steigerung hin"
                                        ],
                                        "tags": [
                                            "mit Komparativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26710e1-57ee-4929-92cf-7aa8f1d4cffd",
                                                "sense_id": "4eeda3ab-23e9-3291-bd09-ccc5c6cda5a2",
                                                "text": "Immer häufiger gehören die Senioren zu den Opfern."
                                            },
                                            {
                                                "example_id": "28917330-85e9-4f8e-8cb7-618feef8aa77",
                                                "sense_id": "4eeda3ab-23e9-3291-bd09-ccc5c6cda5a2",
                                                "text": "Insgesamt wird es auf der Erde immer wärmer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a453d29-3ec3-4db8-b6dc-9a08c1dc77f0",
                        "source_entry_id": "93573d8a-cac8-360f-aebb-dabf9e9bab53",
                        "source_sense_id": "a8f21ccc-e24a-36f8-af99-5c4be2c18feb",
                        "source_sense_description": "op ieder moment",
                        "target_lang_word": "stets",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stets",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33336020-9929-3a25-b6b8-bf23cd7e194a",
                                        "entry_id": "831fdc90-20a7-3a8d-b7ff-533475f2cea4",
                                        "glosses": [
                                            "zu jeder Zeit, immer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c9b1da-27c0-4415-85e7-5d96bacf8cc8",
                                                "sense_id": "33336020-9929-3a25-b6b8-bf23cd7e194a",
                                                "text": "Er ist stets hungrig."
                                            },
                                            {
                                                "example_id": "c65451d6-dba4-4f53-badb-447bacd1c9af",
                                                "sense_id": "33336020-9929-3a25-b6b8-bf23cd7e194a",
                                                "text": "„Stets war es ihr wichtig gewesen, nicht aufzufallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15825168-efad-39b4-87f2-e0b77b81b912",
                                        "entry_id": "831fdc90-20a7-3a8d-b7ff-533475f2cea4",
                                        "glosses": [
                                            "bei jedem Anlass, jedes Mal, immer wieder"
                                        ],
                                        "tags": [
                                            "iterativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e70d6e-c7ef-4f76-8cad-694ab7239f4f",
                                                "sense_id": "15825168-efad-39b4-87f2-e0b77b81b912",
                                                "text": "„Unfälle sind keine Zufälle, wie so manche Zeitungsnotiz verharmlosend wahrhaben möchte. Unfälle entstehen stets im Zusammenlaufen mehrerer Kausallinien, im Schnittpunkt einer Reihe ungünstiger Umstände und Fehlverhaltensweisen.“"
                                            },
                                            {
                                                "example_id": "b984434a-3a7a-4ec8-916b-292ecae64924",
                                                "sense_id": "15825168-efad-39b4-87f2-e0b77b81b912",
                                                "text": "Bei Föhnwetter bekommt er stets Kopfschmerzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
