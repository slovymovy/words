                ],
                "senses": [
                    {
                        "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                        "entry_id": "bcebf55f-d831-3440-9b23-9c9a42a25013",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "786282f8-d29e-497f-aaed-3d5ae5b4e1e0",
                                "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                                "text": "Die Finkenbeiners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "23ca5f09-6baf-4685-8bbb-c8c4b10f67a0",
                                "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                                "text": "Herr Finkenbeiner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "da9850eb-59ea-4dd0-bf1b-3810bbfff746",
                                "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                                "text": "Frau Finkenbeiner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "27fbc12e-a00b-4dd5-9a56-e7ef33e1a29b",
                                "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                                "text": "Der Finkenbeiner trägt nie die Schals, die die Finkenbeiner ihm strickt."
                            },
                            {
                                "example_id": "c311d568-c65a-41e0-84cb-9e2ae9dccaa0",
                                "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finkenbeiner kommt, geht der Herr Finkenbeiner.“"
                            },
                            {
                                "example_id": "bea849d0-448a-43b3-8006-2eee461ed7fd",
                                "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                                "text": "Finkenbeiner kommt und geht."
                            },
                            {
                                "example_id": "81421530-8c4e-4b1f-b7bc-648e7d0411fb",
                                "sense_id": "7961db47-a36f-3437-bdda-c0e61e701ece",
                                "text": "Finkenbeiners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
