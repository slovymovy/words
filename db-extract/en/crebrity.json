                                "example_id": "c4ec05bc-286a-4870-a36d-5233d2c6b023",
                                "sense_id": "66fb8f51-c19f-3ede-9cee-c1eb769287b9",
                                "text": "And this we conceive more than sufllicient evidence of the verity of the first part of our thesis; that a Sound is not generated in the air by the velocity, but crebrity of motion."
                            }
