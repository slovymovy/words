                    {
                        "sense_id": "1d12efa6-630f-386f-8fd9-0aebb0743162",
                        "entry_id": "6c85b468-c147-37e2-8f75-c5c0b1890076",
                        "glosses": [
                            "Celui qui brûle de l’encens dans un encensoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e060e613-d8ad-46dd-9f91-a0d5cf6afb5c",
                                "sense_id": "1d12efa6-630f-386f-8fd9-0aebb0743162",
                                "text": "Deux encenseurs se retournaient à chaque pas vers le Saint-Sacrement, que portait, sous un dais de velours ponceau tenu par quatre fabriciens, M. le curé, dans sa belle chasuble."
                            },
                            {
                                "example_id": "3fb8f286-8bcb-4c85-b476-092c0d27a46a",
                                "sense_id": "1d12efa6-630f-386f-8fd9-0aebb0743162",
                                "text": "Il eut une longue conversation avec un encenseur."
                            }
                        ]
                    },
                    {
                        "sense_id": "84a0d169-9c93-32e1-8aca-92f833a2a15d",
                        "entry_id": "6c85b468-c147-37e2-8f75-c5c0b1890076",
                        "glosses": [
                            "Celui qui encense, fait des éloges, des compliments."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1c11985a-3640-4b76-a0c5-87bd0677a10c",
                                "sense_id": "84a0d169-9c93-32e1-8aca-92f833a2a15d",
                                "text": "On n'en serait pas là si lui comme moi ne disions pas des choses sur le plateau de Ruquier qui perturbent les encenseurs."
                            }
                        ]
                    }
                ],
