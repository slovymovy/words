                "senses": [
                    {
                        "sense_id": "6fc91c29-7d30-3879-8e5e-bcbd8e1e8ab2",
                        "entry_id": "837267db-6568-3dbf-9716-ed208345da85",
                        "glosses": [
                            "Someone or something that wastes; someone who squanders or spends extravagantly."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f3ccf3fa-99c1-3a52-9664-4909b406152e",
                        "entry_id": "837267db-6568-3dbf-9716-ed208345da85",
                        "glosses": [
                            "An imperfection in the wick of a candle, causing it to waste."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b4ce5b91-8bbc-3874-882c-43172c2e462f",
                        "entry_id": "837267db-6568-3dbf-9716-ed208345da85",
                        "glosses": [
                            "A destroyer or plunderer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "79383f39-ab7a-4343-9dda-d3d6698b2526",
                                "sense_id": "b4ce5b91-8bbc-3874-882c-43172c2e462f",
                                "text": "He also that is slothful in his work is brother to him that is a great waster."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffb19663-87e1-305a-8877-7d204b6b842c",
                        "entry_id": "837267db-6568-3dbf-9716-ed208345da85",
                        "glosses": [
                            "An item that is spoiled during its manufacture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174a0315-196b-40fb-855a-2c2b7bf5fb7c",
                                "sense_id": "ffb19663-87e1-305a-8877-7d204b6b842c",
                                "text": "Unless the cast was very hot indeed, the steel would refuse to ascend, and a great many wasters were caused thereby."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29310168-6201-418a-af19-676f17ad70d2",
                        "source_entry_id": "837267db-6568-3dbf-9716-ed208345da85",
                        "source_sense_description": "one that wastes",
                        "target_lang_word": "verkwister",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verkwister",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0d9eddbc-7942-32d9-a8b3-ef633edad43b",
                                        "entry_id": "c566e3f3-f5f3-3e1d-ba50-87dda57b8120",
                                        "glosses": [
                                            "iemand die waardevolle zaken niet voor nuttige zaken gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17149b13-bc4d-4453-914b-5debfa5cfb1b",
                                                "sense_id": "0d9eddbc-7942-32d9-a8b3-ef633edad43b",
                                                "text": "Ik geef een voorbeeld. Ik noem de vrek en de verkwister. De één pot zijn geld op, de ander smijt het over de balk. Het zijn twee uitersten en toch behoren ze allebei tot het rijk van de duivel."
                                            },
                                            {
                                                "example_id": "d635e9e8-4936-473d-b028-c0e01c9e7d60",
                                                "sense_id": "0d9eddbc-7942-32d9-a8b3-ef633edad43b",
                                                "text": "De afgelopen maanden kreeg Bouterse veel kritiek, omdat zijn regering veel meer geld uitgeeft dan er inkomsten zijn. Ook loopt de overheid fors achter met betalingen aan derden zoals aannemers en andere dienstverleners. Dit leidde tot onrust op de valutamarkt waardoor de Centrale Bank zich half september genoodzaakt zag enkele monetaire maatregelen te nemen en de overheid tot zuinigheid te manen. Politieke tegenstanders van Bouterse maken dankbaar gebruik van deze ontwikkelingen door de regering als 'verkwisters en graaiers'af te schilderen."
                                            },
                                            {
                                                "example_id": "99bd37c6-86a2-4798-b9fb-36fa2cf9a471",
                                                "sense_id": "0d9eddbc-7942-32d9-a8b3-ef633edad43b",
                                                "text": "\"Nog even en ECB-president Mario Draghi kondigt nul procent rente af.\"Volgens Jeanne Dijkstra kunnen Nederlanders hun centen beter opmaken in plaats van sparen. \"Spaarzame Nederlanders zijn knettergek als zij zich laten bestelen door de ECB, die verkwisters prefereert boven spaarders.\"Bent u met deze lezer eens? laat het ons weten in een reactie."
                                            },
                                            {
                                                "example_id": "707d4b3f-888d-4f23-a3e2-8acd11183cdb",
                                                "sense_id": "0d9eddbc-7942-32d9-a8b3-ef633edad43b",
                                                "text": "‘Verkwisting’ is door een wetswijziging een reden voor beschermingsbewind geworden. Daarbij gaat het erom dat de ‘verkwister’ de gewoonte heeft boven zijn stand te leven en daardoor niet goed in zijn eigen onderhoud kan voorzien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e565a20a-7977-4b1b-9ee1-369f051bcfaf",
                        "source_entry_id": "837267db-6568-3dbf-9716-ed208345da85",
                        "source_sense_description": "one that wastes",
                        "target_lang_word": "gaspilleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaspilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2951f8db-f385-3f73-af16-e9abc8dc96c5",
                                        "entry_id": "7c98527f-80f3-3b3b-a2f5-c4ff9f641646",
                                        "glosses": [
                                            "Celui qui gaspille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2111ae0-cbf4-4fe4-99aa-5b7889352584",
                                                "sense_id": "2951f8db-f385-3f73-af16-e9abc8dc96c5",
                                                "text": "On en a conclu que ce prince avait été un gaspilleur sans cervelle et sans probité qui avait ruiné son pays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaspilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db2859b7-5585-3adb-975e-f33371301db4",
                                        "entry_id": "ffc11445-781f-35f0-95c5-18184e5eab61",
                                        "glosses": [
                                            "Qui gaspille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53cc5751-4876-4723-8a6c-41d2e82695d1",
                                                "sense_id": "db2859b7-5585-3adb-975e-f33371301db4",
                                                "text": "Ces goûts de courtisane, Valérie les tenait de sa mère, comblée par le général Montcornet pendant les séjours qu’il faisait à Paris, et qui, pendant vingt ans, avait vu tout le monde à ses pieds ; qui, gaspilleuse, avait tout dissipé, tout mangé dans cette vie luxueuse dont le programme est perdu depuis la chute de Napoléon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07a038bc-1be3-4b26-b44d-cbb89551a4f3",
                        "source_entry_id": "837267db-6568-3dbf-9716-ed208345da85",
                        "source_sense_description": "one that wastes",
                        "target_lang_word": "gaspilleuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaspilleuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f31b43e6-609a-3501-b6b9-1384955cde99",
                                        "entry_id": "52ba96f2-e0f9-31c8-8400-a19b71acbefa",
                                        "glosses": [
                                            "Celle qui gaspille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939ab2c8-3185-4fe2-956f-8fbe7bde643c",
                                                "sense_id": "f31b43e6-609a-3501-b6b9-1384955cde99",
                                                "text": "Le soir, quand mon père revient du travail, sa mère lui dit qu’il a épousé une gaspilleuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ea39231-6869-4183-9f50-ecca20571d32",
