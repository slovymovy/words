                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d028d35-6d60-4791-9542-e80975282aa2",
                        "source_entry_id": "b31638f9-5a8e-3237-af9c-0a63d75beb0d",
                        "source_sense_id": "2100ffee-c5f5-3ad2-9990-316dde0f6329",
                        "source_sense_description": "weibliche Person, die Tätigkeiten mit der rechten und der linken Hand genau gleich gut ausüben kann",
                        "target_lang_word": "ambidextrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambidextrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "758461a0-323b-3934-bc25-6a52a07a2960",
                                        "entry_id": "766c6733-4585-35e5-8803-c80d824ca5d9",
                                        "glosses": [
                                            "Having equal or comparable ability in both hands; in particular, able to write well with both hands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c68dc249-bff9-4651-a8dc-144ee48bb065",
                                                "sense_id": "758461a0-323b-3934-bc25-6a52a07a2960",
                                                "text": "Some are […]ambidextrous or right-handed on both sides; which happeneth only unto strong and athletical bodies, whose heat and spirits are able to afford an ability unto both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5940df61-b499-320f-9e7d-9c0a3c48e0cc",
                                        "entry_id": "766c6733-4585-35e5-8803-c80d824ca5d9",
                                        "glosses": [
                                            "Equally usable by left-handed and right-handed people (as a tool or instrument)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3bbb1e8-67f1-32ab-98a6-d7ee1c2f0265",
                                        "entry_id": "766c6733-4585-35e5-8803-c80d824ca5d9",
                                        "glosses": [
                                            "Practising or siding with both parties."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8ec8713-4a42-4c27-b881-abfa54350581",
                                                "sense_id": "b3bbb1e8-67f1-32ab-98a6-d7ee1c2f0265",
                                                "text": "All False, Shuffling, and Ambidextrous Dealings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f157171-7dbb-3aaa-88e5-25aa734a730a",
                                        "entry_id": "766c6733-4585-35e5-8803-c80d824ca5d9",
                                        "glosses": [
                                            "Of a person, bisexual."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "176d56f9-3888-36d6-a38b-82fdc9853730",
                                        "entry_id": "766c6733-4585-35e5-8803-c80d824ca5d9",
                                        "glosses": [
                                            "Exceptionally skillful; adept in more than one medium, genre, style, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f98d8b-fc6d-40df-8b99-506372fe952b",
                                                "sense_id": "176d56f9-3888-36d6-a38b-82fdc9853730",
                                                "text": "Michelangelo was a very ambidextrous artist, producing sculptures and frescoes with equal ability."
                                            },
                                            {
                                                "example_id": "367ec402-f0e4-4c5c-ac41-7b7c87fef753",
                                                "sense_id": "176d56f9-3888-36d6-a38b-82fdc9853730",
                                                "text": "For years, by every possible device, we have been raising the prices of our agricultural products against the foreign buyers […] by every device known to the ambidextrous tradesman and financier. The result is that we have raised up other and unexpected competitors in the markets of the world."
                                            },
                                            {
                                                "example_id": "221407e3-26f9-48d1-802c-6c79fe1041f3",
                                                "sense_id": "176d56f9-3888-36d6-a38b-82fdc9853730",
                                                "text": "In a footnote, these admirers will often bemoan Agee as a Renaissance or at least ambidextrous artist in an age of specialization, a vast and turbulent ocean syphoned off through a garden hose; not just a novelist manque but also a frustrated […]"
                                            },
                                            {
                                                "example_id": "76ae81dd-eb09-405a-92ef-be32cd7f8791",
                                                "sense_id": "176d56f9-3888-36d6-a38b-82fdc9853730",
                                                "text": "He also played the piano and violin, was an ambidextrous artist, and enjoyed acting. Holidays were spent yachting or canoeing or with his brothers. By 1903, Baden-Powell's military training manual, Aids to Scouting, had become a best-seller,[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f7c0c6d-c92d-4f53-8f7b-3a540bf4fd23",
                        "source_entry_id": "b31638f9-5a8e-3237-af9c-0a63d75beb0d",
                        "source_sense_id": "2100ffee-c5f5-3ad2-9990-316dde0f6329",
                        "source_sense_description": "weibliche Person, die Tätigkeiten mit der rechten und der linken Hand genau gleich gut ausüben kann",
                        "target_lang_word": "ambidextre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambidextre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                        "entry_id": "fd76c93c-d2af-3471-aad6-9efce6c5e375",
                                        "glosses": [
                                            "Qui se sert des deux mains avec une égale facilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46073278-1a53-46c0-9019-8bb168a1cb09",
                                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                                "text": "Homme ambidextre."
                                            },
                                            {
                                                "example_id": "b10aa668-b195-4b3e-aec5-1f0e8039a24e",
                                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                                "text": "Femme ambidextre."
                                            },
                                            {
                                                "example_id": "4465edb6-1e5a-4fd1-bd63-e585971d84f8",
                                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                                "text": "Après guerre, lʼutopie ambidextre est bel et bien passée de mode."
                                            },
                                            {
                                                "example_id": "5d58533f-8e76-4a94-bc62-6c09a2aeeb81",
                                                "sense_id": "8ea6bd98-c006-3782-8e07-83133d661a96",
                                                "text": "La plupart des gens sont à moitié ambidextres"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae5fe52-f481-39fc-a730-73e0e6692ad4",
                                        "entry_id": "fd76c93c-d2af-3471-aad6-9efce6c5e375",
                                        "glosses": [
                                            "Bisexuel."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d91daf46-030f-4d57-b556-dedfcff22216",
                                                "sense_id": "5ae5fe52-f481-39fc-a730-73e0e6692ad4",
                                                "text": "Appelez-moi bisexuel ou, comme disaient les Anciens, ambidextre, je n’y vois pas d’inconvénient.' — (Claire Chartier, Le Viol et Nous, 2019)"
                                            },
                                            {
                                                "example_id": "d5c03bc1-ce3e-49dd-a6c4-26b93abb665b",
                                                "sense_id": "5ae5fe52-f481-39fc-a730-73e0e6692ad4",
                                                "text": "Sujet : les ennuis de saint Sébastien à cause de son faible pour les garçons, et ç’aurait dû me mettre la puce à l’oreille, ça, parce que deux jours après la première de la pièce il m’a annoncé qu’il rompait et qu’il était « ambidextre », c’est-à-dire bisexuel, c’est-à-dire : Bravo, Margy, toujours ce pif pour les choisir !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ambidextre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d94c0ffc-90d7-371e-a45d-62791c369de2",
                                        "entry_id": "9184e3ff-c297-3d37-8829-4730ebeb7c3a",
                                        "glosses": [
                                            "Personne qui se sert des deux mains avec une égale facilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5f03b0-8cd9-4b10-8725-ec2da0730b01",
                                                "sense_id": "d94c0ffc-90d7-371e-a45d-62791c369de2",
                                                "text": "C’est un, une ambidextre."
                                            },
                                            {
                                                "example_id": "883b03cb-fe28-4d08-9a40-c539b103f588",
                                                "sense_id": "d94c0ffc-90d7-371e-a45d-62791c369de2",
                                                "text": "Il sʼagissait dʼune apraxie unilatérale droite chez un ambidextre : lʼobservation mentionne que si le patient écrivait et maniait lʼépée de la main droite, cʼest de sa main gauche quʼil distribuait les cartes à jouer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0bca1b-0c7e-36ef-86e1-2dd0426d355a",
                                        "entry_id": "9184e3ff-c297-3d37-8829-4730ebeb7c3a",
                                        "glosses": [
                                            "Personne bisexuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626627d6-4987-405b-b1c0-7ad3c4ae0760",
                                                "sense_id": "ba0bca1b-0c7e-36ef-86e1-2dd0426d355a",
                                                "text": "Ah ! c’est un ambidextre ?"
                                            }
                                        ]
                                    }
                                ]
                            }
