                                        "examples": [
                                            {
                                                "example_id": "33afb13e-8857-4b1b-8e07-3abfaf7b1048",
                                                "sense_id": "7e8f1b81-d28c-3b52-8f41-b617d354c06b",
                                                "text": "\"Yoga wordt intussen wereldwijd erkend door degenen die zonder stress willen leven\", zei Modi. \"Ook de traditionele Indiase geneeskunde ayurveda zal dezelfde waardering krijgen zolang die, net als yoga, als levensstijl wordt gezien.\""
                                            },
                                            {
                                                "example_id": "94e66c9c-9a59-4b39-8221-586a90a1efb4",
                                                "sense_id": "7e8f1b81-d28c-3b52-8f41-b617d354c06b",
                                                "text": "Ayurveda is een Indiase geneeswijze waarbij onder meer gebruik wordt gemaakt van reinigingskuren, massages en yoga."
                                            },
                                            {
                                                "example_id": "e579559c-206b-4421-a171-e8b0febdd011",
                                                "sense_id": "7e8f1b81-d28c-3b52-8f41-b617d354c06b",
                                                "text": "Diverse bedrijven in het dorp hebben zich bereid verklaard fairtrade koffie en thee te gaan schenken of fairtrade-producten te gaan verkopen. Dat geldt voor supermarkt COOP van Stefan Hemel, Ayurveda Twente en letselschadebedrijf Engberink en Kluijt. Het kernteam Fairtrade Hof van Twente hoopt dat op korte termijn nog meer bedrijven in het dorp fairtrade koffie en thee te gaan schenken op de zaak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2bff501-724c-4251-9ff7-cfe7810a7207",
                        "source_entry_id": "c129b942-76ef-3bc4-b85d-60188b014728",
                        "source_sense_description": "traditional Hindu alternative medicine",
                        "target_lang_word": "ayurveda",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ayurveda",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd6877c-1e42-399c-a9de-3f38a5ec231a",
                                        "entry_id": "3366335e-bf30-31dc-a942-969b698f529c",
                                        "glosses": [
                                            "Médecine traditionnelle hindoue."
                                        ],
                                        "tags": [
                                            "Médecine non conventionnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2734ff6d-741b-4a6f-a5bb-ff1880e176e0",
                                                "sense_id": "0cd6877c-1e42-399c-a9de-3f38a5ec231a",
                                                "text": "L’ayurvéda puise ses sources dans le Véda, ensemble de textes sacrés de l’Inde antique et ses principes sont ceux de ce qu’on appelle aujourd’hui la « médecine naturelle »."
                                            },
                                            {
                                                "example_id": "891f3d3a-c8ff-460d-b85b-ee3e5b8721cd",
                                                "sense_id": "0cd6877c-1e42-399c-a9de-3f38a5ec231a",
                                                "text": "L’ayurveda, la médecine traditionnelle indienne, transmise à la fois par voie orale et textuelle, consacre en partie l’un de ses piliers, le Salakya tantra, aux opérations de l’œil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57d5ef59-6c64-47b5-af6e-b47b1f074b5e",
