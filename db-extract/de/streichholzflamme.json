                        "glosses": [
                            "Flamme, die beim Anzünden eines Streichholzes entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b0b162-9b5d-410f-b50f-ed905b05b1c7",
                                "sense_id": "f197b32b-9148-36e8-8059-f824ebb4999b",
                                "text": "„Er sterilisierte sein Messer über einer Streichholzflamme und holte die Steinsalzbröckchen heraus, die sich ins Fleisch gebohrt hatten.“"
                            },
                            {
                                "example_id": "e7391b5a-1931-477f-9dba-4d4ca5ae8410",
                                "sense_id": "f197b32b-9148-36e8-8059-f824ebb4999b",
                                "text": "„Auerbach steckte sich eine Zigarette in den Mund, holte eine Streichholzschachtel aus seiner Tasche, zündete ein Streichholz an, und als die Zigarette brannte, löschte er die Streichholzflamme mit einer schnellen Handgelenkbewegung.“"
                            }
                        ],
