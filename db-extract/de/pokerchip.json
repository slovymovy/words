                "senses": [
                    {
                        "sense_id": "9a4c4d56-a919-36a9-b579-4e2914d02bf9",
                        "entry_id": "2ef8c68e-e51f-3224-8eac-8569f0f9b1a2",
                        "glosses": [
                            "Chip/Spielmarke, mit der Poker gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a80e3b-eaf8-40f5-aaa6-bb66cf861fb1",
                                "sense_id": "9a4c4d56-a919-36a9-b579-4e2914d02bf9",
                                "text": "„Nur das Klatschen der Karten und leise Klicken der Pokerchips durchbrach die Stille.“"
                            },
                            {
                                "example_id": "1702d1bb-ef2e-49c5-a6b4-35ccb68e7fd0",
                                "sense_id": "9a4c4d56-a919-36a9-b579-4e2914d02bf9",
                                "text": "„Der Herzog der Vandalen fand jede Tüte, in der Rote Bete war. Jede silberne Mylar-Tüte, in der Rote-Bete-Scheiben rasselten, trocken wie Pokerchips.“"
                            },
                            {
                                "example_id": "ad06cb74-df29-4991-a9c9-38a522d4f18b",
                                "sense_id": "9a4c4d56-a919-36a9-b579-4e2914d02bf9",
                                "text": "„Er stapelte die Münzen wie Pokerchips.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
