                ],
                "senses": [
                    {
                        "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                        "entry_id": "d52676b0-ccac-3e2e-8d0b-cbc66fd1f15c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "127c6951-d093-4713-9e71-66f85f9f339f",
                                "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                                "text": "Frau Löhle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "436245e6-51fe-4208-b816-c5bd5fe02903",
                                "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                                "text": "Herr Löhle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "40dd7d87-1b24-4840-a99b-7512c146dc7c",
                                "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                                "text": "Die Löhles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "33e2ba0d-afed-4d34-ac58-9acb2257fa84",
                                "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                                "text": "Der Löhle trägt nie die Schals, die die Löhle ihm strickt."
                            },
                            {
                                "example_id": "b2232cbe-8348-4f02-ac8a-671c3436994b",
                                "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Löhle kommt, geht der Herr Löhle.“"
                            },
                            {
                                "example_id": "7eae0f67-08bb-4725-9b03-a1c5b9caf7f2",
                                "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                                "text": "Löhle kommt und geht."
                            },
                            {
                                "example_id": "7ef519d9-1691-4a9a-9a4a-9032309ec858",
                                "sense_id": "94437f1b-d1f0-3e08-9209-6619e8127447",
                                "text": "Löhles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
