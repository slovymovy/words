                                    {
                                        "sense_id": "5e4c5129-d128-3528-b2b6-9f2ffc1a839d",
                                        "entry_id": "8741b5d0-5f6f-3978-bad9-553e8fdf348c",
                                        "glosses": [
                                            "in nördlichen Meeren lebende Robbe mit langen Stoßzähnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3957c8ef-f8d0-4ee4-8026-738ea88c39a6",
                                                "sense_id": "5e4c5129-d128-3528-b2b6-9f2ffc1a839d",
                                                "text": "Walrosse leben in den hohen Breiten."
                                            },
                                            {
                                                "example_id": "94563592-1969-40d4-80f1-7c231a25f61d",
                                                "sense_id": "5e4c5129-d128-3528-b2b6-9f2ffc1a839d",
                                                "text": "35.000 Walrosse drängen sich zurzeit auf einem Küstenstrich von Alaska. Experten des US-Regierungsinstituts USGS sehen in dem Phänomen eine Folge des Klimawandels: Schmelzendes Packeis zwinge die Tiere aufs Festland."
                                            },
                                            {
                                                "example_id": "6e999e2c-8d03-4b14-9283-319bb76a56d6",
                                                "sense_id": "5e4c5129-d128-3528-b2b6-9f2ffc1a839d",
                                                "text": "Was kann Deutschland für die Biodiversität weltweit leisten - also für bedrohte Tierarten wie Walross, Löwe, Elefant, das Nördliche Breitmaulnashorn oder die Primatenart Indri? […]"
                                            },
                                            {
                                                "example_id": "a81e4c2f-d47b-4189-b165-a9b9ea246eb7",
                                                "sense_id": "5e4c5129-d128-3528-b2b6-9f2ffc1a839d",
                                                "text": "„Vielleicht war es eine große Robbe oder ein Walross, das sich bei dem schönen Wetter sonnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a824107-26c5-4c79-93ef-9b01f2ebf3a3",
                        "source_entry_id": "b18dc094-e749-3e04-bfae-602588011db0",
                        "source_sense_id": "38e8ada0-ffd0-3cf4-acba-95dacfe922d4",
                        "source_sense_description": "bepaald soort zoogdier, Odobenus rosmarus",
