                "senses": [
                    {
                        "sense_id": "f5449e53-5d05-3f72-9c2e-ad7302ee88bf",
                        "entry_id": "82057d0a-b0c0-3a53-ba5f-9707212f5599",
                        "glosses": [
                            "typ cząstek elementarnych z grupy barionów dziwnych"
