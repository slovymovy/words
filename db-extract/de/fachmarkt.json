                "senses": [
                    {
                        "sense_id": "b0d95597-68c4-3d94-995c-d417c28cb69f",
                        "entry_id": "d3a80eef-75d2-3dd4-b49f-d1ae3673447a",
                        "glosses": [
                            "großflächiger Selbstbedienungsladen mit großem Sortiment an Waren einer Kategorie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce20bb89-e3a3-46bb-ab3b-846d447ca884",
                                "sense_id": "b0d95597-68c4-3d94-995c-d417c28cb69f",
                                "text": "„In den letzten drei Jahren kam im Schnitt jeden vierten Tag ein neuer Fachmarkt hinzu.“"
                            },
                            {
                                "example_id": "52fd66f4-8e0a-4c84-8af0-a7976788c661",
                                "sense_id": "b0d95597-68c4-3d94-995c-d417c28cb69f",
                                "text": "„Akzeptabel wäre daher der geplante Emser Fachmarkt nur, wenn die Stadt zum Ausgleich für die verbauten Flächen die Rückwidmung anderer Gebiete - wenn möglich in besserer \"Qualität\" - anbieten würde.“"
                            },
                            {
                                "example_id": "07773caa-3a4f-41a5-82f8-8e4ee803b1db",
                                "sense_id": "b0d95597-68c4-3d94-995c-d417c28cb69f",
                                "text": "„Die Verkäuferin in einem Fachmarkt für Elektronik bekommt seit Dezember nur noch 50 Prozent ihres Lohnes ausgezahlt, und das auch nur schleppend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
