        "nl-extract.jsonl": [
            {
                "entry_id": "d4f041f2-8b47-39e6-9c10-66ac5167d81f",
                "word": "bijwerking",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "12231e12-40de-4993-87df-beb6c03f6d34",
                        "entry_id": "d4f041f2-8b47-39e6-9c10-66ac5167d81f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bijwerkingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "662993ae-e46b-3c84-856c-c54052a54350",
                        "entry_id": "d4f041f2-8b47-39e6-9c10-66ac5167d81f",
                        "glosses": [
                            "een ongewenst neveneffect"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b681e832-be4e-499b-bdce-fbde030e1ea9",
                                "sense_id": "662993ae-e46b-3c84-856c-c54052a54350",
                                "text": "Spierpijn is een bijwerking die veel voorkomt bij cholesterol verlagende medicatie."
                            },
                            {
                                "example_id": "14905f55-c862-4b47-9ac5-cf01f44c4aea",
                                "sense_id": "662993ae-e46b-3c84-856c-c54052a54350",
                                "text": "Een verhoogde kans op bloedingen is een bijwerking maar ook een werking van aspirine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b192c680-7aae-4518-9edb-de6b518a7b84",
                        "source_entry_id": "d4f041f2-8b47-39e6-9c10-66ac5167d81f",
                        "source_sense_id": "662993ae-e46b-3c84-856c-c54052a54350",
                        "target_lang_word": "Nebenwirkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebenwirkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b639c00a-36ee-3f3b-9eee-ed69c8723b77",
                                        "entry_id": "3d69a88f-fef7-3a29-b36f-2749fbdeea55",
                                        "glosses": [
                                            "unerwünschter oder nicht beabsichtigter, aber schwächerer Effekt, der bei einer medizinischen Behandlung oder durch Medikamente auftreten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50316de4-ccf9-4381-911b-87f0e38586a7",
                                                "sense_id": "b639c00a-36ee-3f3b-9eee-ed69c8723b77",
                                                "text": "Zu den Nebenwirkungen dieses Medikaments zählen Schweißausbrüche und innere Unruhe."
                                            },
                                            {
                                                "example_id": "e7071fb6-705e-4d49-9e15-4f37e174913b",
                                                "sense_id": "b639c00a-36ee-3f3b-9eee-ed69c8723b77",
                                                "text": "„Das Auftreten von schweren Nebenwirkungen sowie Resistenzentwicklung gehören zu den größten Problemen der modernen Krebstherapie.“"
                                            },
                                            {
                                                "example_id": "c05ab751-9536-4eb4-8c06-32ea287838cc",
                                                "sense_id": "b639c00a-36ee-3f3b-9eee-ed69c8723b77",
                                                "text": "„Seine vielen Nebenwirkungen klingen bemerkenswert.“"
                                            },
                                            {
                                                "example_id": "9578bd7a-3144-4b84-8cfc-174732c4250d",
                                                "sense_id": "b639c00a-36ee-3f3b-9eee-ed69c8723b77",
                                                "text": "„Frauen bauen viele Antidepressiva langsamer ab, weil das aber bei der Dosierung nicht genug beachtet wird, leiden sie häufiger an Nebenwirkungen.“"
                                            },
                                            {
                                                "example_id": "bac94676-13e9-4b47-b1ca-a8876a8c3778",
                                                "sense_id": "b639c00a-36ee-3f3b-9eee-ed69c8723b77",
                                                "text": "„Übelkeit, Erbrechen und Durchfall sind häufige Nebenwirkungen, die bei einer medikamentösen Abtreibung auftreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25d6c81b-4202-348d-b50e-7a2947804b52",
                                        "entry_id": "3d69a88f-fef7-3a29-b36f-2749fbdeea55",
                                        "glosses": [
                                            "unerwünschte oder nicht beabsichtigte Auswirkung als Folge einer Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "842e2d19-4f43-4283-a974-3be93493ff44",
                        "source_entry_id": "d4f041f2-8b47-39e6-9c10-66ac5167d81f",
                        "source_sense_id": "662993ae-e46b-3c84-856c-c54052a54350",
                        "target_lang_word": "side-effect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "side-effect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e613c737-9c23-3da5-a4c5-e0090cc35d9b",
                                        "entry_id": "601074a3-d116-3f02-92d6-d546af85d192",
                                        "glosses": [
                                            "Alternative spelling of side effect."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1900ca45-d3ab-4dc0-aff8-8e192248dc21",
                                                "sense_id": "e613c737-9c23-3da5-a4c5-e0090cc35d9b",
                                                "text": "Gynecomastia is estimated to affect anywhere from 30 to 70 per cent of males at some stage of their lives. And \"gyne\" or \"gyno\", as it's commonly known, is not only an unwelcome (and ironic) side-effect of anabolic-androgenic - that is, muscle-building and masculinising - steroids: it can also be caused by other hormonal disruptors such as alcohol, cigarettes, cannabis, obesity, puberty (usually temporarily) and old age. But [Tom] Powell says his gyno was \"99 percent\" likely due to steroids. […] The new generation of lifters are disparaged as “SARM goblins” for their embrace of the new generation of IPEDs called Selective Androgen Receptor Modulators, which supposedly provide most of the benefits of steroids and fewer of the side-effects, and can be bought online on sites like eBay and Depop."
                                            },
                                            {
                                                "example_id": "51789616-f936-471c-8f09-14faf9df8fa9",
                                                "sense_id": "e613c737-9c23-3da5-a4c5-e0090cc35d9b",
                                                "text": "A common and beautiful side-effect of high solar activity is the Aurora Borealis - the northern lights that dance across Arctic skies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "side-effect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2150d8f6-5613-3c7f-8f3e-a691157a381a",
                                        "entry_id": "e8494dfa-6f43-3681-9f5e-c3fc814be903",
                                        "glosses": [
                                            "To alter as a side effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7044455c-4c55-43fc-8ad8-bb262b318846",
                                                "sense_id": "2150d8f6-5613-3c7f-8f3e-a691157a381a",
                                                "text": "Furthermore, we are on the look-out for pre-conditions for good therapy - so as to prevent the unintended bad therapy: but our efforts are duly side-effected by lack of control over such preconditions."
                                            },
                                            {
                                                "example_id": "a73e4557-e8f0-4cf5-b4e9-a7f1d9d04781",
                                                "sense_id": "2150d8f6-5613-3c7f-8f3e-a691157a381a",
                                                "text": "Local objects can further be distinguished by whether or not they are escaping from the execution of m, and non-local objects can be further distinguished by whether or not they are side-effected by a visible side-effect during the execution of m:"
                                            },
                                            {
                                                "example_id": "ee97351e-4af5-4b94-8610-8b802bf0478e",
                                                "sense_id": "2150d8f6-5613-3c7f-8f3e-a691157a381a",
                                                "text": "Hence, side-effecting the environment is equivalent to collaborating with an autonomous co-robot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2260feb-b7f0-4086-be99-9435a440428b",
                        "source_entry_id": "d4f041f2-8b47-39e6-9c10-66ac5167d81f",
                        "source_sense_id": "662993ae-e46b-3c84-856c-c54052a54350",
                        "target_lang_word": "effet secondaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effet secondaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52284e5b-9163-3ce5-b96a-a6ae45016286",
                                        "entry_id": "6207487b-cdb2-34c8-b266-f2886f7a5683",
                                        "glosses": [
                                            "Effet distinct de celui initialement espéré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44a4bc4a-f319-42fe-a8f7-6120019d8349",
                                                "sense_id": "52284e5b-9163-3ce5-b96a-a6ae45016286",
                                                "text": "La grande chaleur qui provient d'un exercice violent (effet primitif), est suivie de frissons et de froid (effet secondaire). L'homme qui s'était échauffé hier en buvant largement du vin (effet primitif), est aujourd'hui sensible au moindre courant d'air (effet secondaire)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "981d531c-0254-34f2-818b-b63e5b222978",
                                        "entry_id": "6207487b-cdb2-34c8-b266-f2886f7a5683",
                                        "glosses": [
                                            "Effet indésirable d’un médicament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49dd4927-b100-4e99-a787-b1659ae92af0",
                                                "sense_id": "981d531c-0254-34f2-818b-b63e5b222978",
                                                "text": "Hautement recommandé pour les délires antisionistes, révisionnistes, judéophobiques, ou autre simple envie de frapper son voisin parce qu'il est juif. Très efficace, Antisémitox n'a aucun effet secondaire. Il traite également l'antisionisme."
                                            },
                                            {
                                                "example_id": "582147a9-4d8e-4a59-a912-5cd43686c747",
                                                "sense_id": "981d531c-0254-34f2-818b-b63e5b222978",
                                                "text": "Les essais biologiques réalisés par notre équipe à Pasteur démontrèrent que cette molécule synthétique était plus active que le bacille entier et totalement débarrassée de ses effets secondaires."
                                            },
                                            {
                                                "example_id": "3fad4c7a-468b-455b-9425-bbab4f108b5c",
                                                "sense_id": "981d531c-0254-34f2-818b-b63e5b222978",
                                                "text": "Ces textes mentionnent les effets secondaires des vaccins, dont les problèmes cardiaques et pulmonaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9600a3-0e02-3a62-8e99-14016ff3a7b6",
                                        "entry_id": "6207487b-cdb2-34c8-b266-f2886f7a5683",
                                        "glosses": [
                                            "Modification de valeurs du programme autres que celles explicitement spécifiées lors de l’appel d’une fonction ou un sous-programme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
