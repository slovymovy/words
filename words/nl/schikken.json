                        "arrangeren",
                        "rangschikken"
                    ],
                    "antonyms": [
                        "verwarren"
                    ],
                    "common_phrases": [
                        "bloemen schikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to place things in a specific, often neat or attractive order"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrange",
                                "target_lang_sense_clarification": "to put in a specific order"
                            },
                            {
                                "target_lang_word": "organize",
                                "target_lang_sense_clarification": "to put in a neat order"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "177db733-a6b6-3c6b-96b5-4c74b24c7c70",
                    "sense_definition": "zich aanpassen aan een situatie of de wil van een ander, vaak zonder protest",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>schikte</w> zich maar naar haar nukken om ruzie te voorkomen.",
                            "target_lang_translations": {
                                "en": "He just <w>complied</w> with her whims to avoid an argument."
                            }
                        },
                        {
                            "text": "Je moet je naar de omstandigheden <w>schikken</w> als je wilt overleven.",
                            "target_lang_translations": {
                                "en": "You have to <w>adapt</w> to the circumstances if you want to survive."
                            }
                        }
                    ],
                    "synonyms": [
