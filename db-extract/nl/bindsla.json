                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173c2b27-1a27-4709-a45e-9b01922ada96",
                                "sense_id": "8b5dcdd7-0e47-34fc-918d-2cd5249a3ea3",
                                "text": "Donkergekleurd fruit en groenten bevatten meer vitaminen en mineralen, zo bevat groene bindsla meer vitamine B dan de blekere ijsbergsla."
                            },
                            {
                                "example_id": "e3d26128-0e82-46d8-9534-dde47ab8f61f",
                                "sense_id": "8b5dcdd7-0e47-34fc-918d-2cd5249a3ea3",
                                "text": "Het is lang geleden dat ik kipfilet heb besteld in een restaurant, en ik krijg deze keer geen spijt. De filet is in bindsla gewikkeld, op lage temperatuur gegaard en treffend gecombineerd met zoete pruimen en krokante bacon naast jonge courgettes."
                            },
                            {
                                "example_id": "1d2acbb3-e8c1-4e6f-816c-f32711466b15",
                                "sense_id": "8b5dcdd7-0e47-34fc-918d-2cd5249a3ea3",
                                "text": "Maandag wordt er de eerste lading bindsla geoogst, die in het ruimtestation gekweekt werd."
                            }
                        ]
                    }
