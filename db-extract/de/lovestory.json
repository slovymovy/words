                ],
                "senses": [
                    {
                        "sense_id": "e2b63d48-b624-3ef0-8039-f0988c9202f8",
                        "entry_id": "622e183b-6b3b-3503-b8d9-dd44049e9ba6",
                        "glosses": [
                            "love story (story about love)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8150d257-11f4-4d17-a546-c9bf250903f8",
                                "sense_id": "e2b63d48-b624-3ef0-8039-f0988c9202f8",
                                "text": "Diese Agentur ist auf Kurzkrimis, wahre Geschichten und Lovestories spezialisiert; […]"
                            },
                            {
                                "example_id": "20d26c15-da2a-4d65-9b5c-c41cd286d6ef",
                                "sense_id": "e2b63d48-b624-3ef0-8039-f0988c9202f8",
                                "text": "Kritik an den fatalen Auswirkungen der Konsumgesellschaft und Lovestories mit offenem Happyend werden von Fudong in seinen Fotografien, Video- und Filminstallationen in Szene gesetzt."
                            },
                            {
                                "example_id": "dce236b4-de9f-40ea-8906-3564bdc367db",
                                "sense_id": "e2b63d48-b624-3ef0-8039-f0988c9202f8",
                                "text": "So wird Bohème von der Kritik als feinfühlige Literaturverfilmung gefeiert, als Werk, das »höchsten Anforderungen entspricht«,⁴² während Orient und Frauenraub in Marokko an eine lange Reihe exotischer Abenteuer und Lovestories anknüpfen, die damals im deutschen Kino populär sind."
                            },
                            {
                                "example_id": "f88da873-2137-4f1c-8778-37c65a1c0e95",
                                "sense_id": "e2b63d48-b624-3ef0-8039-f0988c9202f8",
                                "text": "Anfang der 2000er Jahre startete er erste Gehversuche mit Kurzkrimis und Lovestories, die ebenfalls zum Teil veröffentlicht wurden."
                            },
                            {
                                "example_id": "42d8f30a-1850-4634-9a56-1a7d0af98a74",
                                "sense_id": "e2b63d48-b624-3ef0-8039-f0988c9202f8",
                                "text": "Ich werde in die Küche zu Tante Olja gebracht, der Freundin meiner Mutter, von wo die Lovestories meiner studentischen Jahre beginnen."
                            },
                            {
                                "example_id": "da5a020e-3881-46bf-97d0-d54584866d50",
                                "sense_id": "e2b63d48-b624-3ef0-8039-f0988c9202f8",
                                "text": "Die studierte Apothekerin schreibt am liebsten Fantasy und Lovestories und hat 2019 ihren ersten Fantasy-Roman „Schwarz wie dein Herz – Seelen der Dunkelheit 1“ im Selfpublishing herausgebracht."
                            }
                        ]
