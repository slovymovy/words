                        "glosses": [
                            "geneigd om veranderingen door te voeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60002dad-a11b-47a6-8330-ca2c84bbdc43",
                                "sense_id": "949979a7-53b2-390c-8418-f61126f3e7ce",
                                "text": "De kandidaat die wordt gezien als relatief hervormingsgezind, Hassan Rohani, gaat er ruim aan de leiding. Hij krijgt zelfs meer dan de helft van de getelde stemmen."
                            },
                            {
                                "example_id": "d6be6f34-3326-44bf-839e-c5c48ff831c8",
                                "sense_id": "949979a7-53b2-390c-8418-f61126f3e7ce",
                                "text": "Anders dan in Libië of Tunesië, waar na de revolutie grote delen van het bestuur zijn verdwenen of vervangen, is in Egypte feitelijk weinig veranderd. Na het vertrek van de gehate Hosni Mubarak, afgelopen februari, is zijn plek ingenomen door veldmaarschalk Mohammed Hussein Tantawi, die niet bekend staat als hervormingsgezind."
                            }
                        ]
                    }
