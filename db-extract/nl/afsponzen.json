                "forms": [],
                "senses": [
                    {
                        "sense_id": "43531fa9-3777-33e4-ab6b-120ddef8c60e",
                        "entry_id": "b60a07cb-f149-37d2-b2e0-83a268f5f322",
                        "glosses": [
                            "koelen, bevochtigen of schoonmaken met een vochtige spons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "552fad0d-dd96-46a5-84a5-616aa9f662ea",
                                "sense_id": "43531fa9-3777-33e4-ab6b-120ddef8c60e",
                                "text": "Dompelen van de pot vinden ook veel planten prettig. Wie daar aardigheid in heeft, ziet misschien ook niet op tegen bladeren afsponzen met lauwwarm water, 's winters verplaatsen naar een koude kamer enzovoorts, maar dan betreden we de sferen van de echte plantenverzorging."
                            },
                            {
                                "example_id": "fa0f1da4-0194-44d1-8f32-2f6b5c82074c",
                                "sense_id": "43531fa9-3777-33e4-ab6b-120ddef8c60e",
                                "text": "Koelen of afsponzen met lauw water werkt niet om de temperatuur te verlagen. Het vergroot het ongemak bij kinderen juist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c6101e3-68b0-4ee9-a979-5345b21fcc62",
                        "source_entry_id": "b60a07cb-f149-37d2-b2e0-83a268f5f322",
                        "source_sense_id": "43531fa9-3777-33e4-ab6b-120ddef8c60e",
