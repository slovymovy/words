                                        "glosses": [
                                            "That serves to extract something"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c6bca0-1c4a-4a71-82c2-30b3e352c3cf",
                                                "sense_id": "1598041a-1a12-35f3-9e3f-84d55a7675e3",
                                                "text": "Certain branches of industry are conveniently designated extractive: e.g., agriculture, pastoral and mining pursuits, cutting of lumber, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47032c77-7f67-3cc7-a162-d11e885b01bb",
                                        "entry_id": "89c6d357-5fa6-3d3a-b4f9-3097aac56416",
                                        "glosses": [
                                            "That withdraws natural resources by extraction"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "240a9522-9fd5-4a0c-9f86-c3e41d977731",
                                                "sense_id": "47032c77-7f67-3cc7-a162-d11e885b01bb",
                                                "text": "The extractive industry consists of any operations that remove metals, mineral and aggregates from the earth. Examples of extractive processes include oil and gas extraction, mining, dredging and quarrying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4557522-32a7-31cb-bc38-8ff397ab3700",
                                        "entry_id": "89c6d357-5fa6-3d3a-b4f9-3097aac56416",
                                        "glosses": [
