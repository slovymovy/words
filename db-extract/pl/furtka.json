                        ],
                        "examples": [
                            {
                                "example_id": "668f0a3f-7975-4745-bee0-3b2fb22afb18",
                                "sense_id": "f92ca5c4-1434-3d7b-b745-a67a7b3584f2",
                                "text": "Przed furtką stanęło czterech szopkarzy i zaczęło śpiewać kolędę."
                            },
                            {
                                "example_id": "31b582c5-9b93-420f-b7a5-85623e2b4e21",
                                "sense_id": "f92ca5c4-1434-3d7b-b745-a67a7b3584f2",
                                "text": "Na wieść o bliskim niebezpieczeństwie, Nazariusz wyprowadził wszystkich ukrytym przejściem do furtki ogrodowej, a następnie do opuszczonych kamieniołomów, odległych o kilkaset kroków od bramy Janikulskiej."
                            }
                        ],
