                                                "example_id": "6d785032-b166-4210-a27f-b01dfc467585",
                                                "sense_id": "150f9c40-eac4-317b-ba4d-cf4f2ee4a9ae",
                                                "text": "« Ils l'ont défigurée », dit-il, et il poursuivit sa route, sans être sensible ni au charme des eaux pures et courantes des rapides de Phade, ni au calme harmonieux de la cuvette d’Haulmé où la Semoy divague plus que de raison, entre une terrasse et des versants à pic."
                                            },
                                            {
                                                "example_id": "3f900d67-f1d8-4fd7-b8a7-345ee7827c79",
                                                "sense_id": "150f9c40-eac4-317b-ba4d-cf4f2ee4a9ae",
                                                "text": "Les rapides innombrables du Caroni semblent se jeter à notre rencontre, pour nous happer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963c206f-a83c-3451-a456-c04dc9cfe3d0",
                                        "entry_id": "63293fd8-1ad9-37e4-9955-20e7523b2289",
                                        "glosses": [
                                            "Train qui avance à grande vitesse et ne s’arrête qu’à quelques gares importantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b89ffff-23fa-4048-aa69-f3d697dfb998",
                                                "sense_id": "963c206f-a83c-3451-a456-c04dc9cfe3d0",
                                                "text": "Les démarches entreprises par la Chambre pour obtenir la régularisation de l’horaire du rapide Milan-Bordeaux, afin d’assurer la correspondance de ce train à Montluçon avec les express desservant la région nantaise, ont abouti."
                                            },
                                            {
                                                "example_id": "e9aef28e-6256-459f-91ec-2dc67a58c347",
                                                "sense_id": "963c206f-a83c-3451-a456-c04dc9cfe3d0",
                                                "text": "— J’entends un bruit de pas…\n— Alors ce n’est sûrement pas un rapide…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db6e39f9-7564-334c-b140-a4e4390931f9",
                                        "entry_id": "63293fd8-1ad9-37e4-9955-20e7523b2289",
                                        "glosses": [
                                            "Tournoi joué à la cadence rapide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rapide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea80e725-2fe3-3347-bab7-49fee8c880f8",
                                        "entry_id": "fbd31f0c-264a-3a01-8bb4-669c40ec7e86",
                                        "glosses": [
                                            "Personne très rapide dans ce qu’elle entreprend."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5adb7ea-5b78-4dda-83f8-b76f199e38cb",
                                                "sense_id": "ea80e725-2fe3-3347-bab7-49fee8c880f8",
                                                "text": "Tu connais Lisa depuis une semaine et vous allez déjà vous marier ? Vous êtes des rapides dis donc !"
