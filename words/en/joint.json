    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2eddfe64-07c6-3bd8-9864-d73204e7048a",
                    "sense_definition": "A part of the body where two bones meet, usually allowing movement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "connection_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather often complains about the pain in his <w>joints</w> when the weather changes.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка часто жалуется на боль в <w>суставах</w>, когда меняется погода.",
                                "zh": "每当天气变化时，我祖父常抱怨他的<w>关节</w>疼。"
                            }
                        },
                        {
                            "text": "The knee <w>joint</w> is particularly vulnerable to injury during sports.",
                            "target_lang_translations": {
                                "ru": "Коленный <w>сустав</w> особенно уязвим для травм во время занятий спортом.",
                                "zh": "膝<w>关节</w>在运动时特别容易受伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "articulation",
                        "connection"
                    ],
                    "common_phrases": [
                        "knee joint",
                        "hip joint",
                        "stiff joints",
                        "aching joints"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела, где соединяются две кости, обычно обеспечивающая движение.",
                        "zh": "身体中两块骨头相连并通常允许活动的部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суста́в",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "сочлене́ние",
                                "target_lang_sense_clarification": "место соединения костей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关节",
                                "target_lang_sense_clarification": "解剖学名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cc983db-1f63-3e44-a7d8-e2770e70be13",
                    "sense_definition": "A place where two parts of an object or structure are joined together.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "connection_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter created a strong dovetail <w>joint</w> to hold the drawer together.",
                            "target_lang_translations": {
                                "ru": "Плотник сделал прочное <w>соединение</w> «ласточкин хвост», чтобы скрепить ящик.",
                                "zh": "木匠做了一个坚固的燕尾<w>接头</w>来固定抽屉。"
                            }
                        },
                        {
                            "text": "Water began leaking from the <w>joint</w> connecting the two pipes.",
                            "target_lang_translations": {
                                "ru": "Вода начала протекать из <w>стыка</w>, соединяющего две трубы.",
                                "zh": "水开始从连接两根管子的<w>接头</w>处渗漏出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "junction",
                        "connection"
                    ],
                    "common_phrases": [
                        "expansion joint",
                        "ball-and-socket joint",
                        "universal joint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где две части объекта или конструкции соединены вместе.",
                        "zh": "物体或结构中两个部分连接在一起的地方。"
                    },
                    "translations": {
                        "ru": [
