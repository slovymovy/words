                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d95f7f-0dd6-4f38-9fb3-3978d2d0c9eb",
                                                "sense_id": "4eb64d6b-b9c8-30eb-a394-05ddc8b9235a",
                                                "text": "First off, how could I ever be a totally slamming, hot French expert on free-running. But, that technicality aside, I honestly don't want to be Henri."
                                            },
                                            {
                                                "example_id": "cf9c61ec-8e5a-43b1-a24d-b795df18a39b",
                                                "sense_id": "4eb64d6b-b9c8-30eb-a394-05ddc8b9235a",
                                                "text": "You could play while driving if wanted to. \"Man, you have no idea how slammin' we would be driving into my neighborhood with these wheels. Just slammin'....\""
                                            },
                                            {
                                                "example_id": "12fb3b3d-36f5-4930-942d-7da2b2396632",
                                                "sense_id": "4eb64d6b-b9c8-30eb-a394-05ddc8b9235a",
                                                "text": "It was totally slamming and reminded Sofi of an MTV spring break show."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slamming",
