                        "source_sense_id": "477a70b2-51d3-3521-91b3-6e4ec5e0a3e6",
                        "source_sense_description": "Handlung oder Vorgang, etwas abzuändern, und Ergebnis dieser Handlung",
                        "target_lang_word": "modification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
