                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2c17dd8-32ec-3e4b-ab76-05da59eff456",
                        "entry_id": "334708f7-ab3e-3bbc-b306-10aaa96de644",
                        "glosses": [
                            "Métal lourd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40586b3-10ec-49e9-b256-3909bf578794",
                                "sense_id": "b2c17dd8-32ec-3e4b-ab76-05da59eff456",
                                "text": "Blei ist ein Schwermetall, das für den Menschen giftig ist.",
                                "translation": "Le plomb est un métal lourd qui est toxique pour l’homme."
                            },
                            {
                                "example_id": "b27637d8-ef65-4dae-9d9c-385e8c101f7d",
                                "sense_id": "b2c17dd8-32ec-3e4b-ab76-05da59eff456",
                                "text": "Dass Blei unter Ächtung steht, wurde breiteren Bevölkerungsschichten klar, als sie ein bestimmtes Silvesterritual nicht mehr mit dem giftigen Schwermetall vollziehen konnten. Aus dem Bleigießen ist nun aus Gesundheitsgründen ein Wachsgießen geworden.",
                                "translation": "De larges couches de la population ont compris que le plomb était proscrit lorsqu’elles n'ont plus pu accomplir un certain rituel du Nouvel An avec ce métal lourd toxique. Pour des raisons de santé, le jeu au plomb s’est transformé en jeu à la cire."
                            },
                            {
                                "example_id": "35f58557-09a7-4e58-9b18-813ace6ee2ff",
                                "sense_id": "b2c17dd8-32ec-3e4b-ab76-05da59eff456",
                                "text": "Es essen ja auch nicht alle Menschen Fisch, und in Zukunft werden es wahrscheinlich noch weniger, wegen der Überfischung oder der Schwermetalle im Fisch.",
                                "translation": "C'est pas que tout le monde mange de poisson, et il y en aura probablement encore moins à l’avenir, à cause de la surpêche ou des métaux lourds présents dans le poisson."
                            }
                        ]
                    }
