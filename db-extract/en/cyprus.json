                                        "entry_id": "8dcc2692-f315-3c67-98bf-1b830e457bc0",
                                        "glosses": [
                                            "Insel im östlichen Mittelmeer, die geografisch zu Asien gehört, mit Europa jedoch kulturell und politisch sehr eng verbunden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb0159e-8dc1-4285-bdca-24fbc0fd4ef0",
                                                "sense_id": "63ed2c49-1a9b-3515-b689-33fe48979853",
                                                "text": "Auf Zypern herrscht mediterranes Klima mit deutlich kontinentaler Ausprägung."
                                            },
                                            {
                                                "example_id": "8e7cbed6-9244-4f57-ad9d-b1835187f346",
                                                "sense_id": "63ed2c49-1a9b-3515-b689-33fe48979853",
                                                "text": "Wer gerne Vögel beobachtet, sollte Zypern besuchen. Dort sind über 300 Arten zu beobachten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9967d16d-0a03-3763-8b9a-9b2df32b7b79",
                                        "entry_id": "8dcc2692-f315-3c67-98bf-1b830e457bc0",
                                        "glosses": [
                                            "Kurzbezeichnung des Staates auf dem Südteil der Insel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd07ec8-f25e-4e47-9b0f-94b73313f8c0",
                                                "sense_id": "9967d16d-0a03-3763-8b9a-9b2df32b7b79",
                                                "text": "Nikosia ist die Hauptstadt von Zypern."
                                            },
                                            {
                                                "example_id": "7f07876c-134c-4e11-a162-ee748b6c1c8b",
                                                "sense_id": "9967d16d-0a03-3763-8b9a-9b2df32b7b79",
                                                "text": "Die Inflationsrate beträgt 2 %, Auslandsschulden hat Zypern nicht."
                                            },
                                            {
                                                "example_id": "14508c24-798e-4d2a-8405-11ad549b75da",
                                                "sense_id": "9967d16d-0a03-3763-8b9a-9b2df32b7b79",
                                                "text": "Im Rahmen der EU-Erweiterung 2004 trat Zypern am 1. Mai 2004 der EU bei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
