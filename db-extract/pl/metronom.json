                                    {
                                        "sense_id": "3f3de840-ea7d-3ee0-90f4-71b4a1aef1fa",
                                        "entry_id": "92965177-6e1e-3235-ae12-8e5e55415c95",
                                        "glosses": [
                                            "Máquina, a manera de reloj, para medir el tiempo e indicar el compás de las composiciones musicales. El sonido del péndulo que oscila en el metrónomo cuando se le pone en movimiento, señala exactamente la rapidez o lentitud que corresponde al aire de las piezas que se ejecutan."
                                        ],
                                        "tags": [
                                            "instrumentos de medida"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a71ddc0-7454-49a7-88e8-e771024d87d9",
                        "source_entry_id": "3088ac88-462e-3a83-a605-677ed6ce7911",
                        "source_sense_id": "9885a9a4-aec9-3dfa-baec-f155f0a4ba90",
                        "target_lang_word": "Metronom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metronom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                        "entry_id": "c0e43fa3-3166-3e57-8e85-a6a7b268f876",
                                        "glosses": [
                                            "Gerät, das durch lautes Ticken dem Musiker das eingestellte Tempo vorgibt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9eaa7c-93dd-4359-a241-46cee62b0a41",
                                                "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                                "text": "„40 Jahre, in denen der sonnengegerbte Mann einem so gleichmäßigen Arbeitsrhythmus folgen sollte, als steuerte ihn ein Metronom...“"
                                            },
                                            {
                                                "example_id": "fcf16342-03ac-44f6-ad8b-7d94d96df0e7",
                                                "sense_id": "833c2ad2-8480-32dd-9d3c-eeb4bafa524c",
                                                "text": "„Jedenfalls, solange die Komponisten so freundlich waren, ihre entsprechenden Angaben mit dem Hinweis zu versehen, auf welchen Wert das Metronom zu stellen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce3e1d84-a0d5-4310-b9b2-eba65404b9c6",
                        "source_entry_id": "3088ac88-462e-3a83-a605-677ed6ce7911",
