                "forms": [
                    {
                        "form_id": "12627abd-426f-4782-b112-b98861d9d559",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "tags": [
                            "plural"
                        ],
                        "form": "reducers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ab06043-7912-3fa0-94fb-ca4ba77c7d7e",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "glosses": [
                            "Something or someone that reduces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80de37e0-4471-4a7e-b168-43ca165f49c3",
                                "sense_id": "9ab06043-7912-3fa0-94fb-ca4ba77c7d7e",
                                "text": "If a floorboard has deep risers, you should use an entrance reducer in winter, to help keep out mice […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "dc20146a-0227-311f-8e93-d8b84494dc0d",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "glosses": [
                            "A reducing agent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4cd2fee5-e140-3dd1-9b25-2fb2b7f0227d",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "glosses": [
                            "A hydraulic device for reducing pressure and hence increasing movement, used to transmit the load from the hydraulic support of the lower shackle to the lever weighing apparatus in some kinds of heavy testing machine."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7dc850de-3162-330f-b155-8229969e8af2",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "glosses": [
                            "A liquid used in the process of developing a negative to reduce its darkness."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "95492e91-fb96-336e-8998-304f1fe75583",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "glosses": [
                            "A component used to connect two pipes of different bores."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "743ace2b-1718-3039-ad98-32a967ffd37b",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "glosses": [
                            "A function that takes state and action as arguments and returns the next state of the app."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "005bd044-ab46-38b9-90ee-03a0837e5e03",
                        "entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "glosses": [
                            "The reduction of the contribution to a football game of a more talented opponent by intimidation using a brutal tackle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5222113c-19ec-46e3-95c2-972c8674b532",
                                "sense_id": "005bd044-ab46-38b9-90ee-03a0837e5e03",
                                "text": "Koulibaly flattens Steven Bergwijn with a reducer from behind but avoids a booking. Bergwijn gets to his feet and blows his cheeks in frustration. I think that really hurt but he doesn’t want to show it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04d22aaa-e20b-40da-9b10-2be7f192c57b",
                        "source_entry_id": "9882701c-510d-3eb8-a0d6-cb8896bd610a",
                        "source_sense_description": "something that reduces",
                        "target_lang_word": "réducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdf6ec8-ba96-31ae-a1f9-629bc24be030",
                                        "entry_id": "b7af6f71-7f82-3047-805d-a53680b0a240",
                                        "glosses": [
                                            "Qui réduit, qui diminue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70b9dbc-7d2f-4f28-8314-b786a99daf2b",
                                                "sense_id": "fcdf6ec8-ba96-31ae-a1f9-629bc24be030",
                                                "text": "Les problèmes complexes que pose à la société française la maîtrise des dépenses de santé sont dissimulés par un discours réducteur évacuant notamment les véritables difficultés…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714bcf67-3133-3b0f-9b35-2891bc44d734",
                                        "entry_id": "b7af6f71-7f82-3047-805d-a53680b0a240",
                                        "glosses": [
                                            "Qualifie une molécule ou un groupement qui donne au moins un électron ou qui accepte au moins un proton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f0662d-c6e5-4e4b-a6cf-6a05f4f3316d",
                                                "sense_id": "714bcf67-3133-3b0f-9b35-2891bc44d734",
                                                "text": "Alors qu'en milieu normal le rH2 cytoplasmique est compris entre 9 et 12, celui des vacuoles est toujours supérieur à 16, c'est à dire que, tandis que le cytoplasme normal est nettement réducteur, le vacuome hydrophile incorporé se montre oxydant."
                                            },
                                            {
                                                "example_id": "4338ea9c-fa33-4e0a-934a-0932c4c20df2",
                                                "sense_id": "714bcf67-3133-3b0f-9b35-2891bc44d734",
                                                "text": "Le lactate est donc un déchet du métabolisme fermentaire, alors qu’il renferme un pouvoir réducteur résiduel important. Ce déchet est éliminé des cellules de manière à poursuivre les oxydations cellulaires."
                                            },
                                            {
                                                "example_id": "05b16bc5-4884-44e7-90ef-9c5ab154eeff",
                                                "sense_id": "714bcf67-3133-3b0f-9b35-2891bc44d734",
                                                "text": "Du point de vue biochimique, les oses sont des polyalcools dotés de plusieurs groupe hydroxyles (-OH) et ils possèdent un groupe carbonyle réducteur."
                                            },
                                            {
                                                "example_id": "ae281ce0-e576-4c83-9b4e-4dda3fa8461f",
                                                "sense_id": "714bcf67-3133-3b0f-9b35-2891bc44d734",
                                                "text": "Dans une seule unité stationnelle en Plaine lorraine (V3), il existe un engorgement particulier, par nappe permanente non réductrice et donc non ou peu asphyxiante : l’horizon bleuté est alors absent, et la nappe ne présente pas les mêmes contraintes pour l’enracinement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b124e672-705d-35aa-a358-8071a3a65ae6",
                                        "entry_id": "b7af6f71-7f82-3047-805d-a53680b0a240",
                                        "glosses": [
                                            "Qui simplifie de façon exagérée, voire abusive."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e88b42-6dad-4888-9313-d683355d6822",
                                                "sense_id": "b124e672-705d-35aa-a358-8071a3a65ae6",
                                                "text": "Ces affects sont, en grande partie, socialement produits, et les gens répondent aux discours qui les valident. Il faut donc accéder aux affects qui nourrissent les préférences électorales avant qu’ils ne soient trop instrumentalisés par des rhétoriques réductrices."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9097784-bd65-3897-9719-1d39406a224f",
                                        "entry_id": "9c97c945-1104-36fc-89ee-8706619e0235",
                                        "glosses": [
                                            "Personne qui réduit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e74a2e17-424c-4184-b577-f207a22e9802",
                                                "sense_id": "b9097784-bd65-3897-9719-1d39406a224f",
                                                "text": "Il appartient au XXᵉ siècle de créer la compression artificielle du texte dans ces revues spécialisées que sont les « digests », où les originaux sont livrés à des équipes non plus de rédacteurs, mais de réducteurs."
                                            },
                                            {
                                                "example_id": "68004893-e415-4f66-8f76-0ec259e3c7f9",
                                                "sense_id": "b9097784-bd65-3897-9719-1d39406a224f",
                                                "text": "Les Jivaros, réducteurs de tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae83b6b-484d-3d8a-aa48-74752945fa16",
                                        "entry_id": "9c97c945-1104-36fc-89ee-8706619e0235",
                                        "glosses": [
                                            "Substance dont les éléments chimiques donnent un ou des électrons aux éléments d’une substance appelée « oxydant »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962e87b2-c615-4f64-9e9e-e57792dd2193",
                                                "sense_id": "cae83b6b-484d-3d8a-aa48-74752945fa16",
                                                "text": "L’ion manganèse est le réducteur associé à l’ion permanganate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29810bdd-a6b3-387a-9679-f49abba75fee",
                                        "entry_id": "9c97c945-1104-36fc-89ee-8706619e0235",
                                        "glosses": [
                                            "Médicament qui permet de réduire la quantité d’une substance présente dans le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d778ceac-ad1a-45ae-b02a-c436e6ed7cd3",
                                                "sense_id": "29810bdd-a6b3-387a-9679-f49abba75fee",
                                                "text": "La Drees s’est intéressée au prix de vente accordé aux hôpitaux par les labos sur les statines, ces réducteurs de cholestérol qui plombent depuis des années les comptes de la Sécu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "261bbee4-bbba-3dd6-a262-686af50d34c5",
                                        "entry_id": "9c97c945-1104-36fc-89ee-8706619e0235",
                                        "glosses": [
                                            "Ensemble d’engrenages qui diminue la vitesse de rotation d’un autre axe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7baf3eba-df76-4128-8e2f-352ab27d236f",
                                                "sense_id": "261bbee4-bbba-3dd6-a262-686af50d34c5",
                                                "text": "Cette turbine d’une puissance de 5 kW ne comprenait qu’une seule roue qui tournait à grande vitesse (30000 tr/min), ce qui imposait l’utilisation d’un réducteur de vitesse à engrenages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
