                ],
                "senses": [
                    {
                        "sense_id": "8b9f07e8-1e54-3ace-a126-87fa696105fc",
                        "entry_id": "1eea7cfb-ab68-3b0f-a6a5-fd4e0dfd6ba0",
                        "glosses": [
                            "Druckbehälter in Pumpen- und Druckluftanlagen, der zur Speicherung von Energie oder einem Fluid und zum Ausgleich von Druckschwankungen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62839626-856a-48ff-8930-dc5218a6186d",
                                "sense_id": "8b9f07e8-1e54-3ace-a126-87fa696105fc",
                                "text": "„Die Druckrohre münden in den Windkessel, in dem durch das eindringende Wasser die Luft zusammengepreßt wird.“"
                            },
                            {
                                "example_id": "9c1d25b6-f5f8-41c3-8bf4-3d64a0773293",
                                "sense_id": "8b9f07e8-1e54-3ace-a126-87fa696105fc",
                                "text": "„Wird nun die Pumpe in Betrieb gesetzt, so entnimmt sie ihr Wasser aus dem Windkessel.“"
                            },
                            {
                                "example_id": "60740345-c324-4a08-b001-a4dc947ccfe4",
                                "sense_id": "8b9f07e8-1e54-3ace-a126-87fa696105fc",
                                "text": "„Diese Luft sammelt sich im Windkessel an, es nimmt daher der Luftgehalt desselben während des Betriebs stetig zu und sein Wasserspiegel sinkt allmählich bis zum unteren Rand des Saugrohrs der Pumpe.“"
                            },
                            {
                                "example_id": "3b35177a-3dd1-45a4-8f35-213ecff9c330",
                                "sense_id": "8b9f07e8-1e54-3ace-a126-87fa696105fc",
                                "text": "„Je größer die Windkessel sind, desto ruhiger wird der Gang der Pumpe, besonders bei hohen Geschwindigkeiten.“"
                            },
                            {
                                "example_id": "8431ba36-87d7-4a19-b667-b499c6569480",
                                "sense_id": "8b9f07e8-1e54-3ace-a126-87fa696105fc",
                                "text": "„Zum Druckausgleich ist deshalb in die Druckleitung ein großer Windkessel von 20 cbm Inhalt eingeschaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
