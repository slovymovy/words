                    }
                ],
                "senses": [
                    {
                        "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                        "entry_id": "d4738a82-46c8-3977-aad3-4a3d3d7a5af9",
                        "glosses": [
                            "Morceau de viande prélevé dans le même morceau que la côte de bœuf, mais désossé et coupé dans la tranche pour en réduire l'épaisseur."
                        ],
                        "tags": [
                            "Boucherie"
                        ],
                        "examples": [
                            {
                                "example_id": "2cbd17ff-df40-4a3f-b4e5-a773662068ef",
                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                "text": "Une entrecôte grillée, braisée."
                            },
                            {
                                "example_id": "160a0866-4fb6-4ee4-a13d-397813502cc2",
                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                "text": "Cette entrecôte est très tendre."
                            },
                            {
                                "example_id": "fd7bc452-b740-40f4-822b-978ddbd4900f",
                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                "text": "C’est pour pouvoir acheter l’entrecôte\nQui nourrira les chères têtes blondes\nQu’elle commit son initiale faute\nQui la rabaisse au rang du demi-monde"
                            },
                            {
                                "example_id": "553270bc-3c4a-4515-8af8-7afb2332123b",
                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                "text": "– Laisse-moi déjà me taper la cloche, fait une voix parisienne, un petite entrecôte Bercy et un canon de beaujolais pour commencer."
                            },
                            {
                                "example_id": "ea5d95bb-73d4-4a77-b289-3dc2e94e8b50",
                                "sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                                "text": "Le poulet faisait partie des menus de fête, un mets noble alors que le bifteck frites, l’entrecôte marchand de vin étaient des plats populaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1dd8d06-13fc-4d77-8e4d-4ecf9940c473",
                        "source_entry_id": "d4738a82-46c8-3977-aad3-4a3d3d7a5af9",
                        "source_sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                        "target_lang_word": "Entrecote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entrecote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71e73629-d491-3ec9-a321-1ef014253262",
                                        "entry_id": "4c4ddc11-fdc3-3c8c-a506-d49c0fdb5ad7",
                                        "glosses": [
                                            "Rippenstück beim Rind, das in Scheiben gebraten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "801c708d-e9a8-4552-b6c5-acef037b97b0",
                                                "sense_id": "71e73629-d491-3ec9-a321-1ef014253262",
                                                "text": "Zum Mittagessen gibt es heute gebratenes Entrecote."
                                            },
                                            {
                                                "example_id": "b5fdc0f3-bb48-4c95-85d8-8443efac001f",
                                                "sense_id": "71e73629-d491-3ec9-a321-1ef014253262",
                                                "text": "Seit sie bei ihrer Tante Entrecote gegessen haben, ist dies das Lieblingsgericht der Kinder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67b99c5e-6905-4d4f-83ae-f38500fbc1e4",
                        "source_entry_id": "d4738a82-46c8-3977-aad3-4a3d3d7a5af9",
                        "source_sense_id": "98014e28-e6d4-3887-bb20-7370696fbef4",
                        "target_lang_word": "entrecôte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrecôte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                        "entry_id": "0a179cca-6f06-34b5-82b3-e37bef5c845c",
                                        "glosses": [
                                            "Sometimes in full entrecôte steak: a premium cut of beef from between the ribs used for roasts and steaks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b41dd8e-a601-4235-9b62-8bf88898ce45",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "Any dispute about the relative excellence of the beefsteak cut from the filet, as is usual in France, and of the entrecote, must henceforth be idle and absurd. Whenever, my dear young friend, you go to Paris, call at once for the entrecote; the filet in comparison to it is a poor fade lady's meat."
                                            },
                                            {
                                                "example_id": "c53a04b8-2979-41bf-bce3-44e92633b315",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "The six or the dozen premium cattle are killed, cooked, and tasted by appointed judges; the sirloin is stewed, broiled, roasted, and under each aspect offered to the epicures. The tail is souped, baked, and tested in its turn; the brain is submitted to a French fry, and the entrecotes to a broil with onions."
                                            },
                                            {
                                                "example_id": "d9d85c58-6a4b-4e26-aa80-9abdf7982338",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "The famous capital of the Gascon country has given its name to a sauce, to a method of serving the entrecôte or ribsteak, and to the cooking of the crayfish."
                                            },
                                            {
                                                "example_id": "0a3aec3e-a4b1-4f1e-a30d-b699b061799f",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "Entrecôtes of Beef à la Rockaway.—Choose three thick and tender entrecôtes of beef; pare and flatten with the cleaver; season with salt and pepper, baste with oil and broil rather rare at the least moment over a moderate charcoal fire; […] dish up the entrecôtes with a little butter, smother with the onions, and serve with scraped horseradish on a plate."
                                            },
                                            {
                                                "example_id": "9a16e5f5-f52a-40db-9da4-d5dc65a9e320",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "The entrecote, or between-the-bone steak, cut from a piece of the ribs of beef, makes a capital pièce de résistance for a little home dinner."
                                            },
                                            {
                                                "example_id": "e16cab6e-a5bb-4e47-bfd4-99f3c2cdc32c",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "[T]he mate cooked dinner using only genuine French entrecôtes scooped from the deep-freezer in the well-equipped galley, […]"
                                            },
                                            {
                                                "example_id": "72fbf60f-2f4b-4095-8940-1b390649e8a7",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "We took hot showers and headed for the pub, where we tore into plates of entrecôte and chicken, and lingered late into the night with a small bottle of red Swiss-Italian wine."
                                            },
                                            {
                                                "example_id": "e11ee7f6-8f3f-4249-906e-07dc2d1583d1",
                                                "sense_id": "fd597585-0181-3ff1-879f-d5400b8b2683",
                                                "text": "On a quaint cobblestone street in Houdan, customers file in and out of the Café de la Paroisse during the lunch rush. On the menu board are the letters \"VF\" – viande française – to show that its steak tartare and entrecôte are made with meat originating in France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
