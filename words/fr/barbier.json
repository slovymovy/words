                    "frequency": "Middle",
                    "semantic_group_id": "metier_coiffure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se rend toutes les deux semaines chez le <w>barbier</w> pour soigner sa moustache."
                        },
                        {
                            "text": "Le salon emploie un <w>barbier</w> expérimenté qui utilise encore le coupe-chou traditionnel."
                        }
                    ],
                    "synonyms": [
                        "coiffeur",
                        "figaro"
                    ],
                    "common_phrases": [
