            "senses": [
                {
                    "sense_id": "93d5abc6-8bde-3f59-a49f-e3abd46c9ce3",
                    "sense_definition": "Qui n'a pas d'éclat, qui ne réfléchit pas la lumière ou qui produit un son sourd.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "apparence_sans_eclat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour repeindre les murs du salon, nous avons préféré une peinture <w>mate</w>."
                        },
                        {
                            "text": "Elle a les yeux très clairs et un teint <w>mat</w> absolument magnifique."
                        }
                    ],
                    "synonyms": [
                        "terne"
                    ],
                    "common_phrases": [
                        "peinture mate",
                        "teint mat"
                    ]
                },
                {
                    "sense_id": "c3e49748-2be2-37ad-998d-4a35dfa4d71f",
                    "sense_definition": "Aux échecs, qualifie le roi qui est attaqué sans possibilité de défense, ou le joueur vaincu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "echecs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce déplacement imprudent de la dame, son roi est devenu totalement <w>mat</w>."
                        },
                        {
                            "text": "Si tu avances ce pion sans réfléchir, tu seras <w>mat</w> au prochain tour."
                        }
                    ],
                    "common_phrases": [
                        "roi mat"
                    ]
                }
            ]
        },
        {
