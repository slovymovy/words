{
    "word_family": [
        "deplorable",
        "deplorably",
        "deploration"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6234b8f-e39c-3ef4-b377-a98d81cc2aae",
                    "sense_definition": "To express strong disapproval of something or to condemn it as being wrong or unacceptable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disapproval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international community continues to <w>deplore</w> the violence occurring in the region.",
                            "target_lang_translations": {
                                "ru": "Международное сообщество продолжает <w>осуждать</w> насилие, происходящее в регионе.",
                                "nl": "De internationale gemeenschap blijft het geweld in de regio <w>veroordelen</w>."
                            }
                        },
                        {
                            "text": "Many local citizens <w>deplore</w> the lack of funding for public schools.",
                            "target_lang_translations": {
                                "ru": "Многие местные жители <w>порицают</w> нехватку финансирования государственных школ.",
                                "nl": "Veel lokale burgers <w>keuren</w> het gebrek aan financiering voor openbare scholen <w>af</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "condemn",
                        "denounce",
                        "censure",
                        "criticize"
                    ],
                    "antonyms": [
                        "approve",
                        "praise",
                        "commend",
                        "applaud"
                    ],
                    "common_phrases": [
                        "deplore the lack",
                        "deplore the violence",
                        "deplore the actions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать решительное неодобрение чего-либо или осуждать это как неправильное или неприемлемое.",
                        "nl": "Krachtige afkeuring over iets uitspreken of iets veroordelen als verkeerd of onaanvaardbaar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуждать",
                                "target_lang_sense_clarification": "высказывать резкое неодобрение"
                            },
                            {
                                "target_lang_word": "порицать",
                                "target_lang_sense_clarification": "официально или публично критиковать"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "veroordelen",
                                "target_lang_sense_clarification": "sterk afkeuren of verwerpen"
                            },
                            {
                                "target_lang_word": "afkeuren",
                                "target_lang_sense_clarification": "iets niet goedvinden of verwerpen"
                            },
                            {
                                "target_lang_word": "verwerpen",
                                "target_lang_sense_clarification": "afwijzen of scherp afkeuren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa36c229-8c8f-3c28-81e1-58bbf4e519b8",
                    "sense_definition": "To feel or express deep grief or regret for something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sorrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I deeply <w>deplore</w> the loss of such a talented young artist.",
                            "target_lang_translations": {
                                "ru": "Я глубоко <w>оплакиваю</w> утрату такого талантливого молодого художника.",
                                "nl": "Ik <w>betreur</w> het verlies van zo'n getalenteerde jonge kunstenaar ten zeerste."
                            }
                        },
                        {
                            "text": "He began to <w>deplore</w> his decision to leave home so early in life.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>сожалеть</w> о своем решении уйти из дома так рано.",
                                "nl": "Hij begon zijn beslissing om zo vroeg van huis weg te gaan te <w>betreuren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lament",
                        "bewail",
                        "mourn",
                        "bemoan"
                    ],
                    "antonyms": [
                        "rejoice",
                        "celebrate"
                    ],
                    "common_phrases": [
                        "deplore the loss",
                        "deeply deplore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать или выражать глубокую скорбь или сожаление по поводу чего-либо.",
                        "nl": "Diepe droefheid of spijt over iets voelen of uiten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сожалеть",
                                "target_lang_sense_clarification": "испытывать печаль или огорчение"
                            },
                            {
                                "target_lang_word": "оплакивать",
                                "target_lang_sense_clarification": "выражать глубокую скорбь об утрате"
                            },
                            {
                                "target_lang_word": "сокрушаться",
                                "target_lang_sense_clarification": "сильно печалиться о чем-либо"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "betreuren",
                                "target_lang_sense_clarification": "leedwezen of spijt voelen over iets"
                            },
                            {
                                "target_lang_word": "beklagen",
                                "target_lang_sense_clarification": "treuren om of jammer vinden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19c69782-bdd2-3444-9302-a1bf3403b17d",
                    "sense_definition": "To regard a situation as hopeless or to give up on it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hopelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors had to <w>deplore</w> the case when the patient stopped responding to treatment.",
                            "target_lang_translations": {
                                "ru": "Врачам пришлось <w>признать</w> случай <w>безнадежным</w>, когда пациент перестал реагировать на лечение.",
                                "nl": "De artsen moesten het geval <w>als hopeloos beschouwen</w> toen de patiënt niet meer op de behandeling reageerde."
                            }
                        },
                        {
                            "text": "Once the situation was <w>deplored</w> by the experts, the project was officially cancelled.",
                            "target_lang_translations": {
                                "ru": "Как только эксперты <w>признали</w> ситуацию <w>безнадежной</w>, проект был официально отменен.",
                                "nl": "Zodra de situatie door de experts <w>als hopeloos werd beschouwd</w>, werd het project officieel stopgezet."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "relinquish",
                        "give up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать ситуацию безнадежной или отказаться от дальнейших попыток что-либо исправить.",
                        "nl": "Een situatie als hopeloos beschouwen of de hoop erop opgeven."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признать безнадежным",
                                "target_lang_sense_clarification": "отказаться от надежды на успех"
                            },
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "прекратить попытки лечения или решения"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opgeven",
                                "target_lang_sense_clarification": "de hoop verliezen en stoppen met proberen"
                            },
                            {
                                "target_lang_word": "als hopeloos beschouwen",
                                "target_lang_sense_clarification": "geen uitweg of herstel meer zien"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}