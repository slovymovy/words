                ],
                "senses": [
                    {
                        "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                        "entry_id": "c9b5c668-926b-3bcf-8271-6601b1e43ae0",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed2a04e-086c-490c-976f-f545e0bbb0e3",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "Frau Abbink ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0be982b5-dacf-431e-ab7b-312b445b5a0d",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "Herr Abbink wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "45ec0668-702b-476e-9d93-a01a5213efa7",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "Die Abbinks kommen heute aus dem Erzgebirge."
                            },
                            {
                                "example_id": "6a96afe9-0ca3-4230-b3f9-910ee8bcbc9c",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "Der Abbink trägt nie die Schals, die die Abbink ihm strickt."
                            },
                            {
                                "example_id": "848fb477-1b77-4fb2-a808-48cc5a56869c",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Abbink kommt, geht der Herr Abbink.“"
                            },
                            {
                                "example_id": "8e580f47-f10d-4950-9b72-bb059fea3933",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "Abbink kommt und geht."
                            },
                            {
                                "example_id": "ccd0336f-b902-4fe7-88e4-697895feefba",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "Abbinks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "2f01d314-bd3f-4047-88f2-d446b0f4e4ff",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "An verregneten Herbsttagen ist Familie Abbinks liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "cb4b1e5d-bbfd-43ef-b7c9-4e100025e3c7",
                                "sense_id": "600c90f1-376d-3adb-87a2-3f981cbf1651",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Abbink das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
