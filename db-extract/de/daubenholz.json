                        "source_sense_id": "153d1099-1605-340e-9965-1509cddcb20f",
                        "source_sense_description": "Holz, das für den Bau eines Fasses verwendet werden kann oder verwendet wurde",
                        "target_lang_word": "douve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Nom de planches disposées en rond qui forment le corps du tonneau et qu’on fait tenir ensemble avec des cercles."
                                        ],
                                        "tags": [
                                            "Tonnellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abecaa3c-3a1e-4279-bf4b-4a1517b1ab34",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "La tonnellerie est l’industrie qui emploie la plus grande quantité de bois de fente, et l’on appelle merrain le bois plus particulièrement destiné à la fabrication des douves de tonneaux."
                                            },
                                            {
                                                "example_id": "1b0a158d-d56a-4cfc-941b-36903199df7d",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "En termes de tonnellerie, on appelle […] jable, la rainure pratiquée vers les extrémités des douves pour arrêter les fonds."
                                            },
                                            {
                                                "example_id": "57d658f5-921e-486e-ab05-3acdbb8cec6a",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "Six douves de poinçon servaient d’ais et de barre."
                                            },
                                            {
                                                "example_id": "43813811-a6d9-4ae6-b0a4-ab99777cb933",
                                                "sense_id": "cd52f4bd-8a3a-31a0-a2a0-209b9a930276",
                                                "text": "Petar fut le premier sur ses jambes dans le coin en dessous de la lampe où, au milieu d’un tas de copeaux, il maniait la plane, polissant des douves de sapin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab82cc7b-314b-36bd-9632-20380f390410",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Fossé servant de limite aux champs et d’écoulement aux eaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7964d02-e726-3854-bf89-c81571338b28",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Paroi des fossés de la fortification ancienne ou, par extension, le fossé lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a809c921-8f60-4765-947f-36f4ef87870d",
                                                "sense_id": "d7964d02-e726-3854-bf89-c81571338b28",
                                                "text": "Dans la cour, le terrain inégal est couvert de bruyères, de violettes et de cailloux. On distingue vaguement des anciens restes de douves ; on entre quelques pas dans un souterrain comblé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06136c26-df65-329b-9bb0-c1b09557267d",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Mur d’un bassin quand il n’est que d’une assise ou deux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "472fc0a4-5c45-3cd0-bc3b-886e67cb252e",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Caverne que les habitants des bords de la Loire creusent dans le roc pour s’y loger."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4b02a91-a654-39ad-9dee-0f4fda89fd2b",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Planche sur laquelle on met les peaux de veaux pour les ratisser et en enlever les parcelles de tan."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32742284-6d7d-3bdf-899a-7419ac307228",
                                        "entry_id": "4d90f53c-8635-3ec3-ba9e-de38c22a1300",
                                        "glosses": [
                                            "Un des types d'obstacle figurant dans les courses de steeple-chase."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "douve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebe5e416-605a-3b3f-9c27-0f7c25e575e4",
                                        "entry_id": "6bb22674-2131-387d-b5c5-b3fc7817aa57",
                                        "glosses": [
                                            "Ver de la classe des trématodes, ressemblant à une feuille, parasite à l’état adulte surtout des canaux biliaires dans le foie de certains ruminants, de carnivores et occasionnellement de l’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8328e2-8885-451b-9751-aa449adf3cd1",
                                                "sense_id": "ebe5e416-605a-3b3f-9c27-0f7c25e575e4",
                                                "text": "Ce troupeau appartenait au juge de Werst, le biró Koltz, lequel payait à la commune un gros droit de brébiage, et qui appréciait fort son pâtour Frik, le sachant très habile à la tonte, et très entendu au traitement des maladies, muguet, affilée, avertin, douve, encaussement, falère, clavelée, piétin, rabuze et autres affections d’origine pécuaire."
                                            },
                                            {
                                                "example_id": "7995a637-180b-4789-8c0b-ca1dd5c97353",
                                                "sense_id": "ebe5e416-605a-3b3f-9c27-0f7c25e575e4",
                                                "text": "Les douves ont une forme aplatie dorso-ventralement. Les espèces intéressant la médecine vétérinaire sont des parasites des canaux biliaires, du système digestif et des vaisseaux sanguins. Tout comme les vers de type ténias, beaucoup sont hermaphrodites […]"
                                            },
                                            {
                                                "example_id": "b0de9f27-16ae-46ae-a0c1-20db1542f046",
                                                "sense_id": "ebe5e416-605a-3b3f-9c27-0f7c25e575e4",
                                                "text": "L'un des plus grands mystères de la nature est sans aucun doute le cycle de la douve du foie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "douve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02bd47f1-9f28-3a83-acc5-7230b6defb1c",
                                        "entry_id": "cc94b4c5-6deb-393b-b6a2-3a9ed3738264",
                                        "glosses": [
                                            "Nom vernaculaire de deux espèces de renoncules de marais à feuilles lancéolées, la renoncule langue et la renoncule flammette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62c46f31-af58-410f-b153-93c46547a2c3",
                                                "sense_id": "02bd47f1-9f28-3a83-acc5-7230b6defb1c",
                                                "text": "Les deux douves vivent complètement dans l’eau, avec la grande lingua de plus d'un mètre, et la petite flammula, une vivace persistante toute l’année. Les fruits des douves sont des akènes chauves de 4 × 4 mm environ, divisés en cinq parties, de couleur verte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
