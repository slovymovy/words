                    {
                        "translation_id": "a0eda2fd-7e74-4243-acf7-71db4e2635e7",
                        "source_entry_id": "3c97f711-3a79-33a6-aa1e-9bb1878e5348",
                        "source_sense_id": "eb54b5b1-d702-3d4d-ba84-1a4746d3e2c5",
