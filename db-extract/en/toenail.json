                    {
                        "translation_id": "0bc35532-a6d0-4349-9015-76aa59bae052",
                        "source_entry_id": "049248b8-a9ca-3ec2-b74d-0844a0884565",
                        "source_sense_id": "5dafa677-fcab-3836-a138-9da0d0323f6a",
                        "source_sense_description": "the plate covering the end of a toe",
                        "target_lang_word": "Zehennagel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zehennagel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86cc3494-2c46-38c9-a1e2-478517d16fde",
                                        "entry_id": "33b2ea63-2b3d-3dab-863b-d7da93ed8b99",
                                        "glosses": [
                                            "gewölbte, durchscheinende Keratinplatte auf der Oberseite der Zehenspitze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665adab4-9b8c-4ab8-a94f-1d7a2ae1190c",
                                                "sense_id": "86cc3494-2c46-38c9-a1e2-478517d16fde",
                                                "text": "Ich sollte mir mal wieder die Zehennägel schneiden."
                                            },
                                            {
                                                "example_id": "a0a0941f-e087-4fac-8dc2-05bec3503ec0",
                                                "sense_id": "86cc3494-2c46-38c9-a1e2-478517d16fde",
                                                "text": "„Ihre behaarten Waden waren wohlgeformt, die Zehennägel niedlich rund.“"
                                            },
                                            {
                                                "example_id": "79c297f5-0c90-4a08-9f72-da19fc43921d",
                                                "sense_id": "86cc3494-2c46-38c9-a1e2-478517d16fde",
                                                "text": "„Unter den Zehennägeln klebte getrockneter, ockerfarbener Uferschlamm.“"
                                            },
                                            {
                                                "example_id": "7f13858c-0d8e-4d5c-b243-de19cbc25011",
                                                "sense_id": "86cc3494-2c46-38c9-a1e2-478517d16fde",
                                                "text": "Als Hausarzt ist man oftmals die erste Anlaufstelle für Patienten mit eitrigen eingewachsenen Zehennägeln."
                                            },
                                            {
                                                "example_id": "e4623e9e-3f97-4280-9444-009e2948be27",
                                                "sense_id": "86cc3494-2c46-38c9-a1e2-478517d16fde",
                                                "text": "„Meine Mutter hatte Wattebäusche zwischen den Zehen, das Rot auf ihren Zehennägeln glänzte feucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
