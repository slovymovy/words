                "senses": [
                    {
                        "sense_id": "47056b8a-6c3a-3976-8c2f-2ef9ae332731",
                        "entry_id": "b749598e-7690-31de-adc1-2daad76ea78a",
                        "glosses": [
                            "разг. многокр. к есть"
                        ],
                        "tags": [
