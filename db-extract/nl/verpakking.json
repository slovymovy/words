                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9237be69-7e1e-3d64-bab4-9704e31fd1c9",
                                        "entry_id": "d0153c14-2d0d-3d1a-892a-697b5673a2f7",
                                        "glosses": [
                                            "The materials used to pack something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37483330-f788-4c65-81bc-ef401da63d36",
                                                "sense_id": "9237be69-7e1e-3d64-bab4-9704e31fd1c9",
                                                "text": "Nearly 200 chemicals connected to breast cancer are used in the making of food packaging and plastic tableware, and dozens of those carcinogens can migrate into the human body, a new study found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f31c21a5-001b-322b-be16-3ad741a4fb35",
                                        "entry_id": "d0153c14-2d0d-3d1a-892a-697b5673a2f7",
                                        "glosses": [
                                            "The industry that produces such material."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd2f8b82-9eac-333b-a6b5-974246c40251",
                                        "entry_id": "d0153c14-2d0d-3d1a-892a-697b5673a2f7",
                                        "glosses": [
                                            "The manner in which a person or product is promoted."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "611a6f3f-7596-4ec1-b718-d5df2a9786f5",
                                                "sense_id": "cd2f8b82-9eac-333b-a6b5-974246c40251",
                                                "text": "Do Amaral seems to belong more to a Europian ^([sic]) tradition than to any of the artistic pigeonholes currently in vogue in the States. His failure to show allegiance to any one medium makes him resistant to the relentless packaging that is a feature even of much avant garde American art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67cf4543-bfc5-41b7-8298-13a87facf1de",
                        "source_entry_id": "3114a020-ba03-30e7-89d7-3d6271cedc71",
                        "source_sense_id": "3adc7334-1002-367e-bf50-a2ac0033a4df",
                        "source_sense_description": "het materiaal waarin iets verpakt is",
                        "target_lang_word": "emballage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emballage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09467099-5300-36b0-adaa-5a7a3cb11f7e",
                                        "entry_id": "b9fb236b-3a8e-3aeb-8123-f96d8cf2d839",
                                        "glosses": [
                                            "Action d’emballer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d1e17c-f30e-416c-b316-757f6f9d6e2b",
                                                "sense_id": "09467099-5300-36b0-adaa-5a7a3cb11f7e",
                                                "text": "Il s’est chargé de l’emballage de ces marchandises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d30e0c-fffe-3abb-a6dd-0d3870b3732f",
                                        "entry_id": "b9fb236b-3a8e-3aeb-8123-f96d8cf2d839",
                                        "glosses": [
                                            "Résultat de cette action ; ce qui emballe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7510d153-20a6-4bcc-94eb-28dba6d0566b",
                                                "sense_id": "15d30e0c-fffe-3abb-a6dd-0d3870b3732f",
                                                "text": "Antoine regarde sa mère ouvrir la barre de nougat tandis qu'il finit son chocolat chaud. C'est vraiment interminable de dégager de son emballage en plastique ce fichu nougat !"
                                            },
                                            {
                                                "example_id": "477be5d9-f013-40d2-8ce3-7d4068293a9c",
                                                "sense_id": "15d30e0c-fffe-3abb-a6dd-0d3870b3732f",
                                                "text": "Frais d’emballage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c3e3b1-1992-3f3b-938e-9689e6f3825b",
                                        "entry_id": "b9fb236b-3a8e-3aeb-8123-f96d8cf2d839",
                                        "glosses": [
                                            "Maniére d'emballer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b34a9a-ff76-46ac-90ac-4537d795d6eb",
                                                "sense_id": "71c3e3b1-1992-3f3b-938e-9689e6f3825b",
                                                "text": "Les produits font l'objet d'un classement en 8 catégories de substances et préparations vénéneuses et 6 catégories de substances et préparations dangereuses, qui en déterminent l’emballage et l’étiquettage commercial sur lequel on peut lire la nature des risques et des conseils de prudence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d8d427-07f6-3b5f-b490-c2c24196a7bf",
                                        "entry_id": "b9fb236b-3a8e-3aeb-8123-f96d8cf2d839",
                                        "glosses": [
                                            "Contenant d'un produit de grande consommation."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5da2b9fd-681a-4764-a3da-0cc931a6177e",
                                                "sense_id": "35d8d427-07f6-3b5f-b490-c2c24196a7bf",
                                                "text": "De plus en plus, l'emballage non retournable fait de nouveaux adeptes et l'on s'oriente de plus en plus vers un emballage standard, de dimensions et de poids constants."
                                            },
                                            {
                                                "example_id": "ebacd651-896f-4ce0-93d0-a6833f620838",
                                                "sense_id": "35d8d427-07f6-3b5f-b490-c2c24196a7bf",
                                                "text": "En parallèle, cette loi impose une part d’emballages réemployés sur le marché."
                                            },
                                            {
                                                "example_id": "0f4e1141-c3c7-45cd-a2e0-3d2a626e8c9a",
                                                "sense_id": "35d8d427-07f6-3b5f-b490-c2c24196a7bf",
                                                "text": "Claude adore l’argent, les affaires, elle se voit déjà à la tête d’un trust de l’emballage et de la cosméto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d3757d-d0ea-3595-a4aa-05a7fd3efa98",
                                        "entry_id": "b9fb236b-3a8e-3aeb-8123-f96d8cf2d839",
                                        "glosses": [
                                            "Matériau utilisé pour ce faire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbbbfe2f-07d2-4e8f-843e-023a3e1c97ce",
                                                "sense_id": "27d3757d-d0ea-3595-a4aa-05a7fd3efa98",
                                                "text": "La directive européenne précitée établit une distinction très précise de l’emballage. Par exemple, le boîtier pour CD, réutilisable et indispensable à la bonne préservation du disque, n’est pas un emballage. Par contre, le film qui l’entoure pour la vente est un emballage. (Wikipédia, Emballage)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cbaaa80-bd11-33a3-ba3a-df89f1115494",
                                        "entry_id": "b9fb236b-3a8e-3aeb-8123-f96d8cf2d839",
                                        "glosses": [
                                            "Apparence, ornements."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1b940d-1b23-430c-b29d-be2cb3302ad5",
                                                "sense_id": "2cbaaa80-bd11-33a3-ba3a-df89f1115494",
                                                "text": "J’allais vers la facilité, vers les terroristes qui avaient un emballage plus attirant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
