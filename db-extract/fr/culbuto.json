                "senses": [
                    {
                        "sense_id": "e088a6b1-c270-3a29-8967-a7ab6766b7e1",
                        "entry_id": "1048ca56-e906-3852-8881-475555dc2a41",
                        "glosses": [
                            "Jouet d’éveil, souvent de forme plus ou moins conique, muni d’une base hémisphérique et massive qui lui permet de se redresser quelle que soit la position dans laquelle on le met."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab02e27-edb1-4c7b-a402-6eacb6548eb2",
                                "sense_id": "e088a6b1-c270-3a29-8967-a7ab6766b7e1",
                                "text": "Je représente souvent la confiance en soi comme un culbuto : vous savez, ces jouets dont la base arrondie est remplie de plomb."
                            },
                            {
                                "example_id": "c2847a76-6833-4dae-bb32-47ec6ed4006f",
                                "sense_id": "e088a6b1-c270-3a29-8967-a7ab6766b7e1",
                                "text": "— Rade à l’ancienne, bonhomme, […], avec carrelage, mosaïque, acajou, tape dans le dos et rondelle de ciflard offerte par un culbuto ambulant qui, à force de danse du croupion, finit par vous échauffer le bouillon Kub."
                            }
                        ]
                    }
