                "senses": [
                    {
                        "sense_id": "224b7e92-c61a-3ddb-9442-b7ad0a8f8492",
                        "entry_id": "859642ff-2221-3ca3-85a5-be458c06d894",
                        "glosses": [
                            "Donner un caractère kitsch à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45dd9d1f-b924-430f-996f-0464bd22d418",
                                "sense_id": "224b7e92-c61a-3ddb-9442-b7ad0a8f8492",
                                "text": "Tu as enkitsché la vieille Allemagne, avec tes images simplistes d’ouvriers et de paysans."
                            },
                            {
                                "example_id": "85cd8356-5cbc-4b40-941e-600190d09772",
                                "sense_id": "224b7e92-c61a-3ddb-9442-b7ad0a8f8492",
                                "text": "Le Poulpe s’était gravi les deux étages étouffés de tapis encadrées de baguettes or, dédaignant l’ascenseur enkitsché de fer forgé, le souffle court à l’idée que le désaxé de service avait manifestement de quoi se payer des poupées Ravie à la en-veux-tu-en-voilà."
                            },
                            {
                                "example_id": "cc200142-73de-40a4-93ae-4e1cb2d91580",
                                "sense_id": "224b7e92-c61a-3ddb-9442-b7ad0a8f8492",
                                "text": "J'aime assez enkitscher les choses."
                            }
                        ]
                    }
