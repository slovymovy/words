                        "sense_id": "a852bef2-7748-30dc-a4bc-b09c834a184e",
                        "entry_id": "16b2c05e-9f21-3f81-8066-a251c50bb390",
                        "glosses": [
                            "uitbouw aan een gevel waardoor een kamer boven de straat of tuin uitspringt, vaak met veel ramen zodat er meer licht in de kamer valt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6240b8c7-50d6-4f20-a4de-a55a7ceb55dd",
                                "sense_id": "a852bef2-7748-30dc-a4bc-b09c834a184e",
                                "text": "De net bijgebouwde erker zorgde voor wat meer schaduw in de tuin."
                            },
                            {
                                "example_id": "b086185d-9eca-4cdb-8d7b-f5c9ac2ccdca",
                                "sense_id": "a852bef2-7748-30dc-a4bc-b09c834a184e",
                                "text": "Ze dronken voorzichtig van een halve fles laat geoogste moezelwijn, voor namelijk om iets voor zich te hebben staan op de mooi gesneden tafel in de erker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "126cc9db-a71f-4cad-bf26-54a0fa792297",
                        "source_entry_id": "16b2c05e-9f21-3f81-8066-a251c50bb390",
                        "source_sense_id": "a852bef2-7748-30dc-a4bc-b09c834a184e",
