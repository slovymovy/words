                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6d94880-1ccc-4593-8afa-70bc09870557",
                                "sense_id": "0d75b7b9-dc98-3ef9-b9c5-8774a68ef7cb",
                                "text": "„Dieser, wie bereits bemerkt, befand sich in einem ziemlich großen Gebäude, das, einem Kornboden oder einer großen Scheune nicht unähnlich, mit Brettern überkleidet war, und von denen mehrere losgerissen im Windstoße schnarrend und knarrend hin und her schwankten.“"
                            }
