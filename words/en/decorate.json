{
    "word_family": [
        "decoration",
        "decorator",
        "decorative",
        "decorativeness",
        "redecorate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05ae5e71-6d9d-3965-a4f7-c3ed2a3d357b",
                    "sense_definition": "To add something to an object or place to make it look more attractive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adornment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>decorated</w> the Christmas tree with tinsel and baubles.",
                            "target_lang_translations": {
                                "ru": "Мы <w>нарядили</w> елку мишурой и шарами."
                            }
                        },
                        {
                            "text": "The children like to <w>decorate</w> the room for the party.",
                            "target_lang_translations": {
                                "ru": "Детям нравится <w>украшать</w> комнату к празднику."
                            }
                        }
                    ],
                    "synonyms": [
                        "adorn",
                        "beautify",
                        "deck",
                        "embellish",
                        "ornament"
                    ],
                    "antonyms": [
                        "deface",
                        "disfigure"
                    ],
                    "common_phrases": [
                        "decorate the room",
                        "decorate for Christmas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять что-либо к объекту или месту, чтобы сделать его более привлекательным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "делать более привлекательным"
                            },
                            {
                                "target_lang_word": "наряжать",
                                "target_lang_sense_clarification": "о елке или праздничном оформлении"
                            },
                            {
                                "target_lang_word": "декорировать",
                                "target_lang_sense_clarification": "художественно оформлять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f0ee3f-e15c-3726-8cac-36d7c0c4924a",
                    "sense_definition": "To improve the appearance of the interior of a building by painting or wallpapering.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "renovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There's some paint left over from when we <w>decorated</w> the guest bedroom.",
                            "target_lang_translations": {
                                "ru": "Осталось немного краски с тех пор, как мы <w>делали ремонт</w> в гостевой спальне."
                            }
                        },
                        {
                            "text": "We moved in over a month ago but we still haven't gotten started on <w>decorating</w>.",
                            "target_lang_translations": {
                                "ru": "Мы въехали больше месяца назад, но до сих пор не приступили к <w>отделке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "do up"
                    ],
                    "common_phrases": [
                        "decorate the house",
                        "newly decorated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать внешний вид интерьера здания путем покраски или наклеивания обоев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать ремонт",
                                "target_lang_sense_clarification": "косметический ремонт помещений"
                            },
                            {
                                "target_lang_word": "отделывать",
                                "target_lang_sense_clarification": "заниматься внутренней отделкой"
                            },
                            {
                                "target_lang_word": "декорировать",
                                "target_lang_sense_clarification": "оформлять интерьер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "215a109a-22f3-37a1-94d9-d669f52c55b8",
                    "sense_definition": "To honor someone by giving them a medal or other official award.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>decorated</w> soldier who served in three wars.",
                            "target_lang_translations": {
                                "ru": "Он был <w>награжденным</w> солдатом, прошедшим три войны."
                            }
                        },
                        {
                            "text": "The general will <w>decorate</w> the brave pilot for his service.",
                            "target_lang_translations": {
                                "ru": "Генерал <w>наградит</w> отважного пилота за его службу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "highly decorated",
                        "decorate for bravery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Почитать кого-либо, вручая медаль или другую официальную награду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награждать",
                                "target_lang_sense_clarification": "вручать орден или медаль"
                            },
                            {
                                "target_lang_word": "представлять к награде",
                                "target_lang_sense_clarification": "официально отмечать заслуги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ddd31ce-3716-3e52-876d-594254ede746",
                    "sense_definition": "To extend a method or function by attaching additional code or attributes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer decided to <w>decorate</w> the class with a custom attribute.",
                            "target_lang_translations": {
                                "ru": "Разработчик решил <w>декорировать</w> класс пользовательским атрибутом."
                            }
                        },
                        {
                            "text": "It makes sure that the field specified is an actual existing field in the class which declares the method <w>decorated</w> with this attribute.",
                            "target_lang_translations": {
                                "ru": "Это гарантирует, что указанное поле действительно существует в классе, который объявляет метод, <w>помеченный</w> этим атрибутом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "decorated method",
                        "decorate a function"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расширять метод или функцию путем присоединения дополнительного кода или атрибутов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декорировать",
                                "target_lang_sense_clarification": "использовать декоратор в программировании"
                            },
                            {
                                "target_lang_word": "аннотировать",
                                "target_lang_sense_clarification": "добавлять атрибуты или метаданные"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "336b9c3f-5dd1-34c5-9e14-5c337180ad2e",
                    "sense_definition": "Being in a state of being <w>decorated</w> or adorned.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "adornment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>decorate</w> surfaces of the ancient temple were covered in gold.",
                            "target_lang_translations": {
                                "ru": "<w>Украшенные</w> поверхности древнего храма были покрыты золотом."
                            }
                        },
                        {
                            "text": "The hall looked more <w>decorate</w> than usual for the royal visit.",
                            "target_lang_translations": {
                                "ru": "Зал выглядел более <w>нарядным</w>, чем обычно, по случаю королевского визита."
                            }
                        }
                    ],
                    "synonyms": [
                        "adorn",
                        "array"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в украшенном или оформленном состоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшенный",
                                "target_lang_sense_clarification": "имеющий декоративные элементы"
                            },
                            {
                                "target_lang_word": "декорированный",
                                "target_lang_sense_clarification": "художественно оформленный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}