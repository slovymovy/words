                        "entry_id": "21a5a805-a1ab-3ea5-b6fc-be011f4aaf37",
                        "glosses": [
                            "posługacz w synagodze, gminie, sądzie rabinackim bądź w bractwie żydowskim, którego zadaniem było m.in. przygotowywanie synagogi do nabożeństw, pomaganie chazanom, poranne budzenie mężczyzn na modlitwy itp."
                        ],
                        "tags": [
                            "Jewish"
                        ],
                        "examples": [
                            {
                                "example_id": "3b9e3a84-11b2-44cb-9825-d7855a1eba25",
                                "sense_id": "d7df5891-c3ca-3237-ad7d-cca8cf620a67",
                                "text": "Późno wieczorem rebe zawołał do siebie szamesa i kazał sobie powtórzyć nowiny. Wiadomości były okropne. W ciągu dnia zmarło jeszcze stu trzydziestu Żydów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
