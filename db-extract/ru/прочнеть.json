                "senses": [
                    {
                        "sense_id": "96c24c70-6bd7-338d-876c-db9e1138d8ff",
                        "entry_id": "0fe64ecc-19a6-3634-9b6d-d5ec3b395fd5",
                        "glosses": [
                            "становиться более прочным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658862da-dba9-47f0-b70c-ccb34a8a32f3",
                                "sense_id": "96c24c70-6bd7-338d-876c-db9e1138d8ff",
                                "text": "Бук в воде не гниёт, от воды он только прочнеет."
                            },
                            {
                                "example_id": "1e8ddcf5-a57b-4752-9a6d-22fbf5116eff",
                                "sense_id": "96c24c70-6bd7-338d-876c-db9e1138d8ff",
                                "text": "Плод весит 700—750 г. Наращивают массу мышцы, удлиняется и прочнеет скелет."
                            },
                            {
                                "example_id": "093d952d-7bc2-440b-99bb-9c4f14d3678f",
                                "sense_id": "96c24c70-6bd7-338d-876c-db9e1138d8ff",
                                "text": "Слава твоя прочнеет."
                            }
                        ]
                    }
