                        "entry_id": "be745bcb-acdb-347b-9e8f-54ebe12c41d6",
                        "glosses": [
                            "Eigenschaft, sehr gewitzt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7742919f-a619-4335-8743-94d26aca5a72",
                                "sense_id": "3e448e0d-96f7-32c0-8808-1d30ea198460",
                                "text": "„Seine Cleverness und Skrupellosigkeit verbargen sich hinter einem fast gütig wirkenden, sehr dunklen Gesicht mit Vollbart und großen, treu in die Welt blickenden Augen.“"
                            },
                            {
                                "example_id": "dd13c600-2891-47e7-b98f-4972796c63ff",
                                "sense_id": "3e448e0d-96f7-32c0-8808-1d30ea198460",
                                "text": "„Auch Ranjids Cleverness wurde von der Lehrerin negativ getestet.“"
                            },
                            {
                                "example_id": "b41ce6c2-a03d-4356-b50b-d548943e089c",
                                "sense_id": "3e448e0d-96f7-32c0-8808-1d30ea198460",
                                "text": "„Janies Cleverness bestand darin, dass sie, als sie in den Vorort kam, erkannte, wozu die Vororte da waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
