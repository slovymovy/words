    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d103be00-2892-3557-b7a3-dba9d98eca09",
                "word": "matting",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7b6bc942-51fe-4b26-b204-60c5c8b72a57",
                        "entry_id": "d103be00-2892-3557-b7a3-dba9d98eca09",
                        "tags": [
