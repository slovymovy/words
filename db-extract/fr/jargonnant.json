                        "glosses": [
                            "Caractérise un exposé, un discours… qui tient du jargon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fce4891-d724-47f5-b145-6535e9320a34",
                                "sense_id": "953f3368-3239-3b80-b808-1608a37d12b7",
                                "text": "Point d’interview de chercheurs ou de propos jargonnants (un glossaire permet toutefois de préciser certains termes techniques)."
                            },
                            {
                                "example_id": "e348c7af-d23a-4feb-bd12-f462902be57a",
                                "sense_id": "953f3368-3239-3b80-b808-1608a37d12b7",
                                "text": "Mais cette prose, pour jargonnante qu’elle soit, résume bien un double mouvement : les grosses entreprises comptent de moins en moins de salariés, et pourtant elles pèsent de plus en plus économiquement."
                            }
                        ]
                    }
