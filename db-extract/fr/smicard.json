                        "glosses": [
                            "Personne payée au SMIC."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b0243419-2c27-48ba-8846-d1d2797d25d3",
                                "sense_id": "2d365745-bc9e-3cc8-89f4-de62638f64b8",
                                "text": "Je suis smicard et ma copine est au chômage, on roule sur l’or en somme !"
                            },
                            {
                                "example_id": "c8eab4e6-829f-484b-bb79-53fde45abd6a",
                                "sense_id": "2d365745-bc9e-3cc8-89f4-de62638f64b8",
                                "text": "Si la France compte environ 10 000 smicards, l’immense majorité n’omet pas de déclarer ses revenus."
                            },
                            {
                                "example_id": "62a114e5-a60c-4ad3-9b90-fb28c968c4e2",
                                "sense_id": "2d365745-bc9e-3cc8-89f4-de62638f64b8",
                                "text": "Patrick Pouyanné avec la coupe de cheveux de Nasser, et si c’était ça le secret d’une relation apaisée entre hauts salaires et smicards ?"
                            }
                        ]
                    }
                ],
