                    {
                        "translation_id": "7261458c-3942-4fd4-ac55-8b90e8f1a613",
                        "source_entry_id": "e9fd427b-05dd-3ce4-9f85-c973023f79d9",
                        "source_sense_id": "943d75d4-c90f-3415-ab88-a79351d28c81",
