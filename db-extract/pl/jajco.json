                        ],
                        "form": "jajca"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0a60f7f-f5e5-3bc0-aa5b-2fc6f8464a71",
                        "entry_id": "fd628a17-aae6-34c8-bf3b-d3908f476311",
                        "glosses": [
                            "jajko"
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "afbb2010-1460-4ce9-a33a-905882a7de45",
                                "sense_id": "b0a60f7f-f5e5-3bc0-aa5b-2fc6f8464a71",
                                "text": "Ile ona tych jajec wbiła do tej jajecznicy?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "681a439a-9168-4852-b74e-95e8fbe228f7",
                        "source_entry_id": "fd628a17-aae6-34c8-bf3b-d3908f476311",
                        "source_sense_id": "b0a60f7f-f5e5-3bc0-aa5b-2fc6f8464a71",
                        "target_lang_word": "яйцо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "яйцо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b39bc195-1edd-3b16-9149-aa9a5f8103da",
                                        "entry_id": "5945705d-8855-3cee-96c4-9fffd9c1fd7e",
                                        "glosses": [
                                            "биол., зоол. то же, что яйцеклетка; женская половая клетка животных и растений, после оплодотворения развивающаяся в новый организм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e91e6f-46c6-4c44-a846-2e3841d1124c",
                                                "sense_id": "b39bc195-1edd-3b16-9149-aa9a5f8103da",
                                                "text": "Центриоли способствуют образованию веретена при первом делении оплодотворённого яйца."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a658b1-56f8-340a-92d7-f79620f61499",
                                        "entry_id": "5945705d-8855-3cee-96c4-9fffd9c1fd7e",
                                        "glosses": [
                                            "зоол. зародыш личинки насекомых, червей и т. п. в виде небольшой, обычно овальной формы крупинки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159071a9-dfc9-4f39-8011-34e180395205",
                                                "sense_id": "f8a658b1-56f8-340a-92d7-f79620f61499",
                                                "text": "Помолчит, выпьет стакан чаю и расскажет, как он … собирал муравьиные яйца для соловьёв."
                                            },
                                            {
                                                "example_id": "6f54ed6e-cfac-40a9-ba97-28a56694440f",
                                                "sense_id": "f8a658b1-56f8-340a-92d7-f79620f61499",
                                                "text": "За спиною мешок с западком и клеткой, за поясом сбоку два мешочка: один для себя с чёрным хлебом, другой — для птиц на подкорм, и в нём свои отделения: конопляное семя, муравьиные яйца, даже живые жуки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b56107-18ef-39f8-8a4a-c0340ee107ab",
                                        "entry_id": "5945705d-8855-3cee-96c4-9fffd9c1fd7e",
                                        "glosses": [
                                            "вместилище, в котором образуется и развивается зародыш птиц, пресмыкающихся и клоачных; совокупность белка и желтка в оболочке (обычно овальной формы в твёрдой и хрупкой скорлупе)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fbea610-610b-4a02-8cc2-fd6871e3f84f",
                                                "sense_id": "47b56107-18ef-39f8-8a4a-c0340ee107ab",
                                                "text": "Яйца страусов, оставленные без присмотра взрослых птиц, часто становятся добычей хищников."
                                            },
                                            {
                                                "example_id": "388d48da-132f-4602-9a98-1466d33b3342",
                                                "sense_id": "47b56107-18ef-39f8-8a4a-c0340ee107ab",
                                                "text": "В неволе черепахи размножаются редко, но всё же иногда откладывают яйца весной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d71c20d8-581b-3e33-a4ee-6afb2250d878",
                                        "entry_id": "5945705d-8855-3cee-96c4-9fffd9c1fd7e",
                                        "glosses": [
                                            "такой зародыш как пищевой продукт"
                                        ],
                                        "tags": [
                                            "тж. неисч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759d4d9f-6fbc-44da-93af-a80d9442016c",
                                                "sense_id": "d71c20d8-581b-3e33-a4ee-6afb2250d878",
                                                "text": "Первоначально предполагалось, что завезти яйцо предстоит в сентябре текущего года, после сдачи в эксплуатацию инкубатора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7bdf18d-c1ec-39be-9fcc-586eae858c6c",
                                        "entry_id": "5945705d-8855-3cee-96c4-9fffd9c1fd7e",
                                        "glosses": [
                                            "кулин. кушанье, приготовленное из такого пищевого продукта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b46951-615e-40d1-a198-8c4651144efe",
                                                "sense_id": "b7bdf18d-c1ec-39be-9fcc-586eae858c6c",
                                                "text": "Перед полуночью Ариадна объявляла, что она хочет есть, и требовала ветчины и яиц всмятку."
                                            },
                                            {
                                                "example_id": "8da414eb-9755-4ed0-bf2d-ad4d0516c6d9",
                                                "sense_id": "b7bdf18d-c1ec-39be-9fcc-586eae858c6c",
                                                "text": "«Омлет, ветчина, яйцо всмятку, яйцо по-английски, сыр, масло, кофе, шоколад, чай?»"
                                            },
                                            {
                                                "example_id": "0e4c5f24-2caa-4821-9502-75293e380166",
                                                "sense_id": "b7bdf18d-c1ec-39be-9fcc-586eae858c6c",
                                                "text": "Перепелиные яйца в кулинарии[.] Яйца перепелов употребляют в пищу сырыми, варёными, жареными или маринованными."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf985b2e-0f81-3601-bf72-4f1fc9b325bf",
                                        "entry_id": "5945705d-8855-3cee-96c4-9fffd9c1fd7e",
                                        "glosses": [
                                            "перен. предмет, формой напоминающий такой зародыш"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1b11ca-f5bf-4832-b1f3-d73c1b3048aa",
                                                "sense_id": "bf985b2e-0f81-3601-bf72-4f1fc9b325bf",
                                                "text": "В окнах булочных развешены гирлянды сахарных яиц с самыми разнообразными украшениями."
                                            },
                                            {
                                                "example_id": "cd47109f-e33b-4d03-93d3-31ca3d1190bf",
                                                "sense_id": "bf985b2e-0f81-3601-bf72-4f1fc9b325bf",
                                                "text": "МТС придётся доказывать право на использование в логотипе яйца в квадрате."
                                            },
                                            {
                                                "example_id": "d96cf04c-0719-4640-bf43-db6b096e4aa7",
                                                "sense_id": "bf985b2e-0f81-3601-bf72-4f1fc9b325bf",
                                                "text": "Внезапно раздались крики, повалил дым из трансформаторов подстанции, отодвинулись брезентовые врата огромного сооружения, и вышла из них вовсе не ракета — вышло гигантское серебристое яйцо с иллюминаторами и радужным нимбом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ebe2f73-1253-3811-a01b-e758acaf3734",
                                        "entry_id": "5945705d-8855-3cee-96c4-9fffd9c1fd7e",
                                        "glosses": [
                                            "жарг., автомоб. стойки стабилизатора поперечной устойчивости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afc65b46-c781-4df9-9d95-b1d388e02f1f",
                                                "sense_id": "6ebe2f73-1253-3811-a01b-e758acaf3734",
                                                "text": "— Завтра поеду на СТО, похоже, пора менять яйца."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "яйцо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3358a935-e57a-39da-8a17-43f22e88df23",
                                        "entry_id": "0113f10e-af5a-3548-a2af-5308ca24b7f2",
                                        "glosses": [
                                            "мошонка вместе с содержащимися в ней яичками (у мужчин и самцов млекопитающих)"
                                        ],
                                        "tags": [
                                            "разг., преимущ. мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d0c2c5-6911-4088-8fa5-d8adf2c25df9",
                                                "sense_id": "3358a935-e57a-39da-8a17-43f22e88df23",
                                                "text": "К коммунизму мы идём, // Птицефермы строятся! // А колхозник видит яйца, // Когда в бане моется!"
                                            },
                                            {
                                                "example_id": "bd38d1df-bcbc-4ac8-9ea1-8a4632dce622",
                                                "sense_id": "3358a935-e57a-39da-8a17-43f22e88df23",
                                                "text": "Ходит дедка по грядам, // Кричит: «Яица продам!» // Вышла бабка на крылец: // «Что ж ты делаешь, подлец!»"
                                            },
                                            {
                                                "example_id": "74026f02-8404-483f-9698-8dda9a335b03",
                                                "sense_id": "3358a935-e57a-39da-8a17-43f22e88df23",
                                                "text": "Обцы, да обцы, // Огурцы да яйцы! // Мою милку хлопнули // В огороде зайцы!"
                                            },
                                            {
                                                "example_id": "aaa4314c-0058-4cc9-8e91-b604138ab7f6",
                                                "sense_id": "3358a935-e57a-39da-8a17-43f22e88df23",
                                                "text": "По деревне мы пройдём, — // Все нарастопашечку! // У нас яицы большие — // С хлебальную чашечку!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52397cb1-94c3-38e7-96ed-49cb9f20cebc",
                                        "entry_id": "0113f10e-af5a-3548-a2af-5308ca24b7f2",
                                        "glosses": [
                                            "то же, что и яичко, парный мужской орган размножения (лат. testis мн. ч. testes, testicle), находящийся в мошонке, имеющий эллипсоидную форму и вырабатывающий мужские половые клетки — сперматозоиды"
                                        ],
                                        "tags": [
                                            "разг., преимущ. мн. ч."
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6f37bbb-e161-34fd-91fa-cc2efe7d37a3",
                                        "entry_id": "0113f10e-af5a-3548-a2af-5308ca24b7f2",
                                        "glosses": [
                                            "то же, что гонады; семенники́, половые железы животных, в т. ч. как пищевой продукт; блюдо, деликатес; тж. в сравнениях"
                                        ],
                                        "tags": [
                                            "разг., преимущ. мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a83d042a-4db5-40ce-b816-d3775666ca7d",
                                                "sense_id": "c6f37bbb-e161-34fd-91fa-cc2efe7d37a3",
                                                "text": "— И замо́к на ней вот такой, как бычьи яйца."
                                            },
                                            {
                                                "example_id": "aa8a9b43-015e-467e-9984-77f8ff20daef",
                                                "sense_id": "c6f37bbb-e161-34fd-91fa-cc2efe7d37a3",
                                                "text": "— Белый царь, а с ним ещё человек сто челяди. Подают Хрущёву бараньи яйца. «Попробуйте, Никита Сергеевич, это наш деликатес»."
                                            },
                                            {
                                                "example_id": "2bfe3fc9-845f-4ccd-9d9c-674966d5f3c4",
                                                "sense_id": "c6f37bbb-e161-34fd-91fa-cc2efe7d37a3",
                                                "text": "— По лицу видно, алкоголик. И глаза, как бараньи яйца. — Мама, я не знаю, как выглядят бараньи яйца, но у Ваньки красивые, чуть навыкате карие глаза."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
