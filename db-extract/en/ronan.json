                        "entry_id": "363537bd-1700-3c27-9423-1d29ec074f2d",
                        "glosses": [
                            "A male given name from Irish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee2d499-26e2-4f35-9485-47c82cf130dc",
                                "sense_id": "d00fb3c2-f63d-3988-88fb-9280468d4c0f",
                                "text": "He'd said that his mother was from Ireland, that he had been born there but came to England when he was just a little boy, he had changed his name from Ronan to Robert, to fit in, and she'd said, fancy that."
                            }
                        ]
                    }
                ],
