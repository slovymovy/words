                        "source_entry_id": "6b4f8a11-5105-353b-9777-af2c18d3684c",
                        "target_lang_word": "Orakel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orakel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a46fc3e-d298-3301-8d11-f35db53bdd16",
                                        "entry_id": "6de7a8c1-da19-360f-9a73-1c50acf30b04",
                                        "glosses": [
                                            "meist antike Stätte, Ort, Platz, an der ein Medium (oft Priester oder Seherinnen) Vorhersagen trifft oder auf Zukunfts- und Entscheidungsfragen mit rätselhaften, mehrdeutigen Aussagen antwortet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae15041-b797-4e39-8f25-bb23bb131d33",
                                                "sense_id": "3a46fc3e-d298-3301-8d11-f35db53bdd16",
                                                "text": "„Der Legende nach prophezeite das Orakel von Delphi dem König von Theben, Laios, dass sein Sohn ihn dereinst töten und seine Frau heiraten werde.“"
                                            },
                                            {
                                                "example_id": "7fd034c0-e24d-4186-afbe-9cc1c8e48c7b",
                                                "sense_id": "3a46fc3e-d298-3301-8d11-f35db53bdd16",
                                                "text": "„Vielleicht haben Prognosen für uns den gleichen Stellenwert wie bei den alten Griechen das Orakel von Delphi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3e03dab-6432-38b3-9430-014de0507436",
                                        "entry_id": "6de7a8c1-da19-360f-9a73-1c50acf30b04",
                                        "glosses": [
                                            "die Zukunft voraussagender Spruch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7757b70f-803c-432d-9f9e-b22397f25261",
                                                "sense_id": "e3e03dab-6432-38b3-9430-014de0507436",
                                                "text": "„Meine Orakel waren immer dann dunkel, wenn ich die näheren Umstände nicht kannte; über ihre Krankheit aber waren sie es nicht, und das machte ihr mein Orakel lieb und unentbehrlich.“"
                                            },
                                            {
                                                "example_id": "eb73efd5-2d01-484e-b10f-a01c3410ff68",
                                                "sense_id": "e3e03dab-6432-38b3-9430-014de0507436",
                                                "text": "Marieluise und Klausdieter vertrauen häufig den Orakeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e7a41540-3548-375e-9a3a-a1710aa44c97",
                                        "entry_id": "6de7a8c1-da19-360f-9a73-1c50acf30b04",
                                        "glosses": [
                                            "zweifelhafter Ratgeber, dessen Aussagen nicht überprüfbar sind"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbcf9274-5d41-4b48-839d-b7597add7694",
                                                "sense_id": "e7a41540-3548-375e-9a3a-a1710aa44c97",
                                                "text": "Marieluise und Klausdieter vertrauen häufig den Orakeln."
                                            }
