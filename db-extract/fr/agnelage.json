                        "entry_id": "80968d49-da23-3011-904d-fd3c61351555",
                        "glosses": [
                            "Mise bas des agneaux au printemps, après 5 mois de gestation."
                        ],
                        "tags": [
                            "Élevage",
                            "Reproduction"
                        ],
                        "examples": [
                            {
                                "example_id": "37b98367-2ab1-468c-bb02-1bef56ab207b",
                                "sense_id": "e99238ac-9eef-3572-adce-87ea868119fd",
                                "text": "Quand la période de l’agnelage arrivait, peu après le retour de transhumance, il fallait commencer par préparer la bergerie."
                            },
                            {
                                "example_id": "64ae925b-7a32-4be6-a8fb-e1faad9f04a4",
                                "sense_id": "e99238ac-9eef-3572-adce-87ea868119fd",
                                "text": "Janvier, il surveille l’agnelage et commence en février la traite biquotidienne qu’il poursuivra jusqu’en juillet."
                            }
                        ]
                    }
                ],
