                ],
                "senses": [
                    {
                        "sense_id": "dff4f75b-92d9-3c5f-ace5-c3764edb120f",
                        "entry_id": "28439bbf-ea78-3a79-b83a-af88214427ff",
                        "glosses": [
                            "Schmuckstein mit vertieft oder erhaben gearbeiteten Figuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c8bc8d-52c7-48cc-b452-970370e31a10",
                                "sense_id": "dff4f75b-92d9-3c5f-ace5-c3764edb120f",
                                "text": "Einige wenige Künstler, die das Anfertigen einer Gemme beherrschen, arbeiten noch mit traditionellem Werkzeug."
                            },
                            {
                                "example_id": "9a2de2c3-7cba-4090-a68a-5a9a83dd3dea",
                                "sense_id": "dff4f75b-92d9-3c5f-ace5-c3764edb120f",
                                "text": "„Annette wie Sibylle sammelten mit Vorliebe alte Münzen, Gemmen und Kupferstiche.“"
                            },
                            {
                                "example_id": "925217c0-1be9-4dae-a633-1057a5dc5ccf",
                                "sense_id": "dff4f75b-92d9-3c5f-ace5-c3764edb120f",
                                "text": "„Bei diesen Worten zeigte er auf die zerschlagene Gemme.“"
                            },
                            {
                                "example_id": "44c8cf7e-e9f6-4fd9-a364-3beb230f4feb",
                                "sense_id": "dff4f75b-92d9-3c5f-ace5-c3764edb120f",
                                "text": "„Mein lieber Bruder Giovanni machte mir einen herrlichen Onyx zum Geschenk, eine Gemme mit dem Basrelief einer schwimmenden Venus.“"
                            },
                            {
                                "example_id": "ab67bffa-bd17-4001-87d2-1e40ec8dcda4",
                                "sense_id": "dff4f75b-92d9-3c5f-ace5-c3764edb120f",
                                "text": "„Kate Hegström hob das schmale Gesicht, das fehlerfrei wie eine Gemme geschnitten war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
