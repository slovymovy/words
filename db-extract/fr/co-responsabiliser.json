                "senses": [
                    {
                        "sense_id": "b1eb8ef2-eb34-3d44-9b74-ae64b2327f69",
                        "entry_id": "a6a3bfd8-e99c-3bcc-bbd7-2f999aa39e3e",
                        "glosses": [
                            "Responsabiliser en même temps (plusieurs personnes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd3cabec-a11d-4b88-8d51-0a0ee23ebee8",
                                "sense_id": "b1eb8ef2-eb34-3d44-9b74-ae64b2327f69",
                                "text": "Certains dispositifs visent à co-responsabiliser salarié et employeur de façon à faire converger les actions de formation décidées par l’entreprise et inscrites dans son plan de formation et celles demandées à titre individuel par le salarié."
                            },
                            {
                                "example_id": "ee1ee66e-add1-480c-984a-caad3d10017a",
                                "sense_id": "b1eb8ef2-eb34-3d44-9b74-ae64b2327f69",
                                "text": "Impliquer les participants, les co-responsabiliser."
                            },
                            {
                                "example_id": "c91c0c41-4647-459f-b784-3876cecdb541",
                                "sense_id": "b1eb8ef2-eb34-3d44-9b74-ae64b2327f69",
                                "text": "Comment peut-on se co-responsabiliser de façon collective pour la durabilité de nos territoires?"
                            }
                        ]
                    }
