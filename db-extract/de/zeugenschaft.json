                "senses": [
                    {
                        "sense_id": "d04f90ce-aa91-317d-ba45-f6f43523ad13",
                        "entry_id": "c8e5f394-3342-3998-913d-91051443837a",
                        "glosses": [
                            "Eigenschaft, Zeuge von etwas zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d8e6d0-2e51-4bf1-bc35-2c7f19e81dba",
                                "sense_id": "d04f90ce-aa91-317d-ba45-f6f43523ad13",
                                "text": "„In seine Zeugenschaft des vielfältigen Todes im 20. Jahrhundert geht ein Misstrauen gegenüber den Menschen ein – Menschen, denen er zuhört, die er beobachtet, die er bis in die Menschheitsgeschichte verfolgt und erforscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6e068529-f769-3cd4-b23a-f479b17ee012",
                        "entry_id": "c8e5f394-3342-3998-913d-91051443837a",
                        "glosses": [
                            "Handlung, etwas zu bezeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8604395d-d178-43ef-8325-e362f5d7f248",
                                "sense_id": "6e068529-f769-3cd4-b23a-f479b17ee012",
                                "text": "Ohne seine Zeugenschaft wäre es nicht zur Verurteilung gekommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "58676db4-bab5-36b4-8217-cbf18dc2253a",
                        "entry_id": "c8e5f394-3342-3998-913d-91051443837a",
                        "glosses": [
                            "Gesamtheit der Personen, für die [1]/[2] gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "105dcb17-38ff-40f9-adee-6a4a432a0f99",
                                "sense_id": "58676db4-bab5-36b4-8217-cbf18dc2253a",
                                "text": "Einige aus der Zeugenschaft hinterließen keinen vertrauenswürdigen Eindruck."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
