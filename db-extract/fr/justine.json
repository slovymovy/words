                                "target_senses": [
                                    {
                                        "sense_id": "7d0fedd2-57be-3b6a-be7f-d20053fed421",
                                        "entry_id": "5ad69d9c-c84d-3fd8-9903-88c953736876",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a01b28-ca84-4efb-ba84-c19c8ed458c8",
                                                "sense_id": "7d0fedd2-57be-3b6a-be7f-d20053fed421",
                                                "text": "O you who have wept tears upon hearing of Virtue's miseries; you who have been moved to sympathy for the woe-ridden Justine; the while forgiving the perhaps too heavy brushstrokes we have found ourselves compelled to employ, may you at least extract from this story the same moral which determined Madame de Lorsange!"
                                            },
                                            {
                                                "example_id": "fb8a322a-005f-44ee-bc84-7d4d0ba16931",
                                                "sense_id": "7d0fedd2-57be-3b6a-be7f-d20053fed421",
                                                "text": "\"What are you going to call your noisy daughter?\" he asked as the door closed and they were alone.\n\"Justine.\"\n\"It's a very good name, but why did you choose it?\"\n\"I read it somewhere, and I liked it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b979c489-4e39-3fdc-b797-9c1ba1fd8ba5",
                                        "entry_id": "5ad69d9c-c84d-3fd8-9903-88c953736876",
                                        "glosses": [
                                            "A male given name from French and Latin, of chiefly Philippine usage, variant of Justin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
