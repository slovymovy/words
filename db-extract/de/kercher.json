                ],
                "senses": [
                    {
                        "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                        "entry_id": "bba00f67-9021-336c-98db-ef000a58fee5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4907851b-4ec8-4759-804b-3cce24addff9",
                                "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                                "text": "Frau Kercher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "90a33ba6-4b9d-4b0b-aef1-dea235a535ee",
                                "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                                "text": "Herr Kercher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4316fbe0-1534-470e-9021-2b95535e16db",
                                "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                                "text": "Die Kerchers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0ab7accf-7249-4eb5-9c0f-8a10a8670f27",
                                "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                                "text": "Der Kercher trägt nie die Schals, die die Kercher ihm strickt."
                            },
                            {
                                "example_id": "6d5e33cc-3080-4203-97a6-bbd6d9157779",
                                "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kercher kommt, geht der Herr Kercher.“"
                            },
                            {
                                "example_id": "d3c9e0ac-8412-4731-a28f-9fe7beea79a0",
                                "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                                "text": "Kercher kommt und geht."
                            },
                            {
                                "example_id": "db14bde5-ec94-4967-9d20-c711d7f94f59",
                                "sense_id": "23c56043-b3e1-3106-b400-0d7c0439eb9f",
                                "text": "Kerchers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
