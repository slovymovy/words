                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8c202650-8083-326c-b6ab-be2bd93f3792",
                                        "entry_id": "714bd949-a5fc-3e44-b155-a31c0fddcb96",
                                        "glosses": [
                                            "неол., кулин. пищевой продукт быстрого приготовления (часто с использованием трансжиров)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a42f93b-d7f4-405c-9daf-8f370d270939",
                                                "sense_id": "8c202650-8083-326c-b6ab-be2bd93f3792",
                                                "text": "Именно в США произошли самые драматические изменения с телом человека ― благодаря изобретению фастфуда и кока-колы там появились люди, которые весят 120, 140, даже 180 кг."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cd33e2d-5bcf-3a29-bd42-aab554212ff4",
                                        "entry_id": "714bd949-a5fc-3e44-b155-a31c0fddcb96",
                                        "glosses": [
                                            "неол., собир. предприятия общественного питания, характеризующиеся быстрым приготовлением пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad8e2c5d-e9db-45f4-abfc-4e11900d9558",
                                                "sense_id": "4cd33e2d-5bcf-3a29-bd42-aab554212ff4",
                                                "text": "Различные заведения, кондитерские, фастфуд вроде «Макдональдса» встречаются с завидной регулярностью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
