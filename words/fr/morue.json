                },
                {
                    "sense_id": "db24278b-0890-3b34-9362-278a71856ec4",
                    "sense_definition": "Terme injurieux désignant une femme désagréable, vulgaire ou de mœurs jugées légères.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "morue_insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans un accès de colère, il a crié sur sa voisine en la traitant de vieille <w>morue</w>."
                        },
                        {
                            "text": "Elle ne supporte plus les remarques méchantes de cette <w>morue</w> au bureau."
