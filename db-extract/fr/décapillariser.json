                "senses": [
                    {
                        "sense_id": "3ceb9641-e84f-3e3f-9b01-b780a38e1db3",
                        "entry_id": "69dff559-bfb9-3c0c-8481-4ffcade1a659",
                        "glosses": [
                            "Faire perdre son caractère capillaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238f6e9b-0930-4b2d-ab27-c40d20e8cdf3",
                                "sense_id": "3ceb9641-e84f-3e3f-9b01-b780a38e1db3",
                                "text": "Nous lançons un appel à toutes les forces progressistes qui souhaitent décoloniser, déclassiser, décapillariser les imaginaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "987ea3c5-8cde-3c33-aa03-f33d64c6f831",
                        "entry_id": "69dff559-bfb9-3c0c-8481-4ffcade1a659",
                        "glosses": [
                            "Enlever les cheveux de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75494633-c1a7-4c7a-accb-c509c58256be",
                                "sense_id": "987ea3c5-8cde-3c33-aa03-f33d64c6f831",
                                "text": "Venez vous faire décapillariser, gaufrer, tondre, teinter, gominer...bref, tout ce qui a trait à vos poils de crâne !"
                            },
                            {
                                "example_id": "9ad9cd7f-c0f6-4039-81f4-0acc68d45411",
                                "sense_id": "987ea3c5-8cde-3c33-aa03-f33d64c6f831",
                                "text": "Plus que posséder votre bibliothèque j'aimerais y fouiner fourrager feuilleter comme y dîner avec vous de mots sages arrogants ou à défroquer défraiser décapillariser mais il y a cette désolante voire dépoilante différence entre aimer un homme et être aimée de cet homme."
                            }
                        ]
                    }
                ],
