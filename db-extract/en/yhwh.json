                                        "glosses": [
                                            "jüdische und christliche Religion: in ökumenischen Texten verwendete, alternative Schreibweise von Jahwe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9884f64e-a116-4475-8701-db76b2aecbec",
                                                "sense_id": "ed999aa8-b295-3fcb-ab9d-010288c34054",
                                                "text": "„Jenseits der diplomatischen und strategischen Streitigkeiten, die zwischen den Delegationen Israels und der PLO ausgetragen werden, profiliert sich also der mythische Wettstreit um die Gunst des einzigen, des gemeinsamen Gottes, ob man ihn nun Jahve oder Allah nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
