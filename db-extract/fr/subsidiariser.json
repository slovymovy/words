                "senses": [
                    {
                        "sense_id": "5cf8c7cf-48c2-3e77-a54a-e6cd32973b52",
                        "entry_id": "1eff41b1-b10e-35fe-865d-56ddaf7cc7eb",
                        "glosses": [
                            "Transférer le pouvoir de décision à un niveau administratif inférieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9428fc5-c06a-4011-965f-56b7f64a3d76",
                                "sense_id": "5cf8c7cf-48c2-3e77-a54a-e6cd32973b52",
                                "text": "Il faut toujours essayer de « subsidiariser », c’est-à-dire de donner les compétences au plus près des besoins afin que les décisions appartiennent à des autorités locales qui connaissent les questions et non à des autorités qui n’ont fait que lire un rapport."
                            },
                            {
                                "example_id": "c328dfca-cfe7-4047-af02-5ef7f72f225e",
                                "sense_id": "5cf8c7cf-48c2-3e77-a54a-e6cd32973b52",
                                "text": "Fédérons le dérégulé, subsidiarisons le tout-multi. Le politiquement correct est à ce prix."
                            }
                        ]
                    }
                ],
