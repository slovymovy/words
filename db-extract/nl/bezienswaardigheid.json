                ],
                "senses": [
                    {
                        "sense_id": "34aaea06-ea85-34da-806b-89e9796e2c2c",
                        "entry_id": "34b9115f-4bda-37ed-b8e9-e2c9a97f119b",
                        "glosses": [
                            "een plaats die of een voorwerp dat door velen bezocht en bekeken wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7bac5b-1bb6-4d00-9092-03c3f7abdb8f",
                                "sense_id": "34aaea06-ea85-34da-806b-89e9796e2c2c",
                                "text": "De Eiffeltoren van Parijs is een van de beroemdste bezienswaardigheden van die stad."
                            },
                            {
                                "example_id": "82efd78b-49b9-4b7b-a831-8c749d9ee757",
                                "sense_id": "34aaea06-ea85-34da-806b-89e9796e2c2c",
                                "text": "Hun rondleiding begon vlakbij in de Oude Stad, waar Renata hen met vaste hand van bezienswaardigheid naar bezienswaardigheid leidde terwijl ze hen overlaadde met jaartallen en namen over het astronomische uurwerk op het raadhuis uit 1389, over de kruittoren uit de elfde eeuw die in 1475 eerder om esthetische dan om militaire redenen werd omgebouwd en over hoe de Dertigjarige Oorlog begon in de burchtwijk Hradtany met een rel waarbij in 1618 de afgevaardigden, van welke kant ze ook waren, uit een raam werden gegooid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b291794-43e0-4a36-a3ad-a66de51b511b",
                        "source_entry_id": "34b9115f-4bda-37ed-b8e9-e2c9a97f119b",
                        "source_sense_id": "34aaea06-ea85-34da-806b-89e9796e2c2c",
                        "source_sense_description": "een plaats die of een voorwerp dat door velen bezocht en bekeken wordt",
                        "target_lang_word": "Sehenswürdigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sehenswürdigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a37b001-b211-33d3-940b-ae8a2bb162a4",
                                        "entry_id": "e4e9b17b-a863-3e9e-aa5c-f9e8f1017134",
                                        "glosses": [
                                            "bedeutsames Objekt von touristischem Interesse, wie Gebäude, Denkmale, Naturdenkmale, deren Besuch lohnend ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e0b0ba-27e5-485c-b252-748a8c28d312",
                                                "sense_id": "1a37b001-b211-33d3-940b-ae8a2bb162a4",
                                                "text": "Ein Besuch in unserer Stadt lohnt sich. Viele verschiedene Sehenswürdigkeiten erwarten Sie."
                                            },
                                            {
                                                "example_id": "2236b99d-c080-4c32-b264-b7785da75fbc",
                                                "sense_id": "1a37b001-b211-33d3-940b-ae8a2bb162a4",
                                                "text": "„Und außerdem konnte ich jetzt, da meine Ruhe sowieso beeinträchtigt und es noch nicht zu heiß war, die Gelegenheit nutzen, die Sehenswürdigkeiten Jerichos zu besichtigen.“"
                                            },
                                            {
                                                "example_id": "6efb3d5c-8dc9-4a82-b081-6188322e82fe",
                                                "sense_id": "1a37b001-b211-33d3-940b-ae8a2bb162a4",
                                                "text": "„Sie sahen sich einige Sehenswürdigkeiten an, probierten in einem Gasthaus den berühmten säuerlichen Apfelwein und fuhren danach zum Tierpark, den Laura Leonore unbedingt besuchen wollte.“"
                                            },
                                            {
                                                "example_id": "5e492d6e-2769-4707-89fb-9e1e3e69308c",
                                                "sense_id": "1a37b001-b211-33d3-940b-ae8a2bb162a4",
                                                "text": "„Immerhin, etwa eine halbe Million sind es jährlich, die es in diese an Sehenswürdigkeiten so reiche Stadt lockt, allerdings vornehmlich Tagesausflügler.“"
                                            },
                                            {
                                                "example_id": "cb3ca3e0-5987-4ed3-8b3e-2b912300fbce",
                                                "sense_id": "1a37b001-b211-33d3-940b-ae8a2bb162a4",
                                                "text": "„Die arbeiten an den Sehenswürdigkeiten und sind hauptsächlich damit beschäftigt, zu erklären, dass beispielsweise Þingvellir eine Art heiliger Ort ist, an dem es sich zu benehmen gilt, und Touristen davor zu bewahren, in den zahlreichen Gefahrenquellen ums Leben zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45cff416-3578-485c-bc54-853ee7edb6ad",
                        "source_entry_id": "34b9115f-4bda-37ed-b8e9-e2c9a97f119b",
