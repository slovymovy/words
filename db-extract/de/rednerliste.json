                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4144ea33-83c7-4dac-9172-00602074c4dd",
                                "sense_id": "c343dc5e-d95d-3b8c-8f2d-42bb2b532558",
                                "text": "„Selbst die Rednerliste der Traditionskundgebung bietet weder Glanz noch Überraschung.“"
                            },
                            {
                                "example_id": "99bb9fdf-2ff2-4b6a-81a1-4b4b94d1b203",
                                "sense_id": "c343dc5e-d95d-3b8c-8f2d-42bb2b532558",
                                "text": "„Parteichef Philip Rösler und der designierte Generalsekretär Patrick Döring haben ihren Platz auf der Rednerliste sicher.“"
                            }
                        ],
