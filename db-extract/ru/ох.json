                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d24989a-bd30-4e77-b5d5-fe93914fdedb",
                                                "sense_id": "0fb87329-8f0f-3853-9dae-3f1a5ae34074",
                                                "text": "Il fit de grands hélas."
                                            },
                                            {
                                                "example_id": "24462df1-c4bd-43c8-b25c-ed92039b587d",
                                                "sense_id": "0fb87329-8f0f-3853-9dae-3f1a5ae34074",
                                                "text": "Voyez le bel hélas."
                                            }
                                        ]
                                    }
                                ]
