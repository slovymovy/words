                "senses": [
                    {
                        "sense_id": "31091fd8-52a5-35f1-87a8-1030f7917d3a",
                        "entry_id": "1e543b30-8aa3-3b33-86dd-1851c1e6cfae",
                        "glosses": [
                            "Zweig der Philosophie, der das Wesen der Technik, ihre Ursachen, Bedingungen und letzten Ziele erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1bcf433-3781-4ce3-8340-364d6b9ddaf6",
                                "sense_id": "31091fd8-52a5-35f1-87a8-1030f7917d3a",
                                "text": "„Die Philosophie der Technik fragt: Erstens, was geschieht da eigentlich, und zweitens, was sollte geschehen? Die Zentralfigur der heutigen Technikphilosophie scheint die Vorstellung zu sein, daß die Menschen mittels der Technik eine neue Welt hervorbringen. Nun mag man fragen, was denn an dieser Erkenntnis so grundstürzend sei - so ist es schließlich schon immer gewesen, denken wir nur an die neolithische Revolution, in deren Verlauf sich der Mensch Ackerbau und Viehzucht zuwandte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
