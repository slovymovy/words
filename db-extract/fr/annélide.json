                "senses": [
                    {
                        "sense_id": "3ab6cc65-a774-3f86-a660-b14cd87c58ea",
                        "entry_id": "da421710-814f-330e-b950-403329128e77",
                        "glosses": [
                            "Ver à anneaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d740f136-6be5-4045-8681-d71ac0c530c8",
                                "sense_id": "3ab6cc65-a774-3f86-a660-b14cd87c58ea",
                                "text": "Chaque annélide en porte un ou deux faisceaux au bord externe de ses pattes, et ces soies plus fines, mais bien plus raides qu'un cheveu, semblent disposées des deux côtés de l'animal pour le protéger contre ses ennemis."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae4854fa-18ab-3e10-9a32-844f909b7f52",
                        "entry_id": "da421710-814f-330e-b950-403329128e77",
                        "glosses": [
                            "Classe de ver à anneaux."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2d398773-c6d8-4697-bc6d-9aaf4a9d489d",
                                "sense_id": "ae4854fa-18ab-3e10-9a32-844f909b7f52",
                                "text": "Les annélides me préoccupèrent surtout dans ces premières explorations. Je ne connaissais encore que par des gravures cette famille nombreuse, vulgairement désignée sous le nom de vers marins."
                            },
                            {
                                "example_id": "ce3e2dcf-a4d7-4360-905e-5de82ee19f5f",
                                "sense_id": "ae4854fa-18ab-3e10-9a32-844f909b7f52",
                                "text": "Classification des Annélides, et Description de celles qui habitent les côtes de la France"
                            },
                            {
                                "example_id": "e924901c-e151-449b-8284-a48425badd4f",
                                "sense_id": "ae4854fa-18ab-3e10-9a32-844f909b7f52",
                                "text": "Observations sur quelques Annélides marines"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a9c817f-3f54-4849-b562-6606b15030b2",
                        "source_entry_id": "da421710-814f-330e-b950-403329128e77",
                        "target_lang_word": "annelid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
