{
    "word_family": [
        "propagate",
        "propagator",
        "propaganda",
        "propagule"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc5d50f3-3d3a-3b35-ac6a-1464d0ae4853",
                    "sense_definition": "The breeding, multiplying, or reproducing of plants or animals by natural processes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener learned new methods for plant <w>propagation</w> using stem cuttings.",
                            "target_lang_translations": {
                                "nl": "De tuinier leerde nieuwe methoden voor <w>plantenvermeerdering</w> met behulp van stengelstekken."
                            }
                        },
                        {
                            "text": "Successful <w>propagation</w> of these endangered animals requires carefully monitored breeding programs.",
                            "target_lang_translations": {
                                "nl": "Succesvolle <w>voortplanting</w> van deze bedreigde dieren vereist zorgvuldig gecontroleerde fokprogramma's."
                            }
                        }
                    ],
                    "synonyms": [
                        "reproduction",
                        "breeding",
                        "multiplication"
                    ],
                    "common_phrases": [
                        "plant propagation",
                        "propagation of species"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het kweken, vermeerderen of voortplanten van planten of dieren via natuurlijke processen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vermeerdering",
                                "target_lang_sense_clarification": "vooral van planten"
                            },
                            {
                                "target_lang_word": "voortplanting",
                                "target_lang_sense_clarification": "algemeen biologisch proces"
                            },
                            {
                                "target_lang_word": "kweek",
                                "target_lang_sense_clarification": "het gecontroleerd fokken of telen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e14bddfb-aead-3854-9f73-fec008e17337",
                    "sense_definition": "The spreading or dissemination of ideas, beliefs, or information to a greater number of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissemination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internet greatly accelerated the <w>propagation</w> of news across the globe.",
                            "target_lang_translations": {
                                "nl": "Het internet versnelde de <w>verspreiding</w> van nieuws over de hele wereld aanzienlijk."
                            }
                        },
                        {
                            "text": "The activist dedicated her life to the <w>propagation</w> of democratic values.",
                            "target_lang_translations": {
                                "nl": "De activiste wijdde haar leven aan de <w>propagering</w> van democratische waarden."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissemination",
                        "spread",
                        "diffusion",
                        "promulgation"
                    ],
                    "antonyms": [
                        "suppression"
                    ],
                    "common_phrases": [
                        "propagation of ideas",
                        "propagation of the faith"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het verspreiden of propageren van ideeën, overtuigingen of informatie onder een groter publiek."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verspreiding",
                                "target_lang_sense_clarification": "algemene distributie van ideeën of informatie"
                            },
                            {
                                "target_lang_word": "propagering",
                                "target_lang_sense_clarification": "het actief uitdragen of bevorderen van ideeën"
                            },
                            {
                                "target_lang_word": "verbreiding",
                                "target_lang_sense_clarification": "het steeds verder bekend worden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0903daae-90d0-3b6a-a42a-e0951aa3e8bf",
                    "sense_definition": "The transmission or travel of energy, waves, or signals through a medium or space.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Atmospheric conditions can significantly affect radio wave <w>propagation</w> over long distances.",
                            "target_lang_translations": {
                                "nl": "Atmosferische omstandigheden kunnen de <w>voortplanting</w> van radiogolven over lange afstanden aanzienlijk beïnvloeden."
                            }
                        },
                        {
                            "text": "The speed of sound <w>propagation</w> depends on the density of the medium.",
                            "target_lang_translations": {
                                "nl": "De snelheid van <w>geluidsvoortplanting</w> hangt af van de dichtheid van het medium."
                            }
                        }
                    ],
                    "synonyms": [
                        "transmission"
                    ],
                    "common_phrases": [
                        "wave propagation",
                        "radio propagation",
                        "propagation delay"
                    ],
                    "target_lang_definitions": {
                        "nl": "De overdracht of voortbeweging van energie, golven of signalen door een medium of ruimte."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voortplanting",
                                "target_lang_sense_clarification": "van golven of straling door een medium"
                            },
                            {
                                "target_lang_word": "propagatie",
                                "target_lang_sense_clarification": "natuurkundige en technische term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e8bc3ae-0000-31e8-b465-67a555cf7506",
                    "sense_definition": "The elongation phase during the transcription or replication of genetic material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During DNA replication, the <w>propagation</w> phase involves adding nucleotides to the growing strand.",
                            "target_lang_translations": {
                                "nl": "Tijdens DNA-replicatie omvat de <w>elongatiefase</w> het toevoegen van nucleotiden aan de groeiende streng."
                            }
                        },
                        {
                            "text": "Specific enzymes are essential for the smooth <w>propagation</w> of RNA during transcription.",
                            "target_lang_translations": {
                                "nl": "Specifieke enzymen zijn essentieel voor de soepele <w>ketenverlenging</w> van RNA tijdens de transcriptie."
                            }
                        }
                    ],
                    "synonyms": [
                        "elongation"
                    ],
                    "antonyms": [
                        "termination"
                    ],
                    "target_lang_definitions": {
                        "nl": "De verlengingsfase (elongatie) tijdens de transcriptie of replicatie van genetisch materiaal."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "elongatie",
                                "target_lang_sense_clarification": "verlengingsfase in de genetica"
                            },
                            {
                                "target_lang_word": "ketenverlenging",
                                "target_lang_sense_clarification": "het verlengen van nucleotidenketens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}