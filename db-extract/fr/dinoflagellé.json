                ],
                "senses": [
                    {
                        "sense_id": "87adc3ae-e85c-37eb-b972-ee9daa24a2d9",
                        "entry_id": "4090dc5d-bf4f-391f-97e5-f0a27e131ed2",
                        "glosses": [
                            "Membre d’une super-classe d'organismes eucaryotes unicellulaires, les Dinoflagellata, qui sont des microorganismes aquatiques (marins ou dulçaquicoles)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b29e244-cb50-46fa-8728-30b3deb62fd7",
                                "sense_id": "87adc3ae-e85c-37eb-b972-ee9daa24a2d9",
                                "text": "Certaines phycotoxines marines de la famille des spiroimines, comme la gymnodimine et les spirolides sont produites par des dinoflagellés et se concentrent dans les mollusques filtreurs."
                            },
                            {
                                "example_id": "6b72b188-989c-44cd-b01a-0da09713090e",
                                "sense_id": "87adc3ae-e85c-37eb-b972-ee9daa24a2d9",
                                "text": "Les gymnodimines, les spirolides, les pinatoxines et les ptériatoxines constituent une famille de toxines d'origine marine de structures complexes, produites en faibles quantités par des microorganismes marins appelés dinoflagellés."
                            },
                            {
                                "example_id": "e970852b-3a3d-4dcc-a2c5-69aead8e574a",
                                "sense_id": "87adc3ae-e85c-37eb-b972-ee9daa24a2d9",
                                "text": "\"Gonyaulax digitale\" est un dinoflagellé, microorganisme marin constituant une partie du phytoplancton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1c29ce0-25ce-42f7-9277-69d8400b45de",
                        "source_entry_id": "4090dc5d-bf4f-391f-97e5-f0a27e131ed2",
