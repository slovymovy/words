                                                "example_id": "63e95e80-bed8-4bad-89d5-a6de2fc9ae42",
                                                "sense_id": "f6d9d07d-3a06-34a4-a24b-956e4b45cbb9",
                                                "text": "\"Could you pass me the paring knife?\" \"Hmm? What's a paring knife?\""
                                            },
