                                "target_senses": [
                                    {
                                        "sense_id": "ad43cada-2293-3754-bdcd-2701f1d0647c",
                                        "entry_id": "184b7bb9-a761-3917-a11e-6a53f7d06e46",
                                        "glosses": [
                                            "Not biased."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4bd849f-357b-3c37-9ef3-74d9ec7914ff",
                                        "entry_id": "184b7bb9-a761-3917-a11e-6a53f7d06e46",
                                        "glosses": [
                                            "Impartial or without bias or prejudice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f84aa5c-6c1b-46e7-9d56-e6af22f36502",
                                                "sense_id": "b4bd849f-357b-3c37-9ef3-74d9ec7914ff",
                                                "text": "A self-proclaimed source of mediation and unbiased ratings of millions of businesses across the country, the BBB receives the majority of its revenue from membership fees paid by hundreds of thousands of companies."
                                            },
                                            {
                                                "example_id": "8ba092e1-8aa8-424b-a5ee-33fd3c58b1e5",
                                                "sense_id": "b4bd849f-357b-3c37-9ef3-74d9ec7914ff",
                                                "text": "The methodology, which we have named the Aural-Oral Transect (AOT), is a systematic, easy-to-implement, unbiased way of collecting quantitative data on spoken language use in multilingual settings."
                                            }
                                        ]
                                    }
