                ],
                "senses": [
                    {
                        "sense_id": "4c1eb40d-53de-3d37-86fe-ff344bc21be9",
                        "entry_id": "15095c8b-92d8-3059-9168-380a2e1d4750",
                        "glosses": [
                            "Erforschung der Eigennamen von Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8cc6da-c77a-4472-86e4-d78e2af73416",
                                "sense_id": "4c1eb40d-53de-3d37-86fe-ff344bc21be9",
                                "text": "„Die Zoonomastik untersucht demnach die Eigennamen der Tiere. Beispiele hierfür sind Struppi, Lilly oder Ringo.“"
                            },
                            {
                                "example_id": "8d4cd877-bf14-498a-a532-7982ba66a8e0",
                                "sense_id": "4c1eb40d-53de-3d37-86fe-ff344bc21be9",
                                "text": "„Im Folgenden beziehe ich mich nur auf den Hund. Fast vollkommen im Dunkeln tappen wir, wenn wir historische Zoonomastik betreiben wollen, denn belastbare Daten gibt es nicht viele.“"
                            },
                            {
                                "example_id": "a4b38ed6-50fb-4f17-a589-0fd6c08ec75f",
                                "sense_id": "4c1eb40d-53de-3d37-86fe-ff344bc21be9",
                                "text": "„Die Tiernamenforschung (Zoonomastik) ist ein eher kleiner Zweig der Linguistik.“"
                            },
                            {
                                "example_id": "da0cb7a0-9aab-479a-88a2-44bf1b47d13e",
                                "sense_id": "4c1eb40d-53de-3d37-86fe-ff344bc21be9",
                                "text": "„Damit fällt ein Schlaglicht auf die Zoonomastik, sprich: Tiernamenforschung, die sich derzeit – wie unlängst im ‚Sprachreport‘ des Instituts für deutsche Sprache zu lesen – eines wachsenden Interesses erfreut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
