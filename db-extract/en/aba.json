                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "7511bed9-251b-4eac-b73c-ba3d7c2bdac8",
                                "sense_id": "2c4a012c-a086-3de8-a1c1-420dd9f6e337",
                                "text": "The rare outburst comes as the ABA is under continued attack from conservatives who question its methodology and argue that the group that has rated potential nominees for decades is biased against conservatives."
                            },
                            {
                                "example_id": "8c241088-e9b6-45ca-8d6d-7a0afd4360e5",
                                "sense_id": "2c4a012c-a086-3de8-a1c1-420dd9f6e337",
                                "text": "Deputy Attorney General Todd Blanche said in an internal memo obtained by CNN that department attorneys cannot travel to, or speak at, ABA events in their official capacity. Career employees, however, are still able to maintain their ABA membership."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8b5106c-09f4-3bff-83ef-96a1e12c3569",
                        "entry_id": "af7ae6b9-660e-33f4-bbfd-87db70ea34de",
                        "glosses": [
