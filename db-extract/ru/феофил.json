                        "source_entry_id": "95ebf93a-c12c-3b6e-9150-142bf9c0178d",
                        "source_sense_id": "f56299fd-b061-343f-b303-8d6af4d151ad",
                        "source_sense_description": "Перевод имени",
                        "target_lang_word": "Théophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Théophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                        "entry_id": "df4d1301-a9ac-3439-95ce-a35781d6193e",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f1203e-1327-417e-b124-b61b42cf46c8",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Et, derrière lui, modestement, venait Théophile Morin, avec ses favoris gris, ses cheveux gris taillés en brosse, ses lunettes, son air jaune et las de vieux professeur, usé dans sa chaire."
                                            },
                                            {
                                                "example_id": "42a06750-4fa3-4a88-89a1-710ea4bdf683",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Jeanne, la fille du fermier, allait épouser le grand Théophile, de Sexey-aux-Forges."
                                            },
                                            {
                                                "example_id": "906871ea-e117-49a3-b702-5bed782d970c",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Ce fut l’occasion pour Théophile Briant d’évoquer, sous le titre « Léon Daudet et les amazones de la Chouannerie », ses relations avec le directeur de L’Action Française (fonction partagée avec Charles Maurras)."
                                            },
                                            {
                                                "example_id": "6f878691-989b-4844-bd1b-7d73d766ee37",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Les gérants, Charlotte et Théophile Nourisson, possèdent déjà deux magasins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e55b165-30b2-37b2-b55e-e6d5df99a3e8",
                                        "entry_id": "df4d1301-a9ac-3439-95ce-a35781d6193e",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0336e7df-a02b-46b3-a5f3-f7ba8018209a",
                                                "sense_id": "8e55b165-30b2-37b2-b55e-e6d5df99a3e8",
                                                "text": "Théophile et Félicité, originaires de Mortagne, village proche du camp, sont les filles d’un greffier, ancien maréchal des logis des hussards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
