{
    "word_family": [
        "indifférence",
        "indifféremment",
        "différent",
        "différence",
        "différencier"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1dd67a49-11ac-3b2d-aeba-877cb15a6ae3",
                    "sense_definition": "Qui n'éprouve aucun intérêt, aucune émotion ou aucune compassion pour quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté complètement <w>indifférent</w> devant la détresse de ses voisins."
                        },
                        {
                            "text": "Elle a écouté toutes leurs plaintes d'un air <w>indifférent</w> sans dire un mot."
                        }
                    ],
                    "synonyms": [
                        "insensible",
                        "insouciant"
                    ],
                    "antonyms": [
                        "sensible",
                        "attentif"
                    ],
                    "common_phrases": [
                        "rester indifférent",
                        "d'un air indifférent"
                    ]
                },
                {
                    "sense_id": "ba2f424b-3bfd-3ae3-b55e-41bed090befd",
                    "sense_definition": "Qui n'a pas d'importance, qui ne suscite aucun intérêt ou souci particulier pour quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le choix du restaurant m'est tout à fait <w>indifférent</w>, décide toi-même."
                        },
                        {
                            "text": "Ils ont passé la soirée à discuter de sujets <w>indifférents</w> sans aborder l'essentiel."
                        }
                    ],
                    "synonyms": [
                        "inintéressant",
                        "insignifiant",
                        "sans importance"
                    ],
                    "antonyms": [
                        "important",
                        "capital"
                    ],
                    "common_phrases": [
                        "cela m'est indifférent"
                    ]
                },
                {
                    "sense_id": "68435899-4dc4-3f1b-b111-919b787d31a2",
                    "sense_definition": "Qui ne répond pas aux sentiments amoureux ou à l'affection qu'on lui témoigne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il souffrait en silence face à cette femme <w>indifférente</w> à son amour."
                        },
                        {
                            "text": "Malgré ses déclarations passionnées, elle lui est demeurée totalement <w>indifférente</w>."
                        }
                    ],
                    "synonyms": [
                        "insensible"
                    ],
                    "antonyms": [
                        "épris"
                    ],
                    "common_phrases": [
                        "cœur indifférent"
                    ]
                },
                {
                    "sense_id": "8145d849-f1fc-38e2-8af5-d8f31a222325",
                    "sense_definition": "Qui n'a pas de penchant marqué pour une option ou pour un parti plutôt qu'un autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce débat houleux, plusieurs électeurs préfèrent demeurer <w>indifférents</w>."
                        },
                        {
                            "text": "Entre les deux candidats du second tour, elle reste <w>indifférente</w> et votera blanc."
                        }
                    ],
                    "synonyms": [
                        "désintéressé"
                    ],
                    "antonyms": [
                        "engagé",
                        "partisan"
                    ]
                },
                {
                    "sense_id": "726a57ef-9b0c-3d80-8723-a768ed81723f",
                    "sense_definition": "Qui n'entraîne en soi aucune préférence nécessaire, qui n'influe pas sur le résultat ou le choix.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour résoudre cette énigme, tous les chemins empruntés ne sont pas <w>indifférents</w>."
                        },
                        {
                            "text": "Il n'est pas <w>indifférent</w> que ces négociations aient eu lieu en terrain neutre."
                        }
                    ],
                    "antonyms": [
                        "déterminant"
                    ]
                },
                {
                    "sense_id": "5aede1d0-7185-3af8-80d4-b08fc6f80ff3",
                    "sense_definition": "Qui par sa nature même ne possède ni l'un ni l'autre des états ou qualités considérés, pouvant indifféremment recevoir l'un ou l'autre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon ce principe physique, la matière est d'elle-même <w>indifférente</w> au mouvement comme au repos."
                        },
                        {
                            "text": "Cette substance demeure <w>indifférente</w> aux variations thermiques ordinaires du milieu."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "936513df-2dc2-37a8-b5c9-6d13ce4e7c75",
                    "sense_definition": "Personne qui n'adopte aucun parti ou qui ne manifeste aucun attachement envers des questions politiques ou religieuses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les extrémistes tentaient de convaincre les <w>indifférents</w> de rallier leur cause."
                        },
                        {
                            "text": "Ce penseur dénonçait le silence des <w>indifférents</w> face aux persécutions religieuses."
                        }
                    ],
                    "antonyms": [
                        "militant",
                        "croyant"
                    ]
                }
            ]
        }
    ]
}