    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ae629b38-7c85-315a-801d-35046fa9f0a6",
                "word": "sightless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d06abf8-bb63-3996-bc08-b6fa63113deb",
                        "entry_id": "ae629b38-7c85-315a-801d-35046fa9f0a6",
                        "glosses": [
                            "Without sight; blind; unseeing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ea8a3cc0-c10e-42c9-994f-876eab920f3b",
                                "sense_id": "2d06abf8-bb63-3996-bc08-b6fa63113deb",
                                "text": "And yet it was possible he might love her—love her truly and deeply: if so, of what avail would it be to lower him in her esteem? It were best for Lucy still to gaze with sightless eyes on her idol."
                            }
                        ]
                    },
                    {
                        "sense_id": "e91a5815-4c64-3f4a-962e-baac387cd0ec",
                        "entry_id": "ae629b38-7c85-315a-801d-35046fa9f0a6",
                        "glosses": [
                            "Synonym of invisible."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c464c264-6743-437e-9a7c-99146aea6cd2",
                                "sense_id": "e91a5815-4c64-3f4a-962e-baac387cd0ec",
                                "text": "In his return, arriving at a rising ground, a knoll, he heard a rustling of the leaves in his front: an enemy was suspected ; he gathered his men around him, each taking his tree. The enemy was sightless to Boyd, and his party, yet the approach around him was sensible to every one."
                            },
                            {
                                "example_id": "d99c8c55-7cc8-4443-a5d2-ba190d76497a",
                                "sense_id": "e91a5815-4c64-3f4a-962e-baac387cd0ec",
                                "text": "The toiling world is sightless to those who cannot see."
                            }
                        ]
                    }
                ],
