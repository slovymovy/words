                ],
                "senses": [
                    {
                        "sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                        "entry_id": "2df95ef1-8f86-33f7-aff4-dfcbd7f5991a",
                        "glosses": [
                            "Einrichtung für die Ausgabe/ den Verkauf von Fahrkarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ea55f7-1cec-46b2-ba74-bb298ea29ef5",
                                "sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                                "text": "„Die rauchenden Angestellten am Fahrkartenschalter machten keine Anstalten, ihn zu bedienen.“"
                            },
                            {
                                "example_id": "439dc03e-2c5a-419f-a862-d5081ef479b2",
                                "sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                                "text": "„Sie musste Phaks am Fahrkartenschalter gesehen haben.\""
                            },
                            {
                                "example_id": "bf0d228e-4d3b-493a-8680-395d600a342c",
                                "sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                                "text": "„Im Bahnhof Aachen fragte er die Frau hinter dem Fahrkartenschalter nach einer Straßenbahn zum Amtsgericht.“"
                            },
                            {
                                "example_id": "1d4fcb58-97d6-42dd-961d-b714180372fa",
                                "sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                                "text": "„Ihre Auskünfte schnurrte sie herunter mit der Leidenschaftlichkeit des Bahnbeamten am Fahrkartenschalter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "117efb71-e721-4c33-a4a9-128368dd80d3",
                        "source_entry_id": "2df95ef1-8f86-33f7-aff4-dfcbd7f5991a",
                        "source_sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                        "source_sense_description": "Einrichtung für die Ausgabe/ den Verkauf von Fahrkarten",
                        "target_lang_word": "ticket office",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ticket office",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "287acf54-2f7c-3285-9a1a-0b55588d94d8",
                                        "entry_id": "391d5a7f-0902-31b3-98ef-e9a73e336f83",
                                        "glosses": [
                                            "An office or booth where tickets may be purchased to allow admittance or for travel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360bd087-08db-4a91-9c4d-f6a0b96941ac",
                                                "sense_id": "287acf54-2f7c-3285-9a1a-0b55588d94d8",
                                                "text": "On the opposite side of the concourse is the triple-counter ticket office and three self-service machines which are adjacent to a large customer service counter and the gateline."
                                            },
                                            {
                                                "example_id": "4c67f141-f799-4e54-aa0d-79407b306388",
                                                "sense_id": "287acf54-2f7c-3285-9a1a-0b55588d94d8",
                                                "text": "Traditionally, 'ticket office' seems to have been the preferred term in America, with Britain using the term 'booking office' (as an 1881 edition of The Railway Age Monthly and Railway Service Magazine explains). Today, the two are often used interchangeably (as the recent 'Save our ticket offices' campaign shows), with the term 'ticketing' perhaps capturing more of the point-of-sale transaction and issuing of tickets within stations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a819c398-3a35-45fb-80c4-ef83a0f01842",
                        "source_entry_id": "2df95ef1-8f86-33f7-aff4-dfcbd7f5991a",
                        "source_sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                        "source_sense_description": "Einrichtung für die Ausgabe/ den Verkauf von Fahrkarten",
                        "target_lang_word": "billetterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "billetterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ccce143-ed2f-3f6a-a839-968d52c6cf5e",
                                        "entry_id": "7720799d-32cb-3e9c-8a55-98b8da090d0e",
                                        "glosses": [
                                            "Ensemble des opérations ayant trait à la délivrance de billets (spectacles, transport, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2735dbf-bf97-47ca-add2-0a0067bf182f",
                                                "sense_id": "2ccce143-ed2f-3f6a-a839-968d52c6cf5e",
                                                "text": "Ils connaissent donc parfaitement bien les spectacles dont ils assurent la billetterie !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b62bb9c-2f3d-3647-b5d6-db1224558250",
                                        "entry_id": "7720799d-32cb-3e9c-8a55-98b8da090d0e",
                                        "glosses": [
                                            "Guichet où acheter des billets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0e5ac1-8900-4155-b63e-9507261d3613",
                                                "sense_id": "1b62bb9c-2f3d-3647-b5d6-db1224558250",
                                                "text": "Et pourtant, une fois la billetterie passée, on arrive dans une grande salle d'attente où un magasin de « gougouilles » et divers jeux vidéo à tester sont là pour que l'on puisse patienter en attendant le début du film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "446c00de-f9d5-3cfe-94ec-30e80ae75658",
                                        "entry_id": "7720799d-32cb-3e9c-8a55-98b8da090d0e",
                                        "glosses": [
                                            "Distributeur automatique de billets de banque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c13ec347-b33c-4e3e-9785-904849929231",
                        "source_entry_id": "2df95ef1-8f86-33f7-aff4-dfcbd7f5991a",
                        "source_sense_id": "23205f8e-6d94-36ed-854b-34a5ef7abe93",
                        "source_sense_description": "Einrichtung für die Ausgabe/ den Verkauf von Fahrkarten",
                        "target_lang_word": "guichet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guichet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "425b4be5-37ea-3ec7-85e6-0a8090e5d89d",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Petite porte pratiquée dans une grande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c9ba8b-24d7-48cc-a87a-6602e637174b",
                                                "sense_id": "425b4be5-37ea-3ec7-85e6-0a8090e5d89d",
                                                "text": "[…] et, faisant traverser à Gurth une cour pavée, le fit sortir par un guichet pratiqué à la porte d’entrée, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6e86ce-9fa8-33af-ae69-5e03bb6ff3d1",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Petite porte pratiquée dans une grande.",
                                            "Petite ouverture ou fenêtre pratiquée dans une porte, dans un grillage et par laquelle on peut parler à quelqu’un ou lui faire passer quelque chose, sans être obligé d’ouvrir la porte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976f5d07-c13f-457f-87d4-5375c608ab76",
                                                "sense_id": "8e6e86ce-9fa8-33af-ae69-5e03bb6ff3d1",
                                                "text": "M. le juge Roquincourt, qui était mondain et galant, avait gracieusement conduit dans la prison mesdames Dellion et de Gromance et leur avait fait voir le condamné par le guichet grillé de la cellule où il jouait aux cartes avec un guichetier."
                                            },
                                            {
                                                "example_id": "993c5c7c-34e9-4ec5-a4a9-43e7a2bd12b3",
                                                "sense_id": "8e6e86ce-9fa8-33af-ae69-5e03bb6ff3d1",
                                                "text": "Pas de concierge. Pas de sonnette. Un marteau de fer qu’on heurtait contre une porte massive munie d’un guichet de prison."
                                            },
                                            {
                                                "example_id": "6aaa206d-6a9b-4f7e-a1d8-a900562380b8",
                                                "sense_id": "8e6e86ce-9fa8-33af-ae69-5e03bb6ff3d1",
                                                "text": "Le 24 avril 1917, de Tascher tente de s'évader. Un feldwebel couche dans la pièce voisine de la sienne et un petit guichet permet de voir ce qui se passe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5569d98-a44a-3b10-b538-c99642171e1c",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Petite porte pratiquée dans une grande.",
                                            "Sorte de petit volet qui se ferme sur la jalousie du confessionnal, du côté du confesseur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26c80d37-5a3c-4e87-994a-752cc46a487c",
                                                "sense_id": "b5569d98-a44a-3b10-b538-c99642171e1c",
                                                "text": "[…] ; en fin de compte, il refusait de m’absoudre ; bien heureuse encore lorsqu’il ne me fermait pas brutalement, dès les premiers mots, le guichet du confessionnal, au nez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b68f1e8-1636-3dc4-bc25-4fa45c6a14b5",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Petite porte pratiquée dans une grande.",
                                            "Ouverture pratiquée dans un mur ou aménagée dans une cloison à claire-voie par laquelle on communique avec les employés d’une administration ou d’une billetterie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e56e0d88-9e4f-4be7-b348-4d9625808bf4",
                                                "sense_id": "4b68f1e8-1636-3dc4-bc25-4fa45c6a14b5",
                                                "text": "Jouer à guichet fermé."
                                            },
                                            {
                                                "example_id": "d6df83ca-d2ad-481b-84f2-30f171934857",
                                                "sense_id": "4b68f1e8-1636-3dc4-bc25-4fa45c6a14b5",
                                                "text": "J’ai si souvent fait buisson creux dans mes tentatives précédentes, que je n’ose plus me présenter au guichet de la gare. A quoi bon ?"
                                            },
                                            {
                                                "example_id": "4d3a67be-b482-425f-89c4-c555301065f6",
                                                "sense_id": "4b68f1e8-1636-3dc4-bc25-4fa45c6a14b5",
                                                "text": "Au musée des Arts Anciens du Namurois, la dame du guichet fut instantanément conquise par notre petite fille. « Comme elle est mignonne ! Une vraie arsouille ! » roucoulait-elle."
                                            },
                                            {
                                                "example_id": "a4f172fb-692c-4281-ac11-5df4193a0a5c",
                                                "sense_id": "4b68f1e8-1636-3dc4-bc25-4fa45c6a14b5",
                                                "text": "Entre le bar à tacos « Les Pâques à Juarez » et celui à souchis « Le Mifouné », Choppard se présenta au guichet du kébabiste. Ce guichet n'est pas une image : Nourri en avait réellement installé un à sa devanture, un de récup’, complet avec hygiaphone et micro crachotant […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f9f33c-bc81-349b-8ff4-faaa14124551",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Petite porte pratiquée dans une grande.",
                                            "Quelqu’une des grandes ouvertures voûtées qui font communiquer les cours intérieures du Louvre avec l’extérieur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b53732-2f2e-419b-8c7a-9b011d3270c8",
                                                "sense_id": "94f9f33c-bc81-349b-8ff4-faaa14124551",
                                                "text": "Depuis le guichet qui mène au pont du Carrousel, jusqu’à la rue du Musée, tout homme venu, ne fût-ce que pour quelques jours, à Paris, remarque une dizaine de maisons à façades ruinées, où les propriétaires découragés ne font aucune réparation, et qui sont le résidu d’un ancien quartier en démolition depuis le jour où Napoléon résolut de terminer le Louvre."
                                            },
                                            {
                                                "example_id": "8b58c0d1-4770-41c4-b81c-a170d0d6f1de",
                                                "sense_id": "94f9f33c-bc81-349b-8ff4-faaa14124551",
                                                "text": "De Mouy descendit de cheval, jeta la bride aux mains de son laquais, s’achemina vers le guichet, se fit reconnaître de la sentinelle, introduisit La Mole dans le château, […]."
                                            },
                                            {
                                                "example_id": "ef60b854-80d2-4d0e-9fae-6384114eb81d",
                                                "sense_id": "94f9f33c-bc81-349b-8ff4-faaa14124551",
                                                "text": "Près des guichets du Louvre, au flanc même du palais, il y a des bancs de pierre où la nuit personne jamais ne s’assoit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b1ef005-d1b4-32c6-bf29-bd3c15e9d125",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Petite porte pratiquée dans une grande.",
                                            "Chatière."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "313de6cc-dbaa-3e68-8e4f-fcb5b1dab7c0",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Lieu, comptoir où l’on peut demander un service ou acheter un billet."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b02a0cd-69fc-4738-a9b0-a52bc3e8297e",
                                                "sense_id": "313de6cc-dbaa-3e68-8e4f-fcb5b1dab7c0",
                                                "text": "Fidèle à son poste, il attendait derrière son guichet que le public vînt réclamer ses services."
                                            },
                                            {
                                                "example_id": "65147642-2548-4eaf-ab22-8515dc2fdc9a",
                                                "sense_id": "313de6cc-dbaa-3e68-8e4f-fcb5b1dab7c0",
                                                "text": "Pour compenser la fermeture des guichets de vente et des gares, la SNCF propose de plus en plus la vente de billets dans des commerces « partenaires »."
                                            },
                                            {
                                                "example_id": "7c646d85-8daf-4eed-a543-6deec7816b38",
                                                "sense_id": "313de6cc-dbaa-3e68-8e4f-fcb5b1dab7c0",
                                                "text": "Les Qataris jouissent d’un statut prioritaire non écrit mais bien réel : pour eux, attendre à un guichet n’est pas envisageable, ni même ralentir à la vue d’un radar ou ne pas s’asseoir sans billet dans les tribunes d’un stade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd70ba10-0695-3106-941d-f9d4c701d154",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Portes d’une armoire, d’un buffet, en parlant d’armoires à l’ancienne mode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b79f194-4f44-4db5-aa95-7c80b15bf856",
                                                "sense_id": "dd70ba10-0695-3106-941d-f9d4c701d154",
                                                "text": "Armoire à quatre guichets, à six guichets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02fbac89-3306-3da4-9478-a37d01c5349f",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Chacune des deux structures fabriquées en bois que le batteur doit défendre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f13a0dc7-f5fb-3647-a006-4fa4eafab835",
                                        "entry_id": "c6b13d7d-4d62-3510-b046-a24ca89cdb16",
                                        "glosses": [
                                            "Interface permettant d’accéder aux services en ligne proposés par une entreprise ou une organisation."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
