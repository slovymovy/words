                        "glosses": [
                            "een test die heel snel een uitslag geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa2625a-6f8f-4230-b241-cf6cc4d221d8",
                                "sense_id": "56f2a43a-b9a8-33bb-9ece-a2e1785030f7",
                                "text": "De veiligheidsregio's IJssellanden, Twente en Zuid-Limburg en West-Brabant krijgen L-teststraten. Waar precies, moet nog worden bepaald. In de provincies Friesland, Drenthe en Zeeland wordt gekeken hoe sneltesten kunnen worden aangeboden op bestaande locaties."
                            },
                            {
                                "example_id": "400a8eeb-9f04-4b80-8961-639086adb710",
                                "sense_id": "56f2a43a-b9a8-33bb-9ece-a2e1785030f7",
                                "text": "De oplossing voor de werkdruk zit volgens de LHV in sneltesten. Volgens Dagblad van het Noorden wordt er bij enkele huisartsen in Drenthe al gewerkt met sneltesten nadat daar meerdere besmettingen werden geconstateerd bij praktijkpersoneel."
                            }
                        ]
                    }
