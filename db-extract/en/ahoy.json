    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "67b01fe7-ef7a-31f6-b5b9-fd4da426c9b1",
                "word": "ahoy",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                        "entry_id": "67b01fe7-ef7a-31f6-b5b9-fd4da426c9b1",
                        "glosses": [
                            "Used to hail a ship, a boat or a person, or to attract attention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3552fa69-7e7b-4db3-b62a-4b4e5712bc48",
                                "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                                "text": "While he was thus occupied, a voice, still more uncouth than the former, bawled aloud, ‘Ho! the house, a-hoy!’"
                            },
                            {
                                "example_id": "fe884912-4d03-49fd-accd-7fae4fac34da",
                                "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                                "text": "I made a speaking trumpet of my hands and commenced to whoop “Ahoy!” and “Hello!” at the top of my lungs. […] The Colonel woke up, and, after asking what in brimstone was the matter, opened his mouth and roared “Hi!” and “Hello!” like the bull of Bashan."
                            },
                            {
                                "example_id": "f6be47d9-f6e8-430b-86a8-207098389f1c",
                                "sense_id": "e7a97a4f-cdc1-3707-aa64-47957d896b5b",
                                "text": "“(grunts) Frankie put glass in the piccata and the restaurant comped us, so we got all these chips. Let's hit the casino.” “All right.” “Come on, Nadia. Let's go watch this Rat Pack show with the girls.” “Did you say \"the Rat Pack\"?” “Yeah, they're good.” “They're here?” “Yeah, yeah, it's the Rat Pack.” “Chips ahoy!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "42e234a8-344c-3d6c-b6b3-36defcbc5632",
                        "entry_id": "67b01fe7-ef7a-31f6-b5b9-fd4da426c9b1",
                        "glosses": [
                            "Warning of something approaching or impending."
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "1b7adbcf-3d9e-4afe-84b6-3c49662988bf",
                                "sense_id": "42e234a8-344c-3d6c-b6b3-36defcbc5632",
                                "text": "Lawsuits, ahoy! […] Towns can regulate use of their beaches. But what about the waters offshore?"
                            },
                            {
                                "example_id": "ccbbecd5-62ec-48e2-900e-7a88c6c65738",
                                "sense_id": "42e234a8-344c-3d6c-b6b3-36defcbc5632",
                                "text": "Catalytic converters ahoy – Zeppelin's latest is one of those high-rev 3D driving games that simulates racing tracks from all over the world."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8227cde4-34c6-4e0f-b911-c10db7a932ea",
                        "source_entry_id": "67b01fe7-ef7a-31f6-b5b9-fd4da426c9b1",
                        "source_sense_description": "used to hail a ship, etc",
                        "target_lang_word": "ahoj",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ahoj",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1750f743-541b-354b-aa52-6fc599ba409f",
                                        "entry_id": "8303966e-aeef-3c70-9f25-2540daff1c93",
                                        "glosses": [
                                            "pozdrav člověku nebo lidem, kterým se tyká"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251601db-43f2-4342-a36c-b0d9e62227e9",
                                                "sense_id": "1750f743-541b-354b-aa52-6fc599ba409f",
                                                "text": "„Ahoj kluci,“ řekl trenér, když přišel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c958a76-e4d8-38e2-ad4a-db1bf88f3293",
                                        "entry_id": "8303966e-aeef-3c70-9f25-2540daff1c93",
                                        "glosses": [
                                            "vodácký pozdrav"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f56422-3c7b-4273-be45-71f494d47829",
                                                "sense_id": "7c958a76-e4d8-38e2-ad4a-db1bf88f3293",
                                                "text": "„Ahoj,“ volali na nás vodáci z kánoe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "896f1774-1fac-4116-98ca-00c3a654437f",
                        "source_entry_id": "67b01fe7-ef7a-31f6-b5b9-fd4da426c9b1",
                        "source_sense_description": "used to hail a ship, etc",
