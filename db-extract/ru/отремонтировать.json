                "translations": [
                    {
                        "translation_id": "28fa5fa0-66ea-45c5-a636-58a26156ce7c",
                        "source_entry_id": "cf9d1e14-eab5-31f7-919f-36ae18848989",
                        "source_sense_id": "66d4acc8-3718-3427-ac51-d477d53d4343",
                        "target_lang_word": "repair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                        "entry_id": "f38eb192-55d2-3ca8-a088-936f6ebd8e4f",
                                        "glosses": [
                                            "To restore to good working order, fix, or improve damaged condition; to mend; to remedy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a8c8e6a-8643-4e44-af61-138ef02de42a",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "to repair a house, a road, a shoe, a ship"
                                            },
                                            {
                                                "example_id": "bb37ecaf-1c22-461e-8bb2-5d2a6e6ead7e",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "to repair a shattered fortune"
                                            },
                                            {
                                                "example_id": "16a5c765-8e97-441d-9334-43c70bfb4226",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "Secret refreſhings, that repair his ſtrength,"
                                            },
                                            {
                                                "example_id": "ef395da4-26e5-47ab-b3e6-d73ca9fdde32",
                                                "sense_id": "b4951c89-768f-3ae0-9f56-99e048e8c216",
                                                "text": "Do thou, as thou art wont, repair / My heart with gladness,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4b87ffc-2a0a-334a-9542-ad276516cd47",
                                        "entry_id": "f38eb192-55d2-3ca8-a088-936f6ebd8e4f",
                                        "glosses": [
                                            "To make amends for, as for an injury, by an equivalent; to indemnify for."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fc380b-070b-4a67-98f6-ad67e9cf8472",
                                                "sense_id": "c4b87ffc-2a0a-334a-9542-ad276516cd47",
                                                "text": "to repair a loss or damage"
                                            },
                                            {
                                                "example_id": "bbd2a1ef-72a9-47d2-a1b0-6a5d28d46372",
                                                "sense_id": "c4b87ffc-2a0a-334a-9542-ad276516cd47",
                                                "text": "I'll repair the misery thou dost bear."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df996c3c-2731-3f15-8c32-112698eba53b",
                                        "entry_id": "d8fa468e-3a19-3f05-9aab-c55fb2b49efd",
                                        "glosses": [
                                            "The act of repairing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97f52848-ac7b-4d1c-b653-21839a639b21",
                                                "sense_id": "df996c3c-2731-3f15-8c32-112698eba53b",
                                                "text": "I took the car to the workshop for repair."
                                            },
                                            {
                                                "example_id": "577ed84c-3f62-4bb2-b97a-b6bdf43596f1",
                                                "sense_id": "df996c3c-2731-3f15-8c32-112698eba53b",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that[…]means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d6a5f8-744d-378b-837f-bcf114fa6518",
                                        "entry_id": "d8fa468e-3a19-3f05-9aab-c55fb2b49efd",
                                        "glosses": [
                                            "The result of repairing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f60c3fa-f0b3-418a-8ece-64d1c0a85e00",
                                                "sense_id": "69d6a5f8-744d-378b-837f-bcf114fa6518",
                                                "text": "If you look closely you can see the repair in the paintwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                        "entry_id": "d8fa468e-3a19-3f05-9aab-c55fb2b49efd",
                                        "glosses": [
                                            "The condition of something, in respect of need for repair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65fb6f98-1f32-4eac-a1f2-8f72bd6fbcde",
                                                "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                                "text": "The car was overall in poor repair before the accident. But after the workshop had it for three weeks it was returned in excellent repair. But the other vehicle was beyond repair."
                                            },
                                            {
                                                "example_id": "5860990d-721d-4e74-99ed-1a022244f192",
                                                "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                                "text": "The 1300 class (Nos. 1301-16), one of which was damaged beyond repair in an accident, are Co-Cos, weigh 111 tons and have a top speed of 85 m.p.h."
                                            },
                                            {
                                                "example_id": "8f547bda-5b51-43d2-a5e2-d9c06e084887",
                                                "sense_id": "aa60c0bf-19c8-39d0-9832-e5d11eef068a",
                                                "text": "Thirteen houses were damaged beyond repair, and much of the rest of the town suffered broken windows and lost slates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f268b5a-2260-37eb-aabc-df71f0b00f5f",
                                        "entry_id": "78c2ad75-b8f8-3b7b-b9a2-298a4549b860",
                                        "glosses": [
                                            "The act of repairing or resorting to a place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698ebb84-8861-452c-b01b-c49c825ce9aa",
                                                "sense_id": "6f268b5a-2260-37eb-aabc-df71f0b00f5f",
                                                "text": "our annual repair to the mountains"
                                            },
                                            {
                                                "example_id": "2bb3ac8f-b878-4b8a-bb45-600ec57fd627",
                                                "sense_id": "6f268b5a-2260-37eb-aabc-df71f0b00f5f",
                                                "text": "The king sent a proclamation for their repair to their houses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19215261-e4b1-37cf-bb1a-fd08b7013b1b",
                                        "entry_id": "78c2ad75-b8f8-3b7b-b9a2-298a4549b860",
                                        "glosses": [
                                            "A place to which one goes frequently or habitually; a haunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e2bfa4-5ebd-417b-8527-c0318473c71e",
                                                "sense_id": "19215261-e4b1-37cf-bb1a-fd08b7013b1b",
                                                "text": "There the fierce winds his tender force assail / And beat him downward to his first repair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                        "entry_id": "c1c2cb22-7dc8-3f76-bd98-74cc715eaaa9",
                                        "glosses": [
                                            "To transfer oneself to another place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd63b5b5-0284-4eb7-86fd-2019f2b53435",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "to repair to sanctuary for safety"
                                            },
                                            {
                                                "example_id": "634baa8b-6cfd-4450-87bb-6b15f8ac8d10",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "Go, mount the winds, and to the shades repair."
                                            },
                                            {
                                                "example_id": "7ba70db4-d82a-4349-8113-55de37bfd133",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "At the hour of half-past five we repaired to our engagement."
                                            },
                                            {
                                                "example_id": "04f8bacb-1584-430d-93cc-2c0164387cad",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "At a late hour, after I had been in bed some time, I heard the visitors repair to their chambers:"
                                            },
                                            {
                                                "example_id": "bebd7996-5282-42ff-990c-31562f212dd0",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "That finished, I repaired to my room, one flight up, and, after a thorough wash, seated myself, pipe in mouth, at the little window that opened on the Rue Garde."
                                            },
                                            {
                                                "example_id": "bbfb0806-0805-4466-a774-ef49039d5eb2",
                                                "sense_id": "735e0cc4-bfd8-3c90-8570-f0bc178adf76",
                                                "text": "[...] the train engine uncouples and either backs on to the up through line to await its next duty or repairs to the motive power depot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "repair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b696eb7-78a5-32a2-97da-8db273dcbe34",
                                        "entry_id": "61ab0ea4-6e91-335f-b151-44430bd2d1df",
                                        "glosses": [
                                            "To pair again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1786c45-30ba-44e1-bd0b-b6755609b7a1",
                                                "sense_id": "5b696eb7-78a5-32a2-97da-8db273dcbe34",
                                                "text": "Please try to repair the two earbuds to each other. Place both earbuds back into the charging case, wait for four seconds, then open it and see if they have been repaired with one another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
