                "senses": [
                    {
                        "sense_id": "6d71e19d-5a66-3492-a3ac-3362c6a58381",
                        "entry_id": "9e9595f2-2a9c-32e2-8903-e06542ed92d7",
                        "glosses": [
                            "Schweben eines Objektes oder einer Person, frei von Schwerkraft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c181fb2-fefa-4cc8-98c7-bd253ee5657c",
                                "sense_id": "6d71e19d-5a66-3492-a3ac-3362c6a58381",
                                "text": "Von Levitation ist gelegentlich in religiösen oder spiritistischen Zusammenhängen die Rede."
                            },
                            {
                                "example_id": "ef577d14-b8ad-4185-8109-8677680d7e27",
                                "sense_id": "6d71e19d-5a66-3492-a3ac-3362c6a58381",
                                "text": "„Der Orden der Kopertiner, erklärte er, habe seinen Namen vom heiligen Joseph von Copertino, einem recht eigenwilligen frommen Mann, der im siebzehnten Jahrhundert lebte und erstaunliche Leistungen der Levitation hervorbrachte, und zwar etwa zur gleichen Zeit, als Isaac Newton die Gesetze der universalen Schwerkraft formulierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77085877-ef88-3183-b0a1-d6057048904e",
                        "entry_id": "9e9595f2-2a9c-32e2-8903-e06542ed92d7",
                        "glosses": [
                            "Schweben von Objekten mittels technischer Verfahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3982f88-ef97-458a-8fbf-d312735f4c31",
                                "sense_id": "77085877-ef88-3183-b0a1-d6057048904e",
                                "text": "Ein Beispiel für Levitation sind Luftkissenfahrzeuge."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
