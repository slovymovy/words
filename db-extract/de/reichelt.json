                ],
                "senses": [
                    {
                        "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                        "entry_id": "05d3e51d-dd7d-3c25-90e9-90bda2bafe88",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b32ec5-ee17-46e2-8bb4-0e37983c8d93",
                                "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                                "text": "Frau Reichelt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0a00e7ca-d7e3-4707-82e7-624ac012d95b",
                                "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                                "text": "Herr Reichelt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cfbb0ed3-58b3-45bb-b26a-7da198d41fb8",
                                "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                                "text": "Die Reichelts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2d289458-ebe5-4a00-9ee0-fba7d1e4e6d2",
                                "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                                "text": "Der Reichelt trägt nie die Schals, die die Reichelt ihm strickt."
                            },
                            {
                                "example_id": "d8d7d7e6-d295-4f8e-a413-d97713c221cc",
                                "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reichelt kommt, geht der Herr Reichelt.“"
                            },
                            {
                                "example_id": "91192759-b7cd-4a64-9e53-e69dde338ec3",
                                "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                                "text": "Reichelt kommt und geht."
                            },
                            {
                                "example_id": "53dd5079-37b0-4c5c-862b-75b4125c8bfb",
                                "sense_id": "feb364f4-4952-387e-bf03-967dc6219d7c",
                                "text": "Reichelts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
