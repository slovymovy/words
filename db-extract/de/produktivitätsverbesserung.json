                                "example_id": "f36bb579-e777-4c52-8cbb-1f074498bfd3",
                                "sense_id": "e37e377c-692a-3c63-8238-f981d8477374",
                                "text": "„Insbesondere der schnelle technologische Wandel und die damit angestrebte Produktivitätsverbesserung erfordern ein nachhaltiges Controlling im Produktionsbereich.“"
                            },
                            {
                                "example_id": "1a890475-85a4-467f-adfe-0089c1983cf7",
                                "sense_id": "e37e377c-692a-3c63-8238-f981d8477374",
                                "text": "„Möglichkeiten zur Produktivitätsverbesserung bestehen zwar dort auch, aber es gibt deutliche Grenzen.“"
                            },
                            {
                                "example_id": "c63aaf30-babc-4814-8e00-48cf791e95c2",
                                "sense_id": "e37e377c-692a-3c63-8238-f981d8477374",
                                "text": "„Mit der Strategie Produktivitätsverbesserung wird versucht, die gemeinsamen Ressourcen verschiedener Unternehmenseinheiten besser zu nutzen.“"
                            }
                        ],
