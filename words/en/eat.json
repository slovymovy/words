                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You look very upset today; what is <w>eating</w> you?",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь очень расстроенным сегодня; что тебя <w>гложет</w>?"
                            }
