                "senses": [
                    {
                        "sense_id": "0051c360-b3f6-3c72-a583-9cd0adcf3ce7",
                        "entry_id": "4b6a884a-5760-38df-a7f0-4c3ad7542f04",
                        "glosses": [
                            "zu einem Haus gehörige Zisterne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970c4fc9-4403-45fc-a39a-796a0a659dd3",
                                "sense_id": "0051c360-b3f6-3c72-a583-9cd0adcf3ce7",
                                "text": "„Mit der Wasserentnahme aus einer Hauszisterne in der Nachbarschaft sollte ausgetestet werden, ob dies eine Lösung für den Ernstfall sein könnte.“"
                            },
                            {
                                "example_id": "c91df2de-110b-4537-aa18-6a87db337e17",
                                "sense_id": "0051c360-b3f6-3c72-a583-9cd0adcf3ce7",
                                "text": "„Zwar hätten die Bauwilligen die Auflage bekommen, Hauszisternen anzulegen, doch sei deren Kapazität gänzlich überfordert.“"
                            },
                            {
                                "example_id": "8e54d41d-f40a-4a06-8b10-2fd5e23a1b0c",
                                "sense_id": "0051c360-b3f6-3c72-a583-9cd0adcf3ce7",
                                "text": "„Bürgermeister Gerd Krämer (CDU) rechnet zwar mit einer längeren Amortisationszeit als bei Hauszisternen (6 bis 8 Jahre), verweist aber auf die Vorbildfunktion durch die Demonstration guten Willens.“"
                            },
                            {
                                "example_id": "316ac3bf-b600-4d3c-b8b0-11566b3c7a1f",
                                "sense_id": "0051c360-b3f6-3c72-a583-9cd0adcf3ce7",
                                "text": "„Um wertvolles Regenwasser nicht einfach in der Kanalisation zu sammeln, seien Hauszisternen denkbar, aber auch sogenannte \"Rigolen\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
