                ],
                "senses": [
                    {
                        "sense_id": "3d3f1a40-1811-3647-8148-ae8d89fd995e",
                        "entry_id": "f18bec75-a4d7-30d9-a489-4bfacfaa3ae9",
                        "glosses": [
                            "Bouquet de violettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0f181f1-2519-4e66-905a-6d7879c201f7",
                                "sense_id": "3d3f1a40-1811-3647-8148-ae8d89fd995e",
                                "text": "[…] und bei der Beerdigung von Lawrence tauchte plötzlich ein unbekanntes, etwa zwölfjähriges Mädchen auf und warf einen Veilchenstrauß ins Grab.",
                                "translation": "[…] et lors de l’enterrement de Lawrence, une jeune fille inconnue, âgée d’environ douze ans, surgit soudainement et lance un bouquet de violettes au cœur de la tombe."
                            },
                            {
                                "example_id": "ead8a62c-c03f-458b-acc4-861f577a6c0d",
                                "sense_id": "3d3f1a40-1811-3647-8148-ae8d89fd995e",
                                "text": "Ich bin meines Vaters Jüngste, für die er den Veilchenstrauß eingehandelt hat, und komme, Euch zu bitten, daß Ihr mich als Frau annehmen […].",
                                "translation": "Je suis la plus jeune fille de mon père, celle pour qui il a tenu le bouquet de violettes, et viens vous demander de me prendre pour épouse […]."
                            }
                        ]
                    }
                ],
