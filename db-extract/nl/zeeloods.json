                    {
                        "translation_id": "f52c228c-8bd9-483b-9533-4b75b657937f",
                        "source_entry_id": "61844ef9-6b19-3039-8c74-2614edc1728b",
                        "source_sense_id": "34c5e027-88ad-37c7-a046-53d725eea544",
                        "source_sense_description": "loods die schepen van en naar de open zee loodst",
                        "target_lang_word": "Lotse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lotse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7077ea8-a40e-3450-b88b-7cdfd2a3020e",
                                        "entry_id": "5b6ad11e-4a5c-3b24-b6b4-0d68ef9f65e6",
                                        "glosses": [
                                            "Schiffer/Seemann, der berufsmäßig Schiffe durch schwierige Gewässer leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67f1c3a-1911-4ce6-a425-42d98ce1c381",
                                                "sense_id": "a7077ea8-a40e-3450-b88b-7cdfd2a3020e",
                                                "text": "Bis 1835 wurden die Lotsen in offenen Jollen versetzt."
                                            },
                                            {
                                                "example_id": "d7db661d-a667-4d8c-94ad-1eff2c001322",
                                                "sense_id": "a7077ea8-a40e-3450-b88b-7cdfd2a3020e",
                                                "text": "„Der Lotse machte auf mich einen ordentlichen und tüchtigen Eindruck.“"
                                            },
                                            {
                                                "example_id": "f0b0642e-6564-4293-ba99-2d1b5acfe166",
                                                "sense_id": "a7077ea8-a40e-3450-b88b-7cdfd2a3020e",
                                                "text": "„Sie hatte einen neuen Mann, von dem wir wußten, daß wir ihm trauen konnten, zum Kapitän, und der alte Lotse erschien nur als Passagier.“"
                                            },
                                            {
                                                "example_id": "e6531091-4d1f-4525-baa0-c16f6287da2f",
                                                "sense_id": "a7077ea8-a40e-3450-b88b-7cdfd2a3020e",
                                                "text": "„Ein Lotse namens Jean le Son, der bei der Belle Ile an Bord gekommen war, hatte sie durch die flachen Gewässer des Golfs geleitet.“"
                                            },
                                            {
                                                "example_id": "686fe526-9811-40cb-a78a-44b56135ee81",
                                                "sense_id": "a7077ea8-a40e-3450-b88b-7cdfd2a3020e",
                                                "text": "„Es herrschte dichter Nebel, doch wir fanden einen Lotsen, liefen in St. Helen's Roads ein und ankerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f3089aa-f11b-38cf-85ca-8c013809d008",
                                        "entry_id": "5b6ad11e-4a5c-3b24-b6b4-0d68ef9f65e6",
                                        "glosses": [
                                            "Führer durch unbekannte Stadtteile oder gefährliche Verkehrslagen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a91b505-e301-4cf1-b2d0-bf7c985a7093",
