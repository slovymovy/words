                ],
                "senses": [
                    {
                        "sense_id": "61c509bc-bd3d-3372-b824-ad232a69fe0b",
                        "entry_id": "f0654d67-80a3-3658-9202-e278949b9c52",
                        "glosses": [
                            "von der Beschaffenheit Pergament ähnelnd, an Pergament erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "628a70b6-3196-4b3f-8514-79c02416510a",
                                "sense_id": "61c509bc-bd3d-3372-b824-ad232a69fe0b",
                                "text": "„Seine dunkle pergamentartige Haut spannte sich so straff über die kahle Schädeldecke, dass jeder einzelne Knochen gespenstisch hervortrat, wie bei einem Totenschädel.“"
                            },
                            {
                                "example_id": "722560a8-8274-4a07-817c-0392c164a134",
                                "sense_id": "61c509bc-bd3d-3372-b824-ad232a69fe0b",
                                "text": "„Er war alt, kahl und hatte ein sehr schmales Gesicht mit pergamentartiger Haut.“"
                            },
                            {
                                "example_id": "71e188c4-8522-4c69-b103-6dab5dbb7159",
                                "sense_id": "61c509bc-bd3d-3372-b824-ad232a69fe0b",
                                "text": "„Im schwachen Licht sah sein Gesicht mit den eingefallenen Wangen und der fahlen, pergamentartigen Haut auf grauenhafte Weise einem Totenschädel gleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
