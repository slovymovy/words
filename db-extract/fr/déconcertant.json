                    {
                        "form_id": "0dd67b4e-bd7a-478a-8b55-89bffc4d18a3",
                        "entry_id": "faf51f42-e15e-3b8d-8320-03033841f4f3",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "déconcertantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b24bf078-ed5c-3924-b696-092346bdb7fd",
                        "entry_id": "faf51f42-e15e-3b8d-8320-03033841f4f3",
                        "glosses": [
                            "Qui déconcerte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe5f4909-6a30-45d9-81e1-d25e1e57d6d6",
                                "sense_id": "b24bf078-ed5c-3924-b696-092346bdb7fd",
                                "text": "C’est elle, en effet, qui, chez les barbiers de la capitale, ensavonne les clients et armée de l’instrument tranchant, que vous connaissez, caresse les mentons poilus avec une maestria déconcertante."
                            },
                            {
                                "example_id": "bdd98dcd-687a-4ca3-a00c-6585d42bc9c1",
                                "sense_id": "b24bf078-ed5c-3924-b696-092346bdb7fd",
                                "text": "Le premier passait son chemin en respirant une fleur et l'on se rendait compte qu'il était à cent lieues de partager l'humeur baroque et déconcertante du second."
                            },
                            {
                                "example_id": "ca3dd65d-6e5f-4d8f-a64d-2f20bc177d1d",
                                "sense_id": "b24bf078-ed5c-3924-b696-092346bdb7fd",
                                "text": "La bise est une coutume sympathique, mais un peu déconcertante pour les étrangers."
                            },
                            {
                                "example_id": "fa50105d-9f37-47f8-a5ec-8295b5984777",
                                "sense_id": "b24bf078-ed5c-3924-b696-092346bdb7fd",
                                "text": "Autrement dit : qu’Ottawa s’occupe de la culture québécoise et francophone ! Déconcertant !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b70a0bb8-171a-4fa8-a1f4-b6cf6c308fd1",
                        "source_entry_id": "faf51f42-e15e-3b8d-8320-03033841f4f3",
                        "source_sense_id": "b24bf078-ed5c-3924-b696-092346bdb7fd",
                        "source_sense_description": "Qui déconcerte.",
                        "target_lang_word": "verwirrend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwirrend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                        "entry_id": "873a218c-8619-3d51-8215-80fd1fafc183",
                                        "glosses": [
                                            "schwierig zu verstehen; durcheinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8986df3-08ac-4edf-8bfa-1aeead1c29e2",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "„Was für eine verwirrende Erklärung, ich verstehe kein Wort.“"
                                            },
                                            {
                                                "example_id": "1ec5fca2-1b7a-4a99-8da0-c481936c08b6",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Beim Sender vermutete man, dass die Zuschauer der komplexen Handlung, in der es eine verwirrende Vielzahl von Protagonisten gab, die einen auch für Amerikaner schwer verständlichen Slang sprachen, einfach nicht folgen konnten."
                                            },
                                            {
                                                "example_id": "55212b49-91eb-4918-815d-ee4a7818091a",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Naturidentisch, künstlich, natürlich - für Verbraucher waren die Bezeichnungen für Aromen in Lebensmitteln bislang ein beständiges Ärgernis: Verwirrende, unbestimmte Begriffe, bei denen keiner verstand, um welche Inhaltsstoffe es sich tatsächlich handelte."
                                            },
                                            {
                                                "example_id": "2ace1efc-789b-4e37-991e-f422473f3474",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Einige Hunderassen haben verwirrende Namen. Die Dänische Dogge kommt eigentlich aus Deutschland."
                                            },
                                            {
                                                "example_id": "6e6b7133-5d14-4a77-8f9d-f7cdc4c50af7",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Bisher verhinderten bestehende Gesetze, ihre [der US-Senatoren Ted Cruz und Chuck Schumer] Fälle vor Gericht zu bringen und Ansprüche geltend zu machen. Schuld war die verwirrende Vielfalt von Verjährungsfristen im US-Rechtssystem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "verwirrend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4cc13b-9b5b-3ed5-aea5-32c75517366a",
                                        "entry_id": "249d2988-e11e-3805-a0d5-e3600e938f8b",
