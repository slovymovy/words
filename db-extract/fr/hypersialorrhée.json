                                "example_id": "c14f066a-a735-450a-a146-3e50d34c8745",
                                "sense_id": "c715b319-eb75-3b36-baa3-9dd365509540",
                                "text": "Notre confrère se demande comment traiter l’hypersialorrhée de l’enfant."
                            }
                        ]
