                "senses": [
                    {
                        "sense_id": "83e68ef0-95a2-3870-b8c2-5dcd5cbdee85",
                        "entry_id": "feec1ab1-be28-39ca-84f9-0712bb9af90d",
                        "glosses": [
                            "разг. застывая, покрыть собой поверхность чего-либо, накопиться на поверхности чего-либо; намёрзнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c45f9a-d48c-4dd5-941c-79a1f22e4e0f",
                                "sense_id": "83e68ef0-95a2-3870-b8c2-5dcd5cbdee85",
                                "text": "Лёд настыл на мостках."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce53f391-a383-38e1-88fa-abdf9e1ae1fd",
                        "entry_id": "feec1ab1-be28-39ca-84f9-0712bb9af90d",
                        "glosses": [
                            "прост. стать холодным, охладиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a58b8314-14ad-4efa-9d0d-e3464a7fbcb5",
                                "sense_id": "ce53f391-a383-38e1-88fa-abdf9e1ae1fd",
                                "text": "Бедный молодой человек рвал с себя настывшие одеяния, как будто в них засел целый рой пчел."
                            }
                        ]
                    },
                    {
                        "sense_id": "aeb20d73-c927-3a40-97b0-be91a1351c36",
                        "entry_id": "feec1ab1-be28-39ca-84f9-0712bb9af90d",
                        "glosses": [
                            "прост. сильно озябнуть; застыть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b633eca-494f-4a30-9147-5f7e450fb3f5",
                                "sense_id": "aeb20d73-c927-3a40-97b0-be91a1351c36",
                                "text": "Ты настыла на улице, выпей горячего чаю."
                            },
                            {
                                "example_id": "2df444b2-dda5-4034-9a37-41917d355711",
                                "sense_id": "aeb20d73-c927-3a40-97b0-be91a1351c36",
                                "text": "Руки настыли."
                            }
                        ]
                    }
