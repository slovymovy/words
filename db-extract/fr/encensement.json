                ],
                "senses": [
                    {
                        "sense_id": "0cdb7c58-6f67-38c2-87de-f07e3928c319",
                        "entry_id": "b58ce149-e286-37a3-b521-03aacaf876e5",
                        "glosses": [
                            "Action d’encenser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d96339e-b29a-4e2c-aa97-853b00cca72a",
                                "sense_id": "0cdb7c58-6f67-38c2-87de-f07e3928c319",
                                "text": "Les encensements sont toujours requis à certaines occasions: pour la dédicace d’une église ou d’un autel, lors de la messe chrismale, aux expositions du Saint-Sacrement, ainsi qu’aux funérailles où le corps est honoré comme un ancien temple de l’Esprit Saint."
                            },
                            {
                                "example_id": "27e3bfa2-13ba-4269-8240-fb78f8b1ff26",
                                "sense_id": "0cdb7c58-6f67-38c2-87de-f07e3928c319",
                                "text": "Aucune femme de tête n’eût pu résister à la puissance exhilarante de cet encensement continu."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa12c4c3-6afb-3280-9174-34075a1cc7f9",
                        "entry_id": "b58ce149-e286-37a3-b521-03aacaf876e5",
                        "glosses": [
                            "Pathologie du cheval caractérisée principalement par des mouvements de tête incontrôlés."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21cb3d82-d494-4d8b-a0a0-9d66a6c904ee",
