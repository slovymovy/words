{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8369666e-6c32-3304-9cf7-8a73749fa6ab",
                    "sense_definition": "An amount of money charged for a specific right, privilege, service, or admission.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must pay an entrance <w>fee</w> to visit the museum.",
                            "target_lang_translations": {
                                "ru": "Вы должны заплатить входную <w>плату</w>, чтобы посетить музей.",
                                "zh": "参观博物馆必须支付入场<w>费</w>。"
                            }
                        },
                        {
                            "text": "The bank charged a late <w>fee</w> because I missed the payment deadline.",
                            "target_lang_translations": {
                                "ru": "Банк взыскал <w>штраф</w> за просрочку, так как я пропустил срок платежа.",
                                "zh": "因为我错过了还款期限，银行收取了滞纳<w>金</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "entrance fee",
                        "admission fee",
                        "late fee",
                        "subscription fee",
                        "service fee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, взимаемая за определенное право, услугу, вход или в качестве штрафа.",
                        "zh": "为获得特定权利、特权、服务或入场资格而支付的金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плата",
                                "target_lang_sense_clarification": "общий термин; например, за вход или проезд"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "обязательный платеж или налог за услугу"
                            },
                            {
                                "target_lang_word": "взнос",
                                "target_lang_sense_clarification": "регулярный платеж за членство или участие"
                            },
                            {
                                "target_lang_word": "пошлина",
                                "target_lang_sense_clarification": "государственный денежный сбор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "费用",
                                "target_lang_sense_clarification": "通用术语，指为服务或使用权支付的钱"
                            },
                            {
                                "target_lang_word": "门票",
                                "target_lang_sense_clarification": "特指进入场所的费用"
                            },
                            {
                                "target_lang_word": "罚款",
                                "target_lang_sense_clarification": "因逾期或违规而支付的额外费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbe44777-1e9f-3561-9c5d-221ce27f330e",
                    "sense_definition": "An amount of money paid to a professional person or organization in exchange for advice or services.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained his <w>fee</w> structure during our first meeting.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил структуру своего <w>гонорара</w> во время нашей первой встречи.",
                                "zh": "律师在第一次会面时解释了他的<w>收费</w>标准。"
                            }
                        },
                        {
                            "text": "We cannot afford the high tuition <w>fees</w> for that private school.",
                            "target_lang_translations": {
                                "ru": "Мы не можем позволить себе высокую <w>плату</w> за обучение в этой частной школе.",
                                "zh": "我们负担不起那所私立学校高昂的<w>学费</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal fee",
                        "consulting fee",
                        "tuition fee",
                        "management fee",
                        "finder's fee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежное вознаграждение, выплачиваемое специалисту или организации за профессиональные услуги или консультации.",
                        "zh": "支付给专业人士或机构以换取建议或服务的金钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гонорар",
                                "target_lang_sense_clarification": "оплата труда лиц свободных профессий (юристов, врачей, авторов)"
                            },
                            {
                                "target_lang_word": "плата",
                                "target_lang_sense_clarification": "например, за обучение (tuition fees)"
                            },
                            {
                                "target_lang_word": "вознаграждение",
                                "target_lang_sense_clarification": "официальная оплата за труд или услугу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酬金",
                                "target_lang_sense_clarification": "支付给专业人士（如律师、医生）的报酬"
                            },
                            {
                                "target_lang_word": "学费",
                                "target_lang_sense_clarification": "支付给学校的教育服务费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac87e302-e4db-30bd-ba3d-2effd6637236",
                    "sense_definition": "An inheritable estate in land, representing full ownership or ownership with specific limitations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "feudal_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The property was sold in <w>fee</w> simple, granting the buyer absolute ownership.",
                            "target_lang_translations": {
                                "ru": "Недвижимость была продана в безусловную <w>собственность</w> (fee simple), предоставляя покупателю полные права владения.",
                                "zh": "该房产以绝对<w>所有权</w>形式出售，赋予买方完全的产权。"
                            }
                        },
                        {
                            "text": "He holds the estate in <w>fee</w> and can pass it on to his heirs.",
                            "target_lang_translations": {
                                "ru": "Он владеет поместьем на правах <w>наследуемой собственности</w> и может передать его своим наследникам.",
                                "zh": "他拥有该地产的<w>所有权</w>，并可以将其传给继承人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fee simple",
                        "fee tail"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical legal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наследуемое право собственности на землю (юридический термин).",
                        "zh": "法律术语，指土地的可继承所有权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "право собственности",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "所有权",
                                "target_lang_sense_clarification": "法律上的土地所有权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31db57ae-0ed8-3a8c-b295-4b70c4c8dadd",
                    "sense_definition": "Land held from a feudal lord in return for service; a feudal estate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight received a <w>fee</w> of land in exchange for his military service.",
                            "target_lang_translations": {
                                "ru": "Рыцарь получил земельный <w>феод</w> в обмен на свою военную службу.",
                                "zh": "骑士以服兵役为代价获得了一块<w>封地</w>。"
                            }
                        },
                        {
                            "text": "In the feudal system, a vassal held his <w>fee</w> at the pleasure of the king.",
                            "target_lang_translations": {
                                "ru": "В феодальной системе вассал владел своим <w>феодом</w> по воле короля.",
                                "zh": "在封建制度下，附庸能否保有其<w>封地</w>取决于国王的意愿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fief"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Земля, пожалованная феодалом вассалу за службу.",
                        "zh": "封建制度下，领主授予附庸以换取服务的土地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "феод",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "封地",
                                "target_lang_sense_clarification": "历史术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e06ebb6-09e7-3ee1-839b-d1f6183215f9",
                    "sense_definition": "To give a payment, reward, or bribe to someone for a service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>feed</w> the porter generously to ensure his luggage was handled with care.",
                            "target_lang_translations": {
                                "ru": "Он щедро <w>заплатил</w> носильщику, чтобы с его багажом обращались осторожно.",
                                "zh": "他慷慨地<w>付钱</w>给搬运工，以确保行李得到妥善处理。"
                            }
                        },
                        {
                            "text": "The doctor was <w>feed</w> for his visit to the sick patient.",
                            "target_lang_translations": {
                                "ru": "Доктору <w>заплатили</w> за его визит к больному пациенту.",
                                "zh": "医生因出诊看望病人而获得了<w>报酬</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Платить вознаграждение или давать на чай за услугу (устаревшее).",
                        "zh": "为某项服务向某人支付报酬或小费（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платить",
                                "target_lang_sense_clarification": "давать деньги за услугу"
                            },
                            {
                                "target_lang_word": "вознаграждать",
                                "target_lang_sense_clarification": "оплачивать труд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支付",
                                "target_lang_sense_clarification": "给予金钱作为报酬"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "868d4e2c-7829-309c-99ec-7d3930d2cfeb",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fee</w> has lived in this neighborhood for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Фи</w> живет в этом районе уже более двадцати лет.",
                                "zh": "<w>菲</w>先生在这个社区已经住了二十多年了。"
                            }
                        },
                        {
                            "text": "We are looking for the records of a family named <w>Fee</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье по фамилии <w>Фи</w>.",
                                "zh": "我们正在寻找一个姓<w>菲</w>的家庭的记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фи",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菲",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13588c0f-ea6f-332f-8d14-30d2b7a404dc",
                    "sense_definition": "A diminutive of the female given name <w>Fiona</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her friends call her <w>Fee</w> instead of her full name.",
                            "target_lang_translations": {
                                "ru": "Друзья зовут её <w>Фи</w> вместо полного имени.",
                                "zh": "她的朋友们叫她<w>菲</w>，而不是叫她的全名。"
                            }
                        },
                        {
                            "text": "I asked <w>Fee</w> if she wanted to join us for dinner.",
                            "target_lang_translations": {
                                "ru": "Я спросил <w>Фи</w>, хочет ли она поужинать с нами.",
                                "zh": "我问<w>菲</w>想不想和我们一起吃晚饭。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма женского имени Фиона.",
                        "zh": "女性名字“菲奥娜”（Fiona）的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фи",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菲",
                                "target_lang_sense_clarification": "名字昵称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}