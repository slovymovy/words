                    },
                    {
                        "translation_id": "7b5d52ad-a34f-405a-8d0b-0d6f6cc3cde1",
                        "source_entry_id": "6adc857a-5e8e-3895-a482-8fcdb0cc95f6",
                        "source_sense_id": "0c7338f7-3672-3fe4-9972-68773e09c98e",
                        "target_lang_word": "duvet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duvet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcd1bdaf-d0ea-3bcb-9492-86c117130dea",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Ensemble des plumes courtes, molles et frisées, qui poussent en premier sur le corps des oiseaux et est particulièrement fournie chez les cygnes et les oies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ede1ef8-3af3-456f-9ee8-588ae2ff5871",
                                                "sense_id": "dcd1bdaf-d0ea-3bcb-9492-86c117130dea",
                                                "text": "Ces îlots, constitués de basalte, servent de repaires à des myriades d’eiders qui nichent dans les rochers. Ces oiseaux donnent le précieux duvet connu sous le nom d’édredon, et sont la principale ressource des habitants : la loi défend de les tuer."
                                            },
                                            {
                                                "example_id": "f27abff0-d2f8-4e2d-8971-866368070587",
                                                "sense_id": "dcd1bdaf-d0ea-3bcb-9492-86c117130dea",
                                                "text": "Ces petits moineaux ont encore leur duvet. — Un oreiller de duvet. — Un édredon de duvet de cygne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7160dcf5-6ab4-3e7a-a5d4-8096f0501a7b",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Poils courts de la toison de certains animaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fab38508-05e9-47dc-95dd-625d4f150dcc",
                                                "sense_id": "7160dcf5-6ab4-3e7a-a5d4-8096f0501a7b",
                                                "text": "La toison se compose de poils longs et raides, de nature jarreuse en mèches souvent vrillées et d’un duvet extrêmement fin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Premier poil qui vient au menton et aux joues des jeunes gens."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7b63b2-6066-4601-97a7-3efa63fb1af7",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "Un léger duvet qui faisait une ombre sur ses lèvres donnait à son visage une grâce irritante et fière."
                                            },
                                            {
                                                "example_id": "a66ed7f4-e4e4-4e5f-b7fc-febd19a6f885",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "Un soldat me secoua pour me réveiller. Je compris vaguement que le duvet qui couvrait ses joues n’avait probablement jamais été rasé. Il n’avait guère plus de seize ans."
                                            },
                                            {
                                                "example_id": "8e317d5d-9bc2-46d8-a86f-5c4896558879",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "Après tout, le duvet apparent sur ses joues ou ses rides lorsqu’elle fronce les sourcils parle pour le personnage: le rendu est plus réaliste que la vision du précédent jeu."
                                            },
                                            {
                                                "example_id": "e6550273-a4a0-4474-a7b0-506d132f1a84",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "— Il avait les cheveux coupés à ras comme à l'armée quand on vous ratiboisait tout, et on avait laissé un duvet plus sombre sur le sommet de son crâne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1fb979-e461-3a3b-99a6-413849a2a47a",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Poils fins et courts qui recouvrent certaines parties du corps."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5f7cc4a-018f-43be-9e81-d36a085513c4",
                                                "sense_id": "1d1fb979-e461-3a3b-99a6-413849a2a47a",
                                                "text": "Ses yeux bruns étaient bordés de noir ou plutôt meurtris ; sa lèvre supérieure était ornée d’un duvet brun qui dessinait une espèce de fumée ; elle avait les lèvres menues, et son front impérieux était rehaussé par une chevelure jadis noire, mais qui tournait au chinchilla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33fb4bb6-dc3f-3d96-bf2f-b31a2256337a",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Espèce de coton qui vient sur certains fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd53d8b-4982-4d3d-91d2-58d9fce3abf8",
                                                "sense_id": "33fb4bb6-dc3f-3d96-bf2f-b31a2256337a",
                                                "text": "Le vent, qui écoutait nos paroles, les fera chanter encore par les chemins ensoleillés ; les groseilles que mes lèvres prenaient sur ta main, mûriront gaîment à côté des noisettes et les abricots pâles, au duvet d’argent, deviendront chaque jour plus vermeils."
                                            },
                                            {
                                                "example_id": "f8958a60-e014-49b0-83aa-3a4d933f3174",
                                                "sense_id": "33fb4bb6-dc3f-3d96-bf2f-b31a2256337a",
                                                "text": "Les pêches, les coings sont couverts d’un duvet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cda8ee3-0eac-3005-97f9-830e74e9b1e9",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Sac de couchage."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcdada44-a520-4825-9dad-2ef6131fd9bf",
                                                "sense_id": "0cda8ee3-0eac-3005-97f9-830e74e9b1e9",
                                                "text": "Où ranger son duvet sur le sac à dos ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d0fcaf5-6f2e-359d-8b06-67e479a525af",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Couette épaisse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f64e25f-51f1-3665-b212-a1cf799d4b6a",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Légère couche d'un matériau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dc668ea-6ff3-4551-a926-32054f2a1731",
                                                "sense_id": "5f64e25f-51f1-3665-b212-a1cf799d4b6a",
                                                "text": "Le château de Vaux-le-Vicomte était recouvert ce dimanche matin d'un léger duvet neigeux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
