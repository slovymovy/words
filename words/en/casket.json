{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f92559c-494c-39bc-ab45-5afd365da43b",
                    "sense_definition": "A box or chest in which a dead person is buried; a coffin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burial_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family gathered silently around the bronze <w>casket</w> during the memorial service.",
                            "target_lang_translations": {
                                "ru": "Семья молча стояла вокруг бронзового <w>гроба</w> во время поминальной службы."
                            }
                        },
                        {
                            "text": "Pallbearers carefully carried the heavy wooden <w>casket</w> into the chapel.",
                            "target_lang_translations": {
                                "ru": "Носильщики осторожно внесли тяжелый деревянный <w>гроб</w> в часовню."
                            }
                        }
                    ],
                    "synonyms": [
                        "coffin"
                    ],
                    "common_phrases": [
                        "open casket",
                        "closed casket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ящик или гроб прямоугольной формы, предназначенный для погребения умершего."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гроб",
                                "target_lang_sense_clarification": "для погребения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdd77350-c1a4-3c6b-94ae-c7c9ed05dc29",
                    "sense_definition": "A small decorative box or chest, typically used for holding jewellery, letters, or other valuables.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_box",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She kept her grandmother's heirloom necklace safely stored inside a velvet-lined <w>casket</w>.",
                            "target_lang_translations": {
                                "ru": "Фамильное ожерелье своей бабушки она бережно хранила в оббитой бархатом <w>шкатулке</w>."
                            }
                        },
                        {
                            "text": "The antique <w>casket</w> was carved from walnut and secured with a tiny silver key.",
                            "target_lang_translations": {
                                "ru": "Старинный <w>ларец</w> был вырезан из орехового дерева и запирался крошечным серебряным ключом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jewel casket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой изящный ящичек или ларец для хранения драгоценностей, писем и ценных вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкатулка",
                                "target_lang_sense_clarification": "для драгоценностей и мелочей"
                            },
                            {
                                "target_lang_word": "ларец",
                                "target_lang_sense_clarification": "традиционный или старинный ящичек"
                            },
                            {
                                "target_lang_word": "коробочка",
                                "target_lang_sense_clarification": "небольшая емкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be8bd22c-1433-320e-96a9-8fdee92d0e4b",
                    "sense_definition": "A vessel or urn designed to hold cremated human ashes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "burial_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They placed the small ashes <w>casket</w> carefully in the garden columbarium.",
                            "target_lang_translations": {
                                "ru": "Они бережно поместили небольшую <w>урну с прахом</w> в садовый колумбарий."
                            }
                        },
                        {
                            "text": "A brass <w>casket</w> holding the cremated remains rested on the altar.",
                            "target_lang_translations": {
                                "ru": "Латунная <w>урна</w> с прахом покоилась на алтаре."
                            }
                        }
                    ],
                    "synonyms": [
                        "urn"
                    ],
                    "common_phrases": [
                        "ashes casket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд или погребальная урна для праха после кремации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урна",
                                "target_lang_sense_clarification": "для праха"
                            },
                            {
                                "target_lang_word": "погребальная урна",
                                "target_lang_sense_clarification": "сосуд с прахом умершего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8328c41e-4f0a-3da2-938c-ab40b967fac3",
                    "sense_definition": "A gasket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic discovered a leaking <w>casket</w> around the cylinder head.",
                            "target_lang_translations": {
                                "ru": "Механик обнаружил протекающую <w>прокладку</w> головки блока цилиндров."
                            }
                        },
                        {
                            "text": "Replace the worn <w>casket</w> before sealing the joint completely.",
                            "target_lang_translations": {
                                "ru": "Замените изношенную <w>прокладку</w> перед тем, как окончательно герметизировать соединение."
                            }
                        }
                    ],
                    "synonyms": [
                        "gasket"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "variant form of gasket"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова gasket; уплотнительное кольцо или прокладка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладка",
                                "target_lang_sense_clarification": "уплотнитель в технике"
                            },
                            {
                                "target_lang_word": "уплотнение",
                                "target_lang_sense_clarification": "герметизирующая деталь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40762778-d332-38f3-8060-db5496b58b25",
                    "sense_definition": "To enclose, place, or preserve something in a casket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collector <w>casketed</w> the rare gemstones to keep them safe from moisture.",
                            "target_lang_translations": {
                                "ru": "Коллекционер <w>спрятал в шкатулку</w> редкие драгоценные камни, чтобы защитить их от влаги."
                            }
                        },
                        {
                            "text": "He decided to <w>casket</w> the ancient documents behind protective glass.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>поместить в ларец</w> древние документы за защитное стекло."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary and uncommon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать или бережно хранить что-либо в шкатулке или ларце."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "класть в шкатулку",
                                "target_lang_sense_clarification": "помещать в ларец"
                            },
                            {
                                "target_lang_word": "прятать в ларец",
                                "target_lang_sense_clarification": "бережно убирать в коробочку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}