                                        "glosses": [
                                            "To subject to ritual burning of herbs (suffumigation, smudging)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0772028-bb07-4922-b916-88b6856aefdd",
                                                "sense_id": "87772a7e-ff8c-37c9-922c-8967984e915a",
                                                "text": "This is easily done using incense to smudge yourself or taking a cleansing bath. To smudge your body use an incense mixture such as sandalwood, lavender, frankincense or myrrh."
                                            }
                                        ]
