                "senses": [
                    {
                        "sense_id": "17b879cd-b116-3076-87fa-70ce533ee933",
                        "entry_id": "58e3a97e-4783-3b3f-8817-b43197585023",
                        "glosses": [
                            "Motorschiff, das von mindestens einem Schaufelrad angetrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113638ad-d87b-4e1a-a0c0-70002a7e0e60",
                                "sense_id": "17b879cd-b116-3076-87fa-70ce533ee933",
                                "text": "„Es ist ein Fachausdruck für zwei Faden (3,69 Meter); diese Tiefe musste das Wasser mindestens haben, damit Schaufelraddampfer den Mississippi gefahrlos befahren konnten.“"
                            },
                            {
                                "example_id": "101de745-3672-49d8-b2e6-f874e364a5d5",
                                "sense_id": "17b879cd-b116-3076-87fa-70ce533ee933",
                                "text": "„Deshalb können Sie mit dem Schaufelraddampfer \"RIVER STAR\" von Prerow aus zu einer Boddenfahrt der besonderen Art starten.“"
                            },
                            {
                                "example_id": "7532f3c0-5add-4bf9-84fc-3ea18bf07a83",
                                "sense_id": "17b879cd-b116-3076-87fa-70ce533ee933",
                                "text": "„Nach gelungener Generalüberholung in den Schiffswerften von Roßlau und Aken legt der Schaufelraddampfer „Stadt Wehlen“ am Donnerstag wieder den Kurs „bergan“ und hat gegen Mittag in Roßlau die Heimfahrt elbaufwärts gestartet.“"
                            },
                            {
                                "example_id": "63e6a1a2-2ba9-4495-ba29-ad2c71996652",
                                "sense_id": "17b879cd-b116-3076-87fa-70ce533ee933",
                                "text": "„Besonders, wenn dann noch einer der über hundert Jahre alten Schaufelraddampfer vorübergleitet, fühlt man sich für Momente in eine Bilderbuch-Vergangenheit zurückversetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
