                                "example_id": "828a36bf-8c03-46b6-93ad-649e964c993c",
                                "sense_id": "2f9da714-a544-3782-8d64-0db5f84bae05",
                                "text": "Des Américains bien intentionnés me parlent avec indignation des musiciens qui fument le marihuana, disant que c’est un crime. Je veux bien croire que le marihuana n’est pas particulièrement bienfaisant pour la santé, mais je suis bien obligé de constater que les musiciens qui boivent sont beaucoup plus malades que ceux qui fument."
                            },
                            {
                                "example_id": "ad6530cd-ca6b-49bf-903e-ff48fbc3cfbd",
                                "sense_id": "2f9da714-a544-3782-8d64-0db5f84bae05",
                                "text": "Il n’y avait que les fumeurs de marihuana."
                            }
                        ]
                    }
