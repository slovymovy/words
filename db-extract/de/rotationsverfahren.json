                ],
                "senses": [
                    {
                        "sense_id": "a58c3485-43b2-38e9-ad48-62e3344c955e",
                        "entry_id": "d445f460-7059-34bf-9fc0-ae03a42fedf8",
                        "glosses": [
                            "Gruppe von Verfahren, mit denen Koordinatensysteme so lange gedreht werden können, bis sie ein zuvor definiertes Kriterium erfüllen"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "aa32d702-09e2-42c5-a6e5-6d2b9a6a0a1a",
                                "sense_id": "a58c3485-43b2-38e9-ad48-62e3344c955e",
                                "text": "„Das VARIMAX-Verfahren ist ein Rotationsverfahren der multivariaten Statistik.“"
                            },
                            {
                                "example_id": "a35fb8e8-a460-4b34-b8fb-bfc3d03da585",
                                "sense_id": "a58c3485-43b2-38e9-ad48-62e3344c955e",
                                "text": "„Bei den obliquen, den schiefwinkligen, Rotationsverfahren wird die Unkorreliertheit der Variablen aufgegeben.“"
                            },
                            {
                                "example_id": "ad8f4591-8585-403b-bf91-84c0d708e4ac",
                                "sense_id": "a58c3485-43b2-38e9-ad48-62e3344c955e",
                                "text": "„Im Anschluss an die Extraktion der Faktoren empfiehlt es sich, ein Rotationsverfahren anzuwenden, bei dem das Koordinatenkreuz in seinem Ursprung gedreht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2a196179-44e5-3351-b158-427234df11dc",
                        "entry_id": "d445f460-7059-34bf-9fc0-ae03a42fedf8",
                        "glosses": [
                            "regelmäßiger Austausch/Wechsel (der Personen, des Ortes, …)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4072f82c-a8ba-4768-86cb-f6720357c7f7",
                                "sense_id": "2a196179-44e5-3351-b158-427234df11dc",
                                "text": "„Nach je vier Torschüssen im Rotationsverfahren tauschen beide Spieler ihre Plätze und Funktionen, um festzustellen, wer der bessere Spieler ist.“"
                            },
                            {
                                "example_id": "df3a0c95-cd1f-42c7-bd24-e61779156782",
                                "sense_id": "2a196179-44e5-3351-b158-427234df11dc",
                                "text": "„Die Lerngruppe legt für jede Einheit im Rotationsverfahren einen Organisator fest, der als Taktgeber für den vordefinierten Ablauffungiert und den Zeitbedarf für die Koordination in der Gruppe minimieren soll.“"
                            },
                            {
                                "example_id": "56eac6ff-d50a-4ba4-a720-30c0e0b235ed",
                                "sense_id": "2a196179-44e5-3351-b158-427234df11dc",
                                "text": "„Sie sollten in diesem Amt nach einem jährlichen Rotationsverfahren abgelöst werden.“"
                            },
                            {
                                "example_id": "f3ffcfdb-aeb8-4149-b839-cebe888f6db4",
                                "sense_id": "2a196179-44e5-3351-b158-427234df11dc",
                                "text": "„Wenn man sich für diesen Zeitintervall entscheidet, sollte man möglichst nach dem Rotationsverfahren verfahren und immer unterschiedliche Präparate auswählen.“"
                            },
                            {
                                "example_id": "f4a26692-e2a9-4242-9738-bc8d60001f76",
                                "sense_id": "2a196179-44e5-3351-b158-427234df11dc",
                                "text": "„Mit dem Rotationsverfahren im Amt des Bundespräsidenten wird zudem die Gleichberechtigung aller sieben Bundesratsmitglieder unterstrichen.“"
                            },
                            {
                                "example_id": "871320c8-f6a2-4b97-a903-9121062728f4",
                                "sense_id": "2a196179-44e5-3351-b158-427234df11dc",
                                "text": "„Weil die Fußball-WM im Rotationsverfahren alle vier Jahre auf einem anderen Kontinent stattfinde, werde das nächste Endturnier in Europa frühestens 20 Jahre nach dem des Jahres 2006 ausgetragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
