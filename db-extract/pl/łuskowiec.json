                "translations": [
                    {
                        "translation_id": "cad40ca4-845d-4319-8359-2b745d7f86eb",
                        "source_entry_id": "cfd3abff-b711-31ed-9e73-682fcab6b7fd",
                        "source_sense_id": "4980ed1a-e734-3ff4-94cc-2cd3299e5c4f",
                        "target_lang_word": "Pine Grosbeak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
