                                                "text": "Wehe dem Mann, der mich schlug!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29ffe69f-d684-37bb-bab3-a8d71dec38ca",
