                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dash off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "514a0fda-935f-37fc-a79e-3c9c2ee7974b",
                                        "entry_id": "63ab129d-dd5f-3028-9ef7-35fc55e743a5",
                                        "glosses": [
                                            "To leave a place quickly or briefly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2300df6d-3004-46b5-8704-0240f4933b16",
                                                "sense_id": "514a0fda-935f-37fc-a79e-3c9c2ee7974b",
                                                "text": "I have to dash off to the store, but I'll be back soon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0cae84a-34b0-3323-aac3-10092257595d",
                                        "entry_id": "63ab129d-dd5f-3028-9ef7-35fc55e743a5",
                                        "glosses": [
                                            "To write quickly or informally."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9b9b77-87c3-4afc-b9fa-04617f4b11dd",
                                                "sense_id": "a0cae84a-34b0-3323-aac3-10092257595d",
                                                "text": "Let me dash off a quick note."
                                            },
                                            {
                                                "example_id": "895cf043-159f-4f41-b736-8a384d01ef25",
                                                "sense_id": "a0cae84a-34b0-3323-aac3-10092257595d",
                                                "text": "In the '50s, she worked as an usherette at the famed Apollo Theater, joined a jazzy trio called the Halos, recorded as the \"Dee\" half of a short-lived Shirley & Lee-ish Jay & Dee, and dashed off tunes in her spare time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "548b4eb6-c59a-47be-8978-2e57f00bd9f5",
                        "source_entry_id": "b1016380-4884-3bb1-af44-68d48b051bef",
                        "source_sense_id": "c8d91670-0e2d-3d41-929d-a0e0187aa271",
                        "target_lang_word": "toss off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toss off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4a23686-b981-3148-8f7c-31ea52c7bb1c",
                                        "entry_id": "f6304dab-91ac-329c-941d-648a9932a525",
                                        "glosses": [
                                            "To drink up rapidly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd9acf3-8243-4fc8-8fd0-2795f5e7da00",
                                                "sense_id": "a4a23686-b981-3148-8f7c-31ea52c7bb1c",
                                                "text": "Let me toss off this beer first."
                                            },
                                            {
                                                "example_id": "6e45f667-73f2-4337-b233-8123eab0ee82",
                                                "sense_id": "a4a23686-b981-3148-8f7c-31ea52c7bb1c",
                                                "text": "A mandrill baboon, at Wombwell's menagerie, was very partial to fermented liquors and ginger beer; the large dog-faced baboon, that died at the Tower in 1828, would toss off a pot of porter with great relish, and was such an excessive toper that he at last sunk under a confirmed dropsy; a young ruffed lemur, at the Paris Museum of Natural History, was partial to spirits; […]"
                                            },
                                            {
                                                "example_id": "b31b97f6-9550-4e2d-a31e-b265a2b4b21c",
                                                "sense_id": "a4a23686-b981-3148-8f7c-31ea52c7bb1c",
                                                "text": "They drank the health of the Nestor of American poets, and the said Nestor thanked them in German, for all the speeches were in the German language. The beer was a very light tipple, and it seemed to me that one must toss off a good many pots of it before becoming tipsy. I am to go to a private dinner to-night, the last of the Taylor festivities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06a3b7a0-c3db-3ee8-aab7-4a835afd1fe4",
                                        "entry_id": "f6304dab-91ac-329c-941d-648a9932a525",
                                        "glosses": [
                                            "To assemble hastily."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a93c2783-43e0-4858-8a7e-2f892f5b3c87",
                                                "sense_id": "06a3b7a0-c3db-3ee8-aab7-4a835afd1fe4",
                                                "text": "I tossed off a letter to the local council."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16462035-bc41-3bb0-afa4-4e4cc8583dbb",
                                        "entry_id": "f6304dab-91ac-329c-941d-648a9932a525",
                                        "glosses": [
                                            "To masturbate."
                                        ],
                                        "tags": [
                                            "British",
                                            "ambitransitive",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "969bb752-769c-3982-a13b-3fb6c185f17c",
                                        "entry_id": "f6304dab-91ac-329c-941d-648a9932a525",
                                        "glosses": [
                                            "To deliver (a remark, suggestion, etc.) in an offhand manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a1d068-3161-4eb4-8621-8e32b29e241c",
                                                "sense_id": "969bb752-769c-3982-a13b-3fb6c185f17c",
                                                "text": "He tossed off a few platitudes and then ignored any further questions."
                                            },
                                            {
                                                "example_id": "21c1a521-26e0-4ba9-a0eb-16c7c10b0434",
                                                "sense_id": "969bb752-769c-3982-a13b-3fb6c185f17c",
                                                "text": "Tyrion tells him a great house (the Tyrells) has already been wiped out of history. “Don’t let it happen again.” But he says it like a trusted authority, a casual command, not taking the boy seriously. Basically, he tosses off the line, expecting that to be the end of the conversation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
