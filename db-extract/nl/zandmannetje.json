                                        "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                        "entry_id": "51976778-3775-37eb-a07d-118febeba3d8",
                                        "glosses": [
                                            "Personnage mythique versant du sable sur les yeux des enfants pour les endormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b746e11-a9b6-4279-b130-59bec760abba",
                                                "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                                "text": "Le marchand de sable venait de m’en lancer une bonne poignée."
                                            },
                                            {
                                                "example_id": "610f57b4-a480-4ac6-ba8d-6abe87c17caa",
                                                "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                                "text": "« Merci Niquedouille.\n— Fermez vos mignons petits yeux ensommeillés. Le marchand de sable va passer. »"
                                            },
                                            {
                                                "example_id": "96182132-aa92-46c1-b7e5-80286858f036",
                                                "sense_id": "e24af135-316e-3efe-92a3-96a8c69474c2",
                                                "text": "Nous apportons joie et rêve… Nous sommes le marchand de sable et la Fée des dents. Nous sommes le lapin de Pâques et le père Noël."
                                            }
                                        ]
                                    }
                                ]
