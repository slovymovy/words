{
    "word_family": [
        "deceit",
        "deceitful",
        "deceitfully",
        "deceitfulness",
        "deceive",
        "deceiver",
        "deception",
        "deceptive",
        "deceptiveness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b36b9c63-7f8a-380f-8fcb-04a20a76b4a4",
                    "sense_definition": "In a way that deliberately misleads or gives a false impression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was accused of <w>deceptively</w> marketing products that did not work as promised.",
                            "target_lang_translations": {
                                "tr": "Şirket, vaat edildiği gibi çalışmayan ürünleri <w>aldatıcı bir şekilde</w> pazarlamakla suçlandı."
                            }
                        },
                        {
                            "text": "The advertisement used <w>deceptively</w> framed statistics to convince shoppers to buy the warranty.",
                            "target_lang_translations": {
                                "tr": "Reklam, müşterileri garanti paketini satın almaya ikna etmek için <w>yanıltıcı biçimde</w> kurgulanmış istatistikler kullandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "misleadingly",
                        "dishonestly",
                        "delusively"
                    ],
                    "antonyms": [
                        "honestly",
                        "truthfully"
                    ],
                    "common_phrases": [
                        "deceptively similar",
                        "marketed deceptively"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kasıtlı olarak yanıltıcı veya yanlış bir izlenim bırakacak şekilde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aldatıcı bir şekilde",
                                "target_lang_sense_clarification": "yanıltarak veya kandırarak"
                            },
                            {
                                "target_lang_word": "yanıltıcı biçimde",
                                "target_lang_sense_clarification": "doğru olmayan izlenim vererek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3ac840e-d853-329b-8916-1d79a9d52d6e",
                    "sense_definition": "In a manner that appears to have a certain quality on the surface, but does not in reality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance_contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river looks <w>deceptively</w> calm, but powerful currents pull underneath the smooth surface.",
                            "target_lang_translations": {
                                "tr": "Nehir <w>aldatıcı derecede</w> sakin görünüyor ancak bu durgun yüzeyin altında güçlü akıntılar çekiyor."
                            }
                        },
                        {
                            "text": "The interview included a <w>deceptively</w> simple question that stumped most applicants.",
                            "target_lang_translations": {
                                "tr": "Mülakatta, çoğu adayı şaşkına çeviren <w>görünüşte</w> basit bir soru yer alıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "seemingly",
                        "outwardly"
                    ],
                    "antonyms": [
                        "genuinely",
                        "truly"
                    ],
                    "common_phrases": [
                        "deceptively simple",
                        "deceptively calm",
                        "deceptively easy"
                    ],
                    "target_lang_definitions": {
                        "tr": "Görünüşte öyle hissettiren fakat gerçekte öyle olmayan bir şekilde; aldatıcı derecede."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "görünüşte",
                                "target_lang_sense_clarification": "aslında öyle olmasa da dışarıdan bakıldığında"
                            },
                            {
                                "target_lang_word": "aldatıcı bir şekilde",
                                "target_lang_sense_clarification": "insanı yanıltacak derecede"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94622b97-177e-3983-a8f5-a99581832ac5",
                    "sense_definition": "To a degree that is true in reality, despite outward appearances suggesting otherwise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance_contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the front, the cottage looks tiny, but it is <w>deceptively</w> spacious inside.",
                            "target_lang_translations": {
                                "tr": "Kulübe önden bakıldığında minik görünüyor fakat içi <w>görünüşünün aksine</w> ferah."
                            }
                        },
                        {
                            "text": "The dessert looks elaborate and intimidating, yet it is a <w>deceptively</w> easy recipe to make.",
                            "target_lang_translations": {
                                "tr": "Tatlı zahmetli ve göz korkutucu görünüyor ancak yapımı <w>şaşırtıcı derecede</w> kolay bir tarif."
                            }
                        }
                    ],
                    "synonyms": [
                        "surprisingly",
                        "unexpectedly"
                    ],
                    "common_phrases": [
                        "deceptively spacious"
                    ],
                    "target_lang_definitions": {
                        "tr": "Dışarıdan öyle görünmese de gerçekte beklenmedik derecede olan bir niteliği belirtmek için kullanılır."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "görünüşünün aksine",
                                "target_lang_sense_clarification": "dışarıdan bakıldığında beklenmeyecek kadar"
                            },
                            {
                                "target_lang_word": "şaşırtıcı derecede",
                                "target_lang_sense_clarification": "beklenenin aksine"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}