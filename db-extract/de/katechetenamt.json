                "senses": [
                    {
                        "sense_id": "70f3dfbd-1602-3d86-9674-f5e59f8b660d",
                        "entry_id": "e7c11709-bf7d-37a0-9f5c-595cab9ba1ae",
                        "glosses": [
                            "Dienstamt des Katecheten"
                        ],
                        "tags": [
                            "katholische",
                            "Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "b858e5b1-0f98-4b81-8a73-67104f13cddb",
                                "sense_id": "70f3dfbd-1602-3d86-9674-f5e59f8b660d",
                                "text": "„Der Mainzer Pastoraltheologe Philipp Müller betrachtet ein eigenständiges Katechetenamt als wichtige Ergänzung der Seelsorge.“"
                            },
                            {
                                "example_id": "393a0316-8ab6-42e9-8898-04af2198f885",
                                "sense_id": "70f3dfbd-1602-3d86-9674-f5e59f8b660d",
                                "text": "„Zum Katechetenamt zugelassen werden können Frauen und Männer, die getauft und gefirmt sind, die Kommunion empfangen haben ‚und dem Diözesanbischof einen frei verfassten und unterzeichneten Antrag vorgelegt haben‘.“"
                            },
                            {
                                "example_id": "3558ed5e-0df3-4e04-8ded-cb21927db4f1",
                                "sense_id": "70f3dfbd-1602-3d86-9674-f5e59f8b660d",
                                "text": "„Insgesamt elf Laien, darunter acht Frauen und drei Männer, wurden von Franziskus im Rahmen der Messe ausgesandt, um künftig das Lektorats- und das Katechetenamt zu übernehmen.“"
                            },
                            {
                                "example_id": "8ead97f1-a7fe-406c-8559-aa9614682985",
                                "sense_id": "70f3dfbd-1602-3d86-9674-f5e59f8b660d",
                                "text": "„Papst Franziskus beauftragte die Bischofskonferenzen der einzelnen Länder in der Verordnung unter dem Titel ‚Antiquum ministerium‘, das neue Katechetenamt in die Praxis umzusetzen.“"
                            },
                            {
                                "example_id": "1a215a0c-92b2-4f01-9b01-0e5896443359",
                                "sense_id": "70f3dfbd-1602-3d86-9674-f5e59f8b660d",
                                "text": "„Die Katholische Arbeitsstelle für Missionarische Pastoral (KAMP e.V.) hat mit einer Online-Veranstaltung am 05.05.2022 eine Möglichkeit zum Austausch geboten und die Diskussion um das Katechetenamt eröffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
