                ],
                "senses": [
                    {
                        "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                        "entry_id": "b58cd324-b4dd-39b3-b644-998f1cb762b6",
                        "glosses": [
                            "Naht, die im Zickzack verläuft; auch bei Operationen mit medizinischem Nahtgut und als Schweißtechnik (Metallbearbeitung) verwendet"
                        ],
                        "tags": [
                            "Schneidern"
                        ],
                        "examples": [
                            {
                                "example_id": "1f46e326-dd5f-44ba-8ae6-81e075a07256",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Mit einer Zickzacknaht lässt sich jede Kante rasch festnähen. Diese Technik bietet sich an, wenn Sie eine Nähmaschine besitzen.“"
                            },
                            {
                                "example_id": "97135c2b-81d2-4a72-8c97-057b470cd8d4",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Die Zickzacknaht sichert alle Kett- und Schussfäden gemeinsam.“"
                            },
                            {
                                "example_id": "3b4ce021-075e-41d0-8518-a7dcb0345eee",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Bei festen Stofen und soliden Geweben kann die Zickzacknaht auch erst nach dem Zurückschneiden der Naht- oder Saumzugabe gesetzt werden.“"
                            },
                            {
                                "example_id": "85733a66-eff3-4b4e-a9f6-b41d5ca31167",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Mit einer Zickzacknaht kann man bei den meisten Stoffarten die Kanten schnell versäubern, sodass sie nicht ausfransen.“"
                            },
                            {
                                "example_id": "4653d459-99f7-4960-91eb-661d755632d0",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Eine schmale Zickzacknaht fällt kaum ins Auge, besonders wenn sie mit einem farblich passenden Garn genäht wird.“"
                            },
                            {
                                "example_id": "5f47f44a-403a-423d-aa7a-667092ef2635",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Versäubert man die Schnittkante des Stoffes mit einer Zickzacknaht, richtet man die Nadel an der Schnittkante entlang aus.“"
                            },
                            {
                                "example_id": "74440f7d-34cd-44eb-a696-a31206313ec0",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Einen so eingenähten Reißverschluss auszuwechseln ist nicht sehr schwierig, doch beim Auftrennen besagter Zickzacknaht muss man gut aufpassen, dass man den Stoff nicht beschädigt.“"
                            },
                            {
                                "example_id": "4c9668c3-4c5d-40af-a9d3-5ab69b25eb3e",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "[Augenoperation:] „Dann fixierte er das Transplantat unter dem Operationsmikroskop mit vier Stütznähten oben, unten, links und rechts. Dabei achtete er sorgsam darauf, daß er nur die äußere Oberfläche der Hornhaut verletzte und das empfindliche Endothel nicht beschädigte. Als er damit fertig war, legte er eine fortlaufende Zickzacknaht um das Implantat. Nun konnte er die Stütznähte entfernen.“"
                            },
                            {
                                "example_id": "2d082982-028f-45ce-83da-72a88e976342",
                                "sense_id": "b6a69d2b-6101-3aaa-a8c3-1aa229c5b100",
                                "text": "„Ana stellt sich als Bildhauerin vor, sie wird den fünf Männern in den nächsten zwei Minuten das Lichtbogenschweißen beibringen. […] Dann zieht sie den Helm übers Gesicht und führt vor, wie man zwei Stahlplättchen mit einer einwandfreien Zickzacknaht zu einem T zusammenschweißt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
