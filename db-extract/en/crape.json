                    {
                        "translation_id": "1ef76fa7-5530-465b-ad82-4f60f221a72d",
                        "source_entry_id": "3d5338d6-85c9-305c-a0ca-fa824f5b85a7",
                        "source_sense_description": "thin, crimped stuff, made of raw silk gummed and twisted on the mill",
                        "target_lang_word": "Krepp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krepp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a66d027-1dc7-333d-878a-c944f67c8edd",
                                        "entry_id": "bd4a0c1c-2825-36b1-b24e-b5cddd963d76",
                                        "glosses": [
                                            "Stoff oder Ähnliches mit rauer Oberfläche"
                                        ],
                                        "tags": [
                                            "Textilwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "672d4f66-591d-459c-9ce5-4a48ad4bf522",
                                                "sense_id": "8a66d027-1dc7-333d-878a-c944f67c8edd",
                                                "text": "„Krepp (Crêpe) Crêpes sind Stoffe mit typisch körniger, sandartiger Oberfläche. Sie sind fließend, aber nicht schlaff, sondern dynamisch und schwungvoll.“"
                                            },
                                            {
                                                "example_id": "94890e90-c2ee-46b7-9391-4968b74f8cd0",
                                                "sense_id": "8a66d027-1dc7-333d-878a-c944f67c8edd",
                                                "text": "„Die poröse Gummisohle wird mit Krepp verglichen, einer Entlehnung von frz. crépe Krepp, krauser Stoff.'“"
                                            },
                                            {
                                                "example_id": "039342c5-f3cf-4879-a308-2158b21eb8ef",
                                                "sense_id": "8a66d027-1dc7-333d-878a-c944f67c8edd",
                                                "text": "„Der Schwarze hob die Hand und zog das Krepp von der Tür ab.“"
                                            },
                                            {
                                                "example_id": "c70bb0f1-cbe0-4a64-ad84-129908057c4d",
                                                "sense_id": "8a66d027-1dc7-333d-878a-c944f67c8edd",
                                                "text": "„Vorauf erschien die schöne Frau von Zacha, ganz in Krepp mit großen schwarzen Jettperlen dreimal um Brust und Hals und an den Perlen ein Kruzifix bis auf den Gürtel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Krepp",
                                "target_lang_code": "de",
