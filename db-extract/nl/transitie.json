                                    },
                                    {
                                        "sense_id": "a1963c4f-ad7e-3623-8955-d7ff8fcb409c",
                                        "entry_id": "e07fd9dc-3121-3f1e-a9c4-7b7bd8c0a1f7",
                                        "glosses": [
                                            "El paso de una escena o parte de una obra a otra indicado con efectos de sonido, visuales o música etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e638d7-8ef9-4188-8782-415bbc2fb2df",
                                                "sense_id": "a1963c4f-ad7e-3623-8955-d7ff8fcb409c",
                                                "text": "Las transiciones en la película son realmente espectaculares."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cfc6df39-7dad-3425-8fc3-a44929b72427",
                                        "entry_id": "e07fd9dc-3121-3f1e-a9c4-7b7bd8c0a1f7",
                                        "glosses": [
                                            "En España, el paso a la democracia después de la muerte de Franco."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14abec89-ed52-40e3-ab89-d5fba8d9480f",
                                                "sense_id": "cfc6df39-7dad-3425-8fc3-a44929b72427",
                                                "text": "Después de la muerte de Franco empezó la transición."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
