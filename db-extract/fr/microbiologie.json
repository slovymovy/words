                        "entry_id": "e45cf381-6b74-3f44-96dc-90ab250fad15",
                        "glosses": [
                            "Science qui étudie les micro-organismes (levures, microbes, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba5fa016-51b5-41fc-b110-8fb7a0540cdb",
                                "sense_id": "135d0b8b-0ec5-34d5-b3e1-d4c4d5b276fc",
                                "text": "« Ils constituent la principale menace de transmission de la peste porcine africaine », prévient Guillaume Lequeux, chef du service de microbiologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7585c163-c03c-4785-b5d3-9370bfa7729a",
                        "source_entry_id": "e45cf381-6b74-3f44-96dc-90ab250fad15",
