                        "examples": [
                            {
                                "example_id": "218a765c-c12e-4c3e-bc05-c70e2f44e33d",
                                "sense_id": "bcbb9d2e-8b27-3a9e-a16c-012f0d6c05ab",
                                "text": "Basieńko, postaw jeszcze jeden czajniczek wody na kawusię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7f27c816-0c33-3029-a3c5-c265ffbf7ee4",
                        "entry_id": "e781bd23-cd6e-3850-9b87-f51a6556774d",
                        "glosses": [
                            "mały czajnik, np. do zaparzania herbaty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f684bab0-e1ae-4d5b-ae86-4abb86e3dce9",
                                "sense_id": "7f27c816-0c33-3029-a3c5-c265ffbf7ee4",
                                "text": "Wsypałam zieloną herbatę do czajniczka i zalałam wrzątkiem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beb6ad4e-3eca-41ba-9628-85ecb525acbf",
