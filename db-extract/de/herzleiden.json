                "senses": [
                    {
                        "sense_id": "1e35c431-d64b-384f-837a-c0380d170b6c",
                        "entry_id": "b010dbde-fafc-3366-9211-782f74a829b6",
                        "glosses": [
                            "länger andauernde Erkrankung des Herzens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1466d55-5bd3-469e-9846-52daa9391ba8",
                                "sense_id": "1e35c431-d64b-384f-837a-c0380d170b6c",
                                "text": "„Immer seltener fehlen Arbeitnehmer wegen Rückenschmerzen, Herzleiden oder Magenproblemen.“"
                            },
                            {
                                "example_id": "edcffd10-2f61-4721-87cb-fab0af6bff35",
                                "sense_id": "1e35c431-d64b-384f-837a-c0380d170b6c",
                                "text": "„Ein ziemlich trostloses Memento mori war hingegen die Hinfälligkeit seines Bruders Sandy: In den acht Monaten, seit Philip ihn zum letzten Mal gesehen hatte, hatte ihn die Osteoporose völlig verkrümmt, ganz zu schweigen von dem Herzleiden, an dem er drei Jahre später sterben würde.“"
                            },
                            {
                                "example_id": "77f77ca7-97e2-4222-8211-da465f324bb9",
                                "sense_id": "1e35c431-d64b-384f-837a-c0380d170b6c",
                                "text": "„Wenige Tage nach seiner Freilassung sprach der Dichter, der sich in der Haft ein schweres Herzleiden zugezogen und auf dem rechten Ohr das Gehör verloren hatte, auf einer Großversammlung zur Befreiung politischer Gefangener.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
