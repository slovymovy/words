                    },
                    {
                        "sense_id": "25db371b-091a-3f3f-a62e-0889657cbc4c",
                        "entry_id": "3d42a38d-ea28-30c6-8394-72232047467d",
                        "glosses": [
                            "Any proverbially distant or remote place."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "572619c5-4505-4158-9d1f-a8fee6a9c384",
                                "sense_id": "25db371b-091a-3f3f-a62e-0889657cbc4c",
                                "text": "You can try every shop from here to Timbuktu, but you won't find another one like this."
                            },
                            {
                                "example_id": "4f3552d4-c233-4d54-8d4f-6037c45f9c32",
                                "sense_id": "25db371b-091a-3f3f-a62e-0889657cbc4c",
                                "text": "Now, my little pesky pets, you're going to travel first-class in your own private compartment all the way to Timbuktu. And this time, you'll never come back."
                            }
                        ]
                    }
                ],
