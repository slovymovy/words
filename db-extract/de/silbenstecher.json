                "senses": [
                    {
                        "sense_id": "58dca06b-dba8-33b3-acc9-76b4cad9aed2",
                        "entry_id": "3b2d036b-2f39-3581-9180-5f5046fbb9f4",
                        "glosses": [
                            "Person, die etwas Geäußertes unangemessen genau/wörtlich nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf52b06-b27e-4f06-977d-195741dc1084",
                                "sense_id": "58dca06b-dba8-33b3-acc9-76b4cad9aed2",
                                "text": "„Nur aus dem Geist des Ganzen heraus kann für Langbehn in der Bibel Gottes Wort gefunden werden, »aber nicht im Sinne der Silbenstecher und der philologischen Kleingeister.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f083e2c6-f6b9-3c76-9f2e-a1f3c7813a0b",
                        "entry_id": "3b2d036b-2f39-3581-9180-5f5046fbb9f4",
                        "glosses": [
                            "jemand, der als Autor mit hoher oder gar übertriebener Präzision arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aeaf381-00c0-4e09-929d-70229d18f02e",
                                "sense_id": "f083e2c6-f6b9-3c76-9f2e-a1f3c7813a0b",
                                "text": "„Grass beweist sich als begnadeter Wortfinder, Lautmaler, Silbenstecher, der den Leser, aber fast mehr noch den Hörer der zeitgleich erschienenen, vom Autor selbst gesprochenen Hörbuchausgabe in den Bann zieht.“"
                            },
                            {
                                "example_id": "f19f3756-6341-4e04-930e-baefe37ab034",
                                "sense_id": "f083e2c6-f6b9-3c76-9f2e-a1f3c7813a0b",
                                "text": "„Der 55-Jährige ist der Silbenstecher der neuen Musik, sein Vokalstil folgt der Sprache so drängend, dass sie demaskiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
