                        "glosses": [
                            "Relatif à Gaston Fébus (1331 - 1391), prince de Béarn et Foix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00da4870-31de-4126-980a-0cf8e1fe8c5f",
                                "sense_id": "f9e68fe8-af10-3f3a-86a0-78ce20648525",
                                "text": "Érigé en 1373 par Gaston III de Foix-Béarn (dit « Gaston Fébus »), le Château de Morlanne est l’un des plus beaux exemples de construction fébusienne aux confins des Landes et du Béarn."
                            }
                        ]
                    },
