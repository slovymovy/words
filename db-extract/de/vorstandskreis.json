                        "examples": [
                            {
                                "example_id": "b71ef3af-ab52-410d-b8d3-faf35488d8e1",
                                "sense_id": "9c6c8886-232f-3bcd-a14d-2d5deb004d2a",
                                "text": "„Dem Vernehmen nach werden aus dem derzeitigen Vorstandskreis nur Stefan Herzberg und Marc Sommer in der Unternehmensführung bleiben.“"
                            },
                            {
                                "example_id": "48f7862c-8764-42ca-bd97-0223de819152",
                                "sense_id": "9c6c8886-232f-3bcd-a14d-2d5deb004d2a",
                                "text": "„Im engeren Vorstandskreis werden sich wahrscheinlich wenig ändern, nur Kassiererin Christa Nickisch wolle aufhören.“"
                            },
                            {
                                "example_id": "75740937-649e-4d9a-9932-e42038a15183",
                                "sense_id": "9c6c8886-232f-3bcd-a14d-2d5deb004d2a",
                                "text": "„Auch aus Vorstandskreisen verlautet, er sei teilweise in die Geschäfte mit Bykov involviert gewesen.“"
                            },
                            {
                                "example_id": "4eaa2024-e5ca-4b1c-a18a-f0303f72db3f",
                                "sense_id": "9c6c8886-232f-3bcd-a14d-2d5deb004d2a",
                                "text": "„Skepsis scheint nicht nur in Vorstandskreisen zu herrschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
