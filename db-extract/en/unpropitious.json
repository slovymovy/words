                        "glosses": [
                            "Not propitious; unfavourable, untimely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aeb72a0-fd9e-467f-ba34-3e513d418b9c",
                                "sense_id": "d5d221f5-5de7-3d69-b260-0a0a588f92a0",
                                "text": "'Tvvas vvhen the Dog-ſtar's unpropitious ray / Smote ev'ry brain, and vvither'd ev'ry Bay; / Sick vvas the Sun, the Ovvl forſook his bovv'r, / The moon-ſtruck Prophet felt the madding hour: […]"
                            },
                            {
                                "example_id": "eb1791b6-5a0a-439d-ad02-e1b670afd3d9",
                                "sense_id": "d5d221f5-5de7-3d69-b260-0a0a588f92a0",
                                "text": "[I]t was there that he had hoped to have found peace and rest from the past turmoils of life, in that enchanting spot, in which he might have desired to have ended his days, had not Fate, ever unpropitious to him, chased him from it."
                            }
                        ]
                    }
