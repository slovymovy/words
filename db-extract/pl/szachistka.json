                    {
                        "translation_id": "7a636783-dd07-4388-a817-cc34668cbc31",
                        "source_entry_id": "334cb611-7b48-3016-8284-bc802e162c16",
                        "source_sense_id": "0dc53349-4663-36bb-b8f3-7aa109287332",
                        "target_lang_word": "Schachspielerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schachspielerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "505bb5c6-8ab0-3b04-ad5f-9bf5fe6514ad",
                                        "entry_id": "c4250e1b-bfd7-3675-b0e5-441d846ee546",
                                        "glosses": [
                                            "weibliche Person, die Schach spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0591a10d-e0b1-4d71-bf14-0b2dfd0ea18e",
                                                "sense_id": "505bb5c6-8ab0-3b04-ad5f-9bf5fe6514ad",
                                                "text": "„Auch hat man, bemerkt, dass es fast in keinem Lande mehrere und geübtere Schachspielerinnen gebe, als in England.“"
                                            },
                                            {
                                                "example_id": "e13e9dda-bb22-4bf9-bbbd-ef1907f8bf95",
                                                "sense_id": "505bb5c6-8ab0-3b04-ad5f-9bf5fe6514ad",
                                                "text": "„Zwar mischt sich, etwa mit der ungarischen Schachspielerin Judith Polgar oder Ex-Schwimmvizeweltmeister Maxim Podoprigora, vereinzelt Prominenz unter die Teilnehmer – die überwiegende Mehrheit sind jedoch Hobbysportler, die von jüdischen Sportvereinen in der ganzen Welt entsandt werden (am größten ist die britische Mannschaft, gefolgt von der deutschen und der österreichischen), ein Teilnehmer kommt aus Guinea-Bissau, ein anderer aus Gibraltar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a51252b4-5bfb-411a-82d9-2887c8b643f8",
                        "source_entry_id": "334cb611-7b48-3016-8284-bc802e162c16",
