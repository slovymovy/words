                    },
                    {
                        "form_id": "ff6c2007-b904-4d9a-b051-2b3376877450",
                        "entry_id": "44d4d355-deba-3c89-b220-71a39279c5e0",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "вы́работавши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a49ab464-169d-3633-b14a-e69018fb2632",
                        "entry_id": "44d4d355-deba-3c89-b220-71a39279c5e0",
                        "glosses": [
                            "работая, изготовить, произвести; создать, разработать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2883b95-cb3c-47d0-85fa-26ff69634a91",
                                "sense_id": "a49ab464-169d-3633-b14a-e69018fb2632",
                                "text": "Всё, что выработал Петербург в идеале, всё, что прославили там господа теоретики, всё это теперь придётся здесь испытать на практике."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a02b601-90d2-38dd-a832-7ee285ac877c",
                        "entry_id": "44d4d355-deba-3c89-b220-71a39279c5e0",
                        "glosses": [
                            "постепенно развить, воспитать в себе какие-либо качества"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7124ff1-25fb-4f6f-9cf6-eb1f831cb489",
                                "sense_id": "0a02b601-90d2-38dd-a832-7ee285ac877c",
                                "text": "Одарённый большим умом и лёгкостью письменного изложения, он выработал себе такой слог, который обратил на него внимание."
                            },
                            {
                                "example_id": "340ba7d9-6fdb-48c3-a5f8-c2ed95432679",
                                "sense_id": "0a02b601-90d2-38dd-a832-7ee285ac877c",
                                "text": "Заводная игрушка позабавит ребёнка, пирамидка поможет выработать терпение и координацию движений, мяч укрепит физически."
                            }
                        ]
                    },
                    {
                        "sense_id": "980faa25-52a4-3641-89f4-8b6989f6a51d",
                        "entry_id": "44d4d355-deba-3c89-b220-71a39279c5e0",
                        "glosses": [
                            "разг. добыть трудом; заработать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793c032a-9d92-4cab-b532-3fa4ecf96c4c",
                                "sense_id": "980faa25-52a4-3641-89f4-8b6989f6a51d",
                                "text": "Они ни в чём не нуждаются, — сказал он, — работают мало, и если выработают какой-нибудь реал в сутки, то есть восьмую часть талера (около 14 коп. серебром), то им с лишком довольно на целый день."
                            },
                            {
                                "example_id": "fcacdc5d-b4fd-48b6-96a2-6bf1de37d814",
                                "sense_id": "980faa25-52a4-3641-89f4-8b6989f6a51d",
                                "text": "Но если до 1 января 2002 года вы уже выработали страховой стаж (не менее пяти лет), то, наверное, и нет оснований этим заниматься."
                            }
                        ]
                    },
                    {
                        "sense_id": "4002e472-ba29-38a4-aaeb-60f516408cd3",
                        "entry_id": "44d4d355-deba-3c89-b220-71a39279c5e0",
                        "glosses": [
                            "полностью использовать, исчерпать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0022cb-321e-4a1a-b45a-bf9d0892b556",
                                "sense_id": "4002e472-ba29-38a4-aaeb-60f516408cd3",
                                "text": "Необходимо установить причины аварии и изучить техническое состояние других объектов космодрома, которые давно выработали свой гарантийный ресурс."
                            }
                        ]
                    }
                ],
