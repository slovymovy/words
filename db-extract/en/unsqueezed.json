                    {
                        "sense_id": "229ac984-2b0c-35ac-8db3-0a57cc2e4c82",
                        "entry_id": "dda352d6-91a9-3e88-8d7f-b78579864882",
                        "glosses": [
                            "Not squeezed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "baccbc52-5dc5-4cb1-af10-1e3ddb2657fc",
                                "sense_id": "229ac984-2b0c-35ac-8db3-0a57cc2e4c82",
                                "text": "Here are verses that in spite / Of myself I needs must write, / Like the wine that oozes first / When the unsqueezed grapes have burst."
                            },
                            {
                                "example_id": "5e4d2e6b-751c-4852-95ac-7c50075a19f2",
                                "sense_id": "229ac984-2b0c-35ac-8db3-0a57cc2e4c82",
                                "text": "On squeezing in palm, not more than one-third of the sample passes between the fingers. That part which remains in palm is granular and loose, and the structure of the plant remains is more distinct than in the wet and unsqueezed sample."
                            },
                            {
                                "example_id": "33f298d4-4b51-4cec-b30b-8a7bc4de8307",
                                "sense_id": "229ac984-2b0c-35ac-8db3-0a57cc2e4c82",
                                "text": "70 mm wide, nonanamorphic (unsqueezed) image. Used only in selected large theaters."
                            }
                        ]
                    }
