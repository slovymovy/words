                    },
                    {
                        "translation_id": "1d363e52-8bc4-4a78-9c67-e461bbcac932",
                        "source_entry_id": "99acf954-69f1-3287-b7eb-fef541bf19a4",
                        "source_sense_description": "a movie photographer, especially one who is in charge of shooting a movie",
                        "target_lang_word": "Kameramann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kameramann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                        "entry_id": "56dc3989-c47e-3c7a-b93f-0a41f5f1cc0d",
                                        "glosses": [
                                            "männliche Person, die beruflich filmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c77569e-3183-4ecf-8ba0-68f2c687beed",
                                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                                "text": "Der Kameramann begleitet den Reporter auf Schritt und Tritt."
                                            },
                                            {
                                                "example_id": "e027b3ad-cc5a-424b-89a4-ea126f2df969",
                                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                                "text": "„Als die Kameraleute das Flugzeug verlassen hatten, schaute ich zu der Landkarte auf dem Bildschirm, auf der nun Asien im Mittelpunkt stand.“"
                                            },
                                            {
                                                "example_id": "bcfd4963-6813-4917-bc2f-02cb025873b2",
                                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                                "text": "„Aber als der erste Kameramann sich an ihm vorbeizwängte, gab er auf.“"
                                            },
                                            {
                                                "example_id": "113b9b4c-64d3-45c3-8a51-e4d6689c2fc6",
                                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                                "text": "„Zwei Kameramänner und zwei Tontechniker waren gekommen, und auch ein Ansager in grünem Blazer, auf dem auf der linken Brusttasche das WSOU-TV-Zeichen aufgestickt war.“"
                                            },
                                            {
                                                "example_id": "910041ab-940a-49a8-be6d-a76493db886a",
                                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                                "text": "„Danach filmte Brack in einem solchen Tempo zu Ende, daß der Kameramann nach der letzten Einstellung mit Nervenzusammenbruch in die Klinik gebracht werden mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ab95a82-b445-4fa8-aa00-57952683b17a",
                        "source_entry_id": "99acf954-69f1-3287-b7eb-fef541bf19a4",
                        "source_sense_description": "a movie photographer, especially one who is in charge of shooting a movie",
                        "target_lang_word": "Kamerafrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kamerafrau",
