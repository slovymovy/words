                                        "sense_id": "643806b6-a4c6-34f7-80ca-221e4afdddaa",
                                        "entry_id": "73753c13-df8c-340f-a9f2-dd45929a2da1",
                                        "glosses": [
                                            "The amount of money or resources earmarked for a particular institution, activity or timeframe."
