                "senses": [
                    {
                        "sense_id": "44acd47d-26ff-316d-989b-354479bcd6be",
                        "entry_id": "db8db429-1ca5-38fc-abee-e986e91dd053",
                        "glosses": [
                            "разг. оказавшись невнимательным, нерасторопным, пропускать, не видеть что-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d535b704-17d5-41a3-91cb-49f4d9b143fc",
                        "source_entry_id": "db8db429-1ca5-38fc-abee-e986e91dd053",
                        "source_sense_id": "44acd47d-26ff-316d-989b-354479bcd6be",
                        "target_lang_word": "manquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf08b8f-6e62-33b6-98c3-8d3e029a6ff7",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Faillir ; tomber en faute."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41c37576-ef5e-4582-8542-ee4e53fad02b",
                                                "sense_id": "4cf08b8f-6e62-33b6-98c3-8d3e029a6ff7",
                                                "text": "J'ai failli moi-même être englouti avec mon cheval par les sables mouvants du Tahaddart, entre Tanger et Azila, et j’ai manqué me noyer dans l’embouchure du Tensift."
                                            },
                                            {
                                                "example_id": "c753d1d0-c18d-4c92-9125-3d964098ea9e",
                                                "sense_id": "4cf08b8f-6e62-33b6-98c3-8d3e029a6ff7",
                                                "text": "Il y eut un autre coup de tonnerre, suffisamment proche pour que le sol tremble et que Jake manque tomber à l’eau."
                                            },
                                            {
                                                "example_id": "8c9da6da-c3e5-419c-8c89-bc792b7915cf",
                                                "sense_id": "4cf08b8f-6e62-33b6-98c3-8d3e029a6ff7",
                                                "text": "Tous les hommes peuvent manquer, sont sujets à manquer. — N’avez-vous jamais manqué?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed201fce-b970-3f7a-99ef-6a544276b16b",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Ne pas partir, en parlant du coup d'une arme à feu, lorsqu’on veut tirer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b0f9455-d964-45cd-b8da-aa4cd8f1ab8f",
                                                "sense_id": "ed201fce-b970-3f7a-99ef-6a544276b16b",
                                                "text": "Son revolver, son fusil a manqué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "695d74d0-ad95-30ff-b4cc-8f2edefcfc9e",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Tomber, faiblir, défaillir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0210be8f-8f69-44b8-8c3a-5662a4c499e1",
                                                "sense_id": "695d74d0-ad95-30ff-b4cc-8f2edefcfc9e",
                                                "text": "Ce cheval manque par les jambes. — Il ne peut plus se soutenir, les jambes, les forces lui manquent."
                                            },
                                            {
                                                "example_id": "72255ac7-b939-4422-8fb9-93baacee4960",
                                                "sense_id": "695d74d0-ad95-30ff-b4cc-8f2edefcfc9e",
                                                "text": "Elle va s’évanouir, le cœur lui manque. — Je suis si interdit que la parole me manque."
                                            },
                                            {
                                                "example_id": "15b2436b-a09d-43fb-8760-f48095bda80e",
                                                "sense_id": "695d74d0-ad95-30ff-b4cc-8f2edefcfc9e",
                                                "text": "Elle ne put pas y arriver, bien que la distance ne fût pas longue de leur chambre à la rue : le cœur lui manqua, et si Perrine ne l’avait pas soutenue elle serait tombée."
                                            },
                                            {
                                                "example_id": "a0a96f7e-078b-4ef4-b7f6-215ec5660909",
                                                "sense_id": "695d74d0-ad95-30ff-b4cc-8f2edefcfc9e",
                                                "text": "Quand je me retrouvai dans l’appartement de la rue de Rennes, pendant un instant le cœur me manqua : trois années encore à passer entre ces murs !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6a545f-311e-3198-bcb9-0cd43f8bf1c2",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Se dérober, s’affaisser, en parlant des choses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "718b9f83-ac63-4d2e-8849-accb81936f51",
                                                "sense_id": "5c6a545f-311e-3198-bcb9-0cd43f8bf1c2",
                                                "text": "La terre manqua sous leurs pieds. — Le pied lui a manqué, et il est tombé"
                                            },
                                            {
                                                "example_id": "caf1bc0a-611a-4b40-a0ff-0da572c02cb5",
                                                "sense_id": "5c6a545f-311e-3198-bcb9-0cd43f8bf1c2",
                                                "text": "Sa femme était morte depuis moins d’une heure, et déjà tout était bouleversé. Il sentait le monde lui manquer sous le pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741a1647-184c-3817-a4fe-19dfd489ed9b",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Mourir, disparaître, en parlant de quelqu’un qui est nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd54bdf-2e49-40a4-8ddc-4634286a3004",
                                                "sense_id": "741a1647-184c-3817-a4fe-19dfd489ed9b",
                                                "text": "Cet homme est bien malade, s’il vient à manquer, sa famille est ruinée."
                                            },
                                            {
                                                "example_id": "4c60953e-f6ac-4267-8e0f-438be2cc3fba",
                                                "sense_id": "741a1647-184c-3817-a4fe-19dfd489ed9b",
                                                "text": "Au revoir, dis-je gravement à la jeune fille. Mais écoutez-moi : votre ami est vieux et peut vous manquer. Permettez-moi de ne jamais vous manquer à vous-même, et je serai tranquille. Dieu vous garde, mon enfant !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef1dc1ac-30f7-35c6-93ee-233a38913fc6",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Faire faute, faire défaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607db8e0-d1d4-4ab2-aa22-c6a106c94396",
                                                "sense_id": "ef1dc1ac-30f7-35c6-93ee-233a38913fc6",
                                                "text": "Mais loin de son Plateau, Arsène André étouffait. L'air résineux lui manquait, les brouillards de la Meuse lui enflammaient la gorge."
                                            },
                                            {
                                                "example_id": "f9efaf97-27e0-4b22-a1a3-349672afddc5",
                                                "sense_id": "ef1dc1ac-30f7-35c6-93ee-233a38913fc6",
                                                "text": "Aux élections générales de 1837, Cobden se porta candidat à Stockport. Il lui manqua une centaine de voix pour être élu."
                                            },
                                            {
                                                "example_id": "41603fb6-6654-41a3-a1a8-a6cbf549193f",
                                                "sense_id": "ef1dc1ac-30f7-35c6-93ee-233a38913fc6",
                                                "text": "Les gazelles et les outardes ne manquent pas non plus, mais il faudrait organiser des battues pour s'en emparer."
                                            },
                                            {
                                                "example_id": "20381c5c-ecc6-4018-9ee2-8b52f19e10e4",
                                                "sense_id": "ef1dc1ac-30f7-35c6-93ee-233a38913fc6",
                                                "text": "Mes gamins y m’manquent grave, dites-leur qu'on se capte la semaine prochaine ici, au supermarché, tiens, prends ça !… 20 keusses, c’est pour la note !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "626f0ea4-76e3-3fae-878b-8498ce82551a",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Ne pas se trouver là où l'on devrait être."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1431e2b6-17e7-4950-a7b2-83f8618ed30b",
                                                "sense_id": "626f0ea4-76e3-3fae-878b-8498ce82551a",
                                                "text": "La formule du pain perdu s'inspirerait-elle des deux recettes d’Aliter dulcia données par Apicius ? sous le règne de Tibère ? N'y manquent que les œufs."
                                            },
                                            {
                                                "example_id": "b63b9161-0446-46fc-8d3e-350bde1d19bc",
                                                "sense_id": "626f0ea4-76e3-3fae-878b-8498ce82551a",
                                                "text": "Il manque deux élèves dans cette classe. — Il manque beaucoup de livres dans cette bibliothèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3997c498-4403-3111-8a3c-6dddb1cec838",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Ne pas réussir dans ce qu’on a entrepris, ne pas rencontrer ce qu’on cherchait, laisser échapper ce qu’on poursuivait."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ba7b87-6c78-4291-b6b2-5bc59caaac8f",
                                                "sense_id": "3997c498-4403-3111-8a3c-6dddb1cec838",
                                                "text": "Cependant, au milieu de la chaussée, des nègres se poursuivaient à coup de boules de neige et parfois, une de ces boules, manquant son but, s'écrasait contre une devanture ; […]."
                                            },
                                            {
                                                "example_id": "7b4b4187-9ba8-4870-bd33-81f45259f82f",
                                                "sense_id": "3997c498-4403-3111-8a3c-6dddb1cec838",
                                                "text": "De tous les pianistes soviétiques, Sofronitzki fut sans doute le plus adulé du public : Gilels et Richter eux-mêmes le vénéraient et ne manquaient pas ses récitals."
                                            },
                                            {
                                                "example_id": "1729c331-d7b4-499d-9cfd-7506be6174f9",
                                                "sense_id": "3997c498-4403-3111-8a3c-6dddb1cec838",
                                                "text": "Je suis arrivé trop tard, j’ai manqué mon ami, je l’ai manqué d’un quart d’heure."
                                            },
                                            {
                                                "example_id": "c8f0196c-e923-4a84-9298-83e51cf877e0",
                                                "sense_id": "3997c498-4403-3111-8a3c-6dddb1cec838",
                                                "text": "Il a manqué le train. — Je regrette d’avoir manqué votre visite. — Il a manqué une belle occasion. — Il a manqué son coup. — Il a manqué le but."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c757171-086e-3943-8846-58d657ab3027",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Tirer un gibier et ne pas l’atteindre."
                                        ],
                                        "tags": [
                                            "especially",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d3ad5df-05ce-453b-a7b5-307eb8c13329",
                                                "sense_id": "6c757171-086e-3943-8846-58d657ab3027",
                                                "text": "J’ai manqué un lièvre qui était au bout de mon fusil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b33d052-3842-3cbf-938d-69b251872ccc",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Ne pas réussir à prendre."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10844d34-3872-4d1a-a518-efc4f8539cc2",
                                                "sense_id": "2b33d052-3842-3cbf-938d-69b251872ccc",
                                                "text": "Les chasseurs ont manqué le cerf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b737a4-898b-311b-8ee0-19788fb8eafa",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Laisser échapper."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a597d4-6430-4b42-b0e9-960dea032765",
                                                "sense_id": "e0b737a4-898b-311b-8ee0-19788fb8eafa",
                                                "text": "Il s’agit d’un évadé de la Guyane. Je le piste depuis cinq mois et je l’ai manqué une première fois à Nogent dans une guinguette du bord de l’eau, où on l’employait comme garçon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c9d902-872d-3688-8bab-1de426d88006",
                                        "entry_id": "92a41485-e1ab-3ec2-8c62-0a046e4825e2",
                                        "glosses": [
                                            "Faillir ; manquer de."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e1a6413-9e5d-406a-bb89-0ef1b8cb6394",
                                                "sense_id": "e7c9d902-872d-3688-8bab-1de426d88006",
                                                "text": "Vic en avale de travers son sacro-saint rocher praliné, tousse, manque s'étouffer. Une bonne âme lui frappe dans le dos à tour de bras."
                                            },
                                            {
                                                "example_id": "7512e5f7-5372-4577-992e-2e8248aad221",
                                                "sense_id": "e7c9d902-872d-3688-8bab-1de426d88006",
                                                "text": "La jeune fille s’écarta brusquement, manquant trébucher et chuter au bas de la falaise."
                                            },
                                            {
                                                "example_id": "190bdd05-5034-4fca-b24b-021871ccf0d1",
                                                "sense_id": "e7c9d902-872d-3688-8bab-1de426d88006",
                                                "text": "Alice Pike Barney manque en laisser tomber son face-à-main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38abe7b2-4596-3a42-b9c7-d01706a148b1",
