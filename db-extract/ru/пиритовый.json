                "senses": [
                    {
                        "sense_id": "c43136ed-7304-3756-b1af-8d7719745ec9",
                        "entry_id": "7e69e5e1-9891-33bc-9b47-920e298a50de",
                        "glosses": [
                            "минер. содержащий пирит, состоящий из пирита"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e908cb-67ff-4343-80df-82143dccb4fb",
                                "sense_id": "c43136ed-7304-3756-b1af-8d7719745ec9",
                                "text": "Моренные материалы состоят из сланцев с обильными пиритовыми включениями, а также из серых и белых мраморов, из которых в основном сложена верхняя часть поясов массива Хан-тенгри."
                            },
                            {
                                "example_id": "bc66ad1b-319c-41ac-8272-fbc8c06861a2",
                                "sense_id": "c43136ed-7304-3756-b1af-8d7719745ec9",
                                "text": "Не менее примечательна находка в 1968 году в донбасской угольной шахте «металлического стержня», оказавшегося естественным пиритовым образованием."
                            }
                        ]
                    }
