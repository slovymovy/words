                ],
                "senses": [
                    {
                        "sense_id": "ba7850c3-4bc8-3435-815d-f4028a8a596a",
                        "entry_id": "188af6dc-7178-3b6b-90f8-abd4c8559415",
                        "glosses": [
                            "Schimpfwort für einen Nazi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5f05ba-1211-4572-887e-14e991e2534c",
                                "sense_id": "ba7850c3-4bc8-3435-815d-f4028a8a596a",
                                "text": "„Hurley zog drei Gegenstände heraus und hielt sie Rapp hin. ›Ein SS-Dolch und deutsche Orden aus dem Zweiten Weltkrieg. Der Kerl ist ein Nazischwein.‹“"
                            },
                            {
                                "example_id": "69639614-9680-4def-b811-a0b88f81ef32",
                                "sense_id": "ba7850c3-4bc8-3435-815d-f4028a8a596a",
                                "text": "„Er drängt mich, eine Schlägerei anzufangen. Ein paar Nazischweine zu vertrimmen.“"
                            },
                            {
                                "example_id": "665d9193-80e8-46d1-b5fc-4cb82c46d348",
                                "sense_id": "ba7850c3-4bc8-3435-815d-f4028a8a596a",
                                "text": "„Weg mit dem Nazischwein.“"
                            },
                            {
                                "example_id": "3c1ea723-4ea7-49d9-af81-3d5abd1a8ba3",
                                "sense_id": "ba7850c3-4bc8-3435-815d-f4028a8a596a",
                                "text": "„Und Sie haben nie mit Goebbels gekegelt, oder? Nazischwein!“"
                            },
                            {
                                "example_id": "bda53d99-7922-4573-9c7c-d64636639549",
                                "sense_id": "ba7850c3-4bc8-3435-815d-f4028a8a596a",
                                "text": "„Ich will weder was mit dir zu tun haben, noch mit deinen Plänen, du Nazischwein!“"
                            },
                            {
                                "example_id": "00fc320b-4562-418b-9d04-62fc2f86591f",
                                "sense_id": "ba7850c3-4bc8-3435-815d-f4028a8a596a",
                                "text": "„Los, ihr Nazischweine!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
