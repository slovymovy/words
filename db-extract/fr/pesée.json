                                                "example_id": "1b7e6387-8ea7-40ac-bd1e-b69d0a488cb2",
                                                "sense_id": "d064f30b-b435-3eac-b24e-47a0f2a6fd6b",
                                                "text": "[I was] doing a weight [1 lb. at that time] a week, sometimes more, sometimes less."
                                            },
                                            {
                                                "example_id": "a44ff33c-bb07-494c-a334-9a8422e110c9",
                                                "sense_id": "d064f30b-b435-3eac-b24e-47a0f2a6fd6b",
                                                "text": "The ones the CIB should be looking out for, to her mind, were the officers who raided a flat, found a couple of weights of cannabis and stashed half of it before they made the collar. The cannabis would make its way back on to the street […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65017460-bf0e-38b8-ae97-1c2e03110825",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49821b63-c85d-48da-8c40-9f411c595012",
                                                "sense_id": "65017460-bf0e-38b8-ae97-1c2e03110825",
                                                "text": "No matter how much money he makes, he is still a soldier, but he has the weight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d34b067-4e62-3c81-af5e-1ff4d8a1356a",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Weight class"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a231d6-3352-46d6-96c3-9ec3ee60face",
                                                "sense_id": "3d34b067-4e62-3c81-af5e-1ff4d8a1356a",
                                                "text": "You’re no match for ’em. You ain’t up to their weight. It’s like little Black Strap standing up to Tom Spring,—the Black’s a pretty fighter but, Law bless you, his arm ain’t long enough to touch Tom,—and I tell you, you’re going it with fellers beyond your weight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee8097f-ab4f-3042-b51b-2a4b3f676693",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "Emphasis applied to a given criterion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "289d44c8-fdc7-4471-a0d4-4f3959f39ec7",
                                                "sense_id": "fee8097f-ab4f-3042-b51b-2a4b3f676693",
                                                "text": "“Logits” are the vectors of weights."
                                            },
                                            {
                                                "example_id": "155ee8e2-85a0-45de-bc73-04f968764c9c",
                                                "sense_id": "fee8097f-ab4f-3042-b51b-2a4b3f676693",
                                                "text": "Even though it's got its two features of color and hardness, it doesn't know how much importance or, as computer scientists say, weight to place on each of them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a99bf05-52fb-3d9a-9ea0-357ba888056e",
                                        "entry_id": "6e08b370-cdab-3ad6-8111-daebeed4c66b",
                                        "glosses": [
                                            "To add weight to something; to make something heavier."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06dc9826-e9d9-37c4-b4a5-27790b5195c0",
                                        "entry_id": "6e08b370-cdab-3ad6-8111-daebeed4c66b",
                                        "glosses": [
                                            "To add weight to something; to make something heavier.",
                                            "To load (fabrics) with barite, etc. to increase the weight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e07efed-ce59-38f4-8a46-54e951c18069",
                                        "entry_id": "6e08b370-cdab-3ad6-8111-daebeed4c66b",
                                        "glosses": [
                                            "To load, burden or oppress someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4508fe5-b9fd-3d09-a999-58b402e59671",
                                        "entry_id": "6e08b370-cdab-3ad6-8111-daebeed4c66b",
                                        "glosses": [
                                            "To assign weights to individual statistics."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "853787ea-5906-3b9b-8e1f-47bec4ee8af0",
                                        "entry_id": "6e08b370-cdab-3ad6-8111-daebeed4c66b",
                                        "glosses": [
                                            "To bias something; to slant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be0c0946-596c-445c-9b4d-63a0506c53db",
                                                "sense_id": "853787ea-5906-3b9b-8e1f-47bec4ee8af0",
                                                "text": "The criteria governing the choice of candidate were heavily weighted in his favor."
                                            },
                                            {
                                                "example_id": "7df84c2d-141d-451d-b1fb-2b5f9b6b605c",
                                                "sense_id": "853787ea-5906-3b9b-8e1f-47bec4ee8af0",
                                                "text": "The U.K. economy is heavily weighted towards the service sector and the coronavirus pandemic could lead to a 10% fall in gross domestic product in the second quarter, according to economists at Jefferies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d270322-ee03-3dd5-a4eb-effa885e717f",
                                        "entry_id": "6e08b370-cdab-3ad6-8111-daebeed4c66b",
                                        "glosses": [
                                            "To handicap a horse with a specified weight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbd9fa40-7c73-34c3-b1dd-5a73c3dbad24",
                                        "entry_id": "6e08b370-cdab-3ad6-8111-daebeed4c66b",
                                        "glosses": [
                                            "To give a certain amount of force to a throw, kick, hit, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd8175c2-98d9-4890-975a-c309b814cdbf",
                                                "sense_id": "dbd9fa40-7c73-34c3-b1dd-5a73c3dbad24",
                                                "text": "With good peripheral vision he spots his teammate, Ray Evans, lurking in the scoring zone and sweeps a perfectly weighted pass to him."
                                            }
                                        ]
                                    }
                                ]
                            }
