                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4262e68b-b3ce-45b0-bc9b-394bb59d864f",
                                "sense_id": "f47af4b7-87d2-3a42-b5ff-fbc06cf7df69",
                                "text": "Pourquoi redécrire les processus ?"
                            },
                            {
                                "example_id": "5af21c75-390a-456f-9593-3cad9bb18edd",
                                "sense_id": "f47af4b7-87d2-3a42-b5ff-fbc06cf7df69",
                                "text": "Nul n'est besoin d'inventer des mots nouveaux pour redécrire."
                            },
                            {
                                "example_id": "3656154d-0a9e-4e44-ade2-3a9516080488",
                                "sense_id": "f47af4b7-87d2-3a42-b5ff-fbc06cf7df69",
                                "text": "Redessiner une carte revient à redécrire ces partages, à les remettre en jeu : la différence qui sépare le symbole du symbolisé en devient imperceptible."
                            }
                        ]
                    }
