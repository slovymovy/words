                ],
                "senses": [
                    {
                        "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                        "entry_id": "e8745533-8555-3403-84f4-05adab643cea",
                        "glosses": [
                            "vorsätzliches oder fahrlässiges Inbrandsetzen einer fremden Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d601f758-73d7-4d22-83ba-4bb527c8bb03",
                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                "text": "Das Gebäude fiel einer Brandstiftung zum Opfer."
                            },
                            {
                                "example_id": "0fd6a0cb-ad6d-4350-9eee-cd4c797df4b0",
                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                "text": "Als Ursache für den Scheunenbrand wird Brandstiftung vermutet."
                            },
                            {
                                "example_id": "c6900936-9956-4df3-8d58-f5abb8b44d2c",
                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                "text": "„Den Vorwurf der Brandstiftung lässt er fallen, aber Hennis Drohung gegen Schwester Angelika kurz vor der Tat, die Zeugenaussage der Frau und vor allem ihr Schweigen führt er wieder und wieder an.“"
                            },
                            {
                                "example_id": "3f57d60e-7d0d-40e1-9c0f-8ecf2cdffcb1",
                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                "text": "„Wenn auch Brandstiftungen vorgekommen sein sollten – was aber durchaus zweifelhaft ist, weil niemand einen Grund zu Brandstiftungen hatte, sondern sich damit nur selbst Scherereien und Gefahren ausgesetzt hätte – so kann man doch in diesen Brandstiftungen niemals den Grund für den Brand Moskaus suchen, der auch ohne sie genau so hätte vor sich gehen müssen.“"
                            },
                            {
                                "example_id": "fb40f731-e9ed-4e14-8e4a-950732da0c2a",
                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                "text": "„Aber entweder gab es in Eyrarbakki kein Feuer aufzutreiben, oder der Junker verstand sich nicht auf Brandstiftung, denn das Haus blieb stehen.“"
                            },
                            {
                                "example_id": "fe97c95e-af1b-4bd3-b801-12863e045ec2",
                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                "text": "„Die Plünderungen und die Brandstiftungen, das gezielte und viel zu oft beiläufige Morden, die Massenvergewaltigungen, all das erlebte der Arzt aus nächster Nähe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
