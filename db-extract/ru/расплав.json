                "senses": [
                    {
                        "sense_id": "b9024353-9e40-346e-99f0-b78bec40c165",
                        "entry_id": "addde3ce-6882-316b-b63c-77f490253077",
                        "glosses": [
                            "жидкость при температуре, не слишком сильно превышающей температуру плавления вещества"
                        ],
