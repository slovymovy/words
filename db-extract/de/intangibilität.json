                "senses": [
                    {
                        "sense_id": "79221a77-2a60-34fd-ad59-a946410f3175",
                        "entry_id": "16a43b29-4426-3c48-aa4f-047ba02c7aac",
                        "glosses": [
                            "Eigenschaft, keine körperliche, materielle, berührbare (tangible) Form zu haben"
                        ],
                        "tags": [
                            "besonders über Dienstleistungen"
                        ],
                        "examples": [
                            {
                                "example_id": "cd2ea51f-3371-4719-8c51-a95003ced2ff",
                                "sense_id": "79221a77-2a60-34fd-ad59-a946410f3175",
                                "text": "„Man unterscheidet zwischen den konstitutiven Merkmalen: Intangibilität, Verderblichkeit, Integration des externen Faktors, wahrgenommenes Kaufrisiko und Individualität.“"
                            },
                            {
                                "example_id": "ac0c244f-ad3d-495f-8454-3f94b18ccc77",
                                "sense_id": "79221a77-2a60-34fd-ad59-a946410f3175",
                                "text": "„Aufgrund der Intangibilität ist das wahrgenommene Kaufrisiko für Kunden bei vielen Dienstleistungen höher als beim Kauf von Sachleistungen, weil Dienstleistungen eher Vertrauens- und Erfahrungseigenschaften aufweisen, wohingegen Sachleistungen eher mit Sucheigenschaften behaftet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
