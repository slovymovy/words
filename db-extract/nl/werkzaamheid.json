                                        "sense_id": "2f88e3a7-3129-39d7-ab2d-4131f364a5a9",
                                        "entry_id": "35269d5a-a2a6-3550-841e-51938192d618",
                                        "glosses": [
                                            "Something done as an action or a movement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e4ddd95-92df-4939-8a18-6ae9866de205",
                                                "sense_id": "2f88e3a7-3129-39d7-ab2d-4131f364a5a9",
                                                "text": "The activity for the morning was a walk to the store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88cfa8ff-dd6a-3b7f-ba4b-a806955ffdba",
                                        "entry_id": "35269d5a-a2a6-3550-841e-51938192d618",
                                        "glosses": [
                                            "Something done for pleasure or entertainment, especially one involving movement or an excursion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85fd785-7be9-45ef-903c-9bab9e12268c",
                                                "sense_id": "88cfa8ff-dd6a-3b7f-ba4b-a806955ffdba",
                                                "text": "An increasing number of sports activities are on offer at the university."
                                            },
                                            {
                                                "example_id": "09fe1886-fac7-473c-b6a0-bc01c0147496",
                                                "sense_id": "88cfa8ff-dd6a-3b7f-ba4b-a806955ffdba",
                                                "text": "Quilting can be an enjoyable activity."
                                            },
                                            {
                                                "example_id": "da5aa1d6-d531-42ca-86d3-293b4fc0f2ed",
                                                "sense_id": "88cfa8ff-dd6a-3b7f-ba4b-a806955ffdba",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3bad11-2177-303c-8086-993e83f52056",
                                        "entry_id": "35269d5a-a2a6-3550-841e-51938192d618",
                                        "glosses": [
                                            "The lexical aspect (aktionsart) of verbs or predicates that change over time and have no natural end point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dc48e86-6ac2-4134-87e6-b73057861dbf",
                                                "sense_id": "9d3bad11-2177-303c-8086-993e83f52056",
                                                "text": "[…]distinctions among states of affairs are reflected to a striking degree in distinctions among Aktionsart types. That is, situations are expressed by state verbs or predicates, events by achievement verbs or predicates, and actions by activity verbs or predicates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d081127-0004-3e7f-88fd-e8b37600e383",
                                        "entry_id": "35269d5a-a2a6-3550-841e-51938192d618",
                                        "glosses": [
                                            "The number of radioactive decays per unit time. Unit for it: becquerel or curie"
                                        ],
