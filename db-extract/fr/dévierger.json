                "senses": [
                    {
                        "sense_id": "ca845ed6-4ea6-39e4-a8bf-612c9d341315",
                        "entry_id": "ef338e1c-ce5e-3cd6-bc89-654aa7b309e4",
                        "glosses": [
                            "Dépuceler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc3152e-f01d-42d4-907e-9f399571b210",
                                "sense_id": "ca845ed6-4ea6-39e4-a8bf-612c9d341315",
                                "text": "J’insisterai sur le comportement des volontaires selon les récits de Musumeci, qui font ripaille dans les couvents, qui déviergent les toutes jeunes filles (sans doute aussi les religieuses, forcer le trait ne gâte rien)."
                            },
                            {
                                "example_id": "abaa033e-dca2-4779-931f-601a0b7f58e0",
                                "sense_id": "ca845ed6-4ea6-39e4-a8bf-612c9d341315",
                                "text": "Je te dis pas le scandale qu’il y a eu à Nancy où il habitait avant ! C’est là-bas qu’il a déviergé une jeune fille d’un avocat de chez nous qui fait un peu de politique et qui veut d’ailleurs devenir président grâce au coup de pouce des Américains."
                            },
                            {
                                "example_id": "59683eb1-0f20-469c-abe9-845cc85f1ab0",
                                "sense_id": "ca845ed6-4ea6-39e4-a8bf-612c9d341315",
                                "text": "La voie lactée est déviergée\nLa voie lactée est LSD\nLady Trenton est épuisée\nEn dessous de Bill retrouvé"
                            }
                        ]
                    }
