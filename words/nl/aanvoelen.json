            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c2c89ce-dfcc-3928-a2c0-6b41cd7ec046",
                    "sense_definition": "een bepaalde fysieke sensatie geven bij aanraking",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysieke_sensatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je voorhoofd <w>voelt</w> erg warm <w>aan</w>, je hebt misschien koorts.",
                            "target_lang_translations": {
                                "en": "Your forehead <w>feels</w> very warm, you might have a fever."
                            }
                        },
                        {
                            "text": "Deze nieuwe handdoeken <w>voelen</w> heerlijk zacht <w>aan</w> na het wassen.",
                            "target_lang_translations": {
                                "en": "These new towels <w>feel</w> wonderfully soft after washing."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zacht aanvoelen",
                        "warm aanvoelen",
                        "koud aanvoelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to give a certain physical sensation when touched"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feel",
                                "target_lang_sense_clarification": "to have a particular texture or temperature"
                            },
                            {
                                "target_lang_word": "feel like",
                                "target_lang_sense_clarification": "to have the sensation of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092c929e-327d-3375-a08e-0e0f194e166a",
                    "sense_definition": "iets intuïtief begrijpen of merken zonder dat het expliciet gezegd wordt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intuïtie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>voelt</w> altijd goed <w>aan</w> wanneer iemand behoefte heeft aan een gesprek.",
                            "target_lang_translations": {
                                "en": "She always <w>senses</w> well when someone needs a conversation."
                            }
                        },
                        {
                            "text": "De hond kon de sfeer in huis feilloos <w>aanvoelen</w>.",
                            "target_lang_translations": {
                                "en": "The dog could <w>sense</w> the atmosphere in the house perfectly."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemerken",
                        "doorhebben"
                    ],
                    "common_phrases": [
                        "de sfeer aanvoelen",
                        "feilloos aanvoelen",
                        "goed aanvoelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to understand or notice something intuitively without it being explicitly stated"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sense",
                                "target_lang_sense_clarification": "to instinctively be aware of something"
                            },
                            {
                                "target_lang_word": "feel",
                                "target_lang_sense_clarification": "to have an intuitive impression"
                            },
                            {
                                "target_lang_word": "pick up on",
                                "target_lang_sense_clarification": "to notice or become aware of something subtle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
