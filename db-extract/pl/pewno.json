                "translations": [
                    {
                        "translation_id": "c0df4366-eb79-4630-8857-fda3b4bf53e9",
                        "source_entry_id": "43cc3059-2067-353f-81bf-14520b5f49f5",
                        "source_sense_id": "58c8d313-8b8a-3055-bd47-295d92ea5d05",
                        "target_lang_word": "surely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84032c6a-9b2d-34fb-a3a0-79fc6a145067",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "Without fail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "406c8243-0e5a-4fe4-bdcc-81fcc211cc27",
                                                "sense_id": "84032c6a-9b2d-34fb-a3a0-79fc6a145067",
                                                "text": "slowly but surely"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "Certainly, undoubtedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9b0d14-0b29-4e6f-ac77-7ad98fa65234",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Surely, you must be joking."
                                            },
                                            {
                                                "example_id": "3621f3cb-b892-44b0-ab9d-e6dd2977a6eb",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "You don’t suppose we're going to pay for you, surely?"
                                            },
                                            {
                                                "example_id": "43d2bcd0-c794-4516-846b-a4cd249eb952",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "She’s surely got the letter by now."
                                            },
                                            {
                                                "example_id": "9a311353-e1b1-495e-b931-1e8f75127d7e",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "But then I had the flintlock by me for protection. ¶ There were giants in the days when that gun was made; for surely no modern mortal could have held that mass of metal steady to his shoulder. The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…]."
                                            },
                                            {
                                                "example_id": "34663fcc-6e83-4c73-a424-c4edc32328ad",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Ted Striker: The stewardess said... both pilots?!\nDr. Rumack: Can you fly this plane and land it?\nTed Striker: Surely you can't be serious.\nDr. Rumack: I am serious; and don't call me Shirley."
                                            },
                                            {
                                                "example_id": "18d0c44d-e5af-404c-a843-a5a80d2b4334",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Here perhaps one of you might interrupt me and say, 'But what is it that you do, Socrates? How is it that you have been misrepresented like this? Surely all this talk and gossip about you would never have arisen if you had confined yourself to ordinary activities, but only if your behaviour was abnormal. Give us the explanation, if you do not want us to draw our own conclusions.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "With confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17183608-5e5e-41bb-8ca6-60914ff1a33d",
                                                "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                                "text": "His feet were planted surely on the ground."
                                            },
                                            {
                                                "example_id": "1db64fc2-249b-44ee-9da4-84ee0955ecf5",
                                                "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                                "text": "Forasmuch as many have taken in hand to set forth in order a declaration of those things which are most surely believed among us[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19844fd2-2832-4860-af9d-e69c6d624da3",
                        "source_entry_id": "43cc3059-2067-353f-81bf-14520b5f49f5",
                        "source_sense_id": "58c8d313-8b8a-3055-bd47-295d92ea5d05",
                        "target_lang_word": "probably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "probably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                        "entry_id": "9bf83edc-da60-354a-a451-2e5a06dcde06",
                                        "glosses": [
                                            "In all likelihood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0771d08f-2890-4085-91bd-2db9514ceacc",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "He probably will arrive tomorrow."
                                            },
                                            {
                                                "example_id": "a8f6ab86-a241-4e97-a094-9f79f409cd5e",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably he'll arrive tomorrow."
                                            },
                                            {
                                                "example_id": "c64c27a4-3184-4fcf-befb-c946c4605a67",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "It is probably too late for amends."
                                            },
                                            {
                                                "example_id": "4dcfb15c-72e1-442f-a97d-d7ef680beedd",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "It probably is too late for amends."
                                            },
                                            {
                                                "example_id": "f19817ff-0a76-493f-8ca5-5737e843fc2a",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "She probably has arrived by now."
                                            },
                                            {
                                                "example_id": "8018e839-ce26-418c-8b1b-b20d909e3c46",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "She has probably arrived by now."
                                            },
                                            {
                                                "example_id": "dd514415-8f91-4104-b79e-37b1bf925ff1",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably she has arrived by now."
                                            },
                                            {
                                                "example_id": "36c31054-dc7f-464a-be9d-298b0be2fd9d",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "He'll probably arrive tomorrow."
                                            },
                                            {
                                                "example_id": "549698ed-29d3-43bd-8710-acfb4ef08179",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Probably it is too late for amends."
                                            },
                                            {
                                                "example_id": "39796ad0-3c6a-440f-844a-39326eaa5e02",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes[…]. And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            },
                                            {
                                                "example_id": "90162654-b440-4543-9e91-ed126046e67b",
                                                "sense_id": "5664b600-22fa-38bd-bc62-4e8e2e5aacf0",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close[…]above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them. Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
