                                "target_lang_sense_clarification": "loose-fitting shirt"
                            },
                            {
                                "target_lang_word": "overalls",
                                "target_lang_sense_clarification": "protective work clothing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c75f29a-005b-3fc1-8812-57fb999ba950",
                    "sense_definition": "een wigvormig pennetje in een klavecimbel om snaren te tokkelen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muziekinstrumenten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kiel</w> van een klavecimbel werd vroeger vaak gemaakt van een ravenpen.",
                            "target_lang_translations": {
                                "en": "The <w>plectrum</w> of a harpsichord was often made from a raven's quill in the past."
                            }
                        },
                        {
                            "text": "Als de <w>kiel</w> versleten is, klinkt de snaar van het instrument niet meer zuiver.",
                            "target_lang_translations": {
                                "en": "If the <w>plectrum</w> is worn out, the instrument's string no longer sounds pure."
                            }
