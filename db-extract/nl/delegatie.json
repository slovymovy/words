                "senses": [
                    {
                        "sense_id": "53e6a324-9e7d-3f62-87e5-eb62f7528f3a",
                        "entry_id": "debb7231-c691-339c-b970-ad34b9ba3b9a",
                        "glosses": [
                            "een klein aantal mensen als vertegenwoordigers van een grote groep, afvaardiging, vertegenwoordigig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac2030bd-ed1a-4f7b-8a96-6d603bbf828c",
                                "sense_id": "53e6a324-9e7d-3f62-87e5-eb62f7528f3a",
                                "text": "Een kleine delegatie van de klas probeerde de leraar te overtuigen dat het proefwerk te moeilijk was geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee245fe6-0a76-38b3-bc3e-8eae3c12b317",
                        "entry_id": "debb7231-c691-339c-b970-ad34b9ba3b9a",
                        "glosses": [
                            "overdracht van (een deel van een) bevoegdheid of verantwoordelijkheid door een persoon of orgaan (de delegant) aan een ander (de delegataris), meestal hiërarchisch ondergeschikt persoon of orgaan"
                        ],
                        "tags": [
                            "staatsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "abbffb9d-0c79-4b7a-b8f3-6df6a31956e9",
                                "sense_id": "ee245fe6-0a76-38b3-bc3e-8eae3c12b317",
                                "text": "De delegatie van haar verantwoordelijkheden was voor de overbezorgde moeder erg moeilijk, vandaar dat ze de leider van het voetbalkamp een uitgebreide lijst gaf van zaken waar hij rekening mee moest houden met betrekking tot haar zoontje van 18."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c595073-1235-3c4b-a2e9-e83a12cfd7f5",
                        "entry_id": "debb7231-c691-339c-b970-ad34b9ba3b9a",
                        "glosses": [
                            "overneming van een schuld door de oorspronkelijke schuldenaar (de delegant) aan een derde (de gedelegeerde of overnemer)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9720d2fd-a891-47bd-b40f-1dda8c09af1f",
                        "source_entry_id": "debb7231-c691-339c-b970-ad34b9ba3b9a",
                        "source_sense_id": "53e6a324-9e7d-3f62-87e5-eb62f7528f3a",
