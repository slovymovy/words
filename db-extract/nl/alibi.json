                    {
                        "translation_id": "d502ac98-eb90-49e1-8bea-5208f832c62a",
                        "source_entry_id": "0517a9a3-cfd7-3dd8-80f3-ad40a3c4d238",
                        "source_sense_id": "6e54df98-6ec1-33a9-a395-b29d021189d3",
