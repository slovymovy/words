                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fcd98b3-b736-34fd-a361-5bb04e91fb48",
                                        "entry_id": "bb4d01f7-21fe-3047-921c-7ed248f68edb",
                                        "glosses": [
                                            "To disseminate."
                                        ],
