{
    "word_family": [
        "snap",
        "snappily",
        "snappiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b592bdc1-d84c-3ee2-843e-07889642fdd8",
                    "sense_definition": "Rapid, quick, and without delay.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quickness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer service representative gave a <w>snappy</w> response to my email inquiry.",
                            "target_lang_translations": {
                                "ru": "Сотрудник службы поддержки дал <w>быстрый</w> ответ на мой запрос по электронной почте."
                            }
                        },
                        {
                            "text": "We need to make this meeting <w>snappy</w> because the next group is waiting for the room.",
                            "target_lang_translations": {
                                "ru": "Нам нужно провести эту встречу <w>побыстрее</w>, потому что следующая группа уже ждет кабинет."
                            }
                        }
                    ],
                    "synonyms": [
                        "fast",
                        "immediate",
                        "quick"
                    ],
                    "antonyms": [
                        "slow",
                        "delayed"
                    ],
                    "common_phrases": [
                        "make it snappy",
                        "snappy response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый, стремительный и без задержек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстрый",
                                "target_lang_sense_clarification": "о действии, ответе"
                            },
                            {
                                "target_lang_word": "скорый",
                                "target_lang_sense_clarification": "о решении, ответе"
                            },
                            {
                                "target_lang_word": "оперативный",
                                "target_lang_sense_clarification": "своевременный и быстрый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "478f60d7-b2b2-3860-842f-c08dbb05241d",
                    "sense_definition": "Clever, catchy, and brief.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleverness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team came up with a <w>snappy</w> slogan that immediately caught everyone's attention.",
                            "target_lang_translations": {
                                "ru": "Отдел маркетинга придумал <w>броский</w> слоган, который сразу привлек всеобщее внимание."
                            }
                        },
                        {
                            "text": "Her presentation was full of <w>snappy</w> dialogue and interesting visuals.",
                            "target_lang_translations": {
                                "ru": "Ее презентация была полна <w>живых</w> диалогов и интересного визуального материала."
                            }
                        }
                    ],
                    "synonyms": [
                        "quick"
                    ],
                    "antonyms": [
                        "dull",
                        "boring"
                    ],
                    "common_phrases": [
                        "snappy slogan",
                        "snappy dialogue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остроумный, броский, запоминающийся и лаконичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "броский",
                                "target_lang_sense_clarification": "о слогане, названии"
                            },
                            {
                                "target_lang_word": "остроумный",
                                "target_lang_sense_clarification": "о диалоге, ответе"
                            },
                            {
                                "target_lang_word": "хлёсткий",
                                "target_lang_sense_clarification": "о фразе, выражении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1c797b4-4708-3261-8d46-12139e4a386b",
                    "sense_definition": "Irritable, touchy, or quick to speak in an angry way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irritability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are very <w>snappy</w> this morning; did you not sleep well last night?",
                            "target_lang_translations": {
                                "ru": "Ты сегодня утром очень <w>раздражительный</w>; плохо спал ночью?"
                            }
                        },
                        {
                            "text": "He gets <w>snappy</w> when he is under a lot of stress at work.",
                            "target_lang_translations": {
                                "ru": "Он становится <w>резким</w>, когда испытывает сильный стресс на работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "peevish",
                        "testy",
                        "tetchy"
                    ],
                    "antonyms": [
                        "patient",
                        "good-natured"
                    ],
                    "common_phrases": [
                        "get snappy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражительный, обидчивый или склонный говорить в резком, сердитом тоне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "о настроении, человеке"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "в общении"
                            },
                            {
                                "target_lang_word": "ворчливый",
                                "target_lang_sense_clarification": "склонный огрызаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4103f6f1-c95c-38b2-b814-79a72714fa02",
                    "sense_definition": "Tidy, well-dressed, and stylish in appearance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Here he is, looking <w>snappy</w> in his brand-new suit for the wedding.",
                            "target_lang_translations": {
                                "ru": "А вот и он, выглядит очень <w>щегольски</w> в своем новеньком костюме для свадьбы."
                            }
                        },
                        {
                            "text": "She always wears <w>snappy</w> outfits that make her stand out in the office.",
                            "target_lang_translations": {
                                "ru": "Она всегда носит <w>стильные</w> наряды, которые выделяют ее в офисе."
                            }
                        }
                    ],
                    "antonyms": [
                        "scruffy",
                        "untidy"
                    ],
                    "common_phrases": [
                        "looking snappy",
                        "snappy dresser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe stylish dressing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опрятный, стильный и элегантно одетый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щегольской",
                                "target_lang_sense_clarification": "об одежде, внешнем виде"
                            },
                            {
                                "target_lang_word": "стильный",
                                "target_lang_sense_clarification": "модный и опрятный"
                            },
                            {
                                "target_lang_word": "элегантный",
                                "target_lang_sense_clarification": "хорошо одетый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ea0f6db-e78b-327e-9a7a-4616916828dd",
                    "sense_definition": "Chilly, brisk, or cold in a stimulating way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn morning was cool and <w>snappy</w>, making us walk a bit faster.",
                            "target_lang_translations": {
                                "ru": "Осеннее утро было прохладным и <w>бодрящим</w>, что заставляло нас идти немного быстрее."
                            }
                        },
                        {
                            "text": "I enjoy going for a run in <w>snappy</w> weather because it feels so refreshing.",
                            "target_lang_translations": {
                                "ru": "Мне нравится бегать в <w>морозную</w> погоду, потому что это очень освежает."
                            }
                        }
                    ],
                    "synonyms": [
                        "nippy",
                        "parky"
                    ],
                    "antonyms": [
                        "warm",
                        "balmy"
                    ],
                    "common_phrases": [
                        "snappy weather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прохладный, бодрящий или морозный (о погоде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодрящий",
                                "target_lang_sense_clarification": "о прохладной погоде"
                            },
                            {
                                "target_lang_word": "прохладный",
                                "target_lang_sense_clarification": "свежий и холодный"
                            },
                            {
                                "target_lang_word": "морозный",
                                "target_lang_sense_clarification": "о воздухе, погоде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e58f0bb1-344d-3520-8503-bb69fad3bb7e",
                    "sense_definition": "Tending to snap, bite, or shut quickly with a snapping sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful around that <w>snappy</w> dog, as it might try to bite your hand.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен с этой <w>кусачей</w> собакой, она может попытаться укусить тебя за руку."
                            }
                        },
                        {
                            "text": "These spring-loaded cabinet doors are very <w>snappy</w> when you release them.",
                            "target_lang_translations": {
                                "ru": "Эти подпружиненные дверцы шкафа резко <w>захлопываются</w>, когда вы их отпускаете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snappy dog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный кусаться, захлопываться или резко закрываться со щелчком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусачий",
                                "target_lang_sense_clarification": "о животном"
                            },
                            {
                                "target_lang_word": "захлопывающийся",
                                "target_lang_sense_clarification": "о механизме, двери"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}