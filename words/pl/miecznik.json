{
    "word_family": [
        "miecz",
        "mieczowy",
        "mieczyk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d151ea0-296e-39e7-b727-bc894a24fc16",
                    "sense_definition": "Duża ryba morska z charakterystyczną górną szczęką w kształcie długiego miecza.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ryby",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas nurkowania w oceanie udało nam się zobaczyć, jak <w>miecznik</w> poluje na mniejsze ryby.",
                            "target_lang_translations": {
                                "ru": "Во время погружения в океане нам удалось увидеть, как <w>меч-рыба</w> охотится на более мелких рыб."
                            }
                        },
                        {
                            "text": "W menu restauracji pojawił się świeży <w>miecznik</w> serwowany z cytryną i ziołami.",
                            "target_lang_translations": {
                                "ru": "В меню ресторана появилась свежая <w>меч-рыба</w>, подаваемая с лимоном и травами."
                            }
                        }
                    ],
                    "synonyms": [
                        "włócznik",
                        "ryba miecz"
                    ],
                    "common_phrases": [
                        "świeży miecznik",
                        "polowanie na miecznika"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная морская рыба с характерной верхней челюстью в форме длинного меча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меч-рыба",
                                "target_lang_sense_clarification": "вид рыбы"
                            },
                            {
                                "target_lang_word": "меченос",
                                "target_lang_sense_clarification": "реже используемое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5849a7ff-736c-3c05-a93c-7d6b69b08720",
                    "sense_definition": "Rzemieślnik zajmujący się wyrobem mieczy i innej broni białej.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zawody",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doświadczony <w>miecznik</w> przez wiele dni wykuwał tę wspaniałą głownię dla rycerza.",
                            "target_lang_translations": {
                                "ru": "Опытный <w>оружейник</w> в течение многих дней выковывал этот великолепный клинок для рыцаря."
                            }
                        },
                        {
                            "text": "W dawnym mieście każdy szanowany <w>miecznik</w> miał swój własny znak warsztatowy.",
                            "target_lang_translations": {
                                "ru": "В старом городе у каждого уважаемого <w>мечника</w> было свое собственное клеймо мастерской."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warsztat miecznika",
                        "królewski miecznik"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "odnosi się do dawnych zawodów"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ремесленник, занимающийся изготовлением мечей и другого холодного оружия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оружейник",
                                "target_lang_sense_clarification": "мастер по оружию"
                            },
                            {
                                "target_lang_word": "мечник",
                                "target_lang_sense_clarification": "изготовитель мечей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27c8254c-7111-304f-891a-68f907c91fdd",
                    "sense_definition": "Urzędnik dworski w dawnej Polsce odpowiedzialny za zbrojownię władcy i noszenie przed nim miecza.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "urzędy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas uroczystej procesji koronacyjnej <w>miecznik</w> kroczył tuż przed królem.",
                            "target_lang_translations": {
                                "ru": "Во время торжественной коронационной процессии <w>мечник</w> шел прямо перед королем."
                            }
                        },
                        {
                            "text": "<w>Miecznik</w> koronny był jednym z najważniejszych dygnitarzy na dworze królewskim.",
                            "target_lang_translations": {
                                "ru": "Коронный <w>мечник</w> был одним из важнейших сановников при королевском дворе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "miecznik koronny",
                        "miecznik litewski"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historyczny urząd dworski"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придворный чиновник в старой Польше, ответственный за оружейную правителя и ношение меча перед ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мечник",
                                "target_lang_sense_clarification": "придворный чин"
                            },
                            {
                                "target_lang_word": "меченосец",
                                "target_lang_sense_clarification": "церемониальная роль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0255fbc7-eab9-3359-a1f3-b61dc31d55c2",
                    "sense_definition": "Duży ssak morski z rodziny delfinowatych, drapieżnik o czarno-białym ubarwieniu.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ssaki",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych tekstach przyrodniczych orka bywała nazywana jako <w>miecznik</w> ze względu na swoją płetwę.",
                            "target_lang_translations": {
                                "ru": "В старых естественнонаучных текстах косатку иногда называли <w>меченосцем</w> из-за её плавника."
                            }
                        },
                        {
                            "text": "Marynarze obserwowali, jak potężny <w>miecznik</w> wynurza się nad powierzchnię wody.",
                            "target_lang_translations": {
                                "ru": "Моряки наблюдали, как могучая <w>косатка</w> выныривает на поверхность воды."
                            }
                        }
                    ],
                    "synonyms": [
                        "orka"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "obecnie rzadko używane w tym znaczeniu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное морское млекопитающее семейства дельфиновых, хищник черно-белого окраса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косатка",
                                "target_lang_sense_clarification": "современное название"
                            },
                            {
                                "target_lang_word": "меченосец",
                                "target_lang_sense_clarification": "устаревшее название из-за формы плавника"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}