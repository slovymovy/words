                        "target_lang_word": "binnendringen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "binnendringen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ee1dbf74-eb3c-368d-9267-224946e1f684",
                                        "entry_id": "6f96cab4-209c-3af1-a172-814bc37a503e",
                                        "glosses": [
                                            "zich met geweld toegang verschaffen."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a56a81e-2120-47cb-9d08-3ba74c36c535",
                                                "sense_id": "ee1dbf74-eb3c-368d-9267-224946e1f684",
                                                "text": "Het was de bedoeling dat journalisten buiten op straat bleven maar de twee brutaalsten zijn toch het conferentiecentrum binnengedrongen."
                                            },
                                            {
                                                "example_id": "f6662621-e1b2-4d2e-a03f-6dcde1f468f9",
                                                "sense_id": "ee1dbf74-eb3c-368d-9267-224946e1f684",
                                                "text": "Toen hij bij haar binnendrong, sloot ze haar ogen."
                                            },
                                            {
                                                "example_id": "475490c2-12b3-4607-b85d-694e23f0ab1c",
                                                "sense_id": "ee1dbf74-eb3c-368d-9267-224946e1f684",
                                                "text": "Een monotone stem uit de verte was haar hoofd binnengedrongen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a05e39b4-d1d7-4788-b872-c6fd891f128c",
                        "source_entry_id": "3c47217d-971c-31d2-80a1-c7356cce81ce",
                        "source_sense_description": "to enter without welcome; to encroach",
                        "target_lang_word": "storen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e4307098-5abd-3c6a-844e-ed6c28fbaf91",
                                        "entry_id": "0610ab52-22d9-3d6b-87c2-2f78ea87d6a3",
                                        "glosses": [
                                            "het functioneren nadelig beïnvloeden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4b46d63-dda6-49d7-aa8e-62bc5bd4db31",
                                                "sense_id": "e4307098-5abd-3c6a-844e-ed6c28fbaf91",
                                                "text": "Alle radio-uitzendingen uit Engeland werden door de bezetter gestoord."
                                            },
                                            {
                                                "example_id": "bd54043d-d1f8-43bf-acd2-5047ae2af4dd",
                                                "sense_id": "e4307098-5abd-3c6a-844e-ed6c28fbaf91",
                                                "text": "`Ik wil mij graag verontschuldigen dat ik u bij die gewichtige opdracht heb gestoord. Ik moet leren dat mijn nieuwsgierigheid onze gasten tot last kan zijn, zoals meneer Montebello altijd zegt.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "027ea146-db58-3492-8cc2-5d30bdcf2e03",
                                        "entry_id": "0610ab52-22d9-3d6b-87c2-2f78ea87d6a3",
                                        "glosses": [
                                            "zich storen aan: zich ergeren"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e487601d-8131-4448-ae83-1fd0331c9950",
                                                "sense_id": "027ea146-db58-3492-8cc2-5d30bdcf2e03",
                                                "text": "Verder merkte ik dat mijn smaak iets scherper werd zodat ik me onmiddellijk stoorde aan de chemische smaak van het kraanwater in de stad na weken uit de rivier te hebben gedronken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "351ffb18-2d43-4800-a799-92bbcf14fb0d",
                        "source_entry_id": "3c47217d-971c-31d2-80a1-c7356cce81ce",
                        "source_sense_description": "to enter without welcome; to encroach",
                        "target_lang_word": "eindringen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindringen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c13abb02-85ac-3f6a-80f9-a598b42bd0a6",
                                        "entry_id": "7ad2d5f5-339f-3c86-bbef-2019c928e61c",
                                        "glosses": [
                                            "in etwas eintreten, hineingelangen"
                                        ],
                                        "tags": [
                                            "auch übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "091ab11f-f1d7-43dd-a5da-8dd3b575a717",
                                                "sense_id": "c13abb02-85ac-3f6a-80f9-a598b42bd0a6",
                                                "text": "Das Hochwasser dringt in den Keller ein."
                                            },
                                            {
                                                "example_id": "7e3b95d8-908d-4ac6-878b-306abe3abf93",
                                                "sense_id": "c13abb02-85ac-3f6a-80f9-a598b42bd0a6",
                                                "text": "„41 Minuten nach dem Erdbeben dringen die Wassermassen in Fukushima Daiichi ein – dem ältesten, aber leistungsstärksten der japanischen Atomkraftwerke.“"
                                            },
                                            {
                                                "example_id": "0256fa70-53ec-4061-b71f-0c3081d31bdb",
                                                "sense_id": "c13abb02-85ac-3f6a-80f9-a598b42bd0a6",
                                                "text": "Je tiefer ich in die Materie eindringe, desto komplizierter wird es."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e6f13f3-af95-3adb-9883-9872372752c5",
                                        "entry_id": "7ad2d5f5-339f-3c86-bbef-2019c928e61c",
                                        "glosses": [
                                            "einbrechen oder (manchmal gewaltsam) einfallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19b8336-aab0-45c8-b86a-257f9f1ca545",
                                                "sense_id": "6e6f13f3-af95-3adb-9883-9872372752c5",
                                                "text": "Der Feind ist in die Stadt eingedrungen."
                                            },
                                            {
                                                "example_id": "5a622fc7-f109-49d6-abf4-b5a91101037a",
                                                "sense_id": "6e6f13f3-af95-3adb-9883-9872372752c5",
                                                "text": "Zwei Verbrecher sind nachts, mit der Absicht Geld zu stehlen, in die Wohnung meines Nachbarn eingedrungen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "051e279f-3b71-3dfb-bb5a-01d07211d605",
                                        "entry_id": "7ad2d5f5-339f-3c86-bbef-2019c928e61c",
                                        "glosses": [
                                            "jemanden bedrängen, ihn mit Worten/Drohungen oder Taten/Gewalt zwingen wollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "903cf97b-295a-49d7-8305-388064493c33",
                                                "sense_id": "051e279f-3b71-3dfb-bb5a-01d07211d605",
                                                "text": "Mit flehenden Worten drang sie auf ihn ein, das Kind zurückzulassen."
                                            },
                                            {
                                                "example_id": "bfc8fa30-f1aa-4b7d-a13f-2af780c7d136",
                                                "sense_id": "051e279f-3b71-3dfb-bb5a-01d07211d605",
                                                "text": "Mit gezückten Messern drangen sie auf die Passanten ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c940c8c-2073-423a-8568-44cb9eb361de",
                        "source_entry_id": "3c47217d-971c-31d2-80a1-c7356cce81ce",
                        "source_sense_description": "to enter without welcome; to encroach",
                        "target_lang_word": "stören",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stören",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "569ee89a-56c6-37dc-bf63-d9b28598ee0d",
                                        "entry_id": "542a0a9b-f65b-31f6-96c4-cd3320b85863",
                                        "glosses": [
                                            "jemanden bei etwas belästigen, von etwas ablenken, einen Vorgang hemmen, ein Vorhaben hemmen, ärgerlicherweise aufhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20e53d2-8ff6-4c4d-831b-1fa850c3b61c",
                                                "sense_id": "569ee89a-56c6-37dc-bf63-d9b28598ee0d",
                                                "text": "Dieser Lärm stört mich bei der Arbeit."
                                            },
                                            {
                                                "example_id": "80113879-9822-417b-84b0-f1e08276b39e",
                                                "sense_id": "569ee89a-56c6-37dc-bf63-d9b28598ee0d",
                                                "text": "„Mario stört zum wiederholten Male den Unterricht.“"
                                            },
                                            {
                                                "example_id": "7f86ca5c-b91f-41e7-b8ec-9527aefa2ae4",
                                                "sense_id": "569ee89a-56c6-37dc-bf63-d9b28598ee0d",
                                                "text": "„Mario Kummer stört häufig die Unterrichtsstunden, in der Erwartung, dass seine Klassenkollegen darüber lachen und so der Unterricht massiv darunter leidet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f640b576-d1f3-357d-b1cc-e51af3378d85",
                                        "entry_id": "542a0a9b-f65b-31f6-96c4-cd3320b85863",
                                        "glosses": [
                                            "negative Auswirkungen auf etwas haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc9270a1-4c66-45e2-89b9-ed1e102b46f6",
                                                "sense_id": "f640b576-d1f3-357d-b1cc-e51af3378d85",
                                                "text": "Die Statik des Gebäudes wird durch Vibrationen gestört."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
