                ],
                "senses": [
                    {
                        "sense_id": "e21f48af-c2c5-3978-9a4d-4fb5d1474dc9",
                        "entry_id": "a9c21467-1715-3851-9f16-32e084904b3f",
                        "glosses": [
                            "fahnenförmige, drehbare Metallfigur in auf dem Dach, die die Windrichtung anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b90bbd3a-2875-454c-b5df-d914edcc6e7d",
                                "sense_id": "e21f48af-c2c5-3978-9a4d-4fb5d1474dc9",
                                "text": "„Sie bewunderten die mit roten Ziegeln gedeckten und von verspielten Wetterfahnen bekrönten steilen Satteldächer, staunten über das Kopfsteinpflaster und die Granitplatten auf den Wegen.“"
                            },
                            {
                                "example_id": "8b7c3b56-8eb1-44d4-a000-d551581b4cfc",
                                "sense_id": "e21f48af-c2c5-3978-9a4d-4fb5d1474dc9",
                                "text": "„Es stand nahe der Straße, trug eine vergoldete Wetterfahne, auf der ein galoppierendes Pferd abgebildet war, und grenzte an eine große rote Scheune.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09fddd8e-88b2-4f1f-8171-65511cd099b1",
                        "source_entry_id": "a9c21467-1715-3851-9f16-32e084904b3f",
                        "source_sense_id": "e21f48af-c2c5-3978-9a4d-4fb5d1474dc9",
                        "source_sense_description": "fahnenförmige, drehbare Metallfigur in auf dem Dach, die die Windrichtung anzeigt",
                        "target_lang_word": "weather vane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weather vane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcba05a4-cc1f-3e48-ab9d-2397e430c01c",
                                        "entry_id": "532f4531-3988-359f-a6c3-eacddf362256",
                                        "glosses": [
                                            "A mechanical device rotating around one axis and attached to an elevated object such as a roof for showing the direction of the wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072ccea3-77d5-4337-b1e1-ba51b80a89ee",
                                                "sense_id": "bcba05a4-cc1f-3e48-ab9d-2397e430c01c",
                                                "text": "From the graveyard gate one can count a dozen gayly painted farmhouses; the gilded weather-vanes on the big red barns wink at each other across the green and brown and yellow fields."
                                            },
                                            {
                                                "example_id": "6e5ac99d-43ed-43e1-b89f-aacfda1d454a",
                                                "sense_id": "bcba05a4-cc1f-3e48-ab9d-2397e430c01c",
                                                "text": "This one is surmounted by a clock-tower with a bent weather-vane - the latter being the only disorderly object in sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d323399-5f56-3062-82fd-04293486fcb8",
                                        "entry_id": "532f4531-3988-359f-a6c3-eacddf362256",
                                        "glosses": [
                                            "An indicator; something that reflects what the current situation is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b53786d6-e1cb-4e51-b985-28b1a1f10b21",
                                                "sense_id": "4d323399-5f56-3062-82fd-04293486fcb8",
                                                "text": "Since Elaine Showalter's 1985 article on the topic, Ophelia has been singled out as a role that depends for its power on the expression of female sexual desire, and, because of this, one that acts as a weather vane for attitudes towards women's sexuality."
                                            },
                                            {
                                                "example_id": "e2863bbc-379a-44bc-aef7-396aeb6adaf6",
                                                "sense_id": "4d323399-5f56-3062-82fd-04293486fcb8",
                                                "text": "Possibly though the best weather vane of the shippers' condition is the attitude of the mill trade as a whole toward present laxness in new orders."
                                            },
                                            {
                                                "example_id": "c22bf62f-03f2-47e0-b315-2435a3b7f431",
                                                "sense_id": "4d323399-5f56-3062-82fd-04293486fcb8",
                                                "text": "But since this measure involves comparing the private judgments of different sets of teachers, it is less reliable as a weather vane of achievement than the results of standardized tests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e405a1-c459-3941-8c43-333340ab0efb",
                                        "entry_id": "532f4531-3988-359f-a6c3-eacddf362256",
                                        "glosses": [
                                            "A person or organization that changes their attitude and position based on the prevailing conditions rather than displaying any conviction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39939ea9-5017-42e3-a2c8-3d86d13f01ca",
                                                "sense_id": "a3e405a1-c459-3941-8c43-333340ab0efb",
                                                "text": "The man who changes with every wind of doctrine is not a thinker but a weather vane."
                                            },
                                            {
                                                "example_id": "06c5dedd-95d3-4bdf-bfbc-688f8fc186b5",
                                                "sense_id": "a3e405a1-c459-3941-8c43-333340ab0efb",
                                                "text": "Laval was a political weather vane, perpetually mobile, but always resting on the same base, himself, the Talleyrand of Aubervilliers."
                                            },
                                            {
                                                "example_id": "5be583be-872e-41fb-8b5d-381e9150cc8c",
                                                "sense_id": "a3e405a1-c459-3941-8c43-333340ab0efb",
                                                "text": "<> repeated the federalist, appalled as always by the weather vane attitude that the Syndicate was well-known for adopting at such times, yet not letting his personal opinion transpire, <> he insisted, much to the astonishment of his interlocutor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
