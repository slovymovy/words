        "fr-extract.jsonl": [
            {
                "entry_id": "b62de9ba-61c6-345b-85fb-c35a1727db02",
                "word": "tintamarre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "760dd29a-0931-45c3-833a-59222450204d",
                        "entry_id": "b62de9ba-61c6-345b-85fb-c35a1727db02",
                        "tags": [
                            "plural"
                        ],
                        "form": "tintamarres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff557474-1824-35ba-aab7-52adf67f9a8b",
                        "entry_id": "b62de9ba-61c6-345b-85fb-c35a1727db02",
                        "glosses": [
                            "Grand bruit discordant, ensemble peu harmonieux de sons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4caf139-0105-4fed-bdff-03be6166a6a5",
                                "sense_id": "ff557474-1824-35ba-aab7-52adf67f9a8b",
                                "text": "Enfin, la pluie diminue, le vent faiblit. Je me lève, je marche, les oreilles assourdies par le tintamarre qui a cessé."
                            },
                            {
                                "example_id": "2e7558fa-60bb-41a4-9917-b6091901b30e",
                                "sense_id": "ff557474-1824-35ba-aab7-52adf67f9a8b",
                                "text": "Quel tintamarre est-ce que j’entends ?"
                            },
                            {
                                "example_id": "02e4cc33-fb1c-4e33-be3a-34b3ce8b6f38",
                                "sense_id": "ff557474-1824-35ba-aab7-52adf67f9a8b",
                                "text": "Au moment où le boulevard obliquait vers la droite, un tintamarre de bronze tomba sur nos têtes : au bord du toit – qui s’élevait à une hauteur prodigieuse – dans une sorte de petite maison qui avait un fronton triangulaire, je vis un cadran de pendule aussi grand qu’une roue de charrette."
                            },
                            {
                                "example_id": "c398b956-df68-4df0-9384-092f90b4fc57",
                                "sense_id": "ff557474-1824-35ba-aab7-52adf67f9a8b",
                                "text": "À la veille de Noël, tous les clochers d’église de Québec résonneront au même moment pour rendre hommage à tous les travailleurs qui ne comptent pas les heures travaillées pour lutter contre la pandémie. À ce tintamarre se joindront les sirènes des pompiers et des policiers de la capitale."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6cdbcd9-8e52-302c-bc29-0ff5b70416ee",
                        "entry_id": "b62de9ba-61c6-345b-85fb-c35a1727db02",
                        "glosses": [
                            "Confusion bruyante pas forcément déplaisante à entendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb91f36-a335-4f79-9c58-b267d3736479",
                                "sense_id": "e6cdbcd9-8e52-302c-bc29-0ff5b70416ee",
                                "text": "Il y avait dans les sycomores un tintamarre de fauvettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4eac546-150f-38dd-8ad3-344479614d5b",
                        "entry_id": "b62de9ba-61c6-345b-85fb-c35a1727db02",
                        "glosses": [
                            "Vive réaction d’un groupe, d’un public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ae207d-1abd-4ad2-bcba-48dc8d4591c3",
                                "sense_id": "d4eac546-150f-38dd-8ad3-344479614d5b",
                                "text": "Que de tintamarre à l’époque où le livre est sorti, et aujourd’hui, on l’a oublié !"
                            },
                            {
                                "example_id": "d0b38212-0cf8-4376-9898-576a26ec642a",
                                "sense_id": "d4eac546-150f-38dd-8ad3-344479614d5b",
                                "text": "Vous vous rappelez peut-être son premier coup de tintamarre, cette affaire assez malpropre d’un nouveau Louis XVII, qu’il essaya de lancer et qui fit de lui l’extraordinaire royaliste qu’il est resté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecce5c9d-5d1b-43af-b810-b271b3edabde",
                        "source_entry_id": "b62de9ba-61c6-345b-85fb-c35a1727db02",
