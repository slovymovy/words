                    },
                    {
                        "translation_id": "57b32228-4822-45a5-9a64-4e874677f1f2",
                        "source_entry_id": "4ac28fe2-ac5f-3c3c-8665-da7a6bd5f64c",
                        "source_sense_id": "f964dc8c-05bc-3087-b422-3a026acf462c",
                        "target_lang_word": "régime de faveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régime de faveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "592b537c-0364-3018-ae41-aab9f1dba83e",
                                        "entry_id": "590e8d81-bfd7-30c6-9f4d-f3a9806e2480",
                                        "glosses": [
                                            "Traitement privilégié, meilleur que les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "705e4daa-50af-410b-b56c-2533d0fc5d36",
                                                "sense_id": "592b537c-0364-3018-ae41-aab9f1dba83e",
                                                "text": "Des familles monoparentales, il y en a d’autres, principalement des mères divorcées, mais moi je bénéficie clairement d’un régime de faveur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
