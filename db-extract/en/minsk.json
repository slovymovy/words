                    {
                        "translation_id": "4ff7a46d-8f0b-437f-a586-fcadd5de9acd",
                        "source_entry_id": "fc707a26-067f-3d96-bb31-80c5c5f23892",
                        "source_sense_id": "9cbaa4a6-3e34-3f10-a274-621076a2f7a5",
