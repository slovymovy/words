                    {
                        "sense_id": "882fdb96-7d69-3df7-b96a-eac1bfa0ce45",
                        "entry_id": "ad1eee0f-1dcb-3542-932c-960de3c21d69",
                        "glosses": [
                            "breiter dreieckiger Knoten zum Binden einer Krawatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32969aca-1610-4130-8d2c-ea0bdfa336a0",
                                "sense_id": "882fdb96-7d69-3df7-b96a-eac1bfa0ce45",
                                "text": "„Der Monitor vor ihm sprang flackernd an und das Bild eines Manns im grauen Anzug erschien. Eine Brooks-Brothers-Krawatte mit Windsorknoten.“"
                            },
                            {
                                "example_id": "fd7bf50c-7bcf-482d-912f-8189bcc0c71f",
                                "sense_id": "882fdb96-7d69-3df7-b96a-eac1bfa0ce45",
                                "text": "„Keine Wirbel heute. Keine unbezähmbaren Verwerfungen im Windsorknoten seiner Krawatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
