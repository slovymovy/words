                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "13fc2b92-8597-3155-a65e-cf203e160bf5",
                        "entry_id": "5e1dba8e-ed7f-3258-a777-6726327610c0",
                        "glosses": [
                            "Acronym of Fair Isaac Corporation, the first corporation to introduce credit scores."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fc846e72-0853-4607-906a-5e55365c5067",
                                "sense_id": "13fc2b92-8597-3155-a65e-cf203e160bf5",
                                "text": "Fifteen hundred dollars stolen through the extortion exerted through the credit bureaus and the FICO nonsense. This is not theft by deception, this is robbery in broad daylight."
                            },
                            {
                                "example_id": "db8a25ae-1536-4197-b048-1a6ce6494713",
                                "sense_id": "13fc2b92-8597-3155-a65e-cf203e160bf5",
                                "text": "In addition to these variations of FICO Scores, each credit reporting agency also offers its own proprietary credit scoring model and makes their own credit scores available to consumers as well as creditors and lenders."
                            },
                            {
                                "example_id": "e83833c9-9bd1-414e-b7e8-8962ba14bb1c",
                                "sense_id": "13fc2b92-8597-3155-a65e-cf203e160bf5",
                                "text": "In my view then Voodoo FICO credit scoring had to go and common sense had to move back in."
                            }
                        ]
                    }
                ],
