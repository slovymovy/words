                    {
                        "sense_id": "58affe36-017b-3eda-a2e5-15b811667822",
                        "entry_id": "a20977db-c790-3a75-b359-fb41c6694b9a",
                        "glosses": [
                            "dawny francuski departament istniejący w latach 1790-1968 obejmujący Paryż i sąsiednie gminy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c957fed0-0087-468c-a805-d91d6af84381",
                                "sense_id": "58affe36-017b-3eda-a2e5-15b811667822",
                                "text": "Baron Haussmann, mianowany przez cesarza prefektem departamentu Sekwany, a tym samym i Paryża, postanowił zmieść z powierzchni miasta szczątki średniowiecznej zabudowy, a na jej cmentarzysku wznieść okazałe gmachy i pałace"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
