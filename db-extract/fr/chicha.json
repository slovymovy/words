                                "target_senses": [
                                    {
                                        "sense_id": "3f1c534c-5478-39dd-9527-c1ea6cf32376",
                                        "entry_id": "39ba14e0-1939-3d9f-99ab-d59507eb2ba2",
                                        "glosses": [
                                            "orientalische Wasserpfeife"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3cd9e5-c2f8-4750-88a2-4ecd35b9c532",
                                                "sense_id": "3f1c534c-5478-39dd-9527-c1ea6cf32376",
                                                "text": "Er rauchte gemeinsam mit seinen Freunden Schischa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49e7b9e6-155c-4f96-96b0-586624ab688a",
                        "source_entry_id": "5e8c1b4d-bc28-3538-b147-7b4c93fd921f",
                        "source_sense_id": "6aac0ca9-a9e3-3c11-9300-5f7ab62931ae",
                        "source_sense_description": "Shisha, Schischa, Wasserpfeife",
                        "target_lang_word": "Wasserpfeife",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserpfeife",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b20dedc-67bf-302a-a266-6b85960f6674",
                                        "entry_id": "b356a3f6-f90a-3763-a9cf-e95e989e8864",
                                        "glosses": [
                                            "Rauchgerät, bei dem die Rauchluft durch einen Wasserbehälter gezogen wird, bevor man ihn einatmet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b21d285-ccd3-4aee-a980-ba00ca60a410",
                                                "sense_id": "1b20dedc-67bf-302a-a266-6b85960f6674",
                                                "text": "Wasserpfeife zu rauchen ist etwas sehr geselliges und wird auch bei uns in Europa immer beliebter."
                                            },
                                            {
                                                "example_id": "d52bb013-0f14-4e5c-83a9-db605d6f01b0",
                                                "sense_id": "1b20dedc-67bf-302a-a266-6b85960f6674",
                                                "text": "„Ich hatte mir eine Wasserpfeife auf der Galata-Brücke verdient.“"
                                            },
                                            {
                                                "example_id": "2939c667-0423-46a0-bfa9-711ac03b875c",
                                                "sense_id": "1b20dedc-67bf-302a-a266-6b85960f6674",
                                                "text": "„Vor dem Hotel Abdulla – auf dem Trottoir – saßen Männer im Halbkreis, rauchten Wasserpfeifen und tranken Türkischen aus kleinen, runden Tassen.“"
                                            },
                                            {
                                                "example_id": "cf9f42e2-03d3-41a3-9a1d-0ef537f5d427",
                                                "sense_id": "1b20dedc-67bf-302a-a266-6b85960f6674",
                                                "text": "„Gegen Abend wurde es noch lebhafter in den kleinen Städtchen entlang meiner Route, die Straßencafés waren voller Menschen, die aus kleinen Tässchen Tee oder Kaffee tranken, Wasserpfeifen rauchten und plauderten.“"
                                            },
                                            {
                                                "example_id": "0f579acf-5bf0-4e45-b5c7-3645b9141bba",
                                                "sense_id": "1b20dedc-67bf-302a-a266-6b85960f6674",
                                                "text": "„So nannten die Leute damals die Wasserpfeifen Narjiledes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
