                "translations": [
                    {
                        "translation_id": "75655604-de4a-445c-9246-981caf5058a7",
                        "source_entry_id": "dee43cc4-2899-374a-90a5-54931f9ff2ff",
                        "source_sense_id": "abae8eec-a238-30ac-b155-2834f0f64c8a",
                        "target_lang_word": "shamelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shamelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                        "entry_id": "de9a2e77-1840-3068-a52f-4c25d6f5228b",
                                        "glosses": [
                                            "In a shameless manner; without shame; impudently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ea6ab8-e298-46d6-bfd6-843cbe85e780",
                                                "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                                "text": "Bradly served him a handsome allowance, and Podson was at it, even in the process of its being served. He guzzled shamelessly, pushing food into an overstuffed mouth, his eye glazed to all intrusion on a gastric debauch."
                                            },
                                            {
                                                "example_id": "f35bbc6f-683e-4088-92cb-a9bc9dc89a22",
                                                "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                                "text": "Yesterday, I shamelessly blegged people to vote for my son in a Parents magazine cutest kid contest."
                                            },
                                            {
                                                "example_id": "444befa3-2c11-4ac4-b13f-7021942cf034",
                                                "sense_id": "83e2b801-bcd5-38d3-9a7f-5180f3ace6a0",
                                                "text": "But I take the view that the statue is a cheap and cynical stunt by ministers with scant knowledge of history, whose only interest lies in greasing up to modern Indian politicians. With little or no dignity, they shamelessly prostrate themselves in the most craven way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
