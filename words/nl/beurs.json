                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "education"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежная сумма, выделяемая кому-либо для оплаты обучения или исследований.",
                        "en": "An amount of money someone receives to pay for a study or research."
