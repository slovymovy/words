                                        "glosses": [
                                            "An offensive formation in which the quarterback receives the snap at a distance behind the center, but closer than in a shotgun formation, with a running back lined up behind him."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
