        "fr-extract.jsonl": [
            {
                "entry_id": "221dcc9a-b069-3493-969e-e9757af57187",
                "word": "évapotranspiration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2606b1b8-20e9-49c6-a340-082cbd87be69",
                        "entry_id": "221dcc9a-b069-3493-969e-e9757af57187",
                        "tags": [
                            "plural"
                        ],
                        "form": "évapotranspirations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33f85c3b-7610-32fa-855b-27dfa9e8cb13",
                        "entry_id": "221dcc9a-b069-3493-969e-e9757af57187",
                        "glosses": [
                            "Processus combiné par lequel l’eau retourne dans l’atmosphère à la fois par l’évaporation à la surface du sol et par la transpiration des plantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90f6f74-24c5-4875-8075-06b1e2718bc1",
                                "sense_id": "33f85c3b-7610-32fa-855b-27dfa9e8cb13",
                                "text": "L’évapotranspiration de la culture est réduite de 25 à 50 % à l'abri des haies."
                            },
                            {
                                "example_id": "e1c0b595-1da2-4def-b48e-2f2b8bc92b62",
                                "sense_id": "33f85c3b-7610-32fa-855b-27dfa9e8cb13",
                                "text": "La quantité d'eau perdue par évapotranspiration dépend des conditions physiques au voisinage de la feuille, de la capacité du sol à fournir de l'eau et de l'état sanitaire des feuilles."
                            },
                            {
                                "example_id": "4f371cb9-92ca-49e5-a290-a98cbf305a8d",
                                "sense_id": "33f85c3b-7610-32fa-855b-27dfa9e8cb13",
                                "text": "Le présentateur nous expliquait le principe de l’évapotranspiration, un truc assez simple."
                            },
                            {
                                "example_id": "b75e6269-c3fb-442f-a736-4a6766b8ad0c",
                                "sense_id": "33f85c3b-7610-32fa-855b-27dfa9e8cb13",
                                "text": "Les flux présentent un cycle annuel où se succèdent une phase d'écoulement en direction de la nappe, et une phase ascendante quand l’évapotranspiration devient supérieure aux précipitations."
                            },
                            {
                                "example_id": "6efec43f-87e8-4639-a66f-7999e858f43f",
                                "sense_id": "33f85c3b-7610-32fa-855b-27dfa9e8cb13",
                                "text": "De plus, une strate herbacée (végétations de 0 à 50 cm de hauteur) dense et bien développée améliorera la capacité d’évapotranspiration et la rétention d’eau de la toiture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a13dfb4f-8784-4df5-9c84-b4c4889a7899",
                        "source_entry_id": "221dcc9a-b069-3493-969e-e9757af57187",
                        "source_sense_id": "33f85c3b-7610-32fa-855b-27dfa9e8cb13",
                        "target_lang_word": "evapotranspiration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evapotranspiration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "803f362e-0def-347d-bc64-56a3a20c5a46",
                                        "entry_id": "cbc8e854-1706-3bd2-aa33-5a8ddaf8083e",
                                        "glosses": [
                                            "The transfer of water from the surface of the earth to the atmosphere by evaporation, sublimation and transpiration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b24b3b-a0eb-45fb-ae6a-efba00802383",
                                                "sense_id": "803f362e-0def-347d-bc64-56a3a20c5a46",
                                                "text": "Calculated evapotranspirations are climatological values, namely the long-term average of the evapotranspirations."
                                            },
                                            {
                                                "example_id": "5b6af319-f80a-49d7-929a-e09118f7321b",
                                                "sense_id": "803f362e-0def-347d-bc64-56a3a20c5a46",
                                                "text": "In many environments, evapotranspiration makes up a larger proportion of the catchment water balance than the stream discharge. Thus, for longer periods of rainfall–runoff simulation, it will generally be necessary to estimate actual evapotranspiration losses from a catchment in order to have an adequate representation of the antecedent state of the catchment prior to each rainfall event."
                                            },
                                            {
                                                "example_id": "fdfb45f5-f70d-40f1-b884-8139d2ad1c8f",
                                                "sense_id": "803f362e-0def-347d-bc64-56a3a20c5a46",
                                                "text": "SWAP estimates that all the components of the water balance and the simulated evapotranspirations do not comprise percolation.[…]Figure 10A shows the ratios between sugarbeet evapotranspirations estimated by water balance and the SWAP-simulated evapotranspirations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
