                "senses": [
                    {
                        "sense_id": "fce45ef1-59f8-3486-b530-1d0949f57e3f",
                        "entry_id": "52d3a1be-808a-3cbb-b528-04f899c9bd95",
                        "glosses": [
                            "Werbung für Klingeltöne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554a96b6-7b8e-408e-be27-911c81e97d6f",
                                "sense_id": "fce45ef1-59f8-3486-b530-1d0949f57e3f",
                                "text": "„Ich werde weder durch Klingeltonwerbung verstört, noch dazu aufgefordert mir den neuesten Hit von Schnuffel, dem süßen Hasen auf mein Handy zu laden.“"
                            },
                            {
                                "example_id": "0e8ccf19-c648-4170-a804-a638ae91394d",
                                "sense_id": "fce45ef1-59f8-3486-b530-1d0949f57e3f",
                                "text": "„Der Musiksender MTV will ab Oktober keine Klingeltonwerbung mehr zur wichtigsten Sendezeit zwischen 16 und 24 Uhr zeigen, der Schwestersender VIVA soll im März 2006 nachziehen.“"
                            },
                            {
                                "example_id": "018f5c6c-58b4-417b-9ecd-8fe7cfa1a2ed",
                                "sense_id": "fce45ef1-59f8-3486-b530-1d0949f57e3f",
                                "text": "„Nach über zehn Jahren Pause meldet sich der verrückte Frosch aus der einst berüchtigten Klingeltonwerbung mit neuem Song zurück.“"
                            },
                            {
                                "example_id": "7bc387d3-35b7-400d-9b69-e8cd46d93ae8",
                                "sense_id": "fce45ef1-59f8-3486-b530-1d0949f57e3f",
                                "text": "„Später stand VIVA eher für nervige Klingeltonwerbung, Cartoons und untertitelte oder schlecht synchronisierte US-Shows, mehrere Kult-Formate wie «Interaktiv» oder «Club Rotation» fielen nach der Übernahme durch den US-Medienkonzern Viacom ab 2004 weg.“"
                            },
                            {
                                "example_id": "0ec66f09-3285-4c0b-b984-d075dfb72ca8",
                                "sense_id": "fce45ef1-59f8-3486-b530-1d0949f57e3f",
                                "text": "„Die Klingeltonwerbung passt aber laut \"Spiegel\" nicht in die von Sender-Chefin Catherine Mühlemann geplante Neuausrichtung der Musikkanäle, die zum US-Konzern Viacom gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
