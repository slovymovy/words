{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "0a489af3-bdde-39ab-8371-3833b17ff3b3",
                    "sense_definition": "Частица, используемая для оформления вопросительного предложения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "question_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Знаете</w> ли вы ответ на этот вопрос?",
                            "target_lang_translations": {
                                "en": "Do you know the answer to this question?"
                            }
                        },
                        {
                            "text": "<w>Хорошо</w> ли ему живется в новом городе?",
                            "target_lang_translations": {
                                "en": "Is he living well in the new city?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "знаете ли",
                        "хорошо ли"
                    ],
                    "target_lang_definitions": {
                        "en": "A particle used to form a question or introduce an interrogative clause."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whether",
                                "target_lang_sense_clarification": "Used to introduce an indirect question."
                            },
                            {
                                "target_lang_word": "if",
                                "target_lang_sense_clarification": "Used to introduce an indirect question or condition."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8431edb8-8ebc-343a-ac0f-6494f3177312",
                    "sense_definition": "Частица, выражающая сомнение или недоверие.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Я справлюсь с этой задачей за час. — <w>Ой</w> ли?",
                            "target_lang_translations": {
                                "en": "— I will finish this task in an hour. — <w>Really</w>?"
                            }
                        },
                        {
                            "text": "Он обещал вернуться, но <w>уж</w> ли он сдержит слово?",
                            "target_lang_translations": {
                                "en": "He promised to return, but <w>will</w> he really keep his word?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ой ли",
                        "уж ли"
                    ],
                    "target_lang_definitions": {
                        "en": "A particle expressing doubt, skepticism, or disbelief."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "really?",
                                "target_lang_sense_clarification": "Used to express skepticism."
                            },
                            {
                                "target_lang_word": "is that so?",
                                "target_lang_sense_clarification": "Used to challenge a statement."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a881daa2-9f8e-34d3-b69a-bf2208cc361a",
                    "sense_definition": "Частица, входящая в состав устойчивых выражений для выражения сомнения, предположения или уточнения.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <w>вряд</w> ли поможет нам в данной ситуации.",
                            "target_lang_translations": {
                                "en": "This will <w>hardly</w> help us in this situation."
                            }
                        },
                        {
                            "text": "Мы <w>едва</w> ли успеем на последний поезд сегодня.",
                            "target_lang_translations": {
                                "en": "We will <w>scarcely</w> make the last train today."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вряд ли",
                        "едва ли",
                        "чуть ли не"
                    ],
                    "target_lang_definitions": {
                        "en": "A particle used in fixed expressions to indicate doubt, estimation, or qualification."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hardly",
                                "target_lang_sense_clarification": "Used to express low probability."
                            },
                            {
                                "target_lang_word": "scarcely",
                                "target_lang_sense_clarification": "Used to express rarity or near-impossibility."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "d62f99f4-6901-3b10-be4b-4d6362955733",
                    "sense_definition": "Союз, используемый для выражения альтернативы или условия.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alternative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Неизвестно, придет он <w>ли</w> завтра на встречу.",
                            "target_lang_translations": {
                                "en": "It is unknown <w>whether</w> he will come to the meeting tomorrow."
                            }
                        },
                        {
                            "text": "Я не уверен, пойду <w>ли</w> я сегодня в кино.",
                            "target_lang_translations": {
                                "en": "I am not sure <w>if</w> I will go to the cinema today."
                            }
                        }
                    ],
                    "synonyms": [
                        "или",
                        "али",
                        "иль",
                        "аль"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction used to express an alternative or a condition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whether",
                                "target_lang_sense_clarification": "Used to introduce alternatives."
                            },
                            {
                                "target_lang_word": "if",
                                "target_lang_sense_clarification": "Used to introduce a conditional or alternative clause."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5f3843c8-ee61-34f5-a087-597a12404db6",
                    "sense_definition": "Корейская фамилия.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Известный корейский спортсмен по фамилии <w>Ли</w> выиграл золото.",
                            "target_lang_translations": {
                                "en": "A famous Korean athlete named <w>Lee</w> won gold."
                            }
                        },
                        {
                            "text": "В списке участников конференции значился господин <w>Ли</w>.",
                            "target_lang_translations": {
                                "en": "Mr. <w>Lee</w> was listed among the conference participants."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ри",
                        "И"
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "корейская фамилия"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A common Korean surname."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Lee",
                                "target_lang_sense_clarification": "Standard romanization of the Korean surname."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}