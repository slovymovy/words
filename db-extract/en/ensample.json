                "senses": [
                    {
                        "sense_id": "c35cad08-26b6-37f3-94fb-b4a45547d514",
                        "entry_id": "e25826fb-3fa5-3f2f-a02b-7dc805889e97",
                        "glosses": [
                            "пример, образец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7367c065-b5cd-4228-a3b4-1c45277dd1c0",
                                "sense_id": "c35cad08-26b6-37f3-94fb-b4a45547d514",
                                "text": "Neither as being lords over God’s heritage, but being ensamples to the flock.",
                                "translation": "и не господствуя над наследием Божиим, но подавая пример стаду;"
                            },
                            {
                                "example_id": "2e74c3ca-2ed2-4e58-bcd5-11008a5462b9",
                                "sense_id": "c35cad08-26b6-37f3-94fb-b4a45547d514",
                                "text": "So that ye were ensamples to all that believe in Macedonia and Achaia.",
                                "translation": "так что вы стали образцом для всех верующих в Македонии и Ахаии."
                            }
                        ]
                    }
                ],
