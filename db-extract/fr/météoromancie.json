                        "glosses": [
                            "Prétendue divination par les météores, et, particulièrement, par le tonnerre et les éclairs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054a517a-2288-4275-ab35-96da779c8b4d",
                                "sense_id": "9c366656-b2b1-31e5-bdf5-2e1f06a83894",
                                "text": "Ces superstitions sur les tempestaires se sont perpétuées pendant tout le Moyen Âge, et plusieurs conciles condamnèrent les personnes qui se livraient à la météoromancie et possédaient de ces bâtons sur lesquels on peut voyager dans les airs."
                            }
                        ]
                    }
