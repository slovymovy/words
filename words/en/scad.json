            "senses": [
                {
                    "sense_id": "29814afb-35a1-3621-a79d-e25199dd7772",
                    "sense_definition": "A large number or quantity of something, often used in the plural.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young entrepreneur managed to make <w>scads</w> of money after his first app became a global success.",
                            "target_lang_translations": {
                                "ru": "Молодому предпринимателю удалось заработать <w>кучу</w> денег после того, как его первое приложение стало мировым хитом."
                            }
                        },
                        {
                            "text": "I saw <w>scads</w> of people waiting in line for the new gallery opening in Berlin last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе я видел <w>целую толпу</w> людей, стоявших в очереди на открытие новой галереи в Берлине."
                            }
                        }
                    ],
                    "synonyms": [
                        "abundance",
                        "heap",
                        "load",
                        "lot",
                        "mass",
                        "pile",
                        "slew",
                        "ton"
                    ],
                    "antonyms": [
                        "bit",
                        "handful",
                        "pittance",
                        "scarcity"
                    ],
                    "common_phrases": [
                        "scads of money",
                        "scads of people",
                        "scads of time"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the plural form 'scads'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или масса чего-либо, часто используется во множественном числе."
                    },
                    "translations": {
