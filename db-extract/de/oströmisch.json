                        "glosses": [
                            "Ostrom zugehörig, Ostrom betreffend, aus Ostrom stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "795f4953-0690-4b1a-b586-34aa2868d086",
                                "sense_id": "08c421f4-fea5-3055-b0f8-e93b4a75ac5d",
                                "text": "„Der oströmische Feldherr Belisar erobert Ravenna, die Hauptstadt des italienischen Ostgotenreiches, das dem Ende geweiht ist.“"
                            },
                            {
                                "example_id": "b1d64df5-279f-419a-ba81-478ab28716ca",
                                "sense_id": "08c421f4-fea5-3055-b0f8-e93b4a75ac5d",
                                "text": "„Jedoch war laut dem oströmischen Historiker Prokop die Insel Gegenstand von Verhandlungen, die Justinians Feldherr Belisar mit dem Goten Totila führte.“"
                            }
                        ],
