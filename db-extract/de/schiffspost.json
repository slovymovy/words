                "senses": [
                    {
                        "sense_id": "c2bce0e8-46df-3b98-afd2-82563bae6263",
                        "entry_id": "d45a5af3-29d8-3a6a-a584-18528ccdfd84",
                        "glosses": [
                            "Beförderung des Postguts mit Schiffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c5a3ef-30ac-4813-aafd-d80fdd885224",
                                "sense_id": "c2bce0e8-46df-3b98-afd2-82563bae6263",
                                "text": "„Das nasse Element brachte verschiedene Beförderungsarten der Schiffspost und sogar Postbojen hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "798cfd0c-ad5b-3785-b8c3-44983b1bf949",
                        "entry_id": "d45a5af3-29d8-3a6a-a584-18528ccdfd84",
                        "glosses": [
                            "Poststelle an Bord eines Schiffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1292a3d4-c1f2-4d56-898b-0c8cbe1f13ff",
                                "sense_id": "798cfd0c-ad5b-3785-b8c3-44983b1bf949",
                                "text": "„Von den Schiffsposten abgesandte, aber nicht genügend frankierte Sendungen tragen den länglichen Stempel »Marine-Postbureau«; für M. ohne diesen Stempel darf Nachschußporto vom Empfänger nicht erhoben werden. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "57ad3932-71c4-38e1-be97-ce1a35dd99f6",
                        "entry_id": "d45a5af3-29d8-3a6a-a584-18528ccdfd84",
                        "glosses": [
                            "das mit Schiffen beförderte Postgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de7ad5d2-03d2-495f-bc93-835beba27dac",
                                "sense_id": "57ad3932-71c4-38e1-be97-ce1a35dd99f6",
                                "text": "Schiffspost ist deutlich günstiger als Luftpost, brauch dafür aber auch umso länger."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
