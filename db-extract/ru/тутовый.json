                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609f8c47-c1ea-46a7-98f8-580f7cebe735",
                                                "sense_id": "076dc192-d6af-3a6d-b6f0-bca01be096ba",
                                                "text": "Vedle pšenice stojí řepa a v žitě zemčata zrají, len vedle kukuruce roste a mezi tím morušový strom, o který se vinný keř otáčí, shrbacený stojí; jedním slovem Vlach všecko, čeho v domě k stravě mu třeba, na svém poli seje."
                                            }
                                        ]
