                        "sense_id": "dcc51129-8f53-34c9-b9f2-b17520229f6d",
                        "entry_id": "ff5a4afa-e409-3aa2-954b-c88b2fb29c30",
                        "glosses": [
                            "Arbeitseinsatz eines Raumfahrers außerhalb jedweden Raumfahrzeugs - insbesondere einer Raumstation und der US-amerikanischen Raumfähren - beziehungsweise außerhalb einer Raumkapsel im Rahmen der bemannten Mondmissionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "537b89bc-8a6b-4e90-9cf3-b8170c4b1163",
                                "sense_id": "dcc51129-8f53-34c9-b9f2-b17520229f6d",
                                "text": "Weltraumspaziergänge dienen dazu, Reparaturen oder Montagen an der Raumstation vorzunehmen."
                            },
                            {
                                "example_id": "3b164e40-9f75-4546-9d89-0bc2400a14cb",
                                "sense_id": "dcc51129-8f53-34c9-b9f2-b17520229f6d",
                                "text": "„Steve Bowen und Alvin Drew hätten bei dem sechseinhalbstündigen Weltraumspaziergang am Montag alle vorgesehenen Aufgaben erledigt, wie die US-Raumfahrtbehörde Nasa mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
