                        "sense_id": "3818c350-58ee-3a09-a7a0-3b87c6cb55c4",
                        "entry_id": "92805def-4497-3692-b81a-88d33eddf303",
                        "glosses": [
                            "Pferd, dessen Eltern einerseits Vollblut, andererseits Warmblüter sind"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06e5afe2-836e-38b8-a15f-1492ad6c14a5",
                        "entry_id": "92805def-4497-3692-b81a-88d33eddf303",
                        "glosses": [
                            "Mensch, dessen Eltern verschiedenen ethnischen Gruppen angehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4f4656c-2eb5-4e4b-a40f-30be01baa184",
                                "sense_id": "06e5afe2-836e-38b8-a15f-1492ad6c14a5",
                                "text": "„Einer von ihnen, ein häßliches und brutal aussehendes Halbblut, nahm besonders mich aufs Korn.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14b120e8-98b1-4e6a-925b-d2c4808d34fe",
                        "source_entry_id": "92805def-4497-3692-b81a-88d33eddf303",
                        "source_sense_id": "3818c350-58ee-3a09-a7a0-3b87c6cb55c4",
                        "source_sense_description": "Pferd, dessen Eltern einerseits Vollblut, andererseits Warmblüter sind",
                        "target_lang_word": "half-caste",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half-caste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e994a53f-2e6b-3ff3-bed7-ca8b806ab9ed",
                                        "entry_id": "0e995ab1-aee6-3863-a4ea-9e21b97ea2e6",
                                        "glosses": [
                                            "Of mixed racial descent."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2069248-c1ed-46a5-a42e-0dfbc3ded7b1",
                                                "sense_id": "e994a53f-2e6b-3ff3-bed7-ca8b806ab9ed",
                                                "text": "It was the racist, settler colonialism that created whiteness, that created blackness, half-caste, quarter-caste, octoroon, that saw mixed-race people as a third race."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "half-caste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67c4bc97-884d-3a54-93f5-3cc23139b316",
                                        "entry_id": "e5cc04df-e22d-3897-b4fd-c592b892031d",
                                        "glosses": [
                                            "A person of mixed racial descent."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c7f84a-dd26-44d0-a9c0-41d64d5116ff",
                                                "sense_id": "67c4bc97-884d-3a54-93f5-3cc23139b316",
                                                "text": "AO Neville, the Protector of Aborigines in Western Australia until the 1930s, railed against the risk of the creation of a ‘third race’ of half-castes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a4b2fda-a35b-4085-ba29-8b600c4eeb7c",
                        "source_entry_id": "92805def-4497-3692-b81a-88d33eddf303",
                        "source_sense_id": "3818c350-58ee-3a09-a7a0-3b87c6cb55c4",
                        "source_sense_description": "Pferd, dessen Eltern einerseits Vollblut, andererseits Warmblüter sind",
                        "target_lang_word": "demi-sang",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-sang",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c401e88c-bded-3073-a002-adfaebd9d2da",
                                        "entry_id": "f29c179b-6a12-3bf9-8dc3-ca2b840c45ee",
                                        "glosses": [
                                            "À l’origine, un cheval issu du croisement entre une race à sang chaud (pur-sang) et une race à sang froid."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f10d549-8cf0-4bb9-83ef-090db6249382",
                                                "sense_id": "c401e88c-bded-3073-a002-adfaebd9d2da",
                                                "text": "– C’est sans doute un demi-sang. On voit tout de suite qu’il a une grande sûreté dans les jambes. S’il était dressé sur l’obstacle, il ferait un très bon hunter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f520d3cc-6aff-3710-9736-7b3ee3502d92",
                                        "entry_id": "f29c179b-6a12-3bf9-8dc3-ca2b840c45ee",
                                        "glosses": [
                                            "Aujourd’hui, une race de cheval de sport (principalement allemande) qui domine les Jeux olympiques et les Jeux équestres mondiaux dans les disciplines du dressage et du saut d'obstacles."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c5d5b1e-d83c-42f2-bc6c-5e14f0e58e73",
                        "source_entry_id": "92805def-4497-3692-b81a-88d33eddf303",
                        "source_sense_id": "06e5afe2-836e-38b8-a15f-1492ad6c14a5",
                        "source_sense_description": "Mensch, dessen Eltern verschiedenen ethnischen Gruppen angehören",
                        "target_lang_word": "métis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c5a163a-f73a-3a20-8e92-83cb5b410cb7",
                                        "entry_id": "e72954dc-8d44-39b7-91a7-83c84dba5b77",
                                        "glosses": [
                                            "Qui est né de parents d’origines différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f34b3b-f1d6-4add-8ef2-e0815e119f4c",
                                                "sense_id": "9c5a163a-f73a-3a20-8e92-83cb5b410cb7",
                                                "text": "En effet, les femmes métisses qui commettent l’adultère ne sont pas poursuivies selon les lois de Castille, comme on le fait dans le cas des femmes espagnoles mariées à des Espagnols, qui se sont rendues coupables d’adultère."
                                            },
                                            {
                                                "example_id": "72b37510-eed2-48e5-9581-9d832e6de656",
                                                "sense_id": "9c5a163a-f73a-3a20-8e92-83cb5b410cb7",
                                                "text": "Bien sûr, Barack Obama est métis, fils d'un universitaire kenyan, noir d'ébène, et d'une fille du Kansas, « blanche comme le lait », comme il aime à la décrire."
                                            },
                                            {
                                                "example_id": "16c7b5dc-af1e-4439-a8e8-7af08ca6b9e1",
                                                "sense_id": "9c5a163a-f73a-3a20-8e92-83cb5b410cb7",
                                                "text": "Alors, elle constata que toutes étaient métisses : plus ou moins claires, plus ou moins foncées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94aa7bc4-ac7b-3d98-9a70-b020c88c8e33",
                                        "entry_id": "e72954dc-8d44-39b7-91a7-83c84dba5b77",
                                        "glosses": [
                                            "Qui appartient à la culture des Métis de l'Ouest canadien, peuple autochtone descendant des Européens et des Autochtones des Prairies canadiennes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ad1a490-7d0b-4fcb-906d-4292cce8605c",
                                                "sense_id": "94aa7bc4-ac7b-3d98-9a70-b020c88c8e33",
                                                "text": "Je me flattais d’être d’une jolie force, et plus résistant que la plupart des hommes. (Je venais encore de me le prouver à moi-même.) Mais que pouvais-je peser auprès d’un homme comme celui-ci, qui trouvait le moyen, malgré la charge du traîneau, de me tenir le long du chemin une conversation vive et enjouée et spirituelle, passant d’un français très pur au jargon métis (il disait : métiff), ou émaillant une anecdote pittoresque de mots crees, chippewayans, ou sauteux, habilement choisis, et juste dans la mesure qu’il fallait pour frapper l’imagination et donner un relief extraordinaire à sa pensée ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd4bb58-d0a3-3e3b-82bd-3161021f8e01",
                                        "entry_id": "e72954dc-8d44-39b7-91a7-83c84dba5b77",
                                        "glosses": [
                                            "Qui sont engendrés de deux races ou de deux variétés, en parlant de certains animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5cb4843-ef16-41fa-aa44-363683e9b037",
                                                "sense_id": "8fd4bb58-d0a3-3e3b-82bd-3161021f8e01",
                                                "text": "Les tous premiers résultats des travaux de sélection générique entrepris à la Station d'Asela et dans de petites exploitations avoisinantes ont fait l'objet de plusieurs rapports ([…]), mais aucune étude n'avait encore été entreprise sur les performances des bovins métis élevés en station et en milieu réel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a2793aa-7353-3dd6-ba59-fbd587d7fa3b",
                                        "entry_id": "e72954dc-8d44-39b7-91a7-83c84dba5b77",
                                        "glosses": [
                                            "Qui sont nés du mélange de deux formes de la même espèce, en parlant des fleurs et des fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e7d905-27db-4ded-86fd-9ed1692ead03",
                                                "sense_id": "2a2793aa-7353-3dd6-ba59-fbd587d7fa3b",
                                                "text": "Ces plantes métisses peuvent varier et présenter des caractères qui diffèrent de ceux de leurs parents, — c'est précisément le but qu'on poursuit,— mais on ne remarque jamais chez elle aucune prépondérance des organes de la végétation et de la nutrition sur les appareils floraux."
                                            },
                                            {
                                                "example_id": "2c277a77-c07c-4070-aaef-384a57ac1a94",
                                                "sense_id": "2a2793aa-7353-3dd6-ba59-fbd587d7fa3b",
                                                "text": "« Vous comprenez, disait Baillargeau, dans la vigne ce ne sont pas des espèces que nous croisons, ce sont des races, des variétés. On devrait dire des métis et non pas des hybrides, mais la coutume est de parler d’hybrides, et puis cela fait plus noble. […] Vous soutenez que le terme d’hybride est plus noble que celui de métis. D’abord il est impropre et vous en convenez puisqu’il désigne le croisement de deux espèces différentes ; ensuite il est grossier, barbare et, de plus, outrageant puisqu’il est tiré du mot grec hybris qui a le sens de viol, alors que métis vient du latin mixtus au sens exquis de ce qui est mêlé, tendrement mêlé, amoureusement mêlé. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "métis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb47e9bf-23ab-3859-95e1-40a333e65ec0",
                                        "entry_id": "84953719-f9d1-37aa-97f5-d5575b1922e6",
                                        "glosses": [
                                            "Individu né de parents d’ethnies ou de races différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9749d36d-d09f-43f3-9aa2-0e881582efe8",
                                                "sense_id": "cb47e9bf-23ab-3859-95e1-40a333e65ec0",
                                                "text": "Je suis Joshua, un métis né d'un Noir africain et d'une Blanche européenne. Je ne suis pas le seul, je le sais. Les métis, il y en a pas mal ici. Mais malgré tout, nous ne passons pas inaperçus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f15c0572-91c0-301d-801e-db0dce033366",
                                        "entry_id": "84953719-f9d1-37aa-97f5-d5575b1922e6",
                                        "glosses": [
                                            "Animal issu de croisement d'animaux d'espèces proches mais différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d61ef53-8956-4a1f-8189-40e4d5a096fc",
                                                "sense_id": "f15c0572-91c0-301d-801e-db0dce033366",
                                                "text": "Le métis du saumon femelle et de la truite mâle est d'une croissance rapide et n'est pas migrateur.\nLe métis ayant le salvelin pour mère et la truite pour père et vice versa est également d'un développement remarquable et vient dans les eaux moins profondes que celles qu'exige le premier."
                                            }
                                        ]
                                    }
