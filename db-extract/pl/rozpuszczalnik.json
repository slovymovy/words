                                                "sense_id": "f6b064ec-64aa-38c0-95a2-a700f0a55d02",
                                                "text": "Near-synonyms: above water, in the black"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df79e43-4e91-327e-ac98-54135bc6fb74",
                                        "entry_id": "dfc9e645-c39d-32c0-8b28-4bbecf2c9d2b",
                                        "glosses": [
                                            "Having the power of dissolving; causing solution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcfcc6aa-b40c-4ccf-b1ef-9eaeb2f3cd7c",
                                                "sense_id": "8df79e43-4e91-327e-ac98-54135bc6fb74",
                                                "text": "Surprisingly, this analysis revealed that acute exposure to solvent vapors at concentrations below those associated with long-term effects appears to increase the risk of a fatal automobile accident."
