                ],
                "translations": [
                    {
                        "translation_id": "e6e8b7b6-6783-41ca-872b-68f4eef77aed",
                        "source_entry_id": "e761efd7-1edb-3fec-b433-b11f5967d019",
                        "source_sense_id": "fb01e603-5b85-32de-ae44-c5653a0e5f41",
                        "source_sense_description": "word or phrase",
                        "target_lang_word": "Jiddismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jiddismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67529f7a-b0bf-361d-a6d3-3e8d5b7bd5a9",
                                        "entry_id": "ee6b4caf-e8fc-3bd8-aff9-15525ae490e3",
                                        "glosses": [
                                            "ein Wort oder sonstiger sprachlicher Ausdruck der jiddischen Sprache als Entlehnung (zum Beispiel als Fremd- oder Lehnwort) in einer anderen Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008999e5-7ed3-47f2-b9de-a28df1854df5",
                                                "sense_id": "67529f7a-b0bf-361d-a6d3-3e8d5b7bd5a9",
                                                "text": "„Wenn man darauf vertrauen darf, dass die verwendeten Wörterbücher die Standardsprache einigermaßen zuverlässig repräsentieren, haben wir es z.Zt. mit etwa 120 bis 130 mehr oder weniger geläufigen Jiddismen zu tun.“"
                                            },
                                            {
                                                "example_id": "84329214-bfaa-4788-a6a5-36a3d396e8b1",
                                                "sense_id": "67529f7a-b0bf-361d-a6d3-3e8d5b7bd5a9",
                                                "text": "„Bei der zunehmenden Verwendung von Jiddismen in der deutschen Presse, in Schlagzeilen, Kommentaren, Sportreportagen und im Feuilleton, auch in belletristischer Literatur, ist ein grundsätzlicher Funktionswandel zu beobachten…“"
                                            },
                                            {
                                                "example_id": "cf1e0ee2-6d57-4dd7-ae35-6681a16edb0a",
                                                "sense_id": "67529f7a-b0bf-361d-a6d3-3e8d5b7bd5a9",
                                                "text": "„Wie es zu dieser Einschätzung kommen konnte, wie stark der Einfluss des Jiddischen auf die deutschen Sondersprachen tatsächlich ist und welche Rolle das Rotwelsche bei der Vermittlung der vielen Jiddismen in die aktuelle Umgangssprache gespielt hat, das erläutert der Beitrag »Hebraismen in deutschen Sondersprachen«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
