                                    {
                                        "sense_id": "647b0509-bab9-329c-bf6e-dfa1da26428c",
                                        "entry_id": "2c1555ed-cf37-3345-95ff-a194047bb3d3",
                                        "glosses": [
                                            "A person who believes; especially regarding religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c43710-3a67-4416-afe5-ac06270f8809",
                                                "sense_id": "647b0509-bab9-329c-bf6e-dfa1da26428c",
                                                "text": "She's a believer in life after death."
                                            },
                                            {
                                                "example_id": "1718b159-a57b-4af2-989d-173dfc982595",
                                                "sense_id": "647b0509-bab9-329c-bf6e-dfa1da26428c",
                                                "text": "But the other two were, comparatively speaking, clean shaved, which of course gave the enemy a larger extent of open country to operate on, though in Mahomed's case the mosquitoes, recognising the taste of a true believer, would not touch him at any price."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f806266-71c7-4033-8a98-b4b8e3c0ac6d",
                        "source_entry_id": "a2d99bd2-afa7-33cb-9c74-0511355171a0",
                        "source_sense_id": "814991ec-39d4-35dc-bd1d-749613900557",
