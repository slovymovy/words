                "senses": [
                    {
                        "sense_id": "6d894501-e3b7-341c-a8c9-32bd509d9e32",
                        "entry_id": "4e60e59e-c74f-32b9-b9ed-51318678d789",
                        "glosses": [
                            "Donner un caractère ambulatoire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c632324-591d-47d1-8360-dfdba4287b19",
                                "sense_id": "6d894501-e3b7-341c-a8c9-32bd509d9e32",
                                "text": "L'objectif de ce projet est d'ambulatoriser plus de mille interventions stationnaires et donc d’économiser plus de 2'000 journées d’hospitalisation."
                            },
                            {
                                "example_id": "21816ca2-3773-40dc-aa0b-f6032912c651",
                                "sense_id": "6d894501-e3b7-341c-a8c9-32bd509d9e32",
                                "text": "Tant que les choses continuent comme cela, il sera impossible d'ambulatoriser…"
                            },
                            {
                                "example_id": "90f6b171-64f8-4d12-b40d-4fcaf4cb0e82",
                                "sense_id": "6d894501-e3b7-341c-a8c9-32bd509d9e32",
                                "text": "Il lui est répondu que lorsqu’on dispose d’une grande capacité de lits, le désir d’ambulatoriser diminue."
                            }
                        ]
                    }
