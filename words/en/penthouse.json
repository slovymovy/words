{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5405273f-6e37-3f4a-91cc-a9a7d93eb291",
                    "sense_definition": "An expensive, luxurious apartment or suite on the top floor of a tall building.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apartment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They bought a luxury <w>penthouse</w> overlooking the entire city.",
                            "target_lang_translations": {
                                "tr": "Tüm şehre tepeden bakan lüks bir <w>çatı katı</w> satın aldılar."
                            }
                        },
                        {
                            "text": "The elevator goes straight up to the private <w>penthouse</w> suite.",
                            "target_lang_translations": {
                                "tr": "Asansör doğrudan özel <w>penthouse</w> süitine çıkıyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "luxury penthouse",
                        "penthouse apartment",
                        "penthouse suite"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüksek bir binanın en üst katında bulunan lüks, pahalı daire veya süit."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çatı katı",
                                "target_lang_sense_clarification": "lüks çatı katı dairesi"
                            },
                            {
                                "target_lang_word": "penthouse",
                                "target_lang_sense_clarification": "lüks teras katı dairesi"
                            },
                            {
                                "target_lang_word": "teras katı",
                                "target_lang_sense_clarification": "teraslı en üst kat dairesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24811c31-7d5e-3605-b767-4c0888ccf90b",
                    "sense_definition": "A sloping roof or structure attached to the wall of a building, serving as a shelter or shed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took shelter under a small wooden <w>penthouse</w> attached to the barn during the storm.",
                            "target_lang_translations": {
                                "tr": "Fırtına sırasında ahıra bitişik küçük ahşap bir <w>sundurmanın</w> altına sığındı."
                            }
                        },
                        {
                            "text": "The old cottage had a low <w>penthouse</w> to protect firewood from the rain.",
                            "target_lang_translations": {
                                "tr": "Eski kulübenin, yakacak odunları yağmurdan korumak için alçak bir <w>sundurnası</w> vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "lean-to",
                        "shed",
                        "annexe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historic architectural meaning"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir binanın duvarına bitişik, barınak veya sundurma görevi gören eğimli çatı veya yapı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sundurma",
                                "target_lang_sense_clarification": "duvara bitişik eğimli çatı veya barınak"
                            },
                            {
                                "target_lang_word": "eklenti çatı",
                                "target_lang_sense_clarification": "binaya eklenen eğimli saçak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e434fa3f-687b-35c4-849b-47ebb2325c31",
                    "sense_definition": "A protective overhang, canopy, or similar sheltering structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The insect's delicate eyes were tucked safely beneath a thick <w>penthouse</w> of scales.",
                            "target_lang_translations": {
                                "tr": "Böceğin narin gözleri kalın bir pul <w>saçağının</w> altına güvenle gizlenmişti."
                            }
                        },
                        {
                            "text": "His bushy eyebrows formed a natural <w>penthouse</w> that shaded his eyes from the glare.",
                            "target_lang_translations": {
                                "tr": "Gür kaşları, gözlerini ışıltıdan koruyan doğal bir <w>gölgelik</w> oluşturuyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "awning",
                        "canopy",
                        "shelter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary and historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Koruyucu bir saçak, gölgelik veya benzeri koruyucu çıkıntı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saçak",
                                "target_lang_sense_clarification": "koruyucu çıkıntı veya örtü"
                            },
                            {
                                "target_lang_word": "gölgelik",
                                "target_lang_sense_clarification": "koruma sağlayan örtü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2abbc87c-4523-3dbc-be8a-5293a99ef466",
                    "sense_definition": "A sloping roof along the walls of a real tennis court over which the ball must be served.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tennis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server aimed to bounce the ball across the <w>penthouse</w> into the receiver's court.",
                            "target_lang_translations": {
                                "tr": "Servis atan oyuncu, topu <w>eğimli çatının</w> üzerinden sektirerek karşılayanın sahasına göndermeyi hedefledi."
                            }
                        },
                        {
                            "text": "Understanding the angles of the court's <w>penthouse</w> is essential to mastering real tennis.",
                            "target_lang_translations": {
                                "tr": "Kortun <w>eğimli çatısının</w> açılarını kavramak, kort tenisinde ustalaşmak için şarttır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Real tennis kortlarının duvarları boyunca uzanan ve servis atılırken topun üzerinden geçmesi gereken eğimli çatı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "eğimli çatı",
                                "target_lang_sense_clarification": "kort tenisi terimi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ca984c4-33d2-3d18-b8ef-376df0d61726",
                    "sense_definition": "To shelter with a sloping roof or provide with an attached shed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders decided to <w>penthouse</w> the rear entrance to shield visitors from the pouring rain.",
                            "target_lang_translations": {
                                "tr": "İnşaatçılar, ziyaretçileri sağanak yağmurdan korumak için arka girişe <w>sundurma yapmaya</w> karar verdiler."
                            }
                        },
                        {
                            "text": "They <w>penthoused</w> the open walkway using heavy wooden beams.",
                            "target_lang_translations": {
                                "tr": "Ağır ahşap kirişler kullanarak açık yürüyüş yolunun üzerini <w>sundurmayla kapattılar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shelter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare and historical use"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Eğimli bir çatı veya sundurma ile örtüp korumak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sundurmalamak",
                                "target_lang_sense_clarification": "sundurma veya saçakla örtmek"
                            },
                            {
                                "target_lang_word": "sundurma yapmak",
                                "target_lang_sense_clarification": "üzerini saçakla kapatmak"
                            }
                        ]
                    }
                }
            ]
        }
