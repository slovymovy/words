                ],
                "senses": [
                    {
                        "sense_id": "fb5926e9-36a5-35aa-91e5-91b2c38262f1",
                        "entry_id": "6325c92a-9972-32c8-8dba-f4fce579c168",
                        "glosses": [
                            "A word having the same spelling as another but a different meaning, and, often, a different pronunciation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d290e0-f8e0-4657-a7be-1f5fa76050cd",
                                "sense_id": "fb5926e9-36a5-35aa-91e5-91b2c38262f1",
                                "text": "Near-synonyms: heterophone, homograph"
                            },
                            {
                                "example_id": "d49e8210-6ab9-4be3-8e02-1755810a1723",
                                "sense_id": "fb5926e9-36a5-35aa-91e5-91b2c38262f1",
                                "text": "The word lead (/ˈlɛd/), for the metal, and lead (/ˈliːd/), for a leash, are heteronyms."
                            },
                            {
                                "example_id": "19f07e82-6b93-4146-9215-ed509356e28a",
                                "sense_id": "fb5926e9-36a5-35aa-91e5-91b2c38262f1",
                                "text": "The word agape, \"astonished\" or \"wide open,\" is a heteronym of agape, \"Christian love.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "2d6ff63a-8ac2-310b-85c1-aa71a11a6add",
                        "entry_id": "6325c92a-9972-32c8-8dba-f4fce579c168",
                        "glosses": [
                            "A fictitious character created by an author for the purpose of writing in a different style."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bd92d83-d538-4473-bc8c-a9a227b37eaa",
