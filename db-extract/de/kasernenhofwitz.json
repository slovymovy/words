                "senses": [
                    {
                        "sense_id": "8d649156-6661-3b62-96b0-2c351eb5a424",
                        "entry_id": "610fab10-f213-3222-84df-eed3f59856eb",
                        "glosses": [
                            "Art von Witz, wie er vor allem unter einfachen Soldaten kursiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710f123f-ffe6-40ad-a63d-03a7c3af72c3",
                                "sense_id": "8d649156-6661-3b62-96b0-2c351eb5a424",
                                "text": "„Zu den klassischen Kasernenhofwitzen gehören die beiden folgenden, die die Art des militärischen Denkens glossieren.“"
                            },
                            {
                                "example_id": "66776f37-4d22-4b50-ac01-bbc725c50cd5",
                                "sense_id": "8d649156-6661-3b62-96b0-2c351eb5a424",
                                "text": "„Den Witz von und über Soldaten zum Beispiel kennen wir als Landser-Witz, als Kasernenhof- oder Kasinowitz.“"
                            },
                            {
                                "example_id": "ba398d6a-87bf-473b-8b04-2a4783c70b28",
                                "sense_id": "8d649156-6661-3b62-96b0-2c351eb5a424",
                                "text": "„Seither legt der Vollblutpolizist Klarner, frech kommt weiter, alles daran, den alten Kasernenhofwitz zu widerlegen.“"
                            },
                            {
                                "example_id": "7ce2cea7-eb5d-4a50-ab67-1473ce8bc7a8",
                                "sense_id": "8d649156-6661-3b62-96b0-2c351eb5a424",
                                "text": "„Für McCain, der in seinen 114 Bürgerversammlungen in New Hampshire Sinn für Selbstironie, aber auch eine Neigung zu verletzenden Kasernenhofwitzen zeigte, geht es am 19. Februar in South Carolina um alles.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
