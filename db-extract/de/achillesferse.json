                                            {
                                                "example_id": "c5c1ee2f-cdd1-4657-a1e9-39a1fa4e07f0",
                                                "sense_id": "57b78ee7-accf-30eb-8bae-e5284c617982",
                                                "text": "A good all-round golfer, playing out of bunkers is my Achilles heel."
                                            },
                                            {
                                                "example_id": "cc06da1c-72ae-4032-a54d-28fb94252963",
                                                "sense_id": "57b78ee7-accf-30eb-8bae-e5284c617982",
                                                "text": "It might seem counter-intuitive, but getting right up in the Demoman's face is the Achillees heel to the power of his explosives."
                                            }
