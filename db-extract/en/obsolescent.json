                        "glosses": [
                            "In the process of becoming obsolete, but not obsolete yet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b79b00a3-e085-4286-b87f-c9bb5bbd6ad0",
                                "sense_id": "9ed3aad1-e280-339e-94b0-98dc872f5763",
                                "text": "How can I live among this gentle\nobsolescent breed of heroes, and not weep?"
                            }
                        ]
                    }
                ],
