                ],
                "senses": [
                    {
                        "sense_id": "906aef58-6cdb-305f-b836-b294034f0047",
                        "entry_id": "aca73dcf-d892-31b7-aab8-0bfd7a95b8d3",
                        "glosses": [
                            "Méthode de phytoremédiation qui utilise des plantes pour absorber les polluants contenus dans le sol et les concentrer dans leurs parties aériennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc19cd12-235f-4bbe-aa4e-8b565c8416b7",
                                "sense_id": "906aef58-6cdb-305f-b836-b294034f0047",
                                "text": "[…] les plantes précitées peuvent agir en […] phytoextraction : les dites feuilles sont alors fauchées puis analysées, environ tous les cinq ans, dans le cadre du processus scientifique déterminant le degré de dépollution."
                            },
                            {
                                "example_id": "ae9ed368-c343-4651-afed-809017bc40e8",
                                "sense_id": "906aef58-6cdb-305f-b836-b294034f0047",
                                "text": "La phytoremédiation est un terme général qui désigne plus spécifiquement divers procédés dits de bio-dépollution (Bert et Deram, 1999 ; ARTEB, 2006) tels que la phytoextraction, la rhizofiltration, la phytostabilisation, la phytodégradation, la rhizodégradation et la phytovolatilisation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b898c8e0-7230-4c79-b405-8cc6c94e7cf5",
                        "source_entry_id": "aca73dcf-d892-31b7-aab8-0bfd7a95b8d3",
                        "source_sense_id": "906aef58-6cdb-305f-b836-b294034f0047",
                        "target_lang_word": "Phytoextraktion",
                        "target_lang_code": "de",
