                    {
                        "translation_id": "59d09137-ca8f-42eb-bbdb-f495570744d2",
                        "source_entry_id": "d5001f60-2a1a-38de-938d-a87377821004",
                        "source_sense_id": "9183cf6a-ab9a-3071-80f0-ddddd19182ba",
