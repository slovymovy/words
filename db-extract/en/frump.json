    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ce9f4618-3dd7-320b-b087-392212376b0c",
                "word": "Frump",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "47a95c2c-c60c-3eed-af7d-05bcd7fc3a47",
                        "entry_id": "ce9f4618-3dd7-320b-b087-392212376b0c",
                        "glosses": [
                            "Nickname for Donald Trump (born 1946), president of the United States (2017–2021, 2025–present)."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d4a205c4-afc5-40ea-99cb-a0686357a92f",
                                "sense_id": "47a95c2c-c60c-3eed-af7d-05bcd7fc3a47",
                                "text": "Had he done so---Frump might have kept a FEW latino voters / As it is---FRUMP Shot his own balls off (if he has any left)"
                            },
                            {
                                "example_id": "46e9377a-ab65-4fdd-b595-5efb5e7fe352",
                                "sense_id": "47a95c2c-c60c-3eed-af7d-05bcd7fc3a47",
                                "text": "Yep, Frump refuses to say how he's going to make America great again."
                            },
                            {
                                "example_id": "b36a70db-6313-4994-b9df-796fcb060862",
                                "sense_id": "47a95c2c-c60c-3eed-af7d-05bcd7fc3a47",
                                "text": "Sorry Fido but Frump is doing what’s best for Frump and his family, for the rest of the minions he has achieved nothing so far. North Korea! It’s the US that had to make the concessions result samo samo, Frump says he wants tariffs eliminated from the EU they offer no tariffs if Frump has no tariffs no word or action from big mouth, because he knows that would be devastating in the EU’s favor."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                "word": "frump",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f13706d7-5662-4ffc-bdce-85ce5f5e5e3b",
                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                        "tags": [
                            "plural"
                        ],
                        "form": "frumps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                        "glosses": [
                            "A frumpy person, somebody who is unattractive, drab or dowdy."
                        ],
                        "tags": [
                            "colloquial",
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9beb760d-1275-4ba8-a573-4a5081c5318b",
                                "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                                "text": "You look like such a frump today!"
                            },
                            {
                                "example_id": "fe22a3a1-e32d-4430-9f11-a769459685ba",
                                "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                                "text": "Using the ideal of French female beauty as a stick with which to beat Britain's supposedly sexless frumps is a stereotype centuries old."
                            },
                            {
                                "example_id": "c69c12b0-2181-4c74-b927-170c5fe00d56",
                                "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                                "text": "If you flipped through certain magazines at this time you could be forgiven for thinking that there was no right way to be a woman, only wrong ones — bimbo or frump, slut or prude, shrew or doormat."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfb42247-5e29-39aa-8ff1-eb8ea083334f",
                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                        "glosses": [
                            "Unattractive, dowdy clothes."
                        ],
                        "tags": [
                            "colloquial",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0862ade6-1381-4309-9558-23ad852e11d3",
                                "sense_id": "dfb42247-5e29-39aa-8ff1-eb8ea083334f",
                                "text": "Get that frump off – it's horrid!"
                            }
                        ]
                    },
                    {
                        "sense_id": "92e5c0ca-78c8-3cd2-815d-a9b0d9eb8fda",
                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                        "glosses": [
                            "A bad-tempered person."
                        ],
                        "tags": [
                            "countable",
                            "dated"
                        ],
                        "examples": []
                    },
