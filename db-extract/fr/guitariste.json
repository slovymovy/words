                                        "entry_id": "29811f94-dcc3-3a85-bce1-fd6c2338c507",
                                        "glosses": [
                                            "weibliche Person, die Gitarre spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d297499-4e22-468a-b6da-412b9364cc2b",
                                                "sense_id": "ab693af1-6d6f-3223-955d-0eff187b53a1",
                                                "text": "„Nachdem die arabischen Polizisten abgerückt waren, stöpselte dann auch die Gitarrenspielerin, die von den Dudelsäcken übertönt wurde, ihr Instrument wieder an den Verstärker an.“"
                                            }
