                    {
                        "sense_id": "81f41302-65af-3977-b8ec-e9cc0d95ff0d",
                        "entry_id": "3df77b82-8731-35fb-8866-f5d7cf8ec084",
                        "glosses": [
                            "ботан. многолетнее травянистое ядовитое растение семейства паслёновых (Mandragora L.)"
                        ],
                        "tags": [],
