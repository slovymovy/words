                "senses": [
                    {
                        "sense_id": "41d54ba4-9e32-315b-b9f2-602cc08c1091",
                        "entry_id": "bb0db38b-fe72-3150-b86c-baa93849d931",
                        "glosses": [
                            "chinesische Philosophie und Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0982686f-c5c9-4eb2-ad8c-b6dd053290f2",
                                "sense_id": "41d54ba4-9e32-315b-b9f2-602cc08c1091",
                                "text": "Es gibt keine einheitliche Lehre des Daoismus."
                            },
                            {
                                "example_id": "541aeb12-d718-4aec-84f9-5119ad957964",
                                "sense_id": "41d54ba4-9e32-315b-b9f2-602cc08c1091",
                                "text": "„Neben Konfuzianismus und Buddhismus ist der Daoismus eine der ‚Drei Lehren‘, die China maßgeblich prägten.“ — (Wikipedia-Artikel „Daoismus“)"
                            },
                            {
                                "example_id": "181bee6a-fdec-4a1a-a8ce-86c81b2abe1c",
                                "sense_id": "41d54ba4-9e32-315b-b9f2-602cc08c1091",
                                "text": "„Die Bewegung war beeinflusst vom traditionellen Daoismus des Landes, entstanden im vierten Jahrhundert vor Christus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46334e69-9024-49d7-8bc0-0e6c8578551b",
