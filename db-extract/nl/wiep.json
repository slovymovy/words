                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab573145-d9ad-3526-a4b1-81591312c637",
                                        "entry_id": "d2a56e09-7c1d-3678-a34f-821b54db08f7",
                                        "glosses": [
                                            "An annoying or inconsiderate person."
                                        ],
                                        "tags": [
                                            "Canada",
