                ],
                "senses": [
                    {
                        "sense_id": "c1f35490-d8f7-3a3c-b04e-4fb245f42a39",
                        "entry_id": "f0d583c3-03bf-3559-8671-887a8fd3e0e4",
                        "glosses": [
                            "Fest des Fastenbrechens im Anschluss an den Fastenmonat Ramadan"
                        ],
                        "tags": [
                            "islamische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "e9a2fb90-60bb-4d20-9996-88a82ad3a6c7",
                                "sense_id": "c1f35490-d8f7-3a3c-b04e-4fb245f42a39",
                                "text": "„Die Familienfeier aus Anlaß des Zuckerfestes sei mittlerweile zu einer richtigen ‚Tradition‘ geworden.“"
                            },
                            {
                                "example_id": "29644496-85ae-49c2-b95b-70002ac96a82",
                                "sense_id": "c1f35490-d8f7-3a3c-b04e-4fb245f42a39",
                                "text": "„Das Zuckerfest kann, nicht in seiner religiösen, aber in seiner gesellschaftlichen Bedeutung, in etwa mit Weihnachten oder Ostern verglichen werden.“"
                            },
                            {
                                "example_id": "6a056125-bb2a-4e90-ae10-b95c1f114110",
                                "sense_id": "c1f35490-d8f7-3a3c-b04e-4fb245f42a39",
                                "text": "„‚Neue Kleider, neue Schuhe und Geldstücke‘ fallen auch Yasemin Yüksel spontan ein, wenn sie an die Zuckerfeste in der Türkei denkt.“"
                            },
                            {
                                "example_id": "518619c4-a9a5-40ea-aac5-8f325cfd7c08",
                                "sense_id": "c1f35490-d8f7-3a3c-b04e-4fb245f42a39",
                                "text": "„Außerdem hatten die Schulen mit einem hohen Anteil muslimischer Schüler die Möglichkeit, die Lernstandserhebung wegen des Zuckerfests zu verschieben.“"
                            },
                            {
                                "example_id": "f2036b8b-d210-4698-b9bf-3120a7d23939",
                                "sense_id": "c1f35490-d8f7-3a3c-b04e-4fb245f42a39",
                                "text": "„Und am Ende feiern wir drei Tage lang Bayram, das Zuckerfest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74d8cd7b-a51d-46dc-8477-a0a80d5fc9e9",
                        "source_entry_id": "f0d583c3-03bf-3559-8671-887a8fd3e0e4",
                        "source_sense_id": "c1f35490-d8f7-3a3c-b04e-4fb245f42a39",
                        "source_sense_description": "islamische Religion: Fest des Fastenbrechens im Anschluss an den Fastenmonat Ramadan",
                        "target_lang_word": "Eid al-Fitr",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eid al-Fitr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2526ffaa-19c8-3c56-b5eb-6e4716cf582e",
                                        "entry_id": "a3809a47-710b-3f66-adac-954cdddeb81a",
                                        "glosses": [
                                            "The religious celebration at the end of Ramadan, on the first day of the tenth month of the Muslim lunar calendar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ad3935-149e-4572-9e35-0cd74b3ebcef",
                                                "sense_id": "2526ffaa-19c8-3c56-b5eb-6e4716cf582e",
                                                "text": "Eid ul-Fitr is one of the main celebrations in the Islamic calendar. […] Prior to Eid ul-Fitr celebrations people give an extra donation of food or money that is distributed to needy people so that no one will be without the means to celebrate the event. This donation is called Zakat ul-Fitr."
                                            },
                                            {
                                                "example_id": "e494831b-9800-4358-84a7-40299cf2a08e",
                                                "sense_id": "2526ffaa-19c8-3c56-b5eb-6e4716cf582e",
                                                "text": "At the end of Ramadan, Muslims celebrate one of the most important Islamic holidays, Eid al-fitr. It is a one-day celebration after the last day of fasting. In the evening on the twenty-ninth day of Ramadan, we go out to see if the moon has appeared. If the moon is not seen, we fast one more day. If it is seen, the next day is Eid al-fitr. During Eid al-fitr, we visit friends and family and have people over to our houses. It is a very happy and special holiday for children."
                                            },
                                            {
                                                "example_id": "fc5539cc-0567-4b6a-980d-2d07e35de7a3",
                                                "sense_id": "2526ffaa-19c8-3c56-b5eb-6e4716cf582e",
                                                "text": "At the end of Ramadan, there is an exuberant celebration called Eid al-Fitr, the Festival of Fast-Breaking. […] Eid al-Fitr falls on the first day of Shawwal, the month that follows Ramadan in the Islamic calendar. In the morning, Muslims gather early in outdoor locations or mosques to perform the Eid prayer, which is a short congregational prayer followed by a sermon. After the sermon is finished, everyone leaves to visit family and friends. It is common to bring gifts, especially to children. The celebration can last as long as three days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
