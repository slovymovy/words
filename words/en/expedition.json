                {
                    "sense_id": "3b791982-16d7-3344-89b1-cb5cdb252087",
                    "sense_definition": "The group of people, vehicles, and equipment involved in an organized journey.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "journey_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>expedition</w> arrived safely at the base camp before sunset.",
                            "target_lang_translations": {
                                "ru": "<w>Экспедиция</w> благополучно прибыла в базовый лагерь до заката.",
                                "zh": "<w>考察队</w>在日落前安全抵达了营地。",
                                "es": "La <w>expedición</w> llegó a salvo al campamento base antes del atardecer.",
                                "tr": "<w>Ekip</w> gün batımından önce ana kampa güvenli bir şekilde ulaştı.",
                                "de": "Die <w>Expedition</w> kam vor Sonnenuntergang sicher im Basislager an."
                            }
                        },
                        {
                            "text": "Several members of the <w>expedition</w> were experienced climbers.",
                            "target_lang_translations": {
                                "ru": "Несколько участников <w>экспедиции</w> были опытными альпинистами.",
                                "zh": "<w>探险队</w>中的几名成员都是经验丰富的登山者。",
                                "es": "Varios miembros de la <w>expedición</w> eran escaladores experimentados.",
                                "tr": "<w>Ekibin</w> birkaç üyesi deneyimli dağcılardı.",
                                "de": "Mehrere Mitglieder der <w>Expedition</w> waren erfahrene Bergsteiger."
                            }
                        }
                    ],
