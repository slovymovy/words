                ],
                "senses": [
                    {
                        "sense_id": "8728f427-1021-349f-a456-246acd3758c3",
                        "entry_id": "0f95ff3e-0f9b-33d9-b2b9-abb8d4caf57d",
                        "glosses": [
                            "To look up at from below; to inspect from underneath."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4dee9cf4-dec0-4caf-95eb-1336dbe72e75",
                                "sense_id": "8728f427-1021-349f-a456-246acd3758c3",
                                "text": "They would be Shepherds and feed his Sheep, and anoint them for the Scab, and underlook them."
                            },
                            {
                                "example_id": "34183e6d-f302-429e-98de-e5adcfb36565",
                                "sense_id": "8728f427-1021-349f-a456-246acd3758c3",
                                "text": "Upon a rough table-ledge, they came to it at last; the place where they could lean in between the trees, and overlook and underlook the shining tumult [of the waterfall]."
                            },
                            {
                                "example_id": "f1f78a25-694f-48f2-b94c-552695aa8ef1",
                                "sense_id": "8728f427-1021-349f-a456-246acd3758c3",
                                "text": "[…]they would be Shepherds and feed his Sheep, and anoint them for the Scab, and underlook them, but not worry them, nor destroy them[…]"
                            },
                            {
                                "example_id": "c672a921-af88-4673-b944-94ddc445d31e",
                                "sense_id": "8728f427-1021-349f-a456-246acd3758c3",
                                "text": "On this occasion at the Mamounia in Marrakesh, we occupied a room underlooking the garden — yes, 'underlooking', for we were just below ground level in a room with a wall that sloped outwards and up to a reinforced glass ceiling."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1e466c7-1599-3519-af45-c1719b25cd1a",
                        "entry_id": "0f95ff3e-0f9b-33d9-b2b9-abb8d4caf57d",
                        "glosses": [
                            "To fail to notice or give due importance to, especially because one is notionally looking too low (found in complement with overlook, as if it meant \\\"to fail to notice because one is looking too high\\\")."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0aec88d3-0dc3-4757-81c7-e4e68bed20dd",
                                "sense_id": "b1e466c7-1599-3519-af45-c1719b25cd1a",
                                "text": "Existing review research has focused on specific terms, underlooking important developments in the area."
                            },
                            {
                                "example_id": "83665491-d3c5-4626-9798-52d3e2e726e6",
                                "sense_id": "b1e466c7-1599-3519-af45-c1719b25cd1a",
                                "text": "The CHAIRMAN. I am not overlooking anything. I am just making inquiry of you for information.\nMr. THOMSON. I know you do not overlook anything.\nThe CHAIRMAN. I am not overlooking or underlooking, but just listening to you and trying to get your viewpoint."
                            },
                            {
                                "example_id": "9a4bc8ad-ce5f-4bbc-911d-ec2248d39dc5",
                                "sense_id": "b1e466c7-1599-3519-af45-c1719b25cd1a",
                                "text": "\"Do you remember Calkin's story about the quarrel he overheard—and underlooked?\""
                            }
                        ]
                    }
