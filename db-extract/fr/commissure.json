                                "target_senses": [
                                    {
                                        "sense_id": "97e1f13a-e225-3808-bab2-1283f5c36623",
                                        "entry_id": "432954ad-4c85-3b08-8cbd-ddf1f04d8d05",
                                        "glosses": [
                                            "een lijn waarlangs twee losse stukken materiaal aan elkaar genaaid of gelast zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fee5abbd-ebc8-411a-bc26-eca238dad6d8",
                                                "sense_id": "97e1f13a-e225-3808-bab2-1283f5c36623",
                                                "text": "De naad wordt tweemaal gestikt, waarbij het eerste stiksel in de tweede naad valt."
                                            },
                                            {
                                                "example_id": "fbb59655-8fca-4b43-95a8-c687e219fa35",
                                                "sense_id": "97e1f13a-e225-3808-bab2-1283f5c36623",
                                                "text": "De naad in mijn onderbroek veroorzaakte zoveel pijn dat ik hem uittrok en die avond op het kampvuur ritueel verbrandde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fed8896-f982-3f2b-9865-4b341e335161",
                                        "entry_id": "432954ad-4c85-3b08-8cbd-ddf1f04d8d05",
