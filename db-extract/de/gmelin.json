                "senses": [
                    {
                        "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                        "entry_id": "76bc9a61-49fb-3a33-9ae6-542fd9433c18",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30a44ece-532d-42a2-abe2-7e73ba9a6462",
                                "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                                "text": "Frau Gmelin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3e8b868b-5beb-4390-9259-f214e25cae59",
                                "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                                "text": "Herr Gmelin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0e86aa2c-9312-4a7d-b8b7-3a23d97097d6",
                                "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                                "text": "Die Gmelins fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "5c0d77ef-66a8-4712-90a4-acab20b004ae",
                                "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                                "text": "Der Gmelin trägt nie die Pullover, die die Gmelin ihm strickt."
                            },
                            {
                                "example_id": "a39a91ee-15a6-4df9-9ee3-22d84f689a9f",
                                "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gmelin kommt, geht der Herr Gmelin.“"
                            },
                            {
                                "example_id": "31fc20f9-771b-495a-871d-72b77acdddf6",
                                "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                                "text": "Gmelin kommt und geht."
                            },
                            {
                                "example_id": "28a69db7-2c76-457e-8312-230eca861d8c",
                                "sense_id": "7367078f-3ce1-3605-806e-fe0e61f87f2f",
                                "text": "Gmelins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
