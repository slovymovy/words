                "senses": [
                    {
                        "sense_id": "dc0e88cc-04d3-3133-8025-84b59da3dda4",
                        "entry_id": "f16e1562-6ac1-3bff-8793-2172b013999b",
                        "glosses": [
                            "Pays ou région qui est de l’autre côté de la mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ca17a6-5161-459d-af82-cef8c9f4107a",
                                "sense_id": "dc0e88cc-04d3-3133-8025-84b59da3dda4",
                                "text": "Bon prieur Aymer, […] sachez que je ne me soucie pas des raffinements d’outre-mer, sans le secours desquels je puis très bien me récréer dans les bois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95cbcf7e-a420-45b8-afa6-8930fc660667",
                        "source_entry_id": "f16e1562-6ac1-3bff-8793-2172b013999b",
                        "source_sense_id": "dc0e88cc-04d3-3133-8025-84b59da3dda4",
                        "target_lang_word": "Übersee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übersee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                        "entry_id": "43869ae0-6217-3974-af77-7d07a9cda6b6",
                                        "glosses": [
                                            "Länder oder Gebiete jenseits eines Ozeans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "166caf84-e1ee-4e78-adc4-237a47720d39",
                                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                                "text": "Viele Auswanderer gingen nach Übersee."
                                            },
                                            {
                                                "example_id": "cf38ae8f-52af-4193-a38a-701c345a79ad",
                                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                                "text": "„Zu ihnen gehörte die zwanzigjährige Mary Anderson, die seit ihrer Verurteilung zu sieben Jahren Deportation nach Übersee im Mai 1788 in Newgate einsaß.“"
                                            },
                                            {
                                                "example_id": "68e9d649-159b-44dc-933a-a1f6cd5e8b0b",
                                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                                "text": "„Zugleich werden die Besitzungen in Übersee in steigendem Maß zur Belastung; zu groß sind die sozialen Probleme dort.“"
                                            },
                                            {
                                                "example_id": "5bc5e016-b26e-491c-b573-8bde77632fbc",
                                                "sense_id": "1d4c0cc6-eae5-37c7-825f-335c0e4e18f1",
                                                "text": "„Die Art, wie die Menschen ihr Land bewirtschafteten, war den Siedlern aus Übersee unbekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31f14f64-5dfb-419b-8750-780f2781f3cb",
                        "source_entry_id": "f16e1562-6ac1-3bff-8793-2172b013999b",
