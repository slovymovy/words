    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c8af973-508c-38e9-b690-06b9f195817a",
                    "sense_definition": "An occasion when someone sees something, especially something rare or searched for.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There will be a small prize for the first <w>sighting</w> of a seal.",
                            "target_lang_translations": {
                                "es": "Habrá un pequeño premio para el primer <w>avistamiento</w> de una foca."
                            }
                        },
                        {
                            "text": "The wildlife park reported a recent <w>sighting</w> of a rare bird in the forest.",
                            "target_lang_translations": {
                                "es": "El parque natural informó de un reciente <w>avistamiento</w> de un ave poco común en el bosque."
                            }
                        }
                    ],
                    "synonyms": [
                        "observation",
                        "glimpse"
                    ],
                    "common_phrases": [
                        "recent sighting",
                        "confirmed sighting",
                        "first sighting"
                    ],
                    "target_lang_definitions": {
                        "es": "Ocasión en la que alguien ve algo, especialmente algo poco común o que se está buscando."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "avistamiento",
                                "target_lang_sense_clarification": "acción de divisar algo poco común o buscado"
                            },
                            {
                                "target_lang_word": "avistaje",
                                "target_lang_sense_clarification": "avistamiento, usado especialmente en ciertas regiones"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "906be9a2-b88c-3e69-a6f2-84d25b308d64",
                    "sense_definition": "present participle and gerund of <w>sight</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After <w>sighting</w> the distant ship, the lookout alerted the captain immediately.",
                            "target_lang_translations": {
                                "es": "Tras <w>avistar</w> el barco a lo lejos, el vigía alertó al capitán de inmediato."
                            }
                        },
                        {
                            "text": "They spent hours <w>sighting</w> targets across the training grounds.",
                            "target_lang_translations": {
                                "es": "Pasaron horas <w>apuntando a</w> blancos a lo largo del campo de entrenamiento."
                            }
                        }
                    ],
                    "synonyms": [
                        "spotting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio presente y gerundio de 'sight': divisar, avistar o apuntar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "avistar",
                                "target_lang_sense_clarification": "divisar o ver algo a la distancia"
                            },
                            {
                                "target_lang_word": "divisar",
                                "target_lang_sense_clarification": "alcanzar a ver algo lejano"
                            },
                            {
                                "target_lang_word": "apuntar",
                                "target_lang_sense_clarification": "dirigir la vista o un arma hacia un objetivo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
