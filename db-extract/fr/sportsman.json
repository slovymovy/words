                "senses": [
                    {
                        "sense_id": "581aa5f3-a77d-3920-b838-7689de6fe692",
                        "entry_id": "2ed5ccac-c6e1-3bc5-ab82-adb2052b8a4e",
                        "glosses": [
                            "Sportif."
                        ],
                        "tags": [
                            "Anglicism",
