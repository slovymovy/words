                                        "entry_id": "6e046102-d9b3-3d92-ba17-d7f0d6a63a77",
                                        "glosses": [
                                            "hohe Konzentration von Schadstoffen in der Luft, wie sie sich über dicht besiedelten Räumen bilden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02913327-64db-4855-b1e8-d98a167a4463",
                                                "sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                                                "text": "In Städten wie Peking oder Shanghai bildet sich häufig Smog."
                                            },
                                            {
                                                "example_id": "246b1d7d-f9b2-4eec-9d87-aae94d0a80a4",
                                                "sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                                                "text": "„Ich blickte mich um und versuchte über dem blauen Smog hinter der mehrspurigen Flughafenausfahrt Straßen und Berge zu erkennen.“"
                                            },
                                            {
                                                "example_id": "dcd9ed65-4188-46d3-9f05-1fafed28c0db",
                                                "sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                                                "text": "„Ich ging zielstrebig durch den Smog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
