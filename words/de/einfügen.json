                {
                    "sense_id": "50ee1873-5fc2-3116-ae65-5b5bdd9ee443",
                    "sense_definition": "Etwas passend in ein Ganzes hineinsetzen oder an einer bestimmten Stelle platzieren, insbesondere auch in Dokumenten oder Texten.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "platzieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>fügen</w> Sie an dieser Stelle eine neue Tabelle in das Dokument <w>ein</w>."
                        },
                        {
                            "text": "Mit der Tastenkombination Strg+V kann man den kopierten Text ganz einfach <w>einfügen</w>."
                        }
                    ],
                    "synonyms": [
                        "einsetzen",
                        "einbinden"
                    ],
                    "antonyms": [
                        "entfernen",
                        "löschen"
                    ],
                    "common_phrases": [
                        "kopieren und einfügen",
                        "ein Bild einfügen",
                        "einen Absatz einfügen"
                    ]
                },
                {
                    "sense_id": "ae599862-d16d-33c1-896c-d5802e7b4f22",
                    "sense_definition": "Sich reflexiv an neue Lebensverhältnisse, eine fremde Umgebung oder eine bestehende Gemeinschaft anpassen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anpassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die neue Kollegin hat sich vom ersten Tag an hervorragend in unser Team <w>eingefügt</w>."
                        },
                        {
                            "text": "Es fiel ihm anfangs schwer, aber schließlich <w>fügte</w> er sich in die bestehende Gemeinschaft <w>ein</w>."
                        }
                    ],
                    "synonyms": [
                        "anpassen",
                        "integrieren",
                        "unterordnen"
                    ],
                    "antonyms": [
                        "anecken"
                    ],
                    "common_phrases": [
                        "sich in eine Gruppe einfügen",
                        "sich nahtlos einfügen"
                    ]
                }
            ]
        }
    ]
