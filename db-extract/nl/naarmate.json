                        "examples": [
                            {
                                "example_id": "a20216d4-1fde-49a4-9cb7-d0569561d8da",
                                "sense_id": "6c4fd562-cb0d-343d-be4b-f5a9c6686b00",
                                "text": "Hij werd steeds nerveuzer naarmate de examendag naderbij kwam."
                            },
                            {
                                "example_id": "60a33074-a9a1-444a-8e10-6d6bd5346794",
                                "sense_id": "6c4fd562-cb0d-343d-be4b-f5a9c6686b00",
                                "text": "Toch was het soms lastig om relaxt te blijven en naarmate de werkstress terugkeerde kreeg ik het er steeds moeilijker mee."
                            },
                            {
                                "example_id": "c20b6ea3-b9ab-47bf-bc82-0b7bf2d77233",
                                "sense_id": "6c4fd562-cb0d-343d-be4b-f5a9c6686b00",
                                "text": "\"Je kunt kinderen vertellen hoe reclame werkt, maar voor jonge kinderen is dat lastig om te begrijpen. Dat begrip groeit naarmate ze ouder worden, vooral als dat ze wordt geleerd. Maar dat wil niet zeggen dat ze ernaar handelen.\""
                            },
                            {
                                "example_id": "cde285a1-f59c-4a0a-9b2a-4e53b8c9d3b5",
                                "sense_id": "6c4fd562-cb0d-343d-be4b-f5a9c6686b00",
                                "text": "Die roodverschuiving :is vergelijkbaar met het bekende dopplereffect bij geluid: de sirene van een ambulance klinkt lager naarmate hij zich sneller van ons verwijdert."
                            }
                        ]
                    }
