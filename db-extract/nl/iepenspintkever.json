                "senses": [
                    {
                        "sense_id": "578c9109-b307-3714-b321-43282b364c7a",
                        "entry_id": "09bb85b6-1446-3ff5-ae74-020d18eadf7a",
                        "glosses": [
                            "bepaald soort tor, Scolytus scolytus, die een belangrijke rol speelt in de verspreiding van iepziekte"
                        ],
                        "tags": [
                            "kevers"
                        ],
                        "examples": [
                            {
                                "example_id": "73159232-4e0a-44c6-ba94-618386b57cc0",
                                "sense_id": "578c9109-b307-3714-b321-43282b364c7a",
                                "text": "De hoge uitval komt waarschijnlijk door het zachte najaar van 2009. Hierdoor is de iepenspintkever nog lang actief geweest en heeft de iepziekteschimmel zich langer kunnen verspreiden. Een late besmetting van iepen maakt dat de voorjaarsprik tegen de iepziekte te laat komt, met meer zieke iepen als gevolg."
                            },
                            {
                                "example_id": "438949b6-893e-458b-97e0-7ed6966c2511",
                                "sense_id": "578c9109-b307-3714-b321-43282b364c7a",
                                "text": "Sporen van de iepenspintkever onder de bast van een iep. De kever geldt als een van de voornaamste verspreiders van de schimmel."
                            },
                            {
                                "example_id": "c0a1f5ce-7666-42c1-87a6-0ff9156ec0d0",
                                "sense_id": "578c9109-b307-3714-b321-43282b364c7a",
                                "text": "De schimmel die de iepziekte veroorzaakt, wordt overgebracht door de iepenspintkevers. De kever zet haar eitjes af in een verzwakte of dode boom of ander iepenhout waar de bast nog omheen zit. Gezonde bomen worden dus met rust gelaten, maar kunnen worden besmet als een boom in de omgeving wordt aangetast, bijvoorbeeld doordat de wortels contact maken."
                            }
                        ]
                    }
