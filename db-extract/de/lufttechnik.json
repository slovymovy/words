                "senses": [
                    {
                        "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                        "entry_id": "477f3a6d-e9f9-3675-9067-63bf42cb0d84",
                        "glosses": [
                            "Behandlung und Versorgung bestimmter Bereiche mit Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ffb644-5c49-4a42-89ee-dd4f5c52d15d",
                                "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                                "text": "„Nachhaltigkeitsthemen wie Arbeitsschutz, Maschinensicherheit und Umweltschutz spielen in den Anwendungsfeldern der Lufttechnik eine besonders große Rolle.“"
                            },
                            {
                                "example_id": "976d56b5-638a-4887-847f-45817749217b",
                                "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                                "text": "„Der Begriff „Lufttechnik” sowie die weitere Untergliederung sind in der DIN 1946/Teil 1 dargestellt. Zwei grundsätzliche Richtungen werden mit den Begriffen Raumlufttechnik und Prozesslufttechnik unterschieden.“"
                            },
                            {
                                "example_id": "43f6a979-ac88-41fd-8e6f-77a344c1d056",
                                "sense_id": "6f0bb671-66f7-3592-be2c-4f5a7e7b4001",
                                "text": "„Die Lufttechnik ist ein fester Bestandteil moderner Fertigungsstätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
