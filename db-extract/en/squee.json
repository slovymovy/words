                    {
                        "sense_id": "5b143944-9b71-35f1-8387-6a7468771ae6",
                        "entry_id": "f74a7a2a-e9dd-326a-b623-d1b27cf5e388",
                        "glosses": [
                            "A squeal of excitement or delight."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d6f2a11d-5ba7-400c-aa56-83b29fab466f",
                                "sense_id": "5b143944-9b71-35f1-8387-6a7468771ae6",
                                "text": "The new console will certainly have more powerful graphics, processor, hard drive and all those specs that really only nerdy writers for technology websites care about: “Ermahgerd, moar polygons! More frame rate! Squee!”"
                            }
                        ]
                    }
                ],
