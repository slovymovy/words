            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b1485fc-7629-377e-9dc8-5320cb938345",
                    "sense_definition": "A retail employee who packs customers' purchases into bags and sometimes carries them to their vehicles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grocery_store_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The friendly <w>bagger</w> at the supermarket carefully packed the eggs on top of the bread.",
                            "target_lang_translations": {
                                "ru": "Дружелюбный <w>упаковщик</w> в супермаркете аккуратно положил яйца поверх хлеба."
                            }
                        },
                        {
                            "text": "He started his career as a grocery <w>bagger</w> before working his way up to store manager.",
                            "target_lang_translations": {
                                "ru": "Он начал свою карьеру как <w>упаковщик пакетов</w> в продуктовом магазине, прежде чем дослужился до директора."
                            }
                        }
                    ],
                    "synonyms": [
                        "courtesy clerk",
                        "sacker"
                    ],
                    "common_phrases": [
                        "grocery bagger",
                        "supermarket bagger"
                    ],
                    "target_lang_definitions": {
