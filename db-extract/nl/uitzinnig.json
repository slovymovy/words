                ],
                "senses": [
                    {
                        "sense_id": "6112adac-de45-371e-807c-ca744ebdbe11",
                        "entry_id": "b16f25a6-b01d-37be-b9b5-3f70a0ce8b01",
                        "glosses": [
                            "heel emotioneel zijn zodat je niet meer goed kunt denken en waarnemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3470f66-c5cb-483b-a84e-59fe344c7cf5",
                                "sense_id": "6112adac-de45-371e-807c-ca744ebdbe11",
                                "text": "Hij was uitzinnig van vreugde toen hij de gouden medaille won op de Olympische Spelen."
                            },
                            {
                                "example_id": "61150f6a-1552-4092-8fd8-c21d29884208",
                                "sense_id": "6112adac-de45-371e-807c-ca744ebdbe11",
                                "text": "De vreugde op de Nederlandse bank was uitzinnig. Waar iedereen sprong, bleef coach Ilse DeLange met de handen voor haar ogen zitten. Ongeloof won het nog van de vreugde. Laurence was al snel weer bij zijn positieven en nam de trofee in ontvangst met de woorden: ‘To Music first. Always.’"
                            },
                            {
                                "example_id": "70d1ead7-06da-4fe5-a9f1-267299ab5039",
                                "sense_id": "6112adac-de45-371e-807c-ca744ebdbe11",
                                "text": "Burgemeester Ron König zegt \"buitengewoon trots\" te zijn op het team. \"Go Ahead Eagles heeft echt voetbal laten zien zoals het hoort te zijn\", vindt hij. \"Heel Deventer is uitzinnig van blijdschap en terecht! We gaan woensdag het elftal groots onthalen en huldigen.\""
                            }
                        ]
                    }
                ],
