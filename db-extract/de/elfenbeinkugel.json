                ],
                "senses": [
                    {
                        "sense_id": "f6a7a7f1-c699-32a5-a8bb-4a8120636dff",
                        "entry_id": "6b006da2-bbf3-3db2-b340-1f7c856e1aad",
                        "glosses": [
                            "Kugel aus Elfenbein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0e0749-d685-4bde-977f-364aef981951",
                                "sense_id": "f6a7a7f1-c699-32a5-a8bb-4a8120636dff",
                                "text": "„Es liegt in der Natur begründet, daß Fortuna mit einem Menschen, der sich ihren Launen überläßt, das gleiche tut, wie ein kleines Kind mit einer Elfenbeinkugel auf einem Billardtisch.“"
                            },
                            {
                                "example_id": "381c4bd6-4ccb-43c4-ae4d-2eeaed0d404b",
                                "sense_id": "f6a7a7f1-c699-32a5-a8bb-4a8120636dff",
                                "text": "„Ihm schien es ganz selbstverständlich, dass das Spiel jedes Mal von neuem begann, sobald der Croupier die Elfenbeinkugel mit der rechten Hand aufnahm, das Roulett mit einem leisen Stoß der gleichen Hand gegen eine der vier Speichen im Uhrzeigersinn in Bewegung setzte und mit einer dritten Bewegung der rechten Hand die Kugel gegen den Uhrzeigersinn und damit gegen die Bewegung des Rouletts auf den Außenrand der Scheibe warf.“"
                            },
                            {
                                "example_id": "2649a34d-e826-4b15-8468-a088c6a49d6e",
                                "sense_id": "f6a7a7f1-c699-32a5-a8bb-4a8120636dff",
                                "text": "„Mit einem Billardstock und zwei Elfenbeinkugeln wollte er Kunststücke vorführen, wie sie Barberou, einer seiner Freunde, machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
