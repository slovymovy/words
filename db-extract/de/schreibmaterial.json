                "senses": [
                    {
                        "sense_id": "dad349c8-53ca-3866-9f8f-314d9621e79a",
                        "entry_id": "75a9036f-b2af-3a7d-8396-8d47a780e96e",
                        "glosses": [
                            "Material, das beschrieben werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6396cb07-e3cd-4ad0-a1f5-270e7fa81332",
                                "sense_id": "dad349c8-53ca-3866-9f8f-314d9621e79a",
                                "text": "„Das bei weitem häufigste Schreibmaterial war Ton, das Schreibwerkzeug ein zugespitzter Rohr- oder (Holz-)Griffel, der die charakteristische schlanke Dreiecksform der einzelnen Keile bewirkte.“"
                            },
                            {
                                "example_id": "4f61ed90-d587-428e-815f-c10c613d7008",
                                "sense_id": "dad349c8-53ca-3866-9f8f-314d9621e79a",
                                "text": "„Aus dem mehrere Meter hohen, dreikantigen Stengel erzeugt man in verschiedenen Verarbeitungsschritten das bekannte ägyptische Schreibmaterial, von dem auch unser Papier seinen Namen hat.“"
                            }
                        ],
