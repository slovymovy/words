                "senses": [
                    {
                        "sense_id": "a2e5fd8b-e1c9-3622-b36f-168cd76bcd27",
                        "entry_id": "95fc6d76-46b9-3abf-94d0-f9a7cd2e799f",
                        "glosses": [
                            "To establish a hierarchy."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "93da498f-1e9c-4f86-ab6e-ae36f1a16a73",
                                "sense_id": "a2e5fd8b-e1c9-3622-b36f-168cd76bcd27",
                                "text": "It operates not by differentiating individuals, but by specifying acts according to a number of general categories; not by hierarchizing but quite simply by bringing into play the binary opposition of the permitted and the forbidden."
                            }
                        ]
                    },
                    {
                        "sense_id": "96cec949-8080-3e5b-bbd9-a9fcce77ad59",
                        "entry_id": "95fc6d76-46b9-3abf-94d0-f9a7cd2e799f",
                        "glosses": [
                            "To arrange in a hierarchy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8eabbc24-6d90-4b2e-9926-253171b5ca3a",
                                "sense_id": "96cec949-8080-3e5b-bbd9-a9fcce77ad59",
                                "text": "The state hierarchizes sexuality by defining homosexuality as an influence that corrupts minors. Such a discourse produces a notion of the correct sexual behavior that transcends into the political realm, reinforcing the heteronationalistic nature of the nation-building."
                            }
                        ]
                    }
                ],
