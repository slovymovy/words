                ],
                "senses": [
                    {
                        "sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
                        "entry_id": "089ec5af-060a-301d-904f-dd4e2ee2c986",
                        "glosses": [
                            "een grote omvang hebbende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca8b0ad-7b7d-4733-9e38-329dc92d9cbf",
                                "sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
                                "text": "Het geheim van een goede zeilracer zit in de combinatie van een licht gewicht, een perfect onderwaterschip met mooi ballastaandeel en perfecte tuigage. Voor een comfortabele cruiser is een volumineus interieur en gemakkelijke ‘handling’ nodig. Het is X-Yachts gelukt beide vereisten in de X4 naar tevredenheid van alle testzeilers te combineren."
                            },
                            {
                                "example_id": "a0dd0cd9-20c2-40d1-b244-bc492426fbe1",
                                "sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
                                "text": "Breng voordat je een hoed opzet, eerst je haar in model. Zo is het aan te raden om op je haarwortels wat haarspray te verdelen en vervolgens met je hoofd ondersteboven je haardos te föhnen. Op die manier zorg je voor een volumineus kapsel."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a0f534e-7e9c-32f4-b264-fa170c549d5a",
                        "entry_id": "089ec5af-060a-301d-904f-dd4e2ee2c986",
                        "glosses": [
                            "zeer dik zijn"
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "13eecd61-bc01-4dc1-b9f5-5a14a1852868",
                                "sense_id": "0a0f534e-7e9c-32f4-b264-fa170c549d5a",
                                "text": "Deze mensen zijn zo volumineus dat zij nauwelijks in staat zijn hun leven gaande te houden. Dientengevolge komt er een legioen aan hulpverleners (waaronder ik) bij deze mensen over de vloer om hun huishouden enigszins op orde te houden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e3ec030-2fe9-4175-88fa-60ca1bd718cb",
                        "source_entry_id": "089ec5af-060a-301d-904f-dd4e2ee2c986",
                        "source_sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
                        "target_lang_word": "voluminous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voluminous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "018f5fe2-febf-3f6e-9eb8-596a9ad7a970",
                                        "entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                                        "glosses": [
                                            "Of or pertaining to volume or volumes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88ed84c1-231f-363b-aa6d-22083d5670b4",
                                        "entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                                        "glosses": [
                                            "Consisting of many folds, coils, or convolutions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a581c084-f82c-410b-955a-6af3e3aca952",
                                                "sense_id": "88ed84c1-231f-363b-aa6d-22083d5670b4",
                                                "text": "I remember that the Baroness was clad in a voluminous silk dress, pale grey in colour, and adorned with flounces and a crinoline and train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c2296d6-9ac4-312b-adae-63dc996ff62f",
                                        "entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                                        "glosses": [
                                            "Of great volume, or bulk; large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45666ec3-d0fd-4e0d-b4b0-ad4023d3ffe8",
                                                "sense_id": "2c2296d6-9ac4-312b-adae-63dc996ff62f",
                                                "text": "Matters of a much more extraordinary kind are to be the subject of this history, or I should grossly mis-spend my time in writing so voluminous a work […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50f85f0b-75c0-3fe2-8c93-a3eba52cc99e",
                                        "entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                                        "glosses": [
                                            "Having written much, or produced many volumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78811ff-ad68-4edb-b518-87aa226681d6",
                                                "sense_id": "50f85f0b-75c0-3fe2-8c93-a3eba52cc99e",
                                                "text": "a voluminous writer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be16735d-9059-44f6-8e07-7a2be17a0f11",
                        "source_entry_id": "089ec5af-060a-301d-904f-dd4e2ee2c986",
