                            {
                                "example_id": "dc1a8014-ec91-446e-8dd0-0639a05a8ec9",
                                "sense_id": "acde426a-fba7-3c88-abf0-f5db50b82795",
                                "text": "\"We hebben verrassende dingen geleerd over Iqbal en we hebben nog steeds niet antwoorden op alle vragen\", aldus de leider van het onderzoek. \"Is er een familiegeheim dat we nog niet hebben gevonden? En gaat het dan over Saad al-Hilli of zijn vrouw Iqbal?\""
                            },
                            {
                                "example_id": "65076948-98ee-41d6-96b4-89e27da0e261",
                                "sense_id": "acde426a-fba7-3c88-abf0-f5db50b82795",
                                "text": "Volgens Godelieve Kessels is de tijd nu pas rijp om dit familiegeheim te onthullen."
                            }
                        ]
                    }
