                                        "examples": [
                                            {
                                                "example_id": "04b1f0c0-bdec-440d-a809-50c5cc561767",
                                                "sense_id": "16e3c6c6-bbfd-300c-96a5-0e0f5bd90f1a",
                                                "text": "His tufted cottage rising through the snow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd58b59-c04c-378d-bc31-235f9a2a42f4",
                                        "entry_id": "501fee78-6256-3db5-8327-62ec95615eff",
                                        "glosses": [
                                            "To form into tufts."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3479a2a9-8eef-3974-b874-f525740db169",
                                        "entry_id": "501fee78-6256-3db5-8327-62ec95615eff",
                                        "glosses": [
                                            "To secure and strengthen (a mattress, quilt, etc.) with tufts. This hinders the stuffing from moving."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e79ae17-e8e4-4a43-bc17-d7d4eb8cf2fb",
                                                "sense_id": "3479a2a9-8eef-3974-b874-f525740db169",
                                                "text": "They're never gonna get that Ottoman tufted in time!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47516777-104b-3d11-aa8f-9750c8522567",
