                    {
                        "sense_id": "cb333a88-ec54-32dd-a167-3fb234671811",
                        "entry_id": "85ee1493-a3ee-3dc5-9599-269168009648",
                        "glosses": [
                            "knop waar je op moet drukken om te kunnen bellen met een mobiele telefoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d1b0fae-e1db-47d9-ad9e-1bfdb6613ec5",
                                "sense_id": "cb333a88-ec54-32dd-a167-3fb234671811",
                                "text": "Whatsapp test de belfunctie al geruime tijd. Zo verscheen de belknop al eerder korte tijd in de app, om snel weer te verdwijnen. De belfunctie kon tot nu toe alleen getest worden op uitnodiging."
                            },
                            {
                                "example_id": "6b74275b-022e-4086-ad5b-7672b51716a8",
                                "sense_id": "cb333a88-ec54-32dd-a167-3fb234671811",
                                "text": "Het achterhalen van het IMEI nummer van je telefoon werkt niet op alle apparaten hetzelfde. In veel gevallen kun je het nummer zien door *#06# in te toetsen, zonder op de belknop te drukken."
                            }
                        ]
                    }
