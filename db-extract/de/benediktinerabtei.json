                "senses": [
                    {
                        "sense_id": "1d9a0e5a-df4d-3ac7-9463-79ecdaff6d34",
                        "entry_id": "3a77836d-fdbc-38aa-bc99-76da9d70dc5f",
                        "glosses": [
                            "Abtei der Benediktiner; Kloster der Benediktiner mit einem Abt als Vorsteher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a7d710a-11fe-4329-bf2d-c6a74ce8d664",
                                "sense_id": "1d9a0e5a-df4d-3ac7-9463-79ecdaff6d34",
                                "text": "„Weitere Informationen stehen aus der Benediktinerabtei Michaelsberg (Siegburg) zur Verfügung.“"
                            },
                            {
                                "example_id": "39ea01c0-668e-4431-9ee5-de7cd851fb92",
                                "sense_id": "1d9a0e5a-df4d-3ac7-9463-79ecdaff6d34",
                                "text": "„Er war zu dem Schluss gekommen, dass die Karte wegen der karolingischen Minuskelschrift darauf aus einem süddeutschen Skriptorium stammen musste, vielleicht dem des Klosters auf der Insel Reichenau im Bodensee, einer Benediktinerabtei, die für ihre Buchmalerei bekannt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
