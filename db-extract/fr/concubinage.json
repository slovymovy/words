                                    {
                                        "sense_id": "eda58afa-1001-349f-81d8-8807f7651e15",
                                        "entry_id": "183e3c02-8fd2-3b92-b209-5a6afab91ac5",
                                        "glosses": [
                                            "związek dwóch osób, podobny do małżeństwa, ale nieformalny z powodu braku rejestracji cywilnej bądź religijnego usankcjonowania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e650ecf-2bdd-41ac-862c-88d2803b30b8",
                                                "sense_id": "eda58afa-1001-349f-81d8-8807f7651e15",
                                                "text": "We Włoszech od lat dyskutuje się nad problemem związków nieformalnych — bez usankcjonowania cywilnego bądź religijnego — i w dyskusji społecznej słowo konkubinat zostało zastąpione przez inne określenia takie, jak „partnerzy”, „towarzysze życia”, „wolny związek”, „związek partnerski”, „związek cywilny”. W Polsce słowo konkubinat ma nadal zabarwienie pejoratywne"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
