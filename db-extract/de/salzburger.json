                "senses": [
                    {
                        "sense_id": "bd05ecec-7b6a-35a2-ac76-ae181d60b7f6",
                        "entry_id": "d808315e-0656-304e-8dc0-1cf205dd456a",
                        "glosses": [
                            "zu Salzburg, sich auf Salzburg beziehend, in der Art und Weise von Salzburg, aus Salzburg kommend, stammend, Salzburg betreffend, zu Salzburg gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e53db9-3a03-47da-a5ba-49991eee0b0d",
                                "sense_id": "bd05ecec-7b6a-35a2-ac76-ae181d60b7f6",
                                "text": "Die Salzburger Landeshymne beginnt mit den Worten: „Land unsrer Väter, lass' jubelnd dich grüßen“."
                            },
                            {
                                "example_id": "b22deb4f-f6b3-41f5-8e7b-f7c0baa93d56",
                                "sense_id": "bd05ecec-7b6a-35a2-ac76-ae181d60b7f6",
                                "text": "„Er vermaß jeden Salzburger Hügel, er stellte täglich den Luftdruck fest, er kartographierte das magnetische Feld, prüfte Luft, Wasser, Erde und Himmelsfarbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
