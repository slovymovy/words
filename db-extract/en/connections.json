                                            {
                                                "example_id": "4e0d2ff6-411f-457c-b420-94cceed296d7",
                                                "sense_id": "507da048-ad40-3d09-a7fc-2b88ba8a9e5b",
                                                "text": "t'as vu sa bucque? Elle est vraiment piston, cra Zaloeil!"
                                            }
