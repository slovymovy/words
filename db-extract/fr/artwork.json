                                    {
                                        "sense_id": "526b2ba9-e85f-3be6-be0e-1e3047745de4",
                                        "entry_id": "9d8d7fe8-aa14-3299-81f2-91c4b049a796",
                                        "glosses": [
                                            "A painting, drawing, sculpture or other piece of creative, visual art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3e85f9-791d-4a00-a181-b4cc1ad9d41d",
                                                "sense_id": "526b2ba9-e85f-3be6-be0e-1e3047745de4",
                                                "text": "A myriad of Hellenic artworks reflects the perceptions of the citizens of Ancient Greece."
                                            },
                                            {
                                                "example_id": "62c849be-ebab-4204-9454-af73bbc0c8bb",
                                                "sense_id": "526b2ba9-e85f-3be6-be0e-1e3047745de4",
                                                "text": "The most distinctive physical attribute of the space is the bright red metal sculpture that resembles one of Claes Oldenburg's oversized clothespins, only slightly deconstructed. The artwork may be enjoyed on its own terms, but ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a98558-bd60-332d-af51-8b6792e1108f",
                                        "entry_id": "9d8d7fe8-aa14-3299-81f2-91c4b049a796",
                                        "glosses": [
                                            "Artistic work."
                                        ],
                                        "tags": [
