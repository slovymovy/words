                    {
                        "sense_id": "2b6b9d13-d591-376b-ae51-3a329ab2036b",
                        "entry_id": "e36f1113-c90e-398d-a772-73db8f7780d3",
                        "glosses": [
                            "Qui contient plusieurs couches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46966ab-2334-4b68-b974-c55e43140a44",
                                "sense_id": "2b6b9d13-d591-376b-ae51-3a329ab2036b",
                                "text": "Cet organe est situé dans le larynx et présente une structure multicouche constituée de fibres musculaires, d’un tissu conjonctif sous-muqueux et d’un épithélium."
                            },
                            {
                                "example_id": "3852e771-b36f-43c4-b62f-4dd649499f03",
                                "sense_id": "2b6b9d13-d591-376b-ae51-3a329ab2036b",
                                "text": "Laine ou taffetas, le rideau est magique, illusionniste et multicouches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a07c2cb-7ace-4c87-b516-f99b9dd8ecd2",
