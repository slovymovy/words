                        "examples": [
                            {
                                "example_id": "f4a0be15-90e4-4f17-9c2a-f076a6389c52",
                                "sense_id": "11830f36-4257-35a4-ac00-45d589434937",
                                "text": "„Sie stammte aus einer Familie, die seit Generationen in Chadera lebte, und wurde später eine berühmte Sopranistin.“"
                            },
                            {
                                "example_id": "2a062ce0-87ee-4816-8281-7e0afaf49993",
                                "sense_id": "11830f36-4257-35a4-ac00-45d589434937",
                                "text": "„Eine weitere erreichte wenige Tage später die noch südlicher gelegene Küstenstadt Chadera, womit Nasrallah demonstrierte, dass er es mit seiner Drohung, auch Raketen nach Tel Aviv zu schicken, ernst meinte.“"
                            }
                        ],
