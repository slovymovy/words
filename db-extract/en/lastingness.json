    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cb8c105e-ca24-394e-9608-bb13e6a21eb3",
                "word": "lastingness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02b9fe93-75b4-3764-bc56-f74df5381d5a",
                        "entry_id": "cb8c105e-ca24-394e-9608-bb13e6a21eb3",
                        "glosses": [
                            "The property of lasting; duration, permanence."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd66214-604d-4c16-a1b4-88f9bdd031be",
                                "sense_id": "02b9fe93-75b4-3764-bc56-f74df5381d5a",
                                "text": "The lightes, doores and staires, rather directed to the use of the guest, then to the eye of the Artificer: and yet as the one cheefly heeded, so the other not neglected; each place handsome without curiositie, and homely without lothsomnes: not so daintie as not to be trode on, nor yet slubberd up with good felowshippe: all more lasting then beautifull, but that the consideration of the exceeding lastingnesse made the eye beleeve it was exceeding beautifull.",
                                "translation": "The New Arcadia",
                                "english": "The New Arcadia"
                            },
                            {
                                "example_id": "6ff3e2f8-988b-4369-8796-d6bcbb1312fe",
                                "sense_id": "02b9fe93-75b4-3764-bc56-f74df5381d5a",
                                "text": "Now lastingnesse [translating durée] is not an accession unto wisdome."
                            },
                            {
                                "example_id": "8de7eb8f-aa6d-4cb6-bb4d-ffada45e0ff1",
                                "sense_id": "02b9fe93-75b4-3764-bc56-f74df5381d5a",
                                "text": "The intercession of Christ, and the lastingness of it, is a sure token of the salvation of them that come unto God by him."
                            },
                            {
                                "example_id": "6ef8a5d5-3b40-4457-b48f-a75e094c1716",
                                "sense_id": "02b9fe93-75b4-3764-bc56-f74df5381d5a",
                                "text": "The Paradise Plums had dwindled substantially. So had the Mintips, a mint sweet with the elasticity and lastingness of rubber."
                            },
                            {
                                "example_id": "3809561f-5941-4624-a4b6-ec263d1e39de",
                                "sense_id": "02b9fe93-75b4-3764-bc56-f74df5381d5a",
                                "text": "There are any number of components that can contribute to a noteworthy verse. From the style to the substance, from the writing to the delivery, a lot is at play to create a lasting verse and its performance. That, that lastingness, that memorability (“quotability” is the word often used), that’s probably the best barometer. Can an artist write a rhyme, and recite in a way, that everyone will always remember?"
                            }
                        ]
                    }
                ],
