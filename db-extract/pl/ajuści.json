                                "target_senses": [
                                    {
                                        "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "nicht genau bestimmbar oder bestimmt"
                                        ],
                                        "tags": [
                                            "adjektivisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0a660f8-2617-4f6b-a56d-992b14de25a9",
                                                "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                                "text": "Ein gewisser Herr Berger hat angerufen und nach dir gefragt."
                                            },
                                            {
                                                "example_id": "9e8583f9-0505-4a4e-9965-cf63548c1137",
                                                "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                                "text": "Gewisse Anstrengungen sind schon nötig."
                                            },
                                            {
                                                "example_id": "426696fa-163d-49b5-81d1-28446053d61f",
                                                "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                                "text": "„Das ersehnte Bergerlebnis ist nur auf dem Wege über ein gewisses Wagnis erreichbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f5608aa-94af-3b9b-99e3-fb0e9f9d630c",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "bekannt, aber nicht genannt"
                                        ],
                                        "tags": [
                                            "adjektivisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7786e86e-ef38-4c6b-9ed2-0535e434ac07",
                                                "sense_id": "6f5608aa-94af-3b9b-99e3-fb0e9f9d630c",
                                                "text": "„Dazu Jerzabek, wörtlich zitiert aus der offiziellen Parlamentsberichterstattung: Sie haben alle das gewisse Plakat schon gesehen, das eine gewisse Dame [nämlich die Tänzerin und Entertainerin Josephine Baker] im Naturkostüm darstellt. (Lebhafte Heiterkeit.)“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96950a3f-28d3-31b6-8cb4-7197b9913f5b",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "ohne Zweifel bestehend, eintretend"
                                        ],
                                        "tags": [
                                            "adjektivisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa37d7b8-7a42-4f17-8bb4-f7f97f161cd0",
                                                "sense_id": "96950a3f-28d3-31b6-8cb4-7197b9913f5b",
                                                "text": "Nichts ist gewisser als der Tod."
                                            },
                                            {
                                                "example_id": "ef2562a9-1463-447d-93f0-f31f595d4cc6",
                                                "sense_id": "96950a3f-28d3-31b6-8cb4-7197b9913f5b",
                                                "text": "„Wir betten sie in die Erde, von der sie genommen sind, in der gewissen Hoffnung, dass sie auferstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ee280c2a-d1ab-3279-a015-4b0e02aa7c85",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "bestimmt, unbedingt, mit Sicherheit"
                                        ],
                                        "tags": [
                                            "adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf3e9931-2f6d-4233-b078-043293092de0",
                                                "sense_id": "ee280c2a-d1ab-3279-a015-4b0e02aa7c85",
                                                "text": "Waren Sie schon mal in Berlin? – Ja gewiss."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
