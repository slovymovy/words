                        "examples": [
                            {
                                "example_id": "98fa5c8b-0c89-4aba-b70e-16e582ba1f39",
                                "sense_id": "372c3f69-b8f3-3983-a0f5-ac6a02dbd17b",
                                "text": "Przebicie jest więc dwukrotne. – Z tego, co zarabiamy, możemy utrzymać rodziny, dać pracę kilkudziesięciu pracownikom firmy i kolejnym, od których odbieramy makulaturę – mówi Sobczyk"
