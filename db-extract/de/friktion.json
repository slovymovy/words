                                        "sense_id": "06872ea7-6954-30c7-bfdb-5a04428d95eb",
                                        "entry_id": "1dc7072e-9f8c-37cb-8c7c-aafc17385398",
                                        "glosses": [
                                            "Lotion faite sur le cuir chevelu."
                                        ],
