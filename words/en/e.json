                {
                    "sense_id": "b77a330c-c037-3aff-b1d2-c94df8b70955",
                    "sense_definition": "The second sixteenth note (semiquaver) of a musical beat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saxophone player enters on the <w>e</w> of the first beat.",
                            "target_lang_translations": {
