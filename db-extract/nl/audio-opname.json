                        "examples": [
                            {
                                "example_id": "0212c080-4807-4e7e-95f3-515a6f9b0c68",
                                "sense_id": "a50ffb81-4044-326e-9e54-0ff05745c213",
                                "text": "De moeder van Soriano overleed vorig jaar aan de gevolgen van kanker. Vlak voordat ze ernstig ziek werd, gaf ze haar dochter de knuffel met daarin een audio-opname van zichzelf."
                            },
                            {
                                "example_id": "e8ca5f74-fd7a-4836-8e29-33c2f021677b",
                                "sense_id": "a50ffb81-4044-326e-9e54-0ff05745c213",
                                "text": "The Washington Post heeft de hand weten te leggen op een audio-opname van het gesprek en die in zijn geheel online gezet."
                            },
                            {
                                "example_id": "0133f2ca-39a1-4e85-ba12-106a7687e812",
                                "sense_id": "a50ffb81-4044-326e-9e54-0ff05745c213",
                                "text": "Er verschijnen steeds meer verhalen die de Russische oorlogsmisdaden lijken te bevestigen. Volgens Der Spiegel heeft de Duitse inlichtingendienst BND geluidsfragmenten onderschept van gesprekken die Russische militairen in Bucha voerden. In de audio-opname zou te horen zijn hoe de Russen de moord op burgers bespraken."
                            }
                        ]
                    }
