                "senses": [
                    {
                        "sense_id": "d32112ac-ce26-35b7-88c4-728cfec6f1cc",
                        "entry_id": "5f81d2a4-427f-3a35-9bbc-2d9c048b2b86",
                        "glosses": [
                            "Préparer en suprême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf5335cd-a5f9-45f8-9818-3ea3afe0b2a8",
                                "sense_id": "d32112ac-ce26-35b7-88c4-728cfec6f1cc",
                                "text": "Et s'il ne vous reste que 5 minutes après avoir peiné à suprêmiser vos oranges, j'ai de quoi les transformer en salade de fruit simplissime pour le dessert: (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "b4cf4d2d-6a41-324f-b790-c96e3b01e270",
                        "entry_id": "5f81d2a4-427f-3a35-9bbc-2d9c048b2b86",
                        "glosses": [
                            "Donner un caractère suprême à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b03146-2cba-4f81-8622-da3fc7315f74",
                                "sense_id": "b4cf4d2d-6a41-324f-b790-c96e3b01e270",
                                "text": "En fait, il n'y a pas qu'un suprême tason là-dessus, il y en a plusieurs, et des sévères, et du tason ordinaire aussi (appelé donc à être tôt ou tard suprêmisé)."
                            },
                            {
                                "example_id": "d4ffbfc3-07f1-43ea-810c-cd38e461b823",
                                "sense_id": "b4cf4d2d-6a41-324f-b790-c96e3b01e270",
                                "text": "Nous nous fondons l’un l’autre. Nous rétrécissons graduellement, la matière suprêmisée disparaît."
                            }
                        ]
                    }
                ],
