                ],
                "senses": [
                    {
                        "sense_id": "15367df0-b889-3328-84b9-da3c31e81e2c",
                        "entry_id": "faaaabd8-80c6-34db-a8f6-e233d192516d",
                        "glosses": [
                            "Perdre son bronzage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4771fa-332e-449a-a061-af74777b66c6",
                                "sense_id": "15367df0-b889-3328-84b9-da3c31e81e2c",
                                "text": "Nous repartons débronzer en coulisses, retrouver la vraie vie après la vie vraie."
                            },
                            {
                                "example_id": "617469dd-86d5-4340-ad3b-ad9ed27caf0f",
                                "sense_id": "15367df0-b889-3328-84b9-da3c31e81e2c",
                                "text": "Oh, oh, faut pas débronzer, hein, on te voit en bikini."
                            }
                        ]
                    },
                    {
                        "sense_id": "b32eb196-935d-3bd0-b391-07cc20e59295",
                        "entry_id": "faaaabd8-80c6-34db-a8f6-e233d192516d",
                        "glosses": [
                            "Faire perdre son bronze à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc07848-af62-4993-ae1f-0ecebb9e3d6f",
                                "sense_id": "b32eb196-935d-3bd0-b391-07cc20e59295",
                                "text": "Elle empêche ses héros poétiques de devenir des statues de squares. Mais loin de débronzer l'art, elle ne cherche qu'à en camoufler l'or royal."
                            },
                            {
                                "example_id": "a34c8e5d-8f67-446c-80ff-5b960b0a297c",
                                "sense_id": "b32eb196-935d-3bd0-b391-07cc20e59295",
                                "text": "Par suite de sa forme plus élargie, le nouveau guidon offre plus de résistance aux chocs et il est moins exposé à se courber et à se débronzer que le guidon pointu actuel."
                            }
                        ]
                    }
