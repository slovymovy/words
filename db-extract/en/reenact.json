                        "source_entry_id": "45adb5e2-6c08-3cd3-90aa-6fa8f050626a",
                        "source_sense_description": "To enact again",
                        "target_lang_word": "nachstellen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachstellen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13b15202-e6c2-3553-a1f8-7802f01650a8",
                                        "entry_id": "d6cb41e0-33cc-3c07-9f77-4969a78c57db",
                                        "glosses": [
                                            "etwas nach einer Änderung / nach einem bestimmten Zeitraum wieder genau einstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec467643-8b3d-4221-8b8d-5c972a8e6d27",
                                                "sense_id": "13b15202-e6c2-3553-a1f8-7802f01650a8",
                                                "text": "Aufgrund der hohen Belastung seiner Fahrradbremsen musste er sie nach der Geländetour nachstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77b94e7e-18b3-3d70-986b-1059e7bfa08b",
                                        "entry_id": "d6cb41e0-33cc-3c07-9f77-4969a78c57db",
                                        "glosses": [
                                            "die Zeiger einer Uhr zurückstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc1f3c76-2472-416c-b020-5e6bdd675161",
                                                "sense_id": "77b94e7e-18b3-3d70-986b-1059e7bfa08b",
                                                "text": "Weil seine Uhr vorging, musste er sie nachstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "69b042b4-142a-3805-b03d-78ef293c0f1f",
                                        "entry_id": "d6cb41e0-33cc-3c07-9f77-4969a78c57db",
                                        "glosses": [
                                            "eine Situation originalgetreu darstellen, wiedergeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8b6bb3-6a82-4057-ab9c-e1fb5b5d7b11",
                                                "sense_id": "69b042b4-142a-3805-b03d-78ef293c0f1f",
                                                "text": "Auf Anweisung der Polizei stellte er den Unfall nach."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "161284e7-a240-3915-a677-4d28c5a479b1",
                                        "entry_id": "d6cb41e0-33cc-3c07-9f77-4969a78c57db",
                                        "glosses": [
                                            "ein Wort oder ein Satzglied in einem Satz hinter ein anderes setzen oder verschieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5bd260b-6b7f-46c8-be80-f22ba73cb9e7",
                                                "sense_id": "161284e7-a240-3915-a677-4d28c5a479b1",
                                                "text": "„Das Genitivattribut wird immer nachgestellt, aber unter bestimmten Bedingungen ist eine Voranstellung als sächsischer Genitiv möglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6dccf370-fee7-3aa4-8af0-ae76d1fafa4b",
                                        "entry_id": "d6cb41e0-33cc-3c07-9f77-4969a78c57db",
                                        "glosses": [
                                            "ein Tier oder eine Person verfolgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6f557c-b953-435e-8432-ee8414b86ea1",
                                                "sense_id": "6dccf370-fee7-3aa4-8af0-ae76d1fafa4b",
                                                "text": "Der Jäger stellte dem Reh vorsichtig nach."
                                            },
                                            {
                                                "example_id": "4bb81797-d6c0-46dc-bea7-f2486debfe19",
                                                "sense_id": "6dccf370-fee7-3aa4-8af0-ae76d1fafa4b",
                                                "text": "„Laut dem Bundesnaturschutzgesetz ist es verboten, Bibern nachzustellen, sie zu fangen, zu verletzen oder zu töten sowie Burgen und Dämme zu beschädigen oder zu zerstören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1b691662-afc3-3bfe-a19d-f64a7ae2d347",
                                        "entry_id": "d6cb41e0-33cc-3c07-9f77-4969a78c57db",
                                        "glosses": [
                                            "eine Person hartnäckig umwerben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec0df1b-be6d-44bf-8971-62ef6dc49a8f",
                                                "sense_id": "1b691662-afc3-3bfe-a19d-f64a7ae2d347",
                                                "text": "Er stellte Anna so lange nach, bis sie sich mit ihm verabredete."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
