                {
                    "sense_id": "88df7ba6-c134-3e94-b2d3-c847798cb991",
                    "sense_definition": "Ajuster, joindre et fixer plusieurs pièces les unes avec les autres pour former un ensemble cohérent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "construction_montage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il suit attentivement la notice pour <w>assembler</w> cette nouvelle table en bois.",
                            "target_lang_translations": {
                                "en": "He carefully follows the instructions to <w>assemble</w> this new wooden table.",
                                "ru": "Он внимательно следует инструкции, чтобы <w>собрать</w> этот новый деревянный стол.",
                                "de": "Er folgt aufmerksam der Anleitung, um diesen neuen Holztisch <w>zusammenzubauen</w>.",
                                "es": "Sigue atentamente las instrucciones para <w>montar</w> esta nueva mesa de madera.",
                                "zh": "他仔细地按照说明书来<w>组装</w>这张新的木桌。"
                            }
                        },
                        {
                            "text": "Les techniciens doivent <w>assembler</w> toutes les pièces métalliques avant la fin de la journée.",
                            "target_lang_translations": {
                                "en": "The technicians must <w>assemble</w> all the metal parts before the end of the day.",
                                "ru": "Техники должны <w>собрать</w> все металлические детали до конца дня.",
                                "de": "Die Techniker müssen alle Metallteile vor Ende des Tages <w>montieren</w>.",
                                "es": "Los técnicos deben <w>montar</w> todas las piezas metálicas antes de que acabe la jornada.",
                                "zh": "技术人员必须在当天结束前把所有金属零件<w>组装</w>好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "assembler un meuble",
                        "assembler des pièces"
                    ],
                    "target_lang_definitions": {
                        "en": "To fit and fix several parts together to form a coherent whole.",
                        "ru": "Соединять и закреплять несколько деталей, образуя единое целое.",
                        "de": "Mehrere Teile passend miteinander verbinden und befestigen, sodass ein stimmiges Ganzes entsteht.",
                        "es": "Unir y fijar varias piezas entre sí para formar un conjunto coherente.",
                        "zh": "把几个零件调整、连接并固定在一起，组成一个协调的整体。"
                    },
