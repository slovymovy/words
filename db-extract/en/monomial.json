                                "target_senses": [
                                    {
                                        "sense_id": "8cae8daa-4162-3fcd-a327-4de924e4242e",
                                        "entry_id": "32c54d28-7bdf-31a8-86bb-5428336cfed5",
                                        "glosses": [
                                            "Expresión algebraica de un solo término, es decir, que involucra solamente multiplicaciones o divisiones entre números e incógnitas con exponente no negativo, tal como en las ecuaciones siguientes:"
                                        ],
                                        "tags": [
                                            "academic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3b46668-ef96-4b2d-93a2-26354d05fec2",
                                                "sense_id": "8cae8daa-4162-3fcd-a327-4de924e4242e",
                                                "text": "Los monomios son expresiones algebraicas muy utilizadas que constan de una constante, a la que se le llama coeficiente y una parte literal, que se representa con letras y que puede estar elevada a distintas potencias. Por ejemplo, el monomio 2x², tiene al 2 como su coeficiente y x² es la parte literal. En varias oportunidades la parte literal puede estar compuesta por una multiplicación de incógnitas, como por ejemplo en el caso de 2xy. Cada una de estas letras recibe el nombre de indeterminada o variable"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
