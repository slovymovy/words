{
    "word_family": [
        "contest",
        "contestable",
        "contestation",
        "contested"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8cd4e62-dce4-3b28-8b13-bc3c5133c9f9",
                    "sense_definition": "Not able to be doubted or questioned; certain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence presented in court made his guilt <w>incontestable</w>.",
                            "target_lang_translations": {
                                "nl": "Het bewijsmateriaal dat in de rechtszaal werd gepresenteerd maakte zijn schuld <w>ontegenzeglijk</w>."
                            }
                        },
                        {
                            "text": "It is an <w>incontestable</w> fact that the climate is changing rapidly.",
                            "target_lang_translations": {
                                "nl": "Het is een <w>onbetwistbaar</w> feit dat het klimaat snel verandert."
                            }
                        }
                    ],
                    "synonyms": [
                        "incontrovertible"
                    ],
                    "common_phrases": [
                        "incontestable fact",
                        "incontestable proof"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet voor twijfel of tegenspraak vatbaar; absoluut zeker."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontegenzeglijk",
                                "target_lang_sense_clarification": "Iets dat niet tegen te spreken is."
                            },
                            {
                                "target_lang_word": "onbetwistbaar",
                                "target_lang_sense_clarification": "Iets waar niet meer over te discussiëren valt."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}