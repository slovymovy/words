            {
                "entry_id": "2b821a9b-1b68-3021-b05c-ad6f585c37a3",
                "word": "Pythonist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5645b4b-2716-4228-a496-eb4fde19369f",
                        "entry_id": "2b821a9b-1b68-3021-b05c-ad6f585c37a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "Pythonists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69522073-14da-3aa9-93a6-a3505b41e0fb",
                        "entry_id": "2b821a9b-1b68-3021-b05c-ad6f585c37a3",
                        "glosses": [
                            "A programmer who uses the Python programming language."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "e0a48003-06a8-428c-8654-0697c5b897fe",
                                "sense_id": "69522073-14da-3aa9-93a6-a3505b41e0fb",
                                "text": "Pythonists and Perlers probably doesn't feel that Ruby (on or off Rails) is sufficiently different from what they're currently doing to warrant stepping down the expert ladder."
                            },
                            {
                                "example_id": "17c13d41-1a18-4490-9d51-014925a34b3f",
                                "sense_id": "69522073-14da-3aa9-93a6-a3505b41e0fb",
                                "text": "We Pythonists have always prided ourselves in being the best example of an end-to-end, batteries-included delivery system that could create anything imaginable for the desktop user."
                            },
                            {
                                "example_id": "73a72cd6-c66a-4aa2-9cc0-ce190f18b765",
                                "sense_id": "69522073-14da-3aa9-93a6-a3505b41e0fb",
                                "text": "If you're a Python guru, you can look for ideas to apply your craft to penetration testing, or if you are a newbie Pythonist with some penetration testing chops, then this module serves as a perfect ending to your search for some hands-on experience in pentesting."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfa276b3-7520-3871-a4f4-6c9768d9c4e9",
                        "entry_id": "2b821a9b-1b68-3021-b05c-ad6f585c37a3",
                        "glosses": [
                            "A fan of the British comedy troupe Monty Python."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "9377c115-44d2-4268-8e31-1cd7a49d89b4",
                                "sense_id": "bfa276b3-7520-3871-a4f4-6c9768d9c4e9",
                                "text": "Am I the only Pythonist out here who thinks \"Always Look On the Bright Side of Life\" is not half as hilarious as \"The Galaxy Song\"? Must be that twist ending at the end..."
                            },
                            {
                                "example_id": "c7ca0a6d-2860-44a3-9bba-2f582af4edf4",
                                "sense_id": "bfa276b3-7520-3871-a4f4-6c9768d9c4e9",
                                "text": "The Prairienet site is also home to the alt.fan.monty-python Homepage,which you should definitely check out if you're a Pythonist."
                            },
                            {
                                "example_id": "8bdb2ac0-90f9-4f5d-8d70-be107200d04e",
                                "sense_id": "bfa276b3-7520-3871-a4f4-6c9768d9c4e9",
                                "text": "Yes those are two classics as well, often mumble those at weirdly appropriate moments (aka when no one but myself and another Pythonist will hear them!)"
                            }
                        ]
                    }
                ],
