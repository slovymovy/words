                "senses": [
                    {
                        "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                        "entry_id": "40057f7b-2b26-312b-ac62-1ba13f3c7b9e",
                        "glosses": [
                            "prähistorische Ruinenstadt im Zentralen Hochland von Mexiko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b87808a3-3e1b-46aa-8aa0-0ec4b8e32c79",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "Die archäologische Stätte Teotihuacans gehört seit 1987 zum Weltkulturerbe der UNESCO."
                            },
                            {
                                "example_id": "9736d7ea-a75e-4351-abe6-4966268b3919",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "Es ist nicht restlos geklärt, welches Volk die Anlagen von Teotihuacan errichtet hat."
                            },
                            {
                                "example_id": "0085f669-f4bc-417b-ac2a-a725dcfeeced",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "Vor 1900 Jahren war sie [die Stadt Teotihuacan] ein halbes Jahrhundert lang die mächtigste Stadt Mittelamerikas und zählte über 150 000 Einwohner."
                            },
                            {
                                "example_id": "671f9b58-e17f-4b9b-9fcd-59b2093df988",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "„Das Leben war nicht überall gleich organisiert.“ Der US-Archäologe wertet das als weiteres Indiz dafür, dass Teotihuacan nicht von einer zentralen Macht, sondern von einem Kollektiv regiert wurde - und das funktionierte in jedem Quartier ein wenig anders."
                            },
                            {
                                "example_id": "291eb408-7ddc-4872-bd51-d435e2d647ee",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "Der Mythos Teotihuacan speist sich aus den Widersprüchen ihrer Kultur: Die Menschen von Teotihuacan kultivierten Mittelamerika wie die Griechen das antike Europa, aber sie haben bis heute nicht einmal einen richtigen Namen."
                            },
                            {
                                "example_id": "676e59d4-8a72-4b69-a4ca-269c45c10a3c",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "Die Azteken fanden Teotihuacan bei ihrer Einwanderung ins Hochland von Mexiko bereits als Ruinenstadt vor, die seit Jahrhunderten verlassen war."
                            },
                            {
                                "example_id": "fffd5ded-f8cb-4480-8341-91f2a40b5a4c",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "Alle Monumente in Teotihuacan waren in Stein eingefaßt und mit einem Stuckanstrich versehen, der mit Wandgemälden oder einfach mit Farben bemalt war."
                            },
                            {
                                "example_id": "415ef1e8-07d4-4899-bb00-c5cd99e842fa",
                                "sense_id": "1fffefdd-2e0c-3b53-b7b4-3d051a015e81",
                                "text": "Die Tolteken von Teotihuacan waren geistig verwandt mit den Mayas, da ihre Hauptstatue, die sogenannte Diosa del agua, eine Bergtalgöttin ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
