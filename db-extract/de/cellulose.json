                    {
                        "sense_id": "2efef295-46a2-3ee5-90f0-016c6137805b",
                        "entry_id": "2e11264d-8fc7-36f5-9a71-abb9957639a6",
                        "glosses": [
                            "Cellulose, polymère de type polysaccharide largement répandu dans la nature."
                        ],
                        "tags": [],
                        "note": "Le pluriel désigne ici des variantes différentes de ce matériau (voir le 2ᵉ exemple",
                        "examples": [
                            {
                                "example_id": "0fdd5708-f614-41d4-ae15-e7895d48da61",
                                "sense_id": "2efef295-46a2-3ee5-90f0-016c6137805b",
                                "text": "Die Cellulose hat vor allem in der Papierindustrie grosse Bedeutung.",
                                "translation": "La cellulose a une grande importance dans l’industrie du papier avant tout."
                            },
                            {
                                "example_id": "6e902432-2ff4-4969-9eb9-31b6047a2f1c",
                                "sense_id": "2efef295-46a2-3ee5-90f0-016c6137805b",
                                "text": "Über Zusammenhänge zwischen Carboxylgehalt und Polymerisationsgrad von Cellulosen bei der Vorreife der Viscose und der Chlorbleiche.",
                                "translation": "Sur les relations entre la teneur en groupes carboxyles et le degré de polymérisation de celluloses lors de la maturation des viscoses et du blanchiment au chlore."
                            }
                        ]
                    }
