                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "461d6646-c4ab-4354-8729-c8573d40db25",
                        "source_entry_id": "28a977e6-b878-337d-886d-9f85f7516751",
                        "source_sense_id": "6a459cef-5a95-3c70-9dd6-fdbe953be5f7",
                        "source_sense_description": "small, hand-held gun",
                        "target_lang_word": "Pistole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pistole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                        "entry_id": "490b67e8-19f6-3b58-b0fa-c06d0b806eac",
                                        "glosses": [
                                            "Schusswaffe mit kurzem Lauf, die aus der Hand abgeschossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa4dc54-c3ac-473b-9080-346ffbd1df75",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "Der Räuber bedrohte die Kassiererin mit einer Pistole."
                                            },
                                            {
                                                "example_id": "1278a15e-9e21-4b02-979c-538853190254",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "In der Kiste mit den Pistolen liegen auch die Magazine."
                                            },
                                            {
                                                "example_id": "be76cceb-230c-40d9-afe1-7b7a33164d80",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Arschloch, dachte ich, beeil du dich nur, daß du an deinen Feind kommst! Hoffentlich kriegst du eine vor den Latz geknallt, du mit deinen sechs Schuß in der Pistole!“"
                                            },
                                            {
                                                "example_id": "36b855de-7b85-4832-b787-14b09460919e",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Ohne länger zu zögern, zog ich meine Pistole und öffnete die Tür.“"
                                            },
                                            {
                                                "example_id": "ac18d01f-5ff8-4175-a806-bb7fe6225660",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Wahrscheinlich ist es also ein Hirt, wozu sein zerlumpter Burnus schon passen könnte; aber er hat einen kostbaren Gürtel um und Dolch und Pistole an der Seite.“"
                                            },
                                            {
                                                "example_id": "f158990b-1459-48e2-91aa-d04c50bb592d",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Sie sicherte die Pistole und schob sie in die Tasche zurück.“"
                                            },
                                            {
                                                "example_id": "31c7c2cb-d983-425d-aa26-33e0d45c9732",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Als er zwei Mal mit seiner Pistole betrunken herumgeballert hatte, drohte seine Frau, ihn auf der Stelle zu verlassen.“"
                                            },
                                            {
                                                "example_id": "065b6ae5-41a0-4ceb-b4ab-18cd28b8e548",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Er nahm die Pistole aus dem Halfter und schoss dem Ulanen ein Loch in den Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4188e223-e5a3-309d-a60e-759755c3e85f",
                                        "entry_id": "490b67e8-19f6-3b58-b0fa-c06d0b806eac",
                                        "glosses": [
                                            "männliches Geschlechtsteil"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pistole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                        "entry_id": "6b38106b-e530-3db1-9be1-dfa9d4dce389",
                                        "glosses": [
                                            "ursprünglich spanische Münze aus amerikanischem Gold, später auch in anderen europäischen Ländern mit unterschiedlicher Prägung, Währung und Wert"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a068abca-7e8e-4034-97d5-7919f00776cc",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Ich wußte wohl, daß Ihr das Pferd kaufen würdet, Herr Marx, denn Ihr ſucht für den Rittmeiſter in Unna eins zu dreißig Piſtolen, und mein Bräunchen paßt Euch dazu, wie beſtellt.“"
                                            },
                                            {
                                                "example_id": "c56aee6a-5fa2-4378-8932-cb4381136b93",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Es wurde ein recht dicker Quarto-Band, für den fehlende algebraïsche Zeichen gegossen und sogar neue Patrizen geschnitten werden mußten, so daß die Ausgabe, die in tausend Exemplaren gedruckt werden sollte, Hervás auf siebenhundert Pistolen zu stehen kam.“"
                                            },
                                            {
                                                "example_id": "e2275eb3-6b19-46e0-9c96-03c07adcf0c4",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Das Pferd, ein Apfelschimmel, kostete vierzig piemontesische Pistolen; das entsprach ungefähr hundert Zechinen.“"
                                            },
                                            {
                                                "example_id": "e7d2695b-6512-4f65-929e-d97dfe0a952e",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Sie stammte aus Quistreham, hatte keine Verwandten, verdiente eine Pistole im Monat – kurzum, sie gefiel ihm so, daß er sie in seinen Dienst zu nehmen wünschte, damit sie der alten Germaine zur Hand ginge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4f1ddfb-feb9-4adb-a046-818890178fc9",
                        "source_entry_id": "28a977e6-b878-337d-886d-9f85f7516751",
                        "source_sense_id": "6a459cef-5a95-3c70-9dd6-fdbe953be5f7",
                        "source_sense_description": "small, hand-held gun",
                        "target_lang_word": "Revolver",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Revolver",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                        "entry_id": "325cad38-4d2a-30d8-a028-1067e25fe63c",
                                        "glosses": [
                                            "Handfeuerwaffe mit einem Nachlademechanismus mit zylindrischer Munitionskammer (Trommel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69cee370-f78a-49bd-bc34-3cdb2ed7bb78",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "Aus Angst vor Räubern hat er immer einen Revolver unter der Ladentheke."
                                            },
                                            {
                                                "example_id": "b492f5c5-2e6c-452c-bf63-2ab6facf40be",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Der Soldat nahm den Revolver an sich, einige Minuten später wurde das Todesurteil vollstreckt.“"
                                            },
                                            {
                                                "example_id": "a6027a36-3622-429e-a4c3-157d1932c2a3",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Diese Möglichkeit hatte ich nicht berücksichtigt, und ich hielt meine Flucht bereits für gescheitert, denn plötzlich fiel mir der scharf geladene Revolver ein.“"
                                            },
                                            {
                                                "example_id": "d8bcc8b2-64c5-47fb-87ba-bf61cae6206b",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Revolver gingen manchmal von selbst los.“"
                                            },
                                            {
                                                "example_id": "a8449ff2-4c36-4d94-86dd-a63e3d5bf5c4",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Wir hatten natürlich Revolver und Gewehre und andere Waffen, auch Panzerfäuste und Mörser, Maschinenpistolen und tragbare Maschinengewehre, leichte und schwere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d34f18cc-853f-473b-9a62-42a928b31de5",
                        "source_entry_id": "28a977e6-b878-337d-886d-9f85f7516751",
                        "source_sense_id": "6a459cef-5a95-3c70-9dd6-fdbe953be5f7",
                        "source_sense_description": "small, hand-held gun",
                        "target_lang_word": "Meuchelpuffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meuchelpuffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89130107-5152-3ca9-88b2-e3b843aa72ef",
                                        "entry_id": "155a1c0d-b28c-3a33-90f9-f050fdacd69e",
                                        "glosses": [
                                            "Schusswaffe mit kurzem Lauf, die aus der Hand abgeschossen wird; Pistole"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84880a81-cdb7-4765-81cd-ad8f284ec786",
                                                "sense_id": "89130107-5152-3ca9-88b2-e3b843aa72ef",
                                                "text": "„Er sagte die Stunde / wan es angähen solte; und naachdehm er ihnen auch das Zeuchen gegäben / und alles wohl angeordnet hatte / verfügt' er sich wider auf das Schlos / wie er sonst pflägte / doch gleichwohl hatt' er sich mit ein paar Meichel=puffern und einem Dägen versähen / die er in geheim in seine Kammer truug / damit er sie / im fal er ja in seinem Führnähmen überfallen würde / zur Gegenwähr gebrauchen konte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c134aea-b4e1-4103-87b6-3e51eaba24be",
                        "source_entry_id": "28a977e6-b878-337d-886d-9f85f7516751",
                        "source_sense_id": "6a459cef-5a95-3c70-9dd6-fdbe953be5f7",
                        "source_sense_description": "small, hand-held gun",
                        "target_lang_word": "пистоле́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пистоле́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "92212289-c014-3608-9d83-46150a9f66e5",
                                        "entry_id": "77a14f39-798e-34a6-a87b-32961c28feac",
                                        "glosses": [
                                            "компактное огнестрельное оружие для стрельбы одной рукой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86636ca8-e8fa-483f-b9ae-f44045c99967",
                                                "sense_id": "92212289-c014-3608-9d83-46150a9f66e5",
                                                "text": "Оставшись один, Арапов 〈…〉 снял со стены висевший над кроватью револьвер и остановился, смотря то на окно комнаты, то на дуло пистолета."
                                            },
                                            {
                                                "example_id": "ac0fe294-1c22-4de4-a0ab-e267af53ddb4",
                                                "sense_id": "92212289-c014-3608-9d83-46150a9f66e5",
                                                "text": "Чертопханов посмотрел ей вслед, подбежал к месту, где лежал пистолет, схватил его, прицелился, выстрелил…"
                                            },
                                            {
                                                "example_id": "7e853497-47b7-4d7c-bbf7-fe3bcc2cf181",
                                                "sense_id": "92212289-c014-3608-9d83-46150a9f66e5",
                                                "text": "В проходе стоял милиционер, держащий в руках пистолет со взведенным курком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0d261bb-ce1f-38ff-9a8c-42a3857e019a",
                                        "entry_id": "77a14f39-798e-34a6-a87b-32961c28feac",
                                        "glosses": [
                                            "пистолет [1], не имеющий в своей конструкции вращающегося блока патронников или стволов, не револьвер"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f0c748-fa5c-4690-9902-bef289f8fb21",
                                                "sense_id": "d0d261bb-ce1f-38ff-9a8c-42a3857e019a",
                                                "text": "Тут у Паши Туманова очень ясно и просто явилось соображение, что, кроме директора, надо убить и учителя латинского языка, а потому лучше купить револьвер, чем пистолет."
                                            },
                                            {
                                                "example_id": "e3172721-acf4-4aec-ac02-7ae90dce5d16",
                                                "sense_id": "d0d261bb-ce1f-38ff-9a8c-42a3857e019a",
                                                "text": "Приехал на смотр старенький, очень важный генерал, на всех накричал, всех похвалил, все перепутал, перезабыв уставы, револьвер называл пистолетом, вместо «снабжать» говорил «снабдать», шепелявил и часто сморкался."
                                            },
                                            {
                                                "example_id": "a3e8c777-9dd9-4172-a98c-cbb1e377f2bb",
                                                "sense_id": "d0d261bb-ce1f-38ff-9a8c-42a3857e019a",
                                                "text": "Отсутствие неавтоматического предохранителя делает пистолет готовым к стрельбе практически мгновенно, подобно револьверу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7226a1ce-3f0e-3a29-8308-0062e2afe43a",
                                        "entry_id": "77a14f39-798e-34a6-a87b-32961c28feac",
                                        "glosses": [
                                            "любое устройство, формой напоминающее пистолет [1] и имеющее спусковой крючок (кнопку, рычаг)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "173f4d34-9960-4eb1-9ad4-eacb7a5e9234",
                                                "sense_id": "7226a1ce-3f0e-3a29-8308-0062e2afe43a",
                                                "text": "У каждого гражданина новой страны имеется аппарат, похожий на пистолет для пирсинга, — с его помощью каждое утро надо делать себе инъекцию специального вещества, подавляющего эмоции."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
