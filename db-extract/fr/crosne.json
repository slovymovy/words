            {
                "entry_id": "3c4911da-dd3a-368b-b21e-6562af77bd18",
                "word": "crosne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c399b975-7e5b-48e4-93ca-4dc01a8cda7e",
                        "entry_id": "3c4911da-dd3a-368b-b21e-6562af77bd18",
                        "tags": [
                            "plural"
                        ],
                        "form": "crosnes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cab81de9-287e-3627-8e65-d98c94ff21a7",
                        "entry_id": "3c4911da-dd3a-368b-b21e-6562af77bd18",
                        "glosses": [
                            "Plante de la famille des lamiacées originaire du Nord-Ouest de la Chine et cultivée pour ses tubercules comestibles. Le terme désigne aussi ces tubercules consommables comme légumes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "835c96a5-10bb-4473-b8fe-4a8bd2f55542",
                                "sense_id": "cab81de9-287e-3627-8e65-d98c94ff21a7",
                                "text": "Le goût de noisette des crosnes rappelle celui des salsifis ou de l’artichaut."
                            },
                            {
                                "example_id": "7918e1c1-05d9-4730-ba05-3cfbbd01f7d0",
                                "sense_id": "cab81de9-287e-3627-8e65-d98c94ff21a7",
                                "text": "Il fut gracié le 1ᵉʳ janvier 1855, et rentra en France avec un plan très complet d’acclimatation, dans la terre algérienne, de la culture du manioc, des crosnes et de la pomme de terre dite saucissse."
                            },
                            {
                                "example_id": "86c85e3e-8c13-4cf3-a97b-7af42056f843",
                                "sense_id": "cab81de9-287e-3627-8e65-d98c94ff21a7",
                                "text": "Ma mère confectionnait des omelettes sans œufs et des entremets à la margarine, où la saccharine remplaçait le sucre ; elle nous servait de la viande frigorifiée, des biftecks de cheval et de tristes légumes : crosnes, topinambours, bettes, artichauts de Jérusalem."
                            },
                            {
                                "example_id": "56fe5d73-ebd5-4012-be1d-45f7ef1505e1",
                                "sense_id": "cab81de9-287e-3627-8e65-d98c94ff21a7",
                                "text": "La façon la plus classique de préparer les crosnes du Japon, c’est de les faire blanchir, puis de les faire sauter au beurre avec beaucoup de persil et du citron, explique-t-il."
                            }
                        ]
                    }
