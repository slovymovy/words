                "senses": [
                    {
                        "sense_id": "e579b0b7-4459-31db-b3a6-e12923ae5be5",
                        "entry_id": "f23159c4-850d-3560-8701-4c33c4f96d13",
                        "glosses": [
                            "Marsch zurück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e70acb2-690a-468d-adf4-ba93336dcc37",
                                "sense_id": "e579b0b7-4459-31db-b3a6-e12923ae5be5",
                                "text": "„Nach zwei oder drei Stunden wurde der Rückmarsch befohlen.“"
                            },
                            {
                                "example_id": "b4906f3b-0194-4e9c-ace7-1b40094519bc",
                                "sense_id": "e579b0b7-4459-31db-b3a6-e12923ae5be5",
                                "text": "„Eine Woche später befahlen deutsche Soldaten auf dem Rückmarsch vor zaristischen Truppen ihnen doch, das Landgut zu verlassen; sie fügten sich.“"
                            },
                            {
                                "example_id": "6e5562f1-7adf-4f90-a0c2-1d7d3c5c50aa",
                                "sense_id": "e579b0b7-4459-31db-b3a6-e12923ae5be5",
                                "text": "„Krank und zum Skelett abgemagert, trat der Schotte den beschwerlichen Rückmarsch zur Küste an.“"
                            },
                            {
                                "example_id": "8903b989-38f0-4153-bf24-64ec8965e2ae",
                                "sense_id": "e579b0b7-4459-31db-b3a6-e12923ae5be5",
                                "text": "„Wir könnten also anspannen und unseren Rückmarsch beginnen, falls nur zwei Pferde sich auftreiben ließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
