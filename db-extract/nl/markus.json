                                    {
                                        "sense_id": "1dd0798b-3f86-38d2-a78d-33d62952e475",
                                        "entry_id": "4b1c77ac-e18a-3715-bab2-bea1d5833840",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
