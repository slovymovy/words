                    "frequency": "Low",
                    "semantic_group_id": "technische beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de sterke stroming begon het schip gevaarlijk te <w>gieren</w>.",
                            "target_lang_translations": {
                                "en": "Due to the strong current, the ship began to <w>yaw</w> dangerously.",
                                "fr": "À cause du fort courant, le navire s'est mis à dangereusement <w>embarder</w>."
                            }
                        },
                        {
                            "text": "Het vliegtuig <w>gierde</w> lichtjes tijdens de landing door de zijwind.",
                            "target_lang_translations": {
