                    },
                    {
                        "form_id": "f1c4ab24-91b5-44b1-a7d5-f6185e8e9ced",
                        "entry_id": "43185eee-6f18-392c-8e06-44a6afeaddfc",
                        "tags": [],
                        "form": "dealer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9c75f4e-3edc-3394-b8d8-2b632e59b350",
                        "entry_id": "43185eee-6f18-392c-8e06-44a6afeaddfc",
                        "glosses": [
                            "Narcotrafiquant, vendeur de drogue, de stupéfiants."
                        ],
                        "tags": [
                            "Anglicism",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9d3acd33-510c-4078-aee8-f92578a5e8eb",
                                "sense_id": "c9c75f4e-3edc-3394-b8d8-2b632e59b350",
                                "text": "Aucun dealeur local ne peut satisfaire la totalité de la nouvelle demande de cannabis et les jeunes les plus téméraires s’aventurent dans les cités des environs pour s’approvisionner, puis consomment et revendent dans les rues de leur quartier."
                            },
                            {
                                "example_id": "b55ee2cf-856b-4234-9a15-c34cf3249eb4",
                                "sense_id": "c9c75f4e-3edc-3394-b8d8-2b632e59b350",
                                "text": "À la suite du dossier du Parisien sur la « guerre perdue contre les dealeurs » du 5 septembre, dans lequel des policiers dénoncent la stratégie de l’État en matière de lutte contre les stupéfiants, Gérald Darmanin a tenté de convaincre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1a39721-6612-4f01-a15d-badaf3644d90",
                        "source_entry_id": "43185eee-6f18-392c-8e06-44a6afeaddfc",
                        "source_sense_id": "c9c75f4e-3edc-3394-b8d8-2b632e59b350",
                        "target_lang_word": "Dealer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dealer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a26fadd-bdc6-3aee-99d9-1183c8ad033d",
                                        "entry_id": "9887fbab-c721-3ca3-aded-b3514dab7584",
                                        "glosses": [
                                            "jemand, der Drogen verkauft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fa3cefc-c56d-4101-827e-a7da1c6ca94f",
                                                "sense_id": "4a26fadd-bdc6-3aee-99d9-1183c8ad033d",
                                                "text": "Hab' eben noch 5 Gramm von meinem Dealer geholt."
                                            },
                                            {
                                                "example_id": "85049730-f393-42ae-9a00-ae61ec913954",
                                                "sense_id": "4a26fadd-bdc6-3aee-99d9-1183c8ad033d",
                                                "text": "„Sie waren alle Dealer der untersten Charge.“"
                                            },
                                            {
                                                "example_id": "bd9aa0b2-f416-49ff-aed2-d5e30d80e0ae",
                                                "sense_id": "4a26fadd-bdc6-3aee-99d9-1183c8ad033d",
                                                "text": "„Die zweite Episode handelt von Farin, einem drallen, mächtigen Dealer, einem Pakistani.“"
                                            },
                                            {
                                                "example_id": "8d5ec70a-2eff-4870-9570-7d5599d53c26",
                                                "sense_id": "4a26fadd-bdc6-3aee-99d9-1183c8ad033d",
                                                "text": "„Auf anständige Weise verdient hier keiner sein Geld: Entweder man ist Nutte, Dealer oder Banker.“"
                                            },
                                            {
                                                "example_id": "8de4c61c-3fc1-42f6-be0d-e9d21282a686",
                                                "sense_id": "4a26fadd-bdc6-3aee-99d9-1183c8ad033d",
                                                "text": "„Ich stellte fest, dass es in meinem Viertel immer mehr Dealer gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d2f33c4-098d-3a84-bab5-54858df577ce",
                                        "entry_id": "9887fbab-c721-3ca3-aded-b3514dab7584",
                                        "glosses": [
                                            "jemand, der (mit Wertpapieren) an einer Börse handelt"
                                        ],
                                        "tags": [
                                            "Börse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d7d8269-8349-4539-add6-af74f979f685",
                                                "sense_id": "8d2f33c4-098d-3a84-bab5-54858df577ce",
                                                "text": "Als Dealer verdiene ich jeden Tag viel Geld in Frankfurt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9de9b45a-3c2e-4f2e-b86f-a0f1214d6237",
                        "source_entry_id": "43185eee-6f18-392c-8e06-44a6afeaddfc",
                        "source_sense_id": "c9c75f4e-3edc-3394-b8d8-2b632e59b350",
                        "target_lang_word": "Drogendealer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drogendealer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa8088a-3b9e-3694-8cad-4ecb17fac16a",
                                        "entry_id": "052209fd-0909-3809-80c7-6b5c6dbf54a8",
                                        "glosses": [
                                            "Person, welche Drogen kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6646b14d-e1fc-4214-9cbc-79e3b9420749",
                                                "sense_id": "4aa8088a-3b9e-3694-8cad-4ecb17fac16a",
                                                "text": "Der Drogendealer hat mich letztens wieder abgezogen."
                                            },
                                            {
                                                "example_id": "65984c9a-a770-4a81-8dab-d61e93c7e48e",
                                                "sense_id": "4aa8088a-3b9e-3694-8cad-4ecb17fac16a",
                                                "text": "„Die bereits erwähnte Freundin – Stichwort Meineid – wurde einige Jahre später von einem Drogendealer getötet.“"
                                            },
                                            {
                                                "example_id": "f1e7b3ed-b476-41cb-93b6-1a4f3836ae2c",
                                                "sense_id": "4aa8088a-3b9e-3694-8cad-4ecb17fac16a",
                                                "text": "„16 Polizeibeamte unterstehen ihm, sie sollen gegen Drogendealer vorgehen, Cafés kontrollieren, das Quartier entkriminalisieren, so weit das möglich ist.“"
                                            },
                                            {
                                                "example_id": "7fb398c4-9ac8-4fd7-a0e4-ec76a6becf95",
                                                "sense_id": "4aa8088a-3b9e-3694-8cad-4ecb17fac16a",
                                                "text": "„Nicht nur der Wähler oder Unternehmer oder der Kommunalpolitiker, sondern jeder Straßenkehrer, jeder Schülerlotse, jede Kindergärtnerin, ja, jeder Drogendealer bastelt am Staat mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
