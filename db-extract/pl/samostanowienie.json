                    },
                    {
                        "translation_id": "c44106da-2492-494a-bb13-d79360f9384f",
                        "source_entry_id": "40452876-87e6-3472-87fc-ff98186ce589",
                        "source_sense_id": "9b1d1c61-2a8d-3883-8888-4ff8b262c2ac",
                        "target_lang_word": "Selbstbestimmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbestimmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                                        "glosses": [
                                            "Verfügung einer Person oder eines Landes über die eigene Existenz; Freiheit in der persönlichen Willensbildung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0fa38d1-97df-4696-90e3-ce594c0688bf",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Es waren deutsche Schulen und Universitäten, die mir ein Leben in Selbstbestimmung ermöglicht haben.“"
                                            },
                                            {
                                                "example_id": "2b598680-64d2-4f09-a13b-e21f92024364",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Präsident Charles de Gaulle lässt schließlich ein Referendum zu – mit eindeutigem Ergebnis: Mehr als 95 Prozent der wahlbeteiligten Algerier votieren für die Selbstbestimmung des Landes.“"
                                            },
                                            {
                                                "example_id": "eaf3cc34-b8e2-44c0-9335-dff31b65716b",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Nach 1945 fordern sie als Belohnung für ihren Einsatz die politische Selbstbestimmung.“"
                                            },
                                            {
                                                "example_id": "e6380834-5a86-4296-8aee-5b1547fdb96d",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Individuelle Freiheit als Selbstbestimmung und Entgrenzung ist dabei das Leitmotiv.“"
                                            },
                                            {
                                                "example_id": "925b7caa-9568-436d-8e5c-ca68eac91bb3",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Die Freiheit des Einzelnen bedeutete für den britischen Philosophen John Stuart Mill auch ein Recht auf Selbstbestimmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                                        "glosses": [
                                            "eine Definition des eigenen Selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf10d79d-a5a8-42f6-b0d1-d59dca9ed7e4",
                                                "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                                                "text": "Entgegen gängiger Selbstbestimmungen von moderner Zeit als unendlichem Fortschreiten oder technischer Beschleunigung fragt das von Barbara Gronau (Professorin für Theorie und Geschichte des Theaters an der Universität der Künste Berlin) geleitete Symposium nach einem anderen Zeitdiskurs der Künste, welcher Unterbrechung, Stillstellung und Verlangsamung als kritisch-utopische Suchmomente beschreibt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d9c30b3-4eab-4fb2-8453-da8a62f18f2d",
                        "source_entry_id": "40452876-87e6-3472-87fc-ff98186ce589",
                        "source_sense_id": "9b1d1c61-2a8d-3883-8888-4ff8b262c2ac",
                        "target_lang_word": "самоопределе́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "самоопределе́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7447cf8e-2cc8-3c37-84fe-e65d9bf49916",
                                        "entry_id": "7244d515-18e4-3cad-996d-e4bb55082423",
                                        "glosses": [
                                            "действие по значению гл. самоопределяться, самоопределиться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def213fa-2159-472c-95d1-50630e38181d",
                                                "sense_id": "7447cf8e-2cc8-3c37-84fe-e65d9bf49916",
                                                "text": "Ясно, что время есть уже логическое заключение, вывод, вытекающий из самоопределения действия."
                                            },
                                            {
                                                "example_id": "f286ded8-c46b-4258-9277-5749d3b450f9",
                                                "sense_id": "7447cf8e-2cc8-3c37-84fe-e65d9bf49916",
                                                "text": "А в природе французской, да и вообще западной, его в наличности не оказалось, а оказалось начало личное, начало особняка, усиленного самосохранения, самопромышления, самоопределения в своем собственном Я, сопоставления этого Я всей природе и всем остальным людям, как самоправного отдельного начала, совершенно равного и равноценного всему тому, что есть кроме него."
                                            },
                                            {
                                                "example_id": "8bbc3003-8697-4be9-b479-45463ae3211b",
                                                "sense_id": "7447cf8e-2cc8-3c37-84fe-e65d9bf49916",
                                                "text": "Таким образом, уже в качестве субстанции божество необходимо обладает самоопределением и саморазличением, то есть личностью и сознанием."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0435c35-e0a6-36a6-af84-ec6e9c84cf8d",
                                        "entry_id": "7244d515-18e4-3cad-996d-e4bb55082423",
                                        "glosses": [
                                            "полит., юр. право нации на создание собственной национальной государственности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4510e8d2-c4d3-4158-bb5d-51bf63fc0163",
                                                "sense_id": "a0435c35-e0a6-36a6-af84-ec6e9c84cf8d",
                                                "text": "Как известно, курды, составляющие значительную, причём весьма активную, трудовую и часто наиболее образованную прослойку во многих странах Ближнего Востока и Азии, на протяжении многих лет вели активную борьбу за свои национальные права, за самоопределение, за автономию."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
