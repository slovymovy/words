                "senses": [
                    {
                        "sense_id": "469cde04-9abb-3283-a330-5f5dd33eecf0",
                        "entry_id": "6ead37f8-ee81-3ce2-9c3a-335e81197bc3",
                        "glosses": [
                            "Waldstück, in dem an ausgewählten Bäumen Totenasche beigesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27e79d15-e323-4b4d-9f7b-fc9d934886af",
                                "sense_id": "469cde04-9abb-3283-a330-5f5dd33eecf0",
                                "text": "Ich würde gerne in einem Friedwald beigesetzt werden."
                            },
                            {
                                "example_id": "d4f2f5ea-d98f-4e07-b722-afccf19f751f",
                                "sense_id": "469cde04-9abb-3283-a330-5f5dd33eecf0",
                                "text": "Die Beisetzung in einem Friedwald wird in der Regel als Feuerbestattung vollzogen."
                            },
                            {
                                "example_id": "d18e021a-9f57-42c7-96b0-2d6e45da0be7",
                                "sense_id": "469cde04-9abb-3283-a330-5f5dd33eecf0",
                                "text": "„Zu Amalia hätte ein Naturstein besser gepasst oder gleich ein Baum in einem Friedwald.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
