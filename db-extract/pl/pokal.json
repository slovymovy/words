                "senses": [
                    {
                        "sense_id": "caf1722c-2300-3947-a0ec-dbd80bb472d6",
                        "entry_id": "f1865018-7f1e-358a-a0ea-1c6db8f4c4bb",
                        "glosses": [
                            "duży, pękaty kielich do piwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d725e05-4018-42e3-8c64-819739c8572c",
                                "sense_id": "caf1722c-2300-3947-a0ec-dbd80bb472d6",
                                "text": "Był piwoszem i szczycił się swoją kolekcją kufli i pokali."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "238a9e6e-73a2-4589-8836-55cf440aac32",
                        "source_entry_id": "f1865018-7f1e-358a-a0ea-1c6db8f4c4bb",
                        "source_sense_id": "caf1722c-2300-3947-a0ec-dbd80bb472d6",
                        "target_lang_word": "Pokal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pokal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a29473c6-e2e5-37a3-8b65-0800abb41492",
                                        "entry_id": "bfd495ef-68c1-3ba9-8de9-49406eba85da",
                                        "glosses": [
                                            "prunkvolles Trinkgefäß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072df0e5-aac8-4c07-b998-5b6c090354ea",
                                                "sense_id": "a29473c6-e2e5-37a3-8b65-0800abb41492",
                                                "text": "Der König nahm einen kräftigen Schluck aus seinem Pokal."
                                            },
                                            {
                                                "example_id": "415ee9e7-5c7f-43f7-a163-df765904b42b",
                                                "sense_id": "a29473c6-e2e5-37a3-8b65-0800abb41492",
                                                "text": "„Die Überlieferung sagt, daß der Pokal nur einmal in jeder Generation benutzt werden darf: vom Gutserben bei seiner Hochzeit.“"
                                            },
                                            {
                                                "example_id": "579eee7d-e395-4d1b-84a0-d6637622e864",
                                                "sense_id": "a29473c6-e2e5-37a3-8b65-0800abb41492",
                                                "text": "„Sie füllte einen großen Pokal und bot ihn Väsele Li dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fa20a74-f5a4-330f-9e5f-8c8eaeb25617",
                                        "entry_id": "bfd495ef-68c1-3ba9-8de9-49406eba85da",
                                        "glosses": [
                                            "Siegertrophäe bei einem Sportwettbewerb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0d6ad9-02a8-4abd-97d4-71882ac37e21",
                                                "sense_id": "3fa20a74-f5a4-330f-9e5f-8c8eaeb25617",
                                                "text": "Als Gewinner des Turniers erhielten sie einen Pokal."
                                            },
                                            {
                                                "example_id": "140a7a00-bd83-4542-8539-7bff8c067bb1",
                                                "sense_id": "3fa20a74-f5a4-330f-9e5f-8c8eaeb25617",
                                                "text": "„Der Pokal der Europa League ist auf einer Werbetour in Mexiko zwischenzeitlich entwendet worden.“"
                                            },
                                            {
                                                "example_id": "ec35a636-9d69-4d05-9752-c7fa069d8f0b",
                                                "sense_id": "3fa20a74-f5a4-330f-9e5f-8c8eaeb25617",
                                                "text": "„Die abwärtsgehende Terz an jedem Morgen ist so sicher wie das Amen in der Kirche und das Überreichen des Pokals nach dem Pokalfinale.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0c61d29c-ccb7-3d1c-a425-5b0668a18885",
                                        "entry_id": "bfd495ef-68c1-3ba9-8de9-49406eba85da",
                                        "glosses": [
                                            "(meist sportlicher) Wettbewerb, dessen Gewinner einen Pokal erhält"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8720b003-29b6-4047-b87b-cd01312591d4",
                        "source_entry_id": "f1865018-7f1e-358a-a0ea-1c6db8f4c4bb",
                        "source_sense_id": "caf1722c-2300-3947-a0ec-dbd80bb472d6",
                        "target_lang_word": "бока́л",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бока́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "19540786-2c49-3933-8750-a0b2ae923869",
                                        "entry_id": "709ddab0-6a8c-3782-9d2b-695109f99475",
                                        "glosses": [
                                            "предмет посуды, сосуд для питья вина, сравнительно большой стакан на ножке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a903aeb-e05c-4dc2-ba85-a7adf4a2c6b7",
                                                "sense_id": "19540786-2c49-3933-8750-a0b2ae923869",
                                                "text": "Он поднялся из подвала в зал, взял в баре высокий бокал с водкой и зашел в свой кабинет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42400b97-9e41-388a-b6c2-dadaa20b7fd3",
                                        "entry_id": "709ddab0-6a8c-3782-9d2b-695109f99475",
                                        "glosses": [
                                            "разг. кружка объёмом 0,5 литра для питья кваса или пива"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236635ce-ad74-49d4-b71a-42e15ff83bbf",
                                                "sense_id": "42400b97-9e41-388a-b6c2-dadaa20b7fd3",
                                                "text": "Из одной 50-литровой бочки бармены отныне могут разлить не более 175 бокалов пива при сохранении прежней цены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1cad7ea-5645-3b61-9ba2-9bcacfc6a12d",
                                        "entry_id": "709ddab0-6a8c-3782-9d2b-695109f99475",
                                        "glosses": [
                                            "рег. (Казахстан, Украина, Воронеж) разг. сосуд в форме стакана с ручкой для холодных и горячих напитков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f750d2f8-6bfc-42c0-a66d-2654c55aedf8",
                                                "sense_id": "f1cad7ea-5645-3b61-9ba2-9bcacfc6a12d",
                                                "text": "«Какой большой кошмар — в бокале с чёрным чаем всплывает твой загадочный волнующий портрет!»"
                                            },
                                            {
                                                "example_id": "94cfdca7-b0a7-4a89-abdb-bdbcaa211612",
                                                "sense_id": "f1cad7ea-5645-3b61-9ba2-9bcacfc6a12d",
                                                "text": "Чай с показным удовольствием пью из огромного бокала с отбитой ручкой."
                                            },
                                            {
                                                "example_id": "fe216796-8d6e-4b72-810e-0c86a0c261d4",
                                                "sense_id": "f1cad7ea-5645-3b61-9ba2-9bcacfc6a12d",
                                                "text": "«Мне повторить [пива]», — Рыжий протянул бокал с отбитой ручкой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
