                {
                    "sense_id": "053a1c59-1da8-3884-a934-c36b1cd398cc",
                    "sense_definition": "Выражение удивления или несогласия в разговорной речи (обычно в повелительном наклонении).",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Подожди</w>, ты действительно хочешь туда пойти?",
                            "target_lang_translations": {
                                "en": "<w>Wait</w>, do you really want to go there?",
                                "nl": "<w>Wacht</w>, wil je daar echt naartoe gaan?",
                                "pl": "<w>Czekaj</w>, naprawdę chcesz tam iść?",
                                "de": "<w>Warte mal</w>, willst du wirklich dorthin gehen?",
                                "fr": "<w>Attends</w>, tu veux vraiment y aller ?",
                                "it": "<w>Aspetta</w>, vuoi davvero andare lì?",
                                "cs": "<w>Počkej</w>, ty tam opravdu chceš jít?",
                                "tr": "<w>Bir dakika</w>, gerçekten oraya gitmek istiyor musun?",
                                "es": "<w>Espera</w>, ¿de verdad quieres ir allí?",
                                "zh": "<w>等等</w>，你真的想去那里吗？"
                            }
                        },
                        {
                            "text": "<w>Подождите</w>, я совсем не это имел в виду!",
                            "target_lang_translations": {
                                "en": "<w>Wait</w>, that is not what I meant at all!",
                                "nl": "<w>Wacht</w>, dat is helemaal niet wat ik bedoelde!",
                                "pl": "<w>Chwileczkę</w>, wcale nie miałem tego na myśli!",
                                "de": "<w>Moment mal</w>, das habe ich überhaupt nicht gemeint!",
                                "fr": "<w>Attendez</w>, ce n'est pas du tout ce que je voulais dire !",
                                "it": "<w>Aspettate</w>, non intendevo affatto questo!",
                                "cs": "<w>Počkejte</w>, to jsem vůbec neměl na mysli!",
                                "tr": "<w>Durun</w>, kastettiğim şey kesinlikle bu değildi!",
                                "es": "<w>Esperen</w>, ¡eso no es lo que quería decir en absoluto!",
                                "zh": "<w>等一下</w>，我根本不是那个意思！"
                            }
                        }
                    ],
