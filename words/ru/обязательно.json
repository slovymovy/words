{
    "word_family": [
        "обязательный",
        "обязанность",
        "обязательство",
        "обязать",
        "необязательный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cab370c0-84b0-3e50-82dd-cd7a6934fb8d",
                    "sense_definition": "Непременно, при любых условиях; выражение твердого намерения или уверенности в том, что событие произойдет.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "definitely",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <обязательно> приду к тебе в гости завтра вечером.",
                            "target_lang_translations": {
                                "en": "I will <definitely> come visit you tomorrow evening.",
                                "es": "Iré a visitarte mañana por la tarde <w>sin falta</w>.",
                                "fr": "Je viendrai <absolument> te voir demain soir."
                            }
                        },
                        {
                            "text": "Мы <обязательно> должны посетить этот музей, пока мы в городе.",
                            "target_lang_translations": {
                                "en": "We <definitely> must visit this museum while we are in the city.",
                                "es": "Tenemos que visitar este museo <w>definitivamente</w> mientras estemos en la ciudad.",
                                "fr": "Nous devons <absolument> visiter ce musée pendant que nous sommes en ville."
                            }
                        }
                    ],
                    "synonyms": [
                        "непременно",
                        "безусловно",
                        "конечно же",
                        "точно",
                        "во что бы то ни стало"
                    ],
                    "common_phrases": [
                        "обязательно приду",
                        "обязательно надо",
                        "обязательно сделаю"
                    ],
                    "target_lang_definitions": {
                        "en": "Without fail, under any conditions; expressing firm intention or certainty that an event will happen.",
                        "es": "Sin falta, bajo cualquier condición; expresión de firme intención o certeza de que un evento ocurrirá.",
                        "fr": "Sans faute, quelles que soient les conditions; expression d'une intention ferme ou de la certitude qu'un événement se produira."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "definitely",
                                "target_lang_sense_clarification": "expressing certainty or firm intention"
                            },
                            {
                                "target_lang_word": "without fail",
                                "target_lang_sense_clarification": "guaranteeing an action will happen"
                            },
                            {
                                "target_lang_word": "for sure",
                                "target_lang_sense_clarification": "informal certainty"
                            },
                            {
                                "target_lang_word": "surely",
                                "target_lang_sense_clarification": "certainly; undoubtedly"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sin falta",
                                "target_lang_sense_clarification": "garantizando que se realizará la acción"
                            },
                            {
                                "target_lang_word": "definitivamente",
                                "target_lang_sense_clarification": "expresando certeza o firme intención"
                            },
                            {
                                "target_lang_word": "de todas maneras",
                                "target_lang_sense_clarification": "bajo cualquier circunstancia"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "absolument",
                                "target_lang_sense_clarification": "exprime une certitude ou une ferme intention"
                            },
                            {
                                "target_lang_word": "sans faute",
                                "target_lang_sense_clarification": "garantissant qu'une action aura lieu"
                            },
                            {
                                "target_lang_word": "à coup sûr",
                                "target_lang_sense_clarification": "avec certitude"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04438b67-ebc0-3674-8fbb-ab6eaa44fa7e",
                    "sense_definition": "В соответствии с требованиями или правилами; совершенно необходимо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "necessarily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед началом работы <обязательно> ознакомьтесь с инструкцией по безопасности.",
                            "target_lang_translations": {
                                "en": "Before starting work, <be sure to> read the safety instructions.",
                                "es": "Antes de empezar a trabajar, lea <w>obligatoriamente</w> las instrucciones de seguridad.",
                                "fr": "Avant de commencer le travail, lisez <impérativement> les consignes de sécurité."
                            }
                        },
                        {
                            "text": "Вам <обязательно> нужно заполнить эту форму для регистрации.",
                            "target_lang_translations": {
                                "en": "You <absolutely> need to fill out this form for registration.",
                                "es": "Tiene que rellenar este formulario <w>necesariamente</w> para registrarse.",
                                "fr": "Vous devez <obligatoirement> remplir ce formulaire pour vous inscrire."
                            }
                        }
                    ],
                    "synonyms": [
                        "необходимо",
                        "требуется"
                    ],
                    "antonyms": [
                        "необязательно"
                    ],
                    "common_phrases": [
                        "строго обязательно",
                        "не обязательно"
                    ],
                    "target_lang_definitions": {
                        "en": "In accordance with requirements or rules; absolutely necessary to do.",
                        "es": "De acuerdo con los requisitos o normas; absolutamente necesario de hacer.",
                        "fr": "Conformément aux exigences ou aux règles; absolument nécessaire."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "necessarily",
                                "target_lang_sense_clarification": "as a necessary condition"
                            },
                            {
                                "target_lang_word": "be sure to",
                                "target_lang_sense_clarification": "used in instructions or commands"
                            },
                            {
                                "target_lang_word": "make sure to",
                                "target_lang_sense_clarification": "imperative instruction"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "necesariamente",
                                "target_lang_sense_clarification": "como condición necesaria"
                            },
                            {
                                "target_lang_word": "obligatoriamente",
                                "target_lang_sense_clarification": "por norma o requisito obligado"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "obligatoirement",
                                "target_lang_sense_clarification": "selon une obligation ou une règle"
                            },
                            {
                                "target_lang_word": "impérativement",
                                "target_lang_sense_clarification": "de manière absolument nécessaire"
                            },
                            {
                                "target_lang_word": "absolument",
                                "target_lang_sense_clarification": "nécessité absolue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b64b1b-7f19-35c6-a0f1-3919b7e84fe1",
                    "sense_definition": "Проявляя внимание и готовность помочь; услужливо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хозяин дома <обязательно> предложил уставшим гостям чаю с дороги.",
                            "target_lang_translations": {
                                "en": "The host <obligingly> offered the tired guests tea after their journey.",
                                "es": "El dueño de la casa ofreció <w>amablemente</w> té a los cansados huéspedes tras el viaje.",
                                "fr": "Le maître de maison a <obligeamment> proposé du thé aux invités fatigués par le voyage."
                            }
                        },
                        {
                            "text": "Приказчик <обязательно> поклонился вошедшей в лавку даме.",
                            "target_lang_translations": {
                                "en": "The clerk <obligingly> bowed to the lady entering the shop.",
                                "es": "El dependiente hizo <w>atentamente</w> una reverencia a la dama que entró en la tienda.",
                                "fr": "Le commis s'est <obligeamment> incliné devant la dame qui entrait dans la boutique."
                            }
                        }
                    ],
                    "synonyms": [
                        "любезно",
                        "услужливо"
                    ],
                    "antonyms": [
                        "грубо"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Showing attention and readiness to help; in an obliging manner.",
                        "es": "Mostrando atención y disposición para ayudar; de manera servicial y atenta.",
                        "fr": "En faisant preuve d'attention et d'empressement à rendre service; avec complaisance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obligingly",
                                "target_lang_sense_clarification": "willing to do a service or kindness"
                            },
                            {
                                "target_lang_word": "courteously",
                                "target_lang_sense_clarification": "politely and respectfully"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "amablemente",
                                "target_lang_sense_clarification": "de manera cortés y servicial"
                            },
                            {
                                "target_lang_word": "atentamente",
                                "target_lang_sense_clarification": "mostrando atención y cortesía"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "obligeamment",
                                "target_lang_sense_clarification": "avec amabilité et empressement à rendre service"
                            },
                            {
                                "target_lang_word": "complaisamment",
                                "target_lang_sense_clarification": "de manière serviable et aimable"
                            }
                        ]
                    }
                }
            ]
        },
