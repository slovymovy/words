                "senses": [
                    {
                        "sense_id": "5eb3cdbe-b35d-38ad-9a27-126cc47ff4b8",
                        "entry_id": "9e71d7f7-dc02-3652-b366-f7ccbac7f261",
                        "glosses": [
                            "Produced by grating."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c88f78-e27e-4a64-a787-65bef7c13a1e",
                                "sense_id": "5eb3cdbe-b35d-38ad-9a27-126cc47ff4b8",
                                "text": "I topped my chili with grated cheese and my mango soufflé with grated orange rind."
                            }
                        ]
                    },
                    {
                        "sense_id": "02daa3b8-1c49-312c-83b3-d4fb2b051d69",
