            "pos": "name",
            "senses": [
                {
                    "sense_id": "94197bf3-6958-34b3-8307-96cf1b6fa3b8",
                    "sense_definition": "Jedyny Bóg w religiach monoteistycznych, uznawany za stwórcę i władcę wszechświata",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "monotheistic_god",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Wierzę, że <w>Bóg</w> czuwa nad moją rodziną.",
                            "target_lang_translations": {
                                "ru": "Я верю, что <w>Бог</w> оберегает мою семью.",
                                "en": "I believe that <w>God</w> watches over my family."
                            }
                        },
                        {
                            "text": "Dzięki <w>Bogu</w> nic złego się nie stało.",
                            "target_lang_translations": {
                                "ru": "Слава <w>Богу</w>, ничего плохого не случилось.",
                                "en": "Thank <w>God</w> nothing bad happened."
                            }
                        }
                    ],
                    "synonyms": [
                        "Pan",
                        "Stwórca",
                        "Najwyższy",
                        "Wszechmogący",
                        "Opatrzność",
                        "Bozia"
                    ],
                    "antonyms": [
                        "diabeł",
                        "lucyfer",
                        "belzebub"
                    ],
                    "common_phrases": [
                        "dzięki Bogu",
                        "broń Boże",
                        "Szczęść Boże",
                        "niech to Bóg broni",
                        "jak trwoga to do Boga"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единый Бог в монотеистических религиях, признаваемый творцом и правителем вселенной",
                        "en": "The sole supreme being and creator of the universe in monotheistic religions"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бог",
                                "target_lang_sense_clarification": "Творец, Всевышний"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "God",
                                "target_lang_sense_clarification": "Supreme Being in monotheism"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0715ab79-607f-37ea-9753-badcab397cb3",
                    "sense_definition": "W wierzeniach politeistycznych: istota nadprzyrodzona mająca wpływ na losy ludzi i zjawiska przyrody",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "polytheistic_deity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mars był rzymskim <w>bogiem</w> wojny.",
                            "target_lang_translations": {
                                "ru": "Марс был римским <w>богом</w> войны.",
                                "en": "Mars was the Roman <w>god</w> of war."
                            }
                        },
                        {
                            "text": "Starożytni Grecy wierzyli w wielu różnych <w>bogów</w>.",
                            "target_lang_translations": {
                                "ru": "Древние греки верили во множество разных <w>богов</w>.",
                                "en": "The ancient Greeks believed in many different <w>gods</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bóstwo",
                        "bożyszcze",
                        "bożec"
                    ],
                    "common_phrases": [
                        "bóg wojny",
                        "bóg słońca",
                        "bóg płodności"
                    ],
                    "target_lang_definitions": {
                        "ru": "В политеистических верованиях: сверхъестественное существо, влияющее на судьбы людей и природные явления",
                        "en": "A supernatural being or deity worshipped in polytheistic religions, believed to control aspects of nature or human fortune"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бог",
                                "target_lang_sense_clarification": "божество"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "god",
                                "target_lang_sense_clarification": "deity in polytheism"
                            },
                            {
                                "target_lang_word": "deity",
                                "target_lang_sense_clarification": "divine being"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f27e660-bcc4-3c72-be1c-6fefa13e68a1",
                    "sense_definition": "Osoba niezwykle podziwiana, uwielbiana i otaczana czcią przez innych ludzi",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_idol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dla wielu nastolatków ten piosenkarz jest prawdziwym <w>bogiem</w>.",
                            "target_lang_translations": {
                                "ru": "Для многих подростков этот певец является настоящим <w>богом</w>.",
                                "en": "For many teenagers, this singer is a real <w>god</w>."
                            }
                        },
                        {
                            "text": "W swoim klubie trener był <w>bogiem</w> – kibice nosili go na rękach po każdym zwycięstwie.",
                            "target_lang_translations": {
                                "ru": "В своём клубе тренер был <w>богом</w> — болельщики носили его на руках после каждой победы.",
                                "en": "At his club, the coach was a <w>god</w> – the fans carried him on their shoulders after every victory."
                            }
                        }
                    ],
                    "synonyms": [
                        "idol",
                        "bożyszcze"
                    ],
                    "common_phrases": [
                        "czuć się jak młody bóg",
                        "wyglądać jak młody bóg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которым чрезвычайно восхищаются, которого обожают и почитают другие люди",
                        "en": "A person who is greatly admired, idealized, or revered by others"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бог",
                                "target_lang_sense_clarification": "кумир, идол"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "god",
                                "target_lang_sense_clarification": "figuratively, an idolized person"
                            },
                            {
                                "target_lang_word": "idol",
                                "target_lang_sense_clarification": "someone greatly admired"
                            }
                        ]
                    }
                }
            ]
        }
