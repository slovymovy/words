                                                "example_id": "84834234-5524-45b6-8495-9f0c946fe502",
                                                "sense_id": "43585f0b-cfc5-3873-ba73-d235cac9c208",
                                                "text": "Protože jsme s sebou měli naftový generátor a svítilny, mohli jsme pracovat dlouho do noci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a75671-2811-3143-bbf4-fb484ca1d2d4",
                                        "entry_id": "8ef706a3-4280-3520-8b4a-db26b49212d8",
                                        "glosses": [
                                            "jakékoli zařízení (i nehmotné povahy), sloužící k vytváření (generování) určitých výsledků či signálů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c2a6a6-5d6e-4d89-9579-ddd17cfc8f27",
                                                "sense_id": "26a75671-2811-3143-bbf4-fb484ca1d2d4",
                                                "text": "Základem této počítačové hry je generátor náhodných čísel."
                                            },
                                            {
                                                "example_id": "de889e2b-5f80-4dc5-a595-a5a69663df38",
                                                "sense_id": "26a75671-2811-3143-bbf4-fb484ca1d2d4",
                                                "text": "generátor vteřinových pulzů"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
