                "senses": [
                    {
                        "sense_id": "c9462928-d979-3374-9505-12806c53380a",
                        "entry_id": "04841ced-7fd0-3fb9-af74-061c05066c24",
                        "glosses": [
                            "смочить немного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea671a1a-7dbe-43a5-b36e-1edbae899a2c",
                                "sense_id": "c9462928-d979-3374-9505-12806c53380a",
                                "text": "Алина пробует примочить водой ее буйные кудри, но Динка равнодушно говорит, что «тогда они будут еще хуже»."
                            }
                        ]
                    },
                    {
                        "sense_id": "b74b0e27-95c6-37ea-9988-e4aafa1904c2",
                        "entry_id": "04841ced-7fd0-3fb9-af74-061c05066c24",
                        "glosses": [
                            "приложить примочку или что-либо мокрое (к больному месту)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e74c0d1-a158-46a7-814e-61282e3b9800",
                                "sense_id": "b74b0e27-95c6-37ea-9988-e4aafa1904c2",
                                "text": "За расспросами советы пойдут: напиться на ночь той либо другой травки, примочить голову уксусом, приложить горчишник."
                            }
                        ]
                    }
