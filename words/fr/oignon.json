                    "frequency": "High",
                    "semantic_group_id": "botanique_alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle coupe un <w>oignon</w> en petits morceaux pour préparer la sauce tomate."
                        },
                        {
                            "text": "Le chef fait revenir les <w>oignons</w> dans un peu d'huile d'olive."
                        }
                    ],
                    "common_phrases": [
