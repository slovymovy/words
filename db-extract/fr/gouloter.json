                "senses": [
                    {
                        "sense_id": "edaece4f-929e-346c-898a-b692c0f7ea7d",
                        "entry_id": "d0f1c5b1-4a8b-3094-8cd3-a52e9624afb6",
                        "glosses": [
                            "Prendre un verre, voire plusieurs."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "977564d2-5910-4788-9c48-7a85b0541260",
                                "sense_id": "edaece4f-929e-346c-898a-b692c0f7ea7d",
                                "text": "A cette occasion, les villageois se rassemblaient autour de la flambée, chantant, buvant et dansant jusqu'à l'aube sous la surveillance de quelques soldats de la Wehrmacht, pas bien méchants et qui ne rechignaient pas eux-mêmes à gouloter."
                            },
                            {
                                "example_id": "1d3466cc-c7c0-4b84-9f91-e3367c6d9b94",
                                "sense_id": "edaece4f-929e-346c-898a-b692c0f7ea7d",
                                "text": "— Hé ho ! Vous n'êtes pas venus là pour poser du lino que je sache ! Allez, venez gouloter un peu, tout le monde vous attend."
                            },
                            {
                                "example_id": "bf5571cf-02c2-4039-86c6-fcab13f86434",
                                "sense_id": "edaece4f-929e-346c-898a-b692c0f7ea7d",
                                "text": "Dans le verre: Le taulier donne à gouloter ce qu'il aime, soit 300 références de vins d'auteur et 14 jajas au verre (entre 5,5 et 12,50 euros les 12 cl)."
                            }
                        ]
                    }
                ],
