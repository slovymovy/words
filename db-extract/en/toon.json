                                "sense_id": "6c134353-3bf0-32be-b380-10ddf633088a",
                                "text": "Each plot held 10 cull trees so that 60 Australian toon and 40 tropical ash trees were treated."
                            }
                        ]
                    },
                    {
                        "sense_id": "7eabea22-e5df-3370-959c-7034d6c330f1",
                        "entry_id": "8ca13a46-0f17-3a5e-a724-84d4fe9c25bd",
