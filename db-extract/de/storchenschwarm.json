                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1164e202-6ba5-4f23-a42f-5c5430f83708",
                                "sense_id": "cbd705d2-29a4-34ec-869f-e06d1927b314",
                                "text": "„Ich lernte, dass Storchenschwärme immer am Josefstag von ihrer Reise über die fernen Meere eintrafen und im Dorf blieben, bis der Bartholomäustag sämtliche Frösche in den Schlamm trieb.“"
                            },
                            {
                                "example_id": "c245c021-2f13-4196-9850-6f8f526da7c1",
                                "sense_id": "cbd705d2-29a4-34ec-869f-e06d1927b314",
                                "text": "„Ein Storchenschwarm landet in der Kreisstadt und ruht sich auf einem Hausdach aus.“"
                            }
                        ],
