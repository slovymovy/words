                            {
                                "example_id": "1d3c148b-f835-41c1-80e2-2722d90817f4",
                                "sense_id": "68347132-f22c-38be-8b76-7d6eb2440695",
                                "text": "Oganeson nie występuje naturalnie i jest bardzo nietrwały."
                            }
