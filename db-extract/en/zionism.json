                "word": "Zionism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9956534d-b00e-474c-99ba-b743ca4f8300",
                        "entry_id": "f1cdfa10-f35d-3f49-8aa6-a388a4d35a28",
                        "tags": [
                            "plural"
