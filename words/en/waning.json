        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4a6d782f-328a-30a4-af6f-55e589559489",
                    "sense_definition": "Gradually becoming weaker, smaller, or less important.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made one last effort despite his <w>waning</w> strength.",
                            "target_lang_translations": {
                                "ru": "Он сделал последнее усилие, несмотря на <w>иссякающие</w> силы."
                            }
                        },
                        {
                            "text": "The party suffered from <w>waning</w> popularity in recent public opinion polls.",
                            "target_lang_translations": {
                                "ru": "Партия пострадала из-за <w>падающей</w> популярности в последних опросах общественного мнения."
                            }
                        }
                    ],
                    "synonyms": [
                        "declining",
                        "diminishing",
                        "dwindling",
                        "fading"
                    ],
                    "antonyms": [
                        "growing",
                        "increasing",
                        "rising"
                    ],
                    "common_phrases": [
                        "waning influence",
                        "waning interest",
                        "waning popularity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно становящийся слабее, меньше или менее значимым; идущий на спад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угасающий",
                                "target_lang_sense_clarification": "об интересе, силе или популярности"
                            },
                            {
                                "target_lang_word": "ослабевающий",
                                "target_lang_sense_clarification": "о силе, влиянии"
                            },
                            {
                                "target_lang_word": "иссякающий",
                                "target_lang_sense_clarification": "о силах, ресурсах"
                            },
                            {
                                "target_lang_word": "падающий",
                                "target_lang_sense_clarification": "о популярности, интересе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad0745a4-ce46-3f46-8abe-336a0e6f104d",
                    "sense_definition": "Relating to the moon's phase when the illuminated area is decreasing from full to new.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lunar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see the outline of trees under the <w>waning</w> moon.",
                            "target_lang_translations": {
                                "ru": "Мы могли видеть очертания деревьев под <w>убывающей</w> луной."
                            }
                        },
                        {
                            "text": "A <w>waning</w> crescent hung low in the morning sky.",
                            "target_lang_translations": {
                                "ru": "<w>Убывающий</w> полумесяц висел низко в утреннем небе."
                            }
                        }
                    ],
                    "antonyms": [
                        "waxing"
                    ],
                    "common_phrases": [
                        "waning moon",
                        "waning crescent",
                        "waning gibbous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к фазе Луны, когда освещённая область уменьшается от полнолуния к новолунию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убывающий",
                                "target_lang_sense_clarification": "о Луне"
                            },
                            {
                                "target_lang_word": "стареющий",
                                "target_lang_sense_clarification": "о фазе Луны"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5abb382f-c50e-32c5-91d8-a4679afdb00d",
                    "sense_definition": "A gradual decrease in size, strength, importance, or intensity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>waning</w> of her enthusiasm surprised everyone on the team.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>угасание</w> её энтузиазма удивило всех в команде."
                            }
