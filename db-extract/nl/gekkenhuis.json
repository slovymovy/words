                        "examples": [
                            {
                                "example_id": "b26fdc27-abb2-425e-a388-57e1064d7e36",
                                "sense_id": "4798bb1a-0a7e-37dd-8a65-f61f866ed8b4",
                                "text": "Zij werd direct naar het gekkenhuis overgebracht nadat ze haar man omgebracht had."
                            },
                            {
                                "example_id": "a43a826a-538e-42f8-8219-bab7b64b927f",
                                "sense_id": "4798bb1a-0a7e-37dd-8a65-f61f866ed8b4",
                                "text": "Het waren een arts en een advocaat die om de beurt een toespraak hielden over dat het soms noodzakelijk was om mensen in het gekkenhuis te stoppen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7101450-4fd0-3576-a995-ec13351ae9e1",
                        "entry_id": "3e593554-a11b-3d2a-afa6-756aad17ba10",
                        "glosses": [
                            "overdrachtelijk een chaotische toestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd25a7ae-5e79-480a-9e4c-bd8c6dbb8176",
                                "sense_id": "c7101450-4fd0-3576-a995-ec13351ae9e1",
                                "text": "Door al die hulpverleners werd het al gauw een gekkenhuis."
                            },
                            {
                                "example_id": "a67717b6-c3b5-4895-b21e-88f473c22901",
                                "sense_id": "c7101450-4fd0-3576-a995-ec13351ae9e1",
                                "text": "En met de Duitse organisatie en techniek kon er de hoognodige orde komen in het Franse gekkenhuis."
                            }
                        ]
                    }
