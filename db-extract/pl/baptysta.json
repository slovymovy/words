                "senses": [
                    {
                        "sense_id": "5c43ba4e-f15b-31f5-af32-87a67930e31b",
                        "entry_id": "6c80d318-ceb7-3ac7-bd68-f845e5c08853",
                        "glosses": [
                            "członek jednego z Kościołów protestanckich, który uznaje wyłącznie chrzest w wieku świadomym na wyznanie wiary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd75d56-0409-44cd-babf-c9e5ed70374e",
                                "sense_id": "5c43ba4e-f15b-31f5-af32-87a67930e31b",
                                "text": "Tadeusz jest baptystą, więc nie ochrzcił swojego dziecka jako niemowlęcia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf6592d5-caab-49b2-ad66-b7ae84a81ba7",
                        "source_entry_id": "6c80d318-ceb7-3ac7-bd68-f845e5c08853",
                        "source_sense_id": "5c43ba4e-f15b-31f5-af32-87a67930e31b",
                        "target_lang_word": "Baptist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baptist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3068861-086f-33e4-a9e2-ec2c148d4a3f",
                                        "entry_id": "253b69c6-9d61-3a60-8324-7948b007d7a1",
                                        "glosses": [
                                            "An adherent of a Protestant denomination (or various subdenominations) of Christianity, which believes in the baptism of believers (sometimes only adults), as opposed to the baptism of infants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Baptist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a99440bc-9d5b-3d1e-96d3-146f20a263e7",
                                        "entry_id": "da576015-9bae-3177-adb7-87e95bdacc7e",
                                        "glosses": [
                                            "Of, relating to, or adhering to the Baptist religious denomination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d65183-bb12-4ba7-83a0-4f975854f799",
                                                "sense_id": "a99440bc-9d5b-3d1e-96d3-146f20a263e7",
                                                "text": "One of the village's most notable sons was Thomas Grantham, a Baptist church leader born in 1634, who was persecuted and imprisoned in the struggle for nonconformist beliefs during the reign of Charles II."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da06d9c0-e8b1-41fa-8797-257db9fda8fe",
                        "source_entry_id": "6c80d318-ceb7-3ac7-bd68-f845e5c08853",
                        "source_sense_id": "5c43ba4e-f15b-31f5-af32-87a67930e31b",
                        "target_lang_word": "baptista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "41be46fe-3d93-4171-a1c5-7e9888f477e2",
                        "source_entry_id": "6c80d318-ceb7-3ac7-bd68-f845e5c08853",
                        "source_sense_id": "5c43ba4e-f15b-31f5-af32-87a67930e31b",
                        "target_lang_word": "baptiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baptiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18859e30-ef6f-3987-a1e3-1c491bc435f9",
                                        "entry_id": "2e055170-6332-396e-9aba-5d5fd4c50d4b",
                                        "glosses": [
                                            "Qui a rapport au baptisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b25313bf-88d5-40c1-bcea-50b0c6721cba",
                                                "sense_id": "18859e30-ef6f-3987-a1e3-1c491bc435f9",
                                                "text": "Dans une église baptiste en particulier, la musique est une expérience beaucoup plus intense, plus physique. Elle commande la danse, le mouvement. Elle est la colle qui soude les âmes et les corps entre eux pour s’élever vers Dieu. Elle est le rythme de l’extase mystique."
                                            },
                                            {
                                                "example_id": "52de187f-ee5a-487b-975e-309fb80cc214",
                                                "sense_id": "18859e30-ef6f-3987-a1e3-1c491bc435f9",
                                                "text": "La voix d’Al Sharpton s’élève, puissante, dans la nef de l’église baptiste de Mount Pilgrim dans le West Side Chicago."
                                            },
                                            {
                                                "example_id": "6b57cc81-514b-42d2-9463-788f67f590ec",
                                                "sense_id": "18859e30-ef6f-3987-a1e3-1c491bc435f9",
                                                "text": "Je m’étais toujours montré correct envers elle, mais elle devait savoir que je n’avais pas une grande tendresse pour sa vision du monde désespérément baptiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baptiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23e70fa6-a363-39fd-b05d-3c99a32071a7",
                                        "entry_id": "78c42a97-f2b6-3898-aafd-798887ecfdd6",
                                        "glosses": [
                                            "Adepte du baptisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa7a6c9-7f41-420d-9560-347ef4cb52a9",
                                                "sense_id": "23e70fa6-a363-39fd-b05d-3c99a32071a7",
                                                "text": "Les baptistes étant égaux dans leur Salut et dans leur rapport avec Dieu, ils attribuent les différences de comportement à des différences de maturité spirituelle."
                                            },
                                            {
                                                "example_id": "e8511d06-2be0-4537-bed0-c269cd7bdeda",
                                                "sense_id": "23e70fa6-a363-39fd-b05d-3c99a32071a7",
                                                "text": "Les baptistes laveurs de pieds sont une subdivision des baptistes primitifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b58f5240-08ae-41ca-99ef-4db9fea06d94",
                        "source_entry_id": "6c80d318-ceb7-3ac7-bd68-f845e5c08853",
                        "source_sense_id": "5c43ba4e-f15b-31f5-af32-87a67930e31b",
