                "senses": [
                    {
                        "sense_id": "14c51b15-cd2c-3bf8-912a-2419d322edd7",
                        "entry_id": "57576387-19f1-3c82-83c6-5d437612e52f",
                        "glosses": [
                            "niet terug te brengen naar de oorsprong"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ac362d5-bc82-4c9c-af6c-4cf6a52e736b",
                                "sense_id": "14c51b15-cd2c-3bf8-912a-2419d322edd7",
                                "text": "Elk benoembaar voorwerp bezat een rafelige omtrek, een onregelmatige kartelrand, waar de vorm in onherleidbaar poeder verdampte."
                            },
                            {
                                "example_id": "6ce85ed4-ff1c-4e4c-aadd-31f00c49eaf0",
                                "sense_id": "14c51b15-cd2c-3bf8-912a-2419d322edd7",
                                "text": "Dat betekent dat de patiëntengegevens onherleidbaar moeten zijn. De versleuteling is volgens het CBP niet voldoende om dit te doen, het is \"slechts een beveiligingsmaatregel om privacyrisico’s te verkleinen\"."
                            }
                        ]
                    }
