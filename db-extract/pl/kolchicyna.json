                        "entry_id": "248beae7-ad61-3a8b-9c39-59ccff3fcfcc",
                        "glosses": [
                            "związek organiczny z grupy alkaloidów, silnie trująca, otrzymywana z nasion zimowita jesiennego, stosowana w leczeniu napadów zapalenia stawów w przebiegu dny moczanowej i leczeniu rodzinnej gorączki śródziemnomorskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b2ceb5e-c068-47ef-8c80-91351490544a",
                                "sense_id": "071bde81-28b3-3ad3-80b9-dc46b3666311",
                                "text": "Nawet lecznicze dawki kolchicyny są toksyczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
