                "senses": [
                    {
                        "sense_id": "d6cd672a-3fa1-3779-a155-9fa21119299d",
                        "entry_id": "9504daba-35ef-3ddf-b283-e3cc5470b747",
                        "glosses": [
                            "A tree of species Sideroxylon spinosum (formerly Argania spinosa), of southwestern Morocco, particularly prized for its oil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8ac361-1b90-4528-9a55-e555abc1c95e",
                                "sense_id": "d6cd672a-3fa1-3779-a155-9fa21119299d",
                                "text": "When pressed, the argan tree’s fruit produces a luxurious oil which is rich in fatty acids, omega-6 and vitamin E. Argan is said to help treat many skin and hair conditions."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f4bb422-0772-38f9-ad26-ce7bc7813427",
                        "entry_id": "9504daba-35ef-3ddf-b283-e3cc5470b747",
                        "glosses": [
                            "Fruit of this tree."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "030dc595-51cf-4561-9691-c94fbf79de17",
                        "source_entry_id": "9504daba-35ef-3ddf-b283-e3cc5470b747",
                        "source_sense_description": "tree",
                        "target_lang_word": "arganier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arganier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6653e05a-f1d4-3d60-b03f-d81c8ffcea68",
                                        "entry_id": "6fae0312-ad12-3659-b759-c357176f4030",
                                        "glosses": [
                                            "Nom usuel de Argania spinosa, arbre endémique de la région côtière du sud-ouest du Maroc, de la famille des Sapotaceae (Sapotacées), dont la graine oléagineuse fournie de l'huile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbfd77fe-aa2c-451e-bd1f-1649b986e311",
                                                "sense_id": "6653e05a-f1d4-3d60-b03f-d81c8ffcea68",
                                                "text": "C’est d’abord cette océanité qui règle, dans le Sud marocain, la répartition de l’arganier."
                                            },
                                            {
                                                "example_id": "6da2cd91-ee6b-45e4-940d-f6506573a65d",
                                                "sense_id": "6653e05a-f1d4-3d60-b03f-d81c8ffcea68",
                                                "text": "C’est un des reliefs les plus vieux du monde, lente ondulation de collines de schistes et de grès, qui sert de marchepied au socle granitique du désert. Il y a encore des touffes d’arbustes, quelques arganiers, des gommiers, qui indiquent la présence du formidable courant d’eau souterrain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
