                                    {
                                        "sense_id": "eea0412a-7670-3b5d-8211-dac408fcf3d6",
                                        "entry_id": "3a0ab389-c55d-3597-ac23-1bb75653ad66",
                                        "glosses": [
                                            "Stellvertreterin eines Präsidenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3de655-fc02-4fdd-96da-d14e234e793a",
                                                "sense_id": "eea0412a-7670-3b5d-8211-dac408fcf3d6",
                                                "text": "„Für Präsident und Vizepräsidentin gelten strengere Voraussetzungen als für Verfassungsrichter.“"
                                            },
                                            {
                                                "example_id": "5b0180ca-92b5-41de-9c94-e7862e9ca316",
                                                "sense_id": "eea0412a-7670-3b5d-8211-dac408fcf3d6",
                                                "text": "„2004 hatte Solomon Mujuru sich gegen seinen Rivalen Emmerson Mnangagwa durchgesetzt, als nicht dieser, sondern Mujurus Frau Joice Vizepräsidentin des Landes wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
