                "senses": [
                    {
                        "sense_id": "e0b7ca14-ca3c-3212-a90c-704085bc33a8",
                        "entry_id": "88e129a3-5419-35c8-8b9a-fd96513dc593",
                        "glosses": [
                            "Machine utilisée pour poncer une surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb13aa56-22d1-44fb-82d4-c4eb74785401",
                                "sense_id": "e0b7ca14-ca3c-3212-a90c-704085bc33a8",
                                "text": "La bande abrasive d’une ponceuse tourne continuellement, si bien que vous devez toujours déplacer la machine à la même vitesse. Si vous immobilisez la ponceuse quelques instants, elle fera son trou jusqu’au garage."
                            }
                        ]
                    },
                    {
                        "sense_id": "872f1595-db2a-3799-a461-d8aaa8fe0def",
                        "entry_id": "88e129a3-5419-35c8-8b9a-fd96513dc593",
                        "glosses": [
                            "Celle qui ponce."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36674713-2e54-4b87-a264-fc0d0c843966",
                        "source_entry_id": "88e129a3-5419-35c8-8b9a-fd96513dc593",
                        "source_sense_id": "e0b7ca14-ca3c-3212-a90c-704085bc33a8",
                        "source_sense_description": "Machine",
                        "target_lang_word": "Schleifmaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schleifmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                                        "entry_id": "fd386d07-02b9-30a5-8137-7efb9842405d",
                                        "glosses": [
                                            "Elektrowerkzeug, typischerweise mit zwei sich drehenden Schleifscheiben, das zum Schleifen, Glätten und Formen von Materialien, normalerweise Metall, verwendet wird und für die dauerhafte Montage auf einer Werkbank ausgelegt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca486eb-be8b-41e4-8e71-d4b2752646c7",
                                                "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                                                "text": "„Binnen kürzester Zeit habe ich die Schleifmaschine angeschlossen und eingeschaltet.“"
                                            },
                                            {
                                                "example_id": "8b63e141-9827-4e6a-a824-0dc9c44eafe5",
                                                "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                                                "text": "„Ein junger Mann sagte, ein Schmirgel reiche nicht aus, man müsse eine Schleifmaschine verwenden.“"
                                            },
                                            {
                                                "example_id": "23581fca-0cc1-4a89-9833-41e11baad802",
                                                "sense_id": "2345ac4e-f75e-3513-9d0d-cd26564cf346",
                                                "text": "„Wenn eine neue Schleifscheibe auf die Schleifmaschine gebracht worden ist, so muß darauf geachtet werden, daß die Schutzhaube wieder richtig angebracht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b906d39-809e-4ac9-a665-f9abe2ca98e2",
                        "source_entry_id": "88e129a3-5419-35c8-8b9a-fd96513dc593",
                        "source_sense_id": "e0b7ca14-ca3c-3212-a90c-704085bc33a8",
