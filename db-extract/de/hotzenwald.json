                                "example_id": "50e3ce8d-7332-42da-b1a1-dec8be00c670",
                                "sense_id": "7c5aa71a-dcf2-35ed-9331-e55386db99b3",
                                "text": "„Viele Freiburger scheinen den Hotzenwald zu lieben oder wollen ihn kennenlernen, denn sie bildeten neben den Schweizern aus dem Kanton Aargau das größte Kontingent.“"
                            },
                            {
                                "example_id": "c66be9c7-f05a-4b53-b727-fbc4383dffec",
                                "sense_id": "7c5aa71a-dcf2-35ed-9331-e55386db99b3",
                                "text": "„Vor 90 Jahren wurden auf dem Hotzenwald erste motorlose Flüge unternommen.“"
                            },
                            {
                                "example_id": "10b1a22a-cddd-4376-82e0-7aad7c39c002",
                                "sense_id": "7c5aa71a-dcf2-35ed-9331-e55386db99b3",
                                "text": "„Im Hotzenwald ist ein tonnenschwerer Felsbrocken aus der Albtalschlucht geschwebt.“"
