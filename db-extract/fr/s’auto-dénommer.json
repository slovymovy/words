                "senses": [
                    {
                        "sense_id": "8f1cc5de-8017-3ce5-ae03-1e8f83d60508",
                        "entry_id": "7d8637c8-4e0f-3adb-bdcd-565b2b292f87",
                        "glosses": [
                            "Se nommer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "764ef265-2505-456d-ac68-4704809e53d1",
                                "sense_id": "8f1cc5de-8017-3ce5-ae03-1e8f83d60508",
                                "text": "C’est-à-dire pratiquer la résistance quotidienne et nous auto-dénommer Noir-e-s. En effet, seul le fait de nous auto-dénommer ainsi produit un sens d’identité assumée positivement, et il s’agit là d'une manière valable de subvertir le système."
                            },
                            {
                                "example_id": "e1071954-980d-4096-b816-4bc837fa6d42",
                                "sense_id": "8f1cc5de-8017-3ce5-ae03-1e8f83d60508",
                                "text": "La plupart d’entre eux, entretenant un flou terminologique bien commode, continuent en effet de s’auto-dénommer « lycées français »."
                            }
                        ]
                    }
