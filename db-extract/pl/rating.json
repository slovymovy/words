                        "entry_id": "96bc2074-8719-3dda-b3f3-2299eb928ca8",
                        "glosses": [
                            "dokonana przez wyspecjalizowaną instytucję ocena wiarygodności kredytowej podmiotu gospodarczego lub państwa i ryzyka inwestycyjnego związanego z określonymi jego papierami wartościowymi bądź jego zdolnością do spłaty swoich zobowiązań w terminie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "390b0451-c77d-4bf7-9497-2bad2c9a5315",
                                "sense_id": "0c5e34ec-26de-3650-8871-5ca05a8fe784",
                                "text": "Amerykańska agencja ratingowa Standard & Poor's obniżyła w sierpniu 2011 rating rządu USA z maksymalnej oceny AAA do AA+."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
