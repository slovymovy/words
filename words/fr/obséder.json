                {
                    "sense_id": "efc33286-445c-3982-b5b5-7b0ff58c2c85",
                    "sense_definition": "Occuper l'esprit de manière continue et involontaire, tourmenter ou hanter durablement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible vision continue d'<w>obséder</w> son esprit même après plusieurs semaines de repos."
                        },
                        {
                            "text": "Une idée fixe commence à l'<w>obséder</w> et l'empêche de trouver le sommeil chaque nuit."
                        }
                    ],
                    "synonyms": [
                        "hanter",
                        "préoccuper",
                        "tourmenter"
                    ],
                    "antonyms": [
                        "apaiser",
                        "rassurer"
                    ],
                    "common_phrases": [
                        "obséder l'esprit",
                        "obséder les pensées"
                    ]
                },
                {
                    "sense_id": "48f3cbe8-32ec-3db4-a1a3-49e78b6e330c",
                    "sense_definition": "Importuner quelqu'un sans relâche par des sollicitations, des démarches ou une assiduité pénible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importuner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les créanciers ne cessent d'<w>obséder</w> cet homme endetté dès les premières heures du jour."
                        },
                        {
                            "text": "Ce journaliste insistant <w>obsédait</w> le ministre de questions indiscrètes tout au long du déplacement."
                        }
                    ],
                    "synonyms": [
                        "harceler",
                        "importuner",
                        "incommoder"
                    ],
                    "common_phrases": [
                        "obséder de questions",
                        "obséder de demandes"
                    ]
                },
                {
                    "sense_id": "a48585ce-fab1-3bcd-98fb-38c33d105c80",
                    "sense_definition": "Entourer quelqu'un avec insistance pour s'en assurer la faveur ou pour l'isoler des autres.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "assieger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs flatteurs habiles <w>obsédaient</w> le monarque pour éloigner les conseillers les plus intègres de la cour."
                        },
                        {
                            "text": "Ce jeune prétendant cherchait à <w>obséder</w> l'héritière afin d'écarter tous ses rivaux du salon."
                        }
                    ],
