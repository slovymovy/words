                                                "example_id": "494c6eee-4b25-4609-a698-a60d99067a45",
                                                "sense_id": "8c8187ef-ee10-32c9-96ce-fe75568f16f4",
                                                "text": "Warst du auch bei der Asche?"
                                            }
                                        ],
