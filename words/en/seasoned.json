                },
                {
                    "sense_id": "7e4f1cc5-c5ad-3d2d-88d9-add0e859394e",
                    "sense_definition": "Having a lot of experience and skill in a particular activity, job, or field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>seasoned</w> traveller, she always knew how to navigate unfamiliar airports.",
                            "target_lang_translations": {
                                "pl": "Jako <w>doświadczona</w> podróżniczka zawsze wiedziała, jak poruszać się po nieznanych lotniskach."
                            }
                        },
                        {
                            "text": "Even a <w>seasoned</w> professional can make a mistake under extreme pressure.",
                            "target_lang_translations": {
                                "pl": "Nawet <w>doświadczony</w> profesjonalista może popełnić błąd pod wpływem ogromnej presji."
                            }
                        }
                    ],
                    "synonyms": [
                        "experienced",
                        "veteran",
                        "practised"
                    ],
                    "antonyms": [
                        "inexperienced",
                        "novice"
                    ],
                    "common_phrases": [
                        "seasoned traveller",
                        "seasoned professional",
                        "seasoned veteran"
                    ],
                    "target_lang_definitions": {
                        "pl": "mający duże doświadczenie i umiejętności w określonej dziedzinie lub pracy"
                    },
                    "translations": {
