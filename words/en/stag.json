                            "trait_type": "archaic",
                            "comment": "Archaic dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шумная, бойкая девочка; сорванец, пацанка (устаревшее диалектное)."
                    },
                    "translations": {
