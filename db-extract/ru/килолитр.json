                                        "examples": [
                                            {
                                                "example_id": "38e39c78-bb84-415e-a312-812d55c75240",
                                                "sense_id": "ae17e1f7-637f-366f-a327-78b097aab820",
                                                "text": "Le stère ou mètre cube de bois de chauffage, douze centimes; de fagots, bois à charbon, neuf centimes; le kilolitre de charbons de bois , six centimes ; de charbon de terre , seize centimes; le kilolitre de cendres neuves, vingt centimes; de cendres lessivées ou charrées, seize centimes; de sel, vingt-cinq centimes; le kilolitre de blé, vingt-deux centimes; d'avoine, quatorze centimes; de légumes, vingt-un centimes."
                                            }
