                        ],
                        "examples": [
                            {
                                "example_id": "3173eb98-3792-40c8-80f7-0b62db6b12db",
                                "sense_id": "7048064b-2a65-3a78-9af8-3a9609f5b1b5",
                                "text": "La présentation est validée avec joie, je te laisse t'autogrouper et t'autoajouter un rang Muffy."
