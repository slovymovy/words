                "senses": [
                    {
                        "sense_id": "6875cf12-5b08-3dc1-803e-3c8e5489ef10",
                        "entry_id": "7b055149-00bb-3c5f-8b03-847c2430c590",
                        "glosses": [
                            "Grandeur physique d’un matériau représentant la résistance électrique sans rapport avec la taille ou la forme, généralement symbolisée par la lettre grecque ρ et dont les unités sont l’ohm-mètre (Ω⋅m) et l’ohm-centimètre (Ω⋅cm) aussi courant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39876dd4-95bb-430c-852b-0c000fe591c5",
                                "sense_id": "6875cf12-5b08-3dc1-803e-3c8e5489ef10",
                                "text": "Quand les morceaux touchent les contacts, la grille reçoit des voltages différents suivant leur résistivité. Si le voltage est suffisant, la valve actionne un relais qui ferme le circuit d'un mécanisme électrique."
                            }
                        ]
                    }
                ],
