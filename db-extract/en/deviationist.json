                                            {
                                                "example_id": "36d177df-6b3d-45c2-9b3f-4dff2df72af7",
                                                "sense_id": "71402869-c108-3c23-9c07-2fbb0229ef5e",
                                                "text": "Er was één dissident binnen de coalitie: PvdA’er Jacques Monasch. Hij kondigde dinsdag zoals verwacht aan met de oppositie mee te zullen stemmen. „Europa gaat te snel”, verkondigde het Kamerlid voor een haag aan televisiecamera’s. En daarmee was het kabinet de minimale meerderheid van 76 zetels kwijt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ab8d64-cff2-3295-810c-87298157c1c2",
                                        "entry_id": "2b680b37-42a4-3e3d-a249-268bba4c1dac",
