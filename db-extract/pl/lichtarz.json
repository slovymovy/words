                "senses": [
                    {
                        "sense_id": "b3173e8e-e51f-3d6d-9d0d-2bf170e95c94",
                        "entry_id": "a183f890-6ea3-3a7c-b396-d37102e8af2b",
                        "glosses": [
                            "świecznik na jedną świecę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43bd2bf1-d93e-4b70-987e-8c80333d9911",
                                "sense_id": "b3173e8e-e51f-3d6d-9d0d-2bf170e95c94",
                                "text": "Obraz przedstawia starca w szlafmycy i z lichtarzem w dłoni."
                            },
                            {
                                "example_id": "851bffe3-f80d-4ef8-8338-ee3514b4c753",
                                "sense_id": "b3173e8e-e51f-3d6d-9d0d-2bf170e95c94",
                                "text": "Służba wyczyściła już lichtarze i odkurzyła meble."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "23fd3124-5ba4-30fc-b8ca-1000adc52194",
                        "entry_id": "a183f890-6ea3-3a7c-b396-d37102e8af2b",
                        "glosses": [
                            "podstawka do osadzania świecy"
                        ],
                        "tags": [],
