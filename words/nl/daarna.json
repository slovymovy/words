                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eerst deden we de afwas, <w>daarna</w> gingen we televisie kijken.",
                            "target_lang_translations": {
                                "en": "First we did the dishes, <w>then</w> we went to watch television.",
                                "ru": "Сначала мы помыли посуду, а <w>потом</w> пошли смотреть телевизор.",
                                "fr": "D'abord nous avons fait la vaisselle, <w>ensuite</w> nous sommes allés regarder la télévision.",
                                "it": "Prima abbiamo lavato i piatti, <w>poi</w> siamo andati a guardare la televisione."
                            }
                        },
                        {
                            "text": "Hij ging eerst naar de bakker en <w>daarna</w> liep hij naar het park.",
                            "target_lang_translations": {
                                "en": "He first went to the bakery and <w>after that</w> he walked to the park.",
                                "ru": "Сначала он зашел в пекарню, а <w>затем</w> пошел в парк.",
                                "fr": "Il est d'abord allé à la boulangerie et <w>après cela</w> il a marché vers le parc.",
                                "it": "Prima è andato dal panettiere e <w>dopo</w> è andato al parco."
                            }
                        }
                    ],
