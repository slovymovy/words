                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d996ecc0-c399-4289-8d2d-0b7bc6dcab78",
                                                "sense_id": "5963c6af-9beb-3e80-a08c-1877c192cf8d",
                                                "text": "„A und nicht A“ ist falsch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "98cd8571-f5d3-32b2-bf0e-cccb643e978c",
                                        "entry_id": "ad6ec583-a673-3b88-b3a5-ff38aaa8d079",
                                        "glosses": [
                                            "den Sinn nicht verändernde Partikel in Sätzen oder Satzteilen (Nebensätzen), die schon anders als durch das Wort „nicht“ funktional negiert sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d450da4-783c-4aee-b691-c0b1ddcae701",
                                                "sense_id": "98cd8571-f5d3-32b2-bf0e-cccb643e978c",
                                                "text": "„Bevor man sich das nicht klargemacht hat, sollte man nicht in Einstellungsgespräche gehen.“"
                                            },
                                            {
                                                "example_id": "6b509457-fbfa-4918-ba0e-71002e170400",
                                                "sense_id": "98cd8571-f5d3-32b2-bf0e-cccb643e978c",
                                                "text": "„Bis die Ermittlungen nicht abgeschlossen sind, ist offen, ob es dabei bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
