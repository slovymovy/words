                                "target_senses": [
                                    {
                                        "sense_id": "c363b091-8ece-3dfd-83a5-415c61a7e3b1",
                                        "entry_id": "84cb32ba-3f8f-3819-a74f-2cfab5a50b6e",
                                        "glosses": [
                                            "Technique d’imagerie médicale permettant d’obtenir des vues en deux ou en trois dimensions de l’intérieur du corps de façon non invasive avec une résolution en contraste élevée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7d568d-d9a7-4baa-b864-c9112ae9ef10",
                                                "sense_id": "c363b091-8ece-3dfd-83a5-415c61a7e3b1",
                                                "text": "Mme Suffren et ses collaborateurs ont ensuite utilisé l'imagerie par résonnance magnétique pour examiner le cerveau des enfants entre les âges de 12 et 16 ans."
                                            }
                                        ]
                                    }
                                ]
