                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6c50813-5fef-42da-aec8-b28e2f82db03",
                        "source_entry_id": "46fd850d-49fa-34d3-94ec-f626d353b4b4",
                        "source_sense_id": "7f9aeb72-ec02-33b4-b82b-9ae706eb800e",
                        "source_sense_description": "Geometrie: Polyeder, das durch Abstumpfung der Ecken eines Oktaeders entsteht",
                        "target_lang_word": "truncated octahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truncated octahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "700f08c5-04aa-3485-b666-56d7ce72eadc",
                                        "entry_id": "bbc97bd6-63b9-332b-96fa-10dd94d35483",
                                        "glosses": [
                                            "A zonohedron that has 14 faces (eight regular hexagons and six squares) and 36 edges and is an Archimedean solid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c2f951-990d-47a9-828c-b8f6a14d597e",
                                                "sense_id": "700f08c5-04aa-3485-b666-56d7ce72eadc",
                                                "text": "The closest packing of truncated octahedra can be considered to be a denser packing than that of the rhombic dodecahedron because in a space filling array each truncated octahedron is surrounded by 14 others corresponding to its 14 faces, while the rhombic dodecahedron is only surrounded by 12 like cells."
                                            },
                                            {
                                                "example_id": "7bd12355-ec3c-4941-b233-d1cbece4bc47",
                                                "sense_id": "700f08c5-04aa-3485-b666-56d7ce72eadc",
                                                "text": "The K-complex is built by taking the truncated octahedrons as 3-cells, and its faces, edges and vertex^([sic]) respectively as 2-cells, 1-cells, and 0-cells."
                                            },
                                            {
                                                "example_id": "91d105d9-b96d-40b4-ba4d-c76ff5f9fd4b",
                                                "sense_id": "700f08c5-04aa-3485-b666-56d7ce72eadc",
                                                "text": "2007, Rebecca L. Wolfe, Novel Gold Monolayer Protected Clusters: Synthesis, Characterization, Separation, and Functionalization, PhD Thesis, page 29,\nMany proposed MPC cores, including Au₁₄₀ and Au₂₂₅, are truncated octahedrons, referred to as TO+ because the shapes are (0 < n - m = 4), where n is the number of atoms between (111) facets and m is the number of atoms between (111) and (100) facets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
