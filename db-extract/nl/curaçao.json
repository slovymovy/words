                    {
                        "translation_id": "0cf3ffc8-ae9d-4966-bdda-2a9bdc476f2d",
                        "source_entry_id": "22558d21-7d21-307b-8e02-6d819c1e0a3b",
                        "source_sense_id": "e04d5f39-4ce8-3817-80a5-a89ceb27846b",
