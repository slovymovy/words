                            }
                        ]
                    },
                    {
                        "translation_id": "86a72815-782c-4600-9359-f0d0b59cebaa",
                        "source_entry_id": "be87ac3a-10ff-3a0a-ab84-997669b8a19c",
                        "source_sense_description": "flower cluster",
                        "target_lang_word": "bloeiwijze",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloeiwijze",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "05ad8719-4d43-38b4-b0cc-5f4a55fc3291",
                                        "entry_id": "e8563626-ae44-377e-8b60-464da8c62261",
                                        "glosses": [
                                            "de vorm en rangschikking van de bloemen van een plant, een kenmerk waarop men planten indeelt in groepen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16eed109-2266-421b-9ef9-5307e360f90e",
                                                "sense_id": "05ad8719-4d43-38b4-b0cc-5f4a55fc3291",
                                                "text": "De Victoria-waterlelie is bekend om zijn enorme ronde bladeren en de sprookjesachtige bloeiwijze. De bloemen bloeien alleen 's nachts."
                                            },
                                            {
                                                "example_id": "ab3ceef6-e980-42b5-89d7-0230a679abb3",
                                                "sense_id": "05ad8719-4d43-38b4-b0cc-5f4a55fc3291",
                                                "text": "De afwijkende groei- en bloeiwijze zette Damen op het spoor. Tijdens onderzoek in herbaria (waar verzamelde, gedroogde planten liggen) vond Damen enkele soortgelijke exemplaren die nooit eerder een naam hadden gekregen. Door publicatie in het Journal of Plant Taxonomy and Plant Geography BLUMEA is de ontdekking nu ook officieel een wetenschappelijk feit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f30ee3b-1362-4a71-90d1-c81d65a443ff",
                        "source_entry_id": "be87ac3a-10ff-3a0a-ab84-997669b8a19c",
