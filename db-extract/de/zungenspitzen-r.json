                "senses": [
                    {
                        "sense_id": "5f64fb2a-4783-307e-9ee4-09a2b3884248",
                        "entry_id": "c81bd884-525f-3d2b-938a-4b77ebd5bbe0",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "0b3ced4c-8b50-479c-b0eb-5e9c6e0f6d46",
                                "sense_id": "5f64fb2a-4783-307e-9ee4-09a2b3884248",
                                "text": "„Das Phonem /r/ kann der Artikulationsstelle nach dental („Zungenspitzen-r“ = [r] bzw. …), uvular („Zäpfchen-r“ = [R], [ʁ] oder auch velar … realisiert werden.“"
                            },
                            {
                                "example_id": "f7930d2a-72c3-4133-bc33-c92e1128c474",
                                "sense_id": "5f64fb2a-4783-307e-9ee4-09a2b3884248",
                                "text": "„Bei den beiden r-Bildungen des Deutschen, dem Zäpfchen-r und dem Zungenspitzen-r, ist die Gleichartigkeit der graphischen Kennzeichnung berechtigt, sie erfüllen - wenngleich phonetisch verschieden - die gleiche Funktion und können also promiscue gebraucht werden.“"
                            },
                            {
                                "example_id": "c5fd94aa-8292-45f5-90e5-1c65f6446bcd",
                                "sense_id": "5f64fb2a-4783-307e-9ee4-09a2b3884248",
                                "text": "„Und das r wird hier überall als hinteres Zäpfchen-r gegen sonstiges vorderes Zungenspitzen-r artikuliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
