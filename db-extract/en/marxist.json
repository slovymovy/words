            {
                "entry_id": "48f2a6c5-82bb-3c25-8e43-c25f6140f52b",
                "word": "Marxist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9cded666-6a84-4c1a-a6a4-325eebaf91cc",
                        "entry_id": "48f2a6c5-82bb-3c25-8e43-c25f6140f52b",
                        "tags": [
                            "plural"
                        ],
                        "form": "Marxists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                        "entry_id": "48f2a6c5-82bb-3c25-8e43-c25f6140f52b",
                        "glosses": [
                            "One that believes in or follows the ideals of Marxism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b070a3-49bd-4ff7-b12f-e46a76e76d9c",
                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                "text": "What sort of Marxist devotes six years to the perfecting of a novel so remote from the struggle for tomorrow?"
                            },
                            {
                                "example_id": "83ca92ae-ad39-4a62-8884-822c4a8ac8d3",
                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                "text": "Of course, no two Marxists and no two Miseseans will ever be exactly alike, so I am not suggesting that a winning political coalition will result from this unlikely arrangement."
                            },
                            {
                                "example_id": "ba827c01-78a9-400d-9b31-6391a3f9bfa4",
                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                "text": "2015, Park Si-soo, Leading Economist Dies at 73, The Korea Times\nKorea's leading Marxist economist Kim Soo-haeng, who translated the legendary economic book \"Capital: Critique of Political Economy\" into Korean in 1990, died of a heart attack in the United States, recently."
                            },
                            {
                                "example_id": "e19d1fc3-4f46-4b77-a377-53927bbb02ba",
                                "sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                                "text": "Like Marxists, wokies are millenarians, working for a magical tomorrow that owes nothing either to past practice or to human frailties."
                            }
                        ]
                    }
                ],
