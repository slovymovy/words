                "senses": [
                    {
                        "sense_id": "a49735b0-71ee-3d16-905c-20b455d46526",
                        "entry_id": "f2f01886-5988-3cc3-9479-03c5dc9f6a8a",
                        "glosses": [
                            "show, performance"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "21d3544d-f850-4b7b-88a5-62d2e9a6ab2c",
                                "sense_id": "a49735b0-71ee-3d16-905c-20b455d46526",
                                "text": "We gingen naar een leuke voorstelling in het theater.",
                                "translation": "We went to a nice show at the theater.",
                                "english": "We went to a nice show at the theater."
                            },
                            {
                                "example_id": "36955c19-bc41-43d5-aef4-088c5278d6bc",
                                "sense_id": "a49735b0-71ee-3d16-905c-20b455d46526",
                                "text": "De circusartiesten gaven een adembenemende voorstelling met acrobatiek.",
                                "translation": "The circus performers put on a breathtaking performance with acrobatics.",
                                "english": "The circus performers put on a breathtaking performance with acrobatics."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fa05493-a666-334e-aa86-3162c641ba4e",
                        "entry_id": "f2f01886-5988-3cc3-9479-03c5dc9f6a8a",
                        "glosses": [
                            "presentation"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "3cacf098-49b8-481c-8edd-a4e23ea95325",
                                "sense_id": "0fa05493-a666-334e-aa86-3162c641ba4e",
                                "text": "De manager gaf een boeiende voorstelling over het nieuwe project.",
                                "translation": "The manager gave an engaging presentation about the new project.",
                                "english": "The manager gave an engaging presentation about the new project."
                            },
                            {
                                "example_id": "6ab5d7cd-0d54-4297-b50f-977920c911f9",
                                "sense_id": "0fa05493-a666-334e-aa86-3162c641ba4e",
                                "text": "De spreker gebruikte visuele hulpmiddelen om zijn voorstelling te ondersteunen.",
                                "translation": "The speaker used visual aids to support his presentation.",
                                "english": "The speaker used visual aids to support his presentation."
                            }
                        ]
                    },
                    {
                        "sense_id": "039329ed-7dc0-30ef-b445-1cb3ecf6e8ce",
                        "entry_id": "f2f01886-5988-3cc3-9479-03c5dc9f6a8a",
                        "glosses": [
                            "notion, idea; mental picture"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e0ec34-cfa1-445c-b6f4-a3d43a06ec3f",
                                "sense_id": "039329ed-7dc0-30ef-b445-1cb3ecf6e8ce",
                                "text": "Ik heb een duidelijke voorstelling van hoe de toekomst eruit zou moeten zien.",
                                "translation": "I have a clear idea of how the future should look like.",
                                "english": "I have a clear idea of how the future should look like."
                            },
                            {
                                "example_id": "57b4bd6b-dd55-4e88-ad2d-06b574ad173f",
                                "sense_id": "039329ed-7dc0-30ef-b445-1cb3ecf6e8ce",
                                "text": "Kun je me een voorstellinkje maken van hoe het eruit zal zien?",
                                "translation": "Can you give me a mental picture of how it will look like?",
                                "english": "Can you give me a mental picture of how it will look like?"
                            }
                        ]
                    }
                ],
