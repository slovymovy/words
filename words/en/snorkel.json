                    "frequency": "Middle",
                    "semantic_group_id": "diving_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before jumping into the bay, she adjusted her mask and breathed through her <w>snorkel</w>."
                        },
                        {
                            "text": "They rented flippers and a <w>snorkel</w> to explore the shallow reef."
                        }
                    ],
                    "common_phrases": [
                        "mask and snorkel"
                    ]
                },
                {
                    "sense_id": "c966689e-f743-343d-93f7-b92ceab5e318",
                    "sense_definition": "A retractable tube fitted to a submarine to supply air to engines and crew while submerged at shallow depth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "diving_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine raised its <w>snorkel</w> to recharge its batteries without surfacing fully."
                        },
                        {
                            "text": "Radar detected the tip of the <w>snorkel</w> cutting through the waves."
                        }
                    ],
                    "synonyms": [
                        "snort"
                    ],
                    "common_phrases": [
                        "submarine snorkel"
                    ]
                },
                {
                    "sense_id": "b0dbb84a-71bb-37e7-b819-09a812d27453",
                    "sense_definition": "A heavy winter coat with a hood that can be zipped high to protect the face, short for snorkel parka.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bundled up in a warm green <w>snorkel</w> before heading out into the blizzard."
                        },
                        {
                            "text": "During the cold winter months, almost every kid wore a thick <w>snorkel</w> to school."
                        }
                    ],
                    "common_phrases": [
                        "snorkel parka"
                    ]
                }
            ]
        },
