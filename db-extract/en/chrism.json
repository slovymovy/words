                                        "sense_id": "536045fa-fd56-322e-88ac-7476175db1a4",
                                        "entry_id": "703077eb-877e-35d4-990b-4f75c3364bef",
                                        "glosses": [
                                            "wertvolles gesegnetes Öl für Salbungen, das unter anderem bei der Firmung, Taufe und der Priesterweihe benutzt wird"
                                        ],
                                        "tags": [
                                            "Katholische Kirche",
                                            "Orthodoxe Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc41b446-57c6-4e93-9573-913b5541ddaf",
                                                "sense_id": "536045fa-fd56-322e-88ac-7476175db1a4",
                                                "text": "„Das Taufwasser ward besonders geweiht und bald auch mit Chrisma vermischt; in dasselbe, das auch sonst die Gläubigen als Sacramentale gebrauchten, ward die Osterkerze eingetaucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
