                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a4349b-318d-43fd-bd98-94416c4f1a4a",
                                "sense_id": "adfd3ee8-6682-305b-b893-bedbff106ecc",
                                "text": "Ce travail est pénible, je suis exténué."
                            },
                            {
                                "example_id": "f1a36857-da2b-4832-9583-6a8d1ec6afca",
                                "sense_id": "adfd3ee8-6682-305b-b893-bedbff106ecc",
                                "text": "J'ai passé ma matinée à faire du ménage, je suis exténué."
                            }
                        ]
                    },
                    {
                        "sense_id": "60f83d81-105b-3396-b242-bf9a07685709",
                        "entry_id": "bf79dcb1-1b01-3f9d-8286-6d10b29b8994",
                        "glosses": [
                            "Délabré ; en piteux état."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0b35212f-ddf6-4483-b93e-3d83e6a1fbf6",
                                "sense_id": "60f83d81-105b-3396-b242-bf9a07685709",
                                "text": "J’avais acheté une vieille 4L dont les cardans exténués rendaient d’inquiétants sons de castagnettes et je roulais des journées entières sur des routes où la mort guettait à chaque virage."
                            }
                        ]
                    }
