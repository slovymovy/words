                "senses": [
                    {
                        "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                        "entry_id": "e13e70d3-839c-39dd-aff0-2477d88f9cc7",
                        "glosses": [
                            "Amtsblatt für Veröffentlichungen durch deutsche Bundesbehörden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cadf7d8-8cb8-438b-90e4-0b86f461f991",
                                "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                                "text": "„Der Bundesanzeiger wird vom Bundesministerium der Justiz und für Verbraucherschutz elektronisch herausgegeben.“"
                            },
                            {
                                "example_id": "56a51da8-af28-496a-a3ad-a0517f44b290",
                                "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                                "text": "„Soweit eine entsprechende Veröffentlichung im Bundesanzeiger auch durch sonstige Vorschriften vorgeschrieben wird, ist eine einmalige Veröffentlichung ausreichend.“"
                            },
                            {
                                "example_id": "976a7f89-1736-4a44-9980-c19c5601e97e",
                                "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                                "text": "„Der OPS selbst wird nach den gesetzlichen Vorgaben weder im Bundesgesetzblatt noch im Bundesanzeiger bekannt gemacht.“"
                            },
                            {
                                "example_id": "9cc2b9bf-ecec-41ff-841a-176c0ec66ee6",
                                "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                                "text": "„Die unterlassene Veröffentlichung im Bundesanzeiger hat zur Folge, dass die Wahlanfechtungsfrist des § 22 Abs 2 S 2 nicht zu laufen beginnt.“"
                            },
                            {
                                "example_id": "4117fa4f-addb-405e-a4c6-2bea0f864b98",
                                "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                                "text": "„Seit 2007 sind etwa 1,1 Millionen Unternehmen gesetzlich verpflichtet, ihre Jahresabschlüsse nicht mehr bei den Amtsgerichten, sondern bei der Bundesanzeiger Verlagsgesellschaft in Köln einzureichen, damit sie im Internet veröffentlicht werden können.“"
                            },
                            {
                                "example_id": "e4f24b78-cd4e-4f54-8dc7-bf04bd1d147b",
                                "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                                "text": "„Im Bundesanzeiger wurden im September die Vermögenswerte von zwölf namentlich genannten Beschuldigten aufgelistet, darunter die mutmaßlichen Haupttäter und Firmengründer Jonas Köller und Stephan Schäfer.“"
                            },
                            {
                                "example_id": "366e6bbb-877b-4eeb-a15e-3940ea6ecc88",
                                "sense_id": "dcbfe7d5-73aa-38bc-98ff-c18adc10a5e1",
                                "text": "„Seit der Vorlage des KPMG-Berichts Ende April haben Hedgefonds ihre Wetten auf einen Kurseinbruch der Wirecard-Aktie kräftig erhöht, die im Bundesanzeiger veröffentlichten Netto-Leerverkaufspositionen sind auf über 10 Prozent gestiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
