                ],
                "senses": [
                    {
                        "sense_id": "23927645-3904-31f2-a25e-a969ee02677a",
                        "entry_id": "1ff82b83-cfda-3c01-8674-5215b68a7eea",
                        "glosses": [
                            "To release from the status of colony; to allow a colony to become independent."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d9d8d449-f4cd-447a-b689-f1a538958a1c",
                                "sense_id": "23927645-3904-31f2-a25e-a969ee02677a",
                                "text": "A paternal government would attempt to decolonize American literature, by forbidding the re-publication of foreign works, and offering premiums to those of home production."
                            }
                        ]
                    },
                    {
                        "sense_id": "089c1a74-dcab-3f85-b67b-d97cf1a6a876",
                        "entry_id": "1ff82b83-cfda-3c01-8674-5215b68a7eea",
                        "glosses": [
                            "To reverse the colonization of, i.e. to grant back autonomy to a group."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cdd9ceec-fe1b-4092-875f-420251d53882",
                                "sense_id": "089c1a74-dcab-3f85-b67b-d97cf1a6a876",
                                "text": "Across Ukraine, officials are starting projects to, as they say, “decolonize” their cities. Streets and subway stops whose names evoke the history of the Russian Empire or the Soviet Union are under scrutiny by a population eager to rid itself of traces of the nation that invaded in late February."
                            },
                            {
                                "example_id": "b9f25534-de83-42f1-b769-a5ab3cbe2de1",
                                "sense_id": "089c1a74-dcab-3f85-b67b-d97cf1a6a876",
                                "text": "The arrival of Trump in the White House gave a new urgency to the idea that museums needed to “decolonize” their collections, atone for their past elitism, and become overtly political institutions rather than mere warehouses of valuable objects."
                            }
                        ]
                    }
                ],
                "translations": [
