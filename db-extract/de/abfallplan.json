                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4427854a-8c5b-453b-ab53-a6266acbee27",
                                "sense_id": "5c859d66-14df-3d1f-a060-0a2c2dc82bea",
                                "text": "„Der Abfallplan sieht den Bau mehrerer Anlagen vor, darunter zwei – oder vielleicht drei – Biovergärungsanlagen und etwa dreißig Multimaterial-Sammel- und Sortierzentren.“"
                            },
                            {
                                "example_id": "1f731406-b546-49b6-9256-c374ffef4457",
                                "sense_id": "5c859d66-14df-3d1f-a060-0a2c2dc82bea",
                                "text": "„In ausgedruckter Form werden die Abfallpläne jedes Jahr im Januar mit den Gebührenbescheiden per Post verschickt.“"
                            }
                        ],
