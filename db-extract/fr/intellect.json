        "fr-extract.jsonl": [
            {
                "entry_id": "99847891-4c51-3808-a033-355fc1e8a7f8",
                "word": "intellect",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "45baeca7-6d29-3891-87ac-e0add01bd35f",
                        "entry_id": "99847891-4c51-3808-a033-355fc1e8a7f8",
                        "glosses": [
                            "Faculté de l’Esprit qu’on nomme aussi entendement et qui est l’intelligence métaphysique, la faculté de connaître supérieure à la raison, au mental."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "117b479a-809e-458f-8ec2-46b65c480861",
                                "sense_id": "45baeca7-6d29-3891-87ac-e0add01bd35f",
                                "text": "[…] [Aristote] sait que l’homme n’est pas un animal comme les autres. Animal raisonnable, l’être humain semble posséder en soi plus que la forme de son corps ; il y a dans l’âme humaine un principe d’opérations indépendant du corps dans son exercice et par conséquent supérieur à ce que serait une simple forme substantielle, c’est l’intellect."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4fae757-67e0-4879-9ad7-2461d4aaa028",
                        "source_entry_id": "99847891-4c51-3808-a033-355fc1e8a7f8",
                        "source_sense_id": "45baeca7-6d29-3891-87ac-e0add01bd35f",
                        "target_lang_word": "Intellekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intellekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1ffde8-c7fb-395d-b383-59b5906c70f2",
                                        "entry_id": "2625d286-28f8-371d-aac4-af195bce0125",
                                        "glosses": [
                                            "Denk-, Erkenntnisvermögen; Verstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668745bb-ddf9-4c3f-a7a2-f2a3104f8744",
                                                "sense_id": "7a1ffde8-c7fb-395d-b383-59b5906c70f2",
                                                "text": "Dazu reicht ihr Intellekt einfach nicht."
                                            },
                                            {
                                                "example_id": "dd9b4df7-0a46-4cb1-af97-c2d20c66954c",
                                                "sense_id": "7a1ffde8-c7fb-395d-b383-59b5906c70f2",
                                                "text": "„Seine scharfe Beobachtungsgabe und sein fast noch schärferer Intellekt machen nicht mehr vor der eigenen Person halt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "437a26e3-e41f-46b3-95f3-4adf08eb2874",
                        "source_entry_id": "99847891-4c51-3808-a033-355fc1e8a7f8",
                        "source_sense_id": "45baeca7-6d29-3891-87ac-e0add01bd35f",
