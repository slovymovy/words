                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24cba6db-d663-4121-b15b-fdd16048d583",
                                "sense_id": "8916556e-51c3-3c30-bc3d-ea99f1d712fc",
                                "text": "Похоже, добившись своего, хитрец Четверик решил придержать поручительство под дополнительные кредиты из других банков. А значит, по мнению Коломнина, оказался элементарным кидалой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd4b8583-5183-489f-a689-fc2b42a6a24d",
                        "source_entry_id": "41e0ea80-2794-3b0a-9c0d-73bbc1b4db0a",
                        "source_sense_id": "8916556e-51c3-3c30-bc3d-ea99f1d712fc",
                        "target_lang_word": "scammer",
