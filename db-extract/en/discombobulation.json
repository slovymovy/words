                    {
                        "sense_id": "500567ca-8e8c-3f64-90cc-d390e180281a",
                        "entry_id": "8d0e22c0-bf1f-3ae3-9a59-acfe89fe4dd6",
                        "glosses": [
                            "An embarrassing feeling that leaves a person confused."
                        ],
                        "tags": [
                            "countable",
                            "humorous",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bcf4e45e-fd55-4fbb-bc30-1b64ba190a91",
                                "sense_id": "500567ca-8e8c-3f64-90cc-d390e180281a",
                                "text": "Prophet of o'er-population, your ingenious calculation,\nCauseth discombobulation only in the anxious mind"
                            },
                            {
                                "example_id": "f762a4a9-838e-42bb-99ff-5b7213cd5cfe",
                                "sense_id": "500567ca-8e8c-3f64-90cc-d390e180281a",
                                "text": "This quality or state of not having your act quite together lacks its own word in the dictionary. It is something short of discombobulation, but the mild, mental chafing is irritating enough to demand a remedy."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3a1de15-a8cd-352c-9954-60504a0e7e7d",
                        "entry_id": "8d0e22c0-bf1f-3ae3-9a59-acfe89fe4dd6",
                        "glosses": [
                            "A confused or disorderly state."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2abcfea-0d63-4c05-82a2-d1ebab7ea4b6",
                                "sense_id": "e3a1de15-a8cd-352c-9954-60504a0e7e7d",
                                "text": "What has changed since the time of Looney Tunes is the discombobulation of characters' faces. Eyeballs constantly bulge beyond normal proportion to show shock or jubilation; cheeks shrink, sag or even bend in shame, fatigue or anger. Each emotion is heightened, overemphasized with cubist contortions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b15825c-5a77-43dd-b7b3-54a5baacf33d",
                        "source_entry_id": "8d0e22c0-bf1f-3ae3-9a59-acfe89fe4dd6",
                        "source_sense_description": "an embarrassing feeling that leaves a person confused",
                        "target_lang_word": "Verwirrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwirrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65aa5074-2309-3916-9e12-88cfc9d532d0",
                                        "entry_id": "851b257c-172e-3138-9246-0400d78b0497",
                                        "glosses": [
                                            "Mangel an Ordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52f39da5-303e-4fc4-9f9c-46ed13566723",
                                                "sense_id": "65aa5074-2309-3916-9e12-88cfc9d532d0",
                                                "text": "Die Kundgebung endete in einer allgemeinen Verwirrung."
                                            },
                                            {
                                                "example_id": "8db0ed94-6250-4d3a-a7f6-bd729ce02034",
                                                "sense_id": "65aa5074-2309-3916-9e12-88cfc9d532d0",
                                                "text": "„Anfangs herrschte Verwirrung. Später sangen sie, lachten und tanzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                        "entry_id": "851b257c-172e-3138-9246-0400d78b0497",
                                        "glosses": [
                                            "geistige Unklarheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed38e9de-b177-41c3-b629-21a1477ad2d5",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "Manche alten Menschen leiden unter geistiger Verwirrung."
                                            },
                                            {
                                                "example_id": "5dea5e0c-ca8f-4eb3-8201-2e118ecae123",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Seine ehrliche Verwirrung ließ ihn beinahe liebenswert erscheinen, aber sie wußten ja alle, daß er unverbesserlich war und bei nächstbester Gelegenheit wieder genauso loslegen würde.“."
                                            },
                                            {
                                                "example_id": "d5c768cc-7d13-4474-88fc-265e28f11673",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Eine Verwirrung befällt sie, von der sie oft, fast immer befallen wird, wenn sie durch die Enge des Raumes in die Nähe eines schönen Sterblichen geraten ist.“"
                                            },
                                            {
                                                "example_id": "7d91c509-9fb6-4d8f-8700-1db49b3df38c",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Die Gerüchte überschlugen sich, die Verwirrung war komplett.“"
                                            },
                                            {
                                                "example_id": "4be5bef5-c92d-47c4-b517-cf852de1cd25",
                                                "sense_id": "5c51e5b0-0a95-3761-b2cd-67b37426a9d9",
                                                "text": "„Ich konnte ihre Verwirrung aber gut nachvollziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
