                        "entry_id": "cf0d2c2b-0328-386e-a4b3-3d3ab457e8d3",
                        "glosses": [
                            "A specific form of a language or language cluster: a language or a dialect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab0df42-dbe7-4bc6-a3a8-a3e6202a3df1",
                                "sense_id": "2d417d1d-e249-3540-9efd-ad6bca2045d2",
                                "text": "Meronyms: lexicon, grammar, sublect"
                            },
                            {
                                "example_id": "4202ef5f-30b2-48bb-a3b7-88e1ddde7a71",
                                "sense_id": "2d417d1d-e249-3540-9efd-ad6bca2045d2",
                                "text": "These, together with (some) Romansh lects, belong to our West Rhaetian; the /ȫ/ also supported by two lects from the Ticino which by our criteria are NWIt, and by the partially umlauting lects of Lombardy which together with (some) Engadine lects belong to our East Rhaetian."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "643c259d-780c-4ed7-8b2a-29246622faa4",
                        "source_entry_id": "cf0d2c2b-0328-386e-a4b3-3d3ab457e8d3",
                        "source_sense_id": "2d417d1d-e249-3540-9efd-ad6bca2045d2",
