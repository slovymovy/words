                "senses": [
                    {
                        "sense_id": "b1da4724-ca13-3c55-8399-029c678cb5f3",
                        "entry_id": "cc384255-250e-36a3-b6a6-fe77e61e2b00",
                        "glosses": [
                            "muff, handwarmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "525cd703-af32-4be6-8806-aa4726a64186",
                                "sense_id": "b1da4724-ca13-3c55-8399-029c678cb5f3",
                                "text": "Она́ вздохну́ла ещё раз, что́бы надыша́ться, и уже́ вы́нула ру́ку из му́фты, что́бы взя́ться за сто́лбик и войти́ в ваго́н, как ещё челове́к в вое́нном пальто́ по́дле неё само́й заслони́л ей коле́блющийся свет фонаря́.",
                                "translation": "She drew one more deep breath of the fresh air, and had just put her hand out of her muff to take hold of the door post and get back into the carriage, when another man in a military overcoat, quite close beside her, stepped between her and the flickering light of the lamp post.",
                                "english": "She drew one more deep breath of the fresh air, and had just put her hand out of her muff to take hold of the door post and get back into the carriage, when another man in a military overcoat, quite close beside her, stepped between her and the flickering light of the lamp post."
                            }
                        ]
