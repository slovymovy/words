                                                "sense_id": "48f60668-143d-3d62-895f-5302b6053b3f",
                                                "text": "The morrow next apprear'd with purple hayre / Yet dropping fresh out of the Indian fount, / And bringing light into the heavens fayre […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee04636-2ced-364f-9017-17dc068be914",
                                        "entry_id": "0655bd03-9304-3f0b-b89a-90ee64950ccc",
                                        "glosses": [
                                            "Of or relating to the indigenous peoples of the Americas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6858c1-1ef4-4f68-a432-dd6b5d048cd7",
                                                "sense_id": "1ee04636-2ced-364f-9017-17dc068be914",
                                                "text": "The hardships of bark-collecting in the primeval forests of South America are of the severest kind, and undergone only by the half-civilized Indians and people of mixed race, in the pay of speculators or companies located in the towns."
                                            }
