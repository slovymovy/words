        "fr-extract.jsonl": [
            {
                "entry_id": "e129021f-95c1-3931-b06e-b83cdd229515",
                "word": "mondialisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "caa08d66-8b76-4c01-941e-686339a07034",
                        "entry_id": "e129021f-95c1-3931-b06e-b83cdd229515",
                        "tags": [
                            "plural"
                        ],
                        "form": "mondialismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abd8e75d-9c2c-3b42-b359-5d0bfec2a3c7",
                        "entry_id": "e129021f-95c1-3931-b06e-b83cdd229515",
                        "glosses": [
                            "Doctrine économique qui prône l'ouverture des marchés, la suppression des barrières douanières, la liberté du commerce et de circulation des personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "671e7037-5820-4c0d-9cff-05368bc34721",
                                "sense_id": "abd8e75d-9c2c-3b42-b359-5d0bfec2a3c7",
                                "text": "Si la mondialisation consiste dans la globalisation du capitalisme à l’échelle mondiale, le « mondialisme » est son idéologie, mais une idéologie à géométrie variable qui télescope des néolibéraux avec des écologistes libertariens, des socio-démocrates multiculturalistes et des régionalistes racialistes."
                            },
                            {
                                "example_id": "4ac79588-f7ee-4577-8e08-654f2f0865a2",
                                "sense_id": "abd8e75d-9c2c-3b42-b359-5d0bfec2a3c7",
                                "text": "Comment pourrions-nous espérer jouer « collectif » au niveau Européen lorsque s’accumulent les individualismes, les corporatismes, les régionalismes, les nationalismes, les mondialismes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6d0bc47-b9c5-309f-8bae-8c7f3d670047",
                        "entry_id": "e129021f-95c1-3931-b06e-b83cdd229515",
                        "glosses": [
                            "Projet d’instituer un État mondial qui gouvernerait l'ensemble des peuples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d277282-f272-49f1-8274-05913dca2c10",
                                "sense_id": "d6d0bc47-b9c5-309f-8bae-8c7f3d670047",
                                "text": "Le communisme internationaliste est un mondialisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2578908-40ac-4b77-ac62-696a84da2e96",
                        "source_entry_id": "e129021f-95c1-3931-b06e-b83cdd229515",
                        "target_lang_word": "globalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "globalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3806ca7-bbde-38a0-b71a-eaca7fb76c0b",
                                        "entry_id": "67c4386a-e958-3266-83c5-6f09bb13f243",
                                        "glosses": [
                                            "An ideology based on the belief that people, goods and information ought to be able to cross national borders unfettered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10c96d75-ca94-348a-9566-b9ec6d83204e",
                                        "entry_id": "67c4386a-e958-3266-83c5-6f09bb13f243",
                                        "glosses": [
                                            "A socio-economic system dedicated to free trade and free access to markets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91e7fc82-db56-4fa9-8c77-4a7b2ec8bdb7",
                        "source_entry_id": "e129021f-95c1-3931-b06e-b83cdd229515",
                        "target_lang_word": "глобализм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глобализм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "005ae19f-a1c9-380a-ba49-9b687c88f372",
                                        "entry_id": "f8a56e12-cf11-3baf-9f4c-5e3947c896a6",
                                        "glosses": [
                                            "книжн. глобальный, максимально широкий и обобщающий подход к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146966f2-5923-46f9-bec6-b040e5ca9989",
                                                "sense_id": "005ae19f-a1c9-380a-ba49-9b687c88f372",
                                                "text": "Научное и объективное плюралистское сознание упрекнёт нас: не нужно приписывать сознанию вредный глобализм, сознание вовсе не претендует на охват мира в целом, оно отражает то, что ему предносится, и лишь в этом, определённом смысле отражает «мир»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cc7f556-a063-3ccf-9b28-8316ea87bb2e",
                                        "entry_id": "f8a56e12-cf11-3baf-9f4c-5e3947c896a6",
                                        "glosses": [
                                            "полит. внешняя политика государства, характеризующаяся вмешательством во внутренние дела других стран"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73c8c5a-c321-4dc9-b7cd-b4fc2d3f38a8",
                                                "sense_id": "5cc7f556-a063-3ccf-9b28-8316ea87bb2e",
                                                "text": "Его связывали тёплые личные отношения с американскими консервативными деятелями Мадлен Олбрайт и Генри Киссинджером и в то же время ― с лидерами арабского мира, резко не принимающими американский глобализм."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36f22ef5-0d1e-3fc4-982c-4df68a574c13",
                                        "entry_id": "f8a56e12-cf11-3baf-9f4c-5e3947c896a6",
                                        "glosses": [
                                            "полит. целостная система взаимосвязанных идеологических, политических, экономических, социальных, военных, культурных и других программ и мероприятий, направленных на утверждение в глобальном масштабе господства той или иной социально-экономической, политической, идеологической, религиозной доктрины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f3152e-fa35-4c21-931c-98e37f121ecf",
                                                "sense_id": "36f22ef5-0d1e-3fc4-982c-4df68a574c13",
                                                "text": "Современная система глобализма представляет собой скорее финал индустриальной стадии развития человечества, «питомник» её предпосылок, нежели начало следующей фазы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
