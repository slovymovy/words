                        "entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                        "glosses": [
                            "A commoner; a member of the lower class of a society."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "14c2278a-be0a-3d6d-8962-29e3e1bc593e",
                        "entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                        "glosses": [
                            "A common person; an unsophisticated or cultureless person."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "5d1ae00d-ccb5-44f9-9db0-01aa8c1006bd",
                                "sense_id": "14c2278a-be0a-3d6d-8962-29e3e1bc593e",
                                "text": "You're under my roof, you pleb."
                            }
                        ]
                    },
                    {
                        "sense_id": "f934fa50-9131-3efa-9b16-c91db54d24b8",
                        "entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                        "glosses": [
                            "A freshman cadet at a military academy."
                        ],
                        "tags": [
                            "US",
                            "derogatory",
                            "slang",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f1718c65-b7fc-478a-9d45-e8f9f739cd68",
                                "sense_id": "f934fa50-9131-3efa-9b16-c91db54d24b8",
                                "text": "I found some of the novices, plebs they are called, home-sick, and weary with their discipline."
                            },
                            {
                                "example_id": "1d42972c-63f3-43c0-af9a-44c642574fac",
                                "sense_id": "f934fa50-9131-3efa-9b16-c91db54d24b8",
                                "text": "At Annapolis, the natives are crabs, the freshmen plebs, the sophomores youngsters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95150458-4933-41c1-b238-61b53fe382d4",
                        "source_entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                        "source_sense_description": "common person",
                        "target_lang_word": "Prolet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prolet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38e4961d-0f85-3444-a1c4-19441b94dfae",
                                        "entry_id": "2573e964-1d87-3c15-99e0-18c6856574ae",
                                        "glosses": [
                                            "Proletarier, Angehöriger der Arbeiterklasse"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1fdae97-3ffe-4ce1-924b-0ecdb0db61ab",
                                                "sense_id": "38e4961d-0f85-3444-a1c4-19441b94dfae",
                                                "text": "Noch hast du die Macht, Prolet, nicht in deinem eig'nen Haus - (Kampflied „Vorwärts, Bolschewik“)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef4d29fd-f775-37c8-a2f1-cba56193c539",
                                        "entry_id": "2573e964-1d87-3c15-99e0-18c6856574ae",
                                        "glosses": [
                                            "ungehobelter, ungebildeter Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcb28f11-b236-4dc6-a0fc-81063e57d12b",
                                                "sense_id": "ef4d29fd-f775-37c8-a2f1-cba56193c539",
                                                "text": "Na, so ein Prolet!"
                                            },
                                            {
                                                "example_id": "753a9a64-04b1-4e02-b249-a0956b26d734",
                                                "sense_id": "ef4d29fd-f775-37c8-a2f1-cba56193c539",
                                                "text": "Die kannst du doch vergessen, das sind alles nur Proleten."
                                            },
                                            {
                                                "example_id": "2c950c6a-8083-486b-8601-5b96fbb5cf59",
                                                "sense_id": "ef4d29fd-f775-37c8-a2f1-cba56193c539",
                                                "text": "Hey, du Prolet, du Vollproll, was willst du?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db23ed88-7db0-47bf-bedd-0816776f295a",
                        "source_entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                        "source_sense_description": "common person",
                        "target_lang_word": "бы́дло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бы́дло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "767ce757-b4e1-3f17-9c2f-0b80aaefc1b8",
                                        "entry_id": "c662a48c-b824-3775-b160-33caafdb2d7e",
                                        "glosses": [
                                            "устар., собир. рабочий рогатый скот"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5300d7e-1229-45e3-a2ff-41f1c3a2e991",
                                                "sense_id": "767ce757-b4e1-3f17-9c2f-0b80aaefc1b8",
                                                "text": "С быдлом, со скотом так обращаться — и то грешно."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "бы́дло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5eee70aa-d7c3-34ec-ae5f-c124e6aa7bd9",
                                        "entry_id": "b42f630c-1173-392a-9a67-0dc2308c23b6",
                                        "glosses": [
                                            "перен., собир. люди, выполняющие тяжёлую работу и занимающие низкое социальное положение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254c2aaf-8da2-4d89-b53c-7a2a51392670",
                                                "sense_id": "5eee70aa-d7c3-34ec-ae5f-c124e6aa7bd9",
                                                "text": "Аристократизм, произведший в Европе вообще рыцарство, в Англии славный институт пэрства, во Франции её блистательное дворянство и изящные, хотя и искусственные формы общественной жизни, даже в Венгрии — её политически развитое магнатство, столько сделавшее для промышленного преуспеяния страны и просвещения народа; в Польше же этот аристократизм обратил высшие сословия в ясновельможное панство и шляхетство, а низшие — в быдло."
                                            },
                                            {
                                                "example_id": "c7291a98-f265-4aec-b00c-009acdeb8e03",
                                                "sense_id": "5eee70aa-d7c3-34ec-ae5f-c124e6aa7bd9",
                                                "text": "— Привык пан считать нас за скотинку, так и зовёт — «быдло»."
                                            },
                                            {
                                                "example_id": "06974267-58c6-4cd6-a1cb-38dc002ae446",
                                                "sense_id": "5eee70aa-d7c3-34ec-ae5f-c124e6aa7bd9",
                                                "text": "Красные части были густо прослоены коммунистическим быдлом из городских хулиганов, по местному — «ракла», которым нечего было терять."
                                            },
                                            {
                                                "example_id": "d7c81ebf-1091-494d-a574-18367f434908",
                                                "sense_id": "5eee70aa-d7c3-34ec-ae5f-c124e6aa7bd9",
                                                "text": "— А то крестьянство теряет лучших членов и вечно останется чернью, быдлом, а дворянство тоже терпит ущерб от прилива некультурных элементов."
                                            },
                                            {
                                                "example_id": "db78f9d6-87e1-45c5-bd81-bc7d75729956",
                                                "sense_id": "5eee70aa-d7c3-34ec-ae5f-c124e6aa7bd9",
                                                "text": "Между рядами и лавками толкалось, тискалось базарное быдло, необозримое скопище простаков, прикопивших за зиму в деревне кое-какой достаток и, на всякий случай, крепко укрутивших этот достаток в карманы нижних портов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab546cd-831a-3df0-9c69-4c6e912ecaa1",
                                        "entry_id": "b42f630c-1173-392a-9a67-0dc2308c23b6",
                                        "glosses": [
                                            "перен., собир., презр. духовно неразвитые, бессловесно покорные люди, подчиняющиеся чужой воле и позволяющие себя эксплуатировать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ee657c-e5a9-4584-a85a-d9fb50e81fde",
                                                "sense_id": "4ab546cd-831a-3df0-9c69-4c6e912ecaa1",
                                                "text": "Эти люди, забыв, что я их облагодетельствовал, на каждом шагу после того бранили при мне русских, говорили, что все мы — идиоты, татары, способные составлять только быдло, и наконец, стали с восторгом рассказывать, как они плюют нашим офицерам в лицо, душат в постелях безоружных наших солдат."
                                            },
                                            {
                                                "example_id": "611aefc1-91ed-43f2-80d2-aa168e86800e",
                                                "sense_id": "4ab546cd-831a-3df0-9c69-4c6e912ecaa1",
                                                "text": "Сегодня они кричат: «мы царские!» — завтра перестанут, лишь бы на нашу бедную долю доставалось побольше таких добрых посланцев! Нужды нет, что это быдло не будет с нами: нам его и не нужно; оно будет само по себе и само за себя; лишь бы поднялось одновременно с нами — и тогда дело наше выиграно!"
                                            },
                                            {
                                                "example_id": "f56e3c1a-628f-4b5c-bb9b-da766d9c8abb",
                                                "sense_id": "4ab546cd-831a-3df0-9c69-4c6e912ecaa1",
                                                "text": "Если я хочу властвовать, я должен уничтожить у подчинённых мне народов всё сильное, одарённое, образованное, всё лучшее, способное к протесту! Останется одно быдло, которое само полезет в ярмо!"
                                            },
                                            {
                                                "example_id": "4994dffa-5285-4e12-88df-dbb4cdb1128b",
                                                "sense_id": "4ab546cd-831a-3df0-9c69-4c6e912ecaa1",
                                                "text": "Все хотят быть быдлом, комфортное чувство стада."
                                            },
                                            {
                                                "example_id": "118565c2-01c6-45e7-9584-a034d384bbf8",
                                                "sense_id": "4ab546cd-831a-3df0-9c69-4c6e912ecaa1",
                                                "text": "Люмпены — да, быдло — да, бомжи — да, охлос — да, тина, поднявшаяся со дна взбаламученного российского пруда, называйте как хотите, но они не дискретны, они постоянны, цельны, их злоба и разрушительная страсть настояны на яростном шовинизме, и, за неимением ничего другого, этот сброд приходится считать народом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a6a38f-492a-3e3f-8a1c-2e109a5d3fcb",
                                        "entry_id": "b42f630c-1173-392a-9a67-0dc2308c23b6",
                                        "glosses": [
                                            "перен., разг., презр. тупой, грубый, неотёсанный, бескультурный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29d62a88-8ff4-4578-a744-59341af09b4a",
                                                "sense_id": "17a6a38f-492a-3e3f-8a1c-2e109a5d3fcb",
                                                "text": "— Я вас не смешиваю с этим русским быдлом… Слава богу, я — человек опытный и хорошо знающий людей. Я отлично вижу, что вы по-настоящему воспитанная барышня, гораздо образованнее, например, чем я сама. Вы тонкая, изящная, умная."
                                            },
                                            {
                                                "example_id": "cc8425e7-95b9-4f14-b924-30e97f3b0aa7",
                                                "sense_id": "17a6a38f-492a-3e3f-8a1c-2e109a5d3fcb",
                                                "text": "Так говорить, да ещё в присутствии старой женщины, могут только хамы, только быдло, даже если оно, это быдло, в мундире с офицерскими погонами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfc9bc1a-7578-3df3-a389-ea19e2b979ad",
                                        "entry_id": "b42f630c-1173-392a-9a67-0dc2308c23b6",
                                        "glosses": [
                                            "перен., бран. употребляется как порицающее или бранное слово"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73103c4-d15d-41d0-9fd1-a8226353c75d",
                                                "sense_id": "dfc9bc1a-7578-3df3-a389-ea19e2b979ad",
                                                "text": "— Шире шаг! — свирепо крикнул роте Качуровский. — Тянутся, как татарская мазница! Чёртово быдло! Выше ногу!"
                                            },
                                            {
                                                "example_id": "5e1231f6-ca5f-428f-8578-d048d6449307",
                                                "sense_id": "dfc9bc1a-7578-3df3-a389-ea19e2b979ad",
                                                "text": "— Грязь соскобли с себя, конское быдло!"
                                            },
                                            {
                                                "example_id": "f4d7dc64-417f-43cb-9d19-82f04c577c12",
                                                "sense_id": "dfc9bc1a-7578-3df3-a389-ea19e2b979ad",
                                                "text": "— Посмотри на себя — ты обычное быдло, ты предсказуем как поведение свиньи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b4f1cd-6906-3bef-8f94-688f2d7a5479",
                                        "entry_id": "b42f630c-1173-392a-9a67-0dc2308c23b6",
                                        "glosses": [
                                            "крим. жарг. умственно отсталый человек"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0474d2c-66ee-35d2-bad3-81d6c8971b17",
                                        "entry_id": "b42f630c-1173-392a-9a67-0dc2308c23b6",
                                        "glosses": [
                                            "крим. жарг. добросовестно работающий заключённый"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b2de6ca-d6b3-4de1-8461-715265ef3e40",
