                ],
                "senses": [
                    {
                        "sense_id": "3eb82d6d-fd7b-3aed-8a08-0fdb86fa365a",
                        "entry_id": "bc1b3bc6-e7d6-3c8d-9a56-e7cf031c282b",
                        "glosses": [
                            "Person, die nach langer Abwesenheit in die Heimat zurückkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa85779-255b-4a7d-9e0a-ec9c7d37a55f",
                                "sense_id": "3eb82d6d-fd7b-3aed-8a08-0fdb86fa365a",
                                "text": "„Doch die Rückkehrer mussten erfahren, dass ihre alte Heimat zu einem Ort ungeordneter, gewaltsamer Deportationen geworden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb9c22e7-4957-350d-81a9-70f3a6b8e6d4",
                        "entry_id": "bc1b3bc6-e7d6-3c8d-9a56-e7cf031c282b",
                        "glosses": [
                            "Person, die aus Kriegsgefangenschaft zurückkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c65ecfb-99c0-4655-946b-1a110afd157d",
                                "sense_id": "eb9c22e7-4957-350d-81a9-70f3a6b8e6d4",
                                "text": "„Und das Los, das viele der Rückkehrer zu Hause erwartete, war kaum weniger beklagenswert als das Schicksal, dem sie mit Mühe und Not entgangen waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
