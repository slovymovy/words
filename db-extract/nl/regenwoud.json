                    },
                    {
                        "form_id": "62668c71-1ba0-4a58-b146-8f931f06ed06",
                        "entry_id": "b290fabd-6963-3fd4-851c-30025200ac74",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "regenwoudjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76bb9888-4709-303c-803f-7064054981db",
                        "entry_id": "b290fabd-6963-3fd4-851c-30025200ac74",
                        "glosses": [
                            "een bos in een klimaat met het hele jaar door neerslag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cea17412-9a65-413e-beb3-3d4b75c6d15c",
                                "sense_id": "76bb9888-4709-303c-803f-7064054981db",
                                "text": "Een tropisch regenwoud."
                            },
                            {
                                "example_id": "60063808-10c9-4233-8e51-e5cd9aedddf1",
                                "sense_id": "76bb9888-4709-303c-803f-7064054981db",
                                "text": "Regenwouden kennen een enorme soortenrijkdom van dieren en planten."
                            },
                            {
                                "example_id": "591f66b9-505c-4653-aa44-2080ff1aebe7",
                                "sense_id": "76bb9888-4709-303c-803f-7064054981db",
                                "text": "Het Amazoneregenwoud ligt in Zuid-Amerika. Het is gigantisch groot. Zo groot als de helft van Europa. Het regenwoud ligt verspreid over negen landen. Het grootste deel ligt in Brazilië. Het gebied is voor heel de wereld belangrijk. Want er leven veel bijzondere bomen, planten en dieren. Een deel van het gebied staat op de Werelderfgoedlijst."
                            },
                            {
                                "example_id": "14a99bd1-c3c2-426f-99bd-473ef852dc5c",
                                "sense_id": "76bb9888-4709-303c-803f-7064054981db",
                                "text": "Trouwens de schrijver houdt zich ook niet geheel aan zijn indeeling, zoo is b.v. de fraaiste afbeelding van een tropisch regenwoud afkomstig van den Gedeh en zeker op minstens 1000 M. hoogte genomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3894470f-7dcb-4773-ba61-dd16868f04d4",
                        "source_entry_id": "b290fabd-6963-3fd4-851c-30025200ac74",
                        "source_sense_id": "76bb9888-4709-303c-803f-7064054981db",
                        "source_sense_description": "een bos in een klimaat met het hele jaar door neerslag",
                        "target_lang_word": "Regenwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                        "entry_id": "6ea9491a-eb21-30e2-a726-68b1d6e62509",
                                        "glosses": [
                                            "naturbelassener Wald mit mehr als 2000 mm Niederschlag im Jahresmittel"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3976e9ef-0712-4604-93eb-56e03e667b79",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„Nahe dem Äquator gedeihen Bäume in strahlender Sonne, heftigem Regen und ganzjähriger Wärme. Das Ergebnis ist ein dichter tropischer Regenwald, eines der artenreichsten Gebiete der Erde.“"
                                            },
                                            {
                                                "example_id": "f8ed6d6c-13af-4746-958b-f9e8b9f1ac1a",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„Im Regenwald gibt es mehr Möglichkeiten, auf der Stelle tot umzufallen, als sich irgendwer vorstellen kann, der niemals dort lebte.“"
                                            },
                                            {
                                                "example_id": "0726d4ab-8c41-4db0-867f-f979b852e9be",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„In Asien und Afrika verschwinden die Regenwälder vielerorts, um Bäume für Palmöl anbauen zu können.“"
                                            },
                                            {
                                                "example_id": "6021e910-5763-4b16-9f8a-1bb5434a3be1",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„In Brasilien werden Regenwälder gerodet, um zusätzliche Anbauflächen für Zuckerrohr für die Bioethanolproduktion zu schaffen.“"
                                            },
                                            {
                                                "example_id": "68df4677-a1c9-4143-93e5-a41a5bc4d221",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„Der Schwund tropischer Regenwälder hielt 2021 nach Satellitenbild-Auswertungen unverändert an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b0c8058-6aaf-432f-ad06-a4a15fc71f6f",
                        "source_entry_id": "b290fabd-6963-3fd4-851c-30025200ac74",
                        "source_sense_id": "76bb9888-4709-303c-803f-7064054981db",
                        "source_sense_description": "een bos in een klimaat met het hele jaar door neerslag",
                        "target_lang_word": "rain forest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rain forest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                        "entry_id": "7904db58-422f-31fd-a6af-6e4054b78275",
                                        "glosses": [
                                            "Alternative form of rainforest."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74bb843e-4ff6-4872-8e8e-7ca7d4cff890",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "In recent years, the problems of the tropical rain forests have become an almost daily topic of conversation."
                                            },
                                            {
                                                "example_id": "58785e0e-74a4-4f95-8b9d-f758b9ed0671",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "2002, Rain Forests of the World, Marshall Cavendish Corporation, page 449,\nTropical rain forests have a greater variety of plants than any other place on Earth."
                                            },
                                            {
                                                "example_id": "9755185b-a566-4141-a2e6-fc7a3235fde5",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "Here's some more left-wing nonsense, this time from the environmentalists, the folks who gave us the rain forest. \"Save the rain forest.\" They decided to call it that because they needed to raise money, and they knew no one would give them money to save a jungle. \"Save the jungle\" doesn't sound right."
                                            },
                                            {
                                                "example_id": "63dffe3b-7876-4587-9d95-1f40864bad10",
                                                "sense_id": "977202aa-8f8b-34e9-8b49-853b66c377bf",
                                                "text": "A large number of everyday foodstuffs that we enjoy today have their origins in the rain forests of the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "364b956b-f09c-4d5f-9465-1f441f6e7d26",
