                                        "sense_id": "9b649152-6d11-34e0-b50e-574cfe7ded29",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A person whose occupation is to clean things, especially rooms, floors, and windows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b095080b-97c4-420a-a9d6-80c6e9262faf",
                                                "sense_id": "9b649152-6d11-34e0-b50e-574cfe7ded29",
                                                "text": "The cleaner worked, of course, at nights. He had to coal and light up the engine, as well as clean it, for the next day's work, which commenced with a light run to Barnham to \"bring in the goods\" from that station at about 6.30 a.m."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd689c9-89ab-3cb0-82be-fbf47677586c",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A device that cleans, such as the vacuum cleaner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef93602a-6e1e-37c6-9d16-cea530bb0f90",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A substance used for cleaning; especially, one retailed for that purpose and meant for use on things other than one's own body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751d43b9-b69a-4297-84e6-b4dc4a0dfd1b",
                                                "sense_id": "ef93602a-6e1e-37c6-9d16-cea530bb0f90",
                                                "text": "Near-synonym: cleaning fluid"
                                            }
                                        ]
                                    },
                                    {
