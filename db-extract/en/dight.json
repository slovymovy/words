            {
                "entry_id": "674873bc-4a4a-388e-ac27-85fab61ec232",
                "word": "dight",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "856764cb-a281-359a-b056-560a98ede2a9",
                        "entry_id": "674873bc-4a4a-388e-ac27-85fab61ec232",
                        "glosses": [
                            "simple past or past participle: adorned, decorated, or furnished (with); dressed, arrayed, or decked out."
                        ],
                        "tags": [
                            "archaic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f213a2a7-d58c-4c2d-b480-14b7d3133873",
                                "sense_id": "856764cb-a281-359a-b056-560a98ede2a9",
                                "text": "Right against the eastern gate, / Where the great sun begins his state, / Robed in flames, and amber light, / The clouds in thousand liveries dight[…]."
                            },
                            {
                                "example_id": "e348c50e-9995-4ed0-b410-0146c8d9f109",
                                "sense_id": "856764cb-a281-359a-b056-560a98ede2a9",
                                "text": "[…]the veil lifted and discovered beneath it fifty horsemen, ravening lions to the sight, in steel armour dight."
                            },
                            {
                                "example_id": "f4b0cde5-d4a4-4a6f-a8fc-867e5fd13b3b",
                                "sense_id": "856764cb-a281-359a-b056-560a98ede2a9",
                                "text": "[…]nor is there found, in sea or on land, a sweeter or pleasanter of gifts than she; for she is prime in comeliness and seemlihead of face and symmetrical shape of perfect grace; her cheek is ruddy dight, her brow flower white, her teeth gem-bright, her eyes blackest black and whitest white, her hips of heavy weight, her waist slight and her favour exquisite."
                            }
                        ]
                    }
                ],
