                "senses": [
                    {
                        "sense_id": "df3b5639-a39d-3bd1-bfba-3b8b56adaaf3",
                        "entry_id": "adc14271-d910-31a8-99b4-d8c587c04d03",
                        "glosses": [
                            "kleine Speise, die in gehobenen Restaurants (unverlangt) noch vor der Vorspeise serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad12e44-82c3-4f09-bf1e-94c94437540f",
                                "sense_id": "df3b5639-a39d-3bd1-bfba-3b8b56adaaf3",
                                "text": "„Bei unserem Besuch bekommen wir zum Aperitif zwei Sorten Baguette mit Butter, Aioli und Salz serviert, wenig später als Amuse-Gueule eine köstliche, leicht scharfe Entenconsommé mit Ingwer und Zitronengras.“"
                            },
                            {
                                "example_id": "3bb90ddf-dae5-4605-a98c-048044081cad",
                                "sense_id": "df3b5639-a39d-3bd1-bfba-3b8b56adaaf3",
                                "text": "„Jetzt ist Manfred Schwarz, dieser Garant der Pfälzer Beständigkeit, nach Heidelberg umgezogen, in ein modernes Restaurant in einem Hochhaus. Und was kocht er dort neben den üblichen Glanzlichtern der Hochküche? Er kocht zwar keinen Saumagen mehr, aber wenn er Champagnergekräusel auf die Karte schreibt, dann ist das seine Edelvariante von Kutteln. Blut- und Leberwurst werden oft als Amuse-Gueule serviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
