                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9aaa26a6-0bdb-4061-a0ba-c7839eaecf66",
                        "entry_id": "3539d1bf-7428-34e6-bed3-d3f8a244c458",
