                                "target_senses": [
                                    {
                                        "sense_id": "e502ad91-2007-37aa-811c-f123b58d5292",
                                        "entry_id": "47ca055d-3cf8-3dbe-951f-83cc7fb99bae",
                                        "glosses": [
                                            "Entfernung von Körperhaaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8354f7-54b2-4bd0-b946-940ff8c2993a",
                                                "sense_id": "e502ad91-2007-37aa-811c-f123b58d5292",
                                                "text": "„Die Epilation gliedert sich in dauerhafte Verfahren, bei denen die Haarwurzel zerstört wird, und in nicht-dauerhafte Verfahren, bei denen das Haar nur ausgerissen wird, ohne die Haarwurzel zu zerstören, und nach einiger Zeit – allerdings erst nach einer längeren Zeitspanne als bei der Depilation – wieder nachwächst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19c74a76-0b85-455d-b5f5-d5d93f3b6733",
                        "source_entry_id": "dab6b1ed-7df5-3ad7-910e-f0b956549cb3",
                        "source_sense_id": "c1b141c6-c8a8-3e14-aa33-ebb93f968a89",
                        "target_lang_word": "épilage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épilage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc99886d-0341-3065-a5c8-ffb7c5d461f6",
                                        "entry_id": "2f0c8431-7e9c-3f60-a31e-0565931cf11a",
                                        "glosses": [
                                            "Action d'épiler ou de s'épiler. On emploie plus couramment « épilation »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f978f609-ab35-4263-ab7b-00646d90f733",
                                                "sense_id": "cc99886d-0341-3065-a5c8-ffb7c5d461f6",
                                                "text": "Elle redessinait ses sourcils par un épilage savant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59cb16f-d64e-3d31-9e89-7d4fed28d4b0",
                                        "entry_id": "2f0c8431-7e9c-3f60-a31e-0565931cf11a",
                                        "glosses": [
                                            "Opération qui consiste à débarrasser les peaux de leurs poils avant le tannage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c5ff20-dbb6-4622-96ac-6977e70fe6c2",
                                                "sense_id": "a59cb16f-d64e-3d31-9e89-7d4fed28d4b0",
                                                "text": "Dans l’épilage à l’échauffe, les peaux sont disposées l’une sur l’autre ou suspendues dans une chambre chaude et humide pour favoriser l’action bactérienne qui libère les poils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89c5849c-61f1-4e5a-84ec-27b64676d4f3",
                        "source_entry_id": "dab6b1ed-7df5-3ad7-910e-f0b956549cb3",
                        "source_sense_id": "c1b141c6-c8a8-3e14-aa33-ebb93f968a89",
                        "target_lang_word": "épilation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épilation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                        "entry_id": "39c27b01-5ded-3ef3-9e7a-f6fee5670c1a",
                                        "glosses": [
                                            "Suppression des poils ou des cheveux opérée par divers procédés manuels, mécaniques, électriques ou chimiques, généralement par souci d’esthétique, de confort, d’hygiène ou de décence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1734625-ce09-49dc-9759-ecd117c1601b",
                                                "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                                "text": "La haine de cette femme. De sa petite vie nourrie de crèmes de beauté et de fonds de teint. De parfums, de houppettes, d’épilations « maillot », de laits autobronzants."
                                            },
                                            {
                                                "example_id": "75f584cd-e13a-4dab-bf85-2a0ad6fa60ff",
                                                "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                                "text": "Parmi cinq ou six (exactement six) Anglo-Saxons, qu’à leur épilation excessive je connus Américains, se tenait assise, aussi vivante qu’il lui était loisible, mon amie Nane."
                                            },
                                            {
                                                "example_id": "a3a1b75f-cd53-43d6-bbc2-c819a8de3fe4",
                                                "sense_id": "fb35a8f1-6485-3be6-ab67-553b59b0af3a",
                                                "text": "Après cela ce fut le tour de l’esthéticienne pour une épilation complète : jambes, aisselles, maillot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
