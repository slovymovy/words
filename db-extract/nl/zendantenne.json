                    {
                        "sense_id": "6181c4c9-ffd5-3a3b-8fd4-dc68e9ff1b93",
                        "entry_id": "11c6c9c9-d2b9-30d3-8f4a-56bab223b2ca",
                        "glosses": [
                            "een vrij opgestelde elektrische geleider, de straler, voor het uitzenden van elektromagnetische straling in het radiofrequentie gedeelte van het elektromagnetische spectrum. De straler kan worden gecombineerd met directoren en/of een reflector om een richtwerking te verkrijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df1bb69-68c0-4e5a-95b2-9497f59d6c8c",
                                "sense_id": "6181c4c9-ffd5-3a3b-8fd4-dc68e9ff1b93",
                                "text": "Goede isolatie is bij een zendantenne noodzakelijk want er kunnen hoge spanningen ontstaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "544625cb-935a-4f67-a6f8-db144736705e",
                        "source_entry_id": "11c6c9c9-d2b9-30d3-8f4a-56bab223b2ca",
                        "source_sense_id": "6181c4c9-ffd5-3a3b-8fd4-dc68e9ff1b93",
                        "source_sense_description": "een vrij opgestelde elektrische geleider",
                        "target_lang_word": "Sendeantenne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sendeantenne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d292a88-c95d-3935-83c0-535b82efebc2",
                                        "entry_id": "4bcec953-523d-3f07-8088-cd39021b29f4",
                                        "glosses": [
                                            "Antenne, die für das Abstrahlen von elektromagnetischen Wellen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b40b90d-e79a-419c-af44-7932100ec344",
                                                "sense_id": "2d292a88-c95d-3935-83c0-535b82efebc2",
                                                "text": "„Der zu übertragende Inhalt wird durch sogenannte Modulation per Trägerwelle von der Sendeantenne abgestrahlt.“"
                                            },
                                            {
                                                "example_id": "357cc907-d950-4cbe-ace3-34674900c092",
                                                "sense_id": "2d292a88-c95d-3935-83c0-535b82efebc2",
                                                "text": "„Vergangene Woche setzte ein Spezialhubschrauber eine neue Sendeantenne auf den Olympiaturm.“"
                                            },
                                            {
                                                "example_id": "741b6120-974c-47f0-9406-4d4eed6f3467",
                                                "sense_id": "2d292a88-c95d-3935-83c0-535b82efebc2",
                                                "text": "„Das ist riskant, Cassini rast mit 110.000 km/h, deshalb fliegt sie mit der Sendeantenne voran in die gefährliche Zone, sie soll als Schutzschild dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
