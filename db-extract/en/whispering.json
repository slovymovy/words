                ],
                "senses": [
                    {
                        "sense_id": "59e26aa4-9253-3b3a-8ba2-a622a34d6fc0",
                        "entry_id": "04e9fcb9-5792-3b32-a468-0f2ee0a3e874",
                        "glosses": [
                            "Something that is whispered; gossip; a rumor."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7f644e24-4c82-3cfb-a19b-93f252999b28",
                        "entry_id": "04e9fcb9-5792-3b32-a468-0f2ee0a3e874",
                        "glosses": [
                            "The sound of whispers;"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a2970c-9456-4c10-957d-373822129d9d",
                                "sense_id": "7f644e24-4c82-3cfb-a19b-93f252999b28",
                                "text": "The tendency of modern science is to close this gate—though it can never stop the search for it—the vague desire after some kind of communication, some kind of poetic identification with the soul that reveals itself through the rolling year, the mysterious presence that is felt to lie behind the outbuddings of spring, the wealth and greenery of summer, with all its whisperings and music and rippling laughter, the blue of autumn, with its fruitage, its expansive horizons, its glory veiling temporary decay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec777511-5afc-4822-8593-cfd2cd875e70",
                        "source_entry_id": "04e9fcb9-5792-3b32-a468-0f2ee0a3e874",
                        "source_sense_description": "Something that is whispered",
                        "target_lang_word": "chuchotement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chuchotement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee7f942-2836-3479-9d1b-8133b8ed35a9",
                                        "entry_id": "3bdad0a4-fd52-35b9-9e1e-e2da8cfed361",
                                        "glosses": [
                                            "Action de chuchoter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9905bcb3-17f4-425b-8dbc-df96f21c8c4f",
                                                "sense_id": "6ee7f942-2836-3479-9d1b-8133b8ed35a9",
                                                "text": "Il ne mêle plus, à ce qu’il nommait nos « jeux », ce libertinage qui s’aide d’une combinaison de miroirs, d’un livre… belge, de mots faits pour le chuchotement et qu’on se force à crier à haute voix, tout crus…"
                                            },
                                            {
                                                "example_id": "348c0a32-c87c-44a6-8d26-660e01d173d6",
                                                "sense_id": "6ee7f942-2836-3479-9d1b-8133b8ed35a9",
                                                "text": "À pas dignes, il monta les quelques marches de la tribune, adressa à ses fidèles un ample geste de salutation destiné à faire taire les chuchotements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac3d8fe-1673-3ec5-9a82-e8d17ad66327",
                                        "entry_id": "3bdad0a4-fd52-35b9-9e1e-e2da8cfed361",
                                        "glosses": [
                                            "Bruit fait par cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d2de777-1048-483f-b268-abf1d0e9a426",
                                                "sense_id": "6ac3d8fe-1673-3ec5-9a82-e8d17ad66327",
                                                "text": "Enfin, en ces temps particulièrement bruyants médiatiquement, de nombreux fans d’Arte y apprécient les silences et chuchotements, et l’absence d'émissions et de jingles criards."
                                            },
                                            {
                                                "example_id": "d70ef458-b6ae-434d-91e0-be94eaabb161",
                                                "sense_id": "6ac3d8fe-1673-3ec5-9a82-e8d17ad66327",
                                                "text": "Un rideau de velours grenat s’abaissait lentement, cependant que s’atténuait la lumière et que bruissaient les derniers chuchotements."
                                            },
                                            {
                                                "example_id": "ca7ed6bd-e52d-43c8-9cac-0089597ccf6e",
                                                "sense_id": "6ac3d8fe-1673-3ec5-9a82-e8d17ad66327",
                                                "text": "La fin ressemblait plus à un épuisement qu’à un arrêt —un diminuendo où le martèlement du rythme se changea en un chuchotement qui se prolongea bien au-delà du vrai silence où il finit par se fondre."
                                            },
                                            {
                                                "example_id": "a668d5e4-6806-409d-8f76-ab2710e7a357",
                                                "sense_id": "6ac3d8fe-1673-3ec5-9a82-e8d17ad66327",
                                                "text": "Ses pieds s’enfonçaient dans les feuilles mortes comme dans une eau bruyante et, pendant quelques minutes, ce grand chuchotement bavard l’empêcha de réfléchir."
                                            },
                                            {
                                                "example_id": "7b31738e-6ab6-4f2d-bedf-83d7c4ce85be",
                                                "sense_id": "6ac3d8fe-1673-3ec5-9a82-e8d17ad66327",
                                                "text": "Héloïse dit et redit son chapelet. Les grains cliquettent de minute en minute et sans relâche, le chuchotement rapide des oraisons s’allonge."
                                            },
                                            {
                                                "example_id": "6bb0e5ef-1221-4131-9155-443e9bafac61",
                                                "sense_id": "6ac3d8fe-1673-3ec5-9a82-e8d17ad66327",
                                                "text": "Les bruits de la brousse —craquements, caquètements, craquètements, cliquètements, coassements, croassements, criaillements, couinements, chuchotements— forment un langage secret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a4b099-f4d7-4829-b665-9a395cf013a3",
                        "source_entry_id": "04e9fcb9-5792-3b32-a468-0f2ee0a3e874",
                        "source_sense_description": "Something that is whispered",
                        "target_lang_word": "Geflüster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geflüster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                        "entry_id": "9ce12df3-badd-373d-981b-393770bd5f4a",
                                        "glosses": [
                                            "durch ein sehr leises Miteinander-Sprechen verursachtes anhaltendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee006756-b6a1-4673-bd0f-005afbfab824",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "Das Geflüster in den hinteren Reihen stört die Veranstaltung."
                                            },
                                            {
                                                "example_id": "bd53957a-ae43-4d50-9db5-d5b3d9d0f4f5",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Plötzlich war Geflüster zu hören.“"
                                            },
                                            {
                                                "example_id": "f501a22a-82a7-4874-803b-a40910d9c163",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Es kam Frau Holle vor, als ob mit dem ersten Dämmerlicht ein Geflüster und Gemurmel durch das Ruinenviertel ging.“"
                                            },
                                            {
                                                "example_id": "65b95749-3782-4f02-be9a-bf137524ce6c",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Über ihrem ernsten Geflüster am prasselnden Feuer schlief ich ein.“"
                                            },
                                            {
                                                "example_id": "695a92ee-5d7f-4f2e-86a1-7f1efbd25386",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Ich machte kehrt und malte mir das Geflüster und die fade Küsserei aus, die hinter meinem Rücken aufs neue begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
