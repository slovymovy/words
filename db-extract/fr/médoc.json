            {
                "entry_id": "ac7d66fd-dc39-3bbc-bcd4-6021cd10ae11",
                "word": "médoc",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b367b32c-11dd-3b27-a572-1e883725ce44",
                        "entry_id": "ac7d66fd-dc39-3bbc-bcd4-6021cd10ae11",
                        "glosses": [
                            "Medikament, Arznei, Arzneimittel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f2cab98-889e-44c9-9bd3-7efbc6ce1ce9",
                        "source_entry_id": "ac7d66fd-dc39-3bbc-bcd4-6021cd10ae11",
                        "source_sense_id": "b367b32c-11dd-3b27-a572-1e883725ce44",
                        "source_sense_description": "umgangssprachlich: Medikament, Arznei, Arzneimittel",
                        "target_lang_word": "Medikament",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Medikament",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                        "entry_id": "50bb2715-63a6-381c-8953-f5deff53a059",
                                        "glosses": [
                                            "ein Arzneimittel, das in bestimmter Dosierung zur Heilung, Vorbeugung oder Linderung einer Krankheit dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14322a1-cbe7-446c-9417-c545a3174268",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "Medikamente dürfen nicht zu hoch dosiert werden."
                                            },
                                            {
                                                "example_id": "1448bccf-0a06-4077-97c0-a2517a6bed55",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "Rezeptpflichtige Medikamente dürfen von deutschen Verbrauchern nach einem heute veröffentlichten Urteil des Landgerichts Frankfurt am Main auch bei so genannten Internetapotheken bestellt werden."
                                            },
                                            {
                                                "example_id": "83852a63-3c50-42d2-a9e8-3f44e15ffbce",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "Ganze OP-Säle mit Operationstischen, Medikamenten und chirurgischen Instrumenten gehören dazu."
                                            },
                                            {
                                                "example_id": "1202a670-6e50-4a6b-b79e-72e78461cafa",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "Denn der ehemalige Berliner Patient nimmt sein fünf Jahren keine Medikamente gegen HIV mehr."
                                            },
                                            {
                                                "example_id": "1d438a49-439d-4e2c-99c9-f598fbcec26a",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "Dazu gehört auch, dass Medikamente, sogenannte Generika, bei verschärftem Urheberrecht teurer werden könnten."
                                            },
                                            {
                                                "example_id": "1d310cb1-3ef7-4721-b113-50eb0dbc341f",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "„Kritiker verweisen darauf, dass Medikamente gezielt und nicht unbewusst mit dem täglichen »Butterbrot« eingenommen werden sollten.“"
                                            },
                                            {
                                                "example_id": "2cca65d4-de17-4af1-9c8e-c1f00799e102",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "„Allerdings war das Wissen über die korrekte Anwendung von Antibiotika äußerst lückenhaft: So glauben 65 Prozent, dass Antibiotika gegen Erkältungen und Schnupfen helfen - dabei richten solche Medikamente gegen Viruserkrankungen nichts aus und helfen nur gegen bakterielle Infektionen.“"
                                            },
                                            {
                                                "example_id": "8c773a67-049e-41b8-8d0c-47a3cb7bcec5",
                                                "sense_id": "8d764678-c333-3841-8188-556c9516f4e1",
                                                "text": "Es gab ja [im MIttelalter] wenig wirksame Medikamente und deswegen schrieb man sich Bibelsprüche oder kraftvolle Worte auf einen Zettel, hat den Zettel zusammengerollt und dann gekaut und heruntergeschluckt, um sich die Kraft dieser Worte einzuverleiben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95969460-4d29-44a3-a029-e97165fd6fe1",
                        "source_entry_id": "ac7d66fd-dc39-3bbc-bcd4-6021cd10ae11",
                        "source_sense_id": "b367b32c-11dd-3b27-a572-1e883725ce44",
                        "source_sense_description": "umgangssprachlich: Medikament, Arznei, Arzneimittel",
                        "target_lang_word": "Arznei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arznei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                        "entry_id": "ce60c3d0-f35d-3bc3-8ac2-ce9138635530",
                                        "glosses": [
                                            "Mittel gegen körperliche oder psychische Beschwerden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837931bc-1297-456a-a275-fd056f50e3c7",
                                                "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                                "text": "Es gibt noch nicht gegen alle Krankheiten eine wirksame Arznei."
                                            },
                                            {
                                                "example_id": "ee8b1de6-c5d1-4038-b9da-fce4df5642fe",
                                                "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                                "text": "„Sie erhielt drei Scherf Silber und flößte dem Kleinen etwas Arznei ein.“"
                                            },
                                            {
                                                "example_id": "f2f8340b-3fbc-42db-ace6-e0c0cce71864",
                                                "sense_id": "62286444-7df9-367a-9005-dbe18b4938ce",
                                                "text": "„Obwohl er ärztlich behandelt, zur Ader gelassen und mit allerlei Arzneien angefüllt wurde, genas er doch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41b8b4c6-2d89-45fd-a747-266a97ed1a07",
                        "source_entry_id": "ac7d66fd-dc39-3bbc-bcd4-6021cd10ae11",
                        "source_sense_id": "b367b32c-11dd-3b27-a572-1e883725ce44",
                        "source_sense_description": "umgangssprachlich: Medikament, Arznei, Arzneimittel",
                        "target_lang_word": "Arzneimittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arzneimittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83026eff-bb10-3398-9870-a025aea7ee03",
                                        "entry_id": "255b77da-512d-370f-b4e5-954db2658c64",
                                        "glosses": [
                                            "Stoff oder Zubereitung, die am oder im Körper angewendet werden soll und Krankheiten heilen, Krankheitserreger abtöten oder vom Körper produzierte Wirkstoffe ersetzen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4796501b-d857-4984-96b1-dcd6e08eaf06",
                                                "sense_id": "83026eff-bb10-3398-9870-a025aea7ee03",
                                                "text": "Das Arzneimittel wird in der Apotheke frisch für den Patienten angerührt."
                                            },
                                            {
                                                "example_id": "76127349-510a-4464-8e2c-721156279eaa",
                                                "sense_id": "83026eff-bb10-3398-9870-a025aea7ee03",
                                                "text": "Aus den Abwässern von Krankenhäusern landen erhebliche Mengen von Arzneimitteln in der Kanalisation."
                                            },
                                            {
                                                "example_id": "7a4e01a2-83b1-4a52-828a-eddbcf05e77b",
                                                "sense_id": "83026eff-bb10-3398-9870-a025aea7ee03",
                                                "text": "„Bei knapp der Hälfte der Arzneimittel war laut dem BAG keine Preissenkung notwendig.“"
                                            },
                                            {
                                                "example_id": "6faf36a0-8bbd-4457-b435-5aae58cb9f24",
                                                "sense_id": "83026eff-bb10-3398-9870-a025aea7ee03",
                                                "text": "„Geschlechtsgenuß hat etwas von der Wirkung eines Heilkrauts, einer Kraftdroge, eines Arzneimittels an sich, er hat in der Tat viel mit dem Genuß eines Ginsong-Wurzelsuds gemeinsam.“"
                                            },
                                            {
                                                "example_id": "ff5f4d30-d662-477a-bf78-ea47c6356c76",
                                                "sense_id": "83026eff-bb10-3398-9870-a025aea7ee03",
                                                "text": "„Ob es sich nun um den Honig oder das berühmte Gelée royale handelt, das die Bienen ihren Königinnenlarven füttern und das bei uns für Arzneimittel und Kosmetika sehr begehrt ist – in Ägypten wurden die Erzeugnisse der Bienen als rar und wertvoll angesehen.“"
                                            },
                                            {
                                                "example_id": "7886ddf7-24d3-4519-9498-26085374b6e9",
                                                "sense_id": "83026eff-bb10-3398-9870-a025aea7ee03",
                                                "text": "„Barberou schickte es und gab in seinem Brief eine Apotheke für die Arzneimittel an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
