                "senses": [
                    {
                        "sense_id": "170807b7-081b-39db-8464-57e755d46535",
                        "entry_id": "8d952960-546d-3f7e-92ff-2fa5e5322464",
                        "glosses": [
                            "altgriechische Figur, die meist aus Holz geschnitzt ist und einen Menschen oder einen Gott darstellt"
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "eb49c7df-ff3d-4598-a256-9630299eb379",
                                "sense_id": "170807b7-081b-39db-8464-57e755d46535",
                                "text": "Untrennbar mit den Tempeln der Akropolis verbunden ist die Frage nach dem oder den archaischen Kultbildern der Athena. In den Schriftquellen wird allein das vom Himmel gefallene Xoanon der Athena Polias aus Olivenholz erwähnt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61aeee02-8a54-4a57-912c-02e5a7c8f2bf",
                        "source_entry_id": "8d952960-546d-3f7e-92ff-2fa5e5322464",
                        "source_sense_id": "170807b7-081b-39db-8464-57e755d46535",
                        "target_lang_word": "xoanon",
