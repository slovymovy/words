                    },
                    {
                        "translation_id": "081a1b75-739c-4e5b-977c-61c3871f3cb3",
                        "source_entry_id": "aa20d19f-781b-3cbf-ae3f-637b17ed4563",
                        "source_sense_id": "19588792-dc79-37d8-ad6f-7d4e623f7d66",
                        "target_lang_word": "Gewohnheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewohnheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4c4c19-5eca-341b-a8f1-92a3cabaa27c",
                                        "entry_id": "50065a5b-224b-3a18-a69e-d78612693dde",
                                        "glosses": [
                                            "Handlung, die zur Routine wurde und immer wieder, oft unbewusst, wiederholt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82798549-e242-46a3-8724-a105413d4413",
                                                "sense_id": "dc4c4c19-5eca-341b-a8f1-92a3cabaa27c",
                                                "text": "Er hat schon aus Gewohnheit angefangen, sich auf japanisch zu entschuldigen."
                                            },
                                            {
                                                "example_id": "d718511b-0f21-4809-b8bd-7fc0d0b35445",
                                                "sense_id": "dc4c4c19-5eca-341b-a8f1-92a3cabaa27c",
                                                "text": "„Die Nachtschwärmer ändern nichts an ihren Gewohnheiten, nur die Mafia lernt sehr schnell, sich auf den Handel mit harten Drogen umzustellen.“"
                                            },
                                            {
                                                "example_id": "8b75f93a-0c9a-496c-a447-b3681405cea5",
                                                "sense_id": "dc4c4c19-5eca-341b-a8f1-92a3cabaa27c",
                                                "text": "„Das römische Recht hinderte die Germanen, alte Gewohnheiten auszuleben wie Blutrache und Beutezüge.“"
                                            },
                                            {
                                                "example_id": "f03f3cab-6f41-4eb5-a36c-7e508127ea24",
                                                "sense_id": "dc4c4c19-5eca-341b-a8f1-92a3cabaa27c",
                                                "text": "„Aus alter Gewohnheit drückte er eine Zigarette in der Kaffeetasse des verfluchten Karlsson aus, bevor er mit finsterer Entschlossenheit die Treppenstufen zum Flur hinaufhastete.“"
                                            },
                                            {
                                                "example_id": "59f5a980-f68c-4cd9-ad25-9922794a3adc",
                                                "sense_id": "dc4c4c19-5eca-341b-a8f1-92a3cabaa27c",
                                                "text": "„Als Natascha mit einem ihr schon zur Gewohnheit gewordenen Griff die Tür öffnete, um Prinzessin Marja vor sich eintreten zu lassen, da fühlte die Prinzessin das aufsteigende Schluchzen in ihrer Kehle.“"
                                            },
                                            {
                                                "example_id": "fc59d5e7-b400-4e68-9d26-d09fac83dcc5",
                                                "sense_id": "dc4c4c19-5eca-341b-a8f1-92a3cabaa27c",
                                                "text": "„In kaum einer anderen Sportart werden Gewohnheiten derart gepflegt wie im Tischtennis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daf5131d-279a-4b78-9072-09c653aafd41",
                        "source_entry_id": "aa20d19f-781b-3cbf-ae3f-637b17ed4563",
                        "source_sense_id": "19588792-dc79-37d8-ad6f-7d4e623f7d66",
                        "target_lang_word": "Angewohnheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angewohnheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80fa7aca-68e9-3bc0-8d77-807c0cd08f32",
                                        "entry_id": "7addbc50-9baa-3241-868a-d976813db36e",
                                        "glosses": [
                                            "Handlung, die zur Routine wurde und immer wieder, oft unbewusst, wiederholt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49850bd7-c0ff-42b7-a40e-11e8f0f106e4",
                                                "sense_id": "80fa7aca-68e9-3bc0-8d77-807c0cd08f32",
                                                "text": "Er hat die Angewohnheit, sich immer wieder zu entschuldigen."
                                            },
                                            {
                                                "example_id": "00b4ca70-6b33-4115-bcae-afba90359228",
                                                "sense_id": "80fa7aca-68e9-3bc0-8d77-807c0cd08f32",
                                                "text": "„Jedenfalls erinnere ich mich sehr gut daran, daß diese lobenswerte Angewohnheit seinem Zweiten Ingenieur zuwider war.“"
                                            },
                                            {
                                                "example_id": "2e9e7820-a324-4a3d-bdf0-f40d58db196c",
                                                "sense_id": "80fa7aca-68e9-3bc0-8d77-807c0cd08f32",
                                                "text": "„Er hatte die Angewohnheit, sich wiederholt mit dem Handrücken die Nase zu reiben.“"
                                            },
                                            {
                                                "example_id": "4cef5432-06b9-4b0f-b254-8b66c4e8aa01",
                                                "sense_id": "80fa7aca-68e9-3bc0-8d77-807c0cd08f32",
                                                "text": "„Wie er mich ablenkte mit seiner Angewohnheit, beim Fahren mit einer Hand zu gestikulieren, wenn wir uns über die richtige Ordnung eines Bibliothekskatalogs austauschten und die Restauration von antikem Papier, über Landkarten und alte Manuskripte – und das nicht nur, weil er mich mit seinem Fahrstil in Todesangst versetzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
