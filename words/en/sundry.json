{
    "word_family": [
        "sunder"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d508f90-51cd-3424-b244-e474f340f3aa",
                    "sense_definition": "More than one or two but not very many; several.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author gathered information from <w>sundry</w> reliable sources to write the book.",
                            "target_lang_translations": {
                                "cs": "Autor shromáždil informace z <w>několika</w> spolehlivých zdrojů, aby knihu napsal."
                            }
                        },
                        {
                            "text": "He made <w>sundry</w> attempts to fix the broken machine before finally calling a professional.",
                            "target_lang_translations": {
                                "cs": "Učinil <w>několik</w> pokusů opravit rozbitý stroj, než nakonec zavolal odborníka."
                            }
                        }
                    ],
                    "synonyms": [
                        "several",
                        "various"
                    ],
                    "common_phrases": [
                        "sundry sources"
                    ],
                    "target_lang_definitions": {
                        "cs": "Více než jeden nebo dva, ale ne příliš mnoho; několik."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "několik",
                                "target_lang_sense_clarification": "označuje neurčitý, ale menší počet"
                            },
                            {
                                "target_lang_word": "rozličný",
                                "target_lang_sense_clarification": "zdůrazňuje různorodost v rámci počtu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbb7d80f-218f-3bbf-b6c4-6c620e2297e4",
                    "sense_definition": "Consisting of an assortment of different kinds; miscellaneous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "variety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The box contained <w>sundry</w> items collected during their travels around the world.",
                            "target_lang_translations": {
                                "cs": "Krabice obsahovala <w>různorodé</w> předměty nasbírané během jejich cest po světě."
                            }
                        },
                        {
                            "text": "She kept a drawer filled with <w>sundry</w> objects that did not belong anywhere else.",
                            "target_lang_translations": {
                                "cs": "Měla zásuvku plnou <w>různých</w> předmětů, které nikam jinam nepatřily."
                            }
                        }
                    ],
                    "synonyms": [
                        "miscellaneous",
                        "assorted"
                    ],
                    "common_phrases": [
                        "sundry items"
                    ],
                    "target_lang_definitions": {
                        "cs": "Skládající se z různých druhů; různorodý, smíšený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "různorodý",
                                "target_lang_sense_clarification": "obsahující různé typy věcí"
                            },
                            {
                                "target_lang_word": "smíšený",
                                "target_lang_sense_clarification": "obsahující různé položky dohromady"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4549e895-e8d4-32a8-80ae-1cd2ee834a4d",
                    "sense_definition": "A minor miscellaneous item.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop sells stationery, magazines, and other small <w>sundries</w>.",
                            "target_lang_translations": {
                                "cs": "Obchod prodává papírnictví, časopisy a další drobné <w>zboží</w>."
                            }
                        },
                        {
                            "text": "He packed his clothes and a few <w>sundries</w> into his small travel bag.",
                            "target_lang_translations": {
                                "cs": "Sbalil si oblečení a pár <w>drobností</w> do své malé cestovní tašky."
                            }
                        }
                    ],
                    "synonyms": [
                        "miscellany"
                    ],
                    "common_phrases": [
                        "travel sundries"
                    ],
                    "target_lang_definitions": {
                        "cs": "Drobné, různorodé předměty."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drobnosti",
                                "target_lang_sense_clarification": "malé, nesouvisející předměty"
                            },
                            {
                                "target_lang_word": "různé drobné zboží",
                                "target_lang_sense_clarification": "v obchodním kontextu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5570d9d9-a880-3134-8a61-6e19d5ffe348",
                    "sense_definition": "A run scored in cricket without the ball having hit the striker's bat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team won the match largely because the opponent gave away too many <w>sundries</w>.",
                            "target_lang_translations": {
                                "cs": "Tým vyhrál zápas z velké části proto, že soupeř daroval příliš mnoho <w>extra bodů</w>."
                            }
                        },
                        {
                            "text": "The scoreboard showed that <w>sundries</w> contributed significantly to the final total.",
                            "target_lang_translations": {
                                "cs": "Tabule ukazovala, že <w>extra body</w> významně přispěly ke konečnému součtu."
                            }
                        }
                    ],
                    "synonyms": [
                        "extra"
                    ],
                    "common_phrases": [
                        "concede sundries"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in cricket-playing nations."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Body získané v kriketu bez přímého zásahu pálkou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "extra body",
                                "target_lang_sense_clarification": "v kriketové terminologii"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "f8a695e0-01c6-3a81-82af-9b8ec6ce1fbf",
                    "sense_definition": "Various people or things; several.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sundry</w> of the guests arrived early to help prepare the dinner.",
                            "target_lang_translations": {
                                "cs": "<w>Někteří</w> z hostů dorazili dříve, aby pomohli s přípravou večeře."
                            }
                        },
                        {
                            "text": "It was noted by <w>sundry</w> that the weather had changed quite suddenly.",
                            "target_lang_translations": {
                                "cs": "<w>Někteří</w> si všimli, že se počasí změnilo docela náhle."
                            }
                        }
                    ],
                    "synonyms": [
                        "several"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Formal or literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Různí lidé nebo věci; několik (zastaralé nebo formální)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "někteří",
                                "target_lang_sense_clarification": "odkazuje na neurčitou skupinu osob"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}