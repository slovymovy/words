                ],
                "senses": [
                    {
                        "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                        "entry_id": "53b15246-b954-3d43-9d37-77a240ed6ba9",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7cc5f7b-2f16-4856-84a7-bbb600b16f84",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Frau Salewski ist nett."
                            },
                            {
                                "example_id": "d946e444-3e47-4199-a81b-cebd9c77ce96",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Wir sind heute Abend bei Salewskis eingeladen."
                            },
                            {
                                "example_id": "f8ec8620-720c-46a6-a039-fe48613923f7",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Die Salewskis von nebenan sind im Urlaub."
                            },
                            {
                                "example_id": "f805a1e6-7757-4931-9fc7-80affbac38be",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Frau Salewski ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a38bf66d-dc6b-45ec-a832-04ef9952bdc6",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Herr Salewski wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7c2b1c80-9e2a-4900-a579-b792e6ed7434",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Die Salewskis fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "1918a6ca-d16e-43cf-8533-fb6491e6e742",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Der Salewski trägt nie die Pullover, die die Salewski ihm strickt."
                            },
                            {
                                "example_id": "01dda7a3-bca9-42a4-96bf-d45cbaab382d",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Salewski kommt, geht der Herr Salewski.“"
                            },
                            {
                                "example_id": "78fbe49c-db00-4145-84c2-9758858852b0",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Salewski kommt und geht."
                            },
                            {
                                "example_id": "4b03c57d-e4a0-4bb5-9573-cb7620592b7d",
                                "sense_id": "198ea23e-67c2-35fa-8185-1a84348bc97c",
                                "text": "Salewskis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
