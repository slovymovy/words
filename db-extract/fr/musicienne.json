                                    {
                                        "sense_id": "6e0569e7-f9ea-353a-abc7-354b1686d61b",
                                        "entry_id": "3b4db009-b7ae-34d9-a377-4fe64ea33639",
                                        "glosses": [
                                            "weibliche Person, die beruflich musiziert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cfe30a3-fa32-4e39-bcc8-79d8b25da49b",
                                                "sense_id": "6e0569e7-f9ea-353a-abc7-354b1686d61b",
                                                "text": "Petra spielt zwar Klavier, aber sie ist keine Musikerin."
                                            }
