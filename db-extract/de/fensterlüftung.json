                ],
                "senses": [
                    {
                        "sense_id": "86d9c986-429b-3f9b-aa49-9c9fa5357bd0",
                        "entry_id": "9fc96cbe-6492-3cd0-af59-f9343e4f49eb",
                        "glosses": [
                            "das Fensterlüften; Austausch der Raumluft durch Frischluft von Außen beim Öffnen von Fenstern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c7b610e-f28e-485a-a146-8204abefa9ff",
                                "sense_id": "86d9c986-429b-3f9b-aa49-9c9fa5357bd0",
                                "text": "„Der Luftwechsel, der beim Öffnen eines Fenster entsteht, heißt Fensterlüftung.“"
                            },
                            {
                                "example_id": "f9879edf-ab6d-4571-862d-2088c5bd4d35",
                                "sense_id": "86d9c986-429b-3f9b-aa49-9c9fa5357bd0",
                                "text": "„Nennlüftung: Beschreibt die notwendige Lüftung zur Gewährleistung der hygienischen und gesundheitlichen Erfordernisse sowie des Bautenschutzes bei Normalnutzung der Wohnung. Der Nutzer kann hierzu teilweise mit aktiver Fensterlüftung herangezogen werden.“"
                            },
                            {
                                "example_id": "343980e5-696c-4bcc-85ce-f044dc52eba3",
                                "sense_id": "86d9c986-429b-3f9b-aa49-9c9fa5357bd0",
                                "text": "„Während Fensterlüftung am Morgen noch zu akzeptablen Ergebnissen bezüglich der Feuchtigkeitsabfuhr führt, verdoppelt sich die Öffnungsdauer bei abendlicher Lüftung, will man den gleichen Effekt zu erzielen.“"
                            },
                            {
                                "example_id": "b8a5aa9a-4980-450c-bae1-f4491e476e6e",
                                "sense_id": "86d9c986-429b-3f9b-aa49-9c9fa5357bd0",
                                "text": "„Lüftung ist die Erneuerung der Raumluft durch direkte oder indirekte Zuführung von Außenluft. Freie Lüftung: Lüftung mit Förderung der Luft durch Druckunterschiede infolge Wind und/oder Temperaturdifferenzen zwischen außen und innen; z. B. Fensterlüftung, Schachtlüftung, Dachaufsatzlüftung und Lüftung durch sonstige Lüftungsöffnungen.“"
                            },
                            {
                                "example_id": "b3dada80-a2d2-4a6d-938e-305e977c030f",
                                "sense_id": "86d9c986-429b-3f9b-aa49-9c9fa5357bd0",
                                "text": "„Wie lange es dauert, bis die verbrauchte Raumluft vollständig gegen frische Außenluft ausgetauscht ist, hängt bei der Fensterlüftung sowohl von der Art der Lüftung (Querlüftung, Stosslüftung, Kipplüftung) als auch von den Wind- und Temperaturverhältnissen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
