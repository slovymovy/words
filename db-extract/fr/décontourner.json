                "senses": [
                    {
                        "sense_id": "f5c26192-4530-3021-822e-97c44a64f3f7",
                        "entry_id": "4c83f636-0d2a-3fa6-a8ed-351597d34e8f",
                        "glosses": [
                            "Variante de contourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1501eca6-6a77-4999-ab7f-a92cbe1e469b",
                                "sense_id": "f5c26192-4530-3021-822e-97c44a64f3f7",
                                "text": "Faut surtout pas approcher, mais décontourner."
                            },
                            {
                                "example_id": "4aa8786a-706f-4d5d-8230-53e733fd7fff",
                                "sense_id": "f5c26192-4530-3021-822e-97c44a64f3f7",
                                "text": "Je retire bien les aiguilles sans décontourner préalablement le fil avec lequel ont été faits, tant dans le sens horizontal que dans le sens vertical, les huit de chiffre dont les anneaux en embrassent les bouts ; mais aussitôt qu’elles sont retirées, j’enlève toute la masse du fil."
                            },
                            {
                                "example_id": "78952d56-6a34-4c74-994c-57dd5e9c9262",
                                "sense_id": "f5c26192-4530-3021-822e-97c44a64f3f7",
                                "text": "Autant que possible on évite de décontourner le coulisseau de cuivre, afin qu’il puisse bien reprendre sa place dans le creux, où il reste fixé une fois le moule établi."
                            }
                        ]
                    }
