{
    "word_family": [
        "avance",
        "avancement",
        "avancée"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "076d870e-f199-3158-ac5d-659282c5c788",
                    "sense_definition": "Se déplacer vers l'avant, aller plus loin dans une direction.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture <w>avance</w> lentement dans la rue encombrée par la circulation."
                        },
                        {
                            "text": "Le piéton <w>avance</w> pas à pas sur le trottoir verglacé."
                        }
                    ],
                    "antonyms": [
                        "reculer"
                    ],
                    "common_phrases": [
                        "avancer pas à pas",
                        "avancer tout droit"
                    ]
                },
                {
                    "sense_id": "7767e4da-3151-31e9-9097-b4ac7aa754e4",
                    "sense_definition": "Faire des progrès ou évoluer positivement dans une activité ou un travail.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>avançons</w> bien dans notre projet depuis le début de la semaine."
                        },
                        {
                            "text": "Les travaux de rénovation <w>avancent</w> à grands pas malgré la pluie."
                        }
                    ],
                    "common_phrases": [
                        "avancer à grands pas",
                        "avancer dans son travail"
                    ]
                },
                {
                    "sense_id": "b2be10bd-cbfd-3be3-9f7d-02965aed6cf5",
                    "sense_definition": "Fixer un événement ou une action à une date ou à une heure plus précoce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé d'<w>avancer</w> la réunion d'une demi-heure."
                        },
                        {
                            "text": "Ils ont dû <w>avancer</w> leur départ en vacances à cause d'un imprévu."
                        }
                    ],
                    "antonyms": [
                        "retarder"
                    ],
                    "common_phrases": [
                        "avancer une date",
                        "avancer un rendez-vous"
                    ]
                },
                {
                    "sense_id": "e9963abd-fced-33a4-b184-3f8bf5296302",
                    "sense_definition": "Fournir ou prêter une somme d'argent à quelqu'un en attendant d'être remboursé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je peux t'<w>avancer</w> les frais du repas si tu n'as pas de monnaie."
                        },
                        {
                            "text": "Il m'a gentiment <w>avancé</w> de l'argent pour payer mon billet de train."
                        }
                    ],
                    "synonyms": [
                        "dépanner"
                    ],
                    "common_phrases": [
                        "avancer de l'argent",
                        "avancer les frais"
                    ]
                },
                {
                    "sense_id": "68f0fc4d-cee0-3935-b637-f616e921a3d3",
                    "sense_definition": "Indiquer une heure en avance par rapport à l'heure réelle en parlant d'une montre ou d'une horloge.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma montre mécanique <w>avance</w> de cinq minutes chaque jour."
                        },
                        {
                            "text": "Ne te fie pas à cette horloge car elle <w>avance</w> toujours."
                        }
                    ],
                    "antonyms": [
                        "retarder"
                    ],
                    "common_phrases": [
                        "avancer de quelques minutes"
                    ]
                },
                {
                    "sense_id": "eaaea8ab-d7d4-3c26-be22-b6cc2c43f834",
                    "sense_definition": "Émettre une idée, une affirmation ou un argument en le présentant comme vrai.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste <w>avance</w> des chiffres précis pour soutenir son analyse."
                        },
                        {
                            "text": "Il ne faut jamais <w>avancer</w> une hypothèse sans apporter des preuves solides."
                        }
                    ],
                    "common_phrases": [
                        "avancer un argument",
                        "avancer une hypothèse"
                    ]
                }
            ]
        }
    ]
}