                        "examples": [
                            {
                                "example_id": "1619c745-4e1c-4432-8c0e-607449309d3e",
                                "sense_id": "46c941e8-0b97-3045-b43a-d0b5ba621755",
                                "text": "Incidental revenues from sales and repairs and practically all ground expense were recorded as applicable to a particular station and then prorated to individual routes on the basis of arrivals, departures, and basings of equipment."
                            },
                            {
                                "example_id": "162f3b9b-5161-47f3-ab9e-461167081012",
                                "sense_id": "46c941e8-0b97-3045-b43a-d0b5ba621755",
                                "text": "In deep underground basing, missiles are buried in tunnels in mountainsides where they are able to ride out a nuclear attack. Following the attack the missiles dig themselves out of the tunnels to the surface and launch themselves."
                            }
                        ]
                    }
