                ],
                "senses": [
                    {
                        "sense_id": "ecea4e1e-5555-3b30-914d-35e7cc2b1dbd",
                        "entry_id": "7f6209a8-bc31-376d-957b-6ad63778c11e",
                        "glosses": [
                            "befestigte, stadtähnliche Siedlung der Kelten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6056516a-fcec-455c-800a-baa1e0c4d9d7",
                                "sense_id": "ecea4e1e-5555-3b30-914d-35e7cc2b1dbd",
                                "text": "„Die Oppida erfüllten in Kriegszeiten eine Schutzfunktion, weil sie Befestigungen waren, in die sich die Bevölkerung der Umgebung im Angriffsfall zurückziehen konnte.“"
                            },
                            {
                                "example_id": "71fb93b1-a194-4490-9a8e-e92900eab325",
                                "sense_id": "ecea4e1e-5555-3b30-914d-35e7cc2b1dbd",
                                "text": "„Nach griechischem und römischem Vorbild gründeten die Kelten im 2. Jahrhundert vor Christus große, stadtähnliche Siedlungen mit Wehranlagen, die sogenannten Oppida.“"
                            },
                            {
                                "example_id": "cdb6dd55-6a44-4f68-b4df-a19bf03bc810",
                                "sense_id": "ecea4e1e-5555-3b30-914d-35e7cc2b1dbd",
                                "text": "„Die ältere Keltenzeit zeichnet sich durch Burgen und mächtige Grabhügel, die jüngere durch die sogenannten Oppida oder keltischen Städte aus.“"
                            },
                            {
                                "example_id": "79fc0126-5581-42f9-bc7b-d87e0bb84b1c",
                                "sense_id": "ecea4e1e-5555-3b30-914d-35e7cc2b1dbd",
                                "text": "„Warum die Oppida auch dort verlassen wurden, wo sie nicht, wie in Gallien, von den Römern erobert wurden, ist unklar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
