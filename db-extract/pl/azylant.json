                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5f8bd29e-1722-339d-90e4-1325bb29f7ea",
                        "entry_id": "82e9cb59-0061-3e52-861c-0f124ae3c2a0",
                        "glosses": [
                            "osoba ubiegająca się o azyl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a2a7ff7-b664-46b7-a965-914de0ec61e2",
                                "sense_id": "5f8bd29e-1722-339d-90e4-1325bb29f7ea",
                                "text": "Jeśli Polska odmawia przyjmowania azylantów z greckich obozów, musi zorganizować repatriację tych osób lub udzielić im zezwolenia na pobyt czasowy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91ccc744-0dc6-40b1-8b32-41c458b1087d",
                        "source_entry_id": "82e9cb59-0061-3e52-861c-0f124ae3c2a0",
                        "source_sense_id": "d361966d-2102-3c90-ad7d-3e47babd8fe8",
                        "target_lang_word": "asylee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asylee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f8cc435-7d7d-326b-a6ad-ef73936fcc10",
                                        "entry_id": "837679a5-3959-39b7-b165-3d8763dafefb",
                                        "glosses": [
                                            "A non-citizen of a country who has been granted asylum in that country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11551314-af70-483f-9dba-c3496ed763a1",
                                                "sense_id": "2f8cc435-7d7d-326b-a6ad-ef73936fcc10",
                                                "text": "At the same time, we must insure adequate legal authority to establish control over immigration: to enable us, when sudden influxes of foreigners occur, to decide to whom we grant the status of refugee or asylee; to improve our border control; […]"
                                            },
                                            {
                                                "example_id": "c32f82ac-51ef-422b-9e76-a0c10ebf5fe4",
                                                "sense_id": "2f8cc435-7d7d-326b-a6ad-ef73936fcc10",
                                                "text": "\"It is quite a novel technique to teach a lesson to any would-be asylees, and also to send a message to the foreign missions.\""
                                            },
                                            {
                                                "example_id": "92f1426e-0a1b-4586-98ea-4c046a61d893",
                                                "sense_id": "2f8cc435-7d7d-326b-a6ad-ef73936fcc10",
                                                "text": "EMM brings in LGBTQ refugees and asylees in a special federal refugee program started during the Obama administration called “Preferred Communities.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
