                        "examples": [
                            {
                                "example_id": "566924e4-90b0-4c16-8026-762b84744440",
                                "sense_id": "7e117f09-2f8b-34dc-a7f4-f9f648993508",
                                "text": "Het beste ziekenhuis van Nederland is het Albert Schweitzer ziekenhuis in Dordrecht. Het presteert op veel gebieden bovengemiddeld goed, zoals op ingrepen bij hart- en vaataandoeningen en kankeroperaties. In 2011 stond het ziekenhuis nog op plaats 54."
                            },
                            {
                                "example_id": "dcb4d2f7-6b7c-412d-a0da-3d4540071e3d",
                                "sense_id": "7e117f09-2f8b-34dc-a7f4-f9f648993508",
                                "text": "Mensen die korter dan 6 uur slapen hebben gemiddeld al 15 procent meer kans op hart- en vaataandoeningen dan mensen die minstens 7 tot 8 uur slapen."
                            }
                        ]
                    }
