                ],
                "senses": [
                    {
                        "sense_id": "6261ba97-29ff-3579-b6f5-fc0da7f51f62",
                        "entry_id": "e0280170-0a41-3142-bcb8-16e74def8815",
                        "glosses": [
                            "einer der beiden 1912 und 1913 stattgefundenen Kriege auf der Balkanhalbinsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbcbe59b-cf13-441e-bf0f-f2eb66bc3f53",
                                "sense_id": "6261ba97-29ff-3579-b6f5-fc0da7f51f62",
                                "text": "„Als der Balkankrieg 1912 die Osmanenherrschaft endgültig beendete, wurde das Kosovo tatsächlich dem Königreich Serbien angegliedert.“"
                            },
                            {
                                "example_id": "86b99566-591a-485f-95f1-b837603eda37",
                                "sense_id": "6261ba97-29ff-3579-b6f5-fc0da7f51f62",
                                "text": "„Nach der vollzogenen Vereinigung und der glücklichen Beendigung des aus Neid von den Serben erklärten Krieges konnte erst das freigebliebene bulgarische Volk ein ruhiges, Soziales und wirtschaftliches Leben beginnen, welches wieder im Jahre 1912 durch den Balkankrieg gestört wurde.“"
                            },
                            {
                                "example_id": "59811094-0bd5-4d3d-bbf8-65832609f379",
                                "sense_id": "6261ba97-29ff-3579-b6f5-fc0da7f51f62",
                                "text": "„Eine Art Schock habe zum Tod geführt in dem Moment, in dem der Vater vom Ausbruch des Balkankrieges gelesen haben soll; dieser Zeitungslektüre voraus ging am Abend zuvor eine Szene zwische Jacques und Mathilde Canetti.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6bf75a5a-ec13-3a2e-b00e-07895db7e2fc",
                        "entry_id": "e0280170-0a41-3142-bcb8-16e74def8815",
                        "glosses": [
                            "bewaffneter Konflikt um die Kontrolle des Kosovo 1998/99"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5093009e-ad12-43d1-9083-723a4651ac11",
                                "sense_id": "6bf75a5a-ec13-3a2e-b00e-07895db7e2fc",
                                "text": "„Es folgte ein weiterer blutiger Balkankrieg im Kosovo, der im Frühjahr 1999 zur Nato-Intervention gegen die jugoslawische Armee und serbische Polizei führte.“"
                            },
                            {
                                "example_id": "6c9f478d-c209-42fb-bae4-3f9025048099",
                                "sense_id": "6bf75a5a-ec13-3a2e-b00e-07895db7e2fc",
                                "text": "„Die wachsende Immigration nach Europa und die großen Flüchtlingswellen in Europa durch den Balkankrieg in den 1990er Jahren und den Bürgerkrieg in Syrien ab 2015 steigerten das Armutsrisiko ebenfalls.“"
                            },
                            {
                                "example_id": "33631e6f-b01d-4a47-8d16-505ebfc1dde8",
                                "sense_id": "6bf75a5a-ec13-3a2e-b00e-07895db7e2fc",
                                "text": "„Schlimm wiederum ist ihm der neue Balkankrieg – ihm ein Zeichen dafür, das Leben nur in Zeiten von Kriegen verbracht zu haben.“"
                            },
                            {
                                "example_id": "fcdc6ebf-e1a3-4809-9034-0bfa6da784bb",
                                "sense_id": "6bf75a5a-ec13-3a2e-b00e-07895db7e2fc",
                                "text": "„Im anschließenden Kommentar wird festgestellt, dass die Bombardierung der chinesischen Botschaft zu einem Zeitpunkt erfolgt sei, als Präsident Clinton mit Russland, europäischen Ländern und UN-Generalsekretär Kofi Annan intensiv an einer diplomatischen Lösung des Balkankriegs gearbeitet habe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
