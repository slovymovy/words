                "senses": [
                    {
                        "sense_id": "85e4ba0c-9931-3733-8b10-01a2d7f01b7f",
                        "entry_id": "e1a94ba5-a624-3049-b98d-6e7c3b13f032",
                        "glosses": [
                            "The processing of margarine by means of a votator."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "debe2c73-d866-4145-ba5f-e8085a8c58b2",
                                "sense_id": "85e4ba0c-9931-3733-8b10-01a2d7f01b7f",
                                "text": "Basically, the solid fat profile, votation processing, and subsequent tempering of the product give the desired characteristics to the fat."
                            },
                            {
                                "example_id": "2abfbc2f-1752-4643-815b-90d6cf26c18d",
                                "sense_id": "85e4ba0c-9931-3733-8b10-01a2d7f01b7f",
                                "text": "However, it must be emphasized that close control of the processing temperature of the emulsion during votation, by maintaining a narrow operating range, is as important as specifying a narrow range for either an SFI or an SFC curve when defining the slope of the solids in the incoming oil."
                            },
                            {
                                "example_id": "beadefae-c56c-445d-b7eb-7ea734d0b631",
                                "sense_id": "85e4ba0c-9931-3733-8b10-01a2d7f01b7f",
                                "text": "The required consistency of the spread is obtained by cooling in a scraped surface heat exchanger, a process called 'votation'."
                            }
                        ]
                    }
                ],
