                ],
                "senses": [
                    {
                        "sense_id": "9ace0746-9d27-359c-bb10-8b89f2727721",
                        "entry_id": "52184a98-2905-376d-96e6-d5c0fca75818",
                        "glosses": [
                            "Action de poloniser, de rendre polonais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6701ba50-a6c9-47e9-bcd8-6076a33d06c5",
                                "sense_id": "9ace0746-9d27-359c-bb10-8b89f2727721",
                                "text": "Les nationalités étrangères forment près du tiers de la population totale de la Pologne. La polonisation systématique et forcée ne s’arrêta pas à ces détails, et prescrivit aux parents, sous peine d’amende et d’arrestation, d’envoyer leurs enfants aux écoles primaires dont ils ne comprenaient pas la langue."
                            }
                        ]
                    },
                    {
                        "sense_id": "66e6dfc3-cdbc-3291-b34d-61ac5a3b8d50",
                        "entry_id": "52184a98-2905-376d-96e6-d5c0fca75818",
                        "glosses": [
                            "Fait de traiter une nation comme le fut la Pologne partagée à partir de 1772 et envahie en 1939."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "314e6d85-4ae4-40ee-bec4-637aefcb6191",
                                "sense_id": "66e6dfc3-cdbc-3291-b34d-61ac5a3b8d50",
                                "text": "Pour les sympathisants, Vichy fut un frein, un obstacle, un moyen de de différer ou d’atténuer les exigences sans bornes de l’ennemi et d’éviter l’occupation totale (comme si les Allemands le voulaient !). « Après nous, la polonisation. »"
                            },
                            {
                                "example_id": "94325b78-a60c-40a2-b69d-9b33b87cf986",
                                "sense_id": "66e6dfc3-cdbc-3291-b34d-61ac5a3b8d50",
                                "text": "Vichy n’a pas évité la « polonisation » de la France par les Allemands. Il a permis, en créant la Milice, une tentative (avortée) de « polonisation » toute nationale et opérée par des mains très françaises."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e192141d-7566-467a-9d89-b0db1fd8268e",
                        "source_entry_id": "52184a98-2905-376d-96e6-d5c0fca75818",
                        "target_lang_word": "Polonisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polonisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f43de7b-f760-3627-87cd-b53b62d22734",
                                        "entry_id": "23da7062-e3e7-3379-94b9-5bc231475e4c",
                                        "glosses": [
                                            "Durchsetzung der polnischen Kultur bei Personen, die anderssprachig sind und/oder einer anderen Kultur/Nation angehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e8015a-2770-466a-aca6-af5aff3670e0",
                                                "sense_id": "9f43de7b-f760-3627-87cd-b53b62d22734",
                                                "text": "„Noch vor der Polonisierung der Erwachsenen beginnt in Groß Döbern die Polonisierung der Kinder.“"
                                            },
                                            {
                                                "example_id": "8c7bd0da-ac6b-49b8-b095-4321a60fce1a",
                                                "sense_id": "9f43de7b-f760-3627-87cd-b53b62d22734",
                                                "text": "„Nur widerwillig ließen die Ostpreußen die Polonisierung ihrer Namen über sich ergehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
