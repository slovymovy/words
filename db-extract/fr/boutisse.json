                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d414dbc-f15f-499f-a089-6475a5c67997",
                                                "sense_id": "9d247b5e-ec35-39a0-aaa5-4646afc33926",
                                                "text": "The header includes an index, an identifier, and a pointer to the next entry."
