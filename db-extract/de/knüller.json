                ],
                "senses": [
                    {
                        "sense_id": "aa4318c6-d7ec-330c-996b-cb2f2077c0e4",
                        "entry_id": "0e9f00b6-f244-38cb-a64b-a134551a83e3",
                        "glosses": [
                            "an exciting article, news story, or piece of information; a sensation, bombshell"
                        ],
                        "tags": [
                            "informal",
                            "masculine",
                            "often",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d48d3ee2-e113-4316-bae4-e6121fdb7aeb",
                                "sense_id": "aa4318c6-d7ec-330c-996b-cb2f2077c0e4",
                                "text": "„Das wird ’n Knüller“, rief der Reporter begeistert.",
                                "translation": "“This’ll be a bombshell,” the reporter cried excitedly.",
                                "english": "“This’ll be a bombshell,” the reporter cried excitedly."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bf23ac8-22ec-3e9b-b604-ef4edee3a100",
                        "entry_id": "0e9f00b6-f244-38cb-a64b-a134551a83e3",
                        "glosses": [
                            "something that is funny, often in an unusual or bizarre way"
                        ],
                        "tags": [
                            "informal",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e1af2857-b6a7-4c4d-9b0f-84a9f66d5026",
                                "sense_id": "1bf23ac8-22ec-3e9b-b604-ef4edee3a100",
                                "text": "Der Typ ist echt ’n Knüller!",
                                "translation": "That bloke is a real oddball!",
                                "english": "That bloke is a real oddball!"
                            },
                            {
                                "example_id": "ce25bef5-ef16-4961-8523-38a5c96da429",
                                "sense_id": "1bf23ac8-22ec-3e9b-b604-ef4edee3a100",
                                "text": "Das war der Knüller, dass wir uns ausgerechnet in Rio getroffen haben.",
                                "translation": "That was the funniest thing that we ran into each other in Rio, out of all places.",
                                "english": "That was the funniest thing that we ran into each other in Rio, out of all places."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c30ab3a-2fc1-3d0c-bfd1-c56d70948be2",
                        "entry_id": "0e9f00b6-f244-38cb-a64b-a134551a83e3",
                        "glosses": [
                            "a blockbuster, hit, highlight, anything exciting"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f9a1088c-dd33-4fa5-a164-68c26737e5cc",
                                "sense_id": "2c30ab3a-2fc1-3d0c-bfd1-c56d70948be2",
                                "text": "Der Film war der Knüller!",
                                "translation": "The film was sensational!",
                                "english": "The film was sensational!"
                            }
                        ]
                    }
                ],
