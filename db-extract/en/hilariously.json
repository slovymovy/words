                                "target_senses": [
                                    {
                                        "sense_id": "3e7400f0-39fb-3bcb-8b8d-83131cf7445e",
                                        "entry_id": "d4ebd1a4-4a38-3f7e-bc94-720f3d2775cc",
                                        "glosses": [
                                            "in Stimmungen und bei Handlungen unbeschwert fröhlich"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2fb7e1c2-a179-3635-927e-528b31e34d43",
                                        "entry_id": "d4ebd1a4-4a38-3f7e-bc94-720f3d2775cc",
                                        "glosses": [
                                            "in Stimmungen und bei Handlungen unbeschwert fröhlich",
                                            "in überschwänglicher Stimmung befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d0b9e80-67f9-4a74-86c3-8fc1da1ea533",
                                                "sense_id": "2fb7e1c2-a179-3635-927e-528b31e34d43",
                                                "text": "Die Stimmung war ausgelassen wie beim Karneval. Die Teilnehmer zogen hinter Lautsprecherwagen her und tanzten in den Straßen."
                                            },
                                            {
                                                "example_id": "10e03a7d-79ff-474f-9d3a-bb9d95f5a341",
                                                "sense_id": "2fb7e1c2-a179-3635-927e-528b31e34d43",
                                                "text": "Ausgelassener Jubel herrschte hingegen bei den 69.000 Zuschauern in der Münchner Allianz-Arena, das 3:3 gegen Dortmund kümmerte keinen, das Resultat war sekundär, alles drehte sich um die Meisterschale. Ausgelassene Stimmung vor allem später am Marienplatz, wo die Bayern-Fans ihre Lieblinge hochleben ließen."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "fe0412db-df0c-3897-b265-efe5a0a648bf",
                                        "entry_id": "d4ebd1a4-4a38-3f7e-bc94-720f3d2775cc",
                                        "glosses": [
                                            "in Stimmungen und bei Handlungen unbeschwert fröhlich",
                                            "Übermut auslebend"
                                        ],
                                        "tags": [
                                            "von Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5951a13a-7e99-41b5-b310-902f96564c97",
                                                "sense_id": "fe0412db-df0c-3897-b265-efe5a0a648bf",
                                                "text": "Und auf einem römischen Brunnen werden überlebensgroße Götterfiguren lebendig. Ausgelassen hebt ein marmorner Dionysos sein Glas und ruft beglückt: Hail Caesar! Heil mir, wispert die Besucherin aus Germany, dass meine Augen solche Wunder schauen dürfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "65c937e5-c72c-3ab3-a105-d3d5690444a1",
                                        "entry_id": "d4ebd1a4-4a38-3f7e-bc94-720f3d2775cc",
                                        "glosses": [
                                            "in Stimmungen und bei Handlungen unbeschwert fröhlich",
                                            "ungestümes Treiben vollführend"
                                        ],
                                        "tags": [
                                            "von Kindern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6fb8bf3-6905-4868-aa81-ef07577b3c8c",
                                                "sense_id": "65c937e5-c72c-3ab3-a105-d3d5690444a1",
                                                "text": "Zwischen den Marktständen Schausteller, Musikanten und seltsame Tiere. Häuser so hoch, dass die Gassen ganz im Schatten liegen, Bänke, auf denen man sitzen und ausruhen kann. Und fröhliche, ausgelassene Kinder, die vornehme Kleider tragen, wie er sie zu Hause nur von Sonntags-Erwachsenen kennt."
                                            },
                                            {
                                                "example_id": "809e8818-94c9-454f-89fa-c5e87edd7684",
                                                "sense_id": "65c937e5-c72c-3ab3-a105-d3d5690444a1",
                                                "text": "Wenn mit dem Alter die Neugier erlahmt, und die Kinder nicht mehr ausgelassen spielen, wolle sie keiner mehr haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "0e2ec0fb-5da5-3160-b70f-608e8d39f209",
                                        "entry_id": "d4ebd1a4-4a38-3f7e-bc94-720f3d2775cc",
                                        "glosses": [
                                            "in Stimmungen und bei Handlungen unbeschwert fröhlich",
                                            "Freude und Fröhlichkeit zelebrierend"
                                        ],
                                        "tags": [
                                            "von Feiern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c78ca20-6738-45bb-b0da-163549515e2c",
                                                "sense_id": "0e2ec0fb-5da5-3160-b70f-608e8d39f209",
                                                "text": "Die ausgelassenen Feiern über den Aufstieg der Schweiz sind in Zürich von Ausschreitungen überschattet worden."
                                            },
                                            {
                                                "example_id": "d69ad9cf-d4c2-435e-994c-e25dd3bb83a7",
                                                "sense_id": "0e2ec0fb-5da5-3160-b70f-608e8d39f209",
                                                "text": "Spanien feierte den neuen \"Volkshelden\", den ersten spanischen Weltmeister überhaupt und den ersten spanisch-sprachigen seit dem Argentinier Juan-Manuel Fangio im Jahre 1957, schon im Vorfeld der Entscheidung ausgelassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1d\""
                                    }
                                ]
                            },
