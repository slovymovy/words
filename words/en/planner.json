{
    "word_family": [
        "plan",
        "planning",
        "unplanned",
        "preplan"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb932ced-a08d-323c-92bc-869f48a390b4",
                    "sense_definition": "A notebook or software application used to organize and keep track of appointments, tasks, and projects.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organization_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to check my <w>planner</w> to see if I am free for lunch on Tuesday.",
                            "target_lang_translations": {
                                "ru": "Мне нужно заглянуть в свой <w>ежедневник</w>, чтобы узнать, свободен ли я для обеда во вторник."
                            }
                        },
                        {
                            "text": "She bought a new digital <w>planner</w> to help manage her busy work schedule.",
                            "target_lang_translations": {
                                "ru": "Она купила новый цифровой <w>планировщик</w>, чтобы было удобнее управлять плотным рабочим графиком."
                            }
                        }
                    ],
                    "synonyms": [
                        "filled pause"
                    ],
                    "common_phrases": [
                        "daily planner",
                        "digital planner",
                        "wedding planner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блокнот или программное приложение, используемое для организации и отслеживания встреч, задач и проектов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "планировщик",
                                "target_lang_sense_clarification": "программа или приложение"
                            },
                            {
                                "target_lang_word": "ежедневник",
                                "target_lang_sense_clarification": "бумажный блокнот"
                            },
                            {
                                "target_lang_word": "органайзер",
                                "target_lang_sense_clarification": "универсальный инструмент для записей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b647622-0c12-3cf8-ae25-f569b3d2d507",
                    "sense_definition": "A person who makes plans, especially as a profession or a specific personality trait.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "people_roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a professional city <w>planner</w>, he designs layouts for new parks and residential areas.",
                            "target_lang_translations": {
                                "ru": "Как профессиональный градостроительный <w>планировщик</w>, он разрабатывает макеты новых парков и жилых районов."
                            }
                        },
                        {
                            "text": "Johnny is a good <w>planner</w> who always starts his work early to meet every deadline.",
                            "target_lang_translations": {
                                "ru": "Джонни — хороший <w>организатор</w>, который всегда начинает работу заранее, чтобы уложиться в любой срок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "city planner",
                        "event planner",
                        "financial planner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который составляет планы, особенно в качестве профессии или как черта характера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "планировщик",
                                "target_lang_sense_clarification": "специалист по планированию"
                            },
                            {
                                "target_lang_word": "организатор",
                                "target_lang_sense_clarification": "человек, занимающийся подготовкой мероприятий"
                            },
                            {
                                "target_lang_word": "проектировщик",
                                "target_lang_sense_clarification": "в контексте градостроительства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "790b4039-3105-3066-95e7-37f83b12c14f",
                    "sense_definition": "A sound or word such as 'um' or 'ah' uttered by a speaker during a pause in speech.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist analyzed the frequency of each <w>planner</w> used during the spontaneous interview.",
                            "target_lang_translations": {
                                "ru": "Лингвист проанализировал частоту каждого <w>заполнителя паузы</w>, использованного во время спонтанного интервью."
                            }
                        },
                        {
                            "text": "Using a <w>planner</w> like 'um' too often can make a speaker sound less confident.",
                            "target_lang_translations": {
                                "ru": "Слишком частое использование таких <w>заполнителей</w>, как «эм», может заставить говорящего звучать менее уверенно."
                            }
                        }
                    ],
                    "synonyms": [
                        "filled pause"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical linguistic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук или слово, такое как «эм» или «а», произносимое говорящим во время паузы в речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заполнитель паузы",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "слово-паразит",
                                "target_lang_sense_clarification": "в разговорном контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}