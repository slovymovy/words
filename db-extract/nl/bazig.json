                    {
                        "sense_id": "17133511-fab9-346d-9c83-23dc7110e940",
                        "entry_id": "efab86fd-e309-3d34-b347-1504068da7fb",
                        "glosses": [
                            "bossy, domineering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca7a4b9-d708-4e56-aca3-0747e3696c98",
                                "sense_id": "17133511-fab9-346d-9c83-23dc7110e940",
                                "text": "De bazige kampleider verknoeide alles door de jongens voortdurend te commanderen.",
                                "translation": "The bossy camp counselor spoiled everything by constantly ordering the boys around.",
                                "english": "The bossy camp counselor spoiled everything by constantly ordering the boys around."
                            }
                        ]
                    }
