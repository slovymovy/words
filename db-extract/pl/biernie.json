                    {
                        "translation_id": "686927a6-b726-4c53-b912-ee79204b209b",
                        "source_entry_id": "cc402165-9958-34f6-b370-e5554c77bfc1",
                        "source_sense_id": "28db314c-1b2e-3582-b407-c29cdd1d5089",
                        "source_sense_description": "keine Initiative zeigend: passiv, untätig, träge",
                        "target_lang_word": "untätig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untätig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee31267f-5fc5-3265-99e1-5202a71de87e",
                                        "entry_id": "015c5eb6-d4e9-3ced-98f7-f8392bc161da",
                                        "glosses": [
                                            "nichts tuend, keine Aktivität zeigend"
                                        ],
                                        "tags": [
                                            "häufig mit abwertendem Unterton"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7885368a-0cc6-4d23-a810-5197d70d2541",
                                                "sense_id": "ee31267f-5fc5-3265-99e1-5202a71de87e",
                                                "text": "Du kannst doch nicht untätig daneben stehen und nichts unternehmen!"
                                            },
                                            {
                                                "example_id": "4840140e-838f-4b00-aa04-0e9f42ea57bb",
                                                "sense_id": "ee31267f-5fc5-3265-99e1-5202a71de87e",
                                                "text": "Neben aktiven gibt es auf der Insel auch untätige Vulkane."
                                            },
                                            {
                                                "example_id": "5f1e32ca-e057-4f97-aad6-3f08b372dd61",
                                                "sense_id": "ee31267f-5fc5-3265-99e1-5202a71de87e",
                                                "text": "Er war nichts weiter als ein stummer, untätiger Zeuge, der zur Passivität verdammt war."
                                            },
                                            {
                                                "example_id": "9df39c42-f443-443f-b87a-f7fbcc65b8b8",
                                                "sense_id": "ee31267f-5fc5-3265-99e1-5202a71de87e",
                                                "text": "„Und da stand schnell fest: Schuld war neben den „Horror-Eltern“ das untätige und unfähige Jugendamt.“"
                                            },
                                            {
                                                "example_id": "29c8422d-f518-404d-afeb-21924d69623e",
                                                "sense_id": "ee31267f-5fc5-3265-99e1-5202a71de87e",
                                                "text": "„Es gab, im letzten Herbst, überall Flüchtlinge, Ausgebombte und Evakuierte auf dem flachen Lande, die mit Arbeit nicht voll ausgelastet waren; vielfach waren sie untätig, arbeitslos.“"
                                            },
                                            {
                                                "example_id": "38af7412-c891-4c9b-91b3-a242a3364663",
                                                "sense_id": "ee31267f-5fc5-3265-99e1-5202a71de87e",
                                                "text": "[Dürre in Südfrankreich 2023:] „Ende März besannen sich verzweifelte Katholiken im südfranzösischen Perpignan auf ein seit der Revolution vergessenes Ritual: eine Bittprozession um Wasser mit der Statue des Heiligen Galderic. Doch der blieb untätig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
