                ],
                "senses": [
                    {
                        "sense_id": "b93f4f0f-24d6-3ad6-af74-a8e8d5324e81",
                        "entry_id": "d99f5141-ae04-3912-bd29-187b7d5dfbff",
                        "glosses": [
                            "Se dit d’un organisme anaérobie procaryote qui n’utilise pas le dioxygène pour son métabolisme mais dont la présence n’est pas dangereuse pour lui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba2f70a9-14d4-48a6-844c-75cffb59ba25",
                                "sense_id": "b93f4f0f-24d6-3ad6-af74-a8e8d5324e81",
                                "text": "Les bactéries du genre Streptococcus sont, pour la plupart, des espèces aérotolérantes."
                            },
                            {
                                "example_id": "96c58613-f50a-4747-a4f1-cb5cccd54067",
                                "sense_id": "b93f4f0f-24d6-3ad6-af74-a8e8d5324e81",
                                "text": "L’isolement dans notre laboratoire d’une souche de C. terlium aérotolérante sur gélose au sang nous permet d’observer facilement ce phénomène…"
                            },
                            {
                                "example_id": "be44d6f2-f336-46f2-9266-7ed99e58667a",
                                "sense_id": "b93f4f0f-24d6-3ad6-af74-a8e8d5324e81",
                                "text": "Les bactéries aérobies strictes sont capables de se développer en présence d’air, elles sont à la fois aérotolérantes et oxydatrices."
                            }
                        ]
                    }
                ],
