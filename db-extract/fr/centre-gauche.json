                    },
                    {
                        "translation_id": "8714d25f-07a1-411a-8c0b-20860b016bfd",
                        "source_entry_id": "22aea36e-01fb-3709-8930-dff0c6be5010",
                        "source_sense_id": "e3421f43-2dc5-3386-8c09-a10f8acc394d",
                        "target_lang_word": "centre-left",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centre-left",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74a5a9dc-f90c-39bf-a505-31a26d7b5c6a",
                                        "entry_id": "b9617f0e-bd32-38b6-a4bd-ba9d073f0e85",
                                        "glosses": [
                                            "Leaning to the left but closer to the centre on the left–right political spectrum than other leftist variants."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e83118-e18e-4645-8eeb-3a3bcad3e9cd",
                                                "sense_id": "74a5a9dc-f90c-39bf-a505-31a26d7b5c6a",
                                                "text": "South Korea holds parliamentary elections on 11 April. Lee's conservative party is expected to lose ground to the centre-left opposition, but a small hint of peace from the North will do him no harm at all. Lee can hardly have expected such a gift."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e59b31a-c0c1-4fba-b809-291770f3e7d3",
                        "source_entry_id": "22aea36e-01fb-3709-8930-dff0c6be5010",
                        "source_sense_id": "e3421f43-2dc5-3386-8c09-a10f8acc394d",
                        "target_lang_word": "liberal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f4690f6-6a17-396e-acc0-c65ce1a54a25",
                                        "entry_id": "56787245-0c22-3cab-885a-211dff11646c",
                                        "glosses": [
                                            "Pertaining to those arts and sciences the study of which is considered to provide general knowledge, as opposed to vocational/occupational, technical or mechanical training."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf89c87-30ff-4468-875d-780a2fc9d84e",
                                                "sense_id": "4f4690f6-6a17-396e-acc0-c65ce1a54a25",
                                                "text": "He had a full education studying the liberal arts."
                                            },
                                            {
                                                "example_id": "c9704723-85a1-41fe-aa09-c2c225dd864d",
                                                "sense_id": "4f4690f6-6a17-396e-acc0-c65ce1a54a25",
                                                "text": "Americans remain enamored with Europe's ability to produce the consequential thought for America. It was the same in nearly every liberal field. Education sought its roots in such Europeans as Froebel, Frobenius, and Rousseau. Political science tried to connect to Thomas Hobbes, John Locke, Nietzsche, Machiavelli, and Otto von Bismarck, for instance. Economics copied the thought of Adam Smith, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139b8998-c23d-39d4-9b4b-5344cee4dde8",
                                        "entry_id": "56787245-0c22-3cab-885a-211dff11646c",
                                        "glosses": [
                                            "Generous; permitting liberty; willing to give unsparingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b5036b0-879a-45c5-ab45-9ac0fd284907",
                                                "sense_id": "139b8998-c23d-39d4-9b4b-5344cee4dde8",
                                                "text": "He was liberal with his compliments."
                                            },
                                            {
                                                "example_id": "50f9906f-1f98-4bd2-8a95-fac1001a8615",
                                                "sense_id": "139b8998-c23d-39d4-9b4b-5344cee4dde8",
                                                "text": "Indeed, the Government has been very liberal in the expenditure of public money"
                                            },
                                            {
                                                "example_id": "f600d87b-bef8-4a8f-8353-7dd6a88f3c1d",
                                                "sense_id": "139b8998-c23d-39d4-9b4b-5344cee4dde8",
                                                "text": "When he shows improvement she is liberal with her praise and then moves on to the next set of skills to be learnt."
                                            },
                                            {
                                                "example_id": "36fc6cdf-0494-4a29-a9e0-6dd1de831c70",
                                                "sense_id": "139b8998-c23d-39d4-9b4b-5344cee4dde8",
                                                "text": "Queen Isabella was already being called Santa Isabella by many of her subjects because she was liberal with her alms."
                                            },
                                            {
                                                "example_id": "c61db8d8-0fc6-4440-a3bf-1a851cc92271",
                                                "sense_id": "139b8998-c23d-39d4-9b4b-5344cee4dde8",
                                                "text": "Was it because the believers were so liberal with their possessions that God was so liberal with his grace?"
                                            },
                                            {
                                                "example_id": "6e40935f-d020-43a5-bd5e-8dba58840f18",
                                                "sense_id": "139b8998-c23d-39d4-9b4b-5344cee4dde8",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c24d11e-ed34-3c05-87c1-7fd18f6142cd",
                                        "entry_id": "56787245-0c22-3cab-885a-211dff11646c",
                                        "glosses": [
                                            "Ample, abundant; generous in quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad7985e-a030-4bf9-b09f-7f76f2fcc597",
                                                "sense_id": "6c24d11e-ed34-3c05-87c1-7fd18f6142cd",
                                                "text": "Add a liberal sprinkling of salt."
                                            },
                                            {
                                                "example_id": "39435b86-a934-4f04-b0bc-2e71c3c34c60",
                                                "sense_id": "6c24d11e-ed34-3c05-87c1-7fd18f6142cd",
                                                "text": "For this reason a liberal amount of piping should be used. If a liberal supply of piping is provided at first, the first cost will of course be greater, but the extra expenditure is called for but once."
                                            },
                                            {
                                                "example_id": "f22e92bf-81b4-43d6-b239-4960d20e37c3",
                                                "sense_id": "6c24d11e-ed34-3c05-87c1-7fd18f6142cd",
                                                "text": "The result was usually that such helpers got a liberal sprinkling of mud over their clothing."
                                            },
                                            {
                                                "example_id": "506987c1-164c-498f-96ea-1b919505f73a",
                                                "sense_id": "6c24d11e-ed34-3c05-87c1-7fd18f6142cd",
                                                "text": "Rose put a steaming cup of mint tea in front of me and spooned a liberal helping of honey into it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ffc161-8568-3ca6-9b05-8bd0af058120",
                                        "entry_id": "56787245-0c22-3cab-885a-211dff11646c",
                                        "glosses": [
                                            "Unrestrained, licentious."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36750b26-1bef-45cd-8564-08c0f7a06b9d",
                                                "sense_id": "00ffc161-8568-3ca6-9b05-8bd0af058120",
                                                "text": "Myself, my brother, and this grieved count,\nDid see her, hear her, at that hour last night,\nTalk with a ruffian at her chamber-window;\nWho hath indeed, most like a liberal villain,\nConfess'd the vile encounters they have had\nA thousand times in secret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daf1918e-b485-30e2-8de6-ec52fcb896b7",
                                        "entry_id": "56787245-0c22-3cab-885a-211dff11646c",
                                        "glosses": [
                                            "Widely open to new ideas, willing to depart from established opinions or conventions; permissive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d5ae1d-b831-41b9-bec3-8c6b0ab6bd8a",
                                                "sense_id": "daf1918e-b485-30e2-8de6-ec52fcb896b7",
                                                "text": "Her parents had liberal ideas about child-rearing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70232a0a-7db4-37a0-90f4-08112681dc61",
                                        "entry_id": "56787245-0c22-3cab-885a-211dff11646c",
                                        "glosses": [
                                            "Open to political or social changes and reforms associated with either classical or modern liberalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e69469b-77b3-4c3a-b92c-6e5b57b18014",
                                                "sense_id": "70232a0a-7db4-37a0-90f4-08112681dc61",
                                                "text": "Endorsing the liberal anti-interventionist credo that the marketplace should act as the \"site of verification,\" the advocates of white lead opposed government intervention for the sake of open economic competition, which they claimed revealed its true value and thus should be the sole determinant: \"When the railways were built, the stage coaches disppeared; they died a timely death. If zinc white is truly superior to white lead, it will kill us in the marketplace, but the government should not intervene.\" These were the words of Expert-Bezançon, in his February 1903 deposition to the parliamentary committee examining the bill for banning lead-based pigments in paint."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liberal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d59c08bb-53f8-3fad-806a-a20bfce01816",
                                        "entry_id": "d1b76b4f-d739-3261-b542-bf41fd7fc18d",
                                        "glosses": [
                                            "One with liberal views, supporting individual liberty (see Wikipedia's article on Liberalism)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e39aaaf6-6a2a-3cb0-b92c-2342524dc851",
                                        "entry_id": "d1b76b4f-d739-3261-b542-bf41fd7fc18d",
                                        "glosses": [
                                            "Someone with progressive or left-wing views, especially on social and environmental issues."
                                        ],
                                        "tags": [
                                            "Canadian",
                                            "Philippine",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd1c78bd-0651-4117-89fa-dda3228eb8f6",
                                                "sense_id": "e39aaaf6-6a2a-3cb0-b92c-2342524dc851",
                                                "text": "And I love Puerto Ricans and Negros\nAs long as they don't move next door.\nSo love me, love me, love me, I'm a liberal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45106c14-3081-380a-8527-c5e031a52a64",
                                        "entry_id": "d1b76b4f-d739-3261-b542-bf41fd7fc18d",
                                        "glosses": [
                                            "A supporter of any of several liberal parties."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16a3a6da-2b2c-3c28-9c56-19b27d1ea101",
                                        "entry_id": "d1b76b4f-d739-3261-b542-bf41fd7fc18d",
                                        "glosses": [
                                            "One who favors individual voting rights, human and civil rights, and laissez-faire markets (also called \\\"classical liberal\\\"; compare libertarian)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7887092-260f-370f-99d7-28a1005b23ce",
                                        "entry_id": "d1b76b4f-d739-3261-b542-bf41fd7fc18d",
                                        "glosses": [
                                            "A conservative, especially a liberal conservative."
                                        ],
                                        "tags": [
                                            "Australian"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
