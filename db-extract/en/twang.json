    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                "word": "twang",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5a5bdfa1-9159-45ef-9bc1-64b41aeb06fc",
                        "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                        "tags": [
                            "plural"
                        ],
                        "form": "twangs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "480ef2d8-7e15-3a93-8953-a9985736bad8",
                        "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                        "glosses": [
                            "The sharp, quick sound of a vibrating tight string, for example, of a bow or a musical instrument."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5992333-759e-4b3e-b627-a0eba6d9cbb8",
                                "sense_id": "480ef2d8-7e15-3a93-8953-a9985736bad8",
                                "text": "Let me give you in rude recitation, with here and there a twang and a caper of the guitar-strings, my vision of the Cid's sally from his besieged castle of Alcocer—the first outburst of that Spanish deluge that never receded till it rose over the dead body of the last Moor."
                            }
                        ]
                    },
                    {
                        "sense_id": "04d6a5b2-9495-3e05-811d-c2c628327f62",
                        "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                        "glosses": [
                            "A particular sharp vibrating sound characteristic of electric guitars."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "984c8735-9a4c-32c2-850c-a3e01a6eac52",
                        "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                        "glosses": [
                            "A trace of a regional or foreign accent in someone's voice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47192797-bd84-441e-b211-2114651fd8d2",
                                "sense_id": "984c8735-9a4c-32c2-850c-a3e01a6eac52",
                                "text": "Despite having lived in Canada for 20 years, he still has that Eastern-European twang in his voice."
                            },
                            {
                                "example_id": "3c5194c0-98d4-4a7a-bba6-4e58face68a3",
                                "sense_id": "984c8735-9a4c-32c2-850c-a3e01a6eac52",
                                "text": "A few insinuated that the American was not first-rate in Shakespeare, and one or two snidely detected a twang of the backwoods in his accent; […]"
                            },
                            {
                                "example_id": "d6e60288-320f-4aae-afd8-ba2aa46ab2a5",
                                "sense_id": "984c8735-9a4c-32c2-850c-a3e01a6eac52",
                                "text": "Judging by the new voice over the PA, we've had a crew change in Plymouth - the warning about masks and the apology for lack of catering is made in a chirpy Cockney twang rather than a West Country burr."
                            }
                        ]
                    },
                    {
                        "sense_id": "17e6e57c-1063-3d40-baa5-72a3c0b3c272",
                        "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                        "glosses": [
                            "The sound quality that appears in the human voice when the epilaryngeal tube is narrowed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991b15ab-603d-4c6d-9478-c1f9dee39333",
                                "sense_id": "17e6e57c-1063-3d40-baa5-72a3c0b3c272",
                                "text": "nasal twang"
                            },
                            {
                                "example_id": "a8a5b843-a11d-4c8d-8350-dfe4f24042ef",
                                "sense_id": "17e6e57c-1063-3d40-baa5-72a3c0b3c272",
                                "text": "Near-synonym: nasality"
                            }
                        ]
                    },
                    {
                        "sense_id": "dd0d559e-69a9-3733-bafd-4719c48d47eb",
                        "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                        "glosses": [
                            "A sharp, pungent taste or flavor; sometimes, a disagreeable one specifically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3d165f-94cd-45ea-b2e8-826a61918b21",
                                "sense_id": "dd0d559e-69a9-3733-bafd-4719c48d47eb",
                                "text": "spicy twang"
                            },
                            {
                                "example_id": "b9450197-4d24-49fe-984b-a18cba705cfe",
                                "sense_id": "dd0d559e-69a9-3733-bafd-4719c48d47eb",
                                "text": "Buttermilk also tastes different today. What do people do when they make buttermilk for the public that gives buttermilk that twang taste? Do these people put milk in an aging tank to mature like wine in a place where air and germs can't get to it?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0efacd02-61d2-3ebd-ac60-9670da8851cf",
                        "entry_id": "715e9a40-382a-3ddd-a859-9c31c18bb1eb",
                        "glosses": [
                            "An annoying or stupid person; especially, a recalcitrant."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9b771a1-63e1-4dd1-8f84-6faa3fb3decc",
