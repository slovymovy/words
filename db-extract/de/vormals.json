                "senses": [
                    {
                        "sense_id": "1af20bab-51b8-3970-a252-ebb68b6a30ec",
                        "entry_id": "e17db50f-8669-39ee-b6e5-01404da80cfa",
                        "glosses": [
                            "in der Vergangenheit liegend; früher"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1759f2-1d21-4291-a390-409a2fb94d30",
                                "sense_id": "1af20bab-51b8-3970-a252-ebb68b6a30ec",
                                "text": "Vormals stand auf diesem Grundstück hier die Fischfabrik."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9411498e-0bbb-4c24-bafb-3d6ec66657eb",
                        "source_entry_id": "e17db50f-8669-39ee-b6e5-01404da80cfa",
                        "source_sense_id": "1af20bab-51b8-3970-a252-ebb68b6a30ec",
                        "source_sense_description": "in der Vergangenheit liegend; früher",
                        "target_lang_word": "autrefois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autrefois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                        "entry_id": "2c88a32d-2c09-37cf-868b-7a3f96000bfa",
                                        "glosses": [
                                            "Anciennement ; jadis ; au temps passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80f5532-4c76-4692-bdfc-c61f6112bdcd",
                                                "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                                "text": "L’Inde autrefois nous donna l’anémone,\nDe nos jardins ornement printanier."
                                            },
                                            {
                                                "example_id": "b0336ef8-874f-443c-986f-8ee19d4bd82c",
                                                "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                                "text": "Mais tout cela était si loin et l’homme qu’il était devenu ressemblait si peu au jeune officier d’autrefois…"
                                            },
                                            {
                                                "example_id": "8da88bf4-7028-4830-84c0-88ae93873715",
                                                "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                                "text": "C’étaient autrefois des Élysées-Montmartre, des Ambassadeurs, des Tivolis Vauxhall, des Skatings, des Boules Noires ; – autrefois encore, des Mabilles, des Casinos, des Courtilles, des Closeries, des Reines Blanches ; – très autrefois, des Frascatis, des Valentinos, des Prados ; – et très, très autrefois, des Idalies, des Tivolis, des Folies, des Paphos."
                                            },
                                            {
                                                "example_id": "5c026170-11c8-4569-94e5-fe251053a97b",
                                                "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                                "text": "[…] ; je me souviens d’avoir lu autrefois, dans un manuel de Paul Bert, que le principe fondamental de la morale s’appuie sur les enseigne­ments de Zoroastre et sur la Constitution de l’an III ; […]."
                                            },
                                            {
                                                "example_id": "f540f296-3bca-4b84-a3f2-dd34e3d28f29",
                                                "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                                "text": "La généralité des Américains s’imaginaient la guerre d’après les campagnes limitées, avantageuses et pittoresques, qui avaient eu lieu autrefois."
                                            },
                                            {
                                                "example_id": "39f844e8-c3c1-4f44-ad95-c39b76f876ff",
                                                "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                                "text": "Ils ont ainsi émis la thèse selon laquelle la vie de l'homme préhistorique, pour bienheureuse qu'elle était, ainsi que nous l’a enseigné Rousseau, n'en était pas moins aussi ennuyeuse, à telle enseigne que cet homme d’autrefois fut naturellement amené à inventer un art pour se distraire."
                                            },
                                            {
                                                "example_id": "4d030589-9211-4558-ae62-1e7728f6fed4",
                                                "sense_id": "16d7ee20-7df4-3734-a6eb-4be9f1de84b6",
                                                "text": "La salle de réunion du conseil municipal avait autrefois servi de salle de classe pour les enfants du village. Le frontispice de l’édifice public comportait d'ailleurs toujours l’inscription « École-Mairie »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autrefois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec25173-5188-3889-98b1-c01f70c58383",
                                        "entry_id": "d418eb47-e944-32b5-9a16-118cc5f7add9",
                                        "glosses": [
                                            "Le temps d’autrefois."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d57fa66e-4a3f-466e-9aac-8abaf24d7acc",
                                                "sense_id": "4ec25173-5188-3889-98b1-c01f70c58383",
                                                "text": "— C’est un mauvais endroit, pensa-t-elle, et il n’est pas étonnant que je me sente l’esprit tourmenté en passant si près des méchantes pierres. On a tué du monde là-dessus, les autrefois, et les âmes sans confession demandent des prières. (Par cette expression, les autrefois, les paysans expriment mieux que nous ce que nous disions plus haut de leur notion mystérieuse et vague des siècles écoulés.)"
                                            },
                                            {
                                                "example_id": "b8119128-1762-4a0e-8e89-d11aeee3e5f5",
                                                "sense_id": "4ec25173-5188-3889-98b1-c01f70c58383",
                                                "text": "Ça leur est un si bon moyen, pour lier conversation, que d’avoir l’air de vous prendre pour un autre et de vous dire ensuite que c’est étonnant ce qu’on ressemble à quelqu’un qu’elles ont aimé, dans des autrefois !"
                                            },
                                            {
                                                "example_id": "b2b00195-c782-4c25-9046-a81b3688bf4c",
                                                "sense_id": "4ec25173-5188-3889-98b1-c01f70c58383",
                                                "text": "Son ton et son air exprimaient que, de l’avoir revue quinze jours plus tôt, cela avait effacé tout l’autrefois."
                                            },
                                            {
                                                "example_id": "748d317e-2302-454b-aeb1-5a57bb0c589d",
                                                "sense_id": "4ec25173-5188-3889-98b1-c01f70c58383",
                                                "text": "Lentement, la page est tournée,\nL’autrefois ne peut revenir […]"
                                            },
                                            {
                                                "example_id": "d3dee428-ef46-406f-959f-1565c5986c6d",
                                                "sense_id": "4ec25173-5188-3889-98b1-c01f70c58383",
                                                "text": "Ici, très loin dans l’autrefois, un ermite avait eu son sanctuaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "913ca810-bfa2-4c07-9553-35dcb63247e0",
                        "source_entry_id": "e17db50f-8669-39ee-b6e5-01404da80cfa",
                        "source_sense_id": "1af20bab-51b8-3970-a252-ebb68b6a30ec",
