                    {
                        "translation_id": "f59ba28a-c6bc-4e9b-8b6a-ae39fc62740a",
                        "source_entry_id": "2c36779e-a3f4-3ee9-b119-309b1b384eb0",
                        "source_sense_id": "1982a312-2989-31d8-a424-961afb3e8cf9",
                        "target_lang_word": "Jugendstil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jugendstil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e93054c3-bb9b-32ca-ad29-fe4b97b9f0d1",
                                        "entry_id": "e73c6ec6-e6ed-3ea0-bac1-3990214c5686",
                                        "glosses": [
                                            "Stilrichtung der Kunst in der Wende vom 19. zum 20. Jahrhundert, welche sich in erster Linie durch ihre pflanzlichen und dekorativen Elemente, aber auch geschwungene Linien und symmetrische Ornamente auszeichnete und hierdurch Ausdruck in der Architektur, Innenarchitektur, Malerei, Graphik und Plakatkunst fand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa71515-f487-4423-a698-3cc71b10c1f3",
                                                "sense_id": "e93054c3-bb9b-32ca-ad29-fe4b97b9f0d1",
                                                "text": "Der Tscheche Alphonse Mucha und der Österreicher Gustav Klimt sind hervorragende Repräsentanten des Jugendstiles."
                                            },
                                            {
                                                "example_id": "b7f87cf0-c5a9-4fe3-b650-4b522b4e2c2c",
                                                "sense_id": "e93054c3-bb9b-32ca-ad29-fe4b97b9f0d1",
                                                "text": "Der Jugendstil machte selbst vor dem wilhelminischen Prunk Kaiser Wilhelms II. in Berlin keinen Halt. Während er seine Hauptstadt mit neobarocken Denkmälern auftakelte, wuchsen Hochbahnhöfe und Kauf- und Wohnhäuser im Jugenstil empor."
                                            },
                                            {
                                                "example_id": "9239426a-7b34-4746-9439-0bb76da724e5",
                                                "sense_id": "e93054c3-bb9b-32ca-ad29-fe4b97b9f0d1",
                                                "text": "„Ziel des Jugendstils war die Wiedereinbeziehung der Kunstbewegung in das alltägliche Leben im Sinne einer künstlerischen Neugestaltung auch technischer Gebrauchsgegenstände, was an dem Bauwerk gut nachvollzogen werden kann.“"
                                            },
                                            {
                                                "example_id": "fb176fa5-c380-4704-a3f0-263ebfc8a012",
                                                "sense_id": "e93054c3-bb9b-32ca-ad29-fe4b97b9f0d1",
                                                "text": "„Über einem breiten Bett im übelsten Jugendststil hing in einem massigen Goldrahmen eine Waldlandschaft mit einem röhrenden Hirsch, ein paar Hirschkühen und einer Quelle im Vordergrunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
