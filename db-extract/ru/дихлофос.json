                "senses": [
                    {
                        "sense_id": "bd0cf2bf-ad06-3e10-ac46-e854ab5d622f",
                        "entry_id": "d343a94d-20a1-36a6-83ce-3e71502443c1",
                        "glosses": [
                            "химическое соединение, применяемое в качестве инсектицида"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2757b8-eab0-4fab-aa42-2fe0e8c2d090",
                                "sense_id": "bd0cf2bf-ad06-3e10-ac46-e854ab5d622f",
                                "text": "Судя по запаху, там морили тараканов, и пассажиры прятались от запаха дихлофоса за плотно закрытыми дверьми."
                            }
                        ]
                    },
                    {
                        "sense_id": "f92cabfe-7f55-3154-a0e9-5fba78beaa09",
                        "entry_id": "d343a94d-20a1-36a6-83ce-3e71502443c1",
                        "glosses": [
                            "разг. инсектицид в аэрозольной упаковке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04add873-1a8d-454d-bb15-d9d462ff18e4",
                                "sense_id": "f92cabfe-7f55-3154-a0e9-5fba78beaa09",
                                "text": "Ну и бражки ― немерено. Дихлофосом всё вспрыснул… Скотина такая, ведь пить заставил!"
                            }
                        ]
                    }
                ],
