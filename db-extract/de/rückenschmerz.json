                "senses": [
                    {
                        "sense_id": "22766ca9-308b-347a-a7d8-800fc25229df",
                        "entry_id": "e8efef40-4a30-329e-8ee0-578bb6c6c007",
                        "glosses": [
                            "Schmerzempfindung im Bereich des Rückens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3ee419-b2fa-41a6-869b-1c4d6f16bf50",
                                "sense_id": "22766ca9-308b-347a-a7d8-800fc25229df",
                                "text": "„In vielen Fällen sind Rückenschmerzen auf Fehlstellungen des Skeletts zurückzuführen.“"
                            },
                            {
                                "example_id": "c819137f-6523-42c2-b438-d18400f16b1e",
                                "sense_id": "22766ca9-308b-347a-a7d8-800fc25229df",
                                "text": "„Obwohl sie den blutigen Ausfluss und die damit verbundenen Rückenschmerzen hasste, war sie dankbar, dass sie dadurch ihren Vater los wurde.“"
                            },
                            {
                                "example_id": "80d9767f-8a4e-46f9-9ce5-3bdcf6f4d0c5",
                                "sense_id": "22766ca9-308b-347a-a7d8-800fc25229df",
                                "text": "„Seine Bestürzung wurde noch durch mörderische Rückenschmerzen verschärft, begleitet von einer Taubheit am rechten Bein, die ihm das Gehen erschwerte und das Schreiben nahezu unmöglich machte – er musste die Arbeit alle zwanzig Minuten unterbrechen und sich auf eine Matte legen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
