        "nl-extract.jsonl": [
            {
                "entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                "word": "naturalisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "809fffa5-422c-3b24-bc13-78b542d6c5a7",
                        "entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                        "glosses": [
                            "stroming in de literatuur aan het eind van de 19e eeuw, die de mens beschouwt als bepaald door milieu en erfelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919c32bb-971c-409a-ac8e-6803a9fdf168",
                                "sense_id": "809fffa5-422c-3b24-bc13-78b542d6c5a7",
                                "text": "Het is Emile Zola geweest die de term 'naturalisme' van toepassing verklaarde op het soort literatuur dat hemzelf voor ogen stond."
                            }
                        ]
                    },
                    {
                        "sense_id": "98984978-3563-3ac2-8341-06def53e29f8",
                        "entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                        "glosses": [
                            "stroming in de schilderkunst waarin men alles zo realistisch mogelijk poogt uit te beelden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c4dbc88-53d8-4f52-91b3-e2ac9efd591a",
                                "sense_id": "98984978-3563-3ac2-8341-06def53e29f8",
                                "text": "Impressionisme volgt op de periode van het naturalisme waarbij de schilder zo getrouw mogelijk de realiteit weergeeft."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d481964-dd0c-3d45-9166-1607226fb280",
                        "entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                        "glosses": [
                            "leer die de natuur boven alles stelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff44e621-555e-4fd8-aefa-ad7e1d274c4f",
                                "sense_id": "5d481964-dd0c-3d45-9166-1607226fb280",
                                "text": "Toen het rationalisme aan het einde van de 17de eeuw het menselijke verstand tot het hoogste goed verhief en het materialisme de materie als het enig werkelijke beschouwde, kon de filosofische denkrichting van het naturalisme zich gaan ontplooien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "902af478-0a9c-4f61-abcd-a41719f8ef3c",
                        "source_entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
                        "source_sense_id": "809fffa5-422c-3b24-bc13-78b542d6c5a7",
                        "source_sense_description": "2.3. stroming in de literatuur aan het eind van de 19e eeuw, die de mens beschouwt als bepaald door milieu en erfelijkheid en leer die de natuur boven alles stelt",
                        "target_lang_word": "Naturalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Naturalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c2a9679-745f-30f8-bf2b-e39ee875ec25",
                                        "entry_id": "8580c894-0910-3c5c-814a-625c211abe9f",
                                        "glosses": [
                                            "Wirklichkeitsnähe bei der Wiedergabe/Darstellung von Gegenständen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcccfd29-ddc9-4eab-88b0-e0dc266236a2",
                                                "sense_id": "4c2a9679-745f-30f8-bf2b-e39ee875ec25",
                                                "text": "„So wird unter Naturalismus eine dem Naturobjekt ähnliche Darstellung verstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d814910-9c4f-327c-b57b-841aae926fda",
                                        "entry_id": "8580c894-0910-3c5c-814a-625c211abe9f",
                                        "glosses": [
                                            "literarische und künstlerische Bewegung Ende des 19. Jahrhunderts, die sich unter dem Einfluss der Naturwissenschaften um eine wirklichkeitsnahe Gestaltung ihrer Gegenstände bemüht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "985652d4-b4da-4ca2-8b48-7556266276a7",
                                                "sense_id": "0d814910-9c4f-327c-b57b-841aae926fda",
                                                "text": "„Strenger formuliert A. Holz die Theorie des ‚konsequenten Naturalismus‘: ‚Die Kunst hat die Tendenz, wieder die Natur zu sein. Sie wird sie nach Maßgabe ihrer jeweiligen Reproduktionsbedingungen und deren Handhabung‘ und schaltet damit jede subjektive Phantasie aus.“."
                                            },
                                            {
                                                "example_id": "67bb59e0-3394-499c-814e-f55540ecab8d",
                                                "sense_id": "0d814910-9c4f-327c-b57b-841aae926fda",
                                                "text": "„Bei diesen Themen und diesem Plot könnte man annehmen, es handle sich um ein realistisches Drama nach der Art des Naturalismus oder um ein psychologisches und sozialkritisches Stück des ausgehenden 19. Jahrhunderts Schnitzler'scher Provenienz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3abe1e85-a3a9-34bd-b48b-69dbc99ac381",
                                        "entry_id": "8580c894-0910-3c5c-814a-625c211abe9f",
                                        "glosses": [
                                            "„philosophisch-weltanschauliche Richtung, welche die Natur als das Allumfassende, Einzige, allein Seiende betrachtet“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e50b62-574d-43f3-a614-b24ac9bb1b1b",
                                                "sense_id": "3abe1e85-a3a9-34bd-b48b-69dbc99ac381",
                                                "text": "„Was genau unter dem philosophischen Naturalismus zu verstehen sei, ist umstritten und Thema gleich mehrerer der in diesem Band versammelten Beiträge; in erster Annäherung ist es ein Philosophieren, das sich dem Erkenntnisideal und den Methoden der Naturwissenschaften verpflichtet fühlt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0d6c2c4-be8a-4af6-8c02-c4fd2e5d1060",
                        "source_entry_id": "c5d325e7-ec02-3604-9bd7-e1391cef369b",
