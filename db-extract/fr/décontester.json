                            {
                                "example_id": "19bebb9e-5b14-4e76-85c5-c9386beb5ed7",
                                "sense_id": "e2e7603c-90ae-3a86-ae6c-4b2f90ab7afa",
                                "text": "En affirmant son choix pour une signification plutôt qu’une autre, elles servent à décontester des concepts fondamentalement contestables."
                            },
                            {
                                "example_id": "e36803a3-a492-4be9-be78-248eef0732fe",
                                "sense_id": "e2e7603c-90ae-3a86-ae6c-4b2f90ab7afa",
                                "text": "Mais face à la contestation éventuelle de prétendants, les tenants s’emploient à « décontester » le réel."
                            },
                            {
                                "example_id": "ec946ab3-0da4-49a2-a063-e40e56772114",
                                "sense_id": "e2e7603c-90ae-3a86-ae6c-4b2f90ab7afa",
                                "text": "Pour accéder à l’escorte qui permet de décontester le temple du Dieu du feu, vous devez d’abord vérifier à quel niveau se trouvent les trois invasions d’Orr."
                            },
                            {
                                "example_id": "f200be21-db6c-497c-91fc-e1af44ee2218",
                                "sense_id": "e2e7603c-90ae-3a86-ae6c-4b2f90ab7afa",
                                "text": "Je voudrais retourner aux cavernes dorées mais je ne sais pas comment faire. Faut-il de nouveau payer 100 pièces d'or et le décontester?"
                            }
