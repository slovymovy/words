{
    "word_family": [
        "empêchement",
        "empêcheur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0050ce45-c59c-3031-8ed5-1efb62984949",
                    "sense_definition": "Faire obstacle à la réalisation de quelque chose ou rendre un événement impossible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La forte pluie a fini par <w>empêcher</w> le déroulement normal du tournoi sportif."
                        },
                        {
                            "text": "Rien ne nous <w>empêche</w> de partir plus tôt pour éviter les embouteillages."
                        }
                    ],
                    "synonyms": [
                        "prévenir"
                    ],
                    "antonyms": [
                        "permettre"
                    ],
                    "common_phrases": [
                        "rien n'empêche de"
                    ]
                },
                {
                    "sense_id": "c41be9de-17fb-322e-874f-7522997d8ca5",
                    "sense_definition": "Sous la forme pronominale, se retenir de manifester une émotion ou d'accomplir une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retenue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En entendant cette plaisanterie absurde, il n'a pas pu s'<w>empêcher</w> de rire."
                        },
                        {
                            "text": "Elle ne peut jamais s'<w>empêcher</w> de donner son avis sur chaque sujet."
                        }
                    ],
                    "synonyms": [
                        "se retenir de"
                    ],
                    "common_phrases": [
                        "ne pas pouvoir s'empêcher"
                    ]
                },
                {
                    "sense_id": "6c9a8481-c693-3a29-851d-4096588b0838",
                    "sense_definition": "Mettre dans une situation d'embarras ou de grande hésitation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embarras",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant cette question inattendue, le conférencier s'est trouvé fort <w>empêché</w> pour répondre."
                        },
                        {
                            "text": "Sans documents officiels pour prouver son identité, il était bien <w>empêché</w> dans ses démarches."
                        }
                    ],
                    "common_phrases": [
                        "être bien empêché",
                        "fort empêché"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Principalement employé au participe passé dans la langue soutenue."
                        }
                    ]
                }
            ]
        }
    ]
