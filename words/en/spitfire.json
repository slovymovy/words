{
    "word_family": [
        "spit",
        "fire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ccf456a-5783-3acd-8af6-6a2126a43bf9",
                    "sense_definition": "A person with a fiery temper who is easily provoked to anger.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a real <w>spitfire</w> who never backed down from an argument.",
                            "target_lang_translations": {
                                "de": "Sie war ein echter <w>Feuerteufel</w>, der bei einem Streit nie nachgab."
                            }
                        },
                        {
                            "text": "The young <w>spitfire</w> shouted at everyone who disagreed with her.",
                            "target_lang_translations": {
                                "de": "Der junge <w>Hitzkopf</w> schrie jeden an, der ihr widersprach."
                            }
                        }
                    ],
                    "synonyms": [
                        "hothead",
                        "firebrand"
                    ],
                    "common_phrases": [
                        "little spitfire"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person mit einem feurigen Temperament, die leicht reizbar ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Feuerteufel",
                                "target_lang_sense_clarification": "jemand mit einem hitzigen, aufbrausenden Wesen"
                            },
                            {
                                "target_lang_word": "Hitzkopf",
                                "target_lang_sense_clarification": "eine leicht reizbare, impulsiv handelnde Person"
                            },
                            {
                                "target_lang_word": "Furie",
                                "target_lang_sense_clarification": "oft für eine Frau mit sehr heftigem Temperament verwendet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f33f744-4597-316c-a21d-227b87b35022",
                    "sense_definition": "A historical type of cannon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>spitfire</w> was mounted on the castle wall for defense.",
                            "target_lang_translations": {
                                "de": "Die alte <w>Kanone</w> war zur Verteidigung auf der Burgmauer montiert."
                            }
                        },
                        {
                            "text": "Historians studied the design of the antique <w>spitfire</w> cannon.",
                            "target_lang_translations": {
                                "de": "Historiker untersuchten das Design der antiken <w>Kanone</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical artillery."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein historischer Kanonentyp."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "alte Kanone",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für historische Geschütze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "561a1f7a-bd12-341e-9aeb-03e1946c8916",
                    "sense_definition": "The larva of the Australian sawfly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spitfire</w> larvae feed on the leaves of eucalyptus trees.",
                            "target_lang_translations": {
                                "de": "Die <w>Blattwespenlarven</w> ernähren sich von den Blättern der Eukalyptusbäume."
                            }
                        },
                        {
                            "text": "Gardeners often find the <w>spitfire</w> clustered together on branches.",
                            "target_lang_translations": {
                                "de": "Gärtner finden die <w>Blattwespenlarven</w> oft in Gruppen an Ästen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Australia."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Larve der australischen Blattwespe."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Blattwespenlarve",
                                "target_lang_sense_clarification": "biologische Bezeichnung für die Larvenform"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1aacf235-b234-3656-bcee-5b9e07204bc5",
                    "sense_definition": "A British single-seat fighter aircraft used during World War II.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aircraft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Spitfire</w> is famous for its role in the Battle of Britain.",
                            "target_lang_translations": {
                                "de": "Die <w>Spitfire</w> ist berühmt für ihre Rolle in der Luftschlacht um England."
                            }
                        },
                        {
                            "text": "Many pilots flew the <w>Spitfire</w> during the war.",
                            "target_lang_translations": {
                                "de": "Viele Piloten flogen während des Krieges die <w>Spitfire</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flew a Spitfire"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein britisches einsitziges Jagdflugzeug, das im Zweiten Weltkrieg eingesetzt wurde."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Spitfire",
                                "target_lang_sense_clarification": "Eigenname des Flugzeugtyps, wird im Deutschen unverändert übernommen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}