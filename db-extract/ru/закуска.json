                        ]
                    },
                    {
                        "translation_id": "bf33b944-20af-439f-aba5-77845fe7c4c3",
                        "source_entry_id": "2c98a2b4-cde8-3f80-9250-98afa0f76391",
                        "source_sense_description": "?",
                        "target_lang_word": "snack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "575d9470-d8d5-322d-9b22-73d306ae52cb",
                                        "entry_id": "d8a0ef64-4cd9-3346-88a9-3a950c5cdab4",
                                        "glosses": [
                                            "A light meal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34018909-51fe-33f1-b38f-19f35e089f42",
                                        "entry_id": "d8a0ef64-4cd9-3346-88a9-3a950c5cdab4",
                                        "glosses": [
                                            "An item of food eaten between meals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d0af5d6-855e-4e63-936f-2c2300f25c91",
                                                "sense_id": "34018909-51fe-33f1-b38f-19f35e089f42",
                                                "text": "The numbers thin out the further we get from London, so I don't feel guilty when I remove my mask momentarily to scoff some of the snacks I'd bought at Marylebone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8d6c66-e76d-30cf-9da3-3678af9e2863",
                                        "entry_id": "d8a0ef64-4cd9-3346-88a9-3a950c5cdab4",
                                        "glosses": [
                                            "A very sexy and attractive person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98e63adc-ae3e-43dc-a6a4-04db4795c9e4",
                                                "sense_id": "0c8d6c66-e76d-30cf-9da3-3678af9e2863",
                                                "text": "Up close, he was a total snack. “That was pretty slick.” “Well.” He cocked his head, “I'm a pretty slick guy.” “I'm Kevin,” I said. “Romeo,” he put out his hand. “You're kidding.”"
                                            },
                                            {
                                                "example_id": "9e1867ab-1a2f-4bba-9910-6566320bdb0a",
                                                "sense_id": "0c8d6c66-e76d-30cf-9da3-3678af9e2863",
                                                "text": "You were looking like a snack. I was looking like a snack. We were finally going to do what two snacks do... I immediately went into my routine. Covers on. Lights off. But you Mr. Tate...you softly grabbed my hand, kissed it, and turned the lights back on."
                                            },
                                            {
                                                "example_id": "4bddec0d-8cbf-4561-ac62-9806da47b968",
                                                "sense_id": "0c8d6c66-e76d-30cf-9da3-3678af9e2863",
                                                "text": "Her confusion amped up. But so did her attraction. He was a total snack."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d3b4461-9381-3944-9a03-a9995bdadf6f",
                                        "entry_id": "f6920884-055b-3b3d-896e-35562bc65d62",
                                        "glosses": [
                                            "To eat a light meal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60dde4d1-a722-4f74-b385-cf66923dab6b",
                                                "sense_id": "3d3b4461-9381-3944-9a03-a9995bdadf6f",
                                                "text": "Insult is added to injury when I see the West Coast Railways dining train at the adjacent platform, where guests are sat snacking and drinking wine at a very sociable distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ff7d6f0-ed53-3b23-8685-d68b5061d8b4",
                                        "entry_id": "f6920884-055b-3b3d-896e-35562bc65d62",
                                        "glosses": [
                                            "To eat between meals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "snack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f986c5-83bf-378b-9fc3-cdbdce069a3f",
                                        "entry_id": "4708dedb-12fd-3e0e-b15d-1f839bbfd20f",
                                        "glosses": [
                                            "A share; a part or portion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0136725c-53d4-4584-9fb7-2907858c51fd",
                                                "sense_id": "29f986c5-83bf-378b-9fc3-cdbdce069a3f",
                                                "text": "All my demurrs but double his attacks; / At laſt he vvhiſpers, \"Do; and vve go ſnacks.\""
                                            },
                                            {
                                                "example_id": "41fc78a5-6899-4359-9d44-df86b89f260e",
                                                "sense_id": "29f986c5-83bf-378b-9fc3-cdbdce069a3f",
                                                "text": "\"Have you exhibited very much?\" said Young Person in the bar-parlour of the \"Coach and Horses,\" where Mr Watkins was skilfully accumulating local information on the night of his arrival. / \"Very little,\" said Mr Watkins, \"just a snack here and there.\""
                                            }
                                        ]
                                    }
                                ]
                            },
