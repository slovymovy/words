                                "target_senses": [
                                    {
                                        "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                        "entry_id": "3c345ed7-4308-36ff-a34d-7e3da010baf8",
                                        "glosses": [
                                            "Action de stériliser ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ca5944-f0b6-4395-9ef8-1e96167b85b3",
                                                "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                                "text": "Dans la laiterie, les technologies utilisables pour la conservation du lait sont … la stérilisation qui consiste à chauffer le lait à 110-120°C pendant 15-30 minutes ou à 135-140°C pendant 2-4 secondes (lait UHT). — (Cirad/Gret/MAE, Mémento de l'Agronome, 1 692 pages, page 1307, 2002, Paris, France, Cirad/Gret/Ministère des Affaires Étrangères)"
                                            },
                                            {
                                                "example_id": "70eb5d95-5b6f-47f3-a113-db0f455bd16e",
                                                "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                                "text": "Il n’y a pas de stérilisation possible des instruments; le verre d’eau du robinet où trempent les abaisse-langues; la gamelle d’aluminium contenant l’huile à lubrifier les spéculums, huile qui est renouvelée tous les trois jours,…"
                                            },
                                            {
                                                "example_id": "27ea8ea8-9caa-4e85-8a58-47abd0f568ed",
                                                "sense_id": "16a3318b-41dc-3fe1-9873-1aa49974028b",
                                                "text": "L'autonomie ? Le repliement de l’Alsace sur elle-même ? On aboutirait à la stérilisation et à la mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5adfbde-d8d3-4f5d-b754-5e6cba25f152",
                        "source_entry_id": "792f4e64-6bf9-33f9-ab2c-688f0f54ae57",
                        "source_sense_id": "8ff53c84-609f-3a1d-b3c5-27543e55abef",
                        "source_sense_description": "Entfernung oder Abtötung von Mikroorganismen in jedem Entwicklungsstadium",
                        "target_lang_word": "décontamination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
