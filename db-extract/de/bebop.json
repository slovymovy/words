                "senses": [
                    {
                        "sense_id": "b103ca65-00e3-3757-be7c-530dac90a45a",
                        "entry_id": "08085d4d-234e-355d-a35f-9247ac274c16",
                        "glosses": [
                            "durch mehr Soli und mehr Improvisation als im Swing geprägte Musikrichtung, die der Vorläufer des Modern Jazz war"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6fa70920-8e5c-4418-a13c-2a9ec30a8568",
                                "sense_id": "b103ca65-00e3-3757-be7c-530dac90a45a",
                                "text": "„Diese Jam-Sessions wurden zur Keimzelle des Bebop, der sich in den 1940er-Jahren entwickelt.“"
                            },
                            {
                                "example_id": "b920abf1-9d4d-44cf-ab3b-47605b9f5020",
                                "sense_id": "b103ca65-00e3-3757-be7c-530dac90a45a",
                                "text": "„Am Anfang jedoch war Bebop ihr großer Hit, Dizzy Gillespie und Charly Parker waren ihre Götter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "747e805b-03fd-3877-ae7d-d65f6da92ed0",
                        "entry_id": "08085d4d-234e-355d-a35f-9247ac274c16",
                        "glosses": [
                            "Werk in dieser Musikrichtung"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adb1886d-2183-4a5c-bec1-7e483fe19301",
                        "source_entry_id": "08085d4d-234e-355d-a35f-9247ac274c16",
                        "source_sense_id": "b103ca65-00e3-3757-be7c-530dac90a45a",
                        "source_sense_description": "Musikrichtung",
                        "target_lang_word": "bebop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bebop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a2e4e07-bec3-3688-9816-795671325003",
                                        "entry_id": "257e8f69-0d9e-31f8-af33-bd0690d0768e",
                                        "glosses": [
                                            "An early form of modern jazz played by small groups and featuring driving rhythms and complex, often dissonant harmonies."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bebop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c40658ff-2e30-3cbe-9cb8-979d557ba4ae",
                                        "entry_id": "2c9f5bae-14e0-338b-b83b-fb96fc660d8c",
                                        "glosses": [
                                            "To participate in bebop jazz, such as by dancing in a way associated with the genre."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150f80bc-6780-4a79-be32-53f704e8777e",
                                                "sense_id": "c40658ff-2e30-3cbe-9cb8-979d557ba4ae",
                                                "text": "Six months into their career, the Clash already showed themselves the equal of any rock band that had come before them, simply by assaulting the last frontier of rock mythology: the notion that the rock audience, like some sort of bebopping proletariat, was a receptacle of goodness and hope, and that rock 'n' roll offered redemption."
                                            },
                                            {
                                                "example_id": "532114cd-188d-40f4-9e34-222ee6bd4351",
                                                "sense_id": "c40658ff-2e30-3cbe-9cb8-979d557ba4ae",
                                                "text": "“The studios think we are having a horrible time out here,” said Richard Potter, a screenwriter who made “Strike Dancing,” a YouTube video showing pickets bebopping in formation to “Play That Funky Music.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                        "entry_id": "2c9f5bae-14e0-338b-b83b-fb96fc660d8c",
                                        "glosses": [
                                            "To walk in an easygoing, carefree manner."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50d5241-4458-48ec-ad85-ab4221964df9",
                                                "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                                "text": "Typically one could spot Chet bebopping down the sidewalk in an Amish hat, or hunched over a cafeteria table discussing Calvinism or the Vietnam war."
                                            },
                                            {
                                                "example_id": "4bdfbe1c-7b39-45ce-ab0d-28f450f1177d",
                                                "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                                "text": "I can't even say it was the people who board and casually whack off the top of your head with their slung-over-the-shoulder carry-ons as they obliviously bebop down the aisle to locate their seats."
                                            },
                                            {
                                                "example_id": "f0dc4efe-d3b3-4e42-9ed3-83c9a2e4ba49",
                                                "sense_id": "38a8c521-8dd7-30e7-a7e5-6306f3f6c692",
                                                "text": "Summer bebopped over, holding a cup of spiked punch in each hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f88567c-016a-4e8b-8e53-fe8a9bf2c8c4",
                        "source_entry_id": "08085d4d-234e-355d-a35f-9247ac274c16",
                        "source_sense_id": "b103ca65-00e3-3757-be7c-530dac90a45a",
                        "source_sense_description": "Musikrichtung",
                        "target_lang_word": "bebop",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bebop",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "931b477a-a416-3d06-96dd-d9c6e51f2611",
                                        "entry_id": "ce2048c9-34a6-33de-aa1e-0b768b7cd014",
                                        "glosses": [
                                            "Forme de jazz apparue dans les années 1940 et 1950."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed604e60-a077-4c79-bdc3-fdd91b91228f",
                                                "sense_id": "931b477a-a416-3d06-96dd-d9c6e51f2611",
                                                "text": "Avec le jazz des années 40, vite étiqueté sous le nom de bebop, émerge en effet une nouvelle donne dans le contrat social de l’époque à New York : les Noirs commencent à parler, à tenir des discours. L’Amérique est en guerre, et pour pouvoir envoyer ces hommes au front, il faut qu’elle relâche un peu la pression."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfaaa4d3-00b1-47d4-91a0-7654bc207058",
                        "source_entry_id": "08085d4d-234e-355d-a35f-9247ac274c16",
                        "source_sense_id": "b103ca65-00e3-3757-be7c-530dac90a45a",
                        "source_sense_description": "Musikrichtung",
                        "target_lang_word": "bebop",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
