                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2893c30-1d26-496e-955b-2d7fde7b6c4c",
                                                "sense_id": "8726a983-b4ce-3cfe-8f90-1e523e4834c7",
                                                "text": "Albert Camus."
                                            },
                                            {
                                                "example_id": "f9b3449f-07f8-4737-a8fa-3fc02f1b9906",
                                                "sense_id": "8726a983-b4ce-3cfe-8f90-1e523e4834c7",
                                                "text": "Pour en savoir plus contactez l’éco-aventurier Remi Camus et son équipe de spécialistes sur www.remicamus.com."
                                            },
                                            {
                                                "example_id": "7156365f-ac1e-4e32-8cb6-0290176d55ee",
                                                "sense_id": "8726a983-b4ce-3cfe-8f90-1e523e4834c7",
                                                "text": "Après une réédition aux éditions Mnémos, et une nouvelle traduction signée David Camus, c’est la prestigieuse collection La Pléiade qui s’apprête à publier l’intégralité de ses ouvrages."
                                            },
                                            {
                                                "example_id": "b078065b-45be-4da4-8f36-2b5452067ae2",
                                                "sense_id": "8726a983-b4ce-3cfe-8f90-1e523e4834c7",
                                                "text": "Sur scène, dans la salle et dans les coulisses, on croise Marie Bell, Madeleine Renaud et Jean-Louis Barrault, Jean Cocteau, Sacha Guitry, Paul Claudel, Albert Camus, Jean-Paul Sartre et Simone de Beauvoir, la toute jeune Juliette Gréco… mais aussi Ernst Jünger, dont le portrait nuancé ajoute à la subtilité de cette brillante évocation dénuée de tout manichéisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6ae64cf-85fe-4936-882d-4186c26a4cc5",
                        "source_entry_id": "cef8d644-badd-35ad-a52a-5255ab239110",
                        "source_sense_description": "surname",
                        "target_lang_word": "Камю́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Камю́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "07bded92-0765-3424-89ea-63e20ec32a07",
                                        "entry_id": "6f10202a-4b3b-3ba5-932a-90a5b27286b7",
                                        "glosses": [
                                            "французская фамилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fce13d4-dcca-4671-97a9-f13ff3f0fe8b",
                                                "sense_id": "07bded92-0765-3424-89ea-63e20ec32a07",
                                                "text": "Сейчас в таких странах, как Франция, имеют место попытки создания нового романа, идущего по пути Достоевского. Прежде всего это Камю. Его роман «Чума», его философское эссе «Миф о Сизифе» построены прямо на Достоевском. Много от Достоевского и у Сартра, хотя Камю, на мой взгляд, глубже."
                                            },
                                            {
                                                "example_id": "e231d2ad-d0a2-4d56-96ec-d0c88f77de19",
                                                "sense_id": "07bded92-0765-3424-89ea-63e20ec32a07",
                                                "text": "Итак, писатель, драматург и философ Камю родился в Алжире в 1913 году, погиб в автомобильной катастрофе во Франции в 1960 году."
                                            },
                                            {
                                                "example_id": "d7149948-e78a-43a3-af76-0470b3b28aba",
                                                "sense_id": "07bded92-0765-3424-89ea-63e20ec32a07",
                                                "text": "4 января 1960 года в автокатастрофе погиб Альбер Камю, лауреат Нобелевской премии по литературе, автор знаменитых книг «Чума» и «Посторонний»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
