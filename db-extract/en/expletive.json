                    {
                        "sense_id": "76f6dc86-422e-3d5c-988c-c37c56ec8b3c",
                        "entry_id": "215b5a8a-165f-3c2b-b022-3f415b567d2c",
                        "glosses": [
                            "Serving to fill up, merely for effect, otherwise redundant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128399c2-be6a-461f-a3c7-1557ced933dc",
                                "sense_id": "76f6dc86-422e-3d5c-988c-c37c56ec8b3c",
                                "text": "No one entered more fully than Shakespeare into the character of this species of poetry, which admits of no expletive imagery, no merely ornamental line."
                            },
                            {
                                "example_id": "2d57e7fb-e9b7-48a8-b554-699288529683",
                                "sense_id": "76f6dc86-422e-3d5c-988c-c37c56ec8b3c",
                                "text": "deprecating being taken for ſerious, or to be underſtood that he meaneth any thing by them; but only that he uſeth them as expletive phraſes ... to plump his ſpeech, and fill up ſentences."
                            }
                        ]
