                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900577c1-c96e-4ad1-8b37-a7318fd028e6",
                                                "sense_id": "5ff8eb43-8d52-31d0-b9fb-94f302550c42",
                                                "text": "„Das legendäre Bild ist eine Pieta, deren Datierung äußerst schwierig ist.“"
                                            },
                                            {
                                                "example_id": "928808b9-bd29-486d-b8ca-0a9e96fbe4d8",
