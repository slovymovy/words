                "senses": [
                    {
                        "sense_id": "79be0124-6899-3f9d-9c1b-7dccc557a74e",
                        "entry_id": "5870eb3f-b5d7-3e8a-abf3-510cbcfe05da",
                        "glosses": [
                            "To remove the foreskin."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9e2567fa-340b-48bd-af0f-814a1ccdb826",
                                "sense_id": "79be0124-6899-3f9d-9c1b-7dccc557a74e",
                                "text": "What she meant, of course, was young initiated men, and any such would be in short supply until after the foreskinning ceremonies at Christmas."
                            },
                            {
                                "example_id": "c3850d54-ef9b-4614-9d92-f1769c807530",
                                "sense_id": "79be0124-6899-3f9d-9c1b-7dccc557a74e",
                                "text": "I always liked an open fire,\" an open wound, suppuration of silent words from somewhere, a long line of fathers foreskinning for all they were worth, unknown, unsaid, alone in ice-cold space as we're all alone in the absence of God with only His mother, the mother of God, out there in black face, alone herself, the queen of the world..."
                            },
                            {
                                "example_id": "3313eca9-4e8d-4c07-903f-e547e4794bd0",
                                "sense_id": "79be0124-6899-3f9d-9c1b-7dccc557a74e",
                                "text": "An article in Instauration entitled “Foreskinning” exclaims that “slicing off babies' foreskins cannot be described as anything but forms of mutilation” performed by “savages.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "32a013aa-661e-315b-adf4-500995a4e6dd",
                        "entry_id": "5870eb3f-b5d7-3e8a-abf3-510cbcfe05da",
                        "glosses": [
                            "To sexually stimulate by manipulating the foreskin."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f806f1e-6635-435e-b692-26fbb4689bbd",
                                "sense_id": "32a013aa-661e-315b-adf4-500995a4e6dd",
                                "text": "According to Scotty, who should have played the accordion, and did he, Dr. Bowles now wonders, grow up to be Scotty Boy Potty and was all this merely a terribly tropish bit of biz foreskinning the man he would becum, nuntheless, according to Scott, if one waved bye-bye up and down, i.e. flapping, versus side to side, i.e. wiping, one was a fag."
                            },
                            {
                                "example_id": "2ec92e17-4b6e-4f67-82de-1318ef6a5e5d",
                                "sense_id": "32a013aa-661e-315b-adf4-500995a4e6dd",
                                "text": "S'ter Penny started to go but stopped when she noticed Ivy was still standing with us. \"Heh! Ivy Abankwah, jai foreskinning!\" She told her to stop doing something -- I wasn't sure what \"foreskinning\" meant."
                            },
                            {
                                "example_id": "880135d2-c3c9-4a57-b02f-bdb64aa5147a",
                                "sense_id": "32a013aa-661e-315b-adf4-500995a4e6dd",
                                "text": "Sucking whiskey from a sagging breast/ Sipping the bitter cigar/ foreskinning up and down..."
                            }
                        ]
                    }
