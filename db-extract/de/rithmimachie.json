                    {
                        "sense_id": "29ad29f2-0a9c-3153-8a3a-ed2cba25521d",
                        "entry_id": "580d63c8-5780-3b38-9fed-8e9d75685f08",
                        "glosses": [
                            "mittelalterliches Zahlenkampfspiel, ein Brettspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e627a6-211b-4755-9c0d-2e483df0d821",
                                "sense_id": "29ad29f2-0a9c-3153-8a3a-ed2cba25521d",
                                "text": "„Es soll nicht bestritten werden, daß Hesse bei der Konzeption und Ausgestaltung seines Glasperlenspiels die Rithmimachie übersehen haben mag.“"
                            },
                            {
                                "example_id": "ad65554b-b90d-4a7d-a2c9-190800c008e2",
                                "sense_id": "29ad29f2-0a9c-3153-8a3a-ed2cba25521d",
                                "text": "„Eine besondere Form unter den mathematischen Spielen war die Rithmimachie (rythmos=numerus, machia=pugna) oder Zahlenkampfspiel, welche aus Elementen der pythagoreischen Zahlentheorie besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
