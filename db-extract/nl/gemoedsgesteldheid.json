                                "example_id": "088444b1-47a9-4162-a218-c1867edc570a",
                                "sense_id": "7be71675-bcca-3751-a715-5bdc920e0e22",
                                "text": "Zijn gemoedsgesteldheid veranderde na het ontvangen van het nieuws.",
                                "translation": "His mood changed after receiving the news.",
                                "english": "His mood changed after receiving the news."
                            },
                            {
                                "example_id": "a5de1972-9fe7-4cb8-962b-b445a0568f38",
                                "sense_id": "7be71675-bcca-3751-a715-5bdc920e0e22",
                                "text": "De muziek had een grote invloed op haar gemoedsgesteldheid.",
                                "translation": "The music had a big influence on her mood.",
                                "english": "The music had a big influence on her mood."
                            },
                            {
                                "example_id": "ec82040a-0e62-40e7-ae97-ad24403d85dd",
                                "sense_id": "7be71675-bcca-3751-a715-5bdc920e0e22",
                                "text": "Het is belangrijk om aandacht te besteden aan je gemoedsgesteldheid voor een goede geestelijke gezondheid.",
                                "translation": "It's important to pay attention to your mood for good mental health.",
                                "english": "It's important to pay attention to your mood for good mental health."
                            }
                        ]
                    }
