                        "examples": [
                            {
                                "example_id": "c4f44bd6-523f-4eb9-b0fa-5834fdaa8fd0",
                                "sense_id": "d3303c0b-b940-3ed9-ac88-ad716160ad87",
                                "text": "“I bartended in that room,” [Mark Ruffalo] said, gesturing toward a space with cushy chairs."
                            },
                            {
                                "example_id": "1d4c7255-5368-4b91-9df6-1ecb5636c46d",
                                "sense_id": "d3303c0b-b940-3ed9-ac88-ad716160ad87",
                                "text": "Jimmy used to scallop from October to March and bartend a few shifts here and there over the summers when scalloping is prohibited."
                            },
                            {
                                "example_id": "df9180a2-b6ca-455e-b8fb-957b38c2a40b",
                                "sense_id": "d3303c0b-b940-3ed9-ac88-ad716160ad87",
                                "text": "In Sea Point, Kate bartends at the Wharf, works at the library and schemes to win back her ex, while facing long-held resentments — namely, feeling overshadowed by her sister and annoyed that, despite stellar academic qualifications, she couldn’t attend the pricey prep school Miles and Ziggy did."
