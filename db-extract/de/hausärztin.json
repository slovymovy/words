                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ec5c02-8c9b-4072-962f-2cd95cce8baa",
                        "source_entry_id": "f908ff68-1466-39ad-a37a-fad8d151fba8",
                        "source_sense_id": "cc08ec2e-cd43-38d4-9ae4-f3364c85ac63",
                        "target_lang_word": "médecin généraliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médecin généraliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6db02d45-d228-3a0e-b345-0854ffbcc1f4",
                                        "entry_id": "f93b8e32-8018-38a4-afc1-a4a79a48735c",
                                        "glosses": [
                                            "Médecin polyvalent qui accueille tout patient, en exerçant la médecine générale (ou médecine généraliste)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e417ac-15ad-45e2-ac05-15270539c1ee",
                                                "sense_id": "6db02d45-d228-3a0e-b345-0854ffbcc1f4",
                                                "text": "Pas loin de l’hôpital, une médecin généraliste travaille avec nous depuis des années."
                                            },
                                            {
                                                "example_id": "65b39bea-ef09-4599-8e64-ec6f2da9d0f5",
                                                "sense_id": "6db02d45-d228-3a0e-b345-0854ffbcc1f4",
                                                "text": "C’est avec une déconcertante facilité qu’elle devint, à son tour, une habitante de Châteauneuf-le-Rouge ou « Négrélienne » et les quelques commerçants du village, la coiffeuse, la responsable du magasin de presse, notre médecin généraliste, les pharmaciens, et tous nos voisins et amis, tous étaient sensibles à sa grande ouverture d’esprit et à son amour de la vie."
                                            },
                                            {
                                                "example_id": "8d40b24f-b3a1-4d22-83b7-4957f058b71a",
                                                "sense_id": "6db02d45-d228-3a0e-b345-0854ffbcc1f4",
                                                "text": "« Il faut essayer de trouver une horloge biologique cohérente et adaptée à la vie quotidienne », conseille Faïza Bossy, médecin généraliste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
