                                                "example_id": "502376b8-177d-4937-aefa-43ab67613ab6",
                                                "sense_id": "313aa28a-4c14-3c7f-8751-f14db84cdcc0",
                                                "text": "Die Zelte sind um das Lagerfeuer herum errichtet."
