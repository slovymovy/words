                "senses": [
                    {
                        "sense_id": "ed9e208a-cbbe-389d-ba3d-e18dd2e8c473",
                        "entry_id": "ed16cf65-b514-3c79-90ba-80b9c25259f3",
                        "glosses": [
                            "A likeness, a similarity; the quality of being similar."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0d2ba874-5bbf-31b5-ae04-bcf4c812364d",
                        "entry_id": "ed16cf65-b514-3c79-90ba-80b9c25259f3",
                        "glosses": [
                            "The way something looks or appears; an appearance; a form."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f6f22415-3a76-46e0-a1db-277b1b02ee08",
                                "sense_id": "0d2ba874-5bbf-31b5-ae04-bcf4c812364d",
                                "text": "England, seated far north in the turbid sea, now visits my dreams in the semblance of a vast and well-manned ship, which mastered the winds and rode proudly over the waves."
                            },
                            {
                                "example_id": "9e8a06d2-4b15-4869-a870-8bba5aa9cb8f",
                                "sense_id": "0d2ba874-5bbf-31b5-ae04-bcf4c812364d",
                                "text": "He was dressed in clothes far too large for him, clothes of the doctor’s bigness; the cords of his face still moved with a semblance of life, but life was quite gone; and by the crushed phial in the hand and the strong smell of kernels that hung upon the air, Utterson knew that he was looking on the body of a self-destroyer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22b1fcd0-3d83-4344-8d7c-f24c0fd9ec6e",
                        "source_entry_id": "ed16cf65-b514-3c79-90ba-80b9c25259f3",
                        "source_sense_description": "likeness, similarity",
                        "target_lang_word": "gelijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1cff9007-0535-3e9b-8988-0268d34163fe",
                                        "entry_id": "3c2b6447-8890-3504-8503-8eabaff30bd1",
                                        "glosses": [
                                            "het gelijk zijn"
                                        ],
                                        "tags": [
                                            "maatschappij"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "319891b6-6cd3-4bb7-a1ca-d205b222d161",
                                                "sense_id": "1cff9007-0535-3e9b-8988-0268d34163fe",
                                                "text": "Tolerantie, gelijkheid, nationale trots: Femke Halsema eist de veren terug waar rechts mee is gaan pronken."
                                            },
                                            {
                                                "example_id": "71ea414e-af6b-4f20-bf7b-e04b68293857",
                                                "sense_id": "1cff9007-0535-3e9b-8988-0268d34163fe",
                                                "text": "De geschiedenis van Europa heeft ons geleerd wat de kosten zijn van haat, tribalisme en geweld – en hoe belangrijk het is om een op feiten gebaseerd gedeeld verhaal over vrijheid, solidariteit, gelijkheid en democratie te hebben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97dddbf8-7273-368e-8794-33d5bd436329",
                                        "entry_id": "3c2b6447-8890-3504-8503-8eabaff30bd1",
                                        "glosses": [
                                            "de overeenkomst tussen grootheden die gelijk aan elkaar zijn"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16a186b3-0011-49e7-b910-cf459a09550d",
                        "source_entry_id": "ed16cf65-b514-3c79-90ba-80b9c25259f3",
