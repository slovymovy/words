{
    "word_family": [
        "settle",
        "settlement",
        "settler",
        "unsettle",
        "unsettling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a10fb276-32d1-33df-826c-3f33f36b2dca",
                    "sense_definition": "Not in a steady condition, uncertain, or subject to frequent change, especially regarding weather or situations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecast predicts <w>unsettled</w> conditions with occasional rain showers throughout the week.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды предсказывает <w>неустойчивые</w> условия с кратковременными дождями в течение всей недели."
                            }
                        },
                        {
                            "text": "Investors are nervous because of the <w>unsettled</w> state of the global economy right now.",
                            "target_lang_translations": {
                                "ru": "Инвесторы нервничают из-за <w>нестабильного</w> состояния мировой экономики в данный момент."
                            }
                        }
                    ],
                    "synonyms": [
                        "unstable",
                        "changeable",
                        "uncertain",
                        "variable"
                    ],
                    "antonyms": [
                        "stable",
                        "settled",
                        "steady"
                    ],
                    "common_phrases": [
                        "unsettled weather",
                        "unsettled conditions",
                        "unsettled state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в неустойчивом состоянии, неопределенный или подверженный частым изменениям, особенно в отношении погоды или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неустойчивый",
                                "target_lang_sense_clarification": "о погоде или ситуации"
                            },
                            {
                                "target_lang_word": "нестабильный",
                                "target_lang_sense_clarification": "о состоянии дел или экономике"
                            },
                            {
                                "target_lang_word": "переменчивый",
                                "target_lang_sense_clarification": "часто меняющийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56169040-04d6-3cb6-9d55-59bcf588f38f",
                    "sense_definition": "Feeling nervous, anxious, or emotionally disturbed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt deeply <w>unsettled</w> by the strange noise coming from the basement late at night.",
                            "target_lang_translations": {
                                "ru": "Я почувствовал себя крайне <w>встревоженным</w> из-за странного шума, доносившегося из подвала поздно ночью."
                            }
                        },
                        {
                            "text": "The <w>unsettled</w> feeling in her stomach wouldn't go away even after the meeting ended.",
                            "target_lang_translations": {
                                "ru": "<w>Беспокойное</w> чувство в животе не проходило даже после окончания встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "disturbed",
                        "uneasy",
                        "agitated",
                        "perturbed"
                    ],
                    "antonyms": [
                        "calm",
                        "composed",
                        "relaxed"
                    ],
                    "common_phrases": [
                        "feel unsettled",
                        "deeply unsettled",
                        "unsettled feeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий нервозность, беспокойство или эмоциональное смятение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеспокоенный",
                                "target_lang_sense_clarification": "чувствующий тревогу"
                            },
                            {
                                "target_lang_word": "выбитый из колеи",
                                "target_lang_sense_clarification": "потерявший душевное равновесие"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "взволнованный чем-то неприятным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b6401d5-d7f0-3164-a15c-ad211774992f",
                    "sense_definition": "Not yet paid or resolved, particularly in the context of debts or disputes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance_legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company still has several <w>unsettled</w> debts that must be paid by the end of the month.",
                            "target_lang_translations": {
                                "ru": "У компании все еще есть несколько <w>непогашенных</w> долгов, которые должны быть выплачены до конца месяца."
                            }
                        },
                        {
                            "text": "There are many <w>unsettled</w> claims remaining after the insurance company reviewed the accident.",
                            "target_lang_translations": {
                                "ru": "Осталось много <w>неурегулированных</w> претензий после того, как страховая компания рассмотрела аварию."
                            }
                        }
                    ],
                    "synonyms": [
                        "unpaid",
                        "outstanding",
                        "resolved"
                    ],
                    "antonyms": [
                        "paid",
                        "settled",
                        "resolved"
                    ],
                    "common_phrases": [
                        "unsettled debt",
                        "unsettled bill",
                        "unsettled claim"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or financial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Еще не оплаченный или не решенный, особенно в контексте долгов или споров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непогашенный",
                                "target_lang_sense_clarification": "о долгах или счетах"
                            },
                            {
                                "target_lang_word": "неурегулированный",
                                "target_lang_sense_clarification": "о спорах или претензиях"
                            },
                            {
                                "target_lang_word": "неоплаченный",
                                "target_lang_sense_clarification": "о финансовых обязательствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "543edad8-eabe-3d39-9565-fa3ea1d282e4",
                    "sense_definition": "Not populated or having no permanent inhabitants or settlers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers traveled through vast <w>unsettled</w> areas of the northern wilderness.",
                            "target_lang_translations": {
                                "ru": "Исследователи путешествовали по обширным <w>незаселенным</w> районам северной глуши."
                            }
                        },
                        {
                            "text": "Much of the interior of the continent remained <w>unsettled</w> for centuries.",
                            "target_lang_translations": {
                                "ru": "Большая часть внутренних районов континента оставалась <w>неосвоенной</w> на протяжении веков."
                            }
                        }
                    ],
                    "synonyms": [
                        "uninhabited",
                        "unpopulated",
                        "empty"
                    ],
                    "antonyms": [
                        "inhabited",
                        "populated",
                        "settled"
                    ],
                    "common_phrases": [
                        "unsettled territory",
                        "unsettled land",
                        "unsettled region"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаселенный или не имеющий постоянных жителей или поселенцев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаселенный",
                                "target_lang_sense_clarification": "о территории"
                            },
                            {
                                "target_lang_word": "неосвоенный",
                                "target_lang_sense_clarification": "о земле, где нет поселений"
                            },
                            {
                                "target_lang_word": "пустынный",
                                "target_lang_sense_clarification": "безлюдный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3823582-838b-376c-8e62-11986d7b8d8c",
                    "sense_definition": "Past tense and past participle of <w>unsettle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in plans <w>unsettled</w> the entire team just before the competition.",
                            "target_lang_translations": {
                                "ru": "Внезапная смена планов <w>выбила из колеи</w> всю команду прямо перед соревнованиями."
                            }
                        },
                        {
                            "text": "The news has <w>unsettled</w> many residents who were hoping for a peaceful resolution.",
                            "target_lang_translations": {
                                "ru": "Эта новость <w>встревожила</w> многих жителей, надеявшихся на мирное решение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «unsettle» (выбивать из колеи, тревожить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстроил",
                                "target_lang_sense_clarification": "нарушил спокойствие"
                            },
                            {
                                "target_lang_word": "встревожил",
                                "target_lang_sense_clarification": "вызвал беспокойство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}