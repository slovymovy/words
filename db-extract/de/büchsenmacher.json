                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "234957a0-4799-446c-9bec-f2b9f5cfb40c",
                                                "sense_id": "332f754a-869d-31cc-bc28-6b269c9bf1c3",
