                "senses": [
                    {
                        "sense_id": "ff035ccc-83a9-313a-9dcc-a9432cc65bf2",
                        "entry_id": "30337528-89af-357b-9dfb-4b06d4469e71",
                        "glosses": [
                            "Ansprache (häufig des Staatsoberhaupts oder Regierungschefs), die anlässlich des Jahreswechsels gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b42d5929-51fb-4ea6-a717-0ab4ca58de55",
                                "sense_id": "ff035ccc-83a9-313a-9dcc-a9432cc65bf2",
                                "text": "Wir sehen uns die Neujahrsansprache der Bundeskanzlerin im Fernsehen an."
                            },
                            {
                                "example_id": "ab38eae8-aaf1-45d2-bdfd-42911db9d6fa",
                                "sense_id": "ff035ccc-83a9-313a-9dcc-a9432cc65bf2",
                                "text": "Tanja hat alle Neujahrsansprachen der Bundeskanzler von 1974 bis 1989 auf Video aufgenommen."
                            },
                            {
                                "example_id": "f0d9e8e0-90bc-4e76-928a-cd348e1e8ca0",
                                "sense_id": "ff035ccc-83a9-313a-9dcc-a9432cc65bf2",
                                "text": "„An Heiligabend dieses Jahres wurde das Äußere der Synagoge durch Nazis geschändet, was Bundeskanzler Adenauer in seiner Neujahrsansprache zum Thema machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
