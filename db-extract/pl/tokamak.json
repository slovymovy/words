                "senses": [
                    {
                        "sense_id": "6d94d30c-5adc-3361-b4ee-186086d67e7f",
                        "entry_id": "2e21bed2-84ad-3009-b675-18c916d5c2d2",
                        "glosses": [
                            "urządzenie do przeprowadzania kontrolowanych reakcji termojądrowych przez podgrzanie plazmy deuterowo-trytowej do temperatury kilkudziesięciu milionów stopni Kelwina"
                        ],
                        "tags": [],
