        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0263a8e0-62c9-3b97-adc7-4f9006a9c974",
                    "sense_definition": "To make or turn (something) green or greener.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spring rains will soon <w>green</w> the hillsides.",
                            "target_lang_translations": {
                                "ru": "Весенние дожди скоро <w>озеленят</w> склоны холмов."
                            }
                        },
                        {
                            "text": "She had accidentally <w>greened</w> her skirt by sitting on the grass.",
                            "target_lang_translations": {
                                "ru": "Она случайно <w>испачкала в зелёный</w> свою юбку, сев на траву."
                            }
