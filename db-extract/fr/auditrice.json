                                        "glosses": [
                                            "Someone who listens, especially to a speech or a broadcast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b3de07-023c-426a-b82a-bcb0edfa8522",
                                                "sense_id": "757cf30a-837e-3981-8060-9f6e479574b0",
                                                "text": "[…] she would set herself going, telling the most interminable stories, until the last listener was fast asleep[…]"
                                            },
                                            {
                                                "example_id": "146e60a5-5d17-4c9a-8d1f-e7b890a671a8",
                                                "sense_id": "757cf30a-837e-3981-8060-9f6e479574b0",
                                                "text": "And then her words tumbled out in a passion of communication, as though she hurried before her listener could be taken away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ebaf8b5-bc76-35a9-8621-8bff4253106d",
