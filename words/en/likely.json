    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03f51730-e4dc-3867-b89e-c71663d9879d",
                    "sense_definition": "Having a good chance of happening or being true; probable or expected.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rain is <w>likely</w> later this afternoon.",
                            "target_lang_translations": {
                                "ru": "Во второй половине дня <w>вероятен</w> дождь.",
                                "tr": "Öğleden sonra yağmur yağması <w>muhtemel</w>.",
                                "zh": "今天下午晚些时候<w>很有可能</w>会下雨。"
                            }
                        },
                        {
                            "text": "He is <w>likely</w> to succeed at anything he tries.",
                            "target_lang_translations": {
                                "ru": "Он, <w>вероятно</w>, добьется успеха во всем, за что ни возьмется.",
                                "tr": "Denediği her şeyde başarılı olması <w>muhtemeldir</w>.",
                                "zh": "他做任何事都<w>很可能</w>会成功。"
                            }
                        },
                        {
                            "text": "It is more <w>likely</w> to be tastier if you eat it fresh.",
                            "target_lang_translations": {
                                "ru": "Это, <w>вероятнее</w> всего, будет вкуснее, если съесть его свежим.",
                                "tr": "Taze yerseniz lezzetli olma ihtimali daha <w>yüksek</w>.",
                                "zh": "趁新鲜吃的话，味道<w>更有可能</w>更好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "probable"
                    ],
                    "antonyms": [
                        "unlikely"
                    ],
                    "common_phrases": [
                        "highly likely",
                        "likely to",
                        "more likely than not",
                        "most likely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий хорошие шансы произойти или оказаться правдой; вероятный или ожидаемый.",
                        "tr": "Gerçekleşme veya doğru olma olasılığı yüksek olan; muhtemel veya beklenen.",
                        "zh": "很有可能发生或属实的；预期的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вероятный",
                                "target_lang_sense_clarification": "возможный, ожидаемый"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "muhtemel",
                                "target_lang_sense_clarification": "olası, beklenen"
                            },
                            {
                                "target_lang_word": "olası",
                                "target_lang_sense_clarification": "gerçekleşme ihtimali olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可能",
                                "target_lang_sense_clarification": "表示有很大机会发生"
                            },
                            {
                                "target_lang_word": "很有可能",
                                "target_lang_sense_clarification": "表示概率很高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "142b9674-0998-367b-8d3b-90b9cb5b30be",
                    "sense_definition": "Seeming like truth; plausible or believable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is not a very <w>likely</w> excuse for being late.",
                            "target_lang_translations": {
                                "ru": "Это не очень <w>правдоподобное</w> оправдание опоздания.",
                                "tr": "Geç kalmak için pek <w>inandırıcı</w> bir mazeret değil.",
                                "zh": "这作为迟到的理由不太<w>可信</w>。"
                            }
                        },
                        {
                            "text": "The police accepted his explanation as the most <w>likely</w> version of events.",
                            "target_lang_translations": {
                                "ru": "Полиция приняла его объяснение как наиболее <w>правдоподобную</w> версию событий.",
                                "tr": "Polis, onun açıklamasını olayların en <w>makul</w> versiyonu olarak kabul etti.",
                                "zh": "警方接受了他的解释，认为这是最<w>合理</w>的事件版本。"
                            }
                        }
                    ],
                    "antonyms": [
                        "implausible"
                    ],
                    "common_phrases": [
                        "likely story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущийся правдой; правдоподобный.",
                        "tr": "Gerçek gibi görünen; akla yatkın veya inanılır.",
                        "zh": "看起来像真的；可信的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правдоподобный",
                                "target_lang_sense_clarification": "выглядящий истинным"
