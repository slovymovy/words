                                    {
                                        "sense_id": "4aad8f90-048c-3df5-872d-dcf0953a9902",
                                        "entry_id": "3ecd9fca-030a-3954-8a0d-6b550a6ed627",
                                        "glosses": [
                                            "een van oorsprong Spaanse worstsoort die kruidig van smaak en roodachtig van kleur is en een stevige, grove structuur heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9694db-4119-400f-9751-8a40e6422543",
                                                "sense_id": "4aad8f90-048c-3df5-872d-dcf0953a9902",
                                                "text": "Een Spaanse tortilla, niet te verwarren met de Mexicaanse variant, bestaat simpel gezegd uit veel ei met aardappel erin. Maar er valt veel mee te experimenteren. Zo kun je er extra groente bij doen of een lekkere chorizo, keuze genoeg!"
                                            },
                                            {
                                                "example_id": "1af6b4c4-4687-45c5-a245-b8e825262017",
                                                "sense_id": "4aad8f90-048c-3df5-872d-dcf0953a9902",
                                                "text": "Ondanks dat de mosselen iets kleiner zijn dit jaar, zijn ze wel van topkwaliteit. Reden om vanavond deze lekkere mosselen met chorizo en couscous te proberen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
