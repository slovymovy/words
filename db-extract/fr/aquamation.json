                "entry_id": "400ffd3c-b9e4-32aa-9bac-7567a49a81eb",
                "word": "aquamation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6acde598-14f6-447f-8265-728deb593c65",
                        "entry_id": "400ffd3c-b9e4-32aa-9bac-7567a49a81eb",
