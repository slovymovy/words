                "senses": [
                    {
                        "sense_id": "4ced1463-30f2-36c8-9b76-d0eafc240a99",
                        "entry_id": "b65546b2-d2e0-3b7c-9727-68955fe7cf7f",
                        "glosses": [
                            "een bestuursorgaan bestaande uit hooggeplaatste leden van een regering, de regering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ca02b7-48a8-4559-9cc4-5a7381cdb573",
                                "sense_id": "4ced1463-30f2-36c8-9b76-d0eafc240a99",
                                "text": "Het kabinet-Balkenende IV viel over de missie in Uruzgan: het CDA en de CU wilden de militaire missie verlengen, de PvdA niet."
                            },
                            {
                                "example_id": "9c4e1841-8740-4441-b4bd-d6bd019ea1c3",
                                "sense_id": "4ced1463-30f2-36c8-9b76-d0eafc240a99",
                                "text": "Het is bepaald niet ondenkbaar dat ook het oligarchenkapitaal dat nu zo moeilijk te traceren is, buiten beeld is geraakt door fiscale constructies die zijn opgetuigd in ons land, met goedkeuring van een hele serie kabinetten-Balkenende en -Rutte."
                            },
                            {
                                "example_id": "ee13be81-80b1-4849-a839-2bcb60eb02bc",
                                "sense_id": "4ced1463-30f2-36c8-9b76-d0eafc240a99",
                                "text": "Toen Van Mierlo zich na de vorming van het kabinet-Den Uyl in 1973 terugtrok als fractieleider, werd Terlouw zijn opvolger. Het verschil met de oude leider had nauwelijks groter kunnen zijn. Van Mierlo, een ex-journalist en ex-katholiek, was een slonzige, wat warrige en breedsprakige kroegtijger; Terlouw een keurige, kalme en rationeel redenerende domineeszoon."
                            }
                        ]
                    },
                    {
                        "sense_id": "cff96db6-e88a-386f-a72c-77b63220ee86",
                        "entry_id": "b65546b2-d2e0-3b7c-9727-68955fe7cf7f",
                        "glosses": [
                            "een meestal houten opslagmeubel met veel vakken, deurtjes of vitrines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fde2c85-ee20-4bbb-9301-5353c2c69052",
                                "sense_id": "cff96db6-e88a-386f-a72c-77b63220ee86",
                                "text": "Midden in de gang torent een enorm kabinet meer dan een halve meter boven Johannes uit."
                            },
                            {
                                "example_id": "5ae24618-25f9-484a-a475-c7e1e3c5c5a6",
                                "sense_id": "cff96db6-e88a-386f-a72c-77b63220ee86",
                                "text": "Maren loopt behoedzaam naar het kabinet toe, alsof het boven op haar kan vallen of uit zichzelf naar haar toe kan komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a3087f9-0da6-39fb-b118-96f42f250815",
                        "entry_id": "b65546b2-d2e0-3b7c-9727-68955fe7cf7f",
                        "glosses": [
                            "een plaats waar een verzameling ergens van is aangelegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7685191d-7465-4774-a030-1dc4c6e870e0",
                                "sense_id": "2a3087f9-0da6-39fb-b118-96f42f250815",
                                "text": "In dit kabinet worden veel rariteiten tentoongesteld."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0e05641-1799-3c33-8785-91ad5970312f",
