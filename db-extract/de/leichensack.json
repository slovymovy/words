                "senses": [
                    {
                        "sense_id": "db9036cf-d803-33d6-a0ba-4e9c743ca7c7",
                        "entry_id": "d50b0fef-1206-34e5-b182-068a30677c12",
                        "glosses": [
                            "Sac mortuaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0543bc54-0d96-439b-81d4-132af76021ef",
                                "sense_id": "db9036cf-d803-33d6-a0ba-4e9c743ca7c7",
                                "text": "Ein Video, das im Internet kursierte, zeigt Leichensäcke, die in einem Krankenhaus der Millionenstadt auf dem Boden direkt neben Kranken liegen, und selbst auf Sitzen im Wartesaal."
                            },
                            {
                                "example_id": "ca4c2036-2c80-46aa-9b65-3d093a39b0bf",
                                "sense_id": "db9036cf-d803-33d6-a0ba-4e9c743ca7c7",
                                "text": "Betty Gilpin, 35, US-Schauspielerin, wurde zu Beginn ihrer Karriere am Set mal in einem Leichensack vergessen. \"Ich erinnere mich, wie sie den Reißverschluss zuzogen\" (...)",
                                "translation": "Betty Gilpin, 35 ans, actrice américaine, a été oubliée une fois sur le plateau au début de sa carrière dans un sac mortuaire. « Je me souviens qu’ils ont tiré la fermeture éclair » (...)"
                            }
                        ]
                    }
                ],
