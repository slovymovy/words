                "senses": [
                    {
                        "sense_id": "27a25df0-3e53-34f1-bb5e-d461bb6c6999",
                        "entry_id": "d18eb892-d91a-3e71-abd0-b4dab167f79d",
                        "glosses": [
                            "Technik beim Kugelstoßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82229172-55ef-47b7-8fb0-79d727f80f3d",
                                "sense_id": "27a25df0-3e53-34f1-bb5e-d461bb6c6999",
                                "text": "„Generell eignet sich das Angleiten mehr für große athletische Sportler, der Drehstoß für etwas kleinere, aber sehr schwere Stoßer.“"
                            },
                            {
                                "example_id": "9dd8977c-926c-4f8c-aa52-4742b799b1ab",
                                "sense_id": "27a25df0-3e53-34f1-bb5e-d461bb6c6999",
                                "text": "„Die Ferse des rechten Fußes setzt nach dem Angleiten auf.“"
                            },
                            {
                                "example_id": "c06a7227-fdab-415d-8eea-b2d892b2cc6e",
                                "sense_id": "27a25df0-3e53-34f1-bb5e-d461bb6c6999",
                                "text": "„Die Schüler und Schülerinnen sollen ein Gefühl für die ganzheitliche Bewegung bekommen und erproben, wie gut sie das Element des Angleitens nun mit bisher Gelerntem verknüpfen können.“"
                            },
                            {
                                "example_id": "8fb7983b-9d8e-4398-88d4-1d18b4d913d7",
                                "sense_id": "27a25df0-3e53-34f1-bb5e-d461bb6c6999",
                                "text": "„Durch ein stärkeres Abbeugen vor dem Angleiten und beim Angleiten selbst konnte er zusammen mit der erhöhten Schnelligkeit beim Angleiten den Beschleunigungsweg der Kugel verlängern und den Weltrekord auf 17,95 m steigern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
