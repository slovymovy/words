            {
                "entry_id": "30d58d7d-4771-34e6-b928-df4a319c287a",
                "word": "fash",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6457a4e4-d2a6-47e7-9003-67bd1063323e",
                        "entry_id": "30d58d7d-4771-34e6-b928-df4a319c287a",
                        "tags": [
