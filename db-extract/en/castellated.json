                        "entry_id": "5e41913d-9ffb-34c8-9b1b-7c996f3a27ba",
                        "glosses": [
                            "Castle-like: built or shaped like a castle; usually, specifically, having castellations (crenellations)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df89d082-da82-4af9-8bd5-2d7239bf6781",
                                "sense_id": "bbf0ede8-e1f4-3acb-9065-d992f346afb1",
                                "text": "Near-synonym: crenellated"
                            },
                            {
                                "example_id": "875a6ca1-d21e-425f-b62d-231f0c3c9379",
                                "sense_id": "bbf0ede8-e1f4-3acb-9065-d992f346afb1",
                                "text": "...A Castellated mansion..."
                            },
                            {
                                "example_id": "0b12c58b-4413-4861-8fd6-68d65b0e98d4",
                                "sense_id": "bbf0ede8-e1f4-3acb-9065-d992f346afb1",
                                "text": "Finally he walked slowly into a vast Italian space, with towers and castellated roofs, and a sky the colour of dark blue ink, smooth and consistent."
                            },
                            {
                                "example_id": "2ca3148d-1f91-4491-89b4-c2ace6469f03",
                                "sense_id": "bbf0ede8-e1f4-3acb-9065-d992f346afb1",
                                "text": "Three castellated (with battlements) towers stand sentry here, with one being particularly large. This is said to have been used by Rhodes as a belvedere, and (according to some sources) by railway staff for some time after opening."
                            }
                        ]
                    },
                    {
                        "sense_id": "59f5c606-17c0-3018-a412-9a3677c22dd5",
                        "entry_id": "5e41913d-9ffb-34c8-9b1b-7c996f3a27ba",
                        "glosses": [
                            "Having grooves or recesses on an upper face."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd67eb5-b7fd-42ee-8c89-29a1f3a76d3f",
                                "sense_id": "59f5c606-17c0-3018-a412-9a3677c22dd5",
                                "text": "Near-synonym: crenellated"
                            },
                            {
                                "example_id": "91f6fde5-a186-47d4-b29d-f06173a50b2e",
                                "sense_id": "59f5c606-17c0-3018-a412-9a3677c22dd5",
                                "text": "Castellated nuts are used throughout, with split pins."
                            }
                        ]
                    },
                    {
                        "sense_id": "154f6e6a-46c7-36c5-a34d-1c482717eca6",
                        "entry_id": "5e41913d-9ffb-34c8-9b1b-7c996f3a27ba",
                        "glosses": [
                            "Castled: having or furnished with castles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2338785a-f229-4635-8971-587579f379a8",
                                "sense_id": "154f6e6a-46c7-36c5-a34d-1c482717eca6",
                                "text": "...This castellated island..."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8681866-392c-3d8e-96db-645866d8a65a",
                        "entry_id": "5e41913d-9ffb-34c8-9b1b-7c996f3a27ba",
                        "glosses": [
                            "Housed or kept in a castle."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7a6ba081-cfff-4d90-a771-f33568cba4d7",
                                "sense_id": "a8681866-392c-3d8e-96db-645866d8a65a",
                                "text": "His unbiassed justice... struck horror into the heart of every castellated felon."
                            }
                        ]
                    }
