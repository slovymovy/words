                "senses": [
                    {
                        "sense_id": "ca133f9d-cf8e-34b2-8a80-f60519397922",
                        "entry_id": "2b939fcb-25fd-308a-9a93-789f9e6e94d8",
                        "glosses": [
                            "Machine permettant de tirer au sort des citoyens dans l’Athènes antique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "36b271c0-68fe-46be-a2d3-1fd404eb9db7",
                                "sense_id": "ca133f9d-cf8e-34b2-8a80-f60519397922",
                                "text": "Au milieu de la plus grande collection universitaire de moulages en France, dont une belle collection d’œuvres illustrant l’histoire et les institutions de la démocratie athénienne, trône donc le klérotèrion."
                            },
                            {
                                "example_id": "2fc3ae3c-024e-44c5-a9c4-66e6777850c3",
                                "sense_id": "ca133f9d-cf8e-34b2-8a80-f60519397922",
                                "text": "Dans les deux cas, klérotèrion ou tableur, la décision est générée par une machine ; et la règle d’arrêt subordonnée à son activation."
                            },
                            {
                                "example_id": "2808bf70-b13e-4279-a96f-05ca22a7a3b7",
                                "sense_id": "ca133f9d-cf8e-34b2-8a80-f60519397922",
                                "text": "Sur les 700 magistrats que compte l’Athènes de Périclès, environ 600 ne sont pas élus mais désignés au terme d’une sorte de loterie : on glissait des languettes de bronze (les pinakia) au nom de chaque citoyen dans une machine conçue pour en sélectionner le nombre souhaité de manière aléatoire, le klérotèrion (cf. ci-dessous)."
                            }
                        ]
                    }
                ],
