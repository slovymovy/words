                ],
                "senses": [
                    {
                        "sense_id": "eeb65dbc-16e2-3083-bc45-80866e7a1bad",
                        "entry_id": "ab8dc6fc-063c-3c9d-9d01-b980791e65b7",
                        "glosses": [
                            "Lüfter, der die Luft axial (parallel zur Drehachse des Laufrades) ansaugt und auch axial ausbläst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea990f5-680a-4037-b2dd-6753192fe658",
                                "sense_id": "eeb65dbc-16e2-3083-bc45-80866e7a1bad",
                                "text": "„Axiallüfter eignen sich für hohe Luftleistungen bei mittlerem Druckaufbau.“"
                            },
                            {
                                "example_id": "92c4d314-c313-4188-8e7a-6a8bbc7a64c2",
                                "sense_id": "eeb65dbc-16e2-3083-bc45-80866e7a1bad",
                                "text": "„Unsere Axiallüfter und Gebläse sind qualitativ hochwertige Produkte.“"
                            },
                            {
                                "example_id": "88448e4a-03e7-48d9-8bb9-91b1beda8e3a",
                                "sense_id": "eeb65dbc-16e2-3083-bc45-80866e7a1bad",
                                "text": "„Ein Erhöhen der Luftgeschwindigkeit in großen Raumvolumina durch einen Axiallüfter und einer gleichzeitigen Verwendung eines Entfeuchters kann das Trocknen von Wänden, Dächern und Fußböden erheblich beschleunigen.“"
                            },
                            {
                                "example_id": "96314c62-7e69-4a63-8060-dd721ffc3df2",
                                "sense_id": "eeb65dbc-16e2-3083-bc45-80866e7a1bad",
                                "text": "„Immer dann, wenn ein effizienter Axiallüfter in einer Lager- und/oder Produktionshalle sowie in einer kleineren Werkstatt zum Einsatz kommen soll, präsentieren wir Ihnen die passende Lösung.“"
                            },
                            {
                                "example_id": "f7f045a2-b2dc-4ae5-89e1-fa418806d2ba",
                                "sense_id": "eeb65dbc-16e2-3083-bc45-80866e7a1bad",
                                "text": "„Wir verwenden nur vollständig abgedeckte Axiallüfter für unsere dreistufigen, luftgekühlten Kompressoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
