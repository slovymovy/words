                                ]
                            },
                            {
                                "target_word": "platoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e525d8-e0a4-335d-9b46-bb60e98d22f5",
                                        "entry_id": "b9dad8bd-0880-307b-95ff-eb7dabbb73ce",
                                        "glosses": [
                                            "To alternate starts with a teammate of opposite handedness, depending on the handedness of the opposing pitcher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35dd487a-2633-47f3-8271-c946af5c3c54",
                                                "sense_id": "f5e525d8-e0a4-335d-9b46-bb60e98d22f5",
                                                "text": "Taylor has been hitting poorly against left-handers, and Morgan has been hitting poorly against right-handers, so they will platoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c977b715-fc2d-3626-8191-aa06233421b6",
                                        "entry_id": "b9dad8bd-0880-307b-95ff-eb7dabbb73ce",
                                        "glosses": [
                                            "To specialize in a particular position or playing style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "049613ef-5c9c-463b-b992-bacc674081be",
                                                "sense_id": "c977b715-fc2d-3626-8191-aa06233421b6",
                                                "text": "You must understand the rules of football in 1939. There was no platooning, so each man played both offense and defense."
                                            }
                                        ]
                                    },
