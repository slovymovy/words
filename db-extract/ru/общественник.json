                    },
                    {
                        "translation_id": "eecd145b-b57b-4cc3-a650-ba51104ab242",
                        "source_entry_id": "5848e79d-4adf-31f8-9dce-774c6d6c3e8e",
                        "target_lang_word": "volontaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volontaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cedb3e3-cda0-3c20-bbca-a40bd01335cf",
                                        "entry_id": "f381583d-e390-3499-8b3c-f1b4e812aeb0",
                                        "glosses": [
                                            "Qui se fait sans contrainte, de pure volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0048c22-8a47-4d6e-ba71-b78efcb64797",
                                                "sense_id": "9cedb3e3-cda0-3c20-bbca-a40bd01335cf",
                                                "text": "Dans cette recherche, nous nous demandons comment expliquer et favoriser l’implication des sapeurs-pompiers volontaires (SPV) au sein des Services départementaux d’incendie et de secours (SDIS)."
                                            },
                                            {
                                                "example_id": "cf77dfec-ab9c-4cce-bea2-898e801b3e9c",
                                                "sense_id": "9cedb3e3-cda0-3c20-bbca-a40bd01335cf",
                                                "text": "L’embastillement sanitaire et épidémiologique peut pour autant nuire davantage que l’emmurement volontaire de l’abstraction créative ? Peut-il conduire à un esseulement frisant la déréliction ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e174ba57-bdaa-39f3-a472-2934ba22547e",
                                        "entry_id": "f381583d-e390-3499-8b3c-f1b4e812aeb0",
                                        "glosses": [
                                            "Qui a contracté un engagement dans l'armée de son plein gré dans l’année."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a02a097-e9a6-4fd4-b7db-fdf1eb022aaf",
                                                "sense_id": "e174ba57-bdaa-39f3-a472-2934ba22547e",
                                                "text": "Engagé volontaire."
                                            }
                                        ]
