                "senses": [
                    {
                        "sense_id": "6dcc9f45-0c61-3448-aa02-364bce75e478",
                        "entry_id": "4ced148f-695e-37bc-9782-51014532cb43",
                        "glosses": [
                            "филол. стихотворение или строфа в восемь стихов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f817a91-f4e4-44ee-a0af-961a3376f2eb",
                                "sense_id": "6dcc9f45-0c61-3448-aa02-364bce75e478",
                                "text": "В этом восьмистишии смешаны слова португальские, испанские и итальянские, причем все глаголы почему-то (надо полагать, смеху ради) поставлены в неопределенном наклонении."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64992a94-dccd-4f46-a32e-df90d4b48ee1",
                        "source_entry_id": "4ced148f-695e-37bc-9782-51014532cb43",
                        "source_sense_id": "6dcc9f45-0c61-3448-aa02-364bce75e478",
                        "target_lang_word": "octave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d402548-c3f0-3ab2-8e85-95f7354b8e52",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "An interval of twelve semitones spanning eight degrees of the diatonic scale, representing a doubling or halving in pitch frequency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c1b6ef-b681-4a30-9728-dd49fd3a26eb",
                                                "sense_id": "2d402548-c3f0-3ab2-8e85-95f7354b8e52",
                                                "text": "The melody jumps up an octave at the beginning, then later drops back down an octave."
                                            },
                                            {
                                                "example_id": "9247ea65-f260-4990-9ae2-807f09dae3da",
                                                "sense_id": "2d402548-c3f0-3ab2-8e85-95f7354b8e52",
                                                "text": "The singer was known for astounding clarity over her entire five-octave range."
                                            },
                                            {
                                                "example_id": "96f0a535-18b7-4077-b2e6-d6a367ea2ded",
                                                "sense_id": "2d402548-c3f0-3ab2-8e85-95f7354b8e52",
                                                "text": "The octave has a pitch ratio of 2:1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f042f07-9ea4-3e40-8543-61487196fb87",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "The pitch an octave higher than a given pitch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68391c4-ba9b-40fe-a51a-f88127a34f3c",
                                                "sense_id": "1f042f07-9ea4-3e40-8543-61487196fb87",
                                                "text": "The bass starts on a low E, and the tenor comes in on the octave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65c88135-3246-3969-8e6c-114cec71a2dd",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "A coupler on an organ which allows the organist to sound the note an octave above the note of the key pressed (cf sub-octave)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ff7fc54-4939-37d9-8971-e69c7cf7f985",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "A poetic stanza consisting of eight lines; usually used as one part of a sonnet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30eaf61-2434-499c-a553-70fc86449e6d",
                                                "sense_id": "1ff7fc54-4939-37d9-8971-e69c7cf7f985",
                                                "text": "With mournful melody it continued this octave.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10d8c09-0a08-3d5a-a348-66c08b88ca93",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "The eighth defensive position, with the sword hand held at waist height, and the tip of the sword out straight at knee level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1588775-915d-4942-b35c-d71ef1f8db66",
                                                "sense_id": "f10d8c09-0a08-3d5a-a348-66c08b88ca93",
                                                "text": "If they always do a lateral parry quarte, and never a semicircular octave, that gives you an opening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4481cb6a-b47f-375c-9164-0ae18e91fd5f",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "The day that is one week after a feast day in the Latin rite of the Catholic Church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440baf1d-f5c7-4c78-86e5-761d42904ceb",
                                                "sense_id": "4481cb6a-b47f-375c-9164-0ae18e91fd5f",
                                                "text": "[…] the Chamberlains' records of the companies' visits to their towns are, for the most part, not precisely dates, but merely group them together […] within their annual accounting period which normally […] ran from Michaelmas (29 September) to Michaelmas, or its octave (6 October)."
                                            },
                                            {
                                                "example_id": "5d1b3d91-9f4f-4c08-bc4b-833bb833704b",
                                                "sense_id": "4481cb6a-b47f-375c-9164-0ae18e91fd5f",
                                                "text": "It was extended to the entire Church by 1814, and then in 1913 the feast was transferred to September 15, the octave day of the Birth of Mary and the day after the Exaltation of the Cross."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1137c0c-d4cf-38e4-8f11-17a765d4e36e",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "An eight-day period beginning on a feast day in the Latin rite of the Catholic Church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c77ec14-ec6f-4bf4-9f5e-b3c4323664b3",
                                                "sense_id": "c1137c0c-d4cf-38e4-8f11-17a765d4e36e",
                                                "text": "1870, The Night Hours of the Church, trans. Rev. J. M. Neale\nOf an Octave the Office is said. or at least commemorated, (when any Sunday or Feast intervene), for eight successive days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2427385-092a-3bc3-adb9-f3f21ed07ddf",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "A small cask of wine, one eighth of a pipe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b72fe81-14d0-3f0a-8bea-475d06a53461",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "An octonion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e014b023-aad8-310c-912b-538eca3ded75",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "Any of a number of coherent-noise functions of differing frequency that are added together to form Perlin noise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "405eb427-4aa8-3bf6-89db-4d785c3b774e",
                                        "entry_id": "4c95f522-1b2c-317b-a87c-011ddc6a4ec8",
                                        "glosses": [
                                            "The subjective vibration of a planet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1441702-e217-4adc-b4d2-5ca01d9ef363",
                                                "sense_id": "405eb427-4aa8-3bf6-89db-4d785c3b774e",
                                                "text": "Mercury then joins its higher octave and generous counterpart Jupiter early next week, and it opens gates of opportunity."
                                            }
                                        ]
                                    }
                                ]
                            },
