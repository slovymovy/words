                "senses": [
                    {
                        "sense_id": "1def5b80-5709-3d03-bcc6-9f9fb0e8817c",
                        "entry_id": "3c18733e-bbe8-3b65-a5d5-df5d3d04b4f0",
                        "glosses": [
                            "The quality of being palmate."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0efddfd7-3143-4beb-9b21-866660bf0514",
                                "sense_id": "1def5b80-5709-3d03-bcc6-9f9fb0e8817c",
                                "text": "In these four antlers there is no trace of palmation, and apart from the elongated base there is nothing to distinguish them from the two-, three-, and four-tined stages of the antlers of other deer..."
                            },
                            {
                                "example_id": "fab764f3-8dba-478c-a302-3992b781d2d5",
                                "sense_id": "1def5b80-5709-3d03-bcc6-9f9fb0e8817c",
                                "text": "Fallow deer of trophy quality must develop palmation; there are herds where palmations are rare or non-existent."
                            },
                            {
                                "example_id": "6d106d89-ee45-4e22-bc38-3cf83fd4d3a3",
                                "sense_id": "1def5b80-5709-3d03-bcc6-9f9fb0e8817c",
                                "text": "If the axis of the brow palm is markedly curved, and also shows palmation at the tip, the width of the brow palm is taken at a right angle to the tip (figure 9-H)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b6f3f11-c25a-354e-a24a-885c964ef56c",
                        "entry_id": "3c18733e-bbe8-3b65-a5d5-df5d3d04b4f0",
                        "glosses": [
                            "A palmate structure."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "38c024b3-39b7-4536-951c-9a84dbe23aab",
                                "sense_id": "6b6f3f11-c25a-354e-a24a-885c964ef56c",
                                "text": "In the antlers of the moose, on the other hand, we find the following abnormality: the antlers may add extra points that reach down, below the palmations' edges."
                            },
                            {
                                "example_id": "c229139f-97b8-48c2-b635-be5a6875a615",
                                "sense_id": "6b6f3f11-c25a-354e-a24a-885c964ef56c",
                                "text": "Fallow deer of trophy quality must develop palmation; there are herds where palmations are rare or non-existent."
                            },
                            {
                                "example_id": "41fa6195-10b6-4962-8ab8-62799451f874",
                                "sense_id": "6b6f3f11-c25a-354e-a24a-885c964ef56c",
                                "text": "A specimen from Unit Vm (Fig. 6.19/7) consists of a large part of the palmation, which was wide and probably curved anteriorly as in Dama dama (the concave border of the left hand side of the photograph would then be the anterior border of the palmation)."
                            }
                        ]
                    }
