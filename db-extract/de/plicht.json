                ],
                "senses": [
                    {
                        "sense_id": "b1b36468-2d20-39c3-8023-95596477a829",
                        "entry_id": "e3ae7852-3b18-331f-bed4-26e0cd168555",
                        "glosses": [
                            "offener Bereich eines Segel-/Motorboots, in dem sich die Mannschaft normalerweise aufhält und aus dem es gesteuert wird"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "cf3a8970-0745-4d6b-9511-35d61ff68598",
                                "sense_id": "b1b36468-2d20-39c3-8023-95596477a829",
                                "text": "Niemals geht man, wenn man im Hafen im Päckchen liegt, durch die Plichten zur Mole, sondern immer über die Vordecks."
                            },
                            {
                                "example_id": "f1865089-9bd3-467b-8c07-bedf9aea0b85",
                                "sense_id": "b1b36468-2d20-39c3-8023-95596477a829",
                                "text": "„Auf Jollen bezeichnet man den gesamten uneingedeckten Raum als Cockpit oder Plicht.“"
                            },
                            {
                                "example_id": "86741258-8c76-497d-b576-84ca254de365",
                                "sense_id": "b1b36468-2d20-39c3-8023-95596477a829",
                                "text": "„Ein weiteres Risiko ist Kaffeekochen bei Seegang. Wir beschließen mit dem heißen Wasser bei höheren Wellen nicht mehr im Schiff zu hantieren, sondern nur noch in der Plicht, wo man sich sicher hinsetzen kann.“"
                            },
                            {
                                "example_id": "8fb1bf1f-63d6-4753-a104-e7a1a3a99348",
                                "sense_id": "b1b36468-2d20-39c3-8023-95596477a829",
                                "text": "„Ich entscheide mich, eine Pause einzulegen um den Motor weiter abkühlen zu lassen. Mir tut es auch gut, in die Plicht zu kommen und frische Luft zu atmen.“"
                            },
                            {
                                "example_id": "34ec9aef-bc86-4ee1-a44a-54c4d0811f68",
                                "sense_id": "b1b36468-2d20-39c3-8023-95596477a829",
                                "text": "„Hein Garbers holt in der besten Stimmung des Tages seine „Quetschorgel“, das Schifferklavier, aus der Kajüte, setzt sich gemütlich in eine Ecke der Plicht und singt dazu.“"
                            },
                            {
                                "example_id": "e39a3f89-91fc-4f1f-a5ed-d7ba41d0380b",
                                "sense_id": "b1b36468-2d20-39c3-8023-95596477a829",
                                "text": "„Ich kann mich noch gut erinnern, dass wir […] im Nachtfahrverbot in die Scharfe Lanke einfuhren und kurz vor dem SpYC von der Wasserschutzpolizei aufgehalten wurden. Schnell verschwanden alle alkoholischen Getränke aus der Plicht, […] und wir konnten nach einer Ermahnung den Hafen anlaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
