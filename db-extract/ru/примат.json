                ],
                "senses": [
                    {
                        "sense_id": "8b98f287-6ea8-368f-8772-8c1a0a742ef5",
                        "entry_id": "b7a320b2-7093-3ca4-a796-c81aad242785",
                        "glosses": [
                            "зоол. представитель инфракласса плацентарных млекопитающих, обезьяна или человек (лат. Primates)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad94da73-0ed6-4a8d-9c61-6b6279d899e5",
                                "sense_id": "8b98f287-6ea8-368f-8772-8c1a0a742ef5",
                                "text": "В 1924 году учёные обнаружили скелет человекообразного примата, передвигавшегося на двух ногах."
                            },
                            {
                                "example_id": "920502d2-6d56-4c0a-b55c-d32279cd2a4b",
                                "sense_id": "8b98f287-6ea8-368f-8772-8c1a0a742ef5",
                                "text": "Любопытно, что приматы, например, бабуины (обезьяны рода павианов), содержат значительно меньше повторов CAGGG, чем люди."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebf20984-19ab-475e-89ab-936f0b0d8165",
                        "source_entry_id": "b7a320b2-7093-3ca4-a796-c81aad242785",
                        "source_sense_id": "8b98f287-6ea8-368f-8772-8c1a0a742ef5",
                        "target_lang_word": "primate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "primate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d77ab75f-5d52-336c-914c-5f5f93982fa9",
                                        "entry_id": "0f6b6408-f37b-32a0-b5c1-76d032c830ce",
                                        "glosses": [
                                            "A mammal of the order Primates, including apes (which include humans), monkeys, lemurs, tarsiers, lorisids, and galagos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38630e7a-4642-4bc6-b40d-c66dfb0113c4",
                                                "sense_id": "d77ab75f-5d52-336c-914c-5f5f93982fa9",
                                                "text": "Primates range from lemurs to gorillas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94dcf377-7fc9-368e-88fb-409132e85350",
                                        "entry_id": "0f6b6408-f37b-32a0-b5c1-76d032c830ce",
                                        "glosses": [
                                            "A simian anthropoid; an ape (including human) or monkey."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "primate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16a41e97-8e33-3562-9964-747fd4c5b61c",
                                        "entry_id": "2875b8ab-e82e-37d1-b4fb-3b24554e1d39",
                                        "glosses": [
                                            "In the Catholic Church, a rare title conferred to or claimed by the sees of certain archbishops, or the highest-ranking bishop of a present or historical, usually political circumscription."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da3a90d4-22c7-485b-a1a7-99639495a00c",
                                                "sense_id": "16a41e97-8e33-3562-9964-747fd4c5b61c",
                                                "text": "The Archbishop of Quebec is the primate of Canada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7331df3-802f-346d-93aa-ec9cc2789712",
                                        "entry_id": "2875b8ab-e82e-37d1-b4fb-3b24554e1d39",
                                        "glosses": [
                                            "In the Orthodox Church, the presiding bishop of an ecclesiastical jurisdiction or region. Usually, the expression primate refers to the first hierarch of an autocephalous or autonomous Orthodox church. Less often, it is used to refer to the ruling bishop of an archdiocese or diocese."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1b15a68-8ce5-3713-af89-01b9eb73bd57",
                                        "entry_id": "2875b8ab-e82e-37d1-b4fb-3b24554e1d39",
                                        "glosses": [
                                            "In the Anglican Church, an archbishop, or the highest-ranking bishop of an ecclesiastic province."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd386796-4d70-47f9-9593-d7d019f57b39",
                        "source_entry_id": "b7a320b2-7093-3ca4-a796-c81aad242785",
                        "source_sense_id": "8b98f287-6ea8-368f-8772-8c1a0a742ef5",
                        "target_lang_word": "Primat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Primat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3bd53c7-a854-30c3-a34a-49195ff60a71",
                                        "entry_id": "03fbd2fb-2285-3353-a56b-511042251517",
                                        "glosses": [
                                            "Ordnung der Säugetiere, zu der auch der Mensch gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9416542-9b0c-473a-8246-a658a1353849",
                                                "sense_id": "d3bd53c7-a854-30c3-a34a-49195ff60a71",
                                                "text": "Die Koboldmakis gehören zu den Primaten."
                                            },
                                            {
                                                "example_id": "288a526b-58ce-4ac5-adb8-f9dd96956ba2",
                                                "sense_id": "d3bd53c7-a854-30c3-a34a-49195ff60a71",
                                                "text": "Von der Gattung Homi, die den Primaten zugeteilt wird, überlebte nur der moderne Mensch."
                                            },
                                            {
                                                "example_id": "aa317206-1a00-4863-8245-fc139753b021",
                                                "sense_id": "d3bd53c7-a854-30c3-a34a-49195ff60a71",
                                                "text": "„Die neuere Systematik teilt die Primaten in vier Unterordnungen: Lemuroidea oder Lemuren, Galagoidea oder Buschbabys und Loris, Tarsioidea oder Gespenstmakis und Simiae oder Affen.“"
                                            },
                                            {
                                                "example_id": "90dc24f0-6ebe-4a7a-bcdd-4f89bf2802bf",
                                                "sense_id": "d3bd53c7-a854-30c3-a34a-49195ff60a71",
                                                "text": "„Die Menschen waren auf einmal keine Sonderanfertigung Gottes mehr, der sie nach seinem Bilde geformt hatte, sondern Tier unter Tieren, Primaten unter Primaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Primat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33c7cd44-32d1-357c-adcc-5278be55041d",
                                        "entry_id": "04e241aa-7e6a-369b-9bdb-64d4175c3cdc",
                                        "glosses": [
                                            "höchste Gewalt in der Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8c235b-a145-483c-a7ec-bb998a4eaa1d",
                                                "sense_id": "33c7cd44-32d1-357c-adcc-5278be55041d",
                                                "text": "das Primat des Papstes"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e36200e-98c3-3cd3-92a1-52c91d9c29d3",
                                        "entry_id": "04e241aa-7e6a-369b-9bdb-64d4175c3cdc",
                                        "glosses": [
                                            "Vorrang, bevorzugte Stellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d444fd29-d24d-480f-9e7d-43124f2e3e8b",
                                                "sense_id": "1e36200e-98c3-3cd3-92a1-52c91d9c29d3",
                                                "text": "Nach Erich Gutenberg herrscht in der funktionalen Organisation das „Primat der Planung“ den anderen Funktionen (Organisation, Personal, Führung, Kontrolle) vor."
                                            },
                                            {
                                                "example_id": "e0976643-6737-4f9e-80a0-b9b548f11b79",
                                                "sense_id": "1e36200e-98c3-3cd3-92a1-52c91d9c29d3",
                                                "text": "„Aus dem Primat der Politik ist der Vorrang einer staatenübergreifenden Finanzaristokratie geworden.“"
                                            },
                                            {
                                                "example_id": "6dfd39fc-409a-45c2-8f23-a5e282e517e3",
                                                "sense_id": "1e36200e-98c3-3cd3-92a1-52c91d9c29d3",
                                                "text": "„Zwar hatte in seiner Ästhetik immer die Phantasie das Primat.“"
                                            },
                                            {
                                                "example_id": "c70c921c-80d1-432f-bd52-5cdf82073e18",
                                                "sense_id": "1e36200e-98c3-3cd3-92a1-52c91d9c29d3",
                                                "text": "„Der Primat wurde synchronen Fragestellungen eingeräumt.“"
                                            },
                                            {
                                                "example_id": "4495f9c2-726a-4668-9699-1da63b5af5e7",
                                                "sense_id": "1e36200e-98c3-3cd3-92a1-52c91d9c29d3",
                                                "text": "„Diese schlichte Bemerkung über das Primat der Intuition hat noch weitere interessante Auswirkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
