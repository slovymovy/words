                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f316a333-5563-4867-9143-673773168901",
                        "entry_id": "759dc3a8-e1c9-3d0c-8f20-c0a5ca978ecf",
                        "tags": [
                            "plural"
                        ],
                        "form": "éons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc5391f6-41b8-3df3-acc6-99b4a0e0ca34",
                        "entry_id": "759dc3a8-e1c9-3d0c-8f20-c0a5ca978ecf",
                        "glosses": [
                            "Plus grande unité de période de temps de l’échelle géologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d0306f-fdaa-40db-8540-f33751989226",
                                "sense_id": "fc5391f6-41b8-3df3-acc6-99b4a0e0ca34",
                                "text": "L’éon du Phanérozoïque commence en concomitance des premières traces animales fossiles."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e9d68bc-5931-3dc9-9918-37a014f1e08e",
                        "entry_id": "759dc3a8-e1c9-3d0c-8f20-c0a5ca978ecf",
                        "glosses": [
                            "Entité éternelle et abstraite imaginée par les gnostiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4623076-7daf-4856-b78a-04bc91948dde",
                                "sense_id": "1e9d68bc-5931-3dc9-9918-37a014f1e08e",
                                "text": "[…] Ptolémée, qui distingua les noms et le nombre des éons en substances personnelles, mais déterminées hors de Dieu, tandis que Valentin les avait renfermées dans l’essence de la divinité, sous le titre de sentiments, d’affections et de mouvements."
                            },
                            {
                                "example_id": "a96de433-47ed-4cf9-8cfe-e18df22532c4",
                                "sense_id": "1e9d68bc-5931-3dc9-9918-37a014f1e08e",
                                "text": "Il n’aurait jamais le pied marin : ses grands pieds n’avaient jamais été à leur place à bord, ils s’y trouvaient par accident tandis que l’homme, à l’intérieur, priait en attendant de rencontrer ses éons."
                            },
                            {
                                "example_id": "0b86c048-97c1-49b3-9422-44e8390dc013",
                                "sense_id": "1e9d68bc-5931-3dc9-9918-37a014f1e08e",
                                "text": "N’est pas mort pour toujours qui dort dans l’éternel,\nMais d’étranges éons rendent la mort mortelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c42b316-497e-401a-a4b5-379dfbcead0d",
                        "source_entry_id": "759dc3a8-e1c9-3d0c-8f20-c0a5ca978ecf",
                        "source_sense_description": "Période géologique",
                        "target_lang_word": "Äon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63d1bf0c-025d-3109-bb14-5b04566b8285",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "Erdzeitalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447d31fe-5d7c-46e1-a587-89bffbbfff82",
                                                "sense_id": "63d1bf0c-025d-3109-bb14-5b04566b8285",
                                                "text": "Das Hadaikum ist der erste Äon in der Geologie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "sehr langer, nach menschlichem Ermessen unüberschaubarer, unendlich erscheinender Zeitraum"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63191cee-00ab-4f7d-9e74-7c0154b051f5",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Moor: Nein, nicht erschlagen! das Wort ist Beschönigung! - der Sohn hat den Vater tausendmal gerädert, gespießt, gefoltert, geschunden! die Worte sind mir zu menschlich - worüber die Sünde roth wird, worüber der Kannibale schaudert, worauf seit Äonen kein Teufel gekommen ist.“"
                                            },
                                            {
                                                "example_id": "f98ae1bc-a8f6-4b2a-bfe5-74310b6d7515",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Äonen, nachdem die Sonne zur roten Riesin geworden ist, werden im Sternennebel noch immer verstreute Funksignale aufgefangen.“"
                                            },
                                            {
                                                "example_id": "6aa6f460-b878-4170-ac80-726ca595e12d",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Als Jäger und Sammler hat sich der Mensch einst in Afrika entwickelt, und so hat er dort auch über Äonen gelebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "Zeitabschnitt der Weltgeschichte, Zeitalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4d7aa1-35f9-48c1-aea4-52f76364e32a",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„Der Kalte Krieg hatte lange genug gedauert, um damals beiden Seiten seine Vergeblichkeit zu beweisen. Ein neuer Äon kündigte sich an. Fantasien vom Ende der Geschichte versprachen ein Goldenes Zeitalter.“"
                                            },
                                            {
                                                "example_id": "3ca974b8-1ce2-4ba4-8ae7-9fa758adadfb",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„Jetzt, im mandarinen Äon, glauben die Menschen nur noch an die Kaufkraft.“"
                                            },
                                            {
                                                "example_id": "766c89a3-0ff4-4174-a4ff-bc051e9bf505",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„So trächtig schwärmten die Gedanken, daß sich die Menschen einbildeten, in der überstürzten Spanne von Jahrzehnten die Entwicklung eines Äons zu bewältigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6274ea29-d7a8-49a7-98c2-d18603d2957d",
                        "source_entry_id": "759dc3a8-e1c9-3d0c-8f20-c0a5ca978ecf",
