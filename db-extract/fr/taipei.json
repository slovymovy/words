                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "0a584161-d6aa-4dd5-87eb-c20d2a0791b3",
                                "sense_id": "ba4d673a-85f8-334a-b362-422192148f7a",
                                "text": "Washington défend régulièrement une meilleure représentation de Taipei dans les agences des Nations unies et les réunions internationales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51b3185d-3f9a-49b7-a5f4-0da46534becc",
                        "source_entry_id": "b38fb52e-9b2f-35c6-929e-ef7df5df422f",
                        "target_lang_word": "Taipeh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taipeh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51711ffd-640b-3381-83f7-988419d0ebcd",
                                        "entry_id": "8c65a35a-e495-3807-bc6b-0fb833a5094d",
                                        "glosses": [
                                            "Hauptstadt von Taiwan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f3f37fe-2cd0-4ee4-b3f9-028355b9d6fa",
                                                "sense_id": "51711ffd-640b-3381-83f7-988419d0ebcd",
                                                "text": "Sie ist in Taipeh geboren."
                                            },
                                            {
                                                "example_id": "70692b10-c631-4949-8825-81798251910e",
                                                "sense_id": "51711ffd-640b-3381-83f7-988419d0ebcd",
                                                "text": "„In Taiwans Hauptstadt Taipeh stürzten zahlreiche Gebäude ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caf17176-45be-442a-8701-0c1d588084a8",
                        "source_entry_id": "b38fb52e-9b2f-35c6-929e-ef7df5df422f",
                        "target_lang_word": "Taipei",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taipei",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                        "entry_id": "8dacc0cb-72cc-386f-b966-d1c371a2a4f9",
                                        "glosses": [
                                            "The capital city of and a special municipality of Taiwan, located in the northern part of the island of Taiwan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae42204-6e62-46a4-aa41-840621ca07f6",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "In 1885 Governor LIU determined to reconstruct Taipei and make it the temporary capital until, the railway having on its way to Taiwan reached the old town of Changhua, in about the middle of Formosa, he should build a city near that place and make it, under the name of Taiwan, the capital of the province of Taiwan."
                                            },
                                            {
                                                "example_id": "0898284b-50b9-4c26-a9da-c181531d8243",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "Radiotelephonic communications were established in November 1946 between Taipei and Canton, thus augmenting the line already existing between Taipei and Shanghai.\nThe Chinese National Aviation Corporation, which operated air service between Shanghai and Taipei three times a week, has added weekly air service between Foochow and Taipei. The Southwest Aviation Corp. is reportedly planning a Canton-Taipei air service, and damaged Japanese military transport aircraft have been under repair for use on this route."
                                            },
                                            {
                                                "example_id": "8d4fefd1-cae1-46eb-801b-03ba5ccd5391",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "The “Beautiful Island” wears a necklace of rails and new roads dangling from Taipei, such as the 17-mile MacArthur Expressway linking the capital to the seaport of Chilung. Taiwan has two other international seaports —recently opened Hualien, on the east coast, and Kaohsiung, facing the mainland a scant 200 miles away."
                                            },
                                            {
                                                "example_id": "550fb205-20f9-479b-a57a-ca8b5e39f639",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "In my bid for re-election as mayor of Taipei, I lost to Ma Ying-jeou, representing the Kuomintang (KMT), Taiwan's ruling party. Analysis of the election results revealed that the overwhelming majority of \"mainlanders\"² in Taipei cast their votes for Mr. Ma."
                                            },
                                            {
                                                "example_id": "47d17418-eab2-4ebd-80f0-6b842f55bcb5",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "Years later, when I was governor, I found myself in the same hotel with Nureyev in Taipei, Taiwan."
                                            },
                                            {
                                                "example_id": "5a7e0a00-c7fd-40b3-bf06-109c5932302c",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "We lived in the county of Taoyuan, in northern Taiwan, around twenty-five miles south of the capital of Taipei."
                                            },
                                            {
                                                "example_id": "cdebdf07-f5ed-45b5-b9c8-9bcb37f14f26",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "The California-based maker of health drinks aims to open its first outlet in Taipei as early as this summer, venturing into a highly fragmented market of mom-and-pop juice stores that have thrived for years."
                                            },
                                            {
                                                "example_id": "9878383b-298b-45d3-a961-5e371bbce0c8",
                                                "sense_id": "781aa46c-8e89-392b-a546-06f26ae13d68",
                                                "text": "The bipartisan group, which will meet with Taiwan President Tsai Ing-wen on Friday morning on their two-day visit, arrived at Taipei's downtown Songshan airport on a U.S. Air Force aircraft and were greeted by Taiwan Foreign Minister Joseph Wu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a21cdd3-7d48-3acb-878f-488afe514147",
                                        "entry_id": "8dacc0cb-72cc-386f-b966-d1c371a2a4f9",
                                        "glosses": [
                                            "A former county of Taiwan, which became New Taipei City."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b19859-5475-4607-af0d-b356354661f9",
                                                "sense_id": "9a21cdd3-7d48-3acb-878f-488afe514147",
                                                "text": "A century ago, the cities of Taipei County were rustic faming societies made up of mostly aboriginal tribes. After the Nationalists retreated to Taiwan in 1949 the area met with a vast influx of Chinese immigrants, and during the 1950s and 1960s small manufacturing facilities began appearing. Taipei County has since become a Taiwanese melting pot of sorts as young people relocate from overseas and southern parts of the island for advanced schooling and settle in the area."
                                            },
                                            {
                                                "example_id": "93dd8f91-2ebf-4b2c-841f-367c2c7f783c",
                                                "sense_id": "9a21cdd3-7d48-3acb-878f-488afe514147",
                                                "text": "C is for Ceramics. C is for - Yingge? Well, not quite, but ‘Yingge is for ceramics’ is something almost any Taiwanese can chant. This little town in the very southern part of Taipei County lives by and for the production of high- and low-quality ceramic and pottery objects: everything from cupboard handles to Song-dynasty vases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63abe260-b07d-3ad8-85eb-01d01bbaaf3e",
                                        "entry_id": "8dacc0cb-72cc-386f-b966-d1c371a2a4f9",
                                        "glosses": [
                                            "The government of the Republic of China (Taiwan)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99656f16-f7f9-4b82-8a13-d0e4d019fe15",
                                                "sense_id": "63abe260-b07d-3ad8-85eb-01d01bbaaf3e",
                                                "text": "In the Shanghai Communiqué of 1972, we recognized the fact that both Beijing and Taipei viewed Taiwan as part of China but unequivocally expressed our support for a peaceful settlement of the unification issue. While we should not alter the fundamental pillars of our policy, we should consider certain steps that will raise Taiwan's international standing."
                                            },
                                            {
                                                "example_id": "fa827764-7335-4135-8ccb-c0f0b4518516",
                                                "sense_id": "63abe260-b07d-3ad8-85eb-01d01bbaaf3e",
                                                "text": "1993 The first official governmental contacts between Taipei and Beijing take place in Singapore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
