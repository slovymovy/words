                "translations": [
                    {
                        "translation_id": "66031493-3594-48a5-8c95-622cd6133c65",
                        "source_entry_id": "ef79f0ca-035b-3a5a-af98-7a2bbfc7dade",
                        "source_sense_id": "85ed64db-75fc-3026-8f89-acb17de170c6",
                        "target_lang_word": "characterization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
