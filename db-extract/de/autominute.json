                "senses": [
                    {
                        "sense_id": "59c4f604-eee5-3bba-b9c6-18d25978d3e1",
                        "entry_id": "38ef7ff9-986c-370c-9334-cab87fbe4c90",
                        "glosses": [
                            "Strecke, die ein Auto in einer Minute zurücklegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a9e4150-ed75-475a-b5b1-665a2e297d9e",
                                "sense_id": "59c4f604-eee5-3bba-b9c6-18d25978d3e1",
                                "text": "Das Restaurant ist acht Autominuten entfernt."
                            },
                            {
                                "example_id": "90ffee0d-b048-4249-80d6-a499bd2563e8",
                                "sense_id": "59c4f604-eee5-3bba-b9c6-18d25978d3e1",
                                "text": "„Doch auf dem Land der Schwarzen, das nur zwanzig Autominuten entfernt liegt, ist der Boden durch jahrelange Überbeanspruchung und Überweidung ausgelaugt.“"
                            },
                            {
                                "example_id": "c082a1d6-29b1-4714-8c8a-e222bd6e66ea",
                                "sense_id": "59c4f604-eee5-3bba-b9c6-18d25978d3e1",
                                "text": "„Nur 15 Autominuten von der Universität Tel Aviv entfernt liegt das Dorf Kfar Qassim, wo am 29. Oktober 1956 israelische Truppen 49 Einwohner auf dem Heimweg von den Feldern ermordeten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
