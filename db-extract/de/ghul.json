                                "target_senses": [
                                    {
                                        "sense_id": "1e9391d3-a990-38dd-91c5-f503a57db9f6",
                                        "entry_id": "879321c9-f144-36e0-bbef-1a34651dc6bb",
                                        "glosses": [
                                            "Archaic form of ghoul."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb148680-eb67-436c-a5ad-0526389c2ac8",
                                                "sense_id": "1e9391d3-a990-38dd-91c5-f503a57db9f6",
                                                "text": "So now all sense re-stretching to the full,\nI felt the approach of this accursed hull, —\nLeviathan in size, with ghosts and gholes\nEmployed on board in torturing other souls: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ghole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea4be556-3649-3ae0-90f0-16e94696fb90",
                                        "entry_id": "08ba24b8-a614-3797-aa58-9f8fc8db5fce",
                                        "glosses": [
