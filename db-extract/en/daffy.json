            {
                "entry_id": "da7d3f3a-6d8e-3989-ab4c-5535f5b60f00",
                "word": "daffy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7fb0a30c-f294-3eed-80a1-0c8340d86e44",
                        "entry_id": "da7d3f3a-6d8e-3989-ab4c-5535f5b60f00",
                        "glosses": [
                            "Gin."
                        ],
                        "tags": [
                            "UK",
                            "dated",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aa2575a9-1a21-47a5-95c4-4838fceb2f55",
                                "sense_id": "7fb0a30c-f294-3eed-80a1-0c8340d86e44",
                                "text": "1837-39, Charles Dickens, Oliver Twist\n“Do you give the children Daffy, Mrs. Mann?” inquired Bumble, following with his eyes the interesting process of mixing."
                            },
                            {
                                "example_id": "af30e9d5-5662-4f68-ab3b-316616b0858b",
                                "sense_id": "7fb0a30c-f294-3eed-80a1-0c8340d86e44",
                                "text": "[…] he failed repeatedly until he took over his famous house in Haymarket, where for many years, surrounded by such admirers as Byron, Tom Moore and Hazlitt, he smoked his yard of clay, drained his glass of 'daffy', and […]"
                            },
                            {
                                "example_id": "68aa8ef6-1ad5-4185-b681-32293d091f68",
                                "sense_id": "7fb0a30c-f294-3eed-80a1-0c8340d86e44",
                                "text": "Within Castle Tavern, at Holborn, Charles Perth and Lord Lucan were drowning their disparate sorrows in a glass of daffy."
                            }
                        ]
                    }
                ],
