                                "target_senses": [
                                    {
                                        "sense_id": "52597020-4119-3abc-b684-caf24fb54dbe",
                                        "entry_id": "6aa5c205-943c-3e8a-8ccb-fe727a2f19dc",
                                        "glosses": [
                                            "Féminin singulier de arpenteur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e4b11a-3cf6-4412-aa80-70b9e8aabab5",
                                                "sense_id": "52597020-4119-3abc-b684-caf24fb54dbe",
                                                "text": "La pieuvre nage ; elle marche aussi. Elle est un peu poisson, ce qui ne l’empêche pas d’être un peu reptile. Elle rampe sur le fond de la mer. En marche elle utilise ses huit pattes. Elle se traîne à la façon de la chenille arpenteuse."
                                            }
                                        ]
