                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "46dd8bfb-ade0-421b-9f9e-a9e82a301530",
                        "entry_id": "4c93c912-a4bb-3357-a1bf-ae92cdf5c98c",
                        "tags": [
                            "plural"
                        ],
                        "form": "navrements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "780d0b0e-2d40-3481-a8f2-b295585dbaf9",
                        "entry_id": "4c93c912-a4bb-3357-a1bf-ae92cdf5c98c",
                        "glosses": [
                            "Tristesse, chagrin, état de dépression morale causé par quelque événement fâcheux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6412ac4-426e-4adc-a759-2620186cb399",
                                "sense_id": "780d0b0e-2d40-3481-a8f2-b295585dbaf9",
                                "text": "La mort déjà avait appesanti son horrible griffe sur ces visages émaciés, ces dos décharnés, ces membres qui pendaient, vidés de sang et de moelle. Et, en présence de ce navrement, oubliant mes propres souffrances, je m’attendris."
                            },
                            {
                                "example_id": "46d3bc69-d227-480f-b9fc-56a7df8e66f4",
                                "sense_id": "780d0b0e-2d40-3481-a8f2-b295585dbaf9",
                                "text": "Malgré l'air de navrement qu'elle avait pris, une joie luisait au fond de ses yeux étincelants."
                            },
                            {
                                "example_id": "bbdb66a6-7020-49db-ae3e-c621a2d3c236",
                                "sense_id": "780d0b0e-2d40-3481-a8f2-b295585dbaf9",
                                "text": "Il en est de ces oublis comme des fautes qu’on se remémore, avec navrement, aux sorties du concours général ou du concours pour l’internat des hôpitaux."
                            },
                            {
                                "example_id": "f6cdcd75-2a9b-4780-8c6e-556aae905bb7",
                                "sense_id": "780d0b0e-2d40-3481-a8f2-b295585dbaf9",
                                "text": "La mère Cœuret hoche la tête en silence, puis un sourire accentue le navrement de son visage."
                            },
                            {
                                "example_id": "01c6d122-1546-47a7-bad6-1903e3a7f55d",
                                "sense_id": "780d0b0e-2d40-3481-a8f2-b295585dbaf9",
                                "text": "[…] Les morts à voix basse du sida et ses survivants consumés nous entouraient. Nous étions dans le navrement."
                            }
                        ]
                    }
                ],
