                                    {
                                        "sense_id": "97900a30-c5b1-39ee-8d66-465371990818",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A diacritical mark ⟨˜⟩ placed above a letter to modify its pronunciation.",
                                            "In Spanish, ⟨ñ⟩ is a palatalized ⟨n⟩, for example in ⟨cañón⟩."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a119a038-9598-4f24-a63c-d09d155d3dd8",
                                                "sense_id": "97900a30-c5b1-39ee-8d66-465371990818",
                                                "text": "California, like several other states, prohibits the use of diacritical marks or accents on official documents. That means no tilde (~), no accent grave (`), no umlaut (¨) and certainly no cedilla (¸)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c4e6c03-3130-3728-80ea-0caa1c52bf21",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A diacritical mark ⟨˜⟩ placed above a letter to modify its pronunciation.",
                                            "In Portuguese, ⟨ã⟩ and ⟨õ⟩ are nasalized vowels, for example in ⟨canção⟩."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "262395d5-6dc9-435b-9530-bd5e265b239e",
                                                "sense_id": "1c4e6c03-3130-3728-80ea-0caa1c52bf21",
                                                "text": "The tilde was used similarly in Portuguese on vowels to show that the letter bearing the tilde should be pronounced nasally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464d3e56-4dbf-383a-8988-4644d7794edf",
                                        "entry_id": "e2e16492-6f24-3ddf-bc9e-144c3ffa9a90",
                                        "glosses": [
                                            "A diacritical mark ⟨˜⟩ placed above a letter to modify its pronunciation.",
                                            "Another name for the Vietnamese tone mark dấu ngã, which is placed above a vowel to indicate a creaky rising tone (thanh ngã)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
