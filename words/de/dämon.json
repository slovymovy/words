                    "frequency": "Middle",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Damals glaubte man wirklich, das Kind sei von einem bösen <w>Dämon</w> besessen."
                        },
                        {
                            "text": "In vielen alten Geschichten bekämpfen mutige Helden gefährliche <w>Dämonen</w> der Unterwelt."
                        }
                    ],
                    "synonyms": [
