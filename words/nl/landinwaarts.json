            "senses": [
                {
                    "sense_id": "4000c3a0-9b87-35ca-8abb-e7501c9e09f2",
                    "sense_definition": "gericht naar of gelegen in het binnenland, vanaf de kust gezien",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoewel deze provincie aan zee ligt, ligt de stad zelf enkele kilometers <w>landinwaarts</w>.",
                            "target_lang_translations": {
                                "en": "Although this province is by the sea, the city itself lies a few kilometers <w>inland</w>."
                            }
                        },
                        {
                            "text": "De <w>landinwaartse</w> wind bracht warme lucht met zich mee.",
                            "target_lang_translations": {
                                "en": "The <w>landward</w> wind brought warm air with it."
                            }
                        }
                    ],
                    "synonyms": [
