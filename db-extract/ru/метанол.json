                        "sense_id": "14750311-c214-3616-8474-46d4259fa706",
                        "entry_id": "8a786ce3-30d6-3ade-8ca1-661df0d17c3f",
                        "glosses": [
                            "хим. простейший одноатомный спирт, бесцветная ядовитая жидкость, CH₃OH"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc44b1ba-e0f1-4603-8a54-fcf402634a0b",
                                "sense_id": "14750311-c214-3616-8474-46d4259fa706",
                                "text": "Метанол является удобным энергоносителем, который можно использовать в качестве моторного, котельного и газотурбинного топлива, как источник водорода для топливных элементов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a20f55b-ebfd-4433-a2ac-6e41681b0816",
                        "source_entry_id": "8a786ce3-30d6-3ade-8ca1-661df0d17c3f",
                        "source_sense_id": "14750311-c214-3616-8474-46d4259fa706",
                        "target_lang_word": "methanol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "methanol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a00383-b4c9-33f0-a8f2-27a4eaf55f44",
                                        "entry_id": "e9cb85f6-00dc-3dbd-a087-635306ec250b",
                                        "glosses": [
                                            "The simplest aliphatic alcohol, CH₃OH; a colourless, toxic, inflammable liquid, used as a solvent, antifreeze, in the chemical industry, and in the preparation of methylated spirit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c888b70-d0c8-448e-bbc5-5c4fc7c6b6c7",
                                                "sense_id": "c8a00383-b4c9-33f0-a8f2-27a4eaf55f44",
                                                "text": "Eight staff members of a backpacker hostel in Laos have been detained by local authorities as they investigate the deaths of six foreign tourists from suspected methanol poisoning, according to state-affiliated media in the Southeast Asian country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fcee567-5e62-4d48-8f51-69483bd5923a",
                        "source_entry_id": "8a786ce3-30d6-3ade-8ca1-661df0d17c3f",
                        "source_sense_id": "14750311-c214-3616-8474-46d4259fa706",
                        "target_lang_word": "Methanol",
                        "target_lang_code": "de",
