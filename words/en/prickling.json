{
    "word_family": [
        "prickle",
        "prickly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "752e1973-44c7-3d62-8005-ade73de4974f",
                    "sense_definition": "A physical sensation of small, sharp stings or tingling on the skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>prickling</w> sensation on her neck as if someone were watching her.",
                            "target_lang_translations": {
                                "cs": "Na krku ucítila náhlé <w>brnění</w>, jako by ji někdo pozoroval."
                            }
                        },
                        {
                            "text": "The cold wind caused a sharp <w>prickling</w> on his face while he walked outside.",
                            "target_lang_translations": {
                                "cs": "Studený vítr jí při chůzi venku způsoboval ostré <w>bodání</w> v obličeji."
                            }
                        }
                    ],
                    "synonyms": [
                        "tingling",
                        "pins-and-needles"
                    ],
                    "common_phrases": [
                        "prickling sensation"
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzický vjem drobného, ostrého bodání nebo brnění na kůži."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "brnění",
                                "target_lang_sense_clarification": "pocit mravenčení nebo lehkého bodání na kůži"
                            },
                            {
                                "target_lang_word": "bodání",
                                "target_lang_sense_clarification": "pocit ostrých vjemů na kůži"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "938f4914-3873-394b-a472-302617d228bf",
                    "sense_definition": "The present participle and gerund of <w>prickle</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wool sweater was <w>prickling</w> against his sensitive skin all day.",
                            "target_lang_translations": {
                                "cs": "Vlněný svetr ho celý den <w>píchal</w> na citlivé kůži."
                            }
                        },
                        {
                            "text": "He kept <w>prickling</w> his finger on the sharp thorns of the rose bush.",
                            "target_lang_translations": {
                                "cs": "Neustále si <w>píchal</w> prst o ostré trny růžového keře."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa 'prickle' (píchat, bodat)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "píchající",
                                "target_lang_sense_clarification": "vlastnost něčeho, co způsobuje píchání"
                            },
                            {
                                "target_lang_word": "píchání",
                                "target_lang_sense_clarification": "činnost způsobování drobných vpichů"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}