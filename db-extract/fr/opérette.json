        "fr-extract.jsonl": [
            {
                "entry_id": "1dba36fb-f36f-3611-8d26-8ab36b0e5eef",
                "word": "opérette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "97cb51c0-3fb9-4b87-a718-e28e37b35a56",
                        "entry_id": "1dba36fb-f36f-3611-8d26-8ab36b0e5eef",
                        "tags": [
                            "plural"
                        ],
                        "form": "opérettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb32fdf9-0eeb-31d3-b6f6-cac0106d9a17",
                        "entry_id": "1dba36fb-f36f-3611-8d26-8ab36b0e5eef",
                        "glosses": [
                            "Composition dramatique dont l’action est gaie ou comique et la musique légère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb6a4304-b3c6-401e-ad66-392e1e68859d",
                                "sense_id": "fb32fdf9-0eeb-31d3-b6f6-cac0106d9a17",
                                "text": "Et, au moment où je sors, j’entends un refrain d’opérette s’échapper de la bouche en cœur de M. Caterna."
                            },
                            {
                                "example_id": "bd999589-8671-4a3d-a217-42503417b5e0",
                                "sense_id": "fb32fdf9-0eeb-31d3-b6f6-cac0106d9a17",
                                "text": "C’était la quatrième opérette de Jean-Jacques Brinès. Un spécialiste du succès et de la musique hispano-américaine."
                            },
                            {
                                "example_id": "e2e7eeab-95c4-4cae-b0a2-4f42ac69a06a",
                                "sense_id": "fb32fdf9-0eeb-31d3-b6f6-cac0106d9a17",
                                "text": "J’ai vu aussi Luis Mariano […] Beaucoup d’opérettes aussi, car maman était, est toujours, une « fana » d’opérettes et comme elle venait quelquefois avec nous…\nLe soir nous rentrions heureux, nous étions fatigués mais heureux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41f57c0e-23d0-49fa-9fc6-0b91779d54a3",
                        "source_entry_id": "1dba36fb-f36f-3611-8d26-8ab36b0e5eef",
                        "source_sense_id": "fb32fdf9-0eeb-31d3-b6f6-cac0106d9a17",
                        "target_lang_word": "Operette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Operette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70df068c-265f-382e-9cbb-56be3db2c9d3",
                                        "entry_id": "aec526b7-a560-3704-9449-f0af99512636",
                                        "glosses": [
                                            "Gattungsbezeichnung für leichte, unterhaltende Bühnenwerke mit Gesang, Dialogen und Tanzeinlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb6679f-9493-4347-a667-c5edfa92e3ad",
                                                "sense_id": "70df068c-265f-382e-9cbb-56be3db2c9d3",
                                                "text": "Die Operette ist ein musikalisches Bühnenwerk, das wohl aus dem Singspiel, nicht jedoch - wie man aus dem Namen schließen könnte - aus der Oper entstand."
                                            },
                                            {
                                                "example_id": "3a1ef667-e748-4504-bb3d-2d514658bf7b",
                                                "sense_id": "70df068c-265f-382e-9cbb-56be3db2c9d3",
                                                "text": "„Eine Oper war es nicht, auch nicht, was es im Ursprung gewesen war, eine Verspottung der Oper, es war, das einzig Ungefälschte daran, eine Operette.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56a7bacd-2b8e-3b69-888a-2034ef65c787",
                                        "entry_id": "aec526b7-a560-3704-9449-f0af99512636",
                                        "glosses": [
                                            "einzelnes Werk der Gattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5bc166d-68f9-4776-a97e-1937440747b6",
                                                "sense_id": "56a7bacd-2b8e-3b69-888a-2034ef65c787",
                                                "text": "„Die lustige Witwe“ ist eine bekannte Operette von Franz Lehár."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6569f6f0-31b9-37e2-ab17-1f0a79053a2d",
                                        "entry_id": "aec526b7-a560-3704-9449-f0af99512636",
                                        "glosses": [
                                            "Aufführung einer Operette"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f070ee-e799-4335-9a7a-4b732012bc14",
                                                "sense_id": "6569f6f0-31b9-37e2-ab17-1f0a79053a2d",
                                                "text": "Heute Abend gehen wir in die Operette."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
