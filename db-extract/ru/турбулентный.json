                                        "sense_id": "c6d5132c-3134-35b3-b70d-e8e6fb526d4b",
                                        "entry_id": "608ae88e-b480-31d4-b81d-8c534b3e8a61",
                                        "glosses": [
                                            "Violently disturbed or agitated; tempestuous, tumultuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f820017-7318-4c0c-bc6d-9a27766c79bc",
                                                "sense_id": "c6d5132c-3134-35b3-b70d-e8e6fb526d4b",
                                                "text": "It is dangerous to sail in turbulent seas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3756a3b-ea6c-362a-a6d7-3299a54af57c",
                                        "entry_id": "608ae88e-b480-31d4-b81d-8c534b3e8a61",
                                        "glosses": [
                                            "Being in, or causing, disturbance or unrest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5c55ea-da20-41d3-95c8-ddd08db0dbd2",
                                                "sense_id": "f3756a3b-ea6c-362a-a6d7-3299a54af57c",
                                                "text": "The mid-19th century was a turbulent time in American history."
                                            },
                                            {
                                                "example_id": "3fceab3c-632e-4f39-a5ca-1308abb0f5df",
                                                "sense_id": "f3756a3b-ea6c-362a-a6d7-3299a54af57c",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account. That is a very American position."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
