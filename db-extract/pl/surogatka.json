                        "cross_references": [
                            {
                                "target_word": "Leihmutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0890b2a-3220-31c1-a4e0-6445f14564ce",
                                        "entry_id": "8b96dd67-df2f-3ca8-88b6-8050242ed881",
                                        "glosses": [
                                            "Frau, die eine Schwangerschaft für andere übernimmt, die fremdgezeugte Embryos oder fremdbefruchtete Eizellen austrägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a588f0bb-7e51-4eac-b53a-d729c1c31096",
                                                "sense_id": "d0890b2a-3220-31c1-a4e0-6445f14564ce",
                                                "text": "Die Leihmutter wollte das fremde Kind nicht mehr hergeben."
                                            },
                                            {
                                                "example_id": "1f3e1313-69e6-4356-a246-f21cc0a4ccf0",
                                                "sense_id": "d0890b2a-3220-31c1-a4e0-6445f14564ce",
                                                "text": "„Leihmutterschaft ist in Österreich verboten, dennoch gibt es auch hierzulande Paare, die sich mittels Leihmutter ihren Kinderwunsch erfüllen.“"
                                            },
                                            {
                                                "example_id": "7bacc0bc-d688-45b9-83d2-0f77f0e1a1f3",
                                                "sense_id": "d0890b2a-3220-31c1-a4e0-6445f14564ce",
                                                "text": "„Geboren hatte ihn eine Leihmutter aus Laos, der der Embryo seiner bei einem Autounfall ums Leben gekommenen Eltern eingepflanzt worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
