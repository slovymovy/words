                                        "sense_id": "a6761b91-8b21-369e-861f-94538ed11a7c",
                                        "entry_id": "779f260e-dd66-3a61-a425-def0d12f8663",
                                        "glosses": [
                                            "To stay the same; to neither advance nor regress."
