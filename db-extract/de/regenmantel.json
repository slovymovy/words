                ],
                "senses": [
                    {
                        "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                        "entry_id": "8ca8b9dc-164e-33b2-aea7-b2535c945672",
                        "glosses": [
                            "wasserabweisendes, langes Kleidungsstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b5d33d-6285-4d1f-890c-7776f34f6bc9",
                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                "text": "Er trug einen gelben Regenmantel."
                            },
                            {
                                "example_id": "2e3cbd90-95f5-4c42-a786-5cab7e36ec5e",
                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                "text": "„Erst dann zog er seine Gummistiefel und seinen Regenmantel an.“"
                            },
                            {
                                "example_id": "2eb43e95-d063-4313-9f87-3acd311991c5",
                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                "text": "„Der für ihn bestimmte Regenmantel wurde zu groß gekauft, saß daher schlecht, sollte aber länger halten – bis er hineingewachsen sein würde.“"
                            },
                            {
                                "example_id": "c7d162fa-0675-4af7-b400-ebee759f91e9",
                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                "text": "„Dann stand ich auf und packte den Kerl am Kragen seines verdreckten Regenmantels.“"
                            },
                            {
                                "example_id": "1dd944a9-82e5-4f18-8080-e4af201ff0c9",
                                "sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                                "text": "„Als ich aussteige, steigt ein dicker Mann mit Regenmantel ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6224d2d0-c636-4d82-ae83-df714f698231",
                        "source_entry_id": "8ca8b9dc-164e-33b2-aea7-b2535c945672",
                        "source_sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                        "source_sense_description": "wasserabweisendes, langes Kleidungsstück",
                        "target_lang_word": "raincoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raincoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec31933-7291-38e2-8782-e5c586b26ef7",
                                        "entry_id": "4d57246d-6685-344a-a271-467a26596d97",
                                        "glosses": [
                                            "A waterproof coat to be worn in the rain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e66ecc-7f6a-4bc0-afe7-2567ae46f573",
                                                "sense_id": "6ec31933-7291-38e2-8782-e5c586b26ef7",
                                                "text": "After standing around in talk for a while, during which time Doris arrived with my hat and raincoat (left with her at the site) we made our way some two hundred strong, up the gracious stone stairway to the Hall of Christ Church, loaned by that College for the celebrationary lunch."
                                            },
                                            {
                                                "example_id": "8cf3af1b-f6ce-49ad-b2cb-7437ff3d73b7",
                                                "sense_id": "6ec31933-7291-38e2-8782-e5c586b26ef7",
                                                "text": "Speaking to a crowd of demonstrators, some of whom dressed in raincoats while others wore keffiyehs in solidarity with Palestinians amid Israel’s deadly war on Gaza, one demonstrator said: “Any president that has come to power has also let workers down.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206eadb4-6c06-3ccb-b924-017680199880",
                                        "entry_id": "4d57246d-6685-344a-a271-467a26596d97",
                                        "glosses": [
                                            "A condom."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f16b69f-2249-4155-881c-54ca31ab9699",
                                                "sense_id": "206eadb4-6c06-3ccb-b924-017680199880",
                                                "text": "Moe said he'll go first, I said I'll take next / Here, take this raincoat and practice safe sex!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "747b5925-8b28-43e1-bed9-1c57115e34d4",
                        "source_entry_id": "8ca8b9dc-164e-33b2-aea7-b2535c945672",
                        "source_sense_id": "d2b1c46b-4f1b-3254-9748-c15e2a00375d",
                        "source_sense_description": "wasserabweisendes, langes Kleidungsstück",
                        "target_lang_word": "imperméable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperméable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1906f6ff-61a6-3fef-ad89-d111af950ccc",
                                        "entry_id": "6eec743b-1904-3b7b-afe9-cb772c035231",
                                        "glosses": [
                                            "Qui ne se laisse point traverser, en parlant de certains matériaux."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fdf6564-d026-4153-9f7f-8b49372e4f63",
                                                "sense_id": "1906f6ff-61a6-3fef-ad89-d111af950ccc",
                                                "text": "Le sol y est compact, souvent imperméable, marécageux par endroits, d’où le caractère mésohygrophile de la flore […]"
                                            },
                                            {
                                                "example_id": "6622a2c0-eec9-436d-9217-fcec053010be",
                                                "sense_id": "1906f6ff-61a6-3fef-ad89-d111af950ccc",
                                                "text": "Le verre est perméable à la lumière et imperméable à l’eau. — Cette étoffe est imperméable à la pluie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0763846f-46e3-3e94-9d41-9a42265323ba",
                                        "entry_id": "6eec743b-1904-3b7b-afe9-cb772c035231",
                                        "glosses": [
                                            "Qui n'est pas atteint par les agressions extérieures."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51488a40-88b7-481a-aea2-57feb12abe68",
                                                "sense_id": "0763846f-46e3-3e94-9d41-9a42265323ba",
                                                "text": "Certes, elle conclut l’un d’entre eux avec un : « Il est temps de rendre le système plus imperméable aux manipulations partisanes »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8661dda9-74c2-3af9-9aad-aee78e687392",
                                        "entry_id": "6eec743b-1904-3b7b-afe9-cb772c035231",
                                        "glosses": [
                                            "Qualifie un cuir, une étoffe, etc., apprêtés de manière que l’eau ne saurait les traverser."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61261fbc-6f57-4c5a-811f-eb4a530c3a17",
                                                "sense_id": "8661dda9-74c2-3af9-9aad-aee78e687392",
                                                "text": "Drap, cuir imperméable. — Chaussure imperméable. — Manteau imperméable"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imperméable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c29839af-4d05-3c34-9c12-e167255737d6",
                                        "entry_id": "651e1567-bc03-3569-a49b-cf643f601316",
                                        "glosses": [
                                            "Vêtement utilisé pour se protéger de la pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
