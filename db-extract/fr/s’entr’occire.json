                ],
                "senses": [
                    {
                        "sense_id": "8ef7f9c3-7171-3c2a-af01-f89f89c465df",
                        "entry_id": "9da0f9fa-fac8-3ea7-a23a-8d3d70088bfc",
                        "glosses": [
                            "Se tuer mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9374f914-46e2-4b5c-84ee-07df77800850",
                                "sense_id": "8ef7f9c3-7171-3c2a-af01-f89f89c465df",
                                "text": "Il ne manque même pas, selon le violoniste, la lyre d’Orphée qui empêche tous ces vauriens de s’entr’occire."
                            },
                            {
                                "example_id": "1944f981-b91a-42b3-bec9-99bdc9b928e2",
                                "sense_id": "8ef7f9c3-7171-3c2a-af01-f89f89c465df",
                                "text": "Le plaisir d’user des armes les plus perfectionnées, de sentir en soi-même l’agrandissement de personnalité que comportent le meurtre et le triomphe, tout ce qui, des centaines de siècles plus tard, inspirera encore les civilisés et les fera s’entr’occire ; l’âme guerrière, enfin, vivait d’une vie audacieuse chez ces premiers fils du monde."
                            }
                        ]
                    }
                ],
