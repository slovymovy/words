                                        "sense_id": "d282bdc8-8952-3954-a335-7113bbc1c4bd",
                                        "entry_id": "5673ea6d-7cbc-341e-948f-51072d121104",
                                        "glosses": [
                                            "Quelque chose qui rappelle Arlequin ou son costume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33502e28-0176-4e37-b23e-1f4b7b7f6f1d",
                                                "sense_id": "d282bdc8-8952-3954-a335-7113bbc1c4bd",
                                                "text": "La mémé Lucie rapetasse la blouse de son homme. Ce n’est pas la première fois : bien malin qui, dans cette arlequinade, pourrait dire où sont le coutil ou le droguet d’origine."
                                            }
                                        ]
