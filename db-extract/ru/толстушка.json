                                                "sense_id": "14ca0027-818d-3947-8a60-40e50c17a93d",
                                                "text": "It's hardly surprising, when it has to support that enormous gut! Lose some weight, fatty!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c044630-438a-3226-b6f1-a75573594528",
                                        "entry_id": "bbdc22c8-80d9-3181-a0ad-21391c3be1b6",
