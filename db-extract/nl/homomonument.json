                        "sense_id": "ef9ed384-a0ba-3df6-9a8b-3de785e4723a",
                        "entry_id": "f78d50d4-dfaf-37e3-9fc9-cee3e8dcb81e",
                        "glosses": [
                            "naam van de herdenkingsplaats waar onderdrukte homofielen worden herdacht in Amsterdam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99d0f13-3546-47b6-86c1-2587b985e6e7",
                                "sense_id": "ef9ed384-a0ba-3df6-9a8b-3de785e4723a",
                                "text": "Duizenden mensen hebben in Amsterdam meegelopen in een demonstratieve mars van het Homomonument op de Westermarkt naar het Vondelpark. De Pride Walk was het begin van Pride Amsterdam, zoals de Gay Pride voortaan heet."
                            },
                            {
                                "example_id": "146361a6-6a65-425a-b6a0-82652a24d9fe",
                                "sense_id": "ef9ed384-a0ba-3df6-9a8b-3de785e4723a",
                                "text": "Aan het hoofd van de mars liepen bekende Nederlanders hand in hand, onder wie Frits Barend, Bart Chabot, Henny Huisman en Ellie Lust. Ook veel anderen liepen hand in hand van de Dam naar het Homomonument. Daar worden bloemen neergelegd."
                            }
                        ]
                    }
