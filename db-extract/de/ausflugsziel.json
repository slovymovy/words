                "senses": [
                    {
                        "sense_id": "713e284f-ff75-391f-913c-9159e0b4031b",
                        "entry_id": "14ec9bd4-9427-39be-ba95-6d17e26f5966",
                        "glosses": [
                            "Zielort eines Ausflugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd625e94-f5d9-4e2c-affa-95160c5977b8",
                                "sense_id": "713e284f-ff75-391f-913c-9159e0b4031b",
                                "text": "„Einige Zeit später, im Jahr 1884, wurde kurzzeitig das Projekt einer Pferdebahn von Wernigerode zum »Silbernen Mann«, einem damals beliebten Ausflugsziel unweit des heutigen »Bahnhofes Steinerne Renne« diskutiert, bald aber auch wieder verworfen.“"
                            },
                            {
                                "example_id": "726d8f24-c66e-41e4-8718-973197475e29",
                                "sense_id": "713e284f-ff75-391f-913c-9159e0b4031b",
                                "text": "„Das Fischerörtchen, in dem normalerweise Boote in verträumten, schilfgesäumten Buchten lagen, war für die Danziger noch im Sommer zuvor ein Ausflugsziel gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
