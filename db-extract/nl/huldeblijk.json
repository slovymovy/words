                                        "sense_id": "92fa72ab-9116-35c6-a3dd-39a660196a33",
                                        "entry_id": "0fcf650a-5f61-3647-a9af-a10d8d2b4eac",
                                        "glosses": [
                                            "An acknowledgment of gratitude, respect or admiration; an accompanying gift."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afdcaee8-ec5e-4f09-b75f-9d7a1c1830bf",
                                                "sense_id": "92fa72ab-9116-35c6-a3dd-39a660196a33",
                                                "text": "Please accept this as a tribute of our thanks."
                                            },
                                            {
                                                "example_id": "ca24fb14-3a8e-4098-b8d0-0f7bbb75c119",
                                                "sense_id": "92fa72ab-9116-35c6-a3dd-39a660196a33",
                                                "text": "the passing tribute of a sigh"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b552c77-e82c-3109-abfb-a92690c85c3d",
                                        "entry_id": "0fcf650a-5f61-3647-a9af-a10d8d2b4eac",
                                        "glosses": [
                                            "An acknowledgment of gratitude, respect or admiration; an accompanying gift.",
                                            "An homage made in a body of work to another work or creator."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da003b8a-f2af-4b83-93b7-4dc0b4a39a6e",
                                                "sense_id": "9b552c77-e82c-3109-abfb-a92690c85c3d",
                                                "text": "Did you catch the Up in Smoke tribute in that episode of That '70s Show?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5942a17a-7575-3424-8a81-accc25a39ea2",
                                        "entry_id": "0fcf650a-5f61-3647-a9af-a10d8d2b4eac",
                                        "glosses": [
                                            "A payment made by one nation to another in submission."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "305da565-ace3-4814-8783-b132a187c992",
                                                "sense_id": "5942a17a-7575-3424-8a81-accc25a39ea2",
                                                "text": "The Ancient Romans made their conquered countries pay tribute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81766413-a530-3397-89a0-3249f245e4c8",
                                        "entry_id": "0fcf650a-5f61-3647-a9af-a10d8d2b4eac",
                                        "glosses": [
                                            "Extortion; protection money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a018152-5fe4-399c-a93d-d524d77411f0",
                                        "entry_id": "0fcf650a-5f61-3647-a9af-a10d8d2b4eac",
                                        "glosses": [
                                            "A payment made by a feudal vassal to his lord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04bc4e74-3c73-31f1-90cb-1d64b51ea254",
                                        "entry_id": "0fcf650a-5f61-3647-a9af-a10d8d2b4eac",
                                        "glosses": [
                                            "A certain proportion of the mined ore, or of its value, given to the miner as payment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f782fc6-77ed-45b5-b043-012ab850b2f7",
                                                "sense_id": "04bc4e74-3c73-31f1-90cb-1d64b51ea254",
                                                "text": "The setting of a Copper Mine upon tribute , has this difference : the Tributor is at the sole expence of digging , raising , and dressing , all the Ore that can be made merchantable"
                                            },
                                            {
                                                "example_id": "77b41406-e997-4b10-8611-b0fe3f9b42c8",
                                                "sense_id": "04bc4e74-3c73-31f1-90cb-1d64b51ea254",
                                                "text": "1852-1866, Charles Tomlinson, Cyclopaedia of Useful Arts and Manufactures\nTut-work is also employed upon the lode itself, though from the advantages generally considered to arise from the tribute system […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31ca38cf-579e-3c03-b399-f3642a748d43",
                                        "entry_id": "0fcf650a-5f61-3647-a9af-a10d8d2b4eac",
                                        "glosses": [
