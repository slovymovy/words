                ],
                "senses": [
                    {
                        "sense_id": "42edeaef-c269-30ef-bffb-7e8e2f728cf7",
                        "entry_id": "4c9cfb9e-9296-3976-b34e-2957d2f7fd29",
                        "glosses": [
                            "книжн. договорной, соответствующий конвенции, определяемый конвенцией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b26f552-2d5f-42a4-b36f-44591c9c6951",
                                "sense_id": "42edeaef-c269-30ef-bffb-7e8e2f728cf7",
                                "text": "Представляется, что в объем данного понятия входят те установки, подходы, которые были выработаны Европейским судом вследствие толкования соответствующих конвенционных положений."
                            }
                        ]
                    },
                    {
                        "sense_id": "c88d6393-6b7a-3b51-a5ea-cbbd6d5c3bff",
                        "entry_id": "4c9cfb9e-9296-3976-b34e-2957d2f7fd29",
                        "glosses": [
                            "воен. неядерный (об оружии)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51627887-83f6-4dc6-9886-f536fe020a3e",
                        "source_entry_id": "4c9cfb9e-9296-3976-b34e-2957d2f7fd29",
                        "target_lang_word": "conventional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conventional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04f359f8-43ac-3c6c-9981-cea1f9e0a7c6",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Pertaining to a convention, as in following generally accepted principles, methods and behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f61e13a2-7876-466e-8e5a-756598dac2d9",
                                                "sense_id": "04f359f8-43ac-3c6c-9981-cea1f9e0a7c6",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Ordinary, commonplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4059d24-b149-418c-bc73-342050103d77",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "They wear conventional clothes, eat conventional food, and keep conventional hours."
                                            },
                                            {
                                                "example_id": "61f7b996-33f2-4f30-ab84-927de3fbdbc2",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "“You’re not conventional?” Isabel gravely asked. “I like the way you utter that word! No, I’m not conventional: I’m convention itself. You don’t understand that?”"
                                            },
                                            {
                                                "example_id": "faa486b6-2bfa-4598-9272-fc1202dd0451",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            },
                                            {
                                                "example_id": "4fde0e6b-ae51-4dcf-a006-5f8dc6fccbe9",
                                                "sense_id": "b3fa1937-d137-38e8-8567-914e4809d620",
                                                "text": "The history of our study of our solar system shows us clearly that accepted and conventional ideas are often wrong, and that fundamental insights can arise from the most unexpected sources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7301ffd9-f771-325c-864d-ed549d814dd1",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Banal, trite, hackneyed, unoriginal or clichéd."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c2d7a04-3dcb-3b76-a99d-927e5d9e7ad7",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Pertaining to a weapon which is not a weapon of mass destruction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9076386c-73b1-3dbb-b269-e466a5c0d3b5",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "Making use of synthetic fertilizers and pesticides."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8662857a-b76d-38b6-b954-8d48e04ea683",
                                        "entry_id": "2c2ec2a3-5926-38d2-84e5-677b7f97ea79",
                                        "glosses": [
                                            "In accordance with a bidding convention, as opposed to a natural bid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "conventional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9903e3-8294-3d1f-8be0-99a989cae217",
                                        "entry_id": "c9a465b0-f00f-34d3-a8fe-be9f529bf903",
                                        "glosses": [
                                            "A conventional gilt-edged security, a kind of bond paying the holder a fixed cash payment (or coupon) every six months until maturity, at which point the holder receives the final payment and the return of the principal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
