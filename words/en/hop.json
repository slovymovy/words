{
    "word_family": [
        "hopper",
        "hopscotch",
        "grasshopper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07241aed-1d75-36a1-b550-ce8eb3c0e91f",
                    "sense_definition": "To make a short jump, often on one foot or using both feet together.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_jump",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little bird <w>hopped</w> along the branch looking for food.",
                            "target_lang_translations": {
                                "ru": "Маленькая птичка <w>прыгала</w> по ветке в поисках еды.",
                                "zh": "小鸟一边寻找食物，一边在树枝上<w>跳跃</w>。"
                            }
                        },
                        {
                            "text": "She had to <w>hop</w> on one leg because she hurt her ankle.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>скакать</w> на одной ноге, потому что она повредила лодыжку.",
                                "zh": "因为脚踝受伤，她不得不<w>单脚跳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jump",
                        "leap"
                    ],
                    "common_phrases": [
                        "hop up and down",
                        "hop on one foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать короткий прыжок, часто на одной ноге или двумя ногами вместе.",
                        "zh": "指单脚或双脚同时进行的短距离跳跃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгать",
                                "target_lang_sense_clarification": "совершать прыжки"
                            },
                            {
                                "target_lang_word": "подпрыгивать",
                                "target_lang_sense_clarification": "делать небольшие прыжки на месте"
                            },
                            {
                                "target_lang_word": "скакать",
                                "target_lang_sense_clarification": "передвигаться прыжками, часто на одной ноге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "泛指跳的动作"
                            },
                            {
                                "target_lang_word": "单脚跳",
                                "target_lang_sense_clarification": "特指单脚跳跃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6db11d33-fe87-3123-afa4-2094a35fcbed",
                    "sense_definition": "To get onto a vehicle quickly, or to move somewhere quickly and casually.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>hop</w> on the next train to London.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>запрыгнуть</w> в следующий поезд до Лондона.",
                                "zh": "我得赶紧<w>跳上</w>下一班去伦敦的火车。"
                            }
                        },
                        {
                            "text": "Why don't you <w>hop</w> in the car so we can leave?",
                            "target_lang_translations": {
                                "ru": "Почему бы тебе не <w>запрыгнуть</w> в машину, чтобы мы могли ехать?",
                                "zh": "你快<w>钻进</w>车里，我们好出发。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hop in",
                        "hop on",
                        "hop off",
                        "hop over to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро сесть в транспортное средство или быстро отправиться куда-либо.",
                        "zh": "指快速登上交通工具，或快速、随意地前往某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрыгнуть",
                                "target_lang_sense_clarification": "быстро сесть в транспорт"
                            },
                            {
                                "target_lang_word": "вскочить",
                                "target_lang_sense_clarification": "быстро войти или забраться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳上",
                                "target_lang_sense_clarification": "快速登上交通工具"
                            },
                            {
                                "target_lang_word": "钻进",
                                "target_lang_sense_clarification": "快速进入车内"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d315e57-f2a9-3249-b3f0-6e88cd925c85",
                    "sense_definition": "To move repeatedly from one place or situation to another similar one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to island-<w>hop</w> throughout their summer vacation.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>путешествовать</w> с острова на остров во время летнего отпуска.",
                                "zh": "他们决定暑假期间在各个岛屿间<w>穿梭</w>旅行。"
                            }
                        },
                        {
                            "text": "We spent the whole night bar-<w>hopping</w> in the city center.",
                            "target_lang_translations": {
                                "ru": "Мы провели всю ночь, <w>ходя</w> по барам в центре города.",
                                "zh": "我们整晚都在市中心的酒吧间<w>穿梭</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "island hop",
                        "bar hop",
                        "job hop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно перемещаться из одного места или ситуации в другое подобное.",
                        "zh": "指在不同地点或情况之间频繁往返或转换。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемещаться",
                                "target_lang_sense_clarification": "двигаться между местами"
                            },
                            {
                                "target_lang_word": "перескакивать",
                                "target_lang_sense_clarification": "быстро менять места или темы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿梭",
                                "target_lang_sense_clarification": "在不同地点间往返"
                            },
                            {
                                "target_lang_word": "跳槽",
                                "target_lang_sense_clarification": "特指频繁更换工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f97562c-0339-355e-a714-893c01d523cd",
                    "sense_definition": "To be very busy or in a state of energetic activity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state_active",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden rush of customers kept the staff <w>hopping</w> all afternoon.",
                            "target_lang_translations": {
                                "ru": "Внезапный наплыв клиентов заставил персонал <w>бегать</w> весь день.",
                                "zh": "突如其来的顾客潮让员工整个下午都<w>忙得团团转</w>。"
                            }
                        },
                        {
                            "text": "We have to keep <w>hopping</w> if we want to finish this project on time.",
                            "target_lang_translations": {
                                "ru": "Нам нужно продолжать <w>шевелиться</w>, если мы хотим закончить этот проект вовремя.",
                                "zh": "如果我们想按时完成这个项目，就必须不停地<w>奔波</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep someone hopping"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть очень занятым или находиться в состоянии энергичной деятельности.",
                        "zh": "指非常忙碌或处于精力充沛的活动状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суетиться",
                                "target_lang_sense_clarification": "быть в хлопотах"
                            },
                            {
                                "target_lang_word": "бегать",
                                "target_lang_sense_clarification": "быть в постоянном движении от дел"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忙得团团转",
                                "target_lang_sense_clarification": "形容非常忙碌"
                            },
                            {
                                "target_lang_word": "奔波",
                                "target_lang_sense_clarification": "形容不停地忙碌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c193fd4-a74f-3c51-acf9-bcafbd63d63a",
                    "sense_definition": "To add hops to beer to flavor it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "brewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brewmaster <w>hopped</w> the beer generously to create a bitter taste.",
                            "target_lang_translations": {
                                "ru": "Пивовар щедро <w>добавил хмеля</w> в пиво, чтобы создать горький вкус.",
                                "zh": "酿酒师在啤酒中大量<w>加啤酒花</w>，以产生苦味。"
                            }
                        },
                        {
                            "text": "This ale is dry-<w>hopped</w> for extra aroma.",
                            "target_lang_translations": {
                                "ru": "Этот эль подвергся сухому <w>охмелению</w> для дополнительного аромата.",
                                "zh": "这款艾尔啤酒经过<w>干投啤酒花</w>处理，以增加香气。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "brewing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять хмель в пиво для придания вкуса.",
                        "zh": "在酿造啤酒时加入啤酒花以增加风味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добавлять хмель",
                                "target_lang_sense_clarification": "в пивоварении"
                            },
                            {
                                "target_lang_word": "охмелять",
                                "target_lang_sense_clarification": "насыщать хмелем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加啤酒花",
                                "target_lang_sense_clarification": "酿造工艺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed8db8bf-9050-3bd5-8432-a5d6335361a8",
                    "sense_definition": "A short jump, especially one made on one foot.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_jump",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With one big <w>hop</w>, the frog landed safely in the water.",
                            "target_lang_translations": {
                                "ru": "Сделав один большой <w>прыжок</w>, лягушка благополучно приземлилась в воду.",
                                "zh": "青蛙用力一<w>跳跃</w>，安全地落入水中。"
                            }
                        },
                        {
                            "text": "The child did a <w>hop</w>, skip, and a jump across the playground.",
                            "target_lang_translations": {
                                "ru": "Ребенок сделал <w>подскок</w>, скачок и прыжок через площадку.",
                                "zh": "孩子在操场上做了一个<w>单脚跳</w>、跨步和跳跃。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jump",
                        "leap",
                        "bound",
                        "spring"
                    ],
                    "common_phrases": [
                        "hop, skip, and a jump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий прыжок, особенно на одной ноге.",
                        "zh": "短距离的跳跃，尤指单脚跳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыжок",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "подскок",
                                "target_lang_sense_clarification": "маленький прыжок"
                            },
                            {
                                "target_lang_word": "скачок",
                                "target_lang_sense_clarification": "резкое движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "名词，跳的动作"
                            },
                            {
                                "target_lang_word": "单脚跳",
                                "target_lang_sense_clarification": "名词，单脚跳的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a74eabd-3809-3ea7-8328-cad6772709d8",
                    "sense_definition": "A climbing plant whose dried flowers are used to give a bitter flavor to beer; the dried flowers themselves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "brewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer grows <w>hops</w> to sell to local breweries.",
                            "target_lang_translations": {
                                "ru": "Фермер выращивает <w>хмель</w> для продажи местным пивоварням.",
                                "zh": "农夫种植<w>啤酒花</w>卖给当地的酿酒厂。"
                            }
                        },
                        {
                            "text": "This lager has a very distinct flavor of <w>hops</w>.",
                            "target_lang_translations": {
                                "ru": "У этого лагера очень отчетливый вкус <w>хмеля</w>.",
                                "zh": "这款拉格啤酒有非常独特的<w>啤酒花</w>风味。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вьющееся растение, сушеные шишки которого используются для придания пиву горького вкуса; сами эти шишки.",
                        "zh": "一种攀援植物，其干燥花序用于给啤酒增添苦味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хмель",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "啤酒花",
                                "target_lang_sense_clarification": "植物名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8e6c569-76db-3672-9872-a677d7e268ca",
                    "sense_definition": "A short journey or flight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement_travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is just a short <w>hop</w> from Paris to London by plane.",
                            "target_lang_translations": {
                                "ru": "Это всего лишь короткий <w>перелет</w> из Парижа в Лондон на самолете.",
                                "zh": "从巴黎到伦敦乘飞机只是一个<w>短途飞行</w>。"
                            }
                        },
                        {
                            "text": "We took a quick <w>hop</w> across the channel for the weekend.",
                            "target_lang_translations": {
                                "ru": "Мы совершили быструю <w>поездку</w> через пролив на выходные.",
                                "zh": "我们周末快速地跨过海峡进行了一次<w>短途旅行</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "short hop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое путешествие или перелет.",
                        "zh": "短途的旅行或飞行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перелет",
                                "target_lang_sense_clarification": "на самолете"
                            },
                            {
                                "target_lang_word": "короткая поездка",
                                "target_lang_sense_clarification": "путешествие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短途飞行",
                                "target_lang_sense_clarification": "指乘飞机的短途旅行"
                            },
                            {
                                "target_lang_word": "短途旅行",
                                "target_lang_sense_clarification": "泛指短途行程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c4c633a-cd5a-31e6-8fed-ede08fbcf17a",
                    "sense_definition": "A bounce of a ball, especially from the ground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball took a bad <w>hop</w> and hit the player in the chest.",
                            "target_lang_translations": {
                                "ru": "Мяч сделал неудачный <w>отскок</w> и ударил игрока в грудь.",
                                "zh": "球发生了一次不规则的<w>弹跳</w>，击中了球员的胸部。"
                            }
                        },
                        {
                            "text": "He fielded the grounder on the second <w>hop</w>.",
                            "target_lang_translations": {
                                "ru": "Он поймал катящийся мяч на втором <w>отскоке</w>.",
                                "zh": "他在球第二次<w>反弹</w>时接住了地滚球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bad hop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отскок мяча, особенно от земли.",
                        "zh": "球类运动中球的弹跳，尤指从地面弹起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отскок",
                                "target_lang_sense_clarification": "мяча"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹跳",
                                "target_lang_sense_clarification": "球的运动状态"
                            },
                            {
                                "target_lang_word": "反弹",
                                "target_lang_sense_clarification": "球触地后的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2746348e-d3bb-397b-a9ec-a90386225b5a",
                    "sense_definition": "One stage of a data packet's journey from one router to the next.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The signal has to make several <w>hops</w> before reaching the destination server.",
                            "target_lang_translations": {
                                "ru": "Сигнал должен сделать несколько <w>переходов</w> (хопов), прежде чем достигнет целевого сервера.",
                                "zh": "信号在到达目标服务器之前必须经过几次<w>跳转</w>。"
                            }
                        },
                        {
                            "text": "Network latency increased with each additional <w>hop</w>.",
                            "target_lang_translations": {
                                "ru": "Сетевая задержка увеличивалась с каждым дополнительным <w>хопом</w>.",
                                "zh": "网络延迟随着每一次额外的<w>跳数</w>而增加。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "next hop"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один этап пути пакета данных от одного маршрутизатора к другому.",
                        "zh": "数据包在网络中从一个路由器传输到下一个路由器的阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хоп",
                                "target_lang_sense_clarification": "компьютерный термин"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "между узлами сети"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳数",
                                "target_lang_sense_clarification": "网络传输阶段"
                            },
                            {
                                "target_lang_word": "跳转",
                                "target_lang_sense_clarification": "网络节点间的传输"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af68574e-7991-32fb-a419-134c2650f5bc",
                    "sense_definition": "An informal dance or party.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandparents met at a local <w>hop</w> in the 1950s.",
                            "target_lang_translations": {
                                "ru": "Мои бабушка и дедушка познакомились на местных <w>танцах</w> в 1950-х годах.",
                                "zh": "我的祖父母是在20世纪50年代当地的一场<w>舞会</w>上相识的。"
                            }
