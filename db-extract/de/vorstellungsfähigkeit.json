                "senses": [
                    {
                        "sense_id": "cc442d0d-ab30-3cbd-bf0b-b99efe63d4a4",
                        "entry_id": "c85b5669-15fa-30b0-8f0c-e141ca0aacde",
                        "glosses": [
                            "Fähigkeit, sich einen Gegenstand, eine Person oder eine Szene anschaulich und bildhaft vorzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68a6f01-1ff5-49b7-a480-d821c91bc3d1",
                                "sense_id": "cc442d0d-ab30-3cbd-bf0b-b99efe63d4a4",
                                "text": "„Zur Fantasie gehört auch die Vorstellungsfähigkeit.“"
                            },
                            {
                                "example_id": "7cf91f89-6f2c-4b96-b07c-27e6e32d20ba",
                                "sense_id": "cc442d0d-ab30-3cbd-bf0b-b99efe63d4a4",
                                "text": "„Die Wirkung eines Gegenstandes auf die Vorstellungsfähigkeit, so fern wir von demselben affiziert werden, ist Empfindung.“"
                            },
                            {
                                "example_id": "96fae87d-2a97-490f-b0c1-4fef23433d9c",
                                "sense_id": "cc442d0d-ab30-3cbd-bf0b-b99efe63d4a4",
                                "text": "„Die einzige Materie war die geistliche Materie der Vorstellungsfähigkeit Gottes, die Er in Seiner Allmacht nach Seinem Willen gebrauchte.“"
                            },
                            {
                                "example_id": "b1855c01-8b9e-4903-af61-9c47413771ad",
                                "sense_id": "cc442d0d-ab30-3cbd-bf0b-b99efe63d4a4",
                                "text": "„Die räumliche Vorstellungsfähigkeit beeinflußt unter anderem, wie gut und schnell Bilder verarbeitet werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
