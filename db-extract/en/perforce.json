                    {
                        "translation_id": "e1d715ba-3d7f-437b-ac54-681ba0f676d1",
                        "source_entry_id": "ad589e57-332c-3ad2-bca1-af2243be545d",
                        "source_sense_description": "by force",
                        "target_lang_word": "de juro",
                        "target_lang_code": "es",
