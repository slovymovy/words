                    {
                        "translation_id": "9e18d453-aec8-4b0d-93af-a5fe4c8fa83b",
                        "source_entry_id": "176ccd4d-5bba-38ce-ae57-59e733eaae22",
                        "source_sense_id": "61f3cf5e-3099-36f3-9629-54f8734f2e87",
                        "source_sense_description": "Licht, dessen Quelle von vorne auf jemand/etwas strahlt",
                        "target_lang_word": "contre-jour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contre-jour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78fea47f-53a9-3001-b455-7580c88e2217",
                                        "entry_id": "e3b61977-4557-33a9-bc62-5c256395a3e6",
                                        "glosses": [
                                            "Éclairage d’un objet qui reçoit la lumière du côté opposé à celui où se trouve l’observateur."
                                        ],
                                        "tags": [],
                                        "note": "On dit « à contre-jour » et plus rarement « en contre-jour »",
                                        "examples": [
                                            {
                                                "example_id": "283e027a-a44e-411e-8983-3048192e7c5c",
                                                "sense_id": "78fea47f-53a9-3001-b455-7580c88e2217",
                                                "text": "Un contre-jour se produit lorsque le sujet est placé devant une source de lumière. Cet éclairage fausse la mesure automatique de la lumière, assombrissant ainsi le sujet."
                                            },
                                            {
                                                "example_id": "53238c8e-bd6c-4d43-b583-54af7ce882a8",
                                                "sense_id": "78fea47f-53a9-3001-b455-7580c88e2217",
                                                "text": "Je regarde à contre-jour une branche chargée de fruits d’or comme dans une légende ancienne."
                                            },
                                            {
                                                "example_id": "d2d0f27a-e9e3-4262-81f5-1cc3fcbed71d",
                                                "sense_id": "78fea47f-53a9-3001-b455-7580c88e2217",
                                                "text": "Simultanément il vit se découper en contre-jour, dans l’encadrement de la fenêtre du coin cuisine, une silhouette massive et inquiétante."
                                            },
                                            {
                                                "example_id": "46e6678f-913f-4125-b0c5-dde63a942e5e",
                                                "sense_id": "78fea47f-53a9-3001-b455-7580c88e2217",
                                                "text": "Le contre-jour découpe sa silhouette athlétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95216bc7-fd8b-3318-9794-3573b8f4977d",
                                        "entry_id": "e3b61977-4557-33a9-bc62-5c256395a3e6",
                                        "glosses": [
                                            "Représentation avec cet effet de lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "464467a4-951e-4cbb-8ebb-b4ad02ada814",
                                                "sense_id": "95216bc7-fd8b-3318-9794-3573b8f4977d",
                                                "text": "Les contrejours de Rembrandt."
                                            },
                                            {
                                                "example_id": "971fefbe-1a2c-4f2f-a12e-f715a2d8de2e",
                                                "sense_id": "95216bc7-fd8b-3318-9794-3573b8f4977d",
                                                "text": "René Allenbach pouvait, dès lors, aborder les contre-jour dont l’écueil est précisément la brutalité d’opposition du clair-obscur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
