                ],
                "senses": [
                    {
                        "sense_id": "09b97604-7968-31b0-a637-cbb786b5c082",
                        "entry_id": "e89c15a7-0fef-34a0-a429-b1083c60684a",
                        "glosses": [
                            "Beamter im Ruhestand, der eine Pension bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab6b589-d0fb-444f-85f8-3bd097a3bd14",
                                "sense_id": "09b97604-7968-31b0-a637-cbb786b5c082",
                                "text": "„Die beiden Pensionäre kämpfen für die Opfer von Verbrechen und ihre Angehörigen.“"
                            },
                            {
                                "example_id": "41144e5f-4888-4515-820f-cfe5590be5a0",
                                "sense_id": "09b97604-7968-31b0-a637-cbb786b5c082",
                                "text": "„Ich bin nun allein auf diesem Boot, allein auf einer Kreuzfahrt, allein zwischen Rentnern und Pensionären.“"
                            }
                        ],
