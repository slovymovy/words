                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8986798a-63e6-4017-bc94-335e529b08db",
                                "sense_id": "80cb870f-4255-354f-9bae-030765a2e49c",
                                "text": "Я рабо́тал бы́стро, не остана́вливаясь, с криво́й ухмы́лкой на губа́х – когда́ надкры́лья на мое́й спине́ раскрыва́лись, мне уже́ не на́до бы́ло поды́скивать выраже́ния.",
                                "translation": "Victor Pelevin",
                                "english": "Victor Pelevin"
                            }
                        ]
                    }
