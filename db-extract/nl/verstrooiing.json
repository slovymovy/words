                                        "entry_id": "73ddf57e-9592-381c-9880-fff8bc9fefd2",
                                        "glosses": [
                                            "A small quantity of something being dispersed (at random points)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70de5518-282d-423d-be75-56e5b0fb823a",
                                                "sense_id": "c79e1dde-2f33-3f1a-8e95-454b876fd778",
                                                "text": "There will be a scattering of showers, with heavy rain in places."
                                            },
                                            {
                                                "example_id": "a6bccc20-89d3-4ba6-a9ff-a3b439407f66",
                                                "sense_id": "c79e1dde-2f33-3f1a-8e95-454b876fd778",
                                                "text": "Only a light scattering of flaws sticks out."
                                            },
                                            {
                                                "example_id": "615eab6f-51bd-4d06-bcfd-5e564ef83eaa",
                                                "sense_id": "c79e1dde-2f33-3f1a-8e95-454b876fd778",
                                                "text": "There was something distinctly low-key, even wilfully alienating about the band’s performance. A scattering of OK Computer tracks were interspersed with more abstract latterday material – the clatter of 15 Step and Myxamatosis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45ede22a-dae4-347a-b142-5001f260c373",
                                        "entry_id": "73ddf57e-9592-381c-9880-fff8bc9fefd2",
                                        "glosses": [
                                            "The total number of votes awarded to nonmajor or unlisted candidates."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a3f28a4-eb95-39bc-8900-27115137ec24",
                                        "entry_id": "73ddf57e-9592-381c-9880-fff8bc9fefd2",
                                        "glosses": [
                                            "The process whereby a beam of waves or particles is dispersed by collisions or similar interactions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
