                    {
                        "sense_id": "f46da71f-cd69-34c1-989b-fc8a57b4cc2b",
                        "entry_id": "0e12964f-833d-3e6c-b451-26fcedd43047",
                        "glosses": [
                            "Non conflictuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae07df1-e9cb-40f0-9004-ff368dff3947",
                                "sense_id": "f46da71f-cd69-34c1-989b-fc8a57b4cc2b",
                                "text": "Je rappellerai l’insistance de Grunberger à différencier le processus pulsionnel conflictuel et le narcissisme qui ne tend pas à décharger une tension, ce qui est le but de la pulsion, mais au contraire à maintenir un état élationnel, a-conflictuel et a-pulsionnel."
                            },
                            {
                                "example_id": "f83033c7-e96a-4b9b-ac2d-2effb129cba6",
                                "sense_id": "f46da71f-cd69-34c1-989b-fc8a57b4cc2b",
                                "text": "Les représentations de relations sont a-conflictuelles, éventuellement – et c’est un élément précieux – libidinalisées (« Y sont en train d’s’embrasser »)."
                            },
                            {
                                "example_id": "8392d56f-faa4-4b52-a7ff-ae032705c398",
                                "sense_id": "f46da71f-cd69-34c1-989b-fc8a57b4cc2b",
                                "text": "Le médecin du travail est conseiller tant du salarié que du chef d'entreprise; alerté soit par l’employeur soit par la salariée, il aurait pu faire une analyse de poste et donner des conseils ergonomiques, organisationnels, a-conflictuels, basés sur l’analyse du travail et non sur des conflits de personnes."
                            }
                        ]
                    }
