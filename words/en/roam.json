{
    "word_family": [
        "roamer",
        "roaming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8be1b83c-ea22-38b7-b9d3-dd5ce1927897",
                    "sense_definition": "To wander or travel freely and with no specific destination.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wander",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild horses love to <w>roam</w> freely across the vast grassy plains.",
                            "target_lang_translations": {
                                "ru": "Дикие лошади любят свободно <w>бродить</w> по бескрайним травянистым равнинам."
                            }
                        },
                        {
                            "text": "During my gap year, I decided to <w>roam</w> around Europe with just a backpack.",
                            "target_lang_translations": {
                                "ru": "Во время своего академического отпуска я решил <w>попутешествовать</w> по Европе с одним лишь рюкзаком."
                            }
                        }
                    ],
                    "synonyms": [
                        "wander"
                    ],
                    "common_phrases": [
                        "roam freely",
                        "roam around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободно бродить или путешествовать без определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "ходить без определенной цели"
                            },
                            {
                                "target_lang_word": "странствовать",
                                "target_lang_sense_clarification": "путешествовать по разным местам"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "странствовать, часто без постоянного дома"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bdab699-2122-3655-b98f-3ecbe27eddb5",
                    "sense_definition": "To range or wander over an area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wander",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gangs of teenagers <w>roamed</w> the streets looking for something to do.",
                            "target_lang_translations": {
                                "ru": "Банды подростков <w>бродили</w> по улицам в поисках занятия."
                            }
                        },
                        {
                            "text": "In ancient times, massive mammoths used to <w>roam</w> the earth.",
                            "target_lang_translations": {
                                "ru": "В древние времена по земле <w>бродили</w> огромные мамонты."
                            }
                        }
                    ],
                    "synonyms": [
                        "wander"
                    ],
                    "common_phrases": [
                        "roam the streets",
                        "roam the countryside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бродить или перемещаться по какой-либо территории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "перемещаться по улицам, окрестностям"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "бродить по территории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9673e045-db40-3d91-ab5f-cf8613b9ae0e",
                    "sense_definition": "To use a mobile network or service from different locations, especially outside of one's home country.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "telecommunications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mobile phone will automatically <w>roam</w> onto a local network when I cross the border.",
                            "target_lang_translations": {
                                "ru": "Мой мобильный телефон автоматически <w>переключится в роуминг</w> на местную сеть, когда я пересеку границу."
                            }
                        },
                        {
                            "text": "To avoid high charges, make sure your device does not <w>roam</w> while you are abroad.",
                            "target_lang_translations": {
                                "ru": "Чтобы избежать высоких расходов, убедитесь, что ваше устройство не <w>работает в роуминге</w>, пока вы находитесь за границей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roam on a network"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать мобильную сеть или услугу связи за пределами домашнего региона или страны (находиться в роуминге)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "находиться в роуминге",
                                "target_lang_sense_clarification": "о мобильной связи"
                            },
                            {
                                "target_lang_word": "роуминговать",
                                "target_lang_sense_clarification": "разговорное, о мобильном устройстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d403cfbc-e615-3d27-a841-121d374ca0cb",
                    "sense_definition": "To transmit or sync resources and settings between different locations or devices to allow comparable usage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "telecommunications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operating system allows users to <w>roam</w> profiles across multiple office computers.",
                            "target_lang_translations": {
                                "ru": "Операционная система позволяет пользователям <w>переносить</w> профили между несколькими офисными компьютерами."
                            }
                        },
                        {
                            "text": "It is highly convenient to <w>roam</w> settings between your laptop and desktop automatically.",
                            "target_lang_translations": {
                                "ru": "Очень удобно автоматически <w>синхронизировать</w> настройки между ноутбуком и настольным компьютером."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roam settings",
                        "roam profiles"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать или синхронизировать ресурсы и настройки между различными устройствами или местоположениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "о профилях или настройках"
                            },
                            {
                                "target_lang_word": "синхронизировать",
                                "target_lang_sense_clarification": "между устройствами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6f658c8-8a21-3af7-ac8c-c3ce1c0741a8",
                    "sense_definition": "The act of roaming; a wander or travel without a specific destination.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wander",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long <w>roam</w> through the forest, we finally found our way back to the cabin.",
                            "target_lang_translations": {
                                "ru": "После долгого <w>блуждания</w> по лесу мы наконец нашли дорогу обратно к хижине."
                            }
                        },
                        {
                            "text": "He enjoyed a quiet afternoon <w>roam</w> around the historic city center.",
                            "target_lang_translations": {
                                "ru": "Ему понравилась тихая дневная <w>прогулка</w> по историческому центру города."
                            }
                        }
                    ],
                    "synonyms": [
                        "wander"
                    ],
                    "common_phrases": [
                        "afternoon roam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогулка, странствие или блуждание без определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогулка",
                                "target_lang_sense_clarification": "пешая прогулка без спешки"
                            },
                            {
                                "target_lang_word": "блуждание",
                                "target_lang_sense_clarification": "хождение без цели"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}