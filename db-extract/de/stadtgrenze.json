                "senses": [
                    {
                        "sense_id": "80aaff89-a512-3ad1-bb8f-592264495027",
                        "entry_id": "8bf8feaa-7907-3080-ac4b-d8ad8d8eaab6",
                        "glosses": [
                            "territoriale Grenze einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eddeee3-5655-4e20-a672-a03e26d6b6b5",
                                "sense_id": "80aaff89-a512-3ad1-bb8f-592264495027",
                                "text": "„Sein Interesse hörte aber keineswegs an der Stadtgrenze auf.“"
                            },
                            {
                                "example_id": "db107cfd-8c04-4594-b551-45c4dca25a31",
                                "sense_id": "80aaff89-a512-3ad1-bb8f-592264495027",
                                "text": "„Der Zug hat die Stadtgrenze noch nicht erreicht, da lehne ich bereits an der Schulter meines Mannes und schlafe.“"
                            },
                            {
                                "example_id": "9d0cc893-6655-43d4-9c90-86dc61a4d746",
                                "sense_id": "80aaff89-a512-3ad1-bb8f-592264495027",
                                "text": "„In Hongkong muss man für eine eigene Grabstelle innerhalb der Stadtgrenzen mittlerweile umgerechnet 28000 Euro bezahlen.“"
                            },
                            {
                                "example_id": "2df7b716-0548-40b5-9d3d-7d97c4a2130f",
                                "sense_id": "80aaff89-a512-3ad1-bb8f-592264495027",
                                "text": "„An der Stadtgrenze von Paris verabschiedete ich mich von ihr und ging zu Fuß zu meinem Bruder, der an der Porte Saint-Denis wohnte.“"
                            },
                            {
                                "example_id": "67d7d8a2-9f62-4519-b412-0942e7441972",
                                "sense_id": "80aaff89-a512-3ad1-bb8f-592264495027",
                                "text": "„Die politischen Bewegungen waren keine Massenorganisationen, sondern rein urbane Institutionen, deren Einfluss kaum über die Stadtgrenze Kabuls hinausreichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
