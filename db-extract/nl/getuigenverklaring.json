                                "example_id": "2c3c7512-a97d-4965-b61b-00623e799892",
                                "sense_id": "2ad5613a-b621-3657-9ffd-6be0fa8ee056",
                                "text": "Volgens getuigenverklaringen was de ramp begonnen met een krachtige explosie midscheeps aan boord van de jager HMS Gôteborg."
                            },
                            {
                                "example_id": "cee1a224-0bff-4156-ba56-e3156fb42dc2",
                                "sense_id": "2ad5613a-b621-3657-9ffd-6be0fa8ee056",
                                "text": "Duitse aanklagers zeggen op basis van onderzoek en getuigenverklaringen dat Winterkorn al in 2015 afwist van het dieselschandaal."
                            }
                        ]
                    }
