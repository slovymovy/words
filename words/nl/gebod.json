{
    "word_family": [
        "gebieden",
        "gebied",
        "gebiedend",
        "verbod",
        "aanbod"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa693d9f-b854-3c46-979d-eccccb138417",
                    "sense_definition": "een dwingende opdracht of bevel die men moet opvolgen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opdracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten kregen het strikte <w>gebod</w> om hun post onder geen beding te verlaten.",
                            "target_lang_translations": {
                                "en": "The soldiers were given the strict <w>command</w> not to leave their post under any circumstances."
                            }
                        },
                        {
                            "text": "Het is een moreel <w>gebod</w> om mensen in nood te helpen wanneer dat mogelijk is.",
                            "target_lang_translations": {
                                "en": "It is a moral <w>imperative</w> to help people in need whenever possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevel",
                        "opdracht",
                        "dictaat"
                    ],
                    "antonyms": [
                        "verbod"
                    ],
                    "common_phrases": [
                        "moreel gebod",
                        "strikte gebod"
                    ],
                    "target_lang_definitions": {
                        "en": "A mandatory instruction or order that must be followed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "an authoritative order"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "a directive to be obeyed"
                            },
                            {
                                "target_lang_word": "edict",
                                "target_lang_sense_clarification": "an official decree"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37569bc1-08b8-3a3b-aba4-d766551cac79",
                    "sense_definition": "een religieuze of morele leefregel, vaak verwijzend naar de Tien Geboden",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de Bijbel staan de Tien <w>Geboden</w> centraal als richtlijn voor het leven.",
                            "target_lang_translations": {
                                "en": "In the Bible, the Ten <w>Commandments</w> are central as a guideline for life."
                            }
                        },
                        {
                            "text": "Het eerste <w>gebod</w> herinnert de gelovigen aan hun toewijding aan God.",
                            "target_lang_translations": {
                                "en": "The first <w>commandment</w> reminds believers of their devotion to God."
                            }
                        }
                    ],
                    "synonyms": [
                        "leefregel",
                        "wet"
                    ],
                    "common_phrases": [
                        "tien geboden",
                        "eerste gebod"
                    ],
                    "target_lang_definitions": {
                        "en": "A religious or moral rule for living, often referring to the Ten Commandments."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commandment",
                                "target_lang_sense_clarification": "a divine or moral rule"
                            },
                            {
                                "target_lang_word": "precept",
                                "target_lang_sense_clarification": "a general rule intended to regulate behavior"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96150883-9288-39e0-a685-b93c72f486d5",
                    "sense_definition": "een van buitenaf opgelegde verplichting of noodzaak",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opdracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij handelde niet uit vrije wil, maar volgde het <w>gebod</w> van de omstandigheden.",
                            "target_lang_translations": {
                                "en": "He did not act of his own free will, but followed the <w>dictate</w> of circumstances."
                            }
                        },
                        {
                            "text": "Het economische <w>gebod</w> dwingt het bedrijf om drastisch te bezuinigen op de kosten.",
                            "target_lang_translations": {
                                "en": "The economic <w>imperative</w> forces the company to cut costs drastically."
                            }
                        }
                    ],
                    "synonyms": [
                        "verplichting",
                        "eis"
                    ],
                    "common_phrases": [
                        "gebod van de tijd"
                    ],
                    "target_lang_definitions": {
                        "en": "An externally imposed obligation or necessity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imperative",
                                "target_lang_sense_clarification": "an essential or urgent thing"
                            },
                            {
                                "target_lang_word": "dictate",
                                "target_lang_sense_clarification": "a requirement or order from an outside force"
                            },
                            {
                                "target_lang_word": "mandate",
                                "target_lang_sense_clarification": "an official requirement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}