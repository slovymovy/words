                    "frequency": "Low",
                    "semantic_group_id": "assemblage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le réparateur doit <w>souder</w> à l'étain ce composant électronique défectueux."
                        },
                        {
                            "text": "Dans son atelier, elle passe des heures à <w>souder</w> des fils de cuivre très fins."
