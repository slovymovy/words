{
    "word_family": [
        "abstraction",
        "abstraitement",
        "abstractif",
        "abstracteur",
        "abstractionnisme",
        "abstractionniste"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6020109-ac9d-3ecc-a95e-c3f5db99bcab",
                    "sense_definition": "S'isoler mentalement de son environnement pour se consacrer entièrement à une réflexion ou une rêverie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour réussir à travailler dans cette pièce bruyante, elle s'<w>abstrait</w> complètement de son environnement immédiat."
                        },
                        {
                            "text": "Il aime s'<w>abstraire</w> du monde pendant quelques heures en lisant un bon roman."
                        }
                    ],
                    "synonyms": [
                        "s'isoler"
                    ],
                    "common_phrases": [
                        "s'abstraire du monde",
                        "s'abstraire du bruit",
                        "s'abstraire de la réalité"
                    ]
                },
                {
                    "sense_id": "4a2293ce-b264-30f7-a4d3-e4e5901b6d8a",
                    "sense_definition": "Considérer par la pensée une qualité ou un élément indépendamment de la réalité concrète à laquelle il appartient.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mathématicien parvient à <w>abstraire</w> la forme géométrique des objets réels observés."
                        },
                        {
                            "text": "Dans son analyse rigoureuse, le chercheur <w>abstrait</w> les détails superflus pour formuler une loi générale."
                        }
                    ],
                    "synonyms": [
                        "isoler",
                        "séparer"
                    ],
                    "common_phrases": [
                        "abstraire un concept",
                        "abstraire une idée"
                    ]
                },
                {
                    "sense_id": "f1e3b131-9735-3670-846c-00fb1d9f34b7",
                    "sense_definition": "Isoler de façon injustifiée ou abusive un élément de la totalité ou du contexte dont il fait partie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ne peut pas <w>abstraire</w> cette citation de son contexte historique sans en fausser le sens."
                        },
                        {
                            "text": "Le critique a commis l'erreur d'<w>abstraire</w> le personnage des réalités sociales qui l'entouraient."
                        }
                    ],
                    "synonyms": [
                        "dissocier",
                        "détacher"
                    ]
                }
            ]
        }
    ]
}