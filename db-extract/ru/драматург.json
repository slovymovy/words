                    {
                        "translation_id": "3c27e333-ca6e-4385-a217-845507ec0ecc",
                        "source_entry_id": "74f8ebca-7b46-3080-8919-f43fb9f23451",
                        "source_sense_id": "bf77e20f-55df-3e1d-9669-01a4cd6351c6",
