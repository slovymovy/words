                        "glosses": [
                            "Experiment zum Eindringen, Einströmen, Einflößen von Flüssigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee92dc5b-fa71-46cb-818d-5c3af9e2eff5",
                                "sense_id": "10919dce-43b5-343e-9ee7-29eb0d724aee",
                                "text": "„Im Zusammenhang mit dem Infiltrationsversuch ist interessant, wie sich der mit der Sonde gemessene Bodenfeuchtegehalt während des Versuchs verhielt.“"
                            }
