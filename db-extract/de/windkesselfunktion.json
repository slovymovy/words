                ],
                "senses": [
                    {
                        "sense_id": "c8b1bb96-8a9b-32e2-ad25-d7cfc456789a",
                        "entry_id": "310da482-3e2b-3ebc-8020-40d49a23f23b",
                        "glosses": [
                            "Druckausgleich durch die Elastizität der herznahen Arterien (vor allem der Aorta), wodurch die starke Druckdifferenz zwischen Systole (Phase des Blutauswurfs durch Kontraktion des Herzmuskels) und Diastole (Entspannung des Herzmuskels) verringert wird"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f4eef187-447a-443c-abc3-2a8c14af43d3",
                                "sense_id": "c8b1bb96-8a9b-32e2-ad25-d7cfc456789a",
                                "text": "„Mit der sogenannten ‚Windkesselfunktion‘ werden bei der Auswurfphase die Arterienwände durch das Blut derart stark gedehnt, dass die ‚Dehnungskraft‘ in Form von elastischer Verformung im Lumen der Aorta gespeichert wird.“"
                            },
                            {
                                "example_id": "4dda4093-6a26-4613-8e5c-c08405b56bd9",
                                "sense_id": "c8b1bb96-8a9b-32e2-ad25-d7cfc456789a",
                                "text": "„Die Windkesselfunktion der Aorta und der großen Arterien dämpft die Amplituden des Druckpulses und des Strömungspulses.“"
                            },
                            {
                                "example_id": "78de6977-1962-4fce-bfeb-8be3f1e9cd8b",
                                "sense_id": "c8b1bb96-8a9b-32e2-ad25-d7cfc456789a",
                                "text": "„Zudem unterstützt die Windkesselfunktion auch die koronare Durchblutung während der Diastole.“"
                            },
                            {
                                "example_id": "6aa7b5f9-4675-4ce8-a15c-76bc0f1db52d",
                                "sense_id": "c8b1bb96-8a9b-32e2-ad25-d7cfc456789a",
                                "text": "„Dies erfordert eine intakte Windkesselfunktion der großen Hirnarterien; durch die Elastizität der Gefäßwand kann ein Teil der hydrodynamischen Energie der einlaufenden Pulswelle absorbiert werden.“"
                            },
                            {
                                "example_id": "fe0b5b5d-4b98-44d1-bae1-d6e1bcd21a71",
                                "sense_id": "c8b1bb96-8a9b-32e2-ad25-d7cfc456789a",
                                "text": "„Altersphysiologische Veränderung und Arteriosklerose der großen Gefäße bewirken durch Fortfall ihrer Windkesselfunktionen ebenfalls eine Blutdrucksteigerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
