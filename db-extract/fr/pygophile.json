                        "cross_references": [
                            {
                                "target_word": "pygophile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0980a9-39fa-3b65-b9ea-8727395c0e9d",
                                        "entry_id": "a4368efd-64b1-34cc-947f-d6f59db5bd4a",
                                        "glosses": [
                                            "A person with an intense desire and/or sexual preference for the human buttocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8a67bb-0927-4fc2-8ce2-a1c8fa3b23df",
                                                "sense_id": "9a0980a9-39fa-3b65-b9ea-8727395c0e9d",
                                                "text": "[…] Pompeian wall-painting and a terracotta from Hadra display the heroine half-naked, as does a mosaic from Praeneste, whose back view is a pygophile's delight; […]"
                                            },
                                            {
                                                "example_id": "88fb7cc3-5dd1-47c9-9d22-c407f0632018",
                                                "sense_id": "9a0980a9-39fa-3b65-b9ea-8727395c0e9d",
                                                "text": "\"And so is this,\" nuzzling down her buxom body and lustily gnawing these sleek, melonous swells.\n\"Such a pygophile y'are.\""
                                            },
                                            {
                                                "example_id": "4ea0ca99-9c05-4855-8e1d-1dfbba11b733",
                                                "sense_id": "9a0980a9-39fa-3b65-b9ea-8727395c0e9d",
                                                "text": "For example, my first exposure to an erotic outlier was with a hebephilic pygophile who also had a touch of frotteurism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
