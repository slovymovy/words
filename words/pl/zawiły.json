                    "frequency": "Middle",
                    "semantic_group_id": "abstrakcyjny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prawnik musiał dokładnie przeanalizować ten niezwykle <w>zawiły</w> problem prawny.",
