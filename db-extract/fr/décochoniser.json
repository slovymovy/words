                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e73d976-1f7d-43ba-8430-edf3552a2ffd",
                                "sense_id": "f05dc3f9-7391-3ba4-a6f9-fd5c33fa870d",
                                "text": "C’était important pour moi de lier la grandeur des sentiments avec le fonctionnement des organes, c’est un enjeu essentiel du film et de sa sensualité, de décochoniser le sexe ainsi, de poétiser la trivialité."
                            },
