{
    "word_family": [
        "okładać",
        "okładka",
        "okładzina",
        "okładkowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "855e425f-5848-3243-9f07-6e513b4c2e34",
                    "sense_definition": "kawałek tkaniny lub materiału, często nasączony lekiem lub wodą, przykładany do chorego miejsca w celach leczniczych",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lecznictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pielęgniarka położyła mu zimny <w>okład</w> na spuchnięte czoło.",
                            "target_lang_translations": {
                                "ru": "Медсестра положила ему холодный <w>компресс</w> на опухший лоб."
                            }
                        },
                        {
                            "text": "Ciepły <w>okład</w> z rumianku pomógł złagodzić ból ucha.",
                            "target_lang_translations": {
                                "ru": "Тёплый <w>компресс</w> из ромашки помог облегчить боль в ухе."
                            }
                        }
                    ],
                    "synonyms": [
                        "kompres",
                        "kataplazm"
                    ],
                    "common_phrases": [
                        "zimny okład",
                        "ciepły okład"
                    ],
                    "target_lang_definitions": {
                        "ru": "кусок ткани или материала, часто смоченный водой или лекарством, прикладываемый к больному месту в лечебных целях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компресс",
                                "target_lang_sense_clarification": "лечебная повязка"
                            },
                            {
                                "target_lang_word": "примочка",
                                "target_lang_sense_clarification": "жидкий компресс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d63bdfdd-554f-3ac7-ae5f-41bca55c8d70",
                    "sense_definition": "zabieg leczniczy lub pielęgnacyjny polegający na obłożeniu części ciała określoną substancją",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lecznictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz zalecił mu regularne <w>okłady</w> borowinowe na bolące stawy.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал ему регулярные грязевые <w>аппликации</w> на больные суставы."
                            }
                        },
                        {
                            "text": "W uzdrowisku pacjenci chętnie korzystają z <w>okładów</w> z leczniczego błota.",
                            "target_lang_translations": {
                                "ru": "В санатории пациенты охотно делают <w>обёртывания</w> из лечебной грязи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "okłady borowinowe"
                    ],
                    "target_lang_definitions": {
                        "ru": "лечебная или косметическая процедура, заключающаяся в нанесении определенного вещества на часть тела"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обёртывание",
                                "target_lang_sense_clarification": "косметическая или лечебная процедура"
                            },
                            {
                                "target_lang_word": "аппликация",
                                "target_lang_sense_clarification": "лечебное наложение грязи, парафина и т. п."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b253bb3-e20a-3a4f-91af-164ba95d36f8",
                    "sense_definition": "dodatkowa warstwa materiału pokrywająca lub zabezpieczająca jakąś powierzchnię",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pokrycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Konstrukcję zabezpieczono grubym <w>okładem</w> z materiału izolacyjnego.",
                            "target_lang_translations": {
                                "ru": "Конструкцию защитили толстой <w>обшивкой</w> из изоляционного материала."
                            }
                        },
                        {
                            "text": "Robotnicy położyli dodatkowy <w>okład</w> z blachy na zniszczoną ścianę.",
                            "target_lang_translations": {
                                "ru": "Рабочие установили дополнительную <w>облицовку</w> из листового металла на повреждённую стену."
                            }
                        }
                    ],
                    "synonyms": [
                        "obłożenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "дополнительный слой материала, покрывающий или защищающий какую-либо поверхность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обшивка",
                                "target_lang_sense_clarification": "покрытие поверхности"
                            },
                            {
                                "target_lang_word": "облицовка",
                                "target_lang_sense_clarification": "защитный или декоративный слой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "535f6d2d-2040-359e-a8f5-5f79601a3388",
                    "sense_definition": "zewnętrzna oprawa książki lub zeszytu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pokrycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary modlitewnik miał skórzany <w>okład</w> ze złotymi zdobieniami.",
                            "target_lang_translations": {
                                "ru": "У старого молитвенника был кожаный <w>переплёт</w> с золотым тиснением."
                            }
                        },
                        {
                            "text": "Introligator starannie odnowił zniszczony <w>okład</w> zabytkowej księgi.",
                            "target_lang_translations": {
                                "ru": "Переплётчик аккуратно восстановил повреждённую <w>обложку</w> старинной книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "okładka"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "w odniesieniu do oprawy książki"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "внешняя обложка или переплёт книги, тетради"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переплёт",
                                "target_lang_sense_clarification": "книжный"
                            },
                            {
                                "target_lang_word": "обложка",
                                "target_lang_sense_clarification": "книги или тетради"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4b07429-9764-3634-8cb9-e8612a7ceb33",
                    "sense_definition": "obowiązkowe świadczenie finansowe, podatek lub obciążenie nałożone na kogoś",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mieszkańcy wioski musieli płacić wysoki <w>okład</w> na rzecz lokalnego władcy.",
                            "target_lang_translations": {
                                "ru": "Жители деревни были обязаны платить высокую <w>подать</w> местному правителю."
                            }
                        },
                        {
                            "text": "Książę nałożył na kupców nowy <w>okład</w> za przewóz towarów przez rzekę.",
                            "target_lang_translations": {
                                "ru": "Князь обложил купцов новым <w>налогом</w> за перевозку товаров через реку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "w znaczeniu daniny lub podatku"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "обязательный денежный сбор, налог или подать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оклад",
                                "target_lang_sense_clarification": "устар. подать, сбор"
                            },
                            {
                                "target_lang_word": "подать",
                                "target_lang_sense_clarification": "устар. налог"
                            },
                            {
                                "target_lang_word": "оброк",
                                "target_lang_sense_clarification": "устар. повинность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6de6abfa-3cea-398d-abdd-85f8fb8b2069",
                    "sense_definition": "zadanie komuś ciosów, lanie, pobicie",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ciemnej bramie napastnicy sprawili mu solidny <w>okład</w> kijami.",
                            "target_lang_translations": {
                                "ru": "В тёмной подворотне нападавшие задали ему хорошую <w>взбучку</w> палками."
                            }
                        },
                        {
                            "text": "Buntownicy dostali od strażników porządny <w>okład</w> i uciekli w popłochu.",
                            "target_lang_translations": {
                                "ru": "Бунтовщики получили от стражников порядочных <w>тумаков</w> и в панике разбежались."
                            }
                        }
                    ],
                    "synonyms": [
                        "oklep",
                        "bęcki"
                    ],
                    "common_phrases": [
                        "sprawić okład"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "w odniesieniu do pobicia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нанесение побоев, избиение, порка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбучка",
                                "target_lang_sense_clarification": "избиение, побои"
                            },
                            {
                                "target_lang_word": "колотушки",
                                "target_lang_sense_clarification": "удары, побои"
                            },
                            {
                                "target_lang_word": "тумаки",
                                "target_lang_sense_clarification": "удары"
                            }
                        ]
                    }
                }
