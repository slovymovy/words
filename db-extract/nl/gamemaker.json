                        "examples": [
                            {
                                "example_id": "96c9e5f5-9ab8-48f7-8a52-e93f1a2071dd",
                                "sense_id": "f0dd80b4-2adf-3d65-8852-02fb986c2935",
                                "text": "De kosten van Horizon Forbidden West, van de Amsterdamse gamemaker Guerrilla, en van The Last of Us: Part II, tonen aan dat de veelgemaakte vergelijking met dure Hollywoodproducties niet vergezocht is. Ter vergelijking: de laatste Star Wars-film kostte zo'n 358 miljoen dollar om te produceren, de komende Indiana Jones-film 295 miljoen en ook veel Marvel-films hebben dit soort budgetten."
                            },
                            {
                                "example_id": "fde32a0e-7048-4cc6-b6c6-a590f79c5b9d",
                                "sense_id": "f0dd80b4-2adf-3d65-8852-02fb986c2935",
                                "text": "Ook werd duidelijk dat er is gewerkt aan een nieuwe versie van de al bestaande Xbox Series X, dat er een nieuwe Xbox-controller in de maak is en dat gamemaker Bethesda werkt aan heruitgaven van succesgames The Elder Scrolls IV: Oblivion en Fallout 3. Verder kwamen e-mails op straat te liggen waaruit was op te maken dat Spencer likkebaardend sprak over een eventuele overname van de Japanse gamegigant Nintendo, een grote concurrent."
                            }
                        ]
                    }
