                "senses": [
                    {
                        "sense_id": "af4f38f5-6aad-3116-a41d-8d09ed200eff",
                        "entry_id": "8c230a12-b090-3aa1-a369-2fd387f8c92a",
                        "glosses": [
                            "Padus avium Mill., gatunek drzewa lub dużego krzewu z rodziny różowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "520df676-df44-4778-83ed-bb1af3e9d180",
                                "sense_id": "af4f38f5-6aad-3116-a41d-8d09ed200eff",
                                "text": "Związki lotne wydzielane przez kwiaty smrodyni zawierają dużo bakteriobójczych fitoncydów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ef13acf1-4338-38c9-bce4-d35bdcde77a8",
                        "entry_id": "8c230a12-b090-3aa1-a369-2fd387f8c92a",
                        "glosses": [
                            "drzewo lub krzew z gatunku smrodynia (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "791ec9ae-17b8-4fc6-a4ce-6c31b43fd6f7",
                                "sense_id": "ef13acf1-4338-38c9-bce4-d35bdcde77a8",
                                "text": "Psa znalazła przywiązanego do smrodyni przy alejce parkowej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "29b459a5-1086-36e5-be25-2ca032e7cca0",
                        "entry_id": "8c230a12-b090-3aa1-a369-2fd387f8c92a",
                        "glosses": [
                            "Ribes nigrum L., gatunek krzewu z rodziny agrestowatych, w Polsce pospolicie uprawianego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ada3b2-6f3d-4534-b674-c75d64269050",
                                "sense_id": "29b459a5-1086-36e5-be25-2ca032e7cca0",
                                "text": "Z owoców smrodyni można robić wina."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "da3c2a3b-86ff-353b-9329-4fc35db75dc0",
                        "entry_id": "8c230a12-b090-3aa1-a369-2fd387f8c92a",
                        "glosses": [
                            "krzew z gatunku smrodynia (1.3)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec40e15-44cf-4924-b988-aeb39b1c6d2a",
                                "sense_id": "da3c2a3b-86ff-353b-9329-4fc35db75dc0",
                                "text": "Dziadkowie mają na działce raję smrodyń."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
