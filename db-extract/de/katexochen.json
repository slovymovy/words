                    {
                        "sense_id": "26baf68c-ac92-3fcc-a9dc-45e4747cdb26",
                        "entry_id": "855becd5-815f-3cf5-ae99-ce2c007cc0c4",
                        "glosses": [
                            "in perfekter Vollendung, in reinster Form"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5edef1f9-feec-4f37-881d-3192adcb2913",
                                "sense_id": "26baf68c-ac92-3fcc-a9dc-45e4747cdb26",
                                "text": "„Das ‚Verweile doch, du bist so schön‘, zum Augenblick gesagt, bezeichnet die Da-Seins-Utopie katexochen.“"
                            },
                            {
                                "example_id": "59ae6f4f-02d9-4ee5-9e63-c6d9234a2992",
                                "sense_id": "26baf68c-ac92-3fcc-a9dc-45e4747cdb26",
                                "text": "„Durchbruchsbegierde aus der Gebundenheit und Versiegelung im Häßlichen, — sage mir immerhin, daß ich Schlafstroh dresche, aber ich fühle, habe immer gefühlt und will es gegen viel derben Augenschein vertreten, daß dies deutsch ist katexochen, tief deutsch, die Definition des Deutschtums geradezu, eines Seelentums, bedroht von Versponnenheit, Einsamkeitsgift, provinzlerischer Eckensteherei, neurotischer Verstrickung, stillem Satanismus...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
