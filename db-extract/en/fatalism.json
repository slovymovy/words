                "entry_id": "6e5247a7-8ca2-3180-b859-94e6a565a6ee",
                "word": "fatalism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "826a3c54-654b-4086-8997-7e333b0b3b28",
                        "entry_id": "6e5247a7-8ca2-3180-b859-94e6a565a6ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "fatalisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "917e7055-34a9-3d72-8d3d-f4a9e95003ce",
                        "entry_id": "6e5247a7-8ca2-3180-b859-94e6a565a6ee",
                        "glosses": [
                            "The doctrine that all events are subject to fate or inevitable necessity, or determined in advance in such a way that human beings cannot alter them."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "004e09b3-2910-4264-9add-63ada1211d6e",
                                "sense_id": "917e7055-34a9-3d72-8d3d-f4a9e95003ce",
                                "text": "Sure, maybe. We know — have long known — that romanticism and fatalism are dialectical lovers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6128d26-e349-42ab-b371-1c2c461f14ed",
                        "source_entry_id": "6e5247a7-8ca2-3180-b859-94e6a565a6ee",
