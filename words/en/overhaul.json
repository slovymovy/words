        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "189fae26-de5b-3ad1-a26f-05cb98305d0a",
                    "sense_definition": "To modernize, repair, renovate, or revise completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic will <w>overhaul</w> the engine to ensure it runs like new again.",
                            "target_lang_translations": {
                                "ru": "Механик <w>проведет капитальный ремонт</w> двигателя, чтобы он снова работал как новый.",
                                "nl": "De monteur zal de motor <w>reviseren</w> om ervoor te zorgen dat hij weer als nieuw loopt."
                            }
                        },
                        {
                            "text": "The government plans to <w>overhaul</w> the education system to improve student outcomes.",
                            "target_lang_translations": {
                                "ru": "Правительство планирует <w>коренным образом пересмотреть</w> систему образования, чтобы улучшить результаты учащихся.",
                                "nl": "De regering is van plan het onderwijssysteem grondig te <w>herzien</w> om de resultaten van leerlingen te verbeteren."
                            }
                        }
                    ],
                    "synonyms": [
                        "renovate",
                        "remodel",
                        "revamp",
                        "reconstruct"
                    ],
                    "common_phrases": [
                        "overhaul the system",
                        "completely overhaul",
                        "overhaul the engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью модернизировать, ремонтировать, обновлять или пересматривать.",
                        "nl": "Grondig nakijken, reviseren, opknappen of volledig moderniseren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капитально ремонтировать",
