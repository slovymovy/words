                    {
                        "translation_id": "1043a2eb-9635-49bf-b474-f0c37128b675",
                        "source_entry_id": "2b13280b-75be-382f-a88d-3fce6b2deec6",
                        "source_sense_id": "8f87f872-f462-3222-9778-b8f20d42cc96",
                        "source_sense_description": "Habit, vêtement",
                        "target_lang_word": "kleren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kleren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "18ac4a8d-871a-3b7b-81f2-10953e86866d",
                                        "entry_id": "79f88c5b-fe90-3661-945c-b327c7edb429",
                                        "glosses": [
                                            "kleding of kledingstukken"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c54859-9dad-4713-b0f0-99b85c262f57",
                                                "sense_id": "18ac4a8d-871a-3b7b-81f2-10953e86866d",
                                                "text": "Jullie moeten vandaag nieuwe kleren kopen."
                                            },
                                            {
                                                "example_id": "9a830231-4f6f-46f0-816a-118bec0fa046",
                                                "sense_id": "18ac4a8d-871a-3b7b-81f2-10953e86866d",
                                                "text": "'Mam, waar heb je mijn kleren gelaten?' Nikki richt zich weer tot haar moeder."
                                            },
                                            {
                                                "example_id": "c6a78300-3558-45a2-ae63-121dfcca2d4c",
                                                "sense_id": "18ac4a8d-871a-3b7b-81f2-10953e86866d",
                                                "text": "Zonder een hap te eten en met mijn kleren nog aan viel ik meteen in slaap."
                                            },
                                            {
                                                "example_id": "efc7f43a-6ff9-4b64-b954-490278db5048",
                                                "sense_id": "18ac4a8d-871a-3b7b-81f2-10953e86866d",
                                                "text": "We hadden gegeten bij Marie-Claire en waren inmiddels afgetaaid naar onze slaapkamer, ik lag al in bed met een boek en Lauren stond kleren te vouwen, toen ze werd gebeld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0701913-06d5-30ed-8e78-b6f083c963a9",
                                        "entry_id": "79f88c5b-fe90-3661-945c-b327c7edb429",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord kleed"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "391b95cc-dcf6-45fb-9472-bd4c06dfafe0",
