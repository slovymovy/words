{
    "word_family": [
        "rattrapage",
        "attraper",
        "attrape"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27bbf0bb-d5d2-35dc-9055-ce60415b26ac",
                    "sense_definition": "Rejoindre une personne ou un véhicule qui a pris de l'avance en allant plus vite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il court très vite pour <w>rattraper</w> ses amis dans la rue."
                        },
                        {
                            "text": "Marche un peu plus vite si tu veux <w>rattraper</w> le groupe avant le carrefour."
                        }
                    ],
                    "synonyms": [
                        "rejoindre"
                    ],
                    "antonyms": [
                        "distancer"
                    ],
                    "common_phrases": [
                        "rattraper le peloton",
                        "rattraper son retard"
                    ]
                },
                {
                    "sense_id": "29188863-1b27-3410-af6c-eefb659553e3",
                    "sense_definition": "Saisir au vol ou retenir un objet ou un être avant qu'il ne tombe ou ne s'échappe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai réussi à <w>rattraper</w> le verre juste avant qu'il ne touche le sol."
                        },
                        {
                            "text": "Le gardien de but a pu <w>rattraper</w> le ballon au dernier moment."
                        }
                    ],
                    "synonyms": [
                        "saisir",
                        "ressaisir"
                    ],
                    "antonyms": [
                        "lâcher"
                    ],
                    "common_phrases": [
                        "rattraper au vol",
                        "rattraper de justesse"
                    ]
                },
                {
                    "sense_id": "12320452-fb7e-3410-9929-e43409b35923",
                    "sense_definition": "Regagner ou compenser ce qui a été perdu, comme du temps, des cours ou un retard.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant doit travailler ce week-end pour <w>rattraper</w> les cours manqués."
                        },
                        {
                            "text": "Nous devons travailler plus vite afin de <w>rattraper</w> le temps perdu."
                        }
                    ],
                    "synonyms": [
                        "compenser",
                        "récupérer"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "rattraper le temps perdu",
                        "rattraper les heures"
                    ]
                },
                {
                    "sense_id": "55ca6d69-a41d-38ee-8c08-e508d747e9ce",
                    "sense_definition": "Prendre appui sur quelque chose pour éviter de tomber ou pour retrouver son équilibre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a glissé sur la neige mais il s'est <w>rattrapé</w> à la rampe."
                        },
                        {
                            "text": "Elle a manqué une marche et s'est <w>rattrapée</w> de justesse au bras de son voisin."
                        }
                    ],
                    "synonyms": [
                        "se raccrocher",
                        "se retenir"
                    ],
                    "common_phrases": [
                        "se rattraper à une branche",
                        "se rattraper à la rampe"
                    ]
                },
                {
                    "sense_id": "98b7f096-e2c3-3f0c-b9c2-4e3d92014be1",
                    "sense_definition": "Corriger habilement une erreur, une maladresse ou une situation embarrassante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir fait une remarque maladroite, il s'est <w>rattrapé</w> avec beaucoup d'humour."
                        },
                        {
                            "text": "Le ministre a commis une faute dans son discours mais s'est bien <w>rattrapé</w> ensuite."
                        }
                    ],
                    "synonyms": [
                        "se corriger"
                    ],
                    "common_phrases": [
                        "se rattraper avec adresse",
                        "rattraper le coup"
                    ]
                },
                {
                    "sense_id": "83de3592-25ce-396f-a752-5311799ab6c5",
                    "sense_definition": "En parlant des conséquences ou du passé, revenir toucher quelqu'un après un délai.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses mensonges passés ont fini par le <w>rattraper</w> au cours de l'enquête."
                        },
                        {
                            "text": "Malgré sa fuite à l'étranger, la justice a fini par la <w>rattraper</w> après des années."
                        }
                    ],
                    "common_phrases": [
                        "être rattrapé par son passé",
                        "la réalité finit par rattraper"
                    ]
                },
                {
                    "sense_id": "3232d728-3ab3-38e7-9300-4af674a909c1",
                    "sense_definition": "Attraper de nouveau un être vivant qui était parvenu à s'enfuir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat s'était enfui de la cage et le vétérinaire a dû le <w>rattraper</w> dans le couloir."
                        },
                        {
                            "text": "Il est particulièrement difficile de <w>rattraper</w> un oiseau qui a pris son envol."
                        }
                    ],
                    "synonyms": [
                        "recapturer"
                    ],
                    "common_phrases": [
                        "rattraper un fugitif",
                        "rattraper l animal"
                    ]
                },
                {
                    "sense_id": "81ddb882-443a-3be2-96d0-2e0941df8aca",
                    "sense_definition": "Prendre quelqu'un au piège ou le duper une seconde fois.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai retenu la leçon et on ne m'y <w>rattrapera</w> plus jamais."
                        },
                        {
                            "text": "Cette escroquerie m'a coûté cher, bien habile qui m'y <w>rattrapera</w> à l'avenir."
                        }
                    ],
                    "synonyms": [
                        "reprendre",
                        "tromper"
                    ],
                    "common_phrases": [
                        "on ne m y rattrapera plus"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé surtout dans des formules figées"
                        }
                    ]
                }
            ]
        }
    ]
}