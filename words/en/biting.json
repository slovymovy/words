    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "766558ff-3937-30f2-8378-e8ac94d37081",
                    "sense_definition": "The present participle and gerund of <w>bite</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy is <w>biting</w> on a rubber toy.",
                            "target_lang_translations": {
                                "ru": "Щенок <w>грызет</w> резиновую игрушку.",
                                "nl": "De puppy is aan het <w>bijten</w> op een rubberen speeltje."
                            }
                        },
                        {
                            "text": "He has a bad habit of <w>biting</w> his nails when nervous.",
                            "target_lang_translations": {
                                "ru": "У него есть дурная привычка <w>грызть</w> ногти, когда он нервничает.",
                                "nl": "Hij heeft de slechte gewoonte om op zijn nagels te <w>bijten</w> als hij zenuwachtig is."
                            }
                        }
