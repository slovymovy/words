        "de-extract.jsonl": [
            {
                "entry_id": "8daeea3b-16c2-360d-878d-13dd15dfca97",
                "word": "derohalben",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "300672aa-b428-3e27-a8a7-091a62507b20",
                        "entry_id": "8daeea3b-16c2-360d-878d-13dd15dfca97",
                        "glosses": [
                            "aus diesem Grund, deshalb"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "116f82b1-60e0-48bc-8248-b44fbd9c6c5d",
                                "sense_id": "300672aa-b428-3e27-a8a7-091a62507b20",
                                "text": "„Er wird derohalben der traurige und betrübte Baum genennet/ dieweil solcher nur zu Nachts/ niemals aber bey dem Tag bluehet.“"
                            },
                            {
                                "example_id": "e7ac5eba-a74e-4b34-8d93-a581615a12be",
                                "sense_id": "300672aa-b428-3e27-a8a7-091a62507b20",
                                "text": "„Derohalben habe Oesterreich der Schwitzer Land-Leute angegriffen, da doch im Friedens-Brieff vertragen war, daß keiner des andern Land-Leute stören solte.“"
                            },
                            {
                                "example_id": "15ea4b4b-4b68-43b1-b72d-621256b77a05",
                                "sense_id": "300672aa-b428-3e27-a8a7-091a62507b20",
                                "text": "„Derohalben thut er, wie ein frommer Prediger thun soll, läßt sich nichts anfechten, daß Herodes ein großer König ist; sondern wie er andere Leute um ihre Sünde strafete, und sie vermahnete, sie sollten ablassen“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
