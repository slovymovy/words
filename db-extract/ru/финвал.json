                                        "glosses": [
                                            "A whale of the rorqual family (Balaenoptera physalus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ae238a-fdeb-4546-b52d-fda7204c66e1",
                                                "sense_id": "47ca6c7a-b95b-3f86-8afb-b7f0c32fca70",
                                                "text": "The fin whale is a fast swimmer (around 30km/h) and generally lives in small groups numbering around five."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
