                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La population civile a dû se réfugier dans les abris pendant le <w>bombardement</w> de la ville."
                        },
                        {
                            "text": "Le <w>bombardement</w> aérien a causé d'importants dégâts matériels dans tout le quartier."
                        }
                    ],
                    "synonyms": [
                        "pilonnage"
                    ],
                    "common_phrases": [
                        "bombardement aérien"
                    ]
                },
                {
                    "sense_id": "5d87829a-1492-3b92-89a6-d7614f983649",
                    "sense_definition": "Envoi massif et répété de messages, de courriels ou de sollicitations à un destinataire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre boîte de réception a été victime d'un véritable <w>bombardement</w> de courriers indésirables ce matin."
                        },
                        {
                            "text": "Ce <w>bombardement</w> publicitaire incessant commence à agacer sérieusement les utilisateurs de l'application."
                        }
                    ],
                    "synonyms": [
                        "inondation",
                        "matraquage"
                    ],
                    "common_phrases": [
