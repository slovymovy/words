    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df562749-1bde-3262-a0f3-25f6a9cec25c",
                    "sense_definition": "To do something that one considers beneath one's dignity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "condescension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not even <w>deign</w> to look at me when I entered the room."
                        },
                        {
                            "text": "She finally <w>deigned</w> to answer my email after waiting for three weeks."
                        }
                    ],
                    "synonyms": [
                        "condescend",
                        "stoop"
                    ],
                    "common_phrases": [
                        "deign to answer",
                        "deign to reply"
                    ]
                },
                {
                    "sense_id": "1f1c609b-ab56-32af-afdc-d6f55fb3d250",
                    "sense_definition": "To graciously agree to give or do something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "condescension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king <w>deigned</w> to grant the peasants an audience in the great hall."
                        },
                        {
                            "text": "We pray that you <w>deign</w> to accept our humble offering today."
                        }
                    ],
                    "synonyms": [
                        "vouchsafe"
                    ],
                    "common_phrases": [
                        "deign to grant"
                    ]
                },
                {
                    "sense_id": "4a3f3bb3-5039-3136-bdb0-e3265bfb897a",
                    "sense_definition": "To consider someone or something worthy of notice or attention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would not <w>deign</w> my request with a response."
                        },
                        {
                            "text": "She did not <w>deign</w> his letter with a second glance."
                        }
                    ],
                    "traits": [
                        {
