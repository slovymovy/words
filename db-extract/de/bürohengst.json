                        ]
                    },
                    {
                        "translation_id": "96a24014-e2f5-4977-ab96-227aa8b6f374",
                        "source_entry_id": "55fcb9fe-1883-35bb-96fc-4d2d97c0e46b",
                        "source_sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                        "source_sense_description": "umgangssprachlich, abwertend: (oft pedantische) Person, die im Büro arbeitet, Büroarbeit leistet",
                        "target_lang_word": "rond-de-cuir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rond-de-cuir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf33b75-e361-301e-aef8-b0d00950cb58",
                                        "entry_id": "7ca3439b-4f2c-30ea-a879-a45653158789",
                                        "glosses": [
                                            "Petite pièce de cuir de forme ronde cousue aux coudes des vêtements pour éviter l’usure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "165ba73f-7930-3b38-a064-e7d71d44d900",
                                        "entry_id": "7ca3439b-4f2c-30ea-a879-a45653158789",
                                        "glosses": [
                                            "Coussin de cuir en forme de couronne utilisé autrefois par les personnes demeurant en position assise prolongée, pour soulager leurs hémorroïdes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b57e2e8a-7f37-4224-930f-f71824f394bf",
                                                "sense_id": "165ba73f-7930-3b38-a064-e7d71d44d900",
                                                "text": "[…] c’était plaisir de le voir allonger ses jambes grassouillettes, s’enfoncer sur son grand fauteuil, sur ce rond de cuir frais et moelleux auquel il devait d’avoir encore l’humeur égale et le teint clair, après trente ans de magistrature assise."
                                            },
                                            {
                                                "example_id": "d74fa38a-3793-4b0d-bcc5-e1604c883f0b",
                                                "sense_id": "165ba73f-7930-3b38-a064-e7d71d44d900",
                                                "text": "Il protestait de temps à autre contre la durée abusive des vacances scolaires.\n« J'admets, disait-il, que les enfants aient besoin d'un si long repos. Mais pendant ce temps, on pourrait employer les instituteurs à autre chose !\n— Eh oui ! disait ironiquement mon père, ils pourraient aller remplacer, pendant deux mois, les fonctionnaires de la préfecture, épuisés par leurs longues siestes, et meurtris par le rond de cuir ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899e8905-dd10-3ae3-9f52-0d2afda70691",
                                        "entry_id": "7ca3439b-4f2c-30ea-a879-a45653158789",
                                        "glosses": [
                                            "Employé de bureau."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af5f147d-cf54-4f4c-a6f2-eec1b26dce63",
                                                "sense_id": "899e8905-dd10-3ae3-9f52-0d2afda70691",
                                                "text": "Messieurs les Ronds-de-cuir ou Tableaux-roman de la vie de bureau"
                                            },
                                            {
                                                "example_id": "9171fcb0-08b5-4955-ab53-9798f95e3802",
                                                "sense_id": "899e8905-dd10-3ae3-9f52-0d2afda70691",
                                                "text": "Un rond-de-cuir sans envergure amené par le destin à commander à des millions d’individus qui le haïssent deviendra un parfait Caligula."
                                            },
                                            {
                                                "example_id": "3de336ff-9a37-4e95-97c4-dafda81686a9",
                                                "sense_id": "899e8905-dd10-3ae3-9f52-0d2afda70691",
                                                "text": "Toutes ces initiatives ont, on le devine, fait l’objet de luttes, contre des conservateurs, contre l’inertie de ronds-de-cuir."
                                            },
                                            {
                                                "example_id": "862f4907-9a6b-4024-ba02-b1e0370e9fe8",
                                                "sense_id": "899e8905-dd10-3ae3-9f52-0d2afda70691",
                                                "text": "J’appelais « syndrome Pessoa » cette rage à se faire humble. Le poète portugais avait mené une carrière de rond-de-cuir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c774f6e-f8c2-3aff-88f8-d111d1ea8d3c",
                                        "entry_id": "7ca3439b-4f2c-30ea-a879-a45653158789",
                                        "glosses": [
                                            "Fonctionnaire (employé dans un bureau)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d465bb-2906-442d-9b65-f8c356021301",
                                                "sense_id": "3c774f6e-f8c2-3aff-88f8-d111d1ea8d3c",
                                                "text": "Vous, ronds-de-cuir qui êtes derrière vos opéras, derrière vos bureaux, à dépenser le fric des gens, voilà. (…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8f4992-757a-39b6-9cb0-6d227690ca70",
                                        "entry_id": "7ca3439b-4f2c-30ea-a879-a45653158789",
                                        "glosses": [
                                            "Personne excessivement sédentaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e78c007c-0262-44d8-b8cc-3ab93d58147d",
                        "source_entry_id": "55fcb9fe-1883-35bb-96fc-4d2d97c0e46b",
                        "source_sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                        "source_sense_description": "umgangssprachlich, abwertend: (oft pedantische) Person, die im Büro arbeitet, Büroarbeit leistet",
                        "target_lang_word": "gratte-papier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gratte-papier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                        "entry_id": "936c596b-afd9-3065-8d50-febbf2b8537b",
                                        "glosses": [
                                            "Celui, celle qui est chargé des écritures dans les études d’avoués, de notaires, etc. ; employé de bureau."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa2364e1-00e7-46b2-b987-d91eade2ac17",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Si j’étais demoiselle, moi, j’aimerais mieux un gentleman qui porte des éperons qu’un gratte-papier, c’est certain."
                                            },
                                            {
                                                "example_id": "3a222e28-648f-4cde-9f32-5371938cdf2d",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Cette réplique coupa la parole aux gratte-papiers ; l’un d’eux désigna un angle de la pièce où un vieillard rangeait des dossiers."
                                            },
                                            {
                                                "example_id": "b2ab95c7-b7ff-4e2a-85ff-f460be580181",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Gabriel plissa des yeux, étonné. Mais le doute n’était pas possible : cette façon de marcher en secouant les rotules, si peu paysanne, trahissait le seul gratte-papier du village."
                                            },
                                            {
                                                "example_id": "164b1a6b-c005-4c74-8a0c-16a32548481d",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Les gratte-papier, tapis derrière leurs comptoirs, levèrent à peine la tête et se replongèrent dans ces gros livres, tendus de toile noire, où depuis sa naissance, ses mérites et ses accidents de parcours se trouvaient dûment enregistrés et pesés. Combien de démarches futiles avait-il accomplies dans ce local, dont la liste des avoués de la Seine et le martyrologe des médecins légistes morts pour la France constituaient à peu près le seul ornement ?"
                                            },
                                            {
                                                "example_id": "0d34faf8-3655-4f61-964f-f9c89b8a7c72",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Et impossible de trouver un emploi de dactylographe. On me disait : « À Paris, on aime les gratte-papier en jupons. Et même les chieuses d'encre et les pisseuses de copie. Allez donc y voir ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ace05bf9-7fa2-33ae-a3a9-c69c4fb07c0f",
                                        "entry_id": "936c596b-afd9-3065-8d50-febbf2b8537b",
                                        "glosses": [
                                            "Personne (auteur, journaliste …) écrivant sans talent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cfb6f5e-a8af-4408-815b-d0af7648f59a",
                                                "sense_id": "ace05bf9-7fa2-33ae-a3a9-c69c4fb07c0f",
                                                "text": "Cyprien, lisant le journal à voix haute : « Si l’on nous demande un remède ... nous ne nous chargeons pas de l’indiquer. » (Parlé) Eh bien, alors... tais ton bec, méchant gratte-papier !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
