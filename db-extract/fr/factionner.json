                        "examples": [
                            {
                                "example_id": "47aed6b3-1582-4976-86d3-b3be39446474",
                                "sense_id": "d76b5438-bfd4-3d28-af0e-f76d48fe6569",
                                "text": "La garde envoyée, au lieu de factionner au dehors, s'est tenue dans l'intérieur, et c'est, parce qu'elle y était renfermée, que les voleurs ont pu grimper par l'extérieur de la colonnade."
                            },
                            {
                                "example_id": "f1aac79e-a9ba-4acb-9637-426a309e3f19",
                                "sense_id": "d76b5438-bfd4-3d28-af0e-f76d48fe6569",
                                "text": "Et vous les agents, à votre tour de factionner dehors"
                            },
                            {
                                "example_id": "ea24239a-6317-40a2-8332-83ae23886374",
                                "sense_id": "d76b5438-bfd4-3d28-af0e-f76d48fe6569",
                                "text": "C’est Rosita, sous-chef infirmière de première classe qui factionne à son chevet, réglant des tubes, des manettes, des zinzins de survie."
                            }
                        ]
                    }
