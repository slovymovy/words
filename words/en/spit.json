                    "frequency": "Low",
                    "semantic_group_id": "sem_emit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful near the stove as the frying pan is <w>spitting</w> hot oil.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен у плиты, так как сковорода <w>брызжет</w> горячим маслом.",
                                "zh": "在炉子旁要小心，平底锅正在<w>溅</w>出热油。"
                            }
                        },
                        {
                            "text": "The old log fire crackled and <w>spat</w> sparks onto the rug.",
                            "target_lang_translations": {
                                "ru": "Старое полено в огне потрескивало и <w>выбрасывало</w> искры на ковер.",
                                "zh": "老木头火堆噼啪作响，向地毯上<w>迸溅</w>出火星。"
                            }
