                                "target_senses": [
                                    {
                                        "sense_id": "f9ef9802-a9f0-3954-8806-f77c83c989c7",
                                        "entry_id": "45bd991e-e804-32a1-b884-402e056a6b05",
                                        "glosses": [
                                            "Grande famine orchestrée par Staline qui a lieu en Ukraine et dans le Kouban en 1932 et 1933 et qui fait, selon les estimations des historiens, entre 2,61 et 5 millions de victimes."
                                        ],
                                        "tags": [
                                            "Communisme",
                                            "URSS"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c08e687-02e7-49d4-b2a9-ab99ec23c84d",
                                                "sense_id": "f9ef9802-a9f0-3954-8806-f77c83c989c7",
                                                "text": "Dans le village de Tarhan, à 120 kilomètres au sud de Kiev, elle est l’une des dernières survivantes de l’Holodomor, une grande famine qui a sévi en 1932-1933."
                                            },
                                            {
                                                "example_id": "90b105c0-4c82-4ac8-aa99-26d551c42250",
                                                "sense_id": "f9ef9802-a9f0-3954-8806-f77c83c989c7",
                                                "text": "Occultée de l’histoire officielle soviétique, l’Holodomor a marqué les familles et entretenu le ressentiment vis-à-vis de Moscou."
                                            },
                                            {
                                                "example_id": "a1a5b893-dfe0-4705-84dc-65e4fa72c02f",
                                                "sense_id": "f9ef9802-a9f0-3954-8806-f77c83c989c7",
                                                "text": "La Russie nie de la même façon l'intention génocidaire de la grande famine causée en Ukraine dans les années 1930 par la collectivisation forcée des terres (Holodomor), alors même qu'elle pourrait s'en défausser sur l'ex-URSS."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03183204-b8d3-4525-8add-c9eedd2e812b",
                        "source_entry_id": "1b36af41-1f4b-3bb8-8035-3a021b949eb0",
