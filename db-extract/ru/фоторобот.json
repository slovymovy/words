                                        "entry_id": "e326bd2d-7d5f-3853-aaef-37694a2d39bb",
                                        "glosses": [
                                            "Outil d'enquête en police judiciaire qui vise à faire le portrait le plus ressemblant possible du visage d’un criminel inconnu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662ca80c-9268-42e6-a10c-9f1e07527a23",
                                                "sense_id": "2dbfc5da-e13c-3be3-bddb-9249a27620ed",
                                                "text": "Le portrait-robot était dessiné, composé et redessiné à partir de bandes de photo (cheveux, yeux, nez, bouche, menton) en fonction des indications données par les victimes ou les témoins. Aujourd’hui, il existe des logiciels capables d’informatiser la création d’un portrait-robot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2954516f-2007-317c-806b-87dcefdf0ea6",
                                        "entry_id": "e326bd2d-7d5f-3853-aaef-37694a2d39bb",
                                        "glosses": [
                                            "Personne rassemblant en elle différents éléments disparates."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ead42ac-a6f5-470f-b317-11ade35b1dcc",
                                                "sense_id": "2954516f-2007-317c-806b-87dcefdf0ea6",
                                                "text": "Ce n’est plus un compositeur : c’est un portrait-robot du compositeur au vingtième siècle."
                                            },
                                            {
                                                "example_id": "83ade720-0d23-4d9f-bb60-ac15597b12df",
                                                "sense_id": "2954516f-2007-317c-806b-87dcefdf0ea6",
                                                "text": "S'il y avait un portrait robot de la personne la plus à risque sur la route, il s'agirait donc d'un homme, conducteur de voiture, entre 18 et 44 ans, et qui roule majoritairement hors agglomération."
                                            }
                                        ]
                                    }
                                ]
