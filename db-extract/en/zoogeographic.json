                        "entry_id": "5573596d-313e-3cf1-8565-c691732f4a36",
                        "glosses": [
                            "Of or relating to zoogeography; concerning the geographic distribution of animals."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "151c5d5e-1d40-497a-8112-6687b63a2f4a",
                                "sense_id": "d5c80ace-00fd-3a7d-a9f7-14e25638704d",
                                "text": "An arm of the Tethys known as the Turgai Strait was an important zoogeographic barrier, cutting Asia off from Europe."
                            }
                        ]
                    }
                ],
