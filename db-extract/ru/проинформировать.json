                            "participle",
                            "past"
                        ],
                        "form": "проинформи́ровав"
                    },
                    {
                        "form_id": "453f037f-8544-4fd6-81be-e20e518995ef",
                        "entry_id": "2bf2c5a6-e18e-3e41-a5de-fd53fdadddd9",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "проинформи́ровавши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44a9e455-8339-3133-8c8a-6496e66170ac",
                        "entry_id": "2bf2c5a6-e18e-3e41-a5de-fd53fdadddd9",
                        "glosses": [
                            "офиц. то же, что поставить в известность; сообщить кому-либо некую информацию, которой он предположительно не обладает"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9207178d-2395-4158-b470-f6421bf3cf54",
                                "sense_id": "44a9e455-8339-3133-8c8a-6496e66170ac",
                                "text": "Прежде всего, хочу проинформировать вас. Барулин изменил нам."
                            },
                            {
                                "example_id": "2ad8929c-73ec-4407-95b5-823150fe4740",
                                "sense_id": "44a9e455-8339-3133-8c8a-6496e66170ac",
                                "text": "Он получил приказ отправиться в один из пригородных стокгольмских особняков, чтобы проинформировать о методах конспирации собравшихся там сотрудников гестапо, офицерский состав СС и видных нацистов, которые уходили сейчас в подполье."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd9d4ff2-e94b-4386-8360-df8fe201b543",
                        "source_entry_id": "2bf2c5a6-e18e-3e41-a5de-fd53fdadddd9",
                        "source_sense_id": "44a9e455-8339-3133-8c8a-6496e66170ac",
                        "target_lang_word": "inform",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e44c7de-406c-3278-97d2-bc8cc701feca",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To instruct, train (usually in matters of knowledge)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82b98c71-e57a-3d3f-ae60-24bb1b332e4c",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To communicate knowledge to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3afbd583-b0da-4bc3-be89-fb77c858e640",
                                                "sense_id": "82b98c71-e57a-3d3f-ae60-24bb1b332e4c",
                                                "text": "For he would learn their business secretly, / And then inform his master hastily."
                                            },
                                            {
                                                "example_id": "979328be-c8b6-45f9-bda9-50ba1317b083",
                                                "sense_id": "82b98c71-e57a-3d3f-ae60-24bb1b332e4c",
                                                "text": "I am informed thoroughly of the cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7af647-fffe-3a86-b5c0-2e13658d72df",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To impart information or knowledge."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16009c8c-336e-3bd5-974a-c18db39b7e1e",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To act as an informer; denounce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90d8b465-e7a6-3be7-8d1f-30604e378524",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To give form or character to; to inspire (with a given quality); to affect, influence (with a pervading principle, idea etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e30b2d2-1c13-4555-a3b8-3af285a71806",
                                                "sense_id": "90d8b465-e7a6-3be7-8d1f-30604e378524",
                                                "text": "His sense of religion informs everything he writes."
                                            },
                                            {
                                                "example_id": "e1dbf36d-eaae-4a22-84dc-9033200a139f",
                                                "sense_id": "90d8b465-e7a6-3be7-8d1f-30604e378524",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            },
                                            {
                                                "example_id": "d78c3067-8911-4dca-acfa-5cf2fbc04030",
                                                "sense_id": "90d8b465-e7a6-3be7-8d1f-30604e378524",
                                                "text": "Let others better mould the running mass / Of metals, and inform the breathing brass"
                                            },
                                            {
                                                "example_id": "7c5d739b-9da0-458c-a143-9ada851f977f",
                                                "sense_id": "90d8b465-e7a6-3be7-8d1f-30604e378524",
                                                "text": "O! long as breath informs this fleeting frame / Ne'er let me pass in silence Dorset's name"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b070dbb3-f88d-3679-aa88-3c72fd26eb51",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To make known, wisely and/or knowledgeably."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b6eff6c-83ba-3f1c-ae7b-2142b51f1a0a",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To direct, guide."
                                        ],
                                        "tags": [
                                            "formal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a631ac46-07b0-4543-9043-8381c7e3476b",
                                                "sense_id": "0b6eff6c-83ba-3f1c-ae7b-2142b51f1a0a",
                                                "text": "Don't forget the code of ethics that informs this profession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c62af6d5-b67e-329e-8fdf-cf8980a96bd0",
                                        "entry_id": "ca1b69cc-e0d7-3032-827a-80b7551e88e4",
                                        "glosses": [
                                            "To take form; to become visible or manifest; to appear."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b71712-cd5a-44aa-9f37-1c4ebcc0aaf2",
