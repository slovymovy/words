                "senses": [
                    {
                        "sense_id": "e2d19a6f-acf2-3757-907a-58f1550a8ed8",
                        "entry_id": "64970a1c-13d5-39ce-a146-66ca42a05f62",
                        "glosses": [
                            "przekształcenie formy, kształtu, postaci, charakteru czegoś w inny; całościowa zmiana"
                        ],
                        "tags": [],
