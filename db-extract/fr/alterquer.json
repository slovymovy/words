                "senses": [
                    {
                        "sense_id": "b3686529-30ea-37f3-aa3a-f332f1142123",
                        "entry_id": "4601e96c-b9d6-3c6e-8608-ac45dd9a5074",
                        "glosses": [
                            "Débattre, disputer, contester."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dff51f44-c04c-4dcf-bc99-98fcabdc1883",
                                "sense_id": "b3686529-30ea-37f3-aa3a-f332f1142123",
                                "text": "Il n’y avait pas moyen d’alterquer beaucoup là-dessus devant le tiers qui nous écoutait. J’ai gardé le silence, et n’ai pu cacher si bien mon chagrin que mon mari ne s’en soit aperçu."
                            },
                            {
                                "example_id": "b61c2e78-ab1f-443f-bdcd-9c87223f351d",
                                "sense_id": "b3686529-30ea-37f3-aa3a-f332f1142123",
                                "text": "J'imagine que cela a du faire un certain effet puisque vous m’alterquez immédiatement avec cette froide logique vôtre et une argumentation de haut niveau. (Forum \"Débats\" du Nouvel Obs)"
                            }
                        ]
                    }
