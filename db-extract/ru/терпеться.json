                "senses": [
                    {
                        "sense_id": "96ae7fe7-d0cd-333c-9b45-e29e378e870f",
                        "entry_id": "d353882f-be43-3591-8515-fd09a8c7069d",
                        "glosses": [
                            "passive of терпе́ть (terpétʹ)"
                        ],
                        "tags": [
                            "form-of",
                            "impersonal",
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "5b7dcdcb-9c50-4fa2-a418-de03f0ce8649",
                                "sense_id": "96ae7fe7-d0cd-333c-9b45-e29e378e870f",
                                "text": "ему́ [им] не те́рпится",
                                "translation": "he is [they are] impatient (+ to); he [they] can't wait (+ to)",
                                "english": "he is [they are] impatient (+ to); he [they] can't wait (+ to)"
                            },
                            {
                                "example_id": "cc0e65a8-5d83-48c9-b5f4-1e486f95739a",
                                "sense_id": "96ae7fe7-d0cd-333c-9b45-e29e378e870f",
                                "text": "мне не те́рпится уви́деть его́ сно́ва",
                                "translation": "I can't wait to see him again",
                                "english": "I can't wait to see him again"
                            },
                            {
                                "example_id": "c085038c-ffca-4d91-8a9c-213dc15451c4",
                                "sense_id": "96ae7fe7-d0cd-333c-9b45-e29e378e870f",
                                "text": "вам что, так не те́рпится?",
                                "translation": "can't you wait any longer?; do you really have such an impelling urge?",
                                "english": "can't you wait any longer?; do you really have such an impelling urge?"
                            }
                        ]
                    }
                ],
