{
    "word_family": [
        "sew",
        "sewer",
        "sewable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bd8cacc-1216-35da-aa2d-7cd8c2945fae",
                    "sense_definition": "The activity or skill of making, mending, or joining things (such as clothing) using a needle and thread.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother taught me <w>sewing</w> when I was just a child.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка научила меня <w>шитью</w>, когда я была совсем ребёнком.",
                                "zh": "我小时候，祖母就教我<w>缝纫</w>了。"
                            }
                        },
                        {
                            "text": "She bought a new <w>sewing</w> machine to make her own curtains.",
                            "target_lang_translations": {
                                "ru": "Она купила новую <w>швейную</w> машинку, чтобы сшить себе шторы.",
                                "zh": "她买了一台新的<w>缝纫</w>机来自己做窗帘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "needlework",
                        "stitching"
                    ],
                    "common_phrases": [
                        "sewing machine",
                        "sewing kit",
                        "sewing needle",
                        "sewing room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность или умение создавать, чинить или соединять вещи (например, одежду) с помощью иглы и нитки.",
                        "zh": "使用针线制作、修补或缝合物品（如衣物）的活动或技能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шитьё",
                                "target_lang_sense_clarification": "процесс или занятие"
                            },
                            {
                                "target_lang_word": "пошив",
                                "target_lang_sense_clarification": "изготовление одежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缝纫",
                                "target_lang_sense_clarification": "指缝补或制作衣物的工艺或活动"
                            },
                            {
                                "target_lang_word": "针线活",
                                "target_lang_sense_clarification": "指手工缝制的活计"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                    "sense_definition": "An article of clothing or piece of fabric that is currently being worked on with a needle and thread.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put her <w>sewing</w> in the basket and went to answer the door.",
                            "target_lang_translations": {
                                "ru": "Она положила своё <w>шитьё</w> в корзину и пошла открывать дверь.",
                                "zh": "她把<w>针线活</w>放进篮子里，去开门了。"
                            }
                        },
                        {
                            "text": "Please move your <w>sewing</w> off the table so we can set it for dinner.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убери своё <w>шитьё</w> со стола, чтобы мы могли накрыть на стол к ужину.",
                                "zh": "请把桌上的<w>针线活</w>挪开，我们要摆放晚餐了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "needlework",
                        "work"
                    ],
                    "common_phrases": [
                        "take up sewing",
                        "put down sewing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет одежды или кусок ткани, над которым в данный момент работают иглой и ниткой.",
                        "zh": "正在用针线进行缝制工作的衣物或布料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шитьё",
                                "target_lang_sense_clarification": "вещь в процессе работы"
                            },
                            {
                                "target_lang_word": "рукоделие",
                                "target_lang_sense_clarification": "работа руками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "针线活",
                                "target_lang_sense_clarification": "指正在进行中的缝制工作"
                            },
                            {
                                "target_lang_word": "缝制品",
                                "target_lang_sense_clarification": "指正在缝制中的物品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19605cb4-c24d-33d3-a60c-4c4d743a5dec",
                    "sense_definition": "Present participle and gerund of <w>sew</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>sewing</w> a patch onto his favorite pair of jeans.",
                            "target_lang_translations": {
                                "ru": "В данный момент он <w>пришивает</w> заплатку на свои любимые джинсы.",
                                "zh": "他正在往他最爱的那条牛仔裤上<w>缝</w>补丁。"
                            }
                        },
                        {
                            "text": "They spent the afternoon <w>sewing</w> costumes for the school play.",
                            "target_lang_translations": {
                                "ru": "Они провели день за <w>шитьём</w> костюмов для школьного спектакля.",
                                "zh": "他们花了一下午的时间为学校的话剧<w>缝制</w>服装。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stitching"
                    ],
                    "common_phrases": [
                        "sewing a button",
                        "sewing clothes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола sew (шить).",
                        "zh": "动词 sew 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шить",
                                "target_lang_sense_clarification": "создавать или чинить одежду"
                            },
                            {
                                "target_lang_word": "пришивать",
                                "target_lang_sense_clarification": "прикреплять нитками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缝",
                                "target_lang_sense_clarification": "用针线连接或修补"
                            },
                            {
                                "target_lang_word": "缝制",
                                "target_lang_sense_clarification": "制作衣物"
                            }
                        ]
                    }
                }
            ]
        }
