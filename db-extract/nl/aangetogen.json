                        "examples": [
                            {
                                "example_id": "f2da0bc9-345a-47eb-bb85-f6130428022b",
                                "sense_id": "994dda8e-0355-38ef-bb06-c5417aaf9e28",
                                "text": "Enige ogenblikken later kwamen de Franse heren met hun wapens aangetogen uit het kasteel."
                            },
                            {
                                "example_id": "450c972a-de94-4652-882b-7b4f3a18c047",
                                "sense_id": "994dda8e-0355-38ef-bb06-c5417aaf9e28",
                                "text": "Een witte nachtkolder aangetogen hebbende, liep zij in een diepe bedenking heen en weer in de kamer, en liet niet de minste lust tot slapen blijken: haar vlammende ogen dwaalden halsstarrig rond."
                            },
                            {
                                "example_id": "93494e09-145a-4481-8bbf-ac7683d14328",
                                "sense_id": "994dda8e-0355-38ef-bb06-c5417aaf9e28",
                                "text": "Ik heb het harnas aangetogen en nu blijft het aan mijn lichaam, tot de dag der verlossing; - ik vecht met mijn neef Gwyde en wil van geen uitstel horen."
                            }
                        ]
                    }
