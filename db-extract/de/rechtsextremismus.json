                "senses": [
                    {
                        "sense_id": "345a4325-fc0f-36c0-b715-9ad5e87c9450",
                        "entry_id": "89912eca-811b-3be9-9e87-99bee535ab22",
                        "glosses": [
                            "Sammelbezeichnung für politische Handlungsweisen und Ideologien, welche den demokratischen Verfassungsstaat ablehnen und durch eine, in der eigenen Terminologie so genannte „Volksgemeinschaft“ ersetzen wollen, die auf das eigene Volk, eine Nation oder Rasse bezogen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d78fe6a8-87aa-4a75-aeb4-154b0fc13878",
                                "sense_id": "345a4325-fc0f-36c0-b715-9ad5e87c9450",
                                "text": "Rechtsextremismus ist häufig ein Problem in Gebieten mit hoher Arbeitslosigkeit."
                            },
                            {
                                "example_id": "4df995a1-a732-48c0-997e-3f8f075b005e",
                                "sense_id": "345a4325-fc0f-36c0-b715-9ad5e87c9450",
                                "text": "„Die Schieflage in der Auseinandersetzung mit Rechts- und Linksextremismus ist ein Symptom, das ebenso auf andere gesellschaftliche Bereiche zutrifft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
