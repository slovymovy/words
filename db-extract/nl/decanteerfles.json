                        "sense_id": "19a3fa5b-ab6a-3727-a303-a80b74d40644",
                        "entry_id": "35bfc9b7-0c52-3f73-9af5-3f1ad259f98c",
                        "glosses": [
                            "fles waarin men wijn overschenk tijdens het decanteren van (oude) wijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ca0d6f-398d-47bd-a774-413237199e02",
                                "sense_id": "19a3fa5b-ab6a-3727-a303-a80b74d40644",
                                "text": "Minstens zo opvallend is wat er in een volgende zaal gebeurt: de embryo’s worden geïmplanteerd in een varkensbaarmoeder, in een decanteerfles gevuld met surrogaatbloed. Etiketten geven de herkomst van de embryo’s aan, terwijl ze onder zachtrood licht heen en weer schudden."
                            },
                            {
                                "example_id": "576aa7d2-20e1-49ab-b43a-b11e0d48c21d",
                                "sense_id": "19a3fa5b-ab6a-3727-a303-a80b74d40644",
                                "text": "Een 156 jaar oude porto van het merk Niepoort, herbotteld in een kristallen decanteerfles van het Franse glaskunstbedrijf Lalique, is op een veiling in Hongkong (figuurlijk) onder de hamer gegaan voor 1,054 miljoen Hongkongse dollar, omgerekend 118.950 euro. Goed voor een nieuw wereldrecord."
                            }
                        ]
                    }
