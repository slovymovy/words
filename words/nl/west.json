                {
                    "sense_id": "1002a10d-901f-3caf-84cc-703d03711099",
                    "sense_definition": "De windstreek waar de zon ondergaat, tegenover het oosten.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "direction_cardinal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De storm beweegt zich langzaam van oost naar <w>west</w>.",
                            "target_lang_translations": {
                                "en": "The storm moves slowly from east to <w>west</w>.",
                                "ru": "Шторм медленно движется с востока на <w>запад</w>.",
                                "pl": "Burza przemieszcza się powoli ze wschodu na <w>zachód</w>.",
                                "de": "Der Sturm bewegt sich langsam von Osten nach <w>Westen</w>.",
                                "fr": "La tempête se déplace lentement de l'est vers l'<w>ouest</w>.",
                                "it": "La tempesta si muove lentamente da est a <w>ovest</w>.",
                                "cs": "Bouře se pomalu pohybuje od východu na <w>západ</w>.",
                                "tr": "Fırtına doğudan <w>batıya</w> doğru yavaşça ilerliyor.",
                                "es": "La tormenta se mueve lentamente de este a <w>oeste</w>."
                            }
                        },
                        {
                            "text": "Deze traditie is in zowel oost als <w>west</w> bekend.",
                            "target_lang_translations": {
                                "en": "This tradition is known in both east and <w>west</w>.",
                                "ru": "Эта традиция известна как на востоке, так и на <w>западе</w>.",
                                "pl": "Ta tradycja jest znana zarówno na wschodzie, jak i na <w>zachodzie</w>.",
                                "de": "Diese Tradition ist sowohl im Osten als auch im <w>Westen</w> bekannt.",
                                "fr": "Cette tradition est connue aussi bien à l'est qu'à l'<w>ouest</w>.",
                                "it": "Questa tradizione è conosciuta sia a est che a <w>ovest</w>.",
                                "cs": "Tato tradice je známá jak na východě, tak na <w>západě</w>.",
                                "tr": "Bu gelenek hem doğuda hem de <w>batıda</w> bilinir.",
                                "es": "Esta tradición es conocida tanto en el este como en el <w>oeste</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "oost",
                        "oosten"
                    ],
                    "common_phrases": [
                        "oost west, thuis best",
                        "van oost naar west",
                        "noord, oost, zuid, west"
                    ],
                    "target_lang_definitions": {
                        "en": "The cardinal direction where the sun sets, opposite to the east.",
                        "ru": "Сторона света, где заходит солнце, противоположная востоку.",
                        "pl": "Kierunek geograficzny, w którym zachodzi słońce, przeciwny do wschodu.",
                        "de": "Die Haupthimmelsrichtung, in der die Sonne untergeht, gegenüber von Osten.",
                        "fr": "Le point cardinal où le soleil se couche, opposé à l'est.",
                        "it": "Il punto cardinale in cui tramonta il sole, opposto all'est.",
                        "cs": "Světová strana, kde zapadá slunce, opak východu.",
                        "tr": "Güneşin battığı yön, doğunun karşıtı.",
                        "es": "El punto cardinal donde se pone el sol, opuesto al este."
                    },
