                ],
                "senses": [
                    {
                        "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                        "entry_id": "f5bae19a-d68b-3dfc-91d3-64342cbd91f6",
                        "glosses": [
                            "Bewegung in Form von Laufen/Joggen, schnelle Fortbewegung zu Fuß"
                        ],
                        "tags": [
                            "insbesondere",
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "444a7865-b39f-4f06-bd45-fb8c67deac95",
                                "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                                "text": "„Der Work-Out-Modus wird automatisch aktiviert, sobald die Uhr eine Laufaktivität erkennt und misst dann sekündlich Deine Herzfrequenz.“"
                            },
                            {
                                "example_id": "b1f62aa5-db11-426d-b442-f7574ed08ae9",
                                "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                                "text": "„Neben meinen Laufaktivitäten betreibe ich auch Bergski und erwarte, dass ich in den nächsten Wochen in den französischen Alpen von Celergen profitieren werde.“"
                            },
                            {
                                "example_id": "9212c8df-e0a4-4af1-8c73-d63700dfc85b",
                                "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                                "text": "„Insbesondere Sportler, die Sprung- und Laufaktivitäten ausführen, profitieren von einem gezielten Training an der Wadenheben-Maschine.“"
                            },
                            {
                                "example_id": "9baa3b53-6cb7-4f3c-8825-25e3b48b1b07",
                                "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                                "text": "„Der September ist ganz ohne Laufaktivität an mir vorbeigezogen.“"
                            },
                            {
                                "example_id": "7b00eb6c-acb2-4d7f-9209-3fa8f3c04652",
                                "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                                "text": "„Die Suchaktivität ist tagzentriert mit höchster Laufaktivität in den heißen Stunden.“"
                            },
                            {
                                "example_id": "55cd11e7-d717-4536-966a-86cf36297608",
                                "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                                "text": "„Bei vielen Arten ist der Nachweis an besondere Perioden mit hoher Laufaktivität, oft die Fortpflanzungsperiode, gebunden.“"
                            },
                            {
                                "example_id": "36d73472-4f3c-4138-8857-e1d009d1427e",
                                "sense_id": "4f90f835-2e9c-33b7-afca-9f8da954b110",
                                "text": "„Die Ställe werden mit Dauerbeleuchtung niedriger Intensität versehen, um die Futteraufnahme bei geringer Laufaktivität zu erhöhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
