                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сероватый",
                                "target_lang_sense_clarification": "с серым оттенком"
                            },
                            {
                                "target_lang_word": "блёклый",
                                "target_lang_sense_clarification": "неяркий, тусклый"
                            },
                            {
                                "target_lang_word": "приглушённый",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灰调的",
                                "target_lang_sense_clarification": "带灰色的"
                            },
                            {
                                "target_lang_word": "柔和的",
                                "target_lang_sense_clarification": "颜色不刺眼的"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "apagado",
                                "target_lang_sense_clarification": "color sin brillo"
                            },
                            {
                                "target_lang_word": "tenue",
                                "target_lang_sense_clarification": "color suave o poco intenso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c46eadd4-3e68-33c8-b5e7-30ea189c4131",
                    "sense_definition": "Bad, unwell, or inadequate (chiefly used in the negative phrase 'not so dusty').",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "idiom_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am feeling not so <w>dusty</w> today, thank you.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя <w>недурно</w> сегодня, спасибо.",
                                "zh": "我今天感觉<w>还不错</w>，谢谢。",
                                "es": "Me siento <w>nada mal</w> hoy, gracias."
                            }
                        },
                        {
                            "text": "For a beginner, that drawing is not so <w>dusty</w>.",
                            "target_lang_translations": {
                                "ru": "Для новичка этот рисунок не так уж <w>плох</w>.",
                                "zh": "对于初学者来说，那幅画画得<w>还不错</w>。",
                                "es": "Para ser un principiante, ese dibujo no está <w>nada mal</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not so dusty"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly British"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неплохой, сносный (обычно в выражении 'not so dusty').",
                        "zh": "不错的、还可以的（主要用于否定短语）。",
                        "es": "No tan malo, aceptable (usado principalmente en la frase 'not so dusty')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недурный",
                                "target_lang_sense_clarification": "разг. неплохой"
                            },
                            {
                                "target_lang_word": "сносный",
                                "target_lang_sense_clarification": "приемлемый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还不错",
                                "target_lang_sense_clarification": "指状态或质量尚可"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nada mal",
                                "target_lang_sense_clarification": "expresión de aprobación"
                            },
                            {
                                "target_lang_word": "pasable",
                                "target_lang_sense_clarification": "que es aceptable"
                            }
                        ]
                    }
                }
            ]
