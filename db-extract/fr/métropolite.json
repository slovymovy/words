                "senses": [
                    {
                        "sense_id": "be68ec49-3248-395f-86c2-661d56d3fc0d",
                        "entry_id": "8719ea74-3eec-3776-b1a3-c3b5b1f75303",
                        "glosses": [
                            "Titre des évêques ou archevêques dont le siège est une métropole. Dans l'Église grecque, titre porté par tous les évêques."
                        ],
                        "tags": [
                            "Christianisme orthodoxe"
                        ],
                        "examples": [
                            {
                                "example_id": "f812824e-56a0-4c96-808c-a5803c950ba4",
                                "sense_id": "be68ec49-3248-395f-86c2-661d56d3fc0d",
                                "text": "Le précédent métropolite d’Athènes avait jugé bon d'excommunier M. Venizelos"
                            }
                        ]
                    },
                    {
                        "sense_id": "53738bf0-f118-36bb-a470-43534a9957b5",
                        "entry_id": "8719ea74-3eec-3776-b1a3-c3b5b1f75303",
                        "glosses": [
                            "Père spirituel, ou figure principale, d’un courant politique ou artistique."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3f0dd0d3-2733-405f-9b9c-3427702032fc",
                                "sense_id": "53738bf0-f118-36bb-a470-43534a9957b5",
                                "text": "Il détestait les dévotions, pas les égards. C’est peut-être un hommage à l’auteur de Anthologie de l’humour noir. On peut d’ailleurs en discuter : chez le métropolite de l’Église surréaliste, l’esprit de sérieux et parfois la vanité l’emportaient sur le sens de l’humour."
                            }
                        ]
                    }
