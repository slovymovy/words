                ],
                "senses": [
                    {
                        "sense_id": "a6f282a0-85b3-3e74-a1f9-bfb01252dd96",
                        "entry_id": "3355cacd-43a4-3c14-8648-595c6765014f",
                        "glosses": [
                            "konkrete Gestaltung eines Druckerzeugnisses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f01317-56a9-4fa0-9ba4-e62de122bf43",
                                "sense_id": "a6f282a0-85b3-3e74-a1f9-bfb01252dd96",
                                "text": "„Über Joplins Porsche hängt der Esso-Schriftzug, rot in blauem Kreis, daneben, gleicher Kreis, gleiche Typo, der Schriftzug LSD.“"
                            },
                            {
                                "example_id": "32039747-cc1f-48bc-8456-465c7edd2237",
                                "sense_id": "a6f282a0-85b3-3e74-a1f9-bfb01252dd96",
                                "text": "„Als er in den 50er Jahren als Schriftsetzerlehrling eingetreten sei, habe er nicht geglaubt, dass er einmal die Typo abwickeln würde.“"
                            },
                            {
                                "example_id": "bf7b3215-95a1-4e6c-9e6f-fa52ce0010f0",
                                "sense_id": "a6f282a0-85b3-3e74-a1f9-bfb01252dd96",
                                "text": "„Du musst an jeden Kabelanschluss denken, an jede Farbe, an die Typo, an das Hauptthema.“"
                            },
                            {
                                "example_id": "084963c1-0b20-421f-93e8-fdb1dc40721f",
                                "sense_id": "a6f282a0-85b3-3e74-a1f9-bfb01252dd96",
                                "text": "„Für das neue Trikot haben die Kollegen von ‚11Teamsports‘ eine eigene Typo entwickelt und zusammen mit dem DFB abgestimmt.“"
                            },
                            {
                                "example_id": "6bcd5d2e-bdd2-463a-a4fb-516dbf734858",
                                "sense_id": "a6f282a0-85b3-3e74-a1f9-bfb01252dd96",
                                "text": "„Passend zum Thema des Fotobuches kann man auch mit der Typo spielen: Die Schrift zur Sommerreise wirkt kursiv gesetzt schwerelos, Serifenschriften zur Hochzeit sehen immer elegant aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
