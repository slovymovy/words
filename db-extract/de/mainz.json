                "senses": [
                    {
                        "sense_id": "90e7e0e3-db29-3f0c-8f2a-e9de022ded7d",
                        "entry_id": "cd0ee08c-2414-3044-af4a-81b23853845d",
                        "glosses": [
                            "Mayence (ville allemande)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47491e65-9cc1-4db4-8c28-b1cebdd207b8",
                                "sense_id": "90e7e0e3-db29-3f0c-8f2a-e9de022ded7d",
                                "text": "Der alte freie Weg nach Mainz war gesperrt, ich mußte über die Schiffbrücke bei Rüsselsheim; in Ginsheim ward gefüttert; der Ort ist sehr zerschossen; dann über die Schiffbrücke auf die Nonnenaue, wo viele Bäume niedergehauen lagen, sofort auf dem zweiten Teil der Schiffbrücke über den größern Arm des Rheins. (Goethe, Belagerung von Mainz, z.n. Projekt Gutenberg)"
                            }
                        ]
                    }
