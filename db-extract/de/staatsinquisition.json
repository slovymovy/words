                ],
                "senses": [
                    {
                        "sense_id": "17f9657e-933a-362e-b8ae-185a99e86fc0",
                        "entry_id": "8524393a-b2e5-3c40-b992-28af70b0eb2e",
                        "glosses": [
                            "politisches Polizei- und Gerichtsorgan in der Republik Venedig, das für Staatsverbrechen wie Hochverrat, Spionage, Geheimnisverrat oder Konspiration jeglicher Art zuständig war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "006cdabf-8b1f-4edb-8816-9a753305c099",
                                "sense_id": "17f9657e-933a-362e-b8ae-185a99e86fc0",
                                "text": "„In Venedig ging die ganze Staatsgewalt in die Hand einer streng geschlossenen Oligarchie über, welche die Macht des auf Lebenszeit gewählten Dogen und selbst die des Großen Rats, der Siguorie, gänzlich einschränkte und sich mit Hülfe einer furchtbaren Staatsinquisition behauptete.“"
                            },
                            {
                                "example_id": "84a4cc54-e507-442b-9d51-0c24fc3ed0ff",
                                "sense_id": "17f9657e-933a-362e-b8ae-185a99e86fc0",
                                "text": "„Den vielen Verschwörungen zum Sturze der Aristokratie suchte der Rat der Zehn durch eine Staatsinquisition (mit Foltern und den berüchtigten Bleikammern) entgegen zu treten.“"
                            },
                            {
                                "example_id": "5a5aeac5-c07f-47a7-8d66-392539f26450",
                                "sense_id": "17f9657e-933a-362e-b8ae-185a99e86fc0",
                                "text": "„Auf dem Landungsplatze trafen sie Beamte der Staatsinquisition, welche die Reisenden sorgsam prüften, ihre Papiere forderten und sie langweiligen Formalitäten unterwarfen.“"
                            },
                            {
                                "example_id": "fe6cf1ff-d83c-40b4-8789-2c15896d32f7",
                                "sense_id": "17f9657e-933a-362e-b8ae-185a99e86fc0",
                                "text": "„Ferner fand Ranke in Wien bei den venetianischen Akten wichtige Nachrichten über Einsetzung und Wirksamkeit der Staatsinquisition, deren heimliches Gerichtsverfahren der sonst so glänzenden Geschichte der alten Republik Venedig oft zum Vorwurf gemacht worden ist.“"
                            },
                            {
                                "example_id": "a3e53b8a-f1ad-42d0-bb8e-0805e26c6896",
                                "sense_id": "17f9657e-933a-362e-b8ae-185a99e86fc0",
                                "text": "„Der Rath der Zehn und die Staatsinquisition war mehr gegen das Gelüste junger Adligen, die Herrschaft zu erringen, als gegen die durch Handel und Fabriken (namentlich in Glas) schnell zu Wohlstand gelangende Volksmasse gerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
