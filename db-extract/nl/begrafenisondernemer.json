                                        "sense_id": "dd539785-eab3-3936-bf2a-f5146a4b4d85",
                                        "entry_id": "2d3edd3b-4856-3f4e-9f8c-5b19872e2aa5",
                                        "glosses": [
                                            "An undertaker or funeral director; especially, one who is also the embalmer or cremator."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99d0c10-9941-438e-8375-31811a7c8308",
                                                "sense_id": "dd539785-eab3-3936-bf2a-f5146a4b4d85",
                                                "text": "“And I prefer mortician to funeral director. It sounds more professional and, well, it is more precise. I deal with more than mere funerals; I deal with death, passing on, the transition.”"
                                            }
                                        ]
                                    }
                                ]
