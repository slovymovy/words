        "nl-extract.jsonl": [
            {
                "entry_id": "7e2ab756-18d8-31e6-87cd-251dd394a60e",
                "word": "krassend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a9dd09c-5849-37ef-8a3f-28050a8ce767",
                        "entry_id": "7e2ab756-18d8-31e6-87cd-251dd394a60e",
                        "glosses": [
                            "kleine, langwerpige insnijdingen makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adccd749-3a97-41fd-abeb-c0106f9eca11",
                                "sense_id": "8a9dd09c-5849-37ef-8a3f-28050a8ce767",
                                "text": "Mijn bezorgdheid dat ik als krassende kluns tussen de echte schaatsers rechtsom zou moeten, groeide in de kleedkamer naast de ijsbaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "20423fea-4dda-38db-8a5a-a1067d7b38b9",
                        "entry_id": "7e2ab756-18d8-31e6-87cd-251dd394a60e",
                        "glosses": [
                            "met schrijfgerei lelijke, lange strepen makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c759b398-12a3-4f5e-9987-ce7514b3c5ae",
                                "sense_id": "20423fea-4dda-38db-8a5a-a1067d7b38b9",
                                "text": "Maar goed, als je voor 1750 euro een mooi pdf'je krijgt waarin je kunt lezen hoe je scoort op zaken als alignment (mijn zoontje scoorde daar als krassende peuter slecht op) en rolduidelijkheid (bij mij thuis doen we het velletje over de bovenkant van de wc-rol, niet onderlangs), dan is dat natuurlijk een superinvestering. Zeker als blijkt dat organisaties die goed scoren op eigenaarschap beter presteren dan organisaties die daar slecht op scoren."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9b34bce-8626-32fd-afda-215830fdd68d",
                        "entry_id": "7e2ab756-18d8-31e6-87cd-251dd394a60e",
                        "glosses": [
                            "lelijk, scherp geluid makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f79112c1-d51b-424f-89a8-dd38a94ec144",
                                "sense_id": "b9b34bce-8626-32fd-afda-215830fdd68d",
                                "text": "Voor de een is de harmonica een gruwel. Een instrument dat onophoudelijk gejengel uitstoot. Het muzikale equivalent van krassende nagels over een schoolbord."
                            },
                            {
                                "example_id": "6e36ab13-36f8-4e14-97aa-8c1370fe5b35",
                                "sense_id": "b9b34bce-8626-32fd-afda-215830fdd68d",
                                "text": "De verblijfplaats van een vleermuis is moeilijk vast te stellen. Ze maken soms, voor volwassenen nauwelijks hoorbare, krassende geluidjes of laten poepjes op vensterbank of muur achter. Vleermuizen worden veelal in de avondschemer gezien, als mensen op het terras of in hun tuin zitten."
                            }
                        ]
                    }
