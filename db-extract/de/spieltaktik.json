                ],
                "senses": [
                    {
                        "sense_id": "7d46c5ff-811f-3a91-b81c-a10bd65aa3d6",
                        "entry_id": "b48b3730-f7d4-3677-8932-051d3cc959d5",
                        "glosses": [
                            "systematisches, zielgerichtetes Vorgehen bei einem Spielgeschehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a436d8a6-bd00-4691-bd51-cd687ba563af",
                                "sense_id": "7d46c5ff-811f-3a91-b81c-a10bd65aa3d6",
                                "text": "„Und doch hängt es von einem nicht unwesentlichen Teil vom Menschen bzw. seiner Spieltaktik ab, was er aus diesen Prämissen zu seinem Vorteil wenden, was er aus ihnen herausholen kann.“"
                            },
                            {
                                "example_id": "4520a48c-9204-483a-ab99-784237841364",
                                "sense_id": "7d46c5ff-811f-3a91-b81c-a10bd65aa3d6",
                                "text": "„Zur Didaktik der Spielerziehung gehört nicht nur die lernende Vermittlung der Spieltechnik und Spieltaktik und die Sicherung eines Spielrahmens, der dem Wesen des Spiels gerecht wird.“"
                            },
                            {
                                "example_id": "12c92828-5d2b-44e7-a253-50e316f8cad0",
                                "sense_id": "7d46c5ff-811f-3a91-b81c-a10bd65aa3d6",
                                "text": "„Das Spiel ließe sich jedoch auch im Hinblick auf Sportspielelemente weiterentwickeln, indem mit den Kindern Spieltaktiken entwickelt werden, die bewusste Zusammenarbeit erfordern.“"
                            },
                            {
                                "example_id": "f66f65a7-2171-4458-bccc-54d9d3140cf3",
                                "sense_id": "7d46c5ff-811f-3a91-b81c-a10bd65aa3d6",
                                "text": "„Wir werden Ihnen im Folgenden eine Reihe von Legespielen vorstellen, insbesondere das Tangram analysieren und dabei auf allgemeine Spieltaktiken stoßen, die auf andere Spiele übertragbar sind.“"
                            },
                            {
                                "example_id": "72bffbcd-72ab-43e8-a304-ba09f13b60c0",
                                "sense_id": "7d46c5ff-811f-3a91-b81c-a10bd65aa3d6",
                                "text": "„Die Spieltaktik von Pep Guardiola ist bekannt, sie war immer sehr dominant, das war schon in Barcelona der Fall und das hat er jetzt auch bei uns mit großem Erfolg eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
