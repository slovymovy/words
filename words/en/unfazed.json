{
    "word_family": [
        "faze"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fcd07dda-c46a-3e69-9baf-ec7984e2c89b",
                    "sense_definition": "Not confused, worried, or shocked by something unexpected or unpleasant; calm and undisturbed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the harsh criticism from the audience, the speaker seemed completely <w>unfazed</w>.",
                            "target_lang_translations": {
                                "es": "A pesar de las duras críticas del público, el orador parecía completamente <w>impertérrito</w>."
                            }
                        },
                        {
                            "text": "The experienced pilot remained <w>unfazed</w> by the sudden turbulence.",
                            "target_lang_translations": {
                                "es": "El experimentado piloto permaneció <w>imperturbable</w> ante la repentina turbulencia."
                            }
                        }
                    ],
                    "synonyms": [
                        "undaunted",
                        "unperturbed",
                        "unruffled",
                        "unmoved"
                    ],
                    "antonyms": [
                        "fazed"
                    ],
                    "common_phrases": [
                        "completely unfazed",
                        "remain unfazed",
                        "seem unfazed",
                        "largely unfazed"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no se perturba, preocupa ni desconcierta ante algo inesperado o desagradable; calmado y sereno."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "impertérrito",
                                "target_lang_sense_clarification": "sereno y sin inmutarse ante una dificultad"
                            },
                            {
                                "target_lang_word": "imperturbable",
                                "target_lang_sense_clarification": "que mantiene la calma bajo presión"
                            },
                            {
                                "target_lang_word": "impávido",
                                "target_lang_sense_clarification": "que no muestra miedo o turbación"
                            },
                            {
                                "target_lang_word": "inmutable",
                                "target_lang_sense_clarification": "que permanece inalterable ante los hechos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74d791eb-bf59-3bff-b967-343a7a22f214",
                    "sense_definition": "Not damaged or impaired; unharmed by difficult conditions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sturdy brick wall stood <w>unfazed</w> by decades of stormy coastal weather.",
                            "target_lang_translations": {
                                "es": "El robusto muro de ladrillos permaneció <w>intacto</w> tras décadas de tormentoso clima costero."
                            }
                        },
                        {
                            "text": "Despite running across sharp rocks, the ancient wheels remained entirely <w>unfazed</w>.",
                            "target_lang_translations": {
                                "es": "A pesar de rodar sobre rocas afiladas, las antiguas ruedas permanecieron totalmente <w>indemnes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "undamaged",
                        "unharmed",
                        "intact"
                    ],
                    "common_phrases": [
                        "unfazed by time"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no ha sufrido daño o alteración; intacto o inalterado frente a condiciones difíciles."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "intacto",
                                "target_lang_sense_clarification": "sin haber sufrido daño o desgaste"
                            },
                            {
                                "target_lang_word": "inalterado",
                                "target_lang_sense_clarification": "que permanece igual a pesar de las adversidades"
                            },
                            {
                                "target_lang_word": "indemne",
                                "target_lang_sense_clarification": "libre de daño o perjuicio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}