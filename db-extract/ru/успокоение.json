                                        "examples": [
                                            {
                                                "example_id": "32a836a0-5bdb-4850-89b9-5a1171f9e9ff",
                                                "sense_id": "1347679f-dc6b-36d4-81f4-d3b51c285ee8",
                                                "text": "The Proteſtants in their Anſwer acknowledged the good-will of the Emperor their Chief, and ſhewed, that the Catholicks ahd oppreſſed them, contrary to the Pacification"
                                            },
                                            {
                                                "example_id": "bff250ef-3080-413e-a154-9246c3ef50ad",
                                                "sense_id": "1347679f-dc6b-36d4-81f4-d3b51c285ee8",
                                                "text": "The electrification of the lines radiating from Casablanca originated with the policy of economic penetration and conciliation pursued by Marshal Lyautey for the pacification of Morocco."
                                            }
