                "translations": [
                    {
                        "translation_id": "5005eb19-0ae8-45ab-a109-555aa984e1b6",
                        "source_entry_id": "1a3586cc-80ae-3c3a-8f56-7cd146e73238",
                        "source_sense_id": "6f7d3705-5a3d-3da8-b631-1819856b73a0",
                        "source_sense_description": "mittelalterlicher Schiffstyp",
                        "target_lang_word": "houlque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "houlque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ccab3fa-0202-3003-be60-80d63c14303d",
                                        "entry_id": "e9426051-e006-3302-8f4a-31008b4b5532",
                                        "glosses": [
                                            "Nom vernaculaire donné à diverses plantes du genre Holcus de la famille des Poaceae (graminées), utilisées en tant que plantes fourragère ou ornementale, elle ressemble à l’avoine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170a6590-ef46-4a42-970a-544e574aba5d",
                                                "sense_id": "4ccab3fa-0202-3003-be60-80d63c14303d",
                                                "text": "Elle écoute longuement le silence de la clairière. Puis elle leur emboîte le pas. Ils marchent le long d’une grande haie de ronces parviflores parmi les tiges de houlques laineuses et les flouves douces et odorantes."
                                            },
                                            {
                                                "example_id": "f04dfe4c-c8f4-4608-94b4-9cfb5f8d6b57",
                                                "sense_id": "4ccab3fa-0202-3003-be60-80d63c14303d",
                                                "text": "Sur des tombeaux aux façades lépreuses, ornées de silhouettes enchâssées et envahies par la menthe sauvage, la houlque et le sisymbre, on devinait des formes dissoutes dans le tanin du marbre blanc, des formes infiniment pures qui amorçaient un dialogue avec la mémoire du monde."
                                            },
                                            {
                                                "example_id": "a8aa8c0c-74c4-4942-8c29-0f43e253c1df",
                                                "sense_id": "4ccab3fa-0202-3003-be60-80d63c14303d",
                                                "text": "Certaines espèces de houlques sont cultivées sous le nom d’avoine."
                                            },
                                            {
                                                "example_id": "4d51534d-99e3-4995-854a-2de542c4972e",
                                                "sense_id": "4ccab3fa-0202-3003-be60-80d63c14303d",
                                                "text": "La chenille de l’hespérie de la houlque se nourrit sur des graminées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63fae12f-1ace-336a-b77d-0b40050bf651",
                                        "entry_id": "e9426051-e006-3302-8f4a-31008b4b5532",
                                        "glosses": [
                                            "Type de voilier médiéval du Nord de l’Europe, qui a précédé les caraques et caravelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36473be8-1c06-4f86-a47d-937392306079",
                                                "sense_id": "63fae12f-1ace-336a-b77d-0b40050bf651",
                                                "text": "D’autre part, c’est la relation des navires – houlques et cogues – à l’espace nautique frison qui soutiendra notre analyse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
