                "senses": [
                    {
                        "sense_id": "dec8afb3-fbc3-3856-9c73-58c6ceb35ec0",
                        "entry_id": "27059f17-250a-3bd6-bb17-f7b236f568f0",
                        "glosses": [
                            "вложить, сунуть во что-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb767c4-d621-4fe8-b935-e72e73cdec55",
                                "sense_id": "dec8afb3-fbc3-3856-9c73-58c6ceb35ec0",
                                "text": "Всунуть ложку в рот."
                            },
                            {
                                "example_id": "8d966133-6221-4a6d-96a0-b8c42f0fecf2",
                                "sense_id": "dec8afb3-fbc3-3856-9c73-58c6ceb35ec0",
                                "text": "А для чего это он цикорного кофею всунул? Я не пью. Кофей вредно пить… На нервы действует…"
                            },
                            {
                                "example_id": "92657abd-fcfb-467d-a275-da119460041a",
                                "sense_id": "dec8afb3-fbc3-3856-9c73-58c6ceb35ec0",
                                "text": "Всунуть платок в карман."
                            },
                            {
                                "example_id": "cd6e949d-5633-40f9-bb58-d8da60f70b9d",
                                "sense_id": "dec8afb3-fbc3-3856-9c73-58c6ceb35ec0",
                                "text": "Всунуть руки в карман."
                            }
                        ]
                    }
