                        "glosses": [
                            "Colchique, plante bulbeuse qui croît dans les prés humides, également cultivée dans les jardins."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1e18f552-c524-4135-8cec-78bdef0ecaf9",
                                "sense_id": "c1ec2c34-3752-38d5-a87e-a9eac35efa70",
                                "text": "Dans les jardins fleur on sème & on plante les ambrettes, ancolies, anémones, argémones ; les campanules, chamétis chardon Roland, cyanus de toutes sortes, cyclamens, colchides, coquelicot & couronne Impériale."
                            },
                            {
                                "example_id": "265c3c60-6e44-4aa0-8a9a-05326ac88727",
                                "sense_id": "c1ec2c34-3752-38d5-a87e-a9eac35efa70",
                                "text": "L’EFFEUILLAISON, defoliatio, est la chute des feuilles, ordinairement annoncée par la floraison de la colchide."
                            }
                        ]
                    }
