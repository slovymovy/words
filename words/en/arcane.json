{
    "word_family": [
        "arcanum"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6891a6a3-f6cc-33a2-b341-f16ff0017ac7",
                    "sense_definition": "Understood or known by only a small number of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mysterious_knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor shared <w>arcane</w> details about the ancient civilization.",
                            "target_lang_translations": {
                                "zh": "教授分享了关于这个古代文明<w>鲜为人知</w>的细节。"
                            }
                        },
                        {
                            "text": "Only a few scholars possess such <w>arcane</w> knowledge of the subject.",
                            "target_lang_translations": {
                                "zh": "只有少数几位学者掌握该学科如此<w>深奥的</w>知识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "esoteric",
                        "recondite",
                        "obscure"
                    ],
                    "antonyms": [
                        "accessible",
                        "well-known"
                    ],
                    "common_phrases": [
                        "arcane knowledge",
                        "arcane rituals"
                    ],
                    "target_lang_definitions": {
                        "zh": "仅少数人知晓或理解的；深奥的、晦涩难懂的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "深奥的",
                                "target_lang_sense_clarification": "指知识或理论幽深不易懂，仅少数人掌握"
                            },
                            {
                                "target_lang_word": "晦涩的",
                                "target_lang_sense_clarification": "指内容隐晦难懂，不广为人知"
                            },
                            {
                                "target_lang_word": "不为人知的",
                                "target_lang_sense_clarification": "指信息或细节知者甚少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68e6e47c-fed8-3d4f-a301-4c5f66ad22b7",
                    "sense_definition": "Difficult to understand or mysterious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mysterious_knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book is filled with <w>arcane</w> symbols that are hard to interpret.",
                            "target_lang_translations": {
                                "zh": "书中充斥着难以解读的<w>神秘</w>符号。"
                            }
                        },
                        {
                            "text": "He explained the <w>arcane</w> origins of the local tradition.",
                            "target_lang_translations": {
                                "zh": "他解释了当地传统那令人费解的<w>神秘</w>起源。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enigmatic",
                        "dark",
                        "mystic",
                        "occult"
                    ],
                    "antonyms": [
                        "mundane",
                        "open"
                    ],
                    "common_phrases": [
                        "arcane origins"
                    ],
                    "target_lang_definitions": {
                        "zh": "神秘的；难以捉摸或解释的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "神秘的",
                                "target_lang_sense_clarification": "指充满谜团、难以捉摸"
                            },
                            {
                                "target_lang_word": "玄奥的",
                                "target_lang_sense_clarification": "指深邃奥妙、带有神秘色彩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dfd476d-bf4b-3fab-bbb1-8c0290bca389",
                    "sense_definition": "Extremely old and often no longer useful or relevant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company still follows an <w>arcane</w> law from the nineteenth century.",
                            "target_lang_translations": {
                                "zh": "这家公司仍遵循着一条源自19世纪的<w>过时</w>法规。"
                            }
                        },
                        {
                            "text": "They struggled to update the <w>arcane</w> computer system.",
                            "target_lang_translations": {
                                "zh": "他们费了好大劲才对那套<w>陈旧的</w>计算机系统完成更新。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arcane law"
                    ],
                    "target_lang_definitions": {
                        "zh": "过时的；陈旧繁琐且不再适用的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过时的",
                                "target_lang_sense_clarification": "指法规或系统年代久远且不再适用"
                            },
                            {
                                "target_lang_word": "陈旧的",
                                "target_lang_sense_clarification": "指系统或规定古老且不合时宜"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}