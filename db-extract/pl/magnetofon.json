                    },
                    {
                        "translation_id": "f1c37185-9c37-45a6-a89c-a9140b9f719b",
                        "source_entry_id": "86f052e8-66c5-39d2-aab8-6b5b5c0b6978",
                        "source_sense_id": "f7bd5f0b-cd34-3a16-a290-4e64092b7341",
                        "target_lang_word": "Tonbandgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tonbandgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                        "entry_id": "ff79a021-a166-341e-a42e-a0e3350321e7",
                                        "glosses": [
                                            "ein Gerät, mit dem man Geräusch-, Sprach- oder Musikaufnahmen auf sogenannten Tonbändern herstellen und abhören kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c99856a-8946-4aa8-b98e-a78c9c7be1c6",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„In der fünften Klasse kam der Schuldirektor meiner sowjetischen Schule mitten im Unterricht mit einem großen Tonbandgerät und einem Mikrofon zu uns in die Klasse.“"
                                            },
                                            {
                                                "example_id": "7c74d3bd-624a-4a6e-b461-7a56c8eb7f74",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Neben ihr saß Miss Carey vor einem Klapptischchen, auf dem das Tonbandgerät stand.“."
                                            },
                                            {
                                                "example_id": "802ab761-fcda-41e6-9344-c6dcf216ad07",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Inzwischen hatte sich der Tombolatisch bis auf ein paar Plüschtiere, eine LP und das Tonbandgerät geleert.“"
                                            },
                                            {
                                                "example_id": "bb06f586-840b-4957-8f5a-c045381d131d",
                                                "sense_id": "778d5501-9852-382d-8ece-1d01e01e1e98",
                                                "text": "„Im Schrank erwarteten mich, gut verpackt, ein Tonbandgerät und ein Fotoapparat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc1189ea-3d52-437a-8012-c0eaed932732",
                        "source_entry_id": "86f052e8-66c5-39d2-aab8-6b5b5c0b6978",
                        "source_sense_id": "f7bd5f0b-cd34-3a16-a290-4e64092b7341",
                        "target_lang_word": "магнитофо́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "магнитофо́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e5383838-659d-372c-bec1-ab7b8ecfc3c3",
                                        "entry_id": "29299f53-02c3-3fb0-851c-2decfcee5b06",
                                        "glosses": [
                                            "электромеханический прибор для записи звуковой информации на магнитный носитель и/или её воспроизведения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb259c2-c5bb-438f-b419-30d38dfc4f1f",
                                                "sense_id": "e5383838-659d-372c-bec1-ab7b8ecfc3c3",
                                                "text": "Много он говорил о новом способе записи: магнитофоне."
                                            },
                                            {
                                                "example_id": "a56186fb-7a41-4fd1-9981-e991a4a2b69f",
                                                "sense_id": "e5383838-659d-372c-bec1-ab7b8ecfc3c3",
                                                "text": "Магнитофон хорош тем, что сохраняет не только слова, но и интонацию, которая иногда усиливает и подчёркивает сказанное, иногда придаёт словам обратный смысл."
                                            },
                                            {
                                                "example_id": "696b9067-e257-4963-bd03-5074dee4939e",
                                                "sense_id": "e5383838-659d-372c-bec1-ab7b8ecfc3c3",
                                                "text": "Радио не работало, зато из купе, где жил Авель, неслась тягостная музыка: играл маленький магнитофон."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
