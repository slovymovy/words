                                    {
                                        "sense_id": "ccc5ecc3-b020-38f0-83d0-0342cfedb375",
                                        "entry_id": "5f5b48dc-8c01-3463-b3fe-ba08f9f0f960",
                                        "glosses": [
                                            "A program that outputs the contents of storage or a data structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600218de-4a63-49b7-ad70-4a26c6ff3512",
                                                "sense_id": "ccc5ecc3-b020-38f0-83d0-0342cfedb375",
                                                "text": "Protected programs implement various measures of counteraction against debuggers, disassemblers, dumpers, and other hacker tools."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54496bcd-46c3-3e3c-b610-7873a785577a",
                                        "entry_id": "5f5b48dc-8c01-3463-b3fe-ba08f9f0f960",
                                        "glosses": [
                                            "A person's buttocks."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
