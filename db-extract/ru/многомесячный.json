                                        "glosses": [
                                            "trwający wiele miesięcy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "943bfacb-d167-4249-ba4f-c19a5f0a7372",
                                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                                "text": "Bogaty wujek zapłacił za wielomiesięczną opiekę medyczną swojego siostrzeńca."
                                            },
                                            {
                                                "example_id": "73a2140f-69df-489a-9be8-07980f6a1d4a",
                                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                                "text": "Wielomiesięczne śledztwo nie przyniosło oczekiwanych rezultatów."
                                            },
                                            {
                                                "example_id": "d1abe157-6287-4d1a-9dd3-07b4297c86f7",
                                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                                "text": "Budowa portu była poprzedzona wielomiesięcznymi przygotowaniami."
                                            },
                                            {
                                                "example_id": "8bad2eb1-ca95-4c37-9c91-8c3d9b0f3650",
                                                "sense_id": "e8a9502b-9913-3e88-a7f9-e4660643889c",
                                                "text": "Rozporządzenie podpisano po wielomiesięcznej dyskusji międzyresortowej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
