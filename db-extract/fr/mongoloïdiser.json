                "senses": [
                    {
                        "sense_id": "c64e674b-04cd-32de-8ba6-65aa9c34fa17",
                        "entry_id": "429f4413-9aaa-3b4f-b4b3-df420eafac21",
                        "glosses": [
                            "Donner un caractère mongoloïde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "980defd7-648d-416a-a122-50e094269d8b",
                                "sense_id": "c64e674b-04cd-32de-8ba6-65aa9c34fa17",
                                "text": "Pourquoi le paysan kolkhozien, même mongoloïdisé par dix siècles de servage et trente ans de télé, vendrait-il ses tomates pour 2 kopecks au circuit socialiste, alors qu’il peut les céder quinze fois plus cher au trafiquant mafieutisé ?"
                            },
                            {
                                "example_id": "d36fe502-6e3b-41c4-a99a-28c803521a57",
                                "sense_id": "c64e674b-04cd-32de-8ba6-65aa9c34fa17",
                                "text": "Vous figurez-vous, cher ami, qu'ils eussent pu être ainsi mongoloïdisés totalement par quelque voisins paléoasiatiques voraces du grand nord sans que cela n'entrainât le moindre changement linguistique et sans que cela ne laissât la moindre trace europoïde ?"
                            },
                            {
                                "example_id": "ab0b95d4-882c-44be-93cd-e1b6ecd161f1",
                                "sense_id": "c64e674b-04cd-32de-8ba6-65aa9c34fa17",
                                "text": "Faut mongoloïdiser un max de monde et niveler par le bas."
                            }
                        ]
                    }
