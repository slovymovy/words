                ],
                "senses": [
                    {
                        "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                        "entry_id": "32d4cffc-579d-3d5a-b4c9-8a8d9cffa866",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4719b34-725f-46ac-b76e-36a557d32a6c",
                                "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                                "text": "Frau Götzcke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "593488ca-20c2-4aa6-a6cf-452257c1a813",
                                "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                                "text": "Herr Götzcke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0329822e-4bbe-4c7e-b7d5-d39e15da218b",
                                "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                                "text": "Die Götzckes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0941f60c-3387-4ca5-b6d9-9dd54e61cc09",
                                "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                                "text": "Der Götzcke trägt nie die Schals, die die Götzcke ihm strickt."
                            },
                            {
                                "example_id": "3d6df3ff-3745-4f97-902f-cf2ce3c34833",
                                "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Götzcke kommt, geht der Herr Götzcke.“"
                            },
                            {
                                "example_id": "f2f7647a-9e6c-46eb-b207-94ca32027243",
                                "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                                "text": "Götzcke kommt und geht."
                            },
                            {
                                "example_id": "8cde62ca-a841-4357-a7ef-2e084fe4ba97",
                                "sense_id": "d1dc31ed-67d8-3335-ac76-3ee246727fbd",
                                "text": "Götzckes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
