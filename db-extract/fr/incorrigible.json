                "forms": [],
                "senses": [
                    {
                        "sense_id": "4bcf239b-de88-3b3d-b930-b4fc0479c71c",
                        "entry_id": "a92556e8-6632-3144-9747-b7fa74595607",
                        "glosses": [
                            "Qu’on ne peut corriger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2f55bd8-b2b5-4eff-ac39-2adaac48d1fd",
                                "sense_id": "4bcf239b-de88-3b3d-b930-b4fc0479c71c",
                                "text": "Devoir, composition incorrigible."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6d8d04f-619e-32fa-8715-cc4f9d42527e",
                        "entry_id": "a92556e8-6632-3144-9747-b7fa74595607",
                        "glosses": [
                            "Qui ne se corrige pas ; qui ne s’amende pas, en parlant des personnes et de leurs défauts."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "004a49b4-7efb-4609-bf5c-78afb8bad353",
                                "sense_id": "d6d8d04f-619e-32fa-8715-cc4f9d42527e",
                                "text": "De l’autre côté, quelques-uns parmi nous discutaient s’il fallait ajouter foi aux affirmations du criminel qui s’était montré menteur incorrigible."
                            },
                            {
                                "example_id": "5ba4fe2d-a372-4637-a74a-9f1ee8bd106f",
                                "sense_id": "d6d8d04f-619e-32fa-8715-cc4f9d42527e",
                                "text": "Caradou, le clairon, incorrigible espiègle, lance sur un ton de commandement :\n— « L’ennemi est en fuite. […] »"
                            },
                            {
                                "example_id": "e6c2d148-a907-4d39-b012-b6835944232f",
                                "sense_id": "d6d8d04f-619e-32fa-8715-cc4f9d42527e",
                                "text": "J’avais pensé que, plongée dans sa vie professionnelle, Wendy se déguiserait en jeune femme active comme on en voit dans les pubs à la télé mais, contre cette attente, elle ne se comportait pas autrement que sûrement n’importe où, protégeant son incorrigible romantisme et son cœur de midinette par un zeste de pseudo-froideur et quelques saillies piquées dans le vocabulaire d’un conducteur de mules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f2958f6-d840-4423-a2de-23a4c82d7c41",
                        "source_entry_id": "a92556e8-6632-3144-9747-b7fa74595607",
                        "source_sense_id": "4bcf239b-de88-3b3d-b930-b4fc0479c71c",
                        "source_sense_description": "Qu’on ne peut corriger",
