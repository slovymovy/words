                        "cross_references": [
                            {
                                "target_word": "меломан",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b518c7d2-ab97-3f8c-ae32-b4de95adc359",
                                        "entry_id": "4c61764d-4d4c-3468-912f-79e35a1cc664",
                                        "glosses": [
                                            "страстный любитель музыки, тот, кто хорошо в ней разбирается"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df41ec22-b465-4ae5-a4d2-5723f1aba89c",
                                                "sense_id": "b518c7d2-ab97-3f8c-ae32-b4de95adc359",
                                                "text": "Николай Платоныч был сам музыкант, меломан в душе и даже композитор по призванию — главная причина, заставившая его, как утверждали многие, взяться за управление театром."
                                            },
                                            {
                                                "example_id": "dbaba6c3-f157-4329-8245-eaaae8913859",
                                                "sense_id": "b518c7d2-ab97-3f8c-ae32-b4de95adc359",
                                                "text": "Певцы, артисты, поэты, художники, меломаны и даже те, которые никогда не были меломанами и с скромною гордостью уверяли, что ни одной ноты не смыслят в музыке, бросились с жадным увлечением за билетами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5279a029-7cda-3cba-856b-c8dda48506e6",
                                        "entry_id": "4c61764d-4d4c-3468-912f-79e35a1cc664",
                                        "glosses": [
                                            "мол. неразборчивый слушатель, готовый слушать любую музыку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b22ded33-388c-479c-a1ec-7a33bb4159d1",
                                                "sense_id": "5279a029-7cda-3cba-856b-c8dda48506e6",
                                                "text": "Я меломан. Если мне будет вообще нечего слушать, и кто-то поставит Киркорова, я буду слушать Киркорова."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
