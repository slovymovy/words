                        "source_sense_id": "1de5cc86-40af-303e-972c-568b6a70556c",
                        "source_sense_description": "to take away humanity",
                        "target_lang_word": "dehumanisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dehumanisieren",
