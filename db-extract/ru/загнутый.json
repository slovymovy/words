                ],
                "senses": [
                    {
                        "sense_id": "96d129c3-3866-337b-8d43-7cf3012e55a4",
                        "entry_id": "e8d6c48e-2644-36e9-aab8-75f592cd6cde",
                        "glosses": [
                            "согнутый, завёрнутый, с подвёрнутым краем чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b16209fa-fd96-46a9-8604-3bfca31204c3",
                                "sense_id": "96d129c3-3866-337b-8d43-7cf3012e55a4",
                                "text": "Карие глаза полковника сияли волей и счастьем; усики, загнутые кверху, были надушены."
                            },
                            {
                                "example_id": "1c8fcb77-d0aa-491b-893e-86605e7702c6",
                                "sense_id": "96d129c3-3866-337b-8d43-7cf3012e55a4",
                                "text": "Потапов открыл загнутую 144-ю страницу и прочитал: «Днём я отправился к Кану. Он пригласил меня отобедать с ним в ресторане…»"
                            },
                            {
                                "example_id": "a8f5bc3f-2cad-4309-9e48-8a2d11a347c2",
                                "sense_id": "96d129c3-3866-337b-8d43-7cf3012e55a4",
                                "text": "Высота в четыре тысячи метров не позволяла существовать здесь никакой растительности, кроме привезённых из Чернобыля черновато-зелёных безлистных деревьев с загнутыми внутрь, к верхушке, ветвями."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a7a6ff7-1972-3243-803e-741d7d64fc1c",
                        "entry_id": "e8d6c48e-2644-36e9-aab8-75f592cd6cde",
                        "glosses": [
                            "согнутый, изогнутый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "334d972f-730f-46bd-967b-f68ee6798986",
                                "sense_id": "6a7a6ff7-1972-3243-803e-741d7d64fc1c",
                                "text": "По углам стояли кресла с высокими спинками, верхушки которых были загнуты на манер бараньих рогов."
                            },
                            {
                                "example_id": "533482df-8d82-4f6d-91fb-67d1000e1581",
                                "sense_id": "6a7a6ff7-1972-3243-803e-741d7d64fc1c",
                                "text": "На лице Кольцова, обрамлённом короткой бородкой, блуждала язвительная усмешка, а тёмные глаза печально смотрели из-под длинных, загнутых, как у женщины, ресниц."
                            },
                            {
                                "example_id": "948f5c35-eb24-49ea-8064-de7a2fc3165b",
                                "sense_id": "6a7a6ff7-1972-3243-803e-741d7d64fc1c",
                                "text": "На печке аккуратно складывал крылья исполинский гриф с голой шеей и зловещим загнутым клювом."
                            }
                        ]
                    }
                ],
