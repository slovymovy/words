                        "examples": [
                            {
                                "example_id": "9aa46191-58e5-44c3-8863-9dcf97315e7c",
                                "sense_id": "7866c205-162e-398d-94ec-7faa33810fc9",
                                "text": "„Der Abfalldezernent des Hochtaunuskreises, Uwe Kraft (CDU), hat Vorwürfe von Bad Homburgs Bürgermeister Michael Korwisi (Grüne) zurückgewiesen, der Kreis sei verantwortlich für die hohen Müllgebühren.“"
                            },
                            {
                                "example_id": "dd2981e5-6257-4b87-bc7c-646f898ea303",
                                "sense_id": "7866c205-162e-398d-94ec-7faa33810fc9",
                                "text": "„Pikanterweise kritisiert jedoch nun ein dem Rechts- und Abfalldezernenten unterstelltes Amt mit hohem juristischem Sachverstand eine dem Rechts- und Abfalldezernenten unterstellte Gesellschaft.“"
                            }
                        ],
