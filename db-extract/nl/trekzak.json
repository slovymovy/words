                        "glosses": [
                            "een instrument met een blaasbalg die een wisseltonig stelsel doorslaande tongen bedient in diatonische stemming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b79f2d9-133b-48b1-beb6-53f73ba19925",
                                "sense_id": "14b1075b-136a-37e8-baf9-c58594a0c0c9",
                                "text": "Een trekzak heeft in tegenstelling tot een accordeon geen klavier."
                            }
