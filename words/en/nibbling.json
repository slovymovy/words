{
    "word_family": [
        "nibble",
        "nibbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e734477-6f85-3faa-ab2f-9cce852396ee",
                    "sense_definition": "present participle and gerund of <w>nibble</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nibble_eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little mouse was quietly <w>nibbling</w> on a piece of cheese.",
                            "target_lang_translations": {
                                "ru": "Маленькая мышка тихонько <w>грызла</w> кусочек сыра."
                            }
                        },
                        {
                            "text": "She sat by the window, <w>nibbling</w> a biscuit while reading her book.",
                            "target_lang_translations": {
                                "ru": "Она сидела у окна, <w>погрызывая</w> печенье за чтением книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "pecking",
                        "gnawing"
                    ],
                    "common_phrases": [
                        "nibbling on"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола nibble (грызть, откусывать мелкими кусочками, лакомиться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызущий",
                                "target_lang_sense_clarification": "причастие, отгрызающий маленькими кусочками"
                            },
                            {
                                "target_lang_word": "погрызывая",
                                "target_lang_sense_clarification": "деепричастие, откусывая маленькими кусочками"
                            },
                            {
                                "target_lang_word": "покусывание",
                                "target_lang_sense_clarification": "герундий, процесс откусывания мелкими кусочками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c25ea12d-abde-31d3-b21c-a7142634fd58",
                    "sense_definition": "The act or sound of taking small, gentle bites.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nibble_eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were startled by the faint sound of <w>nibbling</w> behind the wooden wall.",
                            "target_lang_translations": {
                                "ru": "Нас испугал тихий звук <w>погрызывания</w> за деревянной стеной."
                            }
                        },
                        {
                            "text": "Minute <w>nibblings</w> and rustlings broke the absolute silence of the attic.",
                            "target_lang_translations": {
                                "ru": "Еле слышное <w>погрызывание</w> и шорохи нарушали абсолютную тишину чердака."
                            }
                        }
                    ],
                    "synonyms": [
                        "gnawing"
                    ],
                    "common_phrases": [
                        "faint nibbling",
                        "sound of nibbling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или звук, сопровождающий осторожное откусывание или отщипывание мелкими кусочками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погрызывание",
                                "target_lang_sense_clarification": "действие или звук осторожного грызения"
                            },
                            {
                                "target_lang_word": "пощипывание",
                                "target_lang_sense_clarification": "мелкое отщипывание еды"
                            },
                            {
                                "target_lang_word": "покусывание",
                                "target_lang_sense_clarification": "легкое покусывание зубами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e11dcbc1-107c-38c5-a0e4-84b653d1a4ad",
                    "sense_definition": "A minor adjustment, critique, or gradual encroachment on something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nibble_encroach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I reserve my <w>nibblings</w> and minutiae for another day after we finalize the draft.",
                            "target_lang_translations": {
                                "ru": "Я оставлю свои <w>придирки</w> и мелочи на потом, когда мы закончим черновик."
                            }
                        },
                        {
                            "text": "Continual <w>nibblings</w> at their civil liberties slowly eroded public trust in the system.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>посягательства</w> на гражданские свободы постепенно подрывали доверие общества к системе."
                            }
                        }
                    ],
                    "synonyms": [
                        "encroachment"
                    ],
                    "common_phrases": [
                        "continual nibblings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкое замечание, придирка или постепенное урезание и ущемление чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придирки",
                                "target_lang_sense_clarification": "мелкие замечания или критика"
                            },
                            {
                                "target_lang_word": "ущемление",
                                "target_lang_sense_clarification": "постепенное урезание прав или свобод"
                            },
                            {
                                "target_lang_word": "посягательство",
                                "target_lang_sense_clarification": "постепенное наступление на что-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}