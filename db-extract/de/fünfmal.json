                        "examples": [
                            {
                                "example_id": "1bf87336-cedb-4881-8680-b8e251f64025",
                                "sense_id": "a660c15d-bca2-36e4-8a19-5b16533d8370",
                                "text": "„Bereits heute verbraucht die chinesische Wirtschaft mehr als doppelt so viel Kohle wie die amerikanische und fünfmal so viel wie Westeuropa.“"
                            },
                            {
                                "example_id": "c701d332-413e-4c4f-ac51-d672b17b44c5",
                                "sense_id": "a660c15d-bca2-36e4-8a19-5b16533d8370",
                                "text": "… enthalten reichlich Vitamine. Man sollte sie fünfmal am Tag, drei Portionen Gemüse und zwei Portionen Obst, zu sich nehmen."
                            },
                            {
                                "example_id": "eb2a3ed4-4cf8-47a1-86cd-50219225a768",
                                "sense_id": "a660c15d-bca2-36e4-8a19-5b16533d8370",
                                "text": "„Die Deutschen verursachen fünfmal so viel CO2, wie es für das Klima vernünftig wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
