                    },
                    {
                        "translation_id": "46fde804-7d85-4f27-9b39-01ab72e8df89",
                        "source_entry_id": "0d80529c-88dd-377e-ab70-5720f01f1ac2",
                        "source_sense_id": "978afdcf-2b16-3d3f-af84-3ff0faa1512d",
