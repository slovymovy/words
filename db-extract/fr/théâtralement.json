                                                "sense_id": "6382e76e-f526-3e86-a9f8-32ac95f48d31",
                                                "text": "The film premiered on 3 August before opening theatrically two days later."
                                            },
                                            {
                                                "example_id": "f2e1e447-b316-4257-bb5e-98d908898b7f",
                                                "sense_id": "6382e76e-f526-3e86-a9f8-32ac95f48d31",
                                                "text": "The story was a great success in novel form, but did not perform well theatrically."
                                            }
