                "senses": [
                    {
                        "sense_id": "06a0a4a0-ef31-3d3f-ac04-94e88eaf5d66",
                        "entry_id": "e484eba0-1bf1-31d5-a5d8-498993e3eba8",
                        "glosses": [
                            "(männliche^☆) Person, die ein Konzept, einen Entwurf zu etwas entwickelt, insbesondere im IT-Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2734b1f-2be8-4726-8f24-e771659feb4a",
                                "sense_id": "06a0a4a0-ef31-3d3f-ac04-94e88eaf5d66",
                                "text": "„Diesen Ratschlag gab mir ein großer Meister im Storytelling, als ich meine Lehr- und Wanderjahre als Texter und Konzepter in den goldenen Zeiten der Werbebranche begann.“"
                            },
                            {
                                "example_id": "c16b9b04-fead-4f74-a745-0957b2187c42",
                                "sense_id": "06a0a4a0-ef31-3d3f-ac04-94e88eaf5d66",
                                "text": "„Sowohl Konzepter, Designer, Programmierer und Projektmanager können bei dieser Art Workshop zusammenkommen.“"
                            },
                            {
                                "example_id": "f7c0ad9f-301c-43af-bf9a-34cb5b3c244b",
                                "sense_id": "06a0a4a0-ef31-3d3f-ac04-94e88eaf5d66",
                                "text": "„Mielke war hauptberuflich Texter, Konzepter sowie drei Jahrzehnte lang Kreativdirektor in internationalen Werbeagenturen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
