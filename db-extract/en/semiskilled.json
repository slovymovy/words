                        "glosses": [
                            "Requiring, or having, only minimal levels of training."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9d18d240-acca-43c1-bfa7-aa2742947865",
                                "sense_id": "7923841e-5f71-321c-91d8-cbb6de0532e7",
                                "text": "Near-synonym: low-skilled"
                            },
                            {
                                "example_id": "b2acf59e-a9c2-42f6-a798-2bab98896d35",
                                "sense_id": "7923841e-5f71-321c-91d8-cbb6de0532e7",
                                "text": "Semiskilled workers are cheaper than skilled workers but more productive than unskilled drudges."
                            },
                            {
                                "example_id": "baa9925b-02b7-4746-aefa-6e1c4bb85569",
                                "sense_id": "7923841e-5f71-321c-91d8-cbb6de0532e7",
                                "text": "The greater job security of skilled workers compared with semiskilled and unskilled workers was clearly evident during the 1960–61 recession."
                            },
                            {
                                "example_id": "f4803c70-f0ed-4a01-98f1-f7d3fe836051",
                                "sense_id": "7923841e-5f71-321c-91d8-cbb6de0532e7",
                                "text": "“Scientific” management principles recognized the significant role of machines in better and more efficient production systems. Specifically, semiskilled workers using machines could produce more than the skilled workers in small craft shops."
                            }
                        ]
                    }
