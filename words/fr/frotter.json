    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9cc4df25-1ae1-34bc-b460-0eb6d3820bbd",
                    "sense_definition": "Passer une chose sur une autre de manière répétée en appuyant, pour nettoyer, masser ou réchauffer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait froid dehors et il commence à se <w>frotter</w> les mains pour se réchauffer."
                        },
                        {
                            "text": "L'enfant fatigué ne cesse de se <w>frotter</w> les yeux avant d'aller au lit."
                        }
                    ],
                    "synonyms": [
                        "frictionner",
                        "masser",
                        "astiquer"
                    ],
                    "common_phrases": [
                        "se frotter les mains",
                        "se frotter les yeux",
                        "frotter une allumette"
                    ]
                },
                {
                    "sense_id": "17fc6a4b-4130-331c-b091-eb9b2ec08718",
                    "sense_definition": "Toucher ou racler une surface en se déplaçant contre elle avec une certaine pression.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contact_mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille porte en bois est un peu voilée et <w>frotte</w> contre le carrelage."
                        },
                        {
                            "text": "Le conducteur s'arrête net parce qu'une pièce métallique semble <w>frotter</w> sous la voiture."
                        }
                    ],
                    "synonyms": [
                        "racler"
                    ]
                },
                {
                    "sense_id": "7635d631-15a8-34d6-9612-92e5b9949368",
                    "sense_definition": "Affronter un adversaire redoutable ou s'exposer à une situation difficile ou périlleuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confrontation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune boxeur est courageux mais il ne devrait pas se <w>frotter</w> à un tel champion."
                        },
                        {
                            "text": "Ne te <w>frotte</w> pas à cette affaire complexe sans avoir consulté un juriste."
                        }
                    ],
                    "synonyms": [
                        "s'attaquer à",
                        "défier"
                    ],
                    "antonyms": [
                        "fuir",
                        "éviter"
                    ],
                    "common_phrases": [
                        "se frotter à"
                    ]
                }
            ]
        }
    ]
