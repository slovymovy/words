                "senses": [
                    {
                        "sense_id": "1ae2fd6c-b41b-3f36-bac8-9a148a0eb625",
                        "entry_id": "4612e4c1-bcfb-3d82-9571-7a448bf8ee7d",
                        "glosses": [
                            "Kurzbezeichnung für einen Studenten im ersten Semester"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0727a3b9-66ca-4468-8e2a-77d9e14f63b1",
                                "sense_id": "1ae2fd6c-b41b-3f36-bac8-9a148a0eb625",
                                "text": "Am Beginn des neuen Semesters wurde für die Erstis eine große Party gegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87095c86-bdd7-465a-a974-193d3a39620b",
                        "source_entry_id": "4612e4c1-bcfb-3d82-9571-7a448bf8ee7d",
                        "source_sense_id": "1ae2fd6c-b41b-3f36-bac8-9a148a0eb625",
                        "source_sense_description": "umgangssprachlich: Kurzbezeichnung für einen Studenten im ersten Semester",
                        "target_lang_word": "freshman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freshman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                        "entry_id": "a13bf94e-b773-3bec-9d26-821d49cca1a6",
                                        "glosses": [
                                            "a person (of either sex) entering the first year of an institution, especially a high school (ninth grade for US, grade 9 for Canada, grade 7 for Philippines), a university, or legislative body"
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071cd3d6-9f10-40ca-9179-c12dfdc5304e",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "At the time I was a wide-eyed freshman, but I was soon to grow jaded and cynical."
                                            },
                                            {
                                                "example_id": "0a2e3ca4-6283-414e-aad6-44932bd992f3",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "When he was but yet a freshman in Cambridge."
                                            },
                                            {
                                                "example_id": "f2f6b424-7343-469e-b7c7-2b4b2323ac29",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "Sir Alexander: Then he's a graduate.\nSir Davy: Say they trust him not?\nSir Alexander: Then is he held a freshman and a sot,¶ And never shall commence, but being still barr'd¶ Be expuls'd from the master's side to th' twopenny ward,¶ Or else i' th' hole be plac'd."
                                            },
                                            {
                                                "example_id": "ee81bc4f-8b74-4639-a19e-c9fd6fa84f4a",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "As a country, we now enter what the seven freshmen called “unchartered waters”, with an unprecedented political and constitutional crisis looming on the horizon."
                                            },
                                            {
                                                "example_id": "d1126695-c14e-442a-897b-25fe89dafaf9",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "Trump may have played a role in swaying some holdouts — calling into a meeting of Republican freshmen the night before, and calling other members ahead of voting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49701f9b-75e1-35ca-8a18-f996e8797fee",
                                        "entry_id": "a13bf94e-b773-3bec-9d26-821d49cca1a6",
                                        "glosses": [
                                            "a novice; one in the rudiments of knowledge"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3033a39-b67a-4756-98e3-2f7486eae58b",
                                                "sense_id": "49701f9b-75e1-35ca-8a18-f996e8797fee",
                                                "text": "I am but a Freshman yet in France, therefore I can send you no News but that all is here quiet, and 'tis no ordinary News that the French should be quiet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
