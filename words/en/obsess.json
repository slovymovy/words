{
    "word_family": [
        "obsession",
        "obsessive",
        "obsessively",
        "obsessional"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0555638-dae5-36a0-9147-8c23341734db",
                    "sense_definition": "To dominate the thoughts of someone or to fill someone's mind continually.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental preoccupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fear of failure began to <w>obsess</w> him as the deadline approached.",
                            "target_lang_translations": {
                                "ru": "Страх неудачи начал <w>завладевать</w> им по мере приближения дедлайна."
                            }
                        },
                        {
                            "text": "Thoughts of her <w>obsess</w> my every waking moment since we met.",
                            "target_lang_translations": {
                                "ru": "Мысли о ней <w>не дают мне покоя</w> ни на минуту с тех пор, как мы встретились."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obsess the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью занимать чьи-либо мысли или постоянно присутствовать в сознании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завладеть",
                                "target_lang_sense_clarification": "о мыслях или чувствах"
                            },
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "о навязчивых мыслях"
                            },
                            {
                                "target_lang_word": "не давать покоя",
                                "target_lang_sense_clarification": "постоянно беспокоить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01da3618-b9c0-30f9-944a-d487f2f5ed26",
                    "sense_definition": "To be constantly preoccupied with a single topic, emotion, or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental preoccupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people are <w>obsessed</w> with sports and watch every single game.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди <w>одержимы</w> спортом и смотрят каждую игру."
                            }
                        },
                        {
                            "text": "He was <w>obsessed</w> with alchemy and spent years studying ancient manuscripts.",
                            "target_lang_translations": {
                                "ru": "Он был <w>помешан</w> на алхимии и провел годы, изучая древние манускрипты."
                            }
                        }
                    ],
                    "synonyms": [
                        "fixate"
                    ],
                    "common_phrases": [
                        "obsessed with details",
                        "obsessed with success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть постоянно поглощенным какой-то одной темой, эмоцией или человеком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть одержимым",
                                "target_lang_sense_clarification": "страстно увлекаться чем-либо"
                            },
                            {
                                "target_lang_word": "зацикливаться",
                                "target_lang_sense_clarification": "концентрировать внимание на одном"
                            },
                            {
                                "target_lang_word": "фанатеть",
                                "target_lang_sense_clarification": "разг., сильно увлекаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cccacf27-079c-3c7e-bf4e-7bd1e7378f5b",
                    "sense_definition": "To think or talk about something or someone in a way that is excessive or unhealthy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental preoccupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>obsessing</w> over it and just try to relax for a while.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>зацикливаться</w> на этом и просто постарайся немного расслабиться."
                            }
                        },
                        {
                            "text": "You should not <w>obsess</w> over mistakes you made in the past.",
                            "target_lang_translations": {
                                "ru": "Тебе не стоит <w>изводить себя</w> из-за ошибок, совершенных в прошлом."
                            }
                        }
                    ],
                    "synonyms": [
                        "fixate"
                    ],
                    "common_phrases": [
                        "obsess over details",
                        "stop obsessing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно или нездорово много думать или говорить о ком-то или чем-то."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зацикливаться",
                                "target_lang_sense_clarification": "неотвязно думать об одном и том же"
                            },
                            {
                                "target_lang_word": "зациклиться",
                                "target_lang_sense_clarification": "сосредоточиться на чем-то в ущерб остальному"
                            },
                            {
                                "target_lang_word": "забивать голову",
                                "target_lang_sense_clarification": "разг., слишком много думать о чем-то"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}