                    "sense_definition": "verouderde aanvoegende wijs van de verleden tijd van <w>rijden</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Indien hij te paard <w>rede</w>, zou hij sneller ter plaatse zijn.",
                            "target_lang_translations": {
                                "en": "If he <w>rode</w> on horseback, he would be on the scene faster."
                            }
                        },
                        {
                            "text": "Het was alsof hij in een droom over de wolken <w>rede</w>.",
                            "target_lang_translations": {
                                "en": "It was as if he <w>rode</w> over the clouds in a dream."
                            }
                        }
