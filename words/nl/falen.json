{
    "word_family": [
        "faal",
        "faalangst",
        "gefaald",
        "faling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66de6ef6-005b-3435-a25f-892c16f68114",
                    "sense_definition": "niet slagen in een poging of opdracht; mislukken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mislukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks al zijn harde werk bleef hij helaas <w>falen</w> voor het examen.",
                            "target_lang_translations": {
                                "en": "Despite all his hard work, he unfortunately continued to <w>fail</w> the exam."
                            }
                        },
                        {
                            "text": "Zijn pogingen om de wedstrijd te winnen <w>faalden</w> jammerlijk.",
                            "target_lang_translations": {
                                "en": "His attempts to win the match <w>failed</w> miserably."
                            }
                        }
                    ],
                    "synonyms": [
                        "feilen"
                    ],
                    "antonyms": [
                        "slagen"
                    ],
                    "common_phrases": [
                        "jammerlijk falen",
                        "pogingen faalden"
                    ],
                    "target_lang_definitions": {
                        "en": "to not succeed in an attempt or task; to be unsuccessful"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to be unsuccessful in an attempt"
                            },
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to receive a non-passing grade"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf03f1ad-076e-3247-bc19-8a4a75cdcc8a",
                    "sense_definition": "het doel dat men zich gesteld had niet bereiken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mislukken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>falen</w> in hun opzet om het bedrijf dit jaar winstgevend te maken.",
                            "target_lang_translations": {
                                "en": "They are <w>failing</w> in their plan to make the company profitable this year."
                            }
                        },
                        {
                            "text": "Als we nu niet ingrijpen, zullen we zeker <w>falen</w> in onze missie.",
                            "target_lang_translations": {
                                "en": "If we don't intervene now, we will certainly <w>fail</w> in our mission."
                            }
                        }
                    ],
                    "antonyms": [
                        "slagen"
                    ],
                    "common_phrases": [
                        "falen in opzet"
                    ],
                    "target_lang_definitions": {
                        "en": "to not achieve a goal that one has set for oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to not achieve a particular goal"
                            },
                            {
                                "target_lang_word": "fall short",
                                "target_lang_sense_clarification": "to not reach a target or expectation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60cc54bf-f9b2-3fa6-a188-559050826c1e",
                    "sense_definition": "niet toereikend zijn of tekortschieten in kracht of werking",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tekortschieten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn krachten <w>falen</w> na deze lange en vermoeiende wandeling door de bergen.",
                            "target_lang_translations": {
                                "en": "My strength is <w>failing</w> after this long and tiring hike through the mountains."
                            }
                        },
                        {
                            "text": "De remmen van de auto <w>faalden</w> op het meest kritieke moment.",
                            "target_lang_translations": {
                                "en": "The car's brakes <w>failed</w> at the most critical moment."
                            }
                        }
                    ],
                    "common_phrases": [
                        "krachten falen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be inadequate or to fall short in strength or operation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "of a machine or body part: to cease to operate correctly"
                            },
                            {
                                "target_lang_word": "give out",
                                "target_lang_sense_clarification": "to stop functioning due to exhaustion or wear"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52b46934-2857-3a97-b1f5-bb742b5af5c6",
                    "sense_definition": "niet voldoen aan een financiële verplichting; in gebreke blijven",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf dreigt te <w>falen</w> in het betalen van de maandelijkse rente.",
                            "target_lang_translations": {
                                "en": "The company is at risk of <w>defaulting</w> on the monthly interest payments."
                            }
                        },
                        {
                            "text": "Wanneer een land gaat <w>falen</w> op zijn schulden, heeft dat grote gevolgen.",
                            "target_lang_translations": {
                                "en": "When a country <w>defaults</w> on its debts, it has major consequences."
                            }
                        }
                    ],
                    "common_phrases": [
                        "falen in betaling"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in zakelijke of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to fail to meet a financial obligation; to be in default"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "default",
                                "target_lang_sense_clarification": "to fail to fulfill a financial obligation"
                            },
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to be unable to meet financial engagements"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
