    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fa269e0d-6167-3f85-ac7b-0a0b111d3740",
                    "sense_definition": "В большой степени; намного, существенно.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это здание <значительно> выше всех остальных в городе.",
                            "target_lang_translations": {
                                "en": "This building is <significantly> taller than all the others in the city.",
                                "zh": "这座建筑比城里其他所有建筑都要高<w>得多</w>。"
                            }
                        },
                        {
                            "text": "После ремонта квартира стала <значительно> уютнее и светлее.",
                            "target_lang_translations": {
                                "en": "After the renovation, the apartment became <considerably> cozier and brighter.",
                                "zh": "装修后，公寓变得<w>显著</w>更加舒适和明亮了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "намного",
                        "существенно"
                    ],
                    "antonyms": [
                        "незначительно",
                        "немного",
                        "мало"
                    ],
                    "common_phrases": [
                        "значительно больше",
                        "значительно лучше",
                        "значительно выше",
                        "значительно меньше",
                        "значительно отличаться"
                    ],
                    "target_lang_definitions": {
                        "en": "To a great degree; much, substantially.",
                        "zh": "在很大程度上；非常，相当地。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "significantly",
                                "target_lang_sense_clarification": "to a great extent"
                            },
                            {
                                "target_lang_word": "considerably",
                                "target_lang_sense_clarification": "much"
                            },
                            {
                                "target_lang_word": "substantially",
                                "target_lang_sense_clarification": "largely"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大大地",
                                "target_lang_sense_clarification": "表示程度高"
                            },
                            {
                                "target_lang_word": "显著地",
                                "target_lang_sense_clarification": "表示程度明显"
                            },
                            {
                                "target_lang_word": "相当地",
                                "target_lang_sense_clarification": "表示程度相当大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f55c25f-3744-313d-b433-a2e50aec9382",
                    "sense_definition": "Выразительно, с намёком на важность или особый смысл.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отец <значительно> посмотрел на сына, призывая его к молчанию.",
                            "target_lang_translations": {
                                "en": "The father looked <meaningfully> at his son, urging him to be silent.",
                                "zh": "父亲<w>意味深长</w>地看了儿子一眼，示意他保持安静。"
                            }
                        },
                        {
                            "text": "Она <значительно> улыбнулась, словно знала какую-то тайну.",
                            "target_lang_translations": {
                                "en": "She smiled <significantly>, as if she knew a secret.",
                                "zh": "她<w>意味深长</w>地笑了笑，仿佛知道什么秘密。"
                            }
                        }
                    ],
                    "synonyms": [
                        "важно",
                        "весомо"
                    ],
                    "common_phrases": [
                        "значительно посмотреть",
                        "значительно молчать"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressively, with a hint of importance or special meaning.",
                        "zh": "意味深长地，带有暗示重要性或特殊含义。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meaningfully",
                                "target_lang_sense_clarification": "expressively"
                            },
                            {
                                "target_lang_word": "significantly",
                                "target_lang_sense_clarification": "with special meaning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意味深长地",
                                "target_lang_sense_clarification": "带有暗示或特殊含义"
                            }
                        ]
                    }
                }
            ]
        },
        {
