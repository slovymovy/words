                "senses": [
                    {
                        "sense_id": "36e38ead-0f62-3fda-ae2a-853ed3c4b491",
                        "entry_id": "6ab9402f-3dcd-33ed-b951-a11e96b5af6a",
                        "glosses": [
                            "(abgezogenes) Fell eines Mammuts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78899980-93a0-4035-9537-c3e7dbacb6d3",
                                "sense_id": "36e38ead-0f62-3fda-ae2a-853ed3c4b491",
                                "text": "„Die damaligen Menschen wohnten in Zelten, deren Gerüst aus Mammutknochen und deren Plane aus Mammutfell bestand.“"
                            },
                            {
                                "example_id": "6b75568f-7f6e-499c-abf1-e62458b674cd",
                                "sense_id": "36e38ead-0f62-3fda-ae2a-853ed3c4b491",
                                "text": "„Das Gerüst bestand aus Mammutstoßzähnen. Darüber waren Mammutfelle gespannt.“"
                            },
                            {
                                "example_id": "2b65693f-c2b3-478e-9205-796c6a7d480e",
                                "sense_id": "36e38ead-0f62-3fda-ae2a-853ed3c4b491",
                                "text": "„Im Ort Mezin fand man eine ganze Siedlung solcher Unterkünfte, die einst auch von Mammutfellen abgedeckt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
