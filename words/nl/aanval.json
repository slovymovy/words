                    "frequency": "Middle",
                    "semantic_group_id": "sudden_onset",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest gaan zitten omdat hij een lichte <w>aanval</w> van duizeligheid voelde.",
