                                "target_senses": [
                                    {
                                        "sense_id": "3c076503-f034-354a-9f46-073bf71036dd",
                                        "entry_id": "6d5ca091-eaa4-3600-95fc-974a6cd1300d",
                                        "glosses": [
                                            "Marked by or resulting from extraordinary ability to recall detailed and vivid mental images of visual images."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06915c3-1b8d-4a15-a9a0-16097c148a52",
                                                "sense_id": "3c076503-f034-354a-9f46-073bf71036dd",
                                                "text": "an eidetic memory"
                                            },
                                            {
                                                "example_id": "26801b1f-3c3a-45bf-b937-95047eca35aa",
                                                "sense_id": "3c076503-f034-354a-9f46-073bf71036dd",
                                                "text": "‘Funny that I should remember it? I have an eidetic memory for numbers, can't help"
                                            },
                                            {
                                                "example_id": "d737ea1a-50f9-4413-b208-0e98e326de47",
                                                "sense_id": "3c076503-f034-354a-9f46-073bf71036dd",
                                                "text": "Eidetic images are pictures in the head. They are internal images that have the full force of conventional vision, but which are retained solely in the mind of the eidetiker."
                                            },
                                            {
                                                "example_id": "5dadaa34-354e-44f7-aff3-dd4fcd8a0695",
                                                "sense_id": "3c076503-f034-354a-9f46-073bf71036dd",
                                                "text": "Les Assassins’ M. Fortier and M. Broullime and some others of his comrades-on-wheels believed Remy Marathe to be eidetic, near-perfect in recall and detail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
