        "fr-extract.jsonl": [
            {
                "entry_id": "83c5e9e7-b14d-3fc6-a114-5f0bd6719dbc",
                "word": "Lombardie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "34a3465e-5c49-38d3-8ed0-86768d41c79b",
                        "entry_id": "83c5e9e7-b14d-3fc6-a114-5f0bd6719dbc",
                        "glosses": [
                            "Région d’Italie septentrionale, située au sud de la Suisse, à l’est du Piémont et à l’ouest de la Vénétie."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "d7165b54-a1fe-4bc3-a6c0-8e6156010416",
                                "sense_id": "34a3465e-5c49-38d3-8ed0-86768d41c79b",
                                "text": "Le Bog jouit d'une grande vogue auprès des campagnards italiens. Il vint de Lombardie en France où, au XIXᵉ siècle, il connut beaucoup de succès dans les provinces méridionales."
                            },
                            {
                                "example_id": "0010e2db-687e-429d-aae1-01035e2c7cec",
                                "sense_id": "34a3465e-5c49-38d3-8ed0-86768d41c79b",
                                "text": "En cette fin d’année, il s’est associé à l’un des maîtres italiens du panettone, Iginio Massari, basé à Brescia, en Lombardie."
                            },
                            {
                                "example_id": "13515a30-8d13-41d4-a394-a355777a9145",
                                "sense_id": "34a3465e-5c49-38d3-8ed0-86768d41c79b",
                                "text": "Mademoiselle Judici tenait du sang paternel cette peau jaunâtre au jour, qui le soir, aux lumières, devient d’une blancheur éclatante, des yeux d’une grandeur, d’une forme, d’un éclat oriental, des cils fournis et recourbés qui ressemblaient à de petites plumes noires, une chevelure d’ébène, et cette majesté native de la Lombardie qui fait croire à l’étranger, quand il se promène le dimanche à Milan, que les filles des portiers sont autant de reines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ff0f8b3-ec5f-4f91-a901-0caeb0a3e920",
                        "source_entry_id": "83c5e9e7-b14d-3fc6-a114-5f0bd6719dbc",
                        "source_sense_id": "34a3465e-5c49-38d3-8ed0-86768d41c79b",
