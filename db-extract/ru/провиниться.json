                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb7b5df8-39e7-43a8-99c5-f03ec115741e",
                        "source_entry_id": "9a34a16d-0ad7-3423-a399-ac4cfb3466e2",
                        "source_sense_id": "d8005b2e-c595-38ae-9611-251ab50d4442",
                        "target_lang_word": "commettre une faute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c5eada71-cbcb-405f-be40-26a7e96bbf3a",
                        "source_entry_id": "9a34a16d-0ad7-3423-a399-ac4cfb3466e2",
                        "source_sense_id": "d8005b2e-c595-38ae-9611-251ab50d4442",
                        "target_lang_word": "faillir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faillir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3564047-677e-31df-b37e-7b808cac6ced",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "Ne pas tenir le coup."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca6a557a-0806-3865-bf05-53ad120eb119",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "Faire preuve de manquement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3971ce17-166c-4ec8-a878-d79eae720406",
                                                "sense_id": "ca6a557a-0806-3865-bf05-53ad120eb119",
                                                "text": "Faillir à son devoir."
                                            },
                                            {
                                                "example_id": "7ded6c56-4a78-4eae-9547-bbd2a41efa47",
                                                "sense_id": "ca6a557a-0806-3865-bf05-53ad120eb119",
                                                "text": "Cette armé à qui on a arraché ses écussons, ses galons, cassée, dégradée comme un officier qui aurait failli à l’honneur, elle porte, sur son visage décoloré, la colère du plus faible à qui on a tout pris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f18b73-dc27-3b2f-8b26-90cf2314dd18",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "Manquer à son devoir conjugal."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c340fbf1-0835-3ab4-af2e-a2a999b42bc0",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "Manquer, faire défaut."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ec134d-2b89-418c-89f7-08bc08c0bb5f",
                                                "sense_id": "c340fbf1-0835-3ab4-af2e-a2a999b42bc0",
                                                "text": "Debout dans le jour faillant, Julien toisait les vagues."
                                            },
                                            {
                                                "example_id": "062c5324-dc01-49a0-9dfe-a3c42f5398c3",
                                                "sense_id": "c340fbf1-0835-3ab4-af2e-a2a999b42bc0",
                                                "text": "Son cœur faillit de nouveau quand elle aperçut dans sa chevelure de jais, pour la première fois, un crin blanc."
                                            },
                                            {
                                                "example_id": "30b57bf4-44c9-4b1b-aacd-3c8d6ead3673",
                                                "sense_id": "c340fbf1-0835-3ab4-af2e-a2a999b42bc0",
                                                "text": "La mémoire lui a failli."
                                            },
                                            {
                                                "example_id": "98d00edf-3439-4038-865b-f1d992cfd496",
                                                "sense_id": "c340fbf1-0835-3ab4-af2e-a2a999b42bc0",
                                                "text": "Faillir à une tâche."
                                            },
                                            {
                                                "example_id": "3eab3d35-d568-4958-a128-761392a19e57",
                                                "sense_id": "c340fbf1-0835-3ab4-af2e-a2a999b42bc0",
                                                "text": "Le jour commence à faillir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f14e67-a47b-397f-886f-ba2c63a190b0",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "Céder, devenir faible."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de4b9069-4553-4085-a8dc-bba476571181",
                                                "sense_id": "f8f14e67-a47b-397f-886f-ba2c63a190b0",
                                                "text": "Si, en lisant ces pages, un jeune homme, un seul, prêt à faillir, se sentait tant d’effroi et tant de dégoût, qu’il fût à jamais sauvé du mal, il me semble que le salut de cette âme commencerait le rachat de la mienne."
                                            },
                                            {
                                                "example_id": "4d33b005-c9b0-4b9f-8db7-94d3cd52ea7b",
                                                "sense_id": "f8f14e67-a47b-397f-886f-ba2c63a190b0",
                                                "text": "Les jambes me faillaient, la tête me tournait, mais j’étais bien, comme dans un cocon de soie."
                                            },
                                            {
                                                "example_id": "0858ff0f-d7c2-47e4-9473-34177793399c",
                                                "sense_id": "f8f14e67-a47b-397f-886f-ba2c63a190b0",
                                                "text": "Cet édifice a failli par le pied. — Ce cheval commence à faillir par les jambes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf5305f1-1122-3807-8425-6037e11f07d4",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "Manquer à exécuter, à faire une chose."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cca217-3055-4637-bebc-8b127ebc8c3e",
                                                "sense_id": "cf5305f1-1122-3807-8425-6037e11f07d4",
                                                "text": "J’irai là sans faillir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "(Suivi d'un infinitif) N’être pas loin de faire quelque chose, y manquer de peu. → voir raser de"
                                        ],
                                        "tags": [
                                            "auxiliary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf97be4c-afce-4381-872a-632d566e3701",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "À Mogador, nouvelle relâche, mais la barque envoyée à terre pour rapporter de l’eau fraîche faillit être capturée par les Arabes."
                                            },
                                            {
                                                "example_id": "c556a39b-5a23-44c8-82b7-c6694ee5d605",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "J'ai failli me faire arrêter en rapportant le diadème au magasin."
                                            },
                                            {
                                                "example_id": "d8a1055f-8871-40db-9f94-25e643f734fa",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "Vainement il cherchait, à la fois, sa clé et son équilibre. Soudain il faillit choir en avant."
                                            },
                                            {
                                                "example_id": "1338ae47-7a37-4601-b484-e8926ad7e067",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "D’écœurement, de dégoût et d’indigestion, Tintin vomit tripes et boyaux et faillit en crever pendant la nuit."
                                            },
                                            {
                                                "example_id": "54adc4a6-7270-48e0-a72b-96787c187fdc",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "J’ai failli l’oublier."
                                            },
                                            {
                                                "example_id": "52931638-a2db-43c8-b4ab-38fd01feff79",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "L’accident qui faillit nous arriver."
                                            },
                                            {
                                                "example_id": "66b22415-de90-4ae4-a0b6-638b5f251911",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "Le 20 septembre 2020, Joop Zoetemelk, le vainqueur du Tour de France 1980, a failli mourir sur son vélo, au carrefour d’une route de Seine-et-Marne, la D 147, à Lizy-sur-Ourcq. Renversé par une voiture, le Néerlandais, alors âgé de 74 ans, est passé par-dessus le véhicule. Mais il a eu le réflexe de protéger sa tête avec ses bras."
                                            },
                                            {
                                                "example_id": "e12713a6-ff90-48e0-b0a6-aa64aba151c8",
                                                "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                                                "text": "Il a failli nous arriver un grand malheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae433667-22cc-3944-9d02-6853cb92c984",
                                        "entry_id": "c998e30d-6e34-32b7-a28f-728c448a8f65",
                                        "glosses": [
                                            "Se tromper, se méprendre sur quelque chose."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b12f0d-aeb0-476c-a77f-686fb6a9ed34",
                                                "sense_id": "ae433667-22cc-3944-9d02-6853cb92c984",
                                                "text": "Faillir lourdement."
                                            },
                                            {
                                                "example_id": "72440faf-494c-47e9-bf28-a959e88321c8",
                                                "sense_id": "ae433667-22cc-3944-9d02-6853cb92c984",
                                                "text": "Les plus doctes sont sujets à faillir."
                                            }
                                        ]
                                    }
                                ]
