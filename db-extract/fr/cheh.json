                                        "examples": [
                                            {
                                                "example_id": "e58bc7ab-a22a-4f93-996c-0923bdf6a43d",
                                                "sense_id": "fae49fcd-f8b7-354a-8057-b17710a8afc0",
                                                "text": "I am a king that find thee; and I know 'Tis not the balm, the sceptre, and the ball, The sword, the mace, the crown imperial, The intertissued robe of gold and pearl"
                                            }
                                        ]
                                    },
