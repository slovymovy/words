{
    "word_family": [
        "arrêtoir",
        "arrêter",
        "inarrêtable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e5d6d43-8b2f-393d-a264-e91b79b1c1b6",
                    "sense_definition": "Lieu précis et aménagé où les véhicules de transport en commun s'arrêtent pour faire monter ou descendre des passagers.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous attendons le bus à l'<w>arrêt</w> depuis plus de vingt minutes ce matin."
                        },
                        {
                            "text": "Le chauffeur prévient les voyageurs que le prochain <w>arrêt</w> sera le terminus de la ligne."
                        }
                    ],
                    "synonyms": [
                        "station"
                    ],
                    "common_phrases": [
                        "arrêt de bus",
                        "arrêt facultatif",
                        "prochain arrêt"
                    ]
                },
                {
                    "sense_id": "6d403340-dd7a-3ec2-afe8-23a0fe09df11",
                    "sense_definition": "Action de cesser tout mouvement, toute activité ou tout fonctionnement ; fait d'être interrompu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a prescrit un <w>arrêt</w> de travail de deux semaines au patient épuisé."
                        },
                        {
                            "text": "Le train a marqué un <w>arrêt</w> brusque en pleine voie sans explication."
                        }
                    ],
                    "synonyms": [
                        "interruption",
                        "pause",
                        "cessation"
                    ],
                    "antonyms": [
                        "démarrage",
                        "reprise",
                        "poursuite"
                    ],
                    "common_phrases": [
                        "arrêt de travail",
                        "arrêt cardiaque",
                        "temps d'arrêt",
                        "point d'arrêt"
                    ]
                },
                {
                    "sense_id": "10b8f3a0-64d9-3dc2-9c7b-5a1c5f9497d7",
                    "sense_definition": "Panneau de signalisation routière octogonal rouge indiquant aux automobilistes l'obligation de marquer une pause complète.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut respecter le panneau d'<w>arrêt</w> avant de s'engager sur cette voie rapide."
                        },
                        {
                            "text": "Le conducteur n'a pas fait son <w>arrêt</w> complet au carrefour et a reçu une amende."
                        }
                    ],
                    "synonyms": [
                        "stop"
                    ],
                    "common_phrases": [
                        "panneau d'arrêt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principalement au Québec"
                        }
                    ]
                },
                {
                    "sense_id": "8b111c52-83f4-39bd-8a5b-c358cab47128",
                    "sense_definition": "Dans un sport de ballon, action par laquelle un gardien bloque ou repousse un tir adverse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gardien de but a réalisé un <w>arrêt</w> spectaculaire à la dernière minute du match."
                        },
                        {
                            "text": "Grâce aux nombreux <w>arrêts</w> de son portier, l'équipe a pu conserver son avantage jusqu'à la fin."
                        }
                    ],
                    "synonyms": [
                        "parade"
                    ],
                    "common_phrases": [
                        "bel arrêt",
                        "arrêt réflexe"
                    ]
                },
                {
                    "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                    "sense_definition": "Décision de justice rendue par une juridiction supérieure ou une cour souveraine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Cour de cassation a rendu un <w>arrêt</w> très attendu sur la protection des données."
                        },
                        {
                            "text": "Les avocats ont décidé de contester cet <w>arrêt</w> devant une instance européenne."
                        }
                    ],
                    "synonyms": [
                        "décision",
                        "jugement"
                    ],
                    "common_phrases": [
                        "rendre un arrêt",
                        "arrêt de justice",
                        "arrêt de la cour"
                    ]
                },
                {
                    "sense_id": "ebf85420-da9e-3aa3-a1da-ba9ea7d120f6",
                    "sense_definition": "Sanction disciplinaire militaire obligeant un soldat ou un officier à rester consigné dans un lieu précis sans pouvoir en sortir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour avoir désobéi à son supérieur, le lieutenant a été mis aux <w>arrêts</w> de rigueur pendant huit jours."
                        },
                        {
                            "text": "Le soldat puni passe ses <w>arrêts</w> dans sa chambre de garnison sans autorisation de sortie."
                        }
                    ],
                    "common_phrases": [
                        "mettre aux arrêts",
                        "arrêts de rigueur",
                        "être aux arrêts"
                    ]
                }
            ]
        }
    ]
}