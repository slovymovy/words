                        "glosses": [
                            "Not conforming to the normal type."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecdb6aaa-eb9f-4941-b8bc-6239e4b5377c",
                                "sense_id": "71b2b66b-1a45-3089-92bf-f0fdf6b1f415",
                                "text": "The condition also has an associated atypical development of the retina and optic nerve misrouting, resulting in significant vision issues."
                            }
                        ]
                    },
                    {
                        "sense_id": "ceaaedb4-331e-30fb-a63a-21087e175839",
                        "entry_id": "73968d9c-7485-3ba7-98b8-c99ae7f6d19b",
