                        ],
                        "tags": [
                            "colloquial",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "35f1c7ac-7e84-4121-8198-f1208adf5aec",
                                "sense_id": "a182541e-15a4-3c96-9b06-a98fae5a5294",
                                "text": "Vous me tribouillez les entrailles."
                            },
                            {
                                "example_id": "75e3c064-3898-4ed3-92a3-2e51d3ba33b8",
                                "sense_id": "a182541e-15a4-3c96-9b06-a98fae5a5294",
                                "text": "Je me sens tout tribouiller le cœur quand je te regarde."
                            },
                            {
                                "example_id": "60784469-5c2a-483d-8665-46bf3c07504e",
                                "sense_id": "a182541e-15a4-3c96-9b06-a98fae5a5294",
                                "text": "Ah ! que je l’aime ! je le sens bien en ce moment ; le sang me tribouille partout."
                            },
                            {
                                "example_id": "57c58d16-e0cb-4430-ba59-07e3804facc3",
                                "sense_id": "a182541e-15a4-3c96-9b06-a98fae5a5294",
                                "text": "Foutus Slaves, ils lui ont tout tribouillé le dedans d'la cervelle."
                            }
                        ]
                    }
