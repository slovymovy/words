                        ],
                        "examples": [
                            {
                                "example_id": "15b3c1f1-452d-4ae4-bc7c-143a4fe14267",
                                "sense_id": "abb38735-e42a-3ac3-a4cd-a16db663d1a3",
                                "text": "Neither Wales nor Scotland was in favour of getting rid of it, no doubt because both countries have done an infinitely better job than Whitehall on mainstreaming sustainable development."
                            },
                            {
                                "example_id": "42cbfea0-6c81-460a-ab1d-b7dc11e90894",
                                "sense_id": "abb38735-e42a-3ac3-a4cd-a16db663d1a3",
                                "text": "Mainstreaming implies involving all social actors—governments, civil society, industry and local communities—in the process. Mainstreaming calls for changes in policy as far upstream as possible."
                            }
                        ]
                    },
