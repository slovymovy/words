                    {
                        "sense_id": "91d80edb-18ca-33cc-a13f-901fbbcea98a",
                        "entry_id": "165864a2-8426-34f8-913f-e601c941a4a3",
                        "glosses": [
                            "van zaken dat ze het schuldig zijn van de verdachte waarschijnlijker maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c4e90c-7d39-437b-bb41-cac9ad0334d6",
                                "sense_id": "91d80edb-18ca-33cc-a13f-901fbbcea98a",
                                "text": "Uit de aanklacht van de fiscus blijkt dat er zoveel bezwarende elementen tegen Caminero waren dat die nu vier jaar cel en een megaboete van 4 miljoen euro eist."
                            },
                            {
                                "example_id": "4448afc8-f7ba-48a3-80d3-a46241d28bc5",
                                "sense_id": "91d80edb-18ca-33cc-a13f-901fbbcea98a",
                                "text": "Op woensdag 5 februari beslist de politie of er voldoende bezwarende elementen zijn om de zaak voor te leggen aan een onderzoeksrechter."
                            },
                            {
                                "example_id": "f6c4e380-0c55-458b-9c1b-a6e223f4f3bf",
                                "sense_id": "91d80edb-18ca-33cc-a13f-901fbbcea98a",
                                "text": "De vriendin van Brown legde echter bezwarende getuigenissen af, maar trok die later weer in."
                            }
                        ]
