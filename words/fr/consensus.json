{
    "word_family": [
        "consensuel",
        "consensuellement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6dd71860-1793-3961-a99a-a168ed4e2c1e",
                    "sense_definition": "Accord tacite ou formel entre plusieurs personnes ou parties sans opposition catégorique sur un sujet déterminé.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les membres du comité ont longuement discuté avant de parvenir à un <w>consensus</w> acceptable pour tous."
                        },
                        {
                            "text": "Cette proposition commence à faire <w>consensus</w> au sein de notre équipe de travail."
                        }
                    ],
                    "synonyms": [
                        "accord",
                        "entente"
                    ],
                    "antonyms": [
                        "dissensus"
                    ],
                    "common_phrases": [
                        "faire consensus",
                        "trouver un consensus",
                        "parvenir à un consensus"
                    ]
                },
                {
                    "sense_id": "f25a922a-789c-3bad-8cf9-b3217f8ef366",
                    "sense_definition": "Accord d'une très large majorité de la population, des spécialistes ou d'une communauté sur une idée ou une politique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette théorie scientifique fait aujourd'hui l'objet d'un large <w>consensus</w> international."
                        },
                        {
                            "text": "Il existe un véritable <w>consensus</w> citoyen sur la nécessité de préserver nos forêts."
                        }
                    ],
                    "synonyms": [
                        "unanimité",
                        "adhésion"
                    ],
                    "antonyms": [
                        "dissensus"
                    ],
                    "common_phrases": [
                        "large consensus",
                        "consensus général"
                    ]
                },
                {
                    "sense_id": "5e9e538e-e187-3614-b97b-47b2f01ebe1b",
                    "sense_definition": "Accord et synchronisation de plusieurs processus informatiques ou machines sur une valeur ou un état unique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce réseau distribué, les serveurs utilisent un protocole précis pour atteindre le <w>consensus</w>."
                        },
                        {
                            "text": "Un bon algorithme de <w>consensus</w> assure la sécurité des transactions sur la chaîne de blocs."
                        }
                    ],
                    "common_phrases": [
                        "algorithme de consensus"
                    ]
                },
                {
                    "sense_id": "e20795d0-2767-3e03-a616-339757bc982b",
                    "sense_definition": "Coordination ou action conjointe de plusieurs organes ou systèmes physiologiques dans l'accomplissement d'une fonction vitale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'homéostasie dépend du bon <w>consensus</w> entre le système respiratoire et le système circulatoire."
                        },
                        {
                            "text": "Le médecin constata une altération du <w>consensus</w> fonctionnel des organes vitaux du patient."
                        }
                    ],
                    "synonyms": [
                        "synergie",
                        "harmonie"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme médical désuet"
                        }
                    ]
                }
            ]
        }
    ]
}