                        "examples": [
                            {
                                "example_id": "2770b186-9976-4553-9c31-304710d7ee10",
                                "sense_id": "99c21c56-6cae-37ab-b891-558be34cb279",
                                "text": "Das Bundesamt für Verfassungsschutz und Terrorismusbekämpfung (BVT) schützt verfassungsmäßige Einrichtungen der Republik Österreich und deren Handlungsfähigkeit."
                            },
                            {
                                "example_id": "1e7e5ba9-522b-451f-ad0a-fd845a294432",
                                "sense_id": "99c21c56-6cae-37ab-b891-558be34cb279",
                                "text": "Das BVT ist dem Charakter nach Sicherheitsbehörde."
                            },
                            {
                                "example_id": "29f7a177-bf30-46f1-b96d-cfe631b17448",
                                "sense_id": "99c21c56-6cae-37ab-b891-558be34cb279",
                                "text": "Zu den Kernaufgaben des BVT zählen die Bekämpfung extremistischer und terroristischer Phänomene, der Spionage, des internationalen Waffenhandels, des Handels mit Kernmaterial und der organisierten Kriminalität in diesen Bereichen."
                            }
                        ],
