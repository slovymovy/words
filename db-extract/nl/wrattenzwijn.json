                ],
                "senses": [
                    {
                        "sense_id": "3bfd2fa2-2220-3a5d-851a-6484e67c2221",
                        "entry_id": "f9f10414-2190-3db4-a7d6-fb357119bb57",
                        "glosses": [
                            "benaming voor Afrikaanse wilde varkens uit het geslacht Phacochoerus"
                        ],
                        "tags": [
                            "evenhoevigen"
                        ],
                        "examples": [
                            {
                                "example_id": "7bd761c1-f828-4c80-a478-681aebf3793a",
                                "sense_id": "3bfd2fa2-2220-3a5d-851a-6484e67c2221",
                                "text": "Het wrattenzwijn wordt in Zuid-Afrika veel aangetroffen."
                            },
                            {
                                "example_id": "46e399c5-0876-4e7e-8936-64921bc8bf63",
                                "sense_id": "3bfd2fa2-2220-3a5d-851a-6484e67c2221",
                                "text": "De ziekte komt in het zuidelijk deel van Afrika voor bij het wrattenzwijn en het bosvarken en wordt overgebracht door teken of door contact tussen varkens."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b270e3f-1a13-360c-a297-28f54a0c129c",
                        "entry_id": "f9f10414-2190-3db4-a7d6-fb357119bb57",
                        "glosses": [
                            "benaming voor sommige Aziatische wilde zwijnen uit het geslacht Sus"
                        ],
                        "tags": [
                            "evenhoevigen"
                        ],
                        "examples": [
                            {
                                "example_id": "e534b573-1ef1-4b49-8ccb-bf25b17d3805",
                                "sense_id": "3b270e3f-1a13-360c-a297-28f54a0c129c",
                                "text": "Amper een jaar geleden baarde het opzien dat in een grot op Sulawesi (Indonesië), een rotstekening van een soort jachtscène was gevonden die bijna 44.000 jaar oud bleek te zijn. In een naburige grot is inmiddels een nóg oudere rotstekening gevonden van minstens 45.500 jaar oud: een wrattenzwijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "164091d4-9356-3851-bb3d-99ac6b134277",
                        "entry_id": "f9f10414-2190-3db4-a7d6-fb357119bb57",
                        "glosses": [
                            "verachtelijk, waardeloos persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "48893bcc-a674-4f3e-b9ae-538b39882154",
                                "sense_id": "164091d4-9356-3851-bb3d-99ac6b134277",
                                "text": "Hij houdt van België: „(Het) Belgische volk slaat zijn hoogwaardigheidsbekleders op de televisie gade - het Gentse Wrattenzwijn, de Worstenkop (-) - en besluit dat zijn eigen schilderachige interpretatie van de wet nog steeds ruimschoots gerechtvaardgd is.”"
                            }
                        ]
                    }
                ],
