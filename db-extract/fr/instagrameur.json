                "senses": [
                    {
                        "sense_id": "1a9d3b57-2126-3510-8357-8a688652074d",
                        "entry_id": "0490ea43-aed6-3ea1-909b-f0f032df6a39",
                        "glosses": [
                            "Utilisateur du réseau social Instagram."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "8c25c3af-acb5-4943-a6cc-f336c64332ac",
                                "sense_id": "1a9d3b57-2126-3510-8357-8a688652074d",
                                "text": "Tout part du compte « theshiggyshow », un instagrameur qui, pour fêter la sortie de l'album de Drake « Scorpion », s'est filmé devant sa portière de voiture en train de danser sur le fameux morceau « In my feelings »."
                            },
                            {
                                "example_id": "5a941e62-9412-41c0-979b-3f28dbb8ed96",
                                "sense_id": "1a9d3b57-2126-3510-8357-8a688652074d",
                                "text": "Pour teaser ses ootd (outfit of the day), Bastien, un instagrameur parisien [ayant] plus de 84 000 abonnés, a trouvé un moyen original de susciter l’intérêt."
                            },
                            {
                                "example_id": "367622b7-4bfa-40b3-910e-2a623a536105",
                                "sense_id": "1a9d3b57-2126-3510-8357-8a688652074d",
                                "text": "En attendant l’arrivée de la saison 3 d’Emily in Paris, le 21 décembre, vous pouvez patienter avec les gourmandises de l’''instagrameur Desserted in Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffed91b7-b992-366e-b07a-c22e830834b2",
                        "entry_id": "0490ea43-aed6-3ea1-909b-f0f032df6a39",
