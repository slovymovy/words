                "senses": [
                    {
                        "sense_id": "d9723e92-51bd-3970-8347-aed65e6cd269",
                        "entry_id": "241515c9-0001-300a-98b5-51869c5f5cee",
                        "glosses": [
                            "zoolog badający pajęczaki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e5a746b-061d-4f7e-b28a-dc932e6cc759",
                                "sense_id": "d9723e92-51bd-3970-8347-aed65e6cd269",
                                "text": "Jakiego pająka nazwano na cześć tego brazylijskiego arachnologa w 2017 roku?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ad14ae9-97a9-4be3-ac77-10d6a75b9074",
                        "source_entry_id": "241515c9-0001-300a-98b5-51869c5f5cee",
                        "source_sense_id": "d9723e92-51bd-3970-8347-aed65e6cd269",
                        "target_lang_word": "arachnologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arachnologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c07f1f-8f13-30e0-b1f6-139fe4a552b0",
                                        "entry_id": "ca7ff413-f00a-3055-a6c8-43df495129a3",
                                        "glosses": [
                                            "One who is engaged in arachnology, the study of arachnids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfbafabf-7534-4c79-bc18-edbe7c7f112e",
                        "source_entry_id": "241515c9-0001-300a-98b5-51869c5f5cee",
                        "source_sense_id": "d9723e92-51bd-3970-8347-aed65e6cd269",
                        "target_lang_word": "arachnologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arachnologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "221278ab-85cd-382b-8685-c45f96387247",
                                        "entry_id": "08b3b920-d430-35d2-bfd8-eb61113bc571",
                                        "glosses": [
                                            "Biologiste qui étudie les arachnides, leur vie et leurs mœurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c0ed39-bfc6-4b87-b615-a82e4a6eb850",
                                                "sense_id": "221278ab-85cd-382b-8685-c45f96387247",
                                                "text": "Pour l’arachnologue Pierre Paquin et le photographe naturaliste Gilles Arbour, décrire les richesses du patrimoine naturel permet de mieux protéger les milieux dont nous dépendons, comme les tourbières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8008f72b-bc0a-3cb7-9b36-822b95ccae97",
                                        "entry_id": "08b3b920-d430-35d2-bfd8-eb61113bc571",
                                        "glosses": [
                                            "Aranéologue, spécialiste de l’étude des araignées."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9eba367-aba6-4e85-8b90-e3b737a62f29",
                                                "sense_id": "8008f72b-bc0a-3cb7-9b36-822b95ccae97",
                                                "text": "Si j’étais fabricant de gilets en Kevlar, j’aurais peut-être envie de faire appel à un arachnologue, autrement dit à un spécialiste des araignées."
                                            },
                                            {
                                                "example_id": "e7001961-e6eb-4615-ad4b-c4342782534c",
                                                "sense_id": "8008f72b-bc0a-3cb7-9b36-822b95ccae97",
                                                "text": "Deux types d’araignées sont distingués par les arachnologues : les mygalomorphes (ou araignées primitives), […], et les aranéomorphes (araignées à proprement parler), où deux envenimations sont à développer , […], le latrodectisme et le loxoscélisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60b3811f-0d36-4211-bf1c-46707d2fefb2",
                        "source_entry_id": "241515c9-0001-300a-98b5-51869c5f5cee",
                        "source_sense_id": "d9723e92-51bd-3970-8347-aed65e6cd269",
                        "target_lang_word": "arachnologiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arachnologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d66b6c5e-40a9-3063-b879-fb25e432538c",
                                        "entry_id": "4945db98-0459-3555-85c4-2f5b510c8daa",
                                        "glosses": [
                                            "Zoologiste qui étudie les araignées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aeb5c2b-42f8-404e-b66e-f8e640bc5e0b",
                                                "sense_id": "d66b6c5e-40a9-3063-b879-fb25e432538c",
                                                "text": "Écrit par un arachnologiste réputé, cet ouvrage est bien plus qu’une introduction biologique à la connaissance des 584 espèces d’araignées des îles Britanniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
