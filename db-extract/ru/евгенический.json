                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91de4e9d-ba0a-44f2-a26a-9690d58e11c3",
                                                "sense_id": "a92101e2-48ec-3a2b-893e-c56c1c7b1dbb",
