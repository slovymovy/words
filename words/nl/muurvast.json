{
    "word_family": [
        "muur",
        "vast"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae9fe440-95f7-3b8e-ace5-3d217b0eeffa",
                    "sense_definition": "Volkomen vastzittend of onveranderlijk; zonder enige mogelijkheid tot beweging of verandering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vastheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het ernstige ongeval staat het verkeer op de snelweg al uren <w>muurvast</w>.",
                            "target_lang_translations": {
                                "fr": "En raison du grave accident, la circulation sur l'autoroute est <w>complètement bloquée</w> depuis des heures."
                            }
                        },
                        {
                            "text": "De onderhandelingen zitten <w>muurvast</w> omdat geen van beide partijen wil toegeven.",
                            "target_lang_translations": {
                                "fr": "Les négociations sont <w>dans une impasse totale</w> car aucune des deux parties ne veut céder."
                            }
                        }
                    ],
                    "synonyms": [
                        "onwrikbaar",
                        "onbeweeglijk"
                    ],
                    "common_phrases": [
                        "muurvast zitten",
                        "muurvast staan"
                    ],
                    "target_lang_definitions": {
                        "fr": "Complètement bloqué, coincé ou figé ; sans possibilité de mouvement ou d'évolution."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "complètement bloqué",
                                "target_lang_sense_clarification": "pour la circulation ou une situation sans issue"
                            },
                            {
                                "target_lang_word": "dans l'impasse",
                                "target_lang_sense_clarification": "pour des négociations ou un processus figuré"
                            },
                            {
                                "target_lang_word": "coincé",
                                "target_lang_sense_clarification": "dans le sens d'immobilisé"
                            },
                            {
                                "target_lang_word": "inextricable",
                                "target_lang_sense_clarification": "d'une situation figée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42bf8093-c2c0-306a-ae14-2fef252f06d9",
                    "sense_definition": "Stevig en onbeweeglijk in een muur verankerd of bevestigd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vastheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zware boekenplank is met speciale pluggen <w>muurvast</w> gemonteerd.",
                            "target_lang_translations": {
                                "fr": "La lourde étagère a été montée <w>solidement fixée au mur</w> à l'aide de chevilles spéciales."
                            }
                        },
                        {
                            "text": "Deze <w>muurvaste</w> kluis kan door inbrekers onmogelijk worden meegenomen.",
                            "target_lang_translations": {
                                "fr": "Ce coffre-fort <w>scellé au mur</w> ne peut absolument pas être emporté par des cambrioleurs."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Solidement fixé ou ancré au mur, inamovible."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "scellé au mur",
                                "target_lang_sense_clarification": "fixé de façon inamovible"
                            },
                            {
                                "target_lang_word": "mural",
                                "target_lang_sense_clarification": "encastré ou fixé au mur"
                            },
                            {
                                "target_lang_word": "solidement fixé au mur",
                                "target_lang_sense_clarification": "ancré solidement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}