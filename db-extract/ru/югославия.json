                                "target_senses": [
                                    {
                                        "sense_id": "d6dc9128-7cb7-373e-bce3-f367932380c3",
                                        "entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                                        "glosses": [
                                            "A former country in Southeast Europe in the Balkans, now split into 6 countries: Bosnia and Herzegovina, Croatia, North Macedonia, Montenegro, Serbia, and Slovenia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cfa1e4-eb10-4ba3-bc30-81d89bffdaf5",
                                                "sense_id": "d6dc9128-7cb7-373e-bce3-f367932380c3",
                                                "text": "This all relates to what happened in the 1990s, in the bloody aftermath of Yugoslavia splintering into separate nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "111e29ac-2d2c-37c1-be3f-0633bef35417",
                                        "entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                                        "glosses": [
                                            "A former country in Southeast Europe in the Balkans, now split into 6 countries: Bosnia and Herzegovina, Croatia, North Macedonia, Montenegro, Serbia, and Slovenia.",
                                            "The Kingdom of Yugoslavia, a kingdom ruled by the House of Karađorđević which existed from 1918 to 1941."
                                        ],
                                        "tags": [
                                            "historical",
                                            "specific"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d2f7eb5-fc87-356d-8392-cbd2c1ea8310",
                                        "entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                                        "glosses": [
                                            "A former country in Southeast Europe in the Balkans, now split into 6 countries: Bosnia and Herzegovina, Croatia, North Macedonia, Montenegro, Serbia, and Slovenia.",
                                            "The Socialist Federal Republic of Yugoslavia, a communist state which existed from 1945 to 1992."
                                        ],
                                        "tags": [
                                            "historical",
                                            "specific"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f70b9f6c-beee-33ea-afa1-985f1ffd1eee",
                                        "entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                                        "glosses": [
                                            "A former country in Southeast Europe, a rump state formed by Serbia and Montenegro after 1992; in full, Federal Republic of Yugoslavia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a057d30-f368-438c-8031-cfa07540ffe4",
                                                "sense_id": "f70b9f6c-beee-33ea-afa1-985f1ffd1eee",
                                                "text": "Yugoslavia’s President, Slobodan Milosevic, has rejected all efforts at meaningful diplomacy and, in violation of his own previous commitments, has ratcheted up his military campaign against the innocent civilians of Kosovo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b39eef5-cff4-3ca1-ac4f-816ed409288b",
                                        "entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                                        "glosses": [
                                            "A former country in Southeast Europe, a rump state formed by Serbia and Montenegro after 1992; in full, Federal Republic of Yugoslavia.",
                                            "Serbia and Montenegro, after 2003 until 2006, when it disintegrated."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "historical",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9821608-130e-4637-bb81-f0af0af17247",
                        "source_entry_id": "fe20e5a8-ee42-31ea-bc84-93705f1a6b0e",
                        "source_sense_id": "6c01dbef-a6e2-381f-8e86-7864da3957b8",
                        "target_lang_word": "Yougoslavie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yougoslavie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                        "entry_id": "2a4a7891-f835-3b4a-ba8a-e221609c3c8d",
                                        "glosses": [
                                            "Ancien pays slave qui était composé des actuels Croatie, Kosovo, Serbie, Monténégro, Bosnie-Herzégovine, Slovénie et Macédoine."
                                        ],
                                        "tags": [
                                            "Yougoslavie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20de53a8-24bf-4874-bfad-ecf808a27cbc",
                                                "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                                "text": "La Yougoslavie est un État indépendant depuis 1918, mais elle n'a été connue sous ce nom qu'à partir de 1929."
                                            },
                                            {
                                                "example_id": "1dd5081d-c1f7-489e-9783-a4774c493ed9",
                                                "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                                "text": "Le cinéaste Rajko Grlič, interviewé au festival du film de La Rochelle, l’été 1985, disait en substance qu’en Yougoslavie, tout change tous les cinq kilomètres : les gens, la langue, la religion, le paysage…"
                                            },
                                            {
                                                "example_id": "024c8740-98af-4fb0-9660-03991d8140cf",
                                                "sense_id": "a08240ab-6fc2-3bdf-a4f9-a2df5fdb96b1",
                                                "text": "Et que serait-il arrivé si Faruk n’avait pas raté le pénalty ? Oui, ce pénalty-là, le dernier pénalty de la Yougoslavie, le rideau qui tombe sur la fin de la pièce. Ça n’aurait rien changé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
