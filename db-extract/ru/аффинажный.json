                "senses": [
                    {
                        "sense_id": "2d336af7-9cb7-3996-9985-903bb9de28d8",
                        "entry_id": "7f297939-200f-30c2-bab5-6461a6fab663",
                        "glosses": [
                            "спец. связанный, соотносящийся по значению с существительным аффинаж; относящийся к переработке промышленных продуктов с целью извлечения драгоценных металлов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76237c76-c619-4682-8190-7d9d561d2239",
                                "sense_id": "2d336af7-9cb7-3996-9985-903bb9de28d8",
                                "text": "Урал даёт сотни килограммов серебра. Но видят его в чистом виде только работники аффинажного (очистительного) завода."
                            }
                        ]
                    }
