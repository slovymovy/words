            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "035f332a-fd7f-325a-a374-dd208e0661d3",
                    "sense_definition": "Having elegance, taste, or refinement in manners, appearance, or dress.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fashionable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always wears such <w>stylish</w> clothes even when she is just going to the grocery store.",
                            "target_lang_translations": {
                                "ru": "Она всегда носит такую <w>стильную</w> одежду, даже когда просто идет в продуктовый магазин."
                            }
                        },
                        {
                            "text": "The boutique is known for its <w>stylish</w> outfit choices that appeal to young professionals.",
                            "target_lang_translations": {
                                "ru": "Бутик известен своим выбором <w>стильных</w> нарядов, которые нравятся молодым специалистам."
                            }
                        }
                    ],
                    "synonyms": [
                        "chic"
                    ],
                    "antonyms": [
                        "unstylish"
                    ],
                    "common_phrases": [
                        "stylish outfit",
                        "stylish clothes",
                        "stylish appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий элегантностью, вкусом или изысканностью в манерах, внешнем виде или одежде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стильный",
                                "target_lang_sense_clarification": "о внешнем виде или одежде"
                            },
                            {
                                "target_lang_word": "модный",
                                "target_lang_sense_clarification": "соответствующий моде"
                            },
                            {
                                "target_lang_word": "элегантный",
                                "target_lang_sense_clarification": "изысканный и со вкусом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e89d2f1-6f5e-3a78-a227-cb4d4d5873e0",
                    "sense_definition": "Characterized by a specific, often sophisticated, directing style or visual cinematography in media.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "artistic_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director is famous for his <w>stylish</w> noir films that use dramatic lighting and shadows.",
                            "target_lang_translations": {
                                "ru": "Режиссер знаменит своими <w>стильными</w> нуарными фильмами, в которых используются драматическое освещение и тени."
                            }
                        },
                        {
                            "text": "Critics praised the <w>stylish</w> direction of the music video for its innovative camera work.",
                            "target_lang_translations": {
                                "ru": "Критики похвалили <w>стильную</w> режиссуру музыкального клипа за инновационную операторскую работу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stylish direction",
                        "stylish cinematography"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся особым, часто утонченным режиссерским стилем или визуальной кинематографией в медиа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стильный",
                                "target_lang_sense_clarification": "об эстетике фильма или видео"
                            },
                            {
                                "target_lang_word": "эстетичный",
                                "target_lang_sense_clarification": "визуально проработанный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
