                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94ec2f9a-9616-4168-ac0a-f4090cc6a828",
                        "source_entry_id": "25177771-92ce-3947-be2f-afbe4ea131ee",
                        "source_sense_id": "855f378c-a07c-33a2-a725-ceeb5cdcdb2e",
                        "target_lang_word": "timing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e2dbbe-721d-31b4-b3d1-25b893123ee6",
                                        "entry_id": "d9360c77-eb31-33fa-8d47-b0e4c894cf2b",
                                        "glosses": [
                                            "An occurrence or event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ff2934e-6168-325f-bbb5-ff73606da6e7",
                                        "entry_id": "d9360c77-eb31-33fa-8d47-b0e4c894cf2b",
                                        "glosses": [
                                            "The regulation of the pace of e.g. an athletic race, the speed of an engine, the delivery of a joke, or the occurrence of a series of events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9f007e-bf37-439b-b6f7-13b77cde0474",
                                                "sense_id": "2ff2934e-6168-325f-bbb5-ff73606da6e7",
                                                "text": "The key to telling a good joke is timing."
                                            },
                                            {
                                                "example_id": "79508227-0db9-4832-b21f-e3b1660698c3",
                                                "sense_id": "2ff2934e-6168-325f-bbb5-ff73606da6e7",
                                                "text": "The officials used the latest technology to ensure timing down to the nearest millisecond."
                                            },
                                            {
                                                "example_id": "f82f24bc-774c-403a-b1b6-9cc011388af9",
                                                "sense_id": "2ff2934e-6168-325f-bbb5-ff73606da6e7",
                                                "text": "The S.D.R. [Somerset & Dorset Railway] could not adhere to this schedule, and had to decelerate the service, but the original timings were restored when the M.R. and L.S.W.R. leased the S.D.R."
                                            },
                                            {
                                                "example_id": "93e16407-4c10-4ac1-9cb1-d0b12940f17b",
                                                "sense_id": "2ff2934e-6168-325f-bbb5-ff73606da6e7",
                                                "text": "Smoking was difficult, I had to have perfect timing, sticking my head as far out the tiny porthole as I could, and timing my puffs to the inhalings and exhalings of the ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e09997c-a833-31b9-aa9b-a51702571feb",
                                        "entry_id": "d9360c77-eb31-33fa-8d47-b0e4c894cf2b",
                                        "glosses": [
                                            "The time when something happens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7ee447-e8c5-47e5-925c-96f833210f2c",
                                                "sense_id": "9e09997c-a833-31b9-aa9b-a51702571feb",
                                                "text": "perfect timing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9ea9ee5-6f32-35de-8f18-39aeb4a0c36e",
                                        "entry_id": "d9360c77-eb31-33fa-8d47-b0e4c894cf2b",
                                        "glosses": [
                                            "The synchronization of the firing of the spark plugs in an internal combustion engine."
                                        ],
