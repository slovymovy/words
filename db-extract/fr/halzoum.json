                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8f16a9-b095-486e-a27a-c7b7aad503e4",
                                "sense_id": "887d872a-2433-30be-a50f-58ddbd981dd3",
                                "text": "Fasciolose bucco-pharyngée : parfois signalée au Proche-Orient (Liban, etc.) où elle est désignée sous le nom de « halzoum»."
                            },
                            {
                                "example_id": "373220bf-98dc-4fd6-9eff-8ed5407b45fd",
                                "sense_id": "887d872a-2433-30be-a50f-58ddbd981dd3",
                                "text": "Le halzoum , maladie de l'Orient , résulte de l'implantation bucco-pharyngée directe de douves adultes, lors de la consommation de foie cru. Chez l'homme , c'est Fasciola hepatica qui résume toute l'histoire de la distomatose ;…."
                            }
