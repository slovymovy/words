                },
                {
                    "sense_id": "9e0553d9-5af2-3c70-80f5-175b2496667c",
                    "sense_definition": "Het officiële oordeel of de beslissing van een rechter of rechtbank.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rechtspraak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter doet volgende week vrijdag eindelijk een <w>uitspraak</w> in deze zaak.",
                            "target_lang_translations": {
                                "en": "The judge will finally deliver a <w>verdict</w> in this case next Friday.",
                                "ru": "Судья наконец вынесет <w>решение</w> по этому делу в следующую пятницу."
                            }
                        },
                        {
                            "text": "De advocaat was niet tevreden met de <w>uitspraak</w> van het gerechtshof.",
                            "target_lang_translations": {
                                "en": "The lawyer was not satisfied with the <w>ruling</w> of the court of appeal.",
                                "ru": "Адвокат не был удовлетворен <w>постановлением</w> апелляционного суда."
                            }
                        }
                    ],
                    "synonyms": [
                        "vonnis"
                    ],
                    "common_phrases": [
                        "uitspraak doen",
                        "rechterlijke uitspraak"
                    ],
                    "target_lang_definitions": {
                        "en": "The official judgment or decision made by a judge or a court of law.",
                        "ru": "Официальное решение или вердикт судьи или суда."
                    },
                    "translations": {
