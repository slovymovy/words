                    "sense_id": "3c448263-e438-3c15-89cd-e77025b55e95",
                    "sense_definition": "in zijn eer of trots aangetast; beledigd of gekwetst",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>gekrenkte</w> trots zorgde ervoor dat hij niet meer naar het feest wilde komen.",
                            "target_lang_translations": {
                                "pl": "Jego <w>urażona</w> duma sprawiła, że nie chciał już przyjść na imprezę."
                            }
                        },
                        {
                            "text": "Zij voelde zich diep <w>gekrenkt</w> door de oneerlijke opmerkingen van haar collega.",
                            "target_lang_translations": {
                                "pl": "Poczuła się głęboko <w>dotknięta</w> niesprawiedliwymi uwagami swojego kolegi z pracy."
                            }
                        }
                    ],
                    "synonyms": [
                        "beledigd",
                        "gekwetst"
                    ],
                    "antonyms": [
                        "ongekrenkt"
                    ],
                    "common_phrases": [
                        "gekrenkte trots"
                    ],
                    "target_lang_definitions": {
                        "pl": "taki, którego duma lub honor zostały urażone; obrażony, dotknięty"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "urażony",
                                "target_lang_sense_clarification": "o osobie lub dumie"
                            },
                            {
                                "target_lang_word": "dotknięty",
                                "target_lang_sense_clarification": "głęboko poruszony przykrą uwagą"
                            },
                            {
                                "target_lang_word": "zraniony",
                                "target_lang_sense_clarification": "np. o dumie lub uczuciach"
                            }
                        ]
                    }
                }
            ]
        },
        {
