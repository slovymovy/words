                "senses": [
                    {
                        "sense_id": "de195bd9-c1f6-31a6-9df8-23ef01e83f6d",
                        "entry_id": "06752a4b-cbf7-3e08-96f1-7d0d1334d962",
                        "glosses": [
                            "mythische Erklärung für den Ursprung eines Namens, Objekts, Brauchs, Ereignisses oder desgleichen"
                        ],
                        "tags": [
                            "Antikes Griechenland"
                        ],
                        "examples": [
                            {
                                "example_id": "bc514d18-3298-4335-a87b-88484ef7a588",
                                "sense_id": "de195bd9-c1f6-31a6-9df8-23ef01e83f6d",
                                "text": "„Hadrians Epigramm ist es auch, dass die Erinnerung an den Garten des Narkissos aufbewahrt: die Geschichte von Narkissos' Tod und Verwandlung ist das Aition des lokalen Kults.“"
                            },
                            {
                                "example_id": "3faa9407-4a59-4693-8f09-f370ca222320",
                                "sense_id": "de195bd9-c1f6-31a6-9df8-23ef01e83f6d",
                                "text": "„Das letzte Aition des Buchs behandelte wahrscheinlich den Brauch der kalabresischen Lokrer, demzufolge die Statue des Olympiasiegers Euthykles wie ein Götterbild geehrt worden sei […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
