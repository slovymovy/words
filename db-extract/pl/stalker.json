                                "target_senses": [
                                    {
                                        "sense_id": "6d86487b-24e9-330f-a7ca-c2746f84c284",
                                        "entry_id": "0f6ce4e2-c4d8-3a9d-9b57-3cfeaa700fd8",
                                        "glosses": [
                                            "A person who engages in stalking, i.e., quietly approaching animals to be hunted; a tracker or guide in hunting game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8673f9c-302e-3d01-bbc6-2ec0e72483c8",
                                        "entry_id": "0f6ce4e2-c4d8-3a9d-9b57-3cfeaa700fd8",
                                        "glosses": [
                                            "A person who secretly follows someone, sometimes with unlawful intentions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20406454-ada5-46b8-a72a-8e405a42955e",
                                                "sense_id": "d8673f9c-302e-3d01-bbc6-2ec0e72483c8",
                                                "text": "If the stalker thriller “Obsessed,” which opens on Friday, tops the box office, Clinton R. Culpepper will cement his reputation as Hollywood’s king of the schlockbuster."
                                            },
                                            {
                                                "example_id": "7e8864f7-c677-49c7-b5dd-e9c1ea10deb9",
                                                "sense_id": "d8673f9c-302e-3d01-bbc6-2ec0e72483c8",
                                                "text": "Ordinary people have already been face-swapped into videos for humorous or prank purposes and there is no reason to believe that abusers, harassers, stalkers, and blackmailers will not soon be face-swapping victims into compromising video as part of their arsenal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3629df9-5f1a-30d2-a429-035b0dee3994",
                                        "entry_id": "0f6ce4e2-c4d8-3a9d-9b57-3cfeaa700fd8",
                                        "glosses": [
                                            "Any of various devices for removing the stalk from plants during harvesting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e6fb4d7-11f6-365d-b860-fb284ac21f70",
                                        "entry_id": "0f6ce4e2-c4d8-3a9d-9b57-3cfeaa700fd8",
                                        "glosses": [
                                            "Any bird that walks with a stalking motion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b8fe1b1-d610-3108-bc3c-a1e1211c42dd",
                                        "entry_id": "0f6ce4e2-c4d8-3a9d-9b57-3cfeaa700fd8",
                                        "glosses": [
                                            "A kind of fishing net."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f95633a4-e7d5-3061-99b0-22c6073a52c3",
                                        "entry_id": "0f6ce4e2-c4d8-3a9d-9b57-3cfeaa700fd8",
                                        "glosses": [
                                            "A horse that tends to stay just behind the leaders in a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba3680a9-1684-49e9-9d3d-b3f5f761da46",
                                                "sense_id": "f95633a4-e7d5-3061-99b0-22c6073a52c3",
                                                "text": "If the class of the field is a stalker, I'm all in in terms of evaluating his chances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efa04e7b-d94a-45ac-a44b-956fc259cfe5",
                        "source_entry_id": "7d91d9a4-cf5e-393d-87a8-88ed07d2daec",
                        "source_sense_id": "0a73bd27-fb38-3b16-ac74-c70da4ec6a40",
                        "target_lang_word": "rôdeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rôdeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb843675-a2cd-34a4-8d25-9cdcd59a6e93",
                                        "entry_id": "9637b4d4-958f-362c-97cf-3c88e1bf3c2d",
                                        "glosses": [
                                            "Qui rôde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "906e7058-9510-4996-9dbe-dd201b302575",
                                                "sense_id": "fb843675-a2cd-34a4-8d25-9cdcd59a6e93",
                                                "text": "Et les pâtes superbement se lèvent\nEt les boudins jutent de sève,\nEt la rôdeuse odeur de leur cuisson\nCourant de bouge en ferme et de ferme en maison\nLa prétentaine,\nFait se pâmer, à l’unisson,\nLes nez, les cœurs et les bedaines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rôdeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d489f53-8f45-348d-b8a3-c18937eab2dd",
                                        "entry_id": "ced29caa-15cb-30b2-9694-b5cb97b947c6",
                                        "glosses": [
                                            "Celui qui rôde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c8e2f9-62a1-4ddb-bedd-0845e518adc7",
                                                "sense_id": "7d489f53-8f45-348d-b8a3-c18937eab2dd",
                                                "text": "[…] elle craignait que des rôdeurs ne s’introduisissent la nuit dans cette maison abandonnée et n'y découvrissent les cadavres... ou... qui sait?... la fortune de Nosbitt, que les assassins y auraient cachée, après l'avoir tué, lui aussi."
                                            },
                                            {
                                                "example_id": "7023da3e-b65d-4d5a-98af-de469c907586",
                                                "sense_id": "7d489f53-8f45-348d-b8a3-c18937eab2dd",
                                                "text": "Mais ce n’était déjà plus le jeune homme libre, le rôdeur de forêts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8af2a124-8a96-344e-bb0d-ff6f04ba1b5a",
                                        "entry_id": "ced29caa-15cb-30b2-9694-b5cb97b947c6",
                                        "glosses": [
                                            "Classe de combattant, habile à utiliser les armes à distance."
                                        ],
                                        "tags": [
                                            "Jeux de rôle",
                                            "Jeux de rôle d’action-aventure"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
