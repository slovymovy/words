                    "sense_id": "32514b2d-a6d1-3127-b76c-be7b258cb505",
                    "sense_definition": "Simple past and past participle of <w>move</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>moved</w> to a new apartment in the city last month.",
                            "target_lang_translations": {
                                "ru": "В прошлом месяце мы <w>переехали</w> в новую квартиру в городе.",
                                "es": "El mes pasado nos <w>mudamos</w> a un apartamento nuevo en la ciudad."
                            }
                        },
                        {
                            "text": "She has <w>moved</w> the heavy table to the other side of the room.",
                            "target_lang_translations": {
                                "ru": "Она <w>передвинула</w> тяжелый стол в другую часть комнаты.",
                                "es": "Ella ha <w>movido</w> la mesa pesada al otro lado de la habitación."
                            }
                        }
                    ],
                    "common_phrases": [
                        "moved away",
                        "moved on",
                        "moved in"
                    ],
                    "traits": [
                        {
