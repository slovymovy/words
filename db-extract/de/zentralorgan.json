                ],
                "senses": [
                    {
                        "sense_id": "72ff6afc-e4d5-3af8-8823-eccf9a2756ee",
                        "entry_id": "16beaf58-0440-3d0c-bad0-546cd498e025",
                        "glosses": [
                            "Mitteilungsblatt einer Gruppierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a341e45-da2e-4422-ba2c-bbba95e3836d",
                                "sense_id": "72ff6afc-e4d5-3af8-8823-eccf9a2756ee",
                                "text": "„Das Blatt gilt nicht gerade als Zentralorgan für Kapitalismuskritik.“"
                            },
                            {
                                "example_id": "6279351f-3117-47cd-b5b4-e38805794512",
                                "sense_id": "72ff6afc-e4d5-3af8-8823-eccf9a2756ee",
                                "text": "„In der Zeit des Ständestaats (1934-1938) war er für die damals verbotene 'Arbeiter-Zeitung', das Zentralorgan der österreichischen Sozialdemokratie, tätig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "94eb3f08-26f6-3b04-b5c1-d0aa1283177d",
                        "entry_id": "16beaf58-0440-3d0c-bad0-546cd498e025",
                        "glosses": [
                            "das Herz in seiner Funktion für den Blutkreislauf im Besonderen und die Lebensfunktionen im Allgemeinen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "2e6d26ec-d58a-483d-9c2e-97298e74c36a",
                                "sense_id": "94eb3f08-26f6-3b04-b5c1-d0aa1283177d",
                                "text": "„Die Lebensgeister übermitteln die Bewegungsimpulse auch zum biologischen Zentralorgan (Herz).“"
                            },
                            {
                                "example_id": "20614364-5654-4ce3-a58c-36b306e21773",
                                "sense_id": "94eb3f08-26f6-3b04-b5c1-d0aa1283177d",
                                "text": "„Für Aristoteles stand fest, dass das Herz das Zentralorgan des Menschen sei.“"
                            },
                            {
                                "example_id": "8b45c31f-cdbb-4bf4-90a7-34583f591c98",
                                "sense_id": "94eb3f08-26f6-3b04-b5c1-d0aa1283177d",
                                "text": "„Der griechische Philosoph Alkmaion erkannte, dass nicht das Herz die ihm in der Antike noch zugesprochene Rolle als Zentralorgan der Wahrnehmung und der Erkenntnis hat, sondern das Gehirn.“"
                            },
                            {
                                "example_id": "c62d0618-82dd-41ac-a468-52ca6270e3e2",
                                "sense_id": "94eb3f08-26f6-3b04-b5c1-d0aa1283177d",
                                "text": "„Es ist das Zentralorgan des Kreislaufs, das Blut durch den Körper befördert.“"
                            },
                            {
                                "example_id": "3b598310-226c-4cf0-b017-5edfd889d6c5",
                                "sense_id": "94eb3f08-26f6-3b04-b5c1-d0aa1283177d",
                                "text": "„Unser Zentralorgan in der Mitte des Brustkorbs ist gewissermaßen der Motor des Lebens und treibt den Kreislauf an.“"
                            },
                            {
                                "example_id": "0cae70fd-866c-4218-a811-56274c3eed47",
                                "sense_id": "94eb3f08-26f6-3b04-b5c1-d0aa1283177d",
                                "text": "„Nun hängt aber anima, die psychische Konstitution, von der Temperatur des Zentralorganes Herz ab […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
