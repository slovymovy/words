{
    "word_family": [
        "litigation",
        "litigator",
        "litigious",
        "litigant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fa47df5-a258-32a2-bd79-644aa411f3b6",
                    "sense_definition": "To initiate or carry on a lawsuit; to go to court to resolve a legal dispute.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the company refuses to pay the damages, we will have no choice but to <w>litigate</w>."
                        },
                        {
                            "text": "Instead of trying to <w>litigate</w> a dispute, they decided to settle the matter through mediation."
                        }
                    ],
                    "synonyms": [
                        "sue",
                        "prosecute"
                    ],
                    "antonyms": [
                        "settle"
                    ],
                    "common_phrases": [
                        "decide to litigate",
                        "litigate a dispute"
                    ]
                },
                {
                    "sense_id": "b66c066a-883d-3982-a42d-13084887b125",
                    "sense_definition": "To contest or argue a specific case, claim, or issue in a court of law.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyers are prepared to <w>litigate</w> the patent claim in federal court."
                        },
                        {
                            "text": "It is expensive to <w>litigate</w> a case of this scale over several years."
                        }
                    ],
                    "synonyms": [
                        "contest",
                        "dispute"
                    ],
                    "common_phrases": [
                        "litigate a case",
                        "litigate the claim"
                    ]
                },
                {
                    "sense_id": "144374b2-06f4-3fa1-b118-52300e0022e3",
                    "sense_definition": "To argue, dispute, or fight over something repeatedly (often used metaphorically outside of a courtroom).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot spend the entire meeting trying to <w>litigate</w> past decisions."
                        },
                        {
                            "text": "There is no point trying to <w>litigate</w> this same argument when we have already moved on."
                        }
                    ],
                    "synonyms": [
                        "dispute",
                        "debate",
                        "wrangle"
                    ],
                    "common_phrases": [
                        "litigate the past",
                        "litigate this point"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used metaphorically to mean arguing or debating endlessly"
                        }
                    ]
                }
            ]
        }
    ]
}