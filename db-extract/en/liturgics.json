                                "target_word": "Liturgiewissenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8af8e77-4361-360d-9536-16ac816f94bc",
                                        "entry_id": "c9010091-dc54-34e5-b8c7-793a0583372b",
                                        "glosses": [
                                            "Lehre von der Liturgie; das Verstehen, Gestalten und Analysieren liturgischer Abläufe (Gottesdienstordnung, Texte, Zeremonien, Gegenstände und Bücher)"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b05d6f-f855-4989-b922-62da07d1d316",
                                                "sense_id": "e8af8e77-4361-360d-9536-16ac816f94bc",
                                                "text": "Die Liturgiewissenschaft gehört zur praktischen Theologie."
                                            },
                                            {
                                                "example_id": "3c0d8c3e-4cdc-4dbc-9c4d-0c51bccffcd1",
                                                "sense_id": "e8af8e77-4361-360d-9536-16ac816f94bc",
                                                "text": "„Das Lehrfach Liturgiewissenschaft ist in den Seminarien und den Studienhäusern der Orden zu den notwendigen und wichtigen Fächern und an den Theologischen Fakultäten zu den Hauptfächern zu rechnen. Es ist sowohl unter theologischem und historischem wie auch unter geistlichem, seelsorglichem und rechtlichem Gesichtspunkt zu behandeln.“"
                                            },
                                            {
                                                "example_id": "917b6edf-8691-44a5-8ff7-5ba26ca56032",
                                                "sense_id": "e8af8e77-4361-360d-9536-16ac816f94bc",
                                                "text": "„Im Studiengang Liturgiewissenschaft sollen vertiefte Kenntnisse der Geschichte des christlichen Gottesdienstes, seiner Theologie und Praxis vermittelt werden. Darüber hinaus wird in kultur- und sozialwissenschaftliche Zusammenhänge, soweit sie den Gottesdienst betreffen, eingeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
