                "senses": [
                    {
                        "sense_id": "2028d69b-e6bf-3961-b41b-5f8db98693d5",
                        "entry_id": "dd421add-6751-32ba-8eac-077931321790",
                        "glosses": [
                            "kontrollierende, auch nachträgliche Nachschau der zuvor zolltechnisch deklarierten Waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc06d6d-dc9c-4c49-8377-644951bdcbc7",
                                "sense_id": "2028d69b-e6bf-3961-b41b-5f8db98693d5",
                                "text": "„Unter anderem wurde befohlen, das Gepäck des Reisenden ohne Zollrevision passieren zu lassen, was unter den damaligen Verhältnissen als große Vergünstigung galt, von Ingen- Housz aber auch als eine wahre Wohltat empfunden wurde.“"
                            },
                            {
                                "example_id": "f61ad786-829a-47de-b4ad-e9961518a0be",
                                "sense_id": "2028d69b-e6bf-3961-b41b-5f8db98693d5",
                                "text": "„Das aufgegebene Gepäck, das den vorbezeichneten Personen gehört, ist gegen Vorlegung einer entsprechenden Bescheinigung ebenfalls von der deutschen Zollrevision befreit.“"
                            },
                            {
                                "example_id": "be09f005-5603-4492-bdcf-4190e925e335",
                                "sense_id": "2028d69b-e6bf-3961-b41b-5f8db98693d5",
                                "text": "„Also wieder herauf an Deck mit den Kisten und Kasten und heraus aus dem Schiff in eine riesige Halle, wo die Zollrevision vor sich ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
