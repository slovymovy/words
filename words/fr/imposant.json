                {
                    "sense_id": "13ef94f4-7ec4-3ebe-84ac-61a797f5b9f4",
                    "sense_definition": "Qui est considérable par le nombre, le volume ou la puissance, au point d'inspirer la crainte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée a déployé un dispositif militaire particulièrement <w>imposant</w> le long de la frontière.",
                            "target_lang_translations": {
                                "en": "The army deployed a particularly <w>massive</w> military force along the border.",
                                "ru": "Армия вдоль границы развернула особенно <w>внушительную</w> военную группировку.",
                                "de": "Die Armee hat entlang der Grenze ein besonders <w>massives</w> militärisches Aufgebot aufgestellt.",
                                "es": "El ejército desplegó a lo largo de la frontera un dispositivo militar especialmente <w>imponente</w>.",
                                "zh": "军队沿边境部署了一支规模格外<w>庞大</w>的军事力量。"
                            }
                        },
                        {
                            "text": "Devant une mobilisation si <w>imposante</w>, les autorités ont rapidement ouvert des négociations.",
                            "target_lang_translations": {
                                "en": "Faced with such a <w>massive</w> mobilisation, the authorities quickly opened negotiations.",
                                "ru": "Перед такой <w>внушительной</w> мобилизацией власти быстро начали переговоры.",
                                "de": "Angesichts einer so <w>gewaltigen</w> Mobilisierung nahmen die Behörden rasch Verhandlungen auf.",
                                "es": "Ante una movilización tan <w>masiva</w>, las autoridades abrieron rápidamente negociaciones.",
                                "zh": "面对如此<w>庞大</w>的动员，当局迅速开始了谈判。"
                            }
                        }
                    ],
                    "synonyms": [
                        "massif",
                        "redoutable"
                    ],
                    "antonyms": [
                        "négligeable",
                        "dérisoire"
                    ],
                    "common_phrases": [
                        "forces imposantes",
                        "dispositif imposant"
                    ],
                    "target_lang_definitions": {
                        "en": "Very large in number, volume or power, enough to inspire fear.",
                        "ru": "Очень большой по количеству, объёму или мощи, способный внушать страх.",
                        "de": "Sehr groß an Zahl, Umfang oder Stärke, sodass es Furcht einflößt.",
                        "es": "Muy grande en número, volumen o poder, hasta el punto de infundir temor.",
                        "zh": "数量、体积或力量极大，足以令人畏惧的。"
                    },
