                    "sense_definition": "Een dier met veren, vleugels en een snavel dat eieren legt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk, er zit een kleurrijke <w>vogel</w> in de boom.",
                            "target_lang_translations": {
                                "en": "Look, there is a colorful <w>bird</w> in the tree.",
                                "ru": "Смотри, на дереве сидит разноцветная <w>птица</w>.",
                                "pl": "Spójrz, na drzewie siedzi kolorowy <w>ptak</w>.",
                                "de": "Schau, da sitzt ein bunter <w>Vogel</w> im Baum.",
                                "fr": "Regarde, il y a un <w>oiseau</w> coloré dans l'arbre.",
                                "it": "Guarda, c'è un <w>uccello</w> colorato sull'albero.",
                                "cs": "Podívej, na stromě sedí barevný <w>pták</w>.",
                                "tr": "Bak, ağaçta renkli bir <w>kuş</w> var.",
                                "es": "Mira, hay un <w>pájaro</w> de colores en el árbol."
                            }
                        },
                        {
                            "text": "In de winter voeren we de kleine <w>vogel</w> in onze tuin.",
                            "target_lang_translations": {
                                "en": "In winter we feed the little <w>bird</w> in our garden.",
                                "ru": "Зимой мы кормим маленькую <w>птичку</w> в нашем саду.",
                                "pl": "Zimą dokarmiamy małego <w>ptaszka</w> w naszym ogrodzie.",
                                "de": "Im Winter füttern wir den kleinen <w>Vogel</w> in unserem Garten.",
                                "fr": "En hiver, nous nourrissons le petit <w>oiseau</w> dans notre jardin.",
                                "it": "In inverno diamo da mangiare al piccolo <w>uccello</w> nel nostro giardino.",
                                "cs": "V zimě krmíme na naší zahradě malé <w>ptáčky</w>.",
                                "tr": "Kışın bahçemizdeki küçük <w>kuşu</w> besleriz.",
                                "es": "En invierno alimentamos al pequeño <w>pájaro</w> en nuestro jardín."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vroege vogel",
                        "vrije vogel",
