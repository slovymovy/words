                ],
                "senses": [
                    {
                        "sense_id": "50674ba1-6bd1-3420-b31f-e1bbaeb32eb3",
                        "entry_id": "7a7b936a-70a8-3b4e-8d94-6c94af30d353",
                        "glosses": [
                            "Se comparer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74661b93-91af-43bc-9d43-72fb88d91537",
                                "sense_id": "50674ba1-6bd1-3420-b31f-e1bbaeb32eb3",
                                "text": "S'autoévaluer et s'autocomparer est le meilleur moyen pour anticiper une bonne gestion des ressources humaines de l'entreprise."
                            },
                            {
                                "example_id": "af35a71f-230a-40bd-8b17-eb4feca1fb7c",
                                "sense_id": "50674ba1-6bd1-3420-b31f-e1bbaeb32eb3",
                                "text": "L'auteur qui n'hésite pas d'ailleurs à s'autocomparer à Koltès ou Beckett, propose donc ici une réflexion sur la communication humaine."
                            },
                            {
                                "example_id": "f3a32f9f-32c5-4b44-b995-80badb807dac",
                                "sense_id": "50674ba1-6bd1-3420-b31f-e1bbaeb32eb3",
                                "text": "Ici, il s'autocompare à Koons."
                            }
                        ]
                    }
