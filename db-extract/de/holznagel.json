                "senses": [
                    {
                        "sense_id": "dfa330bc-6b93-3d40-a0db-9df4149255fd",
                        "entry_id": "b84d65c4-d69e-39e9-a73c-d0660c6eea0e",
                        "glosses": [
                            "Nagel, hergestellt aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91697d59-d3fc-4249-9b29-552c8c2c9d64",
                                "sense_id": "dfa330bc-6b93-3d40-a0db-9df4149255fd",
                                "text": "Im Baumarkt gibt es Holznägel auch im 100er-Pack."
                            },
                            {
                                "example_id": "f70b35d6-6061-414e-838a-c04d3246affa",
                                "sense_id": "dfa330bc-6b93-3d40-a0db-9df4149255fd",
                                "text": "„Wirklich, es war Fräulein Rosa, mitten in der Arbeit vor einer Staffelei, die sie sich aus drei Bohnenstangen mit eingeschlagenen Holznägeln zurechtgezimmert hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f978e2f6-c95e-40f8-80f4-d3ceee42098a",
                        "source_entry_id": "b84d65c4-d69e-39e9-a73c-d0660c6eea0e",
                        "source_sense_id": "dfa330bc-6b93-3d40-a0db-9df4149255fd",
                        "source_sense_description": "Nagel, hergestellt aus Holz",
                        "target_lang_word": "treenail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treenail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fa01d78-cff6-37c0-8a8e-037a72444752",
                                        "entry_id": "3689068c-6845-3506-a0e1-a0770c7035ab",
                                        "glosses": [
                                            "A wooden peg or pin used as a fastener."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334b616a-a4aa-4368-928d-b5ac6e6906b3",
                                                "sense_id": "3fa01d78-cff6-37c0-8a8e-037a72444752",
                                                "text": "Long treenails were quite difficult to drive, often being damaged in the process, with ends becoming \"broomed\", or worse, split, necessitating the head being trimmed, or far worse, the removal of the treenail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ef6b6a9-f774-4a76-8938-3cb36a6e2bf5",
                        "source_entry_id": "b84d65c4-d69e-39e9-a73c-d0660c6eea0e",
                        "source_sense_id": "dfa330bc-6b93-3d40-a0db-9df4149255fd",
                        "source_sense_description": "Nagel, hergestellt aus Holz",
                        "target_lang_word": "gournable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gournable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee962fdb-adcd-34b8-b26b-a1310a070518",
                                        "entry_id": "d84fc67c-9831-306c-91ce-58abe549933b",
                                        "glosses": [
                                            "Longue cheville de bois de chêne employée à fixer le bordage sur les membrures d’un vaisseau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c623a89-6bdb-4932-a508-0efd260e9364",
                                                "sense_id": "ee962fdb-adcd-34b8-b26b-a1310a070518",
                                                "text": "Il avait patiemment remplacé tous les clous du bordage de la panse par des gournables, ce qui rendait les trous de rouille impossibles."
                                            },
                                            {
                                                "example_id": "ae598b30-04ce-4757-91ba-9528184a554b",
                                                "sense_id": "ee962fdb-adcd-34b8-b26b-a1310a070518",
                                                "text": "Les tenailles, les pinces et le marteau firent ensuite leur office afin de détacher le bordage que les clous et les gournables retenaient à la bordure."
                                            }
                                        ]
                                    }
                                ]
                            },
