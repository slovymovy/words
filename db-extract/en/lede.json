                        "source_entry_id": "c39eec68-45eb-396b-909b-92ec736246ac",
                        "source_sense_id": "dd994b8c-7d53-30cc-8a1f-98a068d2da0b",
                        "source_sense_description": "introductory paragraph or paragraphs of a newspaper or other news article",
                        "target_lang_word": "chapeau",
                        "target_lang_code": "fr",
