                "senses": [
                    {
                        "sense_id": "7bd0c2c8-845d-39b1-a982-ff62f5782248",
                        "entry_id": "d2d3d7b3-0f6e-3d6d-ac30-e5a513128fc2",
                        "glosses": [
                            "Tor, durch das man ein Anwesen/ein Gebäude/eine Anlage betreten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144c7f30-b5dd-4c38-bcf4-7db1cf98ab4b",
                                "sense_id": "7bd0c2c8-845d-39b1-a982-ff62f5782248",
                                "text": "„Am Eingangstor erschien die Gestalt Mr. Morgans.“"
                            },
                            {
                                "example_id": "a9ce993a-870e-4f95-b0cf-ce30b289a278",
                                "sense_id": "7bd0c2c8-845d-39b1-a982-ff62f5782248",
                                "text": "„Immer wieder war im Fernsehen das Eingangstor zum Vernichtungslager zu sehen.“"
                            },
                            {
                                "example_id": "1c5311b8-a525-481d-a2fe-8562561c325e",
                                "sense_id": "7bd0c2c8-845d-39b1-a982-ff62f5782248",
                                "text": "„Der Trupp, mit dem Martin und Henry ritten, näherte sich dem Kreml und fand das Eingangstor verbarrikadiert.“"
                            },
                            {
                                "example_id": "32c1305d-f934-4f63-a887-4a4487be78e9",
                                "sense_id": "7bd0c2c8-845d-39b1-a982-ff62f5782248",
                                "text": "„Es war schon ein besonderer Moment, als wir durch das Eingangstor der Burg fuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
