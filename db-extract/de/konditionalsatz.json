                    {
                        "translation_id": "c863d80a-75fd-4e4c-a9c8-db1c0f22d809",
                        "source_entry_id": "781da352-aea7-3870-b1d5-30a6a8086caa",
                        "source_sense_id": "6a412191-7bb4-39cc-b5ff-46a63951be25",
                        "target_lang_word": "oración subordinada",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oración subordinada",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6b3594ed-d2f3-3360-a911-cf593297a646",
                                        "entry_id": "a63c13a3-7ab9-3db2-b183-2da2ce32cdb2",
                                        "glosses": [
                                            "Parte de una oración compuesta que depende estructuralmente de la principal y funciona dentro de ella como un adjetivo, un adverbio o un sustantivo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5303b329-3fe7-43c8-aa1a-9b0c8ea1c9d0",
                                                "sense_id": "6b3594ed-d2f3-3360-a911-cf593297a646",
                                                "text": "En la oración \"quiero que salgas\", el verbo \"querer\" es el núcleo de la principal, y \"que salgas\" es una oración subordinada sustantiva."
                                            },
                                            {
                                                "example_id": "5ff25eb1-480c-4bba-a35c-7df8e6386dd6",
                                                "sense_id": "6b3594ed-d2f3-3360-a911-cf593297a646",
                                                "text": "En la oración \"te encontraré donde estés\", el verbo \"encontrar\" es el núcleo de la principal, y \"donde estés\" es una subordinada adverbial."
                                            },
                                            {
                                                "example_id": "5f0436a9-af56-432b-a0b1-c2c6c950ce1f",
                                                "sense_id": "6b3594ed-d2f3-3360-a911-cf593297a646",
                                                "text": "En la oración \"necesita una casa que tenga electricidad\", el verbo \"necesitar\" es el núcleo de la principal, y \"tener\" es el núcleo de la subordinada adjetiva."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
