                                "sense_id": "c5953fbe-21f6-37a6-b1ac-865d2b3ec481",
                                "text": "Check thy self, thou Air-monger; that with a madding thought, thus chasest fleeting shadows."
                            },
                            {
                                "example_id": "4681bdee-3042-4f3f-a24f-dc8c34580e46",
                                "sense_id": "c5953fbe-21f6-37a6-b1ac-865d2b3ec481",
                                "text": "Far from the madding crowd's ignoble strife."
                            }
                        ]
