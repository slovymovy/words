                        "glosses": [
                            "feinster, kaum bemerkbarer Unterschied innerhalb eines Farbkontinuums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0a74ba-97d7-4ff5-b218-07e625303769",
                                "sense_id": "329a103a-b648-3440-bcdd-c906496dfa50",
                                "text": "„Die Sonne ist hinabgestiegen und wie zum Hohn zerreißt es den Himmel in die zartesten Farbnuancen, die man sich nur denken kann.“"
                            },
                            {
                                "example_id": "e9090768-511c-4ef4-a645-e97f7f76392f",
                                "sense_id": "329a103a-b648-3440-bcdd-c906496dfa50",
                                "text": "„Jede Unachtsamkeit, jeder falsch gesetzte Strich, jede Farbnuance zeigte sich in aller Deutlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
