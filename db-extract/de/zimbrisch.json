                "senses": [
                    {
                        "sense_id": "8e7ea884-24f1-37a7-9120-35ed1d2b9c49",
                        "entry_id": "565a750c-e046-30b6-a79b-ccb471a4f025",
                        "glosses": [
                            "in drei Sprachinseln in den Lessiner Alpen nördlich von Verona gesprochene altbairische Mundart, die durch fehlende standardsprachliche Überdachung eine rudimentäre eigene Schriftlichkeit entwickelt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f777867a-c5e8-4c84-ab62-9a8fdaef82f9",
                                "sense_id": "8e7ea884-24f1-37a7-9120-35ed1d2b9c49",
                                "text": "„Umgekehrt kann das Zimbrische auch in Lusern selbst manchmal nur eingeschränkt verwendet werden, sobald ein Italienischsprechender am Gespräch beteiligt ist. Dennoch ist das Zimbrische von Lusern im Ort selbst das allgemein gültige Kommunikationsmittel und als solches noch voll funktionsfähig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b40d0c79-7b86-4b99-a20b-7b1015592900",
                        "source_entry_id": "565a750c-e046-30b6-a79b-ccb471a4f025",
                        "source_sense_id": "8e7ea884-24f1-37a7-9120-35ed1d2b9c49",
                        "source_sense_description": "in den Lessiner Alpen nördlich von Verona gesprochene altbairische Mundart",
                        "target_lang_word": "Cimbrian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cimbrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bd21688-6521-3d1a-b7d6-d08067e6b258",
                                        "entry_id": "283ee4b2-fcb5-3bf6-8079-be2c63c3fe7b",
                                        "glosses": [
                                            "A member of a Germanic people who live in parts of northeast Italy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                        "entry_id": "283ee4b2-fcb5-3bf6-8079-be2c63c3fe7b",
                                        "glosses": [
                                            "A member of the Cimbri, especially when they are considered to have been a Germanic people and to originate from Jutland (the \\\"Cimbrian peninsula\\\")."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e45903-e5ed-4619-bf0d-4da45e93072c",
                                                "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                                "text": "The Teutones settled in Germany and Gaul; the Cimbrians invaded Italy, where they were defeated by Marius."
                                            },
                                            {
                                                "example_id": "4217f338-a10e-4aad-9c94-65804d3343c2",
                                                "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                                "text": "[W]e find mention of the Cimbrians in the Danish or Cimbrian peninsula[. ...] The Cimbrians and Teutons are described as tall and slightly built men [...]"
                                            },
                                            {
                                                "example_id": "e2f22325-2b28-4540-9d65-38bfbd52a3c5",
                                                "sense_id": "ffd2b5e9-7f24-3ba6-96f6-edc76df5b20e",
                                                "text": "I, however, putting these things aside or leaving them out for a short while, have found it better to begin with the migration of the Cimbrians from their home in their peninsula [Jutland]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cimbrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "911d4661-b917-326d-8255-deccb169b373",
                                        "entry_id": "8560e565-4bba-3147-b86c-75adfb9cdd39",
                                        "glosses": [
                                            "The Bavarian Germanic language of these people, which is a variety of German."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee255a92-63f8-4311-80fd-3f528cec8a33",
                        "source_entry_id": "565a750c-e046-30b6-a79b-ccb471a4f025",
                        "source_sense_id": "8e7ea884-24f1-37a7-9120-35ed1d2b9c49",
                        "source_sense_description": "in den Lessiner Alpen nördlich von Verona gesprochene altbairische Mundart",
                        "target_lang_word": "cimbre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cimbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6053dc6-132a-36b0-a1f5-8dd4f33c1ea6",
                                        "entry_id": "f9aabefb-8a1c-37ab-a2ba-128e0e582591",
                                        "glosses": [
                                            "Dialecte bavarois parlé par les Cimbres, des populations alpines vivant dispersées dans le nord-ouest de l’Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c007a50e-bc91-4c96-bb6a-1d0e6d0c7f11",
                                                "sense_id": "d6053dc6-132a-36b0-a1f5-8dd4f33c1ea6",
                                                "text": "C’est ainsi que chaque recoin avait un nom dans l’ancienne langue cimbre et il m’est arrivé, dans les tavernes où se retrouvaient en fin de journée les gardiens de chevaux, de les entendre débiter, comme une litanie, les endroits par où ils étaient passés : Kapfrust, Taltebene, Billaraut, Kessalprenno, Dreitröfle (ce dernier signifie « trois gouttes » et indique une source à laquelle je me suis souvent désaltéré)."
                                            },
                                            {
                                                "example_id": "f48950df-3335-464f-8bd5-716305c11eea",
                                                "sense_id": "d6053dc6-132a-36b0-a1f5-8dd4f33c1ea6",
                                                "text": "Sur certaines de ces cartes les légendes sont rédigées en cimbre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
