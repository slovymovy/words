                ],
                "senses": [
                    {
                        "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                        "entry_id": "5b0a4a83-989e-37f8-9ed3-2ed8d4c60dfc",
                        "glosses": [
                            "Eigenschaft eines Vorgangs, der sich schlagartig/unvermittelt ereignet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad0de78-2b4b-4c12-b0c2-ac0ca8d81612",
                                "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                "text": "„Die Sterne erschienen mit jäher Plötzlichkeit wie hergezaubert.“"
                            },
                            {
                                "example_id": "135ba0d2-d995-4697-b11f-fb7394161c76",
                                "sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                                "text": "„Der Zusammenbruch von Autorität und Macht, der in der Regel nicht nur die Zeitungsleser in seiner Plötzlichkeit überrascht, sondern auch alle Geheimdienste und ihre Experten, die solche Dinge beobachten, wird nur dann zu einer Revolution im vollen Wortsinne, wenn Menschen bereit und in der Lage sind, die Macht aufzugreifen, in das Machtvakuum vorzustoßen und sozusagen einzudringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bf1fe2b-680d-40a5-ba03-736f59e17227",
                        "source_entry_id": "5b0a4a83-989e-37f8-9ed3-2ed8d4c60dfc",
                        "source_sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                        "source_sense_description": "Eigenschaft eines Vorgangs, der sich schlagartig/unvermittelt ereignet",
                        "target_lang_word": "suddenness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suddenness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                        "entry_id": "bf7ef253-5fb8-3c78-b3d3-5555db6e8f97",
                                        "glosses": [
                                            "The state of being sudden."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a412c19-8e0c-4ff2-ab4a-c6823978635c",
                                                "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                                "text": "The suddenness with which the solemn quiet had been broken in upon, had chaced from his remembrance the horrid phantom;—it now recurred to it, with two-fold force, and a shudder crept all over him."
                                            },
                                            {
                                                "example_id": "7ba5f6da-d14f-402d-82ae-e6c213e208d3",
                                                "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                                "text": "The suddenness of this shock must prove irresistable; the Count and those about him will be borne down; the rest will take to flight; the friends of Bernabò will rise and liberate his sons, while I seize one of the gates and secure a retreat […]"
                                            },
                                            {
                                                "example_id": "6254ec1b-b3ac-415e-b67d-56c5754623cf",
                                                "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                                "text": "\"Well,\" said the Duc, with that outward calmness of manner which anger often affects; \"so you do not like me? I am sorry for your bad taste! and I bid you good night, quite convinced that you will repent your refusal; and I dare say you will never get married at all.\" So saying, he left the terrace; while Francesca remained for a few minutes, bewildered by the suddenness of the scene, and half inclined to laugh at the Duc's parting denunciation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "867f7eb4-3f2b-4d0f-9f29-3627300c920c",
                        "source_entry_id": "5b0a4a83-989e-37f8-9ed3-2ed8d4c60dfc",
                        "source_sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                        "source_sense_description": "Eigenschaft eines Vorgangs, der sich schlagartig/unvermittelt ereignet",
                        "target_lang_word": "promptitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promptitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75814c02-1352-3159-93da-da0cfdd25839",
                                        "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                                        "glosses": [
                                            "Rapidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a46a3e8-f91f-4e11-9c4c-a77b568e6a1d",
                                                "sense_id": "75814c02-1352-3159-93da-da0cfdd25839",
                                                "text": "Maintenant que j'ai exposé le procédé de M. Mathieu, je dois ajouter de suite que son expérience lui a appris que toutes les bruyères ne s'enracinent pas avec la même promptitude, et que, s'il y en a qui se trouvent bien enracinées après deux mois de couchage, il en est d'autres auxquelles il faut quatre, cinq ou six mois, et encore davantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aacd542-5f53-3524-83d1-09ca93f81505",
                                        "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                                        "glosses": [
                                            "Disposition qui fait qu’on ne met aucun délai à entreprendre ou à exécuter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19217ffc-cb96-4c6e-b71f-4ce506f03c63",
                                                "sense_id": "0aacd542-5f53-3524-83d1-09ca93f81505",
                                                "text": "Le chevalier en fit autant avec une justesse et une promptitude qui tenaient de la magie."
                                            },
                                            {
                                                "example_id": "eb6140fe-9bd2-4c53-8b60-0eaf711abdba",
                                                "sense_id": "0aacd542-5f53-3524-83d1-09ca93f81505",
                                                "text": "— Mais […] la promptitude avec laquelle s’agitaient, à la moindre émotion, sa lèvre et ses épaisses moustaches, annonçaient évidemment que la tempête n’était qu’assoupie et se réveillerait facilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "938d3ce8-aac1-3f23-b007-f232b04c9b99",
                                        "entry_id": "3482343a-a4c9-3fad-8fc3-ef1984b1a3ca",
                                        "glosses": [
                                            "Vivacité de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e876ba9-b4c1-4a73-a9fe-053724db2c1a",
                                                "sense_id": "938d3ce8-aac1-3f23-b007-f232b04c9b99",
                                                "text": "Il lui arrivait même de s'émerveiller de la facilité, de la promptitude avec laquelle il avait illuminé ces arcanes, hier encore ténébreux et rébarbatifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4087cd05-f040-40fc-bf42-5d6a3efcf62a",
                        "source_entry_id": "5b0a4a83-989e-37f8-9ed3-2ed8d4c60dfc",
                        "source_sense_id": "02c2a48c-bfcb-3bf3-9c0c-856373f3cf01",
                        "source_sense_description": "Eigenschaft eines Vorgangs, der sich schlagartig/unvermittelt ereignet",
                        "target_lang_word": "soudaineté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soudaineté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                        "entry_id": "7e8e6229-d747-3236-a5b5-6452fb749f49",
                                        "glosses": [
                                            "Caractère de ce qui est soudain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5a8870-6cea-4713-b6b2-0a588f78c3d4",
                                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                                "text": "Avec cette soudaineté d’action qui distingue les gens du midi, Gazonal sauta de l’hôtel dans la rue, de la rue dans un cabriolet, et alla rue de Berlin chez son cousin."
                                            },
                                            {
                                                "example_id": "b608cc99-151a-4ef0-a95f-04bcbaeaf3cf",
                                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                                "text": "Rien dans les langages humains, aucune traduction de la pensée faite à l’aide des couleurs, des marbres, des mots ou des sons, ne saurait rendre le nerf, la vérité, le fini, la soudaineté du sentiment dans l’âme !"
                                            },
                                            {
                                                "example_id": "03628717-6a72-46d7-ac82-da5896460f20",
                                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                                "text": "Bert avait serré les freins avec une telle soudaineté que la jeune fille se trouva lancée entre ses jambes au moment où il mettait pied à terre."
                                            },
                                            {
                                                "example_id": "c5bb7b85-45b1-49ef-8de9-3c09cfdc3162",
                                                "sense_id": "a17526c2-b8f6-3d1e-b5b6-595327c2f016",
                                                "text": "Il ne pouvait cependant échapper à un homme réfléchi que les cataclysmes fondent sur une nation avec la soudaineté de la tempête en mer calme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
