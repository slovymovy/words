                                                "example_id": "6fe6d674-86fa-4458-a1a6-8b4ff37f873a",
                                                "sense_id": "2777a884-1c96-34d0-8b6e-d138f2e1a96b",
                                                "text": "France's Vietnam (the Algerian War or First Indochina War)"
