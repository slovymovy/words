{
    "word_family": [
        "sharkskin",
        "sharking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "866ff1f6-8f1c-3436-a093-b0d390389d8b",
                    "sense_definition": "A large predatory fish with a cartilaginous skeleton, prominent dorsal fin, and sharp teeth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The great white <w>shark</w> is one of the most feared predators in the ocean.",
                            "target_lang_translations": {
                                "ru": "Большая белая <w>акула</w> — один из самых опасных хищников в океане.",
                                "zh": "大白<w>鲨</w>是海洋中最令人恐惧的掠食者之一。"
                            }
                        },
                        {
                            "text": "We saw a small <w>shark</w> swimming near the coral reef while diving.",
                            "target_lang_translations": {
                                "ru": "Во время дайвинга мы видели небольшую <w>акулу</w>, плавающую возле кораллового рифа.",
                                "zh": "潜水时，我们看到一条小<w>鲨鱼</w>在珊瑚礁附近游动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "great white shark",
                        "shark attack",
                        "shark fin",
                        "swim with sharks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная хищная рыба с хрящевым скелетом, выступающим спинным плавником и острыми зубами.",
                        "zh": "一种大型掠食性鱼类，具有软骨骨架、明显的背鳍和锋利的牙齿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акула",
                                "target_lang_sense_clarification": "рыба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鲨鱼",
                                "target_lang_sense_clarification": "鱼类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8783b7c5-f0bf-30bb-8f70-9ba5c5d2c62b",
                    "sense_definition": "The flesh of this animal, prepared and consumed as food.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant serves grilled <w>shark</w> with a side of vegetables.",
                            "target_lang_translations": {
                                "ru": "В ресторане подают жареную <w>акулятину</w> с гарниром из овощей.",
                                "zh": "这家餐厅供应烤<w>鲨鱼肉</w>，并配有蔬菜。"
                            }
                        },
                        {
                            "text": "Some environmental groups discourage eating <w>shark</w> due to overfishing concerns.",
                            "target_lang_translations": {
                                "ru": "Некоторые экологические группы не рекомендуют употреблять в пищу <w>акул</w> из-за угрозы их исчезновения.",
                                "zh": "由于过度捕捞的担忧，一些环保组织不鼓励食用<w>鲨鱼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shark steak",
                        "shark meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо этого животного, приготовленное и употребляемое в пищу.",
                        "zh": "这种动物的肉，作为食物烹饪和食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акулятина",
                                "target_lang_sense_clarification": "мясо"
                            },
                            {
                                "target_lang_word": "акула",
                                "target_lang_sense_clarification": "блюдо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鲨鱼肉",
                                "target_lang_sense_clarification": "食物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a37bf591-2384-3438-90e9-b2c207204347",
                    "sense_definition": "A dishonest person who exploits others for money, such as by lending at extremely high interest rates.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "predatory_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He borrowed money from a loan <w>shark</w> and now owes twice as much as he took.",
                            "target_lang_translations": {
                                "ru": "Он занял деньги у <w>ростовщика</w> и теперь должен в два раза больше, чем взял.",
                                "zh": "他向一名<w>高利贷者</w>借了钱，现在欠下的钱是他当初借款的两倍。"
                            }
                        },
                        {
                            "text": "Be careful in the business world, as it is full of <w>sharks</w> waiting to take advantage of you.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны в мире бизнеса, он полон <w>акул</w>, ждущих возможности воспользоваться вами.",
                                "zh": "在商业世界里要小心，那里充满了等着占你便宜的<w>奸商</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "loan shark",
                        "corporate shark"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'loan shark'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный человек, который наживается на других, например, давая деньги в долг под грабительские проценты.",
                        "zh": "指剥削他人的不诚实者，例如以极高利率放贷的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акула",
                                "target_lang_sense_clarification": "перен. хищник, делец"
                            },
                            {
                                "target_lang_word": "ростовщик",
                                "target_lang_sense_clarification": "дающий деньги под процент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高利贷者",
                                "target_lang_sense_clarification": "放贷者"
                            },
                            {
                                "target_lang_word": "奸商",
                                "target_lang_sense_clarification": "商业领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eb52609-e1f2-3b90-830a-196ad89fcdc0",
                    "sense_definition": "A person who is highly skilled at a game, such as pool or cards, often concealing their ability to win money from others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "skilled_player",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't play cards with him for money; he is a known <w>shark</w>.",
                            "target_lang_translations": {
                                "ru": "Не играй с ним в карты на деньги, он известный <w>шулер</w>.",
                                "zh": "别跟他赌钱玩牌，他是个出了名的<w>老千</w>。"
                            }
                        },
                        {
                            "text": "The pool <w>shark</w> pretended to be a beginner before winning the entire tournament.",
                            "target_lang_translations": {
                                "ru": "Бильярдный <w>шулер</w> притворился новичком, прежде чем выиграть весь турнир.",
                                "zh": "这位台球<w>高手</w>在赢得整个锦标赛之前一直假装是新手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hustler"
                    ],
                    "common_phrases": [
                        "pool shark",
                        "card shark"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрок, обладающий высоким мастерством (например, в бильярде или картах), часто скрывающий свои умения ради выигрыша.",
                        "zh": "在台球或纸牌等游戏中技术高超，常隐藏实力以赢取他人钱财的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шулер",
                                "target_lang_sense_clarification": "обманщик в игре"
                            },
                            {
                                "target_lang_word": "катала",
                                "target_lang_sense_clarification": "слэнг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老千",
                                "target_lang_sense_clarification": "赌博或游戏中的骗子"
                            },
                            {
                                "target_lang_word": "高手",
                                "target_lang_sense_clarification": "指深藏不露的玩家"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43bb6f67-6644-35eb-9356-848e6737d90a",
                    "sense_definition": "To hunt or fish for sharks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fishing_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew went <w>sharking</w> off the coast of Florida last summer.",
                            "target_lang_translations": {
                                "ru": "Прошлым летом экипаж отправился <w>ловить акул</w> у побережья Флориды.",
                                "zh": "去年夏天，船员们去佛罗里达海岸<w>捕鲨</w>。"
                            }
                        },
                        {
                            "text": "He spends his weekends <w>sharking</w> in deep waters.",
                            "target_lang_translations": {
                                "ru": "Он проводит выходные, <w>охотясь на акул</w> в глубоких водах.",
                                "zh": "他周末都在深海里<w>捕鲨</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Охотиться или ловить акул.",
                        "zh": "捕猎或钓鲨鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить акул",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "охотиться на акул",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捕鲨",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60008c2b-e8f2-3036-a70f-67b4326007e5",
                    "sense_definition": "To practice fraud, trickery, or theft to obtain something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>shark</w> a free meal from the unsuspecting vendor.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>выманить</w> бесплатную еду у ничего не подозревающего торговца.",
                                "zh": "他试图从毫无戒心的摊贩那里<w>诈取</w>一顿免费餐。"
                            }
                        },
                        {
                            "text": "They <w>sharked</w> their way into the exclusive event without tickets.",
                            "target_lang_translations": {
                                "ru": "Они <w>пробрались обманом</w> на закрытое мероприятие без билетов.",
                                "zh": "他们通过<w>行骗</w>混进了没有门票的独家活动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься мошенничеством, обманом или воровством для получения чего-либо.",
                        "zh": "通过欺诈、诡计或偷窃来获取某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выманивать",
                                "target_lang_sense_clarification": "получать обманом"
                            },
                            {
                                "target_lang_word": "жульничать",
                                "target_lang_sense_clarification": "обманывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诈取",
                                "target_lang_sense_clarification": "通过欺骗获取"
                            },
                            {
                                "target_lang_word": "行骗",
                                "target_lang_sense_clarification": "行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}