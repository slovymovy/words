                        "cross_references": [
                            {
                                "target_word": "физиогра́фия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "47fe92ab-1e71-3231-b1e8-042974fc36c5",
                                        "entry_id": "7189f8e5-6fcd-398a-90c8-bb41b306e149",
                                        "glosses": [
                                            "то же, что физическая география"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be5ebd21-6d45-4b5e-be32-9a301b87027e",
                                                "sense_id": "47fe92ab-1e71-3231-b1e8-042974fc36c5",
                                                "text": "В компьютерные атласы по сравнению с полиграфическими изданиями может быть включено несравненно большее количество разнообразного материала по физиографии пород, причем исключительно в виде цветных изображений; кроме того, они могут сопровождаться информационно-поисковой системой, позволяющей группировать и распознавать необходимые объекты по широкому кругу признаков."
                                            },
                                            {
                                                "example_id": "55cceab3-2eeb-40c1-b429-35f78fc34223",
                                                "sense_id": "47fe92ab-1e71-3231-b1e8-042974fc36c5",
                                                "text": "Преподавали нам и более легкий, весьма увлекательный предмет под названием физиография: учащийся получал представление сразу о ряде наук; геология освещалась как процесс эволюции от Язона до дома Истри, астрономия — как летопись движения небесных светил, неизменных в своем суровом величии и великолепии."
                                            },
                                            {
                                                "example_id": "4fe9de1f-6a80-4710-b6ff-5927864cd617",
                                                "sense_id": "47fe92ab-1e71-3231-b1e8-042974fc36c5",
                                                "text": "Что касаются растительности, то в США она больше зависит от климата, чем от физиографии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
