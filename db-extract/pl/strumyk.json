                "translations": [
                    {
                        "translation_id": "51290c16-631e-41ac-a283-d809034ec1f2",
                        "source_entry_id": "159644df-9d2e-3ab8-88c9-69e6449855eb",
                        "source_sense_id": "e7d6e40a-0647-351f-b5ad-a3a286bb1ff1",
                        "target_lang_word": "creek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c13bea19-090d-38a3-b6dd-7f1c1d76ebca",
                                        "entry_id": "3500278f-1abe-36de-b196-d507a2f58fae",
                                        "glosses": [
                                            "A small inlet, often saltwater, leading to the sea or to the main channel of a river, especially a river estuary."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae93401-2420-403b-9a49-4e9a86455374",
                                                "sense_id": "c13bea19-090d-38a3-b6dd-7f1c1d76ebca",
                                                "text": "Seven miles to the north of Venice, the banks of sand, which near the city rise little above low-water mark, attain by degrees a higher level, and knit themselves at last into fields of salt morass, raised here and there into shapeless mounds, and intercepted by narrow creeks of sea."
                                            },
                                            {
                                                "example_id": "31980287-2c3f-4890-84b5-62bd1900cedb",
                                                "sense_id": "c13bea19-090d-38a3-b6dd-7f1c1d76ebca",
                                                "text": "There is a tide in the affairs of men, / Which, taken any way you please, is bad, / And strands them in forsaken guts and creeks / No decent soul would think of visiting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90b68bd0-c6df-3cad-9f30-fb36683467be",
                                        "entry_id": "3500278f-1abe-36de-b196-d507a2f58fae",
                                        "glosses": [
                                            "The inner part of a port that is used as a dock for small boats."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e972bdc2-9350-34fe-aee9-935845a939d2",
                                        "entry_id": "3500278f-1abe-36de-b196-d507a2f58fae",
                                        "glosses": [
                                            "A stream of water, typically a stream of freshwater smaller than a river; in Australia, also used of river-sized bodies of water."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73a60515-f828-4b69-9610-03694de333f1",
                                                "sense_id": "e972bdc2-9350-34fe-aee9-935845a939d2",
                                                "text": "We all feel it Looming, even when we're awake, out there ahead someplace, the way you come to feel a River or Creek ahead, before anything else,— sound, sky, vegetation,— may have announced it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e232fbaf-acd6-3f30-a9c9-93bb9e136bbb",
                                        "entry_id": "3500278f-1abe-36de-b196-d507a2f58fae",
                                        "glosses": [
                                            "Any turn or winding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cef5f768-f899-488a-85a8-9664cb6a71b9",
                        "source_entry_id": "159644df-9d2e-3ab8-88c9-69e6449855eb",
                        "source_sense_id": "e7d6e40a-0647-351f-b5ad-a3a286bb1ff1",
                        "target_lang_word": "streamlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "streamlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                        "entry_id": "8d3b0113-20ef-3087-a315-02ea829466cc",
                                        "glosses": [
                                            "A small stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e22d4035-76b2-4a01-9514-ead16e1f3446",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "Then the river Medway, branching it selfe into five streamlets, is joyned with as many stone Bridges […]"
                                            },
                                            {
                                                "example_id": "b6b7ba32-96d8-466c-8fc4-7f2b00e819e5",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "[A] ſtreamlet inviting repoſe / Soft-murmuring vvanders avvay, […]"
                                            },
                                            {
                                                "example_id": "bb80ed02-f049-4a1b-b687-68a23a9f40dd",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "[…] the eye, after poring over the unbounded expanse of the ocean, is releaved and delighted by a streamlet and a dell."
                                            },
                                            {
                                                "example_id": "a12fabb7-9f72-46da-8122-5661046f12a2",
                                                "sense_id": "5ce88274-21e1-32cb-a1b1-33f8350a9e3f",
                                                "text": "I wanted to jog in leisurely fashion through the green fields and chestnut avenues, over the rushing bubbling streamlets, to join Sylvie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
