                                        "glosses": [
                                            "een land in Zuid-Amerika, grenzend aan Peru, Bolivia en Argentinië en ingeklemd liggend tussen de Stille Zuidzee en het Andesgebergte"
                                        ],
                                        "tags": [],
                                        "examples": [
