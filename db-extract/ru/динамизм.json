                        "source_sense_id": "6e0db219-7e7d-346c-a763-b5e882bc906a",
                        "target_lang_word": "dynamism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40739c18-348d-36a2-8343-9e93a248c761",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Great energy, drive, force, or power; vigour of body, mind or personality; oomph or pizzazz"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Dynamic reality; active energy; continuous change, progress, or activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1580c5a-ee6c-4c7d-8466-5e570fff21dc",
                                                "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                                "text": "The fact that the war is no longer the main issue in the election points to the dynamism of foreign affairs."
                                            },
                                            {
                                                "example_id": "a0c05c7c-65fa-4f21-9d9d-b763c9f59c67",
                                                "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                                "text": "But, one might ask, how can the temporal event of God in our midst be the same as God's event to himself in his eternity if so absolute a distinction is drawn between the enarrable contents of history and the \"eternal dynamism\" of God's immutability, apatheia, and perfect fullness?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcbc57bf-a219-3072-a714-f2c97348f528",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Any of several philosophical theories that attempt to explain the universe by an immanent force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
