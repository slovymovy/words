                        "form": "деви́чниках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69af45cb-ab88-3a91-9a4a-e5d6410b0f22",
                        "entry_id": "d8aeb1b6-3b42-329e-bd0d-7b6ffd0cc1ed",
                        "glosses": [
                            "прощальная вечеринка с подругами в доме невесты накануне свадьбы"
                        ],
                        "tags": [
                            "в русском свадебном обряде:"
                        ],
                        "examples": [
                            {
                                "example_id": "d3b9d10b-b608-40cf-92c0-efb89b06cb9c",
                                "sense_id": "69af45cb-ab88-3a91-9a4a-e5d6410b0f22",
                                "text": "Девичник мог иметь разную продолжительность: у богатых — до двух недель, у невест победнее — до недели."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e536eca-66ff-34a9-81e8-4c6fef86f5b7",
                        "entry_id": "d8aeb1b6-3b42-329e-bd0d-7b6ffd0cc1ed",
                        "glosses": [
                            "разг. вечеринка, на которую собираются девушки, женщины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4afaf85d-6cb2-451e-8d99-436904f1f0d3",
                                "sense_id": "6e536eca-66ff-34a9-81e8-4c6fef86f5b7",
                                "text": "Криворотов отправился к матери: повидаться на всякий случай, но та, как явствовало из записки, прижатой солонкой к кухонному столу, ушла на «девичник» — ежегодную встречу школьных подруг-одноклассниц."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd952256-0d71-40a8-9f46-62ac02adf5ed",
                        "source_entry_id": "d8aeb1b6-3b42-329e-bd0d-7b6ffd0cc1ed",
                        "source_sense_description": "прощальная вечеринка с подругами в доме невесты накануне свадьбы",
                        "target_lang_word": "hen night",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hen night",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59926daa-5b1d-311c-9f3b-77e7ca522ce5",
                                        "entry_id": "351d11e6-861a-3f8d-b295-c665249f1c6b",
                                        "glosses": [
                                            "A party held for a woman who is about to be married, normally attended only by female friends and relatives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3183568-adf3-4f66-a6a6-38afa7ba885e",
                                                "sense_id": "59926daa-5b1d-311c-9f3b-77e7ca522ce5",
                                                "text": "2001, Karen S Smith, Up To No Good, 2004, Black Lace, London, unnumbered page,\nThis was what a hen night should be: just a group of good friends getting together to enjoy unpretentious fun away from other people’s eyes."
                                            },
                                            {
                                                "example_id": "ba6bbb0f-cd65-479a-8e39-e111cc3d173a",
                                                "sense_id": "59926daa-5b1d-311c-9f3b-77e7ca522ce5",
                                                "text": "2006, Yasmin Mills, How to Party, RoofTop Publishing, Indiana, page 47,\nPlan an unforgettable hen night to show your girlfriends how much you appreciate them."
                                            },
                                            {
                                                "example_id": "92922bfa-963d-4b0a-90c8-8d089c02392d",
                                                "sense_id": "59926daa-5b1d-311c-9f3b-77e7ca522ce5",
                                                "text": "2007, Nicola Chalk, Because of You, Vanguard Press, UK, page 114,\n“Why he is out on a hen night?” Denise asked as soon as we all arrived and met up at the Hotel. “He looks like a man to me.”"
                                            },
                                            {
                                                "example_id": "cf1be652-00c9-4f83-8a6b-d88501ada97b",
                                                "sense_id": "59926daa-5b1d-311c-9f3b-77e7ca522ce5",
                                                "text": "The hen night is for Rachel, the thinnest and most mean-spirited of his wife’s friends, and a hotel suite has been hired for the sleepover, complete with a handsome cocktail waiter to use as they see fit."
                                            },
                                            {
                                                "example_id": "aeb993bd-fed2-42d1-982b-01acba9e5377",
