                ],
                "senses": [
                    {
                        "sense_id": "f1298e15-e92d-3326-b7d8-2b54f16e731f",
                        "entry_id": "cfc3f192-1a16-3e8f-96d8-8451b0066b75",
                        "glosses": [
                            "экон. раздел экономики, занимающийся проблемами производства и сбыта продукции"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5d866a35-a46b-36db-91e8-92bf94f5e604",
                        "entry_id": "cfc3f192-1a16-3e8f-96d8-8451b0066b75",
                        "glosses": [
                            "экон. комплексный подход к управлению производством и организации хозяйственной деятельности, основанный на учёте требований рынка и активном воздействии на расширение сбыта продукции и реализации услуг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43dc7d83-9e90-4749-bb9f-df548a46992b",
                                "sense_id": "5d866a35-a46b-36db-91e8-92bf94f5e604",
                                "text": "Поэтому дропшиппинг трансформирует саму сбытовую деятельность, превращая ее из внутренней (эндогенной) функции маркетинга во внешнюю (экзогенную) функцию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd1a80c7-bf37-4d3c-8d36-0bb6085c2bc4",
                        "source_entry_id": "cfc3f192-1a16-3e8f-96d8-8451b0066b75",
                        "target_lang_word": "marketing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marketing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "270abc93-9f47-3160-b82a-992d19ca7555",
                                        "entry_id": "ecaa2243-0af5-3383-81e9-ae0c619b7fb4",
                                        "glosses": [
                                            "present participle and gerund of market"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
