                "senses": [
                    {
                        "sense_id": "1c030e0d-0d9e-322b-aa8e-455532a44c96",
                        "entry_id": "93b93051-a415-334c-8a05-0bfd065dcc6f",
                        "glosses": [
                            "Kleidungsstück mit kurzen Ärmeln für den Oberkörper, das aus Baumwollfasern gefertigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecdfcd6f-1a41-41c8-9497-ca2ddf4b3959",
                                "sense_id": "1c030e0d-0d9e-322b-aa8e-455532a44c96",
                                "text": "„Das gängigste Kleidungsstück im Repertoire der fairen Mode ist das Baumwoll-T-Shirt – und zwar ein schlichtes, ohne Aufdruck.“"
                            },
                            {
                                "example_id": "47eb0740-07fe-4ed2-a095-97fd8bc2c817",
                                "sense_id": "1c030e0d-0d9e-322b-aa8e-455532a44c96",
                                "text": "„Ein schwarzes Baumwoll-T-Shirt gewährt einen doppelt so hohen UV-Schutz (LSF 50) wie ein weißes T-Shirt, eine dunkelblaue Jeanshose besitzt einen Lichtschutzfaktor von 1700.“"
                            },
                            {
                                "example_id": "f7889c79-fcd6-4fa6-b48c-3bc22d8d4950",
                                "sense_id": "1c030e0d-0d9e-322b-aa8e-455532a44c96",
                                "text": "„Bei Untersuchungen des Bayreuther Instituts für ökologische Chemie fanden sich in Baumwoll-T-Shirts zum Teil erhebliche Mengen an Dioxinen, die sich beim Tragen von den Fasern ablösen und auf die Haut übergehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
