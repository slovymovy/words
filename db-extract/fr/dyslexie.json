            {
                "entry_id": "f9f2f8f1-5d51-318b-9d7e-5cfc0979676e",
                "word": "dyslexie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e1d6a1b-8033-4de4-add3-01e0fac5b601",
                        "entry_id": "f9f2f8f1-5d51-318b-9d7e-5cfc0979676e",
                        "tags": [
                            "plural"
                        ],
                        "form": "dyslexies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eec980a1-f0d8-3e41-a9ce-cdd88b329c13",
                        "entry_id": "f9f2f8f1-5d51-318b-9d7e-5cfc0979676e",
                        "glosses": [
                            "Trouble de l’apprentissage de la lecture, en dehors de toute déficience intellectuelle et sensorielle et de toute maladie mentale, qui se traduit par des inversions et des confusions de lettres, de syllabes et de mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d29097ec-f4e3-4171-a5b9-a0929e1d72d7",
                                "sense_id": "eec980a1-f0d8-3e41-a9ce-cdd88b329c13",
                                "text": "La dyslexie marquée par des confusions phonétiques est souvent décelée quand l’enfant présente déjà une dysorthographie."
                            },
                            {
                                "example_id": "40844d63-f581-431b-b1c8-b68c661a7ed9",
                                "sense_id": "eec980a1-f0d8-3e41-a9ce-cdd88b329c13",
                                "text": "J'avais pourtant cru voir le mot « ÉCOLE » sur la devanture de l'établissement juste après « auto ». Au temps pour moi, ma dyslexie passagère a encore frappé... Enfin... bizarrement, je crois ne pas être la seule à avoir souffert de ce syndrome..."
                            },
                            {
                                "example_id": "593c455c-d416-4ad1-ac93-b91a31528077",
                                "sense_id": "eec980a1-f0d8-3e41-a9ce-cdd88b329c13",
                                "text": "Extradys organise une journée sur les difficultés d’enfants, d’adolescents souffrant de Troubles spécifiques du langage et des Apprentissages (TSLA) appelés communément « Troubles DYS » (dyslexie, dysorthographie, dysgraphie, dyscalculie, dyspraxie, dysphasie), dimanche 18 juin à la salle en dessous du dojo à Malemort de 9h30 à 13h."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "657e2bc4-a168-47b2-83ba-b2d660b2464b",
                        "source_entry_id": "f9f2f8f1-5d51-318b-9d7e-5cfc0979676e",
                        "source_sense_id": "eec980a1-f0d8-3e41-a9ce-cdd88b329c13",
                        "target_lang_word": "Dyslexie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dyslexie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5a0e2e-33ee-3154-8dea-e1bf3b166049",
                                        "entry_id": "1f50f94a-ff7a-3fa7-810d-f5076426c0f8",
                                        "glosses": [
                                            "Verminderung der Fähigkeit, Geschriebenes lesend zu erfassen und verstehen"
                                        ],
                                        "tags": [
                                            "Sprachstörung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16357fd0-2064-4943-b8dc-73aa04bf58fa",
                                                "sense_id": "6d5a0e2e-33ee-3154-8dea-e1bf3b166049",
                                                "text": "„Der Nicht-Ungar, der als Tourist Budapest besucht, findet sich in einer vertrauten europäischen Metropole wieder, doch dann muß er erschrocken feststellen, daß er an kompletter Dyslexie zu leiden scheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0279666d-594e-46cd-b541-2f19ee0f2791",
                        "source_entry_id": "f9f2f8f1-5d51-318b-9d7e-5cfc0979676e",
                        "source_sense_id": "eec980a1-f0d8-3e41-a9ce-cdd88b329c13",
                        "target_lang_word": "Legasthenie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Legasthenie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                                        "entry_id": "74474328-0f4c-3c34-8789-0fe3289358f3",
                                        "glosses": [
                                            "Entwicklungsverzögerung im Lesen oder Schreiben, massive und lang andauernde Störung des Erwerbs der Schriftsprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d894529-67cc-4c50-8b65-7b0b96acdf04",
                                                "sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                                                "text": "Dass Markus an Legasthenie leidet, wurde erst in der dritten Klasse entdeckt."
                                            },
                                            {
                                                "example_id": "889ba2e0-746f-4c8f-94b8-a99e1ce426b9",
                                                "sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                                                "text": "Legasthenie ist eine der Dyskalkulie vergleichbare Lernstörung."
                                            },
                                            {
                                                "example_id": "40521ffa-4e51-499e-a62a-9516ffe51649",
                                                "sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                                                "text": "„Die Legasthenie hat an sich eine gute Prognose, d.h., sie hat die Tendenz, sich zu bessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
