                "senses": [
                    {
                        "sense_id": "5fd1dde8-5445-3a3d-adf3-c1299a4c63fe",
                        "entry_id": "dea9b2d2-0678-3499-93b4-2d9e6f6450db",
                        "glosses": [
                            "strapazierbarer Luxussessel im Stil des Art déco"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929fd518-df6d-4189-a12b-8066079f442f",
                                "sense_id": "5fd1dde8-5445-3a3d-adf3-c1299a4c63fe",
                                "text": "Die rote Wandbespannung und die Truhe davor, die alten Klubsessel … alles ist bisher unverändert."
                            },
                            {
                                "example_id": "cd40c31a-45c8-4083-b082-f6f2a117c76c",
                                "sense_id": "5fd1dde8-5445-3a3d-adf3-c1299a4c63fe",
                                "text": "„Er hatte immer nur an Betten, einen Klubsessel aus Leder und einen eichenen Diplomaten gedacht.“"
                            },
                            {
                                "example_id": "308b35e9-7030-4c63-a098-e3bd443b5d15",
                                "sense_id": "5fd1dde8-5445-3a3d-adf3-c1299a4c63fe",
                                "text": "„Aber der Kinobesitzer, Herr Mandelstamm, war so freundlich und brachte für Mira einen der breiten Klubsessel aus der Diele herein und stellte ihn neben den Notausgang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
