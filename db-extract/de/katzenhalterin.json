                "senses": [
                    {
                        "sense_id": "64e6cb2a-1442-3949-b479-c5e55a56a118",
                        "entry_id": "ba11b7a5-82e9-3c4a-9a4a-e44760e6f02f",
                        "glosses": [
                            "weibliche Person, die eine Katze zur Haustierhaltung besitzt, die sich eine Katze hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42666959-2172-4d77-aef7-f6483d2a9863",
                                "sense_id": "64e6cb2a-1442-3949-b479-c5e55a56a118",
                                "text": "„Es sind mir noch weitere Katzen gestorben, gehört halt dazu, wenn man Katzenhalterin ist.“"
                            },
                            {
                                "example_id": "f2f7d0fc-a0f2-4643-998d-a662d47a508b",
                                "sense_id": "64e6cb2a-1442-3949-b479-c5e55a56a118",
                                "text": "„Die Autorin Brigitte Eilert-Overbeck ist seit vielen Jahre begeisterte Katzenhalterin und hat das Verhalten dieser faszinierenden Tiere intensiv studiert.“"
                            },
                            {
                                "example_id": "e77fcc19-1db8-4ded-adc9-2e1a0cd49d07",
                                "sense_id": "64e6cb2a-1442-3949-b479-c5e55a56a118",
                                "text": "„Lea nahm ihre Pflichten von Beginn an sehr ernst und bewies damit, dass sie eine verantwortungsbewusste Katzenhalterin ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
