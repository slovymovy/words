                "senses": [
                    {
                        "sense_id": "3a1201ac-9b6d-3d4e-9f44-2fc65ed71ec8",
                        "entry_id": "82b0cabb-2b05-3860-91c9-3ca0966d9bff",
                        "glosses": [
                            "vol van de wens en het vertrouwen om iets te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e9e947-93f0-4db6-998f-7cc0684c91ec",
                                "sense_id": "3a1201ac-9b6d-3d4e-9f44-2fc65ed71ec8",
                                "text": "De ambitieuze zakenman werd met tegenslagen geconfronteerd."
                            },
                            {
                                "example_id": "45807222-01ca-4862-96b2-46c7641f7e2f",
                                "sense_id": "3a1201ac-9b6d-3d4e-9f44-2fc65ed71ec8",
                                "text": "Het verhaal is losjes gebaseerd op een slecht gedocumenteerd historisch mengsel van feit en achterklap: de driehoeksverhouding tussen de Britse koningin Anne, haar jeugdvriendin, belangrijkste adviseur en misschien wel geliefde Sarah Churchill (Rachel Weisz) en het ambitieuze kamermeisje Abigail Masham."
                            },
                            {
                                "example_id": "7037a1c1-673c-460a-a471-e98f049fe837",
                                "sense_id": "3a1201ac-9b6d-3d4e-9f44-2fc65ed71ec8",
                                "text": "Maar het was een antwoord dat niet echt paste bij een jong en ambitieus iemand."
                            },
                            {
                                "example_id": "c0ba117b-f608-4a96-b7cc-bcd0bbe2dc78",
                                "sense_id": "3a1201ac-9b6d-3d4e-9f44-2fc65ed71ec8",
                                "text": "Provence was de ambitieuste van de twee broers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "787f6ff7-39b2-4011-a16a-acd3859a5e32",
                        "source_entry_id": "82b0cabb-2b05-3860-91c9-3ca0966d9bff",
                        "source_sense_id": "3a1201ac-9b6d-3d4e-9f44-2fc65ed71ec8",
                        "source_sense_description": "vol van de wens en het vertrouwen om iets te bereiken",
                        "target_lang_word": "ehrgeizig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ehrgeizig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20339a8a-ab5d-3698-a68d-0b7bc6a812d2",
                                        "entry_id": "c1d51f88-ca38-38a8-b419-cb40e2586ce1",
                                        "glosses": [
                                            "starker Wunsch, sich vor anderen auszuzeichnen, Streben nach Ehren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9209c1c0-90ac-4d66-b9bb-b5101a84dd29",
                                                "sense_id": "20339a8a-ab5d-3698-a68d-0b7bc6a812d2",
                                                "text": "Er war schon immer sehr ehrgeizig."
                                            },
                                            {
                                                "example_id": "c0aaf42d-ecd6-4312-9642-9e7f298160d4",
                                                "sense_id": "20339a8a-ab5d-3698-a68d-0b7bc6a812d2",
                                                "text": "„Aus dem Nomaden wurde auf dem Thron ein ehrgeiziger Bauherr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55d08210-f7c7-45ca-b849-aa9b83d9c14a",
                        "source_entry_id": "82b0cabb-2b05-3860-91c9-3ca0966d9bff",
                        "source_sense_id": "3a1201ac-9b6d-3d4e-9f44-2fc65ed71ec8",
                        "source_sense_description": "vol van de wens en het vertrouwen om iets te bereiken",
                        "target_lang_word": "ambitious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambitious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3431ce7-89f8-3d0b-b7ab-5c238bc7740f",
                                        "entry_id": "5a95712e-2f98-39c1-bec0-43851acc7638",
                                        "glosses": [
                                            "Having or showing ambition; wanting a lot of power, honor, respect, superiority, or other distinction."
                                        ],
                                        "tags": [
                                            "of a person or their character"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dccca38-2519-4b8c-8ac1-d61f74960e81",
                                                "sense_id": "d3431ce7-89f8-3d0b-b7ab-5c238bc7740f",
                                                "text": "an ambitious person"
                                            },
                                            {
                                                "example_id": "9d485822-9b9e-401a-8661-af4a9056094e",
                                                "sense_id": "d3431ce7-89f8-3d0b-b7ab-5c238bc7740f",
                                                "text": "someone's ambitious nature"
                                            },
                                            {
                                                "example_id": "54d91a3b-71dc-4af9-9fd7-309c8ee6e9a9",
                                                "sense_id": "d3431ce7-89f8-3d0b-b7ab-5c238bc7740f",
                                                "text": "I was ambitious—have you known\nThe passion, father? You have not:\nA cottager, I mark’d a throne\nOf half the world as all my own,\nAnd murmur’d at such lowly lot— […]"
                                            },
                                            {
                                                "example_id": "b1b495c7-2fa7-4007-97b6-195781db7156",
                                                "sense_id": "d3431ce7-89f8-3d0b-b7ab-5c238bc7740f",
                                                "text": "As I grew richer I grew more ambitious, took a house in the country, and eventually married, without anyone having a suspicion as to my real occupation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdd9a4a0-fc48-3d92-ada9-71235f1ac257",
                                        "entry_id": "5a95712e-2f98-39c1-bec0-43851acc7638",
                                        "glosses": [
                                            "Very desirous"
                                        ],
                                        "tags": [
                                            "followed by \\\"of\\\" or the infinitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e0ee6c7-14be-407b-857e-15bc9e16f181",
                                                "sense_id": "fdd9a4a0-fc48-3d92-ada9-71235f1ac257",
                                                "text": "30 June 2019, Sam Wallace in The Telegraph, Manchester United must shape Aaron Wan-Bissaka into a £50m all-rounder - but there is no hiding place at Old Trafford\nNow he is joining a club ambitious to return to a model of dominating games and attacking opposition."
                                            },
                                            {
                                                "example_id": "082e1cc0-669c-41e2-b752-b922f40f67fd",
                                                "sense_id": "fdd9a4a0-fc48-3d92-ada9-71235f1ac257",
                                                "text": "We were soon in the midst of the rapids, which were more swift and tumultuous than any we had poled up, and had turned to the side of the stream for the purpose of warping, when the boatmen, who felt some pride in their skill, and were ambitious to do something more than usual"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c0316b-ed82-3573-a3a7-88713a11d442",
                                        "entry_id": "5a95712e-2f98-39c1-bec0-43851acc7638",
                                        "glosses": [
                                            "Resulting from, characterized by, or indicating, ambition"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "480ce619-53ef-46f0-b80e-7b950d2f4b6c",
                                                "sense_id": "30c0316b-ed82-3573-a3a7-88713a11d442",
                                                "text": "an ambitious project"
                                            },
                                            {
                                                "example_id": "2d3cf24a-5e81-4842-86db-d709ca4642ed",
                                                "sense_id": "30c0316b-ed82-3573-a3a7-88713a11d442",
                                                "text": "an ambitious style"
                                            },
                                            {
                                                "example_id": "8bfff4fa-e713-4438-8357-a76f650feeeb",
                                                "sense_id": "30c0316b-ed82-3573-a3a7-88713a11d442",
                                                "text": "an ambitious attempt to take power"
                                            },
                                            {
                                                "example_id": "d5ffcd7b-7f7d-445e-9169-a7592ba2ac1b",
                                                "sense_id": "30c0316b-ed82-3573-a3a7-88713a11d442",
                                                "text": "an ambitious plan"
                                            },
                                            {
                                                "example_id": "eb086385-49be-4dea-9def-625456b626e5",
                                                "sense_id": "30c0316b-ed82-3573-a3a7-88713a11d442",
                                                "text": "an ambitious goal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d4b129-e4f0-3e53-8fb8-1dc5fcb813c1",
                                        "entry_id": "5a95712e-2f98-39c1-bec0-43851acc7638",
                                        "glosses": [
                                            "Hard to achieve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d1cf9b-7991-4db0-bb7d-12d92e269bc7",
                                                "sense_id": "61d4b129-e4f0-3e53-8fb8-1dc5fcb813c1",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays. This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
