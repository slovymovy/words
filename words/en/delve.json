                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history book mentions a family named <w>Delve</w> who lived in the village centuries ago.",
                            "target_lang_translations": {
                                "ru": "В книге по местной истории упоминается семья по фамилии <w>Делв</w>, жившая в этой деревне много веков назад.",
                                "cs": "Místní kronika zmiňuje rodinu jménem <w>Delve</w>, která v této vesnici žila před staletími."
                            }
                        },
                        {
                            "text": "Mr. <w>Delve</w> was known throughout the county for his extensive knowledge of traditional farming.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Делв</w> был известен во всем округе своими обширными знаниями в области традиционного фермерства.",
                                "cs": "Pan <w>Delve</w> byl v celém hrabství známý svými rozsáhlými znalostmi tradičního zemědělství."
                            }
