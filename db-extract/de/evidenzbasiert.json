                                "target_senses": [
                                    {
                                        "sense_id": "c26023c0-a344-3be7-addb-708657da795c",
                                        "entry_id": "6772cc00-bb49-3bc8-a607-1ee9c5e9b6d7",
                                        "glosses": [
                                            "Based only on actual evidence, rather than tradition etc."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c87c091a-b4dd-483a-be46-c940ba0e1437",
                                                "sense_id": "c26023c0-a344-3be7-addb-708657da795c",
                                                "text": "He told the GWPF Australia needed “evidence-based policy rather than policy-based evidence” and took aim at a 2013 study that showed that 97% of scientists agree humans are driving climate change, “as if scientific truth is determined by votes rather than facts”."
                                            },
                                            {
                                                "example_id": "8d2b45fc-ba6f-475e-88c6-be7d30230669",
                                                "sense_id": "c26023c0-a344-3be7-addb-708657da795c",
                                                "text": "The spectacle of a prominent vaccine sceptic and wellness crank as secretary of health and human services goes beyond an abandonment of truth; it feels like an assault on human progress. Bans on fluoride in tap water, passed by legislators in Utah and Florida at Robert F Kennedy Jr’s behest, mark a new hostility to the very idea of evidence-based government."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
