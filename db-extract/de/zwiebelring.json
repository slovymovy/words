                    {
                        "translation_id": "670b8c96-9409-428e-84c7-1437e2539dc8",
                        "source_entry_id": "22d06ecf-01cf-3d57-b43f-947efea627e7",
                        "source_sense_id": "c86c65b8-f697-3214-8d50-c1a5e88c3c14",
                        "source_sense_description": "Gastronomie: ein ringförmige Scheibe einer Zwiebel",
                        "target_lang_word": "uienring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uienring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6488c4-8d16-3986-802e-0b29cac80a3c",
                                        "entry_id": "a5293117-4a7f-3031-b1f6-e225a2c09da1",
                                        "glosses": [
                                            "gesneden ui zodanig dat er ringen zijn ontstaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457050fb-d6b2-4f13-9875-ae5f58c963e9",
                                                "sense_id": "dc6488c4-8d16-3986-802e-0b29cac80a3c",
                                                "text": "Het uitverkoren nummer werd bekendgemaakt via een filmpje waarin naast Hillary haar man Bill figureert. Het filmpje is een parodie op de laatste scène van de maffiaserie The Sopranos. Hillary zit in een cafeetje en bladert, net als Tony Soprano in zijn laatste scène, door de nummers die te horen zijn op de jukebox. Bill krijgt een schaaltje met wortels voorgeschoteld. In de scène waarop het filmpje gebaseerd is, krijgt Tony uienringen op zijn bord. 'Geen uienringen?', vraagt de voormalige president daarom. 'Ik let op je gezondheid', antwoordt de 59-jarige presidentskandidaat."
                                            },
                                            {
                                                "example_id": "b8ad093f-f647-4436-8fbc-3a8dcb3fde12",
                                                "sense_id": "dc6488c4-8d16-3986-802e-0b29cac80a3c",
                                                "text": "Doe zout en peper bij de bloem en haal daar plakken lever door. Bak in ruime boerenboter, drie minuten aan iedere kant. Wat uienringen ernaast. Serveer een plak met een appeltje, beetje van het zoete vocht, en wat uitjes. Gebakken witlof ernaast. Zo lekker dat je een vreugdedansje doet."
                                            },
                                            {
                                                "example_id": "687e444d-79cf-4eac-8517-a02d72c453d0",
                                                "sense_id": "dc6488c4-8d16-3986-802e-0b29cac80a3c",
                                                "text": "De 'Legendary Burger', een half pounder met gerookte bacon, cheddar kaas, gebakken uienringen, sla, tomaat en patat kost normaal €15,95 en is al jaren de populaire burger van het café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
