        "fr-extract.jsonl": [
            {
                "entry_id": "ebeeb86c-9fcb-38bd-a89a-eae7fda237c4",
                "word": "vérifiable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d03371f-bcdd-3b60-b6fa-ee70d658d0ff",
                        "entry_id": "ebeeb86c-9fcb-38bd-a89a-eae7fda237c4",
                        "glosses": [
                            "Qui peut être vérifié, soumis à une vérification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e115642-5b9e-4e19-b4b6-942e21c96f94",
                                "sense_id": "8d03371f-bcdd-3b60-b6fa-ee70d658d0ff",
                                "text": "Il n’y a qu’une mesure puisée dans le sein même de la nature, une mesure constante, inaltérable, vérifiable dans tous les temps, qui puisse par ces avantages arracher, pour ainsi dire, le consentement de tous les peuples, & réunir toutes les voix en sa faveur …."
                            },
                            {
                                "example_id": "11adf4da-bc0b-4890-b84d-3f1d2fc05d12",
                                "sense_id": "8d03371f-bcdd-3b60-b6fa-ee70d658d0ff",
                                "text": "Personne ne dira qu’il est vérifiable et certain qu’il y a une cause première et personnelle, gouverneur moral et intelligent de l’univers, et que nous pouvons l’appeler Dieu si bon nous semble."
                            },
                            {
                                "example_id": "e32319c2-5062-40e3-b602-d9c602c97fc7",
                                "sense_id": "8d03371f-bcdd-3b60-b6fa-ee70d658d0ff",
                                "text": "La question est plus délicate si l’effort de l’employé, bien qu’observable par l’employeur, n’est pas vérifiable par un tiers ou par un tribunal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93bc1b4b-a3fa-444f-a025-84796f21e601",
                        "source_entry_id": "ebeeb86c-9fcb-38bd-a89a-eae7fda237c4",
                        "source_sense_id": "8d03371f-bcdd-3b60-b6fa-ee70d658d0ff",
                        "target_lang_word": "nachprüfbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachprüfbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                        "entry_id": "f6aebb89-7a38-3a34-99e4-fb3223d47d19",
                                        "glosses": [
                                            "kann geprüft oder gezeigt werden als wahr, korrekt oder berechtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53998016-ac45-4330-a892-36424b00b888",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "Die These ist nachprüfbar, mal sehen, ob sie stimmt."
                                            },
                                            {
                                                "example_id": "47961a15-aff0-470f-9d06-db1354c15044",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "Sein Alibi ist nachprüfbar richtig."
                                            },
                                            {
                                                "example_id": "15af26ec-42f4-4f53-9531-e753e2659b58",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "Wissenschaftler sollten nur Theorien aufstellen, die in sich schlüssig und nachprüfbar sind."
                                            },
                                            {
                                                "example_id": "9628501f-7c54-4651-b027-3e9d212554bc",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "Die USA fordern eine komplette, nachprüfbare und unumkehrbare Vernichtung dieser [Atom-]Waffen [in Nordkorea]."
                                            },
                                            {
                                                "example_id": "503c0e54-6e7a-4938-9796-5b40871acfa9",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "Die Automobilindustrie muss wirkungsvoll, nachprüfbar und auf eigene Kosten dafür sorgen, dass die Grenzwerte [der Emissionen ihrer Autos] eingehalten werden."
                                            },
                                            {
                                                "example_id": "627a7c9f-ff73-415a-ace6-ffeeef75fe20",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "Schluss mit der Unterstützung für bewaffnete Separatisten, stattdessen endlich nachprüfbare Schritte für eine Entschärfung der Krise in der Ukraine. Dies forderte die NATO in ihrer Dringlichkeitssitzung von Moskau."
                                            },
                                            {
                                                "example_id": "c4206898-bcd8-418e-abd4-166ebeb42407",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "[Für die Hartz-IV-Sätze für Erwachsene und Kinder ist entscheidend,] dass der Gesetzgeber in rechtlich nachprüfbarer Weise den Grundbedarf für die Sicherung des Existenzminimums ermittelt. Schätzungen „ins Blaue hinein“, wie es in der Urteilsbegründung wörtlich heißt, stünden jedoch nicht im Einklang mit den rechtlichen Anforderungen bei der Ermittlung der Bedarfssicherung."
                                            },
                                            {
                                                "example_id": "098040e0-f81e-44a4-9e07-43ea07603ceb",
                                                "sense_id": "7b45c388-0830-3e7d-b130-3c7e6e10d0d6",
                                                "text": "[Neue Fahrtenschreiber für LKWs:] Mit diesen neuen digitalen Geräten sind Lenk- und Ruhezeiten sowie Geschwindigkeit in Verbindung mit den Chipkarten nachprüfbar erfasst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
