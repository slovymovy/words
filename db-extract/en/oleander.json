                                "target_senses": [
                                    {
                                        "sense_id": "cef04875-0794-3784-8880-d495201e77b5",
                                        "entry_id": "bca6d69c-fcfa-3d0d-b646-a6667a847e27",
                                        "glosses": [
                                            "immergrüne Pflanzenart aus der Familie der Hundsgiftgewächse, beliebte Kübelpflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec96ba97-efd5-457d-a596-d86c29c2239d",
                                                "sense_id": "cef04875-0794-3784-8880-d495201e77b5",
                                                "text": "Auf meiner Terrasse steht ein Oleander."
                                            },
                                            {
                                                "example_id": "e80e7ab6-4ac8-418f-8935-a3419a3d0dda",
                                                "sense_id": "cef04875-0794-3784-8880-d495201e77b5",
                                                "text": "„Das lässt sich selbst bei unserem mitreisenden Oleander beobachten, der sicherlich kein normales Oleanderleben führt.“"
                                            },
                                            {
                                                "example_id": "a06a3c48-668f-439e-884d-7d1d14d7d4d0",
                                                "sense_id": "cef04875-0794-3784-8880-d495201e77b5",
                                                "text": "„Ich schaue ins Wasser, erst ins fallende, dann ins stehende, betrachte den Oleander, der rechts und links wächst, die Felsen, den Himmel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
