                "senses": [
                    {
                        "sense_id": "2d339b4d-9634-387d-8492-2e38942c9a41",
                        "entry_id": "84a8b1f1-f98d-3be6-a1bf-4632dc2257bf",
                        "glosses": [
                            "то же, что авиационная бомба; сбрасываемый с летательного аппарата снаряд, не имеющий собственного двигателя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b495fe5e-3dbd-4a9a-b349-f47debd4777d",
                                "sense_id": "2d339b4d-9634-387d-8492-2e38942c9a41",
                                "text": "Расстояние было меньше необходимого, так как сброшенная авиабомба по инерции продолжает лететь по направлению полета самолета и лишь немного сносится сопротивлением воздуха назад."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a7d8648-43c0-47b5-a988-aa8799494361",
                        "source_entry_id": "84a8b1f1-f98d-3be6-a1bf-4632dc2257bf",
                        "source_sense_id": "2d339b4d-9634-387d-8492-2e38942c9a41",
                        "target_lang_word": "airbomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airbomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc459047-325d-3ec6-bfb3-ee8ace56d3ba",
                                        "entry_id": "0333c7e4-16fc-366a-b19b-73727ccdef24",
                                        "glosses": [
                                            "A firework consisting of flash powder in a paper case, ejected into the air with a black powder lifting charge ignited by a fuse, and producing a loud bang and bright flash."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bca6365-cd43-485f-9e1c-43af83f29579",
                        "source_entry_id": "84a8b1f1-f98d-3be6-a1bf-4632dc2257bf",
                        "source_sense_id": "2d339b4d-9634-387d-8492-2e38942c9a41",
