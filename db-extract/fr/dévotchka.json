                        "cross_references": [
                            {
                                "target_word": "devotchka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b335938-f61b-3647-af26-4ca51a8a2809",
                                        "entry_id": "caa80144-0cc9-3d64-9796-d30c8675e96e",
                                        "glosses": [
                                            "A girl, especially one of Russian descent."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "270f268b-9e4c-4a3e-90b0-5e6a37bf1f15",
                                                "sense_id": "1b335938-f61b-3647-af26-4ca51a8a2809",
                                                "text": "This evening in the Korova there was a fair number of vecks and ptitsas and devotchkas and malchicks smecking and peeting away, and cutting through their govoreeting and the burbling of the in-the-landers with their 'Gorgor fallatuke and the worm sprays in filltip slaughterballs' and all that cal you could slooshy a popdisc on the stereo, this being Ned Achimota singing 'That Day, Yeah, That Day'."
                                            },
                                            {
                                                "example_id": "0047532a-7e99-41a9-8ab7-744924271f9f",
                                                "sense_id": "1b335938-f61b-3647-af26-4ca51a8a2809",
                                                "text": "His arm wrapped her shoulders, and he dropped a kiss on her head. \"Come on, devotchka. I'm taking you home.\""
                                            },
                                            {
                                                "example_id": "265f5529-8b69-4b91-897e-55195e7b5931",
                                                "sense_id": "1b335938-f61b-3647-af26-4ca51a8a2809",
                                                "text": "Meanwhile, three churlish mops stroke their cheeks at the top of the stairs as if to remind the first guest that they are truly the rosy-cheeked devotchkas of yore."
                                            },
                                            {
                                                "example_id": "c27cb48c-4de8-4b41-946a-2b38b0beb51b",
                                                "sense_id": "1b335938-f61b-3647-af26-4ca51a8a2809",
                                                "text": "“Comrade Golovkin,” he said. “It is a terrible afternoon, devotchka. May I offer you a ride back to the Kremlin?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
