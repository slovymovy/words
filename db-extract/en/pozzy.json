                                "sense_id": "e1ffd9c3-efad-359d-8d7b-07db76c56651",
                                "text": "‘Could you pinch a tin of pozzy out of stores?’"
                            },
                            {
                                "example_id": "432b0677-6ed1-45a3-a3bc-7c8cf8bdcd6a",
                                "sense_id": "e1ffd9c3-efad-359d-8d7b-07db76c56651",
                                "text": "The Turco used to say: 'Tommy, give Johnny pozzy,' and a tin of plum and apple jam used to be given him."
                            }
                        ]
                    }
