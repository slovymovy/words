        "fr-extract.jsonl": [
            {
                "entry_id": "88c784e7-73e5-381d-a574-59329b356a54",
                "word": "anderthalb",
                "pos": "adj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d7dc1b1-9ea4-35d8-ba34-4e7dfb607275",
                        "entry_id": "88c784e7-73e5-381d-a574-59329b356a54",
                        "glosses": [
                            "Un et demi."
                        ],
                        "tags": [],
                        "note": "Suivi du pluriel",
                        "examples": [
                            {
                                "example_id": "ccb3fc6d-7625-4c7b-bf9c-aa776d439fa0",
                                "sense_id": "6d7dc1b1-9ea4-35d8-ba34-4e7dfb607275",
                                "text": "Der Unterricht dauert anderthalb Stunden.",
                                "translation": "Le cours dure une heure et demie."
                            },
                            {
                                "example_id": "ff33620c-f5cd-42c9-a74b-ad76450f155c",
                                "sense_id": "6d7dc1b1-9ea4-35d8-ba34-4e7dfb607275",
                                "text": "Aus dem klassischen Arabisch hat sich in den letzten anderthalb Jahrtausenden eine Vielzahl von Dialekten entwickelt.",
                                "translation": "Un grand nombre de dialectes se sont développés à partir de l’arabe classique lors du dernier millénaire et demi."
                            },
                            {
                                "example_id": "e78a2f99-5f11-4745-a00a-9ef2bc8e771c",
                                "sense_id": "6d7dc1b1-9ea4-35d8-ba34-4e7dfb607275",
                                "text": "Einen solchen Knickverschluss kennt der eine oder andere vom Gartenschlauch. Man fragt die Schwester, warum der Gartenschlauch nicht mehr geht. Wenn sie das Schlauchende anguckt, lässt man den Knick schnell los und wartet anderthalb Minuten, bis man Hausarrest kriegt.",
                                "translation": "Pour comprendre comment fonctionne ce coude, rappelez-vous le jeu du tuyau d’arrosage. On demande à sa grande sœur ou à son grand frère pourquoi l’eau ne coule plus et, quand ils inspectent l’embout du tuyau, on relâche le coude. Après ça, il n’y a plus qu’à attendre quatre-vingt-dix secondes avant d’être “puni-au-lit-sans-manger”."
                            }
                        ]
                    }
                ],
