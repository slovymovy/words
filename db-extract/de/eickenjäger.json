                "senses": [
                    {
                        "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                        "entry_id": "6bf1dab3-8ab7-3026-8806-3e1a969e341f",
                        "glosses": [
                            "niederdeutscher Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ead545-2235-4fc4-8f4b-4f865cdc3841",
                                "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                                "text": "Eickenjäger kommt und geht."
                            },
                            {
                                "example_id": "f1d13cb4-b266-4c88-b9bb-b70fbbd127af",
                                "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                                "text": "Eickenjägers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "06968327-d986-4977-b204-294a561f0ea8",
                                "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                                "text": "Frau Eickenjäger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "658cafa1-b300-4d5e-9613-d2a0a5c86593",
                                "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                                "text": "Herr Eickenjäger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "828c5610-2440-487f-bb26-df1e30f930ca",
                                "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                                "text": "Die Eickenjägers kommen heute aus Florida."
                            },
                            {
                                "example_id": "ee22c084-94b4-4174-a488-845be2e97d10",
                                "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                                "text": "Der Eickenjäger trägt nie die Schals, die die Eickenjäger ihm strickt."
                            },
                            {
                                "example_id": "1c85877a-f3da-466a-84a6-688367f8b2d7",
                                "sense_id": "f858aea1-cc88-3730-a50c-6c78487d6d3b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eickenjäger kommt, geht der Herr Eickenjäger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
