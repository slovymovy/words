                "senses": [
                    {
                        "sense_id": "6d5ad100-aa26-375f-b201-4bc83bc13a09",
                        "entry_id": "bca21799-5b8e-3b7b-ab31-6ddc7731feaf",
                        "glosses": [
                            "höchster islamischer Beamter, der nur dem Sultan untersteht und die Regierungsgeschäfte ausführt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0566c7a1-1494-4483-8881-945086f58ed5",
                                "sense_id": "6d5ad100-aa26-375f-b201-4bc83bc13a09",
                                "text": "„Die Linken brachte ich ins Haus, aber die sortierte Omar in seiner Eigenschaft als Großwesir schnell wieder aus.“"
                            },
                            {
                                "example_id": "ccd1b797-547c-4370-bf7a-70c004a95532",
                                "sense_id": "6d5ad100-aa26-375f-b201-4bc83bc13a09",
                                "text": "„Hier erhält ein Großwesir, der sich in seinem Harem dem Liebesspiel hingibt, plötzlich von einem Boten des nahenden Feindes eine seidene Schnur überreicht, als Fanal seines unmittelbar bevorstehenden Todes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc73cb66-6991-3ecc-971a-883909f90610",
                        "entry_id": "bca21799-5b8e-3b7b-ab31-6ddc7731feaf",
                        "glosses": [
                            "Titel, den der türkische Ministerpräsident trug"
                        ],
                        "tags": [
                            "historisch (bis 1922)"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "602a58b9-b259-48a7-9340-7cb91763f787",
                        "source_entry_id": "bca21799-5b8e-3b7b-ab31-6ddc7731feaf",
                        "source_sense_id": "6d5ad100-aa26-375f-b201-4bc83bc13a09",
                        "target_lang_word": "grand vizier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grand vizier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39cd0d2a-0d91-39b3-9a81-290dc02dc462",
                                        "entry_id": "acbb61ad-15b1-3653-ba70-0ae72edb97ac",
                                        "glosses": [
                                            "The greatest minister of a sultan, with absolute power of attorney and, in principle, dismissable only by the sultan himself."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23c9370c-247b-3f4b-9ce9-16b77420cf87",
                                        "entry_id": "acbb61ad-15b1-3653-ba70-0ae72edb97ac",
                                        "glosses": [
                                            "A figure of great authority and power."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f790e67f-6f23-43e3-beae-4db44ee0aaad",
                                                "sense_id": "23c9370c-247b-3f4b-9ce9-16b77420cf87",
                                                "text": "But the ultimate fix came from the grand vizier of New Orleans voodoo-funk, Dr John, whose mesmerising performance was as close as you'll come to witnessing a shaman summoning spirits."
                                            },
                                            {
                                                "example_id": "ef9995e0-9c85-4932-b34c-fd67c26dbc87",
                                                "sense_id": "23c9370c-247b-3f4b-9ce9-16b77420cf87",
                                                "text": "To read his memoir of those years, Locked in the Cabinet, is to feel the sting experienced by this talented, innovative, and principled small “d” democrat as he was repeatedly shoved aside on economic issues by Rubin, Bentsen, Panetta, and, of course, the grand vizier himself, Alan Greenspan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9d9a9f7-7074-4877-8d3d-240c198d5d61",
                        "source_entry_id": "bca21799-5b8e-3b7b-ab31-6ddc7731feaf",
