                    },
                    {
                        "translation_id": "9b6f580b-2880-4746-ba98-16486e7a071c",
                        "source_entry_id": "e592abef-098b-3b64-8976-7416aef291ff",
                        "source_sense_id": "9c6f21c0-4587-35dd-baac-98b41775049a",
                        "target_lang_word": "zur Genüge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zur Genüge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "891b83e0-2155-31ef-b7c4-2109fadd7e37",
                                        "entry_id": "b8c2a217-73eb-3fb8-8360-1eb4e6c6e425",
                                        "glosses": [
                                            "in hinreichendem Maß; bis zum Überdruss"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "953e0bbd-98bf-4bc3-a270-262db440019c",
                                                "sense_id": "891b83e0-2155-31ef-b7c4-2109fadd7e37",
                                                "text": "„Endlich bedeutete ihm der Vorſitzende, der Gerichtshof ſei zur Genüge aufgeklärt über des Profeſſors Verhältnis zu ſeinen Schülern.“"
                                            },
                                            {
                                                "example_id": "8d4faf28-a9d6-4ec1-99ba-84e7c6f0939e",
                                                "sense_id": "891b83e0-2155-31ef-b7c4-2109fadd7e37",
                                                "text": "„Gregor erfuhr nun zur Genüge — denn der Vater pflegte sich in seinen Erklärungen öfters zu wiederholen, teils, weil er selbst sich mit diesen Dingen schon lange nicht beschäftigt hatte, teils auch, weil die Mutter nicht alles gleich beim ersten Mal verstand — , daß trotz allen Unglücks ein allerdings ganz kleines Vermögen aus der alten Zeit noch vorhanden war, das die nicht angerührten Zinsen in der Zwischenzeit ein wenig hatten anwachsen lassen.“"
                                            },
                                            {
                                                "example_id": "7e9bcc1d-7619-4291-87f1-49c871faf0ee",
                                                "sense_id": "891b83e0-2155-31ef-b7c4-2109fadd7e37",
                                                "text": "„Was die Managerkrankheit bedeute, wisse man zur Genüge, Unrast, Lärm, zerrüttete Ehen und Nerven, […].“"
                                            },
                                            {
                                                "example_id": "f93c1ab5-48fb-471a-b71c-c74442acefce",
                                                "sense_id": "891b83e0-2155-31ef-b7c4-2109fadd7e37",
                                                "text": "„Nun ist es, wie der verträgliche Jakob und ich mit ihm zur Genüge wissen, die leichteste Sache von der Welt, anderer Meinung zu sein als Kowalski, aber in diesem besonderen Fall ist man geneigt, ihm recht zu geben.“"
                                            },
                                            {
                                                "example_id": "e368d13c-ef53-4192-b407-09859ef461f5",
                                                "sense_id": "891b83e0-2155-31ef-b7c4-2109fadd7e37",
                                                "text": "„Sollten sie sich doch untereinander zerfleischen, was sie ja auch zur Genüge taten.“"
                                            },
                                            {
                                                "example_id": "54cca876-eeee-45db-a53f-7ae87e5ddd17",
                                                "sense_id": "891b83e0-2155-31ef-b7c4-2109fadd7e37",
                                                "text": "„Ich hatte indes zur Genüge wiederholt, dass er gänzlich harmlos sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b4abd16-87e6-4866-b354-79820c156873",
                        "source_entry_id": "e592abef-098b-3b64-8976-7416aef291ff",
                        "source_sense_id": "9c6f21c0-4587-35dd-baac-98b41775049a",
                        "target_lang_word": "abondamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abondamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                        "entry_id": "7cc85cc6-d415-33c7-87a1-c7f4a40c0f69",
                                        "glosses": [
                                            "Avec abondance, de manière abondante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee3cc99-e77b-438e-9e23-6d68152d230c",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Sur le pont, en tenue légère, étaient des matelots américains, tous abondamment tatoués."
                                            },
                                            {
                                                "example_id": "ff5f4fac-3d3a-4fc8-9628-e67251a98f30",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "La salive contient abondamment de l’enzyme protéolytique qui attaque les albumines."
                                            },
                                            {
                                                "example_id": "63e95c34-b098-48ef-8478-19914696d58a",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Cette source fournit de l'eau abondamment."
                                            },
                                            {
                                                "example_id": "e1768bd9-3fe7-4cb4-b3f7-f86b6b0debb0",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Cet avocat parla plus abondamment que son adversaire."
                                            },
                                            {
                                                "example_id": "e20beb3e-11f6-4774-b65d-6272c7cf51a9",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Parce qu’il ne jeûnait et qu’il ne payait si abondamment la dîme que par orgueil."
                                            },
                                            {
                                                "example_id": "3fcdf74d-b071-4b68-91ad-966a01525a7a",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Le Seigneur se communiquait à eux [aux saints] plus abondamment."
                                            },
                                            {
                                                "example_id": "af411edd-f1ff-4b82-b04d-93b6d387af88",
                                                "sense_id": "ec83574a-74c7-36ac-a68d-e0ce0c6175a6",
                                                "text": "Animés plus abondamment de son esprit [on parle de Dieu]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                        "entry_id": "7cc85cc6-d415-33c7-87a1-c7f4a40c0f69",
                                        "glosses": [
                                            "Amplement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a51139a7-cc0f-44d3-8189-9ec5cdbc843b",
                                                "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                                "text": "Cela est abondamment expliqué, abondamment démontré dans plusieurs livres."
                                            },
                                            {
                                                "example_id": "453c30aa-dd81-4636-a68d-5f44c6014fdf",
                                                "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                                "text": "Il y a dans ce sujet abondamment de quoi remplir un poème entier."
                                            },
                                            {
                                                "example_id": "6df153fe-63c2-4a7a-8699-05e7675a0b90",
                                                "sense_id": "cde98353-fb86-3cc5-8b5e-7e9cbe56c6e8",
                                                "text": "Cette question sera abondamment traitée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
