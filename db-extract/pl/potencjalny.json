                    },
                    {
                        "translation_id": "2756f243-a069-48b9-b86b-b5fdc385e660",
                        "source_entry_id": "5e6e324e-b0e7-3129-bcc9-424bb1b82bd5",
                        "source_sense_id": "57eb5256-f5ad-32cd-8471-7afcb48a6fa1",
                        "target_lang_word": "потенциальный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "потенциальный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bbca1b9a-747c-3c9a-9c50-ab8918e3f071",
                                        "entry_id": "a709e8f6-c590-35ea-9771-7326740d5f68",
                                        "glosses": [
                                            "физ. относящийся к потенциалу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7ff3724-374a-49f1-aea8-d632d7a8cc73",
                                                "sense_id": "bbca1b9a-747c-3c9a-9c50-ab8918e3f071",
                                                "text": "Механика даёт способ, хотя бы при помощи уравнений Лагранжа второго вида, вычислять силы, изменяющие известные независимые параметры, коль скоро известно выражение кинетической и потенциальной энергии в этих параметрах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9715fe-b171-33c7-b4f7-e2d191d8cb8d",
                                        "entry_id": "a709e8f6-c590-35ea-9771-7326740d5f68",
                                        "glosses": [
                                            "книжн. существующий в потенции; скрытый, возможный, вероятный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852cb6d5-e53e-45cd-b3e4-d7bcf7ac72c1",
                                                "sense_id": "ac9715fe-b171-33c7-b4f7-e2d191d8cb8d",
                                                "text": "Причина есть то, что действует — производит, вновь рождает следствие, что переводит его из состояния чисто потенциального в актуальное."
                                            },
                                            {
                                                "example_id": "0af23bca-72f6-4f15-9e51-e15d07453cf0",
                                                "sense_id": "ac9715fe-b171-33c7-b4f7-e2d191d8cb8d",
                                                "text": "Итак, естественная смерть у человека скорее потенциальна, чем действительна."
                                            },
                                            {
                                                "example_id": "c863ceb9-06ad-4bfd-b481-1b15440d14b0",
                                                "sense_id": "ac9715fe-b171-33c7-b4f7-e2d191d8cb8d",
                                                "text": "Необходим добавочный фактор, чтобы из потенциального наркомана стать действующим."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
