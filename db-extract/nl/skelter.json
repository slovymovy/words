                                        "entry_id": "1f3798c1-b523-3482-b922-1ecc00d233f2",
                                        "glosses": [
                                            "A toy car large enough to ride in, typically for small children, which is operated by pedals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b7b5396-d3a3-4872-adec-84abeb333cf6",
                                                "sense_id": "92dc7e7a-aec4-36ca-8e24-7e3a5938a385",
                                                "text": "(Bitsy): You know how to find your grandparents' house?\n(Marvin): Not exactly. Too bad Mom and Dad were too cheap to install a GPS system in my pedal car!"
                                            }
