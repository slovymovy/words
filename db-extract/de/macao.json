                "senses": [
                    {
                        "sense_id": "7b33dbb8-72b2-3878-a50a-4e64ec5f0d3c",
                        "entry_id": "2523945e-944c-3f61-8043-039290ea0c76",
                        "glosses": [
                            "chinesische Sonderverwaltungszone, ehemalige portugiesische Kolonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a735dc2-6f7d-41e0-a5c8-a92e3a6d04ec",
                                "sense_id": "7b33dbb8-72b2-3878-a50a-4e64ec5f0d3c",
                                "text": "Seit 2002 boomen die Casinos in Macao."
                            },
                            {
                                "example_id": "9e213216-972f-4354-839d-f79093d7b661",
                                "sense_id": "7b33dbb8-72b2-3878-a50a-4e64ec5f0d3c",
                                "text": "„Das sozialistische Wirtschaftssystem Chinas wird in Macao nicht angewandt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32bfd0b1-6dbb-4c35-9b98-4cb67f543fe1",
                        "source_entry_id": "2523945e-944c-3f61-8043-039290ea0c76",
                        "source_sense_id": "7b33dbb8-72b2-3878-a50a-4e64ec5f0d3c",
                        "source_sense_description": "chinesische Sonderverwaltungszone, ehemalige portugiesische Kolonie",
                        "target_lang_word": "Macau",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Macau",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52e71b59-7902-381d-b826-9c3f3e8f4e1a",
                                        "entry_id": "c2f5c10f-56b3-3182-8c65-ec359529f439",
                                        "glosses": [
                                            "A city, special administrative region, and peninsula in China, west of Hong Kong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdba0058-aa73-469a-875b-91cf4d920ddb",
                                                "sense_id": "52e71b59-7902-381d-b826-9c3f3e8f4e1a",
                                                "text": "Open 24 hours a day and seven days a week, Macau's 35 casinos entertain around 30 million visitors each year, making over 30 billion euros in revenue. These are figures which make the US gambling city of Las Vegas look like a desert village.[…]\nMacau is the only place in China where gambling is officially permitted. Until the end of 1999, the peninsula was a Portuguese colony. Since it was handed back to China, the city of 600,000 people located at the mouth of the Pearl River has been a largely autonomous Special Administrative Region (SAR)."
                                            },
                                            {
                                                "example_id": "fab3ba3e-20c8-4a08-a753-7caba73c2d7c",
                                                "sense_id": "52e71b59-7902-381d-b826-9c3f3e8f4e1a",
                                                "text": "At the height of the Covid wave, some mainland residents ventured across the border to the Chinese territory of Macau to find foreign-made mRNA vaccines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "227ed149-8fbc-32d6-8cf0-cae4bc22d8c0",
                                        "entry_id": "c2f5c10f-56b3-3182-8c65-ec359529f439",
                                        "glosses": [
                                            "a former Portuguese colony in modern southern China between 1557 and 1999."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd5a7c2-74e1-428d-98e3-209e949e8712",
                                                "sense_id": "227ed149-8fbc-32d6-8cf0-cae4bc22d8c0",
                                                "text": "When you depart from Macau to ye other coaſt, you must put out at the Eaſt chanel, if the wind bee Northweſt, if not, then you cannot paſſe, that way, but you muſt ſayle thorough the ſouthweſt chanel, which is a good way to paſſe out, running from the point of Varella, right unto the land on the other ſide of Macau,[…]"
                                            },
                                            {
                                                "example_id": "28193a23-0891-4b77-a650-4c107d175c16",
                                                "sense_id": "227ed149-8fbc-32d6-8cf0-cae4bc22d8c0",
                                                "text": "SOuthward from the County of Quancheufu, lie many ſmall Iſlands in the Sea ; on one of which, being a little hanging Iſle, or rather a Rock, joyn'd to a great Iſland, lieth the City Makao, otherwiſe call'd Amacao, Machao, and Makau, poſſeſs'd by the Portugueſe, on a Promontory, ſo naturally Fortifi'd, that it is almoſt invincible."
                                            },
                                            {
                                                "example_id": "bcbfd1ef-8ac8-4392-9d03-00830bef2ce2",
                                                "sense_id": "227ed149-8fbc-32d6-8cf0-cae4bc22d8c0",
                                                "text": "Within 20 years, Macau had become an international city and one of the richest places on earth, thanks to investment in the cargoes shipped through the port."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d213cab-00ee-46a7-9a98-41571d4a63e7",
                        "source_entry_id": "2523945e-944c-3f61-8043-039290ea0c76",
                        "source_sense_id": "7b33dbb8-72b2-3878-a50a-4e64ec5f0d3c",
                        "source_sense_description": "chinesische Sonderverwaltungszone, ehemalige portugiesische Kolonie",
                        "target_lang_word": "Macao",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Macao",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a9ef17b-a7fa-3157-98d4-1242319a2967",
                                        "entry_id": "444b2652-1179-31d1-b665-a99d5b89a03f",
                                        "glosses": [
                                            "Ville de Chine, ancienne colonie portugaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e42510-9dbe-47ef-9071-0b672df49a11",
                                                "sense_id": "9a9ef17b-a7fa-3157-98d4-1242319a2967",
                                                "text": "Macao, ville et port de la Chine, province de Quang-Toung, située à l’extrémité méridionale d’une petite île de son nom, dans la baie de Canton, à peu près à 16 l. au sud de l’embouchure du fleuve Tchu-Kiang."
                                            },
                                            {
                                                "example_id": "17440777-1feb-4fd7-bcb1-62f2e6fc972f",
                                                "sense_id": "9a9ef17b-a7fa-3157-98d4-1242319a2967",
                                                "text": "On ne parle pas portugais seulement à Lisbonne ou à Brasilia, mais aussi en Angola, à Macao ou au Timor oriental."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
