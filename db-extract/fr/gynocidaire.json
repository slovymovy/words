                                        "entry_id": "3a8eac25-c36c-3afd-ad29-845cfb31570e",
                                        "glosses": [
                                            "Of or relating to gynocide; killing women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26762e9b-76c4-4d7f-9a13-1cbb9f7b1da5",
                                                "sense_id": "de5d5bb6-be20-3984-ae73-2477f9677773",
                                                "text": "These murders reveal not only our culture's profound gynocidal propensities, but simultaneously its geocidal desires and intentions. The endless numbers of women raped, flayed, mutilated, and murdered, in both the real and the symbolic worlds, reflect and enact the large-scale assaults on the besieged and traditionally female-identified Earth."
                                            }
                                        ]
                                    }
