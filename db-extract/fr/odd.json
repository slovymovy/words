                                            {
                                                "example_id": "cb10909b-6ea6-48bf-b7c9-cef33824c3a0",
                                                "sense_id": "4d4788b8-d17a-3126-aafb-1a770f2ab7fe",
                                                "text": "The SDGs are supposed to set out how to improve the lives of the poor in emerging countries, and how to steer money and government policy towards areas where they can do the most good. But the efforts of the SDG drafting committees are so sprawling and misconceived that the entire enterprise is being set up to fail."
                                            },
                                            {
                                                "example_id": "91685bfc-8e01-41c7-ad3a-4fe8e4c7e3bd",
                                                "sense_id": "4d4788b8-d17a-3126-aafb-1a770f2ab7fe",
                                                "text": "Just before the launch of the SDGs, the World Bank published fresh projections for poverty reduction towards 2030."
                                            }
