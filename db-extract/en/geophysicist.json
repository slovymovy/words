                "senses": [
                    {
                        "sense_id": "02139182-4343-34df-8a73-f4128b57499b",
                        "entry_id": "250508cb-8652-3a8e-a1e8-6d75c6f69d6c",
                        "glosses": [
                            "A physicist who specializes in geophysics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc20c67-6901-455d-83d8-cf31e271ac1f",
                                "sense_id": "02139182-4343-34df-8a73-f4128b57499b",
                                "text": "Yevgeny K. Fedorov, one of the Soviet Union's leading geophysicists, died Wednesday, Tass, the official press agency, reported today. He was 71 years old."
                            },
                            {
                                "example_id": "24846c57-4614-4461-8ff4-a64c6e3fbd19",
                                "sense_id": "02139182-4343-34df-8a73-f4128b57499b",
                                "text": "“The lack of an agreement to phase out fossil fuels was devastating,” said Prof Michael Mann, a climatologist and geophysicist at the University of Pennsylvania in the US."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9f658b6-5861-45de-906c-69c0b825b962",
                        "source_entry_id": "250508cb-8652-3a8e-a1e8-6d75c6f69d6c",
                        "source_sense_id": "02139182-4343-34df-8a73-f4128b57499b",
                        "source_sense_description": "one who studies geophysics",
                        "target_lang_word": "geofysicus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geofysicus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7ce616d2-14aa-3bce-bafc-26727e936acc",
                                        "entry_id": "6a3a8be1-e55e-3226-b01d-91d85e297d0f",
                                        "glosses": [
                                            "iemand die de natuurkundige verschijnselen van de aarde bestudeert"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49bb82fd-5639-45ae-a185-bc535281a39b",
                                                "sense_id": "7ce616d2-14aa-3bce-bafc-26727e936acc",
                                                "text": "Geofysicus Joep Orbons van bureau ArcheoPro is in opdracht van de gemeente met een weerstandsmeter een terrein van 2 hectare afgegaan. Zo kon hij de grachten en muurresten opsporen. \"Er zit hier nog echt een verborgen kasteel onder de graszoden,\" zegt hij tegen NH Nieuws."
                                            },
                                            {
                                                "example_id": "832ca6e8-7cdd-42c4-b507-e1a776eeb630",
                                                "sense_id": "7ce616d2-14aa-3bce-bafc-26727e936acc",
                                                "text": "\"Italië behoort tot de meer actieve gebieden\", zegt geofysicus Rob Govers van de Universiteit Utrecht. \"Iets actiever nog dan Griekenland en Turkije.\""
                                            },
                                            {
                                                "example_id": "0c1b505c-3e8d-4ed5-a034-705160008e78",
                                                "sense_id": "7ce616d2-14aa-3bce-bafc-26727e936acc",
                                                "text": "Geofysicus Gerhard Diephuis, inmiddels niet meer werkzaam bij de NAM, ontwikkelde destijds samen met het KNMI en het Shell laboratorium in Rijswijk het netwerk van boorgat-seismometers. Daarmee zijn bevingen te registreren van een veel kleinere magnitude dan met oppervlakte instrumenten mogelijk was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c6b3c4e-13e9-403f-94e6-95acc9e21b51",
                        "source_entry_id": "250508cb-8652-3a8e-a1e8-6d75c6f69d6c",
                        "source_sense_id": "02139182-4343-34df-8a73-f4128b57499b",
