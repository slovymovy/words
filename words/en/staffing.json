{
    "word_family": [
        "staff"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf98b3a2-2d92-3248-af96-2c15fea2b75f",
                    "sense_definition": "The process of hiring and managing employees for an organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "human_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is currently reviewing its <w>staffing</w> policies to improve retention.",
                            "target_lang_translations": {
                                "ru": "Компания в настоящее время пересматривает свою политику <w>подбора персонала</w> для улучшения удержания сотрудников.",
                                "zh": "公司目前正在审查其<w>人员配备</w>政策，以提高员工留任率。"
                            }
                        },
                        {
                            "text": "Effective <w>staffing</w> is essential for maintaining high productivity in the office.",
                            "target_lang_translations": {
                                "ru": "Эффективное <w>кадровое обеспечение</w> необходимо для поддержания высокой производительности в офисе.",
                                "zh": "有效的<w>人员配备</w>对于保持办公室的高生产力至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recruitment",
                        "hiring"
                    ],
                    "common_phrases": [
                        "staffing levels",
                        "staffing agency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс найма и управления сотрудниками организации.",
                        "zh": "为组织招聘和管理员工的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбор персонала",
                                "target_lang_sense_clarification": "процесс поиска и найма сотрудников"
                            },
                            {
                                "target_lang_word": "кадровое обеспечение",
                                "target_lang_sense_clarification": "организация процесса укомплектования штата"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人员配备",
                                "target_lang_sense_clarification": "指组织内人力资源的配置与管理"
                            },
                            {
                                "target_lang_word": "招聘与配置",
                                "target_lang_sense_clarification": "指寻找并安排员工入职的流程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d7edeef-e29a-36dd-804f-996efb979041",
                    "sense_definition": "The group of employees assigned to work on a specific project or task.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "human_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project requires additional <w>staffing</w> to meet the upcoming deadline.",
                            "target_lang_translations": {
                                "ru": "Для соблюдения предстоящего срока выполнения проекта требуется дополнительный <w>персонал</w>.",
                                "zh": "该项目需要额外增加<w>人力</w>以赶上即将到来的截止日期。"
                            }
                        },
                        {
                            "text": "We need to increase the <w>staffing</w> for the night shift to handle the extra work.",
                            "target_lang_translations": {
                                "ru": "Нам нужно увеличить <w>укомплектованность штата</w> в ночную смену, чтобы справиться с дополнительной работой.",
                                "zh": "我们需要增加夜班的<w>员工</w>以处理额外的工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "personnel",
                        "workforce"
                    ],
                    "common_phrases": [
                        "adequate staffing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа сотрудников, назначенных для работы над конкретным проектом или задачей.",
                        "zh": "被指派从事特定项目或任务的员工群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укомплектованность штата",
                                "target_lang_sense_clarification": "наличие необходимого количества сотрудников"
                            },
                            {
                                "target_lang_word": "персонал",
                                "target_lang_sense_clarification": "общая совокупность работников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "员工",
                                "target_lang_sense_clarification": "指在特定岗位工作的具体人员"
                            },
                            {
                                "target_lang_word": "人力",
                                "target_lang_sense_clarification": "指可用于完成任务的劳动力资源"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4af68fb-85ad-30ba-8228-703c003c0acf",
                    "sense_definition": "Present participle and gerund of <w>staff</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "human_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>staffing</w> the new clinic with experienced nurses.",
                            "target_lang_translations": {
                                "ru": "Они <w>укомплектовывают</w> новую клинику опытными медсестрами.",
                                "zh": "他们正在为新诊所<w>配备</w>经验丰富的护士。"
                            }
                        },
                        {
                            "text": "The manager is busy <w>staffing</w> the help desk for the holiday season.",
                            "target_lang_translations": {
                                "ru": "Менеджер занят <w>обеспечением кадрами</w> службы поддержки на праздничный период.",
                                "zh": "经理正忙于为假期期间的服务台<w>配备人员</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «укомплектовывать штат».",
                        "zh": "动词 staff 的现在分词和动名词形式，意为为某处配备人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укомплектование",
                                "target_lang_sense_clarification": "процесс заполнения вакантных должностей"
                            },
                            {
                                "target_lang_word": "обеспечение кадрами",
                                "target_lang_sense_clarification": "назначение сотрудников на рабочие места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配备人员",
                                "target_lang_sense_clarification": "指为机构或部门安排工作人员"
                            },
                            {
                                "target_lang_word": "充实人员",
                                "target_lang_sense_clarification": "指增加或补充工作岗位上的员工"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}