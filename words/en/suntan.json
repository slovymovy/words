                    "sense_id": "799e566c-0d76-364f-9b7e-6f6d613176df",
                    "sense_definition": "A browning or darkening of the skin resulting from exposure to the sun or ultraviolet light.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "suntan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She developed a golden <w>suntan</w> after spending two weeks on the beach.",
                            "target_lang_translations": {
                                "nl": "Ze kreeg een <w>goudbruine kleur</w> na twee weken op het strand te hebben doorgebracht."
                            }
                        },
                        {
                            "text": "He always applied sunscreen to avoid burns while trying to get a <w>suntan</w>.",
                            "target_lang_translations": {
                                "nl": "Hij smeerde altijd zonnebrandcrème om verbranding te voorkomen terwijl hij probeerde <w>bruin te worden</w>."
                            }
