                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9376e46-7f19-40af-9d99-728de73e8d87",
                                "sense_id": "7b1b1813-2aa5-341c-9a17-df31688d6208",
                                "text": "„Und er setzt sich auf das rote Plüschsofa.“"
                            },
                            {
                                "example_id": "99f4c0cb-02a0-487b-b1de-55ccc3f1920f",
                                "sense_id": "7b1b1813-2aa5-341c-9a17-df31688d6208",
                                "text": "„Wir ließen uns in die Plüschsofas sinken, stellten unsere Ellenbogen auf den Tisch und schlürften lautstark heiße Bouille.“"
                            },
                            {
                                "example_id": "f7043d9e-ad4b-4312-8302-0407d2fab00f",
                                "sense_id": "7b1b1813-2aa5-341c-9a17-df31688d6208",
                                "text": "„Mit uns im Kellerraum der Kirche Trinity Episcopal mit seinen Plüschsofas aus dem Wohlfahrtsladen befinden sich vielleicht zwanzig Männer und nur eine Frau, die alle paarweise aneinanderhängen, und die meisten weinen.“"
                            }
                        ],
