                        ],
                        "form": "schrikje"
                    },
                    {
                        "form_id": "fa7e2d0f-04ba-421b-b361-1e9d85595574",
                        "entry_id": "7d384732-5bef-303e-8de9-eaa1d91221b6",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "schrikjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b45afd0d-d7f4-37c7-9179-6545e92f8d29",
                        "entry_id": "7d384732-5bef-303e-8de9-eaa1d91221b6",
                        "glosses": [
                            "hevige plotselinge angst, bijvoorbeeld als gevolg van een onverwachte verandering of gevaarlijke situatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c439a73-0eaf-4f8c-aae8-b0121d7baa16",
                                "sense_id": "b45afd0d-d7f4-37c7-9179-6545e92f8d29",
                                "text": "Zo kwam ik een keer na een lange dag aan bij een op de kaart gemarkeerde waterbron om tot mijn schrik te ontdekken dat hij helemaal was opgedroogd."
                            },
                            {
                                "example_id": "cda7100c-3a88-4388-8381-9c59de69e2ac",
                                "sense_id": "b45afd0d-d7f4-37c7-9179-6545e92f8d29",
                                "text": "Zijn ogen waren wijd open van schrik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2a5375b-3d6e-4914-9723-144608ef4ce7",
                        "source_entry_id": "7d384732-5bef-303e-8de9-eaa1d91221b6",
                        "source_sense_id": "b45afd0d-d7f4-37c7-9179-6545e92f8d29",
                        "source_sense_description": "het ervaren van een gevoel van angst, bijvoorbeeld als gevolg van een plotselinge verandering of gevaarlijke situatie",
                        "target_lang_word": "fright",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa1c803c-f91c-3789-b93f-6535abeed209",
                                        "entry_id": "a84ca046-772d-38a0-a762-c37ece529ce9",
                                        "glosses": [
                                            "A state of terror excited by the sudden appearance of danger; sudden and violent fear, usually of short duration; a sudden alarm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef16aa35-6044-4572-a7aa-b062635474be",
                                                "sense_id": "fa1c803c-f91c-3789-b93f-6535abeed209",
                                                "text": "With a bolt of fright he remembered that there was no bathroom in the Hobhouse Room. He leapt along the corridor in a panic, stopping by the long-case clock at the end where he flattened himself against the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73fb4912-def0-387b-adde-d059d2522868",
                                        "entry_id": "a84ca046-772d-38a0-a762-c37ece529ce9",
                                        "glosses": [
                                            "Someone strange, ugly or shocking, producing a feeling of alarm or aversion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c334c7c-289b-4277-979a-4343acc8282c",
                                                "sense_id": "73fb4912-def0-387b-adde-d059d2522868",
                                                "text": "Her maids were old, and if she took a new one,\nYou might be sure she was a perfect fright;\nShe did this during even her husband's life\nI recommend as much to every wife."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                        "entry_id": "423868ba-6df9-395b-922d-2f4fdb35d3c5",
                                        "glosses": [
                                            "To frighten."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a051dd69-5112-4f27-9cd4-c80da5a0d716",
                                                "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                                "text": "Are not you he […] That frights the maidens of the villagery […] ?"
                                            },
                                            {
                                                "example_id": "afad723d-68bf-4d70-a753-af5695c7594f",
                                                "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                                "text": "Little Miss Muffet, She sat on a tuffet, Eating of curds and whey; There came a little spider, Who sat down beside her, And frighted Miss Muffet away."
                                            },
                                            {
                                                "example_id": "42bda33e-0960-4bf0-865d-65f2fdcc04bd",
                                                "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                                "text": "A very fine situation was proposed to him, where he might have a noble view of the ocean; but he started back, with an attitude of terror Betterton might envy, when Hamlet meets his father's ghost, and cried out,—\"Oh, Christ! the sea looks so fierce that it frights me!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                        "entry_id": "321144ad-81a9-3ff7-9612-0f002b6e1ee7",
                                        "glosses": [
                                            "frightened; afraid; affright"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa86401-9323-4005-adb5-86f25c33efc8",
                                                "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                                "text": "Don't be fright, it is not so impossible as it seems."
                                            },
                                            {
                                                "example_id": "44900002-994b-4527-b983-ad32e211ac92",
                                                "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                                "text": "Don't be fright, I'm not going to hurt you."
                                            },
                                            {
                                                "example_id": "a323c9f3-64f8-44fb-a8cc-4d0be5668269",
                                                "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                                "text": "He had a great heavy jaw and shoulders like an ox and bore no resemblance to Maurice Leonard. 'Come along, lad,' the sergeant said. 'Come along. Don't be fright. It's what you're here for now, ain't it?'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19e72a13-f397-4f13-9527-6fde6cd2a761",
                        "source_entry_id": "7d384732-5bef-303e-8de9-eaa1d91221b6",
                        "source_sense_id": "b45afd0d-d7f4-37c7-9179-6545e92f8d29",
                        "source_sense_description": "het ervaren van een gevoel van angst, bijvoorbeeld als gevolg van een plotselinge verandering of gevaarlijke situatie",
                        "target_lang_word": "terror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Intense dread, fright, or fear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabdba5a-06db-4876-9ad2-c79a34c27a6d",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "\"How thinkest thou that I rule this people? I have but a regiment of guards to do my bidding, therefore it is not by force. It is by terror. My empire is of the imagination.\""
                                            },
                                            {
                                                "example_id": "020f42f0-0214-4fab-9570-ba2c04d09bef",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "The terrors with which I was seized […] were extreme."
                                            },
                                            {
                                                "example_id": "04080c1a-eb8b-4907-b683-0bc067a17f49",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "Fear of their cargo bred a savage cruelty into the crew. One captain, to strike terror into the rest, killed a slave and dividing heart, liver and entrails into 300 pieces made each of the slaves eat one, threatening those who refused with the same torture. Such incidents were not rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70f8dd0-2847-32dd-a3ee-ce3810211a8b",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "The action or quality of causing dread; terribleness, especially such qualities in narrative fiction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Something or someone that causes such fear."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35afdbab-ad88-419c-b67d-cb5c2315f934",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "The Begums' ministers, on the contrary, to extort from them the disclosure of the place which concealed the treasures, were, […] after being fettered and imprisoned, led out on to a scaffold, and this array of terrours proving unavailing, the meek tempered Middleton, as a dernier resort, menaced them with a confinement in the fortress of Chunargar. Thus, my lords, was a British garrison made the climax of cruelties!"
                                            },
                                            {
                                                "example_id": "dc3f0cd8-2604-489c-aa2a-d410ed687f85",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "The terrors of the storm"
                                            },
                                            {
                                                "example_id": "923288e4-79e1-4dc4-a16c-beb35aecea83",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "A chap named Eleazir Kendrick and I had chummed in together the summer afore and built a fish-weir and shanty at Setuckit Point, down Orham way. For a spell we done pretty well. Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Terrorism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73de9df-6d74-4d6e-ae2d-964f74fd4691",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "a terror attack"
                                            },
                                            {
                                                "example_id": "86bffb05-5e79-4808-b0af-e1fb163f71ef",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "the War on Terror"
                                            },
                                            {
                                                "example_id": "8b4cc247-41ab-4a15-802e-4bfcc9e51db4",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "Rank-and-file progressives don’t usually think of the immigration policies they support—expanding refugee quotas, easing restrictions on some classes of immigrants, and ending family separation—as an endorsement of detention, deportation, and racialized terror."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd089fd2-98ca-3087-b19b-71216dd6ff52",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "A night terror."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "terror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc657e79-8ced-3f1f-9757-2f7ae7bf0705",
                                        "entry_id": "7662ffa1-702a-3444-94bd-a1d9cefd81d0",
                                        "glosses": [
                                            "A strict teacher who fails most of the students."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2354b730-5a18-46ff-a943-baf3be40d4ab",
                                                "sense_id": "fc657e79-8ced-3f1f-9757-2f7ae7bf0705",
                                                "text": "I have a terror math teacher."
                                            }
                                        ]
