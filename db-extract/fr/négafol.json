                        "glosses": [
                            "Petite barque à fond plat pour la navigation, la pêche et la chasse sur étang."
                        ],
                        "tags": [
                            "Languedoc"
                        ],
                        "examples": [
                            {
                                "example_id": "e778b911-15bd-4f63-9296-28670ddf394a",
                                "sense_id": "f519d2e4-af20-3551-842a-07580becd7db",
                                "text": "Délaissant bateau et port, il acheta un négafol, petite barque instable mais passe-partout, prit un rôle sur l’étang de l’Arnel, tout proche du village, se promettant de vivre d’une nouvelle pêche et de chasse."
                            },
                            {
                                "example_id": "cc17849e-8dd9-418a-855c-fd0586a145a9",
                                "sense_id": "f519d2e4-af20-3551-842a-07580becd7db",
                                "text": "Dimanche 3 septembre [1939] - J’ai ramené le négafol à la canalette. — (François Sentein, Minutes d’un libertin (1938-1941), Éditions Gallimard, collection Le promeneur, page 46)"
                            }
                        ]
