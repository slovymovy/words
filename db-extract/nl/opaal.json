                    {
                        "translation_id": "9ad57376-48c5-4132-9a97-089dbcfa25bb",
                        "source_entry_id": "ad23d3ea-00d1-346f-86ea-03bd8c4ce6a7",
                        "source_sense_id": "b734df73-34e4-3951-b2f2-4a52688d09ea",
                        "source_sense_description": "een halfedelsteen en een amorfe variëteit van kwarts, SiO₂·nH₂O, gehydrateerd siliciumdioxide met een waterpercentage van soms wel 20%",
                        "target_lang_word": "opale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opale",
