                        "glosses": [
                            "One who adheres to the theory or method of impressionism."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "874dd950-36c4-3129-bb24-142f0e359f95",
                        "entry_id": "99e68ec1-a4c3-3ab6-a3ac-6979539dc462",
                        "glosses": [
                            "A performer who does impressions; a mimic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939c1de7-adeb-457d-94ab-0c54d6d15118",
                                "sense_id": "874dd950-36c4-3129-bb24-142f0e359f95",
                                "text": "When impressionists (and especially lazy impressionists) delivered their comedic interpretation of [Bill] Clinton, the phrase they always used was “I feel your pain,” expressed with a sympathetic Southern drawl."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
