                                    {
                                        "sense_id": "693c9dce-9198-34b2-b3f1-f4b1f31402b5",
                                        "entry_id": "660a0ed0-574b-3e03-ae72-6108104afed9",
                                        "glosses": [
                                            "A clear deep blue variety of corundum, valued as a precious stone."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33c67ed-75b7-4188-9861-518dc01d092b",
                                                "sense_id": "693c9dce-9198-34b2-b3f1-f4b1f31402b5",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bacbbe9-cf6b-323a-812d-7baec8209592",
                                        "entry_id": "660a0ed0-574b-3e03-ae72-6108104afed9",
                                        "glosses": [
                                            "A white, yellow, or purple variety of corundum, either clear or translucent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec97cdb0-770e-323d-b8c8-9197ddec53e3",
                                        "entry_id": "660a0ed0-574b-3e03-ae72-6108104afed9",
                                        "glosses": [
                                            "A deep blue colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eed5252-616d-33c5-9314-a1237e1eadf0",
                                        "entry_id": "660a0ed0-574b-3e03-ae72-6108104afed9",
                                        "glosses": [
                                            "Azure, when blazoning by precious stones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8911b905-25ca-43c0-beb3-f019ae1860e0",
                                                "sense_id": "3eed5252-616d-33c5-9314-a1237e1eadf0",
                                                "text": "Elgin. Topaz a Saltier and Chief Ruby, on a Canton Pearl a Lyon Rampant Saphyr, which last is their paternal Coat; […]"
                                            },
                                            {
                                                "example_id": "a9250897-2de9-4c85-8572-a1b3927f1c1e",
                                                "sense_id": "3eed5252-616d-33c5-9314-a1237e1eadf0",
                                                "text": "3. Saphire, ten Bezants, 4, 3, 2, 1, by the Bisset."
                                            },
                                            {
                                                "example_id": "0d628aa9-9630-4428-81df-a9ddbde033a0",
                                                "sense_id": "3eed5252-616d-33c5-9314-a1237e1eadf0",
                                                "text": "(2) Topaz, a Chief Indented, Saphire."
                                            },
                                            {
                                                "example_id": "7af8a8e0-19bf-4fc0-967f-2195ecadfa3f",
                                                "sense_id": "3eed5252-616d-33c5-9314-a1237e1eadf0",
                                                "text": "Topaz, on a Cross, Sapphire, a Crosier thrust through a Mitre, Topaz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8411c342-8d93-386c-a582-d8c9fd40ceb3",
                                        "entry_id": "660a0ed0-574b-3e03-ae72-6108104afed9",
                                        "glosses": [
                                            "Any hummingbird in the genera Hylocharis and Chlorestes, as well as the rufous-throated sapphire, which is now in the genus Amazilia."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
