                        "glosses": [
                            "Se sucer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "864428a0-93c2-43f7-95f9-1b12cab582fd",
                                "sense_id": "20848e81-dcda-353a-9752-50caf2c6848d",
                                "text": "J’aime un gars qui arrive à s’autosucer sur son canapé."
                            },
                            {
                                "example_id": "58a5dd91-953a-4a9c-823d-64525b14db90",
                                "sense_id": "20848e81-dcda-353a-9752-50caf2c6848d",
                                "text": "Des civilisations orientales (200 av. J.-C), qui considéraient cette pratique comme le pouvoir suprême, aux sites et forums de self-suckers, sur le Net aujourd’hui, en passant par les «ouroboros», d’étranges statues représentant des reptiles s’autosuçant qui ornaient les armes des barbares comme Attila, l’exploit sexuel de l’homme a toujours fasciné."
                            }
                        ]
                    }
