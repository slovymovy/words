        "fr-extract.jsonl": [
            {
                "entry_id": "e42d3aae-1470-3ea7-826f-91c25d057acc",
                "word": "trépidation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ebfae1b0-439c-49c9-8044-4fd834fb2bb2",
                        "entry_id": "e42d3aae-1470-3ea7-826f-91c25d057acc",
                        "tags": [
                            "plural"
                        ],
                        "form": "trépidations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12019108-e3f8-32bd-9a2e-2c21a63e7d3d",
                        "entry_id": "e42d3aae-1470-3ea7-826f-91c25d057acc",
                        "glosses": [
                            "Tremblement."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "ed878efd-d609-4633-8f2c-d2f2869de617",
                                "sense_id": "12019108-e3f8-32bd-9a2e-2c21a63e7d3d",
                                "text": "On obtient l'intensité d'aimantation correspondant à cette courbe en donnant des trépidations mécaniques à un fil de fer tout en le plaçant dans le champ magnétique ( ou bien encore en lui donnant des trépidations électriques, d'après MM. Gerosa et Finzi, en le faisant parcourir par un courant alternatif)."
                            },
                            {
                                "example_id": "ab3670d1-c6f5-44f0-a755-f62a18bdc3cc",
                                "sense_id": "12019108-e3f8-32bd-9a2e-2c21a63e7d3d",
                                "text": "Je tombai cependant dans cette sorte de somnolence que provoquent les trépidations régulières d’un train en marche."
                            },
                            {
                                "example_id": "fb31004d-6d42-424c-8449-da50be13d83f",
                                "sense_id": "12019108-e3f8-32bd-9a2e-2c21a63e7d3d",
                                "text": "Le mouvement du ballon, son trajet sinueux, ses plongeons et ses remontées, étaient nettement perceptibles, et l’incessante trépidation des moteurs semblait se ralentir et s’accélérer tour à tour."
                            },
                            {
                                "example_id": "830d8543-1ab6-4130-a274-d1873802cce2",
                                "sense_id": "12019108-e3f8-32bd-9a2e-2c21a63e7d3d",
                                "text": "Il y a bien un peu d’agitation et je dirais même de trépidation dans les derniers écrits de notre grand Michelet."
                            },
                            {
                                "example_id": "f74c66d1-8262-4380-bf52-b7c0f7873bf1",
                                "sense_id": "12019108-e3f8-32bd-9a2e-2c21a63e7d3d",
                                "text": "Quand je sens en chemin\nLes trépidations de ma machine,\nIl me monte des désirs\nDans le creux de mes reins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88f31d9d-a612-46d7-84f1-e568ef872643",
                        "source_entry_id": "e42d3aae-1470-3ea7-826f-91c25d057acc",
                        "source_sense_id": "12019108-e3f8-32bd-9a2e-2c21a63e7d3d",
                        "target_lang_word": "trepidation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trepidation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                        "entry_id": "0f5119e6-1d9d-3724-a968-60e3404edd83",
                                        "glosses": [
                                            "Anxiety over the uncertain future or possible ill-occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c61a125a-9aba-4a5f-abc3-e239511d3845",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "I decided, with considerable trepidation, to let him drive my car without me."
                                            },
                                            {
                                                "example_id": "23111661-513d-4af0-8d41-3e8614005b1a",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "She reached it soon after half-past two. She found its gloomy nineteenth-century façade, black with the smuts of ninety years, a little daunting, and mounted its broad steps in some trepidation. But she rang the bell hard and knocked firmly."
                                            },
                                            {
                                                "example_id": "2348ea3e-1ff2-414b-828a-f871717dde5d",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "She opened the drawing-room door in trepidation. Would she find Esther drowned with her head in the goldfish bowl, or hanged from the chandelier by her stay-lace?"
                                            },
                                            {
                                                "example_id": "20eec917-a177-4f74-87d1-e6447ee47f1a",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "When I went, I left from the station / With a haversack and some trepidation"
                                            },
                                            {
                                                "example_id": "5aaf609a-670b-4a67-a127-647615dcd332",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "The Midlanders will hope the victory will kickstart a campaign that looked to have hit the buffers, but the sense of trepidation enveloping the Reebok Stadium heading into the new year underlines the seriousness of the predicament facing Owen Coyle's men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45c2a08-282c-3dda-abe1-918bddb6744e",
                                        "entry_id": "0f5119e6-1d9d-3724-a968-60e3404edd83",
                                        "glosses": [
                                            "An involuntary trembling, sometimes an effect of paralysis, but usually caused by terror or fear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53898500-de1b-3878-a2bc-74620731c582",
                                        "entry_id": "0f5119e6-1d9d-3724-a968-60e3404edd83",
                                        "glosses": [
                                            "A libration of the starry sphere in the Ptolemaic system; a motion ascribed to the firmament, to account for certain small changes in the position of the ecliptic and of the stars."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
