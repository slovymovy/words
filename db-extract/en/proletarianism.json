                        "glosses": [
                            "A proletarian word or turn of phrase; a vulgarism."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "eaeca903-d85f-4bc2-805c-87d2017e0572",
                                "sense_id": "a9825ebe-13df-3189-9723-53a63ef9a483",
                                "text": "The scatological proletarianisms of Don Jonz reflect poorly on your heretofore high level of editorial standards."
                            },
                            {
                                "example_id": "7699a863-de25-4700-9cbc-1c89b68ec576",
                                "sense_id": "a9825ebe-13df-3189-9723-53a63ef9a483",
                                "text": "There is a fine dividing line between the everyday sensationalism of popular and tabloid journalism and the parodies in such publications as the British satirical magazine Private Eye, which uses proletarianisms in such headlines as The Royals, dontcha lovem!"
                            },
                            {
                                "example_id": "65c65fcc-84bd-4132-9728-5b4d67c005fe",
                                "sense_id": "a9825ebe-13df-3189-9723-53a63ef9a483",
                                "text": "Sadly, even the ‘genteel’ proletarianisms of Polly and his class are nowadays only normally heard among citizens over the age of fifty. In a few years that richly nuanced dialect will be as dead as Sanskrit."
                            }
                        ]
                    },
