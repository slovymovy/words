                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5050b773-a678-4925-826a-71f73c98add1",
                                                "sense_id": "2ad53de6-b9ae-3bda-9bcf-fe2cdd7ad5cd",
                                                "text": "Japonia stoi na czele państw na świecie pod względem długowieczności swoich mieszkańców: aż 87,2 lat dla kobiet i 81 dla mężczyzn."
                                            },
                                            {
                                                "example_id": "23245a34-8fc3-4261-a461-36344315e860",
                                                "sense_id": "2ad53de6-b9ae-3bda-9bcf-fe2cdd7ad5cd",
                                                "text": "– Budyń jest na długowieczność. Z tym że waniliowy – szeptały kobiety, usiłując wytłumaczyć w ten sposób upodobania doktora do mlecznych deserów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "fcbc17ea-bf6f-3009-b143-a81b0e14e15e",
                                        "entry_id": "8443c16e-b1ff-3b5d-aa13-bae0883f7cd1",
                                        "glosses": [
                                            "długie trwanie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5541ef-720d-4e34-ae82-75a70a14a5da",
                                                "sense_id": "fcbc17ea-bf6f-3009-b143-a81b0e14e15e",
                                                "text": "Rad bowiem należy do grupy pierwiastków ziem alkalicznych o wybitnie określonych własnościach, a jakkolwiek ilość jego w rudach uranu jest nader mała (najwyżej około 500 mgr. na tonnę), to jednak przy względnej długowieczności radu (okres półtrwania wynosi 1600 lat) ilość ta jest wystarczająca, aby można było wyodrębnić czyste sole radu, określić jego ciężar atomowy (226, 0), a nawet otrzymać Ra w stanie metalu"
                                            }
                                        ],
