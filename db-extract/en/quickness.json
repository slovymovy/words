                "senses": [
                    {
                        "sense_id": "d76586ce-d49a-3ade-81c7-d043a62d4e77",
                        "entry_id": "d1ca2584-33e5-33b4-9726-e791d8b4eb11",
                        "glosses": [
                            "rapidity of movement or activity; agility or dexterity"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3848c386-8598-4d2a-a0ce-6e111a31e9c3",
                                "sense_id": "d76586ce-d49a-3ade-81c7-d043a62d4e77",
                                "text": "The quickness of the hand deceives the eye."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72706608-e9cd-430b-b3e4-a617cfa60c58",
                        "source_entry_id": "d1ca2584-33e5-33b4-9726-e791d8b4eb11",
                        "source_sense_id": "d76586ce-d49a-3ade-81c7-d043a62d4e77",
                        "source_sense_description": "rapidity of movement or activity",
                        "target_lang_word": "rapidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "814cfd9d-77c4-3d1d-a2de-4b3634f83fde",
                                        "entry_id": "404dd516-92c2-3ef4-8037-51c56906ccef",
                                        "glosses": [
                                            "Célérité, grande vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5989b0ef-69df-41f0-80bf-f54eb232283e",
                                                "sense_id": "814cfd9d-77c4-3d1d-a2de-4b3634f83fde",
                                                "text": "A de grandes altitudes planaient les frégates et les phaétons, qui tombaient souvent avec une rapidité vertigineuse pour arracher en l'air leur proie aux oiseaux de mer plongeurs."
                                            },
                                            {
                                                "example_id": "fdf07a5d-24af-4992-8bdf-913bf248a777",
                                                "sense_id": "814cfd9d-77c4-3d1d-a2de-4b3634f83fde",
                                                "text": "Jamais la droite ne se mouvait sans que l’œil droit examinât les circonstances extérieures avec cette rapidité placide particulière au voleur et à l’espion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                        "entry_id": "404dd516-92c2-3ef4-8037-51c56906ccef",
                                        "glosses": [
                                            "Il s’emploie aussi figurément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb69131f-887b-4fd5-b02c-80c3376ab221",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "Cependant, au cours de nos travaux, l'espace libre se rétrécit, comme la peau de chagrin de Balzac, avec une déconcertante rapidité."
                                            },
                                            {
                                                "example_id": "2056ce09-0743-4c9f-94f2-12393a6f62dd",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de ses conquêtes a déconcerté l’ennemi."
                                            },
                                            {
                                                "example_id": "c994944e-39f0-45dd-b790-5a6c306061f8",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de ses progrès me confond."
                                            },
                                            {
                                                "example_id": "b577c200-8550-4167-bb9f-f34de75216ca",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de la pensée."
                                            },
                                            {
                                                "example_id": "5c3bb079-ac80-485c-bb97-f1ccb540e37d",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "La rapidité de l’élocution."
                                            },
                                            {
                                                "example_id": "3cfad833-6119-449d-8b8c-20a891548a67",
                                                "sense_id": "a10ea533-9c4a-3a24-9845-cc9e2d9d0d7b",
                                                "text": "J’aime la rapidité de son style."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22104c1c-bf4c-4a60-9863-5f6e6fabe965",
