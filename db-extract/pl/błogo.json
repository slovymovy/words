                                                "example_id": "16a43d74-c7f3-462f-8ed1-bace0b1e7bc7",
                                                "sense_id": "713c0b04-2f30-373c-ada6-2c500ec142f7",
                                                "text": "I walked the blissfully painful path of human love with intoxication and tears, always knowing that love's essence was elsewhere, hidden and yet addictively present."
                                            }
