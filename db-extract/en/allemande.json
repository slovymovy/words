                            {
                                "example_id": "f5410d94-d8b7-4829-8dda-0a320dd3a473",
                                "sense_id": "e68f286e-1ae6-3ee7-94ed-0f7c30858e52",
                                "text": "The gaudy splashes of lightning made it seem that some weird dance was going on, one where you threw your partner into the nearest tree instead of allemanding her, or dug your knee into his crotch instead of doing a do-si-do."
