        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "74bb127a-24ff-3510-a64e-13e833358bed",
                "word": "journo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e33e8b54-56e6-4b00-8316-6a1a5bc9b9ee",
                        "entry_id": "74bb127a-24ff-3510-a64e-13e833358bed",
                        "tags": [
                            "plural"
                        ],
                        "form": "journos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                        "entry_id": "74bb127a-24ff-3510-a64e-13e833358bed",
                        "glosses": [
                            "A journalist."
                        ],
                        "tags": [
                            "Australia",
                            "UK",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "6bcc9450-e92c-4947-aee9-79a1d2d2b3c8",
                                "sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                                "text": "He′d been packed in with all the other journos, standing out only in that he was taller than most and didn′t make as much noise."
                            },
                            {
                                "example_id": "341e1982-ac5f-4d93-baf9-eabbc582535a",
                                "sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                                "text": "Journos and scribes are officially welcomed by the Taliban and then never given visas to enter. The Red Cross needs Talib approval for all journos before you can book a flight."
                            },
                            {
                                "example_id": "d50d015f-5dce-45df-9ae5-d9345f4717f1",
                                "sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                                "text": "2004, Pam Austin, Bob Austin, Getting Free Publicity: The Secrets of Successful Press Relations, How To Books, Oxford, page 8,\nAnd we hope that all women journos will forgive us if, in these pages, we use the word ‘he’ as shorthand for ‘he/she’ when referring to members of the Fourth Estate."
                            },
                            {
                                "example_id": "196fee28-6625-4e1b-98aa-1cedba7e7971",
                                "sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                                "text": "2007, Sara Voorhees, The Lumière Affair: A Novel of Cannes, Simon & Schuster, New York, page 22,\nTV journos consider print journos to be snobs who write for other print journos (and are therefore read by a Lilliputian portion of the population). Print journos believe TV journos to be cretins who are worshipped blindly by the lowest common denominator."
                            },
                            {
                                "example_id": "f0d59d2c-459f-41c2-900f-aa939f334083",
                                "sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                                "text": "2008 August 11, Namrata Joshi, Movie Review: Mission Istaanbul, Outlook, page 80,\nHis nubile wife (Shriya Saran), also a TV journo, calls him names like “mouthpiece of terrorists”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "506027be-8a95-4c0c-9142-f5f1d727c08b",
                        "source_entry_id": "74bb127a-24ff-3510-a64e-13e833358bed",
                        "source_sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                        "source_sense_description": "a journalist",
                        "target_lang_word": "journaleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "journaleux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06bc4a0d-41ca-3a14-be55-77ca373633f3",
                                        "entry_id": "01380c96-6e3c-312e-933d-cb32812c121b",
                                        "glosses": [
                                            "Mauvais journaliste."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3f73f1-3d7e-4a75-9501-bea3af23a40b",
                                                "sense_id": "06bc4a0d-41ca-3a14-be55-77ca373633f3",
                                                "text": "La domesticité du secrétaire particulier, la prostitution du journaleux et la négritude du romancier ou du dramaturge sont les formes diverses prises par le prolétariat de la plume."
                                            },
                                            {
                                                "example_id": "e4a63884-06d2-4387-835d-d151ee0f20b5",
                                                "sense_id": "06bc4a0d-41ca-3a14-be55-77ca373633f3",
                                                "text": "Je me disais que, parmi tous ces caves de journaleux — de soiristes… comme ils disent dans la presse — il y en aurait peut-être un qui citerait mon nom parmi les personnalités présentes."
                                            },
                                            {
                                                "example_id": "6fef35c9-38ac-4057-9ad5-97f8645f3c88",
                                                "sense_id": "06bc4a0d-41ca-3a14-be55-77ca373633f3",
                                                "text": "Dans les journaux ? Y a-t-il été seulement ? C’est pas un journaliste, c’est un journaleux !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c754294d-2bcd-4985-913a-a5b77645fccb",
                        "source_entry_id": "74bb127a-24ff-3510-a64e-13e833358bed",
                        "source_sense_id": "88e74744-b798-3a19-9652-8644fee8611e",
                        "source_sense_description": "a journalist",
                        "target_lang_word": "gratte-papier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gratte-papier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                        "entry_id": "936c596b-afd9-3065-8d50-febbf2b8537b",
                                        "glosses": [
                                            "Celui, celle qui est chargé des écritures dans les études d’avoués, de notaires, etc. ; employé de bureau."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa2364e1-00e7-46b2-b987-d91eade2ac17",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Si j’étais demoiselle, moi, j’aimerais mieux un gentleman qui porte des éperons qu’un gratte-papier, c’est certain."
                                            },
                                            {
                                                "example_id": "3a222e28-648f-4cde-9f32-5371938cdf2d",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Cette réplique coupa la parole aux gratte-papiers ; l’un d’eux désigna un angle de la pièce où un vieillard rangeait des dossiers."
                                            },
                                            {
                                                "example_id": "b2ab95c7-b7ff-4e2a-85ff-f460be580181",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Gabriel plissa des yeux, étonné. Mais le doute n’était pas possible : cette façon de marcher en secouant les rotules, si peu paysanne, trahissait le seul gratte-papier du village."
                                            },
                                            {
                                                "example_id": "164b1a6b-c005-4c74-8a0c-16a32548481d",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Les gratte-papier, tapis derrière leurs comptoirs, levèrent à peine la tête et se replongèrent dans ces gros livres, tendus de toile noire, où depuis sa naissance, ses mérites et ses accidents de parcours se trouvaient dûment enregistrés et pesés. Combien de démarches futiles avait-il accomplies dans ce local, dont la liste des avoués de la Seine et le martyrologe des médecins légistes morts pour la France constituaient à peu près le seul ornement ?"
                                            },
                                            {
                                                "example_id": "0d34faf8-3655-4f61-964f-f9c89b8a7c72",
                                                "sense_id": "6a600a6f-e93e-330e-9ff2-62d6108a5c98",
                                                "text": "Et impossible de trouver un emploi de dactylographe. On me disait : « À Paris, on aime les gratte-papier en jupons. Et même les chieuses d'encre et les pisseuses de copie. Allez donc y voir ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ace05bf9-7fa2-33ae-a3a9-c69c4fb07c0f",
                                        "entry_id": "936c596b-afd9-3065-8d50-febbf2b8537b",
                                        "glosses": [
                                            "Personne (auteur, journaliste …) écrivant sans talent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cfb6f5e-a8af-4408-815b-d0af7648f59a",
                                                "sense_id": "ace05bf9-7fa2-33ae-a3a9-c69c4fb07c0f",
                                                "text": "Cyprien, lisant le journal à voix haute : « Si l’on nous demande un remède ... nous ne nous chargeons pas de l’indiquer. » (Parlé) Eh bien, alors... tais ton bec, méchant gratte-papier !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
