                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f80cdc88-4960-4c4a-9c21-3a0dd71e78a3",
                                                "sense_id": "12413568-27e5-3c1c-95c6-e86db590c4ab",
                                                "text": "„Der Völkerapostel hatte schon die hebräische Bibel allegorisch, symbolisch interpretiert und dem ‚Geist‘ den Vorrang vor dem ‚Buchstaben‘ gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
