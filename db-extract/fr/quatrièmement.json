                    },
                    {
                        "translation_id": "87470e09-e93e-45c6-839f-07174ff4da5e",
                        "source_entry_id": "d2943071-dfd3-39ad-b1f4-f21acbf8a30e",
                        "source_sense_id": "4ae0fbe2-f5b3-3686-9aa6-09387b1843c3",
