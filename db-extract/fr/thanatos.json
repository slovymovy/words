                        "glosses": [
                            "Pulsion de mort par lesquelles les êtres visent à se soustraire aux tensions et à faire retour à l’état organique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93dd273a-ece7-458a-9c51-c2cc49ecf8e9",
                                "sense_id": "a64d885d-0f78-3a88-b884-5a09cb568f59",
                                "text": "Freud a montré […] comment les pulsions de vie (Éros) et les pulsions de mort (Thanatos) peuvent fonctionner de façon autonome ou, au contraire, converger vers un même objet et se mélanger intimement dans des proportions variables."
                            }
                        ]
                    }
