                                        "sense_id": "64a73b8a-3619-323e-a8dd-d5b02eb1e6d9",
                                        "entry_id": "138480d0-e7f7-3e39-b324-bdc551fb1f0b",
                                        "glosses": [
                                            "One who or that is not wanted; an undesirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d70350-59e1-4a0a-a421-4a0976256236",
                                                "sense_id": "64a73b8a-3619-323e-a8dd-d5b02eb1e6d9",
                                                "text": "What slaves they had bought to carry the goods of the interior back to the coast were the unwanteds of the villages — the persons convicted of crime who would normally have been killed or banished from their communities […]"
                                            },
                                            {
                                                "example_id": "4f823fb2-999f-4b43-9528-1fb07d1ff358",
                                                "sense_id": "64a73b8a-3619-323e-a8dd-d5b02eb1e6d9",
                                                "text": "There were no thoughts of hydrogen bombs or CBW or contraceptives or removing unwanteds. It was the old America, the old order restored, and the President saw that it was Good."
                                            }
                                        ]
                                    }
                                ]
