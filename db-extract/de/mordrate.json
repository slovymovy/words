                            {
                                "example_id": "650737cc-bd97-400a-a186-f10429144357",
                                "sense_id": "f1ef64a2-6736-3a73-bfdc-07aa543d585a",
                                "text": "„Mit durchschnittlich einem Mord im Jahr hat Island die drittkleinste Mordrate der Welt.“"
                            },
                            {
                                "example_id": "ec4f1b4f-8fe2-43ac-a0cf-8ffeb00e1ba3",
                                "sense_id": "f1ef64a2-6736-3a73-bfdc-07aa543d585a",
                                "text": "„Fragt man beispielsweise einen Bundesbürger, wie viele Morde seiner Meinung nach pro Jahr in Deutschland verübt werden und ob die Mordrate zu- oder abnehmend sei, so liegt die Antwort meist bei weit über tausend Opfern, Tendenz steigend.“"
                            }
                        ],
