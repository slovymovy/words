                        "glosses": [
                            "A member of subgroup of the Kalenjin ethnic group of East Africa, traditionally living in the highland areas of the Nandi Hills in the former Rift Valley Province of Kenya."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24801e73-f2d0-464d-9bb0-a298382e3cd9",
                                "sense_id": "b179d80a-7d23-37d4-9ebe-0fc0b5080ef4",
                                "text": "A Nandi who is starting on a journey will tie a knot in grass by the wayside, as he believes that by so doing he will prevent the people whom he is going to visit from taking their meal till he arrives, or at all events he will ensure that they leave enough food over for him."
                            }
                        ]
