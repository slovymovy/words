                            {
                                "target_lang_word": "Аменд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Amend",
                                "target_lang_sense_clarification": "soyadı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿门德",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
