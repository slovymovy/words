                "senses": [
                    {
                        "sense_id": "98a454bf-8848-3ef2-b63b-3ac871d0d450",
                        "entry_id": "220b0665-9772-3724-b2d0-c46c867014e9",
                        "glosses": [
                            "koorts ontstaan door een wondinfectie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c4f4b8-f05d-45b6-a571-5a7f7a6ba7c2",
                                "sense_id": "98a454bf-8848-3ef2-b63b-3ac871d0d450",
                                "text": "De kijker wordt de serie binnengeleid door een man met een stoere tattoo die arts blijkt te zijn, en die het been van iemand met wondkoorts kan afzetten."
                            },
                            {
                                "example_id": "71c3028d-237b-4770-99ce-f141020a7e4f",
                                "sense_id": "98a454bf-8848-3ef2-b63b-3ac871d0d450",
                                "text": "Het was een strijd tussen oude stijl en en nieuwe stijl. Lully, de hofcomponist van Lodewijk XIV, was immers al 65 jaar dood. Hij stierf aan wondkoorts nadat hij met zijn dirigeerstok op zijn voet had gestampt. De gevierde Rameau was nog volop in leven, hij zou pas twaalf jaar later overlijden."
                            },
                            {
                                "example_id": "bdf99e72-5f2a-4073-a3e8-f149d7ad40e2",
                                "sense_id": "98a454bf-8848-3ef2-b63b-3ac871d0d450",
                                "text": "Deel 3 begint met ziekte van Hizkia. Hij treft zijn vrouw Chefsiba aan bij een zelfgemaakt Astarte-altaar en veroorzaakt in zijn woede daarover brand. Hierbij raakt Hizkia zo gewond dat hij door wondkoorts stervende raakt. De profeet Jesaja komt hem -na een aanvankelijk doodsbericht- vertellen dat hij nog vijftien levensjaren krijgt."
                            }
                        ]
                    }
