                            {
                                "example_id": "52609b0a-08a0-4a3d-8794-159f0a89efae",
                                "sense_id": "6ec5a0cb-3b1d-3c5d-914d-e1c9cb3d4be4",
                                "text": "Der Anschlag wird Al-Qaida zugeordnet."
                            },
                            {
                                "example_id": "d529a5ab-7c48-4ea6-84ae-deb933e91b33",
                                "sense_id": "6ec5a0cb-3b1d-3c5d-914d-e1c9cb3d4be4",
                                "text": "„Die Defensive, in die Al-Qaida durch die amerikanische Militärintervention in Afghanistan und im Irak gedrängt wurde, ist nicht von Dauer, die tödliche Herausforderung des Westens bleibt bestehen, so lautet Brisards gründlich dokumentiertes Fazit.“"
                            },
                            {
                                "example_id": "d4f8fb5f-95e0-40e7-90d2-d49b484dfbf5",
                                "sense_id": "6ec5a0cb-3b1d-3c5d-914d-e1c9cb3d4be4",
                                "text": "„Die Al-Qaida zählt mit einem Jahresumsatz von 150 Millionen Dollar zu den Top-Terrororganisationen der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
