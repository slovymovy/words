{
    "word_family": [
        "convert",
        "conversion",
        "convertible",
        "reconvert"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d073565a-2d23-395f-9104-387becabfb64",
                    "sense_definition": "A software program or tool that changes a file from one format to another or calculates values between different units.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conversion_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used an online <w>converter</w> to change my document into a PDF file.",
                            "target_lang_translations": {
                                "ru": "Я использовал онлайн-<w>конвертер</w>, чтобы преобразовать документ в PDF-файл."
                            }
                        },
                        {
                            "text": "This currency <w>converter</w> helps travelers calculate how much money they are spending abroad.",
                            "target_lang_translations": {
                                "ru": "Этот <w>конвертер</w> валют помогает путешественникам рассчитать, сколько денег они тратят за границей."
                            }
                        }
                    ],
                    "synonyms": [
                        "transformer"
                    ],
                    "common_phrases": [
                        "currency converter",
                        "file converter",
                        "unit converter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Программное обеспечение или инструмент для изменения формата файлов или пересчета величин из одних единиц измерения в другие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конвертер",
                                "target_lang_sense_clarification": "программа или онлайн-сервис"
                            },
                            {
                                "target_lang_word": "преобразователь",
                                "target_lang_sense_clarification": "инструмент для пересчета величин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fe8c36b-3bfa-3f25-8464-a8163c8ca943",
                    "sense_definition": "An electrical device that changes the voltage, frequency, or type of current (such as AC to DC).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conversion_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will need a power <w>converter</w> if you plan to use your hair dryer in Europe.",
                            "target_lang_translations": {
                                "ru": "Вам понадобится <w>преобразователь</w> напряжения, если вы планируете пользоваться феном в Европе."
                            }
                        },
                        {
                            "text": "The technician installed a new voltage <w>converter</w> to protect the sensitive laboratory equipment.",
                            "target_lang_translations": {
                                "ru": "Техник установил новый <w>преобразователь</w> напряжения для защиты чувствительного лабораторного оборудования."
                            }
                        }
                    ],
                    "synonyms": [
                        "adapter",
                        "transformer"
                    ],
                    "common_phrases": [
                        "power converter",
                        "voltage converter",
                        "catalytic converter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическое устройство, изменяющее напряжение, частоту или тип тока (например, из переменного в постоянный)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преобразователь",
                                "target_lang_sense_clarification": "электрического тока или напряжения"
                            },
                            {
                                "target_lang_word": "конвертер",
                                "target_lang_sense_clarification": "силовое устройство"
                            },
                            {
                                "target_lang_word": "адаптер",
                                "target_lang_sense_clarification": "переходник для электросети"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e09102e-6b9f-322c-a20e-0fd74df7aeaf",
                    "sense_definition": "An electronic device that transforms an analogue signal into a digital signal, or the other way around.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conversion_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The digital-to-analogue <w>converter</w> significantly improved the sound quality of the home audio system.",
                            "target_lang_translations": {
                                "ru": "Цифро-аналоговый <w>преобразователь</w> значительно улучшил качество звука домашней аудиосистемы."
                            }
                        },
                        {
                            "text": "Old television sets require a digital <w>converter</w> box to receive modern broadcast signals.",
                            "target_lang_translations": {
                                "ru": "Старым телевизорам требуется цифровая приставка-<w>конвертер</w> для приема современных сигналов вещания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital converter",
                        "signal converter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное устройство, преобразующее аналоговый сигнал в цифровой или наоборот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преобразователь",
                                "target_lang_sense_clarification": "сигнала"
                            },
                            {
                                "target_lang_word": "конвертер",
                                "target_lang_sense_clarification": "цифровой или аналоговый"
                            },
                            {
                                "target_lang_word": "ЦАП/АЦП",
                                "target_lang_sense_clarification": "техническая аббревиатура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa059a84-f43b-38fc-86cb-94a1ea917359",
                    "sense_definition": "A component in a vehicle's exhaust system that reduces toxic gases and pollutants.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic told me that the catalytic <w>converter</w> needs to be replaced to pass the emissions test.",
                            "target_lang_translations": {
                                "ru": "Механик сказал мне, что каталитический <w>нейтрализатор</w> нужно заменить, чтобы пройти тест на выбросы."
                            }
                        },
                        {
                            "text": "A catalytic <w>converter</w> uses precious metals to trigger a chemical reaction in exhaust fumes.",
                            "target_lang_translations": {
                                "ru": "Каталитический <w>нейтрализатор</w> использует драгоценные металлы для запуска химической реакции в выхлопных газах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "catalytic converter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компонент выхлопной системы автомобиля, снижающий содержание токсичных газов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нейтрализатор",
                                "target_lang_sense_clarification": "каталитический"
                            },
                            {
                                "target_lang_word": "катализатор",
                                "target_lang_sense_clarification": "автомобильный"
                            },
                            {
                                "target_lang_word": "конвертер",
                                "target_lang_sense_clarification": "в контексте выхлопных систем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "173a1037-5991-3372-974d-53ed225f3655",
                    "sense_definition": "A large furnace or vessel used in industrial processes, such as making steel, to change the properties of materials.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "industrial_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Molten iron is poured into the Bessemer <w>converter</w> to be transformed into high-quality steel.",
                            "target_lang_translations": {
                                "ru": "Расплавленный чугун заливают в бессемеровский <w>конвертер</w> для переработки в высококачественную сталь."
                            }
                        },
                        {
                            "text": "The factory upgraded its industrial <w>converter</w> to increase the efficiency of the chemical production line.",
                            "target_lang_translations": {
                                "ru": "Завод модернизировал свой промышленный <w>конвертер</w>, чтобы повысить эффективность химической производственной линии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Bessemer converter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая печь или сосуд, используемый в промышленности (например, в сталелитейной) для изменения свойств материалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конвертер",
                                "target_lang_sense_clarification": "металлургическая печь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "424afd4f-9432-3ced-baf7-ee1d2e98acb2",
                    "sense_definition": "A handheld device used to operate a television or other electronic equipment from a distance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remote_controls",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He asked his brother to pass the <w>converter</w> so he could change the channel.",
                            "target_lang_translations": {
                                "ru": "Он попросил брата передать <w>пульт</w>, чтобы переключить канал."
                            }
                        },
                        {
                            "text": "In some parts of the country, people still refer to the remote as a <w>converter</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых частях страны люди до сих пор называют пульт <w>переключателем</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "remote control",
                        "clicker"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American dialect"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "referring to older cable boxes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Портативное устройство для дистанционного управления телевизором или другой электроникой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пульт",
                                "target_lang_sense_clarification": "дистанционного управления"
                            },
                            {
                                "target_lang_word": "переключатель",
                                "target_lang_sense_clarification": "каналов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}