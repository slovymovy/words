{
    "word_family": [
        "deposito",
        "depositie",
        "deponent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33b65bfb-2a90-3ab3-bc5a-d84a0178b96b",
                    "sense_definition": "iets neerleggen, plaatsen of weggooien op een bepaalde plek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt je afval in deze grote bak <w>deponeren</w>.",
                            "target_lang_translations": {
                                "en": "You can <w>deposit</w> your waste in this large bin."
                            }
                        },
                        {
                            "text": "De reizigers <w>deponeerden</w> hun zware koffers tijdelijk in de bagagekluisjes op het station.",
                            "target_lang_translations": {
                                "en": "The travelers temporarily <w>deposited</w> their heavy suitcases in the luggage lockers at the station."
                            }
                        }
                    ],
                    "synonyms": [
                        "neerleggen",
                        "plaatsen"
                    ],
                    "common_phrases": [
                        "afval deponeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to lay down, place, or dispose of something in a specific location"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deposit",
                                "target_lang_sense_clarification": "to lay down or store something in a place"
                            },
                            {
                                "target_lang_word": "drop off",
                                "target_lang_sense_clarification": "to leave something somewhere"
                            },
                            {
                                "target_lang_word": "dump",
                                "target_lang_sense_clarification": "waste or unwanted items"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0d4f5ae-d0a0-348d-bdf3-7e4c361a2b90",
                    "sense_definition": "iets officieel vastleggen of registreren om het wettelijk te beschermen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "registreren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het jonge bedrijf wilde zijn nieuwe merknaam zo snel mogelijk officieel <w>deponeren</w>.",
                            "target_lang_translations": {
                                "en": "The young company wanted to officially <w>register</w> its new brand name as soon as possible."
                            }
                        },
                        {
                            "text": "De ontwerper <w>deponeerde</w> het patent om te voorkomen dat concurrenten haar idee zouden stelen.",
                            "target_lang_translations": {
                                "en": "The designer <w>filed</w> the patent to prevent competitors from stealing her idea."
                            }
                        }
                    ],
                    "synonyms": [
                        "registreren",
                        "vastleggen"
                    ],
                    "common_phrases": [
                        "een merknaam deponeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to officially register or file something for legal protection"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "register",
                                "target_lang_sense_clarification": "officially record a trademark or name"
                            },
                            {
                                "target_lang_word": "file",
                                "target_lang_sense_clarification": "officially submit a patent or application"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}