                    }
                ],
                "translations": [
                    {
                        "translation_id": "793f5d8a-b940-4d9c-a8a2-feac6cdd233f",
                        "source_entry_id": "89b66a2f-bfc2-3ed5-8283-de240c6c934a",
                        "target_lang_word": "apophysis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apophysis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33c6926d-8dcc-3824-a66f-a0c8a50d1b60",
                                        "entry_id": "11b47569-84eb-302f-aa7e-5232bc3511f9",
                                        "glosses": [
                                            "A natural outgrowth, swelling or enlargement, usually of an organism; a protuberance on a bone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6617a7-e903-4a4c-8131-b5f048ecaa76",
                                                "sense_id": "33c6926d-8dcc-3824-a66f-a0c8a50d1b60",
                                                "text": "Every bone in the real duck had its representative in the automaton, and its wings were anatomically exact. Every cavity, apophysis, and curvature was imitated, and each bone executed its proper movements."
                                            },
                                            {
                                                "example_id": "20ce4e44-f0d4-4e49-bfa4-a8ef914e50ec",
                                                "sense_id": "33c6926d-8dcc-3824-a66f-a0c8a50d1b60",
                                                "text": "In the male each palpal tibia shows a long narrow apophysis on the outerside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a921d2c-a663-3094-9730-6a9c835436fb",
                                        "entry_id": "11b47569-84eb-302f-aa7e-5232bc3511f9",
                                        "glosses": [
                                            "The external part of a cone scale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8bec2c9-c43d-315d-a239-9cd17c8fc526",
                                        "entry_id": "11b47569-84eb-302f-aa7e-5232bc3511f9",
                                        "glosses": [
                                            "A branch of a dike or vein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c20470e3-95a8-4c47-86da-ff72e6dced20",
                                                "sense_id": "a8bec2c9-c43d-315d-a239-9cd17c8fc526",
                                                "text": "Minor palingenetic magmas probably were generated at this time and intruded the mantling rocks in the form of small sills and apophyses; …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac5d7046-ce5c-419c-9a07-eaf35a6f588d",
                        "source_entry_id": "89b66a2f-bfc2-3ed5-8283-de240c6c934a",
                        "target_lang_word": "Apophyse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ea10a42c-adbf-4ba9-bc6f-28feec6e21ff",
                        "source_entry_id": "89b66a2f-bfc2-3ed5-8283-de240c6c934a",
                        "target_lang_word": "apophyse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apophyse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ee3deb8-a978-399d-9191-8be303475a2b",
                                        "entry_id": "4bc91dbe-711e-3e34-8756-9a7c8796d154",
                                        "glosses": [
                                            "Partie saillante d’un os."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8057cdb1-f3cb-4a61-92a5-6ec5fa9b977a",
                                                "sense_id": "9ee3deb8-a978-399d-9191-8be303475a2b",
                                                "text": "Les complications des fractures de lʼapophyse unciforme sont liées au retard diagnostique."
                                            },
                                            {
                                                "example_id": "a8ec61cf-4b34-4ffe-a310-cd97929e18ed",
                                                "sense_id": "9ee3deb8-a978-399d-9191-8be303475a2b",
                                                "text": "Dans ces expériences nous avons observé que pour luxer les apophyses il fallait fléchir très fortement le cou, et qu’aussitôt la luxation produite la flexion du cou devenait moindre ; et lorsqu’on voulait déchevaucher les apophyses pour les réduire, il fallait de nouveau fléchir le cou au maximum : ce qui confirme le précepte donné par les auteurs d’augmenter la flexion d’abord existante pour réduire, etc."
                                            },
                                            {
                                                "example_id": "d38539f1-19f1-4e3e-a075-8b1efbf419c5",
                                                "sense_id": "9ee3deb8-a978-399d-9191-8be303475a2b",
                                                "text": "En ces anatomies, aux postures vengeresses, aux monstrueuses apophyses, devinées sous le vêtement, il y avait un tel accent d’humanité, un tel lamento de volupté infernale, un emportement si tragique, que, devant elles, on se sentait secoué d’un frisson de terreur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa3abbae-4e9a-36e7-af42-7e29deaf7e69",
                                        "entry_id": "4bc91dbe-711e-3e34-8756-9a7c8796d154",
                                        "glosses": [
                                            "Épine, protubérance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
