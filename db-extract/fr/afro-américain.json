                        "form": "Afro-Américains"
                    },
                    {
                        "form_id": "b1c2e618-f4a1-4b2b-9b11-244ecc34819a",
                        "entry_id": "c3366d01-8305-3e40-b954-30e06fb6db96",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Afro-Américaine"
