                                            "To save or keep (something) to be used at a later time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9dd6045-4507-4fbb-aa74-cfa61907a636",
                                                "sense_id": "1553be47-2998-3add-af62-0a5ab9ed93f8",
                                                "text": "I try to put a few dollars aside each week, just in case I need money in an emergency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a4b921-296a-3d23-87c8-38f06f353e43",
                                        "entry_id": "4b2da2db-5c99-3616-bfe4-f4b9acad3c41",
                                        "glosses": [
                                            "To ignore or intentionally disregard (something), temporarily or permanently, so that more important things can occupy one's attention."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2840c2f6-97e0-47ff-b7f8-01aaad0f3856",
                                                "sense_id": "41a4b921-296a-3d23-87c8-38f06f353e43",
                                                "text": "Let's put our differences aside for the moment, and get this project finished."
                                            },
                                            {
                                                "example_id": "f6e6a65d-c247-4617-a4cc-0387840a424c",
                                                "sense_id": "41a4b921-296a-3d23-87c8-38f06f353e43",
                                                "text": "Stanmore: Plans to provide step-free access to the Jubilee Line station have been put aside, after the housing development on the car park that would have paid for it was withdrawn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b194406b-9b61-4856-96a6-1684d7a2823e",
                        "source_entry_id": "0c3c0be3-568f-3a7b-9200-42db5ac404a4",
                        "source_sense_description": "класть в сторону или отдельно, на более далёком расстоянии",
                        "target_lang_word": "set aside",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "set aside",
