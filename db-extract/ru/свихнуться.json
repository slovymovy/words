                    }
                ],
                "senses": [
                    {
                        "sense_id": "10dfa618-b1bd-3240-b238-5ee074045061",
                        "entry_id": "82ab9673-3f4d-3f99-97cc-5c50df65df4b",
                        "glosses": [
                            "стать сумасшедшим, потерять способность рассуждать и действовать разумно, помешаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc85a0d-5700-4452-bd7c-17b33178f26c",
                                "sense_id": "10dfa618-b1bd-3240-b238-5ee074045061",
                                "text": "Мама перепугалась ― сын совсем свихнулся, на котёл залез, со стенкой разговаривает."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f70e73a-645c-3b1a-8601-5340b97eba4b",
                        "entry_id": "82ab9673-3f4d-3f99-97cc-5c50df65df4b",
                        "glosses": [
                            "уделять слишком много сил и времени указанному предмету, как будто этот предмет является основной причиной сумасшествия"
                        ],
                        "tags": [
                            "на чём-либо"
                        ],
                        "examples": [
                            {
                                "example_id": "bb5cb0cb-5697-4109-a306-cfb3a0b2c756",
                                "sense_id": "7f70e73a-645c-3b1a-8601-5340b97eba4b",
                                "text": "Как у нас, мы-то знаем, а вот в Америке ― «они там свихнулись на этом своем феминизме»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b77f8cfb-54be-46d9-a7a6-5b9bb7bb423f",
                        "source_entry_id": "82ab9673-3f4d-3f99-97cc-5c50df65df4b",
                        "target_lang_word": "go nuts",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go nuts",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e14913-2df1-33d5-b94c-3a7896f56a4a",
                                        "entry_id": "1a80a244-0386-3479-bafe-b96e27dcf30c",
                                        "glosses": [
                                            "To become mad."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8a39dd-95b2-4c07-84b2-a8c5f0454d43",
                                                "sense_id": "f8e14913-2df1-33d5-b94c-3a7896f56a4a",
                                                "text": "Yeah, I sometimes go nuts when people try and write on my stuff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a38e8ef-de5f-3d63-ba6e-d1056f5d394f",
                                        "entry_id": "1a80a244-0386-3479-bafe-b96e27dcf30c",
                                        "glosses": [
                                            "Go ahead; feel free."
                                        ],
                                        "tags": [
                                            "imperative",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06fad81-1213-4589-b230-85d4a59b3a8c",
                                                "sense_id": "6a38e8ef-de5f-3d63-ba6e-d1056f5d394f",
                                                "text": "\"Can we play in the garden?\" \"Sure, go nuts.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
