                "senses": [
                    {
                        "sense_id": "e472b9a9-1226-355e-9c73-baa07feb6103",
                        "entry_id": "c80ea429-fdfd-3b63-9753-8a027a2dbc33",
                        "glosses": [
                            "Störung der Verdauung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5726b495-f081-4202-8882-2863cb9254cb",
                                "sense_id": "e472b9a9-1226-355e-9c73-baa07feb6103",
                                "text": "„Heute, im Oktober 1858, fast zweiundzwanzig Jahre später, war er beinahe fünfzig ... und litt, wie seine Ärzte ihm erklärt hatten, unter Dyspepsie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d25507f1-2d7d-4051-85ca-83b86169ffd6",
                        "source_entry_id": "c80ea429-fdfd-3b63-9753-8a027a2dbc33",
                        "source_sense_id": "e472b9a9-1226-355e-9c73-baa07feb6103",
                        "source_sense_description": "Medizin: Störung der Verdauung",
                        "target_lang_word": "dyspepsia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dyspepsia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bebf63a-9ce5-3997-84f6-47bfd1580e2e",
                                        "entry_id": "6c0a87ae-1af3-3d0e-99e6-08aaabef2f3e",
                                        "glosses": [
                                            "Any mild disorder of digestion characterised by stomach pain, discomfort, heartburn, and nausea, often following a meal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c59d7b03-2e38-49fa-9c37-5b6019e68f34",
                                                "sense_id": "9bebf63a-9ce5-3997-84f6-47bfd1580e2e",
                                                "text": "He divides dyspepsias into accidental, temporary (indigestions) and habitual."
                                            },
                                            {
                                                "example_id": "593ed4d6-e557-4ddb-bae8-a4036a46bd47",
                                                "sense_id": "9bebf63a-9ce5-3997-84f6-47bfd1580e2e",
                                                "text": "It is not my strength of mind (exert it as I may) that will prevent me from experiencing dyspepsia, if such follies as these are exhibited before me."
                                            },
                                            {
                                                "example_id": "0566ac57-2c34-41e3-93b7-230640d0dc9f",
                                                "sense_id": "9bebf63a-9ce5-3997-84f6-47bfd1580e2e",
                                                "text": "\"And the cramps when my body - like a badly articulated skeleton - would all get twisted into one rigid tangle! But now, except some dyspepsia and urticaria of the palms, I am free from pain.\""
                                            },
                                            {
                                                "example_id": "8010b2bb-d618-48b7-9123-26f0adecae60",
                                                "sense_id": "9bebf63a-9ce5-3997-84f6-47bfd1580e2e",
                                                "text": "I've never hunted myself, but I understand that half the battle is being able to make noises like some jungle animal with dyspepsia, and I believe that Aunt Dahlia in her prime could lift fellow-members of the Quorn and Pytchley out of their saddles with a single yip, though separated from them by two ploughed fields and a spinney."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b43af19e-6bfe-4bf6-9d1f-47ef50afecc2",
                        "source_entry_id": "c80ea429-fdfd-3b63-9753-8a027a2dbc33",
                        "source_sense_id": "e472b9a9-1226-355e-9c73-baa07feb6103",
                        "source_sense_description": "Medizin: Störung der Verdauung",
                        "target_lang_word": "indigestion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indigestion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2440b352-84f5-3d07-abfb-be371dc876a7",
                                        "entry_id": "a9db4166-3c7b-3a46-9a97-720aea376dbd",
                                        "glosses": [
                                            "A condition of heartburn, nausea, or other stomach-related pain, sometimes caused by eating too quickly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81aedd5b-2839-48e0-b923-e14856f1ee7d",
                                                "sense_id": "2440b352-84f5-3d07-abfb-be371dc876a7",
                                                "text": "If you also knew how to combine foods—that is, what foods eaten together “set well,” you need never have indigestion, constipation or any of the headachy, stomachachy ills they lead to."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffcb6988-2389-4c51-9ce5-b27154734f21",
                        "source_entry_id": "c80ea429-fdfd-3b63-9753-8a027a2dbc33",
                        "source_sense_id": "e472b9a9-1226-355e-9c73-baa07feb6103",
