                        "entry_id": "0b0c920d-d74b-356c-b776-b3437646ac76",
                        "glosses": [
                            "schwer schmelzbare, sehr harte und hitzebeständige Verbindung des Stickstoffs mit Metallen und manchen Nichtmetallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b6db1a-0f14-4eb9-aa02-ef8efc8e6237",
                                "sense_id": "39709359-c4b7-3b21-8886-784ee5fb82d2",
                                "text": "Magnesiumnitrid ist eine chemische Verbindung aus den Elementen Magnesium und Stickstoff. Es besitzt die Formel Mg₃N₂ und gehört zur Stoffgruppe der Nitride."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
