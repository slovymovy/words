                            {
                                "target_lang_word": "одновременно",
                                "target_lang_sense_clarification": "синхронно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同时",
                                "target_lang_sense_clarification": "在同一时间发生"
                            }
                        ]
                    }
                }
            ]
        },
        {
