{
    "word_family": [
        "assomption",
        "assumable",
        "inassumable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6771531-0edb-34ca-98c9-bdf6c7e0fe1a",
                    "sense_definition": "Accepter pleinement la responsabilité de ses actes, de ses choix ou de ses erreurs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut savoir <w>assumer</w> ses erreurs pour progresser dans la vie."
                        },
                        {
                            "text": "Elle a pris une décision difficile et elle en <w>assume</w> les conséquences."
                        }
                    ],
                    "common_phrases": [
                        "assumer ses erreurs",
                        "assumer les conséquences",
                        "assumer ses choix"
                    ]
                },
                {
                    "sense_id": "e980026d-ac6b-3ac1-a7ec-fa0c665eb077",
                    "sense_definition": "Prendre en charge une tâche, une fonction ou une charge importante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau directeur va <w>assumer</w> la responsabilité de tous les projets en cours."
                        },
                        {
                            "text": "Pendant cette période de crise, notre équipe doit <w>assumer</w> un rôle central dans l'organisation."
                        }
                    ],
                    "common_phrases": [
                        "assumer la responsabilité",
                        "assumer un rôle"
                    ]
                },
                {
                    "sense_id": "db01bb52-bfab-3468-aa19-a9ec8307085e",
                    "sense_definition": "Subvenir soi-même à ses besoins matériels ou accepter pleinement sa propre personnalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À dix-huit ans, il a trouvé un emploi pour enfin s'<w>assumer</w>."
                        },
                        {
                            "text": "Elle a quitté le domicile familial pour apprendre à s'<w>assumer</w> au quotidien."
                        }
                    ]
                },
                {
                    "sense_id": "812d34dc-25c8-33b2-92f0-70bb7a1aa733",
                    "sense_definition": "Supposer ou tenir pour acquis sans vérification préalable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu ne devrais pas <w>assumer</w> qu'il viendra sans lui avoir posé la question."
                        },
                        {
                            "text": "Le professeur <w>assume</w> que tous les étudiants ont lu le livre avant le cours."
                        }
                    ],
                    "synonyms": [
                        "présumer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "anglicisme"
                        }
                    ]
                }
            ]
        }
    ]
}