                        "glosses": [
                            "The act of mixing or combining substances to make a compound, such as a medicine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0886db-cd98-4cf9-a37b-6bed41ac013f",
                                "sense_id": "0dffa49c-2c54-3224-b66d-914eefdde333",
                                "text": "Arthur Pendennis, his son, was eight years old at the time of this event, so that it is no wonder that the latter, who left Bath and the surgery so young, should forget the existence of such a place almost entirely, and that his father’s hands had ever been dirtied by the compounding of odious pills, or the preparation of filthy plasters"
