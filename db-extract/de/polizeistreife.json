                    {
                        "sense_id": "37eca8b0-a848-3e5d-a820-38af0ae2cef8",
                        "entry_id": "293128ac-cf50-37ac-addc-6e60f53fb7d2",
                        "glosses": [
                            "Polizeibeamter oder Gruppe von Polizeibeamten, die Fahrten oder Gänge zwecks Kontrolle eines Bereichs durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2ff24e-8aa0-48bc-8b92-063bb74215fe",
                                "sense_id": "37eca8b0-a848-3e5d-a820-38af0ae2cef8",
                                "text": "„Militär- und Polizeistreifen beherrschten die Straßen.“"
                            },
                            {
                                "example_id": "1578cd66-714d-4b5a-a83b-78aeb0b8a412",
                                "sense_id": "37eca8b0-a848-3e5d-a820-38af0ae2cef8",
                                "text": "„Eine Polizeistreife verfolgt einen Kleinstwagen, der die Verkehrsordnung durch kaninchenartiges Gehoppel stört.“"
                            },
                            {
                                "example_id": "c3527799-07be-4e3e-8163-e8df43635b3a",
                                "sense_id": "37eca8b0-a848-3e5d-a820-38af0ae2cef8",
                                "text": "„Viele Stunden lang froren die Götzlacker auf der Straße, bis ihnen eine Polizeistreife ein paar Ställe und Scheunen aufsperrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
