                "senses": [
                    {
                        "sense_id": "52127170-87a4-3042-b15e-53eea21d7272",
                        "entry_id": "b5fd395f-4bef-3436-ae14-25dc2613655d",
                        "glosses": [
                            "Qui se développe d’une façon plus ou moins obscure, ou incomplète, embryonnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b364fb9f-b4d8-4568-957f-d1ed60297bdc",
                                "sense_id": "52127170-87a4-3042-b15e-53eea21d7272",
                                "text": "Elle […] faisait de la neurasthénie larvée ainsi que toute femme qui se fane et sent se flétrir sa beauté."
                            }
                        ]
                    },
                    {
                        "sense_id": "561e682b-7fd9-3da4-98d0-7e1f8ef0ca1c",
                        "entry_id": "b5fd395f-4bef-3436-ae14-25dc2613655d",
                        "glosses": [
                            "Non ouvertement déclaré, latent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd2b6869-896b-4f74-a496-2e23f69acd6f",
                                "sense_id": "561e682b-7fd9-3da4-98d0-7e1f8ef0ca1c",
                                "text": "Cela resta toujours entre elles le sujet d’un féroce conflit larvé."
                            },
                            {
                                "example_id": "f4ba6e4a-d74b-496d-a8a0-cce8bf340f79",
                                "sense_id": "561e682b-7fd9-3da4-98d0-7e1f8ef0ca1c",
                                "text": "La loi 96 continue une guerre larvée entre le pouvoir judiciaire et le pouvoir exécutif sur la langue des tribunaux au Québec."
                            }
                        ]
                    }
                ],
                "translations": [
