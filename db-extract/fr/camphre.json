                    },
                    {
                        "translation_id": "09ab54f6-0ab4-48b1-ab1e-53c82387ec18",
                        "source_entry_id": "c31048fb-3e79-3b28-90d6-b1feb839ac66",
                        "source_sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                        "source_sense_description": "(Cosmétologie) Substance extraite principalement du camphrier",
                        "target_lang_word": "camphor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camphor",
