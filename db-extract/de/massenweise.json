        "de-extract.jsonl": [
            {
                "entry_id": "15b33c69-8b77-3137-bf25-ce69e29c1765",
                "word": "massenweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                        "entry_id": "15b33c69-8b77-3137-bf25-ce69e29c1765",
                        "glosses": [
                            "in sehr großer Menge, viel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dda955a3-2202-477a-bf32-6d4b71623cd7",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "Deutschland exportiert massenweise Fleisch und andere Lebensmittel."
                            },
                            {
                                "example_id": "dab03d7e-85b5-4848-acc6-069055837ee8",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "Wir versenken massenweise Plastikmüll im Meer."
                            },
                            {
                                "example_id": "0e79e981-4f7a-44bf-bf61-0a218b9d0b30",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "Durch das Hochwasser schlüpften in den letzten Tagen massenweise Stechmückenlarven."
                            },
                            {
                                "example_id": "664ef6d3-33fe-434d-956f-f7ee9536aa67",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "ManU taxiert die eigene Anhängerschaft auf rund 659 Millionen Fans […]. Sie kaufen […] massenweise Fanartikel und sichern dem Club vor allem fette Werbeeinnahmen."
                            },
                            {
                                "example_id": "b4d05b4e-a637-490e-b9ea-e29d3363ae2c",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "Ingenieure und Facharbeiter emigrierten [früher] massenweise [aus Spanien] nach Nordeuropa."
                            },
                            {
                                "example_id": "991ac354-fe6c-4978-93d7-276edae6456c",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "Im kurdischen Nordirak laufen die Menschen massenweise davon. Aus Angst vor dem IS und weil die Wirtschaft am Boden liegt."
                            },
                            {
                                "example_id": "1f93b9ad-a3fe-4911-9016-8944b0e54f4f",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "[Bauunternehmer, Millionär und Ministerpräsident Rafiq] Hariri gründete ein Unternehmen namens \"Solidaire\", kaufte massenweise Grundstücke und startete den Bau einer auf Hochglanz polierten Innenstadt."
                            },
                            {
                                "example_id": "3ceade02-fac6-49d6-aa01-447585557564",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "Lange profitieren aufstrebende Volkswirtschaften von den Niedrigzinsen in den Industrieländern. Massenweise fließt Kapital in Schwellenländer."
                            },
                            {
                                "example_id": "661eb210-45d8-411f-9e2e-237eb84be8cc",
                                "sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                                "text": "Beim normalen Verlauf einer Malariaerkrankung werden vom Erreger befallene rote Blutkörperchen zum Platzen gebracht. Dabei werden massenweise Abbauprodukte der Blutkörperchen, darunter der rote Blutfarbstoff Häm freigesetzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eafa4968-649b-455c-bc5e-edf2db2652d9",
                        "source_entry_id": "15b33c69-8b77-3137-bf25-ce69e29c1765",
                        "source_sense_id": "07aafaf4-e010-308c-a2cf-a1c7bdcfe15e",
                        "source_sense_description": "in sehr großer Menge",
                        "target_lang_word": "galore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                        "entry_id": "83e65ceb-706a-3da1-8d53-4b125f32f5f1",
                                        "glosses": [
                                            "In abundance."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "postpositional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48d8aa42-8c36-4913-ab26-44991799bf52",
                                                "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                                "text": "After the shipwreck there was whisky galore to be had for the taking."
                                            },
                                            {
                                                "example_id": "272f5710-8b42-414b-8835-b3befa22508a",
                                                "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                                "text": "[…]But when I had bestridden the plank, quoth I to myself, \"Thou deserveth all that betideth thee. All this is decreed to me of Allah (whose name be exalted!), to turn me from my greed of gain, whence ariseth all that I endure, for I have wealth galore.\""
                                            },
                                            {
                                                "example_id": "a80d6b6e-fb70-4539-b443-6cb3f27c887c",
                                                "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                                "text": "I am the destroyer of mountains, the killer of kings, I always fly by yet I don't have wings. I can end basketball games or marriages with similar ease, and though I flow like a stream only water can freeze. I've murdered parents and children and house plants galore, yet, despite all this, you always want more. Who am I?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "galore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "481b5000-eb66-3f21-b008-192067daeb44",
                                        "entry_id": "23f88fa2-ae5a-397b-9ad3-8718b7680dca",
                                        "glosses": [
                                            "An abundance; plenty."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f857b687-bd78-4a15-9f52-625d3cfdaab1",
                                                "sense_id": "481b5000-eb66-3f21-b008-192067daeb44",
                                                "text": "The usual routine of confections and pastry follows, after which a galore of fruits of all kinds, with a chassè of excellent Mocha, the immediate servitude of which, after good dining, is, I think, universally acknowledged to be a great exhiliration.^([sic – meaning exhilaration])"
                                            },
                                            {
                                                "example_id": "2c51e315-d6ee-4483-8606-5431a20a9f7e",
                                                "sense_id": "481b5000-eb66-3f21-b008-192067daeb44",
                                                "text": "I have got the Innishowen and galores of bread and cheese ready, and all the neighbours are to join us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
