                        "glosses": [
                            "Prostitué occasionnel ; homme qui se fait entretenir par quelqu’un de riche ou de puissant."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5a09866f-1c19-46e2-9856-3ab51667e0fa",
                                "sense_id": "71dfa9b3-560a-33aa-b150-dee44626b0ab",
                                "text": "Hier après-midi, Anastasia m’a donné un plaisir extrême. Aucune masseuse de Bangkok, aucun michetonneur de Manille ou de Colombo n’aurait pu m’en donner davantage."
                            },
                            {
                                "example_id": "e910d58d-936c-4705-a036-49d0aef3c74a",
                                "sense_id": "71dfa9b3-560a-33aa-b150-dee44626b0ab",
                                "text": "S’étant souvenu qu’il était, de tous les michetonneurs ayant défilé à la pension Emma, le préféré du père Chouin, Maud l’avait accueilli à bras ouverts et en avait fait son commis."
                            }
                        ]
                    }
