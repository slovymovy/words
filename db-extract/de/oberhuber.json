                ],
                "senses": [
                    {
                        "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                        "entry_id": "f1d4906c-9418-3d58-85ec-8b55dabc61de",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8140598-1654-4611-97a4-db341e0639a7",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "Frau Oberhuber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "136d688b-6f97-4d31-8bde-ff55682091f5",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "Herr Oberhuber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c92b2b14-bb38-4990-8e39-bb06349ae54b",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "Die Oberhubers kommen heute aus dem Waldviertel."
                            },
                            {
                                "example_id": "ca44abf8-d369-4dab-9d2c-5e72427ba95c",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "Der Oberhuber trägt nie die Schals, die die Oberhuber ihm strickt."
                            },
                            {
                                "example_id": "ca5e6b24-abee-4fd9-893b-01e34dec00ea",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Oberhuber kommt, geht der Herr Oberhuber.“"
                            },
                            {
                                "example_id": "c2d944b2-6465-4be3-ac5c-8258a167f506",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "Oberhuber kommt und geht."
                            },
                            {
                                "example_id": "07fcd0fe-44e1-47b3-8622-f7e7c4c56f26",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "Oberhubers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "34408a5c-3db5-47de-81dc-06c5fb08d2d5",
                                "sense_id": "59f84e1e-f33a-33b9-8099-8c7984b18c49",
                                "text": "„Oberhuber wurde 2001 mit dem Österreichischen Ehrenkreuz für Wissenschaft und Kunst I. Klasse ausgezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
