                "senses": [
                    {
                        "sense_id": "b915a0e0-90f8-3c9c-b18e-4013f8b78264",
                        "entry_id": "30718ba9-8425-3fd9-9f72-273d12d24520",
                        "glosses": [
                            "Donner un caractère souverain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde70761-a3b5-42d6-a8f3-cf985c31c8e7",
                                "sense_id": "b915a0e0-90f8-3c9c-b18e-4013f8b78264",
                                "text": "Maintenant que la manie de SOUVERAINISER les a repris, la cure devient plus difficile ; il faudra cependant en revenir à un expédient qui prévienne des rechutes toujours allarmantes pour la tranquillité publique : voici le moyen le plus efficace à mon avis."
                            },
                            {
                                "example_id": "80c8020d-4024-4d68-9a39-d29f32e88ce3",
                                "sense_id": "b915a0e0-90f8-3c9c-b18e-4013f8b78264",
                                "text": "Hé ! Mon bon roi, ici, au royaume de France, on ne se « vassalise » pas, mon gars, on se « souverainise »."
                            }
                        ]
                    }
