                {
                    "sense_id": "86cbfef0-bdba-37d4-a9dc-58b21a03d932",
                    "sense_definition": "Gebiedende wijs van <w>manken</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mank</w> niet zo overdreven, probeer normaal te lopen.",
                            "target_lang_translations": {
                                "en": "Don't <w>limp</w> so exaggeratedly, try to walk normally.",
                                "ru": "Не <w>хромай</w> так нарочито, попробуй идти нормально.",
                                "de": "<w>Hinke</w> nicht so übertrieben, versuche normal zu gehen."
                            }
                        },
                        {
                            "text": "<w>Mank</w> maar rustig naar de bank als je pijn hebt.",
                            "target_lang_translations": {
                                "en": "Just <w>limp</w> quietly to the couch if you are in pain.",
                                "ru": "<w>Хромай</w> потихоньку к дивану, если тебе больно.",
                                "de": "<w>Hinke</w> einfach langsam zum Sofa, wenn du Schmerzen hast."
