                        "examples": [
                            {
                                "example_id": "5b4d187e-ab7c-4f2d-8f81-521fef4aa073",
                                "sense_id": "5197340e-dae6-330b-9a89-63f8a93f33a4",
                                "text": "Hij keek met schrik naar het aangaande waarschuwingslampje."
                            },
                            {
                                "example_id": "57ff35f1-07de-4dba-9464-fc8e9a9c68c6",
                                "sense_id": "5197340e-dae6-330b-9a89-63f8a93f33a4",
                                "text": "Een karakterschets van deze twee personen is nauwelijks te maken. Zelf een poging wagend; beetje anders dan normaal, de uitdaging aangaande, dromen nalevend, grenzeloos en daardoor ook veel tegelijk aan het doen."
                            }
                        ]
                    }
