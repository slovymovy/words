                                    {
                                        "sense_id": "3e10b00e-f339-3e5b-8cd5-52aa0dfd2b82",
                                        "entry_id": "bbe7e226-d604-3c1a-9986-be90d725b0cb",
                                        "glosses": [
                                            "Being large in size, mass, or volume; big, fat or muscular."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759d36c6-9126-45cc-b8ca-4658eee345e0",
                                                "sense_id": "3e10b00e-f339-3e5b-8cd5-52aa0dfd2b82",
                                                "text": "Action such as this, filmed under great difficulty with a bulky, hand-cranked camera, revealed the possibilities of the movies and was quite startling in those early days."
                                            },
                                            {
                                                "example_id": "6be60671-e3f3-4da2-876f-a71ed637ecae",
                                                "sense_id": "3e10b00e-f339-3e5b-8cd5-52aa0dfd2b82",
                                                "text": "Needless to say, one's seat must be booked in advance and a platoon of urbane officials, one to each door of the train, awaits passengers to usher them to their seats and relieve them of their bulkier baggage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaef20d9-c097-33c5-8c81-474b79707727",
                                        "entry_id": "bbe7e226-d604-3c1a-9986-be90d725b0cb",
                                        "glosses": [
                                            "Unwieldy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5c884a8-7b57-372d-8b31-5e39f1dfa235",
                                        "entry_id": "bbe7e226-d604-3c1a-9986-be90d725b0cb",
                                        "glosses": [
                                            "Having excess body mass, especially muscle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59fe792f-33e9-4a48-bc9a-4187711d49a7",
                        "source_entry_id": "089ec5af-060a-301d-904f-dd4e2ee2c986",
                        "source_sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
