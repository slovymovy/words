                "senses": [
                    {
                        "sense_id": "b93bf044-3ae5-340b-a826-5c5a35154382",
                        "entry_id": "d25c7d4c-02c1-38f4-9f7f-9daaa6234270",
                        "glosses": [
                            "Rendre cocu, avoir des relations avec le ou la partenaire connue d’une personne."
                        ],
                        "tags": [
                            "colloquial",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "afe197ee-6b15-4904-9650-c81d75aea7c6",
                                "sense_id": "b93bf044-3ae5-340b-a826-5c5a35154382",
                                "text": "Il fallut attendre plus de dix ans pour qu’un fils de soyeux, au blason dédoré par la crise, encorniflât successivement un homme du monde devenu comédien célèbre et un comédien célèbre devenu homme du monde."
                            }
                        ]
                    }
