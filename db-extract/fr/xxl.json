                "forms": [],
                "senses": [
                    {
                        "sense_id": "66772461-6b2b-3265-b69a-b717f48a03b5",
                        "entry_id": "c370333a-9c8a-3374-a985-567d1934792a",
                        "glosses": [
                            "Qualifie un vêtement de grande taille, supérieure à XL."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3a106e-b07c-4ca0-b060-044b8228bdad",
                                "sense_id": "66772461-6b2b-3265-b69a-b717f48a03b5",
                                "text": "Elle aimait les chemises trop grandes, porter les vêtements de ce papa qu'elle n'avait jamais eu. Quand elle accompagnait Ruth, dans les friperies de Barbès, elle repartait souvent avec une chemise XXL, espérant que la vendeuse pense que c'était un cadeau pour son père."
                            },
                            {
                                "example_id": "3bc3059d-4797-4e48-b052-6039c3b0b4e4",
                                "sense_id": "66772461-6b2b-3265-b69a-b717f48a03b5",
                                "text": "Son style lui allait à merveille. De sa grande carcasse, il portait très bien le col roulé sous une belle veste XXL. Il était toujours aussi grand, et cela me fascinait prodigieusement."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bc1b877-6df5-3c52-be58-b4328bd9d762",
                        "entry_id": "c370333a-9c8a-3374-a985-567d1934792a",
                        "glosses": [
                            "Qualifie la grande taille d'une chose, par comparaison avec une taille ordinaire."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1cf11c5e-57aa-4af9-a912-2f837989cf70",
                                "sense_id": "4bc1b877-6df5-3c52-be58-b4328bd9d762",
                                "text": "Debout devant le magasin d’antiquités d’Howard Avenue, le lieutenant Paddy Fitzgerald, que tout le monde appelle « Irish », termine un énorme pain aux raisins avec glaçage sur le dessus. À ses pieds, il a posé un gobelet de café noir taille XXL encore trop brûlant pour être bu."
                            },
                            {
                                "example_id": "3ba2528e-69a2-467a-ad9c-94f50cb0c211",
                                "sense_id": "4bc1b877-6df5-3c52-be58-b4328bd9d762",
                                "text": "Tu veux essayer ? dit Harry Mitchell, en abattant son verre XXL de martini sur une table basse dotée d'une belle résonance et en s'efforçant de prendre un air de bouledogue – très convaincant, je l'admets."
                            },
                            {
                                "example_id": "649fa865-6773-4b42-990b-e91c104b5640",
                                "sense_id": "4bc1b877-6df5-3c52-be58-b4328bd9d762",
                                "text": "À Corcoué-sur-Logne, au sud de Nantes, le long de la route qui mène au site du futur méthaniseur géant « Méta Herbauges », des panneaux triangulaires « Non à la méthanisation XXL » donnent le ton."
                            },
                            {
                                "example_id": "bff1f5dd-fd91-4865-8fdb-b87b86c731a6",
                                "sense_id": "4bc1b877-6df5-3c52-be58-b4328bd9d762",
                                "text": "Non à la méthanisation XXL et aux méga-méthaniseurs !"
                            }
                        ]
                    }
