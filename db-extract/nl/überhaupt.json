                        "examples": [
                            {
                                "example_id": "a2bbe957-422b-4dfd-9866-a6d38e661188",
                                "sense_id": "a52062e4-f4ed-3dc4-8a10-06e3c30e4333",
                                "text": "Hoe is het heelal überhaupt ontstaan?",
                                "translation": "How did the universe originate in the first place?",
                                "english": "How did the universe originate in the first place?"
                            },
                            {
                                "example_id": "cd9d075f-79f1-4ebd-8955-4b7e72362e52",
                                "sense_id": "a52062e4-f4ed-3dc4-8a10-06e3c30e4333",
                                "text": "Weet je überhaupt wel wat dat betekent, of praat je gewoon uit je nek?",
                                "translation": "Do you know what that means at all, or are you just making things up as you go along?",
                                "english": "Do you know what that means at all, or are you just making things up as you go along?"
                            }
                        ]
                    }
                ],
                "translations": [],
