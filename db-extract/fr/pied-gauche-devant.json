                                            "nonstandard",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69cbe4e4-0af5-45b0-9018-7004b8ed476d",
                                                "sense_id": "f06e7db0-0fce-3d57-b1a2-d19a89f6e54f",
                                                "text": "'And if the knowledge wasn'y well come by, why, you might ha' made up for it by coming to church reg'lar.'"
                                            },
                                            {
                                                "example_id": "b6c17875-0131-4863-8b3c-2eb0391ffe8f",
                                                "sense_id": "f06e7db0-0fce-3d57-b1a2-d19a89f6e54f",
                                                "text": "Though no minister would visit the Skerburnfoot, or, if he went, departed quicker than he came, the girl Ailie attended regular at the catechising at the mains of Sker."
                                            },
                                            {
                                                "example_id": "09b9772c-bc09-49f5-8ba7-5b1ab922764a",
                                                "sense_id": "f06e7db0-0fce-3d57-b1a2-d19a89f6e54f",
                                                "text": "\"There's only twenty men staying in the house regular,\" said Ahearne, showing him around[.]"
                                            },
                                            {
                                                "example_id": "569c5425-f3f9-44e6-993c-890f59b3afd5",
                                                "sense_id": "f06e7db0-0fce-3d57-b1a2-d19a89f6e54f",
                                                "text": "\"Drain her every thousand, regular. Don't do it myself, o' course; just drop her in at the lubritorium.\""
                                            },
                                            {
                                                "example_id": "7cd5a86b-74ed-4244-8987-c075dd4e7af4",
                                                "sense_id": "f06e7db0-0fce-3d57-b1a2-d19a89f6e54f",
                                                "text": "\"All we've got to do is stick 'em in the bedroom and feed 'em regular.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
