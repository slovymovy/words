                                        "entry_id": "b342eca1-e245-34ea-95d3-3d5ca219ce2b",
                                        "glosses": [
                                            "Person, die in einem Hafen für Schiffsbewegungen, Sicherheit und nautische Verwaltung verantwortlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "571e82ba-9dae-4729-bdc7-45511599f965",
                                                "sense_id": "8f5aecaf-adda-35fc-b0d7-bce44619f187",
                                                "text": "„›Er hat dem Hafenmeister mit der Machete beide Hände abgehackt.‹“"
