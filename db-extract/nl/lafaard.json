                    {
                        "sense_id": "729ce6c7-5fe6-324e-b577-0665cb182510",
                        "entry_id": "354ad459-5467-3150-b2e9-1b1675162dcc",
                        "glosses": [
                            "iemand die door zijn angst wegvlucht uit gevaarlijke situaties"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "62493330-ebd3-4ecd-8d8d-9aab6ed783e5",
                                "sense_id": "729ce6c7-5fe6-324e-b577-0665cb182510",
                                "text": "Die lafaard liet ons in de steek toen we hem het hardst nodig hadden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6e1c726-9dfc-4fcf-8a7d-90fd0e9f964f",
                        "source_entry_id": "354ad459-5467-3150-b2e9-1b1675162dcc",
                        "source_sense_id": "729ce6c7-5fe6-324e-b577-0665cb182510",
                        "source_sense_description": "iemand die door zijn angst wegvlucht uit gevaarlijke situaties.",
                        "target_lang_word": "Feigling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feigling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                        "entry_id": "68d08fb9-82ee-3a71-b31a-97dbe7378338",
                                        "glosses": [
                                            "furchtsame, ängstliche, risikoscheue Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef2bf05-5c64-4b48-9be2-42eab284e81d",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "Sei kein solcher Feigling und sag deinem Chef endlich mal richtig die Meinung!"
                                            },
                                            {
                                                "example_id": "80b97be5-baa2-4700-9ea8-f667b9670c3b",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Wer eine Familie mit fünf Töchtern gründet, kann kein Feigling sein.“"
                                            },
                                            {
                                                "example_id": "8dcd235e-67cb-432f-ad58-cf295d7da7d0",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Anstatt seinen Leuten zu Hilfe zu kommen, drehte sich dieser jämmerliche Feigling plötzlich um und gab Fersengeld.“"
                                            },
                                            {
                                                "example_id": "3b0e40a9-db73-4956-a505-614ed72cb053",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Nun schämten sich die Moskowiter wohl, dass sie als Feiglinge bezeichnet wurden, und schämten sich, dass sie wegfuhren, fuhren aber trotzdem weg, weil sie wussten, dass es sein musste.“"
                                            },
                                            {
                                                "example_id": "9e39e1ca-6039-4809-8fbb-6bfd8778ba3c",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "(„Soll ich da mal rüberbalancieren?“) – „Tu doch, mach doch, Feigling!“ – (Mögliche Antwort:) „Lieber ein Feigling sein, als einem Doofen ein’n Gefallen tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e57a7e9a-4975-422d-abf6-00daac07f971",
                        "source_entry_id": "354ad459-5467-3150-b2e9-1b1675162dcc",
                        "source_sense_id": "729ce6c7-5fe6-324e-b577-0665cb182510",
                        "source_sense_description": "iemand die door zijn angst wegvlucht uit gevaarlijke situaties.",
                        "target_lang_word": "coward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2356e98e-e040-38ed-863e-84e689254f53",
                                        "entry_id": "00d4bdd9-1072-3fca-b994-b025e14d911f",
                                        "glosses": [
                                            "A person who lacks courage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2922e13-994b-41c1-b16b-bbc0bf3645c0",
                                                "sense_id": "2356e98e-e040-38ed-863e-84e689254f53",
                                                "text": "Cowards dye many times before their deaths, / The valiant neuer taſte of death but once: […]"
                                            },
                                            {
                                                "example_id": "cb76a042-cf8f-4a2f-9e16-4806170a98c1",
                                                "sense_id": "2356e98e-e040-38ed-863e-84e689254f53",
                                                "text": "1856: Gustave Flaubert, Madame Bovary, Part II Chapter IV, translated by Eleanor Marx-Aveling\nHe tortured himself to find out how he could make his declaration to her, and always halting between the fear of displeasing her and the shame of being such a coward, he wept with discouragement and desire. Then he took energetic resolutions, wrote letters that he tore up, put it off to times that he again deferred."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a68b643c-ac94-3ed7-b0a7-46cb2dfc4181",
                                        "entry_id": "432b383b-8f74-342f-8ad7-af0df3c784aa",
                                        "glosses": [
                                            "Cowardly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90433c44-af27-4f55-8afa-8a90709b9285",
                                                "sense_id": "a68b643c-ac94-3ed7-b0a7-46cb2dfc4181",
                                                "text": "It is a coward and servile humour, for a man to disguise and hide himselfe under a maske, and not dare to shew himselfe as he is."
                                            },
                                            {
                                                "example_id": "81c73b29-343a-40e0-8eb4-f8e72514a15a",
                                                "sense_id": "a68b643c-ac94-3ed7-b0a7-46cb2dfc4181",
                                                "text": "c. 1605, William Shakespeare, King Lear, Act II, Scene 4,\nHe rais’d the house with loud and coward cries."
                                            },
                                            {
                                                "example_id": "805f51aa-04eb-4678-ab1c-94f327d1d74f",
                                                "sense_id": "a68b643c-ac94-3ed7-b0a7-46cb2dfc4181",
                                                "text": "Invading Fears repel my Coward Joy;\nAnd Ills foreseen the pleasant Bliss destroy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16c34538-ae8c-31a7-9a14-bfced2bad70b",
                                        "entry_id": "432b383b-8f74-342f-8ad7-af0df3c784aa",
                                        "glosses": [
                                            "Borne in the escutcheon with his tail doubled between his legs."
                                        ],
                                        "tags": [
                                            "of a lion"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "coward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62d95d49-9e4b-3a6e-8397-2671a10f240b",
                                        "entry_id": "bb260f0b-7a50-3586-bbb0-a2112db15acc",
                                        "glosses": [
                                            "To intimidate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40342e07-51ea-4023-9d75-96b5687dec85",
                                                "sense_id": "62d95d49-9e4b-3a6e-8397-2671a10f240b",
                                                "text": "The first he coped with was their captain, whom / His sword sent headless to seek out a tomb. / This cowarded the valour of the rest, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27908a9d-0f83-45c4-9d02-cd8f63d8c495",
                        "source_entry_id": "354ad459-5467-3150-b2e9-1b1675162dcc",
                        "source_sense_id": "729ce6c7-5fe6-324e-b577-0665cb182510",
                        "source_sense_description": "iemand die door zijn angst wegvlucht uit gevaarlijke situaties.",
                        "target_lang_word": "lâche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lâche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Qui n’est pas tendu, qui n’est pas serré comme il pourrait ou devrait l’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c897413f-37dd-4ca8-bb4f-422586141fa4",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "La traversée jusqu'à Cap Stewart, puis l'entrée dans l'Inlet furent facilitées par l'état très lâche des glaces."
                                            },
                                            {
                                                "example_id": "dd782368-3e1b-4f15-a7de-52e9b5ccbc8a",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Elle n’aimait pas cette fille que Laurent avait épousée quinze jours auparavant et qui, bien que sa grossesse fût à peine visible, portait des robes lâches et se tenait le ventre en avant."
                                            },
                                            {
                                                "example_id": "798d17f1-c4e5-4ad9-a710-00bf4a11d3cf",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Ce nœud, cette ceinture est trop lâche."
                                            },
                                            {
                                                "example_id": "ef5548bc-0071-46cf-817f-d00b176fdbc7",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Il faut tenir cette corde un peu lâche."
                                            },
                                            {
                                                "example_id": "73aeed31-e7ae-49bc-b457-405a67333fd0",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Toile, drap, étoffe lâche, toile, drap, étoffe dont la trame n’est pas assez battue ou la chaîne assez serrée."
                                            },
                                            {
                                                "example_id": "ee480cd6-e9c9-4fbe-ad9f-4d85a1d91596",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Ventre lâche, ventre mou."
                                            },
                                            {
                                                "example_id": "32a75bae-8ba3-421a-8d24-4a223d94d374",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Style lâche, qui manque d’énergie et de concision."
                                            },
                                            {
                                                "example_id": "6ed2f581-14da-473d-8200-812a08fe273e",
                                                "sense_id": "f71508dc-1d34-303f-8761-eb25607183b7",
                                                "text": "Une écriture lâche, dont les caractères sont mal formés et trop espacés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70aa956-6690-3110-9e97-2448cfe2d2a0",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Mou et paresseux."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b0eb2b-833e-4121-ab00-39a240610d0d",
                                                "sense_id": "b70aa956-6690-3110-9e97-2448cfe2d2a0",
                                                "text": "[…] le père ayant essayé d’en garder un toute la journée avec lui, tandis que l’autre restait avec la mère, tous les deux furent si tristes, si pâles et si lâches au travail, qu’on les crut malades."
                                            },
                                            {
                                                "example_id": "405dac88-7ff6-481c-bc60-672a3a389a5e",
                                                "sense_id": "b70aa956-6690-3110-9e97-2448cfe2d2a0",
                                                "text": "Vie lâche et efféminée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e90b1f6c-1edd-3d68-8d66-ff9614381920",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Qui manque de courage."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa012302-2c87-47c1-87ac-1cbe33c1acbe",
                                                "sense_id": "e90b1f6c-1edd-3d68-8d66-ff9614381920",
                                                "text": "Ce soldat est lâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32fd051b-41e9-3fb7-a444-238ead29435a",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Vil et méprisable."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab638f8e-4c35-43a2-8fc3-798cf9561c76",
                                                "sense_id": "32fd051b-41e9-3fb7-a444-238ead29435a",
                                                "text": "C’est être bien lâche que de trahir son ami."
                                            },
                                            {
                                                "example_id": "0a140b24-0c1d-4639-8832-91d5d7e0fc80",
                                                "sense_id": "32fd051b-41e9-3fb7-a444-238ead29435a",
                                                "text": "Cette dénonciation est le fait d’une âme lâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                        "entry_id": "378f4581-46e3-30e5-99ce-3b36867e5da5",
                                        "glosses": [
                                            "Indigne d’un homme d’honneur ou d'une femme d'honneur."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677349b5-1366-4cd4-9a39-7aaaa6328116",
                                                "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                                "text": "Il a fait là une action bien lâche."
                                            },
                                            {
                                                "example_id": "b5ddca0b-b0b6-4279-86e6-125b9b2b8ea4",
                                                "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                                "text": "Son procédé est lâche."
                                            },
                                            {
                                                "example_id": "1bb765e4-65a5-4c45-bfbe-6225f2c1d73b",
                                                "sense_id": "edb43af7-8a63-3b6c-8957-2a4e084eca5f",
                                                "text": "Que sa conduite est lâche!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lâche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37d41149-9ca0-3f23-b74d-a79a8ce643a0",
                                        "entry_id": "e40b81f5-2641-3d9c-93b5-7d6134b5d69b",
                                        "glosses": [
                                            "Personne caractérisée par sa couardise."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191eef72-ea63-4862-8d65-25e689da1e64",
                                                "sense_id": "37d41149-9ca0-3f23-b74d-a79a8ce643a0",
                                                "text": "C’est un lâche."
                                            },
                                            {
                                                "example_id": "a3ab0303-b60a-490d-8ec9-5ed381a486b5",
                                                "sense_id": "37d41149-9ca0-3f23-b74d-a79a8ce643a0",
                                                "text": "Autour de mon tombeau les lâches se tairont."
                                            },
                                            {
                                                "example_id": "b966cb6e-50c1-4391-8211-d11196e8a65c",
                                                "sense_id": "37d41149-9ca0-3f23-b74d-a79a8ce643a0",
                                                "text": "Il y a quelque chose que je ne saurais admettre, c’est que l'on m’accuse d’avoir tué une femme que j’aimais, … je suis un assassin soit, je ne suis pas un lâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "395921d8-71db-35b2-8af9-2fe756994a44",
                                        "entry_id": "e40b81f5-2641-3d9c-93b5-7d6134b5d69b",
                                        "glosses": [
                                            "Celui qui s’attaque à plus faible que lui."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
                                    {
