                            }
                        ]
                    }
                },
                {
                    "sense_id": "524b205c-e67f-3ca2-9f6a-67f39344588f",
                    "sense_definition": "A parish priest in the Greek Orthodox Church.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers went to ask <w>Papa</w> Athanasius for his advice on the matter.",
                            "target_lang_translations": {
                                "ru": "Жители деревни пошли спросить совета у <w>отца</w> Афанасия по этому вопросу.",
                                "zh": "村民们去向<w>神父</w>阿塔纳修斯请教这件事。"
                            }
                        },
                        {
                            "text": "He served as a faithful <w>papa</w> in the local community for forty years.",
                            "target_lang_translations": {
                                "ru": "Он служил верным <w>священником</w> в местной общине в течение сорока лет.",
                                "zh": "他在当地社区担任了四十年的忠实<w>神父</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "priest"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Greek Orthodox context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приходской священник в Греческой православной церкви",
                        "zh": "希腊正教会的教区神父。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "священник",
                                "target_lang_sense_clarification": "духовное лицо"
                            },
                            {
                                "target_lang_word": "поп",
                                "target_lang_sense_clarification": "устаревшее или разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神父",
                                "target_lang_sense_clarification": "对天主教或东正教司铎的称呼"
                            }
                        ]
                    }
                }
            ]
        }
