                        "examples": [
                            {
                                "example_id": "21350ed9-2b0e-43c7-88dd-001756cd523f",
                                "sense_id": "89a5523c-b44a-33aa-8162-14918133e2b8",
                                "text": "Is the Minister in a position to give the results of ithe Garda investigation of the two latest allegations of deliberate crossings and craterings of Irish roads?"
                            },
                            {
                                "example_id": "3c719257-271d-46ca-87ae-a7d785f77aab",
                                "sense_id": "89a5523c-b44a-33aa-8162-14918133e2b8",
                                "text": "Major craterings are quite apparent on the older and non-reworked faces of the other planets and their satellites."
                            },
                            {
                                "example_id": "e434b67f-1a8f-41ef-a3c5-6e31645721af",
                                "sense_id": "89a5523c-b44a-33aa-8162-14918133e2b8",
                                "text": "Many of the building fronts bore the pockmarks of rifle or machine gun fire; a few showed the larger craterings of aircraft cannon, and an occasional pile of nibble showed the effects of artillery or bombs."
                            },
                            {
                                "example_id": "df82f993-0505-4e2c-aeec-16fab46a01de",
                                "sense_id": "89a5523c-b44a-33aa-8162-14918133e2b8",
                                "text": "The moon also hangs as an inhospitable, cold companion in the night, a grim ball that shows many signs of craterings on its surface but not the great number we see now."
                            }
                        ]
                    }
