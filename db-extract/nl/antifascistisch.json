                            {
                                "example_id": "2d944109-0ae1-45ed-a43b-cc5815c1599d",
                                "sense_id": "cba2a4f5-67c6-3ed4-8d4a-ebeb2c78bb79",
                                "text": "RTV Oost meldt dat een Russische rapgroep afgelopen weekend tijdens een antifascistisch festival in Duitsland opgeroepen heeft naar Enschede te komen om ook te demonstreren tegen Pegida. Met een spandoek op het podium wordt gezegd om in verzet te komen."
                            },
                            {
                                "example_id": "2601a864-bf87-4aaa-963c-2430d8ce43dc",
                                "sense_id": "cba2a4f5-67c6-3ed4-8d4a-ebeb2c78bb79",
                                "text": "De dreiging vanuit deze groepen is gering. Door de tegenreactie van groepen met een antifascistisch gedachtengoed lijkt de dreiging vaak groter."
                            }
                        ]
                    }
