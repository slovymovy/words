                ],
                "senses": [
                    {
                        "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                        "entry_id": "8a9a33c4-99e4-3ac9-9f44-6cd4adcb189c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "719693f7-842d-40cb-ad64-d57c12881add",
                                "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                                "text": "Frau Gidion ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c30e1fa2-08f4-478b-9406-5a2ed21640f2",
                                "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                                "text": "Herr Gidion wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8969c343-51dd-49cb-bfc7-bb728fe24f2a",
                                "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                                "text": "Die Gidions fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4a3e0ed7-4ec8-4d81-bcfc-9a27f2444210",
                                "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                                "text": "Der Gidion trägt nie die Schals, die die Gidion ihm strickt."
                            },
                            {
                                "example_id": "9eb70f79-2fd8-4b44-950b-6e185a9be47a",
                                "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gidion kommt, geht der Herr Gidion.“"
                            },
                            {
                                "example_id": "aa07c606-e8fb-4c18-88da-2b396825946d",
                                "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                                "text": "Gidion kommt und geht."
                            },
                            {
                                "example_id": "5adb655d-21cf-436c-bcfb-fab35f54c1f0",
                                "sense_id": "1da8087a-dbfd-3758-95a6-0b6b419f9769",
                                "text": "Gidions kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
