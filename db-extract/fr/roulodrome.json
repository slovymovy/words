                    {
                        "sense_id": "6139664d-60dd-343f-834a-e3e91a733c0a",
                        "entry_id": "49c98c0e-3b2f-3cde-913e-46cc67d7de83",
                        "glosses": [
                            "Aire sportive dédiée à la pratique de la planche à roulettes ou skateboard, et au patin à roulettes."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "a875abd3-96df-455f-a950-20385706d473",
                                "sense_id": "6139664d-60dd-343f-834a-e3e91a733c0a",
                                "text": "Et les idées originales n’ont pas manqué, de l’hôtel au-dessus de la station de métro au roulodrome autour du «Big O», en passant par l’abandon du toit pour le Stade ou son utilisation pour des compétitions de ski."
                            },
                            {
                                "example_id": "40d57b18-4759-484a-9b77-737062a0a96e",
                                "sense_id": "6139664d-60dd-343f-834a-e3e91a733c0a",
                                "text": "Neuf ans plus tard, le roulodrome rouvre ses portes dans le quartier Saint-Michel."
                            },
                            {
                                "example_id": "fbbab391-a36f-4510-807d-167bfe0a0cb0",
                                "sense_id": "6139664d-60dd-343f-834a-e3e91a733c0a",
                                "text": "Depuis 1996, celui-ci hébergeait un skatepark et roulodrome intérieur, le Tazmahal, affectueusement surnommé Taz par ses fans."
                            }
                        ]
                    }
