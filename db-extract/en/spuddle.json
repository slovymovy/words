    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b7211bd4-e015-3261-b289-8be59a8a4357",
                "word": "spuddle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a9dc0503-d8af-409e-8f97-c3a8cca15ade",
                        "entry_id": "b7211bd4-e015-3261-b289-8be59a8a4357",
                        "tags": [
                            "plural"
                        ],
                        "form": "spuddles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "930aeb07-7b52-3840-bd83-8db015c8f443",
                        "entry_id": "b7211bd4-e015-3261-b289-8be59a8a4357",
                        "glosses": [
                            "A mess or confusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1443a7f5-4c0c-4caf-9f27-41e6c58abf7a",
                                "sense_id": "930aeb07-7b52-3840-bd83-8db015c8f443",
                                "text": "There you go again, making spuddle of whatever I say."
                            },
                            {
                                "example_id": "1a0a2e5a-90a6-422c-99f5-ba8a9d4568b8",
                                "sense_id": "930aeb07-7b52-3840-bd83-8db015c8f443",
                                "text": "All we utter thus when bakelite spuddle Steamified and scorchy Make of our tongue a fat Q."
                            },
                            {
                                "example_id": "6a6432ab-c812-4aba-bc8e-1e8965a84e85",
                                "sense_id": "930aeb07-7b52-3840-bd83-8db015c8f443",
                                "text": "Better to break out and seek progression. You don't want to be a spuddle."
                            }
                        ]
                    },
                    {
                        "sense_id": "462c9fb7-b0dd-3580-b33e-de9f0b270f35",
                        "entry_id": "b7211bd4-e015-3261-b289-8be59a8a4357",
                        "glosses": [
                            "An argument or dispute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24103761-99a3-4717-9a71-3565914a1445",
                                "sense_id": "462c9fb7-b0dd-3580-b33e-de9f0b270f35",
                                "text": "They had a right spuddle together — poor maid was crying, like, and then ' e made off."
                            },
                            {
                                "example_id": "21753755-01c5-4a25-b788-eab755520883",
                                "sense_id": "462c9fb7-b0dd-3580-b33e-de9f0b270f35",
                                "text": "Tis you they fear for spinshine and for spuddle"
                            },
                            {
                                "example_id": "4fa4a391-65b1-4b28-94ec-ed7d160adb15",
                                "sense_id": "462c9fb7-b0dd-3580-b33e-de9f0b270f35",
                                "text": "Us'll have a proper spuddle bevore us is done, you see if I baint right, sir!'"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0747e170-b43b-3e57-b6c0-9f2f170a03f9",
                "word": "spuddle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9a321f90-67eb-4e40-a1a4-e738e4ae28df",
                        "entry_id": "0747e170-b43b-3e57-b6c0-9f2f170a03f9",
                        "tags": [
                            "plural"
                        ],
                        "form": "spuddles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0db91843-3830-3432-a72b-5b484d9fc694",
                        "entry_id": "0747e170-b43b-3e57-b6c0-9f2f170a03f9",
                        "glosses": [
                            "A patch of wet mud or similar substance, more viscous than a puddle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb0cf49b-73de-4ed8-aba9-066a6a36a4c9",
                                "sense_id": "0db91843-3830-3432-a72b-5b484d9fc694",
                                "text": "'Twuz tit fer tat sure, in a spuddle uv mud , And everything plastered all over with blood."
                            },
                            {
                                "example_id": "cd174cbb-ae17-453c-bdb2-df9d79426589",
                                "sense_id": "0db91843-3830-3432-a72b-5b484d9fc694",
                                "text": "In puddle and spuddle They staggered."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c8549d8-ce25-32ef-bc99-2c18d3e63e94",
                        "entry_id": "0747e170-b43b-3e57-b6c0-9f2f170a03f9",
                        "glosses": [
                            "A process combining spraying and puddling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1fd964-3eea-4737-8b85-869d86df2ec1",
                                "sense_id": "1c8549d8-ce25-32ef-bc99-2c18d3e63e94",
                                "text": "A steady stream rather than a mist may be projected onto the wafer, or dispense may occur without rotation to form a “puddle.\" There is also a combination puddle and spray technique called “spuddle” developing."
                            },
                            {
                                "example_id": "72fb0148-2536-416b-84bb-2f69a789f8cd",
                                "sense_id": "1c8549d8-ce25-32ef-bc99-2c18d3e63e94",
                                "text": "First, a screening trial using the same develop and etch times and half the reagent volumes of the established \"spuddle\" process performed on an APT model 9145 machine which serves as a reference method."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                "word": "spuddle",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "52982ba6-5490-4fd7-b11a-72120ab4ff7a",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "spuddles"
                    },
                    {
                        "form_id": "139b9066-a7b4-450f-907d-65383128dede",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "spuddling"
                    },
                    {
                        "form_id": "25b3c253-979c-4fc1-a28e-225b9c9bdaa2",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "spuddled"
                    },
                    {
                        "form_id": "fd9464f9-30ac-459c-b973-e2c4911eadb2",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "tags": [
                            "past"
                        ],
                        "form": "spuddled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a42d2df-3db9-36ec-99fb-d3b0a82aaaaa",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "glosses": [
                            "To loosen and dig up stubble and weeds left after a harvest with a broadshare or similar device."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f53c19d5-e392-419a-a094-c94fbb924b40",
                                "sense_id": "7a42d2df-3db9-36ec-99fb-d3b0a82aaaaa",
                                "text": "Do you shim those stubbles before ploughing? Answer. No; but I spuddle them, to make the ground as clean as possible. Spuddling is performed with the plough, and is of the nature of shiming."
                            },
                            {
                                "example_id": "8c70f591-6727-4a4c-b090-3f2b30bcd955",
                                "sense_id": "7a42d2df-3db9-36ec-99fb-d3b0a82aaaaa",
                                "text": "In order to destroy what few weeds may remain in the rows, and to give that part of the ground its due share of pulverization, and to cleanse it from the bean haulm, a plough is set to work soon after harvest, to spuddle the gratten; and for this purpose a plate of iron is fixed across the share at about four or five inches from the point, and the same axletree and wheels are made use of that were before employed for striking out the furrows; and with this plough and two horses, three acres of ground may be spuddled in a day, by setting the share point in the interval, so that the iron or fin may embrace a row on each side; and when the whole field is thus spuddled, the harrows and roll are to succeed, by which the haulm and weeds will be completely extricated at a trifling charge, and the ground be laid in readiness for ploughing the seed furrows, at which time those beans or pease which may have been shed, will have vegetated, and are destroyed by the plough; so that the farmer may from this mode of husbandry be not less confident of growing a clean sample of wheat, than if his ground had been summer fallowed."
                            },
                            {
                                "example_id": "443016e6-a6c5-4b61-8e6a-4d5bb4cd8dce",
                                "sense_id": "7a42d2df-3db9-36ec-99fb-d3b0a82aaaaa",
                                "text": "When land proves to be very foul after harvest, it is best, first to shallow, spuddle, or broadshare the surface, harrow up the weeds, cart them to a mixen, or burn them on the spot:"
                            },
                            {
                                "example_id": "9e83da1a-6209-44e5-bd9b-748ac8bae913",
                                "sense_id": "7a42d2df-3db9-36ec-99fb-d3b0a82aaaaa",
                                "text": "Thus the Kent farmer with his long-cherished wooden plough, for which he has been the recipient of much ridicule, converts this same wooden plough into a broadshare as soon as his corn is cut, and with this ancient implement proceeds to “broadshare“ spuddle his stubbles."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6a9c7b5-81f6-3260-a59c-282ed3d01dde",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "glosses": [
                            "To shallowly dig or stir up in an unsystematic manner."
                        ],
                        "tags": [
                            "broadly",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "0a977502-256b-4823-866c-7939e75b05a3",
                                "sense_id": "d6a9c7b5-81f6-3260-a59c-282ed3d01dde",
                                "text": "Instead of an \"occasional gardener\" to trim up the walks, and to hoe, your wife will be as happy as a queen, and your daughters as princesses, to spuddle about now and then, and have little flower gardens, and herb beds."
                            },
                            {
                                "example_id": "3ab9c259-a3d8-4313-ac42-8822e3e57790",
                                "sense_id": "d6a9c7b5-81f6-3260-a59c-282ed3d01dde",
                                "text": "Hee grubs and spuddles for his prey in muddy holes and obscure cauernes, my Mufe ferrits base debaushed wretches in their swinish dens."
                            },
                            {
                                "example_id": "72032800-0e5d-4572-b9f9-847c5747f46a",
                                "sense_id": "d6a9c7b5-81f6-3260-a59c-282ed3d01dde",
                                "text": "Leviathan fouls and spuddles again my possessions and my father's house"
                            },
                            {
                                "example_id": "2b56a502-769d-46c8-97d2-90e0c856cb7f",
                                "sense_id": "d6a9c7b5-81f6-3260-a59c-282ed3d01dde",
                                "text": "And they say that in the very place where the child spuddled with his feet, the water flowed out."
                            },
                            {
                                "example_id": "c1b591c0-5679-491f-93f5-0733fedd3f29",
                                "sense_id": "d6a9c7b5-81f6-3260-a59c-282ed3d01dde",
                                "text": "Molehills had to be spuddled."
                            }
                        ]
                    },
                    {
                        "sense_id": "732296b4-9004-31db-8b8b-fcde4adbfa26",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "glosses": [
                            "To make a lot of fuss about trivial things, as if they were important"
                        ],
                        "tags": [
                            "Southern-England",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "501558af-06d9-431f-b330-d629a55fd070",
                                "sense_id": "732296b4-9004-31db-8b8b-fcde4adbfa26",
                                "text": "During all the years that I spuddled around in a porcelain bath tub in a city I was given to regarding the farmer somewhat as the caricaturist, who wears his spring overcoat all winter and sells jokes for 10 cents each to the newspapers, painted him."
                            }
                        ]
                    },
                    {
                        "sense_id": "e79ce185-1a24-3312-9650-016b55e0e2e2",
                        "entry_id": "373f24cd-f49e-3a2f-be29-f6136a5fefb4",
                        "glosses": [
                            "To work ineffectively; to work hard but achieve nothing"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b46a2337-0efa-4c5b-8330-dfd85db2e2af",
                                "sense_id": "e79ce185-1a24-3312-9650-016b55e0e2e2",
                                "text": "In what glooın are you all left to spuddle out your way through the road of life?"
                            },
                            {
                                "example_id": "f403be76-1642-4aec-b9d1-d572a58e9482",
                                "sense_id": "e79ce185-1a24-3312-9650-016b55e0e2e2",
                                "text": "Why you do spuddle So weak's a child. How you do muddle! Gi'e me the speäde."
                            },
                            {
                                "example_id": "2f6ed294-5c8c-449e-ab0a-34a4f685a74c",
                                "sense_id": "e79ce185-1a24-3312-9650-016b55e0e2e2",
                                "text": "\"There! that's how she do bide an' spuddle about,\" said Uncle Granger contemptuously."
                            },
                            {
                                "example_id": "2f05570a-2d8c-4bbd-805d-be9b13adae6e",
                                "sense_id": "e79ce185-1a24-3312-9650-016b55e0e2e2",
                                "text": "Unless you own the land you are not free to grow things where you like, to make mistakes, to spuddle about, as my cousin puts it."
                            }
                        ]
                    }
                ],
