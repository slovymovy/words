                "senses": [
                    {
                        "sense_id": "dab8edf3-e2f7-3e4b-8c8c-9774e3da583e",
                        "entry_id": "a241a5d6-7d62-3eaa-9217-68789ac0292c",
                        "glosses": [
                            "Person, die keine Veränderungen mag und deren Lebensweise von Gewohnheiten geprägt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4d3ea1-1c08-47d8-959d-17cec5c97028",
                                "sense_id": "dab8edf3-e2f7-3e4b-8c8c-9774e3da583e",
                                "text": "Ich gehe jeden Freitag in die Sauna, da bin ich ein Gewohnheitstier."
                            },
                            {
                                "example_id": "c3f4caab-5e7c-406a-8def-dec7ed8ababa",
                                "sense_id": "dab8edf3-e2f7-3e4b-8c8c-9774e3da583e",
                                "text": "„Was den Bundesbürger, ganz Gewohnheitstier, nicht davon abhält, sich im „WSS“ ordentlich einzudecken.“"
                            },
                            {
                                "example_id": "f7357853-d688-44dc-a4f5-82ba32f82cb8",
                                "sense_id": "dab8edf3-e2f7-3e4b-8c8c-9774e3da583e",
                                "text": "„Insgesamt hält [der Philosoph Kwame Anthony] Appiah den Menschen für ein Gewohnheitstier - rationale Argumente haben nachweislich weniger Einfluss auf seine Meinungen als das, woran er gewöhnt ist.“"
                            },
                            {
                                "example_id": "729f6798-21ca-4767-b3dd-478f1a803a2d",
                                "sense_id": "dab8edf3-e2f7-3e4b-8c8c-9774e3da583e",
                                "text": "„Indem sie einen Garagentoröffner mit Smartphone-Technologie kombiniert, verschafft sie grübelnden Gewohnheitstieren Seelenfrieden auf Knopfdruck.“"
                            },
                            {
                                "example_id": "e9ee0ed0-5e22-4c3f-a20b-55168b967199",
                                "sense_id": "dab8edf3-e2f7-3e4b-8c8c-9774e3da583e",
                                "text": "„Als altes Gewohnheitstier stürzte sich mein Vater in die gewohnte Routine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
