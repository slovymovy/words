                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rijkdom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De piraten zochten op het eiland naar verborgen <w>schatten</w>.",
                            "target_lang_translations": {
                                "en": "The pirates searched the island for hidden <w>treasures</w>."
                            }
