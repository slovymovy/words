                "senses": [
                    {
                        "sense_id": "7ace8b28-dc89-305e-8c21-a7dedc393345",
                        "entry_id": "379f1c38-0b3b-395d-a730-a4b2f6e81884",
                        "glosses": [
                            "Qui est plongé dans le sommeil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d94a25b-4220-4295-a91c-ae76d0f564aa",
                                "sense_id": "7ace8b28-dc89-305e-8c21-a7dedc393345",
                                "text": "En te quittant, je suis allée vers le lac ensommeillé où la ruine se mire."
                            },
                            {
                                "example_id": "47198df4-2a15-49e2-82ca-71648140347e",
                                "sense_id": "7ace8b28-dc89-305e-8c21-a7dedc393345",
                                "text": "Je suis encore tout ensommeillé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43040535-4531-401b-8f94-46a5227270c5",
                        "source_entry_id": "379f1c38-0b3b-395d-a730-a4b2f6e81884",
                        "source_sense_id": "7ace8b28-dc89-305e-8c21-a7dedc393345",
                        "target_lang_word": "asleep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asleep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d703fc07-1016-3d86-adbc-676c0acbae09",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "In a state of sleep; also, broadly, resting."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631d98ea-1add-4c7c-bbc8-467ef0ae47b4",
                                                "sense_id": "d703fc07-1016-3d86-adbc-676c0acbae09",
                                                "text": "I was asleep when you called."
                                            },
                                            {
                                                "example_id": "d0a4fbae-6cf6-4383-a3dc-3763123dfbd2",
                                                "sense_id": "d703fc07-1016-3d86-adbc-676c0acbae09",
                                                "text": "Never disturb a man asleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e8d9321-ee37-39e7-bdd0-d8cbaddaf3d1",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "Inattentive."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d33089-b93f-4492-80ad-4524a60616f8",
                                                "sense_id": "7e8d9321-ee37-39e7-bdd0-d8cbaddaf3d1",
                                                "text": "How could you miss that? Were you asleep?"
                                            },
                                            {
                                                "example_id": "50f534e0-2684-406b-b11c-f56e0e54b6d2",
                                                "sense_id": "7e8d9321-ee37-39e7-bdd0-d8cbaddaf3d1",
                                                "text": "The reason they call it the American Dream is because you have to be asleep to believe it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85434181-347f-3bac-b331-4b452ef54c3c",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "Having a numb or prickling sensation accompanied by a degree of unresponsiveness."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91da21f3-7f22-4ee1-9904-05882f2206d0",
                                                "sense_id": "85434181-347f-3bac-b331-4b452ef54c3c",
                                                "text": "My arm fell asleep. You know, like pins and needles."
                                            },
                                            {
                                                "example_id": "3fe2ad7f-4279-469e-81e3-4d9f6982ef4c",
                                                "sense_id": "85434181-347f-3bac-b331-4b452ef54c3c",
                                                "text": "Louisa sat in the car crying, until her foot fell asleep. She shook her foot violently, afraid the numbness would turn to frostbite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca9549f-2ec5-38bc-885d-f46160d71dbe",
                                        "entry_id": "604390c0-8675-3f17-8b04-29c1f5b170ba",
                                        "glosses": [
                                            "Dead."
                                        ],
