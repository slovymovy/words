                    },
                    {
                        "translation_id": "3cdc2e26-9b38-4246-9de5-37801f0d3e7f",
                        "source_entry_id": "e6ffb167-f122-30a1-9255-7575f9e39ef4",
                        "source_sense_id": "8095da2f-e2b8-3796-9865-5f095d281bdd",
                        "source_sense_description": "causing the destruction of liberty",
