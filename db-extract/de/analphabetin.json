                ],
                "senses": [
                    {
                        "sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                        "entry_id": "4f3182d8-5ab1-3155-a594-bd6f17ac987f",
                        "glosses": [
                            "weibliche Person, die nicht lesen und schreiben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1926dbe1-913d-4e70-9965-e48b0677c2f8",
                                "sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                                "text": "Silke ist eine Analphabetin und kann deshalb keine Bücher lesen."
                            },
                            {
                                "example_id": "5b09d72d-6a25-48df-8c54-ffdfc0e12ff1",
                                "sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                                "text": "Das Bildungsministerium plant die Einrichtung einer Schule für Analphabetinnen."
                            },
                            {
                                "example_id": "b7107775-9b6b-468c-b064-f6c263604677",
                                "sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                                "text": "„Als Analphabetin ist sie nach Deutschland gekommen, nie länger zur Schule gegangen.“"
                            },
                            {
                                "example_id": "8f4ceb0f-ee94-4c29-923d-b0b92df09b29",
                                "sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                                "text": "„Beide waren Analphabetinnen.“"
                            },
                            {
                                "example_id": "e95f1e98-c49d-4baf-bebf-b0ef03fe2ec4",
                                "sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                                "text": "„Nach wie vor sind die Frauen hier besonders benachteiligt, doch die Zahl der Analphabetinnen, die 1991 noch etwa 60 Prozent betrug, ist auf 46 Prozent zurückgegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79dd72c6-9072-4175-8c3c-d83f42c9c730",
                        "source_entry_id": "4f3182d8-5ab1-3155-a594-bd6f17ac987f",
                        "source_sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                        "source_sense_description": "weibliche Person, die nicht lesen und schreiben kann",
                        "target_lang_word": "illiterate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illiterate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8740357-1a38-3fd9-9c75-5f8b7c7d8a98",
                                        "entry_id": "183470c1-b1f5-3437-b62a-dd23960ba9a0",
                                        "glosses": [
                                            "Unable to read and write."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "169dc28f-a5d6-4e03-b3b4-144d9491ad5a",
                                                "sense_id": "c8740357-1a38-3fd9-9c75-5f8b7c7d8a98",
                                                "text": "About half of the population in Ethiopia is illiterate."
                                            },
                                            {
                                                "example_id": "f93b4576-309d-4291-b858-e5d544c6de59",
                                                "sense_id": "c8740357-1a38-3fd9-9c75-5f8b7c7d8a98",
                                                "text": "If publique Aſſemblies of Divines cannot agree upon a right vvay, private Conventicles of illeterate men, vvill ſoon finde a vvrong. Bivious demurres breed devious reſolutions. Paſſengers to heaven are in haſte, and vvill vvalk one vvay or other."
                                            },
                                            {
                                                "example_id": "16da4b06-09bc-4e78-948e-a796b9a67e8c",
                                                "sense_id": "c8740357-1a38-3fd9-9c75-5f8b7c7d8a98",
                                                "text": "Not always does this ruse succeed however. The railways have undertaken publicity warning passengers about it, and have made a big difference in the appearance of long distance and short distance tickets, so that the most illiterate person can see the distinction. Some of these swindlers have been caught."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fc62254-a942-3929-a1f1-a695ad52d00e",
                                        "entry_id": "183470c1-b1f5-3437-b62a-dd23960ba9a0",
                                        "glosses": [
                                            "Having less than an expected standard of familiarity with language and literature, or having little formal education."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b817d17d-53d6-4525-9fc8-7c15780cbe06",
                                                "sense_id": "4fc62254-a942-3929-a1f1-a695ad52d00e",
                                                "text": "Ignorant and ſuperſtitious wretches meaſure the actions of letterd and philoſophical men by the tattle of their nurſes or illiterate parents and companions, or by the faſhion of the country : and people of differing religions judge and condemn each other by their own tenents ; when both of them cannot be in the right, and it is well if either of them are."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82b2ef5c-bf01-372b-8f9f-0df012ddf05e",
                                        "entry_id": "183470c1-b1f5-3437-b62a-dd23960ba9a0",
                                        "glosses": [
                                            "Not conforming to prescribed standards of speech or writing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a7152b-92be-4bcf-a905-5d0ba05b85cf",
                                                "sense_id": "82b2ef5c-bf01-372b-8f9f-0df012ddf05e",
                                                "text": "Now (exc. in Nautical language, see b) it is only dialectal or an illiterate substitute for lie, its identity of form with the past tense of the latter no doubt accounting largely for the confusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714626c9-8fd2-35b5-af10-eaf4c5dce46e",
                                        "entry_id": "183470c1-b1f5-3437-b62a-dd23960ba9a0",
                                        "glosses": [
                                            "Ignorant in a specified way or about a specified subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a061192-7582-4138-98e5-a8602ff84237",
                                                "sense_id": "714626c9-8fd2-35b5-af10-eaf4c5dce46e",
                                                "text": "economically illiterate, emotionally illiterate"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "illiterate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7ff095-a2c4-3237-8a56-53b0c244da25",
                                        "entry_id": "31202d30-1edd-3e6d-95c9-4a2bf5bc3cde",
                                        "glosses": [
                                            "An illiterate person, one either not able to read and write or not knowing how."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d80800-18bd-4957-8717-fbe844406269",
                                                "sense_id": "2e7ff095-a2c4-3237-8a56-53b0c244da25",
                                                "text": "We might also provide education plus reading and writing services to adult illiterates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a353b8d-a056-30f1-9257-818f7517a0d9",
                                        "entry_id": "31202d30-1edd-3e6d-95c9-4a2bf5bc3cde",
                                        "glosses": [
                                            "A person ignorant about a given subject. (The relevant subject is usually named as a noun adjunct.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b152a0a3-c008-4e3a-b99b-ab2a18783713",
                                                "sense_id": "0a353b8d-a056-30f1-9257-818f7517a0d9",
                                                "text": "Their government is run by business illiterates."
                                            },
                                            {
                                                "example_id": "45c4abc6-6f2c-4a90-ab59-d7c604134d85",
                                                "sense_id": "0a353b8d-a056-30f1-9257-818f7517a0d9",
                                                "text": "Sometimes a mathematical illiterate is called an innumerate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "777a8ae0-27a6-4963-a923-bc6fe441e7ab",
                        "source_entry_id": "4f3182d8-5ab1-3155-a594-bd6f17ac987f",
                        "source_sense_id": "6bbf41da-2fa1-35f9-8a50-34436ac33f30",
                        "source_sense_description": "weibliche Person, die nicht lesen und schreiben kann",
                        "target_lang_word": "analphabète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analphabète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36bec8a2-9bcf-358a-ba84-458668ea39fc",
                                        "entry_id": "fa4e6931-2e60-3955-9de1-0c38e86ed585",
                                        "glosses": [
                                            "Qui ne sait ni lire ni écrire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ce5a43a-798e-4447-bae0-fb7c50cfc5cb",
                                                "sense_id": "36bec8a2-9bcf-358a-ba84-458668ea39fc",
                                                "text": "Et la culture d'un peuple analphabète, ce sont ses chansons, ses légendes et ses contes."
                                            },
                                            {
                                                "example_id": "350ce1cf-d267-4ae1-a641-0219b4135e2f",
                                                "sense_id": "36bec8a2-9bcf-358a-ba84-458668ea39fc",
                                                "text": "Alors qu’il est analphabète et ne possède pas d’ordinateur, que le représentant du fournisseur, la société X, lui a indiqué qu’il s’engageait pour la création d’un site Internet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d8f0cb-09e1-33da-87f4-d73ee9f286bf",
                                        "entry_id": "fa4e6931-2e60-3955-9de1-0c38e86ed585",
                                        "glosses": [
                                            "Ignare, qui ne sait rien."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce0bc385-ebb4-4a16-8f96-92e971e486b1",
                                                "sense_id": "69d8f0cb-09e1-33da-87f4-d73ee9f286bf",
                                                "text": "Analphabète pluridisciplinaire, il s’évertue tout de même à se donner une contenance à la hauteur de sa fortune."
                                            },
                                            {
                                                "example_id": "16f3d9df-63dd-4722-9f96-94cdf875dc60",
                                                "sense_id": "69d8f0cb-09e1-33da-87f4-d73ee9f286bf",
                                                "text": "Un idiot, un gros moche, un tas analphabète sur lequel crachent même les boudins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "analphabète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a214e346-c5f2-3a8e-a4ee-42bf27477b6f",
                                        "entry_id": "fb3134c6-07e2-340d-9db2-f99a88bb7464",
                                        "glosses": [
                                            "Personne qui ne sait ni lire ni écrire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5abf6ff7-4756-4cf1-8974-4eb12f1b30ae",
                                                "sense_id": "a214e346-c5f2-3a8e-a4ee-42bf27477b6f",
                                                "text": "J’étais un analphabète. Je voulais m’instruire. J’en avais marre de pas lire ni écrire, alors j’ai décidé de venir m’autodidacter à Paris."
                                            }
                                        ]
                                    },
