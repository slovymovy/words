                                            {
                                                "example_id": "24fe4dc0-35e5-408d-b7ce-44223d03dbe8",
                                                "sense_id": "fbe3b08f-1c57-3133-ace0-cce4f88007cc",
                                                "text": "Here is a nice state of affairs. I, at my age, to fall a victim to this modern Circe!"
