                    {
                        "sense_id": "d96de601-f9ed-3122-972b-e3d51e0e3542",
                        "entry_id": "f4451f52-e437-3436-9585-d7973c78d836",
                        "glosses": [
                            "Appareil pour mesurer la teneur en glucides d’un liquide, aréomètre qui mesure la quantité de sucre des moûts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f28cb1-53b3-4014-a6bf-23569f5b4019",
                                "sense_id": "d96de601-f9ed-3122-972b-e3d51e0e3542",
                                "text": "La plupart du temps, la publicité qu’on lit aux carrefours, dans les bourgs, concerne des calcimètres, des acidimètres, des vinoscopes, des glucomètres, des pèse-moûts, des vinomètres, des mustimètres, des ébullioscopes, […] des guanos, des superphosphates, des acides tartriques, des tannins, des adhésols, des tétracuprites, des pyralumnols…"
                            }
                        ]
                    },
                    {
                        "sense_id": "ea08e75c-bffb-3728-a020-cf327b16afac",
                        "entry_id": "f4451f52-e437-3436-9585-d7973c78d836",
                        "glosses": [
                            "Instrument de mesure qui permet de connaître le taux de glucose dans le sang."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f6570311-9e71-4290-acc6-ab38811e9cc7",
                                "sense_id": "ea08e75c-bffb-3728-a020-cf327b16afac",
                                "text": "La plupart des glucomètres fonctionnent à l’aide d’une aiguille que l’on pique au bout d’un doigt."
                            }
                        ]
                    }
                ],
