{
    "word_family": [
        "aliasing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e1e9ecc-3380-3f71-8701-9d847bd06f1f",
                    "sense_definition": "An assumed or additional name used by a person to hide their identity or for convenience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alternative name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous spy traveled across Europe using a clever <w>alias</w> to avoid detection.",
                            "target_lang_translations": {
                                "ru": "Знаменитый шпион путешествовал по Европе, используя хитроумный <w>псевдоним</w>, чтобы избежать обнаружения."
                            }
                        },
                        {
                            "text": "He decided to use an <w>alias</w> when posting comments on the controversial internet forum.",
                            "target_lang_translations": {
                                "ru": "Он решил использовать <w>вымышленное имя</w>, когда оставлял комментарии на скандальном интернет-форуме."
                            }
                        }
                    ],
                    "synonyms": [
                        "pseudonym"
                    ],
                    "common_phrases": [
                        "use an alias",
                        "under an alias",
                        "assumed alias"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленное или дополнительное имя, используемое человеком для сокрытия своей личности или для удобства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "псевдоним",
                                "target_lang_sense_clarification": "вымышленное имя"
                            },
                            {
                                "target_lang_word": "вымышленное имя",
                                "target_lang_sense_clarification": "имя для сокрытия личности"
                            },
                            {
                                "target_lang_word": "кличка",
                                "target_lang_sense_clarification": "конспиративное или уличное имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c1240ab-1ca5-3fdc-ae65-82d88a231585",
                    "sense_definition": "A short command or abbreviation that represents a longer string of commands in computing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I created a shell <w>alias</w> to quickly navigate to my most used project directory.",
                            "target_lang_translations": {
                                "ru": "Я создал <w>алиас</w> в оболочке, чтобы быстро переходить в наиболее часто используемую директорию проекта."
                            }
                        },
                        {
                            "text": "You can set an <w>alias</w> for that long email address to save time when typing.",
                            "target_lang_translations": {
                                "ru": "Вы можете установить <w>псевдоним</w> для этого длинного адреса электронной почты, чтобы сэкономить время при наборе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "set an alias",
                        "command alias",
                        "email alias"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая команда или аббревиатура, представляющая более длинную строку команд в вычислительной технике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алиас",
                                "target_lang_sense_clarification": "в ИТ и программировании"
                            },
                            {
                                "target_lang_word": "псевдоним",
                                "target_lang_sense_clarification": "альтернативное имя команды или адреса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba1d752d-cec8-3c83-8de0-459547c73924",
                    "sense_definition": "A false signal or distortion that occurs when a signal is sampled at an insufficient rate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "signal processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jagged edges in the digital image were caused by a visual <w>alias</w> during the rendering process.",
                            "target_lang_translations": {
                                "ru": "Зубчатые края на цифровом изображении были вызваны визуальным <w>искажением</w> в процессе рендеринга."
                            }
                        },
                        {
                            "text": "Engineers must use filters to prevent an <w>alias</w> from appearing in the recorded audio data.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны использовать фильтры, чтобы предотвратить появление <w>наложения частот</w> в записанных аудиоданных."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ложный сигнал или искажение, возникающее при недостаточной частоте дискретизации сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алиасинг",
                                "target_lang_sense_clarification": "эффект наложения частот"
                            },
                            {
                                "target_lang_word": "искажение",
                                "target_lang_sense_clarification": "из-за дискретизации"
                            },
                            {
                                "target_lang_word": "ступенчатость",
                                "target_lang_sense_clarification": "визуальный эффект в графике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "619eb606-ec89-30eb-b68a-9fbe5b30ecd9",
                    "sense_definition": "Used to indicate that a person is also known by another name.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alternative name",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police report identified the suspect as John Doe, <w>alias</w> 'The Shadow'.",
                            "target_lang_translations": {
                                "ru": "В полицейском отчете подозреваемый был указан как Джон Доу, <w>он же</w> «Тень»."
                            }
                        },
                        {
                            "text": "The document listed the property owner as Robert Smith, <w>alias</w> Bobby.",
                            "target_lang_translations": {
                                "ru": "В документе владелец недвижимости значился как Роберт Смит, <w>известный также как</w> Бобби."
                            }
