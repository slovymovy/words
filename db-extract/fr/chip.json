                        "source_sense_description": "Elektronik: Chip, Mikrochip",
                        "target_lang_word": "Chip",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chip",
