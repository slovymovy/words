                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My lips often <w>chap</w> when the weather gets very cold.",
                            "target_lang_translations": {
                                "ru": "Мои губы часто <w>трескаются</w>, когда погода становится очень холодной."
                            }
