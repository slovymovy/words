            {
                "entry_id": "950ce64b-3823-3d5e-91bb-dbc058d1137d",
                "word": "leman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "faeca350-733a-4a15-990f-6b728a8af631",
                        "entry_id": "950ce64b-3823-3d5e-91bb-dbc058d1137d",
                        "tags": [
