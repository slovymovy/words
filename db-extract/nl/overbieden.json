                ],
                "senses": [
                    {
                        "sense_id": "aca111b8-ef2a-3022-903f-7e1437de5200",
                        "entry_id": "fa55a9b7-4e5e-339e-bc25-6ed60c1a2fb0",
                        "glosses": [
                            "een hoger bod uitbrengen dan een ander."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6e60275a-43ce-4eb3-832a-85ed6c722e38",
                                "sense_id": "aca111b8-ef2a-3022-903f-7e1437de5200",
                                "text": "Je bent overboden en daarom gaat het huis naar de andere bieder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bc438fb-d469-40e0-9990-5b35a053f90e",
                        "source_entry_id": "fa55a9b7-4e5e-339e-bc25-6ed60c1a2fb0",
                        "source_sense_id": "aca111b8-ef2a-3022-903f-7e1437de5200",
                        "source_sense_description": "een hoger bod uitbrengen dan een ander",
                        "target_lang_word": "outbid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outbid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dac5e16-132d-3fe2-824e-a687d713f132",
                                        "entry_id": "b876aa91-3c14-3e0b-b169-5c794da9b271",
                                        "glosses": [
                                            "To bid more than (somebody else) in an auction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2bdb83a-e307-4a8b-a367-7109186ea7d6",
                                                "sense_id": "6dac5e16-132d-3fe2-824e-a687d713f132",
                                                "text": "Bengal outbidded those of Delhi; instead of searching for khalifahs for obtaining recognition, Sultan Sikandar Shah himself took the title .of Imam ul-Azam and Khalifat-ul-Muazzam."
                                            },
                                            {
                                                "example_id": "d133c7f3-dfde-44d1-bb50-8c67d8cff9f7",
                                                "sense_id": "6dac5e16-132d-3fe2-824e-a687d713f132",
                                                "text": "You must understand that there are people who strive and save their whole lives to acquire something, and when they are simply outbidded or outfoxed by me, it is not taken with a delicate smile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
