                                    {
                                        "sense_id": "0be3fe08-c80a-3e15-ad1a-8e4a3fe61f93",
                                        "entry_id": "ca5ffc12-2993-397a-b880-c7b65cd7832f",
                                        "glosses": [
                                            "Action de consacrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c839a7c-5249-4ff9-bc21-847b8fbe4747",
                                                "sense_id": "0be3fe08-c80a-3e15-ad1a-8e4a3fe61f93",
                                                "text": "Le temple ne fut dédié à son patron, saint Nicolas qu'en 1544 ; les anciennes croix de consécration sont conservées dans l'église et placées au-dessus des stations du chemin de Croix."
                                            },
                                            {
                                                "example_id": "a7cecc85-a03c-4696-a928-5ab2afb5e110",
                                                "sense_id": "0be3fe08-c80a-3e15-ad1a-8e4a3fe61f93",
                                                "text": "Bref, l'humeur était à la fête et les consécrations, encourageantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe763ce4-670e-3636-b428-3e11fdf7a7df",
                                        "entry_id": "ca5ffc12-2993-397a-b880-c7b65cd7832f",
                                        "glosses": [
                                            "Action de consacrer.",
                                            "Action par laquelle un prêtre de l'Église consacre quand il célèbre la messe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19ac39ed-2164-40dc-9758-c77fb46e4179",
                                                "sense_id": "fe763ce4-670e-3636-b428-3e11fdf7a7df",
                                                "text": "La consécration étant faite."
                                            },
                                            {
                                                "example_id": "d5d8e797-6cc6-477d-ad59-96280e8e71a3",
                                                "sense_id": "fe763ce4-670e-3636-b428-3e11fdf7a7df",
                                                "text": "Les paroles de la consécration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc59fda7-337f-36ea-ad62-a1021f4b4638",
                                        "entry_id": "ca5ffc12-2993-397a-b880-c7b65cd7832f",
                                        "glosses": [
                                            "Action de sanctionner, de rendre durable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b6f9ab-0450-4bd4-acf2-0c23bc251007",
                                                "sense_id": "fc59fda7-337f-36ea-ad62-a1021f4b4638",
                                                "text": "…ils formulèrent la proposition suivant laquelle l'obéissance au souverain, bon ou mauvais, était préférable à la fitna (anarchie, désordre). Ce qui équivalait à la consécration formelle du quiétisme politique de l'islam."
                                            },
                                            {
                                                "example_id": "52a96d4f-43a6-447d-ba7a-0045e4063cef",
                                                "sense_id": "fc59fda7-337f-36ea-ad62-a1021f4b4638",
                                                "text": "Cette loi n’a pas encore reçu la consécration de l’expérience."
                                            },
                                            {
                                                "example_id": "c1e3f95c-738d-483c-a808-3bb2b0db6da8",
                                                "sense_id": "fc59fda7-337f-36ea-ad62-a1021f4b4638",
                                                "text": "Ce mot n’a pas reçu la consécration de l’usage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
