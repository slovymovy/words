{
    "word_family": [
        "undo",
        "undoing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02d078bf-9140-32bb-a09b-da25211444d8",
                    "sense_definition": "Not completed or finished.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is still so much work left <w>undone</w> before the deadline.",
                            "target_lang_translations": {
                                "ru": "До дедлайна осталось ещё так много <w>несделанной</w> работы."
                            }
                        },
                        {
                            "text": "He felt anxious about the many chores he had left <w>undone</w>.",
                            "target_lang_translations": {
                                "ru": "Он тревожился из-за множества дел, которые оставил <w>невыполненными</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "incomplete",
                        "unfinished"
                    ],
                    "antonyms": [
                        "done",
                        "finished"
                    ],
                    "common_phrases": [
                        "left undone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не выполненный, незавершённый или оставшийся несделанным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несделанный",
                                "target_lang_sense_clarification": "о работе, задаче"
                            },
                            {
                                "target_lang_word": "невыполненный",
                                "target_lang_sense_clarification": "о задании, обещании"
                            },
                            {
                                "target_lang_word": "незавершённый",
                                "target_lang_sense_clarification": "не доведённый до конца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6b19cd4-61ff-308a-b77f-dee7f776f3a5",
                    "sense_definition": "Not fastened, tied, or buttoned.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She noticed that her shoelace was <w>undone</w>.",
                            "target_lang_translations": {
                                "ru": "Она заметила, что её шнурок <w>развязан</w>."
                            }
                        },
                        {
                            "text": "His coat was left <w>undone</w> in the cold wind.",
                            "target_lang_translations": {
                                "ru": "Его пальто было <w>расстёгнуто</w> на холодном ветру."
                            }
                        }
                    ],
                    "synonyms": [
                        "unfastened",
                        "untied"
                    ],
                    "antonyms": [
                        "fastened",
                        "tied"
                    ],
                    "common_phrases": [
                        "come undone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расстёгнутый, развязанный или не зафиксированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстёгнутый",
                                "target_lang_sense_clarification": "об одежде, пуговицах, молнии"
                            },
                            {
                                "target_lang_word": "развязанный",
                                "target_lang_sense_clarification": "о шнурках, узлах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d246ded1-124e-34ae-b318-fc689125b9a3",
                    "sense_definition": "Completely ruined or destroyed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing his entire fortune, he felt completely <w>undone</w>.",
                            "target_lang_translations": {
                                "ru": "Потеряв всё своё состояние, он почувствовал себя совершенно <w>разорённым</w>."
                            }
                        },
                        {
                            "text": "The sudden betrayal left her feeling utterly <w>undone</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапное предательство оставило её совершенно <w>сокрушённой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruined",
                        "destroyed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью разорённый, сокрушённый или сломленный морально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разорённый",
                                "target_lang_sense_clarification": "потерявший состояние, погубленный"
                            },
                            {
                                "target_lang_word": "сокрушённый",
                                "target_lang_sense_clarification": "эмоционально подавленный, сломленный"
                            },
                            {
                                "target_lang_word": "погибший",
                                "target_lang_sense_clarification": "обречённый, пропащий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3cd49c84-be60-39a0-bbd2-a61d86f25a1d",
                    "sense_definition": "The past participle of <w>undo</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The damage has already been <w>undone</w> by the repair team.",
                            "target_lang_translations": {
                                "ru": "Ущерб уже был <w>устранён</w> ремонтной бригадой."
                            }
                        },
                        {
                            "text": "All his hard work was <w>undone</w> by a single mistake.",
                            "target_lang_translations": {
                                "ru": "Весь его упорный труд был <w>сведён на нет</w> одной-единственной ошибкой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола undo (отменять, исправлять, сводить на нет)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменённый",
                                "target_lang_sense_clarification": "действие, которое обратили вспять"
                            },
                            {
                                "target_lang_word": "уничтоженный",
                                "target_lang_sense_clarification": "о результатах, сведённых на нет"
                            },
                            {
                                "target_lang_word": "исправленный",
                                "target_lang_sense_clarification": "об устранении последствий ущерба"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}