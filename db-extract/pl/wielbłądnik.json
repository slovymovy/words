                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kameltreiber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a49520-3348-37fc-bc9d-81446722b3e7",
                                        "entry_id": "5e6e951f-8576-37c2-a020-3d7b231b2291",
                                        "glosses": [
                                            "Person, die Kamele hält und bei Bedarf führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0dfa2d-6a97-49c1-bfa8-2ea64f38c67d",
                                                "sense_id": "e0a49520-3348-37fc-bc9d-81446722b3e7",
                                                "text": "„Mit sieben einheimischen Dienern und Kameltreibern, vier Pferden und vier Kamelen bricht er im November auf.“"
                                            },
                                            {
                                                "example_id": "f35fd01e-5f37-4806-8040-202cf3b001a8",
                                                "sense_id": "e0a49520-3348-37fc-bc9d-81446722b3e7",
                                                "text": "„Die Ausgabe mit dem Kameltreiber stammt ganz klar aus seinem Buch.“"
                                            },
                                            {
                                                "example_id": "08326ddc-26b8-4155-9291-cd0269650fcb",
                                                "sense_id": "e0a49520-3348-37fc-bc9d-81446722b3e7",
                                                "text": "„In diesem Moment kam der Kameltreiber zurück und versetzte dem nächsten Tier einen heftigen Hieb auf die Schnauze, zornig schnaubend zog es sich zurück.“"
                                            }
                                        ],
