                                        "entry_id": "6bcccb82-3e46-311b-9c49-4c6a812d37f8",
                                        "glosses": [
                                            "spezieller Schachzug, bei dem König und Turm eine verschränkte Bewegung ausführen"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bdf30d0-1a11-4740-88f5-cea88df68731",
                                                "sense_id": "0a382954-adeb-3b95-ba5a-3687f54d95ab",
                                                "text": "Mit der kurzen Rochade brachte der weiße Spieler seinen König in Sicherheit."
                                            },
                                            {
                                                "example_id": "a52c2e32-55b0-4854-9496-9f4a208b0661",
                                                "sense_id": "0a382954-adeb-3b95-ba5a-3687f54d95ab",
                                                "text": "„Ich kann nicht anders, als an die Rochaden des Schicksals zu denken, an die Zufälle in Raum und Zeit.“"
                                            },
                                            {
                                                "example_id": "259f4f5d-dffc-4949-b135-1d964b8ac730",
                                                "sense_id": "0a382954-adeb-3b95-ba5a-3687f54d95ab",
                                                "text": "„Sämtliche Gebäude schienen durch bösartige Rochaden ihre Position verändert zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ba7327a-7273-3dac-a4a4-033f17515f2a",
                                        "entry_id": "6bcccb82-3e46-311b-9c49-4c6a812d37f8",
                                        "glosses": [
                                            "der Wechsel einer vorgesetzten und einer nachgestellten Person in ihren Funktionen oder Ämtern"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e36c231-c62e-4c38-972c-c798190a85bb",
                                                "sense_id": "8ba7327a-7273-3dac-a4a4-033f17515f2a",
                                                "text": "Die Zukunft wird zeigen, ob diese personelle Rochade einen positiven Effekt auf die Wählergunst hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a53a82b6-df11-36fe-8164-a33fc0382e9d",
                                        "entry_id": "6bcccb82-3e46-311b-9c49-4c6a812d37f8",
                                        "glosses": [
                                            "der permanente Positionswechsel der Stürmer im Fußball und bei anderen Mannschaftsspielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3e6cc8-89e4-45a8-8035-1b54e9c44fc1",
                                                "sense_id": "a53a82b6-df11-36fe-8164-a33fc0382e9d",
                                                "text": "Die Brasilianer rissen die Zuschauer mit ihrer Sturm-Rochade zu Beifallstürmen hin."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
