            "senses": [
                {
                    "sense_id": "14dd3d34-b308-3353-adba-6ee8ac08e051",
                    "sense_definition": "Employer un moyen, une méthode ou un procédé pour parvenir à un résultat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "usage_moyen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour résoudre ce conflit persistant, ils ont préféré négocier plutôt que de <w>recourir</w> à la force."
                        },
                        {
                            "text": "Cette entreprise moderne <w>recourt</w> régulièrement aux nouvelles technologies pour optimiser sa production."
                        }
                    ],
                    "synonyms": [
                        "employer",
                        "utiliser"
                    ],
                    "common_phrases": [
                        "recourir à la force",
                        "recourir à la violence",
                        "recourir aux grands moyens"
                    ]
                },
                {
                    "sense_id": "8310628b-b67b-3c73-96cd-0b022ac1cc36",
                    "sense_definition": "S'adresser à une personne ou à une autorité pour lui demander de l'aide, du secours ou des conseils.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aide_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à ces démarches administratives complexes, il a dû <w>recourir</w> à un avocat spécialisé."
                        },
                        {
                            "text": "Quand elle rencontrait des difficultés personnelles, elle <w>recourait</w> toujours à ses amis d'enfance."
                        }
                    ],
                    "synonyms": [
                        "s'adresser"
                    ],
                    "common_phrases": [
                        "recourir à un avocat",
                        "recourir à un spécialiste",
                        "recourir à un expert"
                    ]
                },
                {
                    "sense_id": "e861038c-b737-3bae-b2a7-966bd742bbaf",
                    "sense_definition": "Courir de nouveau.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après s'être reposé quelques minutes à l'ombre, l'enfant s'est mis à <w>recourir</w> dans le pré."
                        },
                        {
                            "text": "Elle a couru et <w>recouru</w> toute la matinée pour retrouver son chien égaré dans le quartier."
                        }
                    ]
                },
                {
                    "sense_id": "1fa28016-6451-388d-89ce-a2118bbfce09",
                    "sense_definition": "Former un recours juridique ; se pourvoir devant une juridiction compétente.",
