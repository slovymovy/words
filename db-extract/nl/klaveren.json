                                                "sense_id": "94d30833-bc13-3ac0-a80f-314df813cd17",
                                                "text": "Ich habe Probleme mit meinem Kreuz."
                                            },
                                            {
                                                "example_id": "64d2146c-cb5b-4272-9dd4-f58c2d410013",
                                                "sense_id": "94d30833-bc13-3ac0-a80f-314df813cd17",
                                                "text": "Ah, mein Kreuz!"
                                            }
