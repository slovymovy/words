                        "glosses": [
                            "Auswahl von Medikamenten, die auf Reisen mitgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02684e3-dd01-4860-8f88-335fa2bc2382",
                                "sense_id": "4b9914f0-3ed9-3606-858d-14257161914e",
                                "text": "Mittel gegen Kopfschmerzen und Durchfall gehören in jede Reiseapotheke."
                            },
                            {
                                "example_id": "2d4e8079-d028-4d0d-ae3b-ba868fa5e801",
                                "sense_id": "4b9914f0-3ed9-3606-858d-14257161914e",
                                "text": "„Unsere Reiseapotheke ist gut gefüllt, doch Solomon möchte die gerade erstandene Flasche mit dem Elixier, das gegen Gebrechen jeder Art helfen soll, füllen und für etwaige, auf der Fahrt zu erwartende Beschwerden mitnehmen.“"
                            }
                        ],
