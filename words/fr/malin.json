{
    "word_family": [
        "malignité",
        "malignement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc9da89d-6880-33f1-8b42-fb1206b8aa3a",
                    "sense_definition": "Qui fait preuve d'intelligence, d'adresse ou de ruse pour parvenir à ses fins.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant est très <w>malin</w>, il trouve toujours une solution à ses problèmes."
                        },
                        {
                            "text": "Il est <w>malin</w> comme un singe et réussit tous ses tours d'adresse."
                        }
                    ],
                    "synonyms": [
                        "astucieux",
                        "fin",
                        "intelligent",
                        "rusé"
                    ],
                    "common_phrases": [
                        "malin comme un singe",
                        "avoir l'air malin",
                        "bien malin"
                    ]
                },
                {
                    "sense_id": "5d6bee92-7079-3b24-b4c8-d5d7ecd92927",
                    "sense_definition": "Qui manifeste une malice espiègle ou moqueuse sans intention de nuire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espieglerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle lui a adressé un regard <w>malin</w> avant de lui révéler la surprise."
                        },
                        {
                            "text": "Avec son sourire <w>malin</w>, il préparait manifestement une nouvelle plaisanterie."
                        }
                    ],
                    "synonyms": [
                        "espiègle",
                        "malicieux"
                    ],
                    "common_phrases": [
                        "regard malin",
                        "sourire malin"
                    ]
                },
                {
                    "sense_id": "2f095e68-8b6e-3558-9aee-cc1a38d50f2a",
                    "sense_definition": "Qui présente un caractère grave et dangereux, en parlant d'une maladie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analyses confirment heureusement qu'il ne s'agit pas d'une tumeur <w>maligne</w>."
                        },
                        {
                            "text": "Le médecin surveille de près cette lésion pour éviter toute évolution <w>maligne</w>."
                        }
                    ],
                    "synonyms": [
                        "malsain"
                    ],
                    "antonyms": [
                        "bénin"
                    ],
                    "common_phrases": [
                        "tumeur maligne"
                    ]
                },
                {
                    "sense_id": "29d78d90-141f-36de-9112-f305683de9c7",
                    "sense_definition": "Qui est animé d'une volonté malfaisante, diabolique ou perverse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "malveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les légendes de la région racontent qu'un esprit <w>malin</w> hante ce vieux château."
                        },
                        {
                            "text": "Il a pris un <w>malin</w> plaisir à contredire chacun de ses collègues lors de la réunion."
                        }
                    ],
                    "synonyms": [
                        "diabolique",
                        "mauvais",
                        "méchant"
                    ],
                    "common_phrases": [
                        "esprit malin",
                        "malin plaisir"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83b3e157-8bb8-3868-89a7-e6685eb78d6f",
                    "sense_definition": "Personne rusée, habile, ou qui cherche à se donner en spectacle de façon prétentieuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_rusee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de faire le <w>malin</w> et écoute attentivement les consignes de sécurité."
                        },
                        {
                            "text": "Ce garçon est un petit <w>malin</w> qui sait toujours comment éviter les corvées."
                        }
                    ],
                    "synonyms": [
                        "rusé"
                    ],
                    "common_phrases": [
                        "faire le malin",
                        "petit malin"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e111dd16-1e0d-3e19-8728-be3f33ba950d",
                    "sense_definition": "Surnom couramment donné au diable ou à Satan.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "diable",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Dans les contes populaires, le <w>Malin</w> tente les villageois avec de fausses promesses."
                        },
                        {
                            "text": "Les habitants croyaient reconnaître les ruses du <w>Malin</w> dans chaque mésaventure."
                        }
                    ]
                }
            ]
        }
    ]
}