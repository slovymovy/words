                        "source_entry_id": "cbcb8161-26cf-3242-8f2f-4acbbb330254",
                        "source_sense_id": "3e3f3633-700c-3dd1-8af0-c482a200866a",
                        "target_lang_word": "millet",
                        "target_lang_code": "en",
