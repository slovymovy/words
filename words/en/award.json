{
    "word_family": [
        "awardee",
        "awarder",
        "reward"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "559a60b9-854d-3469-a1a5-35a3a1eff1d8",
                    "sense_definition": "A prize, trophy, or honor given to someone to recognize an achievement or merit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt very proud when she received the <w>award</w> for the best student in her class.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала большую гордость, когда получила <w>награду</w> как лучшая ученица в классе."
                            }
                        },
                        {
                            "text": "The actor won a prestigious <w>award</w> for his performance in the new drama movie.",
                            "target_lang_translations": {
                                "ru": "Актер получил престижную <w>премию</w> за свою роль в новом драматическом фильме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "win an award",
                        "receive an award",
                        "prestigious award"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приз, трофей или почетный знак, вручаемый кому-либо в знак признания достижений или заслуг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "общий термин для поощрения"
                            },
                            {
                                "target_lang_word": "премия",
                                "target_lang_sense_clarification": "денежное или материальное поощрение"
                            },
                            {
                                "target_lang_word": "приз",
                                "target_lang_sense_clarification": "награда победителю в состязании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de026d99-8bca-31eb-8e39-7442be1bfdb5",
                    "sense_definition": "A grant of money or funding provided for a specific purpose, such as a research project.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university received a large research <w>award</w> to study the effects of climate change.",
                            "target_lang_translations": {
                                "ru": "Университет получил крупный исследовательский <w>грант</w> на изучение последствий изменения климата."
                            }
                        },
                        {
                            "text": "He applied for a federal <w>award</w> to help fund his scientific experiments.",
                            "target_lang_translations": {
                                "ru": "Он подал заявку на федеральную <w>субсидию</w>, чтобы помочь профинансировать свои научные эксперименты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "research award",
                        "grant award",
                        "funding award"
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежный грант или финансирование, предоставляемое для определенной цели, например, для исследовательского проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грант",
                                "target_lang_sense_clarification": "денежные средства на проект"
                            },
                            {
                                "target_lang_word": "стипендия",
                                "target_lang_sense_clarification": "финансовая поддержка обучения или исследований"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e59b728e-1f94-378d-b01b-c8ae60d87414",
                    "sense_definition": "A formal or legal decision, especially one made by a judge or arbitrator regarding money or damages.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court announced a multi-million dollar <w>award</w> to the victims of the accident.",
                            "target_lang_translations": {
                                "ru": "Суд объявил о <w>присуждении</w> многомиллионной компенсации жертвам аварии."
                            }
                        },
                        {
                            "text": "After months of mediation, the final <w>award</w> was finally signed by both parties.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев посредничества окончательное арбитражное <w>решение</w> было наконец подписано обеими сторонами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "court award",
                        "arbitration award",
                        "damage award"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное или юридическое решение, особенно вынесенное судьей или арбитром в отношении денег или возмещения ущерба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решение",
                                "target_lang_sense_clarification": "постановление суда или арбитража"
                            },
                            {
                                "target_lang_word": "присуждение",
                                "target_lang_sense_clarification": "официальное назначение выплаты или награды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71b2856c-a811-30d3-874d-826e3630e73a",
                    "sense_definition": "A legally binding document that sets out the minimum pay and working conditions for an industry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The union is negotiating a new industrial <w>award</w> to improve safety standards for workers.",
                            "target_lang_translations": {
                                "ru": "Профсоюз ведет переговоры о новом отраслевом <w>соглашении</w> для улучшения стандартов безопасности рабочих."
                            }
                        },
                        {
                            "text": "Many employees in this sector are still paid according to the minimum <w>award</w> rates.",
                            "target_lang_translations": {
                                "ru": "Многим работникам в этом секторе по-прежнему платят в соответствии с минимальными тарифными <w>ставками</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "industrial award",
                        "award rate",
                        "modern award"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридически обязательный документ, устанавливающий минимальную оплату и условия труда в определенной отрасли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отраслевое соглашение",
                                "target_lang_sense_clarification": "документ об условиях труда"
                            },
                            {
                                "target_lang_word": "тарифное соглашение",
                                "target_lang_sense_clarification": "нормы оплаты труда"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69dbf866-f76c-3076-b8e0-61e00fafd99b",
                    "sense_definition": "To officially give someone a prize, honor, or amount of money.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>award</w> the scholarship to the most hardworking applicant.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>присудить</w> стипендию самому трудолюбивому кандидату."
                            }
                        },
                        {
                            "text": "They will <w>award</w> a gold medal to the winner of the race.",
                            "target_lang_translations": {
                                "ru": "Победителю забега <w>вручат</w> золотую медаль."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestow",
                        "crown"
                    ],
                    "common_phrases": [
                        "award a prize",
                        "award a scholarship",
                        "award a contract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально вручить кому-либо приз, награду или денежную сумму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награждать",
                                "target_lang_sense_clarification": "вручать награду"
                            },
                            {
                                "target_lang_word": "присуждать",
                                "target_lang_sense_clarification": "официально назначать премию или победу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce08842e-cf28-36c7-9e33-10b6dc8f233c",
                    "sense_definition": "To grant or assign something, such as damages or a penalty, through a judicial or formal process.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury decided to <w>award</w> damages to the plaintiff after the long trial.",
                            "target_lang_translations": {
                                "ru": "Присяжные решили <w>присудить</w> возмещение убытков истцу после долгого судебного разбирательства."
                            }
                        },
                        {
                            "text": "The judge can <w>award</w> compensation if the company is found guilty of negligence.",
                            "target_lang_translations": {
                                "ru": "Судья может <w>назначить</w> компенсацию, если компания будет признана виновной в халатности."
                            }
                        }
                    ],
                    "synonyms": [
                        "adjudge"
                    ],
                    "common_phrases": [
                        "award damages",
                        "award compensation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначить или закрепить что-либо, например, возмещение ущерба или штраф, через судебный или формальный процесс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присуждать",
                                "target_lang_sense_clarification": "выносить решение о выплате компенсации"
                            },
                            {
                                "target_lang_word": "назначать",
                                "target_lang_sense_clarification": "определять размер выплаты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd659847-42d3-344c-96cc-82036f4c7992",
                    "sense_definition": "To give points or marks for a correct answer in an exam or competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher will <w>award</w> marks for showing the correct steps in the math problem.",
                            "target_lang_translations": {
                                "ru": "Учитель будет <w>начислять</w> баллы за демонстрацию правильных шагов в решении математической задачи."
                            }
                        },
                        {
                            "text": "Please do not <w>award</w> points if the student provides an incomplete answer.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>начисляйте</w> очки, если студент дает неполный ответ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "award marks",
                        "award points"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выставлять баллы или оценки за правильный ответ на экзамене или в соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начислять",
                                "target_lang_sense_clarification": "давать баллы или очки"
                            },
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "ставить оценку или баллы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}