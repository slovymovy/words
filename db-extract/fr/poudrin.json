                        "glosses": [
                            "Embruns denses ; eau pulvérisée des vagues qui se brisent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b2f925-d61f-40b3-8577-ae641814b131",
                                "sense_id": "39b7c669-da4d-393b-993b-a3d0557e6c2c",
                                "text": "C'est l'heure où son avant [d'une goélette] s'emperle\nDans le poudrin éblouissant\nDu flot moutonnant qui déferle\nEt qu'elle tamise en passant."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc1553f7-b5ca-3439-bea3-39dfbc941ff6",
                        "entry_id": "871b1f79-da8a-3886-8bd5-1838043d25ee",
                        "glosses": [
                            "Neige poudreuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd40bea-b34f-4cbe-96f6-b58c95c3dcd0",
                                "sense_id": "fc1553f7-b5ca-3439-bea3-39dfbc941ff6",
                                "text": "Des porches s’ouvraient, bas et trapus, des corridors où le poudrin s’était engouffré et luisait dans l’ombre. Parfois, la neige amoncelée par le vent murait, jusqu’à mi-hauteur, une porte misérable."
                            }
                        ]
                    }
