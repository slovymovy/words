                        "examples": [
                            {
                                "example_id": "a69b32db-b2b6-4fe1-8f7d-d80139c5edc4",
                                "sense_id": "669d7217-96c0-3d14-8ad1-3e1f792314cc",
                                "text": "„Weshalb aber lassen viele (ein weiterer Trost: doch längst nicht alle) Salomonerinnen und Salomoner den Kahlschlag überhaupt zu, indem sie die Wälder – die ihnen dank dem traditionellen Landrecht zu 80 bis 90 Prozent gehören – an die Regierung verpachten, welche diese Gebiete sogleich an die Abholzungsfirmen weiterverschachert?“"
                            }
                        ],
