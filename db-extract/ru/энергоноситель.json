                                "target_senses": [
                                    {
                                        "sense_id": "2c2f8a9b-c866-3ae9-b6bb-4b341d096815",
                                        "entry_id": "9a85863b-667a-3672-9d29-76a9e416fee7",
                                        "glosses": [
                                            "A substance or phenomenon that can be used to produce mechanical work or heat or to operate chemical or physical processes (ISO 13600)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c882558-f640-4847-b56c-44ce7f9c4667",
                                                "sense_id": "2c2f8a9b-c866-3ae9-b6bb-4b341d096815",
                                                "text": "Solar radiation is an energy carrier that is not an energyware."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1181040-ce07-43ad-9ce8-0caa4060d00e",
                        "source_entry_id": "148fd94b-3179-3541-a71f-d923422b072b",
                        "source_sense_id": "a232d714-b13a-394e-b201-3b2101e5a854",
                        "target_lang_word": "vector energético",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "152f6e0c-99d9-425c-85f9-85e7e04d2d5a",
                        "source_entry_id": "148fd94b-3179-3541-a71f-d923422b072b",
                        "source_sense_id": "a232d714-b13a-394e-b201-3b2101e5a854",
                        "target_lang_word": "vettore energetico",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c57d5b74-a3e1-40f6-8a13-0e13605dd4a9",
                        "source_entry_id": "148fd94b-3179-3541-a71f-d923422b072b",
                        "source_sense_id": "a232d714-b13a-394e-b201-3b2101e5a854",
                        "target_lang_word": "Energieträger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Energieträger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "912d6596-720a-3fc7-b0a5-7109f2c35ebb",
                                        "entry_id": "1b52f351-940d-3c1f-b961-78b67ca4dfc9",
                                        "glosses": [
                                            "Stoff mit nutzbarer Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc435583-3a9b-4c5e-93d4-558f4aafd3df",
                                                "sense_id": "912d6596-720a-3fc7-b0a5-7109f2c35ebb",
                                                "text": "„Auf der Suche nach neuen Rohstoffen und Energieträgern nutzen Forscher Prinzipien der Katalyse, um bisher wenig brauchbare Stoffe in nützliche umzuwandeln.“"
                                            },
                                            {
                                                "example_id": "6c8e4847-2665-4ffc-8d50-5c4eaf2364f8",
                                                "sense_id": "912d6596-720a-3fc7-b0a5-7109f2c35ebb",
                                                "text": "„Wasserstoff ist ein umweltfreundlicher Energieträger. Bei seiner Verbrennung entstehen keine schädlichen Abgase, sondern nur Wasserdampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db0caba2-aaac-41b9-ab20-ac6aff7f5cd2",
                        "source_entry_id": "148fd94b-3179-3541-a71f-d923422b072b",
                        "source_sense_id": "a232d714-b13a-394e-b201-3b2101e5a854",
                        "target_lang_word": "energiedrager",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "energiedrager",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "027c9599-43aa-38ae-8111-e5e1fda4ef31",
                                        "entry_id": "ee8c0652-1716-3d27-ac21-af8179ff708f",
                                        "glosses": [
                                            "medium waarin energie is opgeslagen, stof die men kan omzetten voor het opwekken van bruikbare energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1638801b-ef95-4959-909a-d2337c16b5cc",
                                                "sense_id": "027c9599-43aa-38ae-8111-e5e1fda4ef31",
                                                "text": "Volgens de Hamane zou Marokko in 4 tot 8 procent van de wereldwijde behoefte aan groene waterstof kunnen voorzien. De energiedrager zou in waterstoffabrieken in Marokko worden gemaakt en vervolgens per schip of via buizen worden getransporteerd."
                                            },
                                            {
                                                "example_id": "3bf93821-a34b-4254-a538-8c3a9a06d18b",
                                                "sense_id": "027c9599-43aa-38ae-8111-e5e1fda4ef31",
                                                "text": "Als waterstof inderdaad dé energiedrager van de toekomst wordt, zoals de bedoeling is, gaat dat grote gevolgen hebben voor Nederland. Het zal onder andere betekenen dat er zeer grote hoeveelheden giftig ammoniak, waarmee waterstof wordt gemaakt, door ons land vervoerd zullen worden."
                                            },
                                            {
                                                "example_id": "75be0018-da46-4749-9711-b89acb762ca3",
                                                "sense_id": "027c9599-43aa-38ae-8111-e5e1fda4ef31",
                                                "text": "Waterstof kan als energiedrager een alternatief zijn voor diesel en benzine voor vrachtwagens, bussen, boten en automobilisten die heel veel rijden. \"De auto's rijden wel elektrisch, maar de generator wordt aangedreven door waterstof\", zegt een van de deelnemers van Rijkswaterstaat vlak voor de start van de challenge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c992f0a2-f2ff-4ed8-9c72-75688e0f6443",
