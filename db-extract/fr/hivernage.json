                            {
                                "target_word": "wintering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49e0539c-33f6-39c6-8f0c-55fa956142e5",
                                        "entry_id": "354a64ba-5c1e-3737-ab03-84e2694ebc2f",
                                        "glosses": [
                                            "The act of staying at a place throughout the winter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d18158cc-e36f-4700-bc8c-2758a5b8f687",
                                                "sense_id": "49e0539c-33f6-39c6-8f0c-55fa956142e5",
                                                "text": "Other winterings followed in 1795 and on four occasions in the 1820s, but one in 1834–1835 ended with the death of all members of a seven-man party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
