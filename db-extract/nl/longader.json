                "senses": [
                    {
                        "sense_id": "8997ec22-1e4e-3211-bd21-1fcefb2503cf",
                        "entry_id": "617267bf-744b-33f7-a541-0e6ff7045c6d",
                        "glosses": [
                            "bloedvat waardoor het zuurstofrijke bloed van de longen naar de linker boezem van het hart stroomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe4d1071-e362-4a00-9bcc-893b08465363",
                                "sense_id": "8997ec22-1e4e-3211-bd21-1fcefb2503cf",
                                "text": "Het St. Antonius Ziekenhuis in Nieuwegein en Utrecht heeft een gloednieuwe operatietechniek toegepast om vernauwde longaders te heropenen en daarmee longen voor afsterven te behoeden."
                            },
                            {
                                "example_id": "352d416e-8b1b-4941-9f96-712ce2b1f77f",
                                "sense_id": "8997ec22-1e4e-3211-bd21-1fcefb2503cf",
                                "text": "Westerweel komt bij, na twee dagen op de intensive care. Cardioloog Yves van Belle, die aan de ingreep begon, vertelt hem wat mis ging. „Hij zei dat mijn longader scheurde na het inbrengen van de cryoballon.”"
                            },
                            {
                                "example_id": "cbc303c2-023e-43b6-80c6-4d021397c8f7",
                                "sense_id": "8997ec22-1e4e-3211-bd21-1fcefb2503cf",
                                "text": "Voorkamerfibrillatie of boezemfibrilleren is een hartritmestoornis, die kan ontstaan bij een abnormale elektrische activiteit in de wand van de longaders. Die elektrische activiteit komt vervolgens in het hart terecht, waardoor de spiervezels zich daar zeer snel en ongecoördineerd gaan samentrekken."
                            }
                        ]
                    }
                ],
