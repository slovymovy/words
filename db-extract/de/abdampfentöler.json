                "senses": [
                    {
                        "sense_id": "f46db3ac-2f85-35ce-851e-0b069c8d8551",
                        "entry_id": "ecbee794-041c-3f92-8fd2-64966641aa42",
                        "glosses": [
                            "Apparat zur Separierung von Öl aus Abdampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f10e91c9-b3d1-4da2-b33a-000b1b27abb1",
                                "sense_id": "f46db3ac-2f85-35ce-851e-0b069c8d8551",
                                "text": "„In sehr vielen Betrieben findet man Abdampfentöler eingebaut, jedoch ist die Rückgewinnung vielfach sehr schlecht.“"
                            },
                            {
                                "example_id": "c6683a20-4395-433b-84c1-cb25d576bbe7",
                                "sense_id": "f46db3ac-2f85-35ce-851e-0b069c8d8551",
                                "text": "„In manchen Betrieben sind die vorhandenen Abdampfentöler so wenig instandgehalten, daß sie überhaupt nicht mehr wirken. Jeder Maschinenwärter sollte dem Abdampfentöler ein größeres Interesse entgegenbringen, er kann dadurch […]“"
                            },
                            {
                                "example_id": "dca3c7ff-9482-4628-b7f7-b8ae353fa303",
                                "sense_id": "f46db3ac-2f85-35ce-851e-0b069c8d8551",
                                "text": "„Der Dampf gelangt aus den Kolbenmaschinen durch die Abdampfrohre E in ein großes Umschaltventil D; von da strömt er bei normaler Fahrt durch das Rohr F dem Abdampfentöler H zu, dessen System in […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
