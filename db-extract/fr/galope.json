                        "entry_id": "cbcdbf73-318c-32b5-b252-2690eae5d67f",
                        "glosses": [
                            "Danse rappelant le galop d'un cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e79525-1991-484e-b7a8-d1d6afe7e58b",
                                "sense_id": "c423c656-b7ef-36ca-a582-37c1b822146f",
                                "text": "Elle céda aux instances du marquis de Croisenois qui depuis une heure sollicitait une galope."
                            },
                            {
                                "example_id": "2b3e30bb-25d0-455e-844d-f86609099776",
                                "sense_id": "c423c656-b7ef-36ca-a582-37c1b822146f",
                                "text": "Il dansait une galope avec mademoiselle Théodelinde de Serpierre, lorsque, dans un angle de la salle, il aperçut madame de Chasteller."
                            }
                        ]
                    }
                ],
