                        "glosses": [
                            "Synonyme tombé en désuétude de l’azurite et de formule Cu₃(CO₃)₂(OH)₂."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae69f734-e711-4b43-982e-8a8cdd565562",
                                "sense_id": "823feb14-8296-36d6-beda-36a66154de8e",
                                "text": "L’arménite est un bleu de montagne assez dur pour recevoir un beau poli, néanmoins il ne fait pas feu avec le briquet."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc04de20-3f10-3018-b3c0-b2c12af8f6c1",
                        "entry_id": "1abf867b-2d98-3637-806b-5ba2e31c5136",
                        "glosses": [
                            "Minéral cyclosilicate agréé par l’Association internationale de minéralogie et de formule BaCa₂Al₆Si₉O₃₀•2H₂O."
                        ],
