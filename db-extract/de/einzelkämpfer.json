                "senses": [
                    {
                        "sense_id": "bab6aca6-1800-3656-bf83-1f8deb9f9a41",
                        "entry_id": "ca7ada7d-c851-3969-894e-6f96a188d6ba",
                        "glosses": [
                            "speziell für das Überleben und für den Jagdkampf geschulter Soldat für den Einsatz"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbaa5153-149b-3e4c-88cb-e44bb0553cd7",
                        "entry_id": "ca7ada7d-c851-3969-894e-6f96a188d6ba",
                        "glosses": [
                            "Person, die alleine gegen etwas oder jemanden ankämpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101ef811-40bc-4221-b35d-10f3e3a1582e",
                                "sense_id": "fbaa5153-149b-3e4c-88cb-e44bb0553cd7",
                                "text": "„Es gibt kein einheitliches deutsches Kommando mehr, keine zusammenhängende Front, keine intakte Einheit, keine geordnet geführte Truppe. Nur noch Einzelkämpfer. versprengte Gruppen, verlorene Haufen, die sich mit dem Mut der Verzweiflung wehren.“"
                            },
                            {
                                "example_id": "99b71445-f5ef-4386-af5d-1e3c2b5de123",
                                "sense_id": "fbaa5153-149b-3e4c-88cb-e44bb0553cd7",
                                "text": "„Gerhard ist ein Einzelkämpfer und bettelt ausschließlich allein.“"
                            },
                            {
                                "example_id": "7824372d-0465-4ead-b5b1-04f14fa46a78",
                                "sense_id": "fbaa5153-149b-3e4c-88cb-e44bb0553cd7",
                                "text": "„Ständig balgten sich überall im Sand feindliche Haufen, während gleichzeitig Einzelkämpfer um sich kratzten und bissen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
