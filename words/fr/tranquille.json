                    "frequency": "High",
                    "semantic_group_id": "calme_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous cherchons un village <w>tranquille</w> à la campagne pour passer nos vacances d'été."
                        },
                        {
                            "text": "Les enfants sont restés bien <w>tranquilles</w> dans leur chambre pendant toute l'après-midi."
                        }
                    ],
                    "synonyms": [
                        "calme",
                        "sage"
                    ],
                    "antonyms": [
                        "agité",
                        "bruyant",
                        "remuant"
                    ],
                    "common_phrases": [
