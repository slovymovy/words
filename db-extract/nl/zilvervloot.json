                "senses": [
                    {
                        "sense_id": "bd99963b-111c-39f6-8e11-3149af3d1e3e",
                        "entry_id": "f86786d2-ce50-3b55-8b2f-dee67da3ed67",
                        "glosses": [
                            "een jaarlijks konvooi van schepen, waarin kostbaarheden van de Spaanse koloniën in Amerika werden verscheept naar Spanje. In Nederland is de zilvervloot vooral bekend van de verovering ervan door Piet Hein in 1628."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca6b927-cecd-43f5-91b4-cc2affc78c6b",
                                "sense_id": "bd99963b-111c-39f6-8e11-3149af3d1e3e",
                                "text": "Hein is bij het grote publiek bekend van de verovering van de Spaanse zilvervloot. Toch is hij niet onomstreden door zijn VOC-verleden. Het besluit betekent niet dat alle historische vernoemingen aangepast gaan worden, want daarvan zijn er veel te veel volgens het stadsbestuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e439f8c-b049-3b35-b367-a1dcb561cfe7",
                        "entry_id": "f86786d2-ce50-3b55-8b2f-dee67da3ed67",
                        "glosses": [
                            "een grote hoeveelheid geld"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a03cc73c-9fd5-432e-8734-b709011f0466",
                                "sense_id": "9e439f8c-b049-3b35-b367-a1dcb561cfe7",
                                "text": "Zilvervloot vaart binnen bij Atlético: Een Israëlische investeringsmaatschappij heeft voor 50 miljoen euro 15 procent van de aandelen van de Spaanse voetbalclub Atlético Madrid overgenomen."
                            },
                            {
                                "example_id": "6db3c347-f63f-4708-b0c2-47c0eab4454a",
                                "sense_id": "9e439f8c-b049-3b35-b367-a1dcb561cfe7",
                                "text": "Het verdienmodel: via Facebook en Twitter in real time video’s van doelpunten delen. Voorlopig levert dat weinig op: Van Persie investeerde in 2014, maar deze maand liet Grabyo weten dat de impact van digitale en sociale media nog niet tot alle adverteerders is doorgedrongen. Maar, zo verzekert de ceo, zodra dat besef er is, loopt de zilvervloot binnen."
                            }
                        ]
                    }
