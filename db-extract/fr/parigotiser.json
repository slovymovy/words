                        "glosses": [
                            "Donner un caractère parigot à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d44c3567-727e-4d90-aed3-cd81c30b0bbe",
                                "sense_id": "26a217c6-1602-3723-923a-c6147e8e4398",
                                "text": "Il met l'intonation comme s'il récitait la petite chèvre de monsieur seguin, il fait du lyrisme de pacotille en relevant toutes les fins des phrases et des vers, il parigotise le texte, il met des mots en valeur on se demande pourquoi, il ponctue de ses mains comme un politicien un discours, il laisse parler quelqu'un d'autre à sa place"
                            },
                            {
                                "example_id": "092e70be-59b8-46b4-8ee4-e6834d2b08a4",
                                "sense_id": "26a217c6-1602-3723-923a-c6147e8e4398",
                                "text": "Jeune pousse campagnarde qui aime parfois se parigotiser, le Deleuze, héritier patronymique d'un grand philosophe, est un enfant charmant."
                            },
                            {
                                "example_id": "94a744cf-4ecb-46d6-b29a-e93b007ed203",
                                "sense_id": "26a217c6-1602-3723-923a-c6147e8e4398",
                                "text": "comment il se parigotise ce forum... c'est abject."
                            }
                        ]
                    }
