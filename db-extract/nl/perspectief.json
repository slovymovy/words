                ],
                "senses": [
                    {
                        "sense_id": "e824f75e-fc1f-3756-880b-7848a5e503ff",
                        "entry_id": "6a593ae3-af1b-3075-94ff-f37b2a2c6656",
                        "glosses": [
                            "het aanhouden van zodanige proporties in een vlakke afbeelding dat deze overkomen met hoe de wereld in drie dimensies waargenomen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b78d595-9f42-411c-9fce-7e5aa61da446",
                                "sense_id": "e824f75e-fc1f-3756-880b-7848a5e503ff",
                                "text": "Het perspectief van dit schilderij klopt niet helemaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "173f97f2-6dd3-3022-8956-08bccd3505f3",
                        "entry_id": "6a593ae3-af1b-3075-94ff-f37b2a2c6656",
                        "glosses": [
                            "vooruitzicht op gunstige mogelijkheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da6cc51e-60e9-417c-9d4a-9b376254f09d",
                                "sense_id": "173f97f2-6dd3-3022-8956-08bccd3505f3",
                                "text": "Daarna zag hij weer perspectieven."
                            },
                            {
                                "example_id": "5593e3e4-7987-408a-bc6e-3b13915226f5",
                                "sense_id": "173f97f2-6dd3-3022-8956-08bccd3505f3",
                                "text": "En daar staan we weer voor de strijd uitgerust, dacht Albert, klaar om het schavot te beklimmen (zo werd de ladder genoemd die ze gewoonlijk gebruikten om de loopgraaf uit te komen, over perspectief gesproken) en dan met het hoofd vooruit op de vijandelijke linies af te stormen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a288650-81ff-35f3-ac1b-57afa0f3a5b3",
                        "entry_id": "6a593ae3-af1b-3075-94ff-f37b2a2c6656",
                        "glosses": [
                            "plaats en richting vanwaaruit men iets bekijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2feb08b-fbe7-46fc-8b49-b2530ae20aa9",
                                "sense_id": "5a288650-81ff-35f3-ac1b-57afa0f3a5b3",
                                "text": "Maar bovenal komt die verdraaiing van de werkelijkheid door Yorgos Lanthimos. De absurdistische Griekse regisseur (Dogtooth, The Lobster, The Killing of a Sacred Deer) geeft het genre letterlijk een andere draai, door vaak een vervreemdend perspectief te kiezen."
                            },
                            {
                                "example_id": "e3aa4f27-9db5-4fb6-8a30-16772c3e215a",
                                "sense_id": "5a288650-81ff-35f3-ac1b-57afa0f3a5b3",
                                "text": "Door tijdelijk afstand van je vertrouwde leven te nemen en door zonder je partner op pad te gaan, krijg je tijd en ruimte om je leven vanuit een fris perspectief te bekijken, om de keuzes die je hebt gemaakt te analyseren en de tijd die voor je ligt te overdenken."
                            }
                        ]
                    }
                ],
