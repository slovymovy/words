                        "entry_id": "13744940-aa04-3772-96a1-a68b407eb568",
                        "glosses": [
                            "Bereich, in dem der Fluglärm eines Luftfahrzeugs deutlich zu hören ist"
                        ],
                        "tags": [
                            "Flugwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "4009f6f1-ec02-4227-8d7b-cef4d7ea6eb2",
                                "sense_id": "57c6cb47-96a0-3102-a35c-61dfc6aee2e8",
                                "text": "„Der Lärmteppich des Flugzeugs ist erheblich kleiner als bei allen vergleichbar großen Flugzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ca8b1e6-89d6-3922-bbe2-9a4f7a81c272",
                        "entry_id": "13744940-aa04-3772-96a1-a68b407eb568",
                        "glosses": [
                            "Situation, in der ein hoher Geräuschpegel herrscht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "24d744d3-2c65-46d6-a841-58970342b119",
                                "sense_id": "6ca8b1e6-89d6-3922-bbe2-9a4f7a81c272",
                                "text": "„Allein der in vielen Klassen nahezu permanent vorhandene Lärmteppich nagt auf Dauer am Nervenkostüm des Lehrers.“"
                            },
                            {
                                "example_id": "0b35ab07-9f77-4cde-b624-8bc9d45e9c9b",
                                "sense_id": "6ca8b1e6-89d6-3922-bbe2-9a4f7a81c272",
                                "text": "„Ich fahre durch die Straßen der Stadt mit ihrem ohrenbetäubenden Lärmteppich aus Verkehr und Stimmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
