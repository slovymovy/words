                    {
                        "translation_id": "0d4f0634-f808-49fc-a74e-24942dbbceca",
                        "source_entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                        "source_sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                        "source_sense_description": "denial; renunciation",
                        "target_lang_word": "verwerping",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwerping",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c22b18be-c665-3964-aff8-243b70d6b242",
                                        "entry_id": "83ced013-71e9-30e5-bf58-e14e5b21dc31",
                                        "glosses": [
                                            "het afwijzen van iets; iets niet accepteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d419831e-c7a4-4746-9b26-aeb14cdcb66d",
                                                "sense_id": "c22b18be-c665-3964-aff8-243b70d6b242",
                                                "text": "Door die wet te verwerpen was het misschien mogelijk geweest de oude opvatting van de beweging van lichamen te handhaven, maar zonder verwerping was het onmogelijk, zou men denken, de Ptolemeïsche werelden te blijven bestuderen."
                                            },
                                            {
                                                "example_id": "caefb0f1-e1c4-4715-bdc5-4740a96e5237",
                                                "sense_id": "c22b18be-c665-3964-aff8-243b70d6b242",
                                                "text": "Sánchez werd vorig jaar premier van een minderheidskabinet. Na de verwerping van de begroting schreef hij verkiezingen uit voor april, die zijn partij overtuigend won (een winst van 38 zetels). Maar om een meerderheid te verwerven moest hij een coalitie vormen en dat lukt dus niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82cd9fcd-638a-4e49-98d5-1881dc22f09f",
                        "source_entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                        "source_sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                        "source_sense_description": "denial; renunciation",
                        "target_lang_word": "afwijzing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afwijzing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "54aac5fc-1c42-39be-b0c4-513eed18f3b1",
                                        "entry_id": "c1149db1-21d2-346f-8480-ce5fa643603e",
                                        "glosses": [
                                            "een bericht dat op een voorstel of aanzoek niet ingegaan wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4fd0768-e6ff-47f7-afb3-e94c649151f3",
                                                "sense_id": "54aac5fc-1c42-39be-b0c4-513eed18f3b1",
                                                "text": "Solliciteren levert nu eenmaal vele afwijzingen op."
                                            },
                                            {
                                                "example_id": "c5895d68-3e57-42cc-8c5a-293f1f2dc4d5",
                                                "sense_id": "54aac5fc-1c42-39be-b0c4-513eed18f3b1",
                                                "text": "In de eerste plaats was er de regelrechte afwijzing, de afkeurende blik, waar geen misverstand over kon bestaan."
                                            },
                                            {
                                                "example_id": "5bc95e7e-af0b-4c4b-a60a-eafaf4fa53f2",
                                                "sense_id": "54aac5fc-1c42-39be-b0c4-513eed18f3b1",
                                                "text": "Die afwijzing was het resultaat van talloze kwetsuren die Kathrin in de loop van haar leven had moeten dulden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7d1124f-f701-4ff7-8751-55a9f834d760",
                        "source_entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                        "source_sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                        "source_sense_description": "denial; renunciation",
                        "target_lang_word": "abnégation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnégation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                        "entry_id": "e1a78297-c1f6-370d-8d3a-5e9b3eebdb5f",
                                        "glosses": [
                                            "Renoncement, sacrifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcb22e24-7b88-40d7-b416-0260f784969c",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Cette responsabilité d’honneur, cette abnégation magnifique donnèrent insensiblement à la jeune marquise une dignité de femme, une conscience de vertu […]."
                                            },
                                            {
                                                "example_id": "a1d81725-b95d-44f2-b93d-10f5a442a3f0",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "L’Abnégation du Guerrier est une croix plus lourde que celle du Martyr. Il faut l’avoir portée longtemps pour en savoir la grandeur et le poids."
                                            },
                                            {
                                                "example_id": "1c0f3a6f-c328-4072-9466-71c258697fb0",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Si donc l’histoire récom­pense l’abnégation résignée des hommes qui luttent sans se plaindre et accomplissent sans profit une grande œuvre de l'histoire, comme l'affirme Renan, nous avons une raison nouvelle de croire à l'avènement du socialisme, […]."
                                            },
                                            {
                                                "example_id": "302b5ba6-05fe-4d91-9bfb-920b50eaa380",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Je n’ai pas de leçons à donner, mais s’il y avait eu des smartphones quand j’avais 18 ou 20 ans, je ne sais pas si j’aurais eu le même parcours. Car il m’a demandé beaucoup de travail et un peu d’abnégation."
                                            },
                                            {
                                                "example_id": "28ff7154-569a-46fd-9c40-de05d6ec6721",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "L’abnégation ne figure pas au rang de mes qualités distinctives."
                                            },
                                            {
                                                "example_id": "78b2274b-4ee9-4572-b967-ed7e3cc4682b",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Ce dévouement, qui s'élève parfois jusqu'à l'abnégation, s'affirmera encore davantage après sa visite au bagne de Sakhaline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa83ae96-ba2d-37bd-a542-05774ad52f36",
                                        "entry_id": "e1a78297-c1f6-370d-8d3a-5e9b3eebdb5f",
                                        "glosses": [
                                            "Détachement de tout ce qui n’a pas rapport à Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787eec68-8b63-44fa-9d25-bc9461fe214f",
                                                "sense_id": "aa83ae96-ba2d-37bd-a542-05774ad52f36",
                                                "text": "Pour s’attacher uniquement à Dieu, il fait abnégation de ce que l’homme a de plus cher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
