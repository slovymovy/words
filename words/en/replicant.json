{
    "word_family": [
        "replicate",
        "replication",
        "replicative",
        "replica"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d11985d6-f741-33e6-9a8a-de984251d4a3",
                    "sense_definition": "A bioengineered or artificial being designed to be an exact replica of a human being.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective was tasked with hunting down an escaped <w>replicant</w> hiding among the population.",
                            "target_lang_translations": {
                                "zh": "这名侦探受命追捕一名潜藏在人群中的在逃<w>复制人</w>。"
                            }
                        },
                        {
                            "text": "Scientists in the novel created a sophisticated <w>replicant</w> indistinguishable from a normal human.",
                            "target_lang_translations": {
                                "zh": "小说中的科学家制造出了一个与普通人类真假难辨的高级<w>复制人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "android",
                        "clone",
                        "cyborg"
                    ],
                    "common_phrases": [
                        "runaway replicant",
                        "bioengineered replicant"
                    ],
                    "target_lang_definitions": {
                        "zh": "（科幻作品中的）复制人，人造人（通过生物工程制造、外表和生理机能与人类极度相似的存在）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "复制人",
                                "target_lang_sense_clarification": "科幻作品中仿造人类的生物工程人"
                            },
                            {
                                "target_lang_word": "仿生人",
                                "target_lang_sense_clarification": "高度仿真的合成人或人造人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5496035f-ae7b-3ac9-9d95-3c8018ed8476",
                    "sense_definition": "A person who replies or gives an answer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each <w>replicant</w> in the survey provided detailed feedback regarding their experience.",
                            "target_lang_translations": {
                                "zh": "调查中的每位<w>回答者</w>都就自身经历提供了详细反馈。"
                            }
                        },
                        {
                            "text": "The official waited patiently for the <w>replicant</w> to respond to the inquiry.",
                            "target_lang_translations": {
                                "zh": "官员耐心地等待着<w>答复者</w>对询问做出回应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "respondent",
                        "replier"
                    ],
                    "antonyms": [
                        "questioner",
                        "inquirer"
                    ],
                    "target_lang_definitions": {
                        "zh": "回答者，答复者（罕用，指做出答复或回应的人）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "回答者",
                                "target_lang_sense_clarification": "作答的人"
                            },
                            {
                                "target_lang_word": "答复者",
                                "target_lang_sense_clarification": "做出回应或答复的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28e2e784-df11-39fc-bcba-6d80055e9a6e",
                    "sense_definition": "Serving to replicate or reproduce; replicative.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lab studied the <w>replicant</w> mechanisms of the newly discovered viral strain.",
                            "target_lang_translations": {
                                "zh": "实验室研究了这种新发现病毒株的<w>复制</w>机制。"
                            }
                        },
                        {
                            "text": "Certain cellular processes rely on <w>replicant</w> molecules to duplicate genetic code.",
                            "target_lang_translations": {
                                "zh": "某些细胞过程依赖起<w>复制作用的</w>分子来复制遗传密码。"
                            }
                        }
                    ],
                    "synonyms": [
                        "replicative",
                        "reproductive"
                    ],
                    "target_lang_definitions": {
                        "zh": "复制的，能够自我复制的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "复制的",
                                "target_lang_sense_clarification": "起复制作用或进行复制的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}