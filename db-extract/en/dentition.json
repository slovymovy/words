                    {
                        "translation_id": "39665e61-69e8-4c94-8e96-9c9e7d7f1806",
                        "source_entry_id": "f3f6e165-6721-3805-a395-25d13112d90c",
                        "source_sense_id": "5d7f9f89-6465-3d71-b679-3ca13ee2d16d",
                        "source_sense_description": "Gebiss",
                        "target_lang_word": "Gebiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebiss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                        "entry_id": "d57b8730-428d-3b69-ac5b-0aad151260e0",
                                        "glosses": [
                                            "die Gesamtheit der Zähne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2710530-3c4d-45cc-be7e-3ff187ca1fa4",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "Das menschliche Gebiss umfasst 32 Zähne."
                                            },
                                            {
                                                "example_id": "1cac5d5c-6c1f-43c1-ba34-9b5b4133ca96",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Seine Stimme war klar und fest, sein Gebiss unverstümmelt und von strahlendem Weiß.“"
                                            },
                                            {
                                                "example_id": "919ac4ed-1974-440c-ba57-fd7eb7081313",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Als sie grinste, klaffte eine schwarze Lücke im Gebiss.“"
                                            },
                                            {
                                                "example_id": "671d8bdd-c85e-4c86-b569-8df947a8a22b",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Längst hat der Zahnstocher seinen Siegeszug über die festlich gedeckten Tafeln kultivierter Gastlichkeit angetreten und bietet eine ebenso bequeme wie intensive Betreuung des Gebisses, ohne das Tischgespräch zu unterbrechen.“"
                                            },
                                            {
                                                "example_id": "1c25088b-c2dc-4e9f-964d-26cbbfb910d3",
                                                "sense_id": "11e203f7-b6fb-3fd6-bfa7-390d1dd2df0d",
                                                "text": "„Der Junge zeigte ein Gebiss, in dem ein Vorderzahn fehlte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f60e8fa-391a-370b-9952-af016c09d885",
                                        "entry_id": "d57b8730-428d-3b69-ac5b-0aad151260e0",
                                        "glosses": [
                                            "der Zahnersatz; die künstlichen Zähne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9898c2-ad21-401b-a1b2-c76020e59200",
                                                "sense_id": "5f60e8fa-391a-370b-9952-af016c09d885",
                                                "text": "Das Gebiss liegt auf dem Nachttisch."
                                            },
                                            {
                                                "example_id": "790a8c48-216b-4926-a21e-ec13ea7ec28e",
                                                "sense_id": "5f60e8fa-391a-370b-9952-af016c09d885",
                                                "text": "„Vermutlich saß das Gebiss nicht richtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
