                        "glosses": [
                            "Enlever de son dos, quitter un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93839b47-4b59-4f14-9d35-2325155c31d6",
                                "sense_id": "2ada20ee-c526-3580-8d63-4b94d590487f",
                                "text": "Tous les jours, j’endosse la veste de toile et je la « désendosse » pour le « bras de chemise »."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f2b038d-6ed1-3e3a-82a5-ac2e191e7b7b",
                        "entry_id": "7e86bbf5-e044-3a94-a3cb-aeeb44e79c85",
                        "glosses": [
                            "Ne plus prendre la responsabilité de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841a088b-4fa5-49d7-accf-91f8757c6848",
                                "sense_id": "2f2b038d-6ed1-3e3a-82a5-ac2e191e7b7b",
                                "text": "Dans un cas, le sujet désendosse en quelque sorte sa personnalité : il se démet de toute intimité pour mieux se recréer, à savoir se configurer et se raconter au travers de modèles-types ou de formes-schémes de récits romanesques on ne peut plus distinct du genre autobiographique."
                            }
                        ]
                    },
                    {
                        "sense_id": "fad69982-6a66-3072-ad57-a794d7d17e88",
                        "entry_id": "7e86bbf5-e044-3a94-a3cb-aeeb44e79c85",
                        "glosses": [
                            "Avoir le dos qui se défait, en parlant d’un livre."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "264c1b2d-b51f-4659-9b3d-4623a4347592",
                                "sense_id": "fad69982-6a66-3072-ad57-a794d7d17e88",
                                "text": "Cette seconde ligature est très-nécessaire pour empêcher les Livres de sortir d’entre les ais, & de se désendosser quand on desserrera la presse."
                            }
                        ]
                    }
