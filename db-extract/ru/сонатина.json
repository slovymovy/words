                "senses": [
                    {
                        "sense_id": "a155544b-a5e0-3fda-915c-77cfc13d81d4",
                        "entry_id": "4154b948-a1ff-3baf-a92a-1de8f429d195",
                        "glosses": [
                            "муз. несложная, небольшая соната, в которой отсутствует разработка темы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82aafa3f-7d0f-489f-8525-d4c6cc4acc62",
                                "sense_id": "a155544b-a5e0-3fda-915c-77cfc13d81d4",
                                "text": "Хозяйка давно должна была бы войти в платье, не иначе как до полу, и переиграть всю эту жёлтую стопку сонатин и вальсов, проявив поразительную способность читать по нотам…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b515601-d525-4bde-8ea2-cb3de063b39d",
                        "source_entry_id": "4154b948-a1ff-3baf-a92a-1de8f429d195",
                        "source_sense_id": "a155544b-a5e0-3fda-915c-77cfc13d81d4",
                        "target_lang_word": "sonatina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonatina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbdca92b-cfa4-338b-86c6-4395bd02f220",
                                        "entry_id": "b8b8f594-f893-3464-95d5-e729cb97ac10",
                                        "glosses": [
                                            "A musical composition resembling a sonata but shorter or simpler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "121d4546-057a-41bf-bb89-8803f303cb83",
                                                "sense_id": "cbdca92b-cfa4-338b-86c6-4395bd02f220",
                                                "text": "A sonatina usually has 2 or 3 rather short movements. While these movements provide contrasts of tempo and mood, they also complement one another, combining to fulfill the overall plan for a complete work in several parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
