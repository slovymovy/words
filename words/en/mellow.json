                                "target_lang_word": "沉稳的",
                                "target_lang_sense_clarification": "形容性格成熟、稳重。"
                            },
                            {
                                "target_lang_word": "温和的",
                                "target_lang_sense_clarification": "形容性格平和，不急躁。"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olgun",
                                "target_lang_sense_clarification": "yaş ve deneyimle oturmuş, sakinleşmiş"
                            },
                            {
                                "target_lang_word": "sakin",
                                "target_lang_sense_clarification": "telaşsız, ılımlı"
                            },
                            {
                                "target_lang_word": "mülayim",
                                "target_lang_sense_clarification": "uysal ve hoşgörülü"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "łagodny",
                                "target_lang_sense_clarification": "o usposobieniu człowieka pozbawionego agresji lub złości"
                            },
                            {
                                "target_lang_word": "wyciszony",
                                "target_lang_sense_clarification": "spokojny i zrównoważony emocjonalnie"
                            },
                            {
                                "target_lang_word": "zrównoważony",
                                "target_lang_sense_clarification": "spokojny, dojrzały życiowo"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "mite",
                                "target_lang_sense_clarification": "di indole calma e pacata"
                            },
                            {
                                "target_lang_word": "pacato",
                                "target_lang_sense_clarification": "tranquillo, sereno e privo di aggressività"
                            },
                            {
                                "target_lang_word": "addolcito",
                                "target_lang_sense_clarification": "reso più sereno e tollerante dagli anni"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "mild",
                                "target_lang_sense_clarification": "zachtmoedig en vergevingsgezind van aard"
                            },
                            {
                                "target_lang_word": "bedaard",
                                "target_lang_sense_clarification": "kalm en evenwichtig door leeftijd of ervaring"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a869ea8-4087-3e58-899b-58034b8bf76d",
                    "sense_definition": "Relaxed, easygoing, and cheerful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>mellow</w> afternoon just sitting in the park.",
                            "target_lang_translations": {
                                "zh": "我们坐在公园里，度过了一个<w>放松的</w>下午。",
                                "tr": "Parkta oturarak <w>huzurlu</w> bir öğleden sonra geçirdik.",
                                "pl": "Spędziliśmy <w>leniwe</w> popołudnie, po prostu siedząc w parku.",
                                "it": "Abbiamo trascorso un pomeriggio <w>rilassante</w> semplicemente seduti al parco.",
                                "nl": "We hadden een <w>ontspannen</w> middag terwijl we gewoon in het park zaten."
                            }
                        },
                        {
                            "text": "He is a very <w>mellow</w> guy who never gets angry.",
                            "target_lang_translations": {
                                "zh": "他是个非常<w>随和</w>的人，从不发火。",
                                "tr": "O asla sinirlenmeyen, çok <w>rahat</w> biridir.",
                                "pl": "To bardzo <w>wyluzowany</w> facet, który nigdy się nie złości.",
                                "it": "È un tipo molto <w>tranquillo</w> che non si arrabbia mai.",
                                "nl": "Hij is een heel <w>relaxte</w> gozer die nooit boos wordt."
                            }
                        }
                    ],
