                                "target_senses": [
                                    {
                                        "sense_id": "5a8e3f5d-3044-37ed-a543-83879b66b49f",
                                        "entry_id": "d783aad5-362a-358a-b3e0-154ed4d92bad",
                                        "glosses": [
                                            "de afstand tussen twee opeenvolgende regels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a2e277-09e1-4eea-a7b9-9b96a68c9ad2",
                                                "sense_id": "5a8e3f5d-3044-37ed-a543-83879b66b49f",
                                                "text": "Het is blijkbaar niet veel lezers opgevallen (dit is de enige brief die ik erover kreeg), maar sinds deze week is de vormgeving van de krant enigszins aangepast. Hoe? Chef vormgeving Jan Paul van der Wijk licht toe: „Het corps van de broodletter is iets groter gemaakt, van 8.4 punt met een interlinie van 9, naar 8.6 punt met een interlinie van 9.6. Dat komt de leesbaarheid ten goede. De letters in de weekendkrant waren al iets groter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e2067e-58c9-3750-937b-903a656198dc",
                                        "entry_id": "d783aad5-362a-358a-b3e0-154ed4d92bad",
