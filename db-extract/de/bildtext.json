                "senses": [
                    {
                        "sense_id": "d55a14f6-2ac0-372c-b17f-304a6f91a03d",
                        "entry_id": "407c9d79-9522-34e9-8764-0f360d807b13",
                        "glosses": [
                            "Text zur Erläuterung eines Bildes, zum Beispiel Titel oder Untertext zu einem Bild oder Foto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c541d54e-86e4-420d-af41-edf8f0963cf2",
                                "sense_id": "d55a14f6-2ac0-372c-b17f-304a6f91a03d",
                                "text": "„Die Schreibweise in der deutschsprachigen Wikipedia folgt weitgehend den Bildtexten, die vom niederländischen Nationaal Archief mit den Fotos auf Commons hochgeladen wurden. Leider sind auch diese Bildbeschreibungen nicht ganz eindeutig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2536e704-ab83-3ead-bf6c-a617408ccfbc",
                        "entry_id": "407c9d79-9522-34e9-8764-0f360d807b13",
                        "glosses": [
                            "einzelner Text einer Textsorte, bei der sich der Inhalt aus sprachlichen und bildlichen Darstellungen zusammensetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1f3b0da-1e17-4a4e-85d5-9fb2cd8f4db2",
                                "sense_id": "2536e704-ab83-3ead-bf6c-a617408ccfbc",
                                "text": "„In unseren Beispielen läuft soziale Interaktion über Bildtexte auf Sehflächen, um innerhalb bestimmter Praktiken möglichst effiziente Kommunikation zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
