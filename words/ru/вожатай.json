                    "sense_id": "5c684af6-6972-3a6e-96c8-5b24f88109c2",
                    "sense_definition": "Устаревшее название человека, который указывает путь или сопровождает кого-либо, то же, что <w>вожатый</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Но я молю тебя, поклонник верный твой, будь мне <w>вожатаем</w>.",
                            "target_lang_translations": {
                                "de": "Doch ich flehe dich an, dein treuer Verehrer, sei mein <w>Begleiter</w>."
                            }
                        },
                        {
                            "text": "Мы шли по неизвестной дороге, и нашим <w>вожатаем</w> был опытный местный житель.",
                            "target_lang_translations": {
                                "de": "Wir gingen auf einem unbekannten Weg, und unser <w>Führer</w> war ein erfahrener Einheimischer."
                            }
                        }
                    ],
                    "synonyms": [
                        "проводник",
                        "вожатый",
                        "гид"
                    ],
                    "common_phrases": [
                        "верный вожатай",
                        "опытный вожатай"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Слово является устаревшим вариантом слова вожатый."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Veralteter Begriff für eine Person, die den Weg weist oder jemanden begleitet; entspricht dem Wort 'Führer' oder 'Begleiter'."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Führer",
                                "target_lang_sense_clarification": "Person, die den Weg zeigt oder eine Gruppe leitet"
                            },
                            {
                                "target_lang_word": "Begleiter",
                                "target_lang_sense_clarification": "Person, die jemanden auf einem Weg begleitet"
                            },
                            {
                                "target_lang_word": "Wegweiser",
                                "target_lang_sense_clarification": "Person, die die Richtung angibt"
                            }
                        ]
