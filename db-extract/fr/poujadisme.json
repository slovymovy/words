                "senses": [
                    {
                        "sense_id": "1af45dfc-f42e-3a1d-b841-97f82254853d",
                        "entry_id": "f0262536-f248-3c29-a185-5f4cf81880f6",
                        "glosses": [
                            "Mouvement politique et syndical français, apparu en 1953 et revendiquant la défense des commerçants et des artisans."
                        ],
                        "tags": [
                            "Syndicalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "15bacace-60ca-4036-a0a7-e5f0179cc710",
                                "sense_id": "1af45dfc-f42e-3a1d-b841-97f82254853d",
                                "text": "Qu'il s'agisse de sensualité ou d'expériences préconjugales, les supporters traditionnels du poujadisme ont un comportement absolument prévisible, triste et réactionnaire, là comme ailleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fbb0798-2f31-311f-8f4f-537d4a38da2a",
                        "entry_id": "f0262536-f248-3c29-a185-5f4cf81880f6",
                        "glosses": [
                            "Type de populisme, de corporatisme et de démagogie n’ayant pas forcément de rapport avec le mouvement lancé par Pierre Poujade, et généralement réactionnaire."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "812f153b-a898-420c-8692-ea467fb691cf",
                                "sense_id": "1fbb0798-2f31-311f-8f4f-537d4a38da2a",
                                "text": "L'efficacité, la rapidité d'esprit, la capacité à aller tout de suite au vif du sujet me font revenir illico de mon poujadisme antiénarchie."
                            }
                        ]
                    }
                ],
