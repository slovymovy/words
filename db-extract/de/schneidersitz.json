                "senses": [
                    {
                        "sense_id": "4b9849dd-d2e5-30ca-8df6-d760ad87b046",
                        "entry_id": "03080d5e-abe2-3418-a189-bcab09407092",
                        "glosses": [
                            "Sitzen mit übereinandergeschlagenen Beinen auf ebener Unterlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e9c6bf-302e-4fe6-8de1-2706dafa4c40",
                                "sense_id": "4b9849dd-d2e5-30ca-8df6-d760ad87b046",
                                "text": "„Bruce schaute über ihre Schulter zu Rosa hinüber, die im Schneidersitz auf der Erde saß und mit den Armen Bobbys Knie, so fest sie konnte, umschlungen hielt.“"
                            },
                            {
                                "example_id": "fd452fe1-6647-4a91-8ce1-45a9bfbde6cd",
                                "sense_id": "4b9849dd-d2e5-30ca-8df6-d760ad87b046",
                                "text": "„Er hatte die Beine unter seinem aschgrauen Boubou zum Schneidersitz gekreuzt.“"
                            },
                            {
                                "example_id": "88eefa29-806a-42d9-851c-a21215526756",
                                "sense_id": "4b9849dd-d2e5-30ca-8df6-d760ad87b046",
                                "text": "„Im Schneidersitz saß Warlam Babinitsch in einer Ecke des überfüllten Schlafsaals auf dem dreckigen Betonboden und verbarg mit seinem Körper die Gegenstände, die er vor sich ausgebreitet hatte.“"
                            },
                            {
                                "example_id": "35cbbbaf-56bf-42d8-9b3f-6882f06214e7",
                                "sense_id": "4b9849dd-d2e5-30ca-8df6-d760ad87b046",
                                "text": "„Ich ließ mich im Schneidersitz auf den Rasen vor das Blumenbeet sinken, mit dem Rücken zum Haus und dem Blick über die Weinberge und betrachtete die Pflanzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7a4d643-b1ba-4502-82fa-74bc34b56a3f",
                        "source_entry_id": "03080d5e-abe2-3418-a189-bcab09407092",
                        "source_sense_id": "4b9849dd-d2e5-30ca-8df6-d760ad87b046",
                        "source_sense_description": "Sitzen mit übereinandergeschlagenen Beinen auf ebener Unterlage",
                        "target_lang_word": "tailorwise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tailorwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                                        "entry_id": "e5df8d65-7b8f-3c47-8865-d39ba2b988d8",
                                        "glosses": [
                                            "With the legs crossed in front of one and the ankles on the ground."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c082be46-978d-4bd8-9b2c-01eec72cfd5c",
                                                "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                                                "text": "While sitting on a chair or bench there is no difficulty in holding the trunk erect, because now the hamstring muscles are not only relaxed but further slackened at the lower end by flexion of the knee; the hips will flex several degrees farther here and also in sitting on the floor if the knees are flexed, tailorwise."
                                            },
                                            {
                                                "example_id": "cd36759f-5318-4482-a66d-87744d7240e4",
                                                "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                                                "text": "His shoes off, and his bare feet tucked under his legs, he sat tailorwise and peered up at the giant."
                                            },
                                            {
                                                "example_id": "9618af8a-94fd-4109-86fe-38d84c5306a7",
                                                "sense_id": "73e93975-b365-3181-a216-3a3237bac1cc",
                                                "text": "Perched tailorwise on the bed, I myself stared like an owl into the gloom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
