                "senses": [
                    {
                        "sense_id": "da3dedd6-4f17-3448-9954-2f06ff74b921",
                        "entry_id": "b089c10a-5839-329d-af25-6e316f3011d9",
                        "glosses": [
                            "to snatch (at), to grip, to pluck (at), to catch (at)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c1ecfac1-a6aa-3d92-8c8d-626a4c3b8a57",
                        "entry_id": "b089c10a-5839-329d-af25-6e316f3011d9",
                        "glosses": [
                            "to miss, to notice the absence (of), to find that someone/something is missing"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "058863e6-ca54-440e-ae66-f0ec7fd6ef7c",
                                "sense_id": "c1ecfac1-a6aa-3d92-8c8d-626a4c3b8a57",
                                "text": "хвати́ться кого́-л",
                                "translation": "to miss someone; notice someone's absence",
                                "english": "to miss someone; notice someone's absence"
                            },
                            {
                                "example_id": "ae7bedf7-96b3-4bab-a435-b9b1e5549ec6",
                                "sense_id": "c1ecfac1-a6aa-3d92-8c8d-626a4c3b8a57",
                                "text": "его́ хвати́лись, но бы́ло по́здно",
                                "translation": "when they missed him, it was too late",
                                "english": "when they missed him, it was too late"
                            },
                            {
                                "example_id": "91dcc89d-f2b0-4412-a0c6-91f91c33ed8a",
                                "sense_id": "c1ecfac1-a6aa-3d92-8c8d-626a4c3b8a57",
                                "text": "когда́ вы хвати́лись бума́жника?",
                                "translation": "when did you first miss your wallet?",
                                "english": "when did you first miss your wallet?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c10d6bff-8b65-3675-b6ff-39e7dd362009",
                        "entry_id": "b089c10a-5839-329d-af25-6e316f3011d9",
                        "glosses": [
                            "to remember"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2ad59b42-a00a-4151-ace0-05de9e1bdc1a",
                                "sense_id": "c10d6bff-8b65-3675-b6ff-39e7dd362009",
                                "text": "я сли́шком по́здно хвати́лся",
                                "translation": "I remembered [thought of] it too late",
                                "english": "I remembered [thought of] it too late"
                            }
                        ]
                    },
