                ],
                "senses": [
                    {
                        "sense_id": "0b308901-964e-32d6-b47e-d42d7f86bca2",
                        "entry_id": "6af503b1-d071-3991-89ba-2ed10ea99f5f",
                        "glosses": [
                            "Conscrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd1a702-9449-48b4-b84e-ff342101ac05",
                                "sense_id": "0b308901-964e-32d6-b47e-d42d7f86bca2",
                                "text": "Lunettes épaisses à bordure de fer sur le nez, les cheveux tondus ras, c’était comme lui un appelé du contingent planqué dans les bureaux : il reclassait tous les dossiers que son prédécesseur avait déjà classés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d25ab148-194a-4d40-8b2e-efc12f1b71a6",
                        "source_entry_id": "6af503b1-d071-3991-89ba-2ed10ea99f5f",
                        "source_sense_id": "0b308901-964e-32d6-b47e-d42d7f86bca2",
                        "target_lang_word": "milicien",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milicien",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ef384fff-f664-35fc-9aff-7e931e4e51b3",
                                        "entry_id": "b2df1700-e5dc-3eba-880c-712e826a4e33",
                                        "glosses": [
                                            "dienstplichtige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4c4beb-d5c4-46f8-ad5c-7daf38f2be89",
                                                "sense_id": "ef384fff-f664-35fc-9aff-7e931e4e51b3",
                                                "text": "Als model voor ‘Afghanistan’ en voor wat gevechtsvliegtuigen en helikopters bijdragen aan het beslechten van een grootschalig guerrillaconflict beschouwt Van Creveld bijvoorbeeld de Franse strijd in Algerije in de jaren vijftig. Die analogie stemt somber. De Fransen hadden in de kolonie jarenlang 400.000 reguliere manschappen op de been, aangevuld met bijna tweehonderdduizend Algerijnse miliciens. En de Franse luchtmacht vloog in het conflict met honderden jagers, bommenwerpers, helikopters en transportvliegtuigen. Hun luchtoverwicht was totaal, want de tegenstanders van het Nationaal Bevrijdingsfront die op het hoogtepunt nauwelijks 40.000 man telden, hadden geen luchtmacht en geen luchtafweergeschut."
                                            },
                                            {
                                                "example_id": "c1e013c0-1cb7-4461-8ff6-ab6bdd71997a",
                                                "sense_id": "ef384fff-f664-35fc-9aff-7e931e4e51b3",
                                                "text": "Vorige week werden al twee medewerkers van de marinekazerne gearresteerd. Een van hen is een 23-jarige milicien, een dienstplichtige eilandbewoner. De tweede is een 48-jarige burgermedewerker van Defensie. Beiden worden verdacht van het uitvoeren van cocaïne via de militaire post. Hoe dit precies in zijn werk ging, wil de marechaussee niet zeggen. Mogelijk volgen meer aanhoudingen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "d518976f-256d-32da-af0b-953d50a9e5d2",
                "word": "appelé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
