                "senses": [
                    {
                        "sense_id": "5eefc1f2-b140-3af2-af12-02c03dc8a73c",
                        "entry_id": "7a14675d-69d5-3567-afcd-64f040164866",
                        "glosses": [
                            "Action de rapiécer, de repriser à l’aiguille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a8fead-f6d3-408d-b81e-4594f9e33937",
                                "sense_id": "5eefc1f2-b140-3af2-af12-02c03dc8a73c",
                                "text": "Le ravaudage de vieux bas."
                            },
                            {
                                "example_id": "fe214712-aae9-4001-8730-c4730402b8e5",
                                "sense_id": "5eefc1f2-b140-3af2-af12-02c03dc8a73c",
                                "text": "M. Le Génil, prédicateur estimé dans les diocèses de Paris et de Versailles, faisait du ravaudage pour épargner de la peine à sa vieille servante et par un goût de manier l’aiguille, qu’il avait contracté dans les dures années de sa jeunesse ecclésiastique."
                            }
                        ]
                    },
                    {
                        "sense_id": "c21149f0-60a2-344c-9d57-8c18df34b187",
                        "entry_id": "7a14675d-69d5-3567-afcd-64f040164866",
                        "glosses": [
                            "Besogne mal faite, faite grossièrement."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "43752498-3149-498e-bc95-8c7b6f62e873",
                                "sense_id": "c21149f0-60a2-344c-9d57-8c18df34b187",
                                "text": "Vous n’avez fait là que du ravaudage."
                            }
                        ]
                    },
                    {
                        "sense_id": "59c8bf06-8a56-3c95-9efe-3ec183a68fe4",
                        "entry_id": "7a14675d-69d5-3567-afcd-64f040164866",
                        "glosses": [
                            "Ouvrages de l’esprit qui ne sont faits que d’emprunts, de pièces et de morceaux."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
