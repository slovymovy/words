                "senses": [
                    {
                        "sense_id": "82cdaca7-f476-3d5c-b579-526e930b4cf1",
                        "entry_id": "a7ac3b8f-402f-3949-865d-fe5054a29f14",
                        "glosses": [
                            "длинные и узкие сани, используемые для езды на собаках и оленях на Севере"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a957df9e-de1e-44e2-8e5e-a8fb5928695f",
                                "sense_id": "82cdaca7-f476-3d5c-b579-526e930b4cf1",
                                "text": "Для этой цели они снаряжают особенные легкие и узкие сани, называемые нарты, кладут на них провизию и все необходимое, и тащат эти нарты собаками, которые служат также для охоты."
                            },
                            {
                                "example_id": "ab82930c-998d-420d-ad7c-946d0e53ee4a",
                                "sense_id": "82cdaca7-f476-3d5c-b579-526e930b4cf1",
                                "text": "Зимой едут отсюда на собаках, в так называемых нартах, длинных низеньких санках, лёжа, по одному человеку в каждых."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b00cfd0e-3f77-4fdf-8e9a-998d0f686d9e",
                        "source_entry_id": "a7ac3b8f-402f-3949-865d-fe5054a29f14",
                        "source_sense_id": "82cdaca7-f476-3d5c-b579-526e930b4cf1",
                        "target_lang_word": "Hundeschlitten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hundeschlitten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e773c466-8192-3f36-8352-ea1820b5b024",
                                        "entry_id": "7683e6e0-32ab-3ff8-8188-0fd4fc20564a",
                                        "glosses": [
                                            "Schlitten, der von einem oder mehreren Hunden gezogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fee78fb9-be8b-43c8-a3aa-78fe00a12b8e",
                                                "sense_id": "e773c466-8192-3f36-8352-ea1820b5b024",
                                                "text": "Der Hundeschlitten gleitet durch den Schnee."
                                            },
                                            {
                                                "example_id": "060f4f0c-502f-4a0f-a79a-474d6aa74fe0",
                                                "sense_id": "e773c466-8192-3f36-8352-ea1820b5b024",
                                                "text": "„In der einbrechenden Dunkelheit, die alle Geräusche dämpfte, im rhythmischen Geschaukel der Hundeschlitten und bei dem anheimelnden Knarren der Riemen träumte John vor sich hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f823553-98f5-4686-91a7-db39b1e0882b",
                        "source_entry_id": "a7ac3b8f-402f-3949-865d-fe5054a29f14",
