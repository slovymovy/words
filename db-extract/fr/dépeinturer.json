                "senses": [
                    {
                        "sense_id": "65155d1a-73b1-3543-8d64-009d5f6dd1ae",
                        "entry_id": "78c1a1da-dee8-3c3c-a202-9f77dc852346",
                        "glosses": [
                            "Enlever la peinture de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d147cf8-d775-4ece-a039-616322918870",
                                "sense_id": "65155d1a-73b1-3543-8d64-009d5f6dd1ae",
                                "text": "J'ai payé pour faire dépeinturer le loft."
                            },
                            {
                                "example_id": "c13e75a3-3d7e-424c-b592-853b1f3ff98e",
                                "sense_id": "65155d1a-73b1-3543-8d64-009d5f6dd1ae",
                                "text": "Aujourd'hui, les deux principales faiblesses de ces toits, leur piètre imperméabilité et leur tendance à se dépeinturer, ont été réglées."
                            },
                            {
                                "example_id": "d325a3e0-6c51-4ca6-b70b-1f7d663e7282",
                                "sense_id": "65155d1a-73b1-3543-8d64-009d5f6dd1ae",
                                "text": "Pour finir, madame Frenette avait barré le chemin à madame Mongrain, en lui disant d'aller se « dépeinturer » avant d'entrer à l'église."
                            }
                        ]
