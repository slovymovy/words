                "senses": [
                    {
                        "sense_id": "15fe5216-e99a-325b-a137-c58b0d50e807",
                        "entry_id": "15a799fc-2d6b-33dd-a9a3-166ced5b00d6",
                        "glosses": [
                            "Grundrecht, das garantiert, dass Briefe und Postsendungen nur von ihrem Empfänger geöffnet werden dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c24b91a-c2a3-4db7-94d0-0cd3e7e6e06d",
                                "sense_id": "15fe5216-e99a-325b-a137-c58b0d50e807",
                                "text": "In Deutschland ist das Briefgeheimnis in Artikel 10 des Grundgesetzes garantiert."
                            },
                            {
                                "example_id": "3039ae53-792b-4be1-adeb-380133e11256",
                                "sense_id": "15fe5216-e99a-325b-a137-c58b0d50e807",
                                "text": "In der DDR gab es kein echtes Briefgeheimnis, die Staatssicherheit durfte alle Briefe öffnen."
                            },
                            {
                                "example_id": "5f633da6-d0a7-4503-acb6-5768b1c41db0",
                                "sense_id": "15fe5216-e99a-325b-a137-c58b0d50e807",
                                "text": "„So erklärt sich, weshalb die Forderung nach Wahrung des Briefgeheimnisses eine der wesentlichen Forderungen der Revolution von 1848 gewesen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
