                {
                    "sense_id": "5f2b80f9-6314-35e8-9f74-7a0c4cfbfe8b",
                    "sense_definition": "A non-standard relative pronoun indicating possession, equivalent to whose or of which.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "possessive_relative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a problem <w>thats</w> solution is not yet clear.",
                            "target_lang_translations": {
                                "ru": "Это проблема, решение <w>которой</w> пока не ясно.",
                                "de": "Es ist ein Problem, <w>dessen</w> Lösung noch nicht klar ist.",
                                "fr": "C'est un problème <w>dont</w> la solution n'est pas encore claire.",
                                "it": "È un problema <w>la cui</w> soluzione non è ancora chiara."
                            }
                        },
                        {
                            "text": "She bought a book <w>thats</w> cover was torn.",
                            "target_lang_translations": {
                                "ru": "Она купила книгу, обложка <w>которой</w> была порвана.",
                                "de": "Sie kaufte ein Buch, <w>dessen</w> Einband zerrissen war.",
                                "fr": "Elle a acheté un livre <w>dont</w> la couverture était déchirée.",
                                "it": "Ha comprato un libro <w>la cui</w> copertina era strappata."
                            }
                        }
                    ],
                    "synonyms": [
                        "whose"
                    ],
                    "traits": [
                        {
