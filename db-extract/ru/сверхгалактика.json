                "translations": [
                    {
                        "translation_id": "0ca4f690-8415-427d-94ab-b3b2e7e0968a",
                        "source_entry_id": "c67843bb-0ac1-328b-915c-d4c1b26babf7",
                        "source_sense_id": "5cd1a046-bb5c-39bb-821a-9ac5f34e5ab1",
                        "target_lang_word": "supergalaxy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supergalaxy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93df39ef-a37e-328b-bb2f-5d646e48f23a",
                                        "entry_id": "6ccc9009-9c73-31d7-9237-f7ccc498009b",
                                        "glosses": [
                                            "A very large, extended cluster of galaxies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07eb46f5-86a2-4994-a8f4-b3495417eb07",
                                                "sense_id": "93df39ef-a37e-328b-bb2f-5d646e48f23a",
                                                "text": "Our galaxy, together with the ninety-three globular clusters and the two Magellanic Clouds, forms a sort of super-galaxy in space."
                                            },
                                            {
                                                "example_id": "ff83ced3-c06f-422b-8adf-ce1aff5b88d4",
                                                "sense_id": "93df39ef-a37e-328b-bb2f-5d646e48f23a",
                                                "text": "The radio galaxies Virgo A, Centaurus A and possibly Fornax A lie within the Local Supergalaxy. In addition, the weaker galaxies NGC 4261, M84 and NGC 1068 are also located in this supergalaxy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b2150f2-b319-3f5a-81da-e3d79934766b",
                                        "entry_id": "6ccc9009-9c73-31d7-9237-f7ccc498009b",
                                        "glosses": [
                                            "A single, isolated galaxy as a result of a wholesale merger of a galaxy cluster or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53656d22-e307-40f9-91f0-51b30d73da70",
                                                "sense_id": "4b2150f2-b319-3f5a-81da-e3d79934766b",
                                                "text": "Our descendants will observe that they live in a blob of stars, which results from gravity pulling together a few nearby galaxies into one supergalaxy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
