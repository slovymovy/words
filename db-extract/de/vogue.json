                                                "sense_id": "1e950c0f-24b1-3689-ae12-925611972caa",
                                                "text": "Hula hoops are no longer in vogue."
                                            },
                                            {
                                                "example_id": "c2e5abff-d14a-4f06-8be8-f69c9329e8cf",
                                                "sense_id": "1e950c0f-24b1-3689-ae12-925611972caa",
                                                "text": "The rotation of nine years with two fallowings, which was formerly so much in vogue, is now seldom or never to be met with; it was, however, productive of very fine crops of corn on tenacious soils which require a great deal of tillage."
                                            }
                                        ]
                                    },
