                "senses": [
                    {
                        "sense_id": "e62f152f-4f91-3153-971c-b54698a51198",
                        "entry_id": "5b158c89-a8a4-3a1c-941f-ff0fc60e67d5",
                        "glosses": [
                            "dokument o wartości historycznej, kwalifikujący się do przechowywania w archiwum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7650f3c-c748-4893-8cce-0b2b39eb4944",
                                "sense_id": "e62f152f-4f91-3153-971c-b54698a51198",
                                "text": "Państwo Marzenna i Zbigniew Burczakowie, dzieci śp. pułkownika Kazimierza Burczaka, przekazali do zbiorów Muzeum Katyńskiego kolekcję fotografii i archiwaliów dotyczących ich Ojca. … Innym cennym archiwalium jest Karta Legitymacyjna Oficerska 5. Pułku Piechoty Legionów, należąca do płk Burczaka."
                            },
                            {
                                "example_id": "4340ba38-8fa9-410e-a96d-0bf95090c191",
                                "sense_id": "e62f152f-4f91-3153-971c-b54698a51198",
                                "text": "Jedyny dokument na świecie … Właściwie każde archiwalium ma taki charakter, stąd posiada bezcenną wartość."
                            },
                            {
                                "example_id": "5bb35695-d0e7-4a28-8901-8cf2d5efbcaf",
                                "sense_id": "e62f152f-4f91-3153-971c-b54698a51198",
                                "text": "Książka Rozkazów oddziału partyzanckiego \"Bug\" …, obejmująca okres od 04.10.1943 do 08.07.1944 roku. … Archiwalium to pochodzi ze zbiorów prywatnych pana Władysława Tołysza."
                            },
                            {
                                "example_id": "795fb142-dc35-4c9b-a3f4-c04a7a6cc9ff",
                                "sense_id": "e62f152f-4f91-3153-971c-b54698a51198",
                                "text": "Przykładowe archiwalium na stronie. 1933. Cieszanów Podwórku Szajowskich przed garażem. … Format fotografii: 8,5 x 13 cm."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
