                "senses": [
                    {
                        "sense_id": "3644f534-d052-359a-b523-73f18f306066",
                        "entry_id": "55abb011-b7b1-3dfc-acb0-7f2f512cd7cb",
                        "glosses": [
                            "Publication de pourriels sur Internet."
                        ],
                        "tags": [
                            "Internet",
                            "Sécurité informatique"
                        ],
                        "examples": [
                            {
                                "example_id": "d7d5870a-bc6a-47d2-aedc-7150ddc14a72",
                                "sense_id": "3644f534-d052-359a-b523-73f18f306066",
                                "text": "En outre, les coûts supportés par les FSI pour gérer les pollupostages sont souvent répercutés sur les consommateurs."
                            },
                            {
                                "example_id": "b336b044-f0e5-4dad-ae9e-f81c0f4b8877",
                                "sense_id": "3644f534-d052-359a-b523-73f18f306066",
                                "text": "Un cadre réglementaire national complet a été instauré pour répondre aux préoccupations des entreprises et des usagers concernant le pollupostage, c’est-à-dire l’envoi de messages commerciaux non sollicités."
                            },
                            {
                                "example_id": "f17ca35e-7e6b-4c06-bb5e-fd0e6ff3890b",
                                "sense_id": "3644f534-d052-359a-b523-73f18f306066",
                                "text": "Avec l’augmentation du nombre de blogs, le phénomène du pollupostage (spam), à l’origine associé seulement au courrier électronique, pénètre aujourd’hui la blogosphère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1efba939-482c-4a02-a2e6-61ea45f0d71b",
                        "source_entry_id": "55abb011-b7b1-3dfc-acb0-7f2f512cd7cb",
                        "source_sense_id": "3644f534-d052-359a-b523-73f18f306066",
                        "target_lang_word": "spam",
