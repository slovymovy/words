                        ],
                        "form": "den Landauer"
                    },
                    {
                        "form_id": "9b414c51-dd54-4fa5-a24c-6732a0576260",
                        "entry_id": "0428ef84-a77d-3731-b59f-c49fa365651b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Landauer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2827e776-bac8-34c5-a394-981ff9fb011e",
                        "entry_id": "0428ef84-a77d-3731-b59f-c49fa365651b",
                        "glosses": [
                            "viersitzige Pferdekutsche, die mit geschlossenem oder offenem Verdeck gefahren werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5029ba0f-2f2e-4af0-b16e-f6ca5ef2c65f",
                                "sense_id": "2827e776-bac8-34c5-a394-981ff9fb011e",
                                "text": "„Früher war hier nur Platz für die Familienkutschen: einen Landauer und den Maff-Wagen des Großvaters, so Leaver, »Spirituskocher, Heuschrecke und Mucke-Picke genannt«.“."
                            },
                            {
                                "example_id": "3fbeb20a-6bac-4870-bf25-a56f4cc05ea5",
                                "sense_id": "2827e776-bac8-34c5-a394-981ff9fb011e",
                                "text": "„Sie traten auf den Bürgersteig hinaus und Colonel Jim rief einen eleganten Landauer herbei.“"
                            },
                            {
                                "example_id": "fe17169e-6d84-4027-a19b-7ea16eba9597",
                                "sense_id": "2827e776-bac8-34c5-a394-981ff9fb011e",
                                "text": "„Ich dachte an Stanley, an den Abend, an dem ich ihm nach seiner Entlassung aus Fort Oglethorpe begegnete, an den offenen Landauer, den wir mieteten, und die auf dem Sitz gegenüber aufgeschichteten Bierflaschen.“"
                            },
                            {
                                "example_id": "92e503eb-6251-458e-8d60-12f73bb4f995",
                                "sense_id": "2827e776-bac8-34c5-a394-981ff9fb011e",
                                "text": "„Da der Karneval am nächsten Tag begann, mietete ich einen Landauer für die ganzen acht Tage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8fbebdb-ba78-3849-b87a-75f4add1b5be",
                        "entry_id": "0428ef84-a77d-3731-b59f-c49fa365651b",
                        "glosses": [
                            "Einwohner von Landau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22546e4b-656a-4ef4-9c7e-61e02bc58e3e",
                                "sense_id": "c8fbebdb-ba78-3849-b87a-75f4add1b5be",
                                "text": "Max Müller ist ein Landauer."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c381197e-9f73-4c73-9345-baa9270a6d36",
                        "source_entry_id": "0428ef84-a77d-3731-b59f-c49fa365651b",
                        "source_sense_id": "2827e776-bac8-34c5-a394-981ff9fb011e",
                        "source_sense_description": "viersitzige Pferdekutsche, die mit geschlossenem oder offenem Verdeck gefahren werden kann",
                        "target_lang_word": "landau",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landau",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a381a7ca-40ad-37da-9a35-1dae730033d3",
                                        "entry_id": "2d62f98d-b2ae-3415-ad47-4a810265bbdf",
                                        "glosses": [
                                            "A type of lightweight, four-wheeled carriage in which the front and back passenger seats face each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ea87a0-ba3d-4b44-be39-53ce7210a85a",
                                                "sense_id": "a381a7ca-40ad-37da-9a35-1dae730033d3",
                                                "text": "Indeed, as the two gentlemen reached the door, a landau drove up, a magnificent yellow carriage, lined with brocade or satin of a faint cream colour, drawn by wonderful grey horses, with flaming ribbons, and harness blazing all over with crests: no less than three of these heraldic emblems surmounted the coats-of-arms on the panels, and these shields contained a prodigious number of quarterings, betokening the antiquity and splendour of the house of Clavering and Snell."
                                            },
                                            {
                                                "example_id": "6929c979-aa3f-4456-9ddc-6ce6cd1d523d",
                                                "sense_id": "a381a7ca-40ad-37da-9a35-1dae730033d3",
                                                "text": "On an early winter afternoon, clear but not cold, when the vegetable world was a weird multitude of skeletons through whose ribs the sun shone freely, a gleaming landau came to a pause on the crest of a hill in Wessex."
                                            },
                                            {
                                                "example_id": "70fd9c01-b673-49f1-9a85-424cde9de2a4",
                                                "sense_id": "a381a7ca-40ad-37da-9a35-1dae730033d3",
                                                "text": "Away they went, and I was just wondering whether I should not do well to follow them, when up the lane came a neat little landau, the coachman with his coat only half buttoned, and his tie under his ear, while all the tags of his harness were sticking out of the buckles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5eecd02-fe41-32e6-9612-70d54d95d594",
                                        "entry_id": "2d62f98d-b2ae-3415-ad47-4a810265bbdf",
                                        "glosses": [
                                            "A style of automobile based around the design of landau carriages."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee20a2f1-89ec-41ad-880d-ad19110dc56d",
                        "source_entry_id": "0428ef84-a77d-3731-b59f-c49fa365651b",
                        "source_sense_id": "2827e776-bac8-34c5-a394-981ff9fb011e",
                        "source_sense_description": "viersitzige Pferdekutsche, die mit geschlossenem oder offenem Verdeck gefahren werden kann",
                        "target_lang_word": "landau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae55fcd-f1b8-3a89-894c-bd0ffa956b87",
                                        "entry_id": "63087c93-aa32-387c-bbf3-aa41305713ff",
                                        "glosses": [
                                            "Sorte de voiture hippomobile à quatre roues qui peut se fermer au moyen de deux soufflets se repliant à volonté. Le conducteur restant toujours à l'air libre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f40fa1-d275-4736-ba32-9281cd79b6ff",
                                                "sense_id": "4ae55fcd-f1b8-3a89-894c-bd0ffa956b87",
                                                "text": "Çà et là, dans un landau découvert, éclatait un bout d’étoffe, un bout de toilette de femme, soie ou velours."
                                            },
                                            {
                                                "example_id": "ea2cefbe-7011-4f78-b464-1a0e2d435485",
                                                "sense_id": "4ae55fcd-f1b8-3a89-894c-bd0ffa956b87",
                                                "text": "Alain était resté bouche bée et les yeux fixés sur une voiture qui arrivait du côté de la rue dé la Paix, au grand trot de deux superbes chevaux alezans : un landau découvert, un huit-ressorts à quatre places."
                                            },
                                            {
                                                "example_id": "4b0c0614-0d06-4b93-935c-082558554bc7",
                                                "sense_id": "4ae55fcd-f1b8-3a89-894c-bd0ffa956b87",
                                                "text": "Vinrent encore un lourd omnibus automobile moins rapide mais plus effrayant, sonnant de la trompe sans discontinuer, une antique calèche au devant vitré, un landau mené par de solides et lents chevaux percherons, puis des charrettes anglaises élégantes, et encore des automobiles et des pétrolettes : ce fut durant vingt minutes une succession presque ininterrompue d'équipages et de véhicules attirant les villageois sur le seuil des portes."
                                            },
                                            {
                                                "example_id": "1682b490-8fc3-46da-b957-cd8e8f37d19b",
                                                "sense_id": "4ae55fcd-f1b8-3a89-894c-bd0ffa956b87",
                                                "text": "La voiture qu’il a commandée est annoncée : c’est un landau, s’il vous plaît..., mais tout à fait délabré. Tel qu’il est, il nous vaut néanmoins le respect du garçon d’hôtel, qui s’incline très bas devant nous lorsque nous montons en voiture."
                                            },
                                            {
                                                "example_id": "23ba64ed-ed0f-46c4-90a0-c09416c79eb6",
                                                "sense_id": "4ae55fcd-f1b8-3a89-894c-bd0ffa956b87",
                                                "text": "On y fit amitié avec sa propriétaire, la baronne V., aimable vieille dame ayant du goût pour la musique et les livres, et qui convie souvent les trois Français à de belles promenades en landau à l’intérieur des terres."
                                            },
                                            {
                                                "example_id": "6e23109b-7125-489c-a52e-437bc1be1f08",
                                                "sense_id": "4ae55fcd-f1b8-3a89-894c-bd0ffa956b87",
                                                "text": "Elle quitte sa résidence officielle, Rideau Hall, à bord d'un landau tiré par quatre magnifiques chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70d1203-e3f2-3a11-a1c7-5d39a230ce66",
                                        "entry_id": "63087c93-aa32-387c-bbf3-aa41305713ff",
                                        "glosses": [
                                            "Automobile dont la partie arrière de l'habitacle est recouverte de skaï noir ou crème imitant les capotes à soufflets"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2790a874-caf5-316c-9367-c8eaabd885d9",
                                        "entry_id": "63087c93-aa32-387c-bbf3-aa41305713ff",
                                        "glosses": [
                                            "Ce genre de véhicule conçu tout spécialement pour y transporter un jeune enfant en position allongée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29804328-97c4-48ae-b5c6-a0c085681851",
                                                "sense_id": "2790a874-caf5-316c-9367-c8eaabd885d9",
                                                "text": "Elle est soulagée qu’il s’éloigne. Passe un homme qui pousse un enfant dans un landau tellement high-tech qu’on le croirait parti pour le Paris-Dakar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
