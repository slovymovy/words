                    },
                    {
                        "translation_id": "882a093b-f617-439b-982f-368a1bac19f8",
                        "source_entry_id": "c680c494-9a74-3e67-b684-8ae9efa382b8",
                        "source_sense_description": "of or relating to etymology",
                        "target_lang_word": "etymologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etymologisch",
