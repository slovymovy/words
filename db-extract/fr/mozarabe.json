                "senses": [
                    {
                        "sense_id": "96209234-798f-3c46-8d0d-46d0734df50f",
                        "entry_id": "ac4e02fc-2618-3905-98bc-a54ec9391faa",
                        "glosses": [
                            "Chrétien de la péninsule Ibérique soumis à la domination des Arabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f2c5ed3-4307-4ad3-94c1-8cdfbc11f335",
                                "sense_id": "96209234-798f-3c46-8d0d-46d0734df50f",
                                "text": "Daniel de Morlay a révélé avoir été aidé par un mozarabe nommé Galip pour l’Almageste de Ptolémée."
                            },
                            {
                                "example_id": "2c719d56-ac14-432c-b1f7-c3e4c9a3aeea",
                                "sense_id": "96209234-798f-3c46-8d0d-46d0734df50f",
                                "text": "Les mozarabes furent persécutés, en particulier sous les Omeyyades d’Espagne, qui régnèrent à Cordoue de 756 à 1031."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce13fa58-f2a0-44a9-919c-a95def52917f",
                        "source_entry_id": "ac4e02fc-2618-3905-98bc-a54ec9391faa",
                        "source_sense_id": "96209234-798f-3c46-8d0d-46d0734df50f",
