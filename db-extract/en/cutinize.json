                "senses": [
                    {
                        "sense_id": "80ea9f09-ebd6-3b3c-9988-881c3aa70053",
                        "entry_id": "e1444855-c0a7-353c-b3c7-739f1fb22da1",
                        "glosses": [
                            "To change into cutin."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7cf5a8e6-1f98-464d-a7ee-d41e15346797",
                                "sense_id": "80ea9f09-ebd6-3b3c-9988-881c3aa70053",
                                "text": "Sulphuric acid and chromic acid, even when concentrated, produce little effect on cutinized membranes, beyond removing traces of cellulose present in the cell-wall."
                            },
                            {
                                "example_id": "6dbeb123-85be-4b32-9055-7dab779ce43f",
                                "sense_id": "80ea9f09-ebd6-3b3c-9988-881c3aa70053",
                                "text": "Leaves normally or experimentally developed as underground scales cutinize both upper and lower surfaces, and diminish the formation of collenchyma, palisade cells and intercellular spaces."
                            },
                            {
                                "example_id": "e6b4316b-2840-4a5b-ae3b-b5fd3b2d4081",
                                "sense_id": "80ea9f09-ebd6-3b3c-9988-881c3aa70053",
                                "text": "They may be separated early from the mother tissue by cutinizing their surface."
                            }
                        ]
                    }
                ],
