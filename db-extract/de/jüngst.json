                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3ab7009-cb4c-4b45-a004-dfd420a33203",
                                "sense_id": "3dfb780f-b110-3a8e-85b2-ac9aa1fb5cea",
                                "text": "Er hat jüngst sein vierzigjähriges Dienstjubiläum gefeiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba552000-1466-4eff-806e-94e0d3f60ebf",
                        "source_entry_id": "ea200cc7-2805-34f9-b27b-e47ff809d480",
                        "source_sense_id": "3dfb780f-b110-3a8e-85b2-ac9aa1fb5cea",
                        "source_sense_description": "vor kurzem",
                        "target_lang_word": "recently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                        "entry_id": "6dc644cb-40c6-3768-b4b0-4d2d16a3e0f4",
                                        "glosses": [
                                            "In the recent past",
                                            "a short while ago."
                                        ],
                                        "tags": [
                                            "referring to a point of time in the recent past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "515f07a8-283b-4b94-bdc6-1c4700bb0273",
                                                "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                                "text": "My recently published book about the life stories of recently-arrived immigrants."
                                            },
                                            {
                                                "example_id": "188f866c-98c0-4b11-9b40-c017c7b5a24d",
                                                "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                        "entry_id": "6dc644cb-40c6-3768-b4b0-4d2d16a3e0f4",
                                        "glosses": [
                                            "In the recent past",
                                            "in recent times."
                                        ],
                                        "tags": [
                                            "referring to a time period starting in the recent past and including the present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb89aeae-89fd-40f0-a7ba-2c4f97ff8b80",
                                                "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                                "text": "I haven't been sleeping well recently."
                                            },
                                            {
                                                "example_id": "4f3a357a-b53a-45ca-a057-21e157f6043c",
                                                "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76cc91c4-1f51-4677-9fd8-d47e115b6532",
                        "source_entry_id": "ea200cc7-2805-34f9-b27b-e47ff809d480",
                        "source_sense_id": "3dfb780f-b110-3a8e-85b2-ac9aa1fb5cea",
                        "source_sense_description": "vor kurzem",
                        "target_lang_word": "récemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "récemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                        "entry_id": "d168b27d-2a64-355d-994a-91ae69bed098",
                                        "glosses": [
                                            "Il y a peu de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca9760cd-b76e-43ca-9ee3-4158e8391513",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "— Parfaitement... et il a dit à ces dames que c'était un étranger, arrivé récemment à Paris et colossalement riche."
                                            },
                                            {
                                                "example_id": "c3a6697d-7cd3-43fa-8f3b-f65a6363bfd1",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "Plusieurs constitutions adoptées récemment ont inclus des garanties spécifiques liées à la liberté d'information, reflétant une acceptation croissante de ce droit humain fondamental."
                                            },
                                            {
                                                "example_id": "2a63b65f-141f-47f3-b937-48631bb7f4a3",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "Les tribus, dites actuellement arabes, résultent du mélange des Beni-Hassan ou Hassan, plus récemment arrivés dans le pays, avec les Zenaga qui y étaient établis plus anciennement."
                                            },
                                            {
                                                "example_id": "bb43bd01-e814-4ee8-886a-974ec49d1a7e",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "Récemment relancé par Mehdi Chaoua et Ayoub Shaïb, deux amis et enfants du quartier de Crouin, le Club Football Crouin (CFC) a besoin d’un soutien financier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f00cb443-4e64-4b95-9845-45e066219c08",
                        "source_entry_id": "ea200cc7-2805-34f9-b27b-e47ff809d480",
                        "source_sense_id": "3dfb780f-b110-3a8e-85b2-ac9aa1fb5cea",
                        "source_sense_description": "vor kurzem",
                        "target_lang_word": "il y a peu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "il y a peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dfb597b-cef5-3bbd-b926-41b97e13ee2a",
                                        "entry_id": "1d2bc4a8-717e-3d11-96e6-8c78a38bada8",
                                        "glosses": [
                                            "Récemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc83b252-53a7-46c9-a49f-f7bf0474ab04",
                                                "sense_id": "3dfb597b-cef5-3bbd-b926-41b97e13ee2a",
                                                "text": "Il y a peu, il s’est rabiboché avec Émerse Faé, le sélectionneur ivoirien, qui avait peu goûté ses critiques sur la CAN."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5869d857-7d1f-4221-9bd7-1c1cc73c42e4",
                        "source_entry_id": "ea200cc7-2805-34f9-b27b-e47ff809d480",
                        "source_sense_id": "3dfb780f-b110-3a8e-85b2-ac9aa1fb5cea",
                        "source_sense_description": "vor kurzem",
                        "target_lang_word": "dernièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dernièrement",
