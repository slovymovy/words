                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8e42081c-76f0-4395-b945-54b5ac64b92b",
                        "source_entry_id": "62ee3d0d-9130-36bf-b47b-1cd02be7fc56",
                        "source_sense_id": "dad957ad-5848-3276-95ff-33cae703f9f2",
                        "target_lang_word": "daub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a1f8241-3955-3123-95c1-451c2a67fa1c",
                                        "entry_id": "d0325be9-714e-3c19-b027-7cbf463f92b1",
                                        "glosses": [
                                            "Excrement or clay used as a bonding material in construction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "912e4779-cd63-3cdf-8664-4ee998c1f7d2",
                                        "entry_id": "d0325be9-714e-3c19-b027-7cbf463f92b1",
                                        "glosses": [
                                            "A soft coating of mud, plaster, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f9abe32-fb3e-32a1-aa7c-86d7fdf690f3",
                                        "entry_id": "d0325be9-714e-3c19-b027-7cbf463f92b1",
                                        "glosses": [
                                            "A crude or amateurish painting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc89fb2-1216-40b8-bc6d-c51a3d092215",
                                                "sense_id": "9f9abe32-fb3e-32a1-aa7c-86d7fdf690f3",
                                                "text": "Ah, but what if he penned what in the art schools they call an 'artist's statement' wherein he explained the relation of his gibberish or his daubs to the mainstream of art or writing?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                        "entry_id": "219cc60e-f40d-3ae7-95e9-3d553a1aac9b",
                                        "glosses": [
                                            "To apply (something) to a surface in hasty or crude strokes."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f769f7f-6af6-4204-a751-280b0d6a50d1",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "The artist just seemed to daub on paint at random and suddenly there was a painting."
                                            },
                                            {
                                                "example_id": "d1b565fb-c35e-4885-92cb-63a643d47895",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "[…] she took for him an ark of bulrushes, and daubed it with slime and with pitch […]"
                                            },
                                            {
                                                "example_id": "eb00a8eb-daf2-4268-8455-4ada2bf1debb",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "[…] Mrs. Gibson could not well come up to the girl’s bedroom every night and see that she daubed her face and neck over with the cosmetics so carefully provided for her."
                                            },
                                            {
                                                "example_id": "ba5a72ea-25fd-4a5e-b9aa-b97a6de6bb70",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "An artist friend fitted her out with his castoff palettes, brushes, and colors, and she daubed away, producing pastoral and marine views such as were never seen on land or sea."
                                            },
                                            {
                                                "example_id": "6a4f8c8d-6157-49dc-bf69-a0ca3dba693d",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "[…] as he watched, [the motorcar] came up the snow-covered road, green and brown painted, in broken patches of daubed color, the windows blued over so that you could not see in […]"
                                            },
                                            {
                                                "example_id": "36e20261-8886-4f5a-a265-e446796452c7",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "Blood was running to her shoe, and her stocking was torn in a jagged hole. […] she wet toilet paper and daubed until the red was gone from her stocking, but the red kept coming."
                                            },
                                            {
                                                "example_id": "63646d76-92bd-4e02-8ce3-01ced100fb49",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "They were expecting to see me, she said, daubing paint on the canvas and stepping back to gauge the effect."
                                            },
                                            {
                                                "example_id": "7872b652-8f33-4247-8243-748ed6801991",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "Cylindrical lanterns daubed in red writing hung at intervals across wooden beams […]"
                                            },
                                            {
                                                "example_id": "89e94b53-a4e3-4a0f-a19e-60bb13142bd2",
                                                "sense_id": "c922afb3-d7fb-3fea-ad10-c3bfc0b80a29",
                                                "text": "Unfortunately, one side of the new five-car train is daubed in graffiti, having been vandalised in Wembley Yard, en route from Switzerland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16ffc15-614c-37a7-a72a-62de5e73a26c",
                                        "entry_id": "219cc60e-f40d-3ae7-95e9-3d553a1aac9b",
                                        "glosses": [
                                            "To paint (a picture, etc.) in a coarse or unskilful manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fdbd9c2-29e8-4e4c-8b85-c630965fe3c9",
                                                "sense_id": "b16ffc15-614c-37a7-a72a-62de5e73a26c",
                                                "text": "[…] a lame, imperfect Piece, rudely daub’d over with too little Reflection and too much haste."
                                            },
                                            {
                                                "example_id": "b8d2bb41-58e8-49d6-99e6-522322f22c04",
                                                "sense_id": "b16ffc15-614c-37a7-a72a-62de5e73a26c",
                                                "text": "If a Picture is daub’d with many bright and glaring Colours, the vulgar Eye admires it as an excellent Piece […]"
                                            },
                                            {
                                                "example_id": "442fb94f-ce75-4aa3-83aa-7a7de904567c",
                                                "sense_id": "b16ffc15-614c-37a7-a72a-62de5e73a26c",
                                                "text": "1826, Elizabeth Barrett Browning, An Essay on Mind, Book I, in The Earlier Poems of Elizabeth Barrett Browning, 1826-1833, London: Bartholomew Robson, 1878, pp. 25-26,\nIf some gay picture, vilely daubed, were seen\nWith grass of azure, and a sky of green,\nTh’impatient laughter we’d suppress in vain,\nAnd deem the painter jesting, or insane."
                                            },
                                            {
                                                "example_id": "a9828733-1423-40c3-8912-57c3287cbb56",
                                                "sense_id": "b16ffc15-614c-37a7-a72a-62de5e73a26c",
                                                "text": "[…] this stretch of the shore is still filthy with trash; high-school gangs still daub huge scandalous words on its beach-wall, and seashells are still less easy to find here than discarded rubbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ee27b6-b6f4-3f41-94fe-a99a0e5346ab",
                                        "entry_id": "219cc60e-f40d-3ae7-95e9-3d553a1aac9b",
                                        "glosses": [
                                            "To cover with a specious or deceitful exterior; to disguise; to conceal."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58a6b14a-072c-4879-8644-59e7dcd77e27",
                                                "sense_id": "90ee27b6-b6f4-3f41-94fe-a99a0e5346ab",
                                                "text": "So smooth he daub’d his vice with show of virtue,"
                                            },
                                            {
                                                "example_id": "d0e329f0-9029-4f08-93d0-b7dca52135ca",
                                                "sense_id": "90ee27b6-b6f4-3f41-94fe-a99a0e5346ab",
                                                "text": "No flattering praises daub my stone,\nMy frailties and my faults to hide;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2494a85-b43c-3837-8ff1-7c51ba37933c",
                                        "entry_id": "219cc60e-f40d-3ae7-95e9-3d553a1aac9b",
                                        "glosses": [
                                            "To flatter excessively or grossly."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06c8905-30c6-4d9f-861c-64d629e1c176",
                                                "sense_id": "d2494a85-b43c-3837-8ff1-7c51ba37933c",
                                                "text": "I can safely say, however, that without any daubing at all, I am, very sincerely, Your very affectionate, humble servant,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c447392c-266e-3eec-9468-ae754907ed37",
                                        "entry_id": "219cc60e-f40d-3ae7-95e9-3d553a1aac9b",
                                        "glosses": [
                                            "To put on without taste; to deck gaudily."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39091cfb-227e-4db8-8f37-8b5f4f1a06f0",
                                                "sense_id": "c447392c-266e-3eec-9468-ae754907ed37",
                                                "text": "1697, John Dryden, “On the Three Dukes killing the Beadle on Sunday Morning, Febr. the 26th, 1670/1” in John Denham et al., Poems on affairs of state from the time of Oliver Cromwell, to the abdication of K. James the Second, London, p. 148,\nYet shall Whitehall the Innocent, the Good,\nSee these men dance all daub’d with Lace and Blood."
                                            },
                                            {
                                                "example_id": "87bd1a39-dd77-4a27-aff3-6932f03c425e",
                                                "sense_id": "c447392c-266e-3eec-9468-ae754907ed37",
                                                "text": "[…] whenever they came in order to pay those islanders a visit, [they] were generally very well dressed, and very poor, daubed with lace, but all the gilding on the outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e60e05d6-f8e9-3552-950e-176ea1530813",
                                        "entry_id": "219cc60e-f40d-3ae7-95e9-3d553a1aac9b",
                                        "glosses": [
                                            "To mark spots on a bingo card, using a dauber."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
