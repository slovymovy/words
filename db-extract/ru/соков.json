        "ru-extract.jsonl": [
            {
                "entry_id": "bd2dbab6-1f9a-310f-8c55-ee83092e0e7a",
                "word": "Соков",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                        "entry_id": "bd2dbab6-1f9a-310f-8c55-ee83092e0e7a",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7fb74e-ca6d-4e55-bf37-0395fd6a4823",
                                "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                                "text": ".. в лавке Сокова .. продают остатки ситцев .."
                            },
                            {
                                "example_id": "e8bdd6d9-183e-4efb-8a13-bfa4ff09fea8",
                                "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                                "text": "— .. я — здешний дворецкий, Максим Соков…"
                            },
                            {
                                "example_id": "963558f5-9051-4978-a45a-793166101f37",
                                "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                                "text": "Человечек был буфетчиком в Варьете и назывался Андрей Фокич Соков."
                            },
                            {
                                "example_id": "36d67b76-3312-41e3-b67d-7eedd0ac9ec9",
                                "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                                "text": ".. оказалось, что должность консула занимает С. В. Соков, с которым я познакомился в октябре 1894 г. в Кульдже, возвращаясь из экспедиции в Центральную Азию .."
                            },
                            {
                                "example_id": "cbe7ffbb-5888-4fc7-9be5-3c5404889cd5",
                                "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                                "text": ".. у него был Федька Соков, который работает на станции кузнецом .."
                            },
                            {
                                "example_id": "33a2f199-5077-4e82-969e-523d05e10be7",
                                "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                                "text": "Малышня слушала истории старшей дочки Соковых, Любки."
                            },
                            {
                                "example_id": "d4304bc7-8392-47d7-8756-a7e3c192c3cc",
                                "sense_id": "7d1d9234-b0d1-3d3a-a9a7-3a18ca8e2be1",
                                "text": "Был Алексей Петрович Соков худ, лёгок и с маленькими голубыми глазами — яркими, как у маньяка."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
