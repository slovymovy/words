    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0eb605eb-7c75-3fe7-a2c6-de0335895f2a",
                    "sense_definition": "Petite tache brunâtre ou dorée apparaissant sur la peau, le plus souvent sous l'effet du soleil.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès les premiers jours de l'été, de petites <w>rousseurs</w> apparaissent sur son nez."
                        },
                        {
                            "text": "Le jeune garçon porte avec fierté les <w>rousseurs</w> qui parsèment ses joues."
                        }
                    ],
                    "synonyms": [
                        "éphélide"
                    ],
                    "common_phrases": [
                        "taches de rousseur",
                        "avoir des rousseurs"
                    ]
                },
                {
                    "sense_id": "ffa87b34-427c-37d1-b6b2-786a6b299705",
                    "sense_definition": "Couleur ou teinte rousse caractéristique, en particulier des cheveux, du pelage ou des feuilles en automne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En octobre, la <w>rousseur</w> des arbres annonce l'installation progressive de la saison froide."
                        },
                        {
                            "text": "Elle se distingue immédiatement dans la foule par la <w>rousseur</w> éclatante de ses cheveux."
                        }
                    ],
                    "common_phrases": [
                        "rousseur du feuillage",
                        "rousseur des cheveux"
                    ]
                },
                {
                    "sense_id": "4952b899-f02c-33e9-87d2-b03fade5ff3f",
                    "sense_definition": "Tache jaunâtre ou brun clair causée par l'humidité et le temps sur du papier, des gravures ou des tissus.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce livre ancien a été mal conservé et ses pages blanches sont couvertes de <w>rousseurs</w>."
                        },
                        {
                            "text": "Le restaurateur tente d'atténuer la <w>rousseur</w> qui abîme cette vieille gravure de maître."
                        }
                    ],
                    "common_phrases": [
                        "couvert de rousseurs"
                    ]
                }
            ]
        }
    ]
