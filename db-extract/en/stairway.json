                "senses": [
                    {
                        "sense_id": "77309bfb-9975-3a50-8dd5-e7cd6b15f1a5",
                        "entry_id": "8948310d-14b9-310a-97d4-cbdbb57806da",
                        "glosses": [
                            "A set of steps, with or without a case, that allow one to walk up or down."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28c4ba3-0586-4ff0-a069-2b25a085394e",
                                "sense_id": "77309bfb-9975-3a50-8dd5-e7cd6b15f1a5",
                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps, with something of the stately pose which Richter has given his Queen Louise on the stairway,[…]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d432db8c-e409-48d3-a607-84a96942368e",
                        "source_entry_id": "8948310d-14b9-310a-97d4-cbdbb57806da",
                        "source_sense_id": "77309bfb-9975-3a50-8dd5-e7cd6b15f1a5",
