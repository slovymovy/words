                        "sense_id": "cf6182af-b354-3799-8672-f1a2f723004c",
                        "entry_id": "bd2c67e0-5584-3f85-b6c3-d906a0d5e938",
                        "glosses": [
                            "Donner un caractère francilien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be48a6b5-f3e0-48a8-b5df-c026a74c2dc0",
                                "sense_id": "cf6182af-b354-3799-8672-f1a2f723004c",
                                "text": "Le fait de vouloir \"francilianiser\" tous les citoyens français démontre bien que les objectifs à long terme de la République étaient de faire disparaître ces nuances pour arriver à l'équation parfaite \"Français = Francilien\"."
                            },
                            {
                                "example_id": "901c0f63-fe5d-442a-ba99-d036b22d6f1c",
                                "sense_id": "cf6182af-b354-3799-8672-f1a2f723004c",
                                "text": "Celui d'Alternatiba a été francilianisé, grâce à Christine, de Bizi!, merci à elle!"
                            },
                            {
                                "example_id": "ebba6cd5-4b12-47cf-8dd6-2d463c33395b",
                                "sense_id": "cf6182af-b354-3799-8672-f1a2f723004c",
                                "text": "ça se francilianise, ça prend tournure !!!"
                            }
                        ]
