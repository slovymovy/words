                "senses": [
                    {
                        "sense_id": "622035ca-f6a0-3add-9400-ee20989fb351",
                        "entry_id": "49019501-9dcd-37c7-a502-989bd1350625",
                        "glosses": [
                            "vom Militär ausgeführter Angriff; ein Angriff mit militärischen Mitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f548b46d-8dc7-42ce-97eb-53bd556d2735",
                                "sense_id": "622035ca-f6a0-3add-9400-ee20989fb351",
                                "text": "„Auf dem Höhepunkt seiner schwersten Krise wird er am Dienstag mit einer Rede an die Nation um Zuspruch für einen Militärschlag gegen Syriens Regime werben: Er wolle seine Argumente \"so gut wie möglich\" ausbreiten, \"dem amerikanischen Volk wie der internationalen Gemeinschaft.\"“"
                            },
                            {
                                "example_id": "49334213-0ee0-4fa7-adf7-e75d97043e3a",
                                "sense_id": "622035ca-f6a0-3add-9400-ee20989fb351",
                                "text": "„Die Bundesregierung will sich an einem möglichen Militärschlag der USA auf Syrien nicht beteiligen.“"
                            },
                            {
                                "example_id": "27a41452-9849-4d93-a7a0-9e63fd8d8660",
                                "sense_id": "622035ca-f6a0-3add-9400-ee20989fb351",
                                "text": "„Der König, selbst Jesuitenzögling, lässt sich von einem Militärschlag gegen das Königreich in Simbabwe überzeugen.“"
                            },
                            {
                                "example_id": "8f6f0f5a-b1ac-46a8-9d7a-71ea1b95434f",
                                "sense_id": "622035ca-f6a0-3add-9400-ee20989fb351",
                                "text": "„Die strategische Lage unweit von Kap Horn würde Militärschläge im südlichen Atlantik und Pazifik erleichtern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
