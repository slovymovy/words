{
    "word_family": [
        "clothe",
        "clothing",
        "clothes",
        "clothier",
        "clothy",
        "unclothed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "414b7a54-b5a5-31ec-b466-8ab907bca9ea",
                    "sense_definition": "A fabric, usually made of woven, knitted, or felted fibres or filaments, such as used in dressing, decorating, cleaning or other practical use.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor used a high quality <w>cloth</w> to make the custom suit.",
                            "target_lang_translations": {
                                "ru": "Портной использовал высококачественную <w>ткань</w> для пошива костюма на заказ."
                            }
                        },
                        {
                            "text": "This soft <w>cloth</w> is perfect for making baby clothes.",
                            "target_lang_translations": {
                                "ru": "Эта мягкая <w>материя</w> идеально подходит для изготовления детской одежды."
                            }
                        }
                    ],
                    "synonyms": [
                        "material",
                        "stuff"
                    ],
                    "common_phrases": [
                        "woven cloth",
                        "piece of cloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ткань, обычно изготовленная из тканых, трикотажных или валяных волокон или нитей, используемая для одежды, декора, уборки или других практических целей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ткань",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "материя",
                                "target_lang_sense_clarification": "состав ткани"
                            },
                            {
                                "target_lang_word": "полотно",
                                "target_lang_sense_clarification": "кусок ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b2bc52-e25b-30c3-86a6-48f595c4b76b",
                    "sense_definition": "A piece of fabric used for a particular purpose, such as cleaning or wiping.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wipe the surface with a <w>cloth</w> dampened with mineral spirits in order to remove the sanding dust.",
                            "target_lang_translations": {
                                "ru": "Протрите поверхность <w>тряпкой</w>, смоченной в уайт-спирите, чтобы удалить шлифовальную пыль."
                            }
                        },
                        {
                            "text": "Please use a damp <w>cloth</w> to clean the kitchen table.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, используйте влажную <w>салфетку</w>, чтобы протереть кухонный стол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "damp cloth",
                        "cleaning cloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок ткани, используемый для определенной цели, например, для чистки или протирки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "для уборки"
                            },
                            {
                                "target_lang_word": "салфетка",
                                "target_lang_sense_clarification": "для протирки"
                            },
                            {
                                "target_lang_word": "ветошь",
                                "target_lang_sense_clarification": "старая ткань для чистки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d893471c-90ef-3da2-b7ae-68cf533309f7",
                    "sense_definition": "Specifically, a tablecloth, especially as spread before a meal or removed afterwards.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My husband was very much engaged in business and quitted the room soon after the <w>cloth</w> was removed.",
                            "target_lang_translations": {
                                "ru": "Мой муж был очень занят делами и покинул комнату вскоре после того, как со стола убрали <w>скатерть</w>."
                            }
                        },
                        {
                            "text": "She spread a white <w>cloth</w> over the table before the guests arrived.",
                            "target_lang_translations": {
                                "ru": "Она застелила стол белой <w>скатертью</w> до прихода гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lay the cloth",
                        "remove the cloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально: скатерть, особенно расстеленная перед едой или убранная после нее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скатерть",
                                "target_lang_sense_clarification": "покрывало на стол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dab73e6c-dc90-369f-8850-de87bbf01836",
                    "sense_definition": "The priesthood or the clergy as a profession.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a respected man of the <w>cloth</w> who has served the community for years.",
                            "target_lang_translations": {
                                "ru": "Он уважаемый <w>священнослужитель</w>, который много лет служил общине."
                            }
                        },
                        {
                            "text": "As a man of the <w>cloth</w>, he was expected to provide spiritual guidance.",
                            "target_lang_translations": {
                                "ru": "Как от <w>духовного лица</w>, от него ожидали духовного наставничества."
                            }
                        }
                    ],
                    "common_phrases": [
                        "man of the cloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Священство или духовенство как профессия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовенство",
                                "target_lang_sense_clarification": "сословие"
                            },
                            {
                                "target_lang_word": "священство",
                                "target_lang_sense_clarification": "сан"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35575e29-8672-3163-af28-25175a61c22d",
                    "sense_definition": "A form of attire that represents a particular profession or status.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could hardly come in the <w>cloth</w> of mourning to celebrate his two decades on the stool.",
                            "target_lang_translations": {
                                "ru": "Вряд ли он мог прийти в траурном <w>облачении</w>, чтобы отпраздновать два десятилетия своего правления."
                            }
                        },
                        {
                            "text": "Wearing the <w>cloth</w> of kings would seem to be an appropriate symbol for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Ношение королевского <w>одеяния</w> казалось подходящим символом для церемонии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloth of service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид облачения, представляющий определенную профессию или статус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачение",
                                "target_lang_sense_clarification": "официальная одежда"
                            },
                            {
                                "target_lang_word": "мундир",
                                "target_lang_sense_clarification": "форменная одежда"
                            },
                            {
                                "target_lang_word": "форма",
                                "target_lang_sense_clarification": "единообразная одежда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8295bb9-517f-3854-82dc-9edb1e392b9e",
                    "sense_definition": "Substance or essence; the whole of something complex.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot help seeing that we are but one glorious thread in the <w>cloth</w> of life.",
                            "target_lang_translations": {
                                "ru": "Мы не можем не видеть, что мы всего лишь одна славная нить в <w>ткани</w> жизни."
                            }
                        },
                        {
                            "text": "The rhythm of life in rural areas is often soaked in the <w>cloth</w> of continued tradition.",
                            "target_lang_translations": {
                                "ru": "Ритм жизни в сельской местности часто пропитан <w>основой</w> незыблемых традиций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloth of life",
                        "cloth of time"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сущность или основа; совокупность чего-то сложного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ткань",
                                "target_lang_sense_clarification": "структура чего-либо"
                            },
                            {
                                "target_lang_word": "канва",
                                "target_lang_sense_clarification": "основа событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d7c09f-938f-30b9-802b-e66e9701a65f",
                    "sense_definition": "Appearance or outward seeming.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The policy comes to us decorated in the <w>cloth</w> of emancipation and freedom.",
                            "target_lang_translations": {
                                "ru": "Эта политика предстает перед нами украшенной в <w>одежды</w> эмансипации и свободы."
                            }
                        },
                        {
                            "text": "It was a horrible nightmare cloaked in the <w>cloth</w> of good.",
                            "target_lang_translations": {
                                "ru": "Это был ужасный кошмар, скрытый под <w>личиной</w> добра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrapped in the cloth"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний вид или внешнее подобие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "внешний вид"
                            },
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "видимость"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}