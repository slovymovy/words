                    {
                        "sense_id": "9f357e7b-f32a-35b0-8cd9-72fd7ea16dbb",
                        "entry_id": "ac4922dd-765a-3a8c-92c0-37933d4afac9",
                        "glosses": [
                            "tijdelijke of verplaatsbare overdekte ruimte waarin bouwvakkers of andere arbeiders kunnen rusten en iets kunnen eten of drinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a99a41d-b7f7-47b0-81f6-2f750043b318",
                                "sense_id": "9f357e7b-f32a-35b0-8cd9-72fd7ea16dbb",
                                "text": "Van een parkeerplaats aan de Ronde Bultenweg in Haaksbergen is een groene schaftkeet gestolen. De opmerkelijke diefstal vond plaats ergens tussen vorige week vrijdag en afgelopen dinsdag."
                            },
                            {
                                "example_id": "a82c24fe-e108-4356-bcff-855e260d9515",
                                "sense_id": "9f357e7b-f32a-35b0-8cd9-72fd7ea16dbb",
                                "text": "Eef verschanst zich zoveel mogelijk in de caravan die als schaftkeet op het terrein is neergezet, en waarin zij geacht wordt de mannen van koffie te voorzien. Ze voelt zich op eigen terrein behandeld als ‘een geronselde Pool’, maar weet niet hoe ze voor zichzelf moet opkomen."
                            }
                        ]
                    }
