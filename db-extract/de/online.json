                                                "sense_id": "aeb89bed-37c0-3e22-87a4-97be3dc0b1e7",
                                                "text": "Le patron ne peut pas vous répondre, il est déjà en ligne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3590c79-7bcb-38ae-8d19-8da35c4175ee",
                                        "entry_id": "3c8c461a-0c75-365f-861d-948870cc4769",
                                        "glosses": [
                                            "Disponible à travers un réseau informatique."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414a1766-4beb-4582-9ee5-5b75ced593e0",
                                                "sense_id": "c3590c79-7bcb-38ae-8d19-8da35c4175ee",
                                                "text": "Le serveur est en ligne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa5f334-9188-35f6-a000-01080fa6037b",
                                        "entry_id": "3c8c461a-0c75-365f-861d-948870cc4769",
                                        "glosses": [
                                            "Disponible à travers Internet."
