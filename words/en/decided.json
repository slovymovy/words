        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f67a447f-1f2f-3f16-9d22-4fdfef7d3b06",
                    "sense_definition": "A person, especially a voter, who has already made a choice.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pollsters analyzed the opinions of the <w>decideds</w> separately from those who were still unsure.",
                            "target_lang_translations": {
                                "ru": "Социологи проанализировали мнения <w>определившихся</w> отдельно от тех, кто ещё сомневался.",
                                "zh": "民意调查人员将<w>已确定立场者</w>的意见与仍在犹豫的人区分开来进行分析。"
                            }
                        },
                        {
                            "text": "Political campaigns often ignore the <w>decideds</w> to focus their resources on swing voters.",
                            "target_lang_translations": {
                                "ru": "Политические кампании часто игнорируют <w>определившихся</w>, чтобы сосредоточить ресурсы на колеблющихся избирателях.",
                                "zh": "竞选活动通常会忽略<w>已做决定的选民</w>，而将资源集中在摇摆选民身上。"
                            }
                        }
                    ],
                    "antonyms": [
                        "undecided"
                    ],
                    "common_phrases": [
                        "decideds and undecideds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, особенно избиратель, который уже сделал выбор.",
                        "zh": "已做决定的人（尤指选民）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определившийся",
                                "target_lang_sense_clarification": "об избирателе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "已做决定的选民",
                                "target_lang_sense_clarification": "已确定投票意向的人"
                            },
                            {
                                "target_lang_word": "已确定立场者",
                                "target_lang_sense_clarification": "已有明确决定的人"
                            }
                        ]
                    }
                }
            ]
