                "senses": [
                    {
                        "sense_id": "e78e796e-1bc4-33b1-b212-8596f407f111",
                        "entry_id": "7858d4bb-b0af-3351-a0e9-7ed82fb39456",
                        "glosses": [
                            "Étoffe de laine lustrée d’un côté."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4937ca6a-19ea-406c-bf59-08d359bce613",
                                "sense_id": "e78e796e-1bc4-33b1-b212-8596f407f111",
                                "text": "La calmande est une étoffe connue & réglementée d’ancienne date ; elle s’est soutenue avec un accroissement continuel, parce qu’on la varie à volonté, qu’elle est applicable à une infinité d’usages, & d’un très-bon service."
                            },
                            {
                                "example_id": "015c2d30-21cc-449f-8d6c-0d2c399962f9",
                                "sense_id": "e78e796e-1bc4-33b1-b212-8596f407f111",
                                "text": "Les femmes (…) portent (…) des jupons courts de callemandre."
                            },
                            {
                                "example_id": "f1785e88-63d6-4258-b4fa-b3e8de40f840",
                                "sense_id": "e78e796e-1bc4-33b1-b212-8596f407f111",
                                "text": "Il glissa ses pieds dans des sandales de cuir de roussette et revêtit un élégant costume d'intérieur, pantalon de velours à côtes vert d'eau très profonde et veston de calmande noisette."
                            }
                        ]
                    }
