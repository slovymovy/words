                    },
                    {
                        "translation_id": "358e8b3f-0a95-4461-9a35-ad5101ca302f",
                        "source_entry_id": "467960ee-a63f-34bb-a200-67264c516ef3",
                        "source_sense_description": "garment",
                        "target_lang_word": "tuniek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuniek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "33e7671c-0b00-3ebf-87aa-2bcfaae99abf",
                                        "entry_id": "925e95cb-9b4c-32ca-b6c9-0843926c9a58",
                                        "glosses": [
                                            "een opperkleed gedragen door bisschoppen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce13574-2aa1-3eea-a861-63027ab04088",
                                        "entry_id": "925e95cb-9b4c-32ca-b6c9-0843926c9a58",
                                        "glosses": [
                                            "lange bloes, of korte jurk die vaak over een broek gedragen wordt door vrouwen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df73cf5-d4a8-40f4-b928-7cf65b3ed137",
                                                "sense_id": "9ce13574-2aa1-3eea-a861-63027ab04088",
                                                "text": "Het is anders nu, blijkt uit een snelle telling in mijn kleerkast. Ik kom makkelijk aan tien hippiestuks: 4 paar olifantenpijpen, 1 witte broek met uitzinnige borduursels, 2 tunieks met etnische trekjes, een enkellange rok met psychedelische motieven, een batiktruitje, iets tussen sjaal en stola in een korstig gordijnstofje met minstens tien centimeter lange rafels. En een bijna leeg flesje patchoeliparfum met designeretiket."
                                            },
                                            {
                                                "example_id": "bdfe457f-99bb-49f5-9ecd-df3a5091cf39",
                                                "sense_id": "9ce13574-2aa1-3eea-a861-63027ab04088",
                                                "text": "Het boerkiniverbod zorgde deze week opnieuw voor ophef nadat vier politieagenten een vrouw op het strand in Nice dwongen haar haar tuniek uit te trekken. Een foto van het incident leidde tot grote verontwaardiging."
                                            },
                                            {
                                                "example_id": "027d8750-c057-4911-a6f8-c5d1c849308c",
                                                "sense_id": "9ce13574-2aa1-3eea-a861-63027ab04088",
                                                "text": "Goed voorbeeld van zijn Hermèswerk is de vareuse: een kledingstuk met een smalle, diepe V-hals, dat als jasje, trui of tuniek terugkomt in bijna al zijn collecties. In Antwerpen zijn er zeven te zien. Bij zijn eigen merk presenteerde hij in de winter van 1992-1993 al een voorloper hiervan in de vorm van een motorjack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "682b3130-2471-3b67-9d14-fd52a9056206",
                                        "entry_id": "925e95cb-9b4c-32ca-b6c9-0843926c9a58",
                                        "glosses": [
                                            "korte uniformjas, mini-jurk voor mannen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84c181db-383b-457a-9983-cfd34cd96f5b",
                        "source_entry_id": "467960ee-a63f-34bb-a200-67264c516ef3",
                        "source_sense_description": "garment",
                        "target_lang_word": "tunique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tunique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d06a9f2-b4e5-3d2f-b60a-a2c381b36887",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Vêtement de dessous que portaient les Anciens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968fa334-3be0-488c-8d24-457192f7831e",
                                                "sense_id": "3d06a9f2-b4e5-3d2f-b60a-a2c381b36887",
                                                "text": "Le jeune homme regarda près de lui : les tuniques des joueuses de flûte avaient laissé deux empreintes dans la poussière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d660dd7-09e3-305f-b05d-45b1a9e4ce45",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Vêtement de femme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e83c5a8-07d9-499e-af59-7a9e90b96d20",
                                                "sense_id": "2d660dd7-09e3-305f-b05d-45b1a9e4ce45",
                                                "text": "Cependant, la Bédouine et la négresse portaient le costume saharien, une sorte d’ample voile bleu sombre, agrafé sur les épaules et formant tunique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "392c4e45-e223-3b05-bca8-9a9ea5d4c55e",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Vêtement que les évêques portent sous leur chasuble, quand ils officient pontificalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea33dbc-b9d4-47b0-9c1c-3a8a1985aa17",
                                                "sense_id": "392c4e45-e223-3b05-bca8-9a9ea5d4c55e",
                                                "text": "Son costume se compose d'une mitre précieuse, imitant un décor de broderies de perles, et d'une chape à bords orfrayés, recouvrant une tunique à larges manches, retenue au niveau de la poitrine par un gros fermail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4091161a-7883-33ed-8b14-b5f06683013b",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Vêtement des diacres et des sous-diacres, qu’on nomme aussi dalmatique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9431d7ab-03e4-3f10-bf6d-23fd4f223e20",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Sorte de veste dont les rois de France étaient revêtus, à leur sacre, sous le manteau royal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4021c630-682f-3c75-a8b1-77700a05d780",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Vêtement d’uniforme que portent les soldats, les collégiens, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a513a21-0855-40d3-aed5-9efae7eac10c",
                                                "sense_id": "4021c630-682f-3c75-a8b1-77700a05d780",
                                                "text": "Ils avaient retiré leur tunique, posé leur épée à terre, et ils s’acharnaient superbement à la besogne, […]."
                                            },
                                            {
                                                "example_id": "3e450b62-ac88-4030-8d0d-b1dd171b8167",
                                                "sense_id": "4021c630-682f-3c75-a8b1-77700a05d780",
                                                "text": "Puis un frémissement courut. L’ex-Roi des Rois, une cape noire sur sa tunique blanche, gagnait la tribune. À peine allait-il parler qu’une bordée de sifflets et de cris l’accueillit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80bd40ee-1a17-3c80-98a4-cbc918b0cabf",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Maillot sportif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d897f50-ac06-4650-a3b9-343673f1f12e",
                                                "sense_id": "80bd40ee-1a17-3c80-98a4-cbc918b0cabf",
                                                "text": "L’employé, un proche du vestiaire, selon l’entraîneur des Canaris, Antoine Kombouaré, est soupçonné d’avoir dérobé et revendu des tuniques officielles des joueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5fe689c-34a7-319a-aad1-50f234da06c4",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Membrane qui enveloppe certaines parties du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7583227c-b487-4e6c-87e6-f5b84537242d",
                                                "sense_id": "b5fe689c-34a7-319a-aad1-50f234da06c4",
                                                "text": "Les tuniques de l’œil. Tuniques vasculaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab5531f-7882-3322-adbd-f472b4e79b4e",
                                        "entry_id": "869537a3-9dc4-3f5a-9ee1-c313ec36e5ff",
                                        "glosses": [
                                            "Enveloppe d’un bulbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7c6fc8b-c807-457c-bd7c-4432efb5d0d2",
                                                "sense_id": "cab5531f-7882-3322-adbd-f472b4e79b4e",
                                                "text": "L’oignon est formé de plusieurs tuniques superposées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a965bdc-b101-42b7-a518-67afe8a6a33b",
