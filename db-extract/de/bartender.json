                                        "glosses": [
                                            "One who tends a bar or pub; a person preparing and serving drinks at a bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c483b9c0-63a4-4fad-ad35-2361cb4fad12",
                                                "sense_id": "f9ba9d89-17df-35e7-9dc9-e2a58527e42d",
                                                "text": "He observed as the sad bartender ritually played canasta with two bored and customerless dancers..."
                                            },
                                            {
                                                "example_id": "360b6a90-4746-43c5-bf43-c4cdcde13b49",
                                                "sense_id": "f9ba9d89-17df-35e7-9dc9-e2a58527e42d",
                                                "text": "They weren't all just sexpats and drifters and former disgraced officers or old bartenders, none of which he should have mentioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
