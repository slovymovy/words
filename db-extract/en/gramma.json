    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7a7b986d-2151-3b7a-a4c6-33f8ebc7ba89",
                "word": "Gramma",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c7684b0-01a5-359a-9f57-5b49ee03600b",
                        "entry_id": "7a7b986d-2151-3b7a-a4c6-33f8ebc7ba89",
                        "glosses": [
                            "A nickname for a grandmother."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ed30f2c-c8a3-421c-b724-7b568623d5b6",
                                "sense_id": "1c7684b0-01a5-359a-9f57-5b49ee03600b",
                                "text": "Thirza opened the kitchen door and glanced out at Gramma's favorite timekeeper."
                            },
                            {
                                "example_id": "bc74065f-69eb-423e-a044-1960b6e1c32b",
                                "sense_id": "1c7684b0-01a5-359a-9f57-5b49ee03600b",
                                "text": "Gramma should be in here by now."
                            },
                            {
                                "example_id": "2d8544c8-add6-49f0-9389-87dc1344e95d",
                                "sense_id": "1c7684b0-01a5-359a-9f57-5b49ee03600b",
                                "text": "I figured I should do something constructive, so I decided to call up Gramma and hope that she'd offer to send me some money."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cf8d1290-5e90-3a93-9b32-24f76cb91da4",
                "word": "gramma",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0df459b8-7cc9-45ba-a0d3-d8f0e80ad82a",
                        "entry_id": "cf8d1290-5e90-3a93-9b32-24f76cb91da4",
                        "tags": [
                            "plural"
                        ],
                        "form": "grammas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05b7d5d1-a40a-3871-86ec-b52eb2230d69",
                        "entry_id": "cf8d1290-5e90-3a93-9b32-24f76cb91da4",
                        "glosses": [
                            "A grandmother."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c1c9b3d3-6662-412e-8c54-f801fb9e4a6d",
                                "sense_id": "05b7d5d1-a40a-3871-86ec-b52eb2230d69",
                                "text": "Go on, there, driver, gramma is going."
                            },
                            {
                                "example_id": "ccc45c5c-6050-4c3e-b4e3-21da8702d029",
                                "sense_id": "05b7d5d1-a40a-3871-86ec-b52eb2230d69",
                                "text": "My gramma—all her hair is white Like snow is, but it isn't cold."
                            },
                            {
                                "example_id": "ef0a3535-c0ef-46a2-8fbc-af91dbf69ef2",
                                "sense_id": "05b7d5d1-a40a-3871-86ec-b52eb2230d69",
                                "text": "Polly trotted here and there with motions of taking gramma's hand, and so forth."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5118133f-cd67-3de7-8424-baf4e2bcab45",
                "word": "gramma",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "223c1b88-1a55-4cc7-bc2d-005114fcfac6",
                        "entry_id": "5118133f-cd67-3de7-8424-baf4e2bcab45",
                        "tags": [
                            "plural"
                        ],
                        "form": "grammas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bdc8823e-c1b4-345f-9c57-793cc0d60dde",
                        "entry_id": "5118133f-cd67-3de7-8424-baf4e2bcab45",
                        "glosses": [
                            "A variety of pumpkin, a cultivar of Cucurbita moschata."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "70630a1f-2c49-40bd-bce9-13630cad539a",
                                "sense_id": "bdc8823e-c1b4-345f-9c57-793cc0d60dde",
                                "text": "Traditionally Cucurbita maxima and Cucurbita moschata have been placed into two groups - pumpkins and grammas respectively."
                            },
                            {
                                "example_id": "7a0e60df-943c-42f9-8ca7-5224ec447f80",
                                "sense_id": "bdc8823e-c1b4-345f-9c57-793cc0d60dde",
                                "text": "1941, H. Barnes, Robert Veitch, Queensland Department of Agriculture and Stock, John Howard Simmonds, The Queensland Agricultural and Pastoral Handbook, Volume 1, page 238,\nPumpkins and grammas are harvested when mature, usually when the vines have died or been frosted."
                            },
                            {
                                "example_id": "95e94a0b-c447-4dd7-baa8-8d34ca43efee",
                                "sense_id": "bdc8823e-c1b4-345f-9c57-793cc0d60dde",
                                "text": "The papaw pumpkin belongs to a different species (C. moschata) and is classed as a gramma."
                            },
                            {
                                "example_id": "133a8ddc-3755-476b-9030-5bc22a919609",
                                "sense_id": "bdc8823e-c1b4-345f-9c57-793cc0d60dde",
                                "text": "1983, Margaret Fulton, Encyclopedia of Food and Cookery: The Complete Kitchen Companion from A to Z, Revised 2005, Republished 2009, page 493,\nGramma, or bugle, pumpkin is the variety traditionally used for pumpkin pie, but if it is not available, use butternut instead."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
