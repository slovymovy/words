    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c555ffd-289e-3bbb-bb88-1e5407a751e4",
                    "sense_definition": "Мост или эстакада, проложенные над другой дорогой для обеспечения движения транспорта.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новый <w>путепровод</w> значительно разгрузил движение в центре города.",
                            "target_lang_translations": {
                                "tr": "Yeni <w>üst geçit</w> şehir merkezindeki trafiği önemli ölçüde rahatlattı."
                            }
                        },
                        {
                            "text": "Машины медленно ехали по <w>путепровод</w>у, чтобы избежать пробок на перекрестке.",
                            "target_lang_translations": {
                                "tr": "Araçlar kavşaktaki trafikten kaçınmak için <w>üst geçit</w> üzerinde yavaşça ilerliyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "эстакада",
                        "виадук"
                    ],
                    "common_phrases": [
                        "автомобильный путепровод"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yolun başka bir yolun üzerinden geçmesini sağlayan köprü veya viyadük yapısı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "üst geçit",
                                "target_lang_sense_clarification": "Bir yolun diğerinin üzerinden geçtiği genel yapı."
                            },
                            {
                                "target_lang_word": "viyadük",
                                "target_lang_sense_clarification": "Vadi veya derin yataklar üzerine kurulan köprü tipi yapı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34eb3d59-a37a-39c6-abfc-ae2a886a41a6",
                    "sense_definition": "Мостовое сооружение, предназначенное для пропуска железной дороги над другой дорогой или препятствием.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport_infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезд проехал по старому <w>путепровод</w>у над шоссе.",
                            "target_lang_translations": {
                                "tr": "Tren, kara yolunun üzerindeki eski <w>üst geçit</w>ten geçti."
                            }
                        },
                        {
                            "text": "Строители начали ремонт железнодорожного <w>путепровод</w>а.",
                            "target_lang_translations": {
                                "tr": "İnşaat işçileri demir yolu <w>üst geçidi</w>nin onarımına başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "мост"
                    ],
                    "common_phrases": [
                        "железнодорожный путепровод"
                    ],
                    "target_lang_definitions": {
                        "tr": "Demir yolunun başka bir yolun veya engelin üzerinden geçmesini sağlayan köprü yapısı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "demiryolu köprüsü",
                                "target_lang_sense_clarification": "Demir yolu trafiği için özel olarak inşa edilmiş köprü."
                            },
                            {
                                "target_lang_word": "üst geçit",
                                "target_lang_sense_clarification": "Demir yolunun kara yolu üzerinden geçtiği durumlar için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}