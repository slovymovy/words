                "senses": [
                    {
                        "sense_id": "4a5e392c-329f-36a1-b017-146f23f8c760",
                        "entry_id": "41ee477c-7223-3c76-9ea6-3d1333d5dbb2",
                        "glosses": [
                            "Bestand an Kenntnissen im Bereich Verkehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "448c8e39-cf93-4480-a94c-0925e49f76c7",
                                "sense_id": "4a5e392c-329f-36a1-b017-146f23f8c760",
                                "text": "„Die Duette, Quartette, Puzzles, Legespiele, Quizkarten, Kartenspiele dienen der Aneignung und Festigung von Verkehrswissen.“"
                            },
                            {
                                "example_id": "4f5c3634-8853-49f2-ae81-0ecbe63dd1bd",
                                "sense_id": "4a5e392c-329f-36a1-b017-146f23f8c760",
                                "text": "„Das Verkehrswissen war bei Jungen höher als bei Mädchen, gleichzeitig wiesen die Jungen jedoch auch ein höheres Risikopotenzial in ihrem Verhalten auf.“"
                            },
                            {
                                "example_id": "467c004f-eac2-4e27-af21-65a29338a65d",
                                "sense_id": "4a5e392c-329f-36a1-b017-146f23f8c760",
                                "text": "„Untersuchungen zum Zusammenhang zwischen Verkehrswissen und Verkehrsverständnis und dem tatsächlichen Verhalten von Kindern im Straßenverkehr negieren ein Abhängigkeitsverhältnis.“"
                            },
                            {
                                "example_id": "e539a005-6bff-4b92-8e6c-436b62a1df09",
                                "sense_id": "4a5e392c-329f-36a1-b017-146f23f8c760",
                                "text": "„Das fordern die Verkehrspädagogen Bongard und Winterfeld von der Pädagogischen Hochschule Berlin, die jetzt im Auftrag des Bundesverkehrsministeriums das Verkehrswissen und das Verkehrsverständnis von fünf- und sechsjährigen Kindern vor deren Schuleintritt untersuchten.“"
                            },
                            {
                                "example_id": "1d656140-d5e8-41e5-be0c-34ab8c40e7d9",
                                "sense_id": "4a5e392c-329f-36a1-b017-146f23f8c760",
                                "text": "„Während Verkehrswissen das Reproduzieren von gelernten Begriffen, Regeln und Zeichen bezeichnet, schließt das Verkehrsverständnis zusätzlich die kognitiven Fähigkeiten ein, die erforderlich sind, um einzelne Verkehrssituationen differenziert analysieren, beurteilen und verarbeiten zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
