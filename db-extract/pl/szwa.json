                                "target_senses": [
                                    {
                                        "sense_id": "bf6e5640-8490-37ef-8dca-7932cd37ee10",
                                        "entry_id": "a2d8c8ad-a2c7-3149-98ff-da2849559aca",
                                        "glosses": [
                                            "An indeterminate central vowel sound as the \\\"a\\\" in \\\"about\\\", represented as /ə/ in IPA."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d85552-ee35-483b-9f4d-da93a481899f",
                                                "sense_id": "bf6e5640-8490-37ef-8dca-7932cd37ee10",
                                                "text": "The participle has also, owing to the accent, the lightest possible forms; but here there was no reduplication, and so in class I. the \"schwa\" took the form e before single mutes or fricatives, and elsewhere o."
                                            },
                                            {
                                                "example_id": "0e1ce801-4e82-42d0-b93d-050a3955ccb9",
                                                "sense_id": "bf6e5640-8490-37ef-8dca-7932cd37ee10",
                                                "text": "However, word-final unstressed schwa is deleted even by the speakers from South Albania, though to different degrees and dependant on the speech style[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bdbc0bb-8ff1-33bc-9882-fd94b74ceffd",
                                        "entry_id": "a2d8c8ad-a2c7-3149-98ff-da2849559aca",
                                        "glosses": [
                                            "The name of the Latin-script letter Ə/ə."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
