                                "target_senses": [
                                    {
                                        "sense_id": "953cca70-6bc2-3edb-ab45-96b46157f929",
                                        "entry_id": "e160484d-96a6-3f01-9053-6c63891edabe",
                                        "glosses": [
                                            "der einstimmige Gesang der kirchlichen Gemeinden, die sich in den ersten Jahrhunderten nach Christus bildeten. Dieser Gesang erhielt um 600 n. Chr. den Namen „Gregorianischer Choral“, da sich zu dieser Zeit Papst Gregor I. intensiv für eine Reform dieser Musik stark machte."
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ccd5e0cc-827d-3cc4-8068-2991ee7f4881",
                                        "entry_id": "e160484d-96a6-3f01-9053-6c63891edabe",
                                        "glosses": [
                                            "das von der Gemeinde gesungene Kirchenlied, das wie der alte Gregorianische Choral unbegleitet und im Rhythmus und Akzent des Verses gesungen wird"
                                        ],
                                        "tags": [
                                            "protestantische Kirche"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "938f2424-129b-483f-8107-07b9d52b0ebb",
                        "source_entry_id": "826da74c-cd94-309d-862b-738551b66a1e",
                        "source_sense_id": "c5be5437-bd3a-3acb-8748-fc16e6fb701a",
                        "target_lang_word": "Kirchenlied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchenlied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                        "entry_id": "e0697d38-2f11-3b52-91a4-ad67c0dee841",
                                        "glosses": [
                                            "Lied, das bei Gottesdiensten gesungen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8dedd92-e22d-4ae3-9537-239108b0c400",
                                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                                "text": "„In der vorreformatorischen Zeit begann man, volkssprachliche Kirchenlieder in Gesangbüchern zusammenzustellen.“"
                                            },
                                            {
                                                "example_id": "676d2297-dd17-4025-8fe4-e53db2ceee2e",
                                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                                "text": "„Die Besucher sangen die alten Kirchenlieder und der feine Weihrauchduft stieg in ihre Nasen.“"
                                            },
                                            {
                                                "example_id": "e174516e-cf1c-4fce-b6cb-5337cff0ec9e",
                                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                                "text": "„Er komponierte Kirchenlieder und verfasste Gedichte.\""
                                            },
                                            {
                                                "example_id": "4bf9e79c-88f1-4ac3-ba69-f478c0cf6eb3",
                                                "sense_id": "ee67c38f-6e2b-30e9-9975-436882ce8e12",
                                                "text": "„Da geschieht es unter dem Absingen des letzten Verses dieses Kirchenliedes, daß der Domkirchenpastor Sigurdur Sveinsson seinen Platz verläßt, in der Chortür Aufstellung nimmt und dorten regungslos und grabesernst abwartet, bis man zu Ende gesungen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5bf1036-de3d-401c-824c-be7f046a903a",
                        "source_entry_id": "826da74c-cd94-309d-862b-738551b66a1e",
