                                        "glosses": [
                                            "At the purchasing price; without any markup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce81c8ff-2539-4f3b-bc3d-67db41cee5f5",
                                                "sense_id": "270412c6-e7ee-32d2-8b5b-2b10cf9069ec",
                                                "text": "I will sell you the apples at cost."
                                            },
                                            {
                                                "example_id": "65b87e59-764a-4e2a-99fd-e5881ee5aae6",
                                                "sense_id": "270412c6-e7ee-32d2-8b5b-2b10cf9069ec",
                                                "text": "It is no part of my purpose to make gain from this work. I had hoped to publish it in permanent form and distribute it among my friends as a present but it has grown to such proportions that that will not be practicable and I do hope that I maye be able to sell enough copies at about cost to materially assist in the publication."
                                            }
