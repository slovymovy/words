                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4d196e-aeef-329f-a18d-5be9c17d5b7b",
                                        "entry_id": "b19b023c-89ba-3aac-acd0-cbb312c82bae",
                                        "glosses": [
                                            "Any of a group of olive green magnesium-iron silicate minerals that crystallize in the orthorhombic system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12aaff5e-20d6-4f84-b551-1d08a8e881c4",
                                                "sense_id": "0d4d196e-aeef-329f-a18d-5be9c17d5b7b",
                                                "text": "The olivine crystals in most basalts are imperfect, lacking clear crystal faces."
                                            },
                                            {
                                                "example_id": "a34b9822-5818-4474-be8c-f3baf415c2c1",
                                                "sense_id": "0d4d196e-aeef-329f-a18d-5be9c17d5b7b",
                                                "text": "To do so, his team mixed together limestone with a crushed silicate mineral that contains magnesium — such as olivine, an olive-tinted mineral that can be found around the world. When heated to furiously high temperatures in a kiln, calcium in the limestone and magnesium in the silicate jiggle and switch sides, like participants in a square dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
