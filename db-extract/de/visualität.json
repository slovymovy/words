                "senses": [
                    {
                        "sense_id": "a0c677df-cba0-3b9b-ac8f-6c54006fcb9e",
                        "entry_id": "cececd37-0e00-343a-b37c-33936f8bde3a",
                        "glosses": [
                            "Eigenschaft, über die Augen, optisch (visuell) wahrzunehmen (wahrgenommen werden zu können) sowie das Wahrgenommene mit einer Bedeutung versehen zu können"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1580a563-fd8b-44f6-baf6-b5583bbcf428",
                                "sense_id": "a0c677df-cba0-3b9b-ac8f-6c54006fcb9e",
                                "text": "„Auch Bourdieus Konzept des kulturellen Kapitals und der Distinktionsstrategien ist eng mit der Visualität sozialer Ordnungen verknüpft. Menschen zeigen sich gegenseitig ihre soziale Position, sie erkennen die entsprechenden Zeichen wie Kleidung, Wohnungseinrichtung, Gesten, Tischsitten usw.“"
                            },
                            {
                                "example_id": "59524043-25a7-409f-84dc-b1f2ffceb4e5",
                                "sense_id": "a0c677df-cba0-3b9b-ac8f-6c54006fcb9e",
                                "text": "„Die Frage nach der Visualität von Kommunikation – und der auch politischen Tragweite visueller Signale im Allgemeinen – stellt sich im Zeitalter des multimedialen Wahlkampfs dringender als je zuvor.“"
                            },
                            {
                                "example_id": "948adc71-42da-4078-ba11-c21c89c0bb64",
                                "sense_id": "a0c677df-cba0-3b9b-ac8f-6c54006fcb9e",
                                "text": "„Dieser Beitrag skizziert den für die Visual Culture grundlegenden Kernbegriff der ‚Visualität‘ in Abgrenzung zu verwandten Begriffen und beschreibt visuelle Medienrepräsentationen im für die Visual Studies charakteristischen Spannungsfeld von Sehen, Sichtbarkeit, Macht und Stereotypisierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
