                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2304b5c-13a4-309e-bfc9-c4b05b53a2ad",
                        "entry_id": "79c6d3f0-1b43-3bf3-8f53-4e42c0d5157b",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным бройлер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62bd8bc2-0d40-4dbf-92fb-e981b8cd6476",
                                "sense_id": "d2304b5c-13a4-309e-bfc9-c4b05b53a2ad",
                                "text": "Лучшим примером может служить выращивание гетерозисных цыплят, полученных от скрещивания яйценоских кур и скороспелых петухов. Этот метод, получивший название бройлерного производства, применяется в огромных масштабах во всем мире. За восемь недель цыплята достигают веса 1,4 кг."
                            },
                            {
                                "example_id": "0aff2aab-ec35-4482-9ed5-f929aeea62f4",
                                "sense_id": "d2304b5c-13a4-309e-bfc9-c4b05b53a2ad",
                                "text": "Бройлерное производство за рубежом начало развиваться в 20-х годах нашего столетия; как отрасль народного хозяйства оно окончательно сформировалось в 50—60-х годах."
                            },
                            {
                                "example_id": "f1d45884-5937-4a91-bfa3-e178f977a824",
                                "sense_id": "d2304b5c-13a4-309e-bfc9-c4b05b53a2ad",
                                "text": "Рядом с рабочим поселком Сылва развернулось строительство бройлерной птицефабрики мощностью три миллиона бройлеров в год, что было в те годы существенным добавлением к столу жителей Перми и Пермской области."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cee323e0-1b6f-446a-b617-3ad6d54c7c6b",
                        "source_entry_id": "79c6d3f0-1b43-3bf3-8f53-4e42c0d5157b",
                        "source_sense_id": "d2304b5c-13a4-309e-bfc9-c4b05b53a2ad",
                        "target_lang_word": "broiler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broiler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb77beb-10b0-37b6-b9e8-1bb45b52a298",
                                        "entry_id": "e5b99f5c-6a2f-3ce2-9b45-a26f1b2244d2",
                                        "glosses": [
                                            "A person who broils, someone who cooks by broiling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d38b12-b214-3248-ba70-9be9c7b7b5d0",
                                        "entry_id": "e5b99f5c-6a2f-3ce2-9b45-a26f1b2244d2",
                                        "glosses": [
                                            "A device used to broil food; part of an oven or a small stove; known as a grill in British English."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86088760-0d49-3774-850a-26836874a71f",
                                        "entry_id": "e5b99f5c-6a2f-3ce2-9b45-a26f1b2244d2",
                                        "glosses": [
                                            "A chicken raised for meat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d862f301-d594-4423-a601-50434b874e4d",
                                                "sense_id": "86088760-0d49-3774-850a-26836874a71f",
                                                "text": "In the 1960's culling hens and cockerels accounted for the main share of all live poultry exports. In more recent years, exports of live stewers, ducks, and geese have trended downward while foreign trade of live broilers and turkeys has greatly increased."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "216d2e3c-d7ec-3e92-af61-ba2f1dfc276e",
                                        "entry_id": "e5b99f5c-6a2f-3ce2-9b45-a26f1b2244d2",
                                        "glosses": [
                                            "A chicken raised for meat.",
                                            "Specifically, a young chicken 6 to 10 weeks old, as contrasted with a roaster."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b61d52b-f9c5-39a3-8afc-41cfc94ee70c",
                                        "entry_id": "e5b99f5c-6a2f-3ce2-9b45-a26f1b2244d2",
                                        "glosses": [
                                            "One who engages in or promotes noisy quarrels, or broils."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "345b8b6b-9ee2-4d73-a34d-b95f3a348f41",
                                                "sense_id": "1b61d52b-f9c5-39a3-8afc-41cfc94ee70c",
                                                "text": "What doth he but turn broiler, […] make new libels against the church?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
