                    {
                        "sense_id": "2e83ea45-641d-3415-ae7e-7820efb2eb19",
                        "entry_id": "79ab2656-7b26-343a-bc4d-95132b8787d3",
                        "glosses": [
                            "eigenlijk de bovenste helft van het lichaam (dus boven de navel) meestal het deel van het lichaam boven de heupen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ae7989-6d38-469b-b707-e38e91794434",
                                "sense_id": "2e83ea45-641d-3415-ae7e-7820efb2eb19",
                                "text": "Een trui en een bloes zijn kledingstukken voor het bovenlichaam"
                            },
                            {
                                "example_id": "38a6cbd1-2a7d-48b5-a59f-529006ef24bd",
                                "sense_id": "2e83ea45-641d-3415-ae7e-7820efb2eb19",
                                "text": "Hij boog zijn bovenlichaam naar rechts, zodat hij toch een glimp op kon vangen van hetgeen er zich vlak bij de rand afspeelde."
                            },
                            {
                                "example_id": "01e5280c-a7e1-4d3a-b97a-0dd5455265e9",
                                "sense_id": "2e83ea45-641d-3415-ae7e-7820efb2eb19",
                                "text": "Hij kroop snel in bed toen hij hoorde hoe het water werd uitgezet en legde de deken en het laken zo neer dat ze zijn bovenlichaam tot iets onder zijn navel ontblootten."
                            }
                        ]
                    }
