                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paleolitico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "69d451a0-83eb-30d9-8891-4577d728df06",
                                        "entry_id": "fc6cb2bd-f860-39fc-ab44-ac6cc6b26e07",
                                        "glosses": [
                                            "che riguarda il primo periodo della preistoria, compreso tra il pliocene e il mesolitico, nel quale, tra gli ominidi, iniziò a svilupparsi la tecnologia umana, con l'introduzione dei primi strumenti in pietra da parte di diverse specie di ominidi"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paleolitico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0d3f1f-e838-3a5d-93ec-d44b208048a1",
                                        "entry_id": "4dd02c78-9bf5-315b-9722-14997b36301c",
                                        "glosses": [
                                            "primo e più antico periodo della preistoria (da due milioni a 8.500 anni fa) che finisce con l'ultima glaziazione, nel quale si sviluppò la tecnologia umana, con la prima comparsa di armi ed utensili in pietra da parte di diverse specie di ominidi, compreso tra il pliocene e il mesolitico"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7118b1d3-b0aa-4055-b21c-ea17f82cc338",
                        "source_entry_id": "bf5dbfa2-8aeb-396c-9c4e-08f91020f9d7",
                        "target_lang_word": "Altsteinzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altsteinzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1375c7f-4f55-3d69-ade8-aac137513ba1",
                                        "entry_id": "1d63a1da-5e7f-3db3-b31b-0a2685f72bff",
                                        "glosses": [
                                            "früheste Epoche der Menschheitsgeschichte, die vor einigen Millionen Jahren beginnt und die etwa einige Tausend Jahre vor Christus in die Mittelsteinzeit übergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b2fe637-7e8f-49a8-bc54-5e0a507f9ed0",
                                                "sense_id": "d1375c7f-4f55-3d69-ade8-aac137513ba1",
                                                "text": "„In der jüngeren Phase der Altsteinzeit, der Acheuléen-Kultur, tauchen Faustkeile in verschiedenen Varianten auf, die für verschiedene Zwecke technisch unterschiedlich hergestellt wurden.“"
                                            },
                                            {
                                                "example_id": "bc625336-4766-486b-a6fd-613eb6ff0df9",
                                                "sense_id": "d1375c7f-4f55-3d69-ade8-aac137513ba1",
                                                "text": "„Die modernen Menschen entwickelten in der oberen Altsteinzeit mehrere aufeinanderfolgende Kulturen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
