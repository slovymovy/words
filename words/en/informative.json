    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b21fca92-c4f8-3ffc-9159-91448bc72596",
                    "sense_definition": "Providing useful or interesting information that helps someone learn about a subject.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "educational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary was very <w>informative</w> and taught us a lot about marine life.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм был очень <w>познавательным</w> и многому научил нас в отношении морской жизни."
                            }
                        },
                        {
                            "text": "I read a highly <w>informative</w> article regarding the new tax laws last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером я прочитал крайне <w>информативную</w> статью о новых налоговых законах."
                            }
                        }
                    ],
                    "synonyms": [
                        "informatory",
                        "instructive"
                    ],
                    "antonyms": [
                        "uninformative"
                    ],
                    "common_phrases": [
                        "highly informative",
                        "informative article",
                        "informative speech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставление полезной или интересной информации, которая помогает узнать что-то новое о предмете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "информативный",
                                "target_lang_sense_clarification": "содержащий много полезных сведений"
                            },
                            {
                                "target_lang_word": "познавательный",
                                "target_lang_sense_clarification": "расширяющий кругозор"
                            },
                            {
                                "target_lang_word": "содержательный",
                                "target_lang_sense_clarification": "богатый по содержанию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73e94700-0f1f-3e1e-ab7e-199b6a490b9a",
                    "sense_definition": "Providing information without specifying requirements or imposing rules.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The appendix is purely <w>informative</w> and does not contain any mandatory safety standards.",
                            "target_lang_translations": {
                                "ru": "Приложение носит чисто <w>информационный</w> характер и не содержит обязательных стандартов безопасности."
                            }
                        },
                        {
                            "text": "These <w>informative</w> guidelines are meant to assist users rather than dictate their actions.",
                            "target_lang_translations": {
                                "ru": "Эти <w>справочные</w> рекомендации предназначены для помощи пользователям, а не для диктовки их действий."
                            }
                        }
                    ],
                    "antonyms": [
                        "normative"
                    ],
                    "common_phrases": [
                        "informative annex",
                        "purely informative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставление информации без установления требований или навязывания правил."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "информационный",
                                "target_lang_sense_clarification": "носящий справочный характер"
                            },
                            {
                                "target_lang_word": "справочный",
                                "target_lang_sense_clarification": "предназначенный для справок, не обязательный"
                            },
                            {
                                "target_lang_word": "необязательный",
                                "target_lang_sense_clarification": "не имеющий нормативной силы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ec8fd19-ce16-3aaa-a31e-9a8ec6300a2b",
                    "sense_definition": "Having the power to form or give shape to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "formative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that early experiences have an <w>informative</w> power over a child's character.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что ранний опыт обладает <w>формирующей</w> силой над характером ребенка."
                            }
                        },
                        {
                            "text": "In this biological context, the protein acts as an <w>informative</w> agent for cell development.",
                            "target_lang_translations": {
                                "ru": "В данном биологическом контексте белок выступает как <w>формирующий</w> агент для развития клеток."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English and is often replaced by 'formative'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий силой формировать или придавать форму чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формирующий",
                                "target_lang_sense_clarification": "определяющий развитие или структуру"
                            },
                            {
                                "target_lang_word": "созидательный",
                                "target_lang_sense_clarification": "участвующий в создании формы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}