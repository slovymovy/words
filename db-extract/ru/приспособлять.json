                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba730f26-b039-360b-8eb1-5c165a55b6aa",
                                        "entry_id": "85ca1fe5-d459-3d23-a007-1e9d6cd0a753",
                                        "glosses": [
                                            "(Concret) Ajuster une chose à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66bf9d42-2465-47d2-b4aa-be4f264209a9",
                                                "sense_id": "ba730f26-b039-360b-8eb1-5c165a55b6aa",
                                                "text": "Il adapta ses ambitions à des considérations plus terre à terre comme trouver un petit boulot pour se nourrir."
                                            },
                                            {
                                                "example_id": "0dd2ab03-018e-4e97-9f02-aa80821e173a",
                                                "sense_id": "ba730f26-b039-360b-8eb1-5c165a55b6aa",
                                                "text": "Adapter un robinet à un tonneau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5be8cd2b-babb-3b39-954b-8740074a4e20",
                                        "entry_id": "85ca1fe5-d459-3d23-a007-1e9d6cd0a753",
                                        "glosses": [
                                            "Transposer d'un domaine à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1796fc7-23b8-41bc-a847-ea06972485fd",
                                                "sense_id": "5be8cd2b-babb-3b39-954b-8740074a4e20",
                                                "text": "Adapter un livre ou une bande dessinée en film, c’est avant tout réussir à leur donner vie selon la vision qu’en a le réalisateur ; ce qui implique d’apporter de nouveaux éléments et changer des éléments présents tout en restant fidèle à l’univers exploité."
                                            },
                                            {
                                                "example_id": "b725e7e2-fdcd-42d0-b2f3-736fa3d43ecb",
                                                "sense_id": "5be8cd2b-babb-3b39-954b-8740074a4e20",
                                                "text": "Des chercheurs ont adapté cette méthode à la sélection des candidats"
                                            }
                                        ]
                                    },
