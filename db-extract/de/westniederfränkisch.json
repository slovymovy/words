                        ],
                        "examples": [
                            {
                                "example_id": "d3adede0-3df6-404d-acfc-d6d4a9be2a07",
                                "sense_id": "0394ce34-05b0-38da-8276-15715d137dea",
                                "text": "Das sog. Ostniederfränkische in Deutschland und den südöstlichen Teilen der Niederlande ist Dialekt geblieben. Das Westniederfränkische jedoch hat sich im Lauf des Mittelalters unter dem Einfluß politischer und kultureller Faktoren zu einer selbständigen Kultursprache entwickelt, eben dem Niederländischen, [...]",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "db65355f-1d4d-440f-affe-9fed10abce2d",
                                "sense_id": "0394ce34-05b0-38da-8276-15715d137dea",
                                "text": "1993, Leo Camerlynck, Französisch-Flandern oder Flandern in Frankreich, in: Wim Waumans (ed.), Mit fremden Augen: Niederländisch, eine Sprache, verschiedene Kulturgemeinschaften (Duisburger Arbeiten zur Sprach- und Kulturwissenschaft, 15), page 287ff., here p. 288",
                                "translation": "The language which was spoken in most of this county of Flanders was West Low Franconian, as predecessor to Dutch.",
                                "english": "The language which was spoken in most of this county of Flanders was West Low Franconian, as predecessor to Dutch."
                            },
                            {
                                "example_id": "daae39ed-5716-4ccf-b967-ea5527a2b7cc",
                                "sense_id": "0394ce34-05b0-38da-8276-15715d137dea",
                                "text": "Erhaltene Länge bei langem oder tonlangem Vokal ist im Südwestfälischen und im Westniederfränkischen nicht überall in gleicher Weise vorzufinden."
                            },
                            {
                                "example_id": "d3b410c1-4a2f-42c2-a850-7a4cac1b2b36",
                                "sense_id": "0394ce34-05b0-38da-8276-15715d137dea",
                                "text": "Die niederländische Hochsprache begann sich spontan erst im 16. Jahrhundert auf der Grundlage des Westniederfränkischen zu entwickeln."
                            }
                        ]
                    }
