{
    "word_family": [
        "despicability",
        "despicableness",
        "despicably",
        "despise"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e516a09a-9134-3299-a0d2-04995f66ca80",
                    "sense_definition": "Deserving of hatred or intense dislike; extremely unpleasant or bad.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain committed a <w>despicable</w> crime that shocked the entire community.",
                            "target_lang_translations": {
                                "ru": "Злодей совершил <w>гнусное</w> преступление, которое потрясло всё сообщество.",
                                "it": "Il malvagio ha commesso un crimine <w>spregevole</w> che ha scioccato l'intera comunità.",
                                "zh": "那个恶棍犯下了一桩震惊整个社区的<w>卑鄙</w>罪行。"
                            }
                        },
                        {
                            "text": "It is <w>despicable</w> behavior to lie to your friends just to get what you want.",
                            "target_lang_translations": {
                                "ru": "Лгать друзьям только ради получения желаемого — это <w>подлое</w> поведение.",
                                "it": "Mentire agli amici solo per ottenere ciò che si vuole è un comportamento <w>abietto</w>.",
                                "zh": "为了达到目的而欺骗朋友是一种<w>可耻的</w>行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vile",
                        "contemptible",
                        "loathsome",
                        "shameful",
                        "ignoble",
                        "reprehensible"
                    ],
                    "antonyms": [
                        "honorable",
                        "noble",
                        "respectable",
                        "esteemed"
                    ],
                    "common_phrases": [
                        "despicable behavior",
                        "despicable crime",
                        "despicable act"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий ненависти или сильного отвращения; крайне неприятный или плохой.",
                        "it": "Che merita odio o profondo disprezzo; estremamente spiacevole o moralmente riprovevole.",
                        "zh": "指值得憎恨或强烈厌恶的；极其令人不快或道德败坏的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презренный",
                                "target_lang_sense_clarification": "вызывающий глубокое презрение"
                            },
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "низкий в моральном отношении"
                            },
                            {
                                "target_lang_word": "гнусный",
                                "target_lang_sense_clarification": "вызывающий отвращение своими качествами"
                            },
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "ничтожный и вызывающий презрение"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "spregevole",
                                "target_lang_sense_clarification": "che merita disprezzo per la sua bassezza morale"
                            },
                            {
                                "target_lang_word": "abietto",
                                "target_lang_sense_clarification": "estremamente vile e moralmente degradato"
                            },
                            {
                                "target_lang_word": "disprezzabile",
                                "target_lang_sense_clarification": "che suscita un sentimento di disprezzo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卑鄙的",
                                "target_lang_sense_clarification": "指行为下流、道德低下"
                            },
                            {
                                "target_lang_word": "可耻的",
                                "target_lang_sense_clarification": "指令人感到羞耻、不光彩"
                            },
                            {
                                "target_lang_word": "令人厌恶的",
                                "target_lang_sense_clarification": "指引起强烈反感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb3ff939-70e9-3107-a519-0d811ab857c7",
                    "sense_definition": "A person who is considered wicked, wretched, or unworthy of respect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prison was filled with thieves, bandits, and other <w>despicables</w> from across the country.",
                            "target_lang_translations": {
                                "ru": "Тюрьма была заполнена ворами, бандитами и прочими <w>негодяями</w> со всей страны.",
                                "it": "La prigione era piena di ladri, banditi e altri <w>individui spregevoli</w> provenienti da tutto il paese.",
                                "zh": "监狱里关满了来自全国各地的窃贼、强盗和其他<w>卑鄙小人</w>。"
                            }
                        },
                        {
                            "text": "He refused to associate with such <w>despicables</w> who had no sense of honor.",
                            "target_lang_translations": {
                                "ru": "Он отказался общаться с такими <w>подлецами</w>, у которых не было чувства чести.",
                                "it": "Si è rifiutato di frequentare tali <w>esseri abietti</w> che non avevano alcun senso dell'onore.",
                                "zh": "他拒绝与那些毫无荣誉感的<w>无赖</w>为伍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scoundrel",
                        "wretch",
                        "villain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, считающийся порочным, жалким или недостойным уважения.",
                        "it": "Persona considerata malvagia, meschina o indegna di rispetto.",
                        "zh": "指被认为邪恶、卑劣或不值得尊重的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлец",
                                "target_lang_sense_clarification": "человек, совершающий низкие поступки"
                            },
                            {
                                "target_lang_word": "негодяй",
                                "target_lang_sense_clarification": "человек, заслуживающий презрения"
                            },
                            {
                                "target_lang_word": "презренная личность",
                                "target_lang_sense_clarification": "человек, вызывающий отвращение"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "individuo spregevole",
                                "target_lang_sense_clarification": "persona che agisce in modo moralmente basso"
                            },
                            {
                                "target_lang_word": "essere abietto",
                                "target_lang_sense_clarification": "persona priva di dignità e onore"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卑鄙小人",
                                "target_lang_sense_clarification": "指道德品质低劣的人"
                            },
                            {
                                "target_lang_word": "无赖",
                                "target_lang_sense_clarification": "指行为恶劣、不讲道理的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
