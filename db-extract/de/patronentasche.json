                "translations": [
                    {
                        "translation_id": "21fa82bc-3043-462c-8f82-f0387a80d527",
                        "source_entry_id": "c03e7e28-693f-368b-b5a5-846b2feb02ac",
                        "source_sense_id": "e6a7df1a-777d-38f1-8adc-f0a7d9dcc468",
                        "source_sense_description": "Tasche zur Aufbewahrung/zum Transport von Patronen/Munition",
                        "target_lang_word": "giberne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "giberne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f98d4de-bbfc-31a3-9788-29c5b711cadd",
                                        "entry_id": "cbd1ed52-a808-31e8-8b25-f50a1af7594a",
                                        "glosses": [
                                            "Boîte recouverte de cuir dans laquelle les soldats mettaient les cartouches et quelques menus objets pour l’entretien des armes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3791bb41-71d9-4fa9-b98c-003969170127",
                                                "sense_id": "2f98d4de-bbfc-31a3-9788-29c5b711cadd",
                                                "text": "Avoir le bâton de maréchal dans sa giberne, De simple soldat pouvoir devenir maréchal."
                                            },
                                            {
                                                "example_id": "73c9510f-d959-4f86-9bcc-00438fce3608",
                                                "sense_id": "2f98d4de-bbfc-31a3-9788-29c5b711cadd",
                                                "text": "Enfant de giberne, Enfant de troupe."
                                            },
                                            {
                                                "example_id": "f34d541b-8e96-43d5-8f19-c087e7a11948",
                                                "sense_id": "2f98d4de-bbfc-31a3-9788-29c5b711cadd",
                                                "text": "Au cours du siège, Sans-Gêne est blessée ; heureusement la balle s'amortit contre la buffleterie de sa giberne et contre son manteau roulé en bandoulière qu'elle portait en fourrageur."
                                            },
                                            {
                                                "example_id": "2c76f45c-9328-42b5-b6bd-3218c773c0f8",
                                                "sense_id": "2f98d4de-bbfc-31a3-9788-29c5b711cadd",
                                                "text": "— Les hommes sans chaussures n’ont qu’à se présenter, pieds nus, à l’état-major, et le commandant les mènera lui-même à la mairie. Ils auront mis la baïonnette au canon et des cartouches dans la giberne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "260a97cf-3ab2-3b6e-82fb-c56a66a62834",
                                        "entry_id": "cbd1ed52-a808-31e8-8b25-f50a1af7594a",
                                        "glosses": [
                                            "Bavardage."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b8b23f9-9f66-4aa8-a6fb-dfcb41b83ace",
                                                "sense_id": "260a97cf-3ab2-3b6e-82fb-c56a66a62834",
                                                "text": "Tailler une giberne à quelqu'un, l'importuner par les discours oiseux."
                                            }
                                        ]
                                    }
                                ]
                            },
