                        "target_lang_word": "wohlerzogen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wohlerzogen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cad72be-2de9-319d-9fb3-328228190da2",
                                        "entry_id": "e7cc212e-e9ff-36b5-bad3-095cc33664d7",
                                        "glosses": [
                                            "solches Verhalten zeigend, das den Anforderungen und Erwartungen an eine gute (den jeweiligen Normen entsprechende) Erziehung entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc13cd28-9893-4086-acf7-2adb4aea3e55",
                                                "sense_id": "0cad72be-2de9-319d-9fb3-328228190da2",
                                                "text": "„Sie errötet bescheiden, stiehlt sich bei jedem anzüglichen Scherz unter Männern davon, lacht wie eine wohlerzogene junge Dame und geht zudem so, wie man es edlen jungen Damen beibringt.“"
                                            },
                                            {
                                                "example_id": "a8133486-9e7e-41d2-910e-932038179366",
                                                "sense_id": "0cad72be-2de9-319d-9fb3-328228190da2",
                                                "text": "Der wohlerzogene junge Mann schwieg höflich und lauschte den Worten des Gastgebers."
                                            },
                                            {
                                                "example_id": "d19ef115-9a8c-4e0c-b678-311f80d888cf",
                                                "sense_id": "0cad72be-2de9-319d-9fb3-328228190da2",
                                                "text": "Um darauf angemessen zu antworten, bin ich zu wohlerzogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
