                        "entry_id": "ae6a9297-e405-32fd-8157-8d53af73f2c3",
                        "glosses": [
                            "To carve again or into a new form."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1acfc036-205b-4577-9a8f-8a8d0501ee8e",
                                "sense_id": "7ae6ee25-4b4b-38c4-a58e-df0c61de429f",
                                "text": "The U.S., England and France redrew the map of Europe and recarved Germany in a way that was designed to arouse natural hatreds and pit peoples against each other in order to preclude internationalist working-class solidarity."
                            },
                            {
                                "example_id": "38836b95-33fa-4a4e-a7fa-0e2ca3ef72c3",
                                "sense_id": "7ae6ee25-4b4b-38c4-a58e-df0c61de429f",
                                "text": "He speaks about working with craftsmen to recarve both wood and plaster at the New Amsterdam Theater, and he is the project manager for the Theater for a New Audience, which is planned for a site near the Brooklyn Academy of Music."
                            }
                        ]
                    }
