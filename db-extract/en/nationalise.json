                "senses": [
                    {
                        "sense_id": "70ac0d74-7d1d-3bf8-af54-e71d08b5bee6",
                        "entry_id": "874d739d-e3d0-3b45-8a8c-8fd838b3e65e",
                        "glosses": [
                            "Non-Oxford British English standard spelling of nationalize."
                        ],
                        "tags": [
                            "UK",
                            "alt-of",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "86b94eaa-22f2-4fdb-b120-7831de30cad1",
                                "sense_id": "70ac0d74-7d1d-3bf8-af54-e71d08b5bee6",
                                "text": "It was done in order to nationalise — or rather to Babylonise — all the four throughout, by giving them Chaldean names, bearing the names of the gods Bel and Nego or Nebo."
                            },
                            {
                                "example_id": "cb0b5456-49e3-444a-be70-8d44f55ce124",
                                "sense_id": "70ac0d74-7d1d-3bf8-af54-e71d08b5bee6",
                                "text": "Although the B.L.S. group of railways remains under private ownership, the question of nationalising more Swiss lines has recently been considered by a Government Commission."
                            },
                            {
                                "example_id": "31f71130-0244-4e5b-972d-e6ee8751d623",
                                "sense_id": "70ac0d74-7d1d-3bf8-af54-e71d08b5bee6",
                                "text": "The US joins the first world war and supplies allied forces with oil. President Woodrow Wilson appoints multiple oil executives to war-effort committees and nationalises the railways."
                            },
                            {
                                "example_id": "f8e37c8e-7284-4fee-a2d2-7568bb663764",
                                "sense_id": "70ac0d74-7d1d-3bf8-af54-e71d08b5bee6",
                                "text": "It is a canard trotted out by lazy or tendentious journalists that nationalised British Railways lacked entrepreneurial flair."
                            }
                        ]
                    }
                ],
