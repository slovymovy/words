                                        "tags": [
                                            "gehoben, nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a777f65-7f42-4614-ac0b-a6d4664d70f2",
                                                "sense_id": "bababcb4-183c-38a5-9367-73ab4c126eb3",
                                                "text": "„türkisch“ bedeutet auch „zu den Turkvölkern gehörig“."
                                            },
                                            {
                                                "example_id": "270fd0d6-a57d-4eb4-acd1-6c8cf961626d",
                                                "sense_id": "bababcb4-183c-38a5-9367-73ab4c126eb3",
                                                "text": "Im Duden findet sich zu „hierher“ die Erläuterung: : die hierher (zu dieser Gruppe, Kategorie) gehörigen Tiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
