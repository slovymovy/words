                                        "sense_id": "0a0bc510-6210-3ab7-81d2-5dc4bad105b1",
                                        "entry_id": "3fce0229-abf3-300e-9ecb-7b8508821ab6",
                                        "glosses": [
                                            "(204) Callisto : Planète mineure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
