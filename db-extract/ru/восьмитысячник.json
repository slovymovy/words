                    },
                    {
                        "translation_id": "7e8abcc3-9230-43c8-b832-7d8c08dbd36f",
                        "source_entry_id": "adeb332d-20df-31a5-ad65-cde81e72c550",
                        "source_sense_id": "f0d5a4cf-4182-353b-bddc-05d2c3b75e57",
                        "target_lang_word": "Achttausender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achttausender",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb63b6fa-c0c5-3691-89e3-5570384effa3",
                                        "entry_id": "6bed8251-d9e9-3cf1-8d24-c2351d3cd292",
                                        "glosses": [
                                            "Berg oder Gipfel, der mindestens 8000 Meter hoch ist (auf der Erde gibt es 14 solcher Berge)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2daa67d0-f481-44ad-abc2-5fb0a380183f",
                                                "sense_id": "bb63b6fa-c0c5-3691-89e3-5570384effa3",
                                                "text": "Der Gasherbrum II ist der Zwerg unter den Achttausendern."
                                            },
                                            {
                                                "example_id": "8b0b514d-11fc-4e6c-ac9c-5ad7a81e98c3",
                                                "sense_id": "bb63b6fa-c0c5-3691-89e3-5570384effa3",
                                                "text": "Alle Achttausender liegen im Himalaya und im Karakorum, einem Nebengebirge des Himalaya."
                                            },
                                            {
                                                "example_id": "097f50b7-2ae8-4144-858e-8dcc52f5f082",
                                                "sense_id": "bb63b6fa-c0c5-3691-89e3-5570384effa3",
                                                "text": "„Die sogenannte Todeszone der Achttausender duldet kein längeres Verweilen. Die Funktionsfähigkeit der Organe reduziert sich.“"
                                            },
                                            {
                                                "example_id": "fee3516c-f4dc-45e8-876b-cff0a12d16ee",
                                                "sense_id": "bb63b6fa-c0c5-3691-89e3-5570384effa3",
                                                "text": "„Der Ahrntaler Extrembergsteiger Hans Kammerlander formulierte das spitzer: Auf einen Achttausender mit Hilfe von Sauerstoffflaschen zu steigen, ist in etwa so, wie den Giro d’Italia mit einem Moped statt einem Rennrad in Angriff zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "499ad74c-2652-41a3-8121-17d6920396e4",
                        "source_entry_id": "adeb332d-20df-31a5-ad65-cde81e72c550",
                        "source_sense_id": "f0d5a4cf-4182-353b-bddc-05d2c3b75e57",
                        "target_lang_word": "achtduizender",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achtduizender",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bbf8fda9-0d5d-3a57-95c3-878c5eeef68b",
                                        "entry_id": "7abfb7b6-c2e8-347b-8cef-7a9339b203a9",
                                        "glosses": [
                                            "een van de 14 bergen op aarde waarvan de top hoger ligt dan 8000 meter boven het zeeniveau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a44dbf0-526c-45c6-8c44-f0d251363c1d",
                                                "sense_id": "bbf8fda9-0d5d-3a57-95c3-878c5eeef68b",
                                                "text": "Wilco van Rooijen en voormalig expeditieleider Edmond Offner hebben beide eerder teamleden verloren. Van Rooijen zelf liep in 2008 zwaar bevriezingsletsel op. De Himalaya-expeditie uit de documentaire was na het drama zijn eerste 'achtduizender'."
                                            },
                                            {
                                                "example_id": "0f750b02-2b85-43c9-8087-1f45bcfcf24d",
                                                "sense_id": "bbf8fda9-0d5d-3a57-95c3-878c5eeef68b",
                                                "text": ",,We zijn ooit 30 meter onder de top van een achtduizender omgedraaid. Dan ben je er echt vlakbij. Aan de andere kant kan ik het wel nog steeds navertellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
