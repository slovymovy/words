                        "examples": [
                            {
                                "example_id": "91bcfb97-c73c-4b52-83a7-6fd9bbbc2b5d",
                                "sense_id": "34552b11-6765-32b6-a73d-dde103342d5b",
                                "text": "These senses are not restrictive in the languages which have both stems, and we are not warranted in suggesting more than that there may have been a distinctive value to each of the terminal consonant modulants, but that in the drift along the ages and across the seas the distinction has in some places become obscured."
                            },
                            {
                                "example_id": "6284aa05-7549-4e9b-b654-73662ef90adc",
                                "sense_id": "34552b11-6765-32b6-a73d-dde103342d5b",
                                "text": "Essential oils are known immune modulants, and because they are so concentrated, it is reasonable to assume that, in certain cases, some oils may be too strong for some systems."
                            }
                        ]
                    }
