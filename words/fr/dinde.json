                },
                {
                    "sense_id": "e345143d-8c90-3aea-8099-b56d447e0a59",
                    "sense_definition": "Femme ou jeune fille jugée niaise, sotte ou prétentieuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fille passe ses journées à ricaner bêtement comme une véritable <w>dinde</w>."
