{
    "word_family": [
        "flurried"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fcbb35b-a2c8-3861-8e4b-2d9296de4ceb",
                    "sense_definition": "A period of sudden, intense activity or excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The day before the wedding was a <w>flurry</w> of preparations.",
                            "target_lang_translations": {
                                "ru": "День перед свадьбой был настоящей <w>суетой</w> из приготовлений."
                            }
                        },
                        {
                            "text": "The news report caused a <w>flurry</w> of excitement among the local residents.",
                            "target_lang_translations": {
                                "ru": "Новостной репортаж вызвал <w>шквал</w> эмоций среди местных жителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "barrage"
                    ],
                    "common_phrases": [
                        "flurry of activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период внезапной, интенсивной деятельности или возбуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суета",
                                "target_lang_sense_clarification": "беспорядочная активность или спешка"
                            },
                            {
                                "target_lang_word": "суматоха",
                                "target_lang_sense_clarification": "состояние беспокойной беготни и суеты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa9c3be7-aff5-337e-9e0e-f86dd6b92128",
                    "sense_definition": "A large number of things happening or appearing suddenly in a short time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fencer landed a <w>flurry</w> of hits on her opponent.",
                            "target_lang_translations": {
                                "ru": "Фехтовальщица нанесла <w>шквал</w> ударов по своей сопернице."
                            }
                        },
                        {
                            "text": "The article provoked a <w>flurry</w> of media responses throughout the week.",
                            "target_lang_translations": {
                                "ru": "Статья вызвала <w>шквал</w> откликов в СМИ в течение недели."
                            }
                        }
                    ],
                    "synonyms": [
                        "volley",
                        "barrage"
                    ],
                    "common_phrases": [
                        "flurry of hits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество событий или предметов, внезапно появляющихся за короткое время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шквал",
                                "target_lang_sense_clarification": "переносное значение: резкий наплыв или обилие чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "865f3778-fc49-3008-9716-4140553efe7d",
                    "sense_definition": "A light, brief fall of snow.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a light <w>flurry</w> of snow this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром мы наблюдали легкий <w>снегопад</w>."
                            }
                        },
                        {
                            "text": "The weather forecast predicts a brief <w>flurry</w> later today.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды обещает кратковременный <w>снегопад</w> позднее сегодня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snow flurry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий, кратковременный снегопад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снегопад",
                                "target_lang_sense_clarification": "выпадение снега"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eef5f41c-f1f0-33fb-8bd2-941e6e112af3",
                    "sense_definition": "A sudden, short gust of wind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>flurry</w> of wind blew the papers off the desk.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>порыв</w> ветра сдул бумаги со стола."
                            }
                        },
                        {
                            "text": "The trees swayed during a <w>flurry</w> of wind.",
                            "target_lang_translations": {
                                "ru": "Деревья качались во время <w>порыва</w> ветра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flurry of wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, короткий порыв ветра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порыв ветра",
                                "target_lang_sense_clarification": "резкое усиление ветра"
                            },
                            {
                                "target_lang_word": "шквал",
                                "target_lang_sense_clarification": "сильный и резкий порыв ветра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38006741-79fe-3fbb-894d-49cef17ce7b9",
                    "sense_definition": "A dessert made of soft ice cream mixed with various toppings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They ordered a chocolate <w>flurry</w> for dessert.",
                            "target_lang_translations": {
                                "ru": "Они заказали шоколадный <w>флурри</w> на десерт."
                            }
                        },
                        {
                            "text": "The shop sells a delicious strawberry <w>flurry</w>.",
                            "target_lang_translations": {
                                "ru": "В этом магазине продают вкусный клубничный <w>флурри</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Десерт из мягкого мороженого с различными добавками."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "12a13bce-d39f-3d5a-8a91-0a5c30b174aa",
                    "sense_definition": "A swirling mass of dust or leaves caused by a gust of wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>flurry</w> of dust rose up as the car drove past.",
                            "target_lang_translations": {
                                "ru": "Когда машина проехала мимо, поднялся <w>вихрь</w> пыли."
                            }
                        },
                        {
                            "text": "The wind created a <w>flurry</w> of dry leaves in the garden.",
                            "target_lang_translations": {
                                "ru": "Ветер поднял <w>вихрь</w> сухих листьев в саду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flurry of dust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вихрь пыли или листьев, поднятый порывом ветра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вихрь",
                                "target_lang_sense_clarification": "вращающийся поток воздуха с пылью или листьями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3bcabba-f70c-3d62-a4b8-68cb8b552efb",
                    "sense_definition": "The violent movements of a whale as it dies.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whale went into its final <w>flurry</w>.",
                            "target_lang_translations": {
                                "ru": "Кит начал свою последнюю <w>агонию</w>."
                            }
                        },
                        {
                            "text": "The hunters watched the whale's <w>flurry</w> from the boat.",
                            "target_lang_translations": {
                                "ru": "Охотники наблюдали за <w>агонией</w> кита с лодки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the context of traditional whaling."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Агония кита, сопровождающаяся бурными движениями."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1ee5a6b-e585-3b2a-95df-814137c563d3",
                    "sense_definition": "To make someone feel nervous, confused, or flustered.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected questions <w>flurried</w> the witness.",
                            "target_lang_translations": {
                                "ru": "Неожиданные вопросы <w>взбудоражили</w> свидетеля."
                            }
                        },
                        {
                            "text": "She was <w>flurried</w> by the sudden change in plans.",
                            "target_lang_translations": {
                                "ru": "Она была <w>взбудоражена</w> внезапной переменой планов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то нервничать, смущаться или суетиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбудоражить",
                                "target_lang_sense_clarification": "вызвать тревогу или волнение"
                            },
                            {
                                "target_lang_word": "смутить",
                                "target_lang_sense_clarification": "привести в замешательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce6f64bf-cc83-3917-97da-114a38588b08",
                    "sense_definition": "To move or fall in a light, swirling manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Snow began to <w>flurry</w> in the cold air.",
                            "target_lang_translations": {
                                "ru": "В холодном воздухе начал <w>кружиться</w> снег."
                            }
                        },
                        {
                            "text": "The leaves <w>flurried</w> around the yard in the wind.",
                            "target_lang_translations": {
                                "ru": "Листья <w>кружились</w> по двору на ветру."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или падать легким, кружащимся образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружиться",
                                "target_lang_sense_clarification": "двигаться по кругу (о снеге или листьях)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1c1d304c-de81-317c-a5f8-e9f5ef564a9a",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Flurry</w> is our new neighbor.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Флурри</w> — наш новый сосед."
                            }
                        },
                        {
                            "text": "The <w>Flurrys</w> are coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Флурри</w> придет к нам на ужин сегодня вечером."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}