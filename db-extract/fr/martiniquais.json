                        "glosses": [
                            "Relatif à la Martinique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa1608f0-6146-4bf8-81fb-5c1b924ed4e6",
                                "sense_id": "95c78044-12aa-3873-8f6f-2ef4e5e09323",
                                "text": "Par ailleurs, l'une de ses arrière-arrière-grand-mères étant née à La Nouvelle-Orléans dans une famille d’origine martiniquaise. John Lewis a aussi un peu de sang français..."
                            },
                            {
                                "example_id": "43ad513b-7378-44b1-b6a9-69f98b599e58",
                                "sense_id": "95c78044-12aa-3873-8f6f-2ef4e5e09323",
                                "text": "De son père, professeur de mathématiques et leader indépendantiste martiniquais, qui lui a transmis « l’entêtement et l’exigence »."
                            }
                        ]
                    }
                ],
