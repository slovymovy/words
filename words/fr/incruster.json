                    "semantic_group_id": "fixation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'explosion a <w>incrusté</w> des éclats de verre dans le mur de la cuisine."
                        },
                        {
                            "text": "Cette douloureuse expérience a fini par s'<w>incruster</w> dans sa mémoire comme une cicatrice invisible."
                        }
