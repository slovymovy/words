                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3471820-fe57-4c44-99df-9e09e9c17fb9",
                        "source_entry_id": "698bb4c9-16e5-3512-a111-909c79c4ed27",
                        "source_sense_id": "19ca4ce7-e15e-34c7-bea2-01638e538afc",
                        "target_lang_word": "upgrade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upgrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed7939fb-5577-3790-aed0-bc8326f5dae8",
                                        "entry_id": "b80bd01d-d0b1-3db6-9186-a8246e35810c",
                                        "glosses": [
                                            "An upward grade or slope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771cddcb-5ff8-4516-8fdc-781d74f465e7",
                                                "sense_id": "ed7939fb-5577-3790-aed0-bc8326f5dae8",
                                                "text": "The Worthens sighed with relief as the engine began its night of upgrade chugging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e041da38-6b9b-3843-924c-e15623a05441",
                                        "entry_id": "b80bd01d-d0b1-3db6-9186-a8246e35810c",
                                        "glosses": [
                                            "An improved component or replacement item, usually applied to technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd548223-e361-42c0-9c46-fae015847413",
                                                "sense_id": "e041da38-6b9b-3843-924c-e15623a05441",
                                                "text": "Near-synonym: option"
                                            },
                                            {
                                                "example_id": "f9026254-4134-41eb-b3a9-9334f08974a9",
                                                "sense_id": "e041da38-6b9b-3843-924c-e15623a05441",
                                                "text": "With my phone company, I get a free upgrade every twelve months if I keep topping up 10 pounds a month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9613111b-e6b4-39f2-8744-a9df52f29e1d",
                                        "entry_id": "b80bd01d-d0b1-3db6-9186-a8246e35810c",
                                        "glosses": [
                                            "An improvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "719f77d9-17f1-4cd0-a505-d7a9b3a5933a",
                                                "sense_id": "9613111b-e6b4-39f2-8744-a9df52f29e1d",
                                                "text": "The remarried couples among my friends often joke that their divorce and remarriage amounted to an upgrade."
                                            },
                                            {
                                                "example_id": "feaaa631-bea7-47b2-92e1-4a3b55aa275e",
                                                "sense_id": "9613111b-e6b4-39f2-8744-a9df52f29e1d",
                                                "text": "\"When we're finished in 2024, this upgrade programme will provide a much-improved railway between London Waterloo and Portsmouth,\" said NR's Wessex Route Director Mark Killick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upgrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28faea60-33d0-36c5-803f-283bcd7865a7",
                                        "entry_id": "1eda260c-2aa6-3a2c-95a3-4aa2d3622413",
                                        "glosses": [
                                            "To improve, usually applied to technology, generally by complete replacement of one or more components."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4605ca5b-311c-4c07-bfaa-1f3d84c0a1cd",
                                                "sense_id": "28faea60-33d0-36c5-803f-283bcd7865a7",
                                                "text": "When you upgrade your standard of living, you become addicted to that standard of living."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b120c1a6-78de-34ec-a69f-d5fc6aef7507",
                                        "entry_id": "1eda260c-2aa6-3a2c-95a3-4aa2d3622413",
                                        "glosses": [
                                            "To replace with something better."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c7131b9-df02-48a8-b34b-1136e667002b",
                                                "sense_id": "b120c1a6-78de-34ec-a69f-d5fc6aef7507",
                                                "text": "I had to upgrade my anti-virus software to protect my computer from the newer threats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59a98f6-c559-3e67-b758-97c1e4657dca",
                                        "entry_id": "1eda260c-2aa6-3a2c-95a3-4aa2d3622413",
                                        "glosses": [
                                            "To improve the equipment or furnishings of or services rendered to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9154fd9-bb8e-4311-af99-1f23861d647a",
                                                "sense_id": "e59a98f6-c559-3e67-b758-97c1e4657dca",
                                                "text": "They upgraded him to the latest model."
                                            },
                                            {
                                                "example_id": "0535f53e-3987-49ea-9c31-a31ac25c5aa5",
                                                "sense_id": "e59a98f6-c559-3e67-b758-97c1e4657dca",
                                                "text": "They were upgraded to first class."
                                            },
                                            {
                                                "example_id": "7ff9fee8-4058-4ea1-8235-f0708cb09b80",
                                                "sense_id": "e59a98f6-c559-3e67-b758-97c1e4657dca",
                                                "text": "From the builder's standpoint, the name of the game is to upgrade you to the maximum you can qualify for."
                                            },
                                            {
                                                "example_id": "13082469-7f97-49a5-b460-1ab808d2b36d",
                                                "sense_id": "e59a98f6-c559-3e67-b758-97c1e4657dca",
                                                "text": "Calls at Cardiff Parkway are proposed once this station opens, with investment promised to upgrade station facilities at Severn Tunnel Junction."
                                            },
                                            {
                                                "example_id": "438796dd-34ec-45d1-8557-ffea94f36a15",
                                                "sense_id": "e59a98f6-c559-3e67-b758-97c1e4657dca",
                                                "text": "Several level crossings would have to be upgraded, with the existing track re-laid to allow a line speed of 60mph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57dce8ed-9bfa-30cf-a938-1d1f27cbd56d",
                                        "entry_id": "1eda260c-2aa6-3a2c-95a3-4aa2d3622413",
                                        "glosses": [
                                            "To improve in condition or status."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7cf252a-4557-4a6a-9cc2-4bdef7a229c9",
                                                "sense_id": "57dce8ed-9bfa-30cf-a938-1d1f27cbd56d",
                                                "text": "She upgraded to a more successful husband."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf89bd5-b848-3200-a644-09dff979b024",
                                        "entry_id": "1eda260c-2aa6-3a2c-95a3-4aa2d3622413",
                                        "glosses": [
                                            "To replace a program with a later version of itself, a version having a higher version number or marketed under a more recent product name."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6c1dd7b-a54a-4fa3-87c0-24dcc93ac323",
                                                "sense_id": "3cf89bd5-b848-3200-a644-09dff979b024",
                                                "text": "She waited a long time to upgrade from Windows 10 to Windows 11, hoping the worst bugs would be worked out before she took the plunge."
                                            },
                                            {
                                                "example_id": "4737be25-83d4-4fde-9b40-43854eb42547",
                                                "sense_id": "3cf89bd5-b848-3200-a644-09dff979b024",
                                                "text": "She waited a long time to upgrade Windows, hoping the worst bugs would be worked out before she took the plunge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upgrade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a73c86eb-1c39-321c-82dc-cad46d824fce",
                                        "entry_id": "162f368a-a600-3cc7-951d-e89688e0f536",
                                        "glosses": [
                                            "Up a slope or grade."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26903f8c-19c4-4c2c-9f3a-5ae8132704ed",
                                                "sense_id": "a73c86eb-1c39-321c-82dc-cad46d824fce",
                                                "text": "Men fell out, worn-out, and there were sunstroke cases. It was an eight-mile march upgrade."
                                            },
                                            {
                                                "example_id": "bfa9c1f0-f223-4425-aba4-b236720e2aa7",
                                                "sense_id": "a73c86eb-1c39-321c-82dc-cad46d824fce",
                                                "text": "Northbound trains originating near the Ohio River faced a 26-mile climb upgrade to Flushing."
                                            },
                                            {
                                                "example_id": "e9d8de16-d8d2-4c06-981d-0f9a1189a6d0",
                                                "sense_id": "a73c86eb-1c39-321c-82dc-cad46d824fce",
                                                "text": "From there it was an eight-mile pull upgrade to the mountain top."
                                            },
                                            {
                                                "example_id": "6dc0284b-c44c-4dc0-96a3-09278974bc3c",
                                                "sense_id": "a73c86eb-1c39-321c-82dc-cad46d824fce",
                                                "text": "I did that and saw we had to go upgrade a long ways."
                                            },
                                            {
                                                "example_id": "91ca4b55-2b28-49bb-b261-f5560957e28e",
                                                "sense_id": "a73c86eb-1c39-321c-82dc-cad46d824fce",
                                                "text": "[...] 37905 hauls the 1,400-tonne 0730 Mossend-Margam upgrade from Shrewsbury, mainly at 1-in-100, through Church Stretton at around 25mph on May 13 1989."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
