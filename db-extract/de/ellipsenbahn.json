                "senses": [
                    {
                        "sense_id": "87678113-1174-3e78-bee8-f6820defca77",
                        "entry_id": "9fd31bd8-8828-315b-bd3a-3db5304e2181",
                        "glosses": [
                            "ellipsenförmige Strecke, auf der sich ein Körper bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f884b911-5738-423d-9aca-ad444ec95e83",
                                "sense_id": "87678113-1174-3e78-bee8-f6820defca77",
                                "text": "„Zur gleichen Zeit formulierte Johannes Kepler, allein auf die beobachteten Positionen der Planeten gestützt, die keplerschen Gesetze, nach denen die Planeten sich mit variabler Geschwindigkeit auf Ellipsenbahnen um die Sonne bewegen.“"
                            },
                            {
                                "example_id": "361e25de-3802-41b0-a288-3a8effcb8e5a",
                                "sense_id": "87678113-1174-3e78-bee8-f6820defca77",
                                "text": "„Ein Meteoroid ist ein kleines, festes Teilchen, das sich auf einer Ellipsenbahn um die Sonne bewegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
