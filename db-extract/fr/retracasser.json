                ],
                "senses": [
                    {
                        "sense_id": "70b226e4-dcbb-3ab0-ac43-74ebe8fbbc00",
                        "entry_id": "2b2864a8-b5a7-3520-9db6-f4004ef2867d",
                        "glosses": [
                            "Tracasser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "246f0a4a-35c5-4b49-a906-ce0c173c6741",
                                "sense_id": "70b226e4-dcbb-3ab0-ac43-74ebe8fbbc00",
                                "text": "Je vais faire remonter ma garde robe et m'occupe de toute la partie matérielle qui bientôt va nous retracasser et rudement."
                            },
                            {
                                "example_id": "cb0a6b45-d457-47a4-9816-886867e2b0b1",
                                "sense_id": "70b226e4-dcbb-3ab0-ac43-74ebe8fbbc00",
                                "text": "Mais une pensée vint le retracasser."
                            },
                            {
                                "example_id": "3eb36ff7-7733-4422-b422-aaaab75dda65",
                                "sense_id": "70b226e4-dcbb-3ab0-ac43-74ebe8fbbc00",
                                "text": "À peine je l'ai rassurée, elle se retracasse d'un nouveau manque qu'elle se découvre, une vraie persévérance à se démolir et moi de ma nature déjà pas si certain, à m'escrimer de la rassurer."
                            }
                        ]
                    }
