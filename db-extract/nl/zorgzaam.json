                        "source_sense_id": "0a06984d-4ebb-3e7c-abf4-1e823b6aa5bd",
                        "source_sense_description": "met de nodige zorg",
                        "target_lang_word": "sorgsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorgsam",
