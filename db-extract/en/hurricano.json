                        "glosses": [
                            "A waterspout; a hurricane."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b9316524-40e9-4cbb-bbcb-582b533d3871",
                                "sense_id": "27fd393d-7f8e-38e7-9fec-29abdd269fe7",
                                "text": "You cataracts and hurricanoes, spout."
                            },
                            {
                                "example_id": "8a2d4975-7050-4557-ab7e-a744c4c94200",
                                "sense_id": "27fd393d-7f8e-38e7-9fec-29abdd269fe7",
                                "text": "And downe the shower impetuously doth fall,\nLike that which men the Hurricano call..."
                            },
                            {
                                "example_id": "5f19b6ef-195f-487f-bf61-190443d3f6a0",
                                "sense_id": "27fd393d-7f8e-38e7-9fec-29abdd269fe7",
                                "text": "...For I am possess'd\nWith whirle-winds, and each guilty thought to me is\nA dreadfull Hurricano..."
                            }
                        ]
                    }
                ],
