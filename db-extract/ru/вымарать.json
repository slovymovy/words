                        "examples": [
                            {
                                "example_id": "6b13f002-bb3f-42d4-bfb1-44aab84dcff7",
                                "sense_id": "4082b470-8f91-3bc2-93ac-6be65be01a1e",
                                "text": "Из послания к Чаадаеву вымарал я стихи, которые тебе не понравились .."
                            },
                            {
                                "example_id": "008acaa8-d680-413a-8ece-c0537f9988e9",
                                "sense_id": "4082b470-8f91-3bc2-93ac-6be65be01a1e",
                                "text": "Она перечеркнула карандашом четыре первых столбца и вымарала имена святых вплоть до второго мая, дня её выхода из монастыря."
                            }
                        ]
                    }
