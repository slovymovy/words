                "senses": [
                    {
                        "sense_id": "45654a44-0761-3e10-80ca-e0a452fb5ac6",
                        "entry_id": "c541f243-9493-39d4-bd28-cde9f2ee7fcc",
                        "glosses": [
                            "een boek dat gemaakt is als eerbetoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb96c5dd-99ea-4114-8335-969bea16c99d",
                                "sense_id": "45654a44-0761-3e10-80ca-e0a452fb5ac6",
                                "text": "Nu Tom Boonen met wielerpensioen is heeft hij eindelijk ruimschoots de tijd om te genieten van de dingen die hij zo graag doet. Vandaag ging hij knallen met zijn Donkervoort-sportwagen op het circuit van Zolder. In het boek “Tom Boonen, het officiële huldeboek” onthult hij dat hij vanaf deze zomer in de autosport verder wil."
                            },
                            {
                                "example_id": "913e17fb-2649-48ec-9b68-c89fdecb7142",
                                "sense_id": "45654a44-0761-3e10-80ca-e0a452fb5ac6",
                                "text": "Alles over Merckx in de Tour van 1969 staat in het onlangs voor de Belgische wielrenner verschenen huldeboek Merckxissimo."
                            },
                            {
                                "example_id": "98c79a5c-16ea-46c7-8d94-f437ab0f7511",
                                "sense_id": "45654a44-0761-3e10-80ca-e0a452fb5ac6",
                                "text": "Naast het organiseren van enkele manifestaties moest er ter ere van Boon een ‘groot huldeboek’ verschijnen. Daarvoor hebben auteurs als Kristien Hemmerechts en Geert van Istendael inmiddels al een verhaal geschreven."
                            }
                        ]
                    }
