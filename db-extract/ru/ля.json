                            },
                            {
                                "target_word": "la",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d828b013-8613-36b1-9db8-169faa9f82d8",
                                        "entry_id": "d8c99d62-239c-3e38-a905-d3d1d586a3c3",
                                        "glosses": [
                                            "Sixième note de la gamme. Le la de référence a une fréquence de 440 hertz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82291ce6-2f99-46a5-a11d-313d460bbf7b",
                                                "sense_id": "d828b013-8613-36b1-9db8-169faa9f82d8",
                                                "text": "Donner le la."
                                            },
                                            {
                                                "example_id": "a0adc39a-b70c-47d0-b52a-290800c03d91",
                                                "sense_id": "d828b013-8613-36b1-9db8-169faa9f82d8",
                                                "text": "Elles m'ont donné le la pour toute ma vie ; j'ai appris d’elles dès mes onze ans tous les charmes de l’austérité et de la fantaisie à la fois, grâce et grâce."
                                            },
                                            {
                                                "example_id": "9ff6840d-d880-4423-b4c8-cdeff764bde6",
                                                "sense_id": "d828b013-8613-36b1-9db8-169faa9f82d8",
                                                "text": "15 août 42 – Mais je me révulse à l’idée de l’amour virtuose, jouant d’un doigt négligent et agile sur mes cordes qui ne savent pas encore où est le la. Je veux faire mes gammes tranquillement, à l’abri d’un regard trop sagace."
                                            }
                                        ]
                                    }
                                ]
