                "senses": [
                    {
                        "sense_id": "c10cac63-0233-3be8-8b40-b9d48ab4da07",
                        "entry_id": "81320c4c-f283-3cd1-abfa-0544520b7dcf",
                        "glosses": [
                            "als Bauelement dienender, mit Steinen gefüllter Drahtkorb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a8cfbd-9df2-4c00-9257-3f0fa9f5a74d",
                                "sense_id": "c10cac63-0233-3be8-8b40-b9d48ab4da07",
                                "text": "„In den 1990er Jahren wurde entdeckt, dass der Fluss droht, die Fundamente des Minaretts zu unterspülen. Deshalb wurden Gabionen installiert, dennoch ergaben Messungen, dass der Turm sich zu neigen begonnen hat.“"
                            },
                            {
                                "example_id": "38d46e60-3493-42d8-8d51-c4fcad667adc",
                                "sense_id": "c10cac63-0233-3be8-8b40-b9d48ab4da07",
                                "text": "„Gerd Jung ist Architekt und Stadtplaner, seit mehr als 35 Jahren befasst er sich mit Gabionen, seit etwa zehn Jahren diagnostiziert er, dass sie verstärkt auch im privaten Bereich verbaut werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec608541-db61-4c79-bb59-9f6f47afe770",
                        "source_entry_id": "81320c4c-f283-3cd1-abfa-0544520b7dcf",
                        "source_sense_id": "c10cac63-0233-3be8-8b40-b9d48ab4da07",
                        "source_sense_description": "als Bauelement dienender, mit Steinen gefüllter Drahtkorb",
                        "target_lang_word": "gabion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gabion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c283c63-ce5a-333d-b418-f7ef4f9d1a35",
                                        "entry_id": "59e10d36-4f9c-37b4-9699-6a7fc4fa7371",
                                        "glosses": [
                                            "A cylindrical basket or cage of wicker which was filled with earth or stones and used in fortifications and other engineering work (a precursor to the sandbag)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af2f13e-45fb-4acc-a334-0a9a0b9eab40",
                                                "sense_id": "2c283c63-ce5a-333d-b418-f7ef4f9d1a35",
                                                "text": "When our artillery came before the walls of the town, the English within the walls killed some of our men, and several pioneers who were making gabions. And seeing they were so wounded that there was no hope of curing them, their comrades stripped them, and put them still living inside the gabions, which served to fill them up."
                                            },
                                            {
                                                "example_id": "df170abb-a1ae-4592-a21c-bfd92972c33f",
                                                "sense_id": "2c283c63-ce5a-333d-b418-f7ef4f9d1a35",
                                                "text": "Then ſe the bringing of our ordinance / Along the trench into the battery, / VVhere vve vvil haue gabions of ſix foot broad / To ſaue our Cannoniers from muſket ſhot, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be27ed21-51c9-3e33-818a-38b7731838f9",
                                        "entry_id": "59e10d36-4f9c-37b4-9699-6a7fc4fa7371",
                                        "glosses": [
                                            "A woven wire mesh unit, sometimes rectangular, made from a continuous mesh panel and filled with stones sometimes coated with polyvinyl chloride."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45d3e518-9a73-3e7e-87ae-a73d72373e11",
                                        "entry_id": "59e10d36-4f9c-37b4-9699-6a7fc4fa7371",
                                        "glosses": [
                                            "A porous metal cylinder filled with stones and used in a variety of civil engineering contexts, especially in the construction of retaining walls, the reinforcing of steep slopes, or in the prevention of erosion in river banks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbe99578-d5a5-3352-af9f-59d9099b48e5",
                                        "entry_id": "59e10d36-4f9c-37b4-9699-6a7fc4fa7371",
                                        "glosses": [
                                            "A knickknack, objet d'art, curiosity, collectable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa205039-899b-4276-a20e-0e2549a23a33",
                                                "sense_id": "cbe99578-d5a5-3352-af9f-59d9099b48e5",
                                                "text": "Reliquiae Trotcosienses: Or, the Gabions of the Late Jonathan Oldbuck Esq. of Monkbarns — title of unfinished novel by Walter Scott."
                                            },
                                            {
                                                "example_id": "d88884dc-4ae6-4481-bec3-e66b48b64aff",
                                                "sense_id": "cbe99578-d5a5-3352-af9f-59d9099b48e5",
                                                "text": "1774, James Cant, introduction, The Muses Threnodie p. vi, quoted in 2004, Walter Scott Reliquiae Trotcosiensis, Edinburgh University Press, p.6,\nThe meaning of the word Gabion, as it is used in the poem, is not to be sought for in any dictionary. It was of the venerable old gentleman Mr Ruthven′s own coining, and it was well enough understood among his select friends, to mean nothing else but the miscellaneous curiosities in his closet humorously described in the poem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7768cf6-dac7-458b-8688-cb2eb269d4d8",
                        "source_entry_id": "81320c4c-f283-3cd1-abfa-0544520b7dcf",
                        "source_sense_id": "c10cac63-0233-3be8-8b40-b9d48ab4da07",
                        "source_sense_description": "als Bauelement dienender, mit Steinen gefüllter Drahtkorb",
                        "target_lang_word": "gabion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gabion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71ae568b-6aa5-338c-8316-8bf7def5db8f",
                                        "entry_id": "bcb9a5c4-3f60-3525-ad56-bf5b40713ce6",
                                        "glosses": [
                                            "Sorte de panier sans fond de forme cubique, ou cylindrique, qu’on remplit de terre et dont on se sert dans les sièges pour mettre à couvert les travailleurs, les soldats, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a3e2ec-7439-4f18-9bae-646ede73abc7",
                                                "sense_id": "71ae568b-6aa5-338c-8316-8bf7def5db8f",
                                                "text": "Nous étions à peine installés dans notre trou, et je me rasais, mon miroir posé sur un gabion, quand le lieutenant J. me donna l’ordre de partir aussitôt avec l’équipe […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab8e153-f544-3969-9fc8-4145655fbcb7",
                                        "entry_id": "bcb9a5c4-3f60-3525-ad56-bf5b40713ce6",
                                        "glosses": [
                                            "Sorte de casier constitué de solides fils de fer tressés ou soudés et contenant des pierres. Nommé parfois aussi crib."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "000f8b23-c5d8-482d-8d86-b50986b68446",
                                                "sense_id": "4ab8e153-f544-3969-9fc8-4145655fbcb7",
                                                "text": "Habituellement utilisé dans le génie civil, le gabion arrive en force dans nos jardins et pour cause ! Pratique, facile à mettre en œuvre et esthétique, il constitue un aménagement de choix modulable à souhait !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f489f9c9-dc58-3cf1-8c44-1e0d84f6d33a",
                                        "entry_id": "bcb9a5c4-3f60-3525-ad56-bf5b40713ce6",
                                        "glosses": [
                                            "Grosse personne mal habillée."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b26544-5201-4354-88b0-698506a65e5a",
                                                "sense_id": "f489f9c9-dc58-3cf1-8c44-1e0d84f6d33a",
                                                "text": "C’était Madame Voblat, un gabion de suif, une bombance de chairs mal retenue par les douves d’un corset."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6670eaa5-873f-3474-8ca8-0185d7249d79",
                                        "entry_id": "bcb9a5c4-3f60-3525-ad56-bf5b40713ce6",
                                        "glosses": [
                                            "Mode de bobinage utilisé en radioélectricité et rappelant la forme du panier."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0848a514-8988-3b4e-b14f-f7de0cbc35da",
                                        "entry_id": "bcb9a5c4-3f60-3525-ad56-bf5b40713ce6",
                                        "glosses": [
                                            "Petite hutte destinée à se cacher pour chasser le gibier d'eau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62de0fc0-d023-3629-a339-d7eb2265a0bc",
                                        "entry_id": "bcb9a5c4-3f60-3525-ad56-bf5b40713ce6",
                                        "glosses": [
                                            "Panier rustique qui était utilisé pour le transport de la terre ou du fumier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e88a1aed-e6db-3d83-828b-2014996e32e6",
                                        "entry_id": "bcb9a5c4-3f60-3525-ad56-bf5b40713ce6",
                                        "glosses": [
                                            "Dispositif analogue entourant le pied d’un arbre, destiné à le protéger des chocs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08734505-805d-4f32-b212-3dacb1cf478d",
                                                "sense_id": "e88a1aed-e6db-3d83-828b-2014996e32e6",
                                                "text": "Aux tilleuls succédèrent des peupliers protégés dans le bas de leurs fûts par des gabions d’osier tressé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
