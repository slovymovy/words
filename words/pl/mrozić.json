    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aad1db9c-cc5e-3c65-8e68-6fb56021a2c3",
                    "sense_definition": "poddawać działaniu bardzo niskiej temperatury w celu zamrożenia lub konserwacji",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Latem często <w>mrozimy</w> świeże truskawki na zimowe desery.",
                            "target_lang_translations": {
                                "ru": "Летом мы часто <w>морозим</w> свежую клубнику для зимних десертов."
                            }
                        },
                        {
                            "text": "Czy można powtórnie <w>mrozić</w> rozmrożone wcześniej mięso?",
                            "target_lang_translations": {
                                "ru": "Можно ли повторно <w>замораживать</w> ранее размороженное мясо?"
                            }
                        }
                    ],
                    "synonyms": [
                        "zamrażać"
                    ],
                    "antonyms": [
                        "rozmrażać"
                    ],
                    "common_phrases": [
                        "mrozić owoce",
                        "mrozić warzywa",
                        "mrozić na zimę"
                    ],
                    "target_lang_definitions": {
                        "ru": "подвергать воздействию низкой температуры для замерзания или длительного хранения продуктов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морозить",
                                "target_lang_sense_clarification": "продукты, ягоды и т. п."
                            },
                            {
                                "target_lang_word": "замораживать",
                                "target_lang_sense_clarification": "для консервации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dee3fb1-980b-3540-8c36-8ae03cab2d75",
                    "sense_definition": "silnie ochładzać coś lub obniżać temperaturę napoju bądź potrawy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed podaniem na stół kelner mocno <w>mrozi</w> białe wino.",
                            "target_lang_translations": {
                                "ru": "Перед подачей на стол официант сильно <w>охлаждает</w> белое вино."
                            }
                        },
                        {
                            "text": "W upalne popołudnie chętnie <w>mrozili</w> lemoniadę kostkami lodu.",
                            "target_lang_translations": {
                                "ru": "В жаркий полдень они с удовольствием <w>охлаждали</w> лимонад кубиками льда."
                            }
                        }
                    ],
                    "synonyms": [
                        "chłodzić",
                        "oziębiać"
                    ],
                    "antonyms": [
                        "podgrzewać"
                    ],
                    "common_phrases": [
                        "mrozić napoje",
                        "mrozić szampana"
                    ],
                    "target_lang_definitions": {
                        "ru": "сильно охлаждать напиток или блюдо перед употреблением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охлаждать",
                                "target_lang_sense_clarification": "сильно остужать напитки или блюда"
                            },
                            {
                                "target_lang_word": "леденить",
                                "target_lang_sense_clarification": "делать очень холодным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28f71178-21d7-31e0-9d32-8ab5c4aea4a4",
                    "sense_definition": "o pogodzie lub powietrzu: wywoływać dotkliwe uczucie chłodu; panować jako silny mróz",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pogoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zimą na zewnątrz strasznie <w>mrozi</w>, więc trzeba nosić ciepłą czapkę.",
                            "target_lang_translations": {
                                "ru": "Зимой на улице страшно <w>морозит</w>, поэтому нужно носить теплую шапку."
                            }
                        },
                        {
                            "text": "Lodowaty wiatr znad rzeki mocno <w>mroził</w> twarze przechodniów.",
                            "target_lang_translations": {
                                "ru": "Ледяной ветер с реки сильно <w>обжигал холодом</w> лица прохожих."
                            }
                        }
                    ],
                    "synonyms": [
                        "ziębić"
                    ],
                    "antonyms": [
                        "grzać"
                    ],
                    "common_phrases": [
                        "strasznie mrozi",
                        "mrozi krew w żyłach"
                    ],
                    "target_lang_definitions": {
                        "ru": "о погоде: стоять сильному морозу; вызывать ощущение сильного холода"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морозить",
                                "target_lang_sense_clarification": "безлично о погоде: на дворе мороз"
                            },
                            {
                                "target_lang_word": "подмораживать",
                                "target_lang_sense_clarification": "о легком или начинающемся морозе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28c28aee-063c-34aa-a322-e3c7acf0f044",
                    "sense_definition": "przenośnie: paraliżować ze strachu, onieśmielać lub pozbawiać kogoś pewności siebie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego surowe spojrzenie natychmiast <w>mroziło</w> każdego nowego pracownika.",
                            "target_lang_translations": {
                                "ru": "Его суровый взгляд мгновенно <w>леденил</w> каждого нового сотрудника."
                            }
                        },
                        {
                            "text": "Ta przerażająca opowieść o duchach naprawdę <w>mrozi</w> słuchaczy.",
                            "target_lang_translations": {
                                "ru": "Эта пугающая история о призраках по-настоящему <w>леденит кровь</w> слушателям."
                            }
                        }
                    ],
                    "synonyms": [
                        "blokować",
                        "straszyć"
                    ],
                    "antonyms": [
                        "ożywiać",
                        "dodawać otuchy"
                    ],
                    "common_phrases": [
                        "mrozić wzrokiem",
                        "mrozić spojrzeniem"
                    ],
                    "target_lang_definitions": {
                        "ru": "переносно: парализовать от страха, смущать или приводить в оцепенение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "леденить",
                                "target_lang_sense_clarification": "о взгляде или ужасе"
                            },
                            {
                                "target_lang_word": "сковывать",
                                "target_lang_sense_clarification": "парализовать страхом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}