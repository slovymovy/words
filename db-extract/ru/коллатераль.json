                "senses": [
                    {
                        "sense_id": "944ebec8-1643-3cb3-9edc-6f3e7484155b",
                        "entry_id": "a182e4f8-8a0a-3dec-bd27-1cdd684f8924",
                        "glosses": [
                            "анат. обходная ветвь кровеносного сосуда"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae0da9c-24a6-489b-a6c7-2a86f8346007",
                                "sense_id": "944ebec8-1643-3cb3-9edc-6f3e7484155b",
                                "text": "Фистулограмма: окклюзия подключичной вены (отсутствие контрастирования ствола подключичной вены с развитием выраженных венозных коллатералей)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eef9811a-3521-4b52-8ba4-53bdad0f98ec",
                        "source_entry_id": "a182e4f8-8a0a-3dec-bd27-1cdd684f8924",
                        "source_sense_id": "944ebec8-1643-3cb3-9edc-6f3e7484155b",
                        "target_lang_word": "collateral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collateral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bae5c9f8-1ceb-304f-8b46-faf904f2c040",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Parallel, in the same vein, side by side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6411f8b-6574-459e-8175-bfdd3d42bcfc",
                                                "sense_id": "bae5c9f8-1ceb-304f-8b46-faf904f2c040",
                                                "text": "Her anterior cruciate ligament (ACL) and medial collateral ligament (MCL) are torn and Vonn has a lateral fracture of the tibial plateau, the upper end of the tibia or shin bone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faf76d57-1048-3616-b312-a5d5703f2a6b",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Corresponding; accompanying, concomitant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5abd67ad-3fdf-4b01-8b58-37fc9408feff",
                                                "sense_id": "faf76d57-1048-3616-b312-a5d5703f2a6b",
                                                "text": "Yet the attempt may give / Collateral interest to this homely tale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efae36b6-6b34-3df2-8b38-648f8c6ed748",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Being aside from the main subject, target, or goal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f805a927-fa5e-4fd9-8f68-d8cfb6b6bff8",
                                                "sense_id": "efae36b6-6b34-3df2-8b38-648f8c6ed748",
                                                "text": "collateral damage"
                                            },
                                            {
                                                "example_id": "6aca19b2-f150-4f75-839e-42a91a8530d5",
                                                "sense_id": "efae36b6-6b34-3df2-8b38-648f8c6ed748",
                                                "text": "Although not a direct cause, the border skirmish was certainly a collateral incitement for the war."
                                            },
                                            {
                                                "example_id": "54c1b4c2-0039-4427-9116-80c026dced0f",
                                                "sense_id": "efae36b6-6b34-3df2-8b38-648f8c6ed748",
                                                "text": "That he [Atterbury] was altogether in the wrong on the main question, and on all the collateral questions springing out of it, […] is true."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89037a80-677d-323f-8a4f-2600a51b4ae4",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Of an indirect ancestral relationship, as opposed to lineal descendency."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa679fcd-923c-4974-bc82-421b32fbadca",
                                                "sense_id": "89037a80-677d-323f-8a4f-2600a51b4ae4",
                                                "text": "a collateral descendant"
                                            },
                                            {
                                                "example_id": "012f4a72-5b18-47a5-aacd-e3325309f2b4",
                                                "sense_id": "89037a80-677d-323f-8a4f-2600a51b4ae4",
                                                "text": "Uncles, aunts, cousins, nephews and nieces are collateral relatives."
                                            },
                                            {
                                                "example_id": "e185d7c4-bc58-47c7-a8bc-ea439c6d9907",
                                                "sense_id": "89037a80-677d-323f-8a4f-2600a51b4ae4",
                                                "text": "The pure blood all descends from five collateral lines called Al-Khamsah (the Cinque)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653d90b5-7fbb-3a40-9d18-14a7aa4853ed",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Relating to a collateral in the sense of an obligation or security."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee19899f-c74f-304c-a6bb-4b021b7378c1",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Expensive to the extent of being paid through a loan."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "238ce479-2910-3725-8920-b810fc48bdcc",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Coming or directed along the side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d4b8d3-1bb7-4c36-899e-fb716266381c",
                                                "sense_id": "238ce479-2910-3725-8920-b810fc48bdcc",
                                                "text": "collateral pressure"
                                            },
                                            {
                                                "example_id": "d104b49c-fca2-4dfb-8895-82534f7d1a66",
                                                "sense_id": "238ce479-2910-3725-8920-b810fc48bdcc",
                                                "text": "collateral light"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d421fcea-0a73-34b2-9283-56700f7a228c",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Acting in an indirect way."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c402c3-86c9-4830-a59b-d6a69138b18c",
                                                "sense_id": "d421fcea-0a73-34b2-9283-56700f7a228c",
                                                "text": "If by direct or by collateral hand\n They find us touched, we will our kingdom give […]\n To you in satisfaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf267bac-8ea5-3de4-98ab-f9f2b1dc782b",
                                        "entry_id": "f2bb947b-6b27-34e0-8459-c06d1d0817cc",
                                        "glosses": [
                                            "Having the phloem and xylem adjacent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "collateral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "849118d4-7724-3c3c-a7ed-57feff1a3044",
                                        "entry_id": "c7d910c4-539a-37de-a5cc-2044e3cb210f",
                                        "glosses": [
                                            "A security or guarantee (usually an asset) pledged for the repayment of a loan if one cannot procure enough funds to repay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af66454e-acd3-4cfc-820c-965cec754101",
                                                "sense_id": "849118d4-7724-3c3c-a7ed-57feff1a3044",
                                                "text": "\"The decline in the quality of eligible collateral is a grave problem. The ECB is now buying corporate bonds that are close to junk, and the haircuts can barely deal with a one-notch credit downgrade. The reputational risk of such actions by a central bank would have been unthinkable in the past.\""
                                            },
                                            {
                                                "example_id": "dac14ed5-36ed-4570-a6b5-b8ce933fe541",
                                                "sense_id": "849118d4-7724-3c3c-a7ed-57feff1a3044",
                                                "text": "In colonial times, when land was not worth much and banks didn’t exist, most lending was based on human property. In the early 1700s, slaves were the dominant collateral in South Carolina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f255574f-e468-32a2-9c8a-64f9e89b088f",
                                        "entry_id": "c7d910c4-539a-37de-a5cc-2044e3cb210f",
                                        "glosses": [
                                            "A collateral (not linear) family member."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8d3e28d-475e-399e-bb85-69728aafa22a",
                                        "entry_id": "c7d910c4-539a-37de-a5cc-2044e3cb210f",
                                        "glosses": [
                                            "A branch of a bodily part or system of organs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e6c5f12-d4d4-4b69-8309-9881c5e07a94",
                                                "sense_id": "e8d3e28d-475e-399e-bb85-69728aafa22a",
                                                "text": "Besides the arteries blood streams through numerous veins we call collaterals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "802f2b00-1a18-3f34-bd75-358bd2c00d5a",
                                        "entry_id": "c7d910c4-539a-37de-a5cc-2044e3cb210f",
                                        "glosses": [
                                            "Printed materials or content of electronic media used to enhance sales of products (short form of collateral material)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77da505e-cc34-3363-80b5-7dd25a7160a4",
                                        "entry_id": "c7d910c4-539a-37de-a5cc-2044e3cb210f",
                                        "glosses": [
                                            "A thinner blood vessel providing an alternate route to blood flow in case the main vessel becomes occluded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "381bf948-a13a-3382-abdf-bce02b8b0e54",
                                        "entry_id": "c7d910c4-539a-37de-a5cc-2044e3cb210f",
                                        "glosses": [
                                            "A contemporary or rival."
                                        ],
                                        "tags": [
                                            "archaic",
