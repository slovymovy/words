        "fr-extract.jsonl": [
            {
                "entry_id": "b52dc5ba-59af-3acc-a6aa-54ae18767e18",
                "word": "réciproquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                        "entry_id": "b52dc5ba-59af-3acc-a6aa-54ae18767e18",
                        "glosses": [
                            "D’une manière inverse, en retour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e727bd1c-31d5-40f5-9301-74f740075f89",
                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                "text": "Comme les actions héroïques animent ceux qui écrivent, ceux-ci réciproquement vont remuer, par le désir de la gloire, ce qu’il y a de plus vif dans les grands courages,"
                            },
                            {
                                "example_id": "702fe870-5dc8-46d7-92cd-54d0d4c5e157",
                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                "text": "La convoitise l’empêche [le chrétien] de faire tout le bien qu’il voudrait ; réciproquement, il empêche la convoitise de faire tout le mal qu’elle désire,"
                            },
                            {
                                "example_id": "af165713-31b5-4918-bad2-b722a53d0933",
                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                "text": "Les enfants peut-être seraient plus chers à leurs pères, et réciproquement les pères à leurs enfants, sans le titre d’héritiers,"
                            },
                            {
                                "example_id": "4e94f7a9-44dd-478e-92dd-e91f6acbe861",
                                "sense_id": "944acad0-2022-3687-970a-96beb6e161b6",
                                "text": "Les animaux des parties méridionales de l’ancien continent ne se trouvent pas dans le nouveau ; et, réciproquement, ceux de l’Amérique méridionale ne se trouvent point dans l’ancien continent,"
                            }
                        ]
                    },
                    {
                        "sense_id": "00532b62-8ab3-3591-bd93-10d38dd65b8d",
                        "entry_id": "b52dc5ba-59af-3acc-a6aa-54ae18767e18",
                        "glosses": [
                            "D’une manière réciproque, mutuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dec08e5-545e-46b5-a271-9f9109de1354",
                                "sense_id": "00532b62-8ab3-3591-bd93-10d38dd65b8d",
                                "text": "Les petits se haïssent les uns les autres, lorsqu'ils se nuisent réciproquement,"
                            },
                            {
                                "example_id": "3e3a7f8b-65dc-4d3b-a0b7-d5395b8a029f",
                                "sense_id": "00532b62-8ab3-3591-bd93-10d38dd65b8d",
                                "text": "Il arrivait que les moines et la cour se corrompaient réciproquement,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a2b4cce-014c-4478-8a4c-dc137d5e2a93",
                        "source_entry_id": "b52dc5ba-59af-3acc-a6aa-54ae18767e18",
                        "target_lang_word": "each other",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "each other",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                        "entry_id": "fbff04ee-7061-379c-a3d6-78408300d13a",
                                        "glosses": [
                                            "To one another; one to the other; signifies that a verb applies to two or more entities both as subjects and as direct objects"
                                        ],
                                        "tags": [
                                            "pronoun",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44ea647-a005-4ca6-8777-fe6faaa76631",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "My parents love each other; however, they talk to themselves a lot but not so much to each other."
                                            },
                                            {
                                                "example_id": "f390dbdc-43c2-48ad-ab7a-9744f38081d9",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "I don't think you two know each other, do you?"
                                            },
                                            {
                                                "example_id": "7f783839-0cec-4e31-b074-1af1cfa9dd4c",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet: or anon we shot into a clearing, with a colored glimpse of the lake and its curving shore far below us."
                                            },
                                            {
                                                "example_id": "43362fb9-8f41-45db-846e-d917f2354901",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Passengers wander restlessly about or hurry, with futile energy, from place to place. Pushing men hustle each other at the windows of the purser's office, under pretence of expecting letters or despatching telegrams."
                                            },
                                            {
                                                "example_id": "e5983f92-939f-4572-beea-4ab7193d00f0",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "We've known each other many years, but this is the first time you ever came to me for counsel or for help."
                                            },
                                            {
                                                "example_id": "49bf8472-471e-4447-a346-6366a63411f5",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "It was the first time United had conceded six goals at Old Trafford since 1930, when Huddersfield won 6-0 and Newcastle 7-4 within four days of each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "157da509-2472-49d3-a7aa-81c0c82db0fa",
                        "source_entry_id": "b52dc5ba-59af-3acc-a6aa-54ae18767e18",
                        "target_lang_word": "mutually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4b4fb9-b9a6-354b-9c0e-e52a14d5a088",
                                        "entry_id": "2783b676-0f7f-3605-9c19-542be1c1f79e",
                                        "glosses": [
                                            "In the same way, each to the other; reciprocally"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ead45f6f-5504-4feb-bc18-8e81a2c6eba3",
                                                "sense_id": "2a4b4fb9-b9a6-354b-9c0e-e52a14d5a088",
                                                "text": "The contract was mutually binding."
                                            },
                                            {
                                                "example_id": "b0da2a8c-3bf9-4ad4-91a1-dde850d1cb46",
                                                "sense_id": "2a4b4fb9-b9a6-354b-9c0e-e52a14d5a088",
                                                "text": "Each written word when spoken is mutually incomprehensible between a Mandarin speaker in Beijing and a Cantonese speaker in Hong Kong. If you think that’s odd, consider our number system: the symbol “9” is universally recognized but it’s pronounced “nine” in English and “devet” in Slovenian."
                                            },
                                            {
                                                "example_id": "7bb357df-947c-4bb1-86c3-1cd4c155bd41",
                                                "sense_id": "2a4b4fb9-b9a6-354b-9c0e-e52a14d5a088",
                                                "text": "The deepening strategic partnership between the People’s Republic of China and the Russian Federation and their mutually reinforcing attempts to undercut the rules-based international order run counter to our values and interests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dde9515-f789-3419-b474-71381dd9a148",
                                        "entry_id": "2783b676-0f7f-3605-9c19-542be1c1f79e",
                                        "glosses": [
                                            "In a shared manner; equally; affecting all parties the same way"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49741117-a1d6-4c99-aebd-a9f810e61c18",
                                                "sense_id": "4dde9515-f789-3419-b474-71381dd9a148",
                                                "text": "The adventure was mutually beneficial."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
