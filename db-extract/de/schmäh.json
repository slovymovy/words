                "senses": [
                    {
                        "sense_id": "38e21105-dd5e-3cd6-bc80-65cc61e9b872",
                        "entry_id": "3e9efe3a-0a97-32b6-a006-8c9d9ad4e6d9",
                        "glosses": [
                            "shrewd talk, astute interaction, trick"
                        ],
                        "tags": [
                            "masculine",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "7aacc70b-faa2-4fac-9e89-971eb2983632",
                                "sense_id": "38e21105-dd5e-3cd6-bc80-65cc61e9b872",
                                "text": "Früher waren die Fiaker zu den Fiakerfahrerinnen sehr böse. Sie sagten, dass eine Frau nicht auf einen Kutschbock gehöre. Nach und nach lernten die Fahrer doch die Vorteile durch die Frauen zu schätzen, denn mit ihnen lief der Schmäh besser.",
                                "translation": "In the past, fiacre drivers were very hostile towards female fiacre drivers. They said that women didn’t belong on a coachman’s box. Gradually though, the drivers came to appreciate the advantages of having women drivers, as they were better at engaging with customers.",
                                "english": "In the past, fiacre drivers were very hostile towards female fiacre drivers. They said that women didn’t belong on a coachman’s box. Gradually though, the drivers came to appreciate the advantages of having women drivers, as they were better at engaging with customers."
                            }
                        ]
                    },
                    {
                        "sense_id": "697483e6-7b51-3f13-9358-8e8be33d22b9",
                        "entry_id": "3e9efe3a-0a97-32b6-a006-8c9d9ad4e6d9",
                        "glosses": [
                            "humour, joke"
                        ],
                        "tags": [
                            "masculine",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "9cb5a39a-98e6-470d-96ae-d5c48a3f0d5d",
                                "sense_id": "697483e6-7b51-3f13-9358-8e8be33d22b9",
                                "text": "Bei aller Ernsthaftigkeit und Respekt dürfen natürlich Witz und Wiener Schmäh nicht fehlen – denn schließlich kann man nur mit Humor die schlimmsten Dinge im Leben bewältigen.",
                                "translation": "For all its seriousness and respect, wit and Viennese charm must not be forgotten — after all, humour is the only way to cope with life’s greatest challenges.",
                                "english": "For all its seriousness and respect, wit and Viennese charm must not be forgotten — after all, humour is the only way to cope with life’s greatest challenges."
                            }
                        ]
                    }
