                ],
                "senses": [
                    {
                        "sense_id": "414d3843-e0ce-3bd1-8ef8-155eb3183c91",
                        "entry_id": "35b1d851-8c52-3f7a-932c-d4dfae8d8b1d",
                        "glosses": [
                            "Person (auch bei Tieren), die einen Krankheitserreger von sich gibt (ohne zu dem Zeitpunkt selbst erkrankt zu sein), dies kann zum Beispiel über das Aushusten von Sekret geschehen oder über den Stuhl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9845fa2f-8ea5-438e-b3bd-92fcc65a0f16",
                                "sense_id": "414d3843-e0ce-3bd1-8ef8-155eb3183c91",
                                "text": "„Unter „Ausscheidern“ versteht man Personen, die krankmachende Erreger wie z. B. Bakterien in sich tragen und ausscheiden (in der Regel mit dem Stuhl, bei EHEC, Typhus und Paratyphus auch mit dem Urin), selbst aber nicht oder nicht mehr erkrankt sind. Ausscheider können die Gesundheit der Bevölkerung gefährden, da von ihnen vereinzelte Ansteckungen und auch Krankheitsausbrüche ausgehen können.“"
                            },
                            {
                                "example_id": "bb10d81e-b54b-472e-ab21-ea1eca7c7679",
                                "sense_id": "414d3843-e0ce-3bd1-8ef8-155eb3183c91",
                                "text": "„Andere Tiere desselben Bestandes scheiden nur gelegentlich oder über Wochen hinweg gar kein Virus aus. Katzen, die dauernd FCoV ausscheiden, können pro Gramm Kot bis zu einer Million mal mehr FCoV aufweisen als gelegentliche Ausscheider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
