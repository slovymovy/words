                        "ru": [
                            {
                                "target_lang_word": "бу́квица",
                                "target_lang_sense_clarification": "декоративная заглавная буква"
                            },
                            {
                                "target_lang_word": "инициа́л",
                                "target_lang_sense_clarification": "типографский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首字",
                                "target_lang_sense_clarification": "装饰性大写字母"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4f0959b-e63b-3382-99ce-0ba04aae55ff",
                    "sense_definition": "The part of a syllable that comes before the vowel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the word 'cat', the <w>initial</w> is the 'c' sound.",
                            "target_lang_translations": {
                                "ru": "В слове 'cat' <w>инициалью</w> является звук 'c'.",
                                "zh": "在单词“cat”中，<w>声母</w>是“c”的音。"
                            }
                        },
                        {
                            "text": "Some languages allow complex clusters of consonants in the <w>initial</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые языки допускают сложные скопления согласных в <w>инициали</w>.",
                                "zh": "有些语言允许在<w>声母</w>位置出现复杂的辅音丛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть слога, предшествующая гласному (онсет).",
                        "zh": "音节中元音之前的部分（声母）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инициа́ль",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声母",
                                "target_lang_sense_clarification": "语言学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
