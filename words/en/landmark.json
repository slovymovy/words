{
    "word_family": [
        "land"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a9b55f5-72e9-3967-a3a7-47f22cb0cbdd",
                    "sense_definition": "A notable location with historical, cultural, or geographical significance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Eiffel Tower is a famous <w>landmark</w> that attracts millions of visitors.",
                            "target_lang_translations": {
                                "ru": "Эйфелева башня — знаменитая <w>достопримечательность</w>, которая привлекает миллионы посетителей.",
                                "zh": "埃菲尔铁塔是一座著名的<w>地标</w>，吸引了数百万游客。"
                            }
                        },
                        {
                            "text": "We took photos in front of every historic <w>landmark</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Мы фотографировались у каждой исторической <w>достопримечательности</w> в городе.",
                                "zh": "我们在城里的每一处历史<w>地标</w>前都拍了照。"
                            }
                        }
                    ],
                    "synonyms": [
                        "monument",
                        "sight",
                        "attraction"
                    ],
                    "common_phrases": [
                        "famous landmark",
                        "historic landmark",
                        "national landmark",
                        "local landmark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или объект, имеющие историческую, культурную или географическую значимость и заслуживающие особого внимания.",
                        "zh": "具有历史、文化或地理意义，值得特别关注的地点或建筑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достопримечательность",
                                "target_lang_sense_clarification": "место, заслуживающее внимания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地标",
                                "target_lang_sense_clarification": "具有标志性的地点"
                            },
                            {
                                "target_lang_word": "名胜",
                                "target_lang_sense_clarification": "著名的旅游景点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e085f3-0050-33a7-838f-e2288d29a38c",
                    "sense_definition": "A recognizable natural or man-made feature used for navigation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "location_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall church spire serves as a <w>landmark</w> for sailors approaching the coast.",
                            "target_lang_translations": {
                                "ru": "Высокий шпиль церкви служит <w>ориентиром</w> для моряков, приближающихся к берегу.",
                                "zh": "高耸的教堂尖顶是水手们靠近海岸时的<w>参照物</w>。"
                            }
                        },
                        {
                            "text": "Hikers use the mountain peak as a visual <w>landmark</w> to find their way back.",
                            "target_lang_translations": {
                                "ru": "Туристы используют горную вершину как визуальный <w>ориентир</w>, чтобы найти обратную дорогу.",
                                "zh": "徒步旅行者利用山峰作为视觉<w>参照物</w>来寻找回程的路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marker"
                    ],
                    "common_phrases": [
                        "visual landmark",
                        "familiar landmark",
                        "prominent landmark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо заметный естественный или искусственный объект на местности, используемый для определения местоположения или направления.",
                        "zh": "用于导航或辨别方向的明显自然或人造特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "объект для навигации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "参照物",
                                "target_lang_sense_clarification": "用于定位的物体"
                            },
                            {
                                "target_lang_word": "地标",
                                "target_lang_sense_clarification": "用于辨认方位的标志"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                    "sense_definition": "A major event or discovery.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invention of the internet was a <w>landmark</w> in the history of communication.",
                            "target_lang_translations": {
                                "ru": "Изобретение интернета стало <w>вехой</w> в истории коммуникации.",
                                "zh": "互联网的发明是通信史上的一个<w>里程碑</w>。"
                            }
                        },
                        {
                            "text": "The court made a <w>landmark</w> decision that changed the laws regarding privacy.",
                            "target_lang_translations": {
                                "ru": "Суд вынес <w>знаковое</w> решение, которое изменило законы о конфиденциальности.",
                                "zh": "法院做出了一个具有<w>里程碑</w>意义的判决，改变了有关隐私的法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "milestone"
                    ],
                    "common_phrases": [
                        "landmark decision",
                        "landmark victory",
                        "landmark case",
                        "landmark event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Важное событие, открытие или этап, имеющие поворотное значение в истории чего-либо.",
                        "zh": "在历史或进程中具有转折意义的重大事件或发现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веха",
                                "target_lang_sense_clarification": "важный этап"
                            },
                            {
                                "target_lang_word": "поворотный момент",
                                "target_lang_sense_clarification": "значимое событие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "里程碑",
                                "target_lang_sense_clarification": "具有重大意义的阶段"
                            },
                            {
                                "target_lang_word": "转折点",
                                "target_lang_sense_clarification": "改变进程的关键点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "844a2789-30f0-3ef4-9f8c-bb486bc16a21",
                    "sense_definition": "An object that marks the boundary of a piece of land (usually a stone, or a tree).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "boundary_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old oak tree has served as a <w>landmark</w> between the two farms for a century.",
                            "target_lang_translations": {
                                "ru": "Старый дуб служил <w>межевым знаком</w> между двумя фермами на протяжении столетия.",
                                "zh": "那棵老橡树作为一个世纪以来两座农场之间的<w>界标</w>。"
                            }
                        },
                        {
                            "text": "They placed a stone <w>landmark</w> to clearly define the edge of the property.",
                            "target_lang_translations": {
                                "ru": "Они установили каменный <w>межевой знак</w>, чтобы четко определить границу участка.",
                                "zh": "他们放置了一块石头作为<w>界标</w>，以明确界定该房产的边界。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marker"
                    ],
                    "common_phrases": [
                        "boundary landmark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект (камень, дерево и т.п.), обозначающий границу земельного участка.",
                        "zh": "用于标记土地边界的物体，如石头或树木。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "межевой знак",
                                "target_lang_sense_clarification": "знак границы"
                            },
                            {
                                "target_lang_word": "веха",
                                "target_lang_sense_clarification": "метка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "界标",
                                "target_lang_sense_clarification": "标记边界的标志"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d2470b4-ccb5-3c9d-80e4-18b53d60a5f3",
                    "sense_definition": "To officially designate a site or building as a landmark.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council voted to <w>landmark</w> the historic theater to prevent its demolition.",
                            "target_lang_translations": {
                                "ru": "Городской совет проголосовал за то, чтобы <w>присвоить статус памятника</w> историческому театру для предотвращения его сноса.",
                                "zh": "市议会投票决定将这座历史悠久的剧院<w>列为地标</w>，以防止其被拆除。"
                            }
                        },
                        {
                            "text": "Preservationists are working hard to <w>landmark</w> several old buildings in the downtown area.",
                            "target_lang_translations": {
                                "ru": "Защитники памятников усердно работают над тем, чтобы <w>присвоить статус памятника</w> нескольким старинным зданиям в центре города.",
                                "zh": "文物保护者们正在努力将市中心的几座老建筑<w>列为地标</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "landmark a building",
                        "landmark a site"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально присвоить зданию или месту статус охраняемого исторического объекта.",
                        "zh": "正式将某处地点或建筑指定为受保护的历史地标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присвоить статус памятника",
                                "target_lang_sense_clarification": "объявить охраняемым объектом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "列为地标",
                                "target_lang_sense_clarification": "赋予保护地位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}