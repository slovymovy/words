                                        "glosses": [
                                            "Acción de importar mercancías o cuestiones simbólicas obtenidas, elaboradas o fabricadas en el extranjero."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beae4f01-7896-40b8-b231-1a388082d0d1",
                                                "sense_id": "eeaa5580-7f67-3736-a341-ccac0d768d70",
