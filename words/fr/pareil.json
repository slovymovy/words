                {
                    "sense_id": "590fad11-1f84-3352-8ef2-f0617e8f346a",
                    "sense_definition": "Malgré tout, quand même, en dépit d'un obstacle ou d'une objection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malgré tout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'avais pas envie d'y aller, mais j'y suis allé <w>pareil</w>."
                        },
                        {
                            "text": "— Je l'ai déjà visitée hier. — Ça ne fait rien, viens <w>pareil</w>."
                        },
                        {
                            "text": "Il pleuvait beaucoup, mais nous sommes sortis <w>pareil</w>."
                        }
                    ],
                    "synonyms": [
                        "quand même"
                    ],
                    "common_phrases": [
                        "y aller pareil"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langage familier, surtout à l'oral"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54db2191-e20a-3656-9275-14f123a6b3ce",
                    "sense_definition": "Personne ou chose semblable, équivalente à une autre, surtout dans des expressions comme « ne pas avoir son pareil ».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme n'a pas son <w>pareil</w> pour réparer les vieilles montres."
                        },
                        {
                            "text": "Elle n'a pas sa <w>pareille</w> pour faire des gâteaux."
                        },
                        {
                            "text": "Ce tableau est unique : on ne lui connaît pas de <w>pareil</w>."
                        }
                    ],
                    "common_phrases": [
