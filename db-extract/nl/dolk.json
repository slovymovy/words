                                "target_senses": [
                                    {
                                        "sense_id": "dd63d467-bc3c-3c45-9254-c50052c347fb",
                                        "entry_id": "c5ffce0a-a543-3a60-83fe-2555ce16e202",
                                        "glosses": [
                                            "A timber placed diagonally in a ship's frame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df03d7c3-b8b9-4135-b9d8-5a68abde28de",
                                                "sense_id": "dd63d467-bc3c-3c45-9254-c50052c347fb",
                                                "text": "DAGGER. A piece of timber that faces on to the poppets of the bilgeways, and crosses them diagonally , to keep them together"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d49352a5-710f-4140-b052-20e7188f4988",
                        "source_entry_id": "0e3a130e-6a7c-3ec4-895a-79e835691a8e",
                        "source_sense_id": "b9a413fb-61ae-3d17-9f41-1c2527cb9753",
                        "target_lang_word": "poignard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poignard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90a3f8b9-a127-34cd-87ab-d07b6537ee5e",
                                        "entry_id": "2c17cede-7907-3ebc-a7d3-fb5f94c1aa2e",
                                        "glosses": [
                                            "Arme à lame courte et pointue."
                                        ],
                                        "tags": [
                                            "Coutellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e63af18f-6e45-4dbf-bb8f-ab4a84447ecd",
                                                "sense_id": "90a3f8b9-a127-34cd-87ab-d07b6537ee5e",
                                                "text": "Simon Cohen, se conformant en ceci à l’usage du pays qui interdit le port des armes à ses coreligionnaires marocains, est inerme ; les chameliers ont des gourdins et de mauvais poignards […]"
                                            },
                                            {
                                                "example_id": "8940a639-1ec6-43dc-b11c-9a8549ada4f4",
                                                "sense_id": "90a3f8b9-a127-34cd-87ab-d07b6537ee5e",
                                                "text": "Les deux malandrins alors ont essayé de l’achever avec leurs crosses d’armes et leurs poignards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b9738bc-5486-34ee-82e7-f094a853866f",
                                        "entry_id": "2c17cede-7907-3ebc-a7d3-fb5f94c1aa2e",
                                        "glosses": [
                                            "Brochet."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27b1dc0-0946-4f6b-81d8-3cd63ce570f9",
                                                "sense_id": "3b9738bc-5486-34ee-82e7-f094a853866f",
                                                "text": "Le brochet se nomme lançon et lanceron, quand il est très jeune ; poignard, quand il est d’une grosseur moyenne ; carreau, quand il est plus gros. On l’appelle encore béquet et béchet dans quelques départements de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec0b7924-6d6b-31e0-ae13-88d41fd50dd0",
                                        "entry_id": "2c17cede-7907-3ebc-a7d3-fb5f94c1aa2e",
                                        "glosses": [
                                            "Pièce de tissu taillée en pointe, que l’on met à un vêtement pour l’élargir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f280d2-0603-4881-b9a4-6a6637c339ac",
                                                "sense_id": "ec0b7924-6d6b-31e0-ae13-88d41fd50dd0",
                                                "text": "Les ouvriers qui, chez tous les tailleurs, sont chargés de faire des poignards ou des retouches s’appellent des pompiers, et leur travail est dit à la pompe."
                                            },
                                            {
                                                "example_id": "f14aa18f-cdf0-4648-bdcc-de75f9d4b92b",
                                                "sense_id": "ec0b7924-6d6b-31e0-ae13-88d41fd50dd0",
                                                "text": "Ça m’en a l’air, répliqua Cibot, en laissant tomber une manche d’habit où il faisait ce que, dans l’argot des tailleurs, on appelle un poignard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
