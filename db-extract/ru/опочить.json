                "senses": [
                    {
                        "sense_id": "d7d88771-8390-385b-a3dd-a1541d4894bc",
                        "entry_id": "abc549f1-217a-3dfd-8882-dbba9d3e0df7",
                        "glosses": [
                            "устар., высок., поэт. то же, что почить, уснуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173de273-b334-4f6f-91c9-3ae6a5c40dd1",
                                "sense_id": "d7d88771-8390-385b-a3dd-a1541d4894bc",
                                "text": "Никто под крышею подъемной до утра сном не опочил."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1bb80bd-9fb2-36c0-8340-187dd391be56",
                        "entry_id": "abc549f1-217a-3dfd-8882-dbba9d3e0df7",
                        "glosses": [
                            "перен., поэт. умереть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9068f58-fae0-4510-8c21-b1f65f56afa5",
                                "sense_id": "c1bb80bd-9fb2-36c0-8340-187dd391be56",
                                "text": "А вот и мой конь — на века опочил, один только череп остался."
                            }
                        ]
                    }
