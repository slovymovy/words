{
    "word_family": [
        "détortiller",
        "entortillement",
        "entortiller",
        "tortillage",
        "tortillard",
        "tortillement",
        "tortillon"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d61875ce-3bb1-3ac9-aa6e-8c584e583fd8",
                    "sense_definition": "Tordre ou rouler plusieurs fois sur lui-même un objet souple comme un fil, du papier ou des cheveux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il écoutait distraitement la réunion en <w>tortillant</w> une mèche de cheveux entre ses doigts.",
                            "target_lang_translations": {
                                "en": "He listened distractedly to the meeting while <w>twisting</w> a lock of hair between his fingers.",
                                "ru": "Он рассеянно слушал совещание, <w>накручивая</w> прядь волос между пальцами.",
                                "de": "Er hörte der Besprechung zerstreut zu und <w>zwirbelte</w> dabei eine Haarsträhne zwischen den Fingern.",
                                "es": "Escuchaba distraídamente la reunión mientras <w>retorcía</w> un mechón de pelo entre los dedos.",
                                "zh": "他一边心不在焉地听着会议，一边用手指<w>捻</w>着一绺头发。"
                            }
                        },
                        {
                            "text": "Elle continuait de <w>tortiller</w> son mouchoir avec anxiété pendant que le médecin parlait.",
                            "target_lang_translations": {
                                "en": "She kept <w>twisting</w> her handkerchief anxiously while the doctor was speaking.",
                                "ru": "Она продолжала тревожно <w>крутить</w> платок, пока врач говорил.",
                                "de": "Sie <w>drehte</w> ihr Taschentuch ängstlich weiter, während der Arzt sprach.",
                                "es": "Seguía <w>retorciendo</w> el pañuelo con ansiedad mientras el médico hablaba.",
                                "zh": "医生讲话的时候，她焦虑地一直<w>绞</w>着手帕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entortiller",
                        "tordre"
                    ],
                    "antonyms": [
                        "détordre"
                    ],
                    "common_phrases": [
                        "tortiller une mèche",
                        "tortiller un fil"
                    ],
                    "target_lang_definitions": {
                        "en": "Twist or coil a flexible object, such as thread, paper or hair, several times around itself.",
                        "ru": "Скручивать или многократно обматывать вокруг себя гибкий предмет, например нитку, бумагу или волосы.",
                        "de": "Einen biegsamen Gegenstand wie Faden, Papier oder Haare mehrmals um sich selbst drehen oder wickeln.",
                        "es": "Torcer o enrollar varias veces sobre sí mismo un objeto flexible, como un hilo, papel o cabello.",
                        "zh": "把细线、纸或头发等柔软的物体多次扭转或绕卷。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twist",
                                "target_lang_sense_clarification": "thread, hair or paper"
                            },
                            {
                                "target_lang_word": "twirl",
                                "target_lang_sense_clarification": "a strand of hair"
                            },
                            {
                                "target_lang_word": "wind",
                                "target_lang_sense_clarification": "coil thread or wire around"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "крутить",
                                "target_lang_sense_clarification": "нить, бумагу или шнур"
                            },
                            {
                                "target_lang_word": "накручивать",
                                "target_lang_sense_clarification": "прядь волос на палец"
                            },
                            {
                                "target_lang_word": "наматывать",
                                "target_lang_sense_clarification": "нить или проволоку вокруг"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "drehen",
                                "target_lang_sense_clarification": "Faden, Papier oder Haare"
                            },
                            {
                                "target_lang_word": "zwirbeln",
                                "target_lang_sense_clarification": "Haarsträhne zwischen den Fingern"
                            },
                            {
                                "target_lang_word": "wickeln",
                                "target_lang_sense_clarification": "Faden oder Draht um etwas"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "torcer",
                                "target_lang_sense_clarification": "hilo, papel o mechones"
                            },
                            {
                                "target_lang_word": "retorcer",
                                "target_lang_sense_clarification": "papel o alambre"
                            },
                            {
                                "target_lang_word": "enrollar",
                                "target_lang_sense_clarification": "alrededor de un dedo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捻",
                                "target_lang_sense_clarification": "用手指搓线或发丝"
                            },
                            {
                                "target_lang_word": "绞",
                                "target_lang_sense_clarification": "扭绞手帕或布条"
                            },
                            {
                                "target_lang_word": "卷",
                                "target_lang_sense_clarification": "把纸或头发卷成圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b8831da-6b64-3535-8da9-ca9f277c818e",
                    "sense_definition": "S'agiter ou se tordre dans tous les sens par gêne, douleur ou impatience.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ver de terre continuait de se <w>tortiller</w> sur le sol humide du jardin.",
                            "target_lang_translations": {
                                "en": "The earthworm kept <w>wriggling</w> on the damp soil of the garden.",
                                "ru": "Дождевой червь продолжал <w>извиваться</w> на влажной земле сада.",
                                "de": "Der Regenwurm <w>wand sich</w> weiter auf dem feuchten Boden des Gartens.",
                                "es": "La lombriz de tierra seguía <w>retorciéndose</w> sobre el suelo húmedo del jardín.",
                                "zh": "蚯蚓还在花园潮湿的土地上继续<w>蠕动</w>。"
                            }
                        },
                        {
                            "text": "L'enfant n'arrivait pas à rester calme et commençait à se <w>tortiller</w> sur sa chaise.",
                            "target_lang_translations": {
                                "en": "The child could not keep still and began to <w>squirm</w> in their chair.",
                                "ru": "Ребёнок не мог усидеть на месте и начал <w>ерзать</w> на стуле.",
                                "de": "Das Kind konnte nicht ruhig bleiben und begann, auf seinem Stuhl zu <w>zappeln</w>.",
                                "es": "El niño no lograba quedarse tranquilo y empezaba a <w>revolverse</w> en su silla.",
                                "zh": "孩子静不下来，开始在椅子上<w>扭动</w>身子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frétiller",
                        "gigoter"
                    ],
                    "common_phrases": [
                        "se tortiller sur sa chaise",
                        "se tortiller de douleur"
                    ],
                    "target_lang_definitions": {
                        "en": "Move the body restlessly from discomfort, pain or impatience.",
                        "ru": "Беспокойно двигать телом от неудобства, боли или нетерпения.",
                        "de": "Sich aus Unbehagen, Schmerz oder Ungeduld unruhig hin und her bewegen.",
                        "es": "Agitarse o retorcerse en todas direcciones por molestia, dolor o impaciencia.",
                        "zh": "因不适、疼痛或不耐烦而不停地扭动身体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wriggle",
                                "target_lang_sense_clarification": "restless movement while seated"
                            },
                            {
                                "target_lang_word": "squirm",
                                "target_lang_sense_clarification": "from pain or embarrassment"
                            },
                            {
                                "target_lang_word": "fidget",
                                "target_lang_sense_clarification": "from impatience or boredom"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ерзать",
                                "target_lang_sense_clarification": "на стуле или месте, сидя"
                            },
                            {
                                "target_lang_word": "извиваться",
                                "target_lang_sense_clarification": "от боли или стыда"
                            },
                            {
                                "target_lang_word": "вертеться",
                                "target_lang_sense_clarification": "от скуки или нетерпения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zappeln",
                                "target_lang_sense_clarification": "vor Ungeduld, besonders bei Kindern"
                            },
                            {
                                "target_lang_word": "sich winden",
                                "target_lang_sense_clarification": "vor Schmerz oder Verlegenheit"
                            },
                            {
                                "target_lang_word": "herumrutschen",
                                "target_lang_sense_clarification": "unruhig auf dem Stuhl sitzen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "retorcerse",
                                "target_lang_sense_clarification": "de dolor o incomodidad"
                            },
                            {
                                "target_lang_word": "revolverse",
                                "target_lang_sense_clarification": "inquieto en la silla"
                            },
                            {
                                "target_lang_word": "removerse",
                                "target_lang_sense_clarification": "por impaciencia o aburrimiento"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扭动",
                                "target_lang_sense_clarification": "因不适而扭动身体"
                            },
                            {
                                "target_lang_word": "蠕动",
                                "target_lang_sense_clarification": "多指虫子或软体动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4c7f98d-b455-38da-b125-808ada68f162",
                    "sense_definition": "Marcher en balançant exagérément le bassin ou les hanches.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle avançait au milieu de la salle en <w>tortillant</w> des hanches au son de la musique.",
                            "target_lang_translations": {
                                "en": "She moved across the middle of the room, <w>wiggling</w> her hips to the music.",
                                "ru": "Она шла посреди зала, <w>вихляя</w> бёдрами под музыку.",
                                "de": "Sie ging mitten im Saal und <w>wackelte</w> dabei im Takt der Musik mit den Hüften.",
                                "es": "Avanzaba en medio de la sala <w>meneando</w> las caderas al son de la música.",
                                "zh": "她随着音乐<w>扭</w>着胯，走向大厅中央。"
                            }
                        },
                        {
                            "text": "Il traversait la plage en <w>tortillant</w> des fesses pour faire rire ses amis.",
                            "target_lang_translations": {
                                "en": "He crossed the beach <w>wiggling</w> his bottom to make his friends laugh.",
                                "ru": "Он шёл по пляжу, <w>виляя</w> задом, чтобы рассмешить друзей.",
                                "de": "Er ging über den Strand und <w>wackelte</w> mit dem Hintern, um seine Freunde zum Lachen zu bringen.",
                                "es": "Cruzaba la playa <w>meneando</w> el trasero para hacer reír a sus amigos.",
                                "zh": "他<w>扭</w>着屁股穿过海滩，为的是逗朋友们笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "se déhancher"
                    ],
                    "common_phrases": [
                        "tortiller des hanches"
                    ],
                    "target_lang_definitions": {
                        "en": "Walk while exaggeratedly swinging the hips or buttocks from side to side.",
                        "ru": "Идти, сильно покачивая бёдрами или ягодицами из стороны в сторону.",
                        "de": "Beim Gehen die Hüften oder das Gesäß übertrieben hin und her schwingen.",
                        "es": "Caminar balanceando exageradamente las caderas o el trasero de un lado a otro.",
                        "zh": "走路时夸张地扭动胯部或臀部。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wiggle",
                                "target_lang_sense_clarification": "hips, moving side to side"
                            },
                            {
                                "target_lang_word": "sashay",
                                "target_lang_sense_clarification": "walking in a showy manner"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вихлять",
                                "target_lang_sense_clarification": "бёдрами при ходьбе"
                            },
                            {
                                "target_lang_word": "вилять",
                                "target_lang_sense_clarification": "задом или бёдрами при ходьбе"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wackeln",
                                "target_lang_sense_clarification": "mit dem Hintern beim Gehen"
                            },
                            {
                                "target_lang_word": "schwingen",
                                "target_lang_sense_clarification": "die Hüften beim Gehen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "contonearse",
                                "target_lang_sense_clarification": "al caminar, de forma llamativa"
                            },
                            {
                                "target_lang_word": "menear",
                                "target_lang_sense_clarification": "las caderas o el trasero"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扭",
                                "target_lang_sense_clarification": "扭着胯或臀部走路"
                            },
                            {
                                "target_lang_word": "摇",
                                "target_lang_sense_clarification": "摇晃臀部或胯部走路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1304bff6-b445-389d-b0d7-77c45912d45c",
                    "sense_definition": "Chercher des prétextes ou des subterfuges pour retarder une décision ou éviter de répondre directement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'y a pas à <w>tortiller</w>, nous devons prendre une décision immédiate face à ce problème.",
                            "target_lang_translations": {
                                "en": "There's no point in <w>equivocating</w>: we must make an immediate decision about this problem.",
                                "ru": "Тут нечего <w>юлить</w>: нам нужно немедленно принять решение по этой проблеме.",
                                "de": "Da gibt es nichts <w>herumzueiern</w>: Wir müssen angesichts dieses Problems sofort eine Entscheidung treffen.",
                                "es": "No hay que <w>eludir</w> la cuestión: debemos tomar una decisión inmediata ante este problema.",
                                "zh": "这事没什么好<w>推托</w>的，我们必须马上就这个问题做出决定。"
                            }
                        },
                        {
                            "text": "Arrête de <w>tortiller</w> et dis-moi enfin ce qui s'est réellement passé hier soir.",
                            "target_lang_translations": {
                                "en": "Stop <w>waffling</w> and tell me once and for all what really happened last night.",
                                "ru": "Хватит <w>юлить</w> и скажи наконец, что на самом деле случилось вчера вечером.",
                                "de": "Hör auf, <w>herumzueiern</w>, und sag mir endlich, was gestern Abend wirklich passiert ist.",
                                "es": "Deja de <w>eludir</w> el tema y dime de una vez qué pasó en realidad anoche.",
                                "zh": "别再<w>支吾</w>了，干脆告诉我昨晚到底发生了什么。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hésiter",
                        "tergiverser"
                    ],
                    "common_phrases": [
                        "il n'y a pas à tortiller"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à la forme négative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Look for excuses or evasive tactics to delay a decision or avoid answering directly; often used in the negative.",
                        "ru": "Искать отговорки или уловки, чтобы отложить решение или уклониться от прямого ответа. Часто употребляется в отрицательной форме.",
                        "de": "Nach Ausflüchten suchen, um eine Entscheidung hinauszuzögern oder einer direkten Antwort auszuweichen. Meist in verneinter Form gebraucht.",
                        "es": "Buscar pretextos o rodeos para retrasar una decisión o evitar responder directamente.",
                        "zh": "寻找借口或托词来拖延决定，或不直接回答问题；常用于否定句。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "equivocate",
                                "target_lang_sense_clarification": "evasive, deliberately vague wording"
                            },
                            {
                                "target_lang_word": "prevaricate",
                                "target_lang_sense_clarification": "evasive answers, formal register"
                            },
                            {
                                "target_lang_word": "waffle",
                                "target_lang_sense_clarification": "informal, vague, rambling talk"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "юлить",
                                "target_lang_sense_clarification": "уклончивые ответы, разговорное"
                            },
                            {
                                "target_lang_word": "увиливать",
                                "target_lang_sense_clarification": "от прямого ответа или дела"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ausweichen",
                                "target_lang_sense_clarification": "einer direkten Frage ausweichen"
                            },
                            {
                                "target_lang_word": "herumeiern",
                                "target_lang_sense_clarification": "umgangssprachlich, unklare, ausweichende Antworten"
                            },
                            {
                                "target_lang_word": "lavieren",
                                "target_lang_sense_clarification": "formal, ausweichend taktieren"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "andarse con rodeos",
                                "target_lang_sense_clarification": "evitar responder directamente"
                            },
                            {
                                "target_lang_word": "darle vueltas",
                                "target_lang_sense_clarification": "retrasar una decisión"
                            },
                            {
                                "target_lang_word": "eludir",
                                "target_lang_sense_clarification": "una pregunta incómoda"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推托",
                                "target_lang_sense_clarification": "找借口拖延或回避"
                            },
                            {
                                "target_lang_word": "搪塞",
                                "target_lang_sense_clarification": "敷衍应付，不正面回答"
                            },
                            {
                                "target_lang_word": "支吾",
                                "target_lang_sense_clarification": "说话含糊，不正面回答"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}