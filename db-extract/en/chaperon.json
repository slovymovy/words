                "translations": [
                    {
                        "translation_id": "e59826bf-365b-401f-af6a-3610778499f1",
                        "source_entry_id": "ed2bcd6b-945b-3dc9-bb5d-d7a83ca8680e",
                        "source_sense_description": "to accompany, to escort",
                        "target_lang_word": "begleiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begleiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbe3b29c-107c-36dd-9dd7-acd2ef0a9d37",
                                        "entry_id": "2d3bea53-9ae6-34bd-8233-fcb123d960a5",
                                        "glosses": [
                                            "jemandem Geleit geben; mit jemandem mitgehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28fa7990-e7e7-45fc-bc4c-27c3a89f119e",
                                                "sense_id": "fbe3b29c-107c-36dd-9dd7-acd2ef0a9d37",
                                                "text": "Hast du Lust, mich zum Abschlussball zu begleiten?"
                                            },
                                            {
                                                "example_id": "48f27fa4-6858-4bc6-8ea5-9cbf3b1e0a63",
                                                "sense_id": "fbe3b29c-107c-36dd-9dd7-acd2ef0a9d37",
                                                "text": "„Ich begleitete ihn auf drei oder vier Fahrten und wuchs zu einem großen, kräftigen Burschen heran; da kaperte uns auf der Heimfahrt von der Neufundlandbank ein algerischer Seeräuber oder ein Kriegsschiff.“"
                                            },
                                            {
                                                "example_id": "5c078268-cb4a-4ac5-b946-c6bc45d7b8d7",
                                                "sense_id": "fbe3b29c-107c-36dd-9dd7-acd2ef0a9d37",
                                                "text": "„Gute Wagniserziehung begleitet behutsam beim Hineinwachsen in Wagnisse auf möglichst vielen Gebieten und hilft, übergreifende Wagnisfähigkeiten zu entwickeln.“"
                                            },
                                            {
                                                "example_id": "05d96a48-5e14-433d-83b5-73bb3d2bf165",
                                                "sense_id": "fbe3b29c-107c-36dd-9dd7-acd2ef0a9d37",
                                                "text": "Darf ich dich nach Hause begleiten?"
                                            },
                                            {
                                                "example_id": "d40d351f-f80f-4c13-bbe1-021f0f4a2e45",
                                                "sense_id": "fbe3b29c-107c-36dd-9dd7-acd2ef0a9d37",
                                                "text": "„Ins Basislager am Fuß des Bergs begleiteten ihn sein Bruder Vincent und sein Vater Alfred, der als junger Mann Touren im Himalaja unternommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95165d78-c230-3b9f-9188-6a23dd3d8ee9",
                                        "entry_id": "2d3bea53-9ae6-34bd-8233-fcb123d960a5",
                                        "glosses": [
                                            "(mit einem Instrument) die Melodiestimme harmonisch und rhythmisch unterstützen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f03c5f-1ba0-4d5d-b914-682833cbbfc2",
                                                "sense_id": "95165d78-c230-3b9f-9188-6a23dd3d8ee9",
                                                "text": "Die Gitarre begleitet den Gesang."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13c74b2e-43f3-3f18-8fc4-4877f7948ded",
                                        "entry_id": "2d3bea53-9ae6-34bd-8233-fcb123d960a5",
                                        "glosses": [
                                            "zusammen mit etwas geschehen; in Kombination vorkommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc62da90-66ce-4d02-b445-86089c237c2b",
                                                "sense_id": "13c74b2e-43f3-3f18-8fc4-4877f7948ded",
                                                "text": "Die Wehen begleiten heftige Schmerzen."
                                            },
                                            {
                                                "example_id": "7957e430-8da1-4285-995c-e85bbf350854",
                                                "sense_id": "13c74b2e-43f3-3f18-8fc4-4877f7948ded",
                                                "text": "„Diese Befindlichkeit ist von Glücksgefühlen begleitet. Kletterer ‚tanzen’ in dieser Gefühlslage in der Wand, Gleitschirmpiloten in der Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c0badab-9f17-416d-b9e2-eff80b54dd97",
                        "source_entry_id": "ed2bcd6b-945b-3dc9-bb5d-d7a83ca8680e",
                        "source_sense_description": "to accompany, to escort",
                        "target_lang_word": "eskortieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eskortieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "296f9130-0eee-3088-a598-3be7c067607f",
                                        "entry_id": "e23bc6b6-7249-35ef-a732-a5513a8fec1e",
                                        "glosses": [
                                            "(mit Begleitschutz) begleiten; geleiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90631fa4-1746-4be5-bfe1-8ae77c0ab45e",
                                                "sense_id": "296f9130-0eee-3088-a598-3be7c067607f",
                                                "text": "Der Präsident wurde unter Polizeischutz eskortiert."
                                            },
                                            {
                                                "example_id": "f5242888-48ae-4b4a-b8ea-8f0ee4956ae4",
                                                "sense_id": "296f9130-0eee-3088-a598-3be7c067607f",
                                                "text": "„Kurz darauf fuhr eine elegante, von zwei Grauschimmeln gezogene Kutsche in den Hof, die von einer Gruppe berittener Soldaten eskortiert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcc20ffe-83c3-40f4-b655-92d7e70c60d4",
                        "source_entry_id": "ed2bcd6b-945b-3dc9-bb5d-d7a83ca8680e",
                        "source_sense_description": "to accompany, to escort",
                        "target_lang_word": "beaufsichtigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beaufsichtigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d005e599-bc02-39c8-8f3e-aad5d70d41dd",
                                        "entry_id": "bbda42f4-4831-345e-92aa-03b084b05515",
                                        "glosses": [
                                            "ein Auge auf etwas haben; kontrollierend überwachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "738a8496-8ad7-44d9-957f-e6c8f18b4e52",
                                                "sense_id": "d005e599-bc02-39c8-8f3e-aad5d70d41dd",
                                                "text": "Ein oder zwei Erzieher beaufsichtigen die Kinder in der Sandkiste."
                                            },
                                            {
                                                "example_id": "14a1d39e-dfc5-425d-a9e2-d400b723f17c",
                                                "sense_id": "d005e599-bc02-39c8-8f3e-aad5d70d41dd",
                                                "text": "„Das Haspelamt, dem der Haspelmeister (Haspelmeistergasse) vorstand, war dazu bestimmt, die kaiserlichen Jagdreviere (insbesondere Hasengehege) zu beaufsichtigen.“"
                                            },
                                            {
                                                "example_id": "8b02a9f5-4709-4c56-882c-0822bb24a1f0",
                                                "sense_id": "d005e599-bc02-39c8-8f3e-aad5d70d41dd",
                                                "text": "„Überweisungen müssten künftig abteilungsübergreifend beaufsichtigt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
