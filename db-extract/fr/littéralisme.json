                            {
                                "example_id": "1564e835-64c0-4798-b3f4-bdb82755a3f5",
                                "sense_id": "2198c3b6-ea61-3eb9-b4ab-329a0c1b42f6",
                                "text": "Ressemblance jusqu’au littéralisme."
                            },
                            {
                                "example_id": "50cd7674-feda-46c5-a413-3bf3d1b4c503",
                                "sense_id": "2198c3b6-ea61-3eb9-b4ab-329a0c1b42f6",
                                "text": "Un prosaïque bon sens, un niais littéralisme ravalent peu à peu ces grandes notions comme ailleurs l’épais scepticisme ou la gouaille l’ont fait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e89d5196-3c50-477d-8003-0ff81aec8962",
                        "source_entry_id": "a01d5c11-a4ca-3a0f-87d0-f62fe5c9dfc7",
                        "source_sense_id": "2198c3b6-ea61-3eb9-b4ab-329a0c1b42f6",
