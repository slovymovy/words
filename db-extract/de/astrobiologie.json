                "senses": [
                    {
                        "sense_id": "cde18517-b781-3e97-9235-51fef0d74ba6",
                        "entry_id": "06580e91-b2b8-34c2-9c80-cda48e77a80b",
                        "glosses": [
                            "Wissenschaftszweig, der sich mit der Entstehung des Lebens im Universum beschäftigt"
                        ],
                        "tags": [
                            "Astrophysik"
                        ],
                        "examples": [
                            {
                                "example_id": "9093c0db-9be3-4b53-9546-a2b4f19a0aaa",
                                "sense_id": "cde18517-b781-3e97-9235-51fef0d74ba6",
                                "text": "„Die Konzepte der Astrobiologie können eventuell die Fragen lösen, wie die organische Evolution begonnen hat und wie auf der Erde in den ersten 500 Millionen Jahren die ersten Phasen dieser Evolution abgelaufen sind.“"
                            },
                            {
                                "example_id": "1e590586-77b6-4579-b2eb-3b7caf2954a8",
                                "sense_id": "cde18517-b781-3e97-9235-51fef0d74ba6",
                                "text": "\"Dass die Extremophilen unter so ungewöhnlichen Bedingungen leben können, hat der Astrobiologie einen deutlichen Schub gegeben\", sagt Rabbow."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
