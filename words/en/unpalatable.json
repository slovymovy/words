{
    "word_family": [
        "palatable",
        "palatability",
        "unpalatability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1449f9b-d174-31de-8ac9-6e9d5c867e0f",
                    "sense_definition": "Difficult to accept; highly unpleasant or disagreeable to the mind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disagreeable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager had to deliver the <w>unpalatable</w> truth about the upcoming budget cuts to the entire team.",
                            "target_lang_translations": {
                                "ru": "Менеджеру пришлось сообщить всей команде <w>горькую</w> правду о предстоящем сокращении бюджета."
                            }
                        },
                        {
                            "text": "Accepting that we were wrong was an <w>unpalatable</w> truth that we all had to face eventually.",
                            "target_lang_translations": {
                                "ru": "Признание своей неправоты было <w>неприятной</w> правдой, с которой нам всем в конце концов пришлось столкнуться."
                            }
                        }
                    ],
                    "synonyms": [
                        "distasteful",
                        "unsavory"
                    ],
                    "common_phrases": [
                        "unpalatable truth",
                        "unpalatable facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для принятия; крайне неприятный или неприемлемый для разума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горький",
                                "target_lang_sense_clarification": "о правде, фактах"
                            },
                            {
                                "target_lang_word": "неприятный",
                                "target_lang_sense_clarification": "о вещах, которые трудно принять"
                            },
                            {
                                "target_lang_word": "неприемлемый",
                                "target_lang_sense_clarification": "о фактах или истине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "378c6422-6f96-378b-9e98-3c4c846b9e19",
                    "sense_definition": "Unpleasant to the taste; not savory or appetizing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup was so salty and overcooked that it became completely <w>unpalatable</w>.",
                            "target_lang_translations": {
                                "ru": "Суп был настолько пересолен и переварен, что стал совершенно <w>невкусным</w>."
                            }
                        },
                        {
                            "text": "Some plants develop bitter chemicals to make their leaves <w>unpalatable</w> to insects.",
                            "target_lang_translations": {
                                "ru": "Некоторые растения вырабатывают горькие химические вещества, чтобы сделать свои листья <w>несъедобными</w> для насекомых."
                            }
                        }
                    ],
                    "synonyms": [
                        "distasteful",
                        "ill-flavored",
                        "uneatable",
                        "unpalatable",
                        "unsavory",
                        "yucky"
                    ],
                    "antonyms": [
                        "delicious"
                    ],
                    "common_phrases": [
                        "unpalatable food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятный на вкус; невкусный или неаппетитный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невкусный",
                                "target_lang_sense_clarification": "о еде"
                            },
                            {
                                "target_lang_word": "несъедобный",
                                "target_lang_sense_clarification": "из-за плохого вкуса"
                            },
                            {
                                "target_lang_word": "неаппетитный",
                                "target_lang_sense_clarification": "о пище"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41a14967-375f-3241-b02c-5ac9782d2537",
                    "sense_definition": "Anything that is distasteful, unpleasant, or difficult to tolerate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient developed an unusual craving for chalk, soil, and other <w>unpalatables</w>.",
                            "target_lang_translations": {
                                "ru": "У пациента развилась необычная тяга к мелу, почве и другим <w>несъедобным вещам</w>."
                            }
                        },
                        {
                            "text": "We must learn to face the realities of life, including all its minor <w>unpalatables</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны научиться смотреть в лицо реалиям жизни, включая все её мелкие <w>неприятности</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо неприятное, невкусное или труднопереносимое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприятные вещи",
                                "target_lang_sense_clarification": "о невкусной еде или неприятных фактах"
                            },
                            {
                                "target_lang_word": "несъедобные вещи",
                                "target_lang_sense_clarification": "о несъедобных предметах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}