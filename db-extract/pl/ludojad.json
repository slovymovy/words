                "senses": [
                    {
                        "sense_id": "9b88e551-ca27-3775-8df8-66b7d061193b",
                        "entry_id": "dad3fcdd-2a96-3871-9e39-ad5e9c1ff28b",
                        "glosses": [
                            "zwierzę jadające ludzi"
                        ],
                        "tags": [],
