        "fr-extract.jsonl": [
            {
                "entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                "word": "typographie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c79b734-232d-4850-9920-5561dd12167d",
                        "entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "tags": [
                            "plural"
                        ],
                        "form": "typographies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b959a63-e645-3c16-ac9a-b22653280398",
                        "entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "glosses": [
                            "Art d’agencer les textes avec des caractères, « types », pour l’imprimerie ou pour tout autre support."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "27209e8d-e0c1-44f4-92e3-7e5d365ecb11",
                                "sense_id": "7b959a63-e645-3c16-ac9a-b22653280398",
                                "text": "Voici, par exemple, l'anglais Baskerville (1706-1775) qui, après avoir été maître d'écriture et graveur de pierres tombales, commence en 1750 à s'occuper de typographie, passe deux ans à dessiner ses caractères et à faire graver ses poinçons et met en même temps au point un procédé de fabrication de papier satiné sans vergeûres — le papier vélin."
                            }
                        ]
                    },
                    {
                        "sense_id": "73d87432-dd91-30cc-91ff-00a75d87a442",
                        "entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "glosses": [
                            "Le résultat de cet art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d63cde7-1e8f-4ed8-9ccb-f635cb240984",
                                "sense_id": "73d87432-dd91-30cc-91ff-00a75d87a442",
                                "text": "Une belle typographie de Jérôme Peignot."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7beca37-a92f-35a6-ad87-f3d18921bacb",
                        "entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "glosses": [
                            "Technique d’impression avec des caractères et des gravures en relief. Le jargon du métier est le plomb."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "13e7278f-c129-3d32-a778-5b5df3c0683f",
                        "entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "glosses": [
                            "Grand établissement d’imprimerie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "217eb9b7-7187-4cab-ab01-184bd520c1ec",
                        "source_entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "target_lang_word": "Typographie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Typographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "232abcc8-622c-3bb6-a0fa-a53113a49eb9",
                                        "entry_id": "47697d4a-fb83-3665-bf5e-18ffdc9e1e87",
                                        "glosses": [
                                            "die Kunst des Druckens; Wissenschaft und Lehre vom reproduzierbaren Schriftbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5874ea-201f-428e-8f72-53327a8fb2b6",
                                                "sense_id": "232abcc8-622c-3bb6-a0fa-a53113a49eb9",
                                                "text": "„Ein gutes Beispiel für die praktische Relevanz von Buchstabenstatistiken ist Proskurnin (1933), der im Zusammenhang mit der staatlichen Normierung von Drucksätzen für Typographien und angesichts eines zu dieser Zeit herrschenden Mangels an Buntmetallen den ökonomischen und rationellen Einsatz von Drucktypen diskutiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05370ffc-ae6c-3ba3-8916-ef77c1ab04c8",
                                        "entry_id": "47697d4a-fb83-3665-bf5e-18ffdc9e1e87",
                                        "glosses": [
                                            "die konkrete Gestaltung eines Druckerzeugnisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a30d661-784a-4784-bf92-cb79cc7ccf6c",
                                                "sense_id": "05370ffc-ae6c-3ba3-8916-ef77c1ab04c8",
                                                "text": "„Seit dem 17. Jahrhundert kennen wir den Begriff Typographie im heutigen Sinn. Er umschreibt die Tätigkeit, die aus Schrift, Raumaufteilung, Material und Druck ein schönes Buch werden läßt.“"
                                            },
                                            {
                                                "example_id": "1784a928-f8fa-49f5-b399-c23f6666bcd3",
                                                "sense_id": "05370ffc-ae6c-3ba3-8916-ef77c1ab04c8",
                                                "text": "„Auch er hatte die schlichte Schönheit des ganzheitlichen Handwerks vor Augen und verließ sich auf die Wirkung von Typographie und in diesem Falle seiner eigenen Schriften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "673e3e86-a353-419e-ba65-fccd5f2373e8",
                        "source_entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "target_lang_word": "Typografie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Typografie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52d26c3d-3784-3518-99e2-2ad2b4c2a36a",
                                        "entry_id": "fc204de1-26bc-3f41-afa1-b5e73b6b34a7",
                                        "glosses": [
                                            "Kunst des Druckens; Wissenschaft und Lehre vom reproduzierbaren Schriftbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684b5839-eeb5-462d-8f2f-21132ef9b2be",
                                                "sense_id": "52d26c3d-3784-3518-99e2-2ad2b4c2a36a",
                                                "text": "Ein Webdesigner setzt sein Wissen über Typografie, Bildsprache und Farbgestaltung ein, um einen Webauftritt benutzerfreundlich und lesbar zu machen."
                                            },
                                            {
                                                "example_id": "5c761f39-194d-41d4-b298-a089aef4daaf",
                                                "sense_id": "52d26c3d-3784-3518-99e2-2ad2b4c2a36a",
                                                "text": "„Die Typografie gibt bei der Gestaltung von Texten unter funktionalen und ästhetischen Gesichtspunkten betreffende Richtlinien.“"
                                            },
                                            {
                                                "example_id": "c3398bfe-fdd1-4785-bb66-48a57fc98d74",
                                                "sense_id": "52d26c3d-3784-3518-99e2-2ad2b4c2a36a",
                                                "text": "„Die Kunst der Typografie besteht darin, Gestaltungsmerkmale in geeigneter Weise zu kombinieren.“"
                                            },
                                            {
                                                "example_id": "199b435d-8c1b-490f-a0e8-81c899f08ca8",
                                                "sense_id": "52d26c3d-3784-3518-99e2-2ad2b4c2a36a",
                                                "text": "„Die Ästhetik von Comics wird von ihrer Typografie bestimmt, ihren übertriebenen Formen und Farben, ihren extragroßen verbalen Klangeffekten, denen Ausrufezeichen den nötigen Wumms verleihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "541d2eaf-3803-3d2d-962e-d84571699f69",
                                        "entry_id": "fc204de1-26bc-3f41-afa1-b5e73b6b34a7",
                                        "glosses": [
                                            "konkrete Gestaltung eines Druckerzeugnisses"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff0cf6bc-68af-4843-8e98-b736bef9a74f",
                        "source_entry_id": "454999ed-f001-36f8-a667-65d156f4fb55",
                        "target_lang_word": "Schriftbild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schriftbild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e9fd771-44c2-3115-98ee-8d492f731598",
                                        "entry_id": "117f77b3-6931-39d8-b380-e6c9b7ece031",
                                        "glosses": [
                                            "Aussehen, Gestalt der Schrift/Schriftzeichen eines Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f362afc7-a2a1-455b-b511-9494259d81f2",
                                                "sense_id": "4e9fd771-44c2-3115-98ee-8d492f731598",
                                                "text": "„Ehe die Gießerei die Rechte für den Schriftguß erwirbt, wird die neue Schrift auf ein ausgewogenes Schriftbild in den verschiedenen Schriftgraden geprüft, außerdem wird die seitliche Justage, das heißt die Abstände zwischen den verschiedenen Buchstabenkombinationen kontrolliert.“"
                                            },
                                            {
                                                "example_id": "05c4bd45-1292-4cae-8611-21327dbf8138",
                                                "sense_id": "4e9fd771-44c2-3115-98ee-8d492f731598",
                                                "text": "„Das gesamte Schriftbild erscheint im Gegensatz zur Quadrata unruhiger.“"
                                            },
                                            {
                                                "example_id": "1982306c-4c27-4c76-88c7-1c982819ca53",
                                                "sense_id": "4e9fd771-44c2-3115-98ee-8d492f731598",
                                                "text": "„Dieses Beispiel wurde auch aus einem anderen Grunde gewählt: es läßt nämlich auch den Einfluß des Beschreibstoffes auf die Schriftform, einen für die Entwicklung des äußeren Schriftbildes ungemein wichtigen Faktor, überaus anschaulich erkennen.“"
                                            },
                                            {
                                                "example_id": "b447c1a2-1323-459a-80de-1f7567a1196c",
                                                "sense_id": "4e9fd771-44c2-3115-98ee-8d492f731598",
                                                "text": "„Ein Vergleich der Überschrift und der Transkription der ersten beiden Sätze mit dem Schriftbild macht schlagartig klar, welche Vielzahl von Ausspracheproblemen sich beim Erlernen des Dänischen durch Deutsche einstellen werden (…).“"
                                            },
                                            {
                                                "example_id": "1da895cb-0dd4-4b92-8069-1ae0032ea15b",
                                                "sense_id": "4e9fd771-44c2-3115-98ee-8d492f731598",
                                                "text": "„Im ursprünglichen Schriftbild tritt dieser zugehörige Vokal überhaupt nicht in Erscheinung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
