                ],
                "translations": [
                    {
                        "translation_id": "b7ce14a5-0b5c-4710-a0f4-74a1a93d4bfe",
                        "source_entry_id": "3b4988d2-df9a-3638-ab9a-807443032a6d",
                        "source_sense_id": "e15413b2-5e81-3e3a-950f-44d85f0ec88a",
                        "source_sense_description": "evenredig",
                        "target_lang_word": "proportional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proportional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9d553a-829b-38b2-ae2c-8abab761cc60",
                                        "entry_id": "983439d9-1e51-3c14-b816-7a76e08d6e1d",
                                        "glosses": [
                                            "At a constant ratio (to). Two magnitudes (numbers) are said to be proportional if the second varies in a direct relation arithmetically to the first. Symbol: ∝."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b751e01d-3275-4a1a-9c46-58f09c19d00b",
                                                "sense_id": "1a9d553a-829b-38b2-ae2c-8abab761cc60",
                                                "text": "For example, according to the gas laws, pressure is directly proportional to temperature: the quotient derived from pressure (numerator) and temperature (denominator) will be constant; however, pressure is inversely proportional to volume, meaning that the product between volume and pressure will be constant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e23a746e-b956-3e49-a54b-26b6c4b2577f",
                                        "entry_id": "983439d9-1e51-3c14-b816-7a76e08d6e1d",
                                        "glosses": [
                                            "In proportion (to), proportionate."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34215e97-f691-4e8f-b4eb-3ddfeab16384",
                                                "sense_id": "e23a746e-b956-3e49-a54b-26b6c4b2577f",
                                                "text": "This ensures consistency across your website design so that you don't end up with elements that are not adequately proportional with each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9231d535-c50b-304f-89b5-0bd9ca8ece1a",
                                        "entry_id": "983439d9-1e51-3c14-b816-7a76e08d6e1d",
                                        "glosses": [
                                            "Of a typeface, having characters with natural (non-uniform) width (in contrast to monospace typefaces)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9846839-da07-4634-8a9f-e7c231411c72",
                                                "sense_id": "9231d535-c50b-304f-89b5-0bd9ca8ece1a",
                                                "text": "A font is proportional if all characters in the font have different widths due to their various sizes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "proportional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de8e0aea-b844-374b-be53-00dee4f88332",
                                        "entry_id": "8baddfdb-7d8b-3804-8020-7214caacc4c4",
                                        "glosses": [
                                            "A proportion."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4522670b-74e8-41e8-82a3-81e40f433903",
                                                "sense_id": "de8e0aea-b844-374b-be53-00dee4f88332",
                                                "text": "It is almost superfluous to remark that the numbers attached to the elements of compounds are those of the proportionals in which they combine […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "954c10d7-2d13-47f6-b937-ac3df2c79ee5",
                        "source_entry_id": "3b4988d2-df9a-3638-ab9a-807443032a6d",
                        "source_sense_id": "e15413b2-5e81-3e3a-950f-44d85f0ec88a",
                        "source_sense_description": "evenredig",
                        "target_lang_word": "proportionnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proportionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f49c6d6d-d4e2-3faf-9e3f-b45c07cb9d2a",
                                        "entry_id": "a86060a1-d200-3e7f-aea3-a2eaeb6f3b42",
                                        "glosses": [
                                            "Qui a un rapport de proportion avec une autre chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1be33d8-68a9-4f65-9b40-fe34e2e2e354",
                                                "sense_id": "f49c6d6d-d4e2-3faf-9e3f-b45c07cb9d2a",
                                                "text": "Personne de vraiment grand, sentait-on, n’aurait eu une expression si virulente et si agressive, bien qu’en réalité Butteridge eût une taille de six pieds deux pouces (1ᵐ88) et un poids exactement proportionnel."
                                            },
                                            {
                                                "example_id": "8e6d5bff-2537-4560-9647-7bb05818d54a",
                                                "sense_id": "f49c6d6d-d4e2-3faf-9e3f-b45c07cb9d2a",
                                                "text": "Ils pensent en effet que le luxe vestimentaire est proportionnel à l'importance et à la renommée d'un individu : […]."
                                            },
                                            {
                                                "example_id": "feb8c9da-22d3-41bf-b59d-f74537291187",
                                                "sense_id": "f49c6d6d-d4e2-3faf-9e3f-b45c07cb9d2a",
                                                "text": "Gros titres suivis d'articles dont vous imaginez le contenu. La crédulité de leurs auteurs était - comme il est habituel - directement proportionnelle à leur inculture scientifique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9e3c88-4d90-3228-90d8-b96cc8cc68ce",
                                        "entry_id": "a86060a1-d200-3e7f-aea3-a2eaeb6f3b42",
                                        "glosses": [
                                            "Qui sont liés par un coefficient de proportionnalité, en parlant de deux couples de nombres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e58481f-fab1-43c9-aac1-8bb8c915f40a",
                                                "sense_id": "7f9e3c88-4d90-3228-90d8-b96cc8cc68ce",
                                                "text": "Quatre et trente ne sont pas proportionnels à vingt et six, parce que ,(20)/4=5, et ,6/(,30,)≠5,."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                        "entry_id": "a86060a1-d200-3e7f-aea3-a2eaeb6f3b42",
                                        "glosses": [
                                            "Qui a rapport à une proportion, qui est en proportion avec des quantités de même genre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb5a780-0371-4056-abd8-a2d17961b507",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Parties proportionnelles."
                                            },
                                            {
                                                "example_id": "f3143470-9e72-41c3-be3c-b1c62b86bd1f",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Lignes proportionnelles."
                                            },
                                            {
                                                "example_id": "2985093b-d3a9-46e2-b39f-808238da8802",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Quantités proportionnelles."
                                            },
                                            {
                                                "example_id": "6e2ddab7-1565-45c7-ac16-94547c5118f2",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Nombres proportionnels."
                                            },
                                            {
                                                "example_id": "35b8df29-2b33-421b-89ba-c2aaae436378",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Échelle proportionnelle."
                                            },
                                            {
                                                "example_id": "3e4106e3-8b59-4120-9a58-342622582126",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Moyenne proportionnelle : Quantité moyenne entre deux autres."
                                            },
                                            {
                                                "example_id": "970711e5-8525-49c9-acf0-26c8592105d1",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Moyenne proportionnelle arithmétique : Moitié de la somme de deux quantités inégales."
                                            },
                                            {
                                                "example_id": "f33be94b-dd81-481f-b8db-3bfba66254c9",
                                                "sense_id": "97f1f6c0-f124-3c63-93ff-cdf7ebc82136",
                                                "text": "Moyenne proportionnelle géométrique : Racine carrée du produit de deux nombres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
