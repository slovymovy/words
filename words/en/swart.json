                            },
                            {
                                "target_lang_word": "Mahd",
                                "target_lang_sense_clarification": "gemähter Streifen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "801ca1a7-ab09-3fa1-b42c-9e77469e0814",
                    "sense_definition": "To make swart, dark, or tawny; to blacken or tan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of labor under the blazing tropical sun would <w>swart</w> his skin deeply.",
                            "target_lang_translations": {
                                "de": "Jahrelange Arbeit unter der sengenden Tropensonne sollten seine Haut tief <w>bräunen</w>."
                            }
                        },
                        {
                            "text": "Strong heat and smoke began to <w>swart</w> the wooden beams above the forge.",
                            "target_lang_translations": {
                                "de": "Starke Hitze und Rauch begannen, die Holzbalken über der Schmiede zu <w>schwärzen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blacken",
                        "tan"
