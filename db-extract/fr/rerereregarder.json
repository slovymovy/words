                "senses": [
                    {
                        "sense_id": "fb2e00f1-ece7-3315-98c3-5d6bb9c60b9e",
                        "entry_id": "21a866d6-e4af-3d6b-9152-955a4e5e2491",
                        "glosses": [
                            "Regarder une quatrième fois (ou plus…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dfd8642-dc7d-449d-a40c-252156eb7bde",
                                "sense_id": "fb2e00f1-ece7-3315-98c3-5d6bb9c60b9e",
                                "text": "« Je regarde cette saga essentiellement seule, mais mon compagnon connaît mon amour pour cet univers et accepte, et même me propose parfois avec joie, de les rerereregarder avec moi ! », reprend Pauline."
                            },
                            {
                                "example_id": "bd8e7239-bef4-4990-a33c-17d577ac110c",
                                "sense_id": "fb2e00f1-ece7-3315-98c3-5d6bb9c60b9e",
                                "text": "Elles te rerereregardent, tu as l’impression d’avoir enfilé la serpillière du Père Noël est une ordure."
                            },
                            {
                                "example_id": "59d77a06-82df-4b3c-90f9-f5c90dab83cc",
                                "sense_id": "fb2e00f1-ece7-3315-98c3-5d6bb9c60b9e",
                                "text": "Au bout d’une semaine à regarder ses clips en boucle, j’en arrive encore à rester scotchée devant mon ordinateur à rerereregarder ses vidéos."
                            },
                            {
                                "example_id": "98c074cb-378f-493f-8173-bf3ecb95d2cd",
                                "sense_id": "fb2e00f1-ece7-3315-98c3-5d6bb9c60b9e",
                                "text": "En parlant de Jahash j’ai rerereregardé le film Dofus qui est juste toujours une pure merveille."
                            }
                        ]
                    }
                ],
