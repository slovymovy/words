                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a scenic ferry ride along the Danube River to reach the beautiful city of <w>Ruse</w>.",
                            "target_lang_translations": {
                                "ru": "Мы совершили живописную поездку на пароме по Дунаю, чтобы добраться до красивого города <w>Русе</w>."
                            }
                        },
                        {
                            "text": "Many historic buildings with elegant architecture can be found throughout <w>Ruse</w>.",
                            "target_lang_translations": {
                                "ru": "Множество исторических зданий с элегантной архитектурой можно найти по всему <w>Русе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Rousse",
                        "Rustchuk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Город на северо-востоке Болгарии."
                    },
                    "translations": {
