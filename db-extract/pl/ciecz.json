                        "entry_id": "0c97f7d0-8481-3a1f-9104-8c0f7169dc85",
                        "glosses": [
                            "substancja o ciekłym (pośrednim między gazowym a stałym) stanie skupienia, przyjmująca kształt zbiornika, do którego jest wprowadzona"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "681822f7-e3ad-4a7b-8511-f2a08d6937b7",
                                "sense_id": "ed70ada4-358f-37d6-8794-79aac3803e28",
                                "text": "Ciecz w tym zbiorniku to benzyna."
                            },
                            {
                                "example_id": "ef9497fd-a9b5-4eea-9c5f-61c0e62caf57",
                                "sense_id": "ed70ada4-358f-37d6-8794-79aac3803e28",
                                "text": "Temperaturę, w której ciecz zmienia się w gaz, nazywamy temperaturą wrzenia."
                            },
                            {
                                "example_id": "c6d3d204-cb68-40b6-b2df-cf7e5e3e5ce5",
                                "sense_id": "ed70ada4-358f-37d6-8794-79aac3803e28",
                                "text": "Lejka można używać między innymi wtedy, gdy trzeba przelać ciecz z jednego pojemnika do drugiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
