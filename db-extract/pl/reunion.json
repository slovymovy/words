                    {
                        "translation_id": "1eeddbb3-24db-4826-b54e-debb4d5d1d10",
                        "source_entry_id": "7599ceee-1b71-38d2-9ca6-14b708a22358",
                        "source_sense_id": "0b9e3965-3d69-34d6-a126-52feda1ac6ea",
                        "target_lang_word": "Reunion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reunion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59b01a1e-42ae-3501-8af5-bd44efbccf3d",
                                        "entry_id": "986a934e-14a7-390f-9cda-1f0472fca99e",
                                        "glosses": [
                                            "Vereinigung, Wiedervereinigung"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23adbd03-5267-4ef2-a8e1-b509f87c2389",
                                                "sense_id": "59b01a1e-42ae-3501-8af5-bd44efbccf3d",
                                                "text": "Die Reunion unserer beiden Arbeitsgruppen nach mehrjähriger Trennung gestaltete sich noch schwieriger als erwartet."
                                            },
                                            {
                                                "example_id": "8035a64f-d591-4bb5-96de-8eadb442f821",
                                                "sense_id": "59b01a1e-42ae-3501-8af5-bd44efbccf3d",
                                                "text": "Eine Reunion von Nord- und Südkorea hält Theo bis auf Weiteres für ausgeschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a79c29a5-7fb9-3779-900e-ff30170d7a3d",
                                        "entry_id": "986a934e-14a7-390f-9cda-1f0472fca99e",
                                        "glosses": [
                                            "Annexionen besonders elsässischer und lothringischer Gebiete während der zweiten Hälfte des 17. Jahrhunderts durch Ludwig XIV. von Frankreich"
                                        ],
                                        "tags": [
                                            "nur im Plural; historisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d616b21-cbe2-4fb7-a83d-2230cc1067c8",
                                                "sense_id": "a79c29a5-7fb9-3779-900e-ff30170d7a3d",
                                                "text": "„Die Verhandlungen über Straßburg und die übrigen Reunionen schleppten sich seit ihrer Verlegung von Frankfurt nach Regensburg in dem alten Schlendrian erfolglos fort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Reunion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f710aa2b-e4f6-3e54-9113-4b414179b039",
                                        "entry_id": "278d846f-a4de-3db2-bbe8-a6f982b9d527",
                                        "glosses": [
                                            "gesellige Tanzveranstaltung, die vor allem in Kurorten stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4169f25d-322c-4247-8439-4b27f4db2714",
                                                "sense_id": "f710aa2b-e4f6-3e54-9113-4b414179b039",
                                                "text": "Die gestrige Reunion im großen Saale war gut besucht."
                                            },
                                            {
                                                "example_id": "296f65b0-0bdf-45eb-b9d7-25b10e7fbfeb",
                                                "sense_id": "f710aa2b-e4f6-3e54-9113-4b414179b039",
                                                "text": "Die Reunions in diesem Kurbad sind ganz bezaubernd."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Reunion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a012dce6-11d4-3e01-9f09-65d353c421d7",
                                        "entry_id": "71aec116-c431-377e-9bae-18fecb5d9582",
                                        "glosses": [
                                            "erneutes Zusammenfinden der Mitglieder einer Musik- oder sonstigen Personengruppe nach einer früheren Auflösung dieser Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4957ef6-71d4-4ae3-8e06-ec389d9c6aa3",
                                                "sense_id": "a012dce6-11d4-3e01-9f09-65d353c421d7",
                                                "text": "„Bei der Schlussfeier der Spiele wird Beckham übrigens auch eine Rolle spielen, allerdings nicht der Spice Boy, sondern Posh Spice Victoria, die anlässlich der kurzzeitigen Reunion der Spice Girls, nun ja, singt.“"
                                            },
                                            {
                                                "example_id": "855e325a-0834-486f-8ea4-d061cc8f06d5",
                                                "sense_id": "a012dce6-11d4-3e01-9f09-65d353c421d7",
                                                "text": "„Iommi sagte der Zeitung, dass die neuen Songs mehr in Richtung des ‚alten, originalen Zeugs‘ gehen würden; ein Versprechen, das ja gerne mal bei Reunions dieser Art gegeben wird, um Fans der ersten Stunde schon vorab zu beglücken.“"
                                            },
                                            {
                                                "example_id": "9f9ca659-35f1-4004-91ed-821e5b50dcca",
                                                "sense_id": "a012dce6-11d4-3e01-9f09-65d353c421d7",
                                                "text": "„Denn als wäre ihre Reunion nicht schon genug, rücken auch zwei Lager von Fans vor der Bühne zusammen: Die Robbie-Supporter, die in ihrem Idol den ewigen Soloentertainer sehen wollen. Und die Anhänger der Viererversion von Take That […].“"
                                            },
                                            {
                                                "example_id": "cfd16dd1-abd8-4742-8986-220929a44c50",
                                                "sense_id": "a012dce6-11d4-3e01-9f09-65d353c421d7",
                                                "text": "„Bereits seit März vergangenen Jahres habe es Anzeichen für eine Reunion gegeben: Die ehemaligen Mitglieder Ben Shepherd, Kim Thayil und Matt Cameron hätten bei einem Konzert in Seattle gemeinsam auf der Bühne gestanden […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
