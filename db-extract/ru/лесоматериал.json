                ],
                "senses": [
                    {
                        "sense_id": "56bc2fc4-78c8-3d36-8c09-74cc79fc2063",
                        "entry_id": "c6ec1aaa-ce84-3e07-aecc-cd73b4a4d9e1",
                        "glosses": [
                            "материал из древесины, сохранивший её природную физическую структуру и химический состав, получаемый из поваленных деревьев, хлыстов и (или из их частей) путём поперечного и (или) продольного деления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7906f6f2-45f2-4525-9ef6-4ac48a3c87d5",
                                "sense_id": "56bc2fc4-78c8-3d36-8c09-74cc79fc2063",
                                "text": "К примеру, еловое бревно III сорта диаметром от 14 до 24 см и длиной 4 м может быть названо пиловочником, балансом, тарным или клепочным кряжем, стройлесом, лесоматериалом для радиомачт или мачт судов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84bd1877-4bf2-4fff-8fc1-4a6751273e04",
                        "source_entry_id": "c6ec1aaa-ce84-3e07-aecc-cd73b4a4d9e1",
                        "source_sense_id": "56bc2fc4-78c8-3d36-8c09-74cc79fc2063",
                        "target_lang_word": "lumber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c776bd-9f87-3b96-83fb-d211e1b402d8",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "Wood sawn into planks or otherwise prepared for sale or use, especially as a building material."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c808d1d-7ea7-49ec-aa27-ae795b5d2b11",
                                                "sense_id": "a6c776bd-9f87-3b96-83fb-d211e1b402d8",
                                                "text": "4 December 1883, Chester A. Arthur, Third State of the Union Address\nThe resources of Alaska, especially in fur, mines, and lumber, are considerable in extent and capable of large development, while its geographical situation is one of political and commercial importance.;"
                                            },
                                            {
                                                "example_id": "110c2651-f632-4380-9cdf-2bcfea30a2f8",
                                                "sense_id": "a6c776bd-9f87-3b96-83fb-d211e1b402d8",
                                                "text": "Here they live by fishing on the most plentiful coasts in the world; there they fell trees, by the sides of large rivers, for masts and lumber […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cbaf8f0-5193-3c61-acbc-c69b6d085ebc",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "Old furniture or other items that take up room, or are stored away."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34982c6-e24b-4800-8c51-79f70d933b2a",
                                                "sense_id": "8cbaf8f0-5193-3c61-acbc-c69b6d085ebc",
                                                "text": "On the ſecond day of my impriſonment, I was viſited by the duke of L⁠—⁠—, a friend of my lord, who found me ſitting upon a trunk, in a poor little dining-room filled with lumber, and lighted with two bits of tallow-candle, which had been left over night."
                                            },
                                            {
                                                "example_id": "eeb66978-759d-4a18-a993-06070aa5a87c",
                                                "sense_id": "8cbaf8f0-5193-3c61-acbc-c69b6d085ebc",
                                                "text": "We made all haste down stairs, and soon threw open the street door, for the reception of as much lumber, of all sorts, as our house would hold, brought into it by several who thought it necessary to move their furniture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf24242c-388e-3a54-b4d2-2874928425fb",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "Useless or cumbrous material."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9864abf1-4f89-4539-b43e-8f1ba0e1f8e6",
                                                "sense_id": "cf24242c-388e-3a54-b4d2-2874928425fb",
                                                "text": "The bookful blockhead ignorantly read, / With loads of learned lumber in his head,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef493906-d0ca-330d-bd29-485d5e72e685",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "A pawnbroker's shop, or room for storing articles put in pawn; hence, a pledge, or pawn."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8870379a-1e7c-41d8-9d72-f6f74cae1120",
                                                "sense_id": "ef493906-d0ca-330d-bd29-485d5e72e685",
                                                "text": "a. 1746, Lady Grisell Baillie Murray, Memoirs of the Lives and Characters of the Right Honourable George Baillie\nThey put all the little plate they had […] in the lumber, which is pawning it, till the ships came."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bff5038-7063-30cb-9dba-9f0b9d58a34a",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "A baseball bat."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17a21663-18c5-3d97-953d-4420890efac2",
                                        "entry_id": "6bda22e8-6c1d-3f9a-a382-7a0cb6dfe039",
                                        "glosses": [
                                            "An erect penis."
                                        ],
                                        "tags": [
                                            "slang",
