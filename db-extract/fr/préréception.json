                        "glosses": [
                            "Procédure par laquelle on accepte provisoirement un résultat comme conforme à la commande passée, avant la réception définitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "878cd06b-0f64-4c9d-8478-1264c624a0b7",
                                "sense_id": "d84a2fc8-7790-3491-a817-a2c5b44f6bde",
                                "text": "Une préréception a eu lieu mercredi, en présence des élus et entreprises ayant participé au projet."
                            },
                            {
                                "example_id": "f3478ed0-35fb-4ba6-8503-cd437da71691",
                                "sense_id": "d84a2fc8-7790-3491-a817-a2c5b44f6bde",
                                "text": "Le but de la préréception est d’établir la liste des travaux non exécutés ou non terminés et de définir les remèdes afin de donner toute satisfaction au maître d’ouvrage."
                            },
                            {
                                "example_id": "39fbe90a-576d-4e44-aa15-2f267a244807",
                                "sense_id": "d84a2fc8-7790-3491-a817-a2c5b44f6bde",
                                "text": "Après préréceptions et levées des réserves, les Montois peuvent donc espérer une mise en service aux alentours de la mi-novembre 2012."
                            }
                        ]
