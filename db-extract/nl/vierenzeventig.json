                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44675672-1eda-410e-b054-0b30f50fc38b",
                                "sense_id": "9e084497-6dfb-3dd7-92e6-0dfb870762ff",
                                "text": "De vierenzeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
