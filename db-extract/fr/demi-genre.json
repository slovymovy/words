                                        "entry_id": "1b6da99e-e332-3d52-b0d7-5566f16265c6",
                                        "glosses": [
                                            "Identifying partially or mostly with one gender and at the same time with another gender."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9d8780b-f377-4d67-823e-371fb930afc0",
                                                "sense_id": "5798e0df-606b-3a4a-95b6-73851aa37be5",
                                                "text": "Demigender can be a subset of bigender of multigender, but does not have to be. [...] A demigender person may identify as demifluid or demiflux; this indicates that a part of one's identity remains stable while the other part or parts are fluid."
                                            },
                                            {
                                                "example_id": "c1cd7641-1a90-4ff6-bb9f-a22bd9efe2a9",
                                                "sense_id": "5798e0df-606b-3a4a-95b6-73851aa37be5",
                                                "text": "Demigender people often identify as non-binary."
                                            },
                                            {
                                                "example_id": "c9d54809-3db6-463b-a8a1-075ed0be352f",
                                                "sense_id": "5798e0df-606b-3a4a-95b6-73851aa37be5",
                                                "text": "Examples of demigender identities include demigirl, demiboy, and demiandrogyne."
                                            }
