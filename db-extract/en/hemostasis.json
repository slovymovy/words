                        "entry_id": "3ff7bd70-294f-372f-96d2-52fb95855efb",
                        "glosses": [
                            "The process of keeping blood inside a damaged vessel to stop bleeding."
                        ],
                        "tags": [
                            "countable",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "19c727fb-eae0-441c-aff9-8d1166626ef9",
                                "sense_id": "0180827a-2d29-394a-b2bb-303f14f5cd9d",
                                "text": "A complete hemostasis is achieved with a minimal risk of injury to the trachea when using level 3 with the blunt side of the active blade."
                            }
                        ]
                    }
                ],
