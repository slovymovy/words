                "senses": [
                    {
                        "sense_id": "806a0ea1-d512-379c-882b-c1ecf5e01663",
                        "entry_id": "b297e433-913e-3ef4-93e6-8e55e85293c6",
                        "glosses": [
                            "длительное отсутствие дождя; засуха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "070cfc54-dc9c-41e8-b533-6fee98d4e260",
                                "sense_id": "806a0ea1-d512-379c-882b-c1ecf5e01663",
                                "text": "Три пары быков потянули по дороге перевёрнутый запашник, чертя затвердевшую от осеннего сухостоя и бездождья чёрствую землю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6f7c6c0-9485-4d92-be8e-5d4dcc53c912",
                        "source_entry_id": "b297e433-913e-3ef4-93e6-8e55e85293c6",
                        "source_sense_id": "806a0ea1-d512-379c-882b-c1ecf5e01663",
                        "target_lang_word": "dry spell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dry spell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "603fff91-835e-3b2b-b372-5d71f44a3387",
                                        "entry_id": "965306c9-8383-397e-8570-07ef64365cee",
                                        "glosses": [
                                            "A drawn-out period where the weather has been dry, for an abnormally long time; shorter and not as severe as a drought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b75ce5-4c77-476d-87d5-72092601fb28",
                                                "sense_id": "603fff91-835e-3b2b-b372-5d71f44a3387",
                                                "text": "Mississippi in the middle of a dry spell / Jimmy Rogers on the Victrola up high"
                                            },
                                            {
                                                "example_id": "fe05358f-418e-4944-9bd6-ad4bcf4fecbe",
                                                "sense_id": "603fff91-835e-3b2b-b372-5d71f44a3387",
                                                "text": "The rains, it seemed, were over, and a dry spell was upon them […]"
                                            },
                                            {
                                                "example_id": "002f48d5-9e0c-4912-903f-631996face8d",
                                                "sense_id": "603fff91-835e-3b2b-b372-5d71f44a3387",
                                                "text": "The only place unaffected by the persistent dry spell was the city of Milwaukee […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8daad652-67e3-3a95-8d05-54e8d2214976",
                                        "entry_id": "965306c9-8383-397e-8570-07ef64365cee",
                                        "glosses": [
                                            "A period or time where there is little activity, productivity, low income etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395a364f-6ac4-45cc-a711-49d87f4198d0",
                                                "sense_id": "8daad652-67e3-3a95-8d05-54e8d2214976",
                                                "text": "The first type is of course the dry spell when you can't think of any ideas. The second type is when kids just have a dry spell in writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c103533-8c36-3e60-84ef-1c689e0054c5",
                                        "entry_id": "965306c9-8383-397e-8570-07ef64365cee",
                                        "glosses": [
                                            "A period of time without sexual intercourse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "326d129b-cbde-4216-8529-305fb16195f5",
                                                "sense_id": "1c103533-8c36-3e60-84ef-1c689e0054c5",
                                                "text": "There's no telling when the serial dating bug can strike. You may be just getting out of a serious relationship, marriage, or long dry spell. But one thing's for certain: when it does it can become a really hard habit to break."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
