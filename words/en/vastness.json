{
    "word_family": [
        "vast",
        "vastly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "297592bc-8a96-3496-86a2-7080b6e2866b",
                    "sense_definition": "The quality or state of being immense, huge, or enormous in size or extent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vast_dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Staring up into the night sky, she was overwhelmed by the sheer <w>vastness</w> of the universe.",
                            "target_lang_translations": {
                                "ru": "Глядя в ночное небо, она была потрясена одной лишь <w>необъятностью</w> вселенной."
                            }
                        },
                        {
                            "text": "The <w>vastness</w> of the desert stretched out before them in every direction.",
                            "target_lang_translations": {
                                "ru": "<w>Бескрайность</w> пустыни простиралась перед ними во всех направлениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "immensity",
                        "enormity"
                    ],
                    "common_phrases": [
                        "sheer vastness",
                        "vastness of space"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство или состояние чего-либо огромного, безграничного по размеру или масштабу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огромность",
                                "target_lang_sense_clarification": "очень большой размер или размах"
                            },
                            {
                                "target_lang_word": "необъятность",
                                "target_lang_sense_clarification": "невозможность охватить взглядом или измерить"
                            },
                            {
                                "target_lang_word": "безграничность",
                                "target_lang_sense_clarification": "отсутствие видимых пределов"
                            },
                            {
                                "target_lang_word": "грандиозность",
                                "target_lang_sense_clarification": "величественный масштаб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9bcbc8a-4248-3285-8c0b-bdcd5f717a29",
                    "sense_definition": "An immense space, area, or expanse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vast_dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small aircraft disappeared into the icy <w>vastness</w> of the Arctic.",
                            "target_lang_translations": {
                                "ru": "Небольшой самолёт исчез в ледяных <w>просторах</w> Арктики."
                            }
                        },
                        {
                            "text": "He had a feeling that he was lost in the <w>vastness</w> of a huge forest.",
                            "target_lang_translations": {
                                "ru": "У него возникло чувство, что он затерялся в <w>шири</w> огромного леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "immensity"
                    ],
                    "common_phrases": [
                        "vastness of the ocean"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необъятное пространство, обширная территория."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просторы",
                                "target_lang_sense_clarification": "широкое, необозримое пространство"
                            },
                            {
                                "target_lang_word": "бескрайность",
                                "target_lang_sense_clarification": "пространство без конца и края"
                            },
                            {
                                "target_lang_word": "ширь",
                                "target_lang_sense_clarification": "широкое открытое пространство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}