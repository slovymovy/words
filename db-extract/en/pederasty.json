                                                "example_id": "e1f29d52-a6dc-4ca2-a792-97571cf5edc0",
                                                "sense_id": "75112bbd-7581-35fc-ba56-01ef405d4a51",
                                                "text": "Učené slovníky většinou označují slovem pederastie to, čemu v moderní sexuologii říkáme efebofilie. Je to láska k mladíkům, kteří ještě nejsou muži, ale už zdaleka nejsou dětmi."
                                            },
                                            {
                                                "example_id": "431566ba-0e07-4049-a00a-d139a4895b31",
                                                "sense_id": "75112bbd-7581-35fc-ba56-01ef405d4a51",
                                                "text": "[Antropologie sexuality se zabývá] sexuálním dimorfismem, srovnávacím výzkumem způsobů a vzorců sexuálního a erotického chování (celibát, heterosexualita, homosexualita, pederastie, promiskuita, prostituce, transsexualita, transvestitismus aj.), rituálů (sexuální mutilace aj.) a institucí (svatba, manželství aj.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05e9170-bb69-3fd8-b3b7-bdce19928098",
                                        "entry_id": "faba0e65-959b-35a7-a88f-f0737befc80d",
                                        "glosses": [
                                            "smilstvo muže s mužem"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb7c3975-4f4d-4fd5-9644-02717d26e187",
                                                "sense_id": "a05e9170-bb69-3fd8-b3b7-bdce19928098",
                                                "text": "Ani pederastie (styk osob stejného pohlaví), není v Novoměstské trestnici neznáma. Zbujnělé pohlavní pudy hledají svého ukojení způsoby často laiku neuvěřitelnými."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "426a0992-0a6a-43dd-ab1d-18eb7b75e81f",
                        "source_entry_id": "39170ff5-f813-36e3-afd4-59144292fb11",
