                                "target_senses": [
                                    {
                                        "sense_id": "fa11d0c3-6d16-34ef-bc6d-7797b457506d",
                                        "entry_id": "091871c5-e000-3813-8ca4-28033cb9ba5f",
                                        "glosses": [
                                            "Chambre particulière ou secrète dans un temple."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8651f5e8-e5bd-44ee-bf94-fb83d3668858",
                                                "sense_id": "fa11d0c3-6d16-34ef-bc6d-7797b457506d",
                                                "text": "Lorsque la porte d'entrée est à l’est, l’adytum est reculé sensiblement en arrière vers l’ouest, et il est déplacé d’une bien moins grande quantité à droite, vers le nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb76dbba-4be1-41fb-84c7-e35612a7ccde",
