                                    {
                                        "sense_id": "8ba1decf-be01-3261-b1d8-44bc97ed0e00",
                                        "entry_id": "26c8f66b-6773-30ff-9633-60ee1b38c1a6",
                                        "glosses": [
                                            "een vrouw die een vak beheerst en ook beoefent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a05eeb9-bae3-4fe3-9f40-3788dfe5c138",
                                                "sense_id": "8ba1decf-be01-3261-b1d8-44bc97ed0e00",
                                                "text": "Maar Patchett [schrijfster] is zo’n vakvrouw dat ze zelfs het dreigement van een geladen vuurwapen in een kinderhand kan inlossen op een manier die je niet verwacht en die toch bevredigend is. Op een manier die laat zien dat in het echte leven de dingen meestal niet duidelijk goed of slecht aflopen. Ze gebeuren gewoon, en dan moet je daarna maar zien wat je ervan vindt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa9e2b2a-c7b1-4b32-b498-bd3f03e91e2a",
                        "source_entry_id": "944daac4-db17-3035-af8a-ead34ccccbf8",
                        "source_sense_id": "835dd51f-7ccb-323b-9948-75cddff3b015",
                        "source_sense_description": "female artisan",
                        "target_lang_word": "Handwerkerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handwerkerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da9bd8b6-e595-3e76-bd79-edaf0bf1c5ab",
                                        "entry_id": "86e96f7c-41cc-31b1-ac14-6bd1d45d0038",
                                        "glosses": [
                                            "Frau, die beruflich ein Handwerk betreibt, auch ein Kunsthandwerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6171f053-a80e-46d0-a503-0a5e3edc79ea",
                                                "sense_id": "da9bd8b6-e595-3e76-bd79-edaf0bf1c5ab",
                                                "text": "Sie ist noch eine Handwerkerin der alten Schule."
                                            },
                                            {
                                                "example_id": "04672280-5736-4f7b-9920-babe99a8acd6",
                                                "sense_id": "da9bd8b6-e595-3e76-bd79-edaf0bf1c5ab",
                                                "text": "„Julia Bredl (32) ist in dem Handwerksbetrieb ihres Großvaters und Vaters aufgewachsen. Ihnen nachzueifern und selbst Handwerkerin zu werden, war ihr Traum.“"
                                            },
                                            {
                                                "example_id": "f1302e31-dc97-4d2d-a19e-8beb5f769b05",
                                                "sense_id": "da9bd8b6-e595-3e76-bd79-edaf0bf1c5ab",
                                                "text": "„Schlichting begann dann als Kundendiensttechnikerin bei dem Heizungsunternehmen Vaillant, als erste weibliche Handwerkerin der Unternehmensgeschichte.“"
                                            },
                                            {
                                                "example_id": "dc98b708-7c3a-4172-b58d-f93974786d29",
                                                "sense_id": "da9bd8b6-e595-3e76-bd79-edaf0bf1c5ab",
                                                "text": "„Ziel der Maßnahmen muss es sein, dass es ‚normal‘ wird, dass Handwerkerinnen auch in ‚typischen Männerberufen‘ ihrem Broterwerb nachgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
