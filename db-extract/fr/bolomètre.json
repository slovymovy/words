                        "sense_id": "6ca4d586-8906-3134-bf3e-4a45b54c304c",
                        "entry_id": "549485ca-070e-3984-91e5-bf984d8596b1",
                        "glosses": [
                            "Appareil servant à mesurer l’amplitude du rayonnement électromagnétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b05691dc-bb4e-4b39-9a8b-d2fafe025cb8",
                                "sense_id": "6ca4d586-8906-3134-bf3e-4a45b54c304c",
                                "text": "La sensibilité du récepteur a été améliorée en remplaçant le détecteur de Golay par un bolomètre au germanium dopé au gallium."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75e29e59-f613-4d4a-a8c5-915338fc211a",
                        "source_entry_id": "549485ca-070e-3984-91e5-bf984d8596b1",
                        "source_sense_id": "6ca4d586-8906-3134-bf3e-4a45b54c304c",
                        "target_lang_word": "Bolometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
