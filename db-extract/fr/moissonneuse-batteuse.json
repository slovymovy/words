                        "source_entry_id": "78ffae23-1a53-35e7-bbec-09a02c1b403c",
                        "source_sense_id": "b00aaad0-c173-319b-9f99-c18acf0c99fe",
                        "target_lang_word": "maaidorser",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maaidorser",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "550ea691-32d5-3f5e-9313-e4be8676498a",
                                        "entry_id": "17c2ee18-0635-3e47-bcf6-a43d2c8860ef",
                                        "glosses": [
                                            "een getrokken machine verder ontwikkeld tot een zelfrijdende landbouwmachine, die gebruikt wordt voor het oogsten van graangewassen, koolzaad en graszaad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cbea23d-0651-454a-9f50-464e31f07173",
                                                "sense_id": "550ea691-32d5-3f5e-9313-e4be8676498a",
                                                "text": "De verkoop van tractors is dit jaar met 15,4 procent gestegen ten opzichte van 2010. Er werden ook een kwart meer maaidorsers verkocht. Dat is zondag bekendgemaakt tijdens de afsluitende persconferentie van de landbouwbeurs Agribex, de op twee na grootste indoorbeurs van het land."
                                            },
                                            {
                                                "example_id": "51b6c64d-c152-4790-ae83-855c6f54258f",
                                                "sense_id": "550ea691-32d5-3f5e-9313-e4be8676498a",
                                                "text": "Bij oogstwerkzaamheden op een akker aan de Rekkense Binnenweg is zondagmiddag een maaidorser in brand gevlogen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94f311bd-3573-476d-af51-3608ace8eb64",
