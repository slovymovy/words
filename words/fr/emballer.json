    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29472326-0d61-358f-866d-6cfec14e3efa",
                    "sense_definition": "Envelopper un objet dans du papier ou le placer dans un contenant pour le protéger, le transporter ou l'offrir.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "conditionnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en vacances, nous devons <w>emballer</w> tous les verres avec du papier journal."
                        },
                        {
                            "text": "Elle prend son temps pour <w>emballer</w> soigneusement le cadeau d'anniversaire de son frère."
                        }
                    ],
                    "synonyms": [
                        "envelopper",
                        "paqueter"
                    ],
                    "antonyms": [
                        "déballer"
                    ],
                    "common_phrases": [
                        "emballer un cadeau",
                        "emballer soigneusement"
                    ]
                },
                {
                    "sense_id": "5efaaa1a-c1e3-3cc3-91a8-611fb3f074fa",
                    "sense_definition": "Susciter de l'enthousiasme chez quelqu'un, plaire vivement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthousiasme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle proposition de travail ne m'<w>emballe</w> pas vraiment, je préfère réfléchir encore."
                        },
                        {
                            "text": "Son projet de voyage en Islande a réussi à <w>emballer</w> toute la famille en quelques minutes."
                        }
                    ],
                    "synonyms": [
                        "enthousiasmer",
                        "ravir",
                        "séduire"
                    ],
                    "antonyms": [
                        "décevoir",
                        "refroidir"
                    ],
                    "common_phrases": [
                        "ne pas emballer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "c80f9298-51ca-3cd2-b766-c07dae31fbdb",
                    "sense_definition": "S'enthousiasmer de façon excessive ou perdre son calme et agir avec précipitation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enthousiasme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'<w>emballe</w> pas trop vite, nous devons d'abord attendre les résultats officiels de l'examen."
                        },
                        {
                            "text": "Il a tendance à s'<w>emballer</w> dès qu'on aborde un sujet politique sensible avec lui."
                        }
                    ],
                    "synonyms": [
                        "s'emporter",
                        "s'enflammer"
                    ],
                    "antonyms": [
                        "se calmer",
                        "temporiser"
                    ],
                    "common_phrases": [
                        "s'emballer trop vite"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "a413181a-d25f-388f-81e6-1160f60fb0c3",
                    "sense_definition": "S'accélérer brusquement et de manière incontrôlable, en parlant d'un mécanisme, d'un phénomène ou du cœur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acceleration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de la panique, il a senti son cœur s'<w>emballer</w> dans sa poitrine."
                        },
                        {
                            "text": "Le moteur de la vieille voiture a commencé à s'<w>emballer</w> sur la voie rapide."
                        }
                    ],
                    "synonyms": [
                        "s'accélérer"
                    ],
                    "antonyms": [
                        "ralentir"
                    ],
                    "common_phrases": [
                        "moteur qui s'emballe",
                        "cœur qui s'emballe"
                    ]
                },
                {
                    "sense_id": "8fb9396f-dc64-3a8a-a89d-3b0fb7aa91d8",
                    "sense_definition": "Séduire quelqu'un pour flirter ou pour l'embrasser.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il espérait bien <w>emballer</w> quelqu'un lors de cette soirée étudiante organisée sur le campus."
                        },
                        {
                            "text": "Mon ami a réussi à l'<w>emballer</w> dès le premier rendez-vous au cinéma."
                        }
                    ],
                    "synonyms": [
                        "draguer",
                        "pécho",
                        "séduire"
                    ],
                    "antonyms": [
                        "éconduire"
                    ],
                    "common_phrases": [
                        "emballer en soirée"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argotique et familier"
                        }
                    ]
                },
                {
                    "sense_id": "ff268c22-2572-3a65-95a8-34e228edda5b",
                    "sense_definition": "Prendre le mors aux dents et fuir sans que le cavalier puisse le retenir, en parlant d'un cheval.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acceleration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Effrayé par un coup de tonnerre soudain, le cheval a fini par s'<w>emballer</w> à travers le champ."
                        },
                        {
                            "text": "Le cavalier expérimenté a su garder son sang-froid quand sa monture s'est <w>emballée</w>."
                        }
                    ],
                    "common_phrases": [
                        "cheval qui s'emballe"
                    ]
                }
            ]
        }
    ]
