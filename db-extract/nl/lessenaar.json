                    }
                ],
                "senses": [
                    {
                        "sense_id": "cebea374-b133-3a79-86de-a3e1d0d410e8",
                        "entry_id": "ee6c69dd-6dc8-3387-aae5-9ec241877a0f",
                        "glosses": [
                            "meubel met een hellend bovenblad als overzichtelijke plaats voor een te lezen of te schrijven tekst\\nVaak is er onder het bovenblad een bergplaats. De omvang kan sterk uiteenlopen: een open kastje dat op een tafel wordt gezet, een hoog meubel dat zelf op de grond staat en in kerken en scholen kan het ook om een constructie met een zitplaats gaan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8993c38-d4a9-4df3-93aa-a45b124ae4eb",
                                "sense_id": "cebea374-b133-3a79-86de-a3e1d0d410e8",
                                "text": "Op een hete middag stapte Johnson als kersverse premier uit zijn dienstauto voor 10 Downing Street. Hij nam plaats achter de lessenaar, met de deur naar zijn ambtswoning achter zich, en hield een toespraak vol ambitie, overlopend van branie, gelardeerd met zelfvertrouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "40c2666d-f37d-3f83-8d5b-6450b9e1d8d9",
                        "entry_id": "ee6c69dd-6dc8-3387-aae5-9ec241877a0f",
                        "glosses": [
                            "standaard om bladmuziek op te plaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f20828-9d2d-4139-b75b-3c8bbc5fd9a3",
                                "sense_id": "40c2666d-f37d-3f83-8d5b-6450b9e1d8d9",
                                "text": "Hij had een stevige lessenaar die wel tegen de wind bestand was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40da66d2-5cb8-4c16-ba1d-3e70a275fcf0",
                        "source_entry_id": "ee6c69dd-6dc8-3387-aae5-9ec241877a0f",
                        "source_sense_id": "cebea374-b133-3a79-86de-a3e1d0d410e8",
                        "source_sense_description": "een standaard om bladmuziek op te plaatsen",
                        "target_lang_word": "desk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d458e83-b2fa-39c4-8906-19f5f06821b6",
                                        "entry_id": "b29dbacb-8b7f-387f-a00f-0dad12f67aeb",
                                        "glosses": [
                                            "A table, frame, or case, in past centuries usually with a sloping top but now usually with a flat top, for the use of writers and readers. It often has a drawer or repository underneath."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32e33df-40ca-4510-ab5d-98b021d951d4",
                                                "sense_id": "4d458e83-b2fa-39c4-8906-19f5f06821b6",
                                                "text": "She organized her notes neatly on her desk before starting the project."
                                            },
                                            {
                                                "example_id": "14b68097-b9f7-455d-8d32-cf5b55588ff7",
                                                "sense_id": "4d458e83-b2fa-39c4-8906-19f5f06821b6",
                                                "text": "The desk was cluttered with papers and books, making it hard to concentrate."
                                            },
                                            {
                                                "example_id": "5e2b9121-d785-4707-bfaa-7711f975f208",
                                                "sense_id": "4d458e83-b2fa-39c4-8906-19f5f06821b6",
                                                "text": "He sat at his desk for hours, trying to finish the report."
                                            },
                                            {
                                                "example_id": "28244d4b-fb59-4d11-947d-c2396e96ffe6",
                                                "sense_id": "4d458e83-b2fa-39c4-8906-19f5f06821b6",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b80a5b-95bc-3839-8d74-edc5ad39ba24",
                                        "entry_id": "b29dbacb-8b7f-387f-a00f-0dad12f67aeb",
                                        "glosses": [
                                            "A reading table or lectern to support the book from which the liturgical service is read, differing from the pulpit from which the sermon is preached; also (especially in the United States), a pulpit. Hence, used symbolically for the clerical profession."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "047ddf09-706a-35a6-9ebf-7bac0f26edca",
                                        "entry_id": "b29dbacb-8b7f-387f-a00f-0dad12f67aeb",
                                        "glosses": [
                                            "A department tasked with a particular topic or focus in certain types of businesses, such as newspapers and financial trading firms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a974d5-0ae5-477e-a920-94315869fb34",
                                                "sense_id": "047ddf09-706a-35a6-9ebf-7bac0f26edca",
                                                "text": "the city desk, the sports desk"
                                            },
                                            {
                                                "example_id": "0ff4700a-0031-43bd-93d9-7124c8f71923",
                                                "sense_id": "047ddf09-706a-35a6-9ebf-7bac0f26edca",
                                                "text": "the options desk, the equities desk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab45ede-6a74-308f-b276-ed757c41b592",
                                        "entry_id": "b29dbacb-8b7f-387f-a00f-0dad12f67aeb",
                                        "glosses": [
                                            "Ellipsis of mixing desk."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f2a0c0-42bb-44f0-ac56-f1db2e9c6f85",
                                                "sense_id": "eab45ede-6a74-308f-b276-ed757c41b592",
                                                "text": "Each aux out is connected to an effects unit and the signal is then returned into the desk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf46f2a-fafa-344f-b7d1-9302c262ed01",
                                        "entry_id": "b29dbacb-8b7f-387f-a00f-0dad12f67aeb",
                                        "glosses": [
                                            "A station for a string player in an orchestra, consisting of a chair and a music stand, or a row of such stations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a237b21-15ba-4dba-a83a-e652508cf1f6",
                                                "sense_id": "2bf46f2a-fafa-344f-b7d1-9302c262ed01",
                                                "text": "The first four desks of cellos play separate parts, making a lush, Impressionist harmony."
                                            },
                                            {
                                                "example_id": "a336c6f7-aff7-4eab-ac7b-403ffd334ef8",
                                                "sense_id": "2bf46f2a-fafa-344f-b7d1-9302c262ed01",
                                                "text": "[…]at best a competent viola player occupies a first desk, so that he may play the occasional solos for that instrument; but I have even seen this function performed by the leaderof the first violins."
                                            },
                                            {
                                                "example_id": "ea717048-8a4e-4a11-8d21-abba80382c40",
                                                "sense_id": "2bf46f2a-fafa-344f-b7d1-9302c262ed01",
                                                "text": "First desk: Lalance, chevalier de, composer; Meslay, Masson de, President of the exchequer, amateur; Blasius, Pierre, the elder, professor of music; Second desk:[…]"
                                            },
                                            {
                                                "example_id": "a35ace77-699d-4c2b-98cf-700f5bd68350",
                                                "sense_id": "2bf46f2a-fafa-344f-b7d1-9302c262ed01",
                                                "text": "Lori performed for years with the American Symphony Orchestra under Leopold Stokowski as a first-desk violinist. (She says that Stokowski was not a Russian but an Englishman named Stokes. His Russian accent varied a lot.)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "desk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37257385-4d91-3a27-b445-352e56ffde2b",
                                        "entry_id": "1edaa2f9-ac67-3854-ac26-4f0009b0032a",
                                        "glosses": [
                                            "To shut up, as in a desk; to treasure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b140dff-ec43-3dbb-984c-e61c878751a4",
                                        "entry_id": "1edaa2f9-ac67-3854-ac26-4f0009b0032a",
                                        "glosses": [
                                            "To equip with a desk or desks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d04667-9e8c-4120-9388-9d76396c67e2",
                                                "sense_id": "8b140dff-ec43-3dbb-984c-e61c878751a4",
                                                "text": "But also that the said Chapell be desked, and the windowes of our said Chapell be glased, with Stores, Ymagies, Armes, Bagies ami Cognossaunts, as is by us redily divised, and in picture delivered to the Priour of Saunt Bartilmews besid Smythfel, maistre of the works of our said Chapell;"
                                            },
                                            {
                                                "example_id": "4b9e6ed1-936d-4c04-9cc9-6fdf89b0c9de",
                                                "sense_id": "8b140dff-ec43-3dbb-984c-e61c878751a4",
                                                "text": "The teaching accommodation is to be as follows ;— Senior Mixed Department—Five rooms of equal area, four of which are each to be desked for forty scholars and one to be desked for thirty-two scholars"
                                            },
                                            {
                                                "example_id": "24579dc4-8e64-4e26-9feb-32e6fa3d6d6f",
                                                "sense_id": "8b140dff-ec43-3dbb-984c-e61c878751a4",
                                                "text": "Each row of desked benches was stepped up a step from the other until the top row of desked benches seemed to hit its high ceiling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0181dbf8-bc8f-3e37-a516-a59dcf7bf765",
                                        "entry_id": "1edaa2f9-ac67-3854-ac26-4f0009b0032a",
                                        "glosses": [
                                            "To reject (an article submitted to a newspaper or academic journal etc.) on initial receipt, without reviewing it further."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
