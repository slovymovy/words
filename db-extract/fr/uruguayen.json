                "senses": [
                    {
                        "sense_id": "230d7c4d-9903-3442-a743-c50b597551eb",
                        "entry_id": "1c589b37-7272-39ab-85a1-21bb78a9fd1b",
                        "glosses": [
                            "Ayant un rapport, un lien avec l’Uruguay, pays sud-américain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ffe7b44-90e7-41d6-b39d-2e8cddc8d184",
                                "sense_id": "230d7c4d-9903-3442-a743-c50b597551eb",
                                "text": "Eduardo Galeano (1940–2015), l’homme qui dut fuir deux dictatures, l’uruguayenne et l’argentine, et qui écrivit ce livre fameux, « Les veines ouvertes de l’Amérique latine », implacable réquisitoire montrant comment l’Espagne, le Portugal et l’Angleterre ont exploité, vampirisé, dévasté son continent natal, et comment de nos jours les États-Unis poursuivent ce pillage en grand… Eduardo Galeano, donc, adorait les textes courts, les contes brefs, les petites histoires, qu’il traquait partout, dans les conversations, l’actualité, les vieux fonds de la légende, de croyances et de sagesse populaire."
                            },
                            {
                                "example_id": "08739c21-ac12-4c50-b530-2ad6bfffe908",
                                "sense_id": "230d7c4d-9903-3442-a743-c50b597551eb",
                                "text": "Quelques lignes plus loin, l’illusion uruguayenne dissipée, l’espoir revient et il expose ses projets avec Pierre Brasseur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72a3454b-3fb6-41a2-9c2b-249867f2abbe",
                        "source_entry_id": "1c589b37-7272-39ab-85a1-21bb78a9fd1b",
                        "source_sense_id": "230d7c4d-9903-3442-a743-c50b597551eb",
                        "target_lang_word": "uruguayisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uruguayisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "510b27f5-596f-3963-820f-063041ee22ad",
                                        "entry_id": "6e3c37ca-d550-3414-8c53-a3b77d909f0f",
                                        "glosses": [
                                            "Uruguay betreffend, aus Uruguay kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4b4ae81-e6a8-4c3c-8d8c-9ee0c608c2fd",
                                                "sense_id": "510b27f5-596f-3963-820f-063041ee22ad",
                                                "text": "Der uruguayische Botschafter in Berlin residiert in der Budapester Str. 39."
