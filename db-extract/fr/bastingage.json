        "fr-extract.jsonl": [
            {
                "entry_id": "6e46e446-fefe-335b-99de-e18399ec1461",
                "word": "bastingage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f5a5a2c3-6cc2-48d7-8546-f461e7635dfc",
                        "entry_id": "6e46e446-fefe-335b-99de-e18399ec1461",
                        "tags": [
                            "plural"
                        ],
                        "form": "bastingages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb2d8891-7f8d-330c-9c98-0808974693db",
                        "entry_id": "6e46e446-fefe-335b-99de-e18399ec1461",
                        "glosses": [
                            "Parapet qu’on formait autour du pont supérieur d’un navire, avec les hamacs de l’équipage, pour se protéger de la mousqueterie et de la petite mitraille de l’ennemi."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5f71cc79-1abe-4002-95f9-1ac0ef99fccb",
                                "sense_id": "eb2d8891-7f8d-330c-9c98-0808974693db",
                                "text": "Un homme […] était appuyé sur le bastingage et paraissait insensible au spectacle qui s’offrait aux regards des passagers groupés sur le tillac."
                            },
                            {
                                "example_id": "38b5ea5d-505d-4a7a-990e-f14531be0eaf",
                                "sense_id": "eb2d8891-7f8d-330c-9c98-0808974693db",
                                "text": "Abritez-vous derrière le bastingage de bâbord!"
                            }
                        ]
                    },
                    {
                        "sense_id": "8bc58b63-400e-36a0-b2c7-01744c394116",
                        "entry_id": "6e46e446-fefe-335b-99de-e18399ec1461",
                        "glosses": [
                            "Aujourd’hui, garde-corps, parapet autour du pont supérieur d’un navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d63afa56-0973-4f6e-9cf1-e27923171861",
                                "sense_id": "8bc58b63-400e-36a0-b2c7-01744c394116",
                                "text": "Les fanaux qui garnissaient les bastingages répandaient une vive clarté sur le pont du navire."
                            },
                            {
                                "example_id": "2cfde3d4-6363-4159-9a9a-92977438d801",
                                "sense_id": "8bc58b63-400e-36a0-b2c7-01744c394116",
                                "text": "Ils se cramponnaient fortement aux râteliers des bastingages sans pouvoir échanger un seul mot."
                            },
                            {
                                "example_id": "e15c6c1d-a48a-450a-b740-226dd459f6a6",
                                "sense_id": "8bc58b63-400e-36a0-b2c7-01744c394116",
                                "text": "Ses matelots attendaient ses ordres. Soudain, une demi-douzaine d’entre eux s’étalèrent sur le pont et deux autres basculèrent par-dessus le bastingage pour piquer une tête sanglante dans la Liffey."
                            },
                            {
                                "example_id": "8255ea22-7f17-49ad-9b3a-80e7ec713f63",
                                "sense_id": "8bc58b63-400e-36a0-b2c7-01744c394116",
                                "text": "Et l’odeur de l’huile frite apportait jusqu’au bastingage où nous nous accoudions l’adieu parfumé de l’Attique."
                            },
                            {
                                "example_id": "3eaeffa8-f543-4e82-a400-0818abd4f749",
                                "sense_id": "8bc58b63-400e-36a0-b2c7-01744c394116",
                                "text": "Le lendemain soir — tout son bagage empaqueté à la hâte, tous ses papiers en règle, Jean est accoudé au bastingage d’un navire qui descend le fleuve. — En fumant sa cigarette, il regarde Saint-Louis s’éloigner."
                            }
                        ]
                    },
                    {
                        "sense_id": "80a8473f-0173-395e-b7fa-db2f380e4fb6",
                        "entry_id": "6e46e446-fefe-335b-99de-e18399ec1461",
                        "glosses": [
                            "Caisson cloisonné où l’on place les hamacs de l’équipage pendant le jour. On l’emploie surtout au pluriel pour désigner l’ensemble de ces caissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e210766-74b5-4eb2-979e-cc1e9a9b003d",
                                "sense_id": "80a8473f-0173-395e-b7fa-db2f380e4fb6",
                                "text": "Les bastingages placés sur le pont sont recouverts de toile ou de tôle pour protéger les hamacs."
                            }
                        ]
                    },
                    {
                        "sense_id": "f83e2d44-0095-3370-b046-da83701e4924",
                        "entry_id": "6e46e446-fefe-335b-99de-e18399ec1461",
                        "glosses": [
                            "Muraille d’un navire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9222def-71b5-48d1-b4c6-88f1f4e92396",
                        "source_entry_id": "6e46e446-fefe-335b-99de-e18399ec1461",
                        "target_lang_word": "Reling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6b3628-a099-3181-b490-b9bdd9d2d6a1",
                                        "entry_id": "f7912743-2868-3c19-8ba8-5ba9b17fa77d",
                                        "glosses": [
                                            "Decksgeländer des Schiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05af22e7-012f-47f5-a53f-b90ddc348e68",
                                                "sense_id": "0b6b3628-a099-3181-b490-b9bdd9d2d6a1",
                                                "text": "„In Höhe der Reling werden mehrere blanke Drähte um das gesamte Schiff gespannt.“"
                                            },
                                            {
                                                "example_id": "cf8c82ff-fcf6-495b-be67-99dc218d4670",
                                                "sense_id": "0b6b3628-a099-3181-b490-b9bdd9d2d6a1",
                                                "text": "„Red ging an die Reling und blickte auf das Meer.“"
                                            },
                                            {
                                                "example_id": "43ccfe88-69d6-41e0-966f-0658f44fd5d2",
                                                "sense_id": "0b6b3628-a099-3181-b490-b9bdd9d2d6a1",
                                                "text": "„Es war das Torpedoboot, das mit gedrosselter Maschinenleistung Position hielt und von dessen umlaufender Reling aus mit Fangleinen Lebende und Tote, die im Wasser trieben, aufgefischt wurden.“"
                                            },
                                            {
                                                "example_id": "e53b1ec5-5b25-4129-83f5-7dd5fb8aeaac",
                                                "sense_id": "0b6b3628-a099-3181-b490-b9bdd9d2d6a1",
                                                "text": "„Richard stand allein an der Reling und betrachtete lange das Land, in das er gemäß einem Kabinettsbefehl deportiert worden war.“"
                                            },
                                            {
                                                "example_id": "70cb86a1-d2d8-495e-9d4a-5b55959fbe1c",
                                                "sense_id": "0b6b3628-a099-3181-b490-b9bdd9d2d6a1",
                                                "text": "„Ich legte mir einen der Korkgürtel zurecht, die an der Reling hingen, und erwartete ungeduldig die Dunkelheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f0d03ad-9444-35f9-861d-80736345fe78",
                                        "entry_id": "f7912743-2868-3c19-8ba8-5ba9b17fa77d",
                                        "glosses": [
                                            "Grundträger zum Transport auf dem Fahrzeugdach eines Autos (zum Beispiel Fahrräder)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14fbce72-bf53-45d4-9c80-7bff849fae89",
                                                "sense_id": "3f0d03ad-9444-35f9-861d-80736345fe78",
                                                "text": "„Mit einer Reling können auf einem Fahrzeug bequem Lasten transportiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4b37332-3552-4467-bce7-b5563db2baf1",
