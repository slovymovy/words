                        "examples": [
                            {
                                "example_id": "6f8af191-8cf4-4c37-b148-a73bc7a3dd07",
                                "sense_id": "99fc19ec-6568-3b56-a530-5da9427dd069",
                                "text": "Croupignoteux falots mélangés, croûtons de manuels édulcorés, latiniseries bigoudineuses, poulets « traduction » sauce « mesure » le tout carton-farci nuancé."
                            },
                            {
                                "example_id": "2d66c717-5f51-4fff-9a2d-3ac54c956942",
                                "sense_id": "99fc19ec-6568-3b56-a530-5da9427dd069",
                                "text": "A tantôt soixantes piges, après s’être enfilé tout le boulot de vivre jusque-là, surtout quand on a commencé croupignoteux comme moi…."
                            },
                            {
                                "example_id": "e767bd5b-0818-4f40-927b-8267c1bc61db",
                                "sense_id": "99fc19ec-6568-3b56-a530-5da9427dd069",
                                "text": "— Oh ! Monsieur ! On voit bien que vous voulez remettre en état cet airial. Et un airial sans herbe, c’est un peu croupignoteux.\n — Croupignoteux ?\n — Eh bien, pas beau, raté, monsieur."
                            }
                        ]
