                    },
                    {
                        "translation_id": "c4df6374-bcb2-4610-b0d3-42c525460113",
                        "source_entry_id": "964b873a-bc57-3203-9f87-d5a63a274cb2",
                        "source_sense_description": "to speak against God or religious doctrine",
                        "target_lang_word": "lästern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lästern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6385174-9354-35a0-b200-9e94014678f4",
                                        "entry_id": "c4421c73-cd90-31e9-9d7a-ee427826c6e5",
                                        "glosses": [
                                            "durch verächtliches Gerede beleidigen (insbesondere Gott, etwas Heiliges)"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb5631b-1e97-441c-8634-6e01a2dbc6b5",
                                                "sense_id": "c6385174-9354-35a0-b200-9e94014678f4",
                                                "text": "„Kein Haar unseres Hauptes, kein Spatz am Dache fällt ohne den Willen des Herrn – sollen Menschenbrüder umsonst gefallen sein? Nein und nein und tausendmal nein! Wir würden Gott lästern, wollten wir es behaupten.“"
                                            },
                                            {
                                                "example_id": "265e17ac-c859-487a-94e1-530bb604e594",
                                                "sense_id": "c6385174-9354-35a0-b200-9e94014678f4",
                                                "text": "„Heuchlerische Duckmäuser, die unter der Last ihrer geheimen Sünden niedergebeugt einherschleichen, wagen es, ein Zeitalter zu lästern, das vielleicht das heiligste ist von allen seinen Vorgängern und Nachfolgern, ein Zeitalter, das sich opfert für die Sünden der Vergangenheit und für das Glück der Zukunft, ein Messias unter den Jahrhunderten […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e36fbff-921e-35c1-abd1-c18a42d3227a",
                                        "entry_id": "c4421c73-cd90-31e9-9d7a-ee427826c6e5",
                                        "glosses": [
                                            "subjektive und abwertende Kritik äußern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e011084e-e43f-4bed-8246-7a532011e1db",
                                                "sense_id": "8e36fbff-921e-35c1-abd1-c18a42d3227a",
                                                "text": "„Warum lästern immer alle über Angela Merkels Frisur?“"
                                            },
                                            {
                                                "example_id": "5b812879-c0c4-495d-9687-c4c01e943a4a",
                                                "sense_id": "8e36fbff-921e-35c1-abd1-c18a42d3227a",
                                                "text": "In der Mittagspause sitzen die Mitarbeiter der Abteilung täglich zusammen in der Kantine und lästern über ihren Chef."
                                            },
                                            {
                                                "example_id": "afcbaefb-0d73-4628-94d1-e44a7d0ff325",
                                                "sense_id": "8e36fbff-921e-35c1-abd1-c18a42d3227a",
                                                "text": "„»Ich bin über was Hartes gestolpert.« »Wahrscheinlich ein Grashalm«, lästert Jenny.“"
                                            },
                                            {
                                                "example_id": "d6dfa22d-1839-4ff5-b39f-eeb74fc51a5b",
                                                "sense_id": "8e36fbff-921e-35c1-abd1-c18a42d3227a",
                                                "text": "„Isabel lästert über Lea und sorgt dafür, dass Lea von den Mitschülerinnen ignoriert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
