                                        "glosses": [
                                            "rozpowszechniony w kuchni tureckiej, ormiańskiej, bułgarskiej i bałkańskiej deser z ciasta półfrancuskiego przełożonego warstwami pokrojonych orzechów (włoskich lub migdałów) z cukrem lub miodem, polewanego lukrem lub syropem i posypywanego tłuczonymi, niesolonymi orzeszkami pistacjowymi"
                                        ],
