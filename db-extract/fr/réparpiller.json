                "senses": [
                    {
                        "sense_id": "a5c46a68-618a-3238-9b30-208e673b07c4",
                        "entry_id": "b3d0a82c-aa32-36dd-9719-a55af6ea3551",
                        "glosses": [
                            "Éparpiller."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0f4f92c2-fc29-47d4-9f35-f76e10d48b05",
                                "sense_id": "a5c46a68-618a-3238-9b30-208e673b07c4",
                                "text": "[…], si au contraire, l’on craint la pluie , il faut le laisser en couches , et attendre le beau temps pour le bien faner : on le met en tas la nuit, et on le réparpille le lendemain; lorsqu'il est bien fané , on le met en meulons , […]"
                            },
                            {
                                "example_id": "87a54764-fc37-4111-8480-5008362187ee",
                                "sense_id": "a5c46a68-618a-3238-9b30-208e673b07c4",
                                "text": "[…]; et toujours les petits groupes noirs fourmillent sur la dalle blanche, se désagrègent en lignes parallèles qui évoluent, un temps, militairement, puis se remèlent et se réparpillent dans un brouhaha de bruits neutres sous les entrelacs des rais de lumière tombant des œils-de-bœuf."
                            }
                        ]
                    }
