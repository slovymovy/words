            "senses": [
                {
                    "sense_id": "38fcb551-6ec4-318b-898f-ee8cbe780df8",
                    "sense_definition": "A mammary gland, teat, or udder of a female mammal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry puppies nursed eagerly at their mother's <w>dug</w>.",
                            "target_lang_translations": {
                                "ru": "Голодные щенки жадно сосали материнский <w>сосок</w>.",
                                "de": "Die hungrigen Welpen saugten gierig an der <w>Zitze</w> ihrer Mutter."
                            }
                        },
                        {
                            "text": "The farmer checked the cow's <w>dugs</w> before starting to milk her.",
                            "target_lang_translations": {
                                "ru": "Фермер проверил <w>соски</w> коровы перед тем, как начать её доить.",
                                "de": "Der Bauer untersuchte die <w>Zitzen</w> der Kuh, bevor er mit dem Melken begann."
                            }
