                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beauty_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В сказке рассказывается про то, как жила-была <w>красная</w> девица.",
