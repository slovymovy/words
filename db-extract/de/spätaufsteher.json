                ],
                "senses": [
                    {
                        "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                        "entry_id": "d1b5050c-37e5-32f5-a0ea-f76fc27786de",
                        "glosses": [
                            "Person, die gewohnheitsmäßig später als üblich aufsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e724c7e7-48fd-4e92-999a-dfb38789b891",
                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                "text": "„Das Frühstück, welches für Frühaufsteher ab 06:30 und für Spätaufsteher bis 10:30 Uhr serviert wird, ist sehr abwechslungsreich.“"
                            },
                            {
                                "example_id": "80162f66-2e62-4ff7-9d36-f3dc878cc40e",
                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                "text": "„In Frankreich beleuchten Skigebiete Pisten bis Mitternacht, damit ‚die Spätaufsteher‚ nachts Ski fahren können.“"
                            },
                            {
                                "example_id": "a9e19bfb-ed64-4ee9-8442-24b835127e7f",
                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                "text": "„Die meisten Menschen sind laut Chronobiologie, welche die Biorhythmus-Typen untersucht, entweder Spätaufsteher oder Neutral-Typen.“"
                            },
                            {
                                "example_id": "7e5adeff-8d9f-4a13-9f8c-ea134b2cd71f",
                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                "text": "„Inder sind Spätaufsteher, so dass Du um sieben Uhr morgens zwar nicht alleine auf dem großen Gelände bist, aber die Zahl der Touristen überschaubar ist.“"
                            },
                            {
                                "example_id": "2fe51af2-e32b-4b08-8946-cfe86b5bb84c",
                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                "text": "„Je 20% verteilen sich auf die Früh- und Spätaufsteher, die übrigen 60% gehören zu einer Mischform, die häufig eine Vorliebe entweder für das frühe oder für das späte Aufstehen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
