{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9228eeec-4566-3c47-a15c-000f4348e45c",
                    "sense_definition": "A traditional saying that is widely accepted as true or wise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>adage</w> that honesty is the best policy remains relevant in modern business.",
                            "target_lang_translations": {
                                "ru": "<w>Пословица</w> о том, что честность — лучшая политика, остаётся актуальной и в современном бизнесе."
                            }
                        },
                        {
                            "text": "She often quotes the old <w>adage</w> about looking before you leap.",
                            "target_lang_translations": {
                                "ru": "Она часто цитирует старую <w>поговорку</w> «семь раз отмерь, один раз отрежь»."
                            }
                        }
                    ],
                    "synonyms": [
                        "proverb",
                        "saying",
                        "maxim"
                    ],
                    "common_phrases": [
                        "old adage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционное изречение или пословица, выражающая общепринятую мудрость или истину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пословица",
                                "target_lang_sense_clarification": "традиционное изречение с поучительным смыслом"
                            },
                            {
                                "target_lang_word": "поговорка",
                                "target_lang_sense_clarification": "устойчивое народное выражение"
                            },
                            {
                                "target_lang_word": "изречение",
                                "target_lang_sense_clarification": "мудрое высказывание, афоризм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee72bc7-a340-398a-8caa-6831fad858fc",
                    "sense_definition": "A trite or overused saying that has lost its original impact.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "saying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was filled with every tired <w>adage</w> imaginable about hard work.",
                            "target_lang_translations": {
                                "ru": "Его речь изобиловала всеми мыслимыми <w>избитыми фразами</w> о тяжёлом труде."
                            }
                        },
                        {
                            "text": "The writer avoided the common <w>adage</w> to keep his prose fresh and original.",
                            "target_lang_translations": {
                                "ru": "Писатель избегал <w>затасканных выражений</w>, чтобы сохранить свежесть и оригинальность своей прозы."
                            }
                        }
                    ],
                    "synonyms": [
                        "byword",
                        "old saw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Банальное, избитое выражение или поговорка, утратившая первоначальную выразительность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избитая истина",
                                "target_lang_sense_clarification": "банальное, всем приевшееся суждение"
                            },
                            {
                                "target_lang_word": "избитое выражение",
                                "target_lang_sense_clarification": "затасканная фраза или поговорка"
                            },
                            {
                                "target_lang_word": "штамп",
                                "target_lang_sense_clarification": "клише, шаблонная фраза"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}