                                "example_id": "ba544846-10b6-4691-a66d-5ab918fa36c4",
                                "sense_id": "a7b41f10-9a3a-3bac-941f-6ea63599637b",
                                "text": "“The trail is fresh,” continued the chief; “not more than two dews have fallen on the prints of foot and hoof”"
                            }
                        ]
