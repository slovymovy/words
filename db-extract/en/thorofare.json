                        "examples": [
                            {
                                "example_id": "7e839882-c7b4-4af9-b750-64b61a5f993d",
                                "sense_id": "ba28f1ea-aca6-3dc1-a3b9-0b03d69c2303",
                                "text": "Gaines Avenue was once a \"Quality Street\". It runs on a diagonal from Malvern Avenue, a one-time first class residential thorofare to the Missouri Pacific Tracks."
                            },
