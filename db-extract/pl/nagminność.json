                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560a713f-752d-4cdd-94ad-643230881c6f",
                                "sense_id": "ac498412-de58-3f9b-bba4-ad67e807ebeb",
                                "text": "W Internecie, w mediach, a nawet podczas homilii oburza fakt nagminności błędów językowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05065e66-10d2-4346-a2bb-f8418918c0a5",
                        "source_entry_id": "554642e9-130c-3bfa-a5ed-16c45a0ff4c9",
                        "source_sense_id": "ac498412-de58-3f9b-bba4-ad67e807ebeb",
                        "target_lang_word": "commonness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commonness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "055e5c19-cbac-3841-aa35-0665600e0c48",
                                        "entry_id": "18e2fb43-72a8-3692-bba1-7211c24f196e",
                                        "glosses": [
                                            "The quality of being common in the sense of ordinary, usual or mundane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fde53e9-09cc-4607-96e5-a953c20130c3",
                                                "sense_id": "055e5c19-cbac-3841-aa35-0665600e0c48",
                                                "text": "So she is returning to her parents, where she will work at a corner store and save up money to move to New York. The commonness is so maddening to her. Everyone moves to New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f7e2dda-c605-3377-bb81-ed731c44b8b6",
                                        "entry_id": "18e2fb43-72a8-3692-bba1-7211c24f196e",
                                        "glosses": [
                                            "The quality of being common in the sense of vulgar, coarse or low class."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ddae594-e78b-42ec-81af-9adc59e31756",
                                                "sense_id": "0f7e2dda-c605-3377-bb81-ed731c44b8b6",
                                                "text": "‘Dem wuzn’t no high muckty mucks. Dem wuz railroad hands and dey womenfolks. You ain’t usetuh folks lak dat and Ah wuz skeered you might git all mad and quit me for takin’ you ’mongst ’em […] Befo’ us got married Ah made up mah mind not tuh let you see no commonness in me.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d0bb9a-6716-46cc-bc0f-8d7b550d0b0e",
                        "source_entry_id": "554642e9-130c-3bfa-a5ed-16c45a0ff4c9",
                        "source_sense_id": "ac498412-de58-3f9b-bba4-ad67e807ebeb",
                        "target_lang_word": "high incidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3b023482-984a-4d3c-85bc-03b209d70717",
                        "source_entry_id": "554642e9-130c-3bfa-a5ed-16c45a0ff4c9",
                        "source_sense_id": "ac498412-de58-3f9b-bba4-ad67e807ebeb",
                        "target_lang_word": "Häufigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Häufigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "861fcfca-6d38-3a76-870f-aa540d8772cb",
                                        "entry_id": "3b1bb552-4696-3854-aa4e-4047971f76be",
                                        "glosses": [
                                            "die Anzahl von Ereignissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65144ed8-88ee-45aa-802f-b829469852f1",
                                                "sense_id": "861fcfca-6d38-3a76-870f-aa540d8772cb",
                                                "text": "Diese Häufigkeit blieb über die Jahre konstant."
                                            },
                                            {
                                                "example_id": "12b89626-6800-42f0-b27c-8681878f81ba",
                                                "sense_id": "861fcfca-6d38-3a76-870f-aa540d8772cb",
                                                "text": "„Bei den Päpsten finden wir die größten Häufigkeiten bei den kürzeren Regierungsdauern.“"
                                            },
                                            {
                                                "example_id": "09407081-f20c-4005-be81-84642c8b29ab",
                                                "sense_id": "861fcfca-6d38-3a76-870f-aa540d8772cb",
                                                "text": "„Im Lauf der Jahre ließ die Häufigkeit von Odeds Besuchen nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
