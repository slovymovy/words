                        "glosses": [
                            "Verbrennungsmotor, der mit verschiedenen Arten von Kraftstoffen betrieben werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205d88fe-ac54-461c-b46b-f2bdc5bcfc83",
                                "sense_id": "78f4bf73-5b00-3ece-b660-5f8032909217",
                                "text": "„Der MAN Vielstoffmotor ist in der Lage, bei gleicher Wirtschaftlichkeit alle motorisch überhaupt verwertbaren Kraftstoffe - ausgenommen sind reine Aromaten (z.B. Benzol) und Alkohole (z.B. technischer Methyl- oder Äthylakohol)- zu verarbeiten.“"
                            },
                            {
                                "example_id": "027db685-6405-45e4-a08a-e2f291fbbb46",
                                "sense_id": "78f4bf73-5b00-3ece-b660-5f8032909217",
                                "text": "„Im Rahmen der französischen Landmaschinenausstellung Sima (24. bis 28. Februar) wird John Deere nach eigenen Angaben für einen Forschungstraktor mit Vielstoffmotor eine Auszeichnung erhalten.“"
                            }
                        ],
