                                        "sense_id": "7a1bfb1b-9446-3172-ad86-32441c3b57a0",
                                        "entry_id": "49fa8426-2e72-3612-a5d5-5b7570c57981",
                                        "glosses": [
                                            "die geltenden gesellschaftlichen Regeln wahrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22f7c584-5df4-4126-8a10-0ab9bf73783e",
                                                "sense_id": "7a1bfb1b-9446-3172-ad86-32441c3b57a0",
                                                "text": "„Nur noch selten erinnerten sich diese gesitteten Westgoten an die gar nicht so feinen Anfänge.“"
