                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585b3319-619a-418c-9bdf-b310b7fabd62",
                                "sense_id": "b9ae08be-340e-3550-9396-4c2a770872b9",
                                "text": "De beide hersenhelften zijn onderling verbonden, maar kortgeleden is ontdekt dat dit bij vrouwen meestal iets meer geldt dan bij mannen. Bij vrouwen is de taakverdeling tussen de hersenhelften dan ook vaak iets minder ver doorgevoerd dan bij mannen."
                            },
                            {
                                "example_id": "c7d5801c-66e6-4897-b5e4-9b646d02930c",
                                "sense_id": "b9ae08be-340e-3550-9396-4c2a770872b9",
                                "text": "Er was vroeger een strikte taakverdeling tussen man en vrouw."
                            }
                        ]
