                                "sense_id": "da258d14-48c6-3178-b122-0e90fd786811",
                                "text": "Die Expansion als ein Typ von Transformationen wird von Hundsnurscher vorgestellt."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5725cce2-fa4d-4100-829f-ea2949fda0cd",
                        "source_entry_id": "209c7866-486f-3360-af6a-f38075574821",
                        "source_sense_id": "2ab8e9cc-c525-3ca3-ae8c-da2568d9f1f1",
