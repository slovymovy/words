                        "examples": [
                            {
                                "example_id": "2433dfca-7a9e-4976-80b7-8dc457f43fef",
                                "sense_id": "62bc46ac-df32-33ce-bfca-cea5cce8abd6",
                                "text": "„Irgendein Kamoppel hat die Gipfelbuchbox sperrangelweit offen gelassen. Das triefnasse Buch war leider teilweise gefroren und daher haben wir es hinunter zur Hanauer Hütte gebracht.“"
                            },
                            {
                                "example_id": "0ea14164-bbac-46cd-bd73-17aea0da8b78",
                                "sense_id": "62bc46ac-df32-33ce-bfca-cea5cce8abd6",
                                "text": "„Jetzt, wo alles egal ist, kann er es mir doch sagen. Ich hab ihm auch alles erzählt vorhin, ich Kamoppel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
