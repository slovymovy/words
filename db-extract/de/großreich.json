                "senses": [
                    {
                        "sense_id": "b2ab6ad9-fe83-3f26-a0bf-cb261392bbe5",
                        "entry_id": "2e0aab42-5ce0-35eb-800e-cdda85addb04",
                        "glosses": [
                            "von einem Herrscher regiertes Gebiet von beträchtlichem Ausmaß"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b8ed0227-6868-4da2-8c65-f6f02516d57e",
                                "sense_id": "b2ab6ad9-fe83-3f26-a0bf-cb261392bbe5",
                                "text": "„Nach dem Feldzug des Perserkönigs Dareios I. gegen die Skythen in den Jahren 513 und 512 v. Chr. […] pflegten die Fürsten – wohl vorsorglich – gute Kontakte zu dem Großreich im Osten.“"
                            },
                            {
                                "example_id": "1d71ee27-43ff-46ce-90b3-771bec467a30",
                                "sense_id": "b2ab6ad9-fe83-3f26-a0bf-cb261392bbe5",
                                "text": "„Von einem Großreich träumten nicht nur die Serben.“"
                            },
                            {
                                "example_id": "4a9602ea-e110-4e5f-b356-bcdc30987b2a",
                                "sense_id": "b2ab6ad9-fe83-3f26-a0bf-cb261392bbe5",
                                "text": "„Auf Babur, der sich selbst den Titel «Kaiser von Hindustan» zulegte, folgten neun weitere Mogulherrscher, die bis zur Mitte des 18. Jahrhunderts in Südasien ein Großreich errichteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
