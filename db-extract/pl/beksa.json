                    },
                    {
                        "translation_id": "f70de677-b8de-4260-817b-66906cedb994",
                        "source_entry_id": "798a92bb-be42-31e9-b6c0-0b92034e1ee1",
                        "source_sense_id": "ead5711c-1c8f-3917-aff4-25d29c2a75c3",
                        "target_lang_word": "нытик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нытик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f1721907-bf58-3e76-86b1-dc05f5295d02",
                                        "entry_id": "b3a75650-d1de-3003-b295-4acb741b3f3d",
                                        "glosses": [
                                            "разг. ноющий, всегда чем-то недовольный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7862921-55ae-4641-95ea-ab219ada0a87",
                                                "sense_id": "f1721907-bf58-3e76-86b1-dc05f5295d02",
                                                "text": "Мы ослабели, опустились, пали наконец, наше поколение всплошную состоит из неврастеников и нытиков, мы только и знаем, что толкуем об усталости и переутомлении, но виноваты в том не вы и не я: мы слишком мелки, чтобы от нашего произвола могла зависеть судьба целого поколения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e66627a8-815d-4f4e-9597-f044fe92d136",
                        "source_entry_id": "798a92bb-be42-31e9-b6c0-0b92034e1ee1",
                        "source_sense_id": "ead5711c-1c8f-3917-aff4-25d29c2a75c3",
                        "target_lang_word": "плакса",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плакса",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                        "entry_id": "60ea7023-7d4d-3733-8771-1f2cbd279f11",
                                        "glosses": [
                                            "разг. тот, кто часто, без достаточной причины плачет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1034b874-31cc-4503-b6f3-76a62bdbd9bb",
                                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                                "text": "Где были твои глаза? Плакса! Нюнил до тех пор, пока не утащили из-под его носа жены!"
                                            },
                                            {
                                                "example_id": "1b90d4a1-2800-4948-83de-0578cbe18c50",
                                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                                "text": "Ведь ничего еще не случилось, а вы грустите, будто жизнь уж кончена, прошла, пролетела. Вы просто от природы плакса."
                                            },
                                            {
                                                "example_id": "84b9b52f-a64a-4079-b94a-437803a02920",
                                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                                "text": "Герда. Я давно бы вошла… Но я заплакала. А я очень не люблю, когда видят, как я плачу. Я вовсе не плакса, поверьте мне!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
