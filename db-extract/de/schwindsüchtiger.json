                ],
                "senses": [
                    {
                        "sense_id": "b7aa8fd4-a07d-3182-b68a-926a00b174a8",
                        "entry_id": "d50128e1-53eb-3be8-8aa9-e2b4d7317db7",
                        "glosses": [
                            "Person, die an Schwindsucht leidet"
                        ],
                        "tags": [
                            "colloquial",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "a1565237-53e4-4272-b1b0-a10ffb2d23b4",
                                "sense_id": "b7aa8fd4-a07d-3182-b68a-926a00b174a8",
                                "text": "„Ich erinnerte mich an die Berichte über die Kolonie der Schwindsüchtigen, die sich in dieser gigantischen Grotte niedergelassen hatte, um an der vermeintlich heilsamen, reinen Luft der unterirdischen Welt, den gleichmäßigen Temperaturen und der friedlichen Stille zu genesen, doch die stattdessen ein merkwürdiger und grausiger Tod ereilt hatte.“"
                            },
                            {
                                "example_id": "a9ea75e1-3ea6-469c-83bd-0c4a5312fbc9",
                                "sense_id": "b7aa8fd4-a07d-3182-b68a-926a00b174a8",
                                "text": "„Außerdem wohnt ein verdammter Schwindsüchtiger namens Jackson in einer Hütte auf der anderen Seite des Hügels und schnüffelt hier viel im Schnee herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
