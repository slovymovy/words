                "senses": [
                    {
                        "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                        "entry_id": "07c90cde-7f25-338a-b4f8-bfe08a95418c",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202a1f55-c748-4f48-a30e-7c21900fbf38",
                                "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                                "text": "Frau Picasso ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b5ca3729-8b02-4971-89ed-24fc0588066d",
                                "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                                "text": "Herr Picasso wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c28bbc28-3d70-4d76-adba-074a9abdadbe",
                                "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                                "text": "Die Picassos fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "cbfa4c8e-7783-41ce-ac08-ee1d4d845e38",
                                "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                                "text": "Der Picasso trägt nie die Pullover, die die Picasso ihm strickt."
                            },
                            {
                                "example_id": "55437ed6-aada-438e-8422-d56f320a64a4",
                                "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Picasso kommt, geht der Herr Picasso.“"
                            },
                            {
                                "example_id": "dc7fc5b0-b932-4c39-9e16-ebdd5518b01e",
                                "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                                "text": "Picasso kommt und geht."
                            },
                            {
                                "example_id": "a27ca8c6-a7e3-48a7-b0a6-b73b60977178",
                                "sense_id": "b35ba259-216a-357e-872f-d5c036fa7bc0",
                                "text": "Picassos kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e86b4cca-387d-4402-8d38-434597d2088e",
