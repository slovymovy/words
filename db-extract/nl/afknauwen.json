                        "glosses": [
                            "stukje bij beetje ergens wat van afknabbelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e43c95f-4fab-4141-809a-b38cee6961da",
                                "sense_id": "9f191c71-0a02-36af-8edf-c91441d06ef3",
                                "text": "‘Ze trok hem naar het midden van de keukenvloer. Ze wikkelde een stok in een servet waarop hij kon bijten zodat hij zijn tong niet zou inslikken of afknauwen. Als de toeval abrupt kwam propte ze de kale stok tussen zijn tanden en kwam hij later weer bij met een mond vol versplinterd hout en de smaak van boomsap, en dan voelde zijn hoofd aan als een glazen pot vol oude sleutels en roestige spijkers.’"
                            }
                        ]
                    }
