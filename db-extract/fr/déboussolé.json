                                    {
                                        "sense_id": "b9171614-8b30-37d8-a084-8702e7eb29d1",
                                        "entry_id": "f4070494-fe50-3c62-afb6-378770761642",
                                        "glosses": [
                                            "geistig nicht ganz auf der Höhe seiend, nicht wissend, was zu tun ist; durcheinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b99e097-61fd-4478-bd80-94b3a230e5c6",
                                                "sense_id": "b9171614-8b30-37d8-a084-8702e7eb29d1",
                                                "text": "„Wie heißt du nochmal?“, fragte sie ihn verwirrt."
                                            },
                                            {
                                                "example_id": "a2cac568-42c0-43a2-a9b4-45d68b049e02",
                                                "sense_id": "b9171614-8b30-37d8-a084-8702e7eb29d1",
                                                "text": "Verwirrt irrte er durch die Gänge."
                                            },
                                            {
                                                "example_id": "9c756ae9-831f-4f46-bdfb-5c8e521a7dff",
                                                "sense_id": "b9171614-8b30-37d8-a084-8702e7eb29d1",
                                                "text": "„Ein deutscher Rucksacktourist zeltete 1994 im Palastgarten, ein nackter Gleitschirmflieger besuchte die Königin, ein verwirrter Mann hielt sie für seine Mutter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
