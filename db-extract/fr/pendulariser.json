                "senses": [
                    {
                        "sense_id": "cd74cae2-e0be-3896-8c91-b8628816feb9",
                        "entry_id": "97171b11-6363-3cf1-9797-61595b75d7c8",
                        "glosses": [
                            "Donner un caractère pendulaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d3c6e7-97da-4fe0-bca7-2058e69f2763",
                                "sense_id": "cd74cae2-e0be-3896-8c91-b8628816feb9",
                                "text": "Dans la mesure où la Bretagne souhaite également pendulariser des lignes, Bertrand Giraud s'interroge sur l'opportunité d'une structure transverse aux Régions permettant de lancer un marché au niveau national, et ainsi, rentabiliser la pendularisation ainsi que la création d'un atelier de maintenance spécifique."
                            },
                            {
                                "example_id": "642c860c-8946-41a0-bf33-5eca1312d318",
                                "sense_id": "cd74cae2-e0be-3896-8c91-b8628816feb9",
                                "text": "La population se « pendularise », ce qui contribue à la saturation du trafic et à l'augmentation de la pollution."
                            },
                            {
                                "example_id": "cfe7ab64-0109-4f08-950d-af64d2c814c8",
                                "sense_id": "cd74cae2-e0be-3896-8c91-b8628816feb9",
                                "text": "Parce que la voiture, c'est la solution à tout: maternité centralisée, mobilité motorisée, travail pendularisé et loisirs consommés à volonté…"
                            }
                        ]
                    }
