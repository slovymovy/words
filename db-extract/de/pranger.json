                ],
                "senses": [
                    {
                        "sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                        "entry_id": "3b38f555-a9f5-37c7-ba4c-c634e66ab902",
                        "glosses": [
                            "Holzwand mit Aussparungen für Kopf und Hände oder eine ähnlich geartete, oft nur pfahlartig als Schandsäule mit Halseisen ausgeführte Bestrafungsvorrichtung, an die eine wegen kleinerer Vergehen bestrafte Person gebunden und damit öffentlich zur Schau gestellt wurde"
                        ],
                        "tags": [
                            "ursprünglich im mittelalterlichen Recht"
                        ],
                        "examples": [
                            {
                                "example_id": "12273fcb-e928-439c-b2d8-a225dbdb0e50",
                                "sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                                "text": "In Deutschland ist der Pranger als Strafinstrument für kleinere Vergehen seit dem 12. Jahrhundert nachweisbar. In den Jahren 1848/49 wurde die Prangerstrafe hier weitgehend abgeschafft."
                            },
                            {
                                "example_id": "f211cf7d-c113-443c-87c7-8f8a3746e5a4",
                                "sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                                "text": "Eine mit dem Pranger bestrafte Person galt als ehrlos."
                            },
                            {
                                "example_id": "cb167507-c6a6-4601-bfcd-bd98366fcbd1",
                                "sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                                "text": "„Am 24. Februar 1803 wurden die Häftlinge in Bautzen tagelang an den Pranger gestellt, im kalten Winter bestimmt kein Vergnügen, da das Prangerstehen von 8 bis 16 Uhr dauerte.“"
                            },
                            {
                                "example_id": "cb51c15e-eb9c-447f-b916-bd5970fa730f",
                                "sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                                "text": "„Ebba führte den Urgroßvater gewöhnlich zum alten Pranger von Kák, dort stand er gern.“"
                            },
                            {
                                "example_id": "abe11b6f-2c9b-41be-969f-e4cdc2e29f6a",
                                "sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                                "text": "„Es ist eine Ehrenliste deutschen Geistes, deren Repräsentanten hier an den Pranger gestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6a38649-5f25-46df-82fa-ee98303d1586",
                        "source_entry_id": "3b38f555-a9f5-37c7-ba4c-c634e66ab902",
                        "source_sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                        "target_lang_word": "pillory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pillory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd1b68c-a538-3056-8a8c-999b9a0ab43e",
                                        "entry_id": "57de62a4-243a-3fdc-949d-bb6efaf728fe",
                                        "glosses": [
                                            "A framework on a post, with holes for the hands and head, used as a means of punishment and humiliation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644f35af-f4cf-4e6f-a749-1355f4ed4b59",
                                                "sense_id": "3fd1b68c-a538-3056-8a8c-999b9a0ab43e",
                                                "text": "Maires and Maceris that meanes be betwene / The Kynge and the comon to kepe the lawes / To pũnyſhen on pyleries and pynning ſtoles / Bruſterrs and bakeſters, bochers and cokes / For theſe ar mẽ on this mold þᵉ moſt harme worketh / To the pore people that percel mele byghe[...]",
                                                "translation": "Mayors and mace-bearers, the means are between / The king and the commons to see the law kept, / To punish on pillories and punishment stools / Brewers and bakers, butchers and cooks, / For these are this world's men that work the most harm / To the poor people that must buy piece-meal.",
                                                "english": "Mayors and mace-bearers, the means are between / The king and the commons to see the law kept, / To punish on pillories and punishment stools / Brewers and bakers, butchers and cooks, / For these are this world's men that work the most harm / To the poor people that must buy piece-meal."
                                            },
                                            {
                                                "example_id": "f31f9710-da0d-45ab-99fb-fb38a4eb47a8",
                                                "sense_id": "3fd1b68c-a538-3056-8a8c-999b9a0ab43e",
                                                "text": "Cros·! þou dost no trouþe ; / On a pillori· my fruit to pinne, / He haþ no spot· of Adam sinne ; / Flesch· and veines· nou fleo a-twinne, / Wherfore I· rede of routhe·:"
                                            },
                                            {
                                                "example_id": "6fa5fb25-ba8b-41e4-bb48-98ff7a0046c2",
                                                "sense_id": "3fd1b68c-a538-3056-8a8c-999b9a0ab43e",
                                                "text": "The other replied, That for ought they could ſee, the men were quiet, and ſober, and intended no body any harm ; and that there were many that Traded in their fair, that were more worthy to be put into the Cage, yea, and the Pillory too, then were the men that they had abuſed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pillory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e103550f-f051-3b7c-8576-8e26d4e3f8b0",
                                        "entry_id": "6b165dcc-b666-3f07-a7ed-13473e162aab",
                                        "glosses": [
                                            "To put in a pillory."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03e04f5c-8c6c-32b2-9834-3777cade7082",
                                        "entry_id": "6b165dcc-b666-3f07-a7ed-13473e162aab",
                                        "glosses": [
                                            "To subject to humiliation, scorn, ridicule or abuse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe962df-8344-43c7-8f39-0c731f0528c9",
                                                "sense_id": "03e04f5c-8c6c-32b2-9834-3777cade7082",
                                                "text": "Mike Sarne would end up making a celluloid disasterpiece that is to this day pilloried as one of the worst films ever made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6cf7978-eabe-3c21-aa56-3bccb0dd7b85",
                                        "entry_id": "6b165dcc-b666-3f07-a7ed-13473e162aab",
                                        "glosses": [
                                            "To criticize harshly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92733bdf-ded8-4d56-b190-75aff2634c04",
                                                "sense_id": "e6cf7978-eabe-3c21-aa56-3bccb0dd7b85",
                                                "text": "The breakthrough came through Torres who, pilloried for his miss against Manchester United a week earlier, scored his second goal of the season."
                                            },
                                            {
                                                "example_id": "19bf5632-0ad9-4869-b562-e9c0c9312367",
                                                "sense_id": "e6cf7978-eabe-3c21-aa56-3bccb0dd7b85",
                                                "text": "[T]o suggest that their mere acquaintance in any way undermines Pinker’s work would be to make the kind of ad hominem fallacy that he rightfully pillories in this book."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6204b52-a319-486b-8303-fe7c1abd557d",
                        "source_entry_id": "3b38f555-a9f5-37c7-ba4c-c634e66ab902",
                        "source_sense_id": "05279426-d975-3189-9784-3fa353c11b75",
                        "target_lang_word": "pilori",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilori",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9726b2d9-1500-3587-98a5-3da1d447f2fe",
                                        "entry_id": "94a5166e-a3b9-3e90-9a2e-d522fef0244f",
                                        "glosses": [
                                            "Roue, poteau ou pilier sur lequel on attachait un condamné pour l’exposer en public au mépris de tous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4af3fd8-2881-400a-94aa-3879b526c80f",
                                                "sense_id": "9726b2d9-1500-3587-98a5-3da1d447f2fe",
                                                "text": "Nous avons des lois de S. Louis & de plusieurs autres de nos rois, qui condamnent les blasphémateurs à être mis au pilori & à avoir la langue percée avec un fer chaud par la main du bourreau."
                                            },
                                            {
                                                "example_id": "f94ec118-da2e-43e6-81ad-af830ae4235d",
                                                "sense_id": "9726b2d9-1500-3587-98a5-3da1d447f2fe",
                                                "text": "Messieurs les sergents à verge, vous me mènerez ce drôle au pilori de la Grève, vous le battrez et vous le tournerez une heure."
                                            },
                                            {
                                                "example_id": "7d38b2e8-6445-452a-8921-3096e6ee37c1",
                                                "sense_id": "9726b2d9-1500-3587-98a5-3da1d447f2fe",
                                                "text": "Il faut dire qu’un gibet et un pilori permanent, une justice et une échelle, comme on disait alors, dressés coté à coté au milieu du pavé, ne contribuaient pas peu à faire détourner les yeux de cette place fatale."
                                            },
                                            {
                                                "example_id": "304953d9-ca16-4158-a6d1-69f9212f4dae",
                                                "sense_id": "9726b2d9-1500-3587-98a5-3da1d447f2fe",
                                                "text": "Le pilori n’était pas une bonne idée, disait Henriette, les hommes, sous prétexte d’inconduite, y mettraient toutes les jolies femmes…"
                                            },
                                            {
                                                "example_id": "888b8a3b-897a-460f-b38a-bbb1d8a52bd3",
                                                "sense_id": "9726b2d9-1500-3587-98a5-3da1d447f2fe",
                                                "text": "La Révolution abolit la peine du pilori que, quelques années plus tard, le Code pénal remplaça par celle de l’exposition. Elle-même fut abolie en 1848."
                                            },
                                            {
                                                "example_id": "3449308c-2ea3-4f7f-9b95-dfe436b84862",
                                                "sense_id": "9726b2d9-1500-3587-98a5-3da1d447f2fe",
                                                "text": "Pour un larcin, une querelle, les châtiments pleuvent : ce sont les amendes, le pilori, des coups de fouet…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb6a87c-d265-3469-8bf8-ae06c5a65f48",
                                        "entry_id": "94a5166e-a3b9-3e90-9a2e-d522fef0244f",
                                        "glosses": [
                                            "Exhibition au mépris de tous."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8400a8d-b7a2-4739-b57f-71cc560a103f",
                                                "sense_id": "dbb6a87c-d265-3469-8bf8-ae06c5a65f48",
                                                "text": "Ce fut inutile et il dut se résigner à l’humiliation de cette exhibition publique, à ce pilori paroissial."
                                            },
                                            {
                                                "example_id": "53c69083-69d6-4048-8aea-581dff563023",
                                                "sense_id": "dbb6a87c-d265-3469-8bf8-ae06c5a65f48",
                                                "text": "Cris outragés ! Sursauts d’indignation ! L’aveu récent de l’écrivain allemand Günter Grass — « Je me suis enrôlé dans une unité SS à 17 ans. Oh, pas longtemps, et sans avoir tiré un seul coup de feu. Une folie! » — lui vaut le pilori. De l’Allemagne, de la Pologne, de la République tchèque, des voix suffoquées ont appelé cette semaine au dépouillement intégral du grand homme : médailles, aura de respectabilité, titre de citoyen d’honneur de sa ville natale de Gandz (autrefois Dantzig). Qu’il largue son prix Nobel, sa plume, ses convictions. Et son tambour, un coup parti […] Au poteau, Günter Grass !"
                                            },
                                            {
                                                "example_id": "10087ddf-f2cc-4947-9f5f-3bfcd21fcf09",
                                                "sense_id": "dbb6a87c-d265-3469-8bf8-ae06c5a65f48",
                                                "text": "Personne […] n’est intervenu sur la place publique pour calmer les esprits ; on m’a laissé seul, mains liées au pilori."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pilori",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca74b1a8-5767-3994-92a2-8a1e43c5d594",
                                        "entry_id": "f8d409ff-3ad5-352e-a800-ae531a0e1137",
                                        "glosses": [
                                            "Ancien nom Megalomys desmarestii ou rat musqué de la Martinique, rongeur disparu depuis le début du XXᵉ siècle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e9e439-671d-4831-834d-1c2a7e9c7134",
                                                "sense_id": "ca74b1a8-5767-3994-92a2-8a1e43c5d594",
                                                "text": "Et je ne parle pas du rat nain, qui se fait un nid comme celui de la mésange, ni du rat de Barbarie, ni de la souris du Caire, non plus que du rat géant des Indes, ou du pilori des Antilles, qui a un mètre de long avec la queue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
