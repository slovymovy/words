                        "entry_id": "54b4247e-8744-33f7-9da1-8c5397dd182c",
                        "glosses": [
                            "Causing one to feel embittered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eedb41aa-221d-4dcc-9be1-0172a2725a0e",
                                "sense_id": "dc32a588-4f1e-3e8b-bfe4-c8c064dd1633",
                                "text": "It was a very embittering experience, the climax to what had been for Tony anger and rage with the military way of doing things."
                            },
                            {
                                "example_id": "8a1c4ac8-1633-4999-b3dc-3f597ef8b46e",
                                "sense_id": "dc32a588-4f1e-3e8b-bfe4-c8c064dd1633",
                                "text": "The more openly this despotism proclaims gain to be its end and aim, the more petty, the more hateful, the more embittering it is."
                            },
                            {
                                "example_id": "e3afc8bb-80e9-477e-bbce-4e646d6f5611",
                                "sense_id": "dc32a588-4f1e-3e8b-bfe4-c8c064dd1633",
                                "text": "It was a very embittering moment, just a few years before, he was the star to the faculty, and now they wouldn't hire him because he was black."
                            }
                        ]
                    }
