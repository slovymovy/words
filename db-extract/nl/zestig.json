                "forms": [],
                "senses": [
                    {
                        "sense_id": "05c8f1f3-6643-3715-b9a6-bf5f020283e1",
                        "entry_id": "7123355c-cfdd-38b4-9361-39bd137f7fe2",
                        "glosses": [
                            "dat wat in een (rang)ordening met 60 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac26b22-9946-4585-94a0-19fba1b74cd4",
                                "sense_id": "05c8f1f3-6643-3715-b9a6-bf5f020283e1",
                                "text": "Het is weer de zestig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "18896d03-7896-4646-9c82-75ba9c99dfb2",
                                "sense_id": "05c8f1f3-6643-3715-b9a6-bf5f020283e1",
                                "text": "Haar eenenzestigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zestig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "6827aef0-73c9-3f6e-82c3-2145803fb9bb",
                        "entry_id": "7123355c-cfdd-38b4-9361-39bd137f7fe2",
                        "glosses": [
                            "groep van 60 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37d24f1-2e6a-4d08-9f42-782dc0b81f88",
                                "sense_id": "6827aef0-73c9-3f6e-82c3-2145803fb9bb",
                                "text": "De zestig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
