                                "target_senses": [
                                    {
                                        "sense_id": "bc0c2df0-1b70-37a5-b779-36c6c72ca709",
                                        "entry_id": "f0a059b4-c9ea-3d38-b11e-7bd2c414292c",
                                        "glosses": [
                                            "A percussive keyboard musical instrument, usually ranging over seven octaves, with white and black colored keys, played by pressing these keys, causing hammers to strike strings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fdba9c-c3a1-4268-bf32-6d8748eabfdb",
                                                "sense_id": "bc0c2df0-1b70-37a5-b779-36c6c72ca709",
                                                "text": "The piano in his house takes up a lot of space."
                                            },
                                            {
                                                "example_id": "36922f3c-83c8-4132-b2f6-d96feb41bad5",
                                                "sense_id": "bc0c2df0-1b70-37a5-b779-36c6c72ca709",
                                                "text": "She has been taking lessons for many years and now plays piano very well."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c831639-d7af-323c-bad3-db39bde99028",
                                        "entry_id": "6546a7e0-668b-3991-b9f6-ebfda4ebb19a",
                                        "glosses": [
                                            "To play the piano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51b8b3d1-38d5-4d8c-b4cd-9ddc8cf600a6",
                                                "sense_id": "3c831639-d7af-323c-bad3-db39bde99028",
                                                "text": "Anyhow I pianoed to my own ear, and had no thought at that time for an audience."
                                            },
                                            {
                                                "example_id": "5c5e77a2-4137-4bf8-9183-7bf0ff8be5dc",
                                                "sense_id": "3c831639-d7af-323c-bad3-db39bde99028",
                                                "text": "Who comforted me with Madeleines and lime tea, with whipped cream in my cocoa in far off Ann Arbor while others selfishly fiddled, bassooned, pianoed only for their own ugly self-advancement!"
                                            },
                                            {
                                                "example_id": "10474e83-0ca9-4f73-b167-c339181f9c02",
                                                "sense_id": "3c831639-d7af-323c-bad3-db39bde99028",
                                                "text": "John Ashbery, Kenneth Koch, Arnold Weinstein, and others came to the house, taping their poems as I pianoed and zithered and drummed away."
                                            },
                                            {
                                                "example_id": "c1867115-430c-42e6-840a-458ed82a8065",
                                                "sense_id": "3c831639-d7af-323c-bad3-db39bde99028",
                                                "text": "We guitared and drummed and head banged and pianoed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d99874-970c-3288-88ae-c30aa5d6231d",
                                        "entry_id": "6546a7e0-668b-3991-b9f6-ebfda4ebb19a",
                                        "glosses": [
                                            "To move (the fingers) up and down on, similar to the motions of a pianist playing the piano."
                                        ],
                                        "tags": [
                                            "of or with fingers"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea165ab5-f304-49e0-95ce-2858fdfbae59",
                                                "sense_id": "b2d99874-970c-3288-88ae-c30aa5d6231d",
                                                "text": "He just stared at her, leaned back in his chair and pianoed his fingers along the tablecloth."
                                            },
                                            {
                                                "example_id": "76159a18-2cd2-47b7-ab36-5b82f51e50f7",
                                                "sense_id": "b2d99874-970c-3288-88ae-c30aa5d6231d",
                                                "text": "“Jean, it ain't right how you separated those two,” he said, and pianoed the little coffin with his fingers, tapping out his grievance."
                                            },
                                            {
                                                "example_id": "63e97000-0d4e-4934-b6d2-970239cd2368",
                                                "sense_id": "b2d99874-970c-3288-88ae-c30aa5d6231d",
                                                "text": "The superintendent pianoed his fingers on the surface of a nearby desk."
                                            },
                                            {
                                                "example_id": "c40a1ac6-4247-4142-a607-618d3e82c1ae",
                                                "sense_id": "b2d99874-970c-3288-88ae-c30aa5d6231d",
                                                "text": "Holly pianoed her fingers over her throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67da208f-1197-36bb-9ace-5717a15a107b",
                                        "entry_id": "6546a7e0-668b-3991-b9f6-ebfda4ebb19a",
                                        "glosses": [
                                            "To equip with a piano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f019ef9-280f-4cd8-b9eb-b4b8d71052d5",
                                                "sense_id": "67da208f-1197-36bb-9ace-5717a15a107b",
                                                "text": "Other buildings will also be erected and pianoed by the same architect."
                                            },
                                            {
                                                "example_id": "8b041e9f-6e54-4b12-a9ae-bf1acd953c89",
                                                "sense_id": "67da208f-1197-36bb-9ace-5717a15a107b",
                                                "text": "A tabernacle has been built, burnt, rebuilt, electric lighted, organed, pianoed, and frequently filled — all during the last two years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af3a53ad-b9aa-3600-80c4-5c695b46f029",
