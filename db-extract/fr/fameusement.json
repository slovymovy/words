                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a6190500-4855-4e42-a61e-b9c9c9c22c2c",
                                "sense_id": "b0057adf-cb0a-369f-87aa-09420cb49b3f",
                                "text": "Cela est fameusement bon. Il est fameusement bête."
                            },
                            {
                                "example_id": "6ef26015-55eb-4bcd-8020-11d31dc8dd10",
                                "sense_id": "b0057adf-cb0a-369f-87aa-09420cb49b3f",
                                "text": "Il était un peu ivre (pas autant qu’il le craignait, car il avait fameusement bu)."
                            },
                            {
                                "example_id": "36836edf-73c5-44c1-a69c-616ce4cbafa2",
                                "sense_id": "b0057adf-cb0a-369f-87aa-09420cb49b3f",
                                "text": "Le tour a été fameusement joué! Hahaha!"
                            }
                        ]
                    }
                ],
