                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b655c947-11a8-456e-a6c2-cd5cd51434a6",
                        "entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more sequent"
                    },
                    {
                        "form_id": "121151ed-6a1b-4336-b0bd-40f1e50de419",
                        "entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most sequent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de67d3af-0415-3c4b-8968-4488503761da",
                        "entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "glosses": [
                            "That comes after in time or order; subsequent."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d5231609-0ab1-4cae-8aad-9b05caed65c5",
                                "sense_id": "de67d3af-0415-3c4b-8968-4488503761da",
                                "text": "Why are your songs all wild and bitter sad\nAs funeral dirges with the orphans' cries?\nEach night since first the world was made hath had\nA sequent day to laugh it down the skies."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0c34306-444a-32ca-81b5-b85366490bf3",
                        "entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "glosses": [
                            "That follows on as a result, conclusion etc.; consequent to, on, upon."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c494593f-98e0-4311-839a-27f2d6f6a148",
                                "sense_id": "c0c34306-444a-32ca-81b5-b85366490bf3",
                                "text": "But let my Triall, be mine owne Confession: / Immediate sentence then, and sequent death, / Is all the grace I beg."
                            },
                            {
                                "example_id": "3fd3d042-8c39-431f-99ee-5c4631e87cd0",
                                "sense_id": "c0c34306-444a-32ca-81b5-b85366490bf3",
                                "text": "Maisie found herself clutched to her mother's breast and passionately sobbed and shrieked over, made the subject of a demonstration evidently sequent to some sharp passage just enacted."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ff964b6-0e29-3126-9049-9038425163a7",
                        "entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "glosses": [
                            "Recurring in succession or as a series; successive, consecutive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9912e2f0-7340-4891-ba97-265e82b99c7e",
                                "sense_id": "2ff964b6-0e29-3126-9049-9038425163a7",
                                "text": "The Gallies Haue sent a dozen sequent Messengers / This very night, at one anothers heeles: / And many of the Consuls, rais'd and met, / Are at the Dukes already."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1efb5c34-7834-490b-9f32-d1041fdad16d",
                        "source_entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "source_sense_description": "recurring in succession",
                        "target_lang_word": "после́дующий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "10635dc6-2e94-44f6-8d04-1e3beabaf430",
                        "source_entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "source_sense_description": "recurring in succession",
                        "target_lang_word": "сле́дующий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "41a6e253-87ca-486f-9dbc-547a4ddc7b20",
                        "source_entry_id": "3d0d8f91-9a9f-3061-9935-b1fe6d86e858",
                        "source_sense_description": "recurring in succession",
                        "target_lang_word": "последовательный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "последовательный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7c568fe0-7ca4-31d5-ae61-55f823caa782",
                                        "entry_id": "7b5441b0-2912-3eb0-81b3-932d6d127bda",
                                        "glosses": [
                                            "непрерывно следующий один за другим"
                                        ],
                                        "tags": [
                                            "относит."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d61d94-5800-485b-ac00-8a3b1bd73dc0",
                                                "sense_id": "7c568fe0-7ca4-31d5-ae61-55f823caa782",
                                                "text": "Кефир есть результат последовательных брожений — молочнокислого и спиртового."
                                            },
                                            {
                                                "example_id": "74ce6b5b-ea72-4e21-a966-60462d489b57",
                                                "sense_id": "7c568fe0-7ca4-31d5-ae61-55f823caa782",
                                                "text": "Сначала от быстрых, последовательных, почти слившихся ударов по клавише дрожала самая высокая яркая нота верхнего регистра, затем она резко сменялась низким раскатом баса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b8122a3-9dbc-3671-97f1-5a97563d6f62",
                                        "entry_id": "7b5441b0-2912-3eb0-81b3-932d6d127bda",
                                        "glosses": [
                                            "состоящий из объектов, следующих таким образом"
                                        ],
                                        "tags": [
                                            "относит."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a009bbc2-bc57-49b9-afb8-1574b458fb24",
                                                "sense_id": "4b8122a3-9dbc-3671-97f1-5a97563d6f62",
                                                "text": "Факт этот бросается в глаза систематику, старающемуся разместить близкие формы в последовательный ряд."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e861380-a1c3-39fe-8528-b43e4efb7495",
                                        "entry_id": "7b5441b0-2912-3eb0-81b3-932d6d127bda",
                                        "glosses": [
                                            "закономерно вытекающий из чего-либо, непротиворечивый, логически обоснованный"
                                        ],
                                        "tags": [
                                            "качеств."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d7ca3c2-7a32-4457-aa31-d58818c48662",
                                                "sense_id": "1e861380-a1c3-39fe-8528-b43e4efb7495",
                                                "text": "Только я не сумею точно воспроизвести её беспорядочную речь, торопливую и несвязную, которую должен буду заменить своим более последовательным повествованием."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9ba830f-b620-34b7-82d7-2e76db00409f",
                                        "entry_id": "7b5441b0-2912-3eb0-81b3-932d6d127bda",
                                        "glosses": [
                                            "перен. неотступно следующий чему-либо, неуклонно проводящий в жизнь что-либо"
                                        ],
                                        "tags": [
                                            "о человеке"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "844d7f0e-1e3c-4965-97e8-d5c6ac16c535",
                                                "sense_id": "d9ba830f-b620-34b7-82d7-2e76db00409f",
                                                "text": "Все исходные точки своей системы Фихте заимствовал из критической философии Канта, но переработал их своеобразно с истинно гениальной самостоятельностью, являясь куда более последовательным мыслителем, нежели его великий учитель."
                                            },
                                            {
                                                "example_id": "1f254563-d3ec-473a-91a2-004e428eb33a",
                                                "sense_id": "d9ba830f-b620-34b7-82d7-2e76db00409f",
                                                "text": "По-женски Любочка была вполне последовательна, потому что она была только женщиной и ничем другим."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd410ed-f0ce-349c-ae8a-097aed314461",
                                        "entry_id": "7b5441b0-2912-3eb0-81b3-932d6d127bda",
                                        "glosses": [
                                            "физ., техн. относящийся к соединению элементов электрической цепи, при котором все элементы связаны друг с другом так, что включающий их участок цепи не имеет ни одного узла"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0b00da0-d2ab-3aed-9140-509737f8b6a8",
                                        "entry_id": "7b5441b0-2912-3eb0-81b3-932d6d127bda",
                                        "glosses": [
                                            "радиоэл., комп. передающий информацию последовательно, побитно, один за другим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db803d2-bcb7-4bff-a53b-680180299460",
                                                "sense_id": "a0b00da0-d2ab-3aed-9140-509737f8b6a8",
                                                "text": "Последовательный интерфейс ввода-вывода."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "0de1860b-5237-343d-8149-ce6a411a4828",
                "word": "sequent",
