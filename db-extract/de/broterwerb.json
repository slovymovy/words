                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35359f21-4b05-3f9d-82fa-8f486e5b7786",
                                        "entry_id": "778971bd-980f-3e0a-b492-a59b2d0510b4",
                                        "glosses": [
                                            "Having life; alive."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d77cc5-e2c6-4379-98a3-ad295736e5cb",
                                                "sense_id": "35359f21-4b05-3f9d-82fa-8f486e5b7786",
                                                "text": "a living, breathing child"
                                            },
                                            {
                                                "example_id": "35eae9a4-2e68-41c7-84f7-92e29c789575",
                                                "sense_id": "35359f21-4b05-3f9d-82fa-8f486e5b7786",
                                                "text": "Respect for the dead does not preclude respect for the living."
                                            },
                                            {
                                                "example_id": "f276d34a-8ec9-457b-833e-a82548a5aa9a",
                                                "sense_id": "35359f21-4b05-3f9d-82fa-8f486e5b7786",
                                                "text": "It is also pertinent to note that the current obvious decline in work on holarctic hepatics most surely reflects a current obsession with cataloging and with nomenclature of the organisms—as divorced from their study as living entities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bedd94b-9966-343a-b1e9-93550e0b112f",
                                        "entry_id": "778971bd-980f-3e0a-b492-a59b2d0510b4",
                                        "glosses": [
                                            "In use or existing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e23af64-85a4-479b-8582-173635ef7ce2",
                                                "sense_id": "5bedd94b-9966-343a-b1e9-93550e0b112f",
                                                "text": "Hunanese is a living language."
                                            },
                                            {
                                                "example_id": "a7041109-c624-4ba4-b35e-301b5d41704e",
                                                "sense_id": "5bedd94b-9966-343a-b1e9-93550e0b112f",
                                                "text": "The cab pulled up in front of a tumbledown cheap ‘villa’ in an unfinished cheap neighbourhood, — the whole place a living monument of the defeat of the speculative builder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86485ca6-d188-39b0-8cd3-3491bea1e602",
                                        "entry_id": "778971bd-980f-3e0a-b492-a59b2d0510b4",
                                        "glosses": [
                                            "True to life."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b04c6f-aa93-476b-9baa-a76c18c2c694",
                                                "sense_id": "86485ca6-d188-39b0-8cd3-3491bea1e602",
                                                "text": "This is the living image of Fidel Castro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc43f769-0f9d-3752-9b85-9af30c20f5b7",
                                        "entry_id": "778971bd-980f-3e0a-b492-a59b2d0510b4",
                                        "glosses": [
                                            "Of rock or stone, existing in its original state and place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc88144-dea9-4d0c-85a5-c20213ce9e87",
                                                "sense_id": "bc43f769-0f9d-3752-9b85-9af30c20f5b7",
                                                "text": "This we followed for about five paces, when it suddenly widened out into a small chamber, about eight feet square, and hewn out of the living rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "525cd5d6-14a9-3904-ab4d-eaf1b2d9b5b9",
                                        "entry_id": "778971bd-980f-3e0a-b492-a59b2d0510b4",
                                        "glosses": [
                                            "Continually updated; not static"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d39fa2d4-a308-4945-b3fb-4e9d0ec94b75",
                                                "sense_id": "525cd5d6-14a9-3904-ab4d-eaf1b2d9b5b9",
                                                "text": "HTML is a living standard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66fc9f1-6dec-322f-8b5c-6abe327979b1",
                                        "entry_id": "778971bd-980f-3e0a-b492-a59b2d0510b4",
                                        "glosses": [
                                            "Used as an intensifier."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca56324b-3573-42ae-bdc7-ef1c28eab49a",
                                                "sense_id": "f66fc9f1-6dec-322f-8b5c-6abe327979b1",
                                                "text": "He almost beat the living daylights out of me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "living",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a87358-0d93-3c12-a1f3-06dc8f4f8f0d",
                                        "entry_id": "0a14d5a6-d366-3613-ba13-c86a76144afc",
                                        "glosses": [
                                            "The state of being alive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bfd4cb8-a83a-302a-bfb2-262dd49d2b83",
                                        "entry_id": "0a14d5a6-d366-3613-ba13-c86a76144afc",
                                        "glosses": [
                                            "Financial means; a means of maintaining life; livelihood"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b9fba67-0c3f-4235-8980-fe6a39da0f14",
                                                "sense_id": "7bfd4cb8-a83a-302a-bfb2-262dd49d2b83",
                                                "text": "it's a living"
                                            },
                                            {
                                                "example_id": "6f041436-e001-41a2-8a39-58a79b7b1bf5",
                                                "sense_id": "7bfd4cb8-a83a-302a-bfb2-262dd49d2b83",
                                                "text": "What do you do for a living?"
                                            },
                                            {
                                                "example_id": "0af9a5c3-9ff7-455e-bf52-89057b368577",
                                                "sense_id": "7bfd4cb8-a83a-302a-bfb2-262dd49d2b83",
                                                "text": "Career opportunity […] is the one who never knocks — especially not on the doors of women, who are still hooking, housewifing and hairdressing for their livings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094a4f7d-849c-3bdf-a241-cff649e4cc25",
                                        "entry_id": "0a14d5a6-d366-3613-ba13-c86a76144afc",
                                        "glosses": [
                                            "A style of life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93853d84-6592-40ea-b551-c125a45d07fc",
                                                "sense_id": "094a4f7d-849c-3bdf-a241-cff649e4cc25",
                                                "text": "plain living"
                                            },
                                            {
                                                "example_id": "8343d79c-f5b5-4994-91dc-8032eb98dfae",
                                                "sense_id": "094a4f7d-849c-3bdf-a241-cff649e4cc25",
                                                "text": "The National Brewing Company declared that the Chesapeake Bay region was the Land of Pleasant Living."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372b4146-9872-36ea-a539-df9c9325f51f",
                                        "entry_id": "0a14d5a6-d366-3613-ba13-c86a76144afc",
                                        "glosses": [
                                            "Those who are alive: living people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d24a61dc-c670-4dfd-aca7-436e7b69ad8f",
                                                "sense_id": "372b4146-9872-36ea-a539-df9c9325f51f",
                                                "text": "in the land of the living"
                                            },
                                            {
                                                "example_id": "c28c6c24-8b30-4738-8b78-dd8a8a0769e4",
                                                "sense_id": "372b4146-9872-36ea-a539-df9c9325f51f",
                                                "text": "Glad to see you're still among the living! [good-humored greeting]"
                                            },
                                            {
                                                "example_id": "a4208b5b-50dd-4c1c-b8c0-e8f0a302ede4",
                                                "sense_id": "372b4146-9872-36ea-a539-df9c9325f51f",
                                                "text": "Some say that the spirits of the departed walk among the living, though most of us do not see them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023503d6-4358-34a1-9b24-4e8a7d60671a",
                                        "entry_id": "0a14d5a6-d366-3613-ba13-c86a76144afc",
                                        "glosses": [
                                            "A position in a church (usually the Church of England) that has attached to it a source of income; an ecclesiastical benefice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2035579-7b9b-4b77-a583-31261a5e374e",
                                                "sense_id": "023503d6-4358-34a1-9b24-4e8a7d60671a",
                                                "text": "A Rectory or Parſonage, is a Spirituall liuing, compoſed of Land, Tythe, and other Oblations of the people, ſeparate or dedicate to God in any Congregation, for the ſeruice of his Church there, and for the maintenance of the Gouernour or Miniſter thereof, to vvhoſe charge the ſame is committed."
                                            },
                                            {
                                                "example_id": "07bf87fc-dcc4-4ba8-bf65-eb2467267066",
                                                "sense_id": "023503d6-4358-34a1-9b24-4e8a7d60671a",
                                                "text": "The patron of the living who had the right to nominate a particular priest might make the choice, but the living was actually granted by the local bishop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e88ab12-d071-49e4-9d65-03b2663aff92",
                        "source_entry_id": "b924dffa-ab92-3885-b84b-849733485a82",
                        "source_sense_id": "cc0a5df3-5882-3cd8-845e-bb5015415c6e",
                        "source_sense_description": "Tätigkeit, um sich den Lebensunterhalt zu sichern",
                        "target_lang_word": "breadwinning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breadwinning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21e7f4b4-a57c-33ab-94e0-188bb7c8bc2c",
                                        "entry_id": "58cfd973-b014-3457-9655-89bc6c0052f7",
                                        "glosses": [
                                            "The earning of a household's primary income."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ebe452b-b98c-45cc-96ab-81d3deb9fa2a",
                                                "sense_id": "21e7f4b4-a57c-33ab-94e0-188bb7c8bc2c",
                                                "text": "This could have occurred nowhere but in England, where men and sea interpenetrate, so to speak—the sea entering into the life of most men, and the men knowing something or everything about the sea, in the way of amusement, of travel, or of bread-winning."
                                            },
                                            {
                                                "example_id": "d993e957-bfff-4f0a-b0f3-dbcfeaac14b2",
                                                "sense_id": "21e7f4b4-a57c-33ab-94e0-188bb7c8bc2c",
                                                "text": "And the key issues that both batterers and battered women identify as triggers to battering are men's successes in breadwinning and the bedroom – the two Bs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
