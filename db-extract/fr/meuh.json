                                            {
                                                "example_id": "035384df-e728-41b6-ab37-7b8b54c0d757",
                                                "sense_id": "3a7f39e2-8555-3060-b5e8-8c993af75f96",
                                                "text": "Hij was moe van al het werk."
                                            },
                                            {
                                                "example_id": "3bab660f-411a-45b3-b35e-19c66c5ff25f",
                                                "sense_id": "3a7f39e2-8555-3060-b5e8-8c993af75f96",
                                                "text": "Ik ging er even voor zitten, ik was moe en had nog maar een halve fles water over, dit was geen moment om een foute beslissing te nemen."
                                            },
                                            {
                                                "example_id": "fe8d3af6-1879-45b5-b241-51ab97c19606",
                                                "sense_id": "3a7f39e2-8555-3060-b5e8-8c993af75f96",
                                                "text": "Je zult moe worden, misselijk, een deel van je haar verliezen ' 'Het groeit wel weer aan, Bieb,' zei papa snel, alsof dat hetgeen is waar ik me het meest druk over zou maken."
                                            },
                                            {
                                                "example_id": "dce3e3c3-a51d-41b9-a92f-7a3ecfb67b66",
                                                "sense_id": "3a7f39e2-8555-3060-b5e8-8c993af75f96",
                                                "text": "Ik merk dat ik ineens ontzettend moe ben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4edf5dae-a85a-43cd-bb5b-7fd71a792268",
                        "source_entry_id": "0faac138-ad49-3901-b00a-ba3db3e9776f",
                        "source_sense_id": "528459db-d115-3cc9-a7fa-9fefeee3d0be",
                        "target_lang_word": "муму",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "53d873a3-9bae-4783-bcce-924ffdc61c19",
                        "source_entry_id": "0faac138-ad49-3901-b00a-ba3db3e9776f",
                        "source_sense_id": "528459db-d115-3cc9-a7fa-9fefeee3d0be",
                        "target_lang_word": "му",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "му",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "13d6f7a4-5fa5-364f-ba81-d22850031312",
                                        "entry_id": "7c46cd92-28ea-334e-8377-7f4e85d46021",
                                        "glosses": [
                                            "звук издаваемый коровой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8177697-7c0d-4a3c-87aa-7fd335056a1f",
                                                "sense_id": "13d6f7a4-5fa5-364f-ba81-d22850031312",
                                                "text": "Бык рысью тронулся за мальчиками. «Му-ууу!» Виктор оглянулся, закричал, упал в снег и закрыл голову руками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab855d06-971e-3f5d-bc70-4618c4496c05",
                                        "entry_id": "7c46cd92-28ea-334e-8377-7f4e85d46021",
                                        "glosses": [
                                            "звук, напоминающий мычание коровы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de78ec5-e73e-4625-bf97-8aa8db8fa4c7",
                                                "sense_id": "ab855d06-971e-3f5d-bc70-4618c4496c05",
                                                "text": "Погодите, медведь, не ревите, Объясните, чего вы хотите? Но он только «му» да «му», А к чему, почему — Не пойму!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
