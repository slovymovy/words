                        "examples": [
                            {
                                "example_id": "38305d7c-df0f-495d-820e-80b2dc3b688b",
                                "sense_id": "abd92309-80b1-395f-9249-a729752d62d0",
                                "text": "Volgens deskundigen is hij verminderd toerekeningsvatbaar. K. zei dat hij niet weet waarom hij de inbraken pleegde. Hij zei dat hij niet op bestelling werkte. Officier van Justitie L. Grooters denkt echter dat mensen uit zijn omgeving ‘misbruik hebben gemaakt van zijn zwakbegaafdheid’."
                            },
                            {
                                "example_id": "e082b044-8a13-4cb0-a63f-ab2a073f2369",
                                "sense_id": "abd92309-80b1-395f-9249-a729752d62d0",
                                "text": "Maar de vraag is voor hoe lang nog. Het kabinet heeft aangekondigd te bezuinigen op de AWBZ, ondermeer door het criterium voor zwakbegaafdheid te verlagen. Nu geldt iemand met een IQ van 85 of lager als licht verstandelijk beperkt. Het kabinet wil dat die grens op 70 komt te liggen. De groep tussen de 70 en 85 heeft dan geen vanzelfsprekend recht meer op zorg."
                            },
                            {
                                "example_id": "f5da616f-4df1-43ed-9586-61d4c62956ee",
                                "sense_id": "abd92309-80b1-395f-9249-a729752d62d0",
                                "text": "Hij schudde het kindje regelmatig om het rustig te krijgen en kon de gevolgen door zijn zwakbegaafdheid niet goed overzien, concludeerden deskundigen."
                            }
                        ]
                    }
