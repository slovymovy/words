{
    "word_family": [
        "мерцание",
        "мерцательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "666c466e-6567-3bdb-b4cc-17793c6f2ba3",
                    "sense_definition": "Светиться неровным, прерывистым или слабым светом",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В ночном небе ярко <w>мерцали</w> далекие звезды.",
                            "target_lang_translations": {
                                "en": "Distant stars were <w>glimmering</w> brightly in the night sky."
                            }
                        },
                        {
                            "text": "На столе <w>мерцала</w> маленькая свеча, создавая уютную атмосферу.",
                            "target_lang_translations": {
                                "en": "A small candle <w>flickered</w> on the table, creating a cozy atmosphere."
                            }
                        }
                    ],
                    "synonyms": [
                        "мигать"
                    ],
                    "common_phrases": [
                        "звезды мерцают",
                        "огонек мерцает"
                    ],
                    "target_lang_definitions": {
                        "en": "To shine with a faint, unsteady, or intermittent light."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glimmer",
                                "target_lang_sense_clarification": "To shine with a faint, unsteady light."
                            },
                            {
                                "target_lang_word": "shimmer",
                                "target_lang_sense_clarification": "To shine tremulously or intermittently."
                            },
                            {
                                "target_lang_word": "flicker",
                                "target_lang_sense_clarification": "To shine with an unsteady, wavering light."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fceae73-03aa-3198-bd79-e79d88df6cc1",
                    "sense_definition": "Производить частые колебательные движения",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Реснички эпителия постоянно <w>мерцают</w>, очищая дыхательные пути.",
                            "target_lang_translations": {
                                "en": "The cilia of the epithelium constantly <w>vibrate</w>, clearing the respiratory tract."
                            }
                        },
                        {
                            "text": "Под микроскопом было видно, как <w>мерцают</w> жгутики одноклеточного организма.",
                            "target_lang_translations": {
                                "en": "Under the microscope, it was possible to see how the flagella of the single-celled organism <w>vibrated</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "вибрировать"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce frequent, small, rapid oscillatory movements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vibrate",
                                "target_lang_sense_clarification": "To move continuously and rapidly to and fro."
                            },
                            {
                                "target_lang_word": "flicker",
                                "target_lang_sense_clarification": "To move or flutter rapidly."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}