                    {
                        "sense_id": "2a3e14e1-7533-308c-8d52-288283ad5978",
                        "entry_id": "af0af426-adb4-379b-8910-0ec994c0200c",
                        "glosses": [
                            "Something or someone similarly sweet or enticing",
                            "A romantic pet name; \\\"honey\\\"."
                        ],
