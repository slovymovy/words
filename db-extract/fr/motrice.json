                                "example_id": "bf9840d6-bcbd-4c35-8463-d7003963d900",
                                "sense_id": "dbecbb42-50c4-3bfc-b4cd-c091c77c0fba",
                                "text": "Avez-vous remarqué dans certains mécanismes la petitesse de la roue motrice ?"
                            },
                            {
                                "example_id": "7150f5a8-8065-4727-ae52-8513d8be4d77",
                                "sense_id": "dbecbb42-50c4-3bfc-b4cd-c091c77c0fba",
                                "text": "Suivant l’Acad. le féminin ne s’emploie qu’adjectivement : vertu, faculté, puissance motrice."
                            }
                        ]
                    }
