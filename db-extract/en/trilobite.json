                                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                                "text": "Die Trilobiten sind wichtige Leitfossilien."
                                            },
                                            {
                                                "example_id": "b093595d-674e-405b-aee2-df8aa0f12b80",
                                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                                "text": "Trilobiten haben einen Rückenpanzer und gut entwickelte Augen."
                                            },
                                            {
                                                "example_id": "47b3592c-ef51-463d-b962-a9bd9a47e046",
                                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                                "text": "Die Trilobiten sind eine sehr charakteristische Gruppe für das Paläozoikum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
