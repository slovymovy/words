                    "frequency": "High",
                    "semantic_group_id": "genetica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wetenschappers onderzoeken of deze specifieke aandoening een <w>erfelijke</w> factor heeft.",
                            "target_lang_translations": {
                                "en": "Scientists are investigating whether this specific condition has a <w>hereditary</w> factor."
                            }
                        },
                        {
                            "text": "Er zijn veel <w>erfelijke</w> ziektes die van ouders op kinderen worden overgedragen.",
                            "target_lang_translations": {
