                "translations": [
                    {
                        "translation_id": "3b802a18-72f3-427b-86df-74409a57b232",
                        "source_entry_id": "38d8c8ca-de9b-304f-95ca-1d52ad0d3a8f",
                        "target_lang_word": "paralytic",
