                "senses": [
                    {
                        "sense_id": "52aa3b3b-ee78-38a2-8243-198301d22117",
                        "entry_id": "1c11bee9-a684-3b23-b1bf-316ea32802dd",
                        "glosses": [
                            "An instance of sharting."
                        ],
                        "tags": [
                            "colloquial",
                            "countable",
                            "uncountable",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "25d7c3c5-800d-4e53-b8ef-b138c25df4bf",
                                "sense_id": "52aa3b3b-ee78-38a2-8243-198301d22117",
                                "text": "The definition: Not a fart, not a ***, it is a wet fart, a shart."
                            },
                            {
                                "example_id": "e3c55689-a43e-4137-b74c-99f061728e07",
                                "sense_id": "52aa3b3b-ee78-38a2-8243-198301d22117",
                                "text": "The shart wasn't my finest moment, obviously. I didn't know you could shit and fart at the same time."
                            }
                        ]
                    },
