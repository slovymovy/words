                "senses": [
                    {
                        "sense_id": "6ab9f302-3005-3871-8091-e815d330864e",
                        "entry_id": "31c194d1-c0c9-3c94-8c1b-d118b22968c4",
                        "glosses": [
                            "Gewandtheit, Anmut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2243caf8-f293-44a0-be37-647d10c15c3e",
                                "sense_id": "6ab9f302-3005-3871-8091-e815d330864e",
                                "text": "Der Sprung der Badenixe vom Dreimeterbrett war voller Eleganz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "64421b55-8b92-3005-89fb-fdcb5227c5e6",
                        "entry_id": "31c194d1-c0c9-3c94-8c1b-d118b22968c4",
                        "glosses": [
                            "geschmackvolle und modische Ausstattung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ccd09d-f59f-46ca-9a9f-acd290506d7a",
                                "sense_id": "64421b55-8b92-3005-89fb-fdcb5227c5e6",
                                "text": "Die Eleganz seiner Abendgarderobe ließ nichts zu wünschen übrig."
                            },
                            {
                                "example_id": "74135122-1332-43e9-ab96-11c521bf715e",
                                "sense_id": "64421b55-8b92-3005-89fb-fdcb5227c5e6",
                                "text": "Sie kleidet sich mit lässiger Eleganz."
                            },
                            {
                                "example_id": "cf18d65a-263d-4208-907e-7b876f09d122",
                                "sense_id": "64421b55-8b92-3005-89fb-fdcb5227c5e6",
                                "text": "„Besonders von der Eleganz des Foyers und der geschwungenen Treppenhäuser waren die jungen Fotografinnen begeistert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "99053919-1ca4-39b2-8c68-e6a6d07ed947",
                        "entry_id": "31c194d1-c0c9-3c94-8c1b-d118b22968c4",
                        "glosses": [
                            "Kultiviertheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a37afbb-0ab2-418c-a5e4-c22838e2c78b",
                                "sense_id": "99053919-1ca4-39b2-8c68-e6a6d07ed947",
                                "text": "Gerade die Passage über die Rückkehr auf den elterlichen Hof ist mit brillanter Eleganz formuliert."
                            },
                            {
                                "example_id": "2ab0a7f8-1569-4475-a717-e6c0811b8adb",
                                "sense_id": "99053919-1ca4-39b2-8c68-e6a6d07ed947",
                                "text": "„Die Gesetze der Eleganz umfassten unter anderem das Deutsch-Sprechen zu Hause, auch wenn die Eckerts abstammungsmäßig näher an den Polen waren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9419fd5-3cb0-4b72-a40e-811f6fa4afbe",
                        "source_entry_id": "31c194d1-c0c9-3c94-8c1b-d118b22968c4",
                        "source_sense_id": "6ab9f302-3005-3871-8091-e815d330864e",
