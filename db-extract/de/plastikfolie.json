                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ed15c8b-afb1-328a-ac40-30d058fb7a82",
                        "entry_id": "0a3246de-ed13-322a-9739-5fe2e2530692",
                        "glosses": [
                            "Folie aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e986cb8-7af3-43fc-b346-7501ba47615a",
                                "sense_id": "8ed15c8b-afb1-328a-ac40-30d058fb7a82",
                                "text": "Plastikfolie zersetzt sich erst nach Jahrhunderten."
                            },
                            {
                                "example_id": "ef081b97-5313-472e-9a46-a0c73da9d4ac",
                                "sense_id": "8ed15c8b-afb1-328a-ac40-30d058fb7a82",
                                "text": "„Die Spurensicherung hielt es nicht für nötig, sie mit Plastikfolie oder einem Zelt zu verdecken, denn tatsächlich sah man sie erst, wenn man schon ganz am Ende des Felsens angekommen war.“"
                            },
                            {
                                "example_id": "a75e36e1-38ed-4223-9d61-88c6256956b6",
                                "sense_id": "8ed15c8b-afb1-328a-ac40-30d058fb7a82",
                                "text": "„Papas blauer Mantel hing in Plastikfolie eingepackt da und wartete auf mich.“"
                            },
                            {
                                "example_id": "65dca899-6935-4303-88b8-f3ba1712515d",
                                "sense_id": "8ed15c8b-afb1-328a-ac40-30d058fb7a82",
                                "text": "„Ein hoher Stapel Heuballen in weißer Plastikfolie steht an der Scheunenwand wie eine Festungsmauer, die gegen einen langen Winter errichtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
