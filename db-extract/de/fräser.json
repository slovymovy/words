                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c9f68fb-d226-396f-a9d0-68ff6e2880fd",
                        "entry_id": "38c4a495-caac-3b6c-905e-5a91903c541f",
                        "glosses": [
                            "Facharbeiter, der eine Fräsmaschine bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a3bde9-f9e0-4a8f-b3ec-4e451edfabcc",
                                "sense_id": "6c9f68fb-d226-396f-a9d0-68ff6e2880fd",
                                "text": "Der Zerspanungsmechaniker übernimmt heute die Aufgaben, welche der Fräser früher innehatte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad0e5188-3b1b-4148-9339-cca24737a3c6",
                        "source_entry_id": "38c4a495-caac-3b6c-905e-5a91903c541f",
                        "source_sense_id": "08c6b8e8-3174-3410-9b5b-4f71d7347752",
