                "senses": [
                    {
                        "sense_id": "aab1218f-c930-3200-975f-4a01178d4688",
                        "entry_id": "b9b68600-f312-3710-a347-7e0a4015ebfa",
                        "glosses": [
                            "Femme dont l’occupation est de remailler les vêtements et même autrefois des bas et des collants à la main, avec une aiguille à remailler, puis plus tard avec une machine à remailler. Stoppeuse. (Note : à l'époque où ce métier se pratiquait, il était exclusivement féminin.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271fe873-7382-468e-88ab-ada9e6b49f46",
                                "sense_id": "aab1218f-c930-3200-975f-4a01178d4688",
                                "text": "Et il y avait du travail pour tous : bonnetiers, mécaniciens, rebrousseurs, formeuses, remailleuses, visiteuses, chacun, homme ou femme, pouvant y trouver un poste correspondant à sa condition et à ses capacités."
                            },
                            {
                                "example_id": "bc42c339-223d-4475-a228-4ed52e1f9cff",
                                "sense_id": "aab1218f-c930-3200-975f-4a01178d4688",
                                "text": "L'entrée s'ouvrait entre deux vitrines, animées par une remailleuse de bas et une stoppeuse travaillant sous la lumière électrique."
                            }
                        ]
                    },
                    {
                        "sense_id": "a90805ba-6860-3eaf-b8e5-27c86e24ff5c",
                        "entry_id": "b9b68600-f312-3710-a347-7e0a4015ebfa",
                        "glosses": [
                            "Femme qui répare les filets de pêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad037f5-e2d3-47de-9553-ef1bc6e9d95b",
                                "sense_id": "a90805ba-6860-3eaf-b8e5-27c86e24ff5c",
                                "text": "Elle se dépêchait, se dépêchait, il y avait une remailleuse qui venait lui aider, elle se dépêchait à faire les filets. Mon père allait caler le soir, le lendemain sur le quai, il y en avait encore autant !"
                            }
                        ]
                    },
                    {
                        "sense_id": "30e98e66-bc0e-333e-b7d2-8b296d945cca",
                        "entry_id": "b9b68600-f312-3710-a347-7e0a4015ebfa",
                        "glosses": [
                            "Machine à remailler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "215e19cc-24e3-4154-ae08-f725f0155a52",
                                "sense_id": "30e98e66-bc0e-333e-b7d2-8b296d945cca",
                                "text": "De grandes photos en toile de fond, avec les machines fournies par Héliot, en premier plan : une sur jeteuse, une Inspectomatic, une remailleuse, sur lesquelles travailleront trois ouvrières, séparées par des tableaux bourrés de chiffres donnant une idée de la complexité de la mécanique et des cadence de production."
                            }
                        ]
                    }
