                "senses": [
                    {
                        "sense_id": "f047bdd0-b5c6-34cb-a8e2-ff2fb7eaca89",
                        "entry_id": "5af51c81-a058-3f2f-ad9a-6790e547a830",
                        "glosses": [
                            "Action de rayer ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c03a31ff-302a-4ede-9268-0d3f83c00389",
                                "sense_id": "f047bdd0-b5c6-34cb-a8e2-ff2fb7eaca89",
                                "text": "Le rayage d'une galette des rois lui donne toute son originalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf5c5fd7-9470-30d2-8d37-462346a1f0ef",
                        "entry_id": "5af51c81-a058-3f2f-ad9a-6790e547a830",
                        "glosses": [
                            "Action de créer des rainures hélicoïdales à l'intérieur du canon d'une arme à feu"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0842eec6-a06a-4945-9490-f7d70653dfbd",
                                "sense_id": "bf5c5fd7-9470-30d2-8d37-462346a1f0ef",
                                "text": "Tout canon rayé d'armes de guerre, de chasse ou de luxe subit deux épreuves : la première avant le rayage, le canon étant foré au calibre qu´il doit avoir, émoulu et raboté ; la seconde après le rayage, le canon étant fini à l´extérieur, sauf la culasse et la mise en couleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "d53d5163-76f1-399e-811a-7a2e386d76b1",
                        "entry_id": "5af51c81-a058-3f2f-ad9a-6790e547a830",
                        "glosses": [
                            "Action d´utiliser un stylet ou une pointe diamant pour marquer une surface d´écriture, d´une figure, d'un trait ; résultat de cette action."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
