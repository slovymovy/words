                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eaef13d-ed18-49bb-90b5-8691c7b142b4",
                                                "sense_id": "e03ecee1-75e7-3e8c-8392-668cd17a74ed",
                                                "text": "\"Your parents like Cool Hand Luke, yes?\" \"I don't really know. Why?\" \"Why? Because they name you Luke.\" I was worried I might have to explain that my name wasn't all that uncommon, and, anyway, Claudia had named me after the alter ego of Hank Williams, Luke the Drifter."
                                            },
                                            {
                                                "example_id": "34a36b2c-afff-4465-9f7f-97f10b0e38a5",
                                                "sense_id": "e03ecee1-75e7-3e8c-8392-668cd17a74ed",
                                                "text": "The engineers are Akash Bobba, Edward Coristine, Luke Farritor, Gautier Cole Killian, Gavin Kliger, and Ethan Shaotran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f96212-b067-36ce-b859-1b2e0ee3e785",
                                        "entry_id": "e2ed65e4-d5cf-3a48-843e-c1f504ddb658",
                                        "glosses": [
                                            "Luke the Evangelist, an early Christian credited with the authorship of the Gospel of Luke and the Acts of the Apostles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb8c48f-74fe-438a-b8ce-aa3e2b1a0942",
                                                "sense_id": "71f96212-b067-36ce-b859-1b2e0ee3e785",
                                                "text": "Luke, the beloved physician, and Demas, greet you."
                                            }
                                        ]
                                    },
