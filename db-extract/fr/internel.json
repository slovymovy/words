                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d40b34b6-5c10-40ca-934c-17feefeb2044",
                                                "sense_id": "07fd6db1-2cbb-3079-b544-2d3a6cb7292b",
                                                "text": "There is nothing can be added unto the daintinesse of Fulvius wives death, who was so inward with Augustus."
                                            },
                                            {
                                                "example_id": "e4e1befc-7ee8-4d89-89dd-bb1de430397f",
                                                "sense_id": "07fd6db1-2cbb-3079-b544-2d3a6cb7292b",
                                                "text": "All my inward friends abhorred me."
                                            },
                                            {
                                                "example_id": "c3838a26-e4a8-4e4f-9226-4c4e449661b0",
                                                "sense_id": "07fd6db1-2cbb-3079-b544-2d3a6cb7292b",
                                                "text": "He had had occasion, by one very inward with him, to know in part the discourse of his life.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
