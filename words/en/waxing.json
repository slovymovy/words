{
    "word_family": [
        "wax",
        "waxer",
        "waxy",
        "waxiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49aa2594-8261-3fb2-b9da-93f3b00ce814",
                    "sense_definition": "present participle and gerund of <w>wax</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moon is currently <w>waxing</w> and will be full by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Сейчас Луна <w>растущая</w> и станет полной к концу недели."
                            }
                        },
                        {
                            "text": "The professor was <w>waxing</w> poetic about his favorite medieval literature.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>ударился в</w> поэтические рассуждения о своей любимой средневековой литературе."
                            }
                        }
                    ],
                    "antonyms": [
                        "waning"
                    ],
                    "common_phrases": [
                        "waxing moon",
                        "waxing crescent",
                        "waxing gibbous",
                        "waxing poetic"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола wax: растущий (о Луне), увеличивающийся, становящийся каким-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растущий",
                                "target_lang_sense_clarification": "о фазе Луны"
                            },
                            {
                                "target_lang_word": "становящийся",
                                "target_lang_sense_clarification": "в выражениях вроде waxing poetic"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e978903-aeed-3147-826e-4f4192e22220",
                    "sense_definition": "A cosmetic procedure in which hair is removed from the body by the application and removal of wax.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hair_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She booked an appointment for an eyebrow <w>waxing</w> before the wedding.",
                            "target_lang_translations": {
                                "ru": "Перед свадьбой она записалась на <w>восковую депиляцию</w> бровей."
                            }
                        },
                        {
                            "text": "Regular <w>waxing</w> can lead to softer and finer hair regrowth over time.",
                            "target_lang_translations": {
                                "ru": "Регулярный <w>ваксинг</w> со временем приводит к тому, что отрастающие волосы становятся мягче и тоньше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bikini waxing",
                        "eyebrow waxing",
                        "leg waxing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Косметическая процедура по удалению волос с тела при помощи воска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваксинг",
                                "target_lang_sense_clarification": "косметическая процедура депиляции"
                            },
                            {
                                "target_lang_word": "восковая депиляция",
                                "target_lang_sense_clarification": "удаление волос с помощью воска"
                            },
                            {
                                "target_lang_word": "восковая эпиляция",
                                "target_lang_sense_clarification": "удаление волос горячим или теплым воском"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ec8cfe9-25ef-3062-9b0e-1631d55a3c7c",
                    "sense_definition": "An act of applying wax to a surface to protect or polish it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surface_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique table was restored with several careful <w>waxings</w> using beeswax.",
                            "target_lang_translations": {
                                "ru": "Антикварный стол отреставрировали путём многократного тщательного <w>вощения</w> пчелиным воском."
                            }
                        },
                        {
                            "text": "The car will need another thorough <w>waxing</w> to protect its paint from winter salt.",
                            "target_lang_translations": {
                                "ru": "Машине потребуется ещё одна тщательная <w>полировка воском</w>, чтобы защитить краску от зимней соли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "car waxing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанесение воска на поверхность для её защиты, полировки или обработки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вощение",
                                "target_lang_sense_clarification": "покрытие воском дерева или других материалов"
                            },
                            {
                                "target_lang_word": "натирка воском",
                                "target_lang_sense_clarification": "полировка поверхности воском"
                            },
                            {
                                "target_lang_word": "полировка воском",
                                "target_lang_sense_clarification": "обработка кузова или мебели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd0a3a2c-752e-3e6d-9c42-fc604d4e9db7",
                    "sense_definition": "A phonograph record or recording.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_recording",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jazz enthusiast collected early shellac <w>waxings</w> from the nineteen twenties.",
                            "target_lang_translations": {
                                "ru": "Любитель джаза собирал ранние шеллаковые <w>пластинки</w> двадцатых годов."
                            }
                        },
                        {
                            "text": "Most of the blues singer's classic <w>waxings</w> went largely unnoticed in his lifetime.",
                            "target_lang_translations": {
                                "ru": "Большинство классических <w>записей</w> этого блюзового певца при его жизни остались почти незамеченными."
                            }
                        }
                    ],
                    "synonyms": [
                        "record",
                        "vinyl",
                        "platter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to early phonograph recordings originally made on wax cylinders or discs"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грампластинка или звукозапись (преимущественно на ранних восковых дисках или цилиндрах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грампластинка",
                                "target_lang_sense_clarification": "устаревшее обозначение виниловой или шеллаковой пластинки"
                            },
                            {
                                "target_lang_word": "звукозапись",
                                "target_lang_sense_clarification": "музыкальная дорожка на носителе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}