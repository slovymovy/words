                    {
                        "translation_id": "c20c967b-7298-4897-a533-3cfe40ac9284",
                        "source_entry_id": "47b14b69-0e58-3ede-9231-09dad55549ec",
                        "source_sense_id": "96ec8dec-cb51-344a-8696-53468fdcf7f8",
