                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72f4e453-351d-4f9a-a253-1bd75919b3f0",
                                                "sense_id": "16fed7b3-d49b-3a82-a426-d4d76b342f9c",
                                                "text": "The rider, to whom the paths of these wilds seemed intimately known, pushed on at a rapid pace, managing, with much dexterity, to chuse the safest route, […]"
                                            },
                                            {
                                                "example_id": "36c0dd00-c677-4361-9c66-6ab5ef2b6d01",
                                                "sense_id": "16fed7b3-d49b-3a82-a426-d4d76b342f9c",
                                                "text": "The object of the builders was to push on to Uganda as quickly as possible; one result was that Kenya was \"discovered\" on the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0adcd4e3-8933-35d8-b06b-abad17b170c8",
                                        "entry_id": "d10df025-67d6-361d-b24b-ab53b3aadb80",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see push, on."
                                        ],
                                        "tags": [],
