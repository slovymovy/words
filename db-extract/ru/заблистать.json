                "senses": [
                    {
                        "sense_id": "9c67fdf3-59f2-3c5a-bfaf-940d7254d464",
                        "entry_id": "e618fac4-49dd-33f2-8fb1-3df88d6f861b",
                        "glosses": [
                            "то же, что заблестеть, начать блистать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c8f8a59-e1a0-4e24-a604-24d1fb452f1e",
                                "sense_id": "9c67fdf3-59f2-3c5a-bfaf-940d7254d464",
                                "text": "Голова его слегка было начала кружиться; какая-то дикая энергия заблистала вдруг в его воспаленных глазах и в его исхудалом бледно-желтом лице…"
                            },
                            {
                                "example_id": "a54d70df-9d42-4631-886d-4c22ea2f2866",
                                "sense_id": "9c67fdf3-59f2-3c5a-bfaf-940d7254d464",
                                "text": "На глазах заблистали слёзы."
                            },
                            {
                                "example_id": "7f740a96-f64c-44e9-a2a5-8c9465eb244b",
                                "sense_id": "9c67fdf3-59f2-3c5a-bfaf-940d7254d464",
                                "text": "Глаза заблистали радостью."
                            }
                        ]
                    }
