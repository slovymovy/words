                        "source_entry_id": "fc649ce2-2bc0-3559-9fb2-29a5b398e137",
                        "source_sense_id": "9ec16cce-b4e0-3354-a3bf-fe0e0ab1e35c",
                        "source_sense_description": "überall, allerorten; nach allen Seiten, von allen Seiten; von allen, bei allen",
                        "target_lang_word": "everywhere",
                        "target_lang_code": "en",
