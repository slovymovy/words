                                "target_senses": [
                                    {
                                        "sense_id": "1807ad48-6864-3cb6-9084-da646143ea06",
                                        "entry_id": "bfb7b4b4-0737-31bf-8608-d8e8dfad9ab2",
                                        "glosses": [
                                            "Avec majesté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69065f17-bea9-4446-a21b-5d4b69dd8f31",
                                                "sense_id": "1807ad48-6864-3cb6-9084-da646143ea06",
                                                "text": "Le feu s’avançait majestueusement, engloutissant tout sur son passage, précédé par une foule innombrable d’animaux de toutes sortes, …."
                                            },
                                            {
                                                "example_id": "67faa7e8-4225-442d-8a7d-8af211bc5aaa",
                                                "sense_id": "1807ad48-6864-3cb6-9084-da646143ea06",
                                                "text": "Le jazz, hurlait le général à son aide de camp, tout en bostonnant majestueusement…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c7de0f0-b14c-452f-b41a-134c5c4f4206",
                        "source_entry_id": "17abb09c-69d3-32c0-97b9-5c87a28050c6",
                        "source_sense_id": "1719d0b7-6313-30e8-b3e9-8d63161dda28",
                        "source_sense_description": "in a majestic manner",
                        "target_lang_word": "majestätisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majestätisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "477607c6-37c5-3504-93bd-b8c2345fb0d8",
                                        "entry_id": "b78394a2-63a6-36d5-8d08-94ce748315fd",
                                        "glosses": [
                                            "durch sein Erscheinungsbild Ehrfurcht gebietend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d24f35fa-64e2-467c-bd59-81910f04f310",
                                                "sense_id": "477607c6-37c5-3504-93bd-b8c2345fb0d8",
                                                "text": "„Man sieht majestätische, grün bewaldete Berge, die Silhouetten der Städte Rio und Niterói und die geschwungene Brücke, die sie verbindet.“"
                                            },
                                            {
                                                "example_id": "0f64a627-fbfa-423d-acf7-6e4c4c4f7cb4",
                                                "sense_id": "477607c6-37c5-3504-93bd-b8c2345fb0d8",
                                                "text": "„Der Norden Pakistans ist durch majestätische Gebirge gekennzeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c83b8426-8b8d-3b00-bd85-b37e4254ed45",
                                        "entry_id": "b78394a2-63a6-36d5-8d08-94ce748315fd",
                                        "glosses": [
                                            "die Würde hochgestellter Persönlichkeiten betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdde2888-c1e6-4535-a6a0-d293cf4f88f8",
                                                "sense_id": "c83b8426-8b8d-3b00-bd85-b37e4254ed45",
                                                "text": "„In ihrem majestätischen Selbstverständnis hielten es diese Asphalt-Highlander auch gar nicht für notwendig, Vergleichsangebote für Beratungsleistungen einzuholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
