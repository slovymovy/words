                "senses": [
                    {
                        "sense_id": "48942bf3-614b-36e5-b5a1-8851df4a4807",
                        "entry_id": "43fc42fe-e0d6-321d-b5f4-dc07ad2db3ba",
                        "glosses": [
                            "Transport aérien, trafic aérien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0a216cd-15af-449d-bfc4-4caeba8861c9",
                                "sense_id": "48942bf3-614b-36e5-b5a1-8851df4a4807",
                                "text": "Der internationale Luftverkehr gilt als einer der Risikopunkte bei der Ausbreitung des Coronavirus.",
                                "translation": "Le transport aérien international est considéré comme l’un des points à risque dans la propagation du coronavirus."
                            },
                            {
                                "example_id": "8ebef77e-2b63-4dc1-9dd0-b23d62909657",
                                "sense_id": "48942bf3-614b-36e5-b5a1-8851df4a4807",
                                "text": "Der Luftverkehr hat mit Personalmangel in der Hochsaison zu kämpfen, vor allem bei Bodendiensten, zum Teil aber auch bei Flugbegleitern.",
                                "translation": "Le transport aérien est confronté à un manque de personnel en haute saison, surtout dans les services au sol, mais aussi en partie dans le personnel de cabine."
                            },
                            {
                                "example_id": "04b43fdf-1524-4eab-8ad4-b88d750d6a7e",
                                "sense_id": "48942bf3-614b-36e5-b5a1-8851df4a4807",
                                "text": "Der Tourismusboom in Griechenland bringt die Flugsicherung des Landes an ihr Limit – und verzögert inzwischen den Luftverkehr in ganz Europa.",
                                "translation": "Le boom touristique en Grèce pousse le contrôle aérien du pays à ses limites, ce qui retarde désormais le trafic aérien dans toute l'Europe."
                            }
                        ]
                    }
