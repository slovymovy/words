                "translations": [
                    {
                        "translation_id": "5e466fbc-657a-4e3c-9868-4aa3e5bb950c",
                        "source_entry_id": "7d5912ab-af34-3294-b707-ec6a9adeb60e",
                        "target_lang_word": "awake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea3a4500-86a3-3648-9ace-2cbd5903666d",
                                        "entry_id": "48b53537-3c64-3330-be11-26942f49c980",
                                        "glosses": [
                                            "Not asleep; conscious."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05518a3d-7c2b-4764-ab57-a6c4763902f3",
                                                "sense_id": "ea3a4500-86a3-3648-9ace-2cbd5903666d",
                                                "text": "By quarter to six all this had me so awake and agitated that even the Balinese wind chimes that I hung up in the garden to relax me began to sound like Big Ben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "237852ae-4fef-3c5a-9b09-8027392bb84a",
                                        "entry_id": "48b53537-3c64-3330-be11-26942f49c980",
                                        "glosses": [
                                            "Alert, aware."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e93a69-f437-4304-b551-128cb07354c2",
                                                "sense_id": "237852ae-4fef-3c5a-9b09-8027392bb84a",
                                                "text": "They were awake to the possibility of a decline in sales."
                                            },
                                            {
                                                "example_id": "afcad825-f8a4-4861-b31b-0e8c184fee1b",
                                                "sense_id": "237852ae-4fef-3c5a-9b09-8027392bb84a",
                                                "text": "The Baker was a two-handed hitter, and seemed perfectly awake to the business before him."
                                            },
                                            {
                                                "example_id": "adf8bda9-3c47-4175-8ac5-ad9024a6a323",
                                                "sense_id": "237852ae-4fef-3c5a-9b09-8027392bb84a",
                                                "text": "‘Sammy,’ whispered Mr. Weller, looking cautiously round; ‘[…] Me and a cab’net-maker has dewised a plan for gettin’ him out. A pianner, Samivel—a pianner!’ […]\n‘And wot ‘ud be the good o’ that?’ said Sam.\n‘Let him send to my friend, the cabinet-maker, to fetch it back, Sammy,’ replied Mr. Weller. ‘Are you avake, now?’\n‘No,’ rejoined Sam.\n‘There ain’t no vurks in it,’ whispered his father. ‘It ‘ull hold him easy, vith his hat and shoes on, and breathe through the legs, vich his holler. […]"
                                            },
                                            {
                                                "example_id": "84aafc6c-4a52-4587-b7b0-d7711108cc04",
                                                "sense_id": "237852ae-4fef-3c5a-9b09-8027392bb84a",
                                                "text": "And so we see in our own world a revolution of rising expectations. The great challenge facing every individual graduating today is to remain awake through this social revolution."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "awake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc5eae3-67c5-3ff8-989e-241c57e6fd27",
                                        "entry_id": "42e518ed-0b82-32c5-addc-c02a8ef4659e",
                                        "glosses": [
                                            "To become conscious after having slept."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df3ac871-5add-40cc-8c44-4be330dff51e",
                                                "sense_id": "8cc5eae3-67c5-3ff8-989e-241c57e6fd27",
                                                "text": "Awake! for Morning in the Bowl of Night,\nHas flung the Stone that puts the Stars to Flight:\nAnd Lo! the Hunter of the East has caught\nThe Sultán's Turret in a Noose of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b615b46-8365-3324-837c-d357a5920cf9",
                                        "entry_id": "42e518ed-0b82-32c5-addc-c02a8ef4659e",
                                        "glosses": [
                                            "To cause (somebody) to stop sleeping."
                                        ],
                                        "tags": [
                                            "predicative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4204894c-2984-4b98-8e1d-559e1002362d",
                                                "sense_id": "5b615b46-8365-3324-837c-d357a5920cf9",
                                                "text": "Thenne she called the heremyte syre Vlfyn I am a gentylwoman that wold speke with the knyght whiche is with yow / Thenne the good man awaked Galahad / & badde hym aryse and speke with a gentylwoman that semeth hath grete nede of yow / Thenne Galahad wente to her & asked her what she wold"
                                            },
                                            {
                                                "example_id": "205472d6-413f-4ea1-8e7b-35e8f5f10a90",
                                                "sense_id": "5b615b46-8365-3324-837c-d357a5920cf9",
                                                "text": "[This ant] I ſuffered to lye above an hour in the Spirit; and after I had taken it out, and put its body and legs into a natural poſture, remained moveleſs about an hour; but then , upon a ſudden, as if it had been awaken out of a drunken ſleep, it ſuddenly reviv'd and ran away..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24d7be50-fee1-386e-81d9-3e7eff5799b6",
                                        "entry_id": "42e518ed-0b82-32c5-addc-c02a8ef4659e",
                                        "glosses": [
                                            "To make aware of something."
                                        ],
                                        "tags": [
                                            "predicative",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30bec71a-ff5e-3fe8-a6aa-f65cfc261213",
                                        "entry_id": "42e518ed-0b82-32c5-addc-c02a8ef4659e",
                                        "glosses": [
                                            "To excite or to stir up something latent."
                                        ],
                                        "tags": [
                                            "predicative",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2c8a1e7-f44e-39a9-8593-2ea129655e5f",
                                        "entry_id": "42e518ed-0b82-32c5-addc-c02a8ef4659e",
                                        "glosses": [
                                            "To rouse from a state of inaction or dormancy."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "predicative",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3eaf8ab-e701-36bc-94cc-9e0b2753767d",
                                        "entry_id": "42e518ed-0b82-32c5-addc-c02a8ef4659e",
                                        "glosses": [
                                            "To come out of a state of inaction or dormancy."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70d0144-8322-479c-8e91-62a1456d18f0",
                                                "sense_id": "c3eaf8ab-e701-36bc-94cc-9e0b2753767d",
                                                "text": "1867-1879, Edward Augustus Freeman, The History of the Norman Conquest of England\nThe national spirit again awoke."
                                            },
                                            {
                                                "example_id": "21837a89-15bb-4c2a-8337-ac5e7abc84eb",
                                                "sense_id": "c3eaf8ab-e701-36bc-94cc-9e0b2753767d",
                                                "text": "Awake to righteousness, and sin not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
