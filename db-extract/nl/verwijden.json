        "nl-extract.jsonl": [
            {
                "entry_id": "65c83e89-4142-3800-9689-f587a39487c7",
                "word": "verwijden",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "92fcda49-1811-3bb7-a755-27cca9167367",
                        "entry_id": "65c83e89-4142-3800-9689-f587a39487c7",
                        "glosses": [
                            "iets breder/ruimer/wijder maken"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "15c76973-9f4f-4f4c-b1aa-dde8e75d6ffc",
                                "sense_id": "92fcda49-1811-3bb7-a755-27cca9167367",
                                "text": "\"Mensen die lucht inademen waar ontstekingsremmende corticosteroïden inzitten, blijken inderdaad gemiddeld dikker te zijn. In het algemeen maken corticosteroïden (stresshormonen) dik, dat zie je als iemand ze in tabletvorm - zoals prednison - slikt. Of dat bij de lokale toediening via je longen ook zo direct werkt, moet nog worden uitgezocht. Voor de duidelijkheid: het gaat hier niet om pufjes die de luchtwegen instant verwijden tegen benauwdheid.\""
                            },
                            {
                                "example_id": "ca957d1b-d780-455c-8ae8-a9dc63068800",
                                "sense_id": "92fcda49-1811-3bb7-a755-27cca9167367",
                                "text": "Mochten de meerdere lagen kleding, het thermo-ondergoed en het vroeger naar bed gaan nou niet helpen, dan kan het nuttigen van warm eten en non-alcoholische dranken helpen. Alcohol zorgt er namelijk voor dat je bloedvaten verwijden waardoor de warmte sneller wordt afgegeven. Vervang daarom dat biertje voor een warme chocolademelk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9002ac1f-ed8a-458f-848c-3cd1eefcb522",
                        "source_entry_id": "65c83e89-4142-3800-9689-f587a39487c7",
                        "source_sense_id": "92fcda49-1811-3bb7-a755-27cca9167367",
                        "target_lang_word": "broaden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broaden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "270e20dd-0d7b-3b81-bd33-40a6fab42a5e",
                                        "entry_id": "3f5844a2-6c2e-3b20-add9-fc238adf3a91",
                                        "glosses": [
                                            "To make broad or broader."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af3398cb-aba5-4b8e-8f89-bbb466813ee1",
                                                "sense_id": "270e20dd-0d7b-3b81-bd33-40a6fab42a5e",
                                                "text": "broaden one’s knowledge"
                                            },
                                            {
                                                "example_id": "3aca6a2d-3605-4dfb-b9b9-e4fb57e4edb8",
                                                "sense_id": "270e20dd-0d7b-3b81-bd33-40a6fab42a5e",
                                                "text": "broaden the canal"
                                            },
                                            {
                                                "example_id": "8fbfe395-18c6-475f-a03e-9c80d8049646",
                                                "sense_id": "270e20dd-0d7b-3b81-bd33-40a6fab42a5e",
                                                "text": "Travel broadens the mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b3e36ec-cc1d-302d-93d3-f9cef2b407b3",
                                        "entry_id": "3f5844a2-6c2e-3b20-add9-fc238adf3a91",
                                        "glosses": [
                                            "To become broad or broader."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a4fbd3-480a-4472-bae4-dab6185f5587",
                                                "sense_id": "5b3e36ec-cc1d-302d-93d3-f9cef2b407b3",
                                                "text": "The roads gradually broadened as we drove into the countryside."
                                            },
                                            {
                                                "example_id": "33581794-dee0-4e3c-968d-4ceb3babb4e7",
                                                "sense_id": "5b3e36ec-cc1d-302d-93d3-f9cef2b407b3",
                                                "text": "Her knowledge broadened after spending a year in South America."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa985c99-7a6f-42d5-a06c-60770a8e4073",
                        "source_entry_id": "65c83e89-4142-3800-9689-f587a39487c7",
                        "source_sense_id": "92fcda49-1811-3bb7-a755-27cca9167367",
                        "target_lang_word": "widen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3b4720-c769-38b4-8560-9cd000a11960",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To become wide or wider."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a4c3042-bc0d-4056-84b2-98df301d4dd6",
                                                "sense_id": "7e3b4720-c769-38b4-8560-9cd000a11960",
                                                "text": "His eyes widened as her negligee fell to the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05e3e3b-e3f3-30ee-85c8-62862be0d7cb",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To make wide or wider."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d6f1aa-f7b2-4d4a-80d4-89850a776d95",
                                                "sense_id": "d05e3e3b-e3f3-30ee-85c8-62862be0d7cb",
                                                "text": "But he still saw his side produce a rousing display which owed much to their lauded prowess from set-pieces, despite Uefa regulations meaning the pitch had to be widened and, in the process, the run-up area for Delap's long throws reduced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bff008c-e3e6-33a7-8e68-f2bb1063057e",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To let out clothes to a larger size."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd6f64f-9cb6-4ab5-b73c-f76024c28fd2",
                                                "sense_id": "9bff008c-e3e6-33a7-8e68-f2bb1063057e",
                                                "text": "She widened his trousers for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To broaden or extend in scope or range."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48a1381-05b3-49c4-96c7-242551addd96",
                                                "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                                "text": "The police widened their enquiries."
                                            },
                                            {
                                                "example_id": "94f2f40e-301c-417a-a10d-481caeb68e21",
                                                "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                                "text": "While the primary focus of the Sexual Orientation Committee had been to lobby for gay rights legislation, the new Task Force hopes to widen its activities. The Task Force ― in addition to lobbying — hopes to function as an \"umbrella organization,\" facilitating communication between the state's many gay groups."
                                            },
                                            {
                                                "example_id": "bdfc7893-199f-463d-8e07-b8a0f84e6a02",
                                                "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                                                "text": "Correspondent Gerardo Arreola interviewed Castro Espín for the Jan. 9, 2006, issue of La Jornada about the move to widen rights for transsexuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53a7fbea-ef17-3cdc-b561-e1a5e1b5b2e7",
                                        "entry_id": "aa95f84d-b507-3ae0-997b-53cdc83aa093",
                                        "glosses": [
                                            "To convert to a data type that can hold a larger number of distinct values."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc32b38-cc29-402f-a01b-56c06ff0c8ad",
                                                "sense_id": "53a7fbea-ef17-3cdc-b561-e1a5e1b5b2e7",
                                                "text": "to widen a short variable to an int variable"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab009e62-f22a-4464-a32d-df51cbc2a719",
                        "source_entry_id": "65c83e89-4142-3800-9689-f587a39487c7",
                        "source_sense_id": "92fcda49-1811-3bb7-a755-27cca9167367",
                        "target_lang_word": "expand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f60cd435-1a88-33a2-bb40-9cf3f76cd4a1",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To change (something) from a smaller form or size to a larger one; to spread out or lay open."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5aade17-0026-4cf1-acb9-b2e722da2574",
                                                "sense_id": "f60cd435-1a88-33a2-bb40-9cf3f76cd4a1",
                                                "text": "You can expand this compact umbrella to cover a large table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b87f93ba-4616-3209-a398-94997796e0b5",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To increase the extent, number, volume or scope of (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef6b1742-abbb-4b1e-84ab-c08a60eeb0a4",
                                                "sense_id": "b87f93ba-4616-3209-a398-94997796e0b5",
                                                "text": "A flower expands its leaves."
                                            },
                                            {
                                                "example_id": "ac330ea5-817d-4f0b-af31-40f2e0b1eb2b",
                                                "sense_id": "b87f93ba-4616-3209-a398-94997796e0b5",
                                                "text": "Then with expanded wings he steers his flight."
                                            },
                                            {
                                                "example_id": "2af290b3-ef2e-42c0-b05d-9ed0c133563b",
                                                "sense_id": "b87f93ba-4616-3209-a398-94997796e0b5",
                                                "text": "This has evidently been encouraging, for the current winter timetable - not even with the benefit of summer holiday traffic - shows that the two trains each way have been expanded to four."
                                            },
                                            {
                                                "example_id": "88d47b25-0ff6-42f6-8744-147cf7687eb8",
                                                "sense_id": "b87f93ba-4616-3209-a398-94997796e0b5",
                                                "text": "When an ultrasonic beam is fired at the microcannons, the emulsion evaporates, expanding rapidly into gas. This creates enough force to push the nanobullets out at velocities reaching several metres per second."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5194fa-6c3a-3c24-bbf9-ad65485b18c8",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To express (something) at length and/or in detail."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8146b222-dc74-3d50-9c12-35a2d9a2f874",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To rewrite (an expression) as a longer, yet equivalent, sum of terms."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964320a1-e958-468f-a8fd-086c01a71927",
                                                "sense_id": "8146b222-dc74-3d50-9c12-35a2d9a2f874",
                                                "text": "Use the binomial theorem to expand #123;(x#43;1)#125;⁴."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cc57f52-d4cf-38fa-9733-909a54649d9f",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To become, by rewriting, a longer, yet equivalent, sum of terms."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c570f8ba-6e2c-491c-8bd2-c365c6b712e7",
                                                "sense_id": "7cc57f52-d4cf-38fa-9733-909a54649d9f",
                                                "text": "The expression #123;(x#43;1)#125;⁴ expands to x⁴#43;4x³#43;6x²#43;4x#43;1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbceeffb-06a2-31f1-951e-7755b1d3b6ee",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To multiply both the numerator and the denominator of a fraction by the same (non-zero) number (which yields a fraction of equal value)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41170a9f-4f61-4c59-ba2f-36074e35117b",
                                                "sense_id": "dbceeffb-06a2-31f1-951e-7755b1d3b6ee",
                                                "text": "Expanding 4#47;7 by 3 gives 12#47;21."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf00538-bc87-3df2-bdd0-65841f54d983",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To change or grow from smaller to larger in form, number, or size."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ffc639-1b8f-496a-b429-ec3fc319d959",
                                                "sense_id": "9bf00538-bc87-3df2-bdd0-65841f54d983",
                                                "text": "Many materials expand when heated."
                                            },
                                            {
                                                "example_id": "dfd0a0ee-8d5c-49cf-a2b4-988763adb003",
                                                "sense_id": "9bf00538-bc87-3df2-bdd0-65841f54d983",
                                                "text": "This compact umbrella expands to cover a large table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be09a062-a8f8-3a9f-b5bf-8f44f4e7f39f",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To increase in extent, number, volume or scope."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "741e6027-7538-3d9a-92f9-2613eaf5677f",
                                        "entry_id": "ed67e472-9222-3fcb-93fc-66ce4a9886aa",
                                        "glosses": [
                                            "To speak or write at length or in detail."
