                "senses": [
                    {
                        "sense_id": "32980905-7bc4-307b-9e6b-fd88885365b4",
                        "entry_id": "7a7a72d9-4673-30b6-afa3-dc07526187b7",
                        "glosses": [
                            "das Hervorbringen/Gestalten eines Satzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb024b20-303e-4483-bfcf-2f4e14f71cb2",
                                "sense_id": "32980905-7bc4-307b-9e6b-fd88885365b4",
                                "text": "„Aber große Begebenheiten sind in einem Buch oder in einem Gemälde unbrauchbar, wenn sie nicht in die höchste Präzision jedes Pinselstrichs, jedes Wortes oder jeder Satzbildung eingespannt sind.“"
                            },
                            {
                                "example_id": "21f8c057-0cbc-42ea-ba23-57435f15b009",
                                "sense_id": "32980905-7bc4-307b-9e6b-fd88885365b4",
                                "text": "„Die charakteristischen Merkmale sind Flexion und differenziertere Satzbildung innerhalb der Parataxe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c4c4dd85-d87a-3df6-a134-a8ba818b8292",
                        "entry_id": "7a7a72d9-4673-30b6-afa3-dc07526187b7",
                        "glosses": [
                            "der durch [1] gebildete/gestaltete Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d46276-5062-47af-889f-61956237d4b6",
                                "sense_id": "c4c4dd85-d87a-3df6-a134-a8ba818b8292",
                                "text": "„Der Infinitvsatz ist eine der feinsten Arten der Satzbildung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
