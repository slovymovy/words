                                "target_senses": [
                                    {
                                        "sense_id": "aff6b5ef-a106-3df8-9205-131bb624a3e9",
                                        "entry_id": "47d7b28b-fc3f-35cf-89e3-897ee761f62a",
                                        "glosses": [
                                            "The dressing of the hair by curling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9241b833-ed0d-4200-99d0-2688eab7d6b0",
                                                "sense_id": "aff6b5ef-a106-3df8-9205-131bb624a3e9",
                                                "text": "A box on the ear destroys the whole oeconomy of their frisure, upon which they bestow the greatest part of their time and attention […]"
                                            },
                                            {
                                                "example_id": "f2b38a9a-9c9f-41f0-8fdb-91e485302a74",
                                                "sense_id": "aff6b5ef-a106-3df8-9205-131bb624a3e9",
                                                "text": "1870, Daniel Garrison Brinton and George H. Napheys, Personal Beauty: How to Cultivate and Preserve it in Accordance with the Laws of Health, Springfield, Massachusetts: W.J. Holland, “The Hair,” p. 306,\n[…] in the selection of a frisure, as in that of colors, a lady should take into account her complexion, her stature, her features, and her expression, and so arrange the hair as to heighten and give prominence to the most favorable parts of these, and conceal or diminish any defect which they may present."
                                            },
                                            {
                                                "example_id": "57c2871c-8299-4451-89dd-fc0845810b1a",
                                                "sense_id": "aff6b5ef-a106-3df8-9205-131bb624a3e9",
                                                "text": "[…]the frisure of women's hair"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
