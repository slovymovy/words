                "senses": [
                    {
                        "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                        "entry_id": "d9bf8f12-be48-39e6-a40f-c1fbf0eeb42d",
                        "glosses": [
                            "Synonym of barking, particularly (figurative) snarling, bitterly or angrily complaining."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "a8dc974c-dddd-4c28-b4c5-816cd021b1bf",
                                "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                                "text": "And that the Balant and Latrant Noiſes of that ſort of People may be for ever Silenced, […]"
                            },
                            {
                                "example_id": "41bb628c-ca2f-45d7-a6ef-669e06bd9de1",
                                "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                                "text": "Latrant, barking; as A Latrant Writer, an Author that does nothing but bark and snarl at others."
                            },
                            {
                                "example_id": "e7bbd1b7-51f3-4823-b46a-8dda3830d194",
                                "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                                "text": "Thy care be the first the various gifts to trace\nThe minds and genius of the latrant race."
                            },
                            {
                                "example_id": "00cb2feb-e450-4b4f-be6a-baa02f6899d6",
                                "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                                "text": "Whoſe latrant ſtomachs oft moleſt\nThe deep-laid plans their dreams ſuggeſt;"
                            },
                            {
                                "example_id": "c503d14e-67f6-4680-9bb4-e0dae8b38727",
                                "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                                "text": "Not gyved with connubial relations, I entered upon my migration entirely isolated, with the exception of a canine quadruped whose mordacious, latrant, lusorious, and venatic qualities, are without parity."
                            },
                            {
                                "example_id": "02a19af2-33e8-4081-933f-599b7eb6929b",
                                "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                                "text": "Thy latrant muse aye glooms sae sour;\nThe ither day her gipsy glower"
                            },
                            {
                                "example_id": "1ee515b8-6bae-4781-aa83-a8948950048d",
                                "sense_id": "73ca7245-1305-3d60-bc6c-86dd733ec5ff",
                                "text": "Sounds, latrant, mugient and reboatory, echoed above the city’s noise as, yelping and barking, the heterogeneous pack raced down the street, while boys and girls, armed with rulers and schoolbags, manoeuvred it to a vacant allotment."
                            }
                        ]
                    }
