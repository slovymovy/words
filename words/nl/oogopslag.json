                {
                    "sense_id": "a3ad6375-0cc0-30a1-9247-270e4c75c18a",
                    "sense_definition": "een zeer korte tijd of een snelle waarneming",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd en waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De EHBO-er overzag de situatie in een <w>oogopslag</w> en begon direct met reanimeren.",
                            "target_lang_translations": {
                                "en": "The first aider assessed the situation at a <w>glance</w> and immediately began CPR."
                            }
                        },
                        {
                            "text": "Je kunt in een <w>oogopslag</w> zien dat dit product van hoge kwaliteit is.",
                            "target_lang_translations": {
                                "en": "You can see at a <w>glance</w> that this product is of high quality."
                            }
                        }
                    ],
                    "synonyms": [
                        "handomdraai",
                        "wenk"
                    ],
                    "common_phrases": [
                        "in een oogopslag"
                    ],
                    "target_lang_definitions": {
                        "en": "a very short period of time or a quick observation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glance",
                                "target_lang_sense_clarification": "a quick look"
                            },
                            {
                                "target_lang_word": "blink of an eye",
                                "target_lang_sense_clarification": "a very short time"
                            },
                            {
                                "target_lang_word": "at a glance",
                                "target_lang_sense_clarification": "immediately upon looking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f67d7a1-7e06-35b9-890c-a3266da22bcc",
                    "sense_definition": "de manier waarop iemand kijkt of een snelle blik",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd en waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn eerste <w>oogopslag</w> verraadde dat hij niet blij was met het nieuws.",
                            "target_lang_translations": {
                                "en": "His first <w>look</w> revealed that he was not happy with the news."
                            }
                        },
                        {
                            "text": "Met een korte <w>oogopslag</w> naar zijn horloge liet hij weten dat we moesten gaan.",
                            "target_lang_translations": {
                                "en": "With a quick <w>glance</w> at his watch, he let us know we had to go."
                            }
                        }
                    ],
                    "synonyms": [
                        "blik"
                    ],
                    "common_phrases": [
                        "eerste oogopslag"
                    ],
                    "target_lang_definitions": {
