                    {
                        "sense_id": "03430d17-288e-36b3-9611-542327a1cb96",
                        "entry_id": "3dbeedd8-dc7d-378e-8b3d-1f0e07c5659b",
                        "glosses": [
                            "To dwell around or about (a place); inhabit."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ca328f17-6a2e-4841-b554-8e2e89423d9b",
                                "sense_id": "03430d17-288e-36b3-9611-542327a1cb96",
                                "text": "[...] At first like a twilight cloud, Yet momently clearer in colour, I saw church-domes and steeples, And lastly a whole city, Ancient-looking, Netherlandish, Man-bedwelt in."
                            },
                            {
                                "example_id": "83f37bab-5815-4d6f-a5ae-f202540fca49",
                                "sense_id": "03430d17-288e-36b3-9611-542327a1cb96",
                                "text": "Gentry of narrow income used to bedwell Montreuil; they are gone, war, want or death knows where."
                            },
                            {
                                "example_id": "f96ebd08-d565-40ee-b92f-9f0819c37aa3",
                                "sense_id": "03430d17-288e-36b3-9611-542327a1cb96",
                                "text": "Even as he looks squarely at calculable nature, he \"retrieves readily be seen to be involved in the reference to \"that which announces itself in the processes and conditions of nature that pervasively rule the world we bedwell.\""
                            }
                        ]
                    }
