                "senses": [
                    {
                        "sense_id": "6c378138-8d60-3b7a-9c92-3948df2087f8",
                        "entry_id": "affc452d-8705-3eaf-ba66-673b56b64311",
                        "glosses": [
                            "To waste entirely."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8c981119-977c-4521-81f1-df6d8767dab6",
                                "sense_id": "6c378138-8d60-3b7a-9c92-3948df2087f8",
                                "text": "Who in God his hope hath placed Shall not life in pain outwaste, Fullest joy he yet shall taste."
                            },
                            {
                                "example_id": "67db40b7-c3da-44ad-bcbc-a5ef1da565f9",
                                "sense_id": "6c378138-8d60-3b7a-9c92-3948df2087f8",
                                "text": "O yes: A staunch She Zealot will outwaste Belief; and were it in her Power, privately give more to her Precise Instructions, than the Lavish Cleopatra, in Luxury of Love, quaft off to her wanton Galant."
                            },
                            {
                                "example_id": "259bc3d4-9bfa-4b54-9e60-3383cc200e13",
                                "sense_id": "6c378138-8d60-3b7a-9c92-3948df2087f8",
                                "text": "Uttering love, that outlasts or outwastes Time's attrition, exiles appear again, But faintly altered in eyes and skin."
                            },
                            {
                                "example_id": "60a88310-5ea3-405f-806f-ff6ee4bcfd49",
                                "sense_id": "6c378138-8d60-3b7a-9c92-3948df2087f8",
                                "text": "The fixation on objects will never stop, as we outpace and outwaste the health of our home."
                            }
                        ]
                    }
