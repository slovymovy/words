                "senses": [
                    {
                        "sense_id": "2a598b3f-4104-382f-beec-59ccd4420458",
                        "entry_id": "d3335668-ae50-3dcd-b601-9d48dfea632c",
                        "glosses": [
                            "To steal food or supplies from a ship's store."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dbe967f8-8d08-40a3-9e73-e538f933c37b",
                                "sense_id": "2a598b3f-4104-382f-beec-59ccd4420458",
                                "text": "The other three quarters didn't have the guts to manarvel the cargo. They were like jackals that are too cowardly to make their own kill, but must follow the trail of carcasses left by the lions and tigers."
                            },
                            {
                                "example_id": "0f7a4b92-8531-4b41-9c88-091066c92a8c",
                                "sense_id": "2a598b3f-4104-382f-beec-59ccd4420458",
                                "text": "Zachary began to wonder whether the gomusta was not some kind of investigator, looking into a report of misplaced or manarveled provisions. Yet, why would he concern himself with butter of all things?"
                            },
                            {
                                "example_id": "9e0adf62-371a-40d3-8697-742c03e1e8b1",
                                "sense_id": "2a598b3f-4104-382f-beec-59ccd4420458",
                                "text": "His spirit lingers near the fortress at the other end of the remoseless depths where Theseus manarvels fleece."
                            }
                        ]
                    }
                ],
