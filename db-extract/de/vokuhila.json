                                        "entry_id": "40c7a8ae-932b-35fb-a1a0-db81d5e1ed69",
                                        "glosses": [
                                            "A hairstyle where the hair is kept short on the top and sides and long at the back."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b303a34-a4cc-439f-8b90-3125fa81400b",
                                                "sense_id": "80d61723-9cb8-3436-9f3c-15daf58eaa28",
                                                "text": "– Mullet head, don't touch the back\n– Cut the sides, don't touch the back"
                                            },
                                            {
                                                "example_id": "830a2101-60f1-4c76-be96-3a633f1b9a5a",
                                                "sense_id": "80d61723-9cb8-3436-9f3c-15daf58eaa28",
                                                "text": "– Maybe it's a curly fro.\n– Maybe every day is bad hair day!\n– Maybe it's a mullet!"
                                            }
