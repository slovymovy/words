                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b57df7e-fafc-3b6c-b1da-d0b392a454bb",
                        "entry_id": "96663416-01b3-3c0a-881d-4cfcdc625f44",
                        "glosses": [
                            "Representing a loud noise or heavy impact."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47be9718-806c-4b4c-9568-e04689bb1bd6",
                                "sense_id": "4b57df7e-fafc-3b6c-b1da-d0b392a454bb",
                                "text": "The wind knocked the tree over last night. Bam! It nearly scared me to death."
                            },
                            {
                                "example_id": "65d23944-b5e5-4be0-a4bb-df2f00d1b91f",
                                "sense_id": "4b57df7e-fafc-3b6c-b1da-d0b392a454bb",
                                "text": "We all looked up from the maps, silent, and listened to the hurried footsteps in the entryway. They padded up the red carpet, bam-bam-bam, and across the landing and then up the next flight at a gallop, bam-bam-bam."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c850e10-8b85-3b5d-ba5c-04382aff1df8",
                        "entry_id": "96663416-01b3-3c0a-881d-4cfcdc625f44",
                        "glosses": [
                            "Representing a sudden or abrupt occurrence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9612774d-afee-4a5d-bcaf-a510334becf5",
                                "sense_id": "8c850e10-8b85-3b5d-ba5c-04382aff1df8",
                                "text": "She said she dumped him. Now — bam! — they're back together."
                            }
                        ]
                    }
                ],
