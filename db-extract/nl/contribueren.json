                "translations": [
                    {
                        "translation_id": "eeee9106-fde8-4b27-926e-2d90c0045e89",
                        "source_entry_id": "274eaaeb-923e-3702-b5d9-82c5695760cf",
                        "source_sense_id": "17227775-1f07-3b6b-b73a-d8023a817de0",
                        "target_lang_word": "contribuer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contribuer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e99918-d77e-30d2-a6ef-2fc63c5c5649",
                                        "entry_id": "45ae1ced-50f3-3a9c-adde-d979ce8e78f5",
                                        "glosses": [
                                            "Aider, de quelque manière que ce soit, à l’exécution, au succès d’un dessein, d’une entreprise ; avoir part à un certain résultat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f478e05a-833f-4bba-8b53-05fdfc37625d",
                                                "sense_id": "b1e99918-d77e-30d2-a6ef-2fc63c5c5649",
                                                "text": "C'est donc des mains victorieuses et bienfaisantes du grand capitaine et de l'habile négociateur qui avait contribué à donner la Lorraine à la France et la couronne impériale à Charles VII, que la première société savante formée à Metz, reçut tout à la fois une dotation et des statuts."
                                            },
                                            {
                                                "example_id": "0207114a-83c6-459e-a86f-7813ece0e312",
                                                "sense_id": "b1e99918-d77e-30d2-a6ef-2fc63c5c5649",
                                                "text": "Les troubles tout récents de Russie ont contribué à populariser l’idée de grève générale dans les milieux des professionnels de la politique."
                                            },
                                            {
                                                "example_id": "8748345c-f9fa-4c6a-85fa-32acbc3031bf",
                                                "sense_id": "b1e99918-d77e-30d2-a6ef-2fc63c5c5649",
                                                "text": "Nous roulions beaucoup, mais sans recevoir de coups de mer ; la précaution que j'avais pris de filer de l'huile contribua à nous maintenir dans de bonnes conditions."
                                            },
                                            {
                                                "example_id": "22c6d771-1837-40ff-a6d7-e28e93341e89",
                                                "sense_id": "b1e99918-d77e-30d2-a6ef-2fc63c5c5649",
                                                "text": "Une bâche de 1000 m² qui la recouvre et un dispositif d'aspersion de gouttes d’eau contribuent à éviter les projections alentour et à limiter la diffusion des poussières."
                                            },
                                            {
                                                "example_id": "7696e8fc-22c0-41ab-951d-ca76b6e08aaf",
                                                "sense_id": "b1e99918-d77e-30d2-a6ef-2fc63c5c5649",
                                                "text": "Les arômes contribuent à rendre le produit agréable au palais, ce qui dépend essentiellement de la présence de produits laitiers ou de la matière édulcorante dans la formule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "327f88a9-da6b-33b7-b573-f64b5baaef07",
                                        "entry_id": "45ae1ced-50f3-3a9c-adde-d979ce8e78f5",
                                        "glosses": [
                                            "Payer une part de quelque dépense ou charge commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6f19b7-1204-45dd-9f0a-846d32d76f75",
                                                "sense_id": "327f88a9-da6b-33b7-b573-f64b5baaef07",
                                                "text": "Contribuer pour un tiers, pour un quart dans une dépense."
                                            },
                                            {
                                                "example_id": "217a51a3-34dc-4557-b9a7-eef1bf68c083",
                                                "sense_id": "327f88a9-da6b-33b7-b573-f64b5baaef07",
                                                "text": "Contribuer aux charges publiques en proportion de ses revenus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
