                "senses": [
                    {
                        "sense_id": "f503c4c6-4fed-3588-9520-f998f63a3b68",
                        "entry_id": "9310f9b4-88a3-3db3-bfb8-122a0b7de564",
                        "glosses": [
                            "zur Hohlhand gehörig; auf der Innenseite der Hand liegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4383e559-093b-4fc3-8d89-8e1e42e77042",
                                "sense_id": "f503c4c6-4fed-3588-9520-f998f63a3b68",
                                "text": "Bei der klinischen Untersuchung läßt sich die Elle nach volar zurückdrücken, federt aber nach dem Loslassen sofort wieder in die Subluxationsstellung zurück."
                            },
                            {
                                "example_id": "8607900e-3401-43dd-9499-fe3019f6fcd4",
                                "sense_id": "f503c4c6-4fed-3588-9520-f998f63a3b68",
                                "text": "Die Luxationsrichtung - nach dorsal häufiger als nach volar - zeigt entweder die Frontalaufnahme oder in den ulnearen Karpometakarpalgelenken die volodorsale Aufnahme in Halbsupination an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
