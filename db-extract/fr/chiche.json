        "fr-extract.jsonl": [
            {
                "entry_id": "ecaeb153-153a-327f-94bb-b686904a5ee2",
                "word": "chiche",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a5567ff2-0b7c-49f7-8c67-37d36c11ac45",
                        "entry_id": "ecaeb153-153a-327f-94bb-b686904a5ee2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "chiches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "243b5b7b-86b3-3f8c-9b9b-4aaf01c9358d",
                        "entry_id": "ecaeb153-153a-327f-94bb-b686904a5ee2",
                        "glosses": [
                            "Qui répugne à dépenser ce qu’il faudrait."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "74c54ba1-b3d8-490d-84f2-60b588a7b34f",
                                "sense_id": "243b5b7b-86b3-3f8c-9b9b-4aaf01c9358d",
                                "text": "Ah ! ils ne sont pas chiches de bonnes paroles. Veux-tu des promesses, en voilà !"
                            },
                            {
                                "example_id": "ed836b3c-3e8a-422b-b657-47e3bcdb7834",
                                "sense_id": "243b5b7b-86b3-3f8c-9b9b-4aaf01c9358d",
                                "text": "Demander un crédit au ministère pour organiser un contrôle sérieux ? Vous savez comme ces gens-là sont chiches."
                            },
                            {
                                "example_id": "26fd8789-e2ea-4ed2-a509-f22b7f020af2",
                                "sense_id": "243b5b7b-86b3-3f8c-9b9b-4aaf01c9358d",
                                "text": "Tout ce monde-là porte blason, parfois octroyé par un comte de Flandre ou un duc de Bourgogne ; plus tard, les rois d’Espagne furent peu chiches de lettres de noblesse et d’octroi d’armoiries aux suppôts de la bonne cause, c’est à dire la leur."
                            }
                        ]
                    },
                    {
                        "sense_id": "6835dcaa-469c-3d26-a57e-a591d3f19040",
                        "entry_id": "ecaeb153-153a-327f-94bb-b686904a5ee2",
                        "glosses": [
                            "Qui est chétif, mesquin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133f964f-4335-4c65-b1ec-271952ab1c92",
                                "sense_id": "6835dcaa-469c-3d26-a57e-a591d3f19040",
                                "text": "Ce logis où nous demeurions ne recevait qu’une chiche lumière, dépendance de la sacristie, bien étroite, entremêlée de poutrelles et de recoins poudreux."
                            },
                            {
                                "example_id": "672d30d8-9bbc-40a6-811c-acc1b610e819",
                                "sense_id": "6835dcaa-469c-3d26-a57e-a591d3f19040",
                                "text": "Même complété d’une mousseline carotte-céleri (77 kilocalories, 1,6 gramme de protéine) et d’une tarte aux pommes recomposée (213 kilocalories, 2,6 grammes de protéine), le repas reste chiche, à moins de 500 kilocalories."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68b5b3f7-2213-42a4-89f4-a74801928139",
                        "source_entry_id": "ecaeb153-153a-327f-94bb-b686904a5ee2",
                        "target_lang_word": "sparsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sparsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                        "entry_id": "fb73e362-7b90-3096-af54-5b1366cde21b",
                                        "glosses": [
                                            "so, dass eine Ressource (zum Beispiel Geld, Wasser oder Ähnliches) möglichst lange reicht; wenig verbrauchend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88072074-fd81-4ed9-9bd5-5c48a6b76b70",
                                                "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                                "text": "Meine Großeltern waren sehr sparsame Menschen."
                                            },
                                            {
                                                "example_id": "5d0060af-c159-459e-8ce1-61c4990701ec",
                                                "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                                "text": "Mit dem Trinkwasser müssen wir sparsam umgehen."
                                            },
                                            {
                                                "example_id": "d41966c2-7a81-41a0-aad3-059f4c8a62da",
                                                "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                                "text": "„Weil die Insulaner sparsame Menschen sind, kaufen sie wegen des Preisvorteils immer mehr seine und immer weniger die Nüsse der anderen Bauern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68c17660-7abc-3b9d-ab1d-6987334566c6",
                                        "entry_id": "fb73e362-7b90-3096-af54-5b1366cde21b",
                                        "glosses": [
                                            "knapp bemessen, kaum ausreichend, spärlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b039ec2-1d8b-4e6d-a002-8a80a4de97a3",
                                                "sense_id": "68c17660-7abc-3b9d-ab1d-6987334566c6",
                                                "text": "„Hammond führte Janson durch einen kahlen Gang mit abgenutztem Linoleumboden in ein geräumiges, aber sparsam eingerichtetes Büro im hinteren Bereich des Gebäudes.“"
                                            },
                                            {
                                                "example_id": "c7355288-6d16-4ec4-aad7-b33693158c70",
                                                "sense_id": "68c17660-7abc-3b9d-ab1d-6987334566c6",
                                                "text": "„Sie opferte ihre gesamte Energie, ihre Zeit und ihr sparsames Gehalt für ihre Eltern und Söhne, ohne dass sie deswegen fühlte, auch nur einen Schritt voran zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3be3e09-2e17-3763-898e-a77384bb3893",
                                        "entry_id": "fb73e362-7b90-3096-af54-5b1366cde21b",
                                        "glosses": [
                                            "von geringem Ausmaß; wenig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b5f5fa-9cf3-4b8b-bb7c-1647c5e8e426",
                                                "sense_id": "e3be3e09-2e17-3763-898e-a77384bb3893",
                                                "text": "„Als wir um eine kleine, mit Fichten sparsam bewachsene Landzunge gebogen waren, lag die östliche Ecke von Usedom vor uns.“"
                                            },
                                            {
                                                "example_id": "acb67295-cd2e-40fa-a0c5-892631f32c8c",
                                                "sense_id": "e3be3e09-2e17-3763-898e-a77384bb3893",
                                                "text": "„Allmählich erfuhr er von ihr in sparsamen Worten von seinem Vater, seiner Mutter und seiner Schwester.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
