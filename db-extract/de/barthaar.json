                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9a5515c-25d3-35dc-b65a-2b43b0ff617a",
                        "entry_id": "90acfb72-fe9a-3dca-99a9-718104df6718",
                        "glosses": [
                            "die Haare eines Bartes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c773f07-7343-4638-ac5c-7e90f54d2f1b",
                                "sense_id": "c9a5515c-25d3-35dc-b65a-2b43b0ff617a",
                                "text": "Das Barthaar ist Teil der menschlichen Körperbehaarung."
                            },
                            {
                                "example_id": "37ecfd87-cda7-4d82-a19f-c35db9c0e853",
                                "sense_id": "c9a5515c-25d3-35dc-b65a-2b43b0ff617a",
                                "text": "„Der kraulte in seinen nach innen gebogenen Barthaaren und Tom fielen seine schmutzigen Fingernägel auf, die irgendwie gut zu seinen verschmierten Brillengläsern passten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ba39ca4-4eee-3da7-9329-2359cc0f971a",
                        "entry_id": "90acfb72-fe9a-3dca-99a9-718104df6718",
                        "glosses": [
                            "einzelnes Haar eines Bartes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c05d1d-f596-4dfa-bd1b-c1100d15994c",
                                "sense_id": "7ba39ca4-4eee-3da7-9329-2359cc0f971a",
                                "text": "Er riss sich ein Barthaar aus und betrachtete es unter der Lupe."
                            },
                            {
                                "example_id": "4038c385-289f-4322-b614-4baf373c1828",
                                "sense_id": "7ba39ca4-4eee-3da7-9329-2359cc0f971a",
                                "text": "„Sie überlegte, ob es die Barthaare waren, in denen sich das Grinsen verfangen hatte, und was im Falle einer Rasur mit dem Grinsen geschähe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f480e01d-889c-422c-b628-f95da9bcf794",
                        "source_entry_id": "90acfb72-fe9a-3dca-99a9-718104df6718",
                        "source_sense_id": "c9a5515c-25d3-35dc-b65a-2b43b0ff617a",
