                    "frequency": "High",
                    "semantic_group_id": "veraenderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Winter <w>fallen</w> die Temperaturen in den Bergen oft weit unter den Gefrierpunkt."
