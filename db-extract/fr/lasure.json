                                                "example_id": "61cc8672-0179-4ab1-81a7-9e836e6b42ba",
                                                "sense_id": "4bda0fdd-dd0d-3945-a08a-c627b5e9d1ff",
                                                "text": "of Honour void,\nOf Innocence, of Faith, of Puritie,\nOur wonted Ornaments now soild and staind"
                                            }
