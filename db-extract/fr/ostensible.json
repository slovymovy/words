                    }
                ],
                "senses": [
                    {
                        "sense_id": "b20552a3-9f65-3eea-a0d6-95e8576ff48a",
                        "entry_id": "65265360-59a1-30ee-a411-c7ad79a9fb57",
                        "glosses": [
                            "Qui est fait pour être montré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90eec00a-0376-405c-b2cf-820e5e00ed97",
                                "sense_id": "b20552a3-9f65-3eea-a0d6-95e8576ff48a",
                                "text": "Je mettrai mes fonds à la Banque de France et je reviendrai vous trouver en ne me donnant qu’une fortune ostensible d’environ un million en marchandises."
                            },
                            {
                                "example_id": "beb97beb-0ce0-4e00-858b-7deebbcc9bf5",
                                "sense_id": "b20552a3-9f65-3eea-a0d6-95e8576ff48a",
                                "text": "L'image d'un rituel funéraire congolais en milieu urbain semble dominée par l'expression d'un rapport de force entre acteurs. Les nantis cherchent à impressionner dans l'espace du deuil en montrant de façon ostensible, leur richesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cafe1d3-5f45-3e0e-ad36-7c0ffc011e6b",
                        "entry_id": "65265360-59a1-30ee-a411-c7ad79a9fb57",
                        "glosses": [
                            "Dont l'existence ou la réalité ne peut passer inaperçue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767bdf02-a702-4636-94f0-6addd3445038",
                                "sense_id": "6cafe1d3-5f45-3e0e-ad36-7c0ffc011e6b",
                                "text": "Dans ses recommandations, le rapport propose que les tenues et signes manifestant une appartenance religieuse ostensible (grand croix, voile ou kippa) chez les élèves, de même que les signes politiques, soient interdits; quant à eux, les signes religieux discrets sont acceptés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "452c07c3-7a20-46ca-8600-d15c699d121b",
                        "source_entry_id": "65265360-59a1-30ee-a411-c7ad79a9fb57",
                        "target_lang_word": "offensichtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offensichtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "dem Anschein nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e60d1e-ad13-4f2c-81fe-edec92866d25",
                                                "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                                "text": "Den Wolken nach zu urteilen, wird es offensichtlich regnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "für jeden erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ab0e9c-a524-4a5e-bf78-47a736cd6f2a",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "Es war offensichtlich, dass er gelogen hatte."
                                            },
                                            {
                                                "example_id": "f3761dd4-c271-4717-a207-45ed4e44513b",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Die offensichtlichen Mängel der Expertisen, so die Behörde heute, wären ganz sicher schon damals »in einem ‚Obergutachten‘ und/oder anderem Klageverfahren festgestellt worden«.“"
                                            },
                                            {
                                                "example_id": "36473f8d-c9a5-48b5-80d0-e0d958f80517",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Denn offensichtlich ist Schokolade für Frauen DER Glücklichmacher schlechthin, der in allen Variationen stets zuverlässig funktioniert.“"
                                            },
                                            {
                                                "example_id": "a6529f20-b446-4a31-82cd-7b7758b7593c",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63994c40-7f4d-4374-b349-e217d99e6194",
                        "source_entry_id": "65265360-59a1-30ee-a411-c7ad79a9fb57",
                        "target_lang_word": "auffällig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auffällig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                        "entry_id": "a8f0374e-c422-3466-85b4-d7a05e92065d",
                                        "glosses": [
                                            "die Aufmerksamkeit auf sich ziehend; Interesse erweckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28821eb-9e7c-4db8-b699-8ae75b659039",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "Die Frau war sehr auffällig und schrill gekleidet."
                                            },
                                            {
                                                "example_id": "ce774f61-ba04-44c5-ba7e-4f61e18f4112",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "Auffällig finde ich vor allem sein merkwürdiges Verhalten."
                                            },
                                            {
                                                "example_id": "3ec8342c-11a6-44bf-b134-1678ef25baab",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "„Bekleidet war er mit einer Baseballkappe mit auffälligem X-Emblem, einem schwarzen T-Shirt und einer schwarzen Hose, er trug einen roten Aktenkoffer.“"
                                            },
                                            {
                                                "example_id": "d87ad73a-a31a-4d93-a122-56e20aabf66d",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "„Während die Meeresspiegel fast unmerklich um etwa 3,4 Millimeter pro Jahr steigen, sind andere Klimakatastrophen weit aufälliger. Vor allem Hitze und Dürren nehmen zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "210d7cab-8dc6-4b98-88ca-866132312408",
                        "source_entry_id": "65265360-59a1-30ee-a411-c7ad79a9fb57",
                        "target_lang_word": "ostensible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ostensible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a51195a3-b61a-36f9-8943-c4162ef05c01",
                                        "entry_id": "4280c693-b57f-3bcb-b7e3-4c208cca9490",
                                        "glosses": [
                                            "Apparent, evident; meant for open display."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aca9c24b-d865-4de2-89c2-e742b715998e",
                                                "sense_id": "a51195a3-b61a-36f9-8943-c4162ef05c01",
                                                "text": "Motives, of course, may be mixed; but this only means that a man aims at a variety of goals by means of the same course of action. Similarly a man may have a strong motive or a weak one, an ulterior motive or an ostensible one."
                                            },
                                            {
                                                "example_id": "667bfc27-ea75-4bee-aa41-9fbe29ea2a93",
                                                "sense_id": "a51195a3-b61a-36f9-8943-c4162ef05c01",
                                                "text": "In witch-trials the conflict was officially defined as between the accused and God, or between the accused and the Catholic (later Protestant) church, as God's earthly representative. […] Behind the ostensible conflict of the witch-trial lay the usual conflicts of social class, values, and human relationships."
                                            },
                                            {
                                                "example_id": "da39337f-33e4-45d8-b310-d9ffaf4819d6",
                                                "sense_id": "a51195a3-b61a-36f9-8943-c4162ef05c01",
                                                "text": "The ostensible reason this provision was added to a bill on international trade is to combat the Boycott, Divestment and Sanctions movement, a grass-roots campaign that seeks to pressure Israel to change its policies toward the Palestinians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4250e66a-d501-3e05-8de0-5a915bcd4a9b",
                                        "entry_id": "4280c693-b57f-3bcb-b7e3-4c208cca9490",
                                        "glosses": [
                                            "Appearing as such; being such in appearance; professed, supposed (rather than demonstrably true or real)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9df74f-e2f4-499a-9cdb-e394ca655ead",
                                                "sense_id": "4250e66a-d501-3e05-8de0-5a915bcd4a9b",
                                                "text": "The ostensible reason for his visit to New York was to see his mother, but the real reason was to get to the Yankees game the next day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b77c53b7-6153-49d7-9065-53470096e25c",
                        "source_entry_id": "65265360-59a1-30ee-a411-c7ad79a9fb57",
