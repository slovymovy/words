                                "nl": "<w>Naast</w> de tram gebruiken we vaak de bus.",
                                "pl": "<w>Oprócz</w> tramwaju często korzystamy z autobusu.",
                                "fr": "<w>En plus du</w> tramway, nous utilisons souvent le bus.",
                                "it": "<w>Oltre al</w> tram, usiamo spesso l'autobus.",
                                "cs": "<w>Vedle</w> tramvaje často využíváme autobus.",
