                        "examples": [
                            {
                                "example_id": "7c11acf8-87e6-4849-a9fb-8a5abcb5b2a0",
                                "sense_id": "11e15bb1-e5d3-3390-ad6b-b29bffb55dd3",
                                "text": "Der CFO kündigte die Streichung von Arbeitsplätzen an, um Geld einzusparen."
                            },
                            {
                                "example_id": "80d65d45-ffac-48e7-899d-1f41ba0adc9f",
                                "sense_id": "11e15bb1-e5d3-3390-ad6b-b29bffb55dd3",
                                "text": "„Die CFO eines Familienunternehmens hat die größte Unternehmensakquisition der Unternehmensgeschichte durchgeboxt, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
