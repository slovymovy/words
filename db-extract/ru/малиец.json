                                    {
                                        "sense_id": "05ce01ea-ad03-37dc-a321-d2dd3ea67134",
                                        "entry_id": "197a4e7c-26be-3e8d-9d37-aa50c9246044",
                                        "glosses": [
                                            "Qui se rapporte au Mali, à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1a4eb3-5405-4aff-9f06-31770c1f1059",
                                                "sense_id": "05ce01ea-ad03-37dc-a321-d2dd3ea67134",
                                                "text": "Le 5 mai, impasse de la Statue, des éboueurs d’origine malienne trouvèrent parmi les poubelles de ce beau quartier, le corps de Girolamo Venezia, lui-même d’origine italienne."
                                            },
                                            {
                                                "example_id": "324995dc-be1d-40a8-831d-686a52078073",
                                                "sense_id": "05ce01ea-ad03-37dc-a321-d2dd3ea67134",
                                                "text": "Si ça lui chantait, et ça lui chantait, et ça lui chantait souvent, il pouvait être turc, chinois, berbère, pourquoi pas si ça lui plaisait, indonésien, malien, fuégien, que celui qui n’était pas d’accord le dise, sicilien, irlandais, ou, évidemment, français, ou allemand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
