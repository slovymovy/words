        "fr-extract.jsonl": [
            {
                "entry_id": "b3b45835-309f-3fea-8ac8-4e62f6dc7527",
                "word": "embaumement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8acfb58-5bee-41cd-bd70-922f345d8f0c",
                        "entry_id": "b3b45835-309f-3fea-8ac8-4e62f6dc7527",
                        "tags": [
                            "plural"
                        ],
                        "form": "embaumements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b79f9520-d553-3dcb-ba23-f9b1def03a19",
                        "entry_id": "b3b45835-309f-3fea-8ac8-4e62f6dc7527",
                        "glosses": [
                            "Action d’embaumer un corps mort."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "2496e28d-7e59-483b-9b90-1c5c1cd38023",
                                "sense_id": "b79f9520-d553-3dcb-ba23-f9b1def03a19",
                                "text": "Le visage était déjà marqué de larges taches violettes qui indiquaient la nécessité d’achever l’embaumement."
                            },
                            {
                                "example_id": "158d2c12-80dd-464d-9fc8-df65eac51160",
                                "sense_id": "b79f9520-d553-3dcb-ba23-f9b1def03a19",
                                "text": "Les cas d’embaumement fournissent enfin un spectre des plantes utilisées dans cette pratique, liant alors la symbolique et la pharmacopée."
                            },
                            {
                                "example_id": "034cd38c-3980-4091-8278-67c654480168",
                                "sense_id": "b79f9520-d553-3dcb-ba23-f9b1def03a19",
                                "text": "Les personnages royaux (Henri premier d’Angleterre, Louis XIV, Philippe le Hardi, par exemple) subissent l’embaumement qui consiste à remplir le cadavre éviscéré d’aromates tels que l’ambre, le miel, le musc, jusqu’aux obsèques."
                            },
                            {
                                "example_id": "d4e78900-5c53-44fb-9b58-b2d5497c5773",
                                "sense_id": "b79f9520-d553-3dcb-ba23-f9b1def03a19",
                                "text": "C'est lui qui invente le culte de Lénine, […], l’embaumement, les défilés de foules recueillies devant la momie peinte, semblable à une figure de cire, amenuisée par le travail des embaumeurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d386ab3d-f1a9-475f-8f46-24c677ac3d52",
                        "source_entry_id": "b3b45835-309f-3fea-8ac8-4e62f6dc7527",
                        "source_sense_id": "b79f9520-d553-3dcb-ba23-f9b1def03a19",
                        "target_lang_word": "balseming",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balseming",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                                        "entry_id": "c594124a-ae8a-343e-bd36-84172203061c",
                                        "glosses": [
                                            "handelingen die ervoor zorgen dat de stoffelijke overschotten van een levend wezen niet vergaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c512c2b-a61e-4f25-b9bb-d8d6741802da",
                                                "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                                                "text": "Thanatopracteur Jannette Wendels ontving gisteren haar diploma voor de opleiding 'lichte balseming'."
                                            },
                                            {
                                                "example_id": "6c63ecbb-2701-46dc-9f93-ea49a9192744",
                                                "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                                                "text": "In het zuidwesten van Saoedi-Arabië zijn sporen ontdekt van een 9000 jaar oude beschaving. Deze wordt al-Maqar genoemd, en kenmerkte zich onder meer door de domesticatie van paarden en balseming van doden, 'op een totaal verschillende manier' dan de procedés die tot dan bekend waren."
                                            },
                                            {
                                                "example_id": "504c1fef-5e62-47c3-94af-b6105a862836",
                                                "sense_id": "12ce9a78-61da-3af7-a96b-1163a5844767",
                                                "text": "Het schilderij met daarop de balseming van Christus is rond 1410-1420 vermoedelijk in Brugge gemaakt door een onbekende kunstenaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
