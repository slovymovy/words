                        "source_sense_id": "6850eea7-3565-35cc-ab1a-6523a6c46c98",
                        "target_lang_word": "Paléolithique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paléolithique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48e30b52-25af-334e-9ce7-0da4db692dd2",
                                        "entry_id": "840d30b4-b6de-3dc1-b139-450200ff6d03",
                                        "glosses": [
                                            "Première et plus longue période de la préhistoire, commençant avec l’apparition de l’Homme, il y a environ trois millions d’années et s’achevant vers 12 000 ans avant l’époque actuelle, caractérisée par l’usage de la pierre taillée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada04a36-949d-4595-95d6-9ec7ec963c49",
                                                "sense_id": "48e30b52-25af-334e-9ce7-0da4db692dd2",
                                                "text": "Le travail du métal était inconnu au Paléolithique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57bea524-58fd-3931-bbf5-39d0e85f772b",
                                        "entry_id": "840d30b4-b6de-3dc1-b139-450200ff6d03",
                                        "glosses": [
                                            "Individu ayant vécu à cette époque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d1a33f-3719-46f7-8ad5-9773e30e090e",
                                                "sense_id": "57bea524-58fd-3931-bbf5-39d0e85f772b",
                                                "text": "Le symbolisme du rouge est attesté avec une profusion suffisante dans le monde historique, il découle assez logiquement de lui-même pour qu’on puisse sans trop de réserves admettre que les Paléolithiques y attachaient la même valeur et l’introduisaient dans la fosse d’inhumation comme un symbole vital."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
