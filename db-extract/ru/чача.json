                ],
                "senses": [
                    {
                        "sense_id": "5c886a40-5948-31de-a9f2-57babfdb4022",
                        "entry_id": "61af71d1-439b-3aa7-8024-8327da774a87",
                        "glosses": [
                            "гастрон. грузинский крепкий спиртной напиток из класса виноградных бренди"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38004bf-4472-4033-88c3-2f1e08848d9f",
                                "sense_id": "5c886a40-5948-31de-a9f2-57babfdb4022",
                                "text": "Блестела кахетинская прозрачная чача в огромных бутылях-боцах, светился янтарный коньячный спирт, пузатились бутыли с вином."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c418d5d-65c3-42d6-9c3f-cfe6198896f3",
                        "source_entry_id": "61af71d1-439b-3aa7-8024-8327da774a87",
                        "source_sense_id": "5c886a40-5948-31de-a9f2-57babfdb4022",
                        "target_lang_word": "tchatcha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tchatcha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f90893-50ba-3bac-a95d-fbdd910a332e",
                                        "entry_id": "15962916-bfa3-363d-b5b5-0eb5fb48bf64",
                                        "glosses": [
                                            "Marc traditionnel géorgien à base de raisin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a6934ac-5ed3-41c0-87ed-a7ead7a59490",
                                                "sense_id": "e6f90893-50ba-3bac-a95d-fbdd910a332e",
                                                "text": "Vous ne faites quand même pas une rétrospective géante des photos de Dina sans vodka ni tchatcha ? demande Nene en secouant la tête et en esquissant un sourire ambigu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tchatcha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee75a9f4-8a0d-382f-9b41-a8370631b169",
                                        "entry_id": "dda6dffe-f55c-3a78-bc73-ac2000e4b90a",
                                        "glosses": [
                                            "(Ardennes wallonnes) Grive litorne (Turdus pilaris)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c3fc075-8f7d-4828-b1f8-254df0b66e92",
                                                "sense_id": "ee75a9f4-8a0d-382f-9b41-a8370631b169",
                                                "text": "Mais revenons aux grives : les quatre espèces passaient à travers les Ardennes, deux grandes, la draine et la litorne (appelée ici la « Tchatcha » par une harmonie imitative parfaite) et deux plus petites, la mauvis (ici roussette) et la musicienne (ici la blanche) ; les migrations étaient souvent très imbriquées et l’on pouvait espérer trouver encore quelques grives tous les jours ; […]."
                                            },
                                            {
                                                "example_id": "a3498359-e785-4e11-83c8-079980b6e435",
                                                "sense_id": "ee75a9f4-8a0d-382f-9b41-a8370631b169",
                                                "text": "Les petites gens eux, besogneux et si méritants, pour qui le passage des roussettes , des « tchatchas » et des draines était l’aubaine annuelle, quel tort n’allaient-ils pas subir ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tchatcha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa503f2b-d972-307b-aebd-6ca343bc0dee",
                                        "entry_id": "01fc3329-af83-3284-bcd8-3a5b17572b38",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple du verbe tchatcher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5150f26-1aa0-4949-9357-a864b6c6fdc7",
                        "source_entry_id": "61af71d1-439b-3aa7-8024-8327da774a87",
                        "source_sense_id": "5c886a40-5948-31de-a9f2-57babfdb4022",
