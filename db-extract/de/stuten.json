                                        "entry_id": "fe89dc44-0437-3049-a25e-7de3e5d67c4b",
                                        "glosses": [
                                            "groep mensen of dieren die in een lange rij in een bepaalde richting verplaatsen"
                                        ],
                                        "tags": [],
