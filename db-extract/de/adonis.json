                    {
                        "sense_id": "1fddc341-052c-3925-8852-8647ec34a493",
                        "entry_id": "7b103a19-39e2-302a-af06-be9b45ddfc6a",
                        "glosses": [
                            "Jüngling von großer Schönheit und Geliebter der Aphrodite"
                        ],
                        "tags": [
                            "griechische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3c244fd6-5adc-478b-9806-b41ba9e9deae",
                                "sense_id": "1fddc341-052c-3925-8852-8647ec34a493",
                                "text": "„Doch daraus entstand neuer Hader. Denn bei den Toten in der Unterwelt geriet Adonis in die Fänge von Aphrodites Schwester Persephone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
