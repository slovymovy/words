        "fr-extract.jsonl": [
            {
                "entry_id": "a5ce31ca-21a9-3f6e-abf3-72e5ec5b07af",
                "word": "cré",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                        "entry_id": "a5ce31ca-21a9-3f6e-abf3-72e5ec5b07af",
                        "glosses": [
                            "Interjection, pour « sacré »."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3e028886-1000-4290-83ba-68afa5cad480",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "Cré vin dieu !"
                            },
                            {
                                "example_id": "f847e0d1-5493-46b9-bbf5-dc4598600d11",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "Justin. – (Il éternue.) Cré rhume !… ça me tient dans le cerveau !"
                            },
                            {
                                "example_id": "68725863-9e36-449c-8ee3-26232aaaf49f",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "— Cré mille tonnerres ! fit de Raittolbe exaspéré."
                            },
                            {
                                "example_id": "e9e552a4-b831-49f5-b483-b438641aaa2a",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "— Cré nom d’une sabretache ! C’est que cette hystérique finira par vous épouser malgré vous, je la connais."
                            },
                            {
                                "example_id": "1f7bf126-3515-46f8-bee0-01f042c17ffa",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "Il murmurait : « Cré coquin ! » et il la regardait avec admiration, pris d’un respect, d’une affection tout autre, d’un commencement d’amour vrai pour cette grande gaillarde si solide."
                            },
                            {
                                "example_id": "6e9c3129-9a2c-4f95-81f2-e57ebb39766e",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "Pinchard. — Cré coquin ! t’es rudement bien !"
                            },
                            {
                                "example_id": "c487cdd2-0967-41b6-8355-ede533bde1e1",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "Ah ! cré bon sang, tu refuses les bijoux. Eh bien ma petite…"
                            },
                            {
                                "example_id": "7ba651f4-f974-42eb-836b-3a4257418abe",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "Il s’approcha du comptoir en bougonnant :\n– Cré bateau, ça va mal en Norvège!"
                            },
                            {
                                "example_id": "28cfd3d0-d774-42c0-85e9-9d209cd4bd77",
                                "sense_id": "f3cd9a91-f5ab-392a-bb12-6192432907e4",
                                "text": "Après l’émotion, on plastronne : on les a presque vus ! Si on était allé cent mètres plus loin, on se butait dans eux, cré vains dieux !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
