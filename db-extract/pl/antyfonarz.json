                    {
                        "translation_id": "0f27e311-8778-4179-bd3a-dfafe98eae89",
                        "source_entry_id": "5d03fe83-43eb-3f37-b0d8-7f1fb70fc468",
                        "source_sense_id": "cd8f9ec0-a81e-3931-80df-38f600043d86",
                        "target_lang_word": "antifonář",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
