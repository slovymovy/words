                        "entry_id": "1c625897-a5eb-3c6c-81fb-da36fabc9391",
                        "glosses": [
                            "(männliche^☆) Person oder eine Mannschaft, die aufgrund ihrer (schlechten) Leistungen womöglich demnächst in eine niedrigere Liga wechseln muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e514396-1f03-4f2a-af3c-c73086090af5",
                                "sense_id": "ce411436-ca9e-363c-b0b1-ad50fa30038b",
                                "text": "„Das dürftige 2:2 gegen Abstiegskandidat Mainz katapultierte Team und Verein endgültig in eine Stimmungskrise – und das ausgerechnet vor dem eminent wichtigen Spiel im Pokalhalbfinale gegen Dortmund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19ddd559-5882-33ae-ad42-69793711c93d",
                        "entry_id": "1c625897-a5eb-3c6c-81fb-da36fabc9391",
                        "glosses": [
                            "(männliche^☆) Person oder eine Organisation, deren gesellschaftliches, berufliches Ansehen oder Ähnliches abzunehmen droht"
                        ],
                        "tags": [
                            "casual",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b007c13a-28cf-421a-a74c-fa2c94271e3a",
                                "sense_id": "19ddd559-5882-33ae-ad42-69793711c93d",
                                "text": "Der Minister will nicht akzeptieren, dass er jetzt als potentieller Abstiegskandidat angesehen wird."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
