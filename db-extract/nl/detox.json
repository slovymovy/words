                    {
                        "sense_id": "5088db0b-5b0e-30a1-bf68-b3b8dd68c4da",
                        "entry_id": "3d5a4cc1-3567-3e9e-8295-ea9f9e7feb96",
                        "glosses": [
                            "ontgiftingskuur, ontwenningskuur"
