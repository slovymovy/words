                "senses": [
                    {
                        "sense_id": "8b734598-502f-3035-abb4-44220df1d249",
                        "entry_id": "b6992fa3-45c6-33d4-b879-ea8a097a8e39",
                        "glosses": [
                            "Fehlbildung am Herzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e18c8150-6fcf-497f-ad20-7498c915b6f1",
                                "sense_id": "8b734598-502f-3035-abb4-44220df1d249",
                                "text": "„Nun war es so, dass die Kleine einen seltenen Herzfehler hatte.“"
                            },
                            {
                                "example_id": "32d0cf00-661b-4d89-8997-94d837180cc9",
                                "sense_id": "8b734598-502f-3035-abb4-44220df1d249",
                                "text": "„Erst wurde bei der Klara ein Herzfehler festgestellt, dann starb Pepinas Vater.“"
                            },
                            {
                                "example_id": "3113770a-6d59-4952-ae94-4f9433693c06",
                                "sense_id": "8b734598-502f-3035-abb4-44220df1d249",
                                "text": "„In der Schule hatte er Schwächen in Grammatik und Orthographie, dem Kriegsdienst entging er wegen eines angeblichen Herzfehlers, aber schon sein ersten Stück »Die Stunde der Sterbenden« behandelt ein Kriegsthema.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
