                                        "glosses": [
                                            "Casual pants or trousers, usually for women, with the bottom hem reaching to below the knee but above the ankle (at midcalf, more or less); usually lightweight and summery."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dee18a9d-85cc-4474-bfd8-282ece13e062",
                                                "sense_id": "713e11ca-3c80-3b61-8625-a5ebc4b48888",
                                                "text": "I see women wearing capri pants nearly every day; they're not as bad as cargo capris, but they aren't the capri pants of Grace Kelly and Audrey Hepburn, either. Those 1960s capri pants were fitted."
                                            }
                                        ]
                                    }
