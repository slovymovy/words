                "forms": [
                    {
                        "form_id": "daea89fc-d10c-42d6-a5c4-8d730e589b24",
                        "entry_id": "568f8581-5971-34d8-a0e5-d16c0d9d1672",
                        "tags": [
                            "plural"
                        ],
                        "form": "nigs"
