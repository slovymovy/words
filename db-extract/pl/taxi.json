                                                "text": "taxi down the runway"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3645bf1f-8ab7-3ff1-8d5b-e75697e4b96d",
                                        "entry_id": "25e4da0c-2cc0-388f-9225-6f7b7a4603c7",
