{
    "word_family": [
        "train",
        "training",
        "trainable",
        "retrain",
        "trainee"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd887323-07f8-3019-95d9-58e2e79e7f44",
                    "sense_definition": "A comfortable shoe designed for sports or informal wear.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a new pair of <w>trainers</w> for my running sessions.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новую пару <w>кроссовок</w> для пробежек."
                            }
                        },
                        {
                            "text": "He wore a white <w>trainer</w> on each foot and a tracksuit.",
                            "target_lang_translations": {
                                "ru": "На каждой ноге у него было по белому <w>кроссовку</w>, и он был одет в спортивный костюм."
                            }
                        }
                    ],
                    "synonyms": [
                        "running shoe",
                        "tennis shoe",
                        "sports shoe"
                    ],
                    "common_phrases": [
                        "pair of trainers",
                        "white trainers",
                        "running trainers"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удобная обувь, предназначенная для занятий спортом или повседневной носки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроссовки",
                                "target_lang_sense_clarification": "спортивная обувь для бега или ходьбы"
                            },
                            {
                                "target_lang_word": "кеды",
                                "target_lang_sense_clarification": "легкая спортивная обувь на плоской подошве"
                            },
                            {
                                "target_lang_word": "сникеры",
                                "target_lang_sense_clarification": "повседневная обувь в спортивном стиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd3433c6-ca53-3ffd-8a39-a26cdc0ce3ea",
                    "sense_definition": "A person who teaches skills or helps people and animals to prepare for a sport or activity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "instructor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fitness <w>trainer</w> showed me how to use the gym equipment correctly.",
                            "target_lang_translations": {
                                "ru": "Фитнес-<w>тренер</w> показал мне, как правильно пользоваться тренажерами."
                            }
                        },
                        {
                            "text": "A professional <w>trainer</w> helps the athlete improve their performance every day.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>тренер</w> ежедневно помогает атлету улучшать свои результаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "coach"
                    ],
                    "common_phrases": [
                        "fitness trainer",
                        "personal trainer",
                        "dog trainer",
                        "athletic trainer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который обучает навыкам или помогает людям и животным подготовиться к спортивным соревнованиям или определенной деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тренер",
                                "target_lang_sense_clarification": "специалист по подготовке спортсменов или животных"
                            },
                            {
                                "target_lang_word": "инструктор",
                                "target_lang_sense_clarification": "человек, обучающий технике выполнения упражнений"
                            },
                            {
                                "target_lang_word": "дрессировщик",
                                "target_lang_sense_clarification": "специалист по обучению животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd472512-4aa7-398c-8e2f-090dddda617a",
                    "sense_definition": "A person responsible for treating minor injuries sustained by players during a match.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team <w>trainer</w> ran onto the pitch to check on the injured player.",
                            "target_lang_translations": {
                                "ru": "<w>Массажист</w> команды выбежал на поле, чтобы осмотреть травмированного игрока."
                            }
                        },
                        {
                            "text": "After the collision, the <w>trainer</w> applied ice to the player's ankle.",
                            "target_lang_translations": {
                                "ru": "После столкновения <w>врач</w> приложил лед к лодыжке игрока."
                            }
                        }
                    ],
                    "common_phrases": [
                        "team trainer",
                        "medical trainer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, ответственный за оказание помощи при незначительных травмах, полученных игроками во время матча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "массажист",
                                "target_lang_sense_clarification": "в спортивной команде часто выполняет функции по оказанию первой помощи"
                            },
                            {
                                "target_lang_word": "спортивный врач",
                                "target_lang_sense_clarification": "медицинский специалист в команде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e267b37b-d49c-384b-b257-75fc8d9c1c90",
                    "sense_definition": "A piece of equipment that allows a bicycle to be ridden while remaining in one place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exercise_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since it was raining outside, he set up his bike on the indoor <w>trainer</w>.",
                            "target_lang_translations": {
                                "ru": "Так как на улице шел дождь, он установил велосипед на домашний <w>велостанок</w>."
                            }
                        },
                        {
                            "text": "Using a bicycle <w>trainer</w> is a great way to stay fit during the winter.",
                            "target_lang_translations": {
                                "ru": "Использование <w>велотренажера</w> — отличный способ поддерживать форму зимой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bicycle trainer",
                        "indoor trainer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оборудование, позволяющее ездить на велосипеде, оставаясь на одном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "велостанок",
                                "target_lang_sense_clarification": "устройство для тренировок на обычном велосипеде в помещении"
                            },
                            {
                                "target_lang_word": "велотренажер",
                                "target_lang_sense_clarification": "общее название для стационарных велосипедов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88fe6bc5-99d2-3681-8dee-d43575325566",
                    "sense_definition": "A program or patch for a video game that allows players to use cheats.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "software",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He downloaded a game <w>trainer</w> to get infinite health in the single-player mode.",
                            "target_lang_translations": {
                                "ru": "Он скачал игровой <w>трейнер</w>, чтобы получить бесконечное здоровье в одиночном режиме."
                            }
                        },
                        {
                            "text": "Some players prefer using a <w>trainer</w> to skip difficult levels in the game.",
                            "target_lang_translations": {
                                "ru": "Некоторые игроки предпочитают использовать <w>трейнер</w>, чтобы пропускать сложные уровни в игре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "game trainer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Программа или патч для видеоигры, позволяющие игрокам использовать чит-коды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трейнер",
                                "target_lang_sense_clarification": "программа для взлома параметров игры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}