                "translations": [
                    {
                        "translation_id": "b004d635-a1fc-43ec-b1eb-3734805c3f11",
                        "source_entry_id": "93666dd0-68ec-3eec-8cb3-b47315feef2f",
                        "target_lang_word": "monopolistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monopolistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "243551cb-c5cf-3075-8b32-2ebc7da1c76a",
                                        "entry_id": "16b044bc-ea24-3288-b0c4-beaaef320ce9",
                                        "glosses": [
                                            "Acting in the manner of a monopoly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86838ca8-3dba-4118-9dc4-d7643bbc8186",
                                                "sense_id": "243551cb-c5cf-3075-8b32-2ebc7da1c76a",
                                                "text": "The antitrust laws try to prevent monopolistic behavior."
                                            },
                                            {
                                                "example_id": "a50c373e-4e26-4c88-affa-3f3b3a3e18aa",
                                                "sense_id": "243551cb-c5cf-3075-8b32-2ebc7da1c76a",
                                                "text": "There was a prevailing fear of the effect of large undertakings becoming monopolistic, and Parliament showed itself unwilling to sanction any large groupings."
                                            },
                                            {
                                                "example_id": "a8ce035a-3f8c-4d49-b9d3-802463e96aa8",
                                                "sense_id": "243551cb-c5cf-3075-8b32-2ebc7da1c76a",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            },
                                            {
                                                "example_id": "4ca45a15-5583-4925-bbda-8f2485dca2e4",
                                                "sense_id": "243551cb-c5cf-3075-8b32-2ebc7da1c76a",
                                                "text": "Dominguez-González explained: \"The Spanish market is no longer a monopolistic one, and there is great interest among both the existing open access operators and potential future ones in providing services on other lines.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
