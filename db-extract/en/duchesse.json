                    {
                        "sense_id": "69625ef0-0d29-38fb-8718-062b1daff676",
                        "entry_id": "77ae8bc3-bedc-3988-a3c6-33496052da2e",
                        "glosses": [
                            "A French duchess."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "5033d58c-192f-47df-94bb-b9ef0a8af2ac",
                                "sense_id": "69625ef0-0d29-38fb-8718-062b1daff676",
                                "text": "Ary Scheffer, the drawing-master of the young Orleans princesses, offered to go with Thiers and procure him an audience of the duc or duchesse, or Madame Adélaïde."
                            },
                            {
                                "example_id": "cb1d6e17-ff3f-4ed6-b286-be0f536208f9",
                                "sense_id": "69625ef0-0d29-38fb-8718-062b1daff676",
                                "text": "“[T]hat little violet [La Vallière], who hid herself in the grass, and was ashamed of being a mistress, a mother, and a duchesse; that will never be the model.”—Mme de Sévigné."
                            },
                            {
                                "example_id": "54938eac-6a2d-451b-8ca1-68207ea59767",
                                "sense_id": "69625ef0-0d29-38fb-8718-062b1daff676",
                                "text": "Among the guests are Léon Bourgeois, president of the Chamber of Deputies, the Italian, German and Russian ambassadors, comtesse Greffulhe, the grande-duchesse Vladimir with comtesse Adhéaume de Chevigné, several comtes, comtesses, ducs and duchesses, […]"
                            },
                            {
                                "example_id": "2eb6fde0-a83c-4791-ac2c-c10b5b9d3b2f",
                                "sense_id": "69625ef0-0d29-38fb-8718-062b1daff676",
                                "text": "She was the eighth child of the duc and duchesse of Enghien and, as a member of the reigning Bourbon house, was styled a princesse du sang, or princess of the blood."
                            }
                        ]
                    },
                    {
                        "sense_id": "45202f61-d89f-3855-b3be-c0fa8e4bd25d",
                        "entry_id": "77ae8bc3-bedc-3988-a3c6-33496052da2e",
                        "glosses": [
                            "A type of dressing table with a swing glass."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "a7f0e9bc-fae0-4da5-980c-bc9e054136fb",
                                "sense_id": "45202f61-d89f-3855-b3be-c0fa8e4bd25d",
                                "text": "One morning, during my first week at school, I sneaked into Mum and Dad's bedroom, opened the top drawer of the duchesse, where the coins ‘brought back from the war’ were kept, and helped myself to a handful."
                            }
