                    {
                        "translation_id": "8e5b0276-5ffd-41dc-ab33-355bddcab208",
                        "source_entry_id": "df871acf-d04f-3956-8db7-87c007f34993",
                        "source_sense_id": "4328bf7a-650e-30d2-8189-6b0432137bc0",
                        "target_lang_word": "φέσι",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "φέσι",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "a869f556-b578-3146-9cfe-4358e50319dc",
                                        "entry_id": "edb3fa9a-67d3-36f3-bbdd-9af95bc5c06f",
                                        "glosses": [
                                            "είδος κόκκινου καπέλου, άλλοτε επίσημου στην οθωμανική αυτοκρατορία, την Αίγυπτο, τη Τυνησία και το Μαρόκο (λευκό)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15061f5a-1656-4d4d-9919-5ca68da92005",
                                                "sense_id": "a869f556-b578-3146-9cfe-4358e50319dc",
                                                "text": "※ Ακριτικό τραγούδι από τη Δ. Μακεδονία, ※ ebooks.edu.gr Νέα Ελληνικά Β' ΕΠΑ.Λ. Γενικής Παιδείας, ημερομηνία ανάκτησης: 24-12-2024",
                                                "translation": "Λεβέντης εροβόλησε από ψηλή ραχούλα\nΒαστάει το φέσι χαμηλά και τον τσιαμπά κλωσμένο\nΣτη στράτα όπου πήγαινε, στη στράτα όπου πηγαίνει\nτο γέρο-χάρο σταύρωνε και τον καλημερνούσε"
                                            },
                                            {
                                                "example_id": "a04f01d2-2b4d-4e2f-8d93-364d38efac9c",
                                                "sense_id": "a869f556-b578-3146-9cfe-4358e50319dc",
                                                "text": "※ Κατάρα σ' ὅ,τι κάλυμμα ἡ κεφαλὴ φορέσῃ,"
                                            },
                                            {
                                                "example_id": "7d137a7c-51d3-4856-a54e-347164b2f565",
                                                "sense_id": "a869f556-b578-3146-9cfe-4358e50319dc",
                                                "text": "ψηλὸ καπέλο ψάθινο, καστόρι, σκούφια, φέσι,"
                                            },
                                            {
                                                "example_id": "457497fb-4f52-4233-995b-442ea811226d",
                                                "sense_id": "a869f556-b578-3146-9cfe-4358e50319dc",
                                                "text": "κι' εἰς ὅ,τι τὰ ποδάρια μας κοσμεῖ καὶ περιβάλλει,"
                                            },
                                            {
                                                "example_id": "896697fd-b207-43e3-9bd4-229b35ad4c50",
                                                "sense_id": "a869f556-b578-3146-9cfe-4358e50319dc",
                                                "text": "παντοῦφλα, καραμάντουλο, τσαροῦχι καὶ στιβάλι.",
                                                "translation": "(Γεώργιος Σουρής (1853 - 1919), Ο Φασουλής φιλόσοφος, Μέρος Γ')"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "035d719a-de85-33de-9c31-d16e29bfd410",
                                        "entry_id": "edb3fa9a-67d3-36f3-bbdd-9af95bc5c06f",
                                        "glosses": [
                                            "είδος κόκκινου σκούφου με φούντα που έφεραν παλαιότερα άνδρες και γυναίκες και που συνεχίζουν να φέρουν οι τσολιάδες"
                                        ],
                                        "tags": [
                                            "ενδυμασία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a1c4d3-b02c-4d4d-badf-3b776b7b2ad1",
                                                "sense_id": "035d719a-de85-33de-9c31-d16e29bfd410",
                                                "text": "※ στὴν κεφαλὴ μ’ ἕνα φέσι μεγάλο, τσακισμένο πίσω μὲ μακρυὰ φούντα καὶ δεμένο μὲ μαντῆλι χρωματιστό, κεντημένο γύρω γύρω μὲ μπιμπίλες σὰν γυναῖκα. (Παναγιώτης Αξιώτης, Διηγήματα, Ο Παππά Συνέσιος, 1899)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7db8bbe-1a5c-3fcf-b692-7a22f2dcc076",
                                        "entry_id": "edb3fa9a-67d3-36f3-bbdd-9af95bc5c06f",
                                        "glosses": [
                                            "μεγάλο χρέος που αφήνει κάποιος ανεξόφλητο"
                                        ],
