                    {
                        "form_id": "a2546429-bd99-4e64-b564-6bec49282dff",
                        "entry_id": "6f250058-1afc-3dda-bea8-6be5f16dba80",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bougainvilleen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7ffec21-153f-3342-960a-c6ac1dcd479e",
                        "entry_id": "6f250058-1afc-3dda-bea8-6be5f16dba80",
                        "glosses": [
                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb7a55d-7be4-42a6-9d28-00dde0aa3ea8",
                                "sense_id": "b7ffec21-153f-3342-960a-c6ac1dcd479e",
                                "text": "„Im Garten wachsen Pflanzen aller fünf Kontinente, hauptsächlich Kakteen und Bougainvilleen, weil die das ganze Jahr über schön anzusehen sind.“"
                            },
                            {
                                "example_id": "82fd6d7b-f283-495a-818c-049ac0a96fcf",
                                "sense_id": "b7ffec21-153f-3342-960a-c6ac1dcd479e",
                                "text": "„Ich bin hingerissen von dem Zauber dieses Viertels, mit seinen steilen Treppen, den üppigen rosa Bougainvilleen, die sich wie Wasserfälle über die teils farbigen Gemäuer ergießen.“"
                            },
                            {
                                "example_id": "f267d136-d8ba-4d2e-8bfb-b969511a554b",
                                "sense_id": "b7ffec21-153f-3342-960a-c6ac1dcd479e",
                                "text": "„Der Bischof saß still auf der Bank unter dem hölzernen Vorbau vor dem Eingang, seine Gewänder waren über und über mit den Ranken der Bougainvilleen bedeckt.“"
                            },
                            {
                                "example_id": "044f9a1e-869d-4608-89ea-1feeddf24a52",
                                "sense_id": "b7ffec21-153f-3342-960a-c6ac1dcd479e",
                                "text": "„Der Brunnen ist umgeben von Bougainvilleen und Oleanderbüschen, deren Blütenrot so kraftvoll leuchtet, dass es in den Augen beinahe schmerzt.“"
                            },
                            {
                                "example_id": "2a140055-fded-4d4b-ab36-6768d5bad9b8",
                                "sense_id": "b7ffec21-153f-3342-960a-c6ac1dcd479e",
                                "text": "„Der echte Pool, der, der diesen Namen verdient, muss in die Erde eingelassen sein, von Oleanderbüschen gesäumt, von Bougainvilleen umrankt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
