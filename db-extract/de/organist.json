                    {
                        "translation_id": "339fca56-a61d-4dda-82f9-d664ed977e6a",
                        "source_entry_id": "af2198a0-d739-3ea9-90b8-2864f13801c5",
                        "source_sense_id": "56c2ebad-d006-33b5-8825-d820facaf8c9",
