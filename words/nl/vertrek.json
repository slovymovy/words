                {
                    "sense_id": "f32a1ece-0ac1-3c3c-8d88-909c327b229b",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>vertrekken</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vertrek</w> morgenochtend heel vroeg naar mijn werk.",
                            "target_lang_translations": {
                                "en": "I <w>leave</w> very early tomorrow morning for work.",
                                "ru": "Я <w>выезжаю</w> на работу завтра рано утром.",
                                "pl": "Jutro rano bardzo wcześnie <w>wychodzę</w> do pracy.",
                                "de": "Ich <w>fahre</w> morgen früh sehr zeitig zur Arbeit <w>los</w>.",
                                "fr": "Je <w>pars</w> très tôt demain matin pour le travail.",
                                "it": "Domattina <w>parto</w> molto presto per andare al lavoro.",
                                "cs": "Zítra ráno <w>odcházím</w> do práce velmi brzy.",
                                "tr": "Yarın sabah işe çok erken <w>gidiyorum</w>.",
                                "es": "Mañana por la mañana <w>salgo</w> muy temprano para el trabajo."
                            }
                        },
                        {
                            "text": "Als het regent, <w>vertrek</w> ik liever met de auto dan met de fiets.",
                            "target_lang_translations": {
                                "en": "If it rains, I prefer to <w>leave</w> by car rather than by bike.",
                                "ru": "Если идет дождь, я предпочитаю <w>выезжать</w> на машине, а не на велосипеде.",
                                "pl": "Jeśli pada deszcz, wolę <w>jechać</w> samochodem niż rowerem.",
                                "de": "Wenn es regnet, <w>fahre</w> ich lieber mit dem Auto als mit dem Fahrrad <w>ab</w>.",
                                "fr": "S'il pleut, je <w>pars</w> plutôt en voiture qu'à vélo.",
                                "it": "Se piove, preferisco <w>partire</w> in macchina piuttosto che in bicicletta.",
                                "cs": "Pokud prší, <w>odjíždím</w> raději autem než na kole.",
                                "tr": "Yağmur yağarsa, bisiklet yerine arabayla <w>yola çıkmayı</w> tercih ederim.",
                                "es": "Si llueve, prefiero <w>irme</w> en coche que en bicicleta."
