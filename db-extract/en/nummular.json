                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8dfd29f9-e86e-3204-8d5a-77ecd77d7880",
                        "entry_id": "7e4fbd82-fe75-3b41-9a3a-6cfcb75b9af7",
                        "glosses": [
                            "Flattened with a rounded form, as a disc; coin-shaped.",
                            "Characterized by lesions (especially on the cornea or skin) which are round with well-defined borders."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4c043ec6-0b95-325b-9743-facd00cdce4f",
                        "entry_id": "7e4fbd82-fe75-3b41-9a3a-6cfcb75b9af7",
                        "glosses": [
                            "Flattened with a rounded form, as a disc; coin-shaped.",
                            "Of sputum: forming flat, round shapes (formerly thought to be a symptom of tuberculosis)."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e4340ee3-1181-4646-859c-d6ddb99ca8b9",
                                "sense_id": "4c043ec6-0b95-325b-9743-facd00cdce4f",
                                "text": "NUMMULAR […] An epithet applied to the sputa in phthisis, when they flatten at the bottom of the vessel, like a piece of money."
                            }
                        ]
                    }
                ],
                "translations": [
