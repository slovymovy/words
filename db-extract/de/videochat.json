                                "example_id": "a57ff996-8527-4962-9066-d32bb101b03b",
                                "sense_id": "4b2d599f-2cac-3ef7-bde6-ac5e808e655f",
                                "text": "„Eine neue App will mit zufälligen Videochats dafür sorgen, dass das Netzwerk wieder Spaß macht. Airtime soll fremde Menschen einander näherbringen - ganz ohne Penisse.“"
                            }
