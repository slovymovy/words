                "word": "Swaziland",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f920a1f3-7b11-3e6a-8748-6ccba396be36",
                        "entry_id": "9fd0818c-2ae0-391e-92d8-75baeeee8c85",
                        "glosses": [
                            "Pays situé en Afrique australe, entre l’Afrique du Sud et le Mozambique. Il a pour capitales Mbabane et Lobamba."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a961cd57-dacf-498f-9829-3123bb612642",
                        "source_entry_id": "9fd0818c-2ae0-391e-92d8-75baeeee8c85",
                        "source_sense_id": "f920a1f3-7b11-3e6a-8748-6ccba396be36",
                        "target_lang_word": "Swasiland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Swasiland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f88f43d7-b0f7-3ce5-a10e-91e87d9fb669",
                                        "entry_id": "ac963137-cb80-3358-a04f-8a2e487c84f2",
                                        "glosses": [
                                            "bis 2018 Staat im südlichen Afrika"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84d6ba5-6d76-466b-83a6-2f210751fec7",
                                                "sense_id": "f88f43d7-b0f7-3ce5-a10e-91e87d9fb669",
                                                "text": "„Der höchste Punkt Swasilands ist der 1.862 m hohe Emlembe im Nordwesten an der Grenze zu Südafrika.“"
                                            },
                                            {
                                                "example_id": "d55fb27f-b1c7-4665-a28e-82b0c29b1383",
                                                "sense_id": "f88f43d7-b0f7-3ce5-a10e-91e87d9fb669",
                                                "text": "Mbabane ist die Hauptstadt von Swasiland."
                                            },
                                            {
                                                "example_id": "96ee88fa-a48f-4bea-bb64-93e3ede8c480",
                                                "sense_id": "f88f43d7-b0f7-3ce5-a10e-91e87d9fb669",
                                                "text": "Das heutige Swasiland ist durch die hohe Rate der HIV-Infektionen geprägt."
                                            },
                                            {
                                                "example_id": "3ca3f325-deef-4c96-88bf-a16b611e3dfa",
                                                "sense_id": "f88f43d7-b0f7-3ce5-a10e-91e87d9fb669",
                                                "text": "„Swasiland, das nach Gambia kleinste Land des afrikanischen Kontinents, ist ein kleiner Binnenstaat im südöstlichen Afrika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
