                    {
                        "translation_id": "0abd7f4a-9d8d-4f7b-b325-2b01c4da9626",
                        "source_entry_id": "11bb6e88-474d-3987-9fb2-f22458bafff6",
                        "source_sense_id": "9b3c17df-7543-31d1-a445-698ff005402d",
                        "target_lang_word": "Lyon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lyon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                        "entry_id": "9cdf7499-eaa6-3b2c-93a1-7957e9d1aae4",
                                        "glosses": [
                                            "südostfranzösische Großstadt am Zusammenfluss der Rhone und der Saône"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929acff7-6661-420d-8655-2a4aba68686c",
                                                "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                                "text": "„Sie drohten mit Kapitalflucht, in diesem Fall mit Abwanderung nach Lyon.“"
                                            },
                                            {
                                                "example_id": "9e65a3e9-b42d-4346-8a30-d6f8361aaa5d",
                                                "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                                "text": "Pierre stammt aus Lyon."
                                            },
                                            {
                                                "example_id": "fec74c20-ae53-40f8-968b-91de20423cfb",
                                                "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                                "text": "Ziehst Du bald wieder nach Lyon zurück?"
                                            },
                                            {
                                                "example_id": "1135aed3-6024-4864-b4f1-584a39747cc9",
                                                "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                                "text": "Gibt es in Lyon eine Trabrennbahn?"
                                            },
                                            {
                                                "example_id": "a41cdabc-0f2c-4f18-9736-e3ae3e3f4ceb",
                                                "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                                "text": "„Wir reisten ab und gelangten in fünf Tagen nach Lyon, wo ich eine Woche blieb. Lyon ist eine sehr schöne Stadt, wo zu meiner Zeit keine drei oder vier adligen Häuser den Fremden offen standen, dafür fand man aber bei den Kaufleuten, Fabrikanten und Großhändlern, die viel reicher waren als die Adligen die beste Aufnahme, und die Gesellschaft lebt dort auf einem ausgezeichneten Fuß.“"
                                            },
                                            {
                                                "example_id": "db909a40-dff2-4586-80aa-c7da5ba96315",
                                                "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                                "text": "„Wir verabredeten uns für den nächsten Tag und entschieden uns dann für den Expresszug nach Lyon, der morgens abfuhr.“"
                                            },
                                            {
                                                "example_id": "bcd4108a-63f1-481f-b428-2a2e16f6f304",
                                                "sense_id": "7571d7e4-198f-37a2-93f8-68bb4317c510",
                                                "text": "„Einige Monate nach diesem Gespräch schickte Eiríkur seinen Großeltern ein Foto von sich und Tove, auf dem sie vor einem Restaurant auf einem in Sonnenlicht badenden Platz in Lyon lachend und offensichtlich glücklich ihre Biergläser heben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
