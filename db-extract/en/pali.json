                        "entry_id": "b4017d86-37af-392b-9a86-af0cf34a8925",
                        "glosses": [
                            "A Middle Indo-Aryan language of north India, closely related to Sanskrit; the sacred language of Theravāda Buddhism."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
