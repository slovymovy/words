    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b2ce8c8-9a40-3e86-8b22-1855a0ce9b8c",
                    "sense_definition": "Młoda kobieta, zazwyczaj jeszcze niezamężna; także nastolatka.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_age_gender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta młoda <w>dziewczyna</w> bardzo ładnie śpiewa.",
                            "target_lang_translations": {
                                "ru": "Эта молодая <w>девушка</w> очень красиво поёт.",
                                "de": "Dieses junge <w>Mädchen</w> singt sehr schön."
                            }
                        },
                        {
                            "text": "Wczoraj w parku zaczepiła mnie jakaś nieznajoma <w>dziewczyna</w>.",
                            "target_lang_translations": {
                                "ru": "Вчера в парке меня остановила какая-то незнакомая <w>девушка</w>.",
                                "de": "Gestern hat mich im Park ein fremdes <w>Mädchen</w> angesprochen."
                            }
                        }
                    ],
                    "synonyms": [
                        "panna",
                        "dziewoja",
                        "laska",
                        "nastolatka"
                    ],
                    "antonyms": [
                        "chłopak",
                        "chłopiec"
                    ],
                    "common_phrases": [
                        "młoda dziewczyna",
                        "ładna dziewczyna",
                        "dziewczyna z sąsiedztwa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодая женщина, обычно незамужняя; также подросток.",
                        "de": "Eine junge Frau, meist unverheiratet; auch ein weiblicher Teenager."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девушка",
                                "target_lang_sense_clarification": "молодая особа женского пола"
                            },
                            {
                                "target_lang_word": "девчонка",
                                "target_lang_sense_clarification": "разговорное, часто о подростке"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mädchen",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für eine junge weibliche Person"
                            },
                            {
                                "target_lang_word": "junge Frau",
                                "target_lang_sense_clarification": "etwas formellere Bezeichnung für eine junge Erwachsene"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ac2c7ee-c324-3a83-8396-454a2616fd84",
                    "sense_definition": "Partnerka w związku romantycznym, sympatia, z którą nie jest się w związku małżeńskim.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek i jego <w>dziewczyna</w> idą dzisiaj wieczorem do kina.",
                            "target_lang_translations": {
                                "ru": "Марек и его <w>девушка</w> идут сегодня вечером в кино.",
                                "de": "Marek und seine <w>Freundin</w> gehen heute Abend ins Kino."
                            }
                        },
                        {
                            "text": "Gdy spytałem, czy zostanie moją <w>dziewczyną</w>, zgodziła się bez wahania.",
                            "target_lang_translations": {
                                "ru": "Когда я спросил, станет ли она моей <w>девушкой</w>, она согласилась без колебаний.",
                                "de": "Als ich sie fragte, ob sie meine <w>Freundin</w> werden wolle, stimmte sie ohne Zögern zu."
                            }
                        }
                    ],
                    "synonyms": [
                        "partnerka",
                        "sympatia"
                    ],
                    "antonyms": [
                        "chłopak"
                    ],
                    "common_phrases": [
                        "moja dziewczyna",
                        "mieć dziewczynę",
                        "zerwać z dziewczyną"
                    ],
                    "target_lang_definitions": {
                        "ru": "Партнёрша в романтических отношениях, возлюбленная.",
                        "de": "Partnerin in einer romantischen Beziehung, mit der man nicht verheiratet ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девушка",
                                "target_lang_sense_clarification": "партнёрша в отношениях"
                            },
                            {
                                "target_lang_word": "подруга",
                                "target_lang_sense_clarification": "возлюбленная"
                            }
                        ],
                        "de": [
                            {
