                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "perfection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cc96b0e-4f40-308f-afba-ab97aaaddfc3",
                                        "entry_id": "ad065134-17fa-389b-813c-94680fbe0e33",
                                        "glosses": [
                                            "To perfect."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8678ed69-aa8b-43aa-8a43-1ec4ccfe5472",
                                                "sense_id": "9cc96b0e-4f40-308f-afba-ab97aaaddfc3",
                                                "text": "My plan, gentlemen, is to be conſider'd as a ſuperſtructure on that admirable foundation laid by the modern profeſſor of Engliſh, both our labours tending to the ſame general end; the perfectioning of our countrymen in a moſt eſſential article, the right uſe of their native language."
                                            },
                                            {
                                                "example_id": "bf83e4e5-5ad2-44c2-8b86-5061c7653c26",
                                                "sense_id": "9cc96b0e-4f40-308f-afba-ab97aaaddfc3",
                                                "text": "Sooner I'd kneel unto the modern nine / Alike perfectioned, though a virgin's name / They cannot boast[…]"
                                            },
                                            {
                                                "example_id": "a57333fe-ea8a-4d5e-b234-f5aeaea28d15",
                                                "sense_id": "9cc96b0e-4f40-308f-afba-ab97aaaddfc3",
                                                "text": "The most vain of the Assistants, she knows she's beautiful and let it know to the world. Acts like an ojousama and spends most of her time perfectioning her make-up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e309f2f-7389-42ef-8a4f-9b3f5decce12",
                        "source_entry_id": "97ae7a81-575b-3669-b9d2-741f310e0ec3",
                        "source_sense_id": "d999e7b2-13f6-3a74-9396-467f5d9560e5",
                        "target_lang_word": "perfection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Qualité de ce qui est parfait dans son genre."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd7405e-d47a-48c4-be41-b3257229ee64",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "— Elle garde mes vaches, fait le beurre et les fromages à la crème dans la perfection."
                                            },
                                            {
                                                "example_id": "aafe1b27-15c3-4578-b483-57c0ad38dfc5",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "C'est pour cela que les catalogues illustrés sur les expositions ont toujours été des entreprises sans lendemain, malgré la perfection des gravures."
                                            },
                                            {
                                                "example_id": "843f2590-bae8-43fa-956b-00bd64420549",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "Il faut aspirer à la perfection."
                                            },
                                            {
                                                "example_id": "c3cb0580-8bd4-4cec-873e-5d70377745e0",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "Il est difficile d’atteindre, d’arriver à la perfection."
                                            },
                                            {
                                                "example_id": "d47ff970-1128-4f2d-8d05-c9207fe6e554",
                                                "sense_id": "d2c0bbcd-1559-355d-af81-240e32f41f47",
                                                "text": "Donner à un ouvrage toute la perfection dont il est susceptible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "L’état le plus accompli de la vie religieuse."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dae065ee-3db6-470e-9f3c-84517b7fb5f2",
                                                "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                                "text": "Le quiétisme […] érigeait en système et posait avec franchise comme suprême perfection l’état d'immobilité et d’impuissance où l'âme parvient à la longue quand elle abdique son activité."
                                            },
                                            {
                                                "example_id": "28a90498-592f-4b0b-b3c6-3c10e688deac",
                                                "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                                "text": "Nous croyons avoir assez fait comprendre quʼil y a de sortes de perfections pour la langue internationale : l’une vraie, faite des qualités qui répondent amplement au rôle de l’organe. Celle-là, l’Esperanto la possède, et la pratique le prouve tous les jours. L’autre, fictive et trompeuse, loin de répondre à la fin de l’idiome, y nuit au contraire plus ou moins, selon qu’elle s’éloigne peu ou beaucoup des qualités que la langue internationale doit posséder pour tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d729a356-4af6-3daa-af27-1ea5ac596e48",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Qualités excellentes, soit de l’âme, soit du corps."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4bdeea-94a9-483b-93ad-e8cfdf9ac0f4",
                                                "sense_id": "d729a356-4af6-3daa-af27-1ea5ac596e48",
                                                "text": "Être doué de toute sorte de perfections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce07108f-66cf-34cd-87da-03fe712483a0",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "État parfait."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3edd1fc-25f8-4da4-822f-18c2185f63b2",
                                                "sense_id": "ce07108f-66cf-34cd-87da-03fe712483a0",
                                                "text": "Les perfections divines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9997cf-1683-3cf4-8015-92a1f8dd6c5c",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Être, chose qui a toutes les qualités."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e56d26a-26ed-4d86-9953-991797bc7fd0",
                                                "sense_id": "8a9997cf-1683-3cf4-8015-92a1f8dd6c5c",
                                                "text": "Cette personne est une perfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474f900f-c7e6-3b6d-be42-54b548d1f138",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Achèvement."
                                        ],
                                        "tags": [
