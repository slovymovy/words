                "senses": [
                    {
                        "sense_id": "ecb54cd5-537c-308e-a5d0-af4427859263",
                        "entry_id": "ad9febaa-76a0-3960-a0a7-96fd15e84408",
                        "glosses": [
                            "оценить кого-либо, что-либо не в полной мере, недостаточно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00380b02-e9d8-4acc-839f-4d8f081a076d",
                                "sense_id": "ecb54cd5-537c-308e-a5d0-af4427859263",
                                "text": "Рожественский был слишком самоуверен и считал себя гениальным, но недооценил способностей своего противника."
                            },
                            {
                                "example_id": "86d764ee-3402-4ab0-9904-6846b52572ea",
                                "sense_id": "ecb54cd5-537c-308e-a5d0-af4427859263",
                                "text": "Нам одного не простят: если мы недооценили опасность."
                            }
                        ]
                    }
