                    {
                        "translation_id": "44c04656-e097-4792-b25c-a5cb7f6dfd96",
                        "source_entry_id": "d65c58b4-874c-38da-91a3-485d66c9597a",
                        "source_sense_id": "5217f63c-1e95-3dfc-a5e6-84b732dada2d",
                        "source_sense_description": "wormvormig aanhangsel",
                        "target_lang_word": "appendice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appendice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7956449f-31f0-37bc-823d-fc9ee6eb3bbb",
                                        "entry_id": "d6ec9eba-4edc-3583-af63-8f532bec42a1",
                                        "glosses": [
                                            "Ce qui semble appendu, ajouté à une autre chose."
                                        ],
                                        "tags": [],
                                        "note": "On trouve plus rarement son synonyme : appendage",
                                        "examples": [
                                            {
                                                "example_id": "46eb7853-cebb-43f3-be92-0b383086f981",
                                                "sense_id": "7956449f-31f0-37bc-823d-fc9ee6eb3bbb",
                                                "text": "[…] ; de même que le travail de rouir, tiller et peigner le chanvre, saler ou sécher le poisson , etc. , passe pour un appendice de l'industrie de ceux qui récoltent le chanvre, ou qui pêchent le poisson."
                                            },
                                            {
                                                "example_id": "86d7cc5b-c928-4393-8d4d-d1a70dcb5c2e",
                                                "sense_id": "7956449f-31f0-37bc-823d-fc9ee6eb3bbb",
                                                "text": "Les religieux de Stavelot, seigneurs tréfonciers de Chooz et de ses appendices, lèvent les amendes à Chooz, dont ils donnent le tiers à Gérard de Jauche, seigneur de Hierges, qui, depuis dix-huit ans, s'est emparé de différents revenus."
                                            },
                                            {
                                                "example_id": "08d70a59-11da-42be-8775-9ed583daf61a",
                                                "sense_id": "7956449f-31f0-37bc-823d-fc9ee6eb3bbb",
                                                "text": "À ce moment là, je disais: «nous, Africains» parce que pour moi les Antilles étaient un appendice, je ne dirais pas secondaire, mais un appendice de lʼAfrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d811329-75ee-305c-a38c-7dcef088f847",
                                        "entry_id": "d6ec9eba-4edc-3583-af63-8f532bec42a1",
                                        "glosses": [
                                            "Texte ajouté à la fin d’un ouvrage et qui contient soit des remarques, soit des documents qui n’ont pas trouvé place dans l’ouvrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a53b55d-a723-493e-9760-2c66c6934622",
                                                "sense_id": "3d811329-75ee-305c-a38c-7dcef088f847",
                                                "text": "Il avait commis l'énorme indélicatesse de publier, en appendice au tome III de la Prévencion, la série des lettres à lui adressées par l’« auteuresse », puis une lettre concernant cette jeune fille, une lettre en latin, — comme si le latin seul pouvait braver, en telle occurrence, l'honnêteté, — […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c39d9c2a-2736-3244-b3d8-a8fb3c0194ee",
                                        "entry_id": "d6ec9eba-4edc-3583-af63-8f532bec42a1",
                                        "glosses": [
                                            "Toute partie qui semble être une addition, qui sert de prolongement à un organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef443210-1f32-44c8-b8e5-547de4c41c76",
                                                "sense_id": "c39d9c2a-2736-3244-b3d8-a8fb3c0194ee",
                                                "text": "L’appendice xiphoïde."
                                            },
                                            {
                                                "example_id": "2e69fe8f-9b40-46c6-a3be-784c44197dbd",
                                                "sense_id": "c39d9c2a-2736-3244-b3d8-a8fb3c0194ee",
                                                "text": "Appendice membraneux."
                                            },
                                            {
                                                "example_id": "bad50a45-6770-4e44-a42c-ac69380fa3bb",
                                                "sense_id": "c39d9c2a-2736-3244-b3d8-a8fb3c0194ee",
                                                "text": "Appendice du caecum, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7c0d66-35d4-3f3f-81f7-c1cc46519465",
                                        "entry_id": "d6ec9eba-4edc-3583-af63-8f532bec42a1",
                                        "glosses": [
                                            "Nom courant de l’appendice iléo-cæcal ou appendice vermiforme ou vermiculaire."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02716383-8694-4061-b2e2-cb5b38cc65e0",
                                                "sense_id": "aa7c0d66-35d4-3f3f-81f7-c1cc46519465",
                                                "text": "L’appendice est un organe lymphoïde : il héberge de nombreuses cellules immunitaires, des lymphocytes B et T."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71220ec0-ffaa-3237-b0d5-182732b5bb29",
                                        "entry_id": "d6ec9eba-4edc-3583-af63-8f532bec42a1",
                                        "glosses": [
                                            "Élément en saillie de la structure principale d’un véhicule spatial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20384e4e-23ee-326a-8749-d4b04763fe1d",
                                        "entry_id": "d6ec9eba-4edc-3583-af63-8f532bec42a1",
                                        "glosses": [
                                            "Appendice de coque : tout accessoire qui dépasse de la forme générale de la coque : gouvernail, plan anti-dérive ou antiroulis, arbre, hélice, sonar, sondeur, loch à hélice ou à tube de Pitot, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6d99349-8f0d-3d2e-a38e-482d55f07c8f",
                                        "entry_id": "d6ec9eba-4edc-3583-af63-8f532bec42a1",
                                        "glosses": [
                                            "Flèche rattachée à la bulle indiquant le personnage qui parle, ou ronds en ligne quand le personnage pense ou rêve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
