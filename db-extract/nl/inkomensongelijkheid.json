                "senses": [
                    {
                        "sense_id": "5ba71c3e-8995-3df6-8d6f-9de5b58ed350",
                        "entry_id": "37d18840-a76a-38b5-b3a5-76881bda8df7",
                        "glosses": [
                            "het verschijnsel dat sommige personen meer geld verdienen dan andere personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf5c519-d27f-41fd-b8ea-9b55b6ac9d8e",
                                "sense_id": "5ba71c3e-8995-3df6-8d6f-9de5b58ed350",
                                "text": "Het land met 6,5 miljoen inwoners geldt als een van de corruptste lidstaten van de Europese Unie, en nergens in de EU is de inkomensongelijkheid zo groot. Om toegang te krijgen tot miljarden aan Brusselse subsidies belooft de nieuwe regering het rechtsstelsel te hervormen en corruptie te bestrijden."
                            },
                            {
                                "example_id": "e71d5559-70ec-4ec6-a316-0f3e7e954dd5",
                                "sense_id": "5ba71c3e-8995-3df6-8d6f-9de5b58ed350",
                                "text": "Vergeleken met andere Europese landen, is de inkomensongelijkheid in Nederland klein."
                            },
                            {
                                "example_id": "a7c07714-1836-482b-bd60-0ca23b81a196",
                                "sense_id": "5ba71c3e-8995-3df6-8d6f-9de5b58ed350",
                                "text": "Wel trok Li in 2020 de aandacht met zijn uitspraak dat meer dan 600 miljoen Chinezen, bijna de helft van de bevolking, moet leven van minder dan 130 euro per maand. Dat leidde tot een debat in China over inkomensongelijkheid en armoede."
                            }
                        ]
                    }
