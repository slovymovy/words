                                    {
                                        "sense_id": "f99d37ec-e445-3550-a379-43af3bc0342a",
                                        "entry_id": "3c2b77f6-13d5-3e7f-ad2d-5989bf00e9fe",
                                        "glosses": [
                                            "To a very small extent or degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2a5958-e8a3-422b-b267-a0d3f2592321",
                                                "sense_id": "f99d37ec-e445-3550-a379-43af3bc0342a",
                                                "text": "He could read it only a little bit."
                                            },
                                            {
                                                "example_id": "ed529b7c-52aa-438e-a24e-23d346426672",
                                                "sense_id": "f99d37ec-e445-3550-a379-43af3bc0342a",
                                                "text": "Those shoes are a little bit too tight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "a little bit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                        "entry_id": "065b4de5-8629-3297-8a51-d7af2897f307",
                                        "glosses": [
                                            "A very small amount or time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d8781cb-6c74-4b75-b4ee-f067622e4604",
                                                "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                                "text": "There's just a little bit left."
                                            },
                                            {
                                                "example_id": "f9afc150-f4da-4fbc-bd7c-9c2cab6a18f7",
                                                "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                                "text": "Even a little bit can make a difference."
                                            },
                                            {
                                                "example_id": "515ec1da-2084-430f-bf32-1c333d5a6613",
                                                "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                                "text": "I'll be there in a little bit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2c09420-5148-44e9-9403-4a989e05d603",
                        "source_entry_id": "3beb4df5-655a-36ff-9fd6-43c431a8cfdc",
                        "source_sense_id": "40fcdb91-3ace-3a43-a7ec-f4a3084a5ae3",
                        "target_lang_word": "un peu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "un peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca31a1d-c0b8-38c5-b577-577847675ff9",
                                        "entry_id": "41b9fa21-272f-3057-879f-a1bc9870152c",
                                        "glosses": [
                                            "En petite quantité, pas beaucoup. On utilise quelques-uns pour les dénombrables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba2d7c1b-b496-4b76-91fc-e29dcc0da44a",
                                                "sense_id": "7ca31a1d-c0b8-38c5-b577-577847675ff9",
                                                "text": "Quand il suivit un peu plus tard comme externe les classes du collège d'Arbois, il appartint tout d'abord à la catégorie des élèves que l'on pourrait appeler bons-ordinaires."
                                            },
                                            {
                                                "example_id": "62397702-6793-46da-8077-8e11d241835d",
                                                "sense_id": "7ca31a1d-c0b8-38c5-b577-577847675ff9",
                                                "text": "Là, limite, ma performance individuelle, je m’en tape un peu."
                                            },
                                            {
                                                "example_id": "998f44bf-c532-4d4c-a2b9-815fd5b4856b",
                                                "sense_id": "7ca31a1d-c0b8-38c5-b577-577847675ff9",
                                                "text": "Attendez un peu."
                                            },
                                            {
                                                "example_id": "c190a8cf-394c-4a6f-be3d-a808b9a47b54",
                                                "sense_id": "7ca31a1d-c0b8-38c5-b577-577847675ff9",
                                                "text": "J’arriverai un peu après vous."
                                            },
                                            {
                                                "example_id": "3fb54a1c-bc52-45d9-8230-f25de96a86fb",
                                                "sense_id": "7ca31a1d-c0b8-38c5-b577-577847675ff9",
                                                "text": "Connaissez-vous cet homme ? — Un peu."
                                            },
                                            {
                                                "example_id": "1b0f4bfa-844c-4b35-a7d4-7e2994981bf3",
                                                "sense_id": "7ca31a1d-c0b8-38c5-b577-577847675ff9",
                                                "text": "J’en ai bu un peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c89a3f-d810-364b-be71-4d1a2472b1ab",
                                        "entry_id": "41b9fa21-272f-3057-879f-a1bc9870152c",
                                        "glosses": [
                                            "Une petite quantité. On utilise quelques pour les dénombrables."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7f4f886-a7a6-49a4-8e24-adb31183bc3a",
                                                "sense_id": "34c89a3f-d810-364b-be71-4d1a2472b1ab",
                                                "text": "Le Concorde peut effectuer un aller-retour transatlantique en un peu plus de six heures."
                                            },
                                            {
                                                "example_id": "b9b9a115-1893-4c27-b314-ac78f96e5baf",
                                                "sense_id": "34c89a3f-d810-364b-be71-4d1a2472b1ab",
                                                "text": "Donnez-moi un peu de pain. — Ayez un peu d’espoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab7228cf-b5d0-3364-b684-6d5fe59a04e6",
                                        "entry_id": "41b9fa21-272f-3057-879f-a1bc9870152c",
                                        "glosses": [
                                            "Un court moment, de manière rapide."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eadb780-582c-4c65-9193-c0e7b828ba6c",
                                                "sense_id": "ab7228cf-b5d0-3364-b684-6d5fe59a04e6",
                                                "text": "[…], il entra dans le bois, d’où il ressortit un peu après, écorçant avec son couteau une trique de grosseur assez respectable."
                                            },
                                            {
                                                "example_id": "03d5355f-8029-49d8-bc3c-c516ecdcd33a",
                                                "sense_id": "ab7228cf-b5d0-3364-b684-6d5fe59a04e6",
                                                "text": "Tu saurais un peu jeter un œil sur mon dossier ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e4f0a3e-bd6b-3f9f-aecd-7be6fccac625",
                                        "entry_id": "41b9fa21-272f-3057-879f-a1bc9870152c",
                                        "glosses": [
                                            "Ajouté à un impératif pour le rendre plus supportable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad7b0d85-c02d-43a8-a9a5-cb6747beccc2",
                                                "sense_id": "7e4f0a3e-bd6b-3f9f-aecd-7be6fccac625",
                                                "text": "Venez ici un peu, que je vous parle."
                                            },
                                            {
                                                "example_id": "0c25bade-1492-413d-b43a-3e0b35355a9a",
                                                "sense_id": "7e4f0a3e-bd6b-3f9f-aecd-7be6fccac625",
                                                "text": "Voyons un peu comment vous vous y prendrez."
                                            },
                                            {
                                                "example_id": "f8407cd4-980c-42ac-b742-1fbba4eb4253",
                                                "sense_id": "7e4f0a3e-bd6b-3f9f-aecd-7be6fccac625",
                                                "text": "Oh! dit-elle, regarde un peu, Jean!."
                                            },
                                            {
                                                "example_id": "e2075845-a5db-41c6-a239-5051d7fffeb6",
                                                "sense_id": "7e4f0a3e-bd6b-3f9f-aecd-7be6fccac625",
                                                "text": "Dites-moi un peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ef18045-992a-3633-a776-68bc897d4946",
                                        "entry_id": "41b9fa21-272f-3057-879f-a1bc9870152c",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9acd9fc-e74c-479e-84da-0b64d0ec47e9",
                                                "sense_id": "0ef18045-992a-3633-a776-68bc897d4946",
                                                "text": "Vous avez dit cela un peu bien vite."
                                            },
                                            {
                                                "example_id": "40f3b050-1b04-41b8-900f-6c23ed6c7d6a",
                                                "sense_id": "0ef18045-992a-3633-a776-68bc897d4946",
                                                "text": "Il se moque un peu beaucoup de nous."
                                            },
                                            {
                                                "example_id": "fdb32aea-0d52-4a64-b6b4-872ed938af4e",
                                                "sense_id": "0ef18045-992a-3633-a776-68bc897d4946",
                                                "text": "Un peu se dit très familièrement, en manière d’affirmation."
                                            },
                                            {
                                                "example_id": "4b94fc68-111b-4058-b386-a5fbb92d6183",
                                                "sense_id": "0ef18045-992a-3633-a776-68bc897d4946",
                                                "text": "Vous avez fait cela ? — Un peu."
                                            },
                                            {
                                                "example_id": "ceaf3b51-b97b-460a-a895-60d865fbe46d",
                                                "sense_id": "0ef18045-992a-3633-a776-68bc897d4946",
                                                "text": "Un peu bien, un peu beaucoup, Beaucoup, beaucoup trop."
                                            },
                                            {
                                                "example_id": "a7665045-801c-4dc9-97d2-f3b760c7e52e",
                                                "sense_id": "0ef18045-992a-3633-a776-68bc897d4946",
                                                "text": "La mer se déchaîne. Mate cette vague-là. Tu te la fais? Un peu, que je me la fais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e0ba85-3893-3a04-8477-d324b27a6083",
                                        "entry_id": "41b9fa21-272f-3057-879f-a1bc9870152c",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a01aa1-471d-4501-be94-6c0b1816680a",
                                                "sense_id": "c3e0ba85-3893-3a04-8477-d324b27a6083",
                                                "text": "Il regarda s’éloigner ce grand gaillard qui se dandinait en balançant les bras. Il allait voir un peu, celui-là, si le travail de la masse n’était plus de son âge !…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
