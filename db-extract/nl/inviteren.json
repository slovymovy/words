                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ccc7d9d-9c0b-322e-b590-8fd2cb737af7",
                        "entry_id": "49987c63-0c3c-32a4-8808-2308b2b7a816",
                        "glosses": [
                            "uitnodigen"
                        ],
                        "tags": [
                            "formal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f31f84c3-4643-4963-a42f-c6b42bce734f",
                                "sense_id": "4ccc7d9d-9c0b-322e-b590-8fd2cb737af7",
                                "text": "Adoptie is een geliefd thema in Brazilië. Populaire shows inviteren buitenlandse geadopteerden die op zoek zijn naar hun biologische familie. Ook in de veelbekeken telenovelas (soapseries) komt het thema vaak terug."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4f94a54-d299-3030-a177-7009e8ff8034",
                        "entry_id": "49987c63-0c3c-32a4-8808-2308b2b7a816",
                        "glosses": [
                            "een persoon op een doorgaans vriendelijke en vrijblijvende manier vragen om iets te doen"
                        ],
                        "tags": [
                            "formal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8d14668a-25cf-46e2-ab5e-f15111fccbe5",
                                "sense_id": "d4f94a54-d299-3030-a177-7009e8ff8034",
                                "text": "Het dragen van de Nederlandse vlag bij de opening van de Olympische Spelen was van oudsher een eervolle taak voor een sporter met vele dienstjaren achter de naam. De sterke armen van Van Rijsselberge en diens jeugdige, frisse voorkomen waren de redenen om hem te inviteren. Hij vond het 'tof' en 'een enorme eer'. Hij werd gevraagd omdat de olympische ploeg nu eens niet naar het verleden wilde kijken, maar vooruit wilde zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "882c4092-942d-4641-9ee4-a45849d8ff84",
                        "source_entry_id": "49987c63-0c3c-32a4-8808-2308b2b7a816",
                        "source_sense_id": "d4f94a54-d299-3030-a177-7009e8ff8034",
