{
    "word_family": [
        "tanker",
        "tankful",
        "antitank"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e3eb107-9d2c-3494-8a12-9b0204f10674",
                    "sense_definition": "A large container for holding liquids or gases.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to clean the fish <w>tank</w> because the water is getting dirty.",
                            "target_lang_translations": {
                                "ru": "Нам нужно почистить <w>аквариум</w>, потому что вода становится грязной.",
                                "zh": "我们需要清理<w>鱼缸</w>，因为水变脏了。"
                            }
                        },
                        {
                            "text": "The diver checked his oxygen <w>tank</w> before jumping into the ocean.",
                            "target_lang_translations": {
                                "ru": "Дайвер проверил свой кислородный <w>баллон</w> перед прыжком в океан.",
                                "zh": "潜水员在跳入大海前检查了他的<w>氧气瓶</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "water tank",
                        "fish tank",
                        "oxygen tank",
                        "septic tank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой контейнер для хранения жидкостей или газов.",
                        "zh": "用于盛放液体或气体的容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бак",
                                "target_lang_sense_clarification": "для воды или других жидкостей"
                            },
                            {
                                "target_lang_word": "резервуар",
                                "target_lang_sense_clarification": "промышленный или крупный"
                            },
                            {
                                "target_lang_word": "аквариум",
                                "target_lang_sense_clarification": "для рыб (fish tank)"
                            },
                            {
                                "target_lang_word": "баллон",
                                "target_lang_sense_clarification": "для газа (oxygen tank)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罐",
                                "target_lang_sense_clarification": "通用容器"
                            },
                            {
                                "target_lang_word": "水箱",
                                "target_lang_sense_clarification": "用于盛水"
                            },
                            {
                                "target_lang_word": "鱼缸",
                                "target_lang_sense_clarification": "用于养鱼"
                            },
                            {
                                "target_lang_word": "气瓶",
                                "target_lang_sense_clarification": "用于盛装压缩气体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eb2ae6b-4f73-3f7a-a4dd-606bd32616b5",
                    "sense_definition": "The part of a vehicle that holds fuel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "container_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to stop at the next station because my gas <w>tank</w> is almost empty.",
                            "target_lang_translations": {
                                "ru": "Мне нужно остановиться на следующей заправке, потому что мой <w>бак</w> почти пуст.",
                                "zh": "我得在下一个加油站停一下，因为我的<w>油箱</w>快空了。"
                            }
                        },
                        {
                            "text": "It costs a lot of money to fill the <w>tank</w> of a large truck.",
                            "target_lang_translations": {
                                "ru": "Заправить полный <w>бак</w> большого грузовика стоит кучу денег.",
                                "zh": "给大卡车加满<w>油箱</w>需要花很多钱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gas tank",
                        "fuel tank",
                        "fill the tank",
                        "empty tank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть транспортного средства, в которой хранится топливо.",
                        "zh": "车辆中用于储存燃料的部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бак",
                                "target_lang_sense_clarification": "топливный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "油箱",
                                "target_lang_sense_clarification": "车辆燃料箱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23d3f88d-54fb-33ba-8958-ec805ae678bc",
                    "sense_definition": "An armoured fighting vehicle, armed with a gun designed for direct fire, and moving on caterpillar tracks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers drove the heavy <w>tank</w> across the muddy battlefield.",
                            "target_lang_translations": {
                                "ru": "Солдаты вели тяжелый <w>танк</w> через грязное поле битвы.",
                                "zh": "士兵们驾驶着重型<w>坦克</w>穿过了泥泞的战场。"
                            }
                        },
                        {
                            "text": "During the war, the army used a <w>tank</w> to break through the enemy lines.",
                            "target_lang_translations": {
                                "ru": "Во время войны армия использовала <w>танк</w>, чтобы прорвать вражеские линии.",
                                "zh": "战争期间，军队使用<w>坦克</w>突破了敌人的防线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "battle tank",
                        "armored vehicle"
                    ],
                    "common_phrases": [
                        "army tank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бронированная боевая машина на гусеничном ходу, вооруженная пушкой.",
                        "zh": "一种装有火炮、依靠履带行驶的装甲战斗车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танк",
                                "target_lang_sense_clarification": "военная техника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坦克",
                                "target_lang_sense_clarification": "军事车辆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f770190d-b5bc-3b64-934f-5c7915a9d2ab",
                    "sense_definition": "A sleeveless shirt with wide shoulder straps and no collar; a tank top.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a simple white <w>tank</w> and jeans to the summer party.",
                            "target_lang_translations": {
                                "ru": "Она надела простую белую <w>майку</w> и джинсы на летнюю вечеринку.",
                                "zh": "她穿着一件简单的白色<w>背心</w>和牛仔裤去参加夏日派对。"
                            }
                        },
                        {
                            "text": "It is too cold outside to just wear a <w>tank</w>, so you should bring a jacket.",
                            "target_lang_translations": {
                                "ru": "На улице слишком холодно, чтобы быть просто в <w>майке</w>, поэтому тебе стоит взять куртку.",
                                "zh": "外面太冷了，不能只穿<w>背心</w>，你应该带件外套。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear a tank",
                        "cotton tank"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for tank top"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Майка без рукавов с широкими бретелями.",
                        "zh": "一种无袖、宽肩带的背心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "майка",
                                "target_lang_sense_clarification": "одежда"
                            },
                            {
                                "target_lang_word": "топ",
                                "target_lang_sense_clarification": "женская одежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背心",
                                "target_lang_sense_clarification": "无袖上衣"
                            },
                            {
                                "target_lang_word": "吊带衫",
                                "target_lang_sense_clarification": "女性无袖上衣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af2586ba-2ced-37f5-9eaa-a1e28dc4f06a",
                    "sense_definition": "A character in a video game designed to take damage and protect other players.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team needs a good <w>tank</w> to absorb the boss's attacks while we heal.",
                            "target_lang_translations": {
                                "ru": "Нашей команде нужен хороший <w>танк</w>, чтобы принимать атаки босса, пока мы лечимся.",
                                "zh": "我们需要一个好的<w>坦克</w>来承受首领的攻击，以便我们进行治疗。"
                            }
                        },
                        {
                            "text": "He prefers playing as a <w>tank</w> because he likes being in the front line of combat.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает играть за <w>танка</w>, потому что ему нравится быть на передовой.",
                                "zh": "他更喜欢玩<w>坦克</w>，因为他喜欢站在战斗的最前线。"
                            }
                        }
                    ],
                    "antonyms": [
                        "glass cannon"
                    ],
                    "common_phrases": [
                        "main tank"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Персонаж в видеоигре, созданный, чтобы принимать урон и защищать других игроков.",
                        "zh": "电子游戏中负责承受伤害并保护队友的角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танк",
                                "target_lang_sense_clarification": "игровая роль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坦克",
                                "target_lang_sense_clarification": "游戏角色定位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "165e4ddd-8353-3cbc-9ecb-2fd023a262fb",
                    "sense_definition": "To fail completely or decline rapidly, often regarding the economy, a business, or a product.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie <w>tanked</w> at the box office despite having famous actors.",
                            "target_lang_translations": {
                                "ru": "Фильм <w>провалился</w> в прокате, несмотря на участие известных актеров.",
                                "zh": "尽管有著名演员参演，这部电影在票房上还是<w>惨败</w>了。"
                            }
                        },
                        {
                            "text": "Many small businesses <w>tanked</w> during the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Многие малые предприятия <w>рухнули</w> во время экономического кризиса.",
                                "zh": "许多小企业在经济危机期间<w>倒闭</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "economy tanked",
                        "market tanked"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерпеть полную неудачу или резко упасть (об экономике или бизнесе).",
                        "zh": "指经济、业务或产品彻底失败或迅速衰落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провалиться",
                                "target_lang_sense_clarification": "о фильме или проекте"
                            },
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "об экономике или рынке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "指项目或电影"
                            },
                            {
                                "target_lang_word": "崩盘",
                                "target_lang_sense_clarification": "指经济或市场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c01b2731-b045-3dad-b04d-981919bc6ce0",
                    "sense_definition": "To attract and absorb the attacks of an enemy in a game so teammates are safe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>tank</w> the dragon while the rest of us cast spells.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>танковать</w> дракона, пока остальные из нас накладывают заклинания.",
                                "zh": "你需要去<w>抗住</w>那条龙，剩下的我们来施法。"
                            }
                        },
                        {
                            "text": "She can <w>tank</w> a lot of damage thanks to her heavy armor.",
                            "target_lang_translations": {
                                "ru": "Она может <w>танковать</w> много урона благодаря своей тяжелой броне.",
                                "zh": "多亏了重型盔甲，她能<w>承受</w>大量的伤害。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать на себя атаки врага в игре, чтобы обезопасить товарищей по команде.",
                        "zh": "在游戏中吸引并承受敌方攻击，以保护队友。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танковать",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抗怪",
                                "target_lang_sense_clarification": "游戏术语"
                            },
                            {
                                "target_lang_word": "拉仇恨",
                                "target_lang_sense_clarification": "游戏术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb8a71a-505a-3437-949c-932834d042c5",
                    "sense_definition": "To deliberately lose a sports match or competition to gain a perceived future advantage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_strategy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans accused the team of trying to <w>tank</w> to get a better draft pick next year.",
                            "target_lang_translations": {
                                "ru": "Болельщики обвинили команду в попытке <w>слить</w> сезон, чтобы получить лучший выбор на драфте в следующем году.",
                                "zh": "球迷们指责该队为了在明年获得更好的选秀权而故意<w>摆烂</w>。"
                            }
                        },
                        {
                            "text": "He decided to <w>tank</w> the match to avoid playing the champion in the next round.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>сдать</w> матч, чтобы избежать игры с чемпионом в следующем раунде.",
                                "zh": "他决定<w>放弃</w>这场比赛，以避免在下一轮对阵冠军。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tank the season",
                        "tank the match"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно проигрывать спортивный матч ради будущей выгоды.",
                        "zh": "为了获得未来的某种优势而故意输掉比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сливать",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "матч"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆烂",
                                "target_lang_sense_clarification": "体育竞技术语"
                            },
                            {
                                "target_lang_word": "假打",
                                "target_lang_sense_clarification": "故意输掉比赛"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}