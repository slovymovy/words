                                        "entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                                        "glosses": [
                                            "A regular writer of a column, such as in a magazine or newspaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd08776-e5f4-41e5-b306-bff48f3e0127",
