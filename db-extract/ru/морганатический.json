                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morganatico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "02824e52-914c-3a44-951f-98792afa0108",
                                        "entry_id": "4ce3f0db-1b60-3dcb-8b7d-193c9a90287f",
                                        "glosses": [
                                            "che riguarda una donazione compiuta da un uomo di nobili origini ad una moglie di estrazione sociale minore"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
