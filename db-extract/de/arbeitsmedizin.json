                ],
                "senses": [
                    {
                        "sense_id": "25a814d5-b981-366b-acaa-b7e5fed7dfdb",
                        "entry_id": "6ae73b8b-c34b-3287-bde2-12627b1982bb",
                        "glosses": [
                            "Teilgebiet, in dem man sich einerseits um Arbeitsabläufe/Bedingungen am Arbeitsplatz kümmert, die eine Gefährdung für die Gesundheit des Mitarbeiters sind oder sein können, und andererseits den Mitarbeiter selbst anspricht, um seine persönliche Gesundheit sicherzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7887d7f1-a664-486e-bbdc-eb928bbb25a7",
                                "sense_id": "25a814d5-b981-366b-acaa-b7e5fed7dfdb",
                                "text": "„Die Arbeitsmedizin soll für gesunde Arbeitsbedingungen sorgen, sie soll aber gleichermaßen über die gesundheitliche Eignung der einzelnen Arbeiter und Angestellten urteilen.“"
                            },
                            {
                                "example_id": "4c20c2b6-64a3-4430-a610-20476e59974f",
                                "sense_id": "25a814d5-b981-366b-acaa-b7e5fed7dfdb",
                                "text": "„Die Arbeitsmedizin ist mit ihren engen Verflechtungen von klinischer Beobachtung zu Toxikologie, Technologie und Sozialversicherung eine angewandte Wissenschaft.“"
                            },
                            {
                                "example_id": "de19c4ef-7836-46c6-a14b-67a20ddb076a",
                                "sense_id": "25a814d5-b981-366b-acaa-b7e5fed7dfdb",
                                "text": "„Die moderne Arbeitsmedizin weist mit Recht darauf hin, dass ein Urlaub mindestens 2 Wochen dauern und nicht zu stressig ablaufen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
