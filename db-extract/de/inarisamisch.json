                "senses": [
                    {
                        "sense_id": "a0c1797e-2f22-3836-9309-c13a53e1ab22",
                        "entry_id": "5703d867-1bc1-38ec-9838-bb86d72d8a28",
                        "glosses": [
                            "samische Sprache, die im Norden Finnlands von den Inarisamen gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9742fb-4150-4c17-8c37-00fc8c5839d8",
                                "sense_id": "a0c1797e-2f22-3836-9309-c13a53e1ab22",
                                "text": "„Wie die anderen Samischen Sprachen, das Finnische und das Estnische verwendet das Inarisamische ein Verneinungsverb.“"
                            },
                            {
                                "example_id": "79f258cf-a9e8-47e4-af13-d8e5741a26a1",
                                "sense_id": "a0c1797e-2f22-3836-9309-c13a53e1ab22",
                                "text": "„Inarisamisch: in Nordfinnland am Inarisee, ca. 330 Sprecher“"
                            },
                            {
                                "example_id": "7c7233b0-2bac-44a7-9c2d-c8ff53070646",
                                "sense_id": "a0c1797e-2f22-3836-9309-c13a53e1ab22",
                                "text": "„Im Einzelnen sind es: Nordsamisch (ca. 15.000 Sprecher), Südsamisch (einige hundert), Lulesamisch (etwa 1500), Inarisamisch (ca. 330), Skoltsamisch (ca. 200) und Kildinsamisch (mehrere hundert Sprecher, einzige samische Sprachform, die mit Kyrilliza geschrieben wird).“"
                            },
                            {
                                "example_id": "48387ab5-6ee3-4dbc-b0fe-ec10c9c346f6",
                                "sense_id": "a0c1797e-2f22-3836-9309-c13a53e1ab22",
                                "text": "„Maarits Muttersprache ist Nord-, die ihres Mannes Intoo ist Inarisamisch, und als sich die beiden kennen lernten, konnten sie sich nicht in ihren Sprachen miteinander unterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
