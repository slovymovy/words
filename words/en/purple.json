{
    "word_family": [
        "purplish",
        "purply",
        "purpleness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10217b62-9064-3fe0-8b8e-141376698193",
                    "sense_definition": "Having the colour that is a mixture of red and blue.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful <w>purple</w> dress to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела красивое <w>фиолетовое</w> платье на вечеринку.",
                                "zh": "她穿了一件漂亮的<w>紫色</w>裙子去参加聚会。"
                            }
                        },
                        {
                            "text": "The sky turned a deep <w>purple</w> as the sun set behind the mountains.",
                            "target_lang_translations": {
                                "ru": "Небо стало темно-<w>пурпурным</w>, когда солнце село за горы.",
                                "zh": "当太阳落入山后时，天空变成了深<w>紫色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "violet"
                    ],
                    "antonyms": [
                        "nonpurple"
                    ],
                    "common_phrases": [
                        "bright purple",
                        "deep purple",
                        "dark purple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий цвет, являющийся смесью красного и синего.",
                        "zh": "具有红色和蓝色混合而成的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиолетовый",
                                "target_lang_sense_clarification": "основной цвет"
                            },
                            {
                                "target_lang_word": "пурпурный",
                                "target_lang_sense_clarification": "с красноватым оттенком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紫色",
                                "target_lang_sense_clarification": "基本颜色"
                            },
                            {
                                "target_lang_word": "紫色的",
                                "target_lang_sense_clarification": "形容词形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cad6be02-35b2-3627-8d19-9d4bebb06309",
                    "sense_definition": "Describing a US state or region that has a mixture of support for the Democratic and Republican parties, rather than being predominantly one or the other.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The election results in the <w>purple</w> state were too close to call until the very end.",
                            "target_lang_translations": {
                                "ru": "Результаты выборов в <w>«фиолетовом»</w> штате оставались непредсказуемыми до самого конца.",
                                "zh": "这个<w>摇摆</w>州的选举结果直到最后一刻都难以预料。"
                            }
                        },
                        {
                            "text": "Campaign strategies often focus heavily on winning over voters in <w>purple</w> counties.",
                            "target_lang_translations": {
                                "ru": "Стратегии кампаний часто сосредоточены на привлечении избирателей в <w>«фиолетовых»</w> округах.",
                                "zh": "竞选策略通常非常注重争取<w>中间派</w>县区的选民。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "purple state",
                        "purple county"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US politics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает штат или регион США, где поддержка демократов и республиканцев примерно равна.",
                        "zh": "指美国政治中民主党和共和党支持率相当，不偏向任何一方的州或地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«фиолетовый»",
                                "target_lang_sense_clarification": "политический термин"
                            },
                            {
                                "target_lang_word": "колеблющийся",
                                "target_lang_sense_clarification": "о штате или регионе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇摆的",
                                "target_lang_sense_clarification": "指政治立场不固定的地区"
                            },
                            {
                                "target_lang_word": "中间派的",
                                "target_lang_sense_clarification": "指政治倾向中立的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfea25b7-1b51-318e-9f82-511f4bb6de47",
                    "sense_definition": "Of writing: extravagantly ornate, flowery, or overly elaborate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor advised the young author to cut the <w>purple</w> prose and focus on the plot.",
                            "target_lang_translations": {
                                "ru": "Редактор посоветовал молодому автору сократить <w>вычурную</w> прозу и сосредоточиться на сюжете.",
                                "zh": "编辑建议这位年轻作者删掉那些<w>辞藻华丽</w>的段落，专注于情节。"
                            }
                        },
                        {
                            "text": "His speech was criticized for its <w>purple</w> passages that obscured the actual message.",
                            "target_lang_translations": {
                                "ru": "Его речь критиковали за <w>пышные</w> пассажи, которые затмевали основной смысл.",
                                "zh": "他的演讲因其<w>浮夸</w>的段落掩盖了真实意图而受到批评。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "purple prose",
                        "purple passage"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О стиле письма: чрезмерно вычурный, цветистый или перегруженный деталями.",
                        "zh": "指文风过于华丽、辞藻堆砌或过于繁琐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычурный",
                                "target_lang_sense_clarification": "о стиле"
                            },
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "о слоге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辞藻华丽的",
                                "target_lang_sense_clarification": "形容文风"
                            },
                            {
                                "target_lang_word": "浮夸的",
                                "target_lang_sense_clarification": "形容文风"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29c40a63-6250-3353-9b7a-4ff8d2ef9515",
                    "sense_definition": "A colour between red and blue; violet or magenta.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Purple</w> is my favorite colour because it reminds me of royalty.",
                            "target_lang_translations": {
                                "ru": "<w>Фиолетовый</w> — мой любимый цвет, потому что он напоминает мне о королевской власти.",
                                "zh": "<w>紫色</w>是我最喜欢的颜色，因为它让我想起皇室。"
                            }
                        },
                        {
                            "text": "The artist used a vibrant <w>purple</w> to paint the flowers in the foreground.",
                            "target_lang_translations": {
                                "ru": "Художник использовал яркий <w>фиолетовый цвет</w>, чтобы нарисовать цветы на переднем плане.",
                                "zh": "艺术家用鲜艳的<w>紫色</w>来描绘前景中的花朵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "violet"
                    ],
                    "antonyms": [
                        "nonpurple"
                    ],
                    "common_phrases": [
                        "shades of purple",
                        "royal purple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвет между красным и синим; фиолетовый или маджента.",
                        "zh": "介于红色和蓝色之间的颜色；紫色或洋红色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиолетовый цвет",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "пурпур",
                                "target_lang_sense_clarification": "насыщенный оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紫色",
                                "target_lang_sense_clarification": "颜色名称"
                            },
                            {
                                "target_lang_word": "紫罗兰色",
                                "target_lang_sense_clarification": "特定色调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd71c139-8d9c-3d5a-8c1c-9eb860232dbd",
                    "sense_definition": "Imperial power or high rank, historically associated with the purple robes worn by emperors.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was born in the <w>purple</w>, destined to rule the empire from his first breath.",
                            "target_lang_translations": {
                                "ru": "Он был рожден в <w>пурпуре</w>, предназначенный править империей с первого вздоха.",
                                "zh": "他生于<w>皇室</w>，从出生的那一刻起就注定要统治帝国。"
                            }
                        },
                        {
                            "text": "Many generals aspired to the <w>purple</w>, but few managed to seize the throne.",
                            "target_lang_translations": {
                                "ru": "Многие генералы стремились к <w>пурпуру</w>, но лишь немногим удавалось захватить трон.",
                                "zh": "许多将军都渴望获得<w>皇权</w>，但很少有人能成功夺取王位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "born in the purple",
                        "assume the purple"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Императорская власть или высокий ранг, исторически ассоциируемые с пурпурными одеждами императоров.",
                        "zh": "指帝王权力或崇高地位，历史上与皇帝穿的紫色长袍有关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пурпур",
                                "target_lang_sense_clarification": "символ власти"
                            },
                            {
                                "target_lang_word": "порфира",
                                "target_lang_sense_clarification": "одеяние монарха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皇权",
                                "target_lang_sense_clarification": "象征权力的紫色"
                            },
                            {
                                "target_lang_word": "紫袍",
                                "target_lang_sense_clarification": "指代帝王身份"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "368167e2-9402-3d65-a720-32170e578d75",
                    "sense_definition": "To turn purple in colour.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sky <w>purpled</w> as the storm clouds gathered over the horizon.",
                            "target_lang_translations": {
                                "ru": "Небо <w>окрасилось в пурпур</w>, когда грозовые тучи собрались над горизонтом.",
                                "zh": "随着风暴云在地平线上聚集，天空<w>变紫</w>了。"
                            }
                        },
                        {
                            "text": "His face <w>purpled</w> with rage when he heard the insulting news.",
                            "target_lang_translations": {
                                "ru": "Его лицо <w>побагровело</w> от ярости, когда он услышал оскорбительную новость.",
                                "zh": "当他听到那个侮辱性的消息时，他气得脸都<w>发紫</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться фиолетовым или багровым.",
                        "zh": "变成紫色或深红色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "багроветь",
                                "target_lang_sense_clarification": "от гнева или напряжения"
                            },
                            {
                                "target_lang_word": "окрашиваться в пурпур",
                                "target_lang_sense_clarification": "о природе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发紫",
                                "target_lang_sense_clarification": "脸色转为紫色"
                            },
                            {
                                "target_lang_word": "变紫",
                                "target_lang_sense_clarification": "颜色变成紫色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "207b58e7-31c3-3909-b75d-2c2de18054f2",
                    "sense_definition": "To dye or stain something purple.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dye",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The juice from the berries <w>purpled</w> her fingers as she picked them.",
                            "target_lang_translations": {
                                "ru": "Сок ягод <w>окрасил в фиолетовый цвет</w> её пальцы, когда она их собирала.",
                                "zh": "她采摘浆果时，果汁把她的手指<w>染成紫色</w>了。"
                            }
                        },
                        {
                            "text": "Sunset <w>purpled</w> the hills in the distance, creating a stunning view.",
                            "target_lang_translations": {
                                "ru": "Закат <w>окрасил в пурпур</w> холмы вдалеке, создавая потрясающий вид.",
                                "zh": "日落将远处的山丘<w>染成紫色</w>，营造出迷人的景色。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Красить или пачкать что-либо в фиолетовый цвет.",
                        "zh": "将某物染成或弄成紫色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окрашивать в пурпур",
                                "target_lang_sense_clarification": "придавать цвет"
                            },
                            {
                                "target_lang_word": "красить в фиолетовый",
                                "target_lang_sense_clarification": "красителем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "染成紫色",
                                "target_lang_sense_clarification": "改变颜色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "908e7e74-76ff-35a4-a02b-828f588f4b5d",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Purple</w> arrived late to the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пёрпл</w> опоздал на встречу.",
                                "zh": "<w>珀普尔</w>先生开会迟到了。"
                            }
                        },
                        {
                            "text": "We looked up the <w>Purple</w> family in the local registry.",
                            "target_lang_translations": {
                                "ru": "Мы искали семью <w>Пёрпл</w> в местном реестре.",
                                "zh": "我们在当地登记处查询了<w>珀普尔</w>一家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пёрпл",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珀普尔",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}