                        "examples": [
                            {
                                "example_id": "daa6371e-12ad-46f8-b1ae-829c845bb0d4",
                                "sense_id": "67295a1b-dca4-391b-b2c3-6a9ae1fa5ac7",
                                "text": "My partner held the winning trick, and when the last card was on the board the score stood four to four. […] [T]he next gentleman will kindly follow suit — there is no renigging in this game — and the gentleman on my right will do the same."
                            },
                            {
                                "example_id": "909ae69a-00ec-4ae0-a4d2-0c85cee98ba7",
                                "sense_id": "67295a1b-dca4-391b-b2c3-6a9ae1fa5ac7",
                                "text": "[…] cutting, shuffling, playing, revoking, discarding, renigging."
                            },
                            {
                                "example_id": "4a06677f-e50b-4f1d-95a4-81bfe33b4b4a",
                                "sense_id": "67295a1b-dca4-391b-b2c3-6a9ae1fa5ac7",
                                "text": "[…] but so far the girls have at the fatal moment renigged."
                            }
