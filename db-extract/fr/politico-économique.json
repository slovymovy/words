                        ],
                        "examples": [
                            {
                                "example_id": "8552301c-f4c1-4d2a-bffb-ac9c1a7c9e54",
                                "sense_id": "2860a2cc-5e35-3508-bc41-bb65ccc17d14",
                                "text": "La Chine va présenter sa stratégie politico-économique vis-à-vis de l’Afrique à travers un livre blanc."
