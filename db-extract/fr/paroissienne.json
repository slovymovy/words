                        "glosses": [
                            "Femme qui fait partie d’une paroisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0581bc19-4d33-4f27-ac6a-26641e453ffe",
                                "sense_id": "55a40262-0d35-3c82-b611-f3b2f2d997e0",
                                "text": "Selon les conseils de la paroissienne qui m’a tamponné ma crédenciale, je me rends au presbytère qui se trouve deux rues plus loin."
                            },
                            {
                                "example_id": "7a6ce314-efad-41a3-8985-96066c814c15",
                                "sense_id": "55a40262-0d35-3c82-b611-f3b2f2d997e0",
                                "text": "[…] elle va adjurer les paroissiennes négligentes de se liguer, de faire une chaîne de prières continues qui empêche le mal de passer […]"
                            }
                        ]
                    }
