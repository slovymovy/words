                                    {
                                        "sense_id": "53db6c22-eba8-37a2-85b2-be782db51224",
                                        "entry_id": "a8887ba4-3b67-3abd-86d3-b7862b05140f",
                                        "glosses": [
                                            "With certain (often specified) limits placed upon it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a35859-0905-3c03-8374-d42490471a66",
                                        "entry_id": "a8887ba4-3b67-3abd-86d3-b7862b05140f",
                                        "glosses": [
                                            "Restricted, small, few, not plentiful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6a7f3e-1fc1-4835-b68b-a06544fd2819",
                                                "sense_id": "04a35859-0905-3c03-8374-d42490471a66",
                                                "text": "There are limited places available. Enrol now or you will miss out."
                                            },
                                            {
                                                "example_id": "3e169ca0-2440-4af9-a26d-024d394cbab0",
                                                "sense_id": "04a35859-0905-3c03-8374-d42490471a66",
                                                "text": "I have a limited understanding of quantum physics."
                                            },
                                            {
                                                "example_id": "8e9d3e87-dac9-42fb-b2f4-8eeb681c07d0",
                                                "sense_id": "04a35859-0905-3c03-8374-d42490471a66",
                                                "text": "Secondly, I continue to base my concepts on intensive study of a limited suite of collections, rather than superficial study of every packet that comes to hand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "limited",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "411d352b-942c-3c3b-88c3-643f3d316e58",
                                        "entry_id": "d400b97f-b0ff-3179-badf-bd66eb01e2e5",
                                        "glosses": [
                                            "An express train that only halts at a limited number of stops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f135975d-e9c4-43cf-ab33-2aba440ce954",
                                                "sense_id": "411d352b-942c-3c3b-88c3-643f3d316e58",
                                                "text": "Twentieth Century Limited"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e3b6e6b-d091-4672-87ab-7d6269cdb9e2",
                        "source_entry_id": "16cc51fd-3bae-39f8-9667-f9a6655ebebf",
                        "source_sense_id": "9ecb897d-9902-345d-b145-4d31329cb744",
                        "target_lang_word": "begrenzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begrenzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                        "entry_id": "efdeea8b-57be-3bf3-8a10-4c309bfe0f5e",
                                        "glosses": [
                                            "nicht grenzenlos groß oder umfassend, sondern auf ein gewisses Maß beschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80ec302-08c5-4868-8a01-dd89747adc1d",
                                                "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                                "text": "Sie hatte leider ein nur begrenztes Auffassungsvermögen."
                                            },
                                            {
                                                "example_id": "7f930896-53c7-43e4-b4f5-6eb6edfa976c",
                                                "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                                "text": "Die Anzahl der Studierenden ist begrenzt."
                                            },
                                            {
                                                "example_id": "9ea2adf5-fae9-4548-b907-1bda4b8dbcfd",
                                                "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                                "text": "Die Studiengebühren für den IMS-Masterstudiengang betragen insgesamt 6.000 €. Eine begrenzte Anzahl von Voll- und Teilstipendienplätzen wird Bewerbern zur Verfügung gestellt."
                                            },
                                            {
                                                "example_id": "dbce6153-1cf0-447c-aa39-47989d9e1756",
                                                "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                                "text": "EU-Justizkommissar Franco Frattini will die EU stärker für zeitlich begrenzte Zuwanderung öffnen. Dazu werde er demnächst einen Vorschlag vorlegen […]"
                                            },
                                            {
                                                "example_id": "4fdebde9-2bd3-4872-a27d-9d66a12f1926",
                                                "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                                "text": "Die Parteien [SPD und Grüne] schließen einen Koalitionsvertrag [für die Bremer Landesregierung]. Angesichts der prekären Finanzlage sind Handlungsmöglichkeiten aber begrenzt."
                                            },
                                            {
                                                "example_id": "2f6400be-494f-41eb-9bfa-2c1ece571b82",
                                                "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                                "text": "Die Bewegung [\"Stopp der Überbevölkerung - zur Sicherung der natürlichen Lebensgrundlagen\"] wurde Anfang der 1970er-Jahre gegründet, um auf die Auswirkungen des Bevölkerungswachstums auf die Umwelt und die begrenzten Ressourcen aufmerksam zu machen."
                                            },
                                            {
                                                "example_id": "78fe4485-719e-46f4-b487-70803e478e23",
                                                "sense_id": "45af51b6-04b2-3e47-b4d7-142a17d1dae3",
                                                "text": "„Die größten Schwachstellen von mRNA-Impfstoffen sind die begrenzte Haltbarkeit und die aufwendige Lagerung. Die ersten Impfchargen hielten nur sechs Monate, mittlerweile werden sie nach neun Monaten vernichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
