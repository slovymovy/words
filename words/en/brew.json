    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9acc1931-30a9-34d0-b228-317a10cd2fff",
                    "sense_definition": "To prepare a hot beverage, such as tea or coffee, by infusing ingredients in hot water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "make_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning, I <w>brew</w> a fresh pot of coffee before heading to work.",
                            "target_lang_translations": {
                                "ru": "Каждое утро перед выходом на работу я <w>варю</w> свежий кофейник кофе.",
                                "es": "Cada mañana, <w>preparo</w> una cafetera de café recién hecho antes de ir al trabajo."
                            }
                        },
                        {
                            "text": "She learned how to <w>brew</w> herbal tea using dried leaves from her garden.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>заваривать</w> травяной чай из сушёных листьев из своего сада.",
                                "es": "Aprendió a <w>infusionar</w> té de hierbas usando hojas secas de su jardín."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brew coffee",
                        "brew tea",
                        "brew a pot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приготавливать горячий напиток (чай или кофе), настаивая его на горячей воде.",
                        "es": "Preparar una bebida caliente, como té o café, infusionando los ingredientes en agua caliente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заваривать",
                                "target_lang_sense_clarification": "чай или кофе (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "заварить",
                                "target_lang_sense_clarification": "чай или кофе (совершенный вид)"
                            },
                            {
                                "target_lang_word": "варить",
                                "target_lang_sense_clarification": "кофе"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "preparar",
                                "target_lang_sense_clarification": "café o té"
                            },
                            {
                                "target_lang_word": "hacer",
                                "target_lang_sense_clarification": "café o té"
                            },
                            {
                                "target_lang_word": "infusionar",
                                "target_lang_sense_clarification": "té o hierbas"
                            },
                            {
                                "target_lang_word": "colar",
                                "target_lang_sense_clarification": "café de filtro"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edfd2f1b-022f-3982-85bb-578ed43661fd",
                    "sense_definition": "To make beer or ale by steeping, boiling, and fermenting malt and hops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "make_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local company has been <w>brewing</w> traditional ale for over a century.",
                            "target_lang_translations": {
                                "ru": "Местная компания <w>варит</w> традиционный эль уже более века.",
                                "es": "La empresa local lleva más de un siglo <w>elaborando</w> cerveza tradicional."
                            }
                        },
                        {
                            "text": "He decided to <w>brew</w> his own beer at home on the weekends.",
                            "target_lang_translations": {
                                "ru": "Он решил по выходным <w>варить</w> собственное пиво дома.",
                                "es": "Decidió <w>hacer</w> su propia cerveza en casa los fines de semana."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brew beer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить пиво или эль путём вымачивания, кипячения и сбраживания солода и хмеля.",
                        "es": "Fabricar o elaborar cerveza mediante la maceración, cocción y fermentación de malta y lúpulo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варить",
                                "target_lang_sense_clarification": "пиво или эль (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "сварить",
                                "target_lang_sense_clarification": "пиво или эль (совершенный вид)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "elaborar",
                                "target_lang_sense_clarification": "cerveza"
                            },
                            {
                                "target_lang_word": "fabricar",
                                "target_lang_sense_clarification": "cerveza"
                            },
                            {
                                "target_lang_word": "hacer",
                                "target_lang_sense_clarification": "cerveza artesanal o casera"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f6486c3-ac07-3dd5-9f3d-12a29a1da7e0",
                    "sense_definition": "To develop or form gradually, especially of something dangerous, unpleasant, or threatening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "develop_threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark clouds gathered in the sky, warning that a storm was <w>brewing</w>.",
                            "target_lang_translations": {
                                "ru": "В небе сгустились тёмные тучи, предупреждая о том, что <w>назревает</w> буря.",
                                "es": "Nubarrones oscuros se juntaron en el cielo, advirtiendo que se <w>avecinaba</w> una tormenta."
                            }
                        },
                        {
                            "text": "Trouble was <w>brewing</w> between the two rival groups long before the argument started.",
                            "target_lang_translations": {
                                "ru": "Неприятности между двумя соперничающими группами <w>назревали</w> задолго до начала ссоры.",
                                "es": "Los problemas se estaban <w>fraguando</w> entre los dos grupos rivales mucho antes de que comenzara la discusión."
                            }
                        }
                    ],
                    "common_phrases": [
                        "storm is brewing",
                        "trouble is brewing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно зарождаться или надвигаться (об опасности, буре или неприятностях).",
                        "es": "Formarse o gestarse gradualmente, especialmente algo peligroso, desagradable o amenazante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назревать",
                                "target_lang_sense_clarification": "о конфликте, буре или беде"
                            },
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "о буре или грозе"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "avecinarse",
                                "target_lang_sense_clarification": "una tormenta o peligro"
                            },
                            {
                                "target_lang_word": "fraguarse",
                                "target_lang_sense_clarification": "un conflicto o problema"
                            },
                            {
                                "target_lang_word": "gestarse",
                                "target_lang_sense_clarification": "problemas o disturbios"
                            },
                            {
                                "target_lang_word": "prepararse",
                                "target_lang_sense_clarification": "una tormenta o tempestad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e6fd2d5-8430-3842-a1b8-b83bd80262a5",
                    "sense_definition": "To devise, concoct, or plot a secret or mischievous plan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "develop_threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels met in secret to <w>brew</w> a plot against the corrupt government.",
                            "target_lang_translations": {
                                "ru": "Повстанцы тайно встретились, чтобы <w>сплести</w> заговор против коррумпированного правительства.",
                                "es": "Los rebeldes se reunieron en secreto para <w>tramar</w> un complot contra el gobierno corrupto."
                            }
                        },
                        {
                            "text": "No one realized what kind of scheme the villains were <w>brewing</w>.",
                            "target_lang_translations": {
                                "ru": "Никто не понимал, какую интригу <w>замышляли</w> злодеи.",
                                "es": "Nadie se dio cuenta de qué clase de plan estaban <w>urdiendo</w> los villanos."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrive",
                        "hatch",
                        "plot"
                    ],
                    "common_phrases": [
                        "brew a plot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задумывать, готовить или замышлять тайный либо злой план.",
                        "es": "Tramar, urdir o planear en secreto algo dañino o malicioso."
