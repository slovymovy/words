                                        "entry_id": "07b41020-a2fe-3d42-bf57-a8451de47e51",
                                        "glosses": [
                                            "A surface to which rays reflected or refracted by another surface are tangents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "812d4c8f-c96c-47d7-9987-db81edf7cd81",
                                                "sense_id": "15507bd6-1678-3297-b2d1-2e4256885f1c",
                                                "text": "Caustic curves and surfaces are called catacaustic when formed by reflection, and diacaustic when formed by refraction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
