                                        "glosses": [
                                            "Divinité marine, « Vieillard de la Mer », gardien des troupeaux de phoques de Poséidon, doté du don de prophétie et du pouvoir de se métamorphoser."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f743531e-cad0-4f5f-b824-56153b54a564",
                                                "sense_id": "915f1629-86c6-3402-b519-fcfb94851131",
                                                "text": "Raoule se rua sur le lit de satin, découvrant de nouveau les membres blancs et souples de ce Protée amoureux qui, à présent, n’avait plus rien conservé de sa pudeur de vierge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce77f562-68d7-3836-bdd1-ff9e2cbe95c1",
                                        "entry_id": "09051b90-e745-3072-aa4a-ff52d88a35d3",
                                        "glosses": [
                                            "Satellite naturel de la planète Neptune."
                                        ],
