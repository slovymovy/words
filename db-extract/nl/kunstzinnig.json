                "senses": [
                    {
                        "sense_id": "204e13fa-e852-31d6-9a66-2704df3c3596",
                        "entry_id": "aa1ee08e-6891-3f92-80cc-8539ecaa6db8",
                        "glosses": [
                            "op mooie of betekenisvolle manier gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860153c8-5d32-45f5-8a38-c7b873a7aba4",
                                "sense_id": "204e13fa-e852-31d6-9a66-2704df3c3596",
                                "text": "Zij droeg vaak kunstzinnige kleding."
                            },
                            {
                                "example_id": "1b67e3c1-3c03-4f98-b77d-2027794fb098",
                                "sense_id": "204e13fa-e852-31d6-9a66-2704df3c3596",
                                "text": "Oom Carl Lauritz gedroeg zich als de nogal nonchalante wereldwijze gastheer die hij was en bood de nieuw gearriveerden champagne aan, ook deze keer in de kunstzinnig ingewikkelde glazen waar je bijna onmogelijk uit kon drinken zonder te morsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8675d709-ae1a-3169-a32f-21308560c61c",
                        "entry_id": "aa1ee08e-6891-3f92-80cc-8539ecaa6db8",
                        "glosses": [
                            "aanleg en interesse hebbend om mooie en betekenisvolle dingen te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de10566e-24d3-438a-af89-a4e9dbfafb0c",
                                "sense_id": "8675d709-ae1a-3169-a32f-21308560c61c",
                                "text": "Hij kwam uit een heel kunstzinnig gezin."
                            }
                        ]
                    },
                    {
                        "sense_id": "07d4b03f-920b-34ec-8ec4-513692b9abe4",
                        "entry_id": "aa1ee08e-6891-3f92-80cc-8539ecaa6db8",
                        "glosses": [
                            "met betrekking tot het maken van mooie of betekenisvolle dingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643583e6-7fae-46dd-abf7-365fd4b87a0d",
                                "sense_id": "07d4b03f-920b-34ec-8ec4-513692b9abe4",
                                "text": "Het is belangrijk om enigszins kunstzinnige vorming te ontwikkelen."
                            }
                        ]
                    }
