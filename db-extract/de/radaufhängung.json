                        "examples": [
                            {
                                "example_id": "b5d568d6-30a6-492d-8682-09b207c1fdee",
                                "sense_id": "19e1ffd3-c0b4-39fe-bce6-f50eceb00ae0",
                                "text": "„Das hatte Max Verstappen am Freitag schon zwei Frontflügel gekostet und ebenfalls zu einem Defekt an einer Radaufhängung geführt.“"
                            },
                            {
                                "example_id": "666d730f-b9c9-4991-9104-2c229ca25067",
                                "sense_id": "19e1ffd3-c0b4-39fe-bce6-f50eceb00ae0",
                                "text": "„Viele teuer zu reparierende Schäden sind für den Laien versteckt (Motor, Radaufhängung, Kupplung).“"
                            },
                            {
                                "example_id": "e52ba987-ffaf-469e-af63-150971efd137",
                                "sense_id": "19e1ffd3-c0b4-39fe-bce6-f50eceb00ae0",
                                "text": "„Die Radaufhängung (Querstabilisator) war beschädigt, das linke Vorderrad hing in der Luft.“"
                            }
                        ],
