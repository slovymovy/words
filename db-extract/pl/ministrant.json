                    {
                        "translation_id": "05cfef49-74ee-4b41-a85e-7e4911f0a48c",
                        "source_entry_id": "cee7a9ae-b973-3f67-87f7-7d1f586032e7",
                        "source_sense_id": "0147141b-0989-39a1-853e-a230b14159a2",
                        "target_lang_word": "Ministrant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ministrant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0295ce80-a7df-36b9-9329-4f1538c42299",
                                        "entry_id": "8df58851-d244-3219-95fc-3f565afabadd",
                                        "glosses": [
                                            "Messdiener in der katholischen Kirche, die während der heiligen Messe dem Pfarrer hilfreich zur Seite stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8664395b-01d6-4605-89b1-a2cfc21ce0b5",
                                                "sense_id": "0295ce80-a7df-36b9-9329-4f1538c42299",
                                                "text": "Als er jung war, war er Ministrant in der Kirche seines Heimatortes."
                                            },
                                            {
                                                "example_id": "235d21b0-72cf-445f-95a5-975458ed62d2",
                                                "sense_id": "0295ce80-a7df-36b9-9329-4f1538c42299",
                                                "text": "„Und so beschloss sie, dass er in der St.-Josef-Kirche Ministrant werden sollte.“"
                                            },
                                            {
                                                "example_id": "2cd8bb32-ae72-423f-ba03-33d2c5de2275",
                                                "sense_id": "0295ce80-a7df-36b9-9329-4f1538c42299",
                                                "text": "„Hin und wieder besuchen die Schwestern den Gottesdienst in der Liebfrauenkirche, wobei Benno, dem jüngsten Ministranten dort, aber auch anderen Kirchenbesuchern auffällt, dass sie nie zur Kommunion gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f52928cd-bf03-4820-951c-fd7847e2e44a",
                        "source_entry_id": "cee7a9ae-b973-3f67-87f7-7d1f586032e7",
                        "source_sense_id": "0147141b-0989-39a1-853e-a230b14159a2",
                        "target_lang_word": "Messdiener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Messdiener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67f1f044-ddaf-30e0-8452-069869d61339",
                                        "entry_id": "0bfccbdf-95ff-3f44-ad59-07da87ec3b13",
                                        "glosses": [
                                            "Person mit dienender Funktion in der Messe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "347ffbbf-22c7-4eef-af05-6f26e8bdb6e7",
                                                "sense_id": "67f1f044-ddaf-30e0-8452-069869d61339",
                                                "text": "„Luise schlängelte sich nach vorn, um festzustellen, dass hier tatsächlich auch weibliche Messdiener agierten.“"
                                            },
                                            {
                                                "example_id": "517703d9-e87c-4d93-bc4e-aae1b0a49be7",
                                                "sense_id": "67f1f044-ddaf-30e0-8452-069869d61339",
                                                "text": "„Noch war er nicht Messdiener gewesen, das Kirchenjahr noch eine märchenhaftere Erinnerung.“"
                                            },
                                            {
                                                "example_id": "1aee0417-81a1-4970-be3c-df78518c42f8",
                                                "sense_id": "67f1f044-ddaf-30e0-8452-069869d61339",
                                                "text": "„Eigentlich machte er nicht so viel Unfug wie manch anderer Messdiener in seiner Gemeinde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
