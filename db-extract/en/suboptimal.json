                        "entry_id": "ac81a70e-21e4-3b70-a019-43e119920ebb",
                        "glosses": [
                            "Worse than optimal; of less than the highest standard or quality."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "243a7a46-e38b-4e61-891f-5c971dac8f99",
                                "sense_id": "25dac24b-11b8-38e1-bbba-eddd7fcde6ef",
                                "text": "Near-synonym: submaximal"
                            },
                            {
                                "example_id": "3924fd94-2d95-4764-8e2d-4ee7fab3a877",
                                "sense_id": "25dac24b-11b8-38e1-bbba-eddd7fcde6ef",
                                "text": "A quickly produced suboptimal solution to a problem is often more useful than an optimal one that takes a long time to produce."
                            },
                            {
                                "example_id": "e81f1ccb-f674-4070-81a3-424bc478c74b",
                                "sense_id": "25dac24b-11b8-38e1-bbba-eddd7fcde6ef",
                                "text": "\"The way the consultation has been handled is suboptimal,\" she continued."
                            }
                        ]
                    }
