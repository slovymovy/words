                        "sense_id": "a83040b0-a89d-32d6-91f8-4b5244ebe3e2",
                        "entry_id": "5b4d122e-7eba-3c25-8c9d-95fc5932648d",
                        "glosses": [
                            "Avec des compléments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14467aa0-78f6-420f-b320-f42be368439a",
                                "sense_id": "a83040b0-a89d-32d6-91f8-4b5244ebe3e2",
                                "text": "Précis de l’Histoire moderne, ouvrage adopté par le Conseil royal de l’Université de France. Quatrième édition, revue et augmentée. — Paris, Hachette, 1833. In-8°."
                            }
                        ]
                    },
                    {
                        "sense_id": "3396817f-fe1c-3524-8a18-c4ccac2fd0c5",
                        "entry_id": "5b4d122e-7eba-3c25-8c9d-95fc5932648d",
                        "glosses": [
                            "Auquel est ajoutée une dimension technologique ou numérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74857d08-18d7-49a6-ab71-1c0201631eb7",
                                "sense_id": "3396817f-fe1c-3524-8a18-c4ccac2fd0c5",
                                "text": "Issu de la cyberculture américaine des années 1980, le mouvement « transhumaniste » compte parmi les plus ardents défenseurs d’un humain augmenté."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e2841bb-b6f0-35bf-8d9e-be02a1dd99f8",
                        "entry_id": "5b4d122e-7eba-3c25-8c9d-95fc5932648d",
                        "glosses": [
                            "Intervalle auquel est ajouté un dièse à la note supérieure ou un bémol à l’inférieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ac96d2-4899-4bb8-8f85-304b40bde25c",
                                "sense_id": "1e2841bb-b6f0-35bf-8d9e-be02a1dd99f8",
                                "text": "La gamme mineure, avec une seule altération produisant la note sensible, donne lieu à l’intervalle mélodique de seconde augmentée, et fait intervenir le genre chromatique dans une gamme diatonique."
                            }
                        ]
                    },
                    {
                        "sense_id": "91090583-011c-37e0-86a9-050cbc0ae7b9",
                        "entry_id": "5b4d122e-7eba-3c25-8c9d-95fc5932648d",
                        "glosses": [
                            "Majoré."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
