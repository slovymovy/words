                "senses": [
                    {
                        "sense_id": "5a086ca2-8c74-3015-82c4-5ad108cc4033",
                        "entry_id": "d8c2fc64-c3f3-33d4-8f3a-1afe047e120e",
                        "glosses": [
                            "Not optional."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6b575b76-cecc-46aa-9f97-3da4c847079c",
                                "sense_id": "5a086ca2-8c74-3015-82c4-5ad108cc4033",
                                "text": "Each and every one of the branches mentioned is presented for the pupil's study or exercise as an unoptional subject, essential to his proper training and development in his early school career."
                            },
                            {
                                "example_id": "daf02c47-9720-418c-83e0-6e9e565b2794",
                                "sense_id": "5a086ca2-8c74-3015-82c4-5ad108cc4033",
                                "text": "Within the reality of its factical certainty death is unoptional. Suicide and murder do not make death optional. Although we can bring about death prematurely by force or choice, we cannot choose to do the opposite; […]"
                            },
                            {
                                "example_id": "08264451-a6cf-4e6f-a032-d474262b3b5c",
                                "sense_id": "5a086ca2-8c74-3015-82c4-5ad108cc4033",
                                "text": "The jungle remains several walls away. More important is what sort of garden this “Darwin meets Aristotle” one is. What sort of abominations are going to become unoptional?"
                            }
                        ]
                    }
                ],
