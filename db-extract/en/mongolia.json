                    {
                        "translation_id": "90d1ed2d-974f-4757-9bf3-b88c433db5b8",
                        "source_entry_id": "fcf2e5a5-3ac8-338f-ab25-d81c07254107",
                        "source_sense_description": "East Asian country",
                        "target_lang_word": "Mongolie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mongolie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb19e4a0-d7fa-3fe5-ae3c-8b5ac9486ea6",
                                        "entry_id": "9b4a93e2-c2bf-31c8-a1a5-dad8c727a74f",
                                        "glosses": [
                                            "Région asiatique entre la Chine propre et la Sibérie, composée de l’ancienne Mongolie extérieure et de la Mongolie intérieure chinoise."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feb68185-d6ae-4331-be0e-9d052fbba001",
                                                "sense_id": "cb19e4a0-d7fa-3fe5-ae3c-8b5ac9486ea6",
                                                "text": "À présent voici les bazars avec les mille produits de la Perse, de la Chine, de la Turquie, de la Sibérie, de la Mongolie."
                                            },
                                            {
                                                "example_id": "620ef98d-6b25-4204-912e-c79aa119a3c4",
                                                "sense_id": "cb19e4a0-d7fa-3fe5-ae3c-8b5ac9486ea6",
                                                "text": "— Il a trouvé dans un désert de Mongolie un immense crâne de cheval (du cheval de Gengis Khan, a-t-il tout de suite prétendu), un crâne maléfique qui semait la ruine et la mort et qui a d’ailleurs fini par faire capoter leur avion."
                                            },
                                            {
                                                "example_id": "b79d0ac1-72ee-492d-aad1-afcf59433ab8",
                                                "sense_id": "cb19e4a0-d7fa-3fe5-ae3c-8b5ac9486ea6",
                                                "text": "Le bouddhisme lamaïque a créé depuis le XIIIᵉ siècle des liens étroits entre le Tibet et la Mongolie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f59eb663-6841-3068-a649-a536ec4d13c3",
                                        "entry_id": "9b4a93e2-c2bf-31c8-a1a5-dad8c727a74f",
                                        "glosses": [
                                            "Pays des Mongols correspondant à l’ancienne Mongolie extérieure, entouré de la Russie au nord et de la Chine au sud, dont la capitale est Oulan-Bator."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "048c5627-6b5c-460a-ba65-40bf1ed464a5",
                        "source_entry_id": "fcf2e5a5-3ac8-338f-ab25-d81c07254107",
                        "source_sense_description": "East Asian country",
                        "target_lang_word": "Mongolei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mongolei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                        "entry_id": "44ccedfe-ae32-3e9f-982b-cec09fcc2e99",
                                        "glosses": [
                                            "Staat im Innern Ostasiens mit 3 Millionen Einwohnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fba28ee-8024-42d2-84cf-dd33299a95d8",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "Ulan-Bator ist die Hauptstadt der Mongolei."
                                            },
                                            {
                                                "example_id": "bc7c69b4-66fa-45e8-ac4d-83526839d364",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "„Von allen unabhängigen Staaten der Welt ist die Mongolei das Land mit der geringsten Bevölkerungsdichte.“"
                                            },
                                            {
                                                "example_id": "75f458e4-badc-4019-99b6-d84a0b697cc2",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "„Wegen der geografisch bedingt sehr kargen Böden hat sich in der Mongolei fast überhaupt kein Ackerbau entwickelt, im Gegenzug ist aber eine hoch spezialisierte Viehwirtschaft entstanden.“"
                                            },
                                            {
                                                "example_id": "9a5930e5-a443-48b6-ab23-e8cee88e396f",
                                                "sense_id": "cafb1568-17af-338b-940c-7aaa2f81e986",
                                                "text": "„Er hat sie mir vor zehn Jahren gegeben, gleich nach seiner Rückkehr aus der Mongolei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
