                                "sense_id": "fb17679d-c222-3be9-a98c-e68b22f2eb50",
                                "text": "L’eau est une ressource conflictuelle au Moyen-Orient."
                            },
                            {
                                "example_id": "6ff7e85a-5c96-48d5-875e-f2c14ec7fe22",
                                "sense_id": "fb17679d-c222-3be9-a98c-e68b22f2eb50",
                                "text": "Il s'agit d'une question conflictuelle."
                            },
