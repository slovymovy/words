                ],
                "translations": [
                    {
                        "translation_id": "b31436a7-0413-4185-8d3a-27043e5aacde",
                        "source_entry_id": "610cc1d7-19d6-3808-b011-5e2a9386a272",
                        "source_sense_id": "1298d0b8-2f84-30ca-b98d-17fad3851a78",
                        "target_lang_word": "David",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "David",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38514242-36f6-3352-9745-e6c2280f1441",
                                        "entry_id": "f582d8ba-1990-3293-9c01-81b01581837b",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da679939-28aa-4fa9-9873-e2659dc61fec",
                                                "sense_id": "38514242-36f6-3352-9745-e6c2280f1441",
                                                "text": "David Copperfield. Dwight David Eisenhower. Michelangelo's David. None of these Davids would seem the same if their names were Dave. David, with its final \"d\", sounds finished and complete, whereas Dave just kind of hangs there in the air, indefinitely."
                                            },
                                            {
                                                "example_id": "16646549-da78-4bbe-aa0a-576c876f599c",
                                                "sense_id": "38514242-36f6-3352-9745-e6c2280f1441",
                                                "text": "Well, don't think I'll settle for so little, Mr. Talbot. Or should I call you David? I think you look like a David, you know, righteous and clean living and all of that."
                                            },
                                            {
                                                "example_id": "32dd2aff-ce49-4c07-b46b-24ea4fc05507",
                                                "sense_id": "38514242-36f6-3352-9745-e6c2280f1441",
                                                "text": "Parkland shooting survivor David Hogg called on Republican House Minority Leader Kevin McCarthy Thursday to denounce Rep. Marjorie Taylor Greene, who has faced intense criticism this week over incendiary remarks she made in recent years as well as a viral video in which she harasses Hogg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc73218d-360f-3203-a92e-224083785db4",
                                        "entry_id": "f582d8ba-1990-3293-9c01-81b01581837b",
                                        "glosses": [
                                            "The second king of Judah and Israel, the successor of King Saul in the Hebrew Bible; the son of Jesse and the father of Nathan and King Solomon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2e2094d-eb42-41f5-acf9-9c52dffaef8d",
                                                "sense_id": "bc73218d-360f-3203-a92e-224083785db4",
                                                "text": "David the son of Jesse said, and the man who was raised up on high, the anointed of the God of Jacob, and the sweet psalmist of Israel, said, The Spirit of the LORD spake by me, and his word was in my tongue."
                                            },
                                            {
                                                "example_id": "f94a04cd-efda-41a3-9f6c-6ccdb1b5850f",
                                                "sense_id": "bc73218d-360f-3203-a92e-224083785db4",
                                                "text": "Some devout Christians are among the most fervent advocates of the death penalty, contradicting Jesus Christ and misinterpreting Holy Scriptures and numerous examples of mercy. We remember God’s forgiveness of Cain, who killed Abel, and the adulterer King David, who arranged the killing of Uriah, the husband of Bathsheba, his lover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce56bf0a-83e7-355a-854d-da25e2a1f54b",
                                        "entry_id": "f582d8ba-1990-3293-9c01-81b01581837b",
                                        "glosses": [
                                            "A surname originating as a patronymic common in Wales, in honor of the ancient Saint David of Wales."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "877e9b35-e4f5-3f48-8de2-fa0501a40ffb",
                                        "entry_id": "f582d8ba-1990-3293-9c01-81b01581837b",
                                        "glosses": [
                                            "A female given name, often combined with a feminine middle name (e.g. David Ann)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
