{
    "word_family": [
        "buoyancy",
        "buoyant",
        "buoyantly",
        "lifebuoy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ee1ab86-7bde-3734-b0d7-376318353c83",
                    "sense_definition": "A floating object anchored in water to mark a location, warn of danger, or indicate a navigational channel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "floating_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors carefully steered the ship around the red <w>buoy</w> to avoid the shallow rocks.",
                            "target_lang_translations": {
                                "cs": "Námořníci opatrně navedli loď kolem červené <w>bóje</w>, aby se vyhnuli mělkým skalám."
                            }
                        },
                        {
                            "text": "A bright yellow <w>buoy</w> was placed in the bay to mark the safe swimming area.",
                            "target_lang_translations": {
                                "cs": "V zátoce byla umístěna jasně žlutá <w>bóje</w>, aby označila bezpečnou oblast pro plavání."
                            }
                        }
                    ],
                    "synonyms": [
                        "float",
                        "marker"
                    ],
                    "common_phrases": [
                        "navigation buoy",
                        "moored buoy"
                    ],
                    "target_lang_definitions": {
                        "cs": "Plovoucí objekt ukotvený ve vodě, který označuje polohu, varuje před nebezpečím nebo vymezuje plavební dráhu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bóje",
                                "target_lang_sense_clarification": "plovoucí značení na vodní hladině"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dccf383-9ecb-357f-aa6b-bd1cc104845f",
                    "sense_definition": "A lifebuoy or life preserver designed to keep a person afloat in water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "floating_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lifeguard threw a rescue <w>buoy</w> to the struggling swimmer.",
                            "target_lang_translations": {
                                "cs": "Plavčík hodil tonoucímu plavci <w>záchranný kruh</w>."
                            }
                        },
                        {
                            "text": "Every boat must carry at least one emergency <w>buoy</w> for passenger safety.",
                            "target_lang_translations": {
                                "cs": "Každá loď musí mít pro bezpečnost cestujících alespoň jeden nouzový <w>plovák</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lifebuoy",
                        "life preserver",
                        "lifesaver"
                    ],
                    "common_phrases": [
                        "rescue buoy"
                    ],
                    "target_lang_definitions": {
                        "cs": "Záchranný kruh nebo plovák určený k udržení osoby na hladině."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "záchranný kruh",
                                "target_lang_sense_clarification": "osobní záchranný prostředek"
                            },
                            {
                                "target_lang_word": "plovák",
                                "target_lang_sense_clarification": "obecné označení pro nadnášející předmět"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95b6b014-b804-34fe-96da-d5707664b6a6",
                    "sense_definition": "To lift the spirits of someone; to maintain or enhance enthusiasm or confidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support_or_lift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Buoyed</w> by the good news, the team worked with renewed energy.",
                            "target_lang_translations": {
                                "cs": "<w>Povzbuzen</w> dobrou zprávou, tým pracoval s obnovenou energií."
                            }
                        },
                        {
                            "text": "Her encouraging words helped to <w>buoy</w> his spirits during the difficult exam period.",
                            "target_lang_translations": {
                                "cs": "Její povzbudivá slova mu pomohla <w>pozdvihnout</w> náladu během náročného zkouškového období."
                            }
                        }
                    ],
                    "synonyms": [
                        "uplift",
                        "encourage",
                        "cheer",
                        "hearten"
                    ],
                    "antonyms": [
                        "depress",
                        "discourage"
                    ],
                    "common_phrases": [
                        "buoy spirits",
                        "buoyed by success"
                    ],
                    "target_lang_definitions": {
                        "cs": "Povzbudit někoho, zlepšit něčí náladu nebo zvýšit nadšení a sebedůvěru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "povzbudit",
                                "target_lang_sense_clarification": "zlepšit něčí náladu"
                            },
                            {
                                "target_lang_word": "podpořit",
                                "target_lang_sense_clarification": "posílit něčí odhodlání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "611c59b0-c651-35f5-818e-128b375072f7",
                    "sense_definition": "To support or maintain prices, an economy, or interest at a high level.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_or_lift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strong consumer spending helped to <w>buoy</w> the economy during the recession.",
                            "target_lang_translations": {
                                "cs": "Silné spotřebitelské výdaje pomohly <w>podpořit</w> ekonomiku během recese."
                            }
                        },
                        {
                            "text": "Increased demand for housing continues to <w>buoy</w> property prices in the city.",
                            "target_lang_translations": {
                                "cs": "Zvýšená poptávka po bydlení nadále <w>udržuje</w> ceny nemovitostí ve městě na vysoké úrovni."
                            }
                        }
                    ],
                    "synonyms": [
                        "bolster",
                        "support",
                        "sustain",
                        "prop up"
                    ],
                    "antonyms": [
                        "depress",
                        "weaken"
                    ],
                    "common_phrases": [
                        "buoy the economy",
                        "buoy prices"
                    ],
                    "target_lang_definitions": {
                        "cs": "Udržovat ceny, ekonomiku nebo zájem na vysoké úrovni."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podpořit",
                                "target_lang_sense_clarification": "udržet ekonomiku či ceny"
                            },
                            {
                                "target_lang_word": "udržet",
                                "target_lang_sense_clarification": "stabilizovat úroveň něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f2893d7-3a5a-3e53-9f8d-681769adb408",
                    "sense_definition": "To keep something afloat in water or aloft in the air.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The life jacket was designed to <w>buoy</w> him up until rescue arrived.",
                            "target_lang_translations": {
                                "cs": "Záchranná vesta byla navržena tak, aby ho <w>nadnášela</w>, dokud nepřijde pomoc."
                            }
                        },
                        {
                            "text": "Warm air currents can <w>buoy</w> glider planes high into the sky.",
                            "target_lang_translations": {
                                "cs": "Teplé vzdušné proudy mohou <w>vynést</w> větroně vysoko na oblohu."
                            }
                        }
                    ],
                    "synonyms": [
                        "float",
                        "uplift"
                    ],
                    "antonyms": [
                        "sink"
                    ],
                    "common_phrases": [
                        "buoy up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Udržovat něco nad hladinou vody nebo ve vzduchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nadnášet",
                                "target_lang_sense_clarification": "udržovat na hladině nebo ve vzduchu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d6b3fa6-7d60-3a0a-811f-ed41dc0bcb69",
                    "sense_definition": "To mark a channel, location, or hazard with a buoy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harbor master decided to <w>buoy</w> the shallow channel to prevent ship groundings.",
                            "target_lang_translations": {
                                "cs": "Správce přístavu se rozhodl <w>vyznačit bójemi</w> mělký kanál, aby zabránil najetí lodí na mělčinu."
                            }
                        },
                        {
                            "text": "Workers will <w>buoy</w> off the dangerous reef before the sailing race begins.",
                            "target_lang_translations": {
                                "cs": "Dělníci před začátkem jachtařského závodu <w>bójemi ohradí</w> nebezpečný útes."
                            }
                        }
                    ],
                    "synonyms": [
                        "mark"
                    ],
                    "common_phrases": [
                        "buoy a channel",
                        "buoy off"
                    ],
                    "target_lang_definitions": {
                        "cs": "Označit plavební dráhu, polohu nebo nebezpečí pomocí bójí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyznačit bójemi",
                                "target_lang_sense_clarification": "označit prostor na vodě"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}