                ],
                "senses": [
                    {
                        "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                        "entry_id": "9661f7ad-b174-3390-adfd-732eaa9a9b15",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09aa80f6-4813-4e99-a442-6f8d026a9cf3",
                                "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                                "text": "Frau Ibeling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "21b3a6a6-2c7f-45c9-9f06-ca6ad09573e8",
                                "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                                "text": "Herr Ibeling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "858f9723-2d8c-4494-9a58-af3ffd98f198",
                                "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                                "text": "Die Ibelings kommen heute aus den Niederlanden."
                            },
                            {
                                "example_id": "727c77a7-156c-43d7-9ce5-105cdbccddfb",
                                "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                                "text": "Der Ibeling trägt nie die Schals, die die Ibeling ihm strickt."
                            },
                            {
                                "example_id": "597f7add-545c-49e6-9163-dd85428f313e",
                                "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ibeling kommt, geht der Herr Ibeling.“"
                            },
                            {
                                "example_id": "3ec95825-3c2d-45c3-bd5b-e030e80fe779",
                                "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                                "text": "Ibeling kommt und geht."
                            },
                            {
                                "example_id": "f566d5c9-4f74-4e31-901b-e46c5c9ba8f4",
                                "sense_id": "fc27e96a-90ae-3ea8-998e-4788d6489255",
                                "text": "Ibelings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
