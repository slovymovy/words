                                            {
                                                "example_id": "e53c8686-eb82-4d64-b837-7e46b66fc50b",
                                                "sense_id": "4fed378c-5131-3b8b-b91b-2b0f3f4243e4",
                                                "text": "And we will all the pleasures prove / That hills and valleys, dales and fields, / Woods, or steepy mountain yields"
                                            },
                                            {
                                                "example_id": "1a2e0a0d-66a0-43fd-b89f-c9c769de0f6c",
                                                "sense_id": "4fed378c-5131-3b8b-b91b-2b0f3f4243e4",
                                                "text": "Five miles meandering with a mazy motion, / Through wood and dale the sacred river ran, / Then reached the caverns measureless to man, / And sank in tumult to a lifeless ocean: [...]"
                                            },
                                            {
                                                "example_id": "b7708d44-ab94-43cf-b469-8d101fbb9a7b",
                                                "sense_id": "4fed378c-5131-3b8b-b91b-2b0f3f4243e4",
                                                "text": "The country about Nuncombe Putney is perhaps as pretty as any in England. It is beyond the river Teign, between that and Dartmoor, and is so lovely in all its variations of rivers, rivulets, broken ground, hills and dales, old broken, battered, time-worn timber, green knolls, rich pastures, and heathy common, that the wonder is that English lovers of scenery know so little of it."
                                            },
                                            {
                                                "example_id": "6a5c4d32-556d-46e3-9069-ee46ba54341f",
                                                "sense_id": "4fed378c-5131-3b8b-b91b-2b0f3f4243e4",
                                                "text": "Over hill, over dale / As we hit the dusty trail, / And those caissons go rolling along."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e4ec20-b814-3d13-88e0-e729c83d23c6",
                                        "entry_id": "315c4bff-9338-3323-9ad2-d89120386b9a",
                                        "glosses": [
                                            "The sunken or grooved portion of the surface of a vinyl record."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "242106fd-45a7-3ddd-9819-b941d88e45df",
                                        "entry_id": "a8f9e560-a97c-3de5-ae55-3ffcf6180956",
                                        "glosses": [
                                            "A trough or spout to carry off water, as from a pump."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a4afb6-b4c9-4d65-b863-0f857ebfc271",
                                                "sense_id": "242106fd-45a7-3ddd-9819-b941d88e45df",
                                                "text": "The pump-dale scupper is that to which the dale leads, that conveys the water from the pumps to the side on the lower deck of large ships."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
