                "senses": [
                    {
                        "sense_id": "d98f7cf8-5fcc-340c-a22a-228a1dbb0ce1",
                        "entry_id": "5ee46ba9-3a86-3947-8641-52567e013916",
                        "glosses": [
                            "Resembling an eel: long, thin and slippery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07a1ce75-2340-47e7-8db5-deb3a1a1f112",
                                "sense_id": "d98f7cf8-5fcc-340c-a22a-228a1dbb0ce1",
                                "text": "The great ugly sharky fish was hooked forward by Josh and placed in a great basket, where it lay writhing its eely tail, and flapping its wing-like fins as the boat slowly progressed, and bait after bait was replaced, many being untouched, the thornback, skate, or ray being the only fish taken."
                            },
                            {
                                "example_id": "8d3e2f29-d938-4f26-b3e6-63290d19ccee",
                                "sense_id": "d98f7cf8-5fcc-340c-a22a-228a1dbb0ce1",
                                "text": "That was a great long eely thing; but Joe Cross here says this was more like a great turtle, with flippers and a long neck, and a head like a snake.\""
                            },
                            {
                                "example_id": "800f5e4f-f34f-4440-b6f6-9b276219824f",
                                "sense_id": "d98f7cf8-5fcc-340c-a22a-228a1dbb0ce1",
                                "text": "Any eely creature that manages to blow itself up from “Pink, lank and warm” to a long wiener doing the hula tends to seize the imagination of us moderns."
                            },
                            {
                                "example_id": "5b321039-e6ae-4295-b5ca-3ca5532e9573",
                                "sense_id": "d98f7cf8-5fcc-340c-a22a-228a1dbb0ce1",
                                "text": "Veteran alto saxist Lou Donaldson faces the audience with a raised eyebrow and a toothy grin, and his horn's high-pitched, eely timbre--which still has plenty of the grease that made him a soul-jazz hero in the 60s and 70s--complements his squeaky voice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbaf6bde-8429-4a7b-bae5-6e0cc8184f39",
                        "source_entry_id": "5ee46ba9-3a86-3947-8641-52567e013916",
                        "source_sense_id": "d98f7cf8-5fcc-340c-a22a-228a1dbb0ce1",
                        "source_sense_description": "Thin and slippery",
                        "target_lang_word": "aalglatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aalglatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "423645fd-e126-3eac-a298-e11f0611626a",
                                        "entry_id": "6440c8b8-b6b8-32b5-8c9e-704b847c1e25",
                                        "glosses": [
                                            "von der oberflächlichen Beschaffenheit her wie eine Aalhaut; schleimig-glatt, schlüpfrig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871ee67c-746e-4f6f-bb06-1e4c6df42bdb",
                                                "sense_id": "423645fd-e126-3eac-a298-e11f0611626a",
                                                "text": "Das ist eine aalglatte Rutschbahn."
                                            },
                                            {
                                                "example_id": "84aac088-7251-485f-b3a9-98923d12ed27",
                                                "sense_id": "423645fd-e126-3eac-a298-e11f0611626a",
                                                "text": "Er kam mit ausrasiertem Nacken, mit pomadisierten Polkalocken, über die er eine seidene Schirmmütze gezogen hatte, mit aalglatt halbiertem Kabeljaugesicht, in dessen Mundecke ein Gaudaer Tonstummel saß, dem ein Rauchwölkchen entstieg, das sich übermütig gen Himmel kringelte."
                                            },
                                            {
                                                "example_id": "ca3eea6c-0081-4959-b743-6264c13facc2",
                                                "sense_id": "423645fd-e126-3eac-a298-e11f0611626a",
                                                "text": "Die Kohlmeise lief rasch wie eine Maus über den Schnee und glitt am nächsten Baumstamm aalglatt empor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98906db9-849e-3900-8ed4-beba8730b555",
                                        "entry_id": "6440c8b8-b6b8-32b5-8c9e-704b847c1e25",
                                        "glosses": [
                                            "sehr gewandt und kaum angreifbar, schwer (mit Argumenten) zu packen, für alles eine Ausrede habend, mit Hilfe geschickter Rhetorik seine Interessen durchsetzend"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1fe38fb-71d4-4465-baea-bfeb00fb67be",
                                                "sense_id": "98906db9-849e-3900-8ed4-beba8730b555",
                                                "text": "Er war ein aalglatter Typ."
                                            },
                                            {
                                                "example_id": "9af5ad99-6c5f-49e3-b64d-26fe3bb75dd3",
                                                "sense_id": "98906db9-849e-3900-8ed4-beba8730b555",
                                                "text": "Schauspieler Tim Robbins, der in »The Player« als aalglatter Filmproduzent glänzte, lobte einmal treffend, dass sich Altman nie »die Fesseln von Regeln« anlegte."
                                            },
                                            {
                                                "example_id": "ff2d61cd-7742-40fe-af49-eda22b9d42e1",
                                                "sense_id": "98906db9-849e-3900-8ed4-beba8730b555",
                                                "text": "An seine Stelle ist nun ein aalglatter Bürokrat getreten, der sich nicht in die Karten schauen lässt."
                                            },
                                            {
                                                "example_id": "3252b33c-8f80-419f-804e-a708aa61ab2d",
                                                "sense_id": "98906db9-849e-3900-8ed4-beba8730b555",
                                                "text": "Der Kerl ist einfach nicht zu fassen, er ist aalglatt."
                                            },
                                            {
                                                "example_id": "46abbfe4-f6b3-431c-92fa-01ca20887b28",
                                                "sense_id": "98906db9-849e-3900-8ed4-beba8730b555",
                                                "text": "Er ist aalglatt und bisher mit nichts zu überführen."
                                            },
                                            {
                                                "example_id": "50290abb-6730-4ea6-890b-018539e43a97",
                                                "sense_id": "98906db9-849e-3900-8ed4-beba8730b555",
                                                "text": "Wir werden ihm den Diebstahl nicht nachweisen können, er ist aalglatt und hat jede Menge Ausreden parat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
