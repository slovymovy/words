                                            {
                                                "example_id": "723302de-64c3-40df-b2ee-38c7fa03a506",
                                                "sense_id": "9f287aaf-ce52-33be-83c6-0f903d18aaf7",
                                                "text": "En France, les premières associations de satanistes qualifiés de « lucifériens » semblent se former à la fin du XIX^(ème) siècle. Elles consistent dans des réunions où l'ambiance des cercles littéraires se mêle au libertinage et à la culture ésotérique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27857959-ebcc-3c76-80b1-f1fd1c9e30fa",
                                        "entry_id": "802e8c0d-ea90-3510-ae72-3e4d06df11c7",
                                        "glosses": [
                                            "(Terre-Neuve) Un des noms vernaculaires donnés localement à l'océanite cul-blanc ou pétrel-tempête cul-blanc (Oceanodroma leucorhoa), oiseau de la famille des hydrobatidés (ordre des procellariiformes), par les pêcheurs terre-neuviens. → voir satani."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
