                                        "examples": [
                                            {
                                                "example_id": "4937a7fb-2ef3-4c08-8a30-ef67c25b24e8",
                                                "sense_id": "4b4df76b-da26-332b-97c6-f796440630ea",
                                                "text": "Zijn veroordeling wegens `kinderverkrachting'bracht hem in de gevangenisvleugel van zware gevallen, waar ook Charles Manson, opdrachtgever tot de moord op Polanski's vrouw Sharon Tate, zijn levenslange straf uitzat."
                                            },
