                                        ],
                                        "examples": [
                                            {
                                                "example_id": "280693a7-dac1-4d93-bac8-232708c66843",
                                                "sense_id": "0c247b36-6469-32eb-855b-f768bc6a16a3",
                                                "text": "puff of smoke"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56364be9-3c5d-3b79-a8a9-702208978073",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A sudden but small gust of wind, smoke, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc41d94-8bea-4f63-a9bb-d25029c01eef",
                                                "sense_id": "56364be9-3c5d-3b79-a8a9-702208978073",
                                                "text": "to every puff of wind a slave"
                                            },
                                            {
                                                "example_id": "66f77cc0-14cf-4bc6-88d1-9422d2ca6ae3",
                                                "sense_id": "56364be9-3c5d-3b79-a8a9-702208978073",
                                                "text": "\"The wind we had was only an early puff! You'll see we shall have our full allowance!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb0e6e7-d6b4-3994-8ac4-c1e19a985f4a",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "An act of inhaling smoke from a cigarette, cigar or pipe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a573e7d9-370c-4e9f-9ed2-63ec577a3792",
                                                "sense_id": "0bb0e6e7-d6b4-3994-8ac4-c1e19a985f4a",
                                                "text": "When I went to bed that night I found that I could not get to sleep. At five o'clock I got up and took a hot bath. I climbed back into bed and lighted one of the Chinese-made \"Great Wall\" cigars my hosts had thoughtfully provided, and sat puffing on the cigar and making notes about the events of the momentous week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0f6ad8e-a5ac-3b08-9439-1b6b373d04ae",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "The drug cannabis."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e3594f8-dd91-38db-ab18-5cabf02af020",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A flamboyant or alluring statement of praise."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec97ac14-7102-4801-b8ed-6ca9e891b7d8",
                                                "sense_id": "6e3594f8-dd91-38db-ab18-5cabf02af020",
                                                "text": "[…] though I care not one straw for the personal puffs of which I myself am so often the subject […]"
                                            },
                                            {
                                                "example_id": "ba61d9b9-c210-4d71-bfaa-42a35fef088c",
                                                "sense_id": "6e3594f8-dd91-38db-ab18-5cabf02af020",
                                                "text": "[…] we critics were not his fellow-guests, but simply deadheads whose business it was to \"dress the house\" and write puffs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3013defd-e137-3260-93b4-1c90df21254a",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A portion of fabric gathered up so as to be left full in the middle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c95b157e-f634-4ada-9851-9f28973799ab",
                                                "sense_id": "3013defd-e137-3260-93b4-1c90df21254a",
                                                "text": "a sleeve with a puff at the shoulder"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a0e337e-aa87-3a38-8acb-867c77e2060d",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A light cake filled with cream, cream cheese, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a41db009-7661-426e-bae8-d05440f009e1",
                                                "sense_id": "2a0e337e-aa87-3a38-8acb-867c77e2060d",
                                                "text": "cream puff"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f15d21-acd3-3c34-8469-f3cd083076d1",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A puffball."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4688159-fd2e-495f-97ed-4d7e123635af",
                                                "sense_id": "c5f15d21-acd3-3c34-8469-f3cd083076d1",
                                                "text": "Bozzacchio, an acorne. Also a puffe or mushrump full of dust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c1e615-78b9-3dc6-9ccb-0e7c3950c993",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A powder puff."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "565530f2-7f48-3e18-bbf6-7d757c9653f9",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A puffer, one who is employed by the owner or seller of goods sold at auction to bid up the price; an act or scam of that type."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "707ab89b-87dc-42e8-b205-471513677508",
                                                "sense_id": "565530f2-7f48-3e18-bbf6-7d757c9653f9",
                                                "text": "Is nothing to be said in praise of the \"Emporiums\" and \"Repositories\" and \"Divans,\" which formerly were mere insignificant tailors', toymen's, and tobacconists' shops? Is the transition from the barber's pole to the revolving bust of the perruquier, nothing? — the leap from the bare counter-traversed shop to the carpeted and mirrored saloon of trade, nothing? Are they not, one and all, practical puffs, intended to invest commerce with elegance, and to throw a halo round extravagance?"
                                            },
                                            {
                                                "example_id": "8ce98e4a-d4a4-499f-9ca6-1063cb813c9a",
                                                "sense_id": "565530f2-7f48-3e18-bbf6-7d757c9653f9",
                                                "text": "Here the duke is made the vehicle of the tailor's advertisement, and the prelusive compliments, ostensibly meant for his grace, merge into a covert recommendation of the coat. Several specimens might be given of this species of puff, which is to be met with in almost every paper, and is a favourite form with booksellers, professional men, &c."
                                            },
                                            {
                                                "example_id": "4712ad1f-1394-4d87-b734-6fc0bb3d768a",
                                                "sense_id": "565530f2-7f48-3e18-bbf6-7d757c9653f9",
                                                "text": "He was the eighteenth century king of spin, or, in the language of the day, the \"prince of puff\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b334ada0-ffd8-3dd6-b9bc-37693d23a1b0",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "A region of a chromosome exhibiting a local increase in diameter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b8ae016-234a-3b2f-a5e4-9681630d5db7",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "Life."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24f4324c-48c2-4216-859c-00cb5a1cfdd9",
                                                "sense_id": "7b8ae016-234a-3b2f-a5e4-9681630d5db7",
                                                "text": "Did you ever in your puff see such a perfect perisher?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06484622-3e58-3a79-96a8-af6d7b7b1799",
                                        "entry_id": "ca54421d-0847-31f1-8db9-2bbc457afbaa",
                                        "glosses": [
                                            "Synonym of poof: a gay man; especially one who is effeminate."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "puff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1203e73-5a48-3050-b0ee-2c45fb10fa03",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To emit smoke, gas, etc., in puffs."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754287eb-c6fc-4387-9984-6582e88e387e",
                                                "sense_id": "b1203e73-5a48-3050-b0ee-2c45fb10fa03",
                                                "text": "Still on the down line, the engine puffed away to the South, and in a few moments had disappeared in the darkness!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbb042d9-a07c-3e7b-a056-befde4e36d83",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To pant."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23581174-8693-458f-84c1-80d62eafe69a",
                                                "sense_id": "bbb042d9-a07c-3e7b-a056-befde4e36d83",
                                                "text": "By and by comes the ass back again, Puffing and Blowing, from the Chase."
                                            },
                                            {
                                                "example_id": "97b06932-d739-46bb-91e0-304b82fbc8ed",
                                                "sense_id": "bbb042d9-a07c-3e7b-a056-befde4e36d83",
                                                "text": "Puffing and panting, we plodded on until within about a mile of the harbor we came upon a sight that brought us all up standing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1275f4-e18e-3e7a-9bc5-40fb7d51b1bd",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To advertise."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b3cff0d-264c-31d3-a9db-200ec0a192a1",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To blow as an expression of scorn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c41bc544-d6f9-444f-9d2d-caee6af240cc",
                                                "sense_id": "2b3cff0d-264c-31d3-a9db-200ec0a192a1",
                                                "text": "It is really to defy Heaven to puff at damnation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c7703b-468b-36e0-b3bd-874a671a9fd9",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To swell with air; to be dilated or inflated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8895dba0-7d36-487b-8981-41a9b00d6e8e",
                                                "sense_id": "66c7703b-468b-36e0-b3bd-874a671a9fd9",
                                                "text": "'tis easy for a man to have a great opinion of his own knowledge , and be puff'd up by it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e2eafb2-f74c-331b-a47a-2972bb575331",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To breathe in a swelling, inflated, or pompous manner; hence, to assume importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14e8ff9-b50f-4ef9-8469-7472847eb222",
                                                "sense_id": "8e2eafb2-f74c-331b-a47a-2972bb575331",
                                                "text": "Then came brave Glory puffing by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1629257-6493-3a7d-8d6c-570d82289b33",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To drive with a puff, or with puffs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0d30d4-68d1-4225-bf46-9420e043cdbf",
                                                "sense_id": "d1629257-6493-3a7d-8d6c-570d82289b33",
                                                "text": "The clearing north will puff the clouds away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f55a2c6-72c7-3213-b92b-2a01d625dbf5",
                                        "entry_id": "64c3f133-6682-3760-9ac9-481ff17d198a",
                                        "glosses": [
                                            "To repel with words; to blow at contemptuously."
                                        ],
                                        "tags": [],
