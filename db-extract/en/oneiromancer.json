                        "examples": [
                            {
                                "example_id": "cc211426-48cf-49ca-93ac-bfa1f70ed6c4",
                                "sense_id": "a2b752a3-8db9-31c8-8bef-e1f847245ace",
                                "text": "The interpreter of dreams, like the ancient oneiromancer, often becomes involved in the dream himself and thus runs the risk of no longer being a true witness (which often happens in the analysis of psychotic patients)."
                            },
                            {
                                "example_id": "f38c273b-32d4-4c3d-81c0-2c634531821e",
                                "sense_id": "a2b752a3-8db9-31c8-8bef-e1f847245ace",
                                "text": "He called in an oneiromancer who explained that the dream signified the birth of a daughter."
                            },
                            {
                                "example_id": "dfe2396d-094f-4649-94c8-028ae7955788",
                                "sense_id": "a2b752a3-8db9-31c8-8bef-e1f847245ace",
                                "text": "2002, John Joseph Collins, Peter W. Flint (editors), Cameron VanEpps (assistant), The Book of Daniel: Composition and Reception, Volume 1, page 41,\nAlthough a Neo-Assyrian prayer to the sun-god speaks of the oneiromancer (šā^>ilu) explaining a dream to the king,¹⁰ there is no mention of oneiromancers among the court sages, nor does any of their letters deal with the interpretation of royal dreams."
                            }
