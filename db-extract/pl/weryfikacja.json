                        "target_lang_word": "Überprüfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überprüfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75f78bbe-bfeb-3143-a61a-48876d46a8e0",
                                        "entry_id": "14c01efa-52e8-3770-8687-b0863de7ad24",
                                        "glosses": [
                                            "Untersuchung einer Person oder Sache daraufhin, ob bei ihr bestimmte Anforderungen erfüllt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e8ae11-d4cf-49dc-ae07-0069a31c073a",
                                                "sense_id": "75f78bbe-bfeb-3143-a61a-48876d46a8e0",
                                                "text": "Die Überprüfungen ergaben, dass der Betrieb korrekt gearbeitet hat."
                                            },
                                            {
                                                "example_id": "e8052dfc-7599-4a28-8dc3-33c46f39a722",
                                                "sense_id": "75f78bbe-bfeb-3143-a61a-48876d46a8e0",
                                                "text": "„Die Staatsanwaltschaft ordnete eine Blutentnahme zur Überprüfung auf Alkohol- und Drogenkonsum an.“"
                                            },
                                            {
                                                "example_id": "1f2a1c5a-98b9-4e6b-a4ec-959ce445ef1f",
                                                "sense_id": "75f78bbe-bfeb-3143-a61a-48876d46a8e0",
                                                "text": "„Nach einer recht anständigen Überprüfung meines Koffers durch zwei Beamte, führte uns der Postillion in einen Gasthof gegenüber der Kirche San Carlo, wo ich meinen Koffer in ein eigenes Zimmer bringen ließ und Sir B. M. bat, ruhig zu warten.“"
                                            },
                                            {
                                                "example_id": "4d64b87b-4fb4-49b1-804b-625524feb83f",
                                                "sense_id": "75f78bbe-bfeb-3143-a61a-48876d46a8e0",
                                                "text": "„Denn das Grundprinzip der Naturwissenschaft ist die Überprüfung von Vermutungen durch das Experiment.“"
                                            },
                                            {
                                                "example_id": "0e2b6195-0592-494a-8226-8f06b2ccc6de",
                                                "sense_id": "75f78bbe-bfeb-3143-a61a-48876d46a8e0",
                                                "text": "„Heute weiß ich: Es hätte eine Überprüfung auch der eigenen Rolle erfordert, unbedeutend wie sie gewesen sein mag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
