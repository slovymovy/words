                "senses": [
                    {
                        "sense_id": "f03ee9b9-b562-3212-bc65-32c1ea16aac8",
                        "entry_id": "c5722478-a0f7-3693-a031-8a9ba03122e5",
                        "glosses": [
                            "To treat rubber with heat and (usually) sulfur to harden it and make it more durable."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9d82cf3c-6c1d-33c3-81ef-eac326957342",
                        "entry_id": "c5722478-a0f7-3693-a031-8a9ba03122e5",
                        "glosses": [
                            "To undergo such treatment."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "171472e5-2141-4c19-8e7f-9661849dc1fb",
                                "sense_id": "9d82cf3c-6c1d-33c3-81ef-eac326957342",
                                "text": "These vulcanized hearts, they only become more resistant when you ask for mercy."
                            },
                            {
                                "example_id": "2a10ec36-885e-46ec-a9bd-36bdf1c61380",
                                "sense_id": "9d82cf3c-6c1d-33c3-81ef-eac326957342",
                                "text": "Natural rubber […] vulcanizes readily at the double bonds to give a strong cross-linked structure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ac7703-bc45-4fdd-b0c9-b077b47a6fc0",
                        "source_entry_id": "c5722478-a0f7-3693-a031-8a9ba03122e5",
                        "source_sense_description": "to harden rubber with heat",
                        "target_lang_word": "vulkaniseren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
