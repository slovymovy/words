                                        "entry_id": "c43d9871-a2a9-3073-bf75-0fabd65c7fdb",
                                        "glosses": [
                                            "Having selected portions of the outside removed so as to give an impression of the interior."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501a04fd-5050-4a27-af7c-743b1bea1ff9",
                                                "sense_id": "f98bb331-6b8b-3b33-a2aa-8273a0298b88",
                                                "text": "While it used to take several seconds to generate a single cutaway view in a complex freeform model, you can now view them just about instantly by dynamically scrolling and rotating a plane forward and backward through an object."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cutaway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c29484d8-9417-3ea4-8cbe-65a82147c4ec",
                                        "entry_id": "8f77cd92-63ba-3d58-824b-d8f0f5d46a05",
                                        "glosses": [
                                            "The interruption of a continuously filmed action by inserting a view of something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de47ee5-70be-49a6-9235-b2a98ff1a9e4",
                                                "sense_id": "c29484d8-9417-3ea4-8cbe-65a82147c4ec",
                                                "text": "the director struggles to jazz up his stilted blocking with clumsy montage cutaways, which are only effective in the upbeat, darkly funny number “Sincerely, Me,” in which Evan dreams up a dance-filled fantasy of his fake friendship with Connor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b0e48d-14af-3956-a5d3-2f3dd7f2bcf8",
                                        "entry_id": "8f77cd92-63ba-3d58-824b-d8f0f5d46a05",
                                        "glosses": [
                                            "The interruption of a continuously filmed action by inserting a view of something else.",
                                            "A cut to a shot of person listening to a speaker so that the audience can see the listener's reaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d2fb6ca-e503-4918-bd0b-84aeeefe16fc",
                                                "sense_id": "d5b0e48d-14af-3956-a5d3-2f3dd7f2bcf8",
                                                "text": "Despite a pre-debate “memorandum of understanding” between the Bush campaign and the Kerry campaign that there would be no televised “cutaways” or reaction shots […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80702bfd-2a11-364c-874b-eb4e8b61de98",
                                        "entry_id": "8f77cd92-63ba-3d58-824b-d8f0f5d46a05",
                                        "glosses": [
                                            "A coat with a tapered frontline."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02ec3ce5-aa57-3281-a47d-cf8fb93b462b",
                                        "entry_id": "8f77cd92-63ba-3d58-824b-d8f0f5d46a05",
                                        "glosses": [
                                            "A diagram or model having outer layers removed so as to show the interior"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "874fd5f1-9f6a-4d9e-bf50-fb5ad104e15a",
                                                "sense_id": "02ec3ce5-aa57-3281-a47d-cf8fb93b462b",
                                                "text": "[...] The two assets of the book are clear explanation, and a multitude of extremely helpful diagrams, some in two colours, and cutaway photographs; these clearly unravel a difficult subject for the layman, as well as the student engineman for whom the primer is chiefly designed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64021df3-2e27-3310-9af9-8be69decf3f3",
                                        "entry_id": "8f77cd92-63ba-3d58-824b-d8f0f5d46a05",
                                        "glosses": [
                                            "An indentation in the upper bout of a guitar's body adjacent to the neck, allowing easier access to the upper frets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10cdb7bd-5eaf-3d43-8b89-aaa6125cb0dd",
                                        "entry_id": "8f77cd92-63ba-3d58-824b-d8f0f5d46a05",
                                        "glosses": [
                                            "Short for cutaway bog"
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c769b26-5214-4e6c-af2f-e90b72b67d34",
                                                "sense_id": "10cdb7bd-5eaf-3d43-8b89-aaa6125cb0dd",
                                                "text": "Thousands of hectares of cutaway are now under squares of grass and conifers, but by the 1990s it was obvious that most of the total area was suitable only for \"non-productive\" uses."
                                            },
                                            {
                                                "example_id": "00d6d849-8116-47d9-9ae5-aa04d7c90385",
                                                "sense_id": "10cdb7bd-5eaf-3d43-8b89-aaa6125cb0dd",
                                                "text": "This vast land-art and sculpture park is on a former cutaway bog – “cutaway” being the term for a bog where all the commercial peat has been extracted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
