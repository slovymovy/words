                    {
                        "sense_id": "f991b0d4-00d9-3aa5-bae0-02a7d654798c",
                        "entry_id": "0181d125-0874-37c9-9a84-337094f8e1a8",
                        "glosses": [
                            "Psychiatrie, Zustand erhöhter Reaktionsbereitschaft, Aufmerksamkeit, Wachheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d73263-ce9a-4b3f-ae40-7c145689a37f",
                                "sense_id": "f991b0d4-00d9-3aa5-bae0-02a7d654798c",
                                "text": "Die Arbeitsgruppe \"Vigilanz\" beschäftigt sich auf verschiedenen Ebenen mit den Symptomen Schläfrigkeit und Müdigkeit am Tage, welche ein gemeinsames, häufiges und prominentes Merkmal vieler Schlafstörungen unterschiedlicher Genese darstellen."
                            },
                            {
                                "example_id": "33152948-d3ab-48c7-8c37-7e21b2a17e8a",
                                "sense_id": "f991b0d4-00d9-3aa5-bae0-02a7d654798c",
                                "text": "Aufmerksamkeit ist eine zusammenfassende Bezeichnung für den Zustand gerichteter Vigilanz und dadurch bedingter Auffassungs- und Aktionsbereitschaft des Menschen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b4723d-749e-4b4d-9369-f5a5bcdf1786",
                        "source_entry_id": "0181d125-0874-37c9-9a84-337094f8e1a8",
                        "source_sense_id": "f991b0d4-00d9-3aa5-bae0-02a7d654798c",
                        "source_sense_description": "Psychiatrie, Psychologie: Zustand erhöhter Reaktionsbereitschaft, Aufmerksamkeit, Wachheit",
                        "target_lang_word": "vigilance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigilance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d62dd00d-9f0f-3b41-a046-f52ce3983788",
                                        "entry_id": "83a5ef6f-b28b-304b-a67a-7ed2fb908674",
                                        "glosses": [
                                            "Alert watchfulness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cfedda3-6acc-400b-ab36-9e1d8fb950db",
                                                "sense_id": "d62dd00d-9f0f-3b41-a046-f52ce3983788",
                                                "text": "To-night she took her accustomed place; for, during the night, no vigilance could satisfy her but her own: any eye but hers might close in momentary forgetfulness."
                                            },
                                            {
                                                "example_id": "e526e4b4-4f70-494e-84fe-60242281db79",
                                                "sense_id": "d62dd00d-9f0f-3b41-a046-f52ce3983788",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed. And thus we came by a circuitous route to Mohair, the judge occupied by his own guilty thoughts, and I by others not less disturbing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f735780b-06c8-3654-831b-1b3c3049b409",
                                        "entry_id": "83a5ef6f-b28b-304b-a67a-7ed2fb908674",
                                        "glosses": [
                                            "Close and continuous attention."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ca4bbfc-450d-4d33-92fe-1c4dc9d325d1",
                                                "sense_id": "f735780b-06c8-3654-831b-1b3c3049b409",
                                                "text": "But you must remember, my fellow-citizens, that eternal vigilance by the people is the price of liberty, and that you must pay the price if you wish to secure the blessing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95656442-fa03-3303-a6e4-4cb55bc19dc0",
                                        "entry_id": "83a5ef6f-b28b-304b-a67a-7ed2fb908674",
                                        "glosses": [
                                            "A guard; a person set to watch."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
