                    {
                        "translation_id": "3ce5307e-b140-4176-82d3-139bf0b6be03",
                        "source_entry_id": "44270226-a161-30f5-a93c-b8f9f118f4a4",
                        "source_sense_id": "fd1e9718-25a9-337c-8b5e-a37ec6b57507",
                        "target_lang_word": "adverse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                                        "entry_id": "d3aa551e-831c-32ec-86c2-9cda8af21a87",
                                        "glosses": [
                                            "Unfavorable; antagonistic in purpose or effect; hostile; actively opposing one's interests or wishes; contrary to one's welfare; acting against; working in an opposing direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945967c8-0a7b-4b6a-8a1d-e56327e4a8d7",
                                                "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                                                "text": "adverse criticism"
                                            },
                                            {
                                                "example_id": "94e15c23-143c-4cb0-a0d6-8ab9843f4ad9",
                                                "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                                                "text": "adverse weather"
                                            },
                                            {
                                                "example_id": "43b3a5b8-b83b-45b0-82a5-db6827e200ac",
                                                "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                                                "text": "Happy were it for us all if we bore prosperity as well and wisely as we endure an adverse fortune."
                                            },
                                            {
                                                "example_id": "dcaa1f99-6264-4086-bc65-981759159efa",
                                                "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                                                "text": "Northbound expresses have the hardest work to perform, with adverse grades predominating from Willesden to Tring."
                                            },
                                            {
                                                "example_id": "3f691111-a292-4924-b628-837520ec03c1",
                                                "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                                                "text": "Several types of diesel locomotive have been tested on this working and as a result the probable choice will be Type 2 diesels in pairs, without bankers. The crucial factor in the selection of this method is the higher degree of adhesion obtained than with a single Type 4; on trial one of the latter showed that in very adverse conditions it might slip to a standstill at one of the two tricky spots on the steep climb from Tyne Dock to Consett."
                                            },
                                            {
                                                "example_id": "da309d75-e8b1-446a-ba68-62563b6361e2",
                                                "sense_id": "ac8c66bd-8a71-33a4-a0b8-0abc4358ac31",
                                                "text": "He said Robins had not been in trouble with the law before and had no previous convictions. Jail would have an adverse effect on her and her three children as she was the main carer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c481e5d1-1292-3a9c-ac67-fbf6183d5dd0",
                                        "entry_id": "d3aa551e-831c-32ec-86c2-9cda8af21a87",
                                        "glosses": [
                                            "Opposed; contrary; opposing one's interests or desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c446ffb6-ac45-4454-89b9-c7ca1620b4dc",
                                                "sense_id": "c481e5d1-1292-3a9c-ac67-fbf6183d5dd0",
                                                "text": "adverse circumstances"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2eaeaf1-7a25-33ac-9102-7085bd9031e2",
                                        "entry_id": "d3aa551e-831c-32ec-86c2-9cda8af21a87",
                                        "glosses": [
                                            "Opposite; confronting."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6614178e-25b4-495e-850e-1bd234c0e560",
                                                "sense_id": "b2eaeaf1-7a25-33ac-9102-7085bd9031e2",
                                                "text": "the adverse page"
                                            },
                                            {
                                                "example_id": "262d3a94-6378-4dbc-ae61-e1b9decacbfd",
                                                "sense_id": "b2eaeaf1-7a25-33ac-9102-7085bd9031e2",
                                                "text": "the adverse party"
                                            },
                                            {
                                                "example_id": "5d1bef57-2a4c-4b90-be48-645fafe9b63f",
                                                "sense_id": "b2eaeaf1-7a25-33ac-9102-7085bd9031e2",
                                                "text": "Calpe's adverse height / […] must greet my sight"
                                            },
                                            {
                                                "example_id": "47aa7996-8d96-4d40-9fd6-02f173fbaab7",
                                                "sense_id": "b2eaeaf1-7a25-33ac-9102-7085bd9031e2",
                                                "text": "Now the families of the two lovers were not on very good terms; they were, I believe, rather adverse to one another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
