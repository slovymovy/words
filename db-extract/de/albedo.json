                                "target_senses": [
                                    {
                                        "sense_id": "5f1e4893-4bb4-30fa-b284-a4fe9206e1c5",
                                        "entry_id": "60941587-3be6-37af-a999-4b6ca4aac32c",
                                        "glosses": [
                                            "The fraction of incident light or radiation reflected by a surface or body, commonly expressed as a percentage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2597697b-60bd-4629-9cde-2e088e3a28f0",
                                                "sense_id": "5f1e4893-4bb4-30fa-b284-a4fe9206e1c5",
                                                "text": "For track, painting rails white at weak points that are more prone to buckling (where the 'critical rail temperature' is close to the 'stress free temperature' [...]) increases their albedo and can help slow how quickly they heat up, reducing their temperature by perhaps five degrees or so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f9498e-7e21-38bb-9265-470f0442e512",
                                        "entry_id": "60941587-3be6-37af-a999-4b6ca4aac32c",
                                        "glosses": [
                                            "The whitish inner portion of the rind of citrus fruits that is a source of pectin, commonly referred to as the pith."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67183f7b-9a39-35a2-9ec3-e5aede9c4af9",
                                        "entry_id": "60941587-3be6-37af-a999-4b6ca4aac32c",
                                        "glosses": [
                                            "One of the four major stages of the magnum opus, involving purification of the prima materia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08329960-db94-4e0b-90f1-29da8ebb98ef",
                        "source_entry_id": "6dea59a1-1848-3ee3-95cd-23664be17e90",
                        "source_sense_id": "e8efaa4c-8dcd-3930-bb00-3353afb78c4b",
                        "source_sense_description": "Rückstrahlungsvermögen eines nicht strahlenden Körpers (auch Himmelskörpers), einer Fläche",
                        "target_lang_word": "albédo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "albédo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                                        "entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
                                        "glosses": [
                                            "Grandeur caractérisant la proportion d’énergie lumineuse réfléchie ou diffusée par un corps éclairé."
                                        ],
                                        "tags": [
                                            "Planétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85842cbb-bb2f-40d3-92a8-3c304329fea8",
                                                "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                                                "text": "Ces surfaces sombres, dénuées du pouvoir réfléchissant de la glace et qu’on appelle l’albédo, absorbent les rayons du Soleil qui réchauffent l’océan. Plus il capte la chaleur, plus il fait fondre la glace et plus il retarde la reprise du gel à l’arrivée de l’hiver."
                                            },
                                            {
                                                "example_id": "21a08d79-acd1-4619-ba6b-0d6a51c2e1ff",
                                                "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                                                "text": "L’albédo planétaire dépend à la fois de l’albédo des surfaces et de la présence de nuages."
                                            },
                                            {
                                                "example_id": "f4a2e29f-2ed9-4ce0-b382-cf9fa5add358",
                                                "sense_id": "36a031cf-fe51-34cf-a140-f7aa5ea35efc",
                                                "text": "L’albédo moyen terrestre est de 0,3 toutes surfaces confondues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33106983-88c9-3acf-9963-4b052d09e18f",
                                        "entry_id": "74ae1f23-4042-3aa8-a32d-df4e0b60c051",
                                        "glosses": [
                                            "Mésocarpe de couleur blanche des agrumes. (Face interne de la peau des agrumes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5def168-ba5e-419b-9be6-9f94027b8033",
                                                "sense_id": "33106983-88c9-3acf-9963-4b052d09e18f",
                                                "text": "La peau et l’albédo sont épais, la pulpe est riche en pépins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
