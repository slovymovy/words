                ],
                "senses": [
                    {
                        "sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                        "entry_id": "4dbe9ef6-39f0-3166-98f6-62635985866f",
                        "glosses": [
                            "To unite again."
                        ],
                        "tags": [
                            "ambitransitive",
                            "reciprocal"
                        ],
                        "examples": [
                            {
                                "example_id": "33aaba52-fdc8-4d5e-adff-56228ca18b8d",
                                "sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                                "text": "After ten years apart, the band will reunite."
                            },
                            {
                                "example_id": "9776b984-bef6-4904-b303-896629a2a4de",
                                "sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                                "text": "Two of the members tried several times, but failed to reunite the band."
                            },
                            {
                                "example_id": "2250bb38-7157-4ba8-8108-ea327f1cbc27",
                                "sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                                "text": "Since 2001, islanders and their immediate Chinese neighbors have been able to take the 90-minute boat ride between the Chinese port of Mawei and the Matsu town of Nankan, allowing people with the same ancestry to reunite after generations of estrangement. Now any Chinese or Taiwanese can make the trip."
                            },
                            {
                                "example_id": "2b2e9160-c0bc-414c-a911-b46f24f1c5c2",
                                "sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                                "text": "Reuniting the cast of Trainspotting for a new adventure 21 years on could have gone badly. The BBC’s misjudged This Life + 10, bringing the cast of the iconic 90s TV drama back together, is a case in point."
                            },
                            {
                                "example_id": "4dc73712-fab9-466b-87ec-c153d56830d7",
                                "sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                                "text": "Come find me / I'm hiding in the deepest night / Far away from the riddle of time / Come down here / In twilight we can reunite / Sharing hopes of a wonderful life"
                            },
                            {
                                "example_id": "470b9970-9474-4132-90b1-e7b45783dbb6",
                                "sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                                "text": "London Transport Museum's Siddy Holloway and rail historian and RAIL contributor Tim Dunn will reunite to discover more hidden sites and little-known stories from the Tube."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7afe27f5-c061-4ec5-9f42-578948abaedc",
                        "source_entry_id": "4dbe9ef6-39f0-3166-98f6-62635985866f",
                        "source_sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                        "source_sense_description": "to unite again",
                        "target_lang_word": "herenigen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herenigen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3975652-575d-3a57-b27f-eda45ea1219c",
                                        "entry_id": "d2eaf319-08b5-33b9-b7dc-b9feb2bf8396",
                                        "glosses": [
                                            "opnieuw tot een eenheid maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4335d58-52e4-457d-b6d3-beb5635f77fa",
                                                "sense_id": "b3975652-575d-3a57-b27f-eda45ea1219c",
                                                "text": "Na de val van de Muur werd Duitsland herenigd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de0e4013-ef54-4131-9e97-1497e0f47ab5",
                        "source_entry_id": "4dbe9ef6-39f0-3166-98f6-62635985866f",
                        "source_sense_id": "c6d74734-b79d-3d82-9e87-290cb480858c",
                        "source_sense_description": "to unite again",
                        "target_lang_word": "réunir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réunir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e887090-4159-30a0-9a57-c24888dc152d",
                                        "entry_id": "c91dc231-18dc-326f-92c4-d8e55562dbee",
                                        "glosses": [
                                            "Rejoindre ce qui est désuni, séparé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d0b391-a8d2-4cd7-b575-13045382fdc4",
                                                "sense_id": "7e887090-4159-30a0-9a57-c24888dc152d",
                                                "text": "Réunir les lèvres d’une plaie."
                                            },
                                            {
                                                "example_id": "4f5f12ec-c9ed-428b-992f-1a09f9c714d6",
                                                "sense_id": "7e887090-4159-30a0-9a57-c24888dc152d",
                                                "text": "Les chairs de la plaie se sont réunies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cccaedeb-58ce-374e-832e-984417ec935e",
                                        "entry_id": "c91dc231-18dc-326f-92c4-d8e55562dbee",
                                        "glosses": [
                                            "Unir une chose à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cfab103-5547-4dff-b427-5d8221df35f1",
                                                "sense_id": "cccaedeb-58ce-374e-832e-984417ec935e",
                                                "text": "Nous noterons en passant que l’’Azalea de Desvaux (Azalées de pleine terre des fleuristes), et de quelques auteurs, doit lui être aussi définitivement réuni en ce qu'il n'en diffère que par le nombre fixe des étamines et un feuillage décidu : caractères qui n'empêchent pas un facile croisement avec les espèces de toutes les autres sections des vrais Rhododendrum ; […]."
                                            },
                                            {
                                                "example_id": "ca5dec3c-250d-4767-810d-c355e52242ea",
                                                "sense_id": "cccaedeb-58ce-374e-832e-984417ec935e",
                                                "text": "Cette galerie réunit les deux corps de logis. — Le cou réunit la tête au corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f7529ae-e73a-3f7a-bbbd-111d40624855",
                                        "entry_id": "c91dc231-18dc-326f-92c4-d8e55562dbee",
                                        "glosses": [
                                            "Réconcilier, remettre en bonne intelligence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd10335-f38b-4d7a-8251-802919e87872",
                                                "sense_id": "7f7529ae-e73a-3f7a-bbbd-111d40624855",
                                                "text": "Ils étaient brouillés, un intérêt commun les a réunis."
                                            },
                                            {
                                                "example_id": "6cf6cb56-08e9-4463-a4ba-c6290488c690",
                                                "sense_id": "7f7529ae-e73a-3f7a-bbbd-111d40624855",
                                                "text": "Ils se sont réunis contre l’ennemi commun."
                                            },
                                            {
                                                "example_id": "bff9a373-cb08-49e1-9aba-a05c0d3b5d4c",
                                                "sense_id": "7f7529ae-e73a-3f7a-bbbd-111d40624855",
                                                "text": "Ils se sont réunis sur ce point-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b886ae1d-78bc-3e96-a0b5-1bc23080c4f6",
                                        "entry_id": "c91dc231-18dc-326f-92c4-d8e55562dbee",
                                        "glosses": [
                                            "Rejoindre une chose démembrée au tout dont elle faisait partie, en parlant de fiefs, de domaines, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1151c3e3-6d4a-4525-9acd-1641b660eee6",
                                                "sense_id": "b886ae1d-78bc-3e96-a0b5-1bc23080c4f6",
                                                "text": "Réunir au domaine royal un fief qui avait été donné en apanage."
                                            },
                                            {
                                                "example_id": "0069369e-4d3d-4ff0-ac46-b151f614bcad",
                                                "sense_id": "b886ae1d-78bc-3e96-a0b5-1bc23080c4f6",
                                                "text": "Réunir au fief dominant ce qui en été démembré."
                                            },
                                            {
                                                "example_id": "6b46657c-489e-4413-a333-c4c6bc0ba31c",
                                                "sense_id": "b886ae1d-78bc-3e96-a0b5-1bc23080c4f6",
                                                "text": "Réunir des domaines aliénés."
                                            },
                                            {
                                                "example_id": "c8fd1eb2-b736-4a16-9d55-126c5145486c",
                                                "sense_id": "b886ae1d-78bc-3e96-a0b5-1bc23080c4f6",
                                                "text": "On voulut empêcher cette province de se réunir au royaume dont elle avait été séparée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39df9e14-3846-3dc4-b888-95874c32ad8d",
                                        "entry_id": "c91dc231-18dc-326f-92c4-d8e55562dbee",
                                        "glosses": [
                                            "Joindre pour la première fois une chose à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1266ac7-f0a3-481d-b22c-39a9bcd90301",
                                                "sense_id": "39df9e14-3846-3dc4-b888-95874c32ad8d",
                                                "text": "Ce roi, par ses conquêtes, par son mariage, a réuni telle province à la couronne."
                                            },
                                            {
                                                "example_id": "af173306-ab98-4d2e-ad98-febee943c3c0",
                                                "sense_id": "39df9e14-3846-3dc4-b888-95874c32ad8d",
                                                "text": "Cette administration a été réunie à telle autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "231c2f40-a980-3b90-abda-3e51026542a6",
                                        "entry_id": "c91dc231-18dc-326f-92c4-d8e55562dbee",
                                        "glosses": [
                                            "Rassembler."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b356aaa1-4dec-4587-a542-ae7188599bf7",
                                                "sense_id": "231c2f40-a980-3b90-abda-3e51026542a6",
                                                "text": "Le général Suchet, averti, s'est porté à Rozan, a réuni ses troupes, et a fait reconnaître et observer l'ennemi, qui prit position en avant du camp de Borki, et jeta sa cavalerie dans la plaine."
                                            },
                                            {
                                                "example_id": "6ce9fd50-e134-471f-b333-fa1e256f57d3",
                                                "sense_id": "231c2f40-a980-3b90-abda-3e51026542a6",
                                                "text": "[…], John, Patrick et Henry qui, eux aussi, n'avaient pas les yeux dans leur poche, n'osèrent donc adresser un mot à la nouvelle venue quand l'heure du dîner les eut réunis autour de la table, copieusement garnie."
                                            },
                                            {
                                                "example_id": "3f95ab5c-c55a-42a3-88c5-3e2874e9e679",
                                                "sense_id": "231c2f40-a980-3b90-abda-3e51026542a6",
                                                "text": "Le lendemain, je me rendis à bord du Rochester, où une quarantaine d'officiers, réunis à leur mess autour d'une table immense, me firent une excellente réception."
                                            },
                                            {
                                                "example_id": "4e8edaa6-3b08-4b79-b169-b317d6af74c8",
                                                "sense_id": "231c2f40-a980-3b90-abda-3e51026542a6",
                                                "text": "Faute de pouvoir faire toute la lumière désirable sur ce fait énigmatique, nous réunirons ici le faisceau de vraisemblances et de témoignages qui peuvent seuls nous éclairer pour le moment."
                                            },
                                            {
                                                "example_id": "6bcbc1ca-f39c-48ea-8415-539e81f81ff4",
                                                "sense_id": "231c2f40-a980-3b90-abda-3e51026542a6",
                                                "text": "La pièce aurait pu tomber d'un côté comme de l'autre. Comme à son habitude, Anthony Moris a accepté de se présenter à la presse une fois le match terminé. Mais visiblement, les conditions n'étaient pas réunies pour effectuer une bonne interview."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
