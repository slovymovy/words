                                            {
                                                "example_id": "0b7ea8eb-7887-46e1-a76d-30234f218b6b",
                                                "sense_id": "15a1cd33-96a7-3858-b279-d05ca349ce1c",
                                                "text": "Après avoir renversé le roi Farouk Ier en 1952, Nasser développe une idéologie panarabe, le nassérisme."
                                            },
