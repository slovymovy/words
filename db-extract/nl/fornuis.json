                                "target_senses": [
                                    {
                                        "sense_id": "1636de1c-b2ef-3b2f-a802-08fdf545c70f",
                                        "entry_id": "99a5b7c4-3708-3f77-8b5c-310a91c7682a",
                                        "glosses": [
                                            "A cookstove."
                                        ],
                                        "tags": [
