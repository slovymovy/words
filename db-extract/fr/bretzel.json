                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0f01032-ba51-30d7-aae4-6538cdc13871",
                        "entry_id": "7efa2c8d-bee6-3cec-9bc8-4e5444436566",
                        "glosses": [
                            "Biscuit salé à base de pâte de brioche, spécialité d’Alsace et d’Allemagne en forme de gros nœud."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "01ca8e31-c0bd-4293-8222-a4fdd7d8b6de",
                                "sense_id": "a0f01032-ba51-30d7-aae4-6538cdc13871",
                                "text": "Nous sommes restés là, à boire du champagne, à croquer dans des bretzels géants, à tartiner du caviar."
                            },
                            {
                                "example_id": "d3a4ccc0-ade4-4ab0-9214-b14e09cd7ad4",
                                "sense_id": "a0f01032-ba51-30d7-aae4-6538cdc13871",
                                "text": "Les bretzels en boîtes métalliques et scellées hermétiquement pourront se conserver pendant plus d’un an."
                            }
                        ]
                    },
                    {
                        "sense_id": "af09999d-9a03-3dac-b1fe-1877eaa094bc",
                        "entry_id": "7efa2c8d-bee6-3cec-9bc8-4e5444436566",
                        "glosses": [
                            "Petit biscuit sec apéritif fabriqué industriellement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c35574f-7463-4787-8656-a2b406097797",
                        "source_entry_id": "7efa2c8d-bee6-3cec-9bc8-4e5444436566",
                        "target_lang_word": "Brezel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brezel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                        "entry_id": "20c99f0a-b83b-3bea-9280-b02366485381",
                                        "glosses": [
                                            "größeres mit Salz beziehungsweise Zucker bestreutes Laugen- oder Zuckergebäck, dessen Form dem Buchstaben B ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f7be8e-df74-45e4-8312-420509f929c4",
                                                "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                                "text": "Das alte Zunftzeichen der Bäcker ist die Brezel."
                                            },
                                            {
                                                "example_id": "b69f9f13-aaec-4703-b90d-6592fbcb574c",
                                                "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                                "text": "„Das Wort Brezel heißt überall auf der Welt gleich: Brezel oder Pretzel – das begreifen wir in diesem Augenblick.“"
                                            },
                                            {
                                                "example_id": "0d4bcda7-d5a7-4481-8244-c6413603d491",
                                                "sense_id": "81e544c4-f350-388b-9d98-f3c49e800f9a",
                                                "text": "„Die Prinz-Heinrich-Mütze, die der Gast aufbehält, und die Brezeln weisen ihn als Deutschen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cd09bad-c0aa-344b-bc68-801f939a0153",
                                        "entry_id": "20c99f0a-b83b-3bea-9280-b02366485381",
                                        "glosses": [
                                            "Knabbergebäck, das in seiner Form einer Brezel [1] nachempfunden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1af0b6-0ab3-4bf7-8b37-8ee9245e3ad2",
                                                "sense_id": "3cd09bad-c0aa-344b-bc68-801f939a0153",
                                                "text": "Zum Bier gibts Salzstangen, Chips und Brezel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "91538c52-0c02-3521-8f82-7c335df4e11e",
                                        "entry_id": "20c99f0a-b83b-3bea-9280-b02366485381",
                                        "glosses": [
                                            "Art Waffel, dünnes, knuspriges, im Waffeleisen hergestelltes süßes oder salziges, auch mit Kümmel gewürztes Gebäck"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15908b2b-3b6c-4732-945f-fd879f126188",
                                                "sense_id": "91538c52-0c02-3521-8f82-7c335df4e11e",
                                                "text": "„Ob süss oder pikant, ob Taler oder Cornet: Mit dem Brezelieisen «Knusper-Träumli» werden alle Brezeli-Träume wahr!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb861308-27a0-4c9f-8363-7e105416af11",
