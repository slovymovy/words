                "senses": [
                    {
                        "sense_id": "3320181f-2972-37c3-a5dd-9bb579118cf2",
                        "entry_id": "5a017add-2b27-3a91-9b2c-af77ff31a425",
                        "glosses": [
                            "to pack (up), to be packing (up), to be packing one's things"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e113a442-76be-4d36-8e58-69c2e871b415",
                                "sense_id": "3320181f-2972-37c3-a5dd-9bb579118cf2",
                                "text": "О́льга Ива́новна укла́дывалась ве́село, и да́же щёки у неё разгоре́лись от удово́льствия.",
                                "translation": "Olga Ivanovna, in good spirits, packed her clothes. Her cheeks burnt with pleasure.",
                                "english": "Olga Ivanovna, in good spirits, packed her clothes. Her cheeks burnt with pleasure."
                            }
                        ]
                    },
                    {
                        "sense_id": "9780d551-4d1a-31e1-b347-0a27dbaf73d3",
                        "entry_id": "5a017add-2b27-3a91-9b2c-af77ff31a425",
                        "glosses": [
                            "to go (in, into)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b5c73f-3306-468c-a4d5-18b459d645b9",
                                "sense_id": "9780d551-4d1a-31e1-b347-0a27dbaf73d3",
                                "text": "Не всё укла́дывается в э́тот сунду́к.",
                                "translation": "Not everything will go into the trunk.",
                                "english": "Not everything will go into the trunk."
                            }
                        ]
                    },
                    {
                        "sense_id": "301c29c1-ece4-3caf-9288-303f07668a8e",
                        "entry_id": "5a017add-2b27-3a91-9b2c-af77ff31a425",
                        "glosses": [
                            "to keep (within), to confine oneself (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa045ab4-48ba-4d7b-a644-9bc04d857275",
                                "sense_id": "301c29c1-ece4-3caf-9288-303f07668a8e",
                                "text": "укла́дываться в гра́фик",
                                "translation": "to be on schedule",
                                "english": "to be on schedule"
                            },
                            {
                                "example_id": "edfd2a95-cfa8-4dab-8fcf-6c37f302fa54",
                                "sense_id": "301c29c1-ece4-3caf-9288-303f07668a8e",
                                "text": "укла́дываться в за́данный срок",
                                "translation": "to meet the deadline",
                                "english": "to meet the deadline"
                            },
                            {
                                "example_id": "75a89ee2-5d8f-49db-8cec-e0367b4f4016",
                                "sense_id": "301c29c1-ece4-3caf-9288-303f07668a8e",
                                "text": "Мо́жет ли он укла́дываться в де́сять мину́т?",
                                "translation": "Can he manage in ten minutes?; Can he confine himself to ten minutes?",
                                "english": "Can he manage in ten minutes?; Can he confine himself to ten minutes?"
                            }
                        ]
                    },
                    {
                        "sense_id": "98d841da-251f-313d-8137-43bfe9a540ff",
                        "entry_id": "5a017add-2b27-3a91-9b2c-af77ff31a425",
                        "glosses": [
                            "to lie down"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f7e4c2-afff-4c71-84cb-63ac69e79cc8",
                                "sense_id": "98d841da-251f-313d-8137-43bfe9a540ff",
                                "text": "укла́дываться в посте́ль",
                                "translation": "to go to bed",
                                "english": "to go to bed"
                            }
                        ]
                    },
                    {
                        "sense_id": "5476ea2f-5de1-3c4c-b2c2-3e9e79404914",
                        "entry_id": "5a017add-2b27-3a91-9b2c-af77ff31a425",
                        "glosses": [
                            "to penetrate into consciousness, to become clear; to be assimilated"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "207bd69a-9c0f-4390-a217-eaea42865456",
                                "sense_id": "5476ea2f-5de1-3c4c-b2c2-3e9e79404914",
                                "text": "У вас в голове́ не укла́дывается.",
                                "translation": "It's not getting into your head.",
                                "english": "It's not getting into your head."
                            }
                        ]
                    },
