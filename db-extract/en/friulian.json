                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b818ff9-d9fd-4c08-b8a3-b4b9fd2049fe",
                                                "sense_id": "ca6869fc-ce8b-32d6-a109-ff48a6be7b20",
                                                "text": "Etwa 600.000 Menschen sprechen Friulanisch."
                                            },
                                            {
                                                "example_id": "3e42cc94-28ef-40b5-a08b-27968774040a",
                                                "sense_id": "ca6869fc-ce8b-32d6-a109-ff48a6be7b20",
                                                "text": "„Der größere Teil des Bürgertums sprach Italienisch, das auch Gerichtssprache war, die Arbeiter und Bauern sprachen dagegen Slowenisch oder Friulanisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
