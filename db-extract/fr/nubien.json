                "senses": [
                    {
                        "sense_id": "07fb3cdf-3cb1-31ee-8c27-a55e22941ae5",
                        "entry_id": "5022da6c-eb58-35a8-ad7d-1e6746061a42",
                        "glosses": [
                            "Habitant de Nubie, ou personne en étant originaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbcfe3a-0488-4beb-875d-3a471f58b241",
                                "sense_id": "07fb3cdf-3cb1-31ee-8c27-a55e22941ae5",
                                "text": "À notre arrivée, les sables, et les Nubiens qui ont soin de les pousser, avaient fermé l’entrée."
                            },
                            {
                                "example_id": "3afe62ba-b25a-4dc7-9774-a7b206b3bb44",
                                "sense_id": "07fb3cdf-3cb1-31ee-8c27-a55e22941ae5",
                                "text": "il dit au Nubien attentif :\n« Il est onze heures et demie, Haydée ne peut tarder à arriver. A-t-on prévenu les femmes françaises ? »"
                            },
                            {
                                "example_id": "f4d2f918-ab5b-46c8-a8cb-a12750c746a8",
                                "sense_id": "07fb3cdf-3cb1-31ee-8c27-a55e22941ae5",
                                "text": "D’Alexandrie au Caire on ne rencontre personne. Du Caire à la mer Rouge non plus. Sauf un Nubien qui vend du café, à quarante kilomètres de tout. Au milieu d’exactement rien."
                            }
                        ]
                    }
                ],
                "translations": [
