                ],
                "senses": [
                    {
                        "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                        "entry_id": "6f030114-7521-3a58-a596-d5aafbd4c18e",
                        "glosses": [
                            "Umstände/Situation bei der praktischen Durchführung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76ee3fc7-19e2-4810-862e-d8aef31e3712",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Andere Studierende wiederum passen die Studienvorgaben den tatsächlichen Praxisrealitäten und ihren Aktivitäten kreativ an […].“"
                            },
                            {
                                "example_id": "83516322-e57e-41fc-b674-45a826256979",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Hier weichen die juristischen Anforderungen von der Praxisrealität und dem, was angesichts der Vielzahl an auszustellenden Rezepten möglich ist, stark voneinander ab.“"
                            },
                            {
                                "example_id": "27793a71-9a5c-40c9-af74-4250926cf228",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Dieses Szenario entspricht aus unseren empirischen Erfahrungen im Wesentlichen der Praxisrealität.“"
                            },
                            {
                                "example_id": "c0c6db02-bfb1-4695-a87a-85e149831947",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Natürlich unterscheidet sich die durch die Simulation produzierte Wirklichkeit von der in der Praxisrealität.“"
                            },
                            {
                                "example_id": "ca5b52e7-849c-4fec-bada-432318c58bf4",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Angesichts der kurz skizzierten derzeitigen Praxisrealität mit vielfältigen Einschränkungen erscheint es nicht unproblematisch, für eine therapeutische Sozialarbeit im Altersbereich zu plädieren, und sie muß begründet werden.“"
                            },
                            {
                                "example_id": "ea9319e0-6b82-4366-9394-888deaf6386a",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Plastischer und eindringlicher als es hier geschieht, kann die Kluft zwischen vermittelten Handlungszielen und Praxisrealität kaum geschildert werden.“"
                            },
                            {
                                "example_id": "42b35316-7ed3-44db-beac-0ec534b62efe",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Auszubildende müssen im ersten Jahr der Ausbildung in der Praxisrealität multimorbide Klienten betreuen und in komplexen Pflegesituationen selbstständig und ‚schnell‘ handeln.“"
                            },
                            {
                                "example_id": "ca0af3a8-4ed1-4879-9387-55cc06e16dae",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Außerdem sind Lösungen dafür zu erarbeiten, wie sich die Praxisrealität mit dem Anspruch, den Forschungsstand systematisch zu berücksichtigen, vereinen lässt.“"
                            },
                            {
                                "example_id": "8629fb81-8b22-48eb-9997-25dee5d70052",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Viele ursprüngliche Absichten des Gesetzes sind von der Praxisrealität eingeholt worden.“"
                            },
                            {
                                "example_id": "369de26d-8d0c-4f74-ba6a-8423a723f6a0",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„Dieser kritisch lesende Student dürfte auf die Realität gut vorbereitet sein, auf eine Praxisrealität mit seinem heterogenen Patientenspektrum, das vom Anbeter grüner Medizin bis zum nihilistischen Skeptiker reicht.“"
                            },
                            {
                                "example_id": "d4bdb563-cd43-4005-ba3c-1c7177636d71",
                                "sense_id": "a87967ec-a329-3c11-8067-df12d3be87f6",
                                "text": "„So werde ein Zugewinn an Impulsen durch den Einblick in andere Praxisrealitäten ermöglicht und auf diese Weise sei es möglich, Maßnahmen zur Verbesserung der eigenen Praxis abzuleiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
