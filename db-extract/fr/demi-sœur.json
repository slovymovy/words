                    {
                        "form_id": "710475be-86e4-4825-927c-419b24d420d1",
                        "entry_id": "577c70bb-f0cf-316f-865f-d8997d347b28",
                        "tags": [],
                        "form": "demie-sœur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46951fce-4103-3aaf-a1bc-8b5d4617e7e3",
                        "entry_id": "577c70bb-f0cf-316f-865f-d8997d347b28",
                        "glosses": [
                            "Sœur n'ayant qu'un parent en commun (père ou mère)."
                        ],
                        "tags": [
                            "Famille"
                        ],
                        "examples": [
                            {
                                "example_id": "c46c0250-070f-4140-a186-df8f0267280a",
                                "sense_id": "46951fce-4103-3aaf-a1bc-8b5d4617e7e3",
                                "text": "Pauvre Gratianne ; la dernière des Damvilliers quitte donc ce monde loin de Bagatelle où elle était née. Tu sais qui elle était, Osmond : pour toi une sorte de demi-grand-tante si je puis dire, puisque ma demi-sœur, issue du premier mariage de ma mère avec le marquis de Damvilliers."
                            },
                            {
                                "example_id": "ccda94e4-a1a2-42c0-b717-44b6aaad6863",
                                "sense_id": "46951fce-4103-3aaf-a1bc-8b5d4617e7e3",
                                "text": "Une autre figure familiale mystérieuse plane dans l’ombre du jeune dictateur [Kim Jong-hun]. Sa demi-sœur aînée, Kim Seol-song, jouerait les éminences grises selon plusieurs transfuges et experts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d96b190c-d841-4ede-a23d-bde5227f58fb",
                        "source_entry_id": "577c70bb-f0cf-316f-865f-d8997d347b28",
                        "source_sense_id": "46951fce-4103-3aaf-a1bc-8b5d4617e7e3",
                        "target_lang_word": "Halbschwester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbschwester",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "233968b2-ef2a-38a2-b94b-8e09455ea4b2",
                                        "entry_id": "211e505c-50aa-3376-9d44-ea2f2783860e",
                                        "glosses": [
                                            "blutsverwandte Schwester anderer Kinder nur von Vater oder Mutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ddbe72-92ad-46cc-954e-c30fc7c98771",
                                                "sense_id": "233968b2-ef2a-38a2-b94b-8e09455ea4b2",
                                                "text": "Als Erwachsener lernte er seine Halbschwester kennen und verliebte sich in sie."
                                            },
                                            {
                                                "example_id": "70405e87-5b9f-4be9-ab89-f5a25b87189c",
                                                "sense_id": "233968b2-ef2a-38a2-b94b-8e09455ea4b2",
                                                "text": "„Geneviève erfuhr von der Existenz meiner Halbschwester erst, als sie schon mit mir schwanger war.“"
                                            },
                                            {
                                                "example_id": "721d3e2b-822b-4902-8d7a-ea34afc7cdde",
                                                "sense_id": "233968b2-ef2a-38a2-b94b-8e09455ea4b2",
                                                "text": "„Recherchen fördern zutage, dass die verdächtigte Person eine uneheliche Halbschwester der Ermordeten ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
