                "senses": [
                    {
                        "sense_id": "44cad26e-2860-3da4-b4e6-cd2795225c71",
                        "entry_id": "45afe1b5-eda0-39e2-b5a0-9539b6006a86",
                        "glosses": [
                            "разг. уничиж. тупой человек, глупец, дурак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20ffe5cc-64e2-47e3-9098-846305440a43",
                                "sense_id": "44cad26e-2860-3da4-b4e6-cd2795225c71",
                                "text": "Он такой тупица! Не хочу разговаривать с тупицами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbe6fc93-6c8f-47fd-964a-28c668e15134",
                        "source_entry_id": "45afe1b5-eda0-39e2-b5a0-9539b6006a86",
                        "source_sense_id": "44cad26e-2860-3da4-b4e6-cd2795225c71",
                        "target_lang_word": "dolt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1070ad27-6606-332f-8d98-79ebf331a27d",
                                        "entry_id": "0f600ff8-0aa6-3980-8f71-9defbf57198a",
                                        "glosses": [
                                            "A stupid person; a blockhead or dullard."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f36c4170-d401-419b-9334-8a58c97c61ba",
                                                "sense_id": "1070ad27-6606-332f-8d98-79ebf331a27d",
                                                "text": "O Gull, oh dolt, / As ignorant as durt:[…]"
                                            },
                                            {
                                                "example_id": "93259342-236e-4ff7-b443-fed666464cf9",
                                                "sense_id": "1070ad27-6606-332f-8d98-79ebf331a27d",
                                                "text": "Moſt Monſter-like, be ſhewne / For poor'ſt Diminutiues, for Dolts, […]"
                                            },
                                            {
                                                "example_id": "e09dfb39-c792-4d6d-8bb1-794a0645e8dd",
                                                "sense_id": "1070ad27-6606-332f-8d98-79ebf331a27d",
                                                "text": "This Puck seemes but a dreaming dolt."
                                            },
                                            {
                                                "example_id": "71987aef-3a0a-4d1b-b89f-b84e2b8d187a",
                                                "sense_id": "1070ad27-6606-332f-8d98-79ebf331a27d",
                                                "text": "Those who loathe “Jackass” — which brought the world beer enemas and urine snow cones and thrust its merry band of dolts into reptile lairs and shark-infested waters — have called it disgusting and irresponsible: an incitement to copycat idiocy, if not a sign of the end of Western civilization."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ecf734b-fd14-3ce6-96d4-805ad5614b26",
                                        "entry_id": "25af88a7-3a44-3a03-9c02-e7748a04f70a",
                                        "glosses": [
                                            "To behave foolishly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41a58c4f-a51e-3c8c-a14c-047fc98087e0",
                                        "entry_id": "25af88a7-3a44-3a03-9c02-e7748a04f70a",
                                        "glosses": [
                                            "To fool; to trick"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea6fa33-4057-42a1-b3ab-f471b5c32047",
                                                "sense_id": "41a58c4f-a51e-3c8c-a14c-047fc98087e0",
                                                "text": "Some by frequent Practice will never be dolted"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0580c55b-5832-4b63-a9eb-59463a1b58e2",
                        "source_entry_id": "45afe1b5-eda0-39e2-b5a0-9539b6006a86",
                        "source_sense_id": "44cad26e-2860-3da4-b4e6-cd2795225c71",
                        "target_lang_word": "dunce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dunce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "026985d9-8d05-33f3-b5aa-b4572b70cdee",
                                        "entry_id": "3cd3baac-7d18-3eef-b6f3-7ed9f263d05e",
                                        "glosses": [
                                            "An unintelligent person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0466390a-d851-4540-9179-117f9d9d281d",
                                                "sense_id": "026985d9-8d05-33f3-b5aa-b4572b70cdee",
                                                "text": "When a true genius appears in the world you may know him by this sign; that the dunces are all in confederacy against him."
                                            },
                                            {
                                                "example_id": "32bda1bc-54fe-4653-945a-f4d96500ee52",
                                                "sense_id": "026985d9-8d05-33f3-b5aa-b4572b70cdee",
                                                "text": "[...] Dunce, / Dotard, a-dozing at the very nonce, / After a life spent training for the sight!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7989fe2-7362-4bc8-baae-c5a113443404",
                        "source_entry_id": "45afe1b5-eda0-39e2-b5a0-9539b6006a86",
