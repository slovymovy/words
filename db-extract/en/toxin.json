                                            "ein meist durch Ärger mit einer anderen Person verursachtes negatives Gefühl"
                                        ],
                                        "tags": [
                                            "South-German",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f07560-10a2-4d25-aab3-4e423c57e23d",
                                                "sense_id": "28299c1f-dad0-3830-846b-666b13c97898",
                                                "text": "„Im Bairischen kommt in solchen Fällen das Wort Gift zum Einsatz, im Sinne von Ärger, Zorn, Groll: Hoeneß hat einen Gift auf Ude, und Ude hat einen Gift auf Hoeneß.“"
                                            },
                                            {
                                                "example_id": "75fe7be8-58b5-4986-9697-698f5a0c413a",
                                                "sense_id": "28299c1f-dad0-3830-846b-666b13c97898",
                                                "text": "„Voller Gift, daß es die Häftlinge gewagt hatten, Trotz zu bieten, fauchte Kluttig auf Schwahl ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb90210d-4719-4d07-8aa2-7be655a03c8c",
                        "source_entry_id": "e2a78490-215e-318a-83a8-b628607d4841",
                        "source_sense_id": "c0a1f75f-9e05-3883-a23c-adb7b76489a8",
                        "source_sense_description": "von Organismen erzeugtes Gift",
                        "target_lang_word": "Giftstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Giftstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                        "entry_id": "94adf9e0-ec41-320a-b4dc-dbb58e360d47",
                                        "glosses": [
                                            "toxische chemische Verbindung oder toxisches Stoffgemisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef194082-b620-4ef9-b0f4-8a89985b31df",
                                                "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                                "text": "Mit dem Abwasser gelangen auch viele Giftstoffe in den Fluss."
                                            },
                                            {
                                                "example_id": "f947026e-48db-485c-b69b-cd625e0478c5",
                                                "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                                "text": "„Auch wegen der Giftstoffe im Fleisch hat der Walfang seine Bedeutung für die Nahrungsbeschaffung gänzlich verloren.“"
                                            },
                                            {
                                                "example_id": "8f50c6a2-baab-4c66-9d4a-878c733b7fcb",
                                                "sense_id": "f0f7d714-8c93-3010-a5ae-e4de2da12b06",
                                                "text": "„Der eigentliche Giftstoff in diesem Pilz ist Monomethylhydrazin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
