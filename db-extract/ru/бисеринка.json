                                    {
                                        "sense_id": "222af37f-aa15-3117-9155-5704d27121d7",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "Prayer, later especially with a rosary."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a5bad8-e5af-4607-adf7-ea8ad82342e1",
                                                "sense_id": "222af37f-aa15-3117-9155-5704d27121d7",
                                                "text": "That he must believe in the Pope;—go to Mass;—cross himself;—tell his beads;—be a good Catholick, and that this, in all conscience, was enough to carry him to heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37287248-8a6c-385e-b7ff-945e958a4f6d",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "Each in a string of small balls making up the rosary or paternoster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b304bd0-64b9-41be-8961-841f75188b49",
                                                "sense_id": "37287248-8a6c-385e-b7ff-945e958a4f6d",
                                                "text": "Holonym: prayer beads"
                                            }
                                        ]
                                    },
                                    {
