                    },
                    {
                        "form_id": "f681c217-ebbd-4cbe-8e31-fc45695cd2ba",
                        "entry_id": "3dc86a0e-7e2c-3d28-b801-2b78cce5d2b2",
                        "tags": [
                            "past"
                        ],
                        "form": "convulsed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "daabc1a9-4004-337f-9a5b-6a171be31e5f",
                        "entry_id": "3dc86a0e-7e2c-3d28-b801-2b78cce5d2b2",
                        "glosses": [
                            "To suffer violent involuntary contractions of the muscles, causing one's body to contort."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b29c1dc9-053e-4395-8e27-501a826e4d4e",
                                "sense_id": "daabc1a9-4004-337f-9a5b-6a171be31e5f",
                                "text": "He realized she was crying. He could feel her body convulsing with little sobs and her cheek was wet where it brushed his."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1618715-e6bc-351f-843d-391fb9392fbf",
                        "entry_id": "3dc86a0e-7e2c-3d28-b801-2b78cce5d2b2",
                        "glosses": [
                            "To be beset by political or social upheaval."
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0e9107ee-401d-474b-8708-2fcd33b0f604",
                                "sense_id": "e1618715-e6bc-351f-843d-391fb9392fbf",
                                "text": "The Persian Empire was convulsing with intrigue, revolt, and civil war."
                            }
                        ]
                    },
                    {
                        "sense_id": "99dcd029-281f-3efd-abe1-5adc1b02528f",
                        "entry_id": "3dc86a0e-7e2c-3d28-b801-2b78cce5d2b2",
                        "glosses": [
                            "To cause (someone) to suffer such contractions, especially as a result of making them laugh heartily."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "44751017-9af7-47e3-9a99-cc9e97313466",
                                "sense_id": "99dcd029-281f-3efd-abe1-5adc1b02528f",
                                "text": "But while he was convulsing all London with laughter, he was fast falling a victim to consumption."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed8df105-3747-44cd-aabf-aebb0f294d98",
                        "source_entry_id": "3dc86a0e-7e2c-3d28-b801-2b78cce5d2b2",
                        "source_sense_description": "to violently shake",
                        "target_lang_word": "convulser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convulser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06937a5b-f786-3274-b1be-e2cae8c2f765",
                                        "entry_id": "10443b2f-6640-3d93-b0c3-8b68febed869",
                                        "glosses": [
                                            "Contracter brusquement, tordre par des convulsions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63fb849-5da7-4a51-afbf-5b4bb2bd9f81",
                                                "sense_id": "06937a5b-f786-3274-b1be-e2cae8c2f765",
                                                "text": "Longtemps les deux ennemis se mesurèrent du regard. Une haine égale convulsait leurs visages, ils ne bougeaient pas."
                                            },
                                            {
                                                "example_id": "1863035f-f04e-4698-bdfd-788cd07a5a6a",
                                                "sense_id": "06937a5b-f786-3274-b1be-e2cae8c2f765",
                                                "text": "Des hoquets de dégoût convulsèrent de nouveau leurs faces hâlées, zébrées de rides : depuis un mois, ils avaient bu de l’eau dans laquelle mijotait ce noyé ; depuis un mois tout le pays s’abreuvait de cette pourriture."
                                            },
                                            {
                                                "example_id": "5e806f4b-3d2c-452a-bbc3-8fb53fcb9c85",
                                                "sense_id": "06937a5b-f786-3274-b1be-e2cae8c2f765",
                                                "text": "Il y a un autre courant qui penche pour une origine neurologique : le neuropsychiatre Serge Brion, notamment, pensait que certains pyromanes souffraient d’épilepsie temporale, c’est-à-dire qu’il ne s’agit pas des cas où la personne convulse, mais d’un état de rêve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e2d5e1e-1d2d-4b19-8451-b3d90886b282",
                        "source_entry_id": "3dc86a0e-7e2c-3d28-b801-2b78cce5d2b2",
                        "source_sense_description": "to violently shake",
                        "target_lang_word": "erschüttern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erschüttern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53b48568-0c77-3cc6-89d9-00d218ba5955",
                                        "entry_id": "87688ac1-3c75-370d-8676-0f9d42e8b7dc",
                                        "glosses": [
                                            "in schwingende Bewegung bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1984ea02-6e2e-4154-9f02-809e34901534",
                                                "sense_id": "53b48568-0c77-3cc6-89d9-00d218ba5955",
                                                "text": "Der Schlagbohrer erschüttert mein Zimmer seit 9 Uhr morgens."
                                            },
                                            {
                                                "example_id": "52fc1f41-1508-41a9-b1f1-465e24067467",
                                                "sense_id": "53b48568-0c77-3cc6-89d9-00d218ba5955",
                                                "text": "Das Erdbeben erschütterte die Stadt und brachte mehrere große Gebäude zum Einsturz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1de3b57-e58a-320c-be29-8b257be6c12f",
                                        "entry_id": "87688ac1-3c75-370d-8676-0f9d42e8b7dc",
                                        "glosses": [
                                            "jemanden emotional beunruhigen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1489a7f6-44fb-438c-baa3-af6b9bfa7dd2",
                                                "sense_id": "c1de3b57-e58a-320c-be29-8b257be6c12f",
                                                "text": "Ich wollte meine Mutter nicht erschüttern, doch ich hatte etwas Schlimmes zu berichten."
                                            },
                                            {
                                                "example_id": "bff2f33e-8e42-4cb3-8a30-30575f4f14e5",
                                                "sense_id": "c1de3b57-e58a-320c-be29-8b257be6c12f",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            },
                                            {
                                                "example_id": "1734f622-9b84-4910-bcbd-930f8bbebac9",
                                                "sense_id": "c1de3b57-e58a-320c-be29-8b257be6c12f",
                                                "text": "„Eine Fehde zwischen den mächtigen Bauern Thorstein und Steinar erschüttert die Gemeinschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
