                                    {
                                        "sense_id": "f13fd6cf-dfdf-3bd9-8adb-95c2cebd9dcb",
                                        "entry_id": "54196ce7-f429-35d6-acf5-359244f168ca",
                                        "glosses": [
                                            "Elegance in manner of dress; stylishness; flashiness."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3f9bbcd-f93c-4639-bb48-9fcc1d9029bd",
                                                "sense_id": "f13fd6cf-dfdf-3bd9-8adb-95c2cebd9dcb",
                                                "text": "\"We wanted to give the wallpaper some snazziness and motion,\" says Ha, laughing."
                                            },
                                            {
                                                "example_id": "d144977f-b77a-4ea5-b5f8-5b654f5b235d",
                                                "sense_id": "f13fd6cf-dfdf-3bd9-8adb-95c2cebd9dcb",
                                                "text": "And, for elevated snazziness, the black carbon-fiber-weave case can be customized with wild designs, automotive paints or, for something Apple may never match, it can be chromed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcf2bd7-a6ab-3a85-800e-d7e2ca326a82",
                                        "entry_id": "54196ce7-f429-35d6-acf5-359244f168ca",
                                        "glosses": [
                                            "Excellence; cleverness, ingenuity, or adeptness in behavior, operation, or execution."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656fe1ca-14ac-4f88-9108-4c9ab8cd1124",
                                                "sense_id": "0fcf2bd7-a6ab-3a85-800e-d7e2ca326a82",
                                                "text": "There's a painful disparity between the snazziness of TiVo's technology and the decrepitude of its balance sheet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
