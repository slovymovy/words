                "senses": [
                    {
                        "sense_id": "69746175-9e91-3020-9d9e-a2e4efc63e64",
                        "entry_id": "c20d20f5-8e0a-300d-bf67-93dc1a9c5d82",
                        "glosses": [
                            "wissenschaftliche Beschäftigung mit den gegenwärtig und in der jüngeren Vergangenheit gesprochenen Sprachen und deren Literatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fc88ec-782c-4b83-829a-6c4925dfe558",
                                "sense_id": "69746175-9e91-3020-9d9e-a2e4efc63e64",
                                "text": "Neuphilologie ist ein Sammelbegriff für den Zweig der Philologien, der sich mit den Sprachen und Literaturen der letzten Jahrhunderte befasst."
                            },
                            {
                                "example_id": "27cd9285-c93b-4bc5-9e49-d90610c62cd7",
                                "sense_id": "69746175-9e91-3020-9d9e-a2e4efc63e64",
                                "text": "Während heute die Neuphilologien ihre raison d'être in der Lehrerausbildung haben und sich die öffentliche Hand allein in Deutschland etwa 65 Universitäten leistet, an denen Philologen jeglicher couleur ausgebildet werden, um die Schulen mit genügend Lehrern zu versorgen, war dies zu Beginn des 19. Jahrhunderts kein vorrangiges Ziel."
                            },
                            {
                                "example_id": "03ef73a0-f874-4f72-9b98-80d08711ad24",
                                "sense_id": "69746175-9e91-3020-9d9e-a2e4efc63e64",
                                "text": "Die theoretisch-methodische Schlüssigkeit dieses germanistischen Ansatzes wirkte wiederum propädeutisch für andere Neuphilologien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
