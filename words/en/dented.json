    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd616ab4-369a-3038-bb9f-5c024fb1e888",
                    "sense_definition": "simple past and past participle of <w>dent</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falling branch hit my car and <w>dented</w> the roof badly.",
                            "target_lang_translations": {
                                "nl": "De vallende tak raakte mijn auto en <w>deukte</w> het dak flink <w>in</w>."
                            }
                        },
                        {
                            "text": "The scandal has seriously <w>dented</w> the company's reputation abroad.",
                            "target_lang_translations": {
                                "nl": "Het schandaal heeft de reputatie van het bedrijf in het buitenland ernstig <w>geschaad</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "verleden tijd en voltooid deelwoord van 'dent' (gedeukt, deuken gemaakt in, of figuurlijk geschaad)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gedeukt",
                                "target_lang_sense_clarification": "met deuken"
                            },
                            {
                                "target_lang_word": "deukte",
                                "target_lang_sense_clarification": "verleden tijd van deuken"
                            },
                            {
                                "target_lang_word": "aangetast",
                                "target_lang_sense_clarification": "figuurlijk geschaad, bijv. van reputatie"
                            },
                            {
                                "target_lang_word": "geschaad",
                                "target_lang_sense_clarification": "figuurlijk beschadigd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dbf46e6f-6815-3b83-b443-27a773544846",
                    "sense_definition": "Extremely stupid, foolish, or brain-damaged.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you completely <w>dented</w>, or did you just ignore the warning signs on purpose?",
                            "target_lang_translations": {
                                "nl": "Ben je helemaal <w>getikt</w>, of negeerde je de waarschuwingsborden gewoon met opzet?"
                            }
                        },
                        {
                            "text": "Only a totally <w>dented</w> person would leave their car unlocked with the keys inside.",
                            "target_lang_translations": {
                                "nl": "Alleen iemand die compleet <w>geschuffeld</w> is, zou zijn auto van het slot laten met de sleutels erin."
                            }
                        }
                    ],
                    "synonyms": [
                        "brainless",
                        "dense",
                        "dim-witted",
                        "foolish",
                        "idiotic",
                        "moronic",
                        "stupid",
                        "thick"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "buitengewoon dom, dwaas of niet goed bij het hoofd (slang)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "getikt",
                                "target_lang_sense_clarification": "informeel voor niet wijs"
                            },
                            {
                                "target_lang_word": "geschuffeld",
                                "target_lang_sense_clarification": "informeel voor gek of dwaas"
                            },
                            {
                                "target_lang_word": "achterlijk",
                                "target_lang_sense_clarification": "erg dom of idioot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "354a733b-c1b6-385d-9d59-6755cb360fa7",
                    "sense_definition": "Having a notched or tooth-like edge; indented.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms displayed a chief <w>dented</w> in bright red against silver.",
                            "target_lang_translations": {
                                "nl": "Het wapenschild vertoonde een <w>getand</w> schildhoofd in helderrood tegen zilver."
                            }
                        },
                        {
                            "text": "The ancient heraldic shield featured a <w>dented</w> border encircling the central crest.",
                            "target_lang_translations": {
                                "nl": "Het oude heraldische schild had een <w>gekartelde</w> boord rond het centrale embleem."
                            }
                        }
                    ],
                    "synonyms": [
                        "indented",
                        "serrated"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
