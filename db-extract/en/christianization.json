                                "target_senses": [
                                    {
                                        "sense_id": "ff6773ab-03ad-3706-ba15-69fe9d512759",
                                        "entry_id": "000cf646-0e7d-3c3f-b61f-24955fce3f79",
                                        "glosses": [
                                            "Conversion au christianisme."
                                        ],
                                        "tags": [],
