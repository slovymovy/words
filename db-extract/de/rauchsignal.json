                        "examples": [
                            {
                                "example_id": "6c053497-9e09-44d3-b063-305165e1ff16",
                                "sense_id": "a647b84e-1a34-37ef-b2b4-31178114c96e",
                                "text": "„Weil es keine regulären Sklavenmärkte in dieser Region gab, zeigten örtliche Stammeshäuptlinge und Händler mit Rauchsignalen vorbeisegelnden europäischen Schiffen an, dass sie Sklaven zu verkaufen hatten.“"
                            },
                            {
                                "example_id": "c04a06c1-2c41-4981-b86d-e38ed415ee27",
                                "sense_id": "a647b84e-1a34-37ef-b2b4-31178114c96e",
                                "text": "„Sie hatten sein Rauchsignal nicht gesehen und seinen Hilfeschrei nicht gehört.“"
                            }
                        ],
