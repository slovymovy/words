                        "glosses": [
                            "The state or quality of not being apposite."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "897e0a40-cc31-4041-8edb-fefc8be58a76",
                                "sense_id": "77bffb34-c16c-33d7-bd58-6524084340a5",
                                "text": "And certainly an apt quotation is one of the most effective decorations of a public speech; but the dangers of inappositeness are correspondingly formidable."
                            },
                            {
                                "example_id": "0e62a517-749d-48ec-aefe-db4db3cf56fe",
                                "sense_id": "77bffb34-c16c-33d7-bd58-6524084340a5",
                                "text": "To men and women excited by the details of the last murder they discourse of the existence of God in short, crisp sentences,--and I know not which is worse, the triviality of the discourse or its inappositeness."
                            },
                            {
                                "example_id": "da292e2a-632c-43f7-86c8-d0d9c2f6de99",
                                "sense_id": "77bffb34-c16c-33d7-bd58-6524084340a5",
                                "text": "‘And then, your uncle made an inaugural speech at his first press conference which was of fantastic inappositeness.’"
                            }
                        ]
                    }
