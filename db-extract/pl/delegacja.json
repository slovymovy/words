                                "target_senses": [
                                    {
                                        "sense_id": "7f280846-a00c-352d-a65f-2285112d29a1",
                                        "entry_id": "b3bd588d-0b2d-367c-a9be-e3275f7b4a7b",
                                        "glosses": [
                                            "An act of delegating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95be8efc-6771-45cd-a090-974e0ef6347e",
                                                "sense_id": "7f280846-a00c-352d-a65f-2285112d29a1",
                                                "text": "Decentralisation of the railways was provided for by the establishment of Area Boards for each Region, which began to function on January 1, 1955, and by the extended delegation of powers to the Boards and their General Managers; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5e9d8e-d048-3440-8db3-71ddab6e92d1",
                                        "entry_id": "b3bd588d-0b2d-367c-a9be-e3275f7b4a7b",
                                        "glosses": [
                                            "A group of delegates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a04ed5e5-bf84-4c83-acd6-10f5c0a9c0f0",
                                                "sense_id": "2b5e9d8e-d048-3440-8db3-71ddab6e92d1",
                                                "text": "the American delegation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b22821-44f2-3d22-bb4f-90ac80785fbb",
                                        "entry_id": "b3bd588d-0b2d-367c-a9be-e3275f7b4a7b",
                                        "glosses": [
                                            "A method-dispatching technique describing the lookup and inheritance rules for self-referential calls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "333b07df-9bc9-3f01-a0af-d971cc9141d6",
                                        "entry_id": "b3bd588d-0b2d-367c-a9be-e3275f7b4a7b",
                                        "glosses": [
                                            "The act whereby or constellation in which the performance of an obligation (owed to an obligee, presuming its validity; irrespective of the obligation as the target of the delegation, rarely called delegatary) is assigned by its debtor (delegator, obligor) to and towards another party (delegatee, delegate)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2187bb5-b24f-4d20-9cd1-12f3a77567d5",
                                                "sense_id": "333b07df-9bc9-3f01-a0af-d971cc9141d6",
                                                "text": "The mere delegation of a performance imposes no duty on the delegate to perform. If the delegate performs the duty, the duty is discharged. If the delegate does not perform the duty, the duty is not discharged, but any claim of the obligee for breach is against the delegating party and not against the delegate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0dc34a-5ef9-4b03-9964-3bd7febd1f34",
                        "source_entry_id": "e7894f9d-68d0-3b80-8c93-7b72ef71d721",
                        "source_sense_id": "d06d311d-6a6f-387a-b90e-19530c419297",
                        "target_lang_word": "délégation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délégation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e0a0db-cd92-3c4e-a12a-b700b1f5971c",
                                        "entry_id": "be9565b5-9691-3746-b2d6-749a4982f914",
                                        "glosses": [
                                            "Action de déléguer une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c081dc-606e-4988-9f39-c76363637b76",
                                                "sense_id": "a9e0a0db-cd92-3c4e-a12a-b700b1f5971c",
                                                "text": "Par délégation du tribunal."
                                            },
                                            {
                                                "example_id": "753a4fab-9e30-4dc7-b750-4a7566a1b310",
                                                "sense_id": "a9e0a0db-cd92-3c4e-a12a-b700b1f5971c",
                                                "text": "Agir en vertu d’une délégation."
                                            },
                                            {
                                                "example_id": "f2accbf9-4d9e-42fa-820d-a6b47b003701",
                                                "sense_id": "a9e0a0db-cd92-3c4e-a12a-b700b1f5971c",
                                                "text": "Délégation du pouvoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad68cc1e-d346-36f8-a4f8-625895fb46a6",
                                        "entry_id": "be9565b5-9691-3746-b2d6-749a4982f914",
                                        "glosses": [
                                            "Réunion de gens délégués pour accomplir certaines opérations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a59590-0f75-4d20-9096-3a231e6c3ef4",
                                                "sense_id": "ad68cc1e-d346-36f8-a4f8-625895fb46a6",
                                                "text": "Voilà qui va réconforter les mourants, car la délégation au grand complet visite maintenant les deux salles où sont entassés les cholériques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b067a77c-a8e2-3169-b64d-461c4a4cc872",
                                        "entry_id": "be9565b5-9691-3746-b2d6-749a4982f914",
                                        "glosses": [
                                            "Acte par lequel on autorise une personne à recevoir d’une autre une certaine somme, ou par lequel on transporte une dette à quelqu’un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c4b08e-7b2d-4b5f-ba82-95ac70abf0eb",
                                                "sense_id": "b067a77c-a8e2-3169-b64d-461c4a4cc872",
                                                "text": "Faire une délégation sur son fermier, sur son banquier."
                                            },
                                            {
                                                "example_id": "de7e47d9-15fb-40f9-bdc9-15c705957a4d",
                                                "sense_id": "b067a77c-a8e2-3169-b64d-461c4a4cc872",
                                                "text": "Donner une délégation. Avoir une délégation."
                                            },
                                            {
                                                "example_id": "811972db-7c02-4c7a-869b-efa19343938b",
                                                "sense_id": "b067a77c-a8e2-3169-b64d-461c4a4cc872",
                                                "text": "Accepter une délégation."
                                            },
                                            {
                                                "example_id": "b10cef93-bdab-42b9-897e-8aab0d064c63",
                                                "sense_id": "b067a77c-a8e2-3169-b64d-461c4a4cc872",
                                                "text": "Elle venait de créer alors ce qu’on nommait des bons de délégation, de véritables lettres de change à longue date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12fbf2f-fb56-3b66-97cb-b8b5871d6a91",
                                        "entry_id": "be9565b5-9691-3746-b2d6-749a4982f914",
                                        "glosses": [
                                            "Mission ou représentation diplomatique d'un gouvernement fédéré ou d'une organisation supranationale dans un État étranger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d3e243f-6e00-4894-ac0e-3aa43c94dc6a",
                                                "sense_id": "d12fbf2f-fb56-3b66-97cb-b8b5871d6a91",
                                                "text": "« La délégation de l’UE à Kiev a été endommagée par les frappes russes d’aujourd’hui sur des zones civiles », a écrit la commissaire européenne chargée de l’Élargissement, Marta Kos, sur X."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a0da95d-783b-30c5-b302-6b19b899e87c",
                                        "entry_id": "be9565b5-9691-3746-b2d6-749a4982f914",
                                        "glosses": [
                                            "Groupe de parlementaires d'un État en charge des relations avec le Parlement d'un État étranger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
