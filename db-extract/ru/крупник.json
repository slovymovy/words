                        "glosses": [
                            "krupnik (Belarusian, Polish and Ukrainian soup)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b48fce13-db65-4c26-ab7d-8dfc6d2561ba",
                                "sense_id": "e1ca7a17-5edd-3e89-afd3-9e1d355a0457",
                                "text": "Она́ сама́ налила́ мне по́лную таре́лку крупника́ — похлё́бки из гре́чневой крупы́ с са́лом, лу́ком, карто́фелем и ку́рицей — чрезвыча́йно вку́сного и пита́тельного ку́шанья.",
                                "translation": "She herself poured me out a plateful of groats, a porridge of buckwheat and fat, onion, potato and chicken, an amazingly tasty and nourishing dish.",
                                "english": "She herself poured me out a plateful of groats, a porridge of buckwheat and fat, onion, potato and chicken, an amazingly tasty and nourishing dish."
                            }
                        ]
                    }
