                "senses": [
                    {
                        "sense_id": "cdf26eda-0b5e-30f9-8cc6-f85d90dfbba2",
                        "entry_id": "f98e8f0c-989a-3705-8b7e-bcb0bf1bd7c0",
                        "glosses": [
                            "ogół ptaków lub ich grupa"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "d8504345-a0d4-4d75-843a-6150f8c461c4",
                                "sense_id": "cdf26eda-0b5e-30f9-8cc6-f85d90dfbba2",
                                "text": "Ze zwierząt czystych i nieczystych, z ptactwa i ze wszystkiego, co pełza po ziemi, po dwie sztuki, samiec i samica, weszły do Noego, do arki, tak jak mu Bóg rozkazał."
                            },
                            {
                                "example_id": "c373d9f9-d479-4ee6-9721-b49c8887d86b",
                                "sense_id": "cdf26eda-0b5e-30f9-8cc6-f85d90dfbba2",
                                "text": "Po zapalczywym świegocie ptactwa na drzewach nastąpiło tłumliwe ćwierkanie świerszczy w trawach (…)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
