                        "source_entry_id": "53217bdc-f7bc-3ead-960c-3df06e63d635",
                        "source_sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                        "target_lang_word": "aangenaam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aangenaam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                        "entry_id": "c6793832-b710-3e84-90a4-97ad4e53ed88",
                                        "glosses": [
                                            "een positief gevoel oproepend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1205e15e-81f0-4c70-9d23-4d6624ed8c36",
                                                "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                                "text": "Het is een aangename gewaarwording als je merkt dat je werk een goed effect heeft gehad."
                                            },
                                            {
                                                "example_id": "66f769b9-e180-4923-b37c-cf376066e4ee",
                                                "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                                "text": "`Aangenaam kennis te maken, Abdul.' Ik zei mijn naam. 'Laten we naar binnen gaan. Dan kan het beginnen."
                                            },
                                            {
                                                "example_id": "f7d6f12d-a898-41a9-a26b-a58cd1d98486",
                                                "sense_id": "e0601ed6-bdc5-3bc2-8076-7026a4fd257e",
                                                "text": "Overal kleefden herinneringen aan. Bijna altijd waren het aangename."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70c5e35f-a969-47c9-b199-6b3331f90316",
                        "source_entry_id": "53217bdc-f7bc-3ead-960c-3df06e63d635",
                        "source_sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                        "target_lang_word": "agradavelmente",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agradavelmente",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "e881d953-7f2d-3e8e-881b-d50b23d926fc",
                                        "entry_id": "f4ba6231-302b-3766-ae8b-89e710c7a9ad",
                                        "glosses": [
                                            "de modo agradável"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e74349-7cf8-45c4-9482-122ce44466e1",
                                                "sense_id": "e881d953-7f2d-3e8e-881b-d50b23d926fc",
                                                "text": "«Passámos a tarde a conversar agradavelmente no jardim da casa.»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83ad8401-77d3-4e52-9c0c-f103ea2b1e6b",
                        "source_entry_id": "53217bdc-f7bc-3ead-960c-3df06e63d635",
                        "source_sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                        "target_lang_word": "de maneira agradável",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0841674a-df42-49ff-8633-89c3e807d437",
                        "source_entry_id": "53217bdc-f7bc-3ead-960c-3df06e63d635",
                        "source_sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                        "target_lang_word": "приятно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "приятно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                                        "entry_id": "3d2b04e9-3634-3583-b28c-1ad27ccfd555",
                                        "glosses": [
                                            "наречие к приятный; доставляя удовольствие, вызывая положительные эмоции"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ceda976-32e7-425d-915e-580a230d8d2a",
                                                "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                                                "text": "И в оранжерее тоже приятно пахнет ― да жить в ней нельзя."
                                            },
                                            {
                                                "example_id": "78c4cd85-091d-4d87-8d2b-c3b004f85193",
                                                "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                                                "text": "Как человек, император был приятно удивлён."
                                            },
                                            {
                                                "example_id": "5f2f3ac5-7cca-4575-853f-c11af572b6b1",
                                                "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                                                "text": "Босые ноги приятно холодила влажная земля, а оголенные полные икры и шею ищущими горячими губами целовал суховей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8afa47ed-f49b-3884-a024-29526fd95ee6",
                                        "entry_id": "3d2b04e9-3634-3583-b28c-1ad27ccfd555",
                                        "glosses": [
                                            "предик. о чувстве удовольствия, испытываемом кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c5f8cd-e0b4-4d11-af1f-4deb39400720",
                                                "sense_id": "8afa47ed-f49b-3884-a024-29526fd95ee6",
                                                "text": "Очень приятно, что довелось познакомиться с таким выдающимся человеком."
                                            },
                                            {
                                                "example_id": "b976a212-9fcc-4d74-a605-e9051c9eeeca",
                                                "sense_id": "8afa47ed-f49b-3884-a024-29526fd95ee6",
                                                "text": "Приятно бродить по зимнему лесу, вдыхать чистый, свежий, морозный воздух."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
