{
    "word_family": [
        "ajout",
        "rajouter",
        "rajout",
        "ajoutage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7c50e10-1cdd-3f95-85b5-39c3faf32029",
                    "sense_definition": "Mettre quelque chose en plus, joindre un élément à un ensemble ou à une quantité déjà existants.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>ajouter</w> du sel dans l'eau des pâtes."
                        },
                        {
                            "text": "Elle <w>ajoute</w> du sucre dans son café chaque matin."
                        },
                        {
                            "text": "Il a <w>ajouté</w> une nouvelle photo à son profil."
                        }
                    ],
                    "synonyms": [
                        "rajouter"
                    ],
                    "antonyms": [
                        "retirer",
                        "enlever",
                        "retrancher"
                    ],
                    "common_phrases": [
                        "ajouter du sel",
                        "ajouter du sucre",
                        "ajouter un commentaire",
                        "ajouter au panier"
                    ]
                },
                {
                    "sense_id": "8ddd19b1-6fdc-348a-9b19-8f3671bd7dc1",
                    "sense_definition": "Dire quelque chose en plus de ce qui a déjà été dit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>ajouté</w> que la réunion serait reportée à la semaine prochaine."
                        },
                        {
                            "text": "Elle <w>ajoute</w> qu'elle viendra demain avec ses amis."
                        },
                        {
                            "text": "Je n'ai rien à <w>ajouter</w> sur ce sujet."
                        }
                    ],
                    "common_phrases": [
                        "ajouter que",
                        "sans rien ajouter"
                    ]
                },
                {
                    "sense_id": "f01607b1-7ce1-317d-b208-668f6a24bf9e",
                    "sense_definition": "Augmenter, renforcer une qualité, un sentiment ou un effet déjà présent (construction « ajouter à »).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décoration <w>ajoute</w> au charme de la pièce."
                        },
                        {
                            "text": "La pluie n'a fait qu'<w>ajouter</w> à notre fatigue."
                        }
                    ],
                    "synonyms": [
                        "accroître"
                    ],
                    "common_phrases": [
                        "ajouter au charme",
                        "ajouter à la confusion"
                    ]
                },
                {
                    "sense_id": "55d87087-ab15-3a50-be14-6c421926a9a3",
                    "sense_definition": "(forme pronominale : s'ajouter) Venir en plus, se cumuler avec autre chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fatigue du voyage s'<w>ajoute</w> l'inquiétude du retard."
                        },
                        {
                            "text": "Plusieurs problèmes se sont <w>ajoutés</w> à la crise actuelle."
                        }
                    ],
                    "synonyms": [
                        "s'additionner"
                    ]
                },
                {
                    "sense_id": "5fd9fd14-cf70-3eb9-b969-cac1c9900814",
                    "sense_definition": "Enrichir un récit ou une information en y mêlant des détails inventés ou exagérés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conteur aime <w>ajouter</w> des détails inventés à son récit."
                        },
                        {
                            "text": "Il a tendance à <w>ajouter</w> à la vérité pour impressionner ses amis."
                        }
                    ],
                    "synonyms": [
                        "enjoliver"
                    ]
                }
            ]
        }
    ]
}