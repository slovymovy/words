                "senses": [
                    {
                        "sense_id": "b663a7cd-7835-3072-bf91-4731f6d57c42",
                        "entry_id": "79fa2b97-adc8-33be-b47a-626df70a3b23",
                        "glosses": [
                            "Dealer ; vendeur de stupéfiants illégaux au détail."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b7d0e3e4-6b91-4bb0-a2e2-13beb316a4cd",
                                "sense_id": "b663a7cd-7835-3072-bf91-4731f6d57c42",
                                "text": "Souley m'a rencardé sur son cousin, un ancien bicraveur de Bezbar et de Stalingrad qui m'a présenté un mec qui connaît un mec."
                            },
                            {
                                "example_id": "26b8b804-8843-4466-8f2f-81402f5d7061",
                                "sense_id": "b663a7cd-7835-3072-bf91-4731f6d57c42",
                                "text": "Ils s'écartèrent et Hugues rejoignit Jean son bicraveur de son vrai nom Mansour Al Khini, les facilités qu'il avait à circuler librement dans tous les services de l'hôpital, lui permettait de subtiliser certaines substances interdites et les revendre."
                            },
                            {
                                "example_id": "685f24c9-7457-42cb-bc26-98a0959686d4",
                                "sense_id": "b663a7cd-7835-3072-bf91-4731f6d57c42",
                                "text": "Les années 90, c'étaient les vraies années des vrais gangsters en France. C'était les débuts du crack, les bonnes périodes des bicraveurs, il y avait le respect."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8399440-ed9d-4eb5-af97-865bcf69494a",
