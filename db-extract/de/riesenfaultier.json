                "senses": [
                    {
                        "sense_id": "5a13ce4e-3c4f-37aa-9493-8b2535e0c3e6",
                        "entry_id": "abea665a-39c2-3423-8ba1-d76b115246d7",
                        "glosses": [
                            "ausgestorbene, auf dem Boden lebende Faultierart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d975d4-7cd3-4fdb-9db6-58793f233901",
                                "sense_id": "5a13ce4e-3c4f-37aa-9493-8b2535e0c3e6",
                                "text": "„Am Abend folgt er einer schräg zwischen den flachen Hügeln aufsteigenden Rauchsäule; noch vor Einbruch der Dunkelheit hält er am Eingang eines alten Klausners, der sich wie ein Riesenfaultier hier im Grasland niedergelassen hat.“"
                            },
                            {
                                "example_id": "6d6cd497-8830-42f3-9d4c-a89be5f08fe2",
                                "sense_id": "5a13ce4e-3c4f-37aa-9493-8b2535e0c3e6",
                                "text": "„Die Riesenfaultiere und großen Vampirfledermäuse des Dschungels, den sie dabei durchquerten, überließen sie ebenso wie die kleinwüchsigen, aber angriffslustigen Saurier weniger kühnen Jägern als Beute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
