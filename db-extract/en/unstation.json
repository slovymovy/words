                        "glosses": [
                            "To remove from a station or fixed position."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b3dc4ae8-64db-48c0-b897-bd64bf8d7ed8",
                                "sense_id": "b4e0a97c-9488-3d94-b09c-60d645123f21",
                                "text": "The advance towards the 'freer play' of man's life sets out then from Dante and leads to Sordello itself: by 'unstationing' one of the Commedia's own characters and then refashioning him, Browning can show how far poetry has come in the contrast between the two Sordellos."
                            },
                            {
                                "example_id": "8d2a8b1a-54c4-4e7a-aa78-cabc1e277fc5",
                                "sense_id": "b4e0a97c-9488-3d94-b09c-60d645123f21",
                                "text": "2008, James DeBitetto, Sarah Hodgson, You and Your Puppy\nDo I need to unstation him if I'm just running out of the room for a few minutes? No. Short departures are good because they get your puppy used to being left alone and show him that you won't desert him."
                            }
                        ]
                    }
