                                "target_senses": [
                                    {
                                        "sense_id": "2ef22389-16d6-36df-a65d-31ab9a3bd55d",
                                        "entry_id": "c1688f9d-8c4c-3c59-9230-71cfdb597e3c",
                                        "glosses": [
                                            "Action de laminer, manière de réduire les métaux en lames."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccab265b-eb11-478b-8ee7-5d74dd00b025",
                                                "sense_id": "2ef22389-16d6-36df-a65d-31ab9a3bd55d",
                                                "text": "Mémoire sur le laminage du plomb."
                                            },
                                            {
                                                "example_id": "4348a229-2478-482b-8b18-8051665bfdca",
                                                "sense_id": "2ef22389-16d6-36df-a65d-31ab9a3bd55d",
                                                "text": "LAMINAGE, s. m. (Art méchanique.) c’est l’action & la manière de réduire en lames, par le moyen d’une machine appellée laminoir. Il se dit particulièrement de l’or, de l’argent, & du plomb."
                                            },
                                            {
                                                "example_id": "4df7fca1-4561-4c64-8ab8-94d1a3bba2eb",
                                                "sense_id": "2ef22389-16d6-36df-a65d-31ab9a3bd55d",
                                                "text": "Le martelage peut être remplacé par le laminage, mais ce moyen est inférieur parce qu'il ne réalise pas une pénétration aussi parfaite, un enchevêtrement aussi complet des molécules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f55a713-e852-39bb-bead-dccb90d2dcd7",
                                        "entry_id": "c1688f9d-8c4c-3c59-9230-71cfdb597e3c",
                                        "glosses": [
                                            "Anéantissement, écrasement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67eff072-54e6-4f8a-867b-67a45916ca96",
                                                "sense_id": "2f55a713-e852-39bb-bead-dccb90d2dcd7",
                                                "text": "Laminage du Centre démocrate."
                                            },
                                            {
                                                "example_id": "1b4fc3ca-8ead-4f9e-ac6a-a513ce5265b2",
                                                "sense_id": "2f55a713-e852-39bb-bead-dccb90d2dcd7",
                                                "text": "Les élections parlementaires ont abouti à une victoire éclatante du parti travailliste et un laminage historique du parti conservateur et des partis populistes qui ont fait avaler aux électeurs britanniques la couleuvre de la souveraineté nationale et de la prospérité économique en solo."
                                            }
                                        ]
                                    }
                                ]
                            }
