                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0dd1da2-52e3-3089-b9ad-b11f2137804d",
                        "entry_id": "1c51af22-900e-32c2-ae5e-8d3a9c954c3d",
                        "glosses": [
                            "kleiner Wagen (Fahrzeug)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c730df-d2e9-47b7-891c-193797771dcd",
                                "sense_id": "f0dd1da2-52e3-3089-b9ad-b11f2137804d",
                                "text": "„Ungeheure in ihren Wägelchen fettgewordene Bettler strecken uns ihre Arme in den Weg, man ist in der Eile versucht, über sie zu springen.“"
                            },
                            {
                                "example_id": "00cc5429-fc74-4ab5-99e3-c593a54b84a8",
                                "sense_id": "f0dd1da2-52e3-3089-b9ad-b11f2137804d",
                                "text": "„Berg fuhr in seinem peinlich sauber gehaltenen Wägelchen mit den zwei gutgenährten rehbraunen Pferden, genau solchen, wie sie der Fürst Soundso hatte, vor dem Hause seines Schwiegervaters vor.“"
                            },
                            {
                                "example_id": "03fd94b5-aae3-4e77-9747-7439e18980d0",
                                "sense_id": "f0dd1da2-52e3-3089-b9ad-b11f2137804d",
                                "text": "„Der Wagen lief durch das Hochland der Insel und überholte auf der guten Straße zahlreiche Sados, kleine Wägelchen mit einem einzigen Fahrgast, der mit dem Rücken zum Lenker saß.“"
                            },
                            {
                                "example_id": "b3ece56d-ee2b-4eda-b507-b252c5edd74e",
                                "sense_id": "f0dd1da2-52e3-3089-b9ad-b11f2137804d",
                                "text": "„Ein Wägelchen nahm sie auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26224c5e-ec5e-4592-8b09-733b1fa7b662",
