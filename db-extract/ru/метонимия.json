                ],
                "senses": [
                    {
                        "sense_id": "9b09e0f1-547d-3b64-bc59-3e9dcb8aa6fe",
                        "entry_id": "18286fa8-4f88-33ad-803c-6bdcabe3e750",
                        "glosses": [
                            "филол., лингв. риторический троп, замена одного слова другим на основе связи их значений по смежности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e668af5-b0e1-47c8-abda-11d9d7d4fc43",
                                "sense_id": "9b09e0f1-547d-3b64-bc59-3e9dcb8aa6fe",
                                "text": "Не подходят для каталога и переходы, связанные отношениями регулярной метонимии, например, «автор-произведение», «контейнер-содержимое» и т. п."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6aaae510-84f4-48d3-a63d-0a4a797438ed",
                        "source_entry_id": "18286fa8-4f88-33ad-803c-6bdcabe3e750",
                        "source_sense_id": "9b09e0f1-547d-3b64-bc59-3e9dcb8aa6fe",
                        "target_lang_word": "metonymy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metonymy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                        "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                                        "glosses": [
                                            "The use of a single characteristic or part of an object, concept or phenomenon to identify the entire object, concept, phenomenon or a related object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815454ee-6aa5-48a2-908c-5aa5ff85e0b9",
                                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                                "text": "Metonymy does new names impose,\nAnd things for things by near relation shews."
                                            },
                                            {
                                                "example_id": "60b907d6-1ace-496e-a9d8-5a60923b4f9b",
                                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                                "text": "...the principle of metonymy is simply to substitute for the plain name of a thing a name or phrase based on something connected with it."
                                            },
                                            {
                                                "example_id": "053dd200-5254-4067-aa19-f6893e47ac3d",
                                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                                "text": "THE KEY CONCEPT IS “metonymy.” This is the act of a word or phrase associated with a concept coming to represent the entirety of said concept. Generally, this means an extension of the original meaning. For example, “city hall” no longer means just the structure, but also the lawmakers who inhabit that structure. In the same way, “dish” started as the physical plate a meal is served on, before people started using it to represent the meal itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbabde25-4491-3761-aad6-af39e35d06bf",
                                        "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                                        "glosses": [
                                            "A metonym."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de510759-2f5b-42c2-b3d0-b461c896c8d7",
                        "source_entry_id": "18286fa8-4f88-33ad-803c-6bdcabe3e750",
                        "source_sense_id": "9b09e0f1-547d-3b64-bc59-3e9dcb8aa6fe",
                        "target_lang_word": "metonimia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metonimia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f627cfe6-f837-3639-a6f7-768e254100e4",
                                        "entry_id": "72cb5e21-404f-3bd1-9bff-eafbea926dab",
                                        "glosses": [
                                            "Tropo que designa una cosa con el nombre de otra con la que guarda una relación de causa efecto, de autor a obra, o de algún otro tipo de contigüidad temporal, causal o espacial."
                                        ],
                                        "tags": [
                                            "Retórica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070947cc-e02d-4dc1-9579-016531aa6d80",
                                                "sense_id": "f627cfe6-f837-3639-a6f7-768e254100e4",
                                                "text": "\"laurel\" por \"triunfo\"; \"un Goya\" por un \"cuadro de Goya\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
