                                    {
                                        "sense_id": "cb84919d-815a-3634-a5ff-eef4bbbc36c9",
                                        "entry_id": "50ca37a4-dbba-3a6d-a23f-5fe715465486",
                                        "glosses": [
                                            "Ville de Russie, capitale de la république du Tatarstan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2381ae98-3365-4bbd-a30a-14efb66aeba5",
                                                "sense_id": "cb84919d-815a-3634-a5ff-eef4bbbc36c9",
                                                "text": "L’université de Kazan, la capitale du Tatarstan, d’où Lénine a été renvoyé pour activités subversives, attire un demi-million de touristes chinois par an."
                                            },
                                            {
                                                "example_id": "6da3c976-cb7b-41c6-ba26-1627ee3bb5a8",
                                                "sense_id": "cb84919d-815a-3634-a5ff-eef4bbbc36c9",
                                                "text": "Cette fois j’ai dû les oublier dans la steppe du côté de Kazan, au bord de la Volga où j’écoutais de vieilles berceuses tchouvaches."
                                            },
                                            {
                                                "example_id": "72a3c080-f92d-4fca-8822-9a7de95b2fed",
                                                "sense_id": "cb84919d-815a-3634-a5ff-eef4bbbc36c9",
                                                "text": "Chargé de tirer les penalties depuis deux ans, il transforme ceux qui permettent à la France d’ouvrir le score à Kazan, contre l’Australie au premier match, puis contre l’Argentine en 8ᵉ de finale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d97b50f3-da51-44cc-a946-d535b6ca2c0a",
