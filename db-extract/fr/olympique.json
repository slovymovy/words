                                                "sense_id": "c13117fe-8e6d-3937-8902-74751ec1aa72",
                                                "text": "Hij was apetrots op zijn olympische bronzen plak."
                                            },
                                            {
                                                "example_id": "40855d9d-545f-479a-b93e-a65cc2b8fcc8",
                                                "sense_id": "c13117fe-8e6d-3937-8902-74751ec1aa72",
                                                "text": "Al deze antiquarische en archeologische aandacht leidde tot pogingen de olympische gedachte te laten herleven."
                                            },
                                            {
                                                "example_id": "8a989541-08d7-47fa-96f4-0b45f42b2773",
                                                "sense_id": "c13117fe-8e6d-3937-8902-74751ec1aa72",
