                        ]
                    },
                    {
                        "translation_id": "734395b8-1532-49a3-bc3b-fa5b79abf495",
                        "source_entry_id": "c347c06c-c6ee-3f01-a22f-050f8bba355d",
                        "source_sense_id": "dcff1451-8ee0-3749-b111-91113872f995",
                        "source_sense_description": "iets dat het naderen van een feit in de toekomst bekend maakt (figuurlijk)",
                        "target_lang_word": "présage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "présage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8910a5-b22c-3f1d-aa6d-9ab42ac6d44f",
                                        "entry_id": "95780f93-cc36-310e-a10f-bf97a6e2022a",
                                        "glosses": [
                                            "Augure, signe par lequel on juge de l’avenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3cb5cbe-effc-4ee5-b97a-0efff2baba86",
                                                "sense_id": "8b8910a5-b22c-3f1d-aa6d-9ab42ac6d44f",
                                                "text": "Tous ces présages paraissaient fatals à la pauvre femme; […]."
                                            },
                                            {
                                                "example_id": "1c318250-6e31-4aae-b482-edaaf4c85c66",
                                                "sense_id": "8b8910a5-b22c-3f1d-aa6d-9ab42ac6d44f",
                                                "text": "Le Prince […] ne peut naturellement vous recevoir en ce moment, mais il juge que votre venue est providentielle. Une dernière grâce du ciel, un heureux présage."
                                            },
                                            {
                                                "example_id": "000d16aa-644f-4db0-871f-b9bdc4ddc8ad",
                                                "sense_id": "8b8910a5-b22c-3f1d-aa6d-9ab42ac6d44f",
                                                "text": "[…]; c'est sur cette même place où son union avec Marie-Antoinette d'Autriche fut célébrée par une fête qu’enlaidirent des présages sinistres."
                                            },
                                            {
                                                "example_id": "91b88fdd-1168-4b0d-9235-60e3deef656e",
                                                "sense_id": "8b8910a5-b22c-3f1d-aa6d-9ab42ac6d44f",
                                                "text": "Bumper savait tout de la guerre et des pouvoirs paranormaux. Il attribuait sa survie aux divers pressentiments qui l'avaient assailli là-bas, dans la jungle. Il croyait dur comme fer au sixième sens, aux signes, aux présages. Comme beaucoup de vétérans, il était extrêmement superstitieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a43860-83c7-30ac-a3c2-bcc555223b34",
                                        "entry_id": "95780f93-cc36-310e-a10f-bf97a6e2022a",
                                        "glosses": [
                                            "Conjecture de l’augure, bon ou mauvais, qu’on tire de ce signe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6130221d-d366-473f-894a-5e2b8b0f35e4",
                                                "sense_id": "d2a43860-83c7-30ac-a3c2-bcc555223b34",
                                                "text": "Un hibou hulula dans le lointain, ce qui, chez les Navajos, était un mauvais présage."
                                            },
                                            {
                                                "example_id": "120bffc6-96aa-4031-b9dd-c2708917ae8e",
                                                "sense_id": "d2a43860-83c7-30ac-a3c2-bcc555223b34",
                                                "text": "Les augures tirèrent de cet incident un heureux présage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee4a0d58-0c6c-3662-9b09-91322a35d75b",
                                        "entry_id": "95780f93-cc36-310e-a10f-bf97a6e2022a",
                                        "glosses": [
                                            "Conjecture tirée d’un fait quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b2a255-0005-48f4-9701-845c5e221075",
                                                "sense_id": "ee4a0d58-0c6c-3662-9b09-91322a35d75b",
                                                "text": "Tout cela était d’excellent présage."
                                            },
                                            {
                                                "example_id": "cc0af70e-5199-4592-b5b9-8d3a12080dcf",
                                                "sense_id": "ee4a0d58-0c6c-3662-9b09-91322a35d75b",
                                                "text": "Déjà la veille, supputant les routes que pouvaient suivre les deux armées ennemies, remontant par l’Aisne et par l’Aire, il avait eu un mauvais présage : le 1ᵉʳ C.A. Ducrot, revenant à Voncq, ne descendrait pas à Vouziers, abandonnait Olizy-Primat aux Allemands."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "présage",
                                "target_lang_code": "fr",
