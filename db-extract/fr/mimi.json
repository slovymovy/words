            {
                "entry_id": "867b8521-0c51-314a-a14d-59a0277948c1",
                "word": "mimi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6abb9136-d352-467d-a66d-acee8eca87a1",
                        "entry_id": "867b8521-0c51-314a-a14d-59a0277948c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "mimis"
                    },
                    {
                        "form_id": "bc1fdf90-875c-4b6c-8875-d8393313aa3e",
                        "entry_id": "867b8521-0c51-314a-a14d-59a0277948c1",
                        "tags": [
                            "feminine"
                        ],
                        "form": "mimine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "765b8a15-68ad-3e60-aa38-af3f317851de",
                        "entry_id": "867b8521-0c51-314a-a14d-59a0277948c1",
                        "glosses": [
                            "Diminutif affectif pour les chats."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7c7a9b2f-a0f5-4f72-88fe-7365c762fc25",
                                "sense_id": "765b8a15-68ad-3e60-aa38-af3f317851de",
                                "text": "Allez ! Viens me faire un câlin mon mimi !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e8d31cf1-1a18-37b1-bf1e-40b7c4a7dd5b",
                        "entry_id": "867b8521-0c51-314a-a14d-59a0277948c1",
                        "glosses": [
                            "Diminutif affectif généralement utilisé pour exprimer son affection à une personne ou un animal de compagnie."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "57e7be2a-e2c6-49b7-b0ae-0ac9a73c48f2",
                                "sense_id": "e8d31cf1-1a18-37b1-bf1e-40b7c4a7dd5b",
                                "text": "Tiens, mimi, couvre-toi donc, dit-il."
                            },
                            {
                                "example_id": "f6b24544-470c-4f85-9db7-dab04f845ce8",
                                "sense_id": "e8d31cf1-1a18-37b1-bf1e-40b7c4a7dd5b",
                                "text": "Il n’y en a que pour Toto, la pauvre poulet, le petit chéri, le mimi ; on lui passe deux doigts entre le col et la peau pour voir s’il n’est pas en sueur, on lui tâte le front, les mains…"
                            }
                        ]
                    },
                    {
                        "sense_id": "941b383c-f0bb-3c68-bf9d-07dabd188aaa",
                        "entry_id": "867b8521-0c51-314a-a14d-59a0277948c1",
                        "glosses": [
                            "Baiser ou caresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ebc3ee-669b-44f4-8b83-cb99939397ed",
                                "sense_id": "941b383c-f0bb-3c68-bf9d-07dabd188aaa",
                                "text": "Elle me colle un mimi hydraté sur la poitrine. Ça me file une petite secousse agréable qui se répercute dans ma moelle."
                            },
                            {
                                "example_id": "a06c7f32-f744-4a14-a107-d8ca4901cb45",
                                "sense_id": "941b383c-f0bb-3c68-bf9d-07dabd188aaa",
                                "text": "Nous nous sommes fait des mimis joyeux, nous esclaffant de rire, les larmes aux yeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "7be5f471-169e-33a8-91ef-cca8a0aaad35",
                        "entry_id": "867b8521-0c51-314a-a14d-59a0277948c1",
                        "glosses": [
                            "Flocons de poussière qui s’assemblent sous les meubles. Mouton."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8fd882b7-b9fd-4c74-9e60-2562b1e7ca1a",
                                "sense_id": "7be5f471-169e-33a8-91ef-cca8a0aaad35",
                                "text": "Parlez-moi des acariens ou des mimis sous les meubles, là d’accord. Mais votre placenta de brebis… wouah !"
                            }
                        ]
                    }
                ],
