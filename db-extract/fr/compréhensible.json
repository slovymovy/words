                "forms": [
                    {
                        "form_id": "f3c48bc1-a03b-4709-a702-28ef6b95b99d",
                        "entry_id": "4a569cbf-65d6-3e4f-8ae9-dbbd59f9356c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "compréhensibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87c11045-70ba-353e-aeac-d2215c9279fe",
                        "entry_id": "4a569cbf-65d6-3e4f-8ae9-dbbd59f9356c",
                        "glosses": [
                            "Qui peut se comprendre facilement, par l’intelligence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f994abb9-4137-4ef6-b4c8-7b8020c3cdd3",
                                "sense_id": "87c11045-70ba-353e-aeac-d2215c9279fe",
                                "text": "Le questionnaire doit être rédigé dans une langue grammaticalement correcte et compréhensible pour tous les participants indépendamment de l’âge et du niveau d’enseignement."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd821227-51f9-344d-bdd1-740607a21610",
                        "entry_id": "4a569cbf-65d6-3e4f-8ae9-dbbd59f9356c",
                        "glosses": [
                            "Qui suscite de l’empathie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15953cae-8fb8-4082-a57f-609e96b2385d",
                                "sense_id": "cd821227-51f9-344d-bdd1-740607a21610",
                                "text": "Voilà qui est compréhensible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "821316d8-6b4e-426a-a12b-13a41f5acef1",
                        "source_entry_id": "4a569cbf-65d6-3e4f-8ae9-dbbd59f9356c",
                        "source_sense_description": "Qui peut se comprendre",
                        "target_lang_word": "verständlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verständlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38a5aa72-a6df-3821-ab53-f62d195f6373",
                                        "entry_id": "610315b1-5e9f-3ce1-a2e2-0a8f65bbf979",
                                        "glosses": [
                                            "praktisch gut aufzunehmen und klar zu hören, zu verstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37abd16-2eb1-418f-bd5c-7e0ff00baa53",
                                                "sense_id": "38a5aa72-a6df-3821-ab53-f62d195f6373",
                                                "text": "Hier hinten ist es nicht mehr verständlich, was da vorne gesprochen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fdc3b61-cef7-315d-9805-0dd5671d4e8c",
                                        "entry_id": "610315b1-5e9f-3ce1-a2e2-0a8f65bbf979",
                                        "glosses": [
                                            "mit dem Verstand gut nachzuvollziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c1e8f0-1a08-43af-b34a-f92816751e67",
                                                "sense_id": "4fdc3b61-cef7-315d-9805-0dd5671d4e8c",
                                                "text": "„…schwer zu trennen. Lichtschein, Glanz, Schimmer, Helligkeit - das ist des einen Wortes harmlose Urbedeutung (Sonnenschein). Kühn, aber noch verständlich, haben unsere Ahnen daraus den zweiten Wortsinn abgeleitet: etwa, worauf ein Lichtschein fällt und fallen soll - Schein, Bescheinigung, Beleg, Attest und Urkunde (Geldschein, Trauschein, Totenschein). - Gut - wenn da nicht im 15. Jahrhundert eine dritte Bedeutung hinzugetreten wäre, und die schlägt der zweiten ins Gesicht: Aus dem Lichtschein bildete sich zusätzlich die Lichtspiegelung heraus, die Fata Morgana, der trügerische Schein, die Sinnestäuschung, die Täuschung überhaupt (Scheinblüte, Scheinschwangerschaft), ja, der Betrug (Scheinehe). Unter demselben Begriffsdach also tummeln sich die beglaubigte Wahrheit, der Irrtum und die Lüge. Unsere Gene sind auf Lug und Trug programmiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0381e65c-bd57-3a68-bc47-5f761724b058",
                                        "entry_id": "610315b1-5e9f-3ce1-a2e2-0a8f65bbf979",
                                        "glosses": [
                                            "(auch) emotional gut nachzuvollziehen, wenn man sich in die Situation hineinversetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ae7b98-a871-42a9-9ffc-750a54dd92a5",
                                                "sense_id": "0381e65c-bd57-3a68-bc47-5f761724b058",
                                                "text": "„Verständlich - lief doch immer noch die Klage ihrer Stiefmutter wegen vorsätzlicher Körperverletzung gegen ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e3ae83d-ea4a-44f5-82c0-f735a7fafa1d",
                        "source_entry_id": "4a569cbf-65d6-3e4f-8ae9-dbbd59f9356c",
                        "source_sense_description": "Qui peut se comprendre",
                        "target_lang_word": "understandable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "understandable",
