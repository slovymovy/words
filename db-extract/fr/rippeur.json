                        ]
                    },
                    {
                        "sense_id": "971ae5fc-43fb-3485-a757-69d396a72b7b",
                        "entry_id": "8207eb47-12da-374b-b0c7-ad9f0199404a",
                        "glosses": [
                            "Variante orthographique de ripeur (déménageur de décors de tournage)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3fb7f3-a7da-4b46-9520-614a18cf4239",
                                "sense_id": "971ae5fc-43fb-3485-a757-69d396a72b7b",
                                "text": "Et puis, des « passerelles », où j’avais fait mes preuves, je passai du montage au démontage (aujourd’hui, on dirait rippeur). Nous enlevions les décors qui avaient été utilisés et en mettions d’autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "934e1fe3-5b74-334d-8da6-db95c4abd82c",
                        "entry_id": "8207eb47-12da-374b-b0c7-ad9f0199404a",
                        "glosses": [
                            "Variante orthographique de ripeur (ouvrier dont la fonction est de décharger les marchandises d’un camion ou d’un wagon)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae54fe5e-1bb0-48f0-9572-5d8575cd512e",
                                "sense_id": "934e1fe3-5b74-334d-8da6-db95c4abd82c",
                                "text": "Certains sont en particulier prisés, comme les tournées (chauffeur et rippeur) qui permettent de s'évader de la communauté et d'être en contact avec l’extérieur."
                            }
                        ]
                    }
