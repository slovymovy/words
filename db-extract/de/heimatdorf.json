                ],
                "senses": [
                    {
                        "sense_id": "39fc0ed4-380a-3bae-a28c-efcae9cebf50",
                        "entry_id": "a94bf21f-9884-30cd-8cd2-0c0b3bc3e26c",
                        "glosses": [
                            "kleine Siedlung, in der jemand aufgewachsen ist und sie daher als seine Heimat betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b8c63b-d882-4cf4-a884-a89382c4aa45",
                                "sense_id": "39fc0ed4-380a-3bae-a28c-efcae9cebf50",
                                "text": "„Unter Wehklagen der Eltern und Angehörigen wurden am Samstag die ersten Kinder, denen der Einsturz des Schülerwohnheimes zum tödlichen Verhängnis geworden war, in ihren Heimatdörfern begraben.“"
                            },
                            {
                                "example_id": "2ffc1760-f33a-453a-8e47-8cdc1b93e238",
                                "sense_id": "39fc0ed4-380a-3bae-a28c-efcae9cebf50",
                                "text": "„Er verließ Kanum, machte sich nach Norden auf den Weg nach Zanskar und erreichte schließlich Phuntsogs Heimatdorf Tetha.“"
                            },
                            {
                                "example_id": "7ff292fd-f4c0-4fa9-83d3-f9049917744b",
                                "sense_id": "39fc0ed4-380a-3bae-a28c-efcae9cebf50",
                                "text": "„In den Sommerferien war Nikolais Familie nun mit ihren beiden Kindern zurück nach Rumänien gefahren, um den Urlaub mit alten Bekannten im Heimatdorf zu verbringen.“"
                            },
                            {
                                "example_id": "312ac445-0f3e-4ffa-9d1e-ff098e9ae001",
                                "sense_id": "39fc0ed4-380a-3bae-a28c-efcae9cebf50",
                                "text": "„Mein Großvater ist in dieser schwierigen Zeit aufgewachsen und hat sein Heimatdorf freiwillig verlassen, um woanders eine Ausbildung zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
