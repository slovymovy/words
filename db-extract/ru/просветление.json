                "translations": [
                    {
                        "translation_id": "fb40c9d6-4d4e-46bd-9c20-94478c288393",
                        "source_entry_id": "f338a50c-9808-339c-93d2-e155af497b5e",
                        "source_sense_description": "действие или состояние по значению гл. просветлять, просветлить",
                        "target_lang_word": "éclaircissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclaircissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                                        "glosses": [
                                            "Action de rendre moins serré, moins épais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd9a943-5a64-4d46-95f9-534400ce7e33",
                                                "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                                                "text": "L’éclaircissement d’un bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                                        "glosses": [
                                            "Explication d’une chose obscure ou mal connue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655eb91c-3f16-49d0-9d3c-8d3741a242bb",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "Las de se casser la tête sur des énigmes, Hervé remit les éclaircissements au lendemain et regagna l'hôtel du Rhin."
                                            },
                                            {
                                                "example_id": "083912c9-8592-45a8-8ae5-ce9220647875",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "A son retour, il publia sept lettres attribuées à Saint Antoine, qu’on n’avoit point encore imprimées. Théodore les avoit tirées de la bibliothèque des princes de la Mirande, Jean & François Pic. Symphorien Carpentier, médecin d’Antoine, duc de Lorraine, les accompagna de quelques remarques, qui servirent à leur donner de l’éclaircissement."
                                            },
                                            {
                                                "example_id": "18c3d08b-ed4b-41eb-a714-94d0e9d7a144",
                                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                                "text": "Déconverger le modèle social d’une communauté avec les individus qui la composent, bien que de la convergence, là aussi, naissent des éclaircissements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbfca22e-3073-4d92-9f34-7ccef0bc6b98",
                        "source_entry_id": "f338a50c-9808-339c-93d2-e155af497b5e",
                        "source_sense_description": "действие или состояние по значению гл. просветлять, просветлить",
                        "target_lang_word": "illumination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illumination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09dbfc36-d2c0-38a3-bde0-70baf552a0c2",
                                        "entry_id": "adcc4ce8-3d41-3920-b052-9f85d7baac32",
                                        "glosses": [
                                            "Action d’illuminer ou état de ce qui est illuminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ce0e3dd-7943-4403-8c84-160c17c95fb0",
                                                "sense_id": "09dbfc36-d2c0-38a3-bde0-70baf552a0c2",
                                                "text": "L’illumination de la terre par le soleil. Dans ce sens il est peu usité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8fcac46-95ec-3012-add9-2317ab37088e",
                                        "entry_id": "adcc4ce8-3d41-3920-b052-9f85d7baac32",
                                        "glosses": [
                                            "Grande quantité de lumières disposées avec symétrie, à l’occasion d’une réjouissance."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6224a66-5898-4468-be54-64d58eb6a21e",
                                                "sense_id": "d8fcac46-95ec-3012-add9-2317ab37088e",
                                                "text": "Une petite ville se paie le luxe d’un somptueux corso ; une autre veut des concerts, des illuminations …."
                                            },
                                            {
                                                "example_id": "f030a24f-76c4-42ec-b8e5-f0dde2247c56",
                                                "sense_id": "d8fcac46-95ec-3012-add9-2317ab37088e",
                                                "text": "L’illumination de cet hôtel est brillante. - Les illuminations de ce jardin sont d’un très bel effet. - Allons voir les illuminations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2f9d566-9295-366f-abc8-c35fa8304ee3",
                                        "entry_id": "adcc4ce8-3d41-3920-b052-9f85d7baac32",
                                        "glosses": [
                                            "Lumière extraordinaire que Dieu répand quelquefois dans l’âme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3a6fcd5-d9b1-4acd-9329-aba6dbbcd1e0",
                                                "sense_id": "a2f9d566-9295-366f-abc8-c35fa8304ee3",
                                                "text": "L'âme de Wesley avait besoin d'un feu plus vif. Un jour (24 mai 1738), dans une sorte d’illumination, il entrevit la vraie foi qui est un lien vivant et non une opération de la raison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aead9cda-2c74-35ca-abe0-8292adf84d31",
                                        "entry_id": "adcc4ce8-3d41-3920-b052-9f85d7baac32",
                                        "glosses": [
                                            "Les clartés vives qui se produisent subitement dans certains esprits au milieu des difficultés, des dangers."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc9e68a-5fcb-4897-8a51-945bded70638",
                                                "sense_id": "aead9cda-2c74-35ca-abe0-8292adf84d31",
                                                "text": "Ce général semblait agir par de soudaines illuminations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dbd54d7-58e4-3beb-85c2-c2eb43d03207",
                                        "entry_id": "adcc4ce8-3d41-3920-b052-9f85d7baac32",
                                        "glosses": [
                                            "Éveil spirituel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1224ccac-bb09-45da-a5b3-09d2e04b8119",
                                                "sense_id": "0dbd54d7-58e4-3beb-85c2-c2eb43d03207",
                                                "text": "[…] le nirvâna devient synonyme d’éveil à la réalité, passage de l’aveuglement à l’illumination, de l’ignorance à la connaissance vraie."
                                            },
                                            {
                                                "example_id": "bfeb7ae2-d9a5-4415-86ff-c66f8e71faa7",
                                                "sense_id": "0dbd54d7-58e4-3beb-85c2-c2eb43d03207",
                                                "text": "Il méditait sur la doctrine du bodhicitta de Shantideva, concernant l’aspiration altruiste à l’illumination."
                                            },
                                            {
                                                "example_id": "1ea8bb49-41c3-4a39-863e-465e758e0559",
                                                "sense_id": "0dbd54d7-58e4-3beb-85c2-c2eb43d03207",
                                                "text": "[…] l’arbre de la Bodhi (arbre sous lequel Bouddha atteint l’Illumination) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd0b2000-d028-309e-94c1-89292fb75995",
                                        "entry_id": "adcc4ce8-3d41-3920-b052-9f85d7baac32",
                                        "glosses": [
                                            "Fait de cibler un objectif avec un radar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
