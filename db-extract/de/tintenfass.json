                "senses": [
                    {
                        "sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                        "entry_id": "1c36c614-761e-3cc2-a202-9797f87cc1fc",
                        "glosses": [
                            "kleines Behältnis zur Aufbewahrung von Tinte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b1cc52-dc5e-4675-9646-81feffc54e6d",
                                "sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                                "text": "„Richard tauchte eine Stahlfeder in das Tintenfass und schrieb, ohne zu zögern.“"
                            },
                            {
                                "example_id": "fcbee8c8-4c7b-450b-b353-5713e6791cae",
                                "sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                                "text": "„Dann griff er nach einem Blatt Papier, tauchte die Feder ins Tintenfass und skizzierte die europäischen und nordamerikanischen Küsten.“"
                            },
                            {
                                "example_id": "271bfa95-3f3f-446d-8a7e-9d0d59d21d8e",
                                "sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                                "text": "„Er hat seinen Platz wie früher neben dem Kompass und dem Tintenfass.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d0cbccf-4cfe-485d-8977-3588f798849b",
                        "source_entry_id": "1c36c614-761e-3cc2-a202-9797f87cc1fc",
                        "source_sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                        "source_sense_description": "kleines Behältnis zur Aufbewahrung von Tinte",
                        "target_lang_word": "inkpot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inkpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b01e0593-b6c9-3c24-9929-ce01ab2d03cd",
                                        "entry_id": "da159194-ab76-3149-973f-3a425390cb36",
                                        "glosses": [
                                            "A pot for holding ink, which was a necessary complement to pens without a built-in inkwell (such as a quill pen) (such pots were formerly ubiquitous but are now unusual except among people with artistic or historical interest in such pens)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b8d4b7-e872-490a-b0e1-f97038ca683b",
                                                "sense_id": "b01e0593-b6c9-3c24-9929-ce01ab2d03cd",
                                                "text": "Near-synonyms: inkwell, inkstand"
                                            },
                                            {
                                                "example_id": "65082ef7-d7a4-461e-9e55-68f6a49b9d29",
                                                "sense_id": "b01e0593-b6c9-3c24-9929-ce01ab2d03cd",
                                                "text": "I remember at school when unspillable inkpots came in and were said to be a brilliant new idea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "896f6365-31bf-42b4-8b9a-9b362285f6e4",
                        "source_entry_id": "1c36c614-761e-3cc2-a202-9797f87cc1fc",
                        "source_sense_id": "e0377031-4053-3657-bf2b-f436a6ffea41",
                        "source_sense_description": "kleines Behältnis zur Aufbewahrung von Tinte",
                        "target_lang_word": "inkwell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inkwell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb7b94ff-ccc0-31df-90bd-27fc8c765080",
                                        "entry_id": "2b19ed7f-065e-35cb-866a-f5f5d6005ccb",
                                        "glosses": [
                                            "A container for ink, designed and usually positioned so that a person may conveniently dip a pen (such as a dip pen or quill pen) into it whenever a refill is needed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c83e7654-9cb4-4785-bd76-712fde69ae16",
                                                "sense_id": "fb7b94ff-ccc0-31df-90bd-27fc8c765080",
                                                "text": "Near-synonym: inkstand"
                                            },
                                            {
                                                "example_id": "500b62f8-45d0-4094-a8f4-70d3acaf9897",
                                                "sense_id": "fb7b94ff-ccc0-31df-90bd-27fc8c765080",
                                                "text": "The reference library itself proclaimed the substance of the city with its solid elbow chairs and long mahogany tables, grooved along the edge to hold a pen, and in the centre of each table a massive pewter inkwell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d716d05-9c81-318f-8287-66605daa9a80",
                                        "entry_id": "2b19ed7f-065e-35cb-866a-f5f5d6005ccb",
                                        "glosses": [
                                            "A store of ink built into a pen, comprising a tube attached to the tip of the pen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f4038d3-908e-3755-9d73-df2b03ad80ce",
                                        "entry_id": "2b19ed7f-065e-35cb-866a-f5f5d6005ccb",
                                        "glosses": [
                                            "Euphemistic form of incel (“a member of an online subculture who define themselves as unable to find a partner”)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "euphemistic",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9705d88c-2e98-43b0-afcc-d1c7af49bfa6",
                                                "sense_id": "5f4038d3-908e-3755-9d73-df2b03ad80ce",
                                                "text": "Boy those woman already suffer enough in that line of work. Imagine how much worse it would be if this radical inkwells were in charge of them 🤦♂️🤦♂️🤦♂️🤦♂️"
                                            },
                                            {
                                                "example_id": "226810f5-4ca4-474f-a8b8-96b1e859611a",
                                                "sense_id": "5f4038d3-908e-3755-9d73-df2b03ad80ce",
                                                "text": "this is what leftist \"just have sex inkwell\" types assume what the standards RW men have in looking for women are"
                                            },
                                            {
                                                "example_id": "0f4171ee-92f5-44e3-995a-4da41f86e838",
                                                "sense_id": "5f4038d3-908e-3755-9d73-df2b03ad80ce",
                                                "text": "There is no such thing as a female inkwell. You won't change my mind."
                                            },
                                            {
                                                "example_id": "73e55b5f-df36-4c45-a5f8-68e3fb4966f7",
                                                "sense_id": "5f4038d3-908e-3755-9d73-df2b03ad80ce",
                                                "text": "If a woman has been single and hasn't got laid in awhile,^([sic]) its^([sic]) wildly accepted that this is by her choice. She hasn't met the right man yet. If a man hasn't got laid in awhile, he's seen as an inkwell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
