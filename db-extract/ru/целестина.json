                        "examples": [
                            {
                                "example_id": "34399d6c-f7e5-4d77-bfc5-0efcf9775bfa",
                                "sense_id": "f808c5d5-009b-363a-8226-4b0295f9e419",
                                "text": "Целестине было тогда девятнадцать лет и она точно была сухощава, тонка и не слишком высока…"
                            },
                            {
                                "example_id": "2b69000f-e684-4fba-b2e2-f350264231bb",
                                "sense_id": "f808c5d5-009b-363a-8226-4b0295f9e419",
                                "text": "Похохотав, компания стала рассматривать ярлыки. Целестина, обводя пальцами буквы, прочла: «Ром». ― Ром!"
                            }
                        ]
                    }
