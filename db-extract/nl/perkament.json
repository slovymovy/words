                "senses": [
                    {
                        "sense_id": "9332b7dc-7cae-3bf4-bad4-ff47d25e6eca",
                        "entry_id": "a2ca593b-20bc-3088-8034-47806bdf3a90",
                        "glosses": [
                            "een dun schrijfmateriaal, gemaakt van huid van kalveren, koeien, geiten, schapen, konijnen of ezels"
                        ],
                        "tags": [
                            "materiaalkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "50ee26c2-5d35-495c-af21-739ec8dd46b1",
                                "sense_id": "9332b7dc-7cae-3bf4-bad4-ff47d25e6eca",
                                "text": "Hoewel perkament veel duurder was, heeft het door zijn grotere houdbaarheid in vochtige klimaten papyrus als schrijfmateriaal verdrongen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9978b75e-52bc-31c2-baab-a92601668eee",
                        "entry_id": "a2ca593b-20bc-3088-8034-47806bdf3a90",
                        "glosses": [
                            "een stuk [1], gewoonlijk met handgeschreven tekst erop"
                        ],
                        "tags": [
                            "materiaalkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "31a46c73-c0a6-4323-919f-b30a7ce96456",
                                "sense_id": "9978b75e-52bc-31c2-baab-a92601668eee",
                                "text": "Deze perkamenten komen uit dezelfde bron."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b122e7e5-5e15-4c25-95bc-6a26aad99d33",
