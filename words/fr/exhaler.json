{
    "word_family": [
        "exhalaison",
        "exhalation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5dd75ce1-b63f-3d67-8e99-2c0cd649273a",
                    "sense_definition": "Dégager ou répandre au dehors une odeur, un parfum ou une vapeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emission_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fleurs du jardin <w>exhalent</w> un parfum délicat dès que le soleil commence à se coucher."
                        },
                        {
                            "text": "Ce vieux bâtiment abandonné <w>exhalait</w> une odeur d'humidité particulièrement désagréable qui repoussait les visiteurs."
                        }
                    ],
                    "synonyms": [
                        "dégager",
                        "émettre",
                        "répandre"
                    ],
                    "antonyms": [
                        "absorber"
                    ],
                    "common_phrases": [
                        "exhaler une odeur",
                        "exhaler un parfum suave"
                    ]
                },
                {
                    "sense_id": "0aea1c14-b01e-3535-9287-7905464995b5",
                    "sense_definition": "Rejeter l'air des poumons par le souffle ; expirer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a demandé d'<w>exhaler</w> lentement tout l'air contenu dans ses poumons."
                        },
                        {
                            "text": "Après une longue journée de marche, elle laissa échapper sa fatigue en <w>exhalant</w> un profond soupir."
                        }
                    ],
                    "synonyms": [
                        "expirer",
                        "souffler"
                    ],
                    "antonyms": [
                        "inspirer",
                        "inhaler"
                    ],
                    "common_phrases": [
                        "exhaler un soupir",
                        "exhaler son dernier souffle"
                    ]
                },
                {
                    "sense_id": "b7445d12-3cd0-3cc4-8ba0-dac092c98d29",
                    "sense_definition": "Exprimer ou laisser échapper librement un sentiment, une émotion ou une plainte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression_sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son journal intime, l'écrivain <w>exhale</w> toute sa rancœur accumulée depuis plusieurs années."
                        },
                        {
                            "text": "Incapable de garder le silence plus longtemps, il <w>exhala</w> sa colère devant ses collègues stupéfaits."
                        }
                    ],
                    "synonyms": [
                        "exprimer",
                        "manifester",
                        "épancher"
                    ],
                    "antonyms": [
                        "réprimer",
                        "étouffer",
                        "contenir"
                    ],
                    "common_phrases": [
                        "exhaler sa colère",
                        "exhaler sa rancœur",
                        "exhaler sa douleur"
                    ]
                },
                {
                    "sense_id": "859362ea-8143-3e2c-9459-c12d918c68bb",
                    "sense_definition": "Se dégager ou s'échapper dans l'air, en parlant d'une odeur, d'un gaz ou d'une vapeur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emission_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une fumée épaisse s'<w>exhale</w> lentement de la cheminée pendant les froides soirées d'hiver."
                        },
                        {
                            "text": "De ces marais brumeux s'<w>exhalent</w> de mystérieuses vapeurs qui enveloppent tout le paysage au crépuscule."
                        }
                    ],
                    "synonyms": [
                        "s'échapper",
                        "se dégager",
                        "émaner"
                    ],
                    "common_phrases": [
                        "s'exhaler dans l'air",
                        "s'exhaler de la terre"
                    ]
                }
            ]
        }
    ]
}