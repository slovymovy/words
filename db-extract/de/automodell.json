                "translations": [
                    {
                        "translation_id": "d1fd5025-f3c5-411c-9227-60569099c1c7",
                        "source_entry_id": "2f9fd150-f377-3d77-8546-113c93a69ebc",
                        "source_sense_id": "e65c8fb5-7562-3d34-b511-fa4da20a99e4",
                        "source_sense_description": "Typ einer Serie von Automobilen eines Herstellers",
                        "target_lang_word": "model",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "model",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "541b9bc4-5b85-35a3-8904-c91916fcf0cd",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "A person who serves as a human template for artwork or fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c10eeb3-0f6b-4837-b947-18a271fe9f58",
                                                "sense_id": "541b9bc4-5b85-35a3-8904-c91916fcf0cd",
                                                "text": "Leonardo da Vinci chose a 15th century criminal as a model for Judas in his painting The Last Supper."
                                            },
                                            {
                                                "example_id": "a8d1fd33-c74f-47fb-8fe4-96d119b49227",
                                                "sense_id": "541b9bc4-5b85-35a3-8904-c91916fcf0cd",
                                                "text": "The supersize model displayed the latest summer shorts fashion, tactfully representing similarly overweight teenagers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7500357-1837-3250-b0cc-caa7da7e57f7",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "A person, usually an attractive male or female, who is hired to show items or goods to the public, such as items that are given away as prizes on a TV game show."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb02c225-c0f4-3d00-b050-19b049fe818f",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "A representation of a physical object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "082ee307-ca87-4dde-aa8d-c18c6a706e58",
                                                "sense_id": "fb02c225-c0f4-3d00-b050-19b049fe818f",
                                                "text": "The boy played with a model of a World War II fighter plane."
                                            },
                                            {
                                                "example_id": "af137a61-1f8b-496a-9b11-ecc9d2687795",
                                                "sense_id": "fb02c225-c0f4-3d00-b050-19b049fe818f",
                                                "text": "The biology teacher passed a large plastic model of the atomic structure of DNA around the classroom."
                                            },
                                            {
                                                "example_id": "8ec55562-3cdc-418c-af44-66dd44d22954",
                                                "sense_id": "fb02c225-c0f4-3d00-b050-19b049fe818f",
                                                "text": "I had my father’s signet in my purse, / Which was the model of that Danish seal."
                                            },
                                            {
                                                "example_id": "5ef3ab18-5e4e-4a74-9eda-942ea4ea5780",
                                                "sense_id": "fb02c225-c0f4-3d00-b050-19b049fe818f",
                                                "text": "You have here the models of ſeveral ancient Temples, though the Temples themſelves, and the Gods that vvere vvorſhipped in them, are periſhed many hundred years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe5cfc6c-5958-37b2-b3f0-4d02665471e0",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "A simulation used to analyze the workings of a real world system or event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2248f9-d66e-4195-b70d-604ce93a6f81",
                                                "sense_id": "fe5cfc6c-5958-37b2-b3f0-4d02665471e0",
                                                "text": "machine learning model"
                                            },
                                            {
                                                "example_id": "eba1075c-9f86-4715-b4e0-070ddde36c08",
                                                "sense_id": "fe5cfc6c-5958-37b2-b3f0-4d02665471e0",
                                                "text": "The computer weather model did not correctly predict the path of the hurricane."
                                            },
                                            {
                                                "example_id": "16ebd193-7220-46ca-b592-920b3a8117cc",
                                                "sense_id": "fe5cfc6c-5958-37b2-b3f0-4d02665471e0",
                                                "text": "The trouble is, all those well-intentioned scientists who are arguing that we’re not in any imminent danger are basing their arguments on computer models. I’m basing mine on what’s actually happening."
                                            },
                                            {
                                                "example_id": "35577ff1-29d7-45e0-8730-6f7db183cb4c",
                                                "sense_id": "fe5cfc6c-5958-37b2-b3f0-4d02665471e0",
                                                "text": "The fourth model is called the enlightment model: Actors are seen to be responsible for problems but unable or unwilling to provide solutions. They are believed to need discipline provided by authoritative guidance. The Alcoholic Anonymous^([sic]) groups are considered prototypical for this model."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a744be41-012a-30ad-a482-a23bf79beb79",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "A style, type, or design."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e734cc10-0e65-4aa8-b703-1336a3c242f8",
                                                "sense_id": "a744be41-012a-30ad-a482-a23bf79beb79",
                                                "text": "we service all makes and models"
                                            },
                                            {
                                                "example_id": "d172539b-5b60-4681-be1d-78b3eb935caa",
                                                "sense_id": "a744be41-012a-30ad-a482-a23bf79beb79",
                                                "text": "He decided to buy the turbo engine model of the sports car."
                                            },
                                            {
                                                "example_id": "a9fff298-554d-4a88-8614-e713a2818afc",
                                                "sense_id": "a744be41-012a-30ad-a482-a23bf79beb79",
                                                "text": "This year’s model features four doors instead of two."
                                            },
                                            {
                                                "example_id": "e65ce601-56c8-403d-b1e2-b1f99e0fb848",
                                                "sense_id": "a744be41-012a-30ad-a482-a23bf79beb79",
                                                "text": "Q: What make and model of car do you drive? A: It’s a Buick LaCrosse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb2962e-6c0f-3afb-8897-c0a1e0e1ae27",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "The structural design of a complex system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df64213e-234e-45e9-a286-64fe1bec7e26",
                                                "sense_id": "0cb2962e-6c0f-3afb-8897-c0a1e0e1ae27",
                                                "text": "The team developed a sound business model."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "246599d5-71b0-3fc9-bd49-d91e97ae932c",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "A successful example to be copied, with or without modifications."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce61e1f-d4fc-4ff5-aef7-4379915f2b49",
                                                "sense_id": "246599d5-71b0-3fc9-bd49-d91e97ae932c",
                                                "text": "Near-synonym: (person) role model"
                                            },
                                            {
                                                "example_id": "d3cf1cda-70d4-49f7-bc2c-8d7972282631",
                                                "sense_id": "246599d5-71b0-3fc9-bd49-d91e97ae932c",
                                                "text": "He was a model of eloquence and virtue."
                                            },
                                            {
                                                "example_id": "0120868a-5326-4338-a390-f86f79f8b236",
                                                "sense_id": "246599d5-71b0-3fc9-bd49-d91e97ae932c",
                                                "text": "British parliamentary democracy was seen as a model for other countries to follow."
                                            },
                                            {
                                                "example_id": "c2a04579-935e-4f15-a138-afdb6109208f",
                                                "sense_id": "246599d5-71b0-3fc9-bd49-d91e97ae932c",
                                                "text": "Above all, the 48-page timetables of the new service, which have been distributed free at every station in the scheme, are a model to the rest of B.R. For the first time on British Railways, so far as we are aware, a substantial timetable has been produced, not only without a single footnote but also devoid of all wearisome asterisks, stars, letter suffixes and other hieroglyphics."
                                            },
                                            {
                                                "example_id": "af9ebf8a-eb5d-4700-8b9e-8081900cf3e6",
                                                "sense_id": "246599d5-71b0-3fc9-bd49-d91e97ae932c",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608c46d5-f663-31dc-bf69-5fa967439c47",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "An interpretation function which assigns a truth value to each atomic proposition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7da3adb9-13bf-3a0b-86d9-a36585c92e76",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "An interpretation which makes a set of sentences true, in which case that interpretation is called a model of that set."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45705443-ecf4-3070-85a4-e65d8d645166",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "An organism or species that is used to study an aspect of physiology or pathophysiology or a particular disease; often, a nonhuman one used to approximate processes in humans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02312efb-7740-4876-a71b-c120c7368015",
                                                "sense_id": "45705443-ecf4-3070-85a4-e65d8d645166",
                                                "text": "They studied fasting and glycemia in a mouse model."
                                            },
                                            {
                                                "example_id": "833f88bf-a4d9-458c-9c41-ed18b16df5b7",
                                                "sense_id": "45705443-ecf4-3070-85a4-e65d8d645166",
                                                "text": "They studied Mendelian inheritance in a fruit fly model."
                                            },
                                            {
                                                "example_id": "3d7c198f-10e6-4efd-a984-b49d4c8842d7",
                                                "sense_id": "45705443-ecf4-3070-85a4-e65d8d645166",
                                                "text": "They studied plasmid transfer in a mycobacterial model."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e53e814-0675-31e0-aec4-fc3150a24912",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "Any copy, or resemblance, more or less exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0eef47e-d331-41de-bd4d-1ee3719a3c71",
                                                "sense_id": "2e53e814-0675-31e0-aec4-fc3150a24912",
                                                "text": "Thou seest thy wretched brother die, / Who was the model of thy father's life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "821e8b38-022c-3707-b49e-6b1746e5649e",
                                        "entry_id": "aef8b15a-3fc2-31c0-8eae-51fbd0797d49",
                                        "glosses": [
                                            "In software applications using the model-view-controller design pattern, the part or parts of the application that manage the data."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "model",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                        "entry_id": "9667987d-8bba-3cf6-9cf5-0a379fdf07e5",
                                        "glosses": [
                                            "Worthy of being a model; exemplary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab9a409-6d48-45d6-ba8c-d3164bc19479",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "[...] from the land of your origin, because you demand the claims of those who believe it more model than yours, [...]"
                                            },
                                            {
                                                "example_id": "5d9f5b8c-2a7e-4e0e-867c-b1cbb7d1e898",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "Methods of game-preservation in their extensive and well-stocked hunting-grounds were as model as the huntsmanlike management of the hunts."
                                            },
                                            {
                                                "example_id": "b912d41c-7f0d-44e7-83b1-3b65f0d09947",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "[...] and we press with special severity on one small country whose agriculture is as model as is her way of rural life."
                                            },
                                            {
                                                "example_id": "049b2b6c-3809-4846-80b0-5b9b3f6550ee",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "True, it is an untidy county; the farmhouses are much more model than the farms (when we reach Antrim we shall find that the farms are more model than the farmhouses)."
                                            },
                                            {
                                                "example_id": "ba90c669-b6d0-4a15-84e3-dd4988722871",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "At our approach the animals made so much noise that the owners of the hut peered round the door to see what was the matter; outwardly rather less model than the farm, there appeared two ancient Basques, emblematically black-bereted, gnarled [...]"
                                            },
                                            {
                                                "example_id": "638b58cf-d86b-4ae0-8f77-7c08a818fadb",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "But not all the exchanges were as model as the sergeant. Some of the exchangees showed a rigidity and reluctance to adapt."
                                            },
                                            {
                                                "example_id": "18962ac8-8437-4c5e-b8f4-cc4be695ba3d",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "It is as model as you can get."
                                            },
                                            {
                                                "example_id": "7bcbbb2c-fe4a-4f34-8ab6-65633697da18",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "While Asians have been perceived as the model minority, it is increasingly clear that some Asian groups are more model than are others, and even within these model groups, a division exists [...]"
                                            },
                                            {
                                                "example_id": "0b808ba3-f88c-4296-8874-d330f683aab5",
                                                "sense_id": "3427bf0f-31f0-374e-994e-ec3147395bf2",
                                                "text": "All were neat and well kept which added to the sense that they were more model than real."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "model",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59ced003-2f26-3a1d-b089-3177511ccac6",
                                        "entry_id": "e944870b-4c3e-3181-a300-6b98ca65f93f",
                                        "glosses": [
                                            "To display an item on one's body for others to see the potential effect on their own bodies, especially in regard to wearing clothing while performing the role of a fashion model."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed95314-a437-4627-89ed-c0b3d8c69062",
                                                "sense_id": "59ced003-2f26-3a1d-b089-3177511ccac6",
                                                "text": "She modelled the shoes for her friends to appreciate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b42d478a-b0bc-3a13-b767-9cff0e0ad8cb",
                                        "entry_id": "e944870b-4c3e-3181-a300-6b98ca65f93f",
                                        "glosses": [
                                            "To devise a model of (some original), especially to better understand or forecast the original."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c26066ed-ff39-498c-8be9-4509f387b36e",
                                                "sense_id": "b42d478a-b0bc-3a13-b767-9cff0e0ad8cb",
                                                "text": "They modelled weather patterns using a computer."
                                            },
                                            {
                                                "example_id": "8d7e293f-1177-4b0d-b11e-51eb2d8be29b",
                                                "sense_id": "b42d478a-b0bc-3a13-b767-9cff0e0ad8cb",
                                                "text": "What passenger growth might be achieved by this can be modelled, but experience shows that in the post-COVID environment, accurate modelling is exceptionally difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0310ccc7-46a0-3856-91f0-1f12650e612f",
                                        "entry_id": "e944870b-4c3e-3181-a300-6b98ca65f93f",
                                        "glosses": [
                                            "To make a miniature model of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13bb52d5-61f4-4e47-a302-f72489b8e354",
                                                "sense_id": "0310ccc7-46a0-3856-91f0-1f12650e612f",
                                                "text": "He takes great pride in his skill at modeling airplanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddfaff05-421e-3829-927f-3e4a539a4bdb",
                                        "entry_id": "e944870b-4c3e-3181-a300-6b98ca65f93f",
                                        "glosses": [
                                            "To create from a substance such as clay."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2600069e-f0e8-4f04-a3cd-ee58dd593f7c",
                                                "sense_id": "ddfaff05-421e-3829-927f-3e4a539a4bdb",
                                                "text": "The sculptor modelled the clay into the form of a dolphin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb44a52-13c6-3609-8f71-8b82eefc2f9b",
                                        "entry_id": "e944870b-4c3e-3181-a300-6b98ca65f93f",
                                        "glosses": [
                                            "To make a model or models."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ae8673f-527d-360e-b799-6dede49cc3dd",
                                        "entry_id": "e944870b-4c3e-3181-a300-6b98ca65f93f",
                                        "glosses": [
                                            "To work as a model in art or fashion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e195e6ea-8ce6-428e-8aff-346ba968d79d",
                                                "sense_id": "0ae8673f-527d-360e-b799-6dede49cc3dd",
                                                "text": "The actress used to model before being discovered by Hollywood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
