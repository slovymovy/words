                "senses": [
                    {
                        "sense_id": "e0ad5808-6369-333a-8aa2-024cef04bea1",
                        "entry_id": "9a413b82-cd70-3094-a231-822d26d9d84e",
                        "glosses": [
                            "arystokrata noszący tytuł niższy niż tytuł hrabiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e5fc85-9925-4bb1-9e5d-8bbc56df2ecb",
                                "sense_id": "e0ad5808-6369-333a-8aa2-024cef04bea1",
                                "text": "Gdy drzwi się zamknęły, książę podniósł oczy na wicehrabiego i rzekł: — Zdaje się, że pan przybyłeś z Paryża?"
                            },
                            {
                                "example_id": "a6f99107-e12c-430d-baaf-d2d1ed456192",
                                "sense_id": "e0ad5808-6369-333a-8aa2-024cef04bea1",
                                "text": "Znajomość więc z wicehrabią była dla niej wysoce pożądaną i zupełnie na czasie[…]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
