                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unnötigerweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94216047-ea60-33c9-8c7a-1439f2dac085",
                                        "entry_id": "d6845b1e-ea3d-3045-89a2-b10bdf926951",
                                        "glosses": [
                                            "ohne, dass etwas zwingend notwendig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd38255-f8e2-4878-9c42-d8f68f692a79",
                                                "sense_id": "94216047-ea60-33c9-8c7a-1439f2dac085",
                                                "text": "„Auch in Deutschland befürchten Ärzte schon seit langem, dass viele Patienten die Diagnose unnötigerweise bekommen.“"
                                            }
