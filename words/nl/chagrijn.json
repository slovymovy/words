                                "target_lang_word": "die schlechte Laune",
                                "target_lang_sense_clarification": "Stimmung"
                            },
                            {
                                "target_lang_word": "der Verdruss",
                                "target_lang_sense_clarification": "Unmut, Ärger"
                            },
                            {
                                "target_lang_word": "die Missstimmung",
                                "target_lang_sense_clarification": "gereizte Atmosphäre"
                            },
