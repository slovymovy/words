                        "examples": [
                            {
                                "example_id": "27eb2034-3516-4daa-9d4d-67acfe83f461",
                                "sense_id": "30f604df-ef1c-348d-8390-26ddc3e1b9c0",
                                "text": "Maar ik wil in de toekomst graag meer verdienen. Daarom ben ik ook actief bezig met zelfontwikkeling. Zowel op persoonlijk als zakelijk vlak. Nu ben ik medewerker en het is wel de bedoeling dat ik manager word."
                            },
                            {
                                "example_id": "b81b4e57-220a-4d8d-b005-c84c242e3f6f",
                                "sense_id": "30f604df-ef1c-348d-8390-26ddc3e1b9c0",
                                "text": "Variatie in het werk is daarnaast van belang, stelt Collard. ,,Veertig uur per week precies hetzelfde werk doen wordt monotoon en is te veel. We hebben afgesproken dat we vier dagen in de week ons ‘gewone’ werk doen en een dag reserveren voor zelfontwikkeling.’’"
                            },
                            {
                                "example_id": "a8814336-f703-4aa1-b047-064462673e2a",
                                "sense_id": "30f604df-ef1c-348d-8390-26ddc3e1b9c0",
                                "text": ",,Het geheim van haar succes ligt niet enkel in haar onaardse schoonheid, maar ook in haar werkijver en haar voortdurende zelfontwikkeling, ondanks haar jonge leeftijd.”"
                            }
                        ]
                    }
