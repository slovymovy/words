    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21545811-59e6-3426-9bb9-fdd7e85d7b25",
                    "sense_definition": "Something that is strongly disliked or rejected by someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For many people, the idea of working on weekends is <w>anathema</w> to their lifestyle."
                        },
                        {
                            "text": "Violence was <w>anathema</w> to his peaceful nature, so he avoided all conflict."
                        }
                    ],
                    "synonyms": [
                        "antipathy",
                        "bête noire",
                        "bugbear"
                    ],
                    "common_phrases": [
                        "be anathema to"
                    ]
                },
                {
                    "sense_id": "ee8a839d-15d8-3571-8c30-abf8d932d0ec",
                    "sense_definition": "A formal religious curse or a person or thing that has been officially denounced.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "curse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church issued an <w>anathema</w> against those who defied the new doctrine."
                        },
                        {
                            "text": "He was declared an <w>anathema</w> by the council and cast out of the community."
                        }
                    ],
                    "synonyms": [
                        "ban",
                        "curse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in historical or ecclesiastical contexts."
                        }
                    ]
                },
                {
                    "sense_id": "371ac82e-4969-3827-b326-617a9bae6b3b",
                    "sense_definition": "A strong curse or a solemn denunciation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "curse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man shouted an <w>anathema</w> at the thieves as they ran away."
                        },
                        {
                            "text": "She felt the weight of his <w>anathema</w> hanging over her for many years."
                        }
                    ],
                    "synonyms": [
                        "curse"
                    ],
                    "traits": [
