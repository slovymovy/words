                "senses": [
                    {
                        "sense_id": "8c1c199a-8ee4-3d11-a29a-766d702f5692",
                        "entry_id": "ea702d3f-4a7c-3192-8c76-0d237bbb7c5e",
                        "glosses": [
                            "Action qui consiste à tremper du pain, du pain grillé, des biscuits, du gâteau, etc... dans un liquide alimentaire comme du café, du lait, du vin, tous froid ou chaud."
                        ],
                        "tags": [
                            "Centre-Ouest"
                        ],
                        "examples": [
                            {
                                "example_id": "5cbc3c57-bcdd-4454-8ce2-908dfec50c3e",
                                "sense_id": "8c1c199a-8ee4-3d11-a29a-766d702f5692",
                                "text": "À table, un des plus grands plaisirs de Noëlle est de faire trempinette, ce qui consiste , pour elle, à tremper un biscuit dans du vin sucré."
                            },
                            {
                                "example_id": "698445de-86bf-4105-b585-399d4b8232fa",
                                "sense_id": "8c1c199a-8ee4-3d11-a29a-766d702f5692",
                                "text": "Je me fis la trempinette en rompant dans la jatte le pain de seigle et d'épeautre que j'arrosai de café brûlant pour faire fondre la noisette de beurre et les quatre morceaux de sucre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ccd9695-06cc-3224-973d-2a2010bbd06d",
                        "entry_id": "ea702d3f-4a7c-3192-8c76-0d237bbb7c5e",
                        "glosses": [
                            "Ce nom est aussi parfois donné au résultat de cette action quand on utilise plutôt du vin. On parle aussi de soupine, de bijane, de trempine, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e7afecf-f192-4bc0-ae76-1a9aa281293e",
                                "sense_id": "5ccd9695-06cc-3224-973d-2a2010bbd06d",
                                "text": "Trempinette n. f. Sorte de soupe, faite avec un biscuit ou une mouillette de pain que l'on trempe dans un liquide, café au lait, ou vin sucré, et que l'on mange à demi-imbibé."
                            },
                            {
                                "example_id": "0fefd127-eeef-446e-a3ac-4f556140e7b6",
                                "sense_id": "5ccd9695-06cc-3224-973d-2a2010bbd06d",
                                "text": "Soupe au vin : Bijane ou Soupire ou Soupe à la pie ou Trempinette."
                            },
                            {
                                "example_id": "f05b7a01-8eeb-47a9-8c0a-9bbe731058f4",
                                "sense_id": "5ccd9695-06cc-3224-973d-2a2010bbd06d",
                                "text": "Les grands avaient droit à la trempinette, bouchées de pain grillé arrosé de vin sucré, coupé d eau."
                            }
                        ]
                    }
