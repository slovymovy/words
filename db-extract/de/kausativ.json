                "senses": [
                    {
                        "sense_id": "bd448a12-b894-3e0f-8090-1d32ef504abc",
                        "entry_id": "4d8bbed2-25a8-303c-8094-a6af4e1475a2",
                        "glosses": [
                            "Klasse von (meist abgeleiteten) Verben, die eine Veranlassung ausdrücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e8ce87-f947-4440-878e-614685dd18b1",
                                "sense_id": "bd448a12-b894-3e0f-8090-1d32ef504abc",
                                "text": "Deutsch: sprengen (eigentlich \"springen machen\"), schwemmen (eigentlich \"schwimmen machen\"), tränken (eigentlich \"trinken machen\") sind Beispiele für Kausative (= kausative Verben: Verben der Veranlassung)."
                            },
                            {
                                "example_id": "dd097095-3f8a-4595-b038-73464b4a3ea2",
                                "sense_id": "bd448a12-b894-3e0f-8090-1d32ef504abc",
                                "text": "Finnisch: Verbalstamm soi- \"klingen, tönen\", davon Kausativ soi-tta- \"zum klingen bringen, läuten\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0de458b-e741-3d59-9b4b-58e3faa1e171",
                        "entry_id": "4d8bbed2-25a8-303c-8094-a6af4e1475a2",
                        "glosses": [
                            "Verbalkategorie zum Ausdruck einer Veranlassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e03d313b-52bf-4a2d-8441-90b82e685958",
                                "sense_id": "d0de458b-e741-3d59-9b4b-58e3faa1e171",
                                "text": "„Kausative gedeihen wie Unkraut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
