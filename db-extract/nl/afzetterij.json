                ],
                "translations": [
                    {
                        "translation_id": "4d2907eb-a43e-4959-a32c-905421f91cf4",
                        "source_entry_id": "f10fb32a-54bd-3059-b2bc-7631dec94065",
                        "source_sense_id": "6448ed45-f9f8-39e1-8ac0-cd2b332b854a",
                        "target_lang_word": "Abzocke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abzocke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99744d22-eab6-3482-ba8c-d27d6a873c65",
                                        "entry_id": "2db941e7-22ad-3f2e-aa48-04f4d23c9e42",
                                        "glosses": [
                                            "Handel mit überhöhten Preisen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a7a6f82-3d28-4f7d-9c33-96c4ef7417d9",
                                                "sense_id": "99744d22-eab6-3482-ba8c-d27d6a873c65",
                                                "text": "„Wieder Ärger um Abzocke auf dem Kiez: Die Hamburger Polizei hat drei Tatverdächtige festgenommen, die von einem Kneipengast unter Androhung von Schlägen 340 Euro erpresst haben.“"
                                            },
                                            {
                                                "example_id": "1b76fb1d-c490-43fc-ab7c-8c166d87f432",
                                                "sense_id": "99744d22-eab6-3482-ba8c-d27d6a873c65",
                                                "text": "„Die steirische Arbeiterkammer warnt vor der Abzocke durch unseriöse Schlüsseldienste.“"
                                            },
                                            {
                                                "example_id": "d6ac49c7-af51-4e4e-9fe9-f4411a4bc21d",
                                                "sense_id": "99744d22-eab6-3482-ba8c-d27d6a873c65",
                                                "text": "„Dem stimmte Angel sofort zu, denn wie sie uns versicherte, war der Wechselkurs an der Grenze immer eine Abzocke.“"
                                            },
                                            {
                                                "example_id": "27268d5f-2566-476f-b2c6-d15c950e3f44",
                                                "sense_id": "99744d22-eab6-3482-ba8c-d27d6a873c65",
                                                "text": "„Hierdurch werden Verbraucherinnen und Verbraucher nun endlich besser vor Abzocke durch für sie nachteilige Restschuldversicherungen geschützt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e609fa42-5429-41d1-8273-00561bc8fef8",
                        "source_entry_id": "f10fb32a-54bd-3059-b2bc-7631dec94065",
                        "source_sense_id": "6448ed45-f9f8-39e1-8ac0-cd2b332b854a",
                        "target_lang_word": "rip-off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rip-off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fe93ffe-523a-315a-98d2-3772fbe7d80a",
                                        "entry_id": "4a2a17f9-92f7-373b-be2f-208c20b39563",
                                        "glosses": [
                                            "A bad deal; an unfair or exorbitant price or rate."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae4ec161-6b1b-4d1d-aaee-6d44c210ce1c",
                                                "sense_id": "9fe93ffe-523a-315a-98d2-3772fbe7d80a",
                                                "text": "In those days, a hamburger was fifteen cents, and if someone was charging a quarter for a bowl of soup, it was regarded as a rip-off."
                                            },
                                            {
                                                "example_id": "fdb561d3-7d1c-45ef-8a48-e1bcdd5a4135",
                                                "sense_id": "9fe93ffe-523a-315a-98d2-3772fbe7d80a",
                                                "text": "Eighty-seven bucks for a three-ounce piece of fish? What a rip-off! Haute cuisine or not!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af61991d-bfd7-31c5-abd7-27e9d2821b62",
                                        "entry_id": "4a2a17f9-92f7-373b-be2f-208c20b39563",
                                        "glosses": [
                                            "A theft or robbery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac467d4-d119-4290-a0a2-ba60d9a9598e",
                                                "sense_id": "af61991d-bfd7-31c5-abd7-27e9d2821b62",
                                                "text": "He noticed that the window was ajar, and right away he knew in his gut that a rip-off had probably occurred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ba9bf7-9144-3a53-8c00-63888d999fbd",
                                        "entry_id": "4a2a17f9-92f7-373b-be2f-208c20b39563",
                                        "glosses": [
                                            "A scam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad89da6-4545-46d7-8575-f9f04220262a",
                                                "sense_id": "12ba9bf7-9144-3a53-8c00-63888d999fbd",
                                                "text": "He promised to mail me a refund, but it was just a rip-off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5977cc2-4ee0-37b6-af44-349d7754e0ec",
                                        "entry_id": "4a2a17f9-92f7-373b-be2f-208c20b39563",
                                        "glosses": [
                                            "A copy, especially one that is illegal or inferior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8353820b-e665-452e-b20f-ece698785f10",
                                                "sense_id": "a5977cc2-4ee0-37b6-af44-349d7754e0ec",
                                                "text": "Are you sure that's a real Rolex and not just a cheap rip-off?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0885d03-07c6-4c43-b3d1-8e49da4be5d0",
                        "source_entry_id": "f10fb32a-54bd-3059-b2bc-7631dec94065",
                        "source_sense_id": "6448ed45-f9f8-39e1-8ac0-cd2b332b854a",
                        "target_lang_word": "arnaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arnaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5163ff2d-8cd6-3dfa-9fb2-b19547dabedd",
                                        "entry_id": "fbf47795-96c9-3cde-a8fe-f86911553ff9",
                                        "glosses": [
                                            "Police."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b509f634-8d43-3ee5-a8cd-63b6a25cef26",
                                        "entry_id": "fbf47795-96c9-3cde-a8fe-f86911553ff9",
                                        "glosses": [
                                            "Escroquerie ; tromperie ; œuvre d'un filou."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d7beed-7e0e-4f88-b86d-534be2a8c751",
                                                "sense_id": "b509f634-8d43-3ee5-a8cd-63b6a25cef26",
                                                "text": "— Vous êtes au courant de l’arnaque ? C'est l’hypercherie ! L’embrouille totale. Tout est truqué. Silbermann, ça vous dit quelque chose ? C'est lui le cerveau de la magouille !"
                                            },
                                            {
                                                "example_id": "e959825b-149e-4605-b719-06512fa3916e",
                                                "sense_id": "b509f634-8d43-3ee5-a8cd-63b6a25cef26",
                                                "text": "Rien à voir, le vicelard dans la pègre, pour situer les choses en gros, c'est celui qui louvoie, saisit l’occase des bonnes arnaques avec un minimum de risques... celui qui sait mener les bonnes embrouilles, qui manœuvre pour s'en sortir... s'arracher à la scoumoune."
                                            },
                                            {
                                                "example_id": "f452c416-3d95-4a75-b2fe-db815340e659",
                                                "sense_id": "b509f634-8d43-3ee5-a8cd-63b6a25cef26",
                                                "text": "Sur le plan de l’arnaque, les coups les plus tordus ne sont rien, vous entendez, rien, à côté de la peinture abstraite..."
                                            },
                                            {
                                                "example_id": "061a0ac5-6792-4233-9e82-4ef06d8a468f",
                                                "sense_id": "b509f634-8d43-3ee5-a8cd-63b6a25cef26",
                                                "text": "Le vol au collet marseillais était une arnaque découverte pour la première fois à Marseille qui consistait à bloquer les cartes bleues grâce à un collet (quelquefois, un simple ticket de métro) apposé sur les lecteurs de distributeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59037981-ffcb-3d13-be83-457ba2743355",
                                        "entry_id": "fbf47795-96c9-3cde-a8fe-f86911553ff9",
                                        "glosses": [
                                            "Offre commerciale disproportionnée ou inéquitable, à l'avantage majoritaire du vendeur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
