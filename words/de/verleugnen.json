    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f22655c-4c79-364a-9e15-3a081d2cf942",
                    "sense_definition": "behaupten, jemanden nicht zu kennen oder keine Beziehung zu ihm zu haben; jemanden nicht als Angehörigen oder Freund anerkennen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beziehung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aus Scham wollte der junge Mann vor seinen wohlhabenden Freunden seine eigene Familie <w>verleugnen</w>."
                        },
                        {
                            "text": "In der biblischen Erzählung behauptete Petrus dreimal, Jesus nicht zu kennen, und <w>verleugnete</w> ihn somit."
                        }
                    ],
                    "synonyms": [
                        "verstoßen"
                    ],
                    "antonyms": [
                        "anerkennen",
                        "bekennen"
                    ],
                    "common_phrases": [
                        "seine Herkunft verleugnen",
                        "sein Kind verleugnen"
                    ]
                },
                {
                    "sense_id": "1a065220-1447-3368-8338-a2cade3f5ef1",
                    "sense_definition": "eine Tatsache, Überzeugung oder Wahrheit leugnen bzw. nicht wahrhaben wollen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sachverhalt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand kann die klaren wissenschaftlichen Beweise für den Klimawandel dauerhaft <w>verleugnen</w>."
                        },
                        {
                            "text": "Trotz des offensichtlichen Misserfolgs versuchte der Politiker, die Krise vor den Wählern zu <w>verleugnen</w>."
                        }
                    ],
                    "synonyms": [
                        "abstreiten",
                        "bestreiten",
                        "dementieren",
                        "leugnen"
                    ],
                    "antonyms": [
                        "bekennen",
                        "eingestehen",
                        "zugeben"
                    ],
                    "common_phrases": [
                        "die Tatsachen verleugnen",
                        "die Wahrheit verleugnen"
                    ]
                },
                {
                    "sense_id": "84783237-a031-37e7-82da-13ef4cafebaa",
                    "sense_definition": "vorgeben oder durch Dritte ausrichten lassen, dass man nicht anwesend oder nicht zu sprechen sei",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anwesenheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn unerwünschte Besucher an der Haustür klingelten, ließ er sich regelmäßig von der Haushälterin <w>verleugnen</w>."
                        },
                        {
                            "text": "Die gestresste Direktorin ließ sich am Telefon <w>verleugnen</w>, um ungestört an dem dringenden Bericht arbeiten zu können."
                        }
                    ],
                    "common_phrases": [
                        "sich verleugnen lassen"
                    ]
                },
                {
                    "sense_id": "f3c6271c-f1c4-3052-82d9-8d9578d61873",
                    "sense_definition": "sich gegen das eigene Wesen oder die eigenen Prinzipien verhalten; nicht zu sich selbst stehen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "identitaet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wer immer nur die Erwartungen anderer erfüllen möchte, läuft Gefahr, sich selbst völlig zu <w>verleugnen</w>."
                        },
                        {
                            "text": "Um den begehrten Job zu bekommen, wollte sie ihre Ideale und Überzeugungen keinesfalls <w>verleugnen</w>."
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "zu sich stehen"
                    ],
                    "common_phrases": [
                        "sich selbst verleugnen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5618aa6-96b2-3085-8761-3c1ef7468526",
                    "sense_definition": "das bewusste Bestreiten oder Nichtanerkennen von Tatsachen oder Personen; Substantivierung des Verbs <w>verleugnen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das wiederholte <w>Verleugnen</w> der Tatsachen schadete seiner Glaubwürdigkeit enorm."
                        },
                        {
                            "text": "Sein ständiges <w>Verleugnen</w> der eigenen Gefühle führte schließlich zu großen seelischen Problemen."
                        }
                    ],
                    "synonyms": [
                        "Bestreiten",
                        "Verleugnung"
                    ],
                    "antonyms": [
                        "Anerkennen",
                        "Bekennen"
                    ]
                }
            ]
        }
    ]
