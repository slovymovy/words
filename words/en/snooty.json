{
    "word_family": [
        "snoot"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d17d1e5-4a02-3bd4-87a9-856ff7a83f0d",
                    "sense_definition": "Showing an attitude of superiority and looking down on others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "snobbish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me a <w>snooty</w> look when I asked him for help with the project.",
                            "target_lang_translations": {
                                "nl": "Hij keek me <w>verwaand</w> aan toen ik hem om hulp vroeg bij het project."
                            }
                        },
                        {
                            "text": "She is too <w>snooty</w> to eat at a simple diner like this one.",
                            "target_lang_translations": {
                                "nl": "Ze is te <w>snobistisch</w> om in een eenvoudig eethuis als dit te eten."
                            }
                        }
                    ],
                    "synonyms": [
                        "snobbish",
                        "haughty",
                        "pompous"
                    ],
                    "antonyms": [
                        "arrogant",
                        "immodest"
                    ],
                    "common_phrases": [
                        "snooty attitude",
                        "snooty person"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term used to describe someone acting superior."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een houding van superioriteit tonen en op anderen neerkijken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verwaand",
                                "target_lang_sense_clarification": "iemand die zich beter voelt dan anderen"
                            },
                            {
                                "target_lang_word": "snobistisch",
                                "target_lang_sense_clarification": "gedrag dat getuigt van een elitaire houding"
                            },
                            {
                                "target_lang_word": "uit de hoogte",
                                "target_lang_sense_clarification": "neerkijkend op anderen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6149c863-843b-3c2f-9a53-9f20c80b41e4",
                    "sense_definition": "Relating to an exclusive or elite social environment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "snobbish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They held a <w>snooty</w> party where only the wealthiest people in town were invited.",
                            "target_lang_translations": {
                                "nl": "Ze gaven een <w>elitair</w> feest waar alleen de rijkste mensen van de stad waren uitgenodigd."
                            }
                        },
                        {
                            "text": "The club has a <w>snooty</w> reputation that keeps many people from applying for membership.",
                            "target_lang_translations": {
                                "nl": "De club heeft een <w>exclusieve</w> reputatie die veel mensen ervan weerhoudt om lid te worden."
                            }
                        }
                    ],
                    "synonyms": [
                        "exclusive",
                        "elite"
                    ],
                    "common_phrases": [
                        "snooty club",
                        "snooty event"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal description of exclusive settings."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op een exclusieve of elitaire sociale omgeving."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "elitair",
                                "target_lang_sense_clarification": "gericht op een kleine, bevoorrechte groep"
                            },
                            {
                                "target_lang_word": "exclusief",
                                "target_lang_sense_clarification": "alleen toegankelijk voor een selecte groep"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "387e50f7-82f6-3e57-8998-6bd8baea21ee",
                    "sense_definition": "A person who acts in an elitist or snobbish manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "snobbish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>snooties</w> refused to talk to anyone who did not attend their private school.",
                            "target_lang_translations": {
                                "nl": "De lokale <w>snobs</w> weigerden te praten met iedereen die niet op hun privéschool had gezeten."
                            }
                        },
                        {
                            "text": "I try to avoid the <w>snooties</w> who think they are better than everyone else.",
                            "target_lang_translations": {
                                "nl": "Ik probeer de <w>verwaande mensen</w> te vermijden die denken dat ze beter zijn dan ieder ander."
                            }
                        }
                    ],
                    "synonyms": [
                        "snob"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal noun used to label snobbish individuals."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die zich elitair of snobistisch gedraagt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "snob",
                                "target_lang_sense_clarification": "iemand die zich verheven voelt boven anderen"
                            },
                            {
                                "target_lang_word": "verwaande persoon",
                                "target_lang_sense_clarification": "iemand die arrogant overkomt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "aaedfcc0-c084-3619-84f8-aa995660d2ad",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Snooty</w> family has lived in this village for over two hundred years.",
                            "target_lang_translations": {
                                "nl": "De familie <w>Snooty</w> woont al meer dan tweehonderd jaar in dit dorp."
                            }
                        },
                        {
                            "text": "Mr. <w>Snooty</w> is the new owner of the bookstore downtown.",
                            "target_lang_translations": {
                                "nl": "Meneer <w>Snooty</w> is de nieuwe eigenaar van de boekhandel in het centrum."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een achternaam."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Snooty",
                                "target_lang_sense_clarification": "achternaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}