                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0ad50b-2f47-4ce2-ab6e-194ff75f74ce",
                                "sense_id": "b3955754-11d8-3e9d-b5d2-5637a8ccbbaf",
                                "text": "an embittered enemy"
                            },
                            {
                                "example_id": "c93878da-5a4b-4214-8d08-e2089ee3c209",
                                "sense_id": "b3955754-11d8-3e9d-b5d2-5637a8ccbbaf",
                                "text": "[…] they were opposed to it on grounds that were at once legal, political, historical, personal, geographical, and mixed; the whole combination of causes operating of necessity to make the opposition an embittered one."
                            },
                            {
                                "example_id": "e275ee4e-296e-4237-8965-6a5603a4d00e",
                                "sense_id": "b3955754-11d8-3e9d-b5d2-5637a8ccbbaf",
                                "text": "Again, by means of the ‘follower’s’ life, it will be revealed who is the admirer; for the admirers will become highly embittered against the follower."
                            },
                            {
                                "example_id": "58c9eff1-a102-4797-9050-898db09cc6c1",
                                "sense_id": "b3955754-11d8-3e9d-b5d2-5637a8ccbbaf",
                                "text": "Dawkins’ book is, oddly, much more embittered and deeply emotional, although leavened by his effervescent wit."
                            }
                        ]
                    }
