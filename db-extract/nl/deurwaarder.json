                "senses": [
                    {
                        "sense_id": "e348595e-4594-3559-a946-2cd22e80373b",
                        "entry_id": "7f8dd1d1-900c-335d-a529-6377c262b207",
                        "glosses": [
                            "gerechtelijk ambtenaar die voornamelijk assisteert bij rechtszaken, exploten en executien doet, verkoopingen houdt, dagvaardingen uitbrengt en beslagen legt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "871a9b2c-3729-465d-a424-4fd31a1082dd",
                                "sense_id": "e348595e-4594-3559-a946-2cd22e80373b",
                                "text": "Indien u binnen twee weken de schulden nog niet afbetaald heeft, sturen wij een deurwaarder naar uw woonadres."
                            },
                            {
                                "example_id": "d08749fb-7f71-40b0-9b9e-eecc17c57678",
                                "sense_id": "e348595e-4594-3559-a946-2cd22e80373b",
                                "text": "Helaas kruipt het incassobloed waar het niet gaan kan. In een recent schuldsaneringsdossier zat een opgave door de deurwaarder van de vordering van zijn cliënte. De hoofdsom, wegens een teleshopbestelling, bedroeg € 76,94. De schuld was opgelopen tot € 866,65. Hoe kan dat nu ? De kosten waren toch gelimiteerd ?"
                            },
                            {
                                "example_id": "7d34e64e-09e0-4dc7-8ca3-5c3a92c3ceac",
                                "sense_id": "e348595e-4594-3559-a946-2cd22e80373b",
                                "text": "Gerard Sanderink is Limburger geworden. Uit de dagvaarding van de laatste rechtszitting blijkt dat hij zich officieel heeft laten inschrijven als inwoner van Nunhem, een dorpje van 670 inwoners in Noord-Limburg. Onderzoek door een door Van Egten ingeschakelde deurwaarder leerde dat op het betreffende adres een Roemeense familie woont, die beweerde nog nooit van Sanderink te hebben gehoord."
                            }
                        ]
                    },
                    {
                        "sense_id": "70c0536f-13c2-3561-a81b-b7b870b81475",
