                    {
                        "sense_id": "46eaa643-be43-33ba-afec-cef5e92bfd2d",
                        "entry_id": "ab50fa8a-673a-3491-9ff3-ca5d341fc4f9",
                        "glosses": [
                            "having one's birthday"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01e774b-a971-4253-b012-53594ded28fb",
                                "sense_id": "46eaa643-be43-33ba-afec-cef5e92bfd2d",
                                "text": "Hij is vandaag jarig.",
                                "translation": "He is having his birthday today.",
                                "english": "He is having his birthday today."
                            },
                            {
                                "example_id": "d48d7924-f565-4d09-b3fe-e36956ecedc7",
                                "sense_id": "46eaa643-be43-33ba-afec-cef5e92bfd2d",
                                "text": "Ben je jarig? Gefeliciteerd!",
                                "translation": "Are you having your birthday? Congratulations!",
                                "english": "Are you having your birthday? Congratulations!"
                            },
                            {
                                "example_id": "736e5be1-189a-4afa-ad2d-66d5cec11be2",
                                "sense_id": "46eaa643-be43-33ba-afec-cef5e92bfd2d",
                                "text": "Iedereen die deze maand jarig is, krijgt een cadeau.",
                                "translation": "Everyone who is having their birthday this month gets a gift.",
                                "english": "Everyone who is having their birthday this month gets a gift."
                            }
                        ]
                    }
