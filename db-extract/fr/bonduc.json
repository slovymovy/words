                "senses": [
                    {
                        "sense_id": "ebe8467b-3d90-3b35-af40-bd7270341dce",
                        "entry_id": "0d4f2695-623a-38af-9614-f51b2ca47961",
                        "glosses": [
                            "Nom usuel de Caesalpinia bonduc, arbrisseau épineux littoral pantropical de la famille des Fabacées (Fabaceae) dont les graines sont décoratives et contiennent un principe amer, la bonducine, qui possède des propriétés antipyrétiques et antipaludiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22cfce4e-45fb-4bf0-a787-82fdf33199d0",
                                "sense_id": "ebe8467b-3d90-3b35-af40-bd7270341dce",
                                "text": "D’autre part, mes amis de Soustons (Landes) m’ont appris qu'à la côte du Vieux-Boucau, non loin de Bayonne, pareilles graines sont assez fréquemment rencontrées, en particulier celles du Bonduc ou oeil-de-chat."
                            },
                            {
                                "example_id": "eb954bad-d6df-4fd4-8913-c2888827c320",
                                "sense_id": "ebe8467b-3d90-3b35-af40-bd7270341dce",
                                "text": "Les graines de Bonduc jouissent à la Réunion et dans l’Inde d’une grande réputation pour combattre les fièvres intermittentes et comme tonique général"
                            }
                        ]
                    },
                    {
                        "sense_id": "fbf6142f-3757-3967-86b9-f43cc8395e8e",
                        "entry_id": "0d4f2695-623a-38af-9614-f51b2ca47961",
                        "glosses": [
                            "Nom usuel de Gymnocladus dioica, arbre d'Amérique du Nord, assez rare, de la famille des Fabacées (Fabaceae), planté comme essence décorative en milieu urbain, et dont on infusait les graines grillées comme substitut au café."
                        ],
                        "tags": [],
                        "examples": []
                    }
