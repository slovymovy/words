                    "frequency": "Middle",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij reageerde nogal <w>sloom</w> toen ik hem de vraag stelde.",
                            "target_lang_translations": {
                                "en": "He reacted rather <w>slowly</w> when I asked him the question.",
                                "de": "Er reagierte ziemlich <w>langsam</w>, als ich ihm die Frage stellte."
                            }
                        },
                        {
                            "text": "Dat is de <w>sloomste</w> jongen van de klas.",
                            "target_lang_translations": {
                                "en": "That is the <w>slowest</w> boy in the class.",
                                "de": "Das ist der <w>langsamste</w> Junge in der Klasse."
