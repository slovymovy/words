                    {
                        "translation_id": "0f718fb7-9bad-4eb3-b938-2fc3fca01972",
                        "source_entry_id": "6f2b9307-64dd-333d-a2b2-5f6d1b541f95",
                        "target_lang_word": "klierachtig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klierachtig",
