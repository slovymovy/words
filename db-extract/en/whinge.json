                                                "example_id": "a27ad30d-cfb9-4e38-83b2-e8f3d55c8367",
                                                "sense_id": "995d1517-a1f5-365f-a46e-8ff9b89ca0f9",
                                                "text": "Goldie en Barbie zagen het als één groot avontuur, maar ik liep in het begin wat onwennig achter ze aan."
                                            }
