                "senses": [
                    {
                        "sense_id": "b4c43715-bcbe-32ad-b133-82913bade68f",
                        "entry_id": "3b39fe8b-ec54-3f23-803d-05f70d81422f",
                        "glosses": [
                            "im Privatbesitz befindliches Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7223002e-5035-4f4e-b278-78f07604d7bd",
                                "sense_id": "b4c43715-bcbe-32ad-b133-82913bade68f",
                                "text": "„Problematisch sind Fahrten mit Privatfahrzeugen, bei denen von den Vorschriften der StVO abgewichen wird.“"
                            },
                            {
                                "example_id": "0a5be9e2-3450-4b32-903f-c3783c738ee1",
                                "sense_id": "b4c43715-bcbe-32ad-b133-82913bade68f",
                                "text": "„Sowohl von Jordanien als auch von Ägypten aus dürfen keine Privatfahrzeuge die Grenze in Richtung Israel passieren.“"
                            },
                            {
                                "example_id": "086ea5cf-1b0c-4f18-836a-7995bb49fbe2",
                                "sense_id": "b4c43715-bcbe-32ad-b133-82913bade68f",
                                "text": "„Gleichwohl verbieten aus Angst vor Haftungsrisiken zum Beispiel im Schulbereich viele Dienstherren ihren Lehrern, Schüler in Privatfahrzeugen zu befördern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
