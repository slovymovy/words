                    "semantic_group_id": "transitive_worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twoje słabe oceny w szkole zaczynają mnie poważnie <w>martwić</w>.",
                            "target_lang_translations": {
                                "ru": "Твои плохие оценки в школе начинают меня серьёзно <w>беспокоить</w>.",
                                "en": "Your poor grades at school are starting to seriously <w>worry</w> me.",
                                "nl": "Je slechte cijfers op school beginnen me ernstig <w>ongerust te maken</w>.",
                                "de": "Deine schlechten Noten in der Schule fangen an, mich ernsthaft zu <w>beunruhigen</w>.",
                                "fr": "Tes mauvaises notes à l'école commencent sérieusement à m'<w>inquiéter</w>.",
                                "it": "I tuoi brutti voti a scuola cominciano a <w>preoccuparmi</w> seriamente.",
                                "cs": "Tvoje špatné známky ve škole mě začínají vážně <w>znepokojovat</w>.",
                                "tr": "Okuldaki düşük notların beni ciddi anlamda <w>endişelendirmeye</w> başlıyor.",
                                "es": "Tus malas notas en la escuela empiezan a <w>preocuparme</w> seriamente.",
                                "zh": "你在学校的糟糕成绩开始<w>让</w>我感到严重<w>担忧</w>。"
                            }
                        },
                        {
                            "text": "Sytuacja polityczna w kraju <w>martwi</w> wielu obywateli.",
                            "target_lang_translations": {
                                "ru": "Политическая ситуация в стране <w>беспокоит</w> многих граждан.",
                                "en": "The political situation in the country <w>worries</w> many citizens.",
                                "nl": "De politieke situatie in het land <w>baart</w> veel burgers <w>zorgen</w>.",
                                "de": "Die politische Lage im Land <w>beunruhigt</w> viele Bürger.",
                                "fr": "La situation politique du pays <w>inquiète</w> de nombreux citoyens.",
                                "it": "La situazione politica nel paese <w>preoccupa</w> molti cittadini.",
                                "cs": "Politická situace v zemi <w>znepokojuje</w> mnoho občanů.",
                                "tr": "Ülkedeki siyasi durum birçok vatandaşı <w>kaygılandırıyor</w>.",
                                "es": "La situación política del país <w>preocupa</w> a muchos ciudadanos.",
                                "zh": "该国的政治局势<w>令</w>许多公民<w>担忧</w>。"
                            }
                        }
