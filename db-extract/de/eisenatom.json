                ],
                "senses": [
                    {
                        "sense_id": "79af7b16-6417-3378-8d66-414fa04ef981",
                        "entry_id": "9a2f6ea7-bade-3bb0-b0b5-4a0c90c3b56a",
                        "glosses": [
                            "ein Atom des chemischen Elements Eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa636ac-907e-46f7-bf59-d15f52c4dd0e",
                                "sense_id": "79af7b16-6417-3378-8d66-414fa04ef981",
                                "text": "„Das Eisenatom ist die Bindungsstelle für den Sauerstoff, den das Hämoglobin transportiert.“"
                            },
                            {
                                "example_id": "939a3d53-6df1-483a-b8a9-3f9b9e9a1b8e",
                                "sense_id": "79af7b16-6417-3378-8d66-414fa04ef981",
                                "text": "„Dichter ließe sich ein Datenspeicher kaum packen: Ein internationales Forscherteam hat die Grundlagen geschaffen, um Bits jeweils in einzelnen Eisenatomen zu speichern.“"
                            },
                            {
                                "example_id": "c3c9a107-13c5-4296-ac83-e0fa3ac41806",
                                "sense_id": "79af7b16-6417-3378-8d66-414fa04ef981",
                                "text": "„Die Blöcke aus zwölf Eisenatomen lassen sich durch elektrischen Strom zwischen zwei Magnetisierungszuständen umschalten.“"
                            },
                            {
                                "example_id": "2989652f-7541-474d-bf36-c59155c6a1fc",
                                "sense_id": "79af7b16-6417-3378-8d66-414fa04ef981",
                                "text": "Ein Eisenatom hat ungefähr die 56-fache Masse eines Wasserstoffatoms."
                            },
                            {
                                "example_id": "d3817579-ba76-40c3-9a35-df242276cc98",
                                "sense_id": "79af7b16-6417-3378-8d66-414fa04ef981",
                                "text": "„Auch Chlorophyll und Hämoglobin sind nach dieser Definition keine metallorganischen Verbindungen, da bei ihnen das zentrale Magnesium- bzw. Eisenatom von Stickstoffatomen koordiniert wird.“"
                            },
                            {
                                "example_id": "d7731952-4420-4067-81d4-fd892f4054d4",
                                "sense_id": "79af7b16-6417-3378-8d66-414fa04ef981",
                                "text": "„Die Göttinger Wissenschaftler verwendeten bei ihren Untersuchungen Kobalt- und Eisenatome, die sie mehrere atomare Lagen tief unter einer Kupferoberfläche vergruben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
