                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "remains",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a18de248-5277-3cdd-a1df-e85c75c68652",
                                        "entry_id": "88da9e4c-56e6-3c00-91c0-57915c855746",
                                        "glosses": [
                                            "third-person singular simple present indicative of remain"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "indicative",
                                            "present",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c224196d-cd88-4276-8ee6-c4ad54a209f1",
                                                "sense_id": "a18de248-5277-3cdd-a1df-e85c75c68652",
                                                "text": "We'll go ahead, while she remains here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fafd35f8-cb07-4505-a5ec-da8bb708077e",
                        "source_entry_id": "1c08497f-dedd-3c76-88dc-e65f364dcc65",
                        "source_sense_id": "b8452558-5225-3c60-98e2-72823a1571e4",
