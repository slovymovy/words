                ],
                "senses": [
                    {
                        "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                        "entry_id": "308fd788-e733-3750-8e4e-a1eefd2762b6",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f98a37d-23be-4a35-996e-ee088d15192a",
                                "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                                "text": "Frau Engelbert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7865971c-e4a7-4781-a650-03b35d7757c5",
                                "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                                "text": "Herr Engelbert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "188d9acf-06ec-42ce-9ae3-8e90e5e36fee",
                                "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                                "text": "Die Engelberts kommen heute aus dem Thüringer Wald."
                            },
                            {
                                "example_id": "e6ca9f90-aaa4-441c-9073-7f87d59614cd",
                                "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                                "text": "Der Engelbert trägt nie die Schals, die die Engelbert ihm strickt."
                            },
                            {
                                "example_id": "74f0d899-38fe-4eee-bd48-0102aa845f31",
                                "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Engelbert kommt, geht der Herr Engelbert.“"
                            },
                            {
                                "example_id": "1a5f4eb9-a6c7-4cbe-8fcf-4657c02baa42",
                                "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                                "text": "Engelbert kommt und geht."
                            },
                            {
                                "example_id": "356ced7c-e9df-4a6b-82d8-ef069b3219a6",
                                "sense_id": "092b7e9d-27c6-360c-9a48-1e60064da4da",
                                "text": "Engelberts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
