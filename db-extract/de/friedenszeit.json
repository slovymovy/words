                ],
                "senses": [
                    {
                        "sense_id": "9d8d28f6-bc9b-348b-bf51-b6ed1fe6fd9a",
                        "entry_id": "ef6cac91-f64f-379f-85b9-613d39d141d8",
                        "glosses": [
                            "Zeit, in der Frieden herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33061c1-2a1d-4007-adb7-028a50b51227",
                                "sense_id": "9d8d28f6-bc9b-348b-bf51-b6ed1fe6fd9a",
                                "text": "„In Friedenszeiten jedoch, als wir nicht mehr frieren mußten, gehörte das fuchsrote Fell nur ihr, lag im Schrank in einem Schuhkarton.“"
                            },
                            {
                                "example_id": "8afde4ef-1538-4033-a267-d512108b9120",
                                "sense_id": "9d8d28f6-bc9b-348b-bf51-b6ed1fe6fd9a",
                                "text": "„In Friedenszeiten waren diese mit Palisadenzäunen, Gräben, Wällen und Wachtürmen ausgestatteten Schutzanlagen des Reiches einigermaßen durchlässig.“"
                            },
                            {
                                "example_id": "c6b18c74-860b-4f13-949a-c88733267bc9",
                                "sense_id": "9d8d28f6-bc9b-348b-bf51-b6ed1fe6fd9a",
                                "text": "„Viele der zu Friedenszeiten üblichen Vergnügungsveranstaltungen waren aus politischen Gründen gestrichen worden.“"
                            },
                            {
                                "example_id": "3c3b0098-38d3-4f2c-a147-5d0120416c2a",
                                "sense_id": "9d8d28f6-bc9b-348b-bf51-b6ed1fe6fd9a",
                                "text": "„Alles, was in Friedenszeiten geschah, schien ihn zu quälen.“"
                            },
                            {
                                "example_id": "dbc94cb6-8fdd-4f6d-9797-d7c88a4a880d",
                                "sense_id": "9d8d28f6-bc9b-348b-bf51-b6ed1fe6fd9a",
                                "text": "„Soviel ich weiß, hatte dieses Land bis dahin kaum mal eine längere Friedenszeit erlebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
