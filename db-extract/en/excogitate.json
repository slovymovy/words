                "senses": [
                    {
                        "sense_id": "1a1af7dc-7f17-3d8b-a943-ca61dfc4bc88",
                        "entry_id": "458e7144-3682-3de6-a001-94ba1a220ec6",
                        "glosses": [
                            "To think over something carefully; to consider fully; cogitate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1c2a3f-b4ff-4b42-85c9-b08f7bf32112",
                                "sense_id": "1a1af7dc-7f17-3d8b-a943-ca61dfc4bc88",
                                "text": "The first organs which Gall excogitated, he placed in the region of the sinus; and it is manifest he was then in happy unacquaintance with everything connected with that obnoxious cavity."
                            },
                            {
                                "example_id": "9a980c3c-ee2c-4caf-ad2d-95fed0936e35",
                                "sense_id": "1a1af7dc-7f17-3d8b-a943-ca61dfc4bc88",
                                "text": "Did he ponder the harmony of the spheres? Certainly not: celestial spheres were first excogitated decades or more after Pythagoras' death."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3396218-b7ae-3af0-a997-81e35439a2d8",
                        "entry_id": "458e7144-3682-3de6-a001-94ba1a220ec6",
                        "glosses": [
                            "To reach as a conclusion through reason or careful thought."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd3797f-407a-487d-83ae-560d1f534af8",
                                "sense_id": "b3396218-b7ae-3af0-a997-81e35439a2d8",
                                "text": "After many years of study, he excogitated a solution."
                            },
                            {
                                "example_id": "88445d72-ebd9-46d6-90d1-5f8b5364dda1",
                                "sense_id": "b3396218-b7ae-3af0-a997-81e35439a2d8",
                                "text": "This evidence […] thus excogitated out of the general theory."
                            }
                        ]
                    }
