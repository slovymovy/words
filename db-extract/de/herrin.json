                                "target_senses": [
                                    {
                                        "sense_id": "e69d5948-596f-37e4-94c6-d6b9f693078c",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "ενήλικη γυναίκα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4e563a-2dd9-418c-9e6b-2c202a6dee5d",
                                                "sense_id": "e69d5948-596f-37e4-94c6-d6b9f693078c",
                                                "text": "Τότε μπήκαν στο κατάστημα δύο κυρίες για να ψωνίσουν."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "λέξη που προτάσσεται πριν από κύρια γυναικεία ονόματα. Παλιότερα αποδιδόταν μόνο σε παντρεμένες γυναίκες, ενώ τώρα αποδίδεται γενικά σε οποιαδήποτε ενήλικη γυναίκα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf439e5-54ea-4691-812a-95a29c93c95c",
                                                "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                                "text": "η κυρία Μαρία, η κυρία Παναγιωτοπούλου"
                                            },
                                            {
                                                "example_id": "dccef034-8af1-43f1-a8d6-1177d0b21996",
                                                "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                                "text": "Η κυρία Τίνα μαζί με την κόρη της, τη Δήμητρα, κάνουν τα ψώνια τους στη λαϊκή αγορά."
                                            },
                                            {
                                                "example_id": "38bcb869-6ea7-42ee-a9ff-d915a88d2f67",
                                                "sense_id": "397c85d4-100c-374b-9521-d123a66945d9",
                                                "text": "συντομογραφία: κ., συχνά στην αλληλογραφία: Κα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7eb0aa4-bde5-3b47-b745-6df19da95f32",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "γυναίκα που χαρακτηρίζεται από αρετές όπως αξιοπρέπεια, ευγένεια"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6eeac3-124e-43a6-adcc-d84c7b3e272c",
                                                "sense_id": "c7eb0aa4-bde5-3b47-b745-6df19da95f32",
                                                "text": "μια πραγματική κυρία"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac69a1c-35b4-3b42-8e6f-049b4d09ff79",
                                        "entry_id": "83dc0970-3a71-358d-bead-4351ce84c960",
                                        "glosses": [
                                            "έτσι αποκαλείται, από τους μαθητές της, μια δασκάλα ή καθηγήτρια"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478d4a5f-8bcf-4db9-9b45-797148b62147",
                                                "sense_id": "0ac69a1c-35b4-3b42-8e6f-049b4d09ff79",
                                                "text": "Η κυρία μας θα μας πάει εκδρομή αύριο."
                                            },
                                            {
                                                "example_id": "b48ed956-2d28-4cde-a828-465d91859b8e",
                                                "sense_id": "0ac69a1c-35b4-3b42-8e6f-049b4d09ff79",
                                                "text": "Κυρία! κυρία! Να πάω έξω;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663399be-e4c4-3964-a729-574f91669b42",
