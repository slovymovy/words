                        "glosses": [
                            "пребывание в таком чувстве или состоянии, выказывание такого чувства"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6094a6e-a845-42d5-a32c-f283b9f2e178",
                        "source_entry_id": "34fa9220-989e-3a92-ad5a-5cc0eaf4b37b",
                        "target_lang_word": "schadenfreude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schadenfreude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ac39de-3070-3827-958c-64a16bcc9ebb",
                                        "entry_id": "c21d2363-e5a2-3aec-a26b-8bf9c2f9b10c",
                                        "glosses": [
                                            "Malicious enjoyment derived from observing someone else's misfortune."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71193aa-ab13-4fd4-a982-3854cabe0ac3",
                                                "sense_id": "a5ac39de-3070-3827-958c-64a16bcc9ebb",
                                                "text": "But it is Schadenfreude, a mischievous delight in the misfortunes of others, which remains the worst trait in human nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a06b6d7-9766-4a5d-80a9-07b0a490bcc6",
                        "source_entry_id": "34fa9220-989e-3a92-ad5a-5cc0eaf4b37b",
                        "target_lang_word": "malicious joy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "87218916-748e-4848-9c9d-49b41d4a4997",
                        "source_entry_id": "34fa9220-989e-3a92-ad5a-5cc0eaf4b37b",
                        "target_lang_word": "gloat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gloat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bd44b82-aaf6-3b5b-ad21-4fe9f7a2a39d",
                                        "entry_id": "9d7559e9-8e73-3ccc-a5cd-f4a0816a482e",
                                        "glosses": [
                                            "To exhibit a conspicuous (sometimes malevolent) pleasure or sense of self-satisfaction, often at an adversary's misfortune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d434402-2cae-45ee-98f0-4d2c721c096c",
                                                "sense_id": "7bd44b82-aaf6-3b5b-ad21-4fe9f7a2a39d",
                                                "text": "You did well to win the game, but there's no need to gloat about it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f0ef0b-8853-3495-9a19-e6a6487c0aa1",
                                        "entry_id": "9d7559e9-8e73-3ccc-a5cd-f4a0816a482e",
                                        "glosses": [
                                            "To triumph, crow, relish, glory, revel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gloat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b83e726a-cb8d-358d-80dd-72241a55bca2",
                                        "entry_id": "9f9185bf-5404-347b-a75e-98dba15d0f73",
                                        "glosses": [
                                            "An act or instance of gloating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8e5fbc-4249-4e23-95e0-189ef4cd20af",
                                                "sense_id": "b83e726a-cb8d-358d-80dd-72241a55bca2",
                                                "text": "They spun wildly on their heels, jodelling after the accepted manner of a 'gloat,' which is not unremotely allied to the primitive man's song of triumph […]"
                                            }
                                        ]
                                    }
                                ]
