                                        "sense_id": "e61ea2a8-7555-3e3f-be96-fca0a800dd9b",
                                        "entry_id": "adba09a8-597a-3068-b1e7-72f2d27f1dbb",
                                        "glosses": [
                                            "Any of many tens of thousands of species of herbivorous beetles, ranging in size from tiny to large, in the superfamily Curculionoidea, the most characteristic species having the head projecting in a distinctive snout with the mouthparts at the tip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33d20155-2f59-3b24-9bd6-82d7047ea8de",
                                        "entry_id": "adba09a8-597a-3068-b1e7-72f2d27f1dbb",
                                        "glosses": [
                                            "Any of many tens of thousands of species of herbivorous beetles of various sizes, in the family Curculionidae within the superfamily Curculionoidea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83ee494d-f684-3d98-ba70-37c4f0310faa",
                                        "entry_id": "adba09a8-597a-3068-b1e7-72f2d27f1dbb",
                                        "glosses": [
                                            "Any of many similar, but more distantly related, beetles such as the biscuit weevil (Stegobium paniceum)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7b11d5e-bead-369b-ad4d-18a80c981300",
                                        "entry_id": "adba09a8-597a-3068-b1e7-72f2d27f1dbb",
                                        "glosses": [
                                            "A loathsome person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77cec276-0a72-4a18-b77b-baeed630de75",
                                                "sense_id": "b7b11d5e-bead-369b-ad4d-18a80c981300",
                                                "text": "But you accuse other men of villainy with too easy a tongue, you weevil. I have never wanted you in this matter, and I have said so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
