                                    },
                                    {
                                        "sense_id": "11ec8dc0-0805-3fb2-a88d-3c9a4aba5458",
                                        "entry_id": "b3a7f7c2-e857-3a6c-b27f-bb279c54b5b8",
                                        "glosses": [
                                            "The main kind of church service, in some denominations."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03cb6ba2-7664-4a69-9e42-2cbbbb2a9209",
                                                "sense_id": "11ec8dc0-0805-3fb2-a88d-3c9a4aba5458",
                                                "text": "She went to mass every Sunday for many years, and when she retired, she took to going on some weekdays, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9698788-2243-316c-940d-0d417c2f00b9",
                                        "entry_id": "b3a7f7c2-e857-3a6c-b27f-bb279c54b5b8",
                                        "glosses": [
                                            "The sacrament of the Eucharist."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a907245-27a4-38ee-a5a3-063295b58c5d",
                                        "entry_id": "b3a7f7c2-e857-3a6c-b27f-bb279c54b5b8",
                                        "glosses": [
                                            "A musical setting of parts of the mass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
