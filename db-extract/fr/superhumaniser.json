                "senses": [
                    {
                        "sense_id": "1c9da145-8402-3cff-af4c-2299cf65c22e",
                        "entry_id": "2c510d17-77c8-30c6-a3f3-a101bc08d24a",
                        "glosses": [
                            "Donner un caractère superhumain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b7cc8de-a508-4eb0-86fa-affc9ba0232c",
                                "sense_id": "1c9da145-8402-3cff-af4c-2299cf65c22e",
                                "text": "Là, autour du Christ mort et que l’ombre gagne, c’est d’un beau contraste que ceux qui se penchent sur son cadavre multiplient leur émotion par la vigueur de lumière dont ils sont comme superhumanisés."
                            },
                            {
                                "example_id": "667e9d00-6a61-4092-a807-fa93d0d87ff9",
                                "sense_id": "1c9da145-8402-3cff-af4c-2299cf65c22e",
                                "text": "Superhumaniser les hommes?"
                            },
                            {
                                "example_id": "a9186c2e-c2ce-422a-89fc-f5ffccb4bf85",
                                "sense_id": "1c9da145-8402-3cff-af4c-2299cf65c22e",
                                "text": "Une autre étude très récente montre que les Noirs sont non seulement déshumanisés mais «superhumanisés»."
                            }
                        ]
                    }
