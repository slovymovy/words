                "senses": [
                    {
                        "sense_id": "585092b4-2d2e-3bad-b369-fd36a03443d9",
                        "entry_id": "15f4a460-d866-3664-bcb7-a76d89f10a67",
                        "glosses": [
                            "Commercial property that is built for quick profit and is usually not comfortable to live in and is often against building regulations."
                        ],
                        "tags": [
                            "feminine",
                            "neologism",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "3dd1dcf9-eda2-4b6c-8225-a386463349c4",
                                "sense_id": "585092b4-2d2e-3bad-b369-fd36a03443d9",
                                "text": "Jeśli ktoś planuje inwestycję z lokalem użytkowym poniżej 25 mkw., musi się spieszyć. Szybciej obejmą go przepisy mające zapobiegać patodeweloperce.",
                                "translation": "If someone is planning to invest in commercial property with less than 25m², then they should hurry. Regulations preventing sick development will be in force soon.",
                                "english": "If someone is planning to invest in commercial property with less than 25m², then they should hurry. Regulations preventing sick development will be in force soon."
                            }
                        ]
                    }
                ],
