                    },
                    {
                        "form_id": "4105794a-3dd6-4504-a165-5ce424d3941b",
                        "entry_id": "0e03d69c-42ac-3008-9eb6-bd6f86422e98",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "vlegeltjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5cbe0ce-82ad-3523-9b94-7f0e8848eeab",
                        "entry_id": "0e03d69c-42ac-3008-9eb6-bd6f86422e98",
                        "glosses": [
                            "dorswerktuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe94f45-a42a-4c92-be4f-ae22705da18b",
                                "sense_id": "c5cbe0ce-82ad-3523-9b94-7f0e8848eeab",
                                "text": "Zo ongeveer vanaf de Middeleeuwen werd in de winter de rogge gedorst met een vlegel, in onze streek met een “koeze”, een krom gegroeid boomstammetje."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3ee40f7-397c-39b2-8d08-ac2c9e482024",
                        "entry_id": "0e03d69c-42ac-3008-9eb6-bd6f86422e98",
                        "glosses": [
                            "ondeugende jongen of lompe man"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6d18b5a0-68aa-4851-9570-592a326772e6",
                                "sense_id": "c3ee40f7-397c-39b2-8d08-ac2c9e482024",
                                "text": "Brutale vlegel!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "717f6f82-9b83-472c-8597-553aec1a0587",
                        "source_entry_id": "0e03d69c-42ac-3008-9eb6-bd6f86422e98",
                        "source_sense_id": "c5cbe0ce-82ad-3523-9b94-7f0e8848eeab",
                        "source_sense_description": "dorswerktuig",
                        "target_lang_word": "Flegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e78ee83-3170-385b-855c-f7d285caa0a5",
                                        "entry_id": "48cec20f-b029-3704-b70f-a70477146e51",
                                        "glosses": [
                                            "junger Mann, der sich schlecht oder unhöflich benimmt"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddd4f79f-26fb-4faa-839d-a144ccf78beb",
                                                "sense_id": "2e78ee83-3170-385b-855c-f7d285caa0a5",
                                                "text": "Benimm dich nicht wie ein Flegel."
                                            },
                                            {
                                                "example_id": "36f94e43-c032-4e45-9e9e-429f19e85cb1",
                                                "sense_id": "2e78ee83-3170-385b-855c-f7d285caa0a5",
                                                "text": "„Der Flegel schlug einen herrischen Ton an und wollte wissen, was ich damit gemacht hätte; darauf gab ich ihm zur Antwort, ich hätte ihm keine Rechenschaft abzulegen.“"
                                            },
                                            {
                                                "example_id": "74d18ff0-69b4-49c7-9f4b-86fb3acbc8ef",
                                                "sense_id": "2e78ee83-3170-385b-855c-f7d285caa0a5",
                                                "text": "„Goethe und Carl August konnten auch ungehobelte Flegel sein, und Wieland hat Mühe, seine Gelassenheit zu bewahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a4e6626-dcc7-3a32-aed0-b178b7fc1181",
                                        "entry_id": "48cec20f-b029-3704-b70f-a70477146e51",
                                        "glosses": [
                                            "bäuerliches Handgerät mit einem Stiel und einer Keule zum Trennen (Dreschen) der Getreidekörner vom Stroh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e4510e-3b21-4f7e-acdd-fe2dd6225a4c",
                                                "sense_id": "6a4e6626-dcc7-3a32-aed0-b178b7fc1181",
                                                "text": "Das dreschen mit dem Flegel war härteste körperliche Arbeit."
                                            },
                                            {
                                                "example_id": "dc230e0e-95ed-484f-81b6-edbce84c7c7a",
                                                "sense_id": "6a4e6626-dcc7-3a32-aed0-b178b7fc1181",
                                                "text": "„Winter ists wieder, und der Großvater stutzt einen abgelegten Flegel der Anderthalbmeter-Großmutter für mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a3b2e745-2f7e-365a-b974-2eed99f7c11d",
                                        "entry_id": "48cec20f-b029-3704-b70f-a70477146e51",
                                        "glosses": [
                                            "Schlagwaffe, die im Mittelalter gebraucht wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7da3177-4cdb-4b32-abe1-c2607b1b2ed7",
                                                "sense_id": "a3b2e745-2f7e-365a-b974-2eed99f7c11d",
                                                "text": "Der Flegel wird häufig mit dem Morgenstern verwechselt, der jedoch keine Kette besaß."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cac8a134-0f8b-4ca6-8b70-1b4de9000162",
                        "source_entry_id": "0e03d69c-42ac-3008-9eb6-bd6f86422e98",
                        "source_sense_id": "c5cbe0ce-82ad-3523-9b94-7f0e8848eeab",
                        "source_sense_description": "dorswerktuig",
                        "target_lang_word": "flail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb153edd-f25f-34ca-9ae5-981a6772218e",
                                        "entry_id": "52ae85e0-8a6b-30ed-9e2f-8d019dc07f81",
                                        "glosses": [
                                            "A tool used for threshing, consisting of a long handle (handstock) with a shorter stick (swipple or swingle) attached with a short piece of chain, thong or similar material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54a7249-fbed-4378-9fb3-a404f6f4a908",
                                                "sense_id": "eb153edd-f25f-34ca-9ae5-981a6772218e",
                                                "text": "When in one night, ere glimpse of morn,\nHis shadowy flail hath threshed the corn\nThat ten day-labourers could not end;"
                                            },
                                            {
                                                "example_id": "326ba82b-e31f-421f-a39f-0d79989e627d",
                                                "sense_id": "eb153edd-f25f-34ca-9ae5-981a6772218e",
                                                "text": "Huge fragments vaulted like rebounding hail,\nOr chaffy grain beneath the thresher's flail"
                                            },
                                            {
                                                "example_id": "701ba35d-b29d-44c5-ac01-24b8db7c2c00",
                                                "sense_id": "eb153edd-f25f-34ca-9ae5-981a6772218e",
                                                "text": "On him alone the curse of Cain\nFell, like a flail on the garnered grain,\nAnd struck him to the earth!"
                                            },
                                            {
                                                "example_id": "eff25c9f-c42d-423a-a4fe-3acbd010f50a",
                                                "sense_id": "eb153edd-f25f-34ca-9ae5-981a6772218e",
                                                "text": "If the farmer must use the spade because he has not capital enough for a plough, the sickle instead of the reaping machine, the flail instead of the thresher..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f67f3e4e-31e0-35a5-a4ce-58ba45175511",
                                        "entry_id": "52ae85e0-8a6b-30ed-9e2f-8d019dc07f81",
                                        "glosses": [
                                            "A weapon which has the (usually spherical) striking part attached to the handle with a flexible joint such as a chain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d56f2e76-b227-3513-85f3-ad965ee4b84f",
                                        "entry_id": "52ae85e0-8a6b-30ed-9e2f-8d019dc07f81",
                                        "glosses": [
                                            "Part of a rotating device, often used for cutting vegetation."
                                        ],
                                        "tags": [
                                            "often",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b33445-9612-4584-bbb4-fd8dcadb7d60",
                                                "sense_id": "d56f2e76-b227-3513-85f3-ad965ee4b84f",
                                                "text": "The carriage washing plant uses four pairs of rotating rag flails and will be capable of dealing with the whole of the diesel units as well as steam stock used for main-line trains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72326df5-944e-37ed-be48-34bb414196ac",
                                        "entry_id": "3306207c-a40c-3168-af72-676a6cfd02dd",
                                        "glosses": [
                                            "To beat using a flail or similar implement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df750955-83fd-341e-910a-aaa657f53344",
                                        "entry_id": "3306207c-a40c-3168-af72-676a6cfd02dd",
                                        "glosses": [
                                            "To wave or swing vigorously"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb4e1296-cc34-4c98-adf7-7b18ac81d0d5",
                                                "sense_id": "df750955-83fd-341e-910a-aaa657f53344",
                                                "text": "Tangling with Ziv, Cameron caught him with a flailing elbow, causing the Israeli defender to go down a little easily. However, the referee was in no doubt, much to the displeasure of the home fans."
                                            },
                                            {
                                                "example_id": "cde84d51-f861-4255-b2bc-fa764e4e294f",
                                                "sense_id": "df750955-83fd-341e-910a-aaa657f53344",
                                                "text": "He stopped in his tracks – then, flailing his arms wildly in the air, began to stagger backwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166394b5-4e30-320a-af6e-9d79432f9242",
                                        "entry_id": "3306207c-a40c-3168-af72-676a6cfd02dd",
                                        "glosses": [
                                            "To thresh."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74686529-55a0-33ad-9c5c-ab32363e9ab9",
                                        "entry_id": "3306207c-a40c-3168-af72-676a6cfd02dd",
                                        "glosses": [
                                            "To move like a flail."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdafcba-7b1c-4666-a7bf-0b34bf469539",
                                                "sense_id": "74686529-55a0-33ad-9c5c-ab32363e9ab9",
                                                "text": "He was flailing wildly, but didn't land a blow."
                                            },
                                            {
                                                "example_id": "382f471a-d8e6-4dd8-b0fa-d09939b8428e",
                                                "sense_id": "74686529-55a0-33ad-9c5c-ab32363e9ab9",
                                                "text": "Undismayed he continued to flail with the broken half of it, denting many a helmet[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74c33b91-3760-42bc-9182-69072f4ec158",
                        "source_entry_id": "0e03d69c-42ac-3008-9eb6-bd6f86422e98",
                        "source_sense_id": "c5cbe0ce-82ad-3523-9b94-7f0e8848eeab",
                        "source_sense_description": "dorswerktuig",
                        "target_lang_word": "fléau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fléau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee82aefb-1525-357a-887c-93282f09b530",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Instrument composé de deux bâtons attachés l’un à l’autre à leur bout par un lien flexible, et qui sert à battre le grain pour le séparer de la tige et de l'épi, à la manière d’un fouet rigide. L’un des deux bâtons est le manche de l’outil, l’autre en est la lame."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "839a666a-b803-4520-9a97-852d35abc89a",
                                                "sense_id": "ee82aefb-1525-357a-887c-93282f09b530",
                                                "text": "On va dans la grange où les fléaux s’arrêtent quand les demoiselles et le cousin entrent ! Puis ils repartent décrivant un grand cercle, et battent en mesure les gerbes sur le plancher sonore. J’en attrape un pour essayer ; je sens tourner le battant qui part comme une fronde, et qui revient comme un marteau, qui prend de l’air et fait du vent… S’il touchait une tête, il la casserait comme du verre."
                                            },
                                            {
                                                "example_id": "1aa037b2-4c48-4443-95c6-33e1c23c23a0",
                                                "sense_id": "ee82aefb-1525-357a-887c-93282f09b530",
                                                "text": "Je vis donc depuis quelque temps, sans rien qui me rafraîchisse ou me réchauffe, comme la gerbe qui moisit dans un coin, au lieu de palpiter sous le fléau, comme l'oie qui, clouée par les pattes, gonfle devant le feu."
                                            },
                                            {
                                                "example_id": "b4695453-53c3-413c-8ae1-644069d293de",
                                                "sense_id": "ee82aefb-1525-357a-887c-93282f09b530",
                                                "text": "Un grondement sourd mais qui glaçait le sang ébranla la nuque et les côtes de King. Sa queue avait pris le mouvement du fléau."
                                            },
                                            {
                                                "example_id": "c26dfe45-26aa-42a6-a515-149f9d64a17d",
                                                "sense_id": "ee82aefb-1525-357a-887c-93282f09b530",
                                                "text": "Je battis au fléau les pois chiches, enfermés dans des cosses sèches comme une bille dans un grelot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dca74e28-a6a1-3c6c-91c1-4c0d7ac88058",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Toute grande calamité, malheur ou catastrophe publique ou privée (guerre, épidémie, famine…)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4848d612-9c1e-4c17-97e7-c5effe603177",
                                                "sense_id": "dca74e28-a6a1-3c6c-91c1-4c0d7ac88058",
                                                "text": "Le feu s’avançait majestueusement, engloutissant tout sur son passage, précédé par une foule innombrable d’animaux de toutes sortes, qui bondissaient avec des hurlements de frayeur, poursuivis par le fléau qui les atteignait à chaque pas."
                                            },
                                            {
                                                "example_id": "aa4dbc01-4f58-4de2-b6db-3b4ee694ebe8",
                                                "sense_id": "dca74e28-a6a1-3c6c-91c1-4c0d7ac88058",
                                                "text": "Nous voici devisant avec des Montalbanais de toutes sortes, gens fins et subtils, très avertis du fléau dont nous recherchons les causes, le dénonçant, le déplorant même, le vitupérant, le décrivant, l'analysant, l'exécrant, l'accablant d'imprécations, mais s’en tenant là […]."
                                            },
                                            {
                                                "example_id": "f8d3ba3d-c819-48ef-9023-921dc2a3e2ea",
                                                "sense_id": "dca74e28-a6a1-3c6c-91c1-4c0d7ac88058",
                                                "text": "Il est convaincu que la peste est un fléau endémique et non contagieux et que les seules mesures pour s'en préserver sont des mesures d'hygiène."
                                            },
                                            {
                                                "example_id": "a72fec61-0870-460c-b7c5-3ae777fd0fd4",
                                                "sense_id": "dca74e28-a6a1-3c6c-91c1-4c0d7ac88058",
                                                "text": "En avril 1872, les mouches de la Saint-Marc envahirent Paris et sa région. Elles volaient en abondance et venaient s'abattre sur les passants. L'apparition surprenante en nombre prodigieux de cet insecte fit craindre à certains l'annonce d'un fléau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "562c7cea-7166-3b0d-a91a-27dac987776f",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Se dit aussi de personnes."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1a45bb-3e1c-440c-b047-e8966937a8f1",
                                                "sense_id": "562c7cea-7166-3b0d-a91a-27dac987776f",
                                                "text": "Attila est appelé le fléau de Dieu. - Être le fléau de la société, de l’humanité. - Ce mauvais sujet a été le fléau de sa famille."
                                            },
                                            {
                                                "example_id": "e3c804c2-ddf2-4c4b-a4c8-53275cbc3519",
                                                "sense_id": "562c7cea-7166-3b0d-a91a-27dac987776f",
                                                "text": "Ce dictateur fut un véritable fléau pour son pays."
                                            },
                                            {
                                                "example_id": "3c350594-7898-4764-b6ec-2e0930d7e4cb",
                                                "sense_id": "562c7cea-7166-3b0d-a91a-27dac987776f",
                                                "text": "Vésigneul possède un tumulus dit tombeau d’Attila. Le chef des Huns est mort en Hongrie, mais le nom témoigne du souvenir terrifiant qu’a laissé en Champagne le passage du Fléau de Dieu, personnage beaucoup plus civilisé que ne le laisse supposer ce surnom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9120fcf1-1044-30bd-9d9d-a1f99f37dc58",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Se dit aussi de tout ce qui est nuisible, funeste, redoutable."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b118380-ee15-4999-a68a-7c931dcfb7a8",
                                                "sense_id": "9120fcf1-1044-30bd-9d9d-a1f99f37dc58",
                                                "text": "Parmi les fléaux qui s'abattent sur la vigne, le plus terrible, dans ses effets, est évidemment la grêle. Le vignoble est beau, et plein de promesses, et cinq minutes plus tard il n'en reste rien ; […]."
                                            },
                                            {
                                                "example_id": "667d46a9-3ce9-4a01-a3b7-09c482dc2227",
                                                "sense_id": "9120fcf1-1044-30bd-9d9d-a1f99f37dc58",
                                                "text": "Nous achetions aussi au « Caïffa » nos attrape-mouches. Les mouches étaient un véritable fléau dès que revenaient les beaux jours. Par dizaines, elles s'installaient dans la cuisine […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e047abc0-3b88-34c5-a882-1821daa96349",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Partie principale d’une balance. Tige horizontale aux extrémités de laquelle sont pendus ou se placent les deux plateaux et au milieu de laquelle, pour les balances à cadran, est fixée, perpendiculairement, l’aiguille de l’indicateur de mesure."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1531a5-69e2-4abb-85b3-17e45d61731c",
                                                "sense_id": "e047abc0-3b88-34c5-a882-1821daa96349",
                                                "text": "Petits marchands semblables à des balances, avec leurs deux plateaux au vent et leurs fléaux affolés, carrioles, brouettes dignes des empereurs Tang, infirmes, caves, […]."
                                            },
                                            {
                                                "example_id": "0d974732-2c0a-4ef4-bb6f-a0b5b019179e",
                                                "sense_id": "e047abc0-3b88-34c5-a882-1821daa96349",
                                                "text": "Le fléau d’une balance"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeca615c-d490-364b-9035-8f7f6b654cb8",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Barre de fer qu’on met derrière les portes cochères et qu’on tourne à demi pour ouvrir les deux battants."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c9bb4d-d75f-4ba1-bdbb-d7687e92fd93",
                                                "sense_id": "aeca615c-d490-364b-9035-8f7f6b654cb8",
                                                "text": "Le fléau d’une porte cochère"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79dacb47-065f-322d-b70d-4b06b4a1cc78",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Bascule à contrepoids qui sert à fermer une écluse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40796b5f-8840-30f9-a036-095cefb02caf",
                                        "entry_id": "f2ed909e-e049-3cbf-a379-ce9fd110617f",
                                        "glosses": [
                                            "Fléau d’armes."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
