                "senses": [
                    {
                        "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                        "entry_id": "25f29e08-056b-379f-9fdd-9f21fe34dfbd",
                        "glosses": [
                            "auszeichnende Titulierung, die man bekommt, wenn man einen Meisterschaftswettbewerb als Zweiter beziehungsweise Zweiterfolgreichste abschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa0fd36-b0e9-4b77-893b-1694ee68e8cc",
                                "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                                "text": "„Immerhin reichte es zum Vizemeistertitel und Robert Lewandowski sicherte sich in seiner letzten Saison für Dortmund mit 20 Treffern des Torschützenkönigs, um dann in der Saison darauf Mario Götze nach München zu folgen.“"
                            },
                            {
                                "example_id": "648b738c-9a43-46f0-949c-00a5677f76c8",
                                "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                                "text": "„Nach einem Vizemeistertitel im Folgejahr kam es dazu, dass einige Stammkräfte den Verein verließen und sich Rapid neu aufstellen musste.“"
                            },
                            {
                                "example_id": "02dcbf9c-df50-401b-97b5-222b9aa95414",
                                "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                                "text": "„In der Saison 2012/13 musste der BVB mit dem Vizemeistertitel und dem Erreichen des Champions-League-Finales zufriedengeben, das er in London gegen Bayern München verlor.“"
                            },
                            {
                                "example_id": "ebf01f75-289f-4b47-b5ff-789e2fa6fec9",
                                "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                                "text": "„Der größte Erfolg von Colon war bisher der Vizemeistertitel 1997.“"
                            },
                            {
                                "example_id": "aef96549-3186-4353-88ed-eb5492a097f0",
                                "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                                "text": "„Das höchste der Gefühle waren bisher ein Vizemeistertitel in der La-Liga-Saison 2007/08 sowie zahlreiche Halbfinal-Teilnahmen in den europäischen Bewerben bzw. in der heimischen Copa del Rey.“"
                            },
                            {
                                "example_id": "59cada30-419c-4f43-a245-0f337b13189c",
                                "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                                "text": "„Auch wenn der Saisonstart mit dem 1:1 gegen den WAC nicht ganz nach Wunsch verlaufen ist […], will sich der erfahrene Angreifer nach dem Vizemeistertitel in der Vorsaison in diesem Jahr mit seinem Team noch einmal steigern[.]“"
                            },
                            {
                                "example_id": "687cca0f-61eb-4b5b-a294-277ec0a6cb80",
                                "sense_id": "b6710076-f75f-3d36-b2a2-823e7c6171d6",
                                "text": "„Nach dem erreichten Vizemeistertitel in der Vorsaison ist man auch aktuell wieder der erste Verfolger von Tabellenführer Red Bull Salzburg. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
