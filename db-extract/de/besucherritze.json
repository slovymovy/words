                            {
                                "example_id": "a853b21b-cf2f-4028-bcaf-ca3ed465ad16",
                                "sense_id": "adbb33ca-8cdb-3f94-b7c7-855d1dcd9b87",
                                "text": "Mein Handy verschwand in der Besucherritze."
                            },
                            {
                                "example_id": "d9b973a6-db11-440d-9847-6b700daf1011",
                                "sense_id": "adbb33ca-8cdb-3f94-b7c7-855d1dcd9b87",
                                "text": "Ihr kleiner Sohn kam jede Nacht ins Elternbett und schlief auf der Besucherritze."
                            },
                            {
                                "example_id": "3c97bad8-f3b1-4c57-b2d9-07eeb3c93fbd",
                                "sense_id": "adbb33ca-8cdb-3f94-b7c7-855d1dcd9b87",
                                "text": "Eva Kohlrusch: „Wann sind Sie zum letzten Mal a) hungrig, b) vor den Tagesthemen, c) in einer anderen Stadt, d) ohne Kind in der Besucherritze schlafen gegangen?\""
                            }
