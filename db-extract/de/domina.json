                                "target_senses": [
                                    {
                                        "sense_id": "f45c0ff0-881d-3fc1-b47e-0e2225bc173a",
                                        "entry_id": "6656fae2-de9c-3b93-9eed-7c2bb0b31379",
                                        "glosses": [
                                            "A dominating woman; a female dominator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "170d393d-0edd-3eff-97b2-bedc61a9923c",
                                        "entry_id": "6656fae2-de9c-3b93-9eed-7c2bb0b31379",
                                        "glosses": [
                                            "A dominant female in sadomasochistic practices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e72e05-1afe-4df6-8bc1-a563a1d4acc9",
                                                "sense_id": "170d393d-0edd-3eff-97b2-bedc61a9923c",
                                                "text": "Shadowy masked dominatrixes in stiletto-heeled hip boots snap commands and whips with equal fury."
                                            },
                                            {
                                                "example_id": "55916b13-70b3-4536-b31e-98f3e435c36d",
                                                "sense_id": "170d393d-0edd-3eff-97b2-bedc61a9923c",
                                                "text": "But even as movies depicting successful madams, freelance hookers, and dominatrices were celebrating prostitution as a marketplace expression of the new sexual freedom, doubts were emerging, a backlash growing."
                                            },
                                            {
                                                "example_id": "ae34fd59-0bfc-449d-932d-9a4588ec8017",
                                                "sense_id": "170d393d-0edd-3eff-97b2-bedc61a9923c",
                                                "text": "I've always maintained that the dominatrix is as much a misogynistic caricature as the virginal, asexual \"good\" girl or the disgusting \"nymphomaniac/slut.\" The so-called dominant woman is a dark, eerie version of the woman on a pedestal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dominatrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37e83060-465b-331e-889b-e18d8dc10853",
                                        "entry_id": "a0525d06-492e-3c95-abb0-ff83a57f24d3",
                                        "glosses": [
                                            "To act as a dominatrix, especially professionally."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54fc81d1-84a2-408e-85a6-f91ab56734c3",
                                                "sense_id": "37e83060-465b-331e-889b-e18d8dc10853",
                                                "text": "Cara, when you reach 18, maybe you will take up \"dominatrixing\" for a living."
                                            },
                                            {
                                                "example_id": "652e2c91-2ca1-42a5-a9fa-42b10bfa78bc",
                                                "sense_id": "37e83060-465b-331e-889b-e18d8dc10853",
                                                "text": "Not one single nod is given to the fact is might be something a woman would ever do for the sheer blissy hot of it. Nah, nah, nah, nah, NAH! In fact, in this context, that would probably be beyond horridious. And isn’t that kind of weird. Dominatrixing for money is far more okay (and even kind of family friendly) than dominatrixing for sexual kicks. And you’ve got to wonder why that might be."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
