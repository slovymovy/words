                "senses": [
                    {
                        "sense_id": "b9be7b9b-3740-3463-a5ab-2d3cc72c03cb",
                        "entry_id": "d527ce86-9887-352b-9fbe-b67a215d906b",
                        "glosses": [
                            "Geschwindigkeit, welche die Schallgeschwindigkeit unterschreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b8af43-b77f-4acf-ab08-3067b224ad9c",
                                "sense_id": "b9be7b9b-3740-3463-a5ab-2d3cc72c03cb",
                                "text": "„So wurden auch in jüngster Zeit noch immer neue Konzepte für Flugzeuge mit extrem hohen Unterschallgeschwindigkeiten entwickelt und vorgestellt, wie der Sonic Cruiser von Boeing.“"
                            },
                            {
                                "example_id": "d9265188-457e-4e03-8bcc-340dcfd73992",
                                "sense_id": "b9be7b9b-3740-3463-a5ab-2d3cc72c03cb",
                                "text": "„Nachdem die oberen Schichten der Atmosphäre durchflogen sind, und die Geschwindigkeit auf Unterschallgeschwindigkeit gesunken ist, wird ein Fallschirm ausgeworfen.“"
                            },
                            {
                                "example_id": "6c7a4989-a893-4b6e-9777-46b74d72cec7",
                                "sense_id": "b9be7b9b-3740-3463-a5ab-2d3cc72c03cb",
                                "text": "„Wenn die Concorde die Küste Amerikas oder Europas erreichte, waren die Piloten angewiesen, die Geschwindigkeit auf Unterschallgeschwindigkeit zu reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
