            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e3115bf-7017-3886-999b-3afd506fa44e",
                    "sense_definition": "Native to the place where found; indigenous, rather than having migrated or arrived from elsewhere.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "indigenous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The anthropologists studied the <w>autochthonous</w> population to learn about traditions that predated colonization."
                        },
                        {
                            "text": "Many island species are considered strictly <w>autochthonous</w> because they evolved entirely in isolation."
                        }
                    ],
                    "synonyms": [
                        "aboriginal",
                        "autochthonic",
                        "indigenous",
                        "native"
                    ],
                    "antonyms": [
                        "allochthonous",
                        "heterochthonous"
                    ],
                    "common_phrases": [
                        "autochthonous population",
                        "autochthonous people",
                        "autochthonous species"
                    ]
                },
                {
                    "sense_id": "97e52f3a-0afd-34fc-8743-f3cabeedd507",
                    "sense_definition": "Formed or originating in the part of the body or site where found, rather than having traveled there.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "originating_in_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon determined that the obstruction was an <w>autochthonous</w> thrombus rather than an embolus from elsewhere."
                        },
                        {
                            "text": "Medical researchers distinguished between imported infections and <w>autochthonous</w> cases contracted locally."
                        }
                    ],
                    "antonyms": [
                        "allochthonous"
                    ],
                    "common_phrases": [
                        "autochthonous thrombus",
                        "autochthonous infection"
                    ]
                },
                {
                    "sense_id": "40b6f38d-ed6b-31c9-b9b3-81e09d25ce5f",
                    "sense_definition": "Buried in place, especially of a fossil preserved in its original life position without disturbance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geological_in_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paleontologists discovered an <w>autochthonous</w> assemblage of corals preserved exactly as they had grown on the reef."
                        },
                        {
                            "text": "These well-preserved tree stumps represent an <w>autochthonous</w> fossil forest buried rapidly by volcanic ash."
