                "senses": [
                    {
                        "sense_id": "7c421fd7-bc0f-3f46-8f85-d02202429eb6",
                        "entry_id": "b812a24e-b08b-3a62-9def-787f1afe648e",
                        "glosses": [
                            "Hautreinigungsflüssigkeit mit Tensiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de0146a-bedd-474d-9a8b-c42d1fc320fd",
                                "sense_id": "7c421fd7-bc0f-3f46-8f85-d02202429eb6",
                                "text": "„Mizellenwasser sind wässrige Zubereitungen oder ‚Reinigungswässer‘ zum Reinigen der Haut oder Entfernen von Make-up, die Lösungsvermittler in Form von Mizellen (kleine kugelförmige Tensidkügelchen) in Wasser gelöst enthalten.“"
                            },
                            {
                                "example_id": "fa4e4247-3655-4881-8e16-c479ae2ddf68",
                                "sense_id": "7c421fd7-bc0f-3f46-8f85-d02202429eb6",
                                "text": "„Nutzen Sie zum Reinigen der großen Flächen und des Gesichts Wasser und Handtuch. Keine Seife, kein Peeling, keine alkoholische Lösung, kein Mizellenwasser.“"
                            },
                            {
                                "example_id": "01ea3077-4db1-4a97-9d29-db196e396d5e",
                                "sense_id": "7c421fd7-bc0f-3f46-8f85-d02202429eb6",
                                "text": "„Mizellenwässer sind ideal, um von Einweg-Reinigungstüchern wegzukommen und zu einer nachhaltigeren, hautfreundlicheren Lösung zu wechseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
