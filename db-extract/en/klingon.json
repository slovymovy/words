            {
                "entry_id": "9b2eb4cf-6a0c-32be-856d-26e856800f2e",
                "word": "Klingon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d269fd20-b858-4d7e-ab0b-794518a8b476",
                        "entry_id": "9b2eb4cf-6a0c-32be-856d-26e856800f2e",
                        "tags": [
                            "plural"
                        ],
                        "form": "Klingons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "271453cb-0557-3c9d-8053-8e62f1ee6f0d",
                        "entry_id": "9b2eb4cf-6a0c-32be-856d-26e856800f2e",
                        "glosses": [
                            "A member of an alien warrior race in the Star Trek universe with distinctive forehead ridges and a culture based on the strict observance of honor, loyalty, and combat."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ca6de089-0e04-4f42-b81c-8100485a813c",
                                "sense_id": "271453cb-0557-3c9d-8053-8e62f1ee6f0d",
                                "text": "SPOCK: Captain, we've reached the designated position for scanning the coded directive tape.\nKIRK: Good. We've both guessed right. Negotiations with the Klingon Empire are on the verge of breaking down. Starfleet Command anticipates a surprise attack. We are to proceed to Organia and take whatever steps are necessary to prevent the Klingons from using it as a base."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db9026a7-df9e-4a99-82a0-fd2d9a60e281",
                        "source_entry_id": "9b2eb4cf-6a0c-32be-856d-26e856800f2e",
                        "source_sense_id": "271453cb-0557-3c9d-8053-8e62f1ee6f0d",
                        "source_sense_description": "member of an alien warrior race in the Star Trek universe",
                        "target_lang_word": "Klingon",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "98c2d621-cd94-4f4d-90d9-87b0118ee238",
                        "source_entry_id": "9b2eb4cf-6a0c-32be-856d-26e856800f2e",
                        "source_sense_id": "271453cb-0557-3c9d-8053-8e62f1ee6f0d",
                        "source_sense_description": "member of an alien warrior race in the Star Trek universe",
                        "target_lang_word": "Klingon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klingon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67606ac2-d8b3-39e1-af26-bb73e3e03c1c",
                                        "entry_id": "ff048ffd-4ea8-3293-890c-6ff1f55439c4",
                                        "glosses": [
                                            "Race d’extraterrestres dans l’univers de fiction Star Trek."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85dcafe-f798-4f42-856d-ac4767498a16",
                                                "sense_id": "67606ac2-d8b3-39e1-af26-bb73e3e03c1c",
                                                "text": "Les Klingons sont originaires de la planète Qo'noS (Kronos)."
                                            },
                                            {
                                                "example_id": "15eabffd-8f2b-494c-8df2-9365f2982dba",
                                                "sense_id": "67606ac2-d8b3-39e1-af26-bb73e3e03c1c",
                                                "text": "Elle m’a fait :\n— T’as l’air d’une Klingon.\nElle est vraiment bouchée comme fille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b46e55b-681b-42e3-9d11-5666a2572f15",
                        "source_entry_id": "9b2eb4cf-6a0c-32be-856d-26e856800f2e",
                        "source_sense_id": "271453cb-0557-3c9d-8053-8e62f1ee6f0d",
                        "source_sense_description": "member of an alien warrior race in the Star Trek universe",
                        "target_lang_word": "Klingone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klingone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f323e7e-3175-3ea4-90c7-d4b4f7abd047",
                                        "entry_id": "5f2a3c11-881d-389d-b382-9c8d55eb6cdc",
                                        "glosses": [
                                            "Angehöriger eines fiktiven außerirdischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e940cd6-10d3-4533-897f-d2e57fe9caf9",
                                                "sense_id": "2f323e7e-3175-3ea4-90c7-d4b4f7abd047",
                                                "text": "„Und deshalb zerren sie mich aus dem Bett? Weil die Klingonen wütend sind?“ Er sah zu Cooper. „Notieren sie das, Commander: Die Klingonen sind wütend.“"
                                            },
                                            {
                                                "example_id": "ca2dd8c3-7aba-407e-aeb7-7d68209b6cd8",
                                                "sense_id": "2f323e7e-3175-3ea4-90c7-d4b4f7abd047",
                                                "text": "„Buchberger erzählt, dass der Sprachenerfinder fortan behauptet, er habe einen Klingonen in seinem Keller gefangen und dieser teile ihm immer wieder neue Wörter mit. Klingonisch – ein einziges Fantasiegebilde und ein Riesenspaß?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
