                ],
                "senses": [
                    {
                        "sense_id": "cb4873e2-6d96-34ff-8980-f7c3c1ac51a5",
                        "entry_id": "d61e24a3-610e-3949-a132-636090a50725",
                        "glosses": [
                            "energie in de vorm van elektromagnetische golven of subatomaire deeltjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd9a728-06e8-4010-afab-3d3209c4792c",
                                "sense_id": "cb4873e2-6d96-34ff-8980-f7c3c1ac51a5",
                                "text": "Bij thermische straling wordt de intensiteit op een bepaalde golflengte bepaald door de temperatuur, net zoals dat bij infraroodstraling het geval is."
                            },
                            {
                                "example_id": "614b52e6-c7b8-4fb6-b4b7-cdb943d531bc",
                                "sense_id": "cb4873e2-6d96-34ff-8980-f7c3c1ac51a5",
                                "text": "Probleem is wel dat het op Mars gemiddeld zo'n 50 graden vriest; de planeet heeft een ijle dampkring van koolzuurgas, en er is geen bescherming tegen dodelijke kosmische straling uit het heelal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53688a2d-a14c-4d62-8ff3-ad950228b5e3",
                        "source_entry_id": "d61e24a3-610e-3949-a132-636090a50725",
                        "source_sense_id": "cb4873e2-6d96-34ff-8980-f7c3c1ac51a5",
                        "target_lang_word": "Strahlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strahlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d017799a-aeaa-39f6-b851-b51f677c2ed3",
                                        "entry_id": "f75c1ffe-7ac1-3be9-bd1e-d7ad34eaa370",
                                        "glosses": [
                                            "die Ausbreitung von Teilchen oder Wellen in eine bestimmte Richtung"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d928db-f53c-4c5b-b2bc-8dcff6366ea3",
                                                "sense_id": "d017799a-aeaa-39f6-b851-b51f677c2ed3",
                                                "text": "Die radioaktive Strahlung ist für Menschen sehr gefährlich."
                                            },
                                            {
                                                "example_id": "25030aa4-8c53-47f3-8585-714c2b94baf2",
                                                "sense_id": "d017799a-aeaa-39f6-b851-b51f677c2ed3",
                                                "text": "„Ein fehlerhaftes Laborgerät und Mangel an Vorsicht bewirkten, daß seine linke Hand eine Überdosis von radioaktiver Strahlung abbekam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cbbb1379-9d45-3678-9b71-deba2fce8eba",
                                        "entry_id": "f75c1ffe-7ac1-3be9-bd1e-d7ad34eaa370",
                                        "glosses": [
                                            "Wirkung oder Ausstrahlung eines Menschen"
                                        ],
                                        "tags": [
                                            "no-plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb2edd9-a2ee-46b5-ad21-a60981b8805b",
                                                "sense_id": "cbbb1379-9d45-3678-9b71-deba2fce8eba",
                                                "text": "„… er war noch jung, es war noch weit vom Ende, noch ging Strahlung und Verlockung von ihm aus, noch liebten sie ihn, die guten ängstlichen Weibchen, noch zählten sie auf ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db00a2c1-e5fc-4bba-85f7-c897f256b39e",
                        "source_entry_id": "d61e24a3-610e-3949-a132-636090a50725",
                        "source_sense_id": "cb4873e2-6d96-34ff-8980-f7c3c1ac51a5",
                        "target_lang_word": "radiation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b88abb9-3f15-3e21-b70e-23b586325b92",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The shooting forth of anything from a point or surface, like diverging rays of light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bbeb5c-0248-457e-817c-e41d816d83e5",
                                                "sense_id": "8b88abb9-3f15-3e21-b70e-23b586325b92",
                                                "text": "The radiation of love from the crowd was addictive to the young singer-songwriters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ecdbd55-d88d-3a5e-8dd6-7dc1d26622cf",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The shooting forth of anything from a point or surface, like diverging rays of light.",
                                            "Ellipsis of electromagnetic radiation."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e12352-df03-4212-84c7-5b10dd0f5278",
                                                "sense_id": "3ecdbd55-d88d-3a5e-8dd6-7dc1d26622cf",
                                                "text": "heat radiation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e814ae26-7188-3a28-ac48-677385a35010",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The process of radiating waves or particles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0920265-3f0b-3ecc-a4af-6a72eb80bc45",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "The transfer of energy via radiation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43a3eb62-a7b1-3957-9f3e-ff2779d304ec",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "Radioactive energy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de53d77a-0063-40e5-90e6-ea9201871212",
                                                "sense_id": "43a3eb62-a7b1-3957-9f3e-ff2779d304ec",
                                                "text": "It's Christmas at ground zero / And if the radiation level's OK / I'll go out with you / To see all the new / Mutations on New Year's Day"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e5710ff-a8d9-3e3d-b2de-679a48f6c76f",
                                        "entry_id": "7fa07465-83ba-373d-98b1-f47eb5c2fa20",
                                        "glosses": [
                                            "A rapid diversification of an ancestral species into many new forms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6737478-75bf-4572-942e-df9abb573a08",
                                                "sense_id": "8e5710ff-a8d9-3e3d-b2de-679a48f6c76f",
                                                "text": "So the question is: have plants and animals retained over this huge amount of time—whole radiations of mammals have come and gone in this period—have they retained these potentially costly characteristics?"
                                            },
                                            {
                                                "example_id": "c79b0437-8d61-4ec8-8640-04d372c46d4f",
                                                "sense_id": "8e5710ff-a8d9-3e3d-b2de-679a48f6c76f",
                                                "text": "The second [canid group] is the radiation of dogs in South America that began when the first canids arrived about 3 Ma, after crossing the Panama land bridge (Fig. 5.4)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b938f9c-6147-42bf-80c5-ad9d49683561",
                        "source_entry_id": "d61e24a3-610e-3949-a132-636090a50725",
                        "source_sense_id": "cb4873e2-6d96-34ff-8980-f7c3c1ac51a5",
                        "target_lang_word": "rayonnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rayonnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50578bc7-f0eb-3956-a11f-29d1b6106fb7",
                                        "entry_id": "562a95f0-17c3-3979-b486-c5b44a859ffd",
                                        "glosses": [
                                            "Action de rayonner ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431d3ad8-914f-42c0-88f5-4e9c9cf283c9",
                                                "sense_id": "50578bc7-f0eb-3956-a11f-29d1b6106fb7",
                                                "text": "Sans style et sans grâce de jour, dans la lumière magique de la lune, elle apparaissait diaphane et presque translucide, baignée d'un rayonnement imprécis."
                                            },
                                            {
                                                "example_id": "d7063933-80d4-405a-aed8-7bd5addd5af7",
                                                "sense_id": "50578bc7-f0eb-3956-a11f-29d1b6106fb7",
                                                "text": "Les ténèbres étaient épaisses, la lune voilée par de gros nuages noirs, qui couraient lourdement dans l’espace, ne répandait, par intervalles, qu’une lueur blafarde et sans rayonnement …."
                                            },
                                            {
                                                "example_id": "73e09037-4500-4136-a217-46a0e7c748ff",
                                                "sense_id": "50578bc7-f0eb-3956-a11f-29d1b6106fb7",
                                                "text": "Le rayonnement global mensuel en décajoules par cm² (daJcm²), mesuré avec un solarimètre à thermopile, pour cette période est donné ci-après."
                                            },
                                            {
                                                "example_id": "35533091-fa44-4eca-9715-1bdced71f4c8",
                                                "sense_id": "50578bc7-f0eb-3956-a11f-29d1b6106fb7",
                                                "text": "Les radiations absorbées par la feuille de verre portée à température de la pièce, sont réémises selon une loi de corps noir. Le verre ne constitue donc qu'une barrière faible au rayonnement et se comporte comme un corps noir quasi parfait."
                                            },
                                            {
                                                "example_id": "78f67760-e2a1-467e-a0f5-1b9943995ace",
                                                "sense_id": "50578bc7-f0eb-3956-a11f-29d1b6106fb7",
                                                "text": "Afin de réduire la quantité de rayonnement qui l'atteint, une chicane est installée. Pour être efficace, l’épaisseur de celle-ci doit être conséquente. On rencontre souvent des épaisseurs de plus de 150 cm (figure 3.12)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b5a3568-485e-32cb-bb8e-4b552cfaee06",
                                        "entry_id": "562a95f0-17c3-3979-b486-c5b44a859ffd",
                                        "glosses": [
                                            "Le fait de paraître radieux, en parlant des personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75e7173a-046d-45f6-8de9-d1d725d7dd42",
                                                "sense_id": "9b5a3568-485e-32cb-bb8e-4b552cfaee06",
                                                "text": "Le rayonnement de la joie, du bonheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6642b212-3314-3ed8-8cc5-581176655dd2",
                                        "entry_id": "562a95f0-17c3-3979-b486-c5b44a859ffd",
                                        "glosses": [
                                            "Expansion en parlant d’une doctrine, d’une civilisation, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3499c63e-bd17-4d85-9da5-8b10a3a2dd1b",
                                                "sense_id": "6642b212-3314-3ed8-8cc5-581176655dd2",
                                                "text": "Le rayonnement de l'Empire romain."
                                            },
                                            {
                                                "example_id": "c7f45d30-be20-4ef4-b9b6-05ec4ed84d4e",
                                                "sense_id": "6642b212-3314-3ed8-8cc5-581176655dd2",
                                                "text": "Pour se conformer à l'air du temps, le comité proposait que l'une des finalités de l'université soit, en plus de l'enseignement et de la recherche, « l'engagement social ». Probablement parce qu'il craint la portée de cette expression, un professeur préfère que l'on parle de « rayonnement dans le milieu », ce qui correspond mieux selon lui à la fonction sociale de l'université."
                                            },
                                            {
                                                "example_id": "94c6f0e7-7d8c-4e41-aac8-6787396a6ada",
                                                "sense_id": "6642b212-3314-3ed8-8cc5-581176655dd2",
                                                "text": "Devenu premier ministre à l’issue des élections du 22 juin 1960, Jean Lesage dira, le 28 mars 1961 : « Le gouvernement a l’intention de faire de la province de Québec le centre de rayonnement de la culture française en Amérique. […] »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
