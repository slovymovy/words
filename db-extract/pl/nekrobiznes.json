                "senses": [
                    {
                        "sense_id": "16f780ab-5712-39f3-bbd2-4d844d64e92d",
                        "entry_id": "abdac7eb-a775-370f-9ef0-88e946617500",
                        "glosses": [
                            "biznes związany z przechowywaniem, transportem zwłok, organizacją pochówków itp."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "3bcaf57e-7a17-4ebc-bb32-49cda4699d48",
                                "sense_id": "16f780ab-5712-39f3-bbd2-4d844d64e92d",
                                "text": "Przedsiębiorcy zajmujący się nekrobiznesem żądają wprowadzenia certyfikatów potwierdzających odpowiednią jakość trumien"
                            },
                            {
                                "example_id": "851e5bb2-48df-40e3-9292-dcfaeeb745c5",
                                "sense_id": "16f780ab-5712-39f3-bbd2-4d844d64e92d",
                                "text": "Nekrobiznes to duże przychody, duże zyski, bo dużo mniejsze koszty niż przychody, więc zawsze znajdzie się parę setek złotych na opłacenie tych, którzy „skombinują” dla zakładu pogrzebowego kolejne zwłoki"
                            },
                            {
                                "example_id": "d377a5c4-82b2-4c59-a3e0-7b04acf14065",
                                "sense_id": "16f780ab-5712-39f3-bbd2-4d844d64e92d",
                                "text": "Do tej pory policja w związku z nekrobiznesem zatrzymała siedem osób"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
