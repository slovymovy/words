                        "form": "die Schulsprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "465cecbf-ea9e-38b5-a7bb-a52b26592917",
                        "entry_id": "d5fabff1-3ab6-34a5-b71b-cfc862388408",
                        "glosses": [
                            "Sprache, in der an Schulen unterrichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "487d9dc4-4099-4a64-88ae-08b67803fd69",
                                "sense_id": "465cecbf-ea9e-38b5-a7bb-a52b26592917",
                                "text": "„Während dieser Zeit habe die deutsche Sprache sogar den Status einer offiziellen Schul- und Staatssprache gehabt, den das Ungarische selbst erst zu einem späteren Zeitpunkt erlangen konnte.“"
                            },
                            {
                                "example_id": "17b68b19-5c90-4ff0-b4a8-af13ed789d9e",
                                "sense_id": "465cecbf-ea9e-38b5-a7bb-a52b26592917",
                                "text": "„Landsmål wurde 1885 mit dem Dänischen gleichgestellt und verbreitete sich schnell als Schulsprache und allgemeine Gebrauchssprache.“"
                            },
                            {
                                "example_id": "33a0cde7-a046-4304-b4ea-f13a0e74e885",
                                "sense_id": "465cecbf-ea9e-38b5-a7bb-a52b26592917",
                                "text": "„Auch wenn in den Regelschulen und vor allem in den Familien teilweise andere Sprachen (Arabisch, Hebräisch, Russisch etc.) gesprochen werden, so bleibt die Schulsprache Deutsch.“"
                            },
                            {
                                "example_id": "015106ae-d1a4-4cd4-a754-30e181a7df89",
                                "sense_id": "465cecbf-ea9e-38b5-a7bb-a52b26592917",
                                "text": "„Der ansonsten eher liberale Friedrich VII. stimmte nicht zu, sondern straffte stattdessen die Zügel, unter anderem, indem er Dänisch zur Schulsprache des gesamten Gebiets bestimmte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
