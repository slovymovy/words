        "nl-extract.jsonl": [
            {
                "entry_id": "9db3e37d-1c66-351e-b7c9-c804502551cb",
                "word": "gezagdrager",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f322c5bc-7495-404e-8cbd-ffc91fd29afd",
                        "entry_id": "9db3e37d-1c66-351e-b7c9-c804502551cb",
                        "tags": [
                            "plural"
                        ],
                        "form": "gezagdragers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd6f1dfb-a38c-34f6-b89b-55da850c60eb",
                        "entry_id": "9db3e37d-1c66-351e-b7c9-c804502551cb",
                        "glosses": [
                            "mensen die een bestuursfunctie hebben; iemand die het recht heeft om te bevelen; iemand die gehoorzaamt dient te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb070b53-a05a-448d-991d-c8942f183272",
                                "sense_id": "bd6f1dfb-a38c-34f6-b89b-55da850c60eb",
                                "text": "„Net de minister-president van België van het podium gestuurd om het maken van selfies tijdens mijn set. Zo hoort het.” Aan Belgische media liet de dj later weten dat het bericht met een knipoog was bedoeld en dat er geen gezagdragers van zijn stage zijn gestuurd."
                            },
                            {
                                "example_id": "db5ed00c-ee03-4940-8150-d592183d4034",
                                "sense_id": "bd6f1dfb-a38c-34f6-b89b-55da850c60eb",
                                "text": "De Nederlandse missie in Uruzgan mag niet mislukken, zei Dick Berlijn, de hoogste militaire gezagdrager in ons land. Deze week is de Nederlandse missie officieel begonnen, nadat eerder al kwartiermakers waren afgereisd naar de Afghaanse provincie."
                            },
                            {
                                "example_id": "c1dca7d6-d6de-48af-9c67-7b7de0b57214",
                                "sense_id": "bd6f1dfb-a38c-34f6-b89b-55da850c60eb",
                                "text": "Kardinaal Simonis vond ‘Noach’ een prachtige naam voor het nieuwe parochieverband van zeven rooms-katholieke kerkgemeentes in de Noord-Oost-Achterhoek. Dat zegt Jan Beunk, die de naam vier jaar geleden inzond voor een prijsvraag. Het voorstel van de Beltrumer werd uitgekozen en samen met een delegatie van het parochieverband reisde hij naar Utrecht voor een ontmoeting met de toenmalige hoogste gezagdrager van de katholieke kerk in Nederland."
                            }
                        ]
                    }
                ],
