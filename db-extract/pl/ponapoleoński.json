                "senses": [
                    {
                        "sense_id": "e31606fc-847a-34a9-82ca-b3705feefe88",
                        "entry_id": "3c246235-2496-34aa-a890-42554b9780c0",
                        "glosses": [
                            "istniejący, dziejący się w okresie po ostatecznej klęsce Napoleona Bonapartego w 1815 r."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1716894-096a-4bcd-92c0-ccb27334e8f6",
                                "sense_id": "e31606fc-847a-34a9-82ca-b3705feefe88",
                                "text": "W armiach ery napoleońskiej i ponapoleońskiej lojalność wobec króla została zastąpiona lojalnością wobec narodu, opartą na patriotyzmie narodowym"
                            },
                            {
                                "example_id": "b5835bdf-b495-4b97-8fb3-7d62c8b045a1",
                                "sense_id": "e31606fc-847a-34a9-82ca-b3705feefe88",
                                "text": "Chociaż w następnych latach podjęto kilka prób przywrócenia państwowości polskiej, żaden z efemerycznych tworów dyplomacji napoleońskiej i ponapoleońskiej nie uzyskał pełnej suwerenności i żadnemu nie udało się zjednoczyć pod jednymi rządami całego polskiego narodu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
