                "senses": [
                    {
                        "sense_id": "42c50885-c025-38c1-aec9-93613c4c9970",
                        "entry_id": "d890b7c0-d827-38f3-bbf2-c11b3e4d8f04",
                        "glosses": [
                            "dziedzina wiedzy zajmująca się przekazywaniem informacji w sposób zabezpieczony przed nieuprawnionym dostępem, obejmuje tak utajnianie wiadomości (kryptografię) jak i przełamywanie ich zabezpieczeń i odczyt treści (kryptoanalizę)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccf19eff-9429-4305-8a89-e7bf3d7c19c7",
                        "source_entry_id": "d890b7c0-d827-38f3-bbf2-c11b3e4d8f04",
                        "source_sense_id": "42c50885-c025-38c1-aec9-93613c4c9970",
                        "target_lang_word": "cryptology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43ed0a61-e616-3b54-86ad-1c7f5924d947",
                                        "entry_id": "63490262-fef0-3307-876d-b7545e356841",
                                        "glosses": [
                                            "The science or study of mathematical, linguistic, and other coding patterns and histories."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86c0938f-cbd5-49ce-8333-8b0d68c9a03f",
                                                "sense_id": "43ed0a61-e616-3b54-86ad-1c7f5924d947",
                                                "text": "Meronyms: cryptography, cryptanalysis; encoding, decoding; encrypting, decrypting, decyphering"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26fe3b22-18d3-371f-a29d-2e65ca93fc06",
                                        "entry_id": "63490262-fef0-3307-876d-b7545e356841",
                                        "glosses": [
                                            "The practice of analysing encoded messages, in order to decode them."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a85adcf-0e04-4948-87d7-6d38c19e5558",
                                                "sense_id": "26fe3b22-18d3-371f-a29d-2e65ca93fc06",
                                                "text": "Near-synonyms: cryptanalysis, decoding, decrypting, decyphering"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d3b28b-ea22-3c34-8962-4e747a73918d",
                                        "entry_id": "63490262-fef0-3307-876d-b7545e356841",
                                        "glosses": [
                                            "Secret or enigmatical language."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722838bc-a3da-4b2b-837d-6c284405926e",
                                                "sense_id": "a9d3b28b-ea22-3c34-8962-4e747a73918d",
                                                "text": "But the question of speech-play causes confusion to the slang researcher because this subject borders on family slang, private lingo, secret language, cryptologies, disguised language of children and grown-ups"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "186bc4b6-0a55-4634-a031-454207db6de1",
                        "source_entry_id": "d890b7c0-d827-38f3-bbf2-c11b3e4d8f04",
                        "source_sense_id": "42c50885-c025-38c1-aec9-93613c4c9970",
                        "target_lang_word": "cryptologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37cd67bc-4ca7-3a6d-83c8-96953380b5af",
                                        "entry_id": "cf36a819-8cef-3ce6-9a92-d57ee2c89698",
                                        "glosses": [
                                            "Science qui étudie les techniques de chiffrement et de déchiffrement des informations pour assurer leur confidentialité, leur intégrité et leur authenticité. Elle se divise en deux branches principales la cryptographie (l’écriture secrète) et la cryptanalyse (l’analyse de cette dernière)."
                                        ],
                                        "tags": [
                                            "Cryptologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d61ae593-4801-496c-8893-ec344b189ae5",
                                                "sense_id": "37cd67bc-4ca7-3a6d-83c8-96953380b5af",
                                                "text": "Parmi les 183 propositions présentées cette année aux étudiants de niveau bac + 5 en électronique, en cryptologie ou en informatique, certaines s’adressent sans fausse barbe à de futurs hackeurs."
                                            },
                                            {
                                                "example_id": "0d5731c4-6f2e-48f6-a059-6600194e668b",
                                                "sense_id": "37cd67bc-4ca7-3a6d-83c8-96953380b5af",
                                                "text": "Le système des tiers de confiance n’est pas clairement défini. Un rapport du 27 mai 1997, rédigé par un collège de personnalités de la cryptologie (Diffie, Rivest, Schiller, etc.), précise à ce sujet qu’un système gouvernemental de surveillance des clés servant au chiffrement relève pour l’instant de l’utopie, principalement à cause de la complexité d’un tel système."
                                            },
                                            {
                                                "example_id": "9c7f8054-f330-4f57-8c38-58c58737b625",
                                                "sense_id": "37cd67bc-4ca7-3a6d-83c8-96953380b5af",
                                                "text": "Sont également visées, entre autres, la complicité d'administration d'une plateforme en ligne pour permettre une transaction illicite en bande organisée, de détention et de diffusion de l'image d'un mineur présentant un caractère pédo pornographique, d'infraction à la législation sur les stupéfiants, d'escroquerie en bande organisée ainsi que le blanchiment de crimes ou de délit en bande organisée et la fourniture de prestations de cryptologie visant à assurer des fonctions de confidentialité sans déclaration conforme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "646e55d1-fe98-472a-b997-86d22be75f0e",
                        "source_entry_id": "d890b7c0-d827-38f3-bbf2-c11b3e4d8f04",
                        "source_sense_id": "42c50885-c025-38c1-aec9-93613c4c9970",
                        "target_lang_word": "criptología",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "08ae3114-b954-4976-87e7-98b3b3030b8b",
                        "source_entry_id": "d890b7c0-d827-38f3-bbf2-c11b3e4d8f04",
                        "source_sense_id": "42c50885-c025-38c1-aec9-93613c4c9970",
                        "target_lang_word": "Kryptologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kryptologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                                        "entry_id": "fd485ebd-cb4d-31e1-81df-447c14fbf114",
                                        "glosses": [
                                            "Wissenschaft, die sich mit technischen Verfahren der Verschlüsselung beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b5ec10-33b1-44ba-b2ea-11b14bb66495",
                                                "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                                                "text": "Die Kryptologie lässt sich in die beiden Gebiete Kryptographie (modernere Schreibweise auch: „Kryptografie“) und Kryptoanalyse (modernere Schreibweise auch: „Kryptanalyse“) unterteilen."
                                            },
                                            {
                                                "example_id": "762d1515-4e9c-45a2-9c6c-a20e373e9fbc",
                                                "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                                                "text": "Vielmehr werden die Begriffe Kryptologie und Kryptographie gelegentlich vielleicht auch aus Unwissenheit oder Bequemlichkeit zuweilen gleichberechtigt verwendet."
                                            },
                                            {
                                                "example_id": "f8c5be0a-9489-4c2c-af8a-6e6c3c34da7c",
                                                "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                                                "text": "„Weil der Tierkreismörder allenfalls über laienhafte Kenntnisse der Kryptologie verfügt haben dürfte, sieht Autor Schmeh hier eine der Grundregeln des klandestinen Gewerbes bestätigt: »Profis sind berechenbar, die Amateure sind wirklich gefährlich«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
