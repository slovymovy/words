                ],
                "senses": [
                    {
                        "sense_id": "af5e4ee0-d633-362c-a4bb-12c8c680bb76",
                        "entry_id": "4fd046b4-2002-3d54-8670-44ecf56e6712",
                        "glosses": [
                            "The quality of being exceptional."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "449addb1-4d4a-47a4-8291-283392458b3a",
                                "sense_id": "af5e4ee0-d633-362c-a4bb-12c8c680bb76",
                                "text": "For all their exceptionality, there is also a numbing sameness to the movies of Hayao Miyazaki."
                            }
                        ]
                    },
                    {
                        "sense_id": "40e8c462-f902-371b-a091-8fd461dd0ad3",
                        "entry_id": "4fd046b4-2002-3d54-8670-44ecf56e6712",
                        "glosses": [
                            "A thing, condition, or other matter which is exceptional."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "daa330e8-abb1-47c3-ba85-034be9f80d08",
                                "sense_id": "40e8c462-f902-371b-a091-8fd461dd0ad3",
                                "text": "We are fain to ask what is to become of Shakespeare and a host of others, who, with equal originality of thought, have avoided those vagrant exceptionalities of humour."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8b61ff1-5799-35bc-935c-d7d7d9201d1b",
                        "entry_id": "4fd046b4-2002-3d54-8670-44ecf56e6712",
                        "glosses": [
                            "the condition of requiring special schooling for reasons of intellectual giftedness or physical or mental disability"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a1213675-cdbe-4fa2-a617-be1e48d5c74f",
                                "sense_id": "c8b61ff1-5799-35bc-935c-d7d7d9201d1b",
                                "text": "1998, National Joint Committee on Learning Disabilities, \"Learning Disabilities: Preservice Preparation of General and Special Education Teachers,\" Learning Disability Quarterly, vol. 21, no. 3, p. 185,\nEducators who are earning degrees as learning disability specialists should . . . understand the differences between learning disabilities and other exceptionalities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cddec11-0a12-4ec9-a519-cb3900693e05",
                        "source_entry_id": "4fd046b4-2002-3d54-8670-44ecf56e6712",
                        "source_sense_description": "quality of being exceptional",
                        "target_lang_word": "uitzonderlijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitzonderlijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e2beeae4-5a46-3fd7-b391-a426da7c5abd",
                                        "entry_id": "6b26455a-f479-3582-b101-8691e21f14c9",
                                        "glosses": [
                                            "het heel anders zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb5155da-bf47-40a0-a5b6-da0544971881",
                                                "sense_id": "e2beeae4-5a46-3fd7-b391-a426da7c5abd",
                                                "text": "Camerota's gast, radiopresentator en actief Tea Party-lid David Webb, zag in de keuze van de outfits van de atleten zelfs een vorm van 'anti-Amerikanisme' waardoor de Amerikanen hun \"uitzonderlijkheid\" niet meer zouden durven benadrukken. Webb wees er op dat landen als bijvoorbeeld China, wel degelijk nationalistische kleuren dragen."
                                            },
                                            {
                                                "example_id": "3051c537-e97c-453b-b1f1-3756144b89f4",
                                                "sense_id": "e2beeae4-5a46-3fd7-b391-a426da7c5abd",
                                                "text": "Zich verschuilend achter hun \"uitzonderlijkheid\", negeren de Verenigde Staten op arrogante wijze de zienswijzen en belangen van andere landen."
                                            },
                                            {
                                                "example_id": "828e6941-97da-49b4-b24c-86ce4e4f58a6",
                                                "sense_id": "e2beeae4-5a46-3fd7-b391-a426da7c5abd",
                                                "text": "De ontdekking van de extra gevallen zal het debat over de oorzaak van de misvormingen en de uitzonderlijkheid ervan wellicht opnieuw aanzwengelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0b0ce6b-361d-44fb-b253-d3bee2f76280",
                        "source_entry_id": "4fd046b4-2002-3d54-8670-44ecf56e6712",
                        "source_sense_description": "quality of being exceptional",
                        "target_lang_word": "exceptionnalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exceptionnalité",
                                "target_lang_code": "fr",
