    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c74243dd-93bd-33d0-a173-090acb7ce4a0",
                    "sense_definition": "W tamtym czasie; w okresie, o którym mowa w danej wypowiedzi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miałem <w>wówczas</w> czternaście lat.",
                            "target_lang_translations": {
                                "ru": "Мне было <w>тогда</w> четырнадцать лет.",
                                "en": "I was fourteen years old <w>then</w>."
                            }
                        },
                        {
                            "text": "Byłem <w>wówczas</w> małym chłopcem, gdy ją po raz pierwszy zobaczyłem.",
                            "target_lang_translations": {
                                "ru": "Я был <w>тогда</w> маленьким мальчиком, когда впервые увидел её.",
                                "en": "I was a little boy <w>at that time</w> when I saw her for the first time."
                            }
                        }
                    ],
                    "synonyms": [
                        "wtedy",
                        "wtenczas",
                        "podówczas"
                    ],
                    "antonyms": [
                        "teraz",
                        "obecnie"
                    ],
                    "common_phrases": [
                        "wówczas gdy"
                    ],
                    "target_lang_definitions": {
                        "ru": "В то время; в период, о котором идет речь.",
                        "en": "At that time; during the period being spoken of."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тогда",
                                "target_lang_sense_clarification": "в то время"
                            },
                            {
                                "target_lang_word": "в то время",
                                "target_lang_sense_clarification": "в тот период"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "at that time"
                            },
                            {
                                "target_lang_word": "at that time",
                                "target_lang_sense_clarification": "during that past period"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c6614ef-9965-37f5-97b3-cbda950705e4",
                    "sense_definition": "W takim przypadku; jako skutek spełnienia określonego warunku.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conditional_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Porozmawiamy dopiero <w>wówczas</w>, gdy się uspokoisz.",
                            "target_lang_translations": {
                                "ru": "Мы поговорим только <w>тогда</w>, когда ты успокоишься.",
                                "en": "We will talk <w>only then</w>, when you calm down."
                            }
                        },
                        {
                            "text": "Wydam towar dopiero <w>wówczas</w>, gdy dostanę pieniądze.",
                            "target_lang_translations": {
                                "ru": "Я выдам товар только <w>тогда</w>, когда получу деньги.",
                                "en": "I will release the goods <w>only then</w>, when I receive the money."
                            }
                        },
                        {
                            "text": "Jeśli pociąg się spóźni, <w>wówczas</w> zadzwonię do ciebie z dworca.",
                            "target_lang_translations": {
                                "ru": "Если поезд опоздает, <w>тогда</w> я позвоню тебе с вокзала.",
                                "en": "If the train is delayed, <w>then</w> I will call you from the station."
                            }
                        }
                    ],
                    "synonyms": [
                        "wtedy"
                    ],
                    "common_phrases": [
                        "dopiero wówczas",
                        "a wówczas"
                    ],
                    "target_lang_definitions": {
                        "ru": "В таком случае; как следствие выполнения условия.",
                        "en": "In that case; under those circumstances or as a result of a condition being met."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тогда",
                                "target_lang_sense_clarification": "в таком случае"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "in that case or condition"
                            },
                            {
                                "target_lang_word": "only then",
                                "target_lang_sense_clarification": "not until that point"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}