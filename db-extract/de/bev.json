            {
                "entry_id": "02a6e98f-2ed8-3c96-9c95-c75678b7913b",
                "word": "BEV",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f5a4c59-e18a-36e9-8c0e-e241b1c2644d",
                        "entry_id": "02a6e98f-2ed8-3c96-9c95-c75678b7913b",
                        "glosses": [
                            "Bundesamt für Eich- und Vermessungswesen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "de06e0d6-8188-4da4-8ee8-602fb120194c",
                                "sense_id": "6f5a4c59-e18a-36e9-8c0e-e241b1c2644d",
                                "text": "Das BEV ist eine dem Bundesministerium für Wissenschaft, Forschung und Wirtschaft nachgeordnete Bundesbehörde mit den Aufgabenbereichen Vermessung und Geoinformation und Mess- und Eichwesen."
                            },
                            {
                                "example_id": "fa08d322-30f6-47aa-a5ac-ba1c64eff6cf",
                                "sense_id": "6f5a4c59-e18a-36e9-8c0e-e241b1c2644d",
                                "text": "In seiner Funktion als nationales Metrologieinstitut hält das BEV in der Gruppe Eichwesen die verbindlichen Nationalen Etalons (Messnormale) zur Darstellung der gesetzlichen Maßeinheiten bereit und stellt deren internationale Gleichwertigkeit sicher."
                            },
                            {
                                "example_id": "f2ea7499-1dbe-4473-89b2-45dde34caece",
                                "sense_id": "6f5a4c59-e18a-36e9-8c0e-e241b1c2644d",
                                "text": "Die Kontrollen, die das BEV als Eichbehörde auf dem Gebiet der Fertigpackungskontrolle und der Marktüberwachung durchführt, stärken den Konsumentenschutz und garantieren einen fairen wirtschaftlichen Wettbewerb."
                            },
                            {
                                "example_id": "623b9e35-ef90-4360-99ec-f962f4c616ec",
                                "sense_id": "6f5a4c59-e18a-36e9-8c0e-e241b1c2644d",
                                "text": "Die 34. Fachtagung der Vermessungsverwaltungen von Tschechien, Slowakei, Ungarn, Kroatien, Slowenien, Trentino, Südtirol, Friaul-Julisch Venetien und Österreich wurde am 18. und 19. Mai 2017 im BEV abgehalten."
                            },
                            {
                                "example_id": "dda61e70-bf15-4aea-aae0-9892c9ad10a3",
                                "sense_id": "6f5a4c59-e18a-36e9-8c0e-e241b1c2644d",
                                "text": "Bis heute sind es vor allem hochtechnische Anwendungen, die die ganz genaue Atomzeit direkt von der „Master Clock“ des BEV beziehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cd9f6576-14fc-317d-9aa3-4bf45664dffb",
                        "entry_id": "02a6e98f-2ed8-3c96-9c95-c75678b7913b",
                        "glosses": [
                            "Bundeseisenbahnvermögen"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "cbf054a2-6718-4419-8c3b-3469ad2a53be",
                                "sense_id": "cd9f6576-14fc-317d-9aa3-4bf45664dffb",
                                "text": "„Laut Verein sei der in einem vom BEV beauftragten Gutachten festgesetzte Verkehrswert von 1,7 auf mehr als sechs Millionen Euro gestiegen.“"
                            }
                        ],
