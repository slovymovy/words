                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e916ada-709e-4f02-ae21-23f896e5199b",
                                "sense_id": "087de590-ff32-39c5-9b45-4aaf5a07ef45",
                                "text": "J’voudrais bien jouer les gagne-petit, les pue-la-sueur, mais j’ai pas la vocation."
                            },
                            {
                                "example_id": "12b9994b-bfe3-481c-8c73-6b734386288f",
                                "sense_id": "087de590-ff32-39c5-9b45-4aaf5a07ef45",
                                "text": "Mais, à la veille du défilé, Michèle Biaggi, patronne des pue-la-sueur de la confédé, a annoncé que les manifestants prendraient le risque de sanctions."
                            }
                        ]
                    }
