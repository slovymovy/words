                                "target_senses": [
                                    {
                                        "sense_id": "a7699180-e16b-3cec-98d7-038f084719df",
                                        "entry_id": "1e174d7f-cbf4-3c75-8b42-70b6aa6e91c3",
                                        "glosses": [
                                            "A lumberjack shirt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a99e3c0-74a5-4b63-b8e0-24389550d263",
                                                "sense_id": "a7699180-e16b-3cec-98d7-038f084719df",
                                                "text": "As they approached they saw a man running up this track towards the road, a man in lumber jacket and dirty canvas trousers, a rough man, running clumsily up-hill, half foundered."
                                            },
                                            {
                                                "example_id": "71073e71-71a8-47fe-bf2c-bd8691a72431",
                                                "sense_id": "a7699180-e16b-3cec-98d7-038f084719df",
                                                "text": "He fished into the inside pocket of his lumber jacket and brought out a paper screw of sugar."
                                            },
                                            {
                                                "example_id": "f633ddf7-c907-4f32-ad4f-27353493922c",
                                                "sense_id": "a7699180-e16b-3cec-98d7-038f084719df",
                                                "text": "[…] swinging back up into the cab of the truck in my Levis and lumberjacket and moccasins (which out on the highway no longer seem the costume that they do in the halls of the high school) […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
