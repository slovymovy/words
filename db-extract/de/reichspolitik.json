                "senses": [
                    {
                        "sense_id": "48f1d53f-54b5-3f64-b178-c5908832fac4",
                        "entry_id": "23ff83fc-8d69-3a5d-8239-c2d376e672e3",
                        "glosses": [
                            "Gesamtheit der politischen Aktivitäten des/eines Reichs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d6207c-6e89-4b89-a18d-b2578c81fd2c",
                                "sense_id": "48f1d53f-54b5-3f64-b178-c5908832fac4",
                                "text": "„Seit den achtziger Jahren des 15. Jahrhunderts fand der Buchdruck im Rahmen der Reichspolitik zunehmend als ein effektives Medium politischer Kommunikation sowie als Mittel herrschaftlicher Repräsentation gezielt Verwendung.“"
                            },
                            {
                                "example_id": "9c5f4026-fc29-4ff2-9145-cd494dfbfd53",
                                "sense_id": "48f1d53f-54b5-3f64-b178-c5908832fac4",
                                "text": "„Er stand damit ganz in der Tradition safawidischer Reichspolitik, die er selbst unter Nader Schah kennengelernt hatte und bis ins kleinste Detail kopierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
