                        "cross_references": [
                            {
                                "target_word": "грузин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a388b95f-0e76-34b2-8ab2-21edd60b5311",
                                        "entry_id": "7a30b22b-11bf-317c-8243-a584663ae435",
                                        "glosses": [
                                            "представитель народа картвельской этноязыковой группы, составляющего коренное население Грузии, также житель, уроженец или гражданин Грузии либо потомок выходцев из этой страны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13784634-aff7-4e47-b54f-9f31b4be8e57",
                                                "sense_id": "a388b95f-0e76-34b2-8ab2-21edd60b5311",
                                                "text": "Так, грузины имеют свой национальный алфавит, освящённый более чем тысячелетней исторической традицией и прекрасно приспособленный к грузинскому языку .."
                                            },
                                            {
                                                "example_id": "0eddca14-3164-4cfb-af80-ef68c539fe1a",
                                                "sense_id": "a388b95f-0e76-34b2-8ab2-21edd60b5311",
                                                "text": "Феликс про себя отметил, что итальянцы не только внешне похожи на грузин, но и тосты у них такие же длинные и замысловатые."
                                            },
                                            {
                                                "example_id": "2d40a45b-cc86-40b0-a978-76892219daef",
                                                "sense_id": "a388b95f-0e76-34b2-8ab2-21edd60b5311",
                                                "text": "Задумчивый грузин на месть тебя ковал .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7821b161-23b2-329d-a053-87cd485c0170",
                                        "entry_id": "7a30b22b-11bf-317c-8243-a584663ae435",
                                        "glosses": [
                                            "перен., жарг. то же, что грузчик"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
