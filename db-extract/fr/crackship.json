                                        "examples": [
                                            {
                                                "example_id": "5689a607-e292-4ea7-b7b5-a93165806236",
                                                "sense_id": "f996e48e-eb75-3bad-825c-24957fde3a65",
                                                "text": "Moreover, in the more silly venues of fandom, some fans generate \"crack ships,\" or nonsensical couplings, such as sensing chemistry between Bonnie/A Rock."
                                            },
                                            {
                                                "example_id": "db3f38df-83f7-402f-9439-2e18be132a76",
                                                "sense_id": "f996e48e-eb75-3bad-825c-24957fde3a65",
                                                "text": "We carve out little fiefdoms with the common love of a middle-aged actress, and we march up the gangplank to board our favorite crackship."
                                            },
                                            {
                                                "example_id": "428d898c-334f-4e48-b56a-131e31515e7c",
                                                "sense_id": "f996e48e-eb75-3bad-825c-24957fde3a65",
                                                "text": "With rarepairs and crackships, it's the unlikeliness or even impossibility of their coming together that gets you going."
                                            }
