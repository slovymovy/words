{
    "word_family": [
        "rencontre",
        "rencontrable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "586dfb82-e620-3925-83a6-85f8b1b95e12",
                    "sense_definition": "Se trouver en présence de quelqu'un par hasard ou sur rendez-vous ; faire la connaissance d'une personne.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais <w>rencontrer</w> mes nouveaux voisins ce soir pour faire connaissance."
                        },
                        {
                            "text": "Elle a <w>rencontré</w> son futur mari lorsqu'ils étaient étudiants à l'université."
                        }
                    ],
                    "synonyms": [
                        "croiser",
                        "voir"
                    ],
                    "common_phrases": [
                        "rencontrer par hasard",
                        "rencontrer un ami",
                        "rencontrer quelqu'un"
                    ]
                },
                {
                    "sense_id": "0ff17edc-27d1-338e-9846-4d8c0a75817f",
                    "sense_definition": "Faire l'expérience de situations particulières, trouver devant soi des obstacles, des difficultés ou un accueil favorable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe commence à <w>rencontrer</w> des difficultés imprévues dans ce projet."
                        },
                        {
                            "text": "Ce nouveau roman a <w>rencontré</w> un très grand succès auprès du public."
                        }
                    ],
                    "synonyms": [
                        "éprouver",
                        "affronter"
                    ],
                    "common_phrases": [
                        "rencontrer des difficultés",
                        "rencontrer des obstacles",
                        "rencontrer du succès"
                    ]
                },
                {
                    "sense_id": "0bc8e4c7-deaa-3330-8efc-3b96e993390d",
                    "sense_definition": "Exister, être présent ou observable en certains endroits ou dans certaines circonstances.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante sauvage peut encore se <w>rencontrer</w> dans les sous-bois humides."
                        },
                        {
                            "text": "Une telle générosité ne se <w>rencontre</w> malheureusement pas tous les jours."
                        }
                    ],
                    "synonyms": [
                        "se trouver",
                        "exister"
                    ],
                    "common_phrases": [
                        "se rencontrer souvent"
                    ]
                },
                {
                    "sense_id": "62c76f25-7b9d-3b23-9ba0-8c721d4ddc1a",
                    "sense_definition": "Entrer en contact physique involontaire et brutal ; entrer en collision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux automobiles se sont <w>rencontrées</w> violemment à ce carrefour dangereux."
                        },
                        {
                            "text": "Le vélo et le scooter se sont <w>rencontrés</w> de plein fouet dans le virage."
                        }
                    ],
                    "synonyms": [
                        "se heurter",
                        "se percuter"
                    ]
                },
                {
                    "sense_id": "37859f2b-9d33-36d1-9947-e19908a6b073",
                    "sense_definition": "Avoir un ou plusieurs points communs, en parlant de lignes géométriques ou d'ensembles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette droite finit par <w>rencontrer</w> la parabole en deux points bien distincts."
                        },
                        {
                            "text": "Deux droites parallèles ne peuvent jamais se <w>rencontrer</w> dans un plan classique."
                        }
                    ],
                    "synonyms": [
                        "couper",
                        "intersecter"
                    ],
                    "common_phrases": [
                        "rencontrer la droite",
                        "rencontrer le plan"
                    ]
                },
                {
                    "sense_id": "c632f743-e06e-3f7b-a98e-3d4d40d42b2c",
                    "sense_definition": "Partager exactement le même avis, les mêmes idées ou la même inspiration.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous sommes <w>rencontrés</w> sur les solutions principales à adopter."
                        },
                        {
                            "text": "Comme dit le proverbe, les grands esprits se <w>rencontrent</w> toujours."
                        }
                    ],
                    "synonyms": [
                        "s'accorder",
                        "convenir"
                    ],
                    "common_phrases": [
                        "les beaux esprits se rencontrent"
                    ]
                }
            ]
        }
    ]
}