                ],
                "senses": [
                    {
                        "sense_id": "d30de798-6396-3c6f-a5fb-13dc79abc994",
                        "entry_id": "72c5f187-efd6-3ace-8b81-fce3c36cc403",
                        "glosses": [
                            "Personne qui est atteinte de rhumatisme, qui est sujette aux rhumatismes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd9fbec0-8a7a-4f4b-8e4c-eede7e9f1059",
                                "sense_id": "d30de798-6396-3c6f-a5fb-13dc79abc994",
                                "text": "Le rhumatisant évitera toute fatigue corporelle et tout excès de mouvement; il fuira les veilles et les excès alcooliques ou vénériens, pour suivre l’existence la plus régulière."
                            },
                            {
                                "example_id": "c7c70424-bc41-4e02-9fd8-24fcc805a423",
                                "sense_id": "d30de798-6396-3c6f-a5fb-13dc79abc994",
                                "text": "Le Dr Privat, passant par Paris, lui dit un jour : « Tu devrais venir me voir à Lamalou. On rencontre là de bizarres rhumatisants, qui t’intéresseraient sans doute vivement. »"
                            },
                            {
                                "example_id": "1d5b5dbe-5bb7-4c99-a577-23bd5889d61b",
                                "sense_id": "d30de798-6396-3c6f-a5fb-13dc79abc994",
                                "text": "Moins l'habit et la cornette, c'est une sœur de la charité qui pose des ventouses, des cataplasmes, applique des sinapismes, masse les rhumatisants, ensevelit les morts."
                            }
                        ]
                    }
