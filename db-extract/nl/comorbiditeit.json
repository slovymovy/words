                                "target_senses": [
                                    {
                                        "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                                        "glosses": [
                                            "The presence of one or more disorders (or diseases) in addition to a primary disease or disorder."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feb01312-b929-4823-8a38-6092de7a6328",
                                                "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                                "text": "Extensive comorbidity is the hallmark of immunodeficiencies."
                                            },
                                            {
                                                "example_id": "78a45686-9d1d-4171-ba66-2111788e2b84",
                                                "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                                "text": "The reported comorbidity between categorical personality disorders and OCD ranges between 33 and 87 percent (Bejerot et al, 1998)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                                        "glosses": [
                                            "A disease thus coexisting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a9e448-0f4e-4703-8919-4d4872a5da43",
                                                "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                                "text": "Coronary artery disease is often a comorbidity of diabetes mellitus."
                                            },
                                            {
                                                "example_id": "a667cd72-8ee3-451e-9c99-ee0e07042791",
                                                "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                                "text": "Yet in private conversations, members of his staff were also candid that the president has comorbidities that could make him more susceptible to a severe bout of the virus."
                                            }
                                        ]
                                    },
                                    {
