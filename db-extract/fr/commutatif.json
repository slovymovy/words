                                            "von Operationen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c56157d9-a379-440f-8b4a-4d339e525db0",
                                                "sense_id": "d6996e7c-54b6-3248-b5fe-2448b0a08c38",
                                                "text": "Addition und Multiplikation zweier Zahlen sind kommutative Operationen."
                                            },
                                            {
                                                "example_id": "d2add95e-c717-4f62-a5be-7d91e4a6bef6",
                                                "sense_id": "d6996e7c-54b6-3248-b5fe-2448b0a08c38",
                                                "text": "Die Potenz ist nicht kommutativ, denn 2³ ist 8, aber 3² ist 9."
                                            }
