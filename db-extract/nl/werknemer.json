                        "examples": [
                            {
                                "example_id": "423c0350-1ca6-4160-b34d-1da70dd95a12",
                                "sense_id": "7c93003f-5f10-3c0b-be36-3dfa479a380a",
                                "text": "De werknemer heeft recht op vakantiedagen.",
                                "translation": "The employee is entitled to vacation days.",
                                "english": "The employee is entitled to vacation days."
                            },
                            {
                                "example_id": "bb9d85cd-d99e-4d80-85eb-65c4343bf904",
                                "sense_id": "7c93003f-5f10-3c0b-be36-3dfa479a380a",
                                "text": "De rechten van de werknemers worden beschermd door de wet.",
                                "translation": "The rights of the employees are protected by the law.",
                                "english": "The rights of the employees are protected by the law."
                            },
                            {
                                "example_id": "bd7e53af-afce-486f-85ed-c7a393f00068",
                                "sense_id": "7c93003f-5f10-3c0b-be36-3dfa479a380a",
                                "text": "De nieuwe wet voorziet in betere bescherming voor werkneemsters tijdens zwangerschap.",
                                "translation": "The new law provides better protection for female employees during pregnancy.",
                                "english": "The new law provides better protection for female employees during pregnancy."
                            }
                        ]
                    }
