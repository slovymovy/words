                                "example_id": "bd41957e-bd9e-40e6-9668-901621e96e94",
                                "sense_id": "61262286-3851-3bae-a5c0-57011570f246",
                                "text": "La reine Margrethe de Danemark vient d'inaugurer une nouvelle attraction à Copenhague : le lapidarium des rois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
