                        "examples": [
                            {
                                "example_id": "860daa64-6c26-462b-91d8-33492c8af05f",
                                "sense_id": "96f210ce-538f-32d0-b22d-b8f243a33bca",
                                "text": "и был тако́в",
                                "translation": "我走了/他走了/就這樣走了"
                            },
                            {
                                "example_id": "224e13e3-8be8-436f-8a9b-b502b66014fe",
                                "sense_id": "96f210ce-538f-32d0-b22d-b8f243a33bca",
                                "text": "Все́ ко́шки таковы́.",
                                "translation": "所有貓都是這樣的。"
                            },
                            {
                                "example_id": "aae6a39d-b8a4-4f20-8a0e-8603ea30e280",
                                "sense_id": "96f210ce-538f-32d0-b22d-b8f243a33bca",
                                "text": "Вопро́с тако́в: заче́м они́ э́то де́лают?",
                                "translation": "問題是，他們為什麼要這樣做？"
                            },
                            {
                                "example_id": "42e0db4b-3c21-444d-819a-00e95df7cbed",
                                "sense_id": "96f210ce-538f-32d0-b22d-b8f243a33bca",
                                "text": "Таковы́ фа́кты.",
                                "translation": "事實就是這樣。"
                            }
                        ]
                    },
                    {
                        "sense_id": "6a499498-1c66-3c7e-a3bc-b96c1ce90747",
                        "entry_id": "f012c9f3-2c56-3e78-9240-c207bb16c08f",
                        "glosses": [
                            "就是這樣"
                        ],
                        "tags": [
                            "緊接在что (što)開頭的分句前"
                        ],
                        "examples": [
                            {
                                "example_id": "36e45223-068d-4a9a-aca6-d17629d53e2a",
                                "sense_id": "6a499498-1c66-3c7e-a3bc-b96c1ce90747",
                                "text": "Ситуа́ция такова́, что э́то невозмо́жно.",
                                "translation": "情況如此，這是不可能的。"
                            }
                        ]
                    },
                    {
                        "sense_id": "de9aca83-eb4b-3a40-b1d2-a7551dc5a770",
                        "entry_id": "f012c9f3-2c56-3e78-9240-c207bb16c08f",
                        "glosses": [
                            "如"
                        ],
                        "tags": [
                            "緊接在како́в (kakóv)、како́й (kakój)、как (kak)開頭的分句前"
                        ],
                        "examples": [
                            {
                                "example_id": "e837f9f2-1225-4f3d-829f-270226209ee3",
                                "sense_id": "de9aca83-eb4b-3a40-b1d2-a7551dc5a770",
                                "text": "Фа́кты таковы́, как я их изложи́л.",
                                "translation": "事實正如我所陳述的那樣。"
                            },
                            {
                                "example_id": "17c65330-2aff-405c-a0ec-9a4154100ab9",
                                "sense_id": "de9aca83-eb4b-3a40-b1d2-a7551dc5a770",
                                "text": "Мир тако́в, како́в он есть.",
                                "translation": "世界就是這樣。"
                            }
                        ]
                    }
