    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6f1f5f27-e6cf-37bb-b8db-81b39ad3d001",
                "word": "petrol",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6f840754-f1f5-43e5-97a5-80816e6f1a10",
                        "entry_id": "6f1f5f27-e6cf-37bb-b8db-81b39ad3d001",
                        "tags": [
                            "plural"
                        ],
                        "form": "petrols"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                        "entry_id": "6f1f5f27-e6cf-37bb-b8db-81b39ad3d001",
                        "glosses": [
                            "A fluid consisting of a mixture of refined petroleum hydrocarbons, primarily consisting of octane, commonly used as a motor fuel."
                        ],
                        "tags": [
                            "Commonwealth",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "31266204-23a1-4c17-900e-eb934653151a",
                                "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                                "text": "1987 October 29, Advertisement, New Scientist, page 31,\nWe were the first company to introduce unleaded petrol in Britain, opening our first pump in June 1986."
                            },
                            {
                                "example_id": "5ba30e8d-d257-4125-9015-7d6e9487e15f",
                                "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                                "text": "2000 September 27, Congressional Record: Proceedings and Debates of the 106th Congress, Second Session, Volume 146, Part 14, page 19605,\nEuropean oil firms are beginning to follow the example of their American counterparts by adding convenience stores to their pumps: the typical American petrol station now makes some 40 percent of its profits from the sale of non-oil products, such as cigarettes and beer."
                            },
                            {
                                "example_id": "fa116a5a-e7f5-4d95-9fa1-22c049cf803a",
                                "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                                "text": "2003, S. Srinivasan, Automotive Mechanics, Tata McGraw Hill, India, 2nd Edition, page 149,\nAt a crank angle 6° before the TDC, the electric spark ignites the petrol mixture."
                            },
                            {
                                "example_id": "26f8d413-6fe6-4385-b5a1-c1f1f3ec7005",
                                "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                                "text": "He also admitted that when big trucks bring in petrol, they park along Langata Road[…]."
                            },
                            {
                                "example_id": "5e7c0c37-6458-441a-896b-6c2212eb8c88",
                                "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                                "text": "2006 August, Economic Scenario, Pratiyogita Darpan, page 218,\nThe increase in rates comes just a few days after India raised petrol prices by 9-2% and diesel prices by 6-6% which boosed inflation expectations in Indian economy."
                            },
                            {
                                "example_id": "44389e63-8f27-4044-ab6b-8c3920ccf83d",
                                "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                                "text": "2008, Robin Stonecash, Joshua Gans, Stephen King, Gregory Mankiw, Principles of Macroeconomics, Cengage Learning Australia, page 122,\nMost major Australian cities receive their petrol from a single refinery."
                            }
                        ]
                    },
                    {
                        "sense_id": "067ac279-189e-3456-b399-ec0a826dc45f",
                        "entry_id": "6f1f5f27-e6cf-37bb-b8db-81b39ad3d001",
                        "glosses": [
                            "A motor vehicle powered by petrol (as opposed to diesel)."
                        ],
                        "tags": [
                            "informal",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "507e47a1-40d6-48ce-a7ed-bfc71c47a767",
                                "sense_id": "067ac279-189e-3456-b399-ec0a826dc45f",
                                "text": "However, I do feel entitled to criticise the car. There are lots of different versions: manuals and automatics; petrols and diesels; two-wheel drives and four-wheel drives, and it's possible to spend thirty grand on one."
                            }
                        ]
                    }
                ],
