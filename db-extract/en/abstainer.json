                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3741527c-7028-3d7b-b9e3-1a6eb1464f9f",
                        "entry_id": "a4d8996c-d909-3636-82b7-0e424ccde525",
                        "glosses": [
                            "Person, die bewusst auf etwas verzichtet, das als unangemessen oder ungesund gilt (zum Beispiel das Trinken alkoholischer Getränke): Abstinenzler, Abstinenzlerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17c167d-d6d6-4895-9f13-51ba3856edf5",
                                "sense_id": "3741527c-7028-3d7b-b9e3-1a6eb1464f9f",
                                "text": "The former alcoholic became a total abstainer.",
                                "translation": "Der frühere Alkoholiker wurde ein Abstinenzler."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11c0ada3-eee8-4693-80a5-a278f88acb11",
                        "source_entry_id": "a4d8996c-d909-3636-82b7-0e424ccde525",
                        "source_sense_id": "3741527c-7028-3d7b-b9e3-1a6eb1464f9f",
                        "source_sense_description": "Person, die bewusst auf etwas verzichtet",
                        "target_lang_word": "Abstinenzler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstinenzler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                        "entry_id": "74ea0cbf-e6b9-3377-8537-dd17c6c06890",
                                        "glosses": [
                                            "Person, die prinzipiell keinen Alkohol trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6394e07f-c8d6-4acf-a8ca-40ec0373be36",
                                                "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                                "text": "Für einen überzeugten Abstinenzler sind Erscheinungen wie das Koma-Saufen völlig unverständlich."
                                            },
                                            {
                                                "example_id": "0d5781c0-19b1-479d-bc59-181d6d92a7a6",
                                                "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                                "text": "„Der Präsident bestellte noch eine Runde Bier, bemerkte aber leicht gereizt, eine Person, die in betrunkenem Zustand nukleare Geheimnisse ausplauderte, sollte vielleicht erwägen, unter die Abstinenzler zu gehen.“"
                                            },
                                            {
                                                "example_id": "93381a1f-bee3-40ba-a48b-9b328687ce45",
                                                "sense_id": "c08574a3-bf74-384a-8720-5104e767b7b7",
                                                "text": "„Angeblich war der für das Palais zuständige Marschall Abstinenzler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
