                        "glosses": [
                            "страд. к закинуть"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f73550f-1c11-493e-ab1e-8629e62cf0f3",
                                "sense_id": "3e880001-2d8b-3c09-9631-95519bb675f9",
                                "text": "Худшим наказанием для коней является осаживание, а потому если он намеревается закинуться на препятствие, то никогда нельзя делать поворота, а надо осаживать до тех пор, пока сам конь не предпочтет идти вперед."
                            }
                        ]
                    },
                    {
                        "sense_id": "329d5f38-5bd6-3127-a2c5-272de0607d76",
                        "entry_id": "0c647652-1dc1-3ec5-b2bc-04fcbe0c9b65",
                        "glosses": [
                            "сленг, жарг. нарк. принять наркотик внутрь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63fdf8a5-5600-4684-8b00-d014b150eccc",
                                "sense_id": "329d5f38-5bd6-3127-a2c5-272de0607d76",
                                "text": "Позавчера кислотой закинулись, так, кажется до сих пор ещё не отошли."
                            }
                        ]
                    }
