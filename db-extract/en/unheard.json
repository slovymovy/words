    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6ed13e53-3282-36d3-921a-724001289455",
                "word": "unheard",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "58eea86f-d8c9-343b-bc46-8652c3594e76",
                        "entry_id": "6ed13e53-3282-36d3-921a-724001289455",
                        "glosses": [
                            "Not heard."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1001ee33-90a9-4801-9904-28bd475971e0",
                                "sense_id": "58eea86f-d8c9-343b-bc46-8652c3594e76",
                                "text": "Her cries for help remained unheard."
                            },
                            {
                                "example_id": "05b965fa-407b-4a9d-a530-cfb0b5e0fdc6",
                                "sense_id": "58eea86f-d8c9-343b-bc46-8652c3594e76",
                                "text": "When night had fallen, the she-demon stole forth toward the hall, which she entered unheard and unseen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab800b23-bbae-3897-a423-1766bef28da3",
                        "entry_id": "6ed13e53-3282-36d3-921a-724001289455",
                        "glosses": [
                            "Not listened to."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "74ee9c1e-3415-49d5-b228-fa5685ca5029",
                                "sense_id": "ab800b23-bbae-3897-a423-1766bef28da3",
                                "text": "c. 1693?, John Dryden, Amaryllis\nWhat pangs I feel, unpitied and unheard!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e9a85f5b-bf6e-3ae3-97a1-40ad8270f0fe",
                        "entry_id": "6ed13e53-3282-36d3-921a-724001289455",
                        "glosses": [
                            "Not known to fame; not illustrious or celebrated; obscure."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c71aac-7629-409c-b368-ca4d360ca2ee",
                                "sense_id": "e9a85f5b-bf6e-3ae3-97a1-40ad8270f0fe",
                                "text": "Nor was his name unheard or unadored."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9da8126e-dac0-4894-83ef-7eeb3fa5904a",
                        "source_entry_id": "6ed13e53-3282-36d3-921a-724001289455",
                        "source_sense_description": "not heard",
                        "target_lang_word": "non écouté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7496299e-cbdb-4899-9c29-ac2298358495",
                        "source_entry_id": "6ed13e53-3282-36d3-921a-724001289455",
                        "source_sense_description": "not heard",
                        "target_lang_word": "non entendu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1ad30eaf-885e-43eb-8331-b2643d1b4df4",
                        "source_entry_id": "6ed13e53-3282-36d3-921a-724001289455",
                        "source_sense_description": "not heard",
                        "target_lang_word": "inouï",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inouï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e9b8397-5671-3abb-b736-e454af54cf8d",
                                        "entry_id": "8c476d9a-537f-34dd-926f-40ed5df7905e",
                                        "glosses": [
                                            "Qu’on n’a pas ouï."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895fce5d-9bb1-44b7-960f-7106546f0387",
                                                "sense_id": "9e9b8397-5671-3abb-b736-e454af54cf8d",
                                                "text": "[…] que faudra-t-il croire de cet amas de dogmes inouïs aux schismatiques, même les plus audacieux de toute l’antiquité ?"
                                            },
                                            {
                                                "example_id": "a3990d87-9159-492a-81d1-1766afd85a9e",
                                                "sense_id": "9e9b8397-5671-3abb-b736-e454af54cf8d",
                                                "text": "Cette façon de parler est sans doute de quelque province de France ; car elle est inouïe à la cour, et même il ne me souvient pas de l’avoir ouï dire dans les villes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                        "entry_id": "8c476d9a-537f-34dd-926f-40ed5df7905e",
                                        "glosses": [
                                            "Dont on n’a jamais parlé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d28436d2-a1f8-49dd-b248-55f5c8ac889d",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Que, lorsqu’il n’y avait point d’exemple de quelque chose, il en fallait faire ; que ce qui était inouï ne le serait plus quand il serait fait."
                                            },
                                            {
                                                "example_id": "af53101b-3c91-45a1-a0ce-b2e6582a1c2b",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Il est beau de tenter des choses inouïes."
                                            },
                                            {
                                                "example_id": "dcdac85a-8542-4bba-86b8-4c5a46ac2c5c",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Et qui croira qu’un cœur si grand en apparence […] Trame une perfidie inouïe à la cour ?"
                                            },
                                            {
                                                "example_id": "66013ced-2d19-4b27-899a-23011ae5192b",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Le prix est sans doute inouï, Jamais d’un tel honneur un sujet n’a joui."
                                            },
                                            {
                                                "example_id": "5e6868b7-e17e-4675-928e-d8a1b66d47c3",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Est-ce donc un prodige inouï parmi nous ?"
                                            },
                                            {
                                                "example_id": "e602133d-c5af-4dc3-8897-38ac6eaf23cf",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Les grands et le peuple lui rendent des honneurs jusque-là inouïs."
                                            },
                                            {
                                                "example_id": "c3717ba9-98cd-4ce9-b96b-7311de91c614",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Ah ! quels noms inouïs lui donnez-vous, seigneur !"
                                            },
                                            {
                                                "example_id": "2445ba72-a091-4cc6-b409-a90af6279057",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "Le czar, se réservant pour tous domestiques un valet de chambre, un homme de livrée et un nain, se confondait dans la foule ; c’était une chose inouïe dans l’histoire du monde, qu’un roi de vingt-cinq ans qui abandonnait ses royaumes pour mieux régner."
                                            },
                                            {
                                                "example_id": "442f0595-9313-418e-848f-435fc75b0d9b",
                                                "sense_id": "934f31e4-9b63-3ad9-be1e-14878196f11c",
                                                "text": "L’appareil inouï pour ces mortels nouveaux De nos châteaux ailés qui volaient sur les eaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                        "entry_id": "8c476d9a-537f-34dd-926f-40ed5df7905e",
                                        "glosses": [
                                            "Extraordinaire ; exceptionnel ; incroyable."
                                        ],
                                        "tags": [
                                            "Aujourd’hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7973228c-0b80-4a55-ac11-113f97ba435a",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "Douce soirée où l’on pouvait encore croire — à la rigueur, le calcul des probabilités cédant à une chance inouïe — qu’il n’y aurait pas de morts pendant la guerre."
                                            },
                                            {
                                                "example_id": "a36c6fa7-4a13-4175-8f3d-b110fde44c78",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "Les rafales d’une violence inouïe, accès de colère de Wottan ou de Thor, tombent des hauteurs en sifflant et soulèvent des tourbillons d’embruns qui sillonnent la mer."
                                            },
                                            {
                                                "example_id": "88281ac4-f367-4aec-9482-b2f0452248d9",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "Après des travaux inouïs couronnés par le succès, il vint, vers la onzième année, se faire réhabiliter à Nantes en laissant son fils aîné à la tête de sa maison transatlantique."
                                            },
                                            {
                                                "example_id": "2a09f6e7-4c98-4569-8cec-80880edda754",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "En pleine mer, des bâtiments sombrèrent, ou, désemparés par la tempête, n’échappèrent au naufrage que par des efforts inouïs."
                                            },
                                            {
                                                "example_id": "db81223b-9091-4a06-9742-55e79c326aae",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "Les saints martyrs de Lyon et de Vienne endurèrent des supplices inouïs."
                                            },
                                            {
                                                "example_id": "41bb4d34-9f7d-4c09-b193-d3af1744ba43",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "Les infortunes inouïes d’une si grande reine."
                                            },
                                            {
                                                "example_id": "2b51e7fd-f61b-466b-a383-26f04d7bf462",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "Ah ! sentence ! ah, rigueur inouïe !"
                                            },
                                            {
                                                "example_id": "33b74c4a-47ba-4aa6-8571-cee0d880a056",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "Fortune dont la main couronne\nLes forfaits les plus inouïs."
                                            },
                                            {
                                                "example_id": "8e3139fd-1edd-4461-87be-c15222a246a9",
                                                "sense_id": "a08f2795-201a-375b-b424-c1b89e356d09",
                                                "text": "La jalousie entre ces deux chefs et l’absence du czar furent en partie cause de la défaite inouïe de Nerva."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inouï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64dcd092-0e86-363c-9ed4-9741e276fd78",
                                        "entry_id": "85466d71-e6e1-39c1-b4c6-88cde9e8acc2",
                                        "glosses": [
                                            "Participe passé masculin singulier de inouïr."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
