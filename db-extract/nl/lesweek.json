                        "examples": [
                            {
                                "example_id": "852e6a9c-47d2-4842-80ff-df722a8abe01",
                                "sense_id": "64892650-0581-3239-9856-2ed4d06034d3",
                                "text": "Kaliber Kunstenschool houdt van maandag 25- tot en met vrijdag 29 september een open lesweek in haar onderkomen in multifunctioneel centrum De Holtink aan de Mensinkweg."
                            },
                            {
                                "example_id": "cdd9e2d9-a831-4fad-ba6f-e663668a00b6",
                                "sense_id": "64892650-0581-3239-9856-2ed4d06034d3",
                                "text": "De vakantie staat voor de deur, de sfeer is ongedwongen en staat het toe om verhalen te mogen horen die tijdens een drukke lesweek vaak onder het oppervlak blijven. Soms komt een vader of moeder mee. Of een opa. We hebben allen indirect een band met elkaar. We zijn op een of andere manier verbonden en bij elkaar gebracht, op dit moment in dit lokaal."
                            }
                        ]
