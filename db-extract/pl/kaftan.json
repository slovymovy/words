                        ]
                    },
                    {
                        "translation_id": "dfe62965-e30e-41d4-b4f7-9860c0a1a1e9",
                        "source_entry_id": "0ac0f1b1-69ff-3763-9177-0bd9c1f7b32b",
                        "source_sense_id": "97bd1e15-521e-3c33-acd6-18bd61f8499b",
                        "target_lang_word": "caftán",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caftán",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "498b9d3a-61a0-39c3-b02d-866c48d6e6b4",
                                        "entry_id": "8bb287dd-aab5-3427-b978-d80292d43502",
                                        "glosses": [
                                            "Túnica larga con mangas, usalmente acompañada de una faja, de origen persa y tradicionalmente usada en Medio Oriente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f919968-95d7-4962-a965-0d7fff34e025",
                                                "sense_id": "498b9d3a-61a0-39c3-b02d-866c48d6e6b4",
                                                "text": "de frac visten todos los pueblos cristianos, y cuando el Sultán de Turquía Abdul-Medjil quiere introducir la civilización europea en sus estados, depone el turbante, el caftán y las bombachas, para vestir frac, pantalón y corbata."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "549add5c-bd4d-3e1a-b46f-cf53b520bf81",
                                        "entry_id": "8bb287dd-aab5-3427-b978-d80292d43502",
                                        "glosses": [
                                            "Prenda de abrigo similar a un caftán₁ usada tradicionalmente en los países eslavos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c6f71f2-89cd-4e8b-8d54-0e8f919bb33b",
                                                "sense_id": "549add5c-bd4d-3e1a-b46f-cf53b520bf81",
                                                "text": "Bastante gente á pie, pero silenciosa y envuelta en sus prolongadísimos caftanes. El hombre del pueblo lleva el caftán ceñido á la cintura con una faja de un color vivo, botas de pieles ó un género de calzado singular, que creo que se llama lapti, y en la cabeza una especie de acerico ó almohadilla, tan desaforada á veces, que casi puede servir de almohada. Este es el traje de la Gran Rusia, y también le usan los cocheros."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9efc08d4-7cf0-476e-86e1-3e1af6ad32b1",
                        "source_entry_id": "0ac0f1b1-69ff-3763-9177-0bd9c1f7b32b",
                        "source_sense_id": "97bd1e15-521e-3c33-acd6-18bd61f8499b",
                        "target_lang_word": "Kaftan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaftan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19cd08c0-058a-38df-a25c-cce2624ae6da",
                                        "entry_id": "e9909682-f4af-330d-afdd-405ac49918a7",
                                        "glosses": [
                                            "lang- und weitärmliges orientalisches Obergewand, das mit einem langen Band über Schulter und Brust oder mit Knöpfchen über der Brust geschlossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abbf3fef-ab48-44d3-bc8e-2e2bca3f3d4b",
                                                "sense_id": "19cd08c0-058a-38df-a25c-cce2624ae6da",
                                                "text": "In großen Teilen der Welt ist der Kaftan noch immer das übliche Gewand für Männer."
                                            },
                                            {
                                                "example_id": "f7387279-7a37-45f1-8ebf-a1c66f9ad1cd",
                                                "sense_id": "19cd08c0-058a-38df-a25c-cce2624ae6da",
                                                "text": "„Unter der Kapuze des alten Kaftans sieht er nicht wie der reichste Mann der Welt, sondern wie ein niederer Palastdiener der Nachtschicht aus, der jetzt nach Hause will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                        "entry_id": "e9909682-f4af-330d-afdd-405ac49918a7",
                                        "glosses": [
                                            "langes, enges, vorn geknöpftes orientalisches Obergewand, das früher in Osteuropa Bestandteil der Tracht orthodoxer Juden war"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a7f7ac-d516-4242-95ef-c32c25b2ac3d",
                                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                                "text": "„Samuels Mischpoke kommt mit Kaftan und Gebetsriemen leicht überzeichnet daher; es gibt Zores über die Frage, ob man am Sabbat telefonieren darf; am Ende entscheidet der Rabbi.“"
                                            },
                                            {
                                                "example_id": "c640ff12-2f27-4337-9a2a-c89173895e44",
                                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                                "text": "„Die Juden waren überwiegend orthodox, aber auch liberale Ideen begannen sich langsam durchzusetzen. Kaftan, Bart, Schläfenlocken und Gebetskäppchen wurden allmählich durch polnische oder westliche Kleidung ersetzt.“"
                                            },
                                            {
                                                "example_id": "0e788ea9-8920-4497-98d3-dbe84c720fd4",
                                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                                "text": "„In den Läden standen langbärtige Juden herum, in langen Kaftanen und derben Stiefeln.“"
                                            },
                                            {
                                                "example_id": "086ac522-404c-4de9-ab29-8e4c76c33dde",
                                                "sense_id": "0a733402-393e-3f70-9b42-a75027aca4d3",
                                                "text": "„Sie tragen Kaftane von schwarzem Seidenatlas mit gold- und silberbeschlagenen Gürteln.“"
