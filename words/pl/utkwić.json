{
    "word_family": [
        "tkwić",
        "utkwienie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e337b1a-b55b-3556-b65b-e0376337e29f",
                    "sense_definition": "znaleźć się w miejscu, z którego nie można się wydostać lub w którym coś utknęło",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "utknięcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Klucz <w>utkwił</w> w zamku i nie dało się go wyciągnąć.",
                            "target_lang_translations": {
                                "ru": "Ключ <w>застрял</w> в замке, и его невозможно было вытащить."
                            }
                        },
                        {
                            "text": "Samochód <w>utkwił</w> w głębokim błocie na środku drogi.",
                            "target_lang_translations": {
                                "ru": "Машина <w>застряла</w> в глубокой грязи посреди дороги."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaklinować się",
                        "zablokować się"
                    ],
                    "common_phrases": [
                        "utkwić w błocie",
                        "utkwić w korku"
                    ],
                    "target_lang_definitions": {
                        "ru": "оказаться в месте, из которого невозможно выбраться, или застрять где-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застрять",
                                "target_lang_sense_clarification": "оказаться в ловушке или заблокированным в чем-либо"
                            },
                            {
                                "target_lang_word": "заклинить",
                                "target_lang_sense_clarification": "о предмете, который перестал двигаться в механизме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a987b6cb-52e2-3c94-9c5d-01c1fefabb27",
                    "sense_definition": "skupić wzrok na czymś, wpatrzyć się w coś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wzrok",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczyna <w>utkwiła</w> wzrok w dalekim horyzoncie.",
                            "target_lang_translations": {
                                "ru": "Девушка <w>устремила</w> взгляд на далекий горизонт."
                            }
                        },
                        {
                            "text": "Dziecko <w>utkwiło</w> oczy w kolorowej zabawce.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>уставился</w> глазами на яркую игрушку."
                            }
                        }
                    ],
                    "synonyms": [
                        "wpatrzyć się"
                    ],
                    "common_phrases": [
                        "utkwić wzrok"
                    ],
                    "target_lang_definitions": {
                        "ru": "пристально смотреть на что-либо, уставиться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уставиться",
                                "target_lang_sense_clarification": "пристально или неподвижно смотреть на что-то"
                            },
                            {
                                "target_lang_word": "устремить",
                                "target_lang_sense_clarification": "направить взгляд на объект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}