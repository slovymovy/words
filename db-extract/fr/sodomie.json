                                        "sense_id": "6a0f2053-0b3d-372b-8f68-58103a2f95cc",
                                        "entry_id": "d764f2a1-81f2-328e-ba90-4435578b829a",
                                        "glosses": [
                                            "Analverkehr (Variante des Geschlechtsverkehrs, bei der der Penis in den After des Partners oder der Partnerin eingeführt wird)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
