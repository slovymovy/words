                "senses": [
                    {
                        "sense_id": "e8cae528-3eb4-38bd-81cc-4c4a5496c028",
                        "entry_id": "b965d512-d382-3ebf-8827-197d5eee33d2",
                        "glosses": [
                            "ein Bauwerk, das als Denkmal (für frühere Baukunst) fungiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d8cb42-7294-494b-b78b-803243eafb04",
                                "sense_id": "e8cae528-3eb4-38bd-81cc-4c4a5496c028",
                                "text": "„Das bedeutendste Baudenkmal auf thailändischem Boden ist Phimai, das die Khmer Ende des 11. Jahrhunderts im Stil Angkor Vats erbauten.“"
                            },
                            {
                                "example_id": "fa9e7ce5-da88-461e-b92d-0f42a6a7b609",
                                "sense_id": "e8cae528-3eb4-38bd-81cc-4c4a5496c028",
                                "text": "„Das bedeutendste Baudenkmal ist die St.-Petri-Kirche, das Wahrzeichen der Stadt. “"
                            },
                            {
                                "example_id": "30f2cbd4-67f0-4209-b63c-5a8cb2fe7bec",
                                "sense_id": "e8cae528-3eb4-38bd-81cc-4c4a5496c028",
                                "text": "„Der Stephansdom, Wahrzeichen Wiens und zugleich Österreichs bedeutendstes gotisches Baudenkmal, bildet den Mittelpunkt der Wiener Altstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
