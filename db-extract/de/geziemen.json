                "senses": [
                    {
                        "sense_id": "89148987-54d7-34ad-afd4-c7e8193c1416",
                        "entry_id": "2081aafe-f8c4-361f-beeb-f33c1d0688c4",
                        "glosses": [
                            "den Sitten, den Regeln des Anstands entsprechen"
                        ],
                        "tags": [
                            "outdated",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "85672bc7-7a7d-41b5-b4cd-064ae43fcf79",
                                "sense_id": "89148987-54d7-34ad-afd4-c7e8193c1416",
                                "text": "Die jungen Mädchen saßen scheu auf ihren Stühlen, wie es sich geziemt."
                            },
                            {
                                "example_id": "9f7ce11d-4446-46d5-b75c-283ea58befc5",
                                "sense_id": "89148987-54d7-34ad-afd4-c7e8193c1416",
                                "text": "Ein solches Benehmen geziemt sich nicht für einen Mann deines Standes."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c668976-11db-4891-9fce-54584f9e1c83",
