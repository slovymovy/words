                        "examples": [
                            {
                                "example_id": "25fcef5b-1258-4f42-8ad6-dd3bdfce8f99",
                                "sense_id": "8e9d1705-66d4-39e3-8ece-99f968aefe87",
                                "text": "Even was er een benauwd moment bij de landing van Curiosity voor Inge Loes ten Kate, onderzoekster van de Universiteit Utrecht. De met gejuich ontvangen mededeling dat er data van de Marswagen binnenkwamen, werd meteen weer tegengesproken. Het werd heel stil in het vluchtleidingscentrum."
                            },
                            {
                                "example_id": "7f2ed3db-6a74-422a-8d99-e047fa897dab",
                                "sense_id": "8e9d1705-66d4-39e3-8ece-99f968aefe87",
                                "text": "De medewerkers van het vluchtleidingscentrum in Houston blijven aan de slag om de twee landgenoten in het internationale ruimtestation bij te staan. De rest van de NASA gaat op slot. Mars-rover Curiosity is in 'protective mode' gezet en opgehouden met het verzamelen en verzenden van data."
                            }
                        ]
                    }
