                },
                {
                    "sense_id": "f4687c85-fca4-301d-af0c-484a7f774878",
                    "sense_definition": "Impressive by reason of grandeur, beauty, or power; magnificent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal family lives in a <w>splendid</w> palace on the hill.",
                            "target_lang_translations": {
                                "ru": "Королевская семья живет в <w>великолепном</w> дворце на холме.",
                                "nl": "De koninklijke familie woont in een <w>prachtig</w> paleis op de heuvel."
                            }
                        },
                        {
                            "text": "We hiked up the mountain to see the <w>splendid</w> view of the valley.",
                            "target_lang_translations": {
                                "ru": "Мы поднялись на гору, чтобы увидеть <w>великолепный</w> вид на долину.",
                                "nl": "We wandelden de berg op om het <w>schitterende</w> uitzicht over de vallei te zien."
                            }
                        }
                    ],
                    "synonyms": [
