                    "frequency": "Middle",
                    "semantic_group_id": "passenger_or_guest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The buffet dinner will cost forty dollars per <w>pax</w>.",
                            "target_lang_translations": {
                                "zh": "自助晚餐的价格为每<w>位</w>四十美元。"
                            }
                        },
                        {
                            "text": "Please confirm the exact number of <w>pax</w> for the banquet.",
                            "target_lang_translations": {
                                "zh": "请确认宴会的确切<w>人数</w>。"
                            }
                        }
