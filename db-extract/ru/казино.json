                        "translation_id": "c9ad2dbc-aea0-42ef-9a2c-06d00fc680eb",
                        "source_entry_id": "0ee55948-92bb-3b64-9617-cb2d57666097",
                        "source_sense_id": "bf1ec94f-45a4-38da-9d3b-f449c6e2d5dd",
