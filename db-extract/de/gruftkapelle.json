                "senses": [
                    {
                        "sense_id": "a321acb0-3d94-3001-9b1a-d3bb06c9f19d",
                        "entry_id": "3e2aa9e4-aedc-3e4a-9592-c90ad15798f1",
                        "glosses": [
                            "Kapellenbau über oder mit integrierter Grabstätte, der nicht für regelmäßige Gottesdienste einer Gemeinde dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0436cda-fc23-459d-b7c5-fb0cc37815cf",
                                "sense_id": "a321acb0-3d94-3001-9b1a-d3bb06c9f19d",
                                "text": "„Die Klausner Gruftkapelle gehört zum Bereich der Pfarrkirche.“"
                            },
                            {
                                "example_id": "2d2fb263-dd33-457c-a669-f685f214c434",
                                "sense_id": "a321acb0-3d94-3001-9b1a-d3bb06c9f19d",
                                "text": "„Hoch über dem Elsavatal, ist die Gruftkapelle St. Maria schon von weithin sichtbar.“"
                            },
                            {
                                "example_id": "243078a1-4ee4-47a7-a680-25222c8e3579",
                                "sense_id": "a321acb0-3d94-3001-9b1a-d3bb06c9f19d",
                                "text": "„Die neue Gruftkapelle wurde gleichzeitig mit der Franz Josephs Gruft im Auftrag Kaiser Franz Josephs errichtet.“"
                            },
                            {
                                "example_id": "1c29a834-dece-4abe-884b-97f9871dabcb",
                                "sense_id": "a321acb0-3d94-3001-9b1a-d3bb06c9f19d",
                                "text": "„Im mittelalterlichen Kreuzgarten ließ Fürst Maximilian Karl in den Jahren 1835 - 1841 eine Gruftkapelle errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
