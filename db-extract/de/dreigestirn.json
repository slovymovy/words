                        "glosses": [
                            "Gruppe von drei hervorgehobenen Objekten oder Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f294e14-062b-423f-9e64-db0e0852644d",
                                "sense_id": "d72a6e0c-0db8-3c37-a2f7-d44429823801",
                                "text": "„Viele kleine Leser kamen in der Grundschule Isenbüttel ganz groß raus. In einem spannenden Wettbewerb klärten sie, wer das Dreigestirn der Lesekönige bildet: Henriette Clemens (2a), Ida Wichmann (3a) und Maximilian Speh (4c).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d712a65-dbf8-3c98-bbe5-504d87f7c8d8",
                        "entry_id": "e2db0ca3-c76f-3cab-a050-ebd858da2f59",
                        "glosses": [
                            "Symbolfiguren des rheinischen Karnevals: Prinz, Bauer und Jungfrau"
                        ],
                        "tags": [
                            "Karneval"
                        ],
                        "examples": [
                            {
                                "example_id": "c071ac87-9f34-4c70-beac-9d3725eb194e",
                                "sense_id": "9d712a65-dbf8-3c98-bbe5-504d87f7c8d8",
                                "text": "„In den Regen hinaus treten Würdenträger, Dreigestirn und, allen voran, Präsident Ritterbach.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
