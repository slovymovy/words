                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7ef7e02f-c96e-3f60-80f7-e7c36ad3da66",
                        "entry_id": "6aa98864-568e-36cf-9cdd-8b0fff290094",
                        "glosses": [
                            "To purloin, or obtain by devious means."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ddda3528-7622-4e1b-8a23-34605b27a26e",
                                "sense_id": "7ef7e02f-c96e-3f60-80f7-e7c36ad3da66",
                                "text": "[…] the Master at Arms, the senior member of the lower deck and chief policeman, was found to be drunk; he must have snaffled some of the crew's rum ration always kept closely guarded in a special locker […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "0f9d20ad-0259-3b76-af8f-4c15fa67e307",
                        "entry_id": "6aa98864-568e-36cf-9cdd-8b0fff290094",
                        "glosses": [
                            "To talk foolishly."
                        ],
                        "tags": [
                            "Norfolk",
                            "UK",
                            "archaic",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "37d59c1e-154d-4620-aa90-62d5b9426a8f",
                                "sense_id": "0f9d20ad-0259-3b76-af8f-4c15fa67e307",
                                "text": "In Norfolk, \"jaffle\" is used in the sense of idle discourse, of an indecent or malicious character; and a prating busybody is said to be \"always a snaffling and jafflin about what don't concern him.\""
                            }
                        ]
                    }
